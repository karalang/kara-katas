/* Constants from series, without the -l library. */
define arctan(x) {
    auto term, sum, k, x2, prev
    sum = x
    term = x
    x2 = x * x
    k = 1
    prev = 0
    while (sum != prev) {
        prev = sum
        term = -term * x2
        k += 2
        sum += term / k
    }
    return (sum)
}
define exp1() {
    auto term, sum, n
    sum = 1
    term = 1
    n = 0
    while (term > 0) {
        n += 1
        term = term / n
        sum += term
    }
    return (sum)
}
scale = 60
pi = 16 * arctan(1/5) - 4 * arctan(1/239)
scale = 50
pi / 1
e = exp1()
e
scale = 70
sqrt(2)
phi = (1 + sqrt(5)) / 2
phi
