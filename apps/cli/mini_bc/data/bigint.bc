# Exact integer work: factorials, Fibonacci, powers and number theory.
define fact(n) {
    if (n <= 1) return (1)
    return (n * fact(n - 1))
}
define fib(n) {
    auto a, b, t, i
    a = 0
    b = 1
    for (i = 0; i < n; i++) {
        t = a + b
        a = b
        b = t
    }
    return (a)
}
define gcd(a, b) {
    auto t
    while (b != 0) {
        t = a % b
        a = b
        b = t
    }
    return (a)
}
define lcm(a, b) {
    return (a / gcd(a, b) * b)
}
define powmod(b, e, m) {
    auto r
    r = 1
    b = b % m
    while (e > 0) {
        if (e % 2 == 1) r = r * b % m
        b = b * b % m
        e = e / 2
    }
    return (r)
}
define digitsum(n) {
    auto s
    s = 0
    while (n > 0) {
        s += n % 10
        n /= 10
    }
    return (s)
}
fact(25)
fact(100)
fib(90)
fib(300)
2^256
2^64 - 1
-(3^100)
gcd(1071, 462)
lcm(4, 6) ; lcm(21, 6)
powmod(4, 13, 497)
powmod(2, 10007, 10007)
digitsum(fact(100))
length(fact(100))
length(2^1000)
for (p = 2; p < 60; p++) {
    prime = 1
    for (d = 2; d * d <= p; d++) {
        if (p % d == 0) { prime = 0; break }
    }
    if (prime) print p, " "
}
print "\n"
