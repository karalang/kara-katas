a[0] = 1; a[1] = 2; a[2] = 3
define sum(v[], n) {
    auto i, t
    for (i = 0; i < n; i++) t += v[i]
    return (t)
}
sum(a[], 3)
define clobber(v[]) {
    v[0] = 99
    return (v[0])
}
clobber(a[])
a[0]
define setall(*v[], n, val) {
    auto i
    for (i = 0; i < n; i++) v[i] = val
}
setall(a[], 3, 7)
a[0] + a[1] + a[2]
define void greet(name) {
    print "hello, number ", name, "\n"
}
greet(42)
define ack(m, n) {
    if (m == 0) return (n + 1)
    if (n == 0) return (ack(m - 1, 1))
    return (ack(m - 1, ack(m, n - 1)))
}
ack(2, 3)
define hanoi(n) {
    if (n == 0) return
    return (2 * hanoi(n - 1) + 1)
}
hanoi(10)
define noret() { y = 5 }
noret()
y
define counter() {
    auto i, s[]
    for (i = 0; i < 5; i++) s[i] = i * i
    return (s[4])
}
counter()
z[3]
define collatz(n) {
    auto steps
    while (n != 1) {
        if (n % 2 == 0) n /= 2 else n = 3 * n + 1
        steps += 1
    }
    return (steps)
}
collatz(27)
i = 0
while (1) {
    i += 1
    if (i == 3) continue
    if (i > 6) break
    print i, " "
}
