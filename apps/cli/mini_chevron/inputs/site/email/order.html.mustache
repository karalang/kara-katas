{{> header}}
<p>Hi {{customer.first_name}},</p>
<p>Thanks for your order <b>#{{order.number}}</b> placed on {{order.date}}.</p>
<table class="items">
  <tr><th>Item</th><th>Qty</th><th>Price</th></tr>
  {{#order.items}}
  <tr><td>{{name}}{{#options}} ({{.}}){{/options}}</td><td>{{qty}}</td><td>{{currency}}{{price}}</td></tr>
  {{/order.items}}
</table>
{{#order.discount}}
<p>Discount code <code>{{code}}</code> saved you {{currency}}{{amount}}.</p>
{{/order.discount}}
{{^order.discount}}
<p>Tip: sign up for our newsletter to get 10% off.</p>
{{/order.discount}}
<p>Total: <b>{{currency}}{{order.total}}</b>{{#order.gift}} (gift wrapped){{/order.gift}}</p>
<p>Ship to:<br>
{{#customer.address}}
{{line1}}<br>
{{#line2}}{{line2}}<br>{{/line2}}
{{city}} {{zip}}, {{country}}
{{/customer.address}}
</p>
{{#customer.note}}
<blockquote>{{{customer.note}}}</blockquote>
{{/customer.note}}
{{> footer}}
