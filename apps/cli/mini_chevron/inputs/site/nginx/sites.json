{
  "env": "production",
  "user": "www-data",
  "workers": "auto",
  "connections": 1024,
  "gzip": {"types": "text/css application/json application/javascript"},
  "upstreams": [
    {"name": "app", "servers": [
      {"host": "10.0.1.11", "port": 8000, "weight": 3},
      {"host": "10.0.1.12", "port": 8000, "weight": 1},
      {"host": "10.0.1.13", "port": 8000, "backup": true}
    ]},
    {"name": "metrics", "servers": [{"host": "127.0.0.1", "port": 9100}]}
  ],
  "sites": [
    {"port": 443, "names": "shop.example.org www.shop.example.org", "tls": true, "cert": "shop",
     "locations": [
       {"path": "/", "proxy": "app"},
       {"path": "/static/", "root": "/srv/shop", "files": "index.html"},
       {"path": "/.git", "deny": true}
     ]},
    {"port": 8080, "names": "status.internal", "tls": false,
     "locations": [{"path": "/metrics", "proxy": "metrics"}]}
  ]
}
