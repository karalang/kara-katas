name: <% name %>

on:
  push:
    branches: [<% branch %>]
  pull_request:

jobs:
<%#jobs%>
  <% id %>:
    runs-on: ${{ matrix.os }}
    strategy:
      matrix:
        os: [<% os %>]
<%#toolchains.0%>
        toolchain: [<% toolchains %>]
<%/toolchains.0%>
    steps:
      - uses: actions/checkout@v4
<%#steps%>
      <%>step%>
<%/steps%>
<%/jobs%>
