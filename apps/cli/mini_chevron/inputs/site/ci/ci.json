{
  "name": "CI",
  "branch": "main",
  "jobs": [
    {"id": "test", "os": "ubuntu-latest, macos-latest", "toolchains": "stable, beta",
     "steps": [
       {"name": "Build", "run": "cargo build --locked"},
       {"name": "Test", "run": "cargo test -- --nocapture"},
       {"name": "Upload coverage", "if": "github.ref == 'refs/heads/main' && success()", "run": "./upload.sh", "env": "CODECOV_TOKEN"}
     ]},
    {"id": "lint", "os": "ubuntu-latest", "toolchains": "",
     "steps": [{"name": "Clippy", "run": "cargo clippy -- -D warnings"}]}
  ]
}
