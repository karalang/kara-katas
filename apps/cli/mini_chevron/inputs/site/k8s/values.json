{
  "app": "billing-api",
  "namespace": "payments",
  "replicas": 3,
  "labels": [{"key": "team", "value": "payments"}, {"key": "tier", "value": "backend"}],
  "containers": [
    {"name": "api", "image": "registry.example.com/billing-api", "tag": "2.14.1",
     "ports": [8080, 9090],
     "env": [{"name": "LOG_LEVEL", "value": "info"}, {"name": "DB_POOL", "value": 20}],
     "limits": {"cpu": "500m", "memory": "512Mi"}},
    {"name": "proxy", "image": "envoyproxy/envoy", "tag": "v1.31.0",
     "ports": [],
     "limits": {"cpu": "100m", "memory": "128Mi"}}
  ],
  "volumes": [{"name": "envoy-config", "config": "billing-envoy"}]
}
