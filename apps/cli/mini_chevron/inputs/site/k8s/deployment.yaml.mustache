apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{app}}
  namespace: {{namespace}}
  labels:
    app: {{app}}
{{#labels}}
    {{key}}: "{{value}}"
{{/labels}}
spec:
  replicas: {{replicas}}
  selector:
    matchLabels:
      app: {{app}}
  template:
    metadata:
      labels:
        app: {{app}}
    spec:
      containers:
{{#containers}}
        - {{>container}}
{{/containers}}
{{#volumes.0}}
      volumes:
{{/volumes.0}}
{{#volumes}}
        - name: {{name}}
          configMap:
            name: {{config}}
{{/volumes}}
