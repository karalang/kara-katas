== the converters one at a time
> convert_quotes('"foo" -- bar')
  -> '&#8220;foo&#8221; -- bar'
> convert_quotes('"Isn\'t this fun?"')
  -> '&#8220;Isn&#8217;t this fun?&#8221;'
> convert_quotes("'Isn't this fun?'")
  -> '&#8216;Isn&#8217;t this fun?&#8217;'
> convert_quotes("1440-80's")
  -> '1440-80&#8217;s'
> convert_quotes("1440-'80s")
  -> '1440-&#8216;80s'
> convert_quotes("1440--'80s")
  -> '1440--&#8216;80s'
> convert_quotes('1960s')
  -> '1960s'
> convert_quotes("1960's")
  -> '1960&#8217;s'
> convert_quotes("one two '60s")
  -> 'one two &#8216;60s'
> convert_quotes("'60s")
  -> '&#8216;60s'
> convert_quotes("the '80s and the 90's")
  -> 'the &#8216;80s and the 90&#8217;s'
> convert_quotes('21st century')
  -> '21st century'
> convert_quotes('3rd')
  -> '3rd'
> convert_quotes('You should use ";" here')
  -> 'You should use &#8220;;&#8221; here'
> convert_quotes('Take a look at the "<a>Essay on quoting</a>" paper.')
  -> 'Take a look at the &#8220;<a>Essay on quoting</a>&#8221; paper.'
> convert_quotes('Take a look at "<a>Essay on quoting</a>".')
  -> 'Take a look at &#8220;<a>Essay on quoting</a>&#8221;.'
> convert_quotes("<p>He said &quot;Let's write some code.&quot; This code here <code>if True:\n\tprint &quot;Okay&quot;</code> is python code.</p>")
  -> '<p>He said &quot;Let&#8217;s write some code.&quot; This code here <code>if True:\n\tprint &quot;Okay&quot;</code> is python code.</p>'
> convert_quotes('--')
  -> '--'
> convert_quotes('-->')
  -> '-->'
> convert_quotes('-- \t  >')
  -> '-- \t  >'
> convert_quotes('<!-- "foo" --> blah--blah <!-- "bar" -->')
  -> '<!-- &#8220;foo&#8221; --> blah--blah <!-- &#8220;bar&#8221; -->'
> convert_quotes('<p>foo -- "bar"<!-- foo-bar\n<p>blah "this"</p>\n-->\n</p>')
  -> '<p>foo -- &#8220;bar&#8221;<!-- foo-bar\n<p>blah &#8220;this&#8221;</p>\n-->\n</p>'
> convert_quotes('<!-- comment -->')
  -> '<!-- comment -->'
> convert_quotes('<!-- <li>Fee-fi-of-fum</li> -->')
  -> '<!-- <li>Fee-fi-of-fum</li> -->'
> convert_quotes('<!-- "foo" --> <!-- "bar" -->')
  -> '<!-- &#8220;foo&#8221; --> <!-- &#8220;bar&#8221; -->'
> convert_quotes('<!-- -- -->')
  -> '<!-- -- -->'
> convert_quotes('<!-- -- -- \t >')
  -> '<!-- -- -- \t >'
> convert_quotes('<!---->')
  -> '<!---->'
> convert_quotes('<!-- --->')
  -> '<!-- --->'
> convert_quotes('<!-- x -- >')
  -> '<!-- x -- >'
> convert_quotes('"quote here"')
  -> '&#8220;quote here&#8221;'
> convert_quotes('"quote&ndash;here"')
  -> '&#8220;quote&ndash;here&#8221;'
> convert_quotes('Nothing endures but change. -- Heraclitus')
  -> 'Nothing endures but change. -- Heraclitus'
> convert_quotes('Life itself is the proper binge. --- Julia Child (1912--2004)')
  -> 'Life itself is the proper binge. --- Julia Child (1912--2004)'
> convert_quotes('Dare to be naïve. -- Buckminster Fuller (1895---1983)')
  -> 'Dare to be naïve. -- Buckminster Fuller (1895---1983)'
> convert_quotes('Huh...?')
  -> 'Huh...?'
> convert_quotes('Wait. . . what?')
  -> 'Wait. . . what?'
