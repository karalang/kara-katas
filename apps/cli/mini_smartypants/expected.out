  -> '&#8216; &#8216;'
> convert_quotes('" "')
  -> '&#8221; &#8220;'
> convert_quotes('He said, "\'Quoted\' words in a larger quote."')
  -> 'He said, &#8220;&#8216;Quoted&#8217; words in a larger quote.&#8221;'
> convert_quotes('\'"Nested" inside\'')
  -> '&#8216;&#8220;Nested&#8221; inside&#8217;'
> convert_quotes('"\'Double then single\'"')
  -> '&#8220;&#8216;Double then single&#8217;&#8221;'
> convert_quotes('"..." and \'...\'')
  -> '&#8221;...&#8221; and &#8216;...&#8217;'
> convert_quotes('"?" she asked')
  -> '&#8221;?&#8221; she asked'
> convert_quotes("'!' he said")
  -> '&#8216;!&#8217; he said'
> convert_quotes('"!" -- \'?\'')
  -> '&#8221;!&#8221; -- &#8216;?&#8217;'
> convert_quotes("Rock 'n' roll")
  -> 'Rock &#8216;n&#8217; roll'
> convert_quotes("'Tis the season")
  -> '&#8216;Tis the season'
> convert_quotes("the dog's bone, the dogs' bones")
  -> 'the dog&#8217;s bone, the dogs&#8217; bones'
> convert_quotes('&nbsp;\'tis &nbsp;"so"')
  -> '&nbsp;&#8216;tis &nbsp;&#8220;so&#8221;'
> convert_quotes('&mdash;\'word\' &ndash;"word"')
  -> '&mdash;&#8216;word&#8217; &ndash;&#8220;word&#8221;'
> convert_quotes('&#8211;\'dash\' &#8212;"dash" &#x2013;\'hex\' &#x2014;"hex"')
  -> '&#8211;&#8217;dash&#8217; &#8212;&#8221;dash&#8221; &#x2013;&#8217;hex&#8217; &#x2014;&#8221;hex&#8221;'
> convert_quotes('("paren") [\'bracket\'] {"brace"} -\'dash\'-')
  -> '(&#8220;paren&#8221;) [&#8216;bracket&#8217;] {&#8220;brace&#8221;} -&#8216;dash&#8217;-'
> convert_quotes('"5\'10" tall"')
  -> '&#8220;5&#8216;10&#8221; tall&#8221;'
