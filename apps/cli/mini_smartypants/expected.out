  -> '&#8216;tis&#8230; the &#8216;80s &#8212;- &#8220;really&#8221;'
> smartypants('\'tis... the \'80s --- "really"', 107)
  -> '&#8216;tis&#8230; the &#8216;80s &#8211; &#8220;really&#8221;'
