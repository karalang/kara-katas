  -> '``Isn&#8217;t this fun?&#8217;&#8216;'
> convert_quotes("`Isn't this fun?'")
  -> '`Isn&#8217;t this fun?&#8217;'
> convert_quotes("``double'' and `single'")
  -> '``double&#8217;&#8217; and `single&#8217;'
> convert_quotes('"smarty" \\"pants\\"')
  -> '&#8220;smarty&#8221; \\&#8221;pants\\&#8221;'
> convert_quotes('\\\\')
  -> '\\\\'
> convert_quotes('a \\- b \\. c \\` d \\\' e \\" f \\\\ g')
  -> 'a \\- b \\. c \\` d \\&#8217; e \\&#8221; f \\\\ g'
> convert_quotes("'")
  -> '&#8216;'
> convert_quotes('"')
  -> '&#8220;'
