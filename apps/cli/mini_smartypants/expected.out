  -> '&#8220;tab&#8221;\t&#8216;tab&#8217;'
> convert_quotes('Ça va? "Très bien" -- \'merci\'')
  -> 'Ça va? &#8220;Très bien&#8221; -- &#8216;merci&#8217;'
> convert_quotes('«Bonjour» "monde"')
  -> '«Bonjour» &#8220;monde&#8221;'
> convert_quotes('数字 "引用" \'テスト\'')
  -> '数字 &#8220;引用&#8221; &#8216;テスト&#8217;'
