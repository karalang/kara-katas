{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "plain": {
      "format": "%(levelname)s %(name)s: %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "plain",
      "stream": "ext://sys.stdout"
    },
    "buffer": {
      "class": "logging.handlers.MemoryHandler",
      "capacity": 100,
      "target": "console"
    }
  },
  "loggers": {
    "app.http": {
      "handlers": [
        "buffer"
      ],
      "propagate": false
    }
  },
  "root": {
    "level": "INFO",
    "handlers": [
      "console"
    ]
  }
}
