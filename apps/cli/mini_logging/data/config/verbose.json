{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "brace": {
      "format": "{asctime}.{msecs:03.0f} {levelname:<8} [{name:>15}] {message}",
      "style": "{",
      "datefmt": "%H:%M:%S"
    },
    "db": {
      "format": "%(asctime)s %(levelname)s %(name)s: %(message)s",
      "datefmt": "%a %d %b %H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "brace",
      "stream": "ext://sys.stdout"
    },
    "db_file": {
      "class": "logging.FileHandler",
      "filename": "data/logs/db.log",
      "formatter": "db",
      "encoding": "utf-8"
    },
    "trash": {
      "class": "logging.NullHandler"
    }
  },
  "loggers": {
    "app": {
      "level": "DEBUG"
    },
    "app.db": {
      "handlers": [
        "db_file"
      ],
      "propagate": false
    },
    "stripe": {
      "level": "WARNING",
      "handlers": [
        "trash"
      ],
      "propagate": false
    }
  },
  "root": {
    "level": "WARNING",
    "handlers": [
      "console"
    ]
  }
}
