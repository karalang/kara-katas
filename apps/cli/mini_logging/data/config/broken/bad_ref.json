{
  "version": 1,
  "formatters": {
    "short": {
      "format": "$levelname $name: $message",
      "style": "$"
    }
  },
  "handlers": {
    "console2": {
      "class": "logging.StreamHandler",
      "formatter": "short",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "app.db": {
      "handlers": [
        "console2",
        "nope"
      ]
    }
  }
}
