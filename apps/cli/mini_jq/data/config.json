{
  "name": "shop",
  "version": 3,
  "feature_search": true,
  "feature_beta_ui": false,
  "owner": "platform-team",
  "limits": {"ratio": 0.10, "burst": 1.50, "max_conns": 512},
  "environments": {
    "staging": {"url": "https://staging.shop.test", "replicas": 1},
    "prod": {"url": "https://shop.test", "replicas": 6}
  },
  "services": {
    "api": {"image": "api:1.8.2", "port": 8080, "replicas": 3, "env": {"LOG_LEVEL": "info", "DB_POOL": "20"}},
    "worker": {"image": "worker:1.8.2", "replicas": 2, "env": {"QUEUE": "jobs"}},
    "legacy": {"image": "monolith:0.9", "port": 9000, "replicas": 0, "env": {}}
  },
  "tags": ["blue", "Green", "red", "green"]
}
