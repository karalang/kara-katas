{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {"name": "batch"},
  "spec": {
    "selector": {"matchLabels": {"app": "batch"}},
    "strategy": {"rollingUpdate": {"maxSurge": 1.5}},
    "template": {"spec": {"containers": [
      {"name": "app", "image": "batch:1"},
      {"name": "app", "image": "batch:2"}
    ]}}
  }
}
