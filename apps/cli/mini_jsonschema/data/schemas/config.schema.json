{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "service config",
  "type": "object",
  "properties": {
    "listen": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      ],
      "items": false
    },
    "workers": {
      "type": "integer",
      "multipleOf": 2,
      "minimum": 2
    },
    "ratio": {
      "type": "number",
      "multipleOf": 0.1,
      "maximum": 1
    },
    "level": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error",
        0,
        null
      ]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 4
    },
    "limits": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z_]+$",
        "maxLength": 12
      },
      "additionalProperties": {
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "minProperties": 1
    },
    "mode": {
      "const": {
        "tls": true,
        "versions": [
          1.2,
          1.3
        ]
      }
    },
    "legacyAuth": false,
    "admins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "pattern": "@ops\\.example$"
      },
      "minContains": 2
    },
    "token": {
      "type": "string",
      "not": {
        "pattern": "^(changeme|secret|password)$"
      }
    },
    "backoff": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "maxItems": 0
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "minProperties": 1
}
