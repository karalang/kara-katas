{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub Actions workflow (subset)",
  "type": "object",
  "required": [
    "on",
    "jobs"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "on": {
      "oneOf": [
        {
          "$ref": "#/$defs/event"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 1
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/event"
          },
          "minProperties": 1
        }
      ]
    },
    "jobs": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[_a-zA-Z][a-zA-Z0-9_-]*$": {
          "$ref": "#/$defs/job"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "event": {
      "enum": [
        "push",
        "pull_request",
        "schedule",
        "workflow_dispatch",
        "release"
      ]
    },
    "job": {
      "type": "object",
      "required": [
        "runs-on",
        "steps"
      ],
      "properties": {
        "runs-on": {
          "type": [
            "string",
            "array"
          ]
        },
        "timeout-minutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 360
        },
        "needs": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "uses": {
          "type": "string",
          "pattern": "^[\\w.-]+/[\\w.-]+(/[\\w./-]+)?@[\\w.-]+$|^docker://"
        },
        "run": {
          "type": "string"
        },
        "with": {
          "type": "object"
        }
      },
      "anyOf": [
        {
          "required": [
            "uses"
          ]
        },
        {
          "required": [
            "run"
          ]
        }
      ],
      "not": {
        "required": [
          "uses",
          "run"
        ]
      },
      "dependentSchemas": {
        "with": {
          "required": [
            "uses"
          ]
        }
      }
    }
  }
}
