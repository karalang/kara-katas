// proxy_serve: service/rev_proxy as a long-running server, the second
// target of the M4a load test (run.sh).
//
// Routing, the pools and their passive health check, the GET retry on a
// 503, the header rewriting, de-chunking and the origins' replies are
// rev_proxy.kara's, unchanged. What differs is that nothing is driven by
// hand: the proxy and the origins b1 and b2 each run an accept loop that
// gives every connection its own task, and the proxy's pools are shared by
// all its tasks behind a Mutex, locked only between network calls. As in
// rev_proxy, a client sends one request, shuts its write side and reads
// the reply until the proxy closes; the proxy talks to an origin the same
// way.
//
// The proxy listens on 127.0.0.1:27761, b1 and b2 on 27762 and 27763. b4
// (27764) and s1 (27765) are in the pools but nothing listens on them, and
// they are on 127.0.0.2. A connect to a dead port on the proxy's own
// address can pick that same port as its source and connect to itself,
// and the proxy then relays its own request back as the reply: about once
// in 80k requests when the port is inside the ephemeral range, which on
// some machines starts at 1024. A connect to 127.0.0.2 comes from
// 127.0.0.1, so it can never meet itself.
// GET /__stats answers the per-upstream counters. It runs until killed.

struct Header { name: String, value: String }

struct Message {
    start: String,
    headers: Vec[Header],
    body: String,
}

struct Upstream {
    name: String,
    addr: String,
    down_for: i64,
    refused: i64,
    served: i64,
}

struct Cluster {
    name: String,
    members: Vec[Upstream],
    next: i64,
}

struct Route { prefix: String, pool: i64, strip: bool }

const MAX_BODY: i64 = 64;
const COOLDOWN: i64 = 3;


fn reason(status: i64) -> String {
    match status {
        200 => "OK".to_string(),
        201 => "Created".to_string(),
        400 => "Bad Request".to_string(),
        404 => "Not Found".to_string(),
        413 => "Payload Too Large".to_string(),
        500 => "Internal Server Error".to_string(),
        502 => "Bad Gateway".to_string(),
        503 => "Service Unavailable".to_string(),
        _ => "Unknown".to_string(),
    }
}

fn read_all(conn: ref TcpStream) -> Result[String, String] {
    let mut bytes: Vec[u8] = Vec.new();
    let mut buf: Array[u8, 64] = [0u8; 64];
    loop {
        match conn.read(mut buf) {
            Ok(0) => break,
            Ok(n) => {
                let mut i = 0;
                while i < n {
                    bytes.push(buf[i]);
                    i = i + 1;
                }
            }
            Err(_) => return Err("read failed".to_string()),
        }
    }
    match String.from_utf8(bytes) {
        Ok(s) => Ok(s),
        Err(_) => Err("not utf-8".to_string()),
    }
}

fn header(m: ref Message, name: Str) -> Option[String] {
    for h in m.headers.iter() {
        if h.name.to_lowercase() == name {
            return Some(h.value.clone());
        }
    }
    None
}

// Decodes a chunked body: hex size line, data, CRLF, until a zero chunk.
fn dechunk(raw: Str) -> Result[String, String] {
    let mut out = String.new();
    let mut at = 0;
    loop {
        let rest = raw[at..raw.len()];
        let eol = match rest.find("\r\n") {
            Some(i) => i,
            None => return Err("chunk size line missing".to_string()),
        };
        let size = match i64.from_str_radix(rest[0..eol].trim(), 16) {
            Some(n) => n,
            None => return Err(f"bad chunk size [{rest[0..eol]}]"),
        };
        if size == 0 {
            return Ok(out);
        }
        let start = eol + 2;
        if start + size + 2 > rest.len() {
            return Err("chunk truncated".to_string());
        }
        out.push_str(rest[start..start + size]);
        at = at + start + size + 2;
    }
}

// Parses one HTTP/1.1 message (request or response) that fills `raw`.
fn parse_message(raw: Str) -> Result[Message, String] {
    let head_end = match raw.find("\r\n\r\n") {
        Some(i) => i,
        None => return Err("no end of headers".to_string()),
    };
    let lines: Vec[String] = raw[0..head_end].split("\r\n").map(|p| p.to_string()).collect();
    let mut headers: Vec[Header] = Vec.new();
    let mut i = 1;
    while i < lines.len() {
        match lines[i].find(":") {
            Some(c) => headers.push(Header {
                name: lines[i][0..c].trim().to_string(),
                value: lines[i][c + 1..lines[i].len()].trim().to_string(),
            }),
            None => return Err(f"bad header [{lines[i]}]"),
        }
        i = i + 1;
    }
    let mut m = Message { start: lines[0].clone(), headers: headers, body: String.new() };
    let rest = raw[head_end + 4..raw.len()];
    let chunked = match header(m, "transfer-encoding") {
        Some(v) => v.to_lowercase() == "chunked",
        None => false,
    };
    if chunked {
        m.body = dechunk(rest)?;
    } else {
        let len = match header(m, "content-length") {
            Some(v) => match i64.parse(v).ok() {
                Some(n) => n,
                None => return Err(f"bad content-length [{v}]"),
            },
            None => 0,
        };
        if len > rest.len() {
            return Err(f"body short by {len - rest.len()} bytes");
        }
        m.body = rest[0..len].to_string();
    }
    Ok(m)
}

// Hop-by-hop headers belong to one connection and are never forwarded,
// along with any header the Connection header names.
fn is_hop(name: Str, extra: ref Vec[String]) -> bool {
    let n = name.to_lowercase();
    let fixed = ["connection", "keep-alive", "proxy-connection", "te", "trailer", "transfer-encoding", "upgrade"];
    for f in fixed {
        if n == f {
            return true;
        }
    }
    for e in extra.iter() {
        if n == e {
            return true;
        }
    }
    false
}

fn end_to_end(m: ref Message) -> Vec[Header] {
    let mut extra: Vec[String] = Vec.new();
    match header(m, "connection") {
        Some(v) => {
            for tok in v.split(",") {
                extra.push(tok.trim().to_lowercase());
            }
        }
        None => {}
    }
    let mut out: Vec[Header] = Vec.new();
    for h in m.headers.iter() {
        if not is_hop(h.name, extra) and h.name.to_lowercase() != "content-length" {
            out.push(Header { name: h.name.clone(), value: h.value.clone() });
        }
    }
    out
}

fn render(start: Str, headers: ref Vec[Header], body: Str) -> String {
    let mut s = f"{start}\r\n";
    for h in headers.iter() {
        s.push_str(f"{h.name}: {h.value}\r\n");
    }
    s.push_str(f"Content-Length: {body.len()}\r\n\r\n");
    s.push_str(body);
    s
}

fn simple(status: i64, body: Str) -> String {
    let headers = vec![
        Header { name: "Content-Type".to_string(), value: "text/plain".to_string() },
        Header { name: "Via".to_string(), value: "1.1 kproxy".to_string() },
    ];
    render(f"HTTP/1.1 {status} {reason(status)}", headers, body)
}

fn status_of(start: Str) -> i64 {
    let parts: Vec[String] = start.split(" ").map(|p| p.to_string()).collect();
    if parts.len() < 2 {
        return 0;
    }
    i64.parse(parts[1]).unwrap_or(0)
}

// ---- origins ----------------------------------------------------------

fn origin_reply(name: Str, req: ref Message) -> String {
    let parts: Vec[String] = req.start.split(" ").map(|p| p.to_string()).collect();
    let method = parts[0].clone();
    let path = parts[1].clone();
    let mut headers: Vec[Header] = vec![
        Header { name: "Server".to_string(), value: f"origin-{name}" },
        Header { name: "Connection".to_string(), value: "close, X-Origin-Trace".to_string() },
        Header { name: "X-Origin-Trace".to_string(), value: f"{name}-internal" },
    ];
    let mut status = 200;
    let mut body = String.new();
    if path == "/users" and method == "GET" {
        body = "[{\"id\":1,\"name\":\"ada\"},{\"id\":2,\"name\":\"bob\"}]".to_string();
    } else if path == "/users" and method == "POST" {
        status = 201;
        body = f"{{\"created\":{req.body},\"by\":\"{name}\"}}";
    } else if path.starts_with("/users/") {
        body = f"{{\"id\":{path[7..path.len()]},\"from\":\"{name}\"}}";
    } else if path == "/flaky" {
        if name == "b1" {
            status = 503;
            body = "draining".to_string();
        } else {
            body = f"steady on {name}";
        }
    } else if path == "/headers" {
        let mut names: Vec[String] = Vec.new();
        for h in req.headers.iter() {
            names.push(h.name.to_lowercase());
        }
        names.sort();
        let xff = header(req, "x-forwarded-for").unwrap_or("-".to_string());
        let pre = header(req, "x-forwarded-prefix").unwrap_or("-".to_string());
        body = f"{names.join(",")} xff={xff} prefix={pre}";
    } else if path == "/export" {
        // A streamed reply: chunked, so the proxy has to decode it.
        headers.push(Header { name: "Transfer-Encoding".to_string(), value: "chunked".to_string() });
        let mut s = f"HTTP/1.1 200 OK\r\n";
        for h in headers.iter() {
            s.push_str(f"{h.name}: {h.value}\r\n");
        }
        s.push_str("\r\n");
        let rows = ["id,name\n", "1,ada\n", "2,bob\n", "3,cy\n"];
        for r in rows {
            s.push_str(f"{r.len():x}\r\n{r}\r\n");
        }
        s.push_str("0\r\n\r\n");
        return s;
    } else {
        status = 404;
        body = f"origin {name} has no {path}";
    }
    render(f"HTTP/1.1 {status} {reason(status)}", headers, body)
}


// ---- proxy ------------------------------------------------------------

fn pick(pool: mut ref Cluster, tried: ref Vec[bool]) -> Option[i64] {
    let n = pool.members.len();
    let mut k = 0;
    while k < n {
        let idx = (pool.next + k) % n;
        if pool.members[idx].down_for == 0 and not tried[idx] {
            pool.next = (idx + 1) % n;
            return Some(idx);
        }
        k = k + 1;
    }
    None
}

fn route_for(routes: ref Vec[Route], path: Str) -> Option[i64] {
    let mut best: Option[i64] = None;
    let mut best_len = 0;
    let mut i = 0;
    while i < routes.len() {
        let p = routes[i].prefix.clone();
        if path.starts_with(p) and p.len() > best_len {
            best = Some(i);
            best_len = p.len();
        }
        i = i + 1;
    }
    best
}

// Forwards one request through the chosen pool. Returns the reply for the

struct Proxy {
    routes: Vec[Route],
    pools: Vec[Cluster],
    requests: i64,
}

// The origin side: answer every connection on its own task.
fn origin_conn(conn: own TcpStream, name: Str) {
    let out = match read_all(conn) {
        Ok(raw) => match parse_message(raw) {
            Ok(req) => origin_reply(name, req),
            Err(e) => simple(400, e),
        },
        Err(e) => simple(400, e),
    };
    let _ = conn.write_all(out.bytes());
}

fn serve_origin(listener: own TcpListener, name: own String, tasks: ref TaskGroup) {
    loop {
        match listener.accept() {
            Ok(conn) => {
                let _ = tasks.spawn(|| origin_conn(conn, name));
            }
            Err(_) => sleep_ms(10),
        }
    }
}

// What forward needs from the shared state for one try: the upstream it
// picked and that upstream's address.
struct Pick { idx: i64, name: String, addr: String }

fn pick_locked(state: ref Mutex[Proxy], pi: i64, tried: ref Vec[bool]) -> Option[Pick] {
    let g = state.lock();
    match pick(mut g.value.pools[pi], tried) {
        Some(idx) => {
            let up = ref g.value.pools[pi].members[idx];
            Some(Pick { idx: idx, name: up.name.clone(), addr: up.addr.clone() })
        }
        None => None,
    }
}

fn mark_refused(state: ref Mutex[Proxy], pi: i64, idx: i64) {
    let g = state.lock();
    bump_refused(mut g.value.pools[pi], idx);
}

fn bump_refused(pool: mut ref Cluster, idx: i64) {
    pool.members[idx].refused += 1;
    pool.members[idx].down_for = COOLDOWN;
}

fn mark_served(state: ref Mutex[Proxy], pi: i64, idx: i64) {
    let g = state.lock();
    bump_served(mut g.value.pools[pi], idx);
}

fn bump_served(pool: mut ref Cluster, idx: i64) {
    pool.members[idx].served += 1;
}

fn cool_down(pool: mut ref Cluster) {
    for m in pool.members.iter_mut() {
        if m.down_for > 0 {
            m.down_for -= 1;
        }
    }
}

// rev_proxy's forward, with the shared state locked only around the pool
// bookkeeping, never across a connect, write or read.
fn forward(state: ref Mutex[Proxy], req: ref Message, method: Str, path: Str) -> (String, String, i64) {
    let (prefix, strip, pi, pool_name, n) = {
        let g = state.lock();
        let ri = match route_for(g.value.routes, path) {
            Some(i) => i,
            None => return (simple(404, f"no route for {path}"), "-".to_string(), 0),
        };
        let pi = g.value.routes[ri].pool;
        cool_down(mut g.value.pools[pi]);
        (g.value.routes[ri].prefix.clone(), g.value.routes[ri].strip, pi, g.value.pools[pi].name.clone(), g.value.pools[pi].members.len())
    };
    let upstream_path = if strip {
        let p = path[prefix.len() - 1..path.len()].to_string();
        p
    } else {
        path.to_string()
    };
    let mut headers = end_to_end(req);
    headers.push(Header { name: "X-Forwarded-For".to_string(), value: "127.0.0.1".to_string() });
    headers.push(Header { name: "X-Forwarded-Prefix".to_string(), value: prefix[0..prefix.len() - 1].to_string() });
    headers.push(Header { name: "Via".to_string(), value: "1.1 kproxy".to_string() });
    let outgoing = render(f"{method} {upstream_path} HTTP/1.1", headers, req.body);

    let mut tried: Vec[bool] = Vec.new();
    for _ in 0..n {
        tried.push(false);
    }
    let mut tries = 0;
    let mut last_reply: Option[(String, String)] = None;
    loop {
        let up = match pick_locked(state, pi, tried) {
            Some(p) => p,
            None => break,
        };
        tried[up.idx] = true;
        tries += 1;
        let conn = match TcpStream.connect(up.addr.clone()) {
            Ok(c) => c,
            Err(_) => {
                mark_refused(state, pi, up.idx);
                continue;
            }
        };
        let sent = conn.write_all(outgoing.bytes()).is_ok() and conn.shutdown_write().is_ok();
        if not sent {
            continue;
        }
        let raw = match read_all(conn) {
            Ok(r) => r,
            Err(_) => continue,
        };
        let resp = match parse_message(raw) {
            Ok(r) => r,
            Err(e) => {
                last_reply = Some((simple(502, f"bad upstream reply: {e}"), up.name.clone()));
                break;
            }
        };
        mark_served(state, pi, up.idx);
        let mut out_headers = end_to_end(resp);
        out_headers.push(Header { name: "Via".to_string(), value: "1.1 kproxy".to_string() });
        out_headers.push(Header { name: "X-Upstream".to_string(), value: up.name.clone() });
        let reply = render(resp.start, out_headers, resp.body);
        if status_of(resp.start) == 503 and method == "GET" {
            last_reply = Some((reply, up.name.clone()));
            continue;
        }
        return (reply, up.name.clone(), tries);
    }
    match last_reply {
        Some((r, name)) => (r, name, tries),
        None => (simple(502, f"no healthy upstream in {pool_name}"), "-".to_string(), tries),
    }
}

fn stats_reply(state: ref Mutex[Proxy]) -> String {
    let g = state.lock();
    let mut body = f"requests={g.value.requests}\n";
    for p in g.value.pools.iter() {
        for m in p.members.iter() {
            body.push_str(f"{p.name}/{m.name} served={m.served} refused={m.refused} down_for={m.down_for}\n");
        }
    }
    simple(200, body)
}

fn handle_client(conn: own TcpStream, state: ref Mutex[Proxy]) {
    let raw = match read_all(conn) {
        Ok(r) => r,
        Err(e) => e,
    };
    {
        let g = state.lock();
        g.value.requests += 1;
    }
    let reply = match parse_message(raw) {
        Ok(req) => {
            let parts: Vec[String] = req.start.split(" ").map(|p| p.to_string()).collect();
            if parts.len() != 3 or not parts[2].starts_with("HTTP/1.") {
                simple(400, "bad request line")
            } else if parts[0] == "GET" and parts[1] == "/__stats" {
                stats_reply(state)
            } else if req.body.len() > MAX_BODY {
                simple(413, f"body over {MAX_BODY} bytes")
            } else {
                forward(state, req, parts[0], parts[1]).0
            }
        }
        Err(e) => simple(400, e),
    };
    let _ = conn.write_all(reply.bytes());
}

fn upstream(name: Str, host: Str, port: i64) -> Upstream {
    Upstream { name: name.to_string(), addr: f"{host}:{port}", down_for: 0, refused: 0, served: 0 }
}

fn main() {
    let listener = match TcpListener.bind("127.0.0.1:27761") {
        Ok(l) => l,
        Err(_) => {
            println("proxy bind failed");
            return;
        }
    };
    let b1 = match TcpListener.bind("127.0.0.1:27762") {
        Ok(l) => l,
        Err(_) => {
            println("origin b1 bind failed");
            return;
        }
    };
    let b2 = match TcpListener.bind("127.0.0.1:27763") {
        Ok(l) => l,
        Err(_) => {
            println("origin b2 bind failed");
            return;
        }
    };
    let state = Mutex.new(Proxy {
        routes: vec![
            Route { prefix: "/api/".to_string(), pool: 0, strip: true },
            Route { prefix: "/api/admin/".to_string(), pool: 1, strip: false },
            Route { prefix: "/static/".to_string(), pool: 1, strip: false },
        ],
        pools: vec![
            Cluster { name: "api".to_string(), members: vec![upstream("b1", "127.0.0.1", 27762), upstream("b2", "127.0.0.1", 27763), upstream("b4", "127.0.0.2", 27764)], next: 0 },
            Cluster { name: "static".to_string(), members: vec![upstream("s1", "127.0.0.2", 27765)], next: 0 },
        ],
        requests: 0,
    });
    println("proxy_serve listening on 127.0.0.1:27761");
    let tasks = TaskGroup.new();
    let _ = tasks.spawn(|| serve_origin(b1, "b1".to_string(), tasks));
    let _ = tasks.spawn(|| serve_origin(b2, "b2".to_string(), tasks));
    loop {
        match listener.accept() {
            Ok(conn) => {
                let _ = tasks.spawn(|| handle_client(conn, state));
            }
            Err(_) => sleep_ms(10),
        }
    }
}
