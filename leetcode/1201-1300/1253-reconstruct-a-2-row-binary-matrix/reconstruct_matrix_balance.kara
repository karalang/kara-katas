// LeetCode #1253: Reconstruct a 2-Row Binary Matrix -- greedy in one pass:
// what each row still has to give, a 2 taking one from both and a 1 going
// to whichever row has more left. While a matrix exists, the row with
// more left has more than the 2s still to come, so it can spare the 1; a
// count gone below zero, or left over at the end, means none exists.

fn reconstruct_matrix(upper: i64, lower: i64, colsum: Vec[i64]) -> Vec[Vec[i64]] {
    let mut rows = [Vec.new(), Vec.new()];
    let mut left = [upper, lower];
    for v in colsum {
        let (a, b) = match v {
            2 => (1, 1),
            1 if left[0] >= left[1] => (1, 0),
            1 => (0, 1),
            _ => (0, 0),
        };
        rows[0].push(a);
        rows[1].push(b);
        left[0] -= a;
        left[1] -= b;
        if left[0] < 0 or left[1] < 0 {
            return [];
        }
    }
    if left[0] != 0 or left[1] != 0 {
        return [];
    }
    rows
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 1 when `ans` is a matrix the statement asks for: two rows of 0s and 1s,
// as long as `colsum`, whose rows add to `upper` and `lower` and whose
// columns add to `colsum`; 0 when it is empty, the answer for no such
// matrix; and -1 otherwise. LeetCode accepts any such matrix, and the
// arms need not choose the same one.
fn judge(upper: i64, lower: i64, colsum: Vec[i64], ans: Vec[Vec[i64]]) -> i64 {
    if ans.is_empty() {
        return 0;
    }
    let n = colsum.len();
    if ans.len() != 2 or ans[0].len() != n or ans[1].len() != n {
        return -1;
    }
    let mut up = 0;
    let mut low = 0;
    for i in 0..n {
        let a = ans[0][i];
        let b = ans[1][i];
        if a < 0 or a > 1 or b < 0 or b > 1 or a + b != colsum[i] {
            return -1;
        }
        up += a;
        low += b;
    }
    if up == upper and low == lower { 1 } else { -1 }
}

// A random `colsum` of `n` columns, a 2 with chance `twos` in 100 and a 0
// or 1 otherwise, and the row sums of one matrix that has it, moved by
// -1 to 1 each half the time so that some have no matrix at all.
fn random_case(n: i64, twos: i64, seed: mut ref i64) -> (i64, i64, Vec[i64]) {
    let mut colsum = Vec.new();
    let mut upper = 0;
    let mut lower = 0;
    for _ in 0..n {
        let v = if next_random(mut seed) % 100 < twos { 2 } else { next_random(mut seed) % 2 };
        colsum.push(v);
        if v == 2 {
            upper += 1;
            lower += 1;
        } else if v == 1 {
            if next_random(mut seed) % 2 == 0 {
                upper += 1;
            } else {
                lower += 1;
            }
        }
    }
    if next_random(mut seed) % 2 == 0 {
        upper += next_random(mut seed) % 3 - 1;
        lower += next_random(mut seed) % 3 - 1;
    }
    (upper.max(0), lower.max(0), colsum)
}

fn show(verdict: i64) -> String {
    match verdict {
        1 => "matrix",
        0 => "[]",
        _ => "WRONG",
    }
}

fn main() {
    // LeetCode's three examples
    let a = judge(2, 1, [1, 1, 1], reconstruct_matrix(2, 1, [1, 1, 1]));
    let b = judge(2, 3, [2, 2, 1, 1], reconstruct_matrix(2, 3, [2, 2, 1, 1]));
    let colsum = [2, 1, 2, 0, 1, 0, 1, 2, 0, 1];
    let c = judge(5, 5, colsum, reconstruct_matrix(5, 5, colsum));
    println(f"{show(a)} {show(b)} {show(c)}");
    // 1000 random cases of 1 to 2000 columns, each with its own share of 2s
    let mut seed = 1253;
    let mut built = 0;
    let mut wrong = 0;
    let mut check = 0;
    for t in 0..1000 {
        let n = next_random(mut seed) % 2000 + 1;
        let twos = next_random(mut seed) % 101;
        let (upper, lower, colsum) = random_case(n, twos, mut seed);
        let verdict = judge(upper, lower, colsum, reconstruct_matrix(upper, lower, colsum));
        if verdict == 1 {
            built += 1;
        } else if verdict == -1 {
            wrong += 1;
        }
        check = (check * 131 + verdict * (t + 1)) % 1000000007;
    }
    println(f"1000 random cases: {built} built, {wrong} wrong, checksum {check}");
    // the constraints' top: 100000 columns of 2s with both rows 100000,
    // 100000 columns of 1s split 50000 and 50000, and the same with the
    // upper row one short
    let twos = Vec.filled(100000, 2);
    let ones = Vec.filled(100000, 1);
    let x = judge(100000, 100000, twos, reconstruct_matrix(100000, 100000, twos));
    let y = judge(50000, 50000, ones, reconstruct_matrix(50000, 50000, ones));
    let z = judge(49999, 50000, ones, reconstruct_matrix(49999, 50000, ones));
    println(f"100000 columns: twos {show(x)}, ones {show(y)}, one short {show(z)}");
}
