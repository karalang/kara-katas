// LeetCode #1262: Greatest Sum Divisible by Three -- greedily: take every
// number, and if the total leaves a remainder, give back the cheapest
// numbers that remove it, one with that remainder or two with the other,
// the two smallest of each remainder kept in one pass.

fn max_sum_div_three(nums: Vec[i64]) -> i64 {
    // The smallest and second smallest number with remainder 1, and with
    // remainder 2, or `None` while there are fewer.
    let mut ones: (Option[i64], Option[i64]) = (None, None);
    let mut twos: (Option[i64], Option[i64]) = (None, None);
    let mut total = 0;
    for x in nums.iter() {
        total += x;
        let pair = match x % 3 {
            1 => mut ref ones,
            2 => mut ref twos,
            _ => continue,
        };
        match pair {
            (None, _) => pair.0 = Some(x),
            (Some(a), _) if x < a => {
                pair.1 = pair.0;
                pair.0 = Some(x);
            }
            (Some(_), None) => pair.1 = Some(x),
            (Some(_), Some(b)) if x < b => pair.1 = Some(x),
            _ => {}
        }
    }
    let (one, two) = match total % 3 {
        0 => return total,
        1 => (ones, twos),
        _ => (twos, ones),
    };
    // One number with the total's remainder, or two with the other.
    let single = one.0;
    let double = match two {
        (Some(a), Some(b)) => Some(a + b),
        _ => None,
    };
    match (single, double) {
        (Some(a), Some(b)) => total - a.min(b),
        (Some(a), None) => total - a,
        (None, Some(b)) => total - b,
        (None, None) => 0,
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_nums(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    (0..n).map(|_| next_random(mut seed) % top + 1).collect()
}

fn main() {
    // LeetCode's three examples
    println(f"{max_sum_div_three([3, 6, 5, 1, 8])} {max_sum_div_three([4])} {max_sum_div_three([1, 2, 3, 4, 4])}");
    // 1000 random lists of 1 to 10 numbers from 1 to 9, and 1000 of 1 to
    // 200 numbers from 1 to 10^4
    let mut seed = 1262;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let (n, top) = if round < 1000 { (next_random(mut seed) % 10 + 1, 9) } else { (next_random(mut seed) % 200 + 1, 10000) };
        let best = max_sum_div_three(random_nums(n, top, mut seed));
        total += best;
        check = (check * 131 + best) % 1000000007;
    }
    println(f"2000 random lists: total {total}, checksum {check}");
    // the constraints' top: 4 * 10^4 numbers, all 10^4, at random, and all
    // 2 but one 1
    let all = Vec.filled(40000, 10000);
    let mixed = random_nums(40000, 10000, mut seed);
    let mut twos = Vec.filled(40000, 2);
    twos[20000] = 1;
    println(f"{max_sum_div_three(all)} {max_sum_div_three(mixed)} {max_sum_div_three(twos)}");
}
