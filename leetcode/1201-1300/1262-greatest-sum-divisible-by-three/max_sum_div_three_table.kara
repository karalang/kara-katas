// LeetCode #1262: Greatest Sum Divisible by Three -- by a table: row `i`
// holds, for each remainder, the best sum of a choice among the first `i`
// numbers, or `None` where no choice has that remainder; each row is built
// from the one above by skipping or taking the next number.

fn max_sum_div_three(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut table: Vec[Vec[Option[i64]]] = Vec.filled(n + 1, Vec.filled(3, None));
    table[0][0] = Some(0);
    for i in 0..n {
        for r in 0..3 {
            let skip = table[i][r];
            let take = table[i][(r + 3 - nums[i] % 3) % 3].map(|s| s + nums[i]);
            table[i + 1][r] = match (skip, take) {
                (Some(a), Some(b)) => Some(a.max(b)),
                (a, None) => a,
                (None, b) => b,
            };
        }
    }
    table[n][0].unwrap_or(0)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_nums(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    (0..n).map(|_| next_random(mut seed) % top + 1).collect()
}

fn main() {
    // LeetCode's three examples
    println(f"{max_sum_div_three([3, 6, 5, 1, 8])} {max_sum_div_three([4])} {max_sum_div_three([1, 2, 3, 4, 4])}");
    // 1000 random lists of 1 to 10 numbers from 1 to 9, and 1000 of 1 to
    // 200 numbers from 1 to 10^4
    let mut seed = 1262;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let (n, top) = if round < 1000 { (next_random(mut seed) % 10 + 1, 9) } else { (next_random(mut seed) % 200 + 1, 10000) };
        let best = max_sum_div_three(random_nums(n, top, mut seed));
        total += best;
        check = (check * 131 + best) % 1000000007;
    }
    println(f"2000 random lists: total {total}, checksum {check}");
    // the constraints' top: 4 * 10^4 numbers, all 10^4, at random, and all
    // 2 but one 1
    let all = Vec.filled(40000, 10000);
    let mixed = random_nums(40000, 10000, mut seed);
    let mut twos = Vec.filled(40000, 2);
    twos[20000] = 1;
    println(f"{max_sum_div_three(all)} {max_sum_div_three(mixed)} {max_sum_div_three(twos)}");
}
