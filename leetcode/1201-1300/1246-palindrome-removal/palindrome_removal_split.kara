// LeetCode #1246: Palindrome Removal -- interval dynamic programming by
// length, split form: an interval is cleared either as two parts cleared
// one after the other, at the best split, or, when its two ends are
// equal, as its inside with the ends riding along on the inside's last
// move (one move when there is no inside). `best[i][j]` covers
// `arr[i..=j]`.

fn minimum_moves(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut best: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(n, 0));
    for len in 1..n + 1 {
        for i in 0..n - len + 1 {
            let j = i + len - 1;
            if len == 1 {
                best[i][j] = 1;
                continue;
            }
            let mut moves = len;
            if arr[i] == arr[j] {
                moves = if len == 2 { 1 } else { best[i + 1][j - 1] };
            }
            for k in i..j {
                moves = moves.min(best[i][k] + best[k + 1][j]);
            }
            best[i][j] = moves;
        }
    }
    best[0][n - 1]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{minimum_moves([1, 2])} {minimum_moves([1, 3, 4, 1, 5])}");
    // 1000 random arrays of 1 to 100 values, from as few as 1 to as many
    // as 20 distinct values, so that palindromes are common and rare
    let mut seed = 1246;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 100 + 1;
        let values = next_random(mut seed) % 20 + 1;
        let arr: Vec[i64] = (0..n).map(|_| next_random(mut seed) % values + 1).collect();
        let moves = minimum_moves(arr);
        total += moves;
        check = (check * 131 + moves) % 1000000007;
    }
    println(f"1000 random arrays: total {total}, checksum {check}");
    // the constraints' top: 100 values from 1 to 20, from 1 to 2, and a
    // run up and down, 1 to 50 and back
    let wide: Vec[i64] = (0..100).map(|_| next_random(mut seed) % 20 + 1).collect();
    let narrow: Vec[i64] = (0..100).map(|_| next_random(mut seed) % 2 + 1).collect();
    let hill: Vec[i64] = (0..100).map(|i| if i < 50 { i + 1 } else { 100 - i }).collect();
    println(f"100 values: from 1 to 20 {minimum_moves(wide)}, from 1 to 2 {minimum_moves(narrow)}, a hill {minimum_moves(hill)}");
}
