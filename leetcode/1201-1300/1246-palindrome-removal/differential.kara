// LeetCode #1246: the differential -- the five arms against the statement
// read literally and four more properties, on 2000 random arrays.

// arm 0: palindrome_removal.kara
fn a0_minimum_moves(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    // `best[i][j]` for `arr[i..j]`, end exclusive, so an empty interval
    // is `best[i][i] = 0`.
    let mut best: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(n + 1, 0));
    for i in (0..n).rev() {
        for j in i + 1..n + 1 {
            let mut moves = 1 + best[i + 1][j];
            if i + 1 < j and arr[i + 1] == arr[i] {
                moves = moves.min(1 + best[i + 2][j]);
            }
            for k in i + 2..j {
                if arr[k] == arr[i] {
                    moves = moves.min(best[i + 1][k] + best[k + 1][j]);
                }
            }
            best[i][j] = moves;
        }
    }
    best[0][n]
}

// arm 1: palindrome_removal_memo.kara
fn a1_clear(arr: Vec[i64], i: i64, j: i64, memo: mut ref Vec[Vec[i64]]) -> i64 {
    if i >= j {
        return 0;
    }
    if memo[i][j] >= 0 {
        return memo[i][j];
    }
    let mut moves = 1 + a1_clear(arr, i + 1, j, mut memo);
    if i + 1 < j and arr[i + 1] == arr[i] {
        moves = moves.min(1 + a1_clear(arr, i + 2, j, mut memo));
    }
    for k in i + 2..j {
        if arr[k] == arr[i] {
            moves = moves.min(a1_clear(arr, i + 1, k, mut memo) + a1_clear(arr, k + 1, j, mut memo));
        }
    }
    memo[i][j] = moves;
    moves
}

fn a1_minimum_moves(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut memo: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(n + 1, -1));
    a1_clear(arr, 0, n, mut memo)
}

// arm 2: palindrome_removal_split.kara
fn a2_minimum_moves(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut best: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(n, 0));
    for len in 1..n + 1 {
        for i in 0..n - len + 1 {
            let j = i + len - 1;
            if len == 1 {
                best[i][j] = 1;
                continue;
            }
            let mut moves = len;
            if arr[i] == arr[j] {
                moves = if len == 2 { 1 } else { best[i + 1][j - 1] };
            }
            for k in i..j {
                moves = moves.min(best[i][k] + best[k + 1][j]);
            }
            best[i][j] = moves;
        }
    }
    best[0][n - 1]
}

// arm 3: palindrome_removal_flat.kara
fn a3_minimum_moves(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let w = n + 1;
    let mut best: Vec[i64] = Vec.filled(w * w, 0);
    for i in (0..n).rev() {
        for j in i + 1..w {
            let alone = 1 + best[(i + 1) * w + j];
            let pair = if i + 1 < j and arr[i + 1] == arr[i] { 1 + best[(i + 2) * w + j] } else { alone };
            let later = (i + 2..j)
                .filter(|k| arr[k] == arr[i])
                .map(|k| best[(i + 1) * w + k] + best[(k + 1) * w + j])
                .min()
                .unwrap_or(alone);
            best[i * w + j] = alone.min(pair).min(later);
        }
    }
    best[n]
}

// arm 4: palindrome_removal_solution.kara
struct A4Solution {}

impl A4Solution {
    pub fn minimum_moves(arr: Vec[i32]) -> i32 {
        let n = arr.len();
        let mut dp = Vec.filled(n, Vec.filled(n, 0i32));
        for i in (0..n).rev() {
            for j in i..n {
                if i == j {
                    dp[i][j] = 1;
                    continue;
                }
                dp[i][j] = 1 + dp[i + 1][j];
                if arr[i] == arr[i + 1] {
                    dp[i][j] = dp[i][j].min(1 + if i + 2 <= j { dp[i + 2][j] } else { 0 });
                }
                for k in (i + 2)..=j {
                    if arr[i] == arr[k] {
                        let right = if k + 1 <= j { dp[k + 1][j] } else { 0 };
                        dp[i][j] = dp[i][j].min(dp[i + 1][k - 1] + right);
                    }
                }
            }
        }
        dp[0][n - 1]
    }
}

fn a4_minimum_moves(arr: Vec[i64]) -> i64 {
    A4Solution.minimum_moves(arr.iter().map(|v| v as i32).collect())
}

// The statement read literally: every move there is, every subarray that
// reads the same both ways taken out and the rest closed up, and the
// fewest moves over all of them, each array met once kept in a `Map`.
fn literal(arr: Vec[i64], seen: mut ref Map[Vec[i64], i64]) -> i64 {
    if arr.is_empty() {
        return 0;
    }
    if let Some(moves) = seen.get(arr) {
        return moves;
    }
    let n = arr.len();
    let mut best = n;
    for i in 0..n {
        for j in i + 1..n + 1 {
            let part = arr[i..j].to_vec();
            let mut back = part.clone();
            back.reverse();
            if part == back {
                let mut rest = arr[0..i].to_vec();
                rest.extend(arr[j..n].iter());
                best = best.min(1 + literal(rest, mut seen));
            }
        }
    }
    seen.insert(arr.clone(), best);
    best
}

fn arms(arr: Vec[i64]) -> Vec[i64] {
    [a0_minimum_moves(arr), a1_minimum_moves(arr), a2_minimum_moves(arr), a3_minimum_moves(arr), a4_minimum_moves(arr)]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["the statement read literally", "the array reversed", "between 1 and n, and 1 exactly for a palindrome", "the values renamed", "two arrays end to end take no more than both", "the ★ arm's answer"];
    let mut fails = Vec.filled(6, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 12460;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 10 + 1;
        let values = next_random(mut seed) % 4 + 1;
        let arr: Vec[i64] = (0..n).map(|_| next_random(mut seed) % values + 1).collect();
        let mut seen: Map[Vec[i64], i64] = Map.new();
        let want = literal(arr, mut seen);
        check = (check * 131 + want) % 1000000007;
        let got = arms(arr);
        let mut back = arr.clone();
        back.reverse();
        let reversed = arms(back);
        let is_palindrome = arr == back;
        let mut names_for: Vec[i64] = (1..21).collect();
        for i in (1..20).rev() {
            let j = next_random(mut seed) % (i + 1);
            names_for.swap(i, j);
        }
        let renamed = arms(arr.iter().map(|v| names_for[v - 1]).collect());
        let m = next_random(mut seed) % 10 + 1;
        let other: Vec[i64] = (0..m).map(|_| next_random(mut seed) % values + 1).collect();
        let others = arms(other);
        let mut joined = arr.clone();
        joined.extend(other.iter());
        let both = arms(joined);
        for arm in 0..5 {
            let d = got[arm];
            let held = [
                d == want,
                reversed[arm] == d,
                d >= 1 and d <= n and (d == 1) == is_palindrome,
                renamed[arm] == d,
                both[arm] <= d + others[arm],
                d == got[0],
            ];
            for t in 0..6 {
                checks += 1;
                if not held[t] {
                    fails[t] += 1;
                    if fails[t] <= 2 {
                        println(f"P{t + 1} ({names[t]}) fails on arm {arm}: {arr} -> {d}");
                    }
                }
            }
        }
    }
    let total: i64 = fails.iter().sum();
    for t in 0..6 {
        if fails[t] > 0 {
            print(f"P{t + 1}: {fails[t]} failures ");
        }
    }
    println(f"2000 arrays: checksum {check}, {checks} checks over 5 arms: {total} failures");
}
