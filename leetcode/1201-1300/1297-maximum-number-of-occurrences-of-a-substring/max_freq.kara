// LeetCode #1297: Maximum Number of Occurrences of a Substring -- the ★
// arm: a substring that occurs k times has its first minSize letters occur
// at least k times, with no more distinct letters, so only windows of
// minSize count. One window slides along the string with its letter counts
// and number of distinct letters, and each window with few enough letters
// is counted in a `Map` by its text. O(n minSize)

fn max_freq(s: Str, max_letters: i64, min_size: i64, max_size: i64) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut letters: Vec[i64] = Vec.filled(26, 0);
    let mut distinct = 0;
    let mut seen: Map[Str, i64] = Map.new();
    let mut best = 0;
    for i in 0..n {
        let add = (bytes[i] - 97) as i64;
        if letters[add] == 0 {
            distinct += 1;
        }
        letters[add] += 1;
        if i >= min_size {
            let gone = (bytes[i - min_size] - 97) as i64;
            letters[gone] -= 1;
            if letters[gone] == 0 {
                distinct -= 1;
            }
        }
        if i + 1 >= min_size and distinct <= max_letters {
            let window = s[i + 1 - min_size..i + 1];
            let times = seen.get(window).cloned().unwrap_or(0) + 1;
            seen.insert(window, times);
            if times > best {
                best = times;
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's examples, a window as long as the string, no substring
    // with few enough letters, and one letter repeated
    println(f"{max_freq("aababcaab", 2, 3, 4)} {max_freq("aaaa", 1, 3, 3)} {max_freq("abcde", 5, 5, 5)} {max_freq("abcde", 1, 2, 3)} {max_freq("zzzzzzzzzz", 1, 1, 10)}");
    // random strings of 1 to 600 letters over the first 2 to 26 letters,
    // and random limits within the constraints
    let mut seed = 1297;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..200 {
        let len = 1 + next_random(mut seed) % 600;
        let alphabet = 2 + next_random(mut seed) % 25;
        let mut s = String.new();
        for _ in 0..len {
            s.push(char.try_from(97 + (next_random(mut seed) % alphabet) as u32).ok().unwrap());
        }
        let top = if len < 26 { len } else { 26 };
        let min_size = 1 + next_random(mut seed) % (if top < 6 { top } else { 6 });
        let max_size = min_size + next_random(mut seed) % (top - min_size + 1);
        let max_letters = 1 + next_random(mut seed) % 26;
        let best = max_freq(s, max_letters, min_size, max_size);
        total += best;
        check = (check * 131 + best) % 1000000007;
    }
    println(f"200 random strings: occurrences total {total}, checksum {check}");
}
