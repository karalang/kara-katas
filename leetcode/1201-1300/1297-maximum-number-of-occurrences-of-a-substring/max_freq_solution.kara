// LeetCode #1297: Maximum Number of Occurrences of a Substring -- a Rust
// solution as LeetCode's Rust users write it (a `HashMap<&str, i32>` keyed
// by `&s[i..i + min_size]`, the distinct letters of each window counted by
// a `[0; 26]` array refilled per window), carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn max_freq(s: String, max_letters: i32, min_size: i32, _max_size: i32) -> i32 {
        let k = min_size as i64;
        let b = s.bytes();
        let mut map: Map[Str, i32] = Map.new();
        let mut ans: i32 = 0;
        for i in 0..=b.len() - k {
            let mut cnt = [0; 26];
            let mut uniq = 0;
            for j in i..i + k {
                let c = (b[j] - b'a') as i64;
                if cnt[c] == 0 {
                    uniq += 1;
                }
                cnt[c] += 1;
            }
            if uniq <= max_letters {
                let e = map.entry(s[i..i + k]).or_insert(0);
                *e += 1;
                ans = ans.max(*e);
            }
        }
        ans
    }
}

fn max_freq(s: Str, max_letters: i64, min_size: i64, max_size: i64) -> i64 {
    Solution.max_freq(s.to_string(), max_letters as i32, min_size as i32, max_size as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's examples, a window as long as the string, no substring
    // with few enough letters, and one letter repeated
    println(f"{max_freq("aababcaab", 2, 3, 4)} {max_freq("aaaa", 1, 3, 3)} {max_freq("abcde", 5, 5, 5)} {max_freq("abcde", 1, 2, 3)} {max_freq("zzzzzzzzzz", 1, 1, 10)}");
    // random strings of 1 to 600 letters over the first 2 to 26 letters,
    // and random limits within the constraints
    let mut seed = 1297;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..200 {
        let len = 1 + next_random(mut seed) % 600;
        let alphabet = 2 + next_random(mut seed) % 25;
        let mut s = String.new();
        for _ in 0..len {
            s.push(char.try_from(97 + (next_random(mut seed) % alphabet) as u32).ok().unwrap());
        }
        let top = if len < 26 { len } else { 26 };
        let min_size = 1 + next_random(mut seed) % (if top < 6 { top } else { 6 });
        let max_size = min_size + next_random(mut seed) % (top - min_size + 1);
        let max_letters = 1 + next_random(mut seed) % 26;
        let best = max_freq(s, max_letters, min_size, max_size);
        total += best;
        check = (check * 131 + best) % 1000000007;
    }
    println(f"200 random strings: occurrences total {total}, checksum {check}");
}
