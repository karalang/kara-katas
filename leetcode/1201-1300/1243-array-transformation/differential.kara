// LeetCode #1243: the differential -- the five arms against the statement
// read literally and five more properties, on 2000 random arrays.

// arm 0: array_transformation.kara
fn a0_transform_array(arr: own Vec[i64]) -> Vec[i64] {
    let mut cur = arr;
    loop {
        let mut next = cur.clone();
        for i in 1..cur.len() - 1 {
            if cur[i] < cur[i - 1] and cur[i] < cur[i + 1] {
                next[i] += 1;
            } else if cur[i] > cur[i - 1] and cur[i] > cur[i + 1] {
                next[i] -= 1;
            }
        }
        if next == cur {
            return cur;
        }
        cur = next;
    }
}

// arm 1: array_transformation_inplace.kara
fn a1_transform_array(arr: own Vec[i64]) -> Vec[i64] {
    let mut arr = arr;
    let mut changed = true;
    while changed {
        changed = false;
        let mut prev = arr[0];
        for i in 1..arr.len() - 1 {
            let here = arr[i];
            if here < prev and here < arr[i + 1] {
                arr[i] += 1;
                changed = true;
            } else if here > prev and here > arr[i + 1] {
                arr[i] -= 1;
                changed = true;
            }
            prev = here;
        }
    }
    arr
}

// arm 2: array_transformation_windows.kara
fn a2_step(w: Slice[i64]) -> i64 {
    if w[1] < w[0] and w[1] < w[2] {
        w[1] + 1
    } else if w[1] > w[0] and w[1] > w[2] {
        w[1] - 1
    } else {
        w[1]
    }
}

fn a2_transform_array(arr: Vec[i64]) -> Vec[i64] {
    let mut cur = arr.clone();
    loop {
        let mut next = [cur[0]];
        next.extend(cur.windows(3).into_iter().map(a2_step));
        next.push(cur[cur.len() - 1]);
        if next == cur {
            return cur;
        }
        cur = next;
    }
}

// arm 3: array_transformation_iter.kara
fn a3_transform_array(arr: Vec[i64]) -> Vec[i64] {
    let n = arr.len();
    let mut cur = arr.clone();
    loop {
        let next: Vec[i64] = (0..n)
            .map(|i| {
                if i == 0 or i == n - 1 {
                    cur[i]
                } else if cur[i] < cur[i - 1] and cur[i] < cur[i + 1] {
                    cur[i] + 1
                } else if cur[i] > cur[i - 1] and cur[i] > cur[i + 1] {
                    cur[i] - 1
                } else {
                    cur[i]
                }
            })
            .collect();
        let moved = (0..n).filter(|i| next[i] != cur[i]).count();
        cur = next;
        if moved == 0 {
            return cur;
        }
    }
}

// arm 4: array_transformation_solution.kara
struct A4Solution {}

impl A4Solution {
    pub fn transform_array(arr: own Vec[i32]) -> Vec[i32] {
        let mut arr = arr;
        loop {
            let prev = arr.clone();
            let mut changed = false;
            for i in 1..arr.len() - 1 {
                if prev[i] < prev[i - 1] and prev[i] < prev[i + 1] {
                    arr[i] += 1;
                    changed = true;
                } else if prev[i] > prev[i - 1] and prev[i] > prev[i + 1] {
                    arr[i] -= 1;
                    changed = true;
                }
            }
            if not changed {
                break;
            }
        }
        arr
    }
}

fn a4_transform_array(arr: Vec[i64]) -> Vec[i64] {
    A4Solution.transform_array(arr.iter().map(|x| x as i32).collect()).iter().map(|x| x as i64).collect()
}

// The statement read literally: the days, each made from the one before
// by the rule as written, kept in a list until one equals the day before
// it, which is the answer.
fn one_day(prev: Vec[i64]) -> Vec[i64] {
    let mut day: Vec[i64] = Vec.new();
    for i in 0..prev.len() {
        let first_or_last = i == 0 or i == prev.len() - 1;
        let smaller = not first_or_last and prev[i] < prev[i - 1] and prev[i] < prev[i + 1];
        let bigger = not first_or_last and prev[i] > prev[i - 1] and prev[i] > prev[i + 1];
        if smaller {
            day.push(prev[i] + 1);
        } else if bigger {
            day.push(prev[i] - 1);
        } else {
            day.push(prev[i]);
        }
    }
    day
}

fn literal(arr: Vec[i64]) -> Vec[i64] {
    let mut days: Vec[Vec[i64]] = [arr.clone()];
    loop {
        let day = one_day(days[days.len() - 1].clone());
        if day == days[days.len() - 1] {
            return day;
        }
        days.push(day);
    }
}

fn arms(arr: Vec[i64]) -> Vec[Vec[i64]] {
    [a0_transform_array(arr.clone()), a1_transform_array(arr.clone()), a2_transform_array(arr), a3_transform_array(arr), a4_transform_array(arr)]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["the statement read literally", "one more day changes nothing", "the ends kept, every value within the input's range", "the array reversed gives the answer reversed", "every value raised by 7 gives the answer raised by 7", "the ★ arm's answer"];
    let mut fails = Vec.filled(6, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 12430;
    for case in 0..2000 {
        let (n, top) = match case % 3 {
            0 => (next_random(mut seed) % 10 + 3, 5),
            1 => (next_random(mut seed) % 28 + 13, 100),
            _ => (next_random(mut seed) % 60 + 41, 100),
        };
        let arr: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let want = literal(arr);
        let got = arms(arr);
        let mut back = arr.clone();
        back.reverse();
        let reversed = arms(back);
        let raised = arms(arr.iter().map(|v| v + 7).collect());
        let low = arr.iter().min().unwrap();
        let high = arr.iter().max().unwrap();
        for arm in 0..got.len() {
            let v = got[arm].clone();
            let mut r = reversed[arm].clone();
            r.reverse();
            let held = [
                v == want,
                one_day(v) == v,
                v[0] == arr[0] and v[n - 1] == arr[n - 1] and v.iter().all(|x| x >= low and x <= high),
                r == v,
                raised[arm].iter().zip(v.iter()).all(|(a, b)| a == b + 7) and raised[arm].len() == n,
                v == got[0],
            ];
            for t in 0..6 {
                checks += 1;
                if not held[t] {
                    fails[t] += 1;
                    if fails[t] <= 2 {
                        println(f"P{t + 1} ({names[t]}) fails on arm {arm}: {arr} -> {v}");
                    }
                }
            }
        }
        for x in got[0].iter() {
            check = (check * 131 + x) % 1000000007;
        }
    }
    for t in 0..6 {
        if fails[t] > 0 {
            println(f"P{t + 1}: {fails[t]} failures");
        }
    }
    let failures = fails.iter().sum();
    println(f"2000 cases: checksum {check}, {checks} checks over 5 arms: {failures} failures");
}
