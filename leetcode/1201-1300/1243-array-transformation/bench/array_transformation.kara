// LeetCode #1243: the benchmark -- the ★ arm on 5000 random arrays of 100
// values from 1 to 100, built once, then 10 rounds over them; every
// answer folded into a checksum.

fn transform_array(arr: own Vec[i64]) -> Vec[i64] {
    let mut cur = arr;
    loop {
        let mut next = cur.clone();
        for i in 1..cur.len() - 1 {
            if cur[i] < cur[i - 1] and cur[i] < cur[i + 1] {
                next[i] += 1;
            } else if cur[i] > cur[i - 1] and cur[i] > cur[i + 1] {
                next[i] -= 1;
            }
        }
        if next == cur {
            return cur;
        }
        cur = next;
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1243;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..5000 {
        arrays.push((0..100).map(|_| next_random(mut seed) % 100 + 1).collect());
    }
    let mut check = 0;
    for _ in 0..10 {
        for a in arrays.iter() {
            for v in transform_array(a.clone()).iter() {
                check = (check * 131 + v) % 1000000007;
            }
        }
    }
    println(f"10 rounds of 5000 arrays of 100 values: checksum {check}");
}
