// LeetCode #1243: Array Transformation -- a Rust solution as LeetCode's
// Rust users write it, carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn transform_array(arr: own Vec[i32]) -> Vec[i32] {
        let mut arr = arr;
        loop {
            let prev = arr.clone();
            let mut changed = false;
            for i in 1..arr.len() - 1 {
                if prev[i] < prev[i - 1] and prev[i] < prev[i + 1] {
                    arr[i] += 1;
                    changed = true;
                } else if prev[i] > prev[i - 1] and prev[i] > prev[i + 1] {
                    arr[i] -= 1;
                    changed = true;
                }
            }
            if not changed {
                break;
            }
        }
        arr
    }
}

fn transform_array(arr: Vec[i64]) -> Vec[i64] {
    Solution.transform_array(arr.iter().map(|x| x as i32).collect()).iter().map(|x| x as i64).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{transform_array([6, 2, 3, 4])}");
    println(f"{transform_array([1, 6, 3, 4, 3, 5])}");
    // 1000 random arrays of 3 to 100 values from 1 to 100
    let mut seed = 1243;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 98 + 3;
        let arr: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 100 + 1).collect();
        let got = transform_array(arr);
        for v in got.iter() {
            total += v;
            check = (check * 131 + v) % 1000000007;
        }
    }
    println(f"1000 random arrays: total {total}, checksum {check}");
    // the constraints' top: 100 values alternating 1 and 100, and 100
    // values stepping by 37 around 1 to 100
    let zigzag: Vec[i64] = (0..100).map(|i| if i % 2 == 0 { 1 } else { 100 }).collect();
    let saw: Vec[i64] = (0..100).map(|i| i * 37 % 100 + 1).collect();
    let z = transform_array(zigzag);
    let s = transform_array(saw);
    println(f"zigzag: {z[0]} {z[1]} {z[50]} {z[98]} {z[99]}, by 37: {s[0]} {s[1]} {s[50]} {s[98]} {s[99]}");
}
