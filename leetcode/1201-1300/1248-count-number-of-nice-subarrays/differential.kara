// LeetCode #1248: the differential -- the five arms against the statement
// read literally and four more properties, on 2000 random arrays.

// arm 0: number_of_subarrays.kara
fn a0_number_of_subarrays(nums: Vec[i64], k: i64) -> i64 {
    let mut prefixes: Vec[i64] = Vec.filled(nums.len() + 1, 0);
    prefixes[0] = 1;
    let mut odd = 0;
    let mut nice = 0;
    for v in nums.iter() {
        odd += v % 2;
        if odd >= k {
            nice += prefixes[odd - k];
        }
        prefixes[odd] += 1;
    }
    nice
}

// arm 1: number_of_subarrays_window.kara
fn a1_at_most(nums: Vec[i64], k: i64) -> i64 {
    let mut left = 0;
    let mut odd = 0;
    let mut count = 0;
    for right in 0..nums.len() {
        odd += nums[right] % 2;
        while odd > k {
            odd -= nums[left] % 2;
            left += 1;
        }
        count += right - left + 1;
    }
    count
}

fn a1_number_of_subarrays(nums: Vec[i64], k: i64) -> i64 {
    a1_at_most(nums, k) - a1_at_most(nums, k - 1)
}

// arm 2: number_of_subarrays_gaps.kara
fn a2_number_of_subarrays(nums: Vec[i64], k: i64) -> i64 {
    let mut at: Vec[i64] = [-1];
    for (i, v) in nums.iter().enumerate() {
        if v % 2 == 1 {
            at.push(i);
        }
    }
    at.push(nums.len());
    let mut nice = 0;
    let mut first = 1;
    while first + k < at.len() {
        let last = first + k - 1;
        nice += (at[first] - at[first - 1]) * (at[last + 1] - at[last]);
        first += 1;
    }
    nice
}

// arm 3: number_of_subarrays_map.kara
fn a3_number_of_subarrays(nums: Vec[i64], k: i64) -> i64 {
    let mut seen: Map[i64, i64] = Map.new();
    seen.insert(0, 1);
    let (_, nice) = nums.iter().fold((0, 0), |(odd, nice), v| {
        let odd = odd + v % 2;
        let more = *seen.get(odd - k).unwrap_or(0);
        *seen.entry(odd).or_insert(0) += 1;
        (odd, nice + more)
    });
    nice
}

// arm 4: number_of_subarrays_solution.kara
struct A4Solution {}

impl A4Solution {
    pub fn number_of_subarrays(nums: Vec[i32], k: i32) -> i32 {
        let mut cnt = Vec.filled(nums.len() + 1, 0);
        cnt[0] = 1;
        let mut (odd, ans) = (0, 0);
        for x in nums.iter() {
            odd += (x & 1) as usize;
            if odd >= k as usize {
                ans += cnt[odd - k as usize];
            }
            cnt[odd] += 1;
        }
        ans
    }
}

fn a4_number_of_subarrays(nums: Vec[i64], k: i64) -> i64 {
    A4Solution.number_of_subarrays(nums.iter().map(|v| v as i32).collect(), k as i32)
}

// The statement read literally: every subarray, its odd values counted
// one by one, and those with exactly `k` counted.
fn literal(nums: Vec[i64], k: i64) -> i64 {
    let mut nice = 0;
    for i in 0..nums.len() {
        for j in i..nums.len() {
            let mut odd = 0;
            for t in i..j + 1 {
                if nums[t] % 2 == 1 {
                    odd += 1;
                }
            }
            if odd == k {
                nice += 1;
            }
        }
    }
    nice
}

fn arms(nums: Vec[i64], k: i64) -> Vec[i64] {
    [a0_number_of_subarrays(nums, k), a1_number_of_subarrays(nums, k), a2_number_of_subarrays(nums, k), a3_number_of_subarrays(nums, k), a4_number_of_subarrays(nums, k)]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["the statement read literally", "the array reversed", "each value swapped for another of its parity", "every k together counts every subarray with an odd value", "none past the number of odd values, some up to it", "the ★ arm's answer"];
    let mut fails = Vec.filled(6, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 12480;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 30 + 1;
        let percent = next_random(mut seed) % 101;
        let nums: Vec[i64] = (0..n)
            .map(|_| {
                let v = next_random(mut seed) % 50 + 1;
                if next_random(mut seed) % 100 < percent { 2 * v - 1 } else { 2 * v }
            })
            .collect();
        let odd = nums.iter().filter(|v| v % 2 == 1).count();
        let k = next_random(mut seed) % (odd + 2) + 1;
        let want = literal(nums, k);
        check = (check * 131 + want) % 1000000007;
        let got = arms(nums, k);
        let mut back = nums.clone();
        back.reverse();
        let reversed = arms(back, k);
        let swapped = arms(nums.iter().map(|v| v + 2 * (next_random(mut seed) % 5)).collect(), k);
        // Every subarray less those of even values only, a run of `r`
        // even values holding `r * (r + 1) / 2` of them.
        let mut with_odd = n * (n + 1) / 2;
        let mut run = 0;
        for v in nums.iter() {
            if v % 2 == 0 {
                run += 1;
            } else {
                with_odd -= run * (run + 1) / 2;
                run = 0;
            }
        }
        with_odd -= run * (run + 1) / 2;
        let mut sums = [0, 0, 0, 0, 0];
        for j in 1..odd + 1 {
            let by_k = arms(nums, j);
            for arm in 0..5 {
                sums[arm] += by_k[arm];
            }
        }
        for arm in 0..5 {
            let d = got[arm];
            let held = [
                d == want,
                reversed[arm] == d,
                swapped[arm] == d,
                sums[arm] == with_odd,
                if k > odd { d == 0 } else { d > 0 },
                d == got[0],
            ];
            for t in 0..6 {
                checks += 1;
                if not held[t] {
                    fails[t] += 1;
                    if fails[t] <= 2 {
                        println(f"P{t + 1} ({names[t]}) fails on arm {arm}: {nums} k = {k} -> {d}");
                    }
                }
            }
        }
    }
    let total: i64 = fails.iter().sum();
    for t in 0..6 {
        if fails[t] > 0 {
            print(f"P{t + 1}: {fails[t]} failures ");
        }
    }
    println(f"2000 arrays: checksum {check}, {checks} checks over 5 arms: {total} failures");
}
