// LeetCode #1248: Count Number of Nice Subarrays -- sliding windows: the
// subarrays with at most `k` odd values, counted by a window that keeps
// its left end as far left as it can, less those with at most `k - 1`,
// leaves those with exactly `k`.

fn at_most(nums: Vec[i64], k: i64) -> i64 {
    let mut left = 0;
    let mut odd = 0;
    let mut count = 0;
    for right in 0..nums.len() {
        odd += nums[right] % 2;
        while odd > k {
            odd -= nums[left] % 2;
            left += 1;
        }
        count += right - left + 1;
    }
    count
}

fn number_of_subarrays(nums: Vec[i64], k: i64) -> i64 {
    at_most(nums, k) - at_most(nums, k - 1)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    let a = number_of_subarrays([1, 1, 2, 1, 1], 3);
    let b = number_of_subarrays([2, 4, 6], 1);
    let c = number_of_subarrays([2, 2, 2, 1, 2, 2, 1, 2, 2, 2], 2);
    println(f"{a} {b} {c}");
    // 1000 random arrays of 1 to 2000 values from 1 to 100000, each with
    // its own chance of an odd value, and `k` from 1 to a little past the
    // number of odd values
    let mut seed = 1248;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 2000 + 1;
        let percent = next_random(mut seed) % 101;
        let nums: Vec[i64] = (0..n)
            .map(|_| {
                let v = next_random(mut seed) % 50000 + 1;
                if next_random(mut seed) % 100 < percent { 2 * v - 1 } else { 2 * v }
            })
            .collect();
        let odd = nums.iter().filter(|v| v % 2 == 1).count();
        let k = next_random(mut seed) % (odd + 2) + 1;
        let nice = number_of_subarrays(nums, k);
        total += nice;
        check = (check * 131 + nice) % 1000000007;
    }
    println(f"1000 random arrays: total {total}, checksum {check}");
    // the constraints' top: 50000 odd values with k = 1 and k = 25000, and
    // 50000 values with one odd value in the middle
    let odd: Vec[i64] = (0..50000).map(|i| 2 * i + 1).collect();
    let one: Vec[i64] = (0..50000).map(|i| if i == 25000 { 1 } else { 2 }).collect();
    let x = number_of_subarrays(odd, 1);
    let y = number_of_subarrays(odd, 25000);
    let z = number_of_subarrays(one, 1);
    println(f"50000 values: all odd, k = 1 {x}, k = 25000 {y}; one odd {z}");
}
