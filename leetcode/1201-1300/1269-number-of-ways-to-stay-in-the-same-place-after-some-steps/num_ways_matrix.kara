// LeetCode #1269: Number of Ways to Stay in the Same Place After Some Steps
// -- by matrix powers: one step is a tridiagonal matrix of ones over the
// reachable cells, and the answer is the top-left entry of its `steps`-th
// power, by repeated squaring. O(w^3 log steps), w = min(steps / 2 + 1,
// arrLen).

const MOD: i64 = 1000000007;

fn multiply(a: Vec[Vec[i64]], b: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let n = a.len();
    let mut c: Vec[Vec[i64]] = (0..n).map(|_| Vec.filled(n, 0)).collect();
    for i in 0..n {
        for k in 0..n {
            if a[i][k] == 0 {
                continue;
            }
            for j in 0..n {
                c[i][j] = (c[i][j] + a[i][k] * b[k][j]) % MOD;
            }
        }
    }
    c
}

fn num_ways(steps: i64, arr_len: i64) -> i64 {
    let w = arr_len.min(steps / 2 + 1);
    let mut step: Vec[Vec[i64]] = (0..w).map(|i| (0..w).map(|j| if (i - j).abs() <= 1 { 1 } else { 0 }).collect()).collect();
    let mut power: Vec[Vec[i64]] = (0..w).map(|i| (0..w).map(|j| if i == j { 1 } else { 0 }).collect()).collect();
    let mut e = steps;
    while e > 0 {
        if e % 2 == 1 {
            power = multiply(power, step);
        }
        step = multiply(step, step);
        e /= 2;
    }
    power[0][0]
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's examples
    println(f"{num_ways(3, 2)} {num_ways(2, 4)} {num_ways(4, 2)} {num_ways(27, 7)}");
    // 2000 random cases: 1 to 100 steps, an array of 1 to 60 cells or wider
    // than the steps can reach
    let mut seed = 1269;
    let mut check = 0;
    for case in 0..2000 {
        let steps = next_random(mut seed) % 100 + 1;
        let arr_len = if case % 4 == 0 { 1000000 } else { next_random(mut seed) % 60 + 1 };
        check = (check * 131 + num_ways(steps, arr_len)) % 1000000007;
    }
    println(f"2000 random cases: checksum {check}");
    // the constraints' top: 500 steps in the widest array, and in narrow ones
    println(f"{num_ways(500, 1000000)} {num_ways(500, 1)} {num_ways(500, 2)} {num_ways(500, 3)} {num_ways(430, 148488)}");
}
