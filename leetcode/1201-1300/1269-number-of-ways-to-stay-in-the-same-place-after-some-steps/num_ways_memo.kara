// LeetCode #1269: Number of Ways to Stay in the Same Place After Some Steps
// -- by memoised recursion: the ways home from cell `at` with `left` steps
// to go are the ways after staying, going left and going right; a cell
// farther than the steps left is a dead end. The memo is a table by steps
// left and cell. O(steps * min(steps, arrLen)).

const MOD: i64 = 1000000007;

fn ways_home(at: i64, left: i64, arr_len: i64, memo: mut ref Vec[Vec[i64]]) -> i64 {
    if at < 0 or at >= arr_len or at > left {
        return 0;
    }
    if left == 0 {
        return 1;
    }
    if memo[left][at] >= 0 {
        return memo[left][at];
    }
    let ways = (ways_home(at, left - 1, arr_len, mut memo)
        + ways_home(at - 1, left - 1, arr_len, mut memo)
        + ways_home(at + 1, left - 1, arr_len, mut memo))
        % MOD;
    memo[left][at] = ways;
    ways
}

fn num_ways(steps: i64, arr_len: i64) -> i64 {
    let width = arr_len.min(steps + 1);
    let mut memo: Vec[Vec[i64]] = (0..steps + 1).map(|_| Vec.filled(width, -1)).collect();
    ways_home(0, steps, arr_len, mut memo)
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's examples
    println(f"{num_ways(3, 2)} {num_ways(2, 4)} {num_ways(4, 2)} {num_ways(27, 7)}");
    // 2000 random cases: 1 to 100 steps, an array of 1 to 60 cells or wider
    // than the steps can reach
    let mut seed = 1269;
    let mut check = 0;
    for case in 0..2000 {
        let steps = next_random(mut seed) % 100 + 1;
        let arr_len = if case % 4 == 0 { 1000000 } else { next_random(mut seed) % 60 + 1 };
        check = (check * 131 + num_ways(steps, arr_len)) % 1000000007;
    }
    println(f"2000 random cases: checksum {check}");
    // the constraints' top: 500 steps in the widest array, and in narrow ones
    println(f"{num_ways(500, 1000000)} {num_ways(500, 1)} {num_ways(500, 2)} {num_ways(500, 3)} {num_ways(430, 148488)}");
}
