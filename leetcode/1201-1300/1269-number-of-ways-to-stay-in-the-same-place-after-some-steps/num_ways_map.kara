// LeetCode #1269: Number of Ways to Stay in the Same Place After Some Steps
// -- by a walker that remembers: a struct holding the array's length and a
// `Map` from (cell, steps left) to the ways home, its method recursing on
// the three moves. O(steps * min(steps, arrLen)) map entries.

struct Walker {
    arr_len: i64,
    memo: Map[(i64, i64), i64],
}

impl Walker {
    fn ways_home(mut ref self, at: i64, left: i64) -> i64 {
        if at < 0 or at >= self.arr_len or at > left {
            return 0;
        }
        if left == 0 {
            return 1;
        }
        if let Some(w) = self.memo.get((at, left)) {
            return w;
        }
        let mut ways = 0;
        for next in [at - 1, at, at + 1] {
            ways = (ways + self.ways_home(next, left - 1)) % 1000000007;
        }
        self.memo.insert((at, left), ways);
        ways
    }
}

fn num_ways(steps: i64, arr_len: i64) -> i64 {
    let mut walker = Walker { arr_len: arr_len, memo: Map.new() };
    walker.ways_home(0, steps)
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's examples
    println(f"{num_ways(3, 2)} {num_ways(2, 4)} {num_ways(4, 2)} {num_ways(27, 7)}");
    // 2000 random cases: 1 to 100 steps, an array of 1 to 60 cells or wider
    // than the steps can reach
    let mut seed = 1269;
    let mut check = 0;
    for case in 0..2000 {
        let steps = next_random(mut seed) % 100 + 1;
        let arr_len = if case % 4 == 0 { 1000000 } else { next_random(mut seed) % 60 + 1 };
        check = (check * 131 + num_ways(steps, arr_len)) % 1000000007;
    }
    println(f"2000 random cases: checksum {check}");
    // the constraints' top: 500 steps in the widest array, and in narrow ones
    println(f"{num_ways(500, 1000000)} {num_ways(500, 1)} {num_ways(500, 2)} {num_ways(500, 3)} {num_ways(430, 148488)}");
}
