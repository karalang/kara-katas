// LeetCode #1269 bench, in Kāra: the ★ arm (the ways to stand on each of
// the first `steps / 2 + 1` cells, a new row per step) on 1000 random cases
// of 1 to 500 steps in 1 to 400 cells or a million, drawn once, 20 rounds;
// every answer folded into a checksum.

const MOD: i64 = 1000000007;

fn num_ways(steps: i64, arr_len: i64) -> i64 {
    let width = arr_len.min(steps / 2 + 1);
    let mut ways = Vec.filled(width, 0);
    ways[0] = 1;
    for _ in 0..steps {
        let mut next = Vec.filled(width, 0);
        for i in 0..width {
            let mut w = ways[i];
            if i > 0 {
                w += ways[i - 1];
            }
            if i + 1 < width {
                w += ways[i + 1];
            }
            next[i] = w % MOD;
        }
        ways = next;
    }
    ways[0]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1269;
    let mut cases: Vec[(i64, i64)] = Vec.new();
    for c in 0..1000 {
        let steps = next_random(mut seed) % 500 + 1;
        let arr_len = if c % 4 == 0 { 1000000 } else { next_random(mut seed) % 400 + 1 };
        cases.push((steps, arr_len));
    }
    let mut check = 0;
    for round in 0..20 {
        for (steps, arr_len) in cases.iter() {
            check = (check * 131 + num_ways(steps, arr_len) + round) % 1000000007;
        }
    }
    println(f"20 rounds of 1000 cases: checksum {check}");
}
