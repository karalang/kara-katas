// LeetCode #1213 bench: the ★ arm (three pointers, all three stepping on
// when the values agree and otherwise only those at the least value) on
// 1000 triples of arrays drawn once, each array keeping every value from 1
// to 2000 with its own chance, from 33 to 44 in 100, so 600 to 950 values,
// near the constraints' most of 1000; then 10 rounds over the triples,
// every answer's length and last value folded into a checksum.

fn arrays_intersection(arr1: Vec[i64], arr2: Vec[i64], arr3: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut (i, j, k) = (0, 0, 0);
    while i < arr1.len() and j < arr2.len() and k < arr3.len() {
        let (a, b, c) = (arr1[i], arr2[j], arr3[k]);
        if a == b and b == c {
            out.push(a);
            i += 1;
            j += 1;
            k += 1;
        } else {
            let least = a.min(b).min(c);
            if a == least {
                i += 1;
            }
            if b == least {
                j += 1;
            }
            if c == least {
                k += 1;
            }
        }
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_sorted(seed: mut ref i64, percent: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for v in 1..=2000 {
        if next_random(mut seed) % 100 < percent {
            out.push(v);
        }
    }
    out
}

fn main() {
    let mut seed = 1213;
    let mut triples: Vec[(Vec[i64], Vec[i64], Vec[i64])] = Vec.new();
    for _ in 0..1000 {
        let a = random_sorted(mut seed, 33 + next_random(mut seed) % 12);
        let b = random_sorted(mut seed, 33 + next_random(mut seed) % 12);
        let c = random_sorted(mut seed, 33 + next_random(mut seed) % 12);
        triples.push((a, b, c));
    }
    let mut check = 0;
    for round in 0..10 {
        for (a, b, c) in triples.iter() {
            let answer = arrays_intersection(a, b, c);
            let last = if answer.is_empty() { 0 } else { answer[answer.len() - 1] };
            check = (check * 131 + answer.len() + last + round) % 1000000007;
        }
    }
    println(f"10 rounds over 1000 triples of 600 to 950 values: checksum {check}");
}
