// LeetCode #1213: Intersection of Three Sorted Arrays -- binary search: for
// each value of the first array, a search by halving in each of the other
// two, which only ever looks to the right of where its last search ended,
// since the values come in rising order. O(n1 log(n2 + n3)).

// The first index at or after `from` whose value is at least `v`.
fn lower_bound(arr: Vec[i64], from: i64, v: i64) -> i64 {
    let mut low = from;
    let mut high = arr.len();
    while low < high {
        let mid = (low + high) / 2;
        if arr[mid] < v {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    low
}

fn arrays_intersection(arr1: Vec[i64], arr2: Vec[i64], arr3: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut j = 0;
    let mut k = 0;
    for v in arr1.iter() {
        j = lower_bound(arr2, j, v);
        k = lower_bound(arr3, k, v);
        if j == arr2.len() or k == arr3.len() {
            break;
        }
        if arr2[j] == v and arr3[k] == v {
            out.push(v);
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// each value from 1 to `top` kept with chance `percent` in 100: strictly
// increasing, and never empty
fn random_sorted(seed: mut ref i64, top: i64, percent: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for v in 1..=top {
        if next_random(mut seed) % 100 < percent {
            out.push(v);
        }
    }
    if out.is_empty() {
        out.push(next_random(mut seed) % top + 1);
    }
    out
}

fn main() {
    let cases: Vec[(Vec[i64], Vec[i64], Vec[i64])] = [
        ([1, 2, 3, 4, 5], [1, 2, 5, 7, 9], [1, 3, 4, 5, 8]),
        ([197, 418, 523, 876, 1356], [501, 880, 1593, 1710, 1870], [521, 682, 1337, 1395, 1764]),
        ([1], [1], [1]),
        ([1], [2], [1]),
        ([1, 2, 3], [1, 2, 3], [1, 2, 3]),
        ([2000], [1, 2000], [1, 1000, 2000]),
        ([1, 3, 5, 7], [2, 4, 6, 8], [1, 2, 3, 4, 5, 6, 7, 8]),
    ];
    for (a, b, c) in cases.iter() {
        println(f"{a} {b} {c}: {arrays_intersection(a, b, c)}");
    }
    let mut seed = 1213;
    let mut kept = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let top = next_random(mut seed) % 20 + 1;
        let a = random_sorted(mut seed, top, next_random(mut seed) % 100);
        let b = random_sorted(mut seed, top, next_random(mut seed) % 100);
        let c = random_sorted(mut seed, top, next_random(mut seed) % 100);
        let answer = arrays_intersection(a, b, c);
        kept += answer.len();
        for v in answer.iter() {
            check = (check * 131 + v) % 1000000007;
        }
        check = (check * 131 + answer.len()) % 1000000007;
    }
    println(f"1000 small cases: {kept} values kept, checksum {check}");
    // The constraints' top: up to 1000 values each, from 1 to 2000.
    let a = random_sorted(mut seed, 2000, 45);
    let b = random_sorted(mut seed, 2000, 45);
    let c = random_sorted(mut seed, 2000, 45);
    let answer = arrays_intersection(a, b, c);
    println(f"{a.len()}, {b.len()} and {c.len()} of 1 to 2000: {answer.len()} kept, the first {answer[0]}, the last {answer[answer.len() - 1]}");
    let evens: Vec[i64] = (1..=1000).map(|v| 2 * v).collect();
    let odds: Vec[i64] = (0..1000).map(|v| 2 * v + 1).collect();
    let all: Vec[i64] = (1001..=2000).collect();
    println(f"1000 evens, 1000 odds, 1001 to 2000: {arrays_intersection(evens, odds, all).len()} kept");
    println(f"1000 evens three times over: {arrays_intersection(evens, evens, evens).len()} kept");
    println(f"1000 evens, 1001 to 2000 twice: {arrays_intersection(evens, all, all).len()} kept");
}
