// LeetCode #1289 bench: the ★ arm (the row above's two smallest path sums)
// on 100 grids of 200 by 200, built once, 300 rounds, every answer folded
// into a checksum.

fn min_falling_path_sum(grid: Vec[Vec[i64]]) -> i64 {
    // (smallest sum, its column, second smallest sum) over the row above
    let mut first = 0;
    let mut first_col = -1;
    let mut second = 0;
    for row in grid.iter() {
        let mut next_first = i64.MAX;
        let mut next_col = -1;
        let mut next_second = i64.MAX;
        for (j, x) in row.iter().enumerate() {
            let sum = x + if j == first_col { second } else { first };
            if sum < next_first {
                next_second = next_first;
                next_first = sum;
                next_col = j;
            } else if sum < next_second {
                next_second = sum;
            }
        }
        first = next_first;
        first_col = next_col;
        second = next_second;
    }
    first
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn problem(seed: mut ref i64, n: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(next_random(mut *seed) % 199 - 99);
        }
        grid.push(row);
    }
    grid
}

fn main() {
    let mut seed = 1289;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..100 {
        grids.push(problem(mut seed, 200));
    }
    let mut check = 0;
    for round in 0..300 {
        for grid in grids.iter() {
            check = (check * 131 + min_falling_path_sum(grid) + round + 1000000) % 1000000007;
        }
    }
    println(f"300 rounds of 100 grids of 200 by 200: checksum {check}");
}
