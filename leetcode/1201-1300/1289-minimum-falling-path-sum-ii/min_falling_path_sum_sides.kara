// LeetCode #1289: Minimum Falling Path Sum II -- by prefix and suffix
// minima: the least of the row above outside column j is the smaller of
// the least to its left and the least to its right, each a running
// minimum built once per row. O(n^2)

fn min_falling_path_sum(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut best: Vec[i64] = grid[0].clone();
    for i in 1..n {
        let mut left: Vec[i64] = Vec.filled(n + 1, i64.MAX);
        let mut right: Vec[i64] = Vec.filled(n + 1, i64.MAX);
        for j in 0..n {
            left[j + 1] = left[j].min(best[j]);
        }
        for j in (0..n).rev() {
            right[j] = right[j + 1].min(best[j]);
        }
        best = (0..n).map(|j| grid[i][j] + left[j].min(right[j + 1])).collect();
    }
    best.iter().cloned().min().unwrap()
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn problem(seed: mut ref i64, n: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(next_random(mut *seed) % 199 - 99);
        }
        grid.push(row);
    }
    grid
}

fn main() {
    // LeetCode's examples, and a tie for the smallest in every row
    println(f"{min_falling_path_sum([[1, 2, 3], [4, 5, 6], [7, 8, 9]])} {min_falling_path_sum([[7]])} {min_falling_path_sum([[1, 1], [1, 1]])} {min_falling_path_sum([[-5, -5, 3], [-5, 2, -5], [0, -5, -5]])}");
    // 300 random grids up to 30 by 30, then 3 of 200 by 200
    let mut seed = 1289;
    let mut total = 0;
    let mut check = 0;
    for case in 0..303 {
        let n = if case < 300 { next_random(mut seed) % 30 + 1 } else { 200 };
        let best = min_falling_path_sum(problem(mut seed, n));
        total += best;
        check = (check * 131 + best + 1000000) % 1000000007;
    }
    println(f"303 random grids: total {total}, checksum {check}");
}
