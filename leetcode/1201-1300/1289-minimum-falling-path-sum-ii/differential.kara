// LeetCode #1289: the differential -- the five arms against the statement
// read literally and five more properties, on 2000 random grids.

// arm 0: min_falling_path_sum.kara
fn a0_min_falling_path_sum(grid: Vec[Vec[i64]]) -> i64 {
    // (smallest sum, its column, second smallest sum) over the row above
    let mut first = 0;
    let mut first_col = -1;
    let mut second = 0;
    for row in grid.iter() {
        let mut next_first = i64.MAX;
        let mut next_col = -1;
        let mut next_second = i64.MAX;
        for (j, x) in row.iter().enumerate() {
            let sum = x + if j == first_col { second } else { first };
            if sum < next_first {
                next_second = next_first;
                next_first = sum;
                next_col = j;
            } else if sum < next_second {
                next_second = sum;
            }
        }
        first = next_first;
        first_col = next_col;
        second = next_second;
    }
    first
}

// arm 1: min_falling_path_sum_cubic.kara
fn a1_min_falling_path_sum(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut best: Vec[i64] = grid[0].clone();
    for i in 1..n {
        let mut next: Vec[i64] = Vec.filled(n, 0);
        for j in 0..n {
            let mut least = i64.MAX;
            for k in 0..n {
                if k != j {
                    least = least.min(best[k]);
                }
            }
            next[j] = grid[i][j] + least;
        }
        best = next;
    }
    *best.iter().min().unwrap()
}

// arm 2: min_falling_path_sum_sides.kara
fn a2_min_falling_path_sum(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut best: Vec[i64] = grid[0].clone();
    for i in 1..n {
        let mut left: Vec[i64] = Vec.filled(n + 1, i64.MAX);
        let mut right: Vec[i64] = Vec.filled(n + 1, i64.MAX);
        for j in 0..n {
            left[j + 1] = left[j].min(best[j]);
        }
        for j in (0..n).rev() {
            right[j] = right[j + 1].min(best[j]);
        }
        best = (0..n).map(|j| grid[i][j] + left[j].min(right[j + 1])).collect();
    }
    best.iter().cloned().min().unwrap()
}

// arm 3: min_falling_path_sum_memo.kara
fn a3_from(grid: Vec[Vec[i64]], row: i64, col: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if row == grid.len() - 1 {
        return grid[row][col];
    }
    if let Some(known) = memo.get((row, col)) {
        return *known;
    }
    let mut least = i64.MAX;
    for next in 0..grid.len() {
        if next != col {
            least = least.min(a3_from(grid, row + 1, next, mut memo));
        }
    }
    let best = grid[row][col] + least;
    memo.insert((row, col), best);
    best
}

fn a3_min_falling_path_sum(grid: Vec[Vec[i64]]) -> i64 {
    let mut memo: Map[(i64, i64), i64] = Map.new();
    (0..grid.len()).map(|col| a3_from(grid, 0, col, mut memo)).min().unwrap()
}

// arm 4: min_falling_path_sum_solution.kara
impl A4Solution {
    pub fn min_falling_path_sum(grid: Vec[Vec[i32]]) -> i32 {
        let n = grid.len();
        let mut dp = grid[0].clone();
        for i in 1..n {
            let mut ndp = Vec.filled(n, i32.MAX);
            for j in 0..n {
                for k in 0..n {
                    if k != j {
                        ndp[j] = ndp[j].min(dp[k] + grid[i][j]);
                    }
                }
            }
            dp = ndp;
        }
        *dp.iter().min().unwrap()
    }
}

struct A4Solution {}

fn a4_min_falling_path_sum(grid: Vec[Vec[i64]]) -> i64 {
    let small: Vec[Vec[i32]] = grid.iter().map(|row| row.iter().map(|x| *x as i32).collect()).collect();
    A4Solution.min_falling_path_sum(small)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// ---- the differential ------------------------------------------------------

fn arm(k: i64, grid: Vec[Vec[i64]]) -> i64 {
    match k {
        0 => a0_min_falling_path_sum(grid),
        1 => a1_min_falling_path_sum(grid),
        2 => a2_min_falling_path_sum(grid),
        3 => a3_min_falling_path_sum(grid),
        _ => a4_min_falling_path_sum(grid),
    }
}

// The statement read literally: every way to choose one column in each
// row, no two neighbouring rows in the same column, summed; the least.
fn every_path(grid: Vec[Vec[i64]], row: i64, last: i64, sum: i64, least: mut ref i64) {
    if row == grid.len() {
        if sum < *least {
            *least = sum;
        }
        return;
    }
    for col in 0..grid.len() {
        if col != last {
            every_path(grid, row + 1, col, sum + grid[row][col], mut least);
        }
    }
}

fn literal(grid: Vec[Vec[i64]]) -> i64 {
    let mut least = i64.MAX;
    every_path(grid, 0, -1, 0, mut least);
    least
}

fn problem(seed: mut ref i64, n: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(next_random(mut *seed) % 199 - 99);
        }
        grid.push(row);
    }
    grid
}

fn main() {
    let mut seed = 12890;
    let mut fails: Array[i64, 6] = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 5 + 1;
        let grid = problem(mut seed, n);
        let want = literal(grid);
        let c = next_random(mut seed) % 21 - 10;
        let raised: Vec[Vec[i64]] = grid.iter().map(|row| row.iter().map(|x| x + c).collect()).collect();
        // one permutation of the columns, the same for every row
        let mut order: Vec[i64] = (0..n).collect();
        let mut i = n - 1;
        while i > 0 {
            let j = next_random(mut seed) % (i + 1);
            order.swap(i, j);
            i -= 1;
        }
        let shuffled: Vec[Vec[i64]] = grid.iter().map(|row| order.iter().map(|k| row[*k]).collect()).collect();
        let upside_down: Vec[Vec[i64]] = grid.iter().rev().cloned().collect();
        let r = next_random(mut seed) % n;
        let mut one_row = grid.clone();
        for x in one_row[r].iter_mut() {
            *x += c;
        }
        let star = arm(0, grid);
        check = (check * 131 + star + 1000000) % 1000000007;
        for a in 0..5 {
            let got = arm(a, grid);
            let held = [
                got == want,
                arm(a, raised) == got + n * c,
                arm(a, shuffled) == got,
                arm(a, upside_down) == got,
                arm(a, one_row) == got + c,
                got == star,
            ];
            for p in 0..6 {
                checks += 1;
                if not held[p] {
                    fails[p] += 1;
                }
            }
        }
    }
    let mut total = 0;
    for p in 0..6 {
        if fails[p] > 0 {
            print(f"P{p + 1}: {fails[p]} failures ");
        }
        total += fails[p];
    }
    println(f"2000 grids: checksum {check}, {checks} checks over 5 arms: {total} failures");
}
