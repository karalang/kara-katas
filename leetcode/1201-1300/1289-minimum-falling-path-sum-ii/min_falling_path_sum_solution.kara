// LeetCode #1289: Minimum Falling Path Sum II -- a Rust solution as
// LeetCode's Rust users write it (a `dp` row cloned from the grid's first,
// a fresh `vec![i32::MAX; n]` per row filled by a triple loop, and
// `*dp.iter().min().unwrap()`), carried to Kāra by `karac fix`.

impl Solution {
    pub fn min_falling_path_sum(grid: Vec[Vec[i32]]) -> i32 {
        let n = grid.len();
        let mut dp = grid[0].clone();
        for i in 1..n {
            let mut ndp = Vec.filled(n, i32.MAX);
            for j in 0..n {
                for k in 0..n {
                    if k != j {
                        ndp[j] = ndp[j].min(dp[k] + grid[i][j]);
                    }
                }
            }
            dp = ndp;
        }
        *dp.iter().min().unwrap()
    }
}

struct Solution {}

// The harness's grid, handed over as LeetCode's `Vec<Vec<i32>>`.
fn min_falling_path_sum(grid: Vec[Vec[i64]]) -> i64 {
    let small: Vec[Vec[i32]] = grid.iter().map(|row| row.iter().map(|x| *x as i32).collect()).collect();
    Solution.min_falling_path_sum(small)
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn problem(seed: mut ref i64, n: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(next_random(mut *seed) % 199 - 99);
        }
        grid.push(row);
    }
    grid
}

fn main() {
    // LeetCode's examples, and a tie for the smallest in every row
    println(f"{min_falling_path_sum([[1, 2, 3], [4, 5, 6], [7, 8, 9]])} {min_falling_path_sum([[7]])} {min_falling_path_sum([[1, 1], [1, 1]])} {min_falling_path_sum([[-5, -5, 3], [-5, 2, -5], [0, -5, -5]])}");
    // 300 random grids up to 30 by 30, then 3 of 200 by 200
    let mut seed = 1289;
    let mut total = 0;
    let mut check = 0;
    for case in 0..303 {
        let n = if case < 300 { next_random(mut seed) % 30 + 1 } else { 200 };
        let best = min_falling_path_sum(problem(mut seed, n));
        total += best;
        check = (check * 131 + best + 1000000) % 1000000007;
    }
    println(f"303 random grids: total {total}, checksum {check}");
}
