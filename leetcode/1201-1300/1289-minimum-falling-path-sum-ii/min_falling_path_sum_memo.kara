// LeetCode #1289: Minimum Falling Path Sum II -- by memoised recursion
// from the top: the best sum from (row, col) down is the cell plus the
// best from any other column of the next row, each answer kept in a
// `Map` keyed by (row, col). O(n^3)

fn from(grid: Vec[Vec[i64]], row: i64, col: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if row == grid.len() - 1 {
        return grid[row][col];
    }
    if let Some(known) = memo.get((row, col)) {
        return *known;
    }
    let mut least = i64.MAX;
    for next in 0..grid.len() {
        if next != col {
            least = least.min(from(grid, row + 1, next, mut memo));
        }
    }
    let best = grid[row][col] + least;
    memo.insert((row, col), best);
    best
}

fn min_falling_path_sum(grid: Vec[Vec[i64]]) -> i64 {
    let mut memo: Map[(i64, i64), i64] = Map.new();
    (0..grid.len()).map(|col| from(grid, 0, col, mut memo)).min().unwrap()
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn problem(seed: mut ref i64, n: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(next_random(mut *seed) % 199 - 99);
        }
        grid.push(row);
    }
    grid
}

fn main() {
    // LeetCode's examples, and a tie for the smallest in every row
    println(f"{min_falling_path_sum([[1, 2, 3], [4, 5, 6], [7, 8, 9]])} {min_falling_path_sum([[7]])} {min_falling_path_sum([[1, 1], [1, 1]])} {min_falling_path_sum([[-5, -5, 3], [-5, 2, -5], [0, -5, -5]])}");
    // 300 random grids up to 30 by 30, then 3 of 200 by 200
    let mut seed = 1289;
    let mut total = 0;
    let mut check = 0;
    for case in 0..303 {
        let n = if case < 300 { next_random(mut seed) % 30 + 1 } else { 200 };
        let best = min_falling_path_sum(problem(mut seed, n));
        total += best;
        check = (check * 131 + best + 1000000) % 1000000007;
    }
    println(f"303 random grids: total {total}, checksum {check}");
}
