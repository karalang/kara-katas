// LeetCode #1226: The Dining Philosophers -- a `Mutex` for each fork, and
// backing off: a philosopher waits for the left fork, then only tries the
// right one, and when it is taken puts the left one back, yields the
// processor (`sleep(Duration.ms(0))`) and starts again. Nobody holds one
// fork while waiting for the other, so nobody waits forever.

import std.sync.{Mutex, TaskGroup};
import std.time.{Duration, sleep};

sync struct DiningPhilosophers {
    forks: Vec[Mutex[i64]],
}

impl DiningPhilosophers {
    fn new() -> DiningPhilosophers {
        DiningPhilosophers { forks: (0..5).map(|_| Mutex.new(0)).collect() }
    }

    fn wants_to_eat(
        self,
        philosopher: i64,
        pick_left_fork: Fn(),
        pick_right_fork: Fn(),
        eat: Fn(),
        put_left_fork: Fn(),
        put_right_fork: Fn(),
    ) {
        let left = philosopher;
        let right = (philosopher + 4) % 5;
        loop {
            let _left = self.forks[left].lock();
            if let Some(_right) = self.forks[right].try_lock() {
                pick_left_fork();
                pick_right_fork();
                eat();
                put_left_fork();
                put_right_fork();
                return;
            }
            drop(_left);
            sleep(Duration.ms(0));
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// LeetCode's run: five tasks share one `DiningPhilosophers`, philosopher
// `p`'s task calling `wants_to_eat` `n` times with callbacks that append
// `[p, fork, operation]` to the log (fork 1 left, 2 right, 0 for eating;
// operation 1 pick, 2 put, 3 eat); `order` is the order the five tasks
// are started in. Returns the log, in the order the calls were made.
fn run(n: i64, order: Vec[i64]) -> Vec[(i64, i64, i64)] {
    let table = DiningPhilosophers.new();
    let log: Mutex[Vec[(i64, i64, i64)]] = Mutex.new([]);
    {
        let group = TaskGroup.new();
        for p in order.iter() {
            group.spawn(|| {
                for _ in 0..n {
                    table.wants_to_eat(
                        p,
                        || log.lock().value.push((p, 1, 1)),
                        || log.lock().value.push((p, 2, 1)),
                        || log.lock().value.push((p, 0, 3)),
                        || log.lock().value.push((p, 1, 2)),
                        || log.lock().value.push((p, 2, 2)),
                    );
                }
            });
        }
    }
    log.lock().value.clone()
}

// The statement read literally: replays the log on five forks. A fork is
// picked up only when it lies on the table and put down only by whoever
// holds it, a philosopher eats only holding both their forks, every
// philosopher eats `n` times, and every fork is back on the table at the
// end. Returns the first broken rule, or "valid".
fn judge(n: i64, log: Vec[(i64, i64, i64)]) -> String {
    let mut holder = Vec.filled(5, -1);
    let mut meals = Vec.filled(5, 0);
    for (p, fork, op) in log.iter() {
        let f = if fork == 1 { p } else { (p + 4) % 5 };
        if op == 1 {
            if holder[f] != -1 {
                return f"philosopher {p} picks up fork {f}, held by {holder[f]}";
            }
            holder[f] = p;
        } else if op == 2 {
            if holder[f] != p {
                return f"philosopher {p} puts down fork {f}, not holding it";
            }
            holder[f] = -1;
        } else {
            if holder[p] != p or holder[(p + 4) % 5] != p {
                return f"philosopher {p} eats without both forks";
            }
            meals[p] += 1;
        }
    }
    if meals.iter().any(|m| m != n) {
        return f"meals {meals}";
    }
    if holder.iter().any(|h| h != -1) {
        return f"forks left held {holder}";
    }
    "valid"
}

fn main() {
    // LeetCode's example output for n = 1, judged
    let example = [(4, 2, 1), (4, 1, 1), (0, 1, 1), (2, 2, 1), (2, 1, 1), (2, 0, 3), (2, 1, 2), (2, 2, 2), (4, 0, 3), (4, 1, 2), (0, 2, 1), (4, 2, 2), (3, 2, 1), (3, 1, 1), (0, 0, 3), (0, 1, 2), (0, 2, 2), (1, 2, 1), (1, 1, 1), (3, 0, 3), (3, 1, 2), (3, 2, 2), (1, 0, 3), (1, 1, 2), (1, 2, 2)];
    println(f"LeetCode's example: {example.len()} calls, {judge(1, example)}");
    // LeetCode's example, n = 1, and its largest, n = 60
    for n in [1, 2, 60] {
        let log = run(n, [0, 1, 2, 3, 4]);
        println(f"n={n}: {log.len()} calls, {judge(n, log)}");
    }
    // 1000 random runs: n from 1 to 60, the five tasks started in a random
    // order
    let mut seed = 1226;
    let mut calls = 0;
    let mut valid = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 60 + 1;
        let mut order = [0, 1, 2, 3, 4];
        for i in (1..5).rev() {
            let j = next_random(mut seed) % (i + 1);
            order.swap(i, j);
        }
        let log = run(n, order);
        calls += log.len();
        if judge(n, log) == "valid" {
            valid += 1;
        }
    }
    println(f"1000 random runs: {calls} calls, {valid} valid");
}
