// ---- arm 2: butler ------------------------------------------------------
sync struct A2DiningPhilosophers {
    seats: Semaphore,
    forks: Vec[Semaphore],
}

impl A2DiningPhilosophers {
    fn new() -> A2DiningPhilosophers {
        A2DiningPhilosophers {
            seats: Semaphore.new(4),
            forks: (0..5).map(|_| Semaphore.new(1)).collect(),
        }
    }

    fn wants_to_eat(
        self,
        philosopher: i64,
        pick_left_fork: Fn(),
        pick_right_fork: Fn(),
        eat: Fn(),
        put_left_fork: Fn(),
        put_right_fork: Fn(),
    ) {
        let left = philosopher;
        let right = (philosopher + 4) % 5;
        let _ = self.seats.acquire(60000);
        let _ = self.forks[left].acquire(60000);
        pick_left_fork();
        let _ = self.forks[right].acquire(60000);
        pick_right_fork();
        eat();
        put_left_fork();
        self.forks[left].release();
        put_right_fork();
        self.forks[right].release();
        self.seats.release();
    }
}

