    let table = A2DiningPhilosophers.new();
    let log: Mutex[Vec[(i64, i64, i64)]] = Mutex.new([]);
    {
        let group = TaskGroup.new();
        for p in order.iter() {
            group.spawn(|| {
                for _ in 0..n {
                    table.wants_to_eat(
                        p,
                        || {
                            log.lock().value.push((p, 1, 1));
                            sleep(Duration.ms(0));
                        },
                        || {
                            log.lock().value.push((p, 2, 1));
                            sleep(Duration.ms(0));
                        },
                        || {
                            log.lock().value.push((p, 0, 3));
                            sleep(Duration.ms(0));
                        },
                        || {
                            sleep(Duration.ms(0));
                            log.lock().value.push((p, 1, 2));
                        },
                        || {
                            sleep(Duration.ms(0));
                            log.lock().value.push((p, 2, 2));
                        },
                    );
                }
            });
        }
    }
    log.lock().value.clone()
}

// ---- arm 3: lefty -------------------------------------------------------
sync struct A3DiningPhilosophers {
    forks: Vec[Mutex[i64]],
}

impl A3DiningPhilosophers {
    fn new() -> A3DiningPhilosophers {
        A3DiningPhilosophers { forks: (0..5).map(|_| Mutex.new(0)).collect() }
    }

    fn wants_to_eat(
        self,
        philosopher: i64,
        pick_left_fork: Fn(),
        pick_right_fork: Fn(),
        eat: Fn(),
        put_left_fork: Fn(),
        put_right_fork: Fn(),
    ) {
        let left = philosopher;
        let right = (philosopher + 4) % 5;
        if philosopher % 2 == 0 {
            let _left = self.forks[left].lock();
            pick_left_fork();
            let _right = self.forks[right].lock();
            pick_right_fork();
            eat();
            put_right_fork();
            put_left_fork();
        } else {
            let _right = self.forks[right].lock();
            pick_right_fork();
            let _left = self.forks[left].lock();
            pick_left_fork();
            eat();
            put_left_fork();
            put_right_fork();
        }
    }
}

fn run3(n: i64, order: Vec[i64]) -> Vec[(i64, i64, i64)] {
