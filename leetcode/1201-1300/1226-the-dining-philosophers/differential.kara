// LeetCode #1226: The Dining Philosophers -- the arms against the
// statement read literally and five more properties. Every callback
// yields the processor (a pick-up and the meal once logged, a put-down
// before), so that the tasks interleave on the interpreter too.
// Generated from the arms; see the README.

import std.sync.{Atomic, Mutex, TaskGroup};
import std.time.{Duration, sleep};
import std.sync.{Receiver, Semaphore, Sender};

// ---- arm 0: star --------------------------------------------------------
sync struct A0DiningPhilosophers {
    forks: Vec[Mutex[i64]],
}

impl A0DiningPhilosophers {
    fn new() -> A0DiningPhilosophers {
        A0DiningPhilosophers { forks: (0..5).map(|_| Mutex.new(0)).collect() }
    }

    fn wants_to_eat(
        self,
        philosopher: i64,
        pick_left_fork: Fn(),
        pick_right_fork: Fn(),
        eat: Fn(),
        put_left_fork: Fn(),
        put_right_fork: Fn(),
    ) {
        let left = philosopher;
        let right = (philosopher + 4) % 5;
        let _first = self.forks[left.min(right)].lock();
        let _second = self.forks[left.max(right)].lock();
        pick_left_fork();
        pick_right_fork();
        eat();
        put_left_fork();
        put_right_fork();
    }
}

fn run0(n: i64, order: Vec[i64]) -> Vec[(i64, i64, i64)] {
    let table = A0DiningPhilosophers.new();
    let log: Mutex[Vec[(i64, i64, i64)]] = Mutex.new([]);
    {
        let group = TaskGroup.new();
        for p in order.iter() {
            group.spawn(|| {
                for _ in 0..n {
                    table.wants_to_eat(
                        p,
                        || {
                            log.lock().value.push((p, 1, 1));
                            sleep(Duration.ms(0));
                        },
                        || {
                            log.lock().value.push((p, 2, 1));
                            sleep(Duration.ms(0));
                        },
                        || {
                            log.lock().value.push((p, 0, 3));
                            sleep(Duration.ms(0));
                        },
                        || {
                            sleep(Duration.ms(0));
                            log.lock().value.push((p, 1, 2));
                        },
                        || {
                            sleep(Duration.ms(0));
                            log.lock().value.push((p, 2, 2));
                        },
                    );
                }
            });
        }
    }
    log.lock().value.clone()
}

// ---- arm 1: table -------------------------------------------------------
sync struct A1DiningPhilosophers {
    table: Mutex[i64],
}

impl A1DiningPhilosophers {
    fn new() -> A1DiningPhilosophers {
        A1DiningPhilosophers { table: Mutex.new(0) }
    }

    fn wants_to_eat(
        self,
        philosopher: i64,
        pick_left_fork: Fn(),
        pick_right_fork: Fn(),
        eat: Fn(),
        put_left_fork: Fn(),
        put_right_fork: Fn(),
    ) {
        let _turn = self.table.lock();
        pick_left_fork();
        pick_right_fork();
        eat();
        put_left_fork();
        put_right_fork();
    }
}

