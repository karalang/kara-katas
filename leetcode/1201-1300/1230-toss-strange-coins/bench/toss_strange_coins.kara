// LeetCode #1230 bench: the ★ arm, one row of the table updated from the
// top count down, over 200 random sets of 1000 coins with random targets,
// drawn once and each solved once, the answers summed.

fn probability_of_heads(prob: Vec[f64], target: i64) -> f64 {
    let mut ways = Vec.filled(target + 1, 0.0);
    ways[0] = 1.0;
    for p in prob.iter() {
        for j in (1..=target).rev() {
            ways[j] = ways[j] * (1.0 - p) + ways[j - 1] * p;
        }
        ways[0] = ways[0] * (1.0 - p);
    }
    ways[target]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1230;
    let mut sets: Vec[Vec[f64]] = Vec.new();
    let mut targets: Vec[i64] = Vec.new();
    for _ in 0..200 {
        sets.push((0..1000).map(|_| (next_random(mut seed) % 1001) as f64 / 1000.0).collect());
        targets.push(next_random(mut seed) % 1001);
    }
    let mut total = 0.0;
    for s in 0..200 {
        total += probability_of_heads(sets[s], targets[s]);
    }
    println(f"200 sets of 1000 coins: total {total:.6}");
}
