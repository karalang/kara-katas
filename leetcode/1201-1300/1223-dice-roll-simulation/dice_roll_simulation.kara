// LeetCode #1223: Dice Roll Simulation -- the ★ arm: count the sequences
// by their last face and how many times in a row it has come up; a roll of
// the same face lengthens the run while it stays within that face's
// limit, and any other face starts a run of one. O(n * 6 * 15 * 6).

fn die_simulator(n: i64, roll_max: Vec[i64]) -> i64 {
    let modulus = 1_000_000_007;
    // count[f][r - 1]: sequences ending in face f rolled r times in a row
    let mut count = Vec.filled(6, Vec.filled(15, 0));
    for f in 0..6 {
        count[f][0] = 1;
    }
    for _ in 1..n {
        let mut next = Vec.filled(6, Vec.filled(15, 0));
        for f in 0..6 {
            for r in 0..roll_max[f] {
                let c = count[f][r];
                if c == 0 {
                    continue;
                }
                for g in 0..6 {
                    if g != f {
                        next[g][0] = (next[g][0] + c) % modulus;
                    } else if r + 1 < roll_max[f] {
                        next[f][r + 1] = (next[f][r + 1] + c) % modulus;
                    }
                }
            }
        }
        count = next;
    }
    let mut total = 0;
    for f in 0..6 {
        for r in 0..15 {
            total = (total + count[f][r]) % modulus;
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"{die_simulator(2, [1, 1, 2, 2, 2, 3])}");
    println(f"{die_simulator(2, [1, 1, 1, 1, 1, 1])}");
    println(f"{die_simulator(3, [1, 1, 1, 2, 2, 3])}");
    println(f"{die_simulator(1, [1, 1, 1, 1, 1, 1])}");
    let mut seed = 1223;
    let mut check = 0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 60 + 1;
        let roll_max: Vec[i64] = (0..6).map(|_| next_random(mut seed) % 15 + 1).collect();
        check = (check * 131 + die_simulator(n, roll_max)) % 1000000007;
    }
    println(f"300 random cases with n up to 60: checksum {check}");
    let wide: Vec[i64] = (0..6).map(|_| next_random(mut seed) % 15 + 1).collect();
    println(f"n = 5000: no face twice {die_simulator(5000, [1, 1, 1, 1, 1, 1])}, up to 15 {die_simulator(5000, [15, 15, 15, 15, 15, 15])}, {wide}: {die_simulator(5000, wide)}");
}
