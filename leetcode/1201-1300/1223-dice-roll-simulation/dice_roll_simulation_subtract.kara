// LeetCode #1223: Dice Roll Simulation -- every sequence of i - 1 rolls
// can take face j next, except those that would make one run of j too
// long: the ones whose last roll_max[j] + 1 rolls would all be j. Those
// are the sequences of i - roll_max[j] - 1 rolls not ending in j, then
// roll_max[j] j's, so they are subtracted. O(36 n).

fn die_simulator(n: i64, roll_max: Vec[i64]) -> i64 {
    let modulus = 1_000_000_007;
    // ending[i][j]: sequences of i rolls ending in j; total[i]: all of them,
    // with total[0] = 1, the empty sequence
    let mut ending = Vec.filled(n + 1, Vec.filled(6, 0));
    let mut total = Vec.filled(n + 1, 0);
    total[0] = 1;
    for i in 1..=n {
        for j in 0..6 {
            let mut ways = total[i - 1];
            let k = i - roll_max[j] - 1;
            if k >= 0 {
                ways = (ways - (total[k] - ending[k][j]) + 2 * modulus) % modulus;
            }
            ending[i][j] = ways;
            total[i] = (total[i] + ways) % modulus;
        }
    }
    total[n]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"{die_simulator(2, [1, 1, 2, 2, 2, 3])}");
    println(f"{die_simulator(2, [1, 1, 1, 1, 1, 1])}");
    println(f"{die_simulator(3, [1, 1, 1, 2, 2, 3])}");
    println(f"{die_simulator(1, [1, 1, 1, 1, 1, 1])}");
    let mut seed = 1223;
    let mut check = 0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 60 + 1;
        let roll_max: Vec[i64] = (0..6).map(|_| next_random(mut seed) % 15 + 1).collect();
        check = (check * 131 + die_simulator(n, roll_max)) % 1000000007;
    }
    println(f"300 random cases with n up to 60: checksum {check}");
    let wide: Vec[i64] = (0..6).map(|_| next_random(mut seed) % 15 + 1).collect();
    println(f"n = 5000: no face twice {die_simulator(5000, [1, 1, 1, 1, 1, 1])}, up to 15 {die_simulator(5000, [15, 15, 15, 15, 15, 15])}, {wide}: {die_simulator(5000, wide)}");
}
