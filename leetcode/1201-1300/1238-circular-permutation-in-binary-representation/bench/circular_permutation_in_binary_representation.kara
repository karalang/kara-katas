// LeetCode #1238: Circular Permutation in Binary Representation -- the
// benchmark: the ★ arm's answer for n = 16 from 64 starts, each checked as
// a cycle (every value once, one bit between neighbours and across the
// wrap); prints the cycles found and a checksum of their middle values.

fn circular_permutation(n: i64, start: i64) -> Vec[i64] {
    (0..1 << n).map(|i| start ^ i ^ (i >> 1)).collect()
}

fn is_cycle(n: i64, start: i64, p: Vec[i64]) -> bool {
    let size = 1 << n;
    if p.len() != size or p[0] != start {
        return false;
    }
    let mut seen = Vec.filled(size, false);
    for v in p.iter() {
        if v < 0 or v >= size or seen[v] {
            return false;
        }
        seen[v] = true;
    }
    for i in 0..size {
        let d = p[i] ^ p[(i + 1) % size];
        if d == 0 or d & (d - 1) != 0 {
            return false;
        }
    }
    true
}

fn main() {
    let mut cycles = 0;
    let mut check = 0;
    for k in 0..64 {
        let start = (k * 1031) % 65536;
        let p = circular_permutation(16, start);
        if is_cycle(16, start, p) {
            cycles += 1;
        }
        check = (check * 131 + p[32768]) % 1000000007;
    }
    println(f"n = 16, 64 starts: {cycles} cycles, checksum {check}");
}
