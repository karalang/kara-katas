// LeetCode #1276: Number of Burgers with No Waste of Ingredients -- by
// `Result`: start from all small burgers, one per cheese slice, and swap
// small for jumbo two tomato slices at a time; each way it can fail is an
// `Err` naming why, carried by `?`, and the answer is the `Ok` or nothing.

enum Waste {
    OddTomatoes,
    TooFewTomatoes,
    TooManyTomatoes,
}

fn swaps(tomato_slices: i64, cheese_slices: i64) -> Result[i64, Waste] {
    let all_small = 2 * cheese_slices;
    if tomato_slices < all_small {
        return Err(Waste.TooFewTomatoes);
    }
    let extra = tomato_slices - all_small;
    if extra % 2 != 0 {
        return Err(Waste.OddTomatoes);
    }
    if extra / 2 > cheese_slices {
        return Err(Waste.TooManyTomatoes);
    }
    Ok(extra / 2)
}

fn burgers(tomato_slices: i64, cheese_slices: i64) -> Result[(i64, i64), Waste] {
    let jumbo = swaps(tomato_slices, cheese_slices)?;
    Ok((jumbo, cheese_slices - jumbo))
}

fn num_of_burgers(tomato_slices: i64, cheese_slices: i64) -> Vec[i64] {
    match burgers(tomato_slices, cheese_slices) {
        Ok((jumbo, small)) => [jumbo, small],
        Err(_) => Vec.new(),
    }
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's examples
    println(f"{num_of_burgers(16, 7)} {num_of_burgers(17, 4)} {num_of_burgers(4, 17)} {num_of_burgers(0, 0)} {num_of_burgers(2, 1)}");
    // 3000 random cases: a third made from burgers, so they have an
    // answer, a third near one, and a third anything
    let mut seed = 1276;
    let mut made = 0;
    let mut check = 0;
    for case in 0..3000 {
        let big = next_random(mut seed) % 2 == 0;
        let span = if big { 2500000 } else { 30 };
        let jumbo = next_random(mut seed) % span;
        let small = next_random(mut seed) % span;
        let (t, c) = if case % 3 == 0 {
            (4 * jumbo + 2 * small, jumbo + small)
        } else if case % 3 == 1 {
            (4 * jumbo + 2 * small + next_random(mut seed) % 5 - 2, jumbo + small + next_random(mut seed) % 3 - 1)
        } else {
            (next_random(mut seed) % (4 * span), next_random(mut seed) % (2 * span))
        };
        let (t, c) = (t.max(0), c.max(0));
        let answer = num_of_burgers(t, c);
        if answer.len() == 2 {
            made += 1;
            check = (check * 131 + answer[0] * 7 + answer[1]) % 1000000007;
        } else {
            check = (check * 131 + answer.len() + 1) % 1000000007;
        }
    }
    println(f"3000 random cases: {made} with burgers, checksum {check}");
    // the constraints' top
    println(f"{num_of_burgers(10000000, 2500000)} {num_of_burgers(10000000, 5000000)} {num_of_burgers(10000000, 3000000)} {num_of_burgers(10000000, 10000000)} {num_of_burgers(9999999, 3000000)}");
}
