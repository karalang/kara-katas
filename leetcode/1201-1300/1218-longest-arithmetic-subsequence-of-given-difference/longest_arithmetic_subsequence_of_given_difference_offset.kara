// LeetCode #1218: Longest Arithmetic Subsequence of Given Difference --
// another Rust solution: a `vec![0i32; 40001]` indexed by the value plus
// a `const OFFSET: i32 = 20000` declared in the function, the predecessor
// read only when `(-OFFSET..=OFFSET).contains(&prev)`, carried to Kāra by
// `karac fix`.

struct Solution {}

impl Solution {
    pub fn longest_subsequence(arr: Vec[i32], difference: i32) -> i32 {
        const OFFSET: i32 = 20000;
        let mut dp = Vec.filled(40001, 0i32);
        let mut res: i32 = 1;
        for x in arr {
            let prev = x - difference;
            let p = if (-OFFSET..=OFFSET).contains(prev) { dp[(prev + OFFSET) as usize] } else { 0 };
            dp[(x + OFFSET) as usize] = p + 1;
            res = res.max(p + 1);
        }
        res
    }
}

fn longest_subsequence(arr: Vec[i64], difference: i64) -> i64 {
    Solution.longest_subsequence(arr.iter().map(|v| v as i32).collect(), difference as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases: Vec[(Vec[i64], i64)] = [
        ([1, 2, 3, 4], 1),
        ([1, 3, 5, 7], 1),
        ([1, 5, 7, 8, 5, 3, 4, 2, 1], -2),
        ([5], 0),
        ([3, 3, 3], 0),
        ([-10000, 0, 10000], 10000),
        ([10000, 0, -10000], -10000),
        ([4, 1, 3, 2], -1),
    ];
    for (arr, d) in cases.iter() {
        println(f"{arr} {d}: {longest_subsequence(arr, d)}");
    }
    let mut seed = 1218;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 12 + 1;
        let spread = next_random(mut seed) % 8 + 1;
        let arr: Vec[i64] = (0..n).map(|_| next_random(mut seed) % (2 * spread + 1) - spread).collect();
        let d = next_random(mut seed) % 5 - 2;
        let answer = longest_subsequence(arr, d);
        total += answer;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"1000 small cases: lengths total {total}, checksum {check}");
    // The constraints' top: 10^5 values from -10^4 to 10^4.
    let arr: Vec[i64] = (0..100000).map(|_| next_random(mut seed) % 20001 - 10000).collect();
    println(f"10^5 random values, difference 3: {longest_subsequence(arr, 3)}, difference -7: {longest_subsequence(arr, -7)}, difference 0: {longest_subsequence(arr, 0)}");
    let rising: Vec[i64] = (0..100000).map(|i| i % 20001 - 10000).collect();
    println(f"-10^4 to 10^4 over and over, difference 1: {longest_subsequence(rising, 1)}, difference -1: {longest_subsequence(rising, -1)}");
    let ends: Vec[i64] = (0..100000).map(|i| if i % 2 == 0 { -10000 } else { 10000 }).collect();
    println(f"-10^4 and 10^4 in turn, difference 10^4: {longest_subsequence(ends, 10000)}, difference 0: {longest_subsequence(ends, 0)}");
}
