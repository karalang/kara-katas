// LeetCode #1218 bench: the ★ arm (a `Map` from each value to the longest
// subsequence ending with it) on 16 arrays of 10^5 values from -10^4 to
// 10^4, the constraints' most, drawn once, each asked with the
// differences -3 to 3; every answer folded into a checksum.

fn longest_subsequence(arr: Vec[i64], difference: i64) -> i64 {
    let mut ending: Map[i64, i64] = Map.new();
    let mut best = 0;
    for x in arr.iter() {
        let length = ending.get(x - difference).unwrap_or(0) + 1;
        ending.insert(x, length);
        best = max(best, length);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1218;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..16 {
        let mut arr: Vec[i64] = Vec.with_capacity(100000);
        for _ in 0..100000 {
            arr.push(next_random(mut seed) % 20001 - 10000);
        }
        arrays.push(arr);
    }
    let mut check = 0;
    for arr in arrays.iter() {
        for d in -3..=3 {
            check = (check * 131 + longest_subsequence(arr, d) + d + 3) % 1000000007;
        }
    }
    println(f"16 arrays of 10^5 values, differences -3 to 3: checksum {check}");
}
