// LeetCode #1293: Shortest Path in a Grid with Obstacles Elimination --
// differential test of the five arms against the statement read literally,
// with five more properties.
//
// The statement: given an m x n grid of 0 (empty) and 1 (obstacle), moving
// up, down, left or right between cells, return the minimum number of steps
// to walk from the upper left corner to the lower right corner given that
// you can eliminate at most k obstacles, or -1 if it is not possible.

// ---- shortest_path.kara ----
fn a0_shortest_path(grid: Vec[Vec[i64]], k: i64) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    if k >= m + n - 2 {
        return m + n - 2;
    }
    // the most eliminations left with which each cell has been reached
    let mut best: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n, -1));
    let mut queue: VecDeque[(i64, i64, i64)] = VecDeque.new();
    queue.push_back((0, 0, k));
    best[0][0] = k;
    let mut steps = 0;
    while not queue.is_empty() {
        for _ in 0..queue.len() {
            let (r, c, left) = queue.pop_front().unwrap();
            if r == m - 1 and c == n - 1 {
                return steps;
            }
            for (dr, dc) in [(1, 0), (-1, 0), (0, 1), (0, -1)].iter() {
                let nr = r + dr;
                let nc = c + dc;
                if nr < 0 or nr >= m or nc < 0 or nc >= n {
                    continue;
                }
                let rest = left - grid[nr][nc];
                if rest > best[nr][nc] {
                    best[nr][nc] = rest;
                    queue.push_back((nr, nc, rest));
                }
            }
        }
        steps += 1;
    }
    -1
}

// ---- shortest_path_visited.kara ----
fn a1_shortest_path(grid: Vec[Vec[i64]], k: i64) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut seen: Vec[Vec[Vec[bool]]] = Vec.filled(m, Vec.filled(n, Vec.filled(k + 1, false)));
    let mut queue: VecDeque[(i64, i64, i64, i64)] = VecDeque.new();
    queue.push_back((0, 0, k, 0));
    seen[0][0][k] = true;
    while let Some((r, c, left, steps)) = queue.pop_front() {
        if r == m - 1 and c == n - 1 {
            return steps;
        }
        for (dr, dc) in [(1, 0), (-1, 0), (0, 1), (0, -1)].iter() {
            let nr = r + dr;
            let nc = c + dc;
            if nr < 0 or nr >= m or nc < 0 or nc >= n {
                continue;
            }
            let rest = left - grid[nr][nc];
            if rest >= 0 and not seen[nr][nc][rest] {
                seen[nr][nc][rest] = true;
                queue.push_back((nr, nc, rest, steps + 1));
            }
        }
    }
    -1
}

// ---- shortest_path_astar.kara ----
fn a2_shortest_path(grid: Vec[Vec[i64]], k: i64) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let goal = (m - 1, n - 1);
    // (steps + distance to go, steps, row, column, eliminations left): the
    // queue gives the smallest first
    let mut open: PriorityQueue[(i64, i64, i64, i64, i64)] = PriorityQueue.new();
    let mut done: Set[(i64, i64, i64)] = Set.new();
    open.push((m + n - 2, 0, 0, 0, k));
    while let Some((_, steps, r, c, left)) = open.pop() {
        if (r, c) == goal {
            return steps;
        }
        if done.contains((r, c, left)) {
            continue;
        }
        done.insert((r, c, left));
        for (dr, dc) in [(1, 0), (-1, 0), (0, 1), (0, -1)].iter() {
            let nr = r + dr;
            let nc = c + dc;
            if nr < 0 or nr >= m or nc < 0 or nc >= n {
                continue;
            }
            let rest = left - grid[nr][nc];
            if rest >= 0 and not done.contains((nr, nc, rest)) {
                let to_go = (m - 1 - nr) + (n - 1 - nc);
                open.push((steps + 1 + to_go, steps + 1, nr, nc, rest));
            }
        }
    }
    -1
}

// ---- shortest_path_layers.kara ----
fn a3_shortest_path(grid: Vec[Vec[i64]], k: i64) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let unseen = m * n * (k + 1) + 1;
    // dist[r][c]: fewest steps to (r, c) crossing at most e obstacles
    let mut dist: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n, unseen));
    for e in 0..k + 1 {
        let mut next: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n, unseen));
        if e == 0 {
            next[0][0] = 0;
        } else {
            // one more obstacle: any obstacle next to a cell reached with e - 1
            for r in 0..m {
                for c in 0..n {
                    next[r][c] = dist[r][c];
                    for (dr, dc) in [(1, 0), (-1, 0), (0, 1), (0, -1)].iter() {
                        let pr = r + dr;
                        let pc = c + dc;
                        if grid[r][c] == 1 and pr >= 0 and pr < m and pc >= 0 and pc < n and dist[pr][pc] + 1 < next[r][c] {
                            next[r][c] = dist[pr][pc] + 1;
                        }
                    }
                }
            }
        }
        // then relax through free cells in order of steps: a Dijkstra on the
        // free cells with these starting distances
        let mut queue: PriorityQueue[(i64, i64, i64)] = PriorityQueue.new();
        for r in 0..m {
            for c in 0..n {
                if next[r][c] < unseen {
                    queue.push((next[r][c], r, c));
                }
            }
        }
        while let Some((d, r, c)) = queue.pop() {
            if d > next[r][c] {
                continue;
            }
            for (dr, dc) in [(1, 0), (-1, 0), (0, 1), (0, -1)].iter() {
                let nr = r + dr;
                let nc = c + dc;
                if nr >= 0 and nr < m and nc >= 0 and nc < n and grid[nr][nc] == 0 and d + 1 < next[nr][nc] {
                    next[nr][nc] = d + 1;
                    queue.push((d + 1, nr, nc));
                }
            }
        }
        dist = next;
    }
    if dist[m - 1][n - 1] < unseen { dist[m - 1][n - 1] } else { -1 }
}

// ---- shortest_path_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn shortest_path(grid: Vec[Vec[i32]], k: i32) -> i32 {
        let (m, n, k) = (grid.len(), grid[0].len(), k as i64);
        let mut visited = Vec.filled(m, Vec.filled(n, Vec.filled(k + 1, false)));
        let mut q = VecDeque.new();
        q.push_back((0, 0, k, 0i32));
        visited[0][0][k] = true;
        let dirs = [(0, 1), (1, 0), (0, -1), (-1, 0)];
        while let Some((r, c, rem, steps)) = q.pop_front() {
            if r == m - 1 and c == n - 1 {
                return steps;
            }
            for (dr, dc) in dirs.iter() {
                let nr = r as i32 + dr;
                let nc = c as i32 + dc;
                if nr < 0 or nc < 0 or nr >= m as i32 or nc >= n as i32 {
                    continue;
                }
                if grid[nr][nc] == 1 {
                    if rem > 0 and not visited[nr][nc][rem - 1] {
                        visited[nr][nc][rem - 1] = true;
                        q.push_back((nr, nc, rem - 1, steps + 1));
                    }
                } else if not visited[nr][nc][rem] {
                    visited[nr][nc][rem] = true;
                    q.push_back((nr, nc, rem, steps + 1));
                }
            }
        }
        -1
    }
}

fn a4_shortest_path(grid: Vec[Vec[i64]], k: i64) -> i64 {
    let g: Vec[Vec[i32]] = grid.iter().map(|row| row.iter().map(|x| x as i32).collect()).collect();
    A4Solution.shortest_path(g, k as i32)
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(w: i64, grid: Vec[Vec[i64]], k: i64) -> i64 {
    match w {
        0 => a0_shortest_path(grid, k),
        1 => a1_shortest_path(grid, k),
        2 => a2_shortest_path(grid, k),
        3 => a3_shortest_path(grid, k),
        _ => a4_shortest_path(grid, k),
    }
}

// Every walk that never comes back to a cell, from the upper left corner,
// with the obstacles it steps on counted; the fewest steps of any that
// reaches the lower right corner on at most k of them. A shortest walk
// never comes back to a cell, so these are enough.
fn walk(grid: Vec[Vec[i64]], k: i64, r: i64, c: i64, steps: i64, crossed: i64, on: mut ref Vec[Vec[bool]], best: mut ref i64) {
    let m = grid.len();
    let n = grid[0].len();
    if r == m - 1 and c == n - 1 {
        if *best < 0 or steps < *best {
            *best = steps;
        }
        return;
    }
    for (dr, dc) in [(1, 0), (-1, 0), (0, 1), (0, -1)].iter() {
        let nr = r + dr;
        let nc = c + dc;
        if nr >= 0 and nr < m and nc >= 0 and nc < n and not on[nr][nc] and crossed + grid[nr][nc] <= k {
            on[nr][nc] = true;
            walk(grid, k, nr, nc, steps + 1, crossed + grid[nr][nc], mut on, mut best);
            on[nr][nc] = false;
        }
    }
}

fn literal(grid: Vec[Vec[i64]], k: i64) -> i64 {
    let mut on: Vec[Vec[bool]] = Vec.filled(grid.len(), Vec.filled(grid[0].len(), false));
    on[0][0] = true;
    let mut best = -1;
    walk(grid, k, 0, 0, 0, 0, mut on, mut best);
    best
}

struct Case {
    grid: Vec[Vec[i64]],
    k: i64,
    // P5's cell to clear
    clear: (i64, i64),
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

// `after` is no worse than `before`: reachable whenever `before` is, in no
// more steps
fn no_worse(before: i64, after: i64) -> bool {
    before < 0 or (after >= 0 and after <= before)
}

fn check_case(t: mut ref Tally, c: Case) {
    let m = c.grid.len();
    let n = c.grid[0].len();
    let transposed: Vec[Vec[i64]] = (0..n).map(|j| (0..m).map(|i| c.grid[i][j]).collect()).collect();
    let turned: Vec[Vec[i64]] = c.grid.iter().rev().map(|row| row.iter().rev().cloned().collect()).collect();
    let mut cleared = c.grid.clone();
    let (cr, cc) = c.clear;
    cleared[cr][cc] = 0;
    let want = literal(c.grid, c.k);
    let star = arm(0, c.grid, c.k);
    for a in 0..5 {
        let got = arm(a, c.grid, c.k);
        let what = f"arm {a}, case {t.cases} {c.grid} k {c.k} -> {got}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}, literal {want}");
        // P2: the grid transposed, the same answer
        let tr = arm(a, transposed, c.k);
        expect(mut t, 2, tr == got, f"P2 {what}, transposed: {tr}");
        // P3: the grid turned half round, corners swapped, the same answer
        let tu = arm(a, turned, c.k);
        expect(mut t, 3, tu == got, f"P3 {what}, turned: {tu}");
        // P4: one more elimination, no worse
        let more = arm(a, c.grid, c.k + 1);
        expect(mut t, 4, no_worse(got, more), f"P4 {what}, k + 1: {more}");
        // P5: one cell cleared, no worse
        let cl = arm(a, cleared, c.k);
        expect(mut t, 5, no_worse(got, cl), f"P5 {what}, ({cr}, {cc}) cleared: {cl}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
    t.cases += 1;
    t.check = (t.check * 131 + want + 2) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 grids in four kinds, 500 each: up to 4 by 4 with obstacles from
    // 20 to 80 in 100; a single row or column of up to 12 cells; a snake of
    // 5 or 7 rows whose every other row is a wall with one gap, at the right
    // and the left in turn, so that the shortest way with few eliminations
    // doubles back, and transposed half the time, so that it climbs; and up
    // to 4 by 4 again. k is up to 4, and up to 2 for a snake. Every grid, k
    // and cell to clear is drawn before any arm answers.
    let mut seed = 12931;
    let mut cases: Vec[Case] = Vec.new();
    for i in 0..2000 {
        let kind = i % 4;
        let mut grid: Vec[Vec[i64]] = Vec.new();
        if kind == 2 {
            let m = 5 + 2 * (next_random(mut seed) % 2);
            let n = 3 + next_random(mut seed) % 3;
            for r in 0..m {
                let mut row: Vec[i64] = Vec.new();
                for col in 0..n {
                    let gap = if r % 4 == 1 { n - 1 } else { 0 };
                    let corner = (r == 0 and col == 0) or (r == m - 1 and col == n - 1);
                    let cell = if r % 2 == 1 { if col == gap { 0 } else { 1 } } else if not corner and next_random(mut seed) % 100 < 15 { 1 } else { 0 };
                    row.push(cell);
                }
                grid.push(row);
            }
            if next_random(mut seed) % 2 == 0 {
                grid = (0..n).map(|j| (0..m).map(|r| grid[r][j]).collect()).collect();
            }
        } else {
            let (m, n) = if kind == 1 {
                let len = 1 + next_random(mut seed) % 12;
                if next_random(mut seed) % 2 == 0 { (1, len) } else { (len, 1) }
            } else {
                (1 + next_random(mut seed) % 4, 1 + next_random(mut seed) % 4)
            };
            let percent = 20 + next_random(mut seed) % 61;
            for r in 0..m {
                let mut row: Vec[i64] = Vec.new();
                for col in 0..n {
                    let corner = (r == 0 and col == 0) or (r == m - 1 and col == n - 1);
                    row.push(if not corner and next_random(mut seed) % 100 < percent { 1 } else { 0 });
                }
                grid.push(row);
            }
        }
        let k = next_random(mut seed) % (if kind == 2 { 3 } else { 5 });
        let clear = (next_random(mut seed) % grid.len(), next_random(mut seed) % grid[0].len());
        cases.push(Case { grid, k, clear });
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} grids: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
