// LeetCode #1293 bench: the ★ arm (a breadth-first search over (row, column,
// eliminations left), each cell keeping the most eliminations it has been
// reached with) over 50 grids of 40 by 40 with obstacles 30 in 100, built
// once; then 80 passes, each flipping one cell of every grid and choosing k
// from the checksum so far, answering it, and folding the steps into the
// checksum.

fn shortest_path(grid: Vec[Vec[i64]], k: i64) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    if k >= m + n - 2 {
        return m + n - 2;
    }
    let mut best: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n, -1));
    let mut queue: VecDeque[(i64, i64, i64)] = VecDeque.new();
    queue.push_back((0, 0, k));
    best[0][0] = k;
    let mut steps = 0;
    while not queue.is_empty() {
        for _ in 0..queue.len() {
            let (r, c, left) = queue.pop_front().unwrap();
            if r == m - 1 and c == n - 1 {
                return steps;
            }
            for (dr, dc) in [(1, 0), (-1, 0), (0, 1), (0, -1)].iter() {
                let nr = r + dr;
                let nc = c + dc;
                if nr < 0 or nr >= m or nc < 0 or nc >= n {
                    continue;
                }
                let rest = left - grid[nr][nc];
                if rest > best[nr][nc] {
                    best[nr][nc] = rest;
                    queue.push_back((nr, nc, rest));
                }
            }
        }
        steps += 1;
    }
    -1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1293;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..50 {
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for i in 0..40 {
            let mut row: Vec[i64] = Vec.new();
            for j in 0..40 {
                let corner = (i == 0 and j == 0) or (i == 39 and j == 39);
                row.push(if not corner and next_random(mut seed) % 100 < 30 { 1 } else { 0 });
            }
            grid.push(row);
        }
        grids.push(grid);
    }
    let mut check = 0;
    for p in 0..80 {
        for a in 0..grids.len() {
            // flip one cell other than the two corners
            let cell = 1 + check % 1598;
            grids[a][cell / 40][cell % 40] = 1 - grids[a][cell / 40][cell % 40];
            check = (check * 31 + shortest_path(grids[a], check % 78) + 2 + p) % 1000000007;
        }
    }
    println(f"80 passes over 50 grids of 40 by 40: checksum {check}");
}
