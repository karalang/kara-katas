// LeetCode #1298 bench: the ★ arm (a breadth-first walk over the boxes that
// can be opened, each queued once, when it is both held and open) over 100
// cases of 1000 boxes, built once; then 5000 passes, each flipping one box of
// every case between open and locked, chosen from the checksum so far,
// answering it, and folding the answer into the checksum.

fn max_candies(status: Vec[i64], candies: Vec[i64], keys: Vec[Vec[i64]], contained_boxes: Vec[Vec[i64]], initial_boxes: Vec[i64]) -> i64 {
    let n = status.len();
    let mut open: Vec[bool] = status.iter().map(|s| s == 1).collect();
    let mut held: Vec[bool] = Vec.filled(n, false);
    let mut queued: Vec[bool] = Vec.filled(n, false);
    let mut queue: VecDeque[i64] = VecDeque.new();
    for b in initial_boxes.iter() {
        held[b] = true;
        if open[b] and not queued[b] {
            queued[b] = true;
            queue.push_back(b);
        }
    }
    let mut total = 0;
    while let Some(b) = queue.pop_front() {
        total += candies[b];
        for k in keys[b].iter() {
            open[k] = true;
            if held[k] and not queued[k] {
                queued[k] = true;
                queue.push_back(k);
            }
        }
        for c in contained_boxes[b].iter() {
            held[c] = true;
            if open[c] and not queued[c] {
                queued[c] = true;
                queue.push_back(c);
            }
        }
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Case {
    status: Vec[i64],
    candies: Vec[i64],
    keys: Vec[Vec[i64]],
    contained: Vec[Vec[i64]],
    initial: Vec[i64],
}

// n boxes in a random order, each after the first put inside an earlier one
// nest times in 100, else held at the start initial times in 100, else lost;
// each open open times in 100, with up to max_keys distinct keys
fn make_case(seed: mut ref i64, n: i64, open: i64, initial_in: i64, nest: i64, max_keys: i64) -> Case {
    let mut order: Vec[i64] = (0..n).collect();
    for i in 0..n {
        let j = i + next_random(mut seed) % (n - i);
        let held = order[i];
        order[i] = order[j];
        order[j] = held;
    }
    let mut status: Vec[i64] = Vec.filled(n, 0);
    let mut candies: Vec[i64] = Vec.filled(n, 0);
    let mut keys: Vec[Vec[i64]] = Vec.new();
    let mut contained: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        keys.push(Vec.new());
        contained.push(Vec.new());
    }
    let mut initial: Vec[i64] = Vec.new();
    for i in 0..n {
        let b = order[i];
        let roll = next_random(mut seed) % 100;
        if i > 0 and roll < nest {
            let parent = order[next_random(mut seed) % i];
            contained[parent].push(b);
        } else if next_random(mut seed) % 100 < initial_in {
            initial.push(b);
        }
        if next_random(mut seed) % 100 < open {
            status[b] = 1;
        }
        candies[b] = 1 + next_random(mut seed) % 1000;
        let count = next_random(mut seed) % (max_keys + 1);
        for _ in 0..count {
            let k = next_random(mut seed) % n;
            if not keys[b].contains(k) {
                keys[b].push(k);
            }
        }
    }
    Case { status, candies, keys, contained, initial }
}

fn main() {
    let mut seed = 1298;
    let mut cases: Vec[Case] = Vec.new();
    for t in 0..100 {
        cases.push(make_case(mut seed, 1000, 10 + t % 40, 5 + t % 20, 60 + t % 40, 1 + t % 4));
    }
    let mut check = 0;
    for p in 0..5000 {
        for t in 0..cases.len() {
            let b = check % 1000;
            cases[t].status[b] = 1 - cases[t].status[b];
            let c = ref cases[t];
            let got = max_candies(c.status, c.candies, c.keys, c.contained, c.initial);
            check = (check * 31 + got + p) % 1000000007;
        }
    }
    println(f"5000 passes over 100 cases of 1000 boxes: checksum {check}");
}
