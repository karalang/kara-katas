// LeetCode #1260: Shift 2D Grid -- by rotation: the rows flattened into
// one `Vec`, rotated right by `k` modulo its length with
// `rotate_right`, and cut back into rows of `n` with `chunks`.

fn shift_grid(grid: Vec[Vec[i64]], k: i64) -> Vec[Vec[i64]] {
    let n = grid[0].len();
    let mut flat: Vec[i64] = grid.iter().flat_map(|v| v.iter()).cloned().collect();
    let len = flat.len();
    flat.rotate_right(k % len);
    flat.chunks(n).into_iter().map(|row| row.to_vec()).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_grid(m: i64, n: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    (0..m).map(|_| (0..n).map(|_| next_random(mut seed) % 2001 - 1000).collect()).collect()
}

fn fold(check: i64, grid: Vec[Vec[i64]]) -> i64 {
    let mut check = check;
    for row in grid.iter() {
        for x in row.iter() {
            check = (check * 131 + x + 1000) % 1000000007;
        }
        check = (check * 131 + 7) % 1000000007;
    }
    check
}

fn main() {
    // LeetCode's three examples
    let g = [[1, 2, 3], [4, 5, 6], [7, 8, 9]];
    println(f"{shift_grid(g, 1)}");
    println(f"{shift_grid([[3, 8, 1, 9], [19, 7, 2, 5], [4, 6, 11, 10], [12, 0, 21, 13]], 4)}");
    println(f"{shift_grid(g, 9)}");
    // 1000 random grids of 1 to 50 by 1 to 50, shifted by 0 to 100
    let mut seed = 1260;
    let mut check = 0;
    let mut corner = 0;
    for _ in 0..1000 {
        let m = next_random(mut seed) % 50 + 1;
        let n = next_random(mut seed) % 50 + 1;
        let k = next_random(mut seed) % 101;
        let grid = random_grid(m, n, mut seed);
        let shifted = shift_grid(grid, k);
        corner += shifted[0][0];
        check = fold(check, shifted);
    }
    println(f"1000 random grids: corners {corner}, checksum {check}");
    // the constraints' top: 50 by 50 shifted by 100, and a column and a
    // row shifted by 99
    let big = random_grid(50, 50, mut seed);
    let a = shift_grid(big, 100);
    let column = shift_grid(random_grid(50, 1, mut seed), 99);
    let row = shift_grid(random_grid(1, 50, mut seed), 99);
    println(f"50 by 50: {a[0][0]} {a[49][49]} {fold(0, a)}; column {column[0][0]} {fold(0, column)}; row {row[0][49]} {fold(0, row)}");
}
