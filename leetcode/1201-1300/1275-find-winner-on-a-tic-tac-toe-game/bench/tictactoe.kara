// LeetCode #1275 bench, in Kāra: the ★ arm (line sums) asked about every
// position of every game of tic-tac-toe, 549,945 of them, each game carried
// on while the answer is "Pending"; 40 rounds, every answer folded into a
// checksum.

fn tictactoe(moves: Vec[Vec[i64]]) -> String {
    let mut rows: Array[i64, 3] = [0, 0, 0];
    let mut cols: Array[i64, 3] = [0, 0, 0];
    let mut diagonal = 0;
    let mut anti = 0;
    let mut turn = 1;
    for m in moves.iter() {
        let (r, c) = (m[0], m[1]);
        rows[r] += turn;
        cols[c] += turn;
        if r == c {
            diagonal += turn;
        }
        if r + c == 2 {
            anti += turn;
        }
        if rows[r].abs() == 3 or cols[c].abs() == 3 or diagonal.abs() == 3 or anti.abs() == 3 {
            return if turn == 1 { "A" } else { "B" };
        }
        turn = -turn;
    }
    if moves.len() == 9 { "Draw" } else { "Pending" }
}

fn walk(moves: mut ref Vec[Vec[i64]], check: mut ref i64) {
    for square in 0..9 {
        let (r, c) = (square / 3, square % 3);
        if moves.iter().any(|m| m[0] == r and m[1] == c) {
            continue;
        }
        moves.push([r, c]);
        let answer = tictactoe(moves);
        let k = if answer == "A" { 0 } else if answer == "B" { 1 } else if answer == "Draw" { 2 } else { 3 };
        *check = (*check * 7 + k) % 1000000007;
        if k == 3 {
            walk(mut moves, mut check);
        }
        moves.pop();
    }
}

fn main() {
    let mut check = 0;
    for round in 0..40 {
        let mut moves: Vec[Vec[i64]] = Vec.new();
        walk(mut moves, mut check);
        check = (check * 131 + round) % 1000000007;
    }
    println(f"40 rounds of every game: checksum {check}");
}
