// LeetCode #1275: the differential -- the six arms against the statement
// read literally and five more properties, on 2000 random games.

// arm 0: tictactoe.kara
fn a0_tictactoe(moves: Vec[Vec[i64]]) -> String {
    let mut rows: Array[i64, 3] = [0, 0, 0];
    let mut cols: Array[i64, 3] = [0, 0, 0];
    let mut diagonal = 0;
    let mut anti = 0;
    let mut turn = 1;
    for m in moves.iter() {
        let (r, c) = (m[0], m[1]);
        rows[r] += turn;
        cols[c] += turn;
        if r == c {
            diagonal += turn;
        }
        if r + c == 2 {
            anti += turn;
        }
        if rows[r].abs() == 3 or cols[c].abs() == 3 or diagonal.abs() == 3 or anti.abs() == 3 {
            return if turn == 1 { "A" } else { "B" };
        }
        turn = -turn;
    }
    if moves.len() == 9 { "Draw" } else { "Pending" }
}

// arm 1: tictactoe_board.kara
fn a1_tictactoe(moves: Vec[Vec[i64]]) -> String {
    let mut board: Vec[char] = Vec.filled(9, '.');
    for (i, m) in moves.iter().enumerate() {
        board[m[0] * 3 + m[1]] = if i % 2 == 0 { 'X' } else { 'O' };
    }
    let lines: Vec[Vec[i64]] = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]];
    for line in lines.iter() {
        let spelled: String = line.iter().map(|i| board[i]).collect();
        if spelled == "XXX" {
            return "A";
        }
        if spelled == "OOO" {
            return "B";
        }
    }
    if moves.len() == 9 { "Draw" } else { "Pending" }
}

// arm 2: tictactoe_bits.kara
const A2LINES: Array[i64, 8] = [0b111, 0b111000, 0b111000000, 0b1001001, 0b10010010, 0b100100100, 0b100010001, 0b1010100];

fn a2_tictactoe(moves: Vec[Vec[i64]]) -> String {
    let mut mask: Array[i64, 2] = [0, 0];
    for (i, m) in moves.iter().enumerate() {
        mask[i % 2] |= 1 << (m[0] * 3 + m[1]);
    }
    for (player, name) in [(0, "A"), (1, "B")] {
        if A2LINES.iter().any(|line| (mask[player] & line) == line) {
            return name.clone();
        }
    }
    if moves.len() == 9 { "Draw" } else { "Pending" }
}

// arm 3: tictactoe_enum.kara
#[derive(Copy, Clone)]
enum A3Player {
    A,
    B,
}

fn a3_tictactoe(moves: Vec[Vec[i64]]) -> String {
    let mut board: Vec[Option[A3Player]] = Vec.new();
    for _ in 0..9 {
        board.push(None);
    }
    for (i, m) in moves.iter().enumerate() {
        board[m[0] * 3 + m[1]] = Some(if i % 2 == 0 { A3Player.A } else { A3Player.B });
    }
    let lines: Array[(i64, i64, i64), 8] = [(0, 1, 2), (3, 4, 5), (6, 7, 8), (0, 3, 6), (1, 4, 7), (2, 5, 8), (0, 4, 8), (2, 4, 6)];
    let winner = lines.iter().find_map(|(a, b, c)| match (board[a], board[b], board[c]) {
        (Some(A3Player.A), Some(A3Player.A), Some(A3Player.A)) => Some("A"),
        (Some(A3Player.B), Some(A3Player.B), Some(A3Player.B)) => Some("B"),
        _ => None,
    });
    match winner {
        Some(w) => w.to_string(),
        None => if moves.len() == 9 { "Draw" } else { "Pending" },
    }
}

// arm 4: tictactoe_last.kara
fn a4_tictactoe(moves: Vec[Vec[i64]]) -> String {
    let n = moves.len();
    let mine: Set[(i64, i64)] = moves.iter().enumerate().filter(|(i, _)| i % 2 == (n - 1) % 2).map(|(_, m)| (m[0], m[1])).collect();
    let mut won = (0..3).all(|j| mine.contains((j, j))) or (0..3).all(|j| mine.contains((j, 2 - j)));
    for k in 0..3 {
        won = won or (0..3).all(|j| mine.contains((k, j))) or (0..3).all(|j| mine.contains((j, k)));
    }
    if won {
        if n % 2 == 1 { "A" } else { "B" }
    } else if n == 9 {
        "Draw"
    } else {
        "Pending"
    }
}

// arm 5: tictactoe_solution.kara
impl A5Solution {
    pub fn tictactoe(moves: Vec[Vec[i32]]) -> String {
        let mut lines = [0i32; 8];
        for (i, m) in moves.iter().enumerate() {
            let d = if i % 2 == 0 { 1 } else { -1 };
            let (r, c) = (m[0] as usize, m[1] as usize);
            lines[r] += d;
            lines[3 + c] += d;
            if r == c {
                lines[6] += d;
            }
            if r + c == 2 {
                lines[7] += d;
            }
        }
        for s in lines.iter() {
            if s == 3 {
                return "A";
            }
            if s == -3 {
                return "B";
            }
        }
        if moves.len() == 9 {
            "Draw"
        } else {
            "Pending"
        }
    }
}

struct A5Solution {}

fn a5_tictactoe(moves: Vec[Vec[i64]]) -> String {
    A5Solution.tictactoe(moves.iter().map(|m| m.iter().map(|x| x as i32).collect()).collect())
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// ---- the differential ------------------------------------------------------

fn arm(k: i64, moves: Vec[Vec[i64]]) -> String {
    match k {
        0 => a0_tictactoe(moves),
        1 => a1_tictactoe(moves),
        2 => a2_tictactoe(moves),
        3 => a3_tictactoe(moves),
        4 => a4_tictactoe(moves),
        _ => a5_tictactoe(moves),
    }
}

// The statement read literally: A writes `X` and B `O` in turn on an empty
// grid; three of one character filling a row, a column or a diagonal is
// that player's win, a full grid without one a draw, anything else
// pending. Each line is found by asking every square whether it lies on it.
fn literal(moves: Vec[Vec[i64]]) -> String {
    let mut grid: Vec[Vec[char]] = Vec.filled(3, Vec.filled(3, ' '));
    for i in 0..moves.len() {
        grid[moves[i][0]][moves[i][1]] = if i % 2 == 0 { 'X' } else { 'O' };
    }
    for line in 0..8 {
        let mut cells: Vec[char] = Vec.new();
        for r in 0..3 {
            for c in 0..3 {
                let on = if line < 3 { r == line } else if line < 6 { c == line - 3 } else if line == 6 { r == c } else { r + c == 2 };
                if on {
                    cells.push(grid[r][c]);
                }
            }
        }
        let first = cells[0];
        if first != ' ' and cells.iter().all(|x| x == first) {
            return if first == 'X' { "A" } else { "B" };
        }
    }
    if grid.iter().all(|row| row.iter().all(|x| x != ' ')) { "Draw" } else { "Pending" }
}

fn moved(moves: Vec[Vec[i64]], quarter: bool) -> Vec[Vec[i64]] {
    moves.iter().map(|m| if quarter { [m[1], 2 - m[0]] } else { [m[0], 2 - m[1]] }).collect()
}

fn main() {
    let mut seed = 12750;
    let mut fails: Array[i64, 6] = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for _ in 0..2000 {
        // a random game, played until it ends or is cut short
        let mut order: Vec[i64] = (0..9).collect();
        for i in (1..9).rev() {
            let j = next_random(mut seed) % (i + 1);
            order.swap(i, j);
        }
        let stop = 1 + next_random(mut seed) % 9;
        let mut moves: Vec[Vec[i64]] = Vec.new();
        for square in order.iter() {
            moves.push([square / 3, square % 3]);
            if moves.len() == stop or literal(moves) != "Pending" {
                break;
            }
        }
        let want = literal(moves);
        // each player's moves shuffled among that player's own turns
        let mut shuffled = moves.clone();
        for player in 0..2 {
            let turns: Vec[i64] = (0..moves.len()).filter(|i| i % 2 == player).collect();
            for t in (1..turns.len()).rev() {
                let u = next_random(mut seed) % (t + 1);
                shuffled.swap(turns[t], turns[u]);
            }
        }
        let star = arm(0, moves);
        let k = if star == "A" { 0 } else if star == "B" { 1 } else if star == "Draw" { 2 } else { 3 };
        check = (check * 131 + k * 10 + moves.len()) % 1000000007;
        for a in 0..6 {
            let got = arm(a, moves);
            if got != want {
                fails[0] += 1;
            }
            let fits = if got == "Draw" { moves.len() == 9 } else if got == "Pending" { moves.len() < 9 } else { (got == "A" or got == "B") and moves.len() >= 5 };
            if not fits {
                fails[1] += 1;
            }
            if arm(a, moved(moves, true)) != got {
                fails[2] += 1;
            }
            if arm(a, moved(moves, false)) != got {
                fails[3] += 1;
            }
            if arm(a, shuffled) != got {
                fails[4] += 1;
            }
            if got != star {
                fails[5] += 1;
            }
            checks += 6;
        }
    }
    let mut total = 0;
    for p in 0..6 {
        if fails[p] > 0 {
            print(f"P{p + 1}: {fails[p]} failures ");
        }
        total += fails[p];
    }
    println(f"2000 games: checksum {check}, {checks} checks over 6 arms: {total} failures");
}
