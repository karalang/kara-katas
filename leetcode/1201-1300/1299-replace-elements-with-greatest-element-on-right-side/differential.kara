// LeetCode #1299: Replace Elements with Greatest Element on Right Side --
// differential test of the six arms against the statement read literally,
// with five more properties.
//
// The statement: replace every element in the array with the greatest
// element among the elements to its right, and replace the last element
// with -1.

// ---- replace_elements.kara ----
fn a0_replace_elements(arr: Vec[i64]) -> Vec[i64] {
    let n = arr.len();
    let mut out: Vec[i64] = Vec.filled(n, -1);
    let mut greatest = -1;
    for i in (0..n).rev() {
        out[i] = greatest;
        if arr[i] > greatest {
            greatest = arr[i];
        }
    }
    out
}

// ---- replace_elements_naive.kara ----
fn a1_replace_elements(arr: Vec[i64]) -> Vec[i64] {
    let n = arr.len();
    let mut out: Vec[i64] = Vec.new();
    for i in 0..n {
        let mut greatest = -1;
        for j in i + 1..n {
            if arr[j] > greatest {
                greatest = arr[j];
            }
        }
        out.push(greatest);
    }
    out
}

// ---- replace_elements_recursive.kara ----
fn a2_fill_from(i: i64, arr: Vec[i64], out: mut ref Vec[i64]) -> i64 {
    if i == arr.len() {
        return -1;
    }
    let after = a2_fill_from(i + 1, arr, mut out);
    out[i] = after;
    arr[i].max(after)
}

fn a2_replace_elements(arr: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.filled(arr.len(), 0);
    a2_fill_from(0, arr, mut out);
    out
}

// ---- replace_elements_heap.kara ----
fn a3_replace_elements(arr: Vec[i64]) -> Vec[i64] {
    let n = arr.len();
    let mut heap: PriorityQueue[(i64, i64)] = PriorityQueue.max_first();
    for i in 0..n {
        heap.push((arr[i], i));
    }
    let mut out: Vec[i64] = Vec.new();
    for i in 0..n {
        while let Some((_, at)) = heap.peek() {
            if at > i {
                break;
            }
            heap.pop();
        }
        out.push(match heap.peek() {
            Some((value, _)) => value,
            None => -1,
        });
    }
    out
}

// ---- replace_elements_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_replace_elements(arr: own Vec[i32]) -> Vec[i32] {
        let mut arr = arr;
        let mut max = -1;
        for i in (0..arr.len()).rev() {
            let cur = arr[i];
            arr[i] = max;
            max = max.max(cur);
        }
        arr
    }
}

fn a4_replace_elements(arr: Vec[i64]) -> Vec[i64] {
    A4Solution.a4_replace_elements(arr.iter().map(|x| x as i32).collect())
        .iter()
        .map(|x| x as i64)
        .collect()
}

// ---- replace_elements_scan.kara ----
struct A5Solution {}

impl A5Solution {
    pub fn a5_replace_elements(arr: Vec[i32]) -> Vec[i32] {
        let mut res: Vec[i32] = arr
            .iter()
            .rev()
            .scan(-1i32, |m, x| { let r = m; let m = m.max(x); Some((m, r)) })
            .collect();
        res.reverse();
        res
    }
}

fn a5_replace_elements(arr: Vec[i64]) -> Vec[i64] {
    A5Solution.a5_replace_elements(arr.iter().map(|x| x as i32).collect())
        .iter()
        .map(|x| x as i64)
        .collect()
}

// ---- the statement read literally -----------------------------------------

// For each place, the numbers to its right gathered and sorted, the last of
// them the greatest; -1 where there are none.
fn literal(arr: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for i in 0..arr.len() {
        let mut right: Vec[i64] = Vec.new();
        for j in i + 1..arr.len() {
            right.push(arr[j]);
        }
        right.sort();
        out.push(if right.len() == 0 { -1 } else { right[right.len() - 1] });
    }
    out
}

// ---- the checks -------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Case {
    arr: Vec[i64],
    shift: i64,
    extra: i64,
    cut: i64,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, arr: Vec[i64]) -> Vec[i64] {
    match i {
        0 => a0_replace_elements(arr),
        1 => a1_replace_elements(arr),
        2 => a2_replace_elements(arr),
        3 => a3_replace_elements(arr),
        4 => a4_replace_elements(arr),
        _ => a5_replace_elements(arr),
    }
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn greater(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn check_case(t: mut ref Tally, c: Case) {
    let n = c.arr.len();
    let want = literal(c.arr);
    t.cases += 1;
    for x in want.iter() {
        t.check = (t.check * 131 + x + 1) % 1000000007;
    }
    let shifted: Vec[i64] = c.arr.iter().map(|x| x + c.shift).collect();
    let mut appended = c.arr.clone();
    appended.push(c.extra);
    let suffix: Vec[i64] = c.arr[c.cut..n].to_vec();
    let mut prepended: Vec[i64] = [c.extra];
    for x in c.arr.iter() {
        prepended.push(x);
    }
    let star = a0_replace_elements(c.arr);
    for i in 0..6 {
        let got = arm(i, c.arr);
        let what = f"arm {i} case {t.cases} {show(c.arr)}: got {show(got)}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}, literal {show(want)}");
        // P2: every number shifted up, every answer shifted up but the -1
        let sh = arm(i, shifted);
        let mut ok = sh.len() == n;
        for j in 0..n {
            if ok {
                ok = sh[j] == if j == n - 1 { -1 } else { got[j] + c.shift };
            }
        }
        expect(mut t, 2, ok, f"P2 {what}, shifted by {c.shift}: {show(sh)}");
        // P3: one number appended, the earlier answers raised to it and the
        // new last -1
        let ap = arm(i, appended);
        let mut ok = ap.len() == n + 1 and ap[n] == -1;
        for j in 0..n {
            if ok {
                ok = ap[j] == greater(got[j], c.extra);
            }
        }
        expect(mut t, 3, ok, f"P3 {what}, {c.extra} appended: {show(ap)}");
        // P4: the numbers from a cut on, the same answers there
        let sf = arm(i, suffix);
        expect(mut t, 4, sf == got[c.cut..n].to_vec(), f"P4 {what}, from {c.cut}: {show(sf)}");
        // P5: one number put in front, the rest unchanged and the new first
        // the greatest of the old numbers
        let pp = arm(i, prepended);
        let mut most = -1;
        for x in c.arr.iter() {
            most = greater(most, x);
        }
        let ok = pp.len() == n + 1 and pp[0] == most and pp[1..n + 1].to_vec() == got;
        expect(mut t, 5, ok, f"P5 {what}, {c.extra} in front: {show(pp)}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {show(star)}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 arrays of 1 to 12 numbers in four kinds, 500 each: numbers up to
    // 5, so that ties are common; up to 10^5; rising; and falling. Every
    // array, shift, extra number and cut is drawn before any arm answers.
    let mut seed = 12991;
    let mut cases: Vec[Case] = Vec.new();
    for i in 0..2000 {
        let kind = i / 500;
        let n = 1 + next_random(mut seed) % 12;
        let mut arr: Vec[i64] = Vec.new();
        let mut at = 1 + next_random(mut seed) % 100;
        for _ in 0..n {
            if kind == 0 {
                arr.push(1 + next_random(mut seed) % 5);
            } else if kind == 1 {
                arr.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000);
            } else {
                at += 1 + next_random(mut seed) % 10;
                arr.push(at);
            }
        }
        if kind == 3 {
            arr.reverse();
        }
        let shift = 1 + next_random(mut seed) % 1000;
        let extra = 1 + next_random(mut seed) % (if kind == 0 { 6 } else { 2000 });
        let cut = next_random(mut seed) % n;
        cases.push(Case { arr, shift, extra, cut });
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} arrays: checksum {t.check}, {t.checks} checks over 6 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
