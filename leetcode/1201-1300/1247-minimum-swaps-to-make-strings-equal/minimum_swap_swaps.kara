// LeetCode #1247: Minimum Swaps to Make Strings Equal -- doing it: the
// places that differ gathered by kind, two of the same kind fixed with
// one swap between the strings, and a last pair of one of each turned
// into two of the same kind by a swap inside the pair and then fixed
// with a second; the strings are compared at the end.

fn minimum_swap(s1: Str, s2: Str) -> i64 {
    let mut a: Vec[char] = s1.chars().collect();
    let mut b: Vec[char] = s2.chars().collect();
    let mut xy: Vec[i64] = Vec.new();
    let mut yx: Vec[i64] = Vec.new();
    for i in 0..a.len() {
        if a[i] != b[i] {
            if a[i] == 'x' {
                xy.push(i);
            } else {
                yx.push(i);
            }
        }
    }
    let mut swaps = 0;
    for kind in [xy.clone(), yx.clone()] {
        let mut k = 0;
        while k + 1 < kind.len() {
            // `a[i]` over `b[i]` and `a[j]` over `b[j]` alike: swapping
            // `a[i]` with `b[j]` fixes both.
            let i = kind[k];
            let j = kind[k + 1];
            let t = a[i];
            a[i] = b[j];
            b[j] = t;
            swaps += 1;
            k += 2;
        }
    }
    if xy.len() % 2 == 1 and yx.len() % 2 == 1 {
        // One `x` over `y` at `i` and one `y` over `x` at `j`: swapping
        // `a[i]` with `b[i]` makes them alike, and a second swap fixes
        // both.
        let i = xy[xy.len() - 1];
        let j = yx[yx.len() - 1];
        let t = a[i];
        a[i] = b[i];
        b[i] = t;
        let t = a[i];
        a[i] = b[j];
        b[j] = t;
        swaps += 2;
    }
    if a == b { swaps } else { -1 }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random string of `n` letters `x` and `y`, each `x` with chance
// `percent` in 100.
fn random_xy(n: i64, percent: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(if next_random(mut seed) % 100 < percent { 'x' } else { 'y' });
    }
    s
}

fn main() {
    // LeetCode's examples
    let a = minimum_swap("xx", "yy");
    let b = minimum_swap("xy", "yx");
    let c = minimum_swap("xx", "xy");
    let d = minimum_swap("xxyyxyxyxx", "xyyxyxxxyx");
    println(f"{a} {b} {c} {d}");
    // 1000 random pairs of 1 to 1000 letters, each with its own mix of
    // `x` and `y`
    let mut seed = 1247;
    let mut total = 0;
    let mut impossible = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 1000 + 1;
        let p1 = next_random(mut seed) % 101;
        let p2 = next_random(mut seed) % 101;
        let s1 = random_xy(n, p1, mut seed);
        let s2 = random_xy(n, p2, mut seed);
        let swaps = minimum_swap(s1, s2);
        if swaps < 0 {
            impossible += 1;
        } else {
            total += swaps;
        }
        check = (check * 131 + swaps + 1) % 1000000007;
    }
    println(f"1000 random pairs: {impossible} impossible, total {total}, checksum {check}");
    // the constraints' top: 1000 letters, every place different, half
    // each way and all one way
    let half = "xy".repeat(500);
    let flipped = "yx".repeat(500);
    let all_x = "x".repeat(1000);
    let all_y = "y".repeat(1000);
    println(f"1000 letters: crossed {minimum_swap(half, flipped)}, one way {minimum_swap(all_x, all_y)}");
}
