// LeetCode #1247: the differential -- the five arms against the statement
// read literally and four more properties, on 2000 random pairs.

// arm 0: minimum_swap.kara
fn a0_minimum_swap(s1: Str, s2: Str) -> i64 {
    let mut x_over_y = 0;
    let mut y_over_x = 0;
    for (a, b) in s1.chars().zip(s2.chars()) {
        if a == 'x' and b == 'y' {
            x_over_y += 1;
        } else if a == 'y' and b == 'x' {
            y_over_x += 1;
        }
    }
    if (x_over_y + y_over_x) % 2 == 1 {
        return -1;
    }
    x_over_y / 2 + y_over_x / 2 + 2 * (x_over_y % 2)
}

// arm 1: minimum_swap_bytes.kara
fn a1_minimum_swap(s1: Str, s2: Str) -> i64 {
    let one = s1.bytes();
    let two = s2.bytes();
    let mut xy = 0;
    let mut yx = 0;
    for i in 0..one.len() {
        match (one[i], two[i]) {
            (b'x', b'y') => xy += 1,
            (b'y', b'x') => yx += 1,
            _ => {}
        }
    }
    match (xy % 2, yx % 2) {
        (0, 0) => xy / 2 + yx / 2,
        (1, 1) => xy / 2 + yx / 2 + 2,
        _ => -1,
    }
}

// arm 2: minimum_swap_swaps.kara
fn a2_minimum_swap(s1: Str, s2: Str) -> i64 {
    let mut a: Vec[char] = s1.chars().collect();
    let mut b: Vec[char] = s2.chars().collect();
    let mut xy: Vec[i64] = Vec.new();
    let mut yx: Vec[i64] = Vec.new();
    for i in 0..a.len() {
        if a[i] != b[i] {
            if a[i] == 'x' {
                xy.push(i);
            } else {
                yx.push(i);
            }
        }
    }
    let mut swaps = 0;
    for kind in [xy.clone(), yx.clone()] {
        let mut k = 0;
        while k + 1 < kind.len() {
            // `a[i]` over `b[i]` and `a[j]` over `b[j]` alike: swapping
            // `a[i]` with `b[j]` fixes both.
            let i = kind[k];
            let j = kind[k + 1];
            let t = a[i];
            a[i] = b[j];
            b[j] = t;
            swaps += 1;
            k += 2;
        }
    }
    if xy.len() % 2 == 1 and yx.len() % 2 == 1 {
        // One `x` over `y` at `i` and one `y` over `x` at `j`: swapping
        // `a[i]` with `b[i]` makes them alike, and a second swap fixes
        // both.
        let i = xy[xy.len() - 1];
        let j = yx[yx.len() - 1];
        let t = a[i];
        a[i] = b[i];
        b[i] = t;
        let t = a[i];
        a[i] = b[j];
        b[j] = t;
        swaps += 2;
    }
    if a == b { swaps } else { -1 }
}

// arm 3: minimum_swap_iter.kara
fn a3_minimum_swap(s1: Str, s2: Str) -> i64 {
    let xy = s1.chars().zip(s2.chars()).filter(|(a, b)| a == 'x' and b == 'y').count();
    let yx = s1.chars().zip(s2.chars()).filter(|(a, b)| a == 'y' and b == 'x').count();
    if (xy + yx) % 2 != 0 {
        -1
    } else {
        (xy + 1) / 2 + (yx + 1) / 2
    }
}

// arm 4: minimum_swap_solution.kara
struct A4Solution {}

impl A4Solution {
    pub fn minimum_swap(s1: String, s2: String) -> i32 {
        let mut (xy, yx) = (0, 0);
        for (a, b) in s1.bytes().iter().zip(s2.bytes().iter()) {
            if a == b'x' and b == b'y' {
                xy += 1;
            } else if a == b'y' and b == b'x' {
                yx += 1;
            }
        }
        if (xy + yx) % 2 == 1 {
            return -1;
        }
        xy / 2 + yx / 2 + (xy % 2) * 2
    }
}

fn a4_minimum_swap(s1: Str, s2: Str) -> i64 {
    A4Solution.minimum_swap(s1.to_string(), s2.to_string())
}

// The statement read literally: a breadth-first search over every pair of
// strings the swaps reach, each string kept as a bit mask of its `x`s,
// each move any `s1[i]` swapped with any `s2[j]`, until the two are equal;
// `-1` when no pair reached is.
fn literal(s1: Str, s2: Str) -> i64 {
    let n = s1.len();
    let mask = |s: Str| {
        let mut m = 0;
        for (i, c) in s.chars().enumerate() {
            if c == 'x' {
                m |= 1 << i;
            }
        }
        m
    };
    let start = (mask(s1) << n) | mask(s2);
    let low = (1 << n) - 1;
    let mut dist: Vec[i64] = Vec.filled(1 << (2 * n), -1);
    dist[start] = 0;
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(start);
    while let Some(state) = queue.pop_front() {
        let a = state >> n;
        let b = state & low;
        if a == b {
            return dist[state];
        }
        for i in 0..n {
            for j in 0..n {
                let ai = (a >> i) & 1;
                let bj = (b >> j) & 1;
                let na = (a & ~(1 << i)) | (bj << i);
                let nb = (b & ~(1 << j)) | (ai << j);
                let next = (na << n) | nb;
                if dist[next] < 0 {
                    dist[next] = dist[state] + 1;
                    queue.push_back(next);
                }
            }
        }
    }
    -1
}

fn arms(s1: Str, s2: Str) -> Vec[i64] {
    [a0_minimum_swap(s1, s2), a1_minimum_swap(s1, s2), a2_minimum_swap(s1, s2), a3_minimum_swap(s1, s2), a4_minimum_swap(s1, s2)]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_xy(n: i64, percent: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(if next_random(mut seed) % 100 < percent { 'x' } else { 'y' });
    }
    s
}

fn flip(s: Str) -> String {
    s.chars().map(|c| if c == 'x' { 'y' } else { 'x' }).collect()
}

fn main() {
    let names = ["the statement read literally", "the two strings traded", "every x a y and every y an x", "the places reordered alike in both", "-1 exactly for an odd count of x", "the ★ arm's answer"];
    let mut fails = Vec.filled(6, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 12470;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 5 + 1;
        let p1 = next_random(mut seed) % 101;
        let p2 = next_random(mut seed) % 101;
        let s1 = random_xy(n, p1, mut seed);
        let s2 = random_xy(n, p2, mut seed);
        let want = literal(s1, s2);
        check = (check * 131 + want + 1) % 1000000007;
        let got = arms(s1, s2);
        let traded = arms(s2, s1);
        let flipped = arms(flip(s1), flip(s2));
        let mut order: Vec[i64] = (0..n).collect();
        for i in (1..n).rev() {
            let j = next_random(mut seed) % (i + 1);
            order.swap(i, j);
        }
        let c1: Vec[char] = s1.chars().collect();
        let c2: Vec[char] = s2.chars().collect();
        let r1: String = order.iter().map(|i| c1[i]).collect();
        let r2: String = order.iter().map(|i| c2[i]).collect();
        let reordered = arms(r1, r2);
        let xs = s1.chars().filter(|c| c == 'x').count() + s2.chars().filter(|c| c == 'x').count();
        for arm in 0..5 {
            let d = got[arm];
            let held = [
                d == want,
                traded[arm] == d,
                flipped[arm] == d,
                reordered[arm] == d,
                (d == -1) == (xs % 2 == 1),
                d == got[0],
            ];
            for t in 0..6 {
                checks += 1;
                if not held[t] {
                    fails[t] += 1;
                    if fails[t] <= 2 {
                        println(f"P{t + 1} ({names[t]}) fails on arm {arm}: {s1} {s2} -> {d}");
                    }
                }
            }
        }
    }
    let total: i64 = fails.iter().sum();
    for t in 0..6 {
        if fails[t] > 0 {
            print(f"P{t + 1}: {fails[t]} failures ");
        }
    }
    println(f"2000 pairs: checksum {check}, {checks} checks over 5 arms: {total} failures");
}
