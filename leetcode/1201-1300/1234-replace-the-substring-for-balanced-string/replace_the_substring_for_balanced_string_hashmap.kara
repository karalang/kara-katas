// LeetCode #1234: Replace the Substring for Balanced String -- another Rust
// solution: the counts in a `HashMap<char, i32>` built through
// `*count.entry(c).or_insert(0) += 1`, changed through
// `*count.get_mut(&c).unwrap()`, and read back by `unwrap_or(&0)`,
// carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn balanced_string(s: String) -> i32 {
        let chars: Vec[char] = s.chars().collect();
        let n = chars.len() as i32;
        let k = n / 4;
        let mut count: Map[char, i32] = Map.new();
        for c in ref chars {
            *count.entry(c).or_insert(0) += 1;
        }
        let balanced = |count: ref Map[char, i32]| "QWER".chars().all(|c| *count.get(c).unwrap_or(0) <= k);
        if balanced(count) {
            return 0;
        }
        let mut res = n;
        let mut left = 0;
        for right in 0..chars.len() {
            *count.get_mut(chars[right]).unwrap() -= 1;
            while left <= right and balanced(count) {
                res = res.min((right - left + 1) as i32);
                *count.get_mut(chars[left]).unwrap() += 1;
                left += 1;
            }
        }
        res
    }
}

fn balanced_string(s: String) -> i64 {
    Solution.balanced_string(s)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters from "QWER" from `seed`, each letter drawn with a weight so
// that some strings lean far from balanced.
fn letters(n: i64, lean: i64, seed: mut ref i64) -> String {
    let mut s = "";
    for _ in 0..n {
        let r = next_random(mut seed) % (4 + lean);
        s.push(if r >= 4 or r == 0 { 'Q' } else if r == 1 { 'W' } else if r == 2 { 'E' } else { 'R' });
    }
    s
}

fn main() {
    // LeetCode's three examples, and one letter only
    println(f"{balanced_string("QWER")}");
    println(f"{balanced_string("QQWE")}");
    println(f"{balanced_string("QQQW")}");
    println(f"{balanced_string("QQQQ")}");
    // 1000 random strings of 4 to 40 letters
    let mut seed = 1234;
    let mut check = 0;
    for _ in 0..1000 {
        let n = (next_random(mut seed) % 10 + 1) * 4;
        let s = letters(n, next_random(mut seed) % 5, mut seed);
        check = (check * 131 + balanced_string(s)) % 1000000007;
    }
    println(f"1000 random strings: checksum {check}");
    // the constraints' top, 10^5 letters: drawn evenly, leaning, and balanced
    println(f"10^5 letters: {balanced_string(letters(100000, 0, mut seed))}, {balanced_string(letters(100000, 2, mut seed))}, {balanced_string("QWER".repeat(25000))}");
}
