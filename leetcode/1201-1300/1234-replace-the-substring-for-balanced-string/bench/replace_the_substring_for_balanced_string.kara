// LeetCode #1234 bench: the ★ arm, a sliding window shrunk while no letter
// outside it passes n / 4, over 40 random strings of 10^5 letters, `Q`
// drawn up to four times as often as the rest, drawn once and each solved
// 20 times.

fn index(c: u8) -> i64 {
    match c {
        b'Q' => 0,
        b'W' => 1,
        b'E' => 2,
        _ => 3,
    }
}

fn balanced_string(s: String) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let k = n / 4;
    let mut outside = [0; 4];
    for b in bytes.iter() {
        outside[index(b)] += 1;
    }
    if outside.iter().all(|c| c == k) {
        return 0;
    }
    let mut best = n;
    let mut left = 0;
    for right in 0..n {
        outside[index(bytes[right])] -= 1;
        while left <= right and outside.iter().all(|c| c <= k) {
            best = best.min(right - left + 1);
            outside[index(bytes[left])] += 1;
            left += 1;
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1234;
    let mut strings: Vec[String] = Vec.new();
    for t in 0..40 {
        let lean = t % 4;
        let mut s = "".to_string();
        for _ in 0..100000 {
            let r = next_random(mut seed) % (4 + lean);
            s.push(if r >= 4 or r == 0 { 'Q' } else if r == 1 { 'W' } else if r == 2 { 'E' } else { 'R' });
        }
        strings.push(s);
    }
    let mut check = 0;
    for _ in 0..20 {
        for s in strings.iter() {
            check = (check * 131 + balanced_string(s)) % 1000000007;
        }
    }
    println(f"40 strings of 10^5 letters, 20 passes: checksum {check}");
}
