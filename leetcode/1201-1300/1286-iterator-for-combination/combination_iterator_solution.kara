// LeetCode #1286: Iterator for Combination -- a Rust solution as
// LeetCode's Rust users write it (every mask from the largest down whose
// `count_ones` is the length, each turned into its `String` by a
// `filter(|&i| ..).map(..).collect()`, the list reversed so that `next` can
// `pop`), carried to Kāra by `karac fix`.

struct CombinationIterator {
    combos: Vec[String],
}

impl CombinationIterator {
    fn new(characters: String, combination_length: i32) -> Self {
        let chars: Vec[char] = characters.chars().collect();
        let n = chars.len();
        let k = combination_length as usize;
        let mut combos = Vec.new();
        for mask in (0..(1u32 << n)).rev() {
            if mask.count_ones() as usize == k {
                let s: String = (0..n)
                    .filter(|i| mask & (1 << (n - 1 - i)) != 0)
                    .map(|i| chars[i])
                    .collect();
                combos.push(s);
            }
        }
        combos.reverse();
        CombinationIterator { combos }
    }

    fn next(mut ref self) -> String {
        self.combos.pop().unwrap()
    }

    fn has_next(self) -> bool {
        not self.combos.is_empty()
    }
}

// The harness's length, handed over as LeetCode's `i32`.
fn make(characters: String, k: i64) -> CombinationIterator {
    CombinationIterator.new(characters, k as i32)
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` distinct letters, sorted: the letters of the alphabet kept or not by
// chance until `n` are kept.
fn letters(seed: mut ref i64, n: i64) -> String {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    let mut out = "";
    let mut left = n;
    for (i, c) in alphabet.chars().enumerate() {
        if left > 0 and next_random(mut *seed) % (26 - i) < left {
            out.push(c);
            left -= 1;
        }
    }
    out
}

fn main() {
    // LeetCode's example
    let mut it = make("abc", 2);
    let first = it.next();
    let a = it.has_next();
    let second = it.next();
    let b = it.has_next();
    let third = it.next();
    let c = it.has_next();
    println(f"{first} {a} {second} {b} {third} {c}");
    // every length k of every set of n letters, n up to 15; the calls to
    // has_next repeated at random, as a caller may
    let mut seed = 1286;
    let mut check = 0;
    for n in 1..16 {
        let mut count = 0;
        let mut last = "";
        for k in 1..(n + 1) {
            let chars = letters(mut seed, n);
            let mut it = make(chars, k);
            while it.has_next() {
                if next_random(mut seed) % 3 == 0 {
                    let again = it.has_next();
                    if not again {
                        println("has_next changed its answer");
                    }
                }
                let s = it.next();
                count += 1;
                for b in s.bytes().iter() {
                    check = (check * 131 + *b) % 1000000007;
                }
                check = (check * 131 + 7) % 1000000007;
                last = s;
            }
        }
        println(f"{n} letters: {count} combinations, the last {last}");
    }
    println(f"checksum {check}");
}
