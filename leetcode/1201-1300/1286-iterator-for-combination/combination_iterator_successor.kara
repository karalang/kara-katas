// LeetCode #1286: Iterator for Combination -- by successor on the text
// itself: the iterator keeps the next combination as a `String`, and finds
// the one after it by locating, from the right, the first letter that
// `find` can move one place along the characters with room to its right,
// then refilling the tail from there. O(nk) a call

struct CombinationIterator {
    characters: String,
    upcoming: Option[String],
}

fn successor(characters: Str, current: Str) -> Option[String] {
    let n = characters.len();
    let k = current.len();
    let mut i = k - 1;
    while i >= 0 {
        let at = characters.find(current[i..i + 1]).unwrap();
        if at + 1 <= n - (k - i) {
            let mut out = current[0..i].to_string();
            out.push_str(characters[at + 1..at + 1 + (k - i)]);
            return Some(out);
        }
        i -= 1;
    }
    None
}

impl CombinationIterator {
    fn new(characters: own String, combination_length: i64) -> CombinationIterator {
        let first = characters[0..combination_length].to_string();
        CombinationIterator { characters, upcoming: Some(first) }
    }

    fn next(mut ref self) -> String {
        let current = self.upcoming.take().unwrap();
        self.upcoming = successor(self.characters, current);
        current
    }

    fn has_next(self) -> bool {
        self.upcoming.is_some()
    }
}

fn make(characters: own String, k: i64) -> CombinationIterator {
    CombinationIterator.new(characters, k)
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` distinct letters, sorted: the letters of the alphabet kept or not by
// chance until `n` are kept.
fn letters(seed: mut ref i64, n: i64) -> String {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    let mut out = "";
    let mut left = n;
    for (i, c) in alphabet.chars().enumerate() {
        if left > 0 and next_random(mut *seed) % (26 - i) < left {
            out.push(c);
            left -= 1;
        }
    }
    out
}

fn main() {
    // LeetCode's example
    let mut it = make("abc", 2);
    let first = it.next();
    let a = it.has_next();
    let second = it.next();
    let b = it.has_next();
    let third = it.next();
    let c = it.has_next();
    println(f"{first} {a} {second} {b} {third} {c}");
    // every length k of every set of n letters, n up to 15; the calls to
    // has_next repeated at random, as a caller may
    let mut seed = 1286;
    let mut check = 0;
    for n in 1..16 {
        let mut count = 0;
        let mut last = "";
        for k in 1..(n + 1) {
            let chars = letters(mut seed, n);
            let mut it = make(chars, k);
            while it.has_next() {
                if next_random(mut seed) % 3 == 0 {
                    let again = it.has_next();
                    if not again {
                        println("has_next changed its answer");
                    }
                }
                let s = it.next();
                count += 1;
                for b in s.bytes().iter() {
                    check = (check * 131 + *b) % 1000000007;
                }
                check = (check * 131 + 7) % 1000000007;
                last = s;
            }
        }
        println(f"{n} letters: {count} combinations, the last {last}");
    }
    println(f"checksum {check}");
}
