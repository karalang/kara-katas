// LeetCode #1286: Iterator for Combination -- by listing them all first:
// a backtracking search writes every combination, in lexicographic order,
// into a `Vec[String]`, and the iterator walks an index along it.
// O(C(n, k) k) at construction, O(1) a call

struct CombinationIterator {
    all: Vec[String],
    at: i64,
}

fn extend(chars: Vec[char], k: i64, from: i64, picked: mut ref String, all: mut ref Vec[String]) {
    if picked.len() == k {
        all.push(picked.clone());
        return;
    }
    for i in from..chars.len() {
        picked.push(chars[i]);
        extend(chars, k, i + 1, mut picked, mut all);
        picked.pop();
    }
}

impl CombinationIterator {
    fn new(characters: String, combination_length: i64) -> CombinationIterator {
        let chars: Vec[char] = characters.chars().collect();
        let mut all: Vec[String] = Vec.new();
        let mut picked = "";
        extend(chars, combination_length, 0, mut picked, mut all);
        CombinationIterator { all, at: 0 }
    }

    fn next(mut ref self) -> String {
        self.at += 1;
        self.all[self.at - 1].clone()
    }

    fn has_next(self) -> bool {
        self.at < self.all.len()
    }
}

fn make(characters: String, k: i64) -> CombinationIterator {
    CombinationIterator.new(characters, k)
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` distinct letters, sorted: the letters of the alphabet kept or not by
// chance until `n` are kept.
fn letters(seed: mut ref i64, n: i64) -> String {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    let mut out = "";
    let mut left = n;
    for (i, c) in alphabet.chars().enumerate() {
        if left > 0 and next_random(mut *seed) % (26 - i) < left {
            out.push(c);
            left -= 1;
        }
    }
    out
}

fn main() {
    // LeetCode's example
    let mut it = make("abc", 2);
    let first = it.next();
    let a = it.has_next();
    let second = it.next();
    let b = it.has_next();
    let third = it.next();
    let c = it.has_next();
    println(f"{first} {a} {second} {b} {third} {c}");
    // every length k of every set of n letters, n up to 15; the calls to
    // has_next repeated at random, as a caller may
    let mut seed = 1286;
    let mut check = 0;
    for n in 1..16 {
        let mut count = 0;
        let mut last = "";
        for k in 1..(n + 1) {
            let chars = letters(mut seed, n);
            let mut it = make(chars, k);
            while it.has_next() {
                if next_random(mut seed) % 3 == 0 {
                    let again = it.has_next();
                    if not again {
                        println("has_next changed its answer");
                    }
                }
                let s = it.next();
                count += 1;
                for b in s.bytes().iter() {
                    check = (check * 131 + *b) % 1000000007;
                }
                check = (check * 131 + 7) % 1000000007;
                last = s;
            }
        }
        println(f"{n} letters: {count} combinations, the last {last}");
    }
    println(f"checksum {check}");
}
