// LeetCode #1259: Handshakes That Don't Cross -- a Rust solution as
// LeetCode's Rust users write it, carried to Kāra by `karac fix`.

impl Solution {
    pub fn number_of_ways(num_people: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let n = (num_people / 2) as i64;
        let mut dp = Vec.filled(n + 1, 0);
        dp[0] = 1;
        for i in 1..=n {
            for j in 0..i {
                dp[i] = (dp[i] + dp[j] * dp[i - 1 - j]) % MOD;
            }
        }
        dp[n] as i32
    }
}

struct Solution {}

// The harness's count, handed over as LeetCode's `i32`.
fn number_of_ways(num_people: i64) -> i64 {
    Solution.number_of_ways(num_people as i32)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's examples
    println(f"{number_of_ways(4)} {number_of_ways(6)}");
    // every even count of people from 2 to 1000
    let mut total = 0;
    let mut check = 0;
    let mut n = 2;
    while n <= 1000 {
        let w = number_of_ways(n);
        total = (total + w) % 1000000007;
        check = (check * 131 + w) % 1000000007;
        n += 2;
    }
    println(f"2 to 1000 people: total {total}, checksum {check}");
    // small counts exactly, and the constraints' top
    let small: Vec[i64] = (1..=10).map(|k| number_of_ways(2 * k)).collect();
    println(f"{small} ... {number_of_ways(1000)}");
}
