// LeetCode #1259: Handshakes That Don't Cross -- top down: the count for
// `n` people, asked recursively over where person 0's partner sits, each
// count kept in a `Map` the first time it is found.

fn ways(n: i64, memo: mut ref Map[i64, i64]) -> i64 {
    if n == 0 {
        return 1;
    }
    if let Some(known) = memo.get(n) {
        return known;
    }
    let mut total = 0;
    let mut partner = 1;
    while partner < n {
        let inside = partner - 1;
        let outside = n - partner - 1;
        total = (total + ways(inside, mut memo) * ways(outside, mut memo)) % 1000000007;
        partner += 2;
    }
    memo.insert(n, total);
    total
}

fn number_of_ways(num_people: i64) -> i64 {
    let mut memo: Map[i64, i64] = Map.new();
    ways(num_people, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's examples
    println(f"{number_of_ways(4)} {number_of_ways(6)}");
    // every even count of people from 2 to 1000
    let mut total = 0;
    let mut check = 0;
    let mut n = 2;
    while n <= 1000 {
        let w = number_of_ways(n);
        total = (total + w) % 1000000007;
        check = (check * 131 + w) % 1000000007;
        n += 2;
    }
    println(f"2 to 1000 people: total {total}, checksum {check}");
    // small counts exactly, and the constraints' top
    let small: Vec[i64] = (1..=10).map(|k| number_of_ways(2 * k)).collect();
    println(f"{small} ... {number_of_ways(1000)}");
}
