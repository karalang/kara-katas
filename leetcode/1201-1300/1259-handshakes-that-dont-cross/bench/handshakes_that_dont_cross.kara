// LeetCode #1259 bench, in Kāra: the ★ arm (ways[k] for k pairs, summed over
// where person 0's partner sits, modulo 10^9 + 7) for every even count of
// people from 2 to 1000, 4 rounds; each count folded into a checksum.

fn number_of_ways(num_people: i64) -> i64 {
    let m = 1000000007;
    let pairs = num_people / 2;
    let mut ways = Vec.filled(pairs + 1, 0);
    ways[0] = 1;
    for k in 1..=pairs {
        for left in 0..k {
            ways[k] = (ways[k] + ways[left] * ways[k - 1 - left]) % m;
        }
    }
    ways[pairs]
}

fn main() {
    let mut check = 0;
    for _ in 0..4 {
        let mut n = 2;
        while n <= 1000 {
            check = (check * 131 + number_of_ways(n)) % 1000000007;
            n += 2;
        }
    }
    println(f"4 rounds of 2 to 1000 people: checksum {check}");
}
