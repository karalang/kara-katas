// LeetCode #1259: Handshakes That Don't Cross -- as paths: going round the
// table, a person who starts a handshake is an up-step and one who ends
// it a down-step, and the handshakes that don't cross are the paths that
// never go below the start. A row of counts per height, moved one person
// at a time.

fn number_of_ways(num_people: i64) -> i64 {
    let m = 1000000007;
    let mut at_height: Vec[i64] = Vec.filled(num_people / 2 + 2, 0);
    at_height[0] = 1;
    for _ in 0..num_people {
        let mut next = Vec.filled(at_height.len(), 0);
        for h in 0..at_height.len() - 1 {
            if at_height[h] != 0 {
                next[h + 1] = (next[h + 1] + at_height[h]) % m;
                if h > 0 {
                    next[h - 1] = (next[h - 1] + at_height[h]) % m;
                }
            }
        }
        at_height = next;
    }
    at_height[0]
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's examples
    println(f"{number_of_ways(4)} {number_of_ways(6)}");
    // every even count of people from 2 to 1000
    let mut total = 0;
    let mut check = 0;
    let mut n = 2;
    while n <= 1000 {
        let w = number_of_ways(n);
        total = (total + w) % 1000000007;
        check = (check * 131 + w) % 1000000007;
        n += 2;
    }
    println(f"2 to 1000 people: total {total}, checksum {check}");
    // small counts exactly, and the constraints' top
    let small: Vec[i64] = (1..=10).map(|k| number_of_ways(2 * k)).collect();
    println(f"{small} ... {number_of_ways(1000)}");
}
