// LeetCode #1259: Handshakes That Don't Cross -- by pairs: person 0 shakes
// hands with someone, and that handshake leaves an even number of people
// on each side, who shake hands only among themselves. `ways[k]`, the
// count for `k` pairs, is the sum over where person 0's partner sits.

fn number_of_ways(num_people: i64) -> i64 {
    let m = 1000000007;
    let pairs = num_people / 2;
    let mut ways = Vec.filled(pairs + 1, 0);
    ways[0] = 1;
    for k in 1..=pairs {
        for left in 0..k {
            ways[k] = (ways[k] + ways[left] * ways[k - 1 - left]) % m;
        }
    }
    ways[pairs]
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's examples
    println(f"{number_of_ways(4)} {number_of_ways(6)}");
    // every even count of people from 2 to 1000
    let mut total = 0;
    let mut check = 0;
    let mut n = 2;
    while n <= 1000 {
        let w = number_of_ways(n);
        total = (total + w) % 1000000007;
        check = (check * 131 + w) % 1000000007;
        n += 2;
    }
    println(f"2 to 1000 people: total {total}, checksum {check}");
    // small counts exactly, and the constraints' top
    let small: Vec[i64] = (1..=10).map(|k| number_of_ways(2 * k)).collect();
    println(f"{small} ... {number_of_ways(1000)}");
}
