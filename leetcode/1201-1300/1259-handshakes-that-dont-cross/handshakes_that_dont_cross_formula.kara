// LeetCode #1259: Handshakes That Don't Cross -- by formula: the count for
// `k` pairs is the Catalan number C(2k, k) / (k + 1), computed modulo the
// prime 10^9 + 7 with factorials and Fermat's inverse, `x^(p-2)`.

fn power(base: i64, exp: i64, m: i64) -> i64 {
    let mut result = 1;
    let mut b = base % m;
    let mut e = exp;
    while e > 0 {
        if e & 1 == 1 {
            result = result * b % m;
        }
        b = b * b % m;
        e >>= 1;
    }
    result
}

fn number_of_ways(num_people: i64) -> i64 {
    let m = 1000000007;
    let k = num_people / 2;
    let mut fact = 1;
    let mut top = 1;
    for i in 1..=2 * k {
        fact = fact * i % m;
        if i == k {
            top = fact;
        }
    }
    let k_plus_one = top * (k + 1) % m;
    fact * power(top * k_plus_one % m, m - 2, m) % m
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's examples
    println(f"{number_of_ways(4)} {number_of_ways(6)}");
    // every even count of people from 2 to 1000
    let mut total = 0;
    let mut check = 0;
    let mut n = 2;
    while n <= 1000 {
        let w = number_of_ways(n);
        total = (total + w) % 1000000007;
        check = (check * 131 + w) % 1000000007;
        n += 2;
    }
    println(f"2 to 1000 people: total {total}, checksum {check}");
    // small counts exactly, and the constraints' top
    let small: Vec[i64] = (1..=10).map(|k| number_of_ways(2 * k)).collect();
    println(f"{small} ... {number_of_ways(1000)}");
}
