// LeetCode #1277: the differential -- the six arms against the statement
// read literally and five more properties, on 2000 random matrices.

// arm 0: count_squares.kara
fn a0_count_squares(matrix: Vec[Vec[i64]]) -> i64 {
    let m = matrix.len();
    let n = matrix[0].len();
    let mut side: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n, 0));
    let mut total = 0;
    for i in 0..m {
        for j in 0..n {
            if matrix[i][j] == 1 {
                side[i][j] = if i == 0 or j == 0 {
                    1
                } else {
                    side[i - 1][j].min(side[i][j - 1]).min(side[i - 1][j - 1]) + 1
                };
                total += side[i][j];
            }
        }
    }
    total
}

// arm 1: count_squares_row.kara
fn a1_count_squares(matrix: Vec[Vec[i64]]) -> i64 {
    let n = matrix[0].len();
    let mut side: Vec[i64] = Vec.filled(n + 1, 0);
    let mut total = 0;
    for row in matrix.iter() {
        let mut diagonal = 0;
        for j in 1..(n + 1) {
            let above = side[j];
            side[j] = if row[j - 1] == 1 { above.min(side[j - 1]).min(diagonal) + 1 } else { 0 };
            total += side[j];
            diagonal = above;
        }
    }
    total
}

// arm 2: count_squares_prefix.kara
fn a2_count_squares(matrix: Vec[Vec[i64]]) -> i64 {
    let m = matrix.len();
    let n = matrix[0].len();
    let mut sum: Vec[Vec[i64]] = Vec.filled(m + 1, Vec.filled(n + 1, 0));
    for i in 0..m {
        for j in 0..n {
            sum[i + 1][j + 1] = sum[i][j + 1] + sum[i + 1][j] - sum[i][j] + matrix[i][j];
        }
    }
    let ones = |i: i64, j: i64, k: i64| sum[i + k][j + k] - sum[i][j + k] - sum[i + k][j] + sum[i][j];
    let mut total = 0;
    for i in 0..m {
        for j in 0..n {
            let mut k = 1;
            while i + k <= m and j + k <= n and ones(i, j, k) == k * k {
                total += 1;
                k += 1;
            }
        }
    }
    total
}

// arm 3: count_squares_levels.kara
fn a3_count_squares(matrix: Vec[Vec[i64]]) -> i64 {
    let mut level: Vec[Vec[bool]] = matrix.iter().map(|row| row.iter().map(|x| x == 1).collect()).collect();
    let mut total = 0;
    while level.len() > 0 and level[0].len() > 0 {
        total += level.iter().map(|row| row.iter().filter(|x| *x).count()).sum();
        let mut next: Vec[Vec[bool]] = Vec.new();
        for i in 0..(level.len() - 1) {
            let mut row: Vec[bool] = Vec.new();
            for j in 0..(level[0].len() - 1) {
                row.push(level[i][j] and level[i][j + 1] and level[i + 1][j] and level[i + 1][j + 1]);
            }
            next.push(row);
        }
        level = next;
    }
    total
}

// arm 4: count_squares_memo.kara
fn a4_side(matrix: Vec[Vec[i64]], i: i64, j: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if i < 0 or j < 0 or matrix[i][j] == 0 {
        return 0;
    }
    if let Some(known) = memo.get((i, j)) {
        return known;
    }
    let s = a4_side(matrix, i - 1, j, mut memo).min(a4_side(matrix, i, j - 1, mut memo)).min(a4_side(matrix, i - 1, j - 1, mut memo)) + 1;
    memo.insert((i, j), s);
    s
}

fn a4_count_squares(matrix: Vec[Vec[i64]]) -> i64 {
    let mut memo: Map[(i64, i64), i64] = Map.new();
    let mut total = 0;
    for i in 0..matrix.len() {
        for j in 0..matrix[0].len() {
            total += a4_side(matrix, i, j, mut memo);
        }
    }
    total
}

// arm 5: count_squares_solution.kara
impl A5Solution {
    pub fn count_squares(matrix: own Vec[Vec[i32]]) -> i32 {
        let mut matrix = matrix;
        let m = matrix.len();
        let n = matrix[0].len();
        let mut res: i32 = 0;
        for i in 0..m {
            for j in 0..n {
                if matrix[i][j] == 1 and i > 0 and j > 0 {
                    matrix[i][j] = matrix[i - 1][j].min(matrix[i][j - 1]).min(matrix[i - 1][j - 1]) + 1;
                }
                res += matrix[i][j];
            }
        }
        res
    }
}

struct A5Solution {}

fn a5_count_squares(matrix: Vec[Vec[i64]]) -> i64 {
    A5Solution.count_squares(matrix.iter().map(|row| row.iter().map(|x| x as i32).collect()).collect())
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// An m by n matrix, each entry 1 with chance `percent` in 100.
fn random_matrix(m: i64, n: i64, percent: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut matrix: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let row: Vec[i64] = (0..n).map(|_| if next_random(mut seed) % 100 < percent { 1 } else { 0 }).collect();
        matrix.push(row);
    }
    matrix
}

// ---- the differential ------------------------------------------------------

fn arm(k: i64, matrix: Vec[Vec[i64]]) -> i64 {
    match k {
        0 => a0_count_squares(matrix),
        1 => a1_count_squares(matrix),
        2 => a2_count_squares(matrix),
        3 => a3_count_squares(matrix),
        4 => a4_count_squares(matrix),
        _ => a5_count_squares(matrix),
    }
}

// The statement read literally: every square submatrix, each top left
// corner and each side that fits, its cells looked at one by one.
fn literal(matrix: Vec[Vec[i64]]) -> i64 {
    let m = matrix.len();
    let n = matrix[0].len();
    let mut count = 0;
    for i in 0..m {
        for j in 0..n {
            for k in 1..(m + n) {
                if i + k > m or j + k > n {
                    continue;
                }
                let mut all = true;
                for r in i..(i + k) {
                    for c in j..(j + k) {
                        if matrix[r][c] != 1 {
                            all = false;
                        }
                    }
                }
                if all {
                    count += 1;
                }
            }
        }
    }
    count
}

fn main() {
    let mut seed = 12770;
    let mut fails: Array[i64, 6] = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for case in 0..2000 {
        let m = next_random(mut seed) % 8 + 1;
        let n = next_random(mut seed) % 8 + 1;
        let percent = if case % 3 == 0 { 50 } else if case % 3 == 1 { 80 } else { 95 };
        let matrix = random_matrix(m, n, percent, mut seed);
        let want = literal(matrix);
        let ones: i64 = matrix.iter().map(|row| row.iter().sum()).sum();
        let mut fit = 0;
        for k in 1..(m.min(n) + 1) {
            fit += (m - k + 1) * (n - k + 1);
        }
        let transposed: Vec[Vec[i64]] = (0..n).map(|j| (0..m).map(|i| matrix[i][j]).collect()).collect();
        let flipped: Vec[Vec[i64]] = matrix.iter().rev().map(|row| row.clone()).collect();
        // one 1, if any, turned to 0
        let mut less = matrix.clone();
        let cell = next_random(mut seed) % (m * n);
        let mut lowered = false;
        for step in 0..(m * n) {
            let at = (cell + step) % (m * n);
            if not lowered and less[at / n][at % n] == 1 {
                less[at / n][at % n] = 0;
                lowered = true;
            }
        }
        let star = arm(0, matrix);
        check = (check * 131 + star) % 1000000007;
        for k in 0..6 {
            let got = arm(k, matrix);
            if got != want {
                fails[0] += 1;
            }
            if got < ones or got > fit {
                fails[1] += 1;
            }
            if arm(k, transposed) != got {
                fails[2] += 1;
            }
            if arm(k, flipped) != got {
                fails[3] += 1;
            }
            if lowered and arm(k, less) >= got {
                fails[4] += 1;
            }
            if got != star {
                fails[5] += 1;
            }
            checks += 6;
        }
    }
    let mut total = 0;
    for p in 0..6 {
        if fails[p] > 0 {
            print(f"P{p + 1}: {fails[p]} failures ");
        }
        total += fails[p];
    }
    println(f"2000 matrices: checksum {check}, {checks} checks over 6 arms: {total} failures");
}
