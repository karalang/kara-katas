// LeetCode #1277: Count Square Submatrices with All Ones -- by memoised
// recursion: the side of the largest square ending at a cell asked of the
// cells above, to the left and diagonally above, each answer kept in a
// `Map` keyed by the cell.

fn side(matrix: Vec[Vec[i64]], i: i64, j: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if i < 0 or j < 0 or matrix[i][j] == 0 {
        return 0;
    }
    if let Some(known) = memo.get((i, j)) {
        return known;
    }
    let s = side(matrix, i - 1, j, mut memo).min(side(matrix, i, j - 1, mut memo)).min(side(matrix, i - 1, j - 1, mut memo)) + 1;
    memo.insert((i, j), s);
    s
}

fn count_squares(matrix: Vec[Vec[i64]]) -> i64 {
    let mut memo: Map[(i64, i64), i64] = Map.new();
    let mut total = 0;
    for i in 0..matrix.len() {
        for j in 0..matrix[0].len() {
            total += side(matrix, i, j, mut memo);
        }
    }
    total
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// An m by n matrix, each entry 1 with chance `percent` in 100.
fn random_matrix(m: i64, n: i64, percent: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut matrix: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let row: Vec[i64] = (0..n).map(|_| if next_random(mut seed) % 100 < percent { 1 } else { 0 }).collect();
        matrix.push(row);
    }
    matrix
}

fn main() {
    // LeetCode's examples
    println(f"{count_squares([[0, 1, 1, 1], [1, 1, 1, 1], [0, 1, 1, 1]])} {count_squares([[1, 0, 1], [1, 1, 0], [1, 1, 0]])}");
    // 2000 random matrices of 1 to 12 by 1 to 12, half, four fifths and
    // nineteen twentieths ones
    let mut seed = 1277;
    let mut total = 0;
    let mut check = 0;
    for case in 0..2000 {
        let m = next_random(mut seed) % 12 + 1;
        let n = next_random(mut seed) % 12 + 1;
        let percent = if case % 3 == 0 { 50 } else if case % 3 == 1 { 80 } else { 95 };
        let got = count_squares(random_matrix(m, n, percent, mut seed));
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random matrices: {total} squares, checksum {check}");
    // the constraints' top: 300 by 300 all ones and nine tenths ones, and
    // a row and a column of 300 ones
    let ones: Vec[Vec[i64]] = Vec.filled(300, Vec.filled(300, 1));
    let dense = random_matrix(300, 300, 90, mut seed);
    let row: Vec[Vec[i64]] = [Vec.filled(300, 1)];
    let column: Vec[Vec[i64]] = Vec.filled(300, [1]);
    println(f"{count_squares(ones)} {count_squares(dense)} {count_squares(row)} {count_squares(column)}");
}
