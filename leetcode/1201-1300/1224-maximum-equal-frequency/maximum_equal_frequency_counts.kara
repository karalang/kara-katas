// LeetCode #1224: Maximum Equal Frequency -- a Rust solution as LeetCode's
// Rust users write it: `cnt` and `freq` as `vec![0usize; 100001]`, the
// numbers cast `as usize`, the three shapes tested on `usize` lengths,
// carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn max_equal_freq(nums: Vec[i32]) -> i32 {
        let mut cnt = Vec.filled(100001, 0);
        let mut freq = Vec.filled(100002, 0);
        let mut max_f: i64 = 0;
        let mut ans = 0;
        for (i, x) in nums.iter().enumerate() {
            let x = x as i64;
            if cnt[x] > 0 {
                freq[cnt[x]] -= 1;
            }
            cnt[x] += 1;
            freq[cnt[x]] += 1;
            max_f = max_f.max(cnt[x]);
            let len = i + 1;
            if max_f == 1 or freq[max_f] * max_f + 1 == len or (freq[max_f - 1] + 1) * (max_f - 1) + 1 == len {
                ans = len;
            }
        }
        ans as i32
    }
}

fn max_equal_freq(nums: Vec[i64]) -> i64 {
    Solution.max_equal_freq(nums.iter().map(|v| v as i32).collect())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    println(f"{max_equal_freq([2, 2, 1, 1, 5, 3, 3, 5])}");
    println(f"{max_equal_freq([1, 1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5])}");
    println(f"{max_equal_freq([1, 1])}");
    println(f"{max_equal_freq([1, 2, 3, 4, 5, 6, 7, 8, 9])}");
    let mut seed = 1224;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 30 + 2;
        let values = next_random(mut seed) % 6 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % values + 1).collect();
        let answer = max_equal_freq(nums);
        total += answer;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"1000 random arrays of 2 to 31 numbers: lengths total {total}, checksum {check}");
    // The constraints' top: 10^5 numbers up to 10^5.
    let rising: Vec[i64] = (1..=100000).collect();
    let mut blocks: Vec[i64] = Vec.new();
    for v in 1..=316 {
        for _ in 0..316 {
            blocks.push(v);
        }
    }
    blocks.push(317);
    let wide: Vec[i64] = (0..100000).map(|_| next_random(mut seed) % 100000 + 1).collect();
    println(f"10^5 numbers: all different {max_equal_freq(rising)}, 316 blocks of 316 and one more {max_equal_freq(blocks)}, random {max_equal_freq(wide)}");
}
