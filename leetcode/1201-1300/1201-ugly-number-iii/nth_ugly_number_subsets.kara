// LeetCode #1201: Ugly Number III -- the count over the seven nonempty
// subsets of {a, b, c} as bitmasks, each subset's least common multiple
// added or taken away by the parity of its size, and a binary search that
// keeps the best answer found.

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn nth_ugly_number(n: i64, a: i64, b: i64, c: i64) -> i64 {
    let values = [a, b, c];
    let mut multiples: Vec[(i64, i64)] = Vec.new();
    for mask in 1..8 {
        let mut l = 1;
        let mut size = 0;
        for i in 0..3 {
            if mask & (1 << i) != 0 {
                l = l / gcd(l, values[i]) * values[i];
                size += 1;
            }
        }
        multiples.push((l, if size % 2 == 1 { 1 } else { -1 }));
    }
    let mut low = 1;
    let mut high = 2000000000;
    let mut best = high;
    while low <= high {
        let mid = (low + high) / 2;
        let mut count = 0;
        for (l, sign) in multiples.iter() {
            count += sign * (mid / l);
        }
        if count >= n {
            best = mid;
            high = mid - 1;
        } else {
            low = mid + 1;
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases = [
        (3, 2, 3, 5),
        (4, 2, 3, 4),
        (5, 2, 11, 13),
        (1000000000, 2, 217983653, 336916467),
        (1, 1, 1, 1),
        (1000000000, 1, 1, 1),
        (1000000000, 2, 2, 2),
        (5, 2, 4, 8),
        (2, 1000000, 1000000, 1000000),
        (2, 999999937, 999999929, 1),
        (7, 6, 10, 15),
    ];
    for (n, a, b, c) in cases.iter() {
        println(f"n = {n}, a = {a}, b = {b}, c = {c}: {nth_ugly_number(n, a, b, c)}");
    }
    let mut seed = 1201;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let a = next_random(mut seed) % 30 + 1;
        let b = next_random(mut seed) % 30 + 1;
        let c = next_random(mut seed) % 30 + 1;
        let n = next_random(mut seed) % 200 + 1;
        let v = nth_ugly_number(n, a, b, c);
        total += v;
        check = (check * 131 + v) % 1000000007;
    }
    println(f"1000 small cases: total {total}, checksum {check}");
    total = 0;
    check = 0;
    for _ in 0..1000 {
        let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000 + 1;
        let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000 + 1;
        let c = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000 + 1;
        let most = 2000000000 / a.min(b).min(c);
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most.min(1000000000) + 1;
        let v = nth_ugly_number(n, a, b, c);
        total += v;
        check = (check * 131 + v) % 1000000007;
    }
    println(f"1000 large cases: total {total}, checksum {check}");
}
