// LeetCode #1231: Divide Chocolate -- binary search on the answer, each
// test counting pieces by jumps over the prefix sums: the next cut after a
// piece starting at prefix `from` is the first prefix of at least `from +
// m`, found by `partition_point`. O(k log n) per answer tested.

fn maximize_sweetness(sweetness: Vec[i64], k: i64) -> i64 {
    let mut prefix = [0];
    for s in sweetness.iter() {
        prefix.push(prefix[prefix.len() - 1] + s);
    }
    let total = prefix[prefix.len() - 1];
    let fits = |m: i64| {
        let mut from = 0;
        for _ in 0..k + 1 {
            let at = prefix.partition_point(|y| y < from + m);
            if at >= prefix.len() {
                return false;
            }
            from = prefix[at];
        }
        true
    };
    let mut lo = 1;
    let mut hi = total / (k + 1);
    while lo < hi {
        let mid = lo + (hi - lo + 1) / 2;
        if fits(mid) {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, and no cut at all
    println(f"{maximize_sweetness([1, 2, 3, 4, 5, 6, 7, 8, 9], 5)}");
    println(f"{maximize_sweetness([5, 6, 7, 8, 9, 1, 2, 3, 4], 8)}");
    println(f"{maximize_sweetness([1, 2, 2, 1, 2, 2, 1, 2, 2], 2)}");
    println(f"{maximize_sweetness([3, 1, 4], 0)}");
    // 1000 random bars of 1 to 40 chunks, sweetness up to 100
    let mut seed = 1231;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 40 + 1;
        let bar: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 100 + 1).collect();
        let k = next_random(mut seed) % n;
        check = (check * 131 + maximize_sweetness(bar, k)) % 1000000007;
    }
    println(f"1000 random bars: checksum {check}");
    // the constraints' top: 10^4 chunks up to 10^5, 0, 99 and 9999 cuts
    let bar: Vec[i64] = (0..10000).map(|_| next_random(mut seed) % 100000 + 1).collect();
    println(f"10^4 chunks: {maximize_sweetness(bar, 0)}, {maximize_sweetness(bar, 99)}, {maximize_sweetness(bar, 9999)}");
}
