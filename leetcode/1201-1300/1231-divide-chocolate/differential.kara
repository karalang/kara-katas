// LeetCode #1231: Divide Chocolate -- the arms against the
// statement read literally and five more properties.
// Generated from the arms; see the README.

// ---- arm 0: star --------------------------------------------------------
fn a0_pieces(sweetness: Vec[i64], m: i64) -> i64 {
    let mut count = 0;
    let mut piece = 0;
    for s in sweetness.iter() {
        piece += s;
        if piece >= m {
            count += 1;
            piece = 0;
        }
    }
    count
}

fn a0_maximize_sweetness(sweetness: Vec[i64], k: i64) -> i64 {
    let mut lo = 1;
    let mut hi = sweetness.iter().sum() / (k + 1);
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if a0_pieces(sweetness, mid) >= k + 1 {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

// ---- arm 1: jumpsf ------------------------------------------------------
fn a1_maximize_sweetness(sweetness: Vec[i64], k: i64) -> i64 {
    let mut prefix = [0];
    for s in sweetness.iter() {
        prefix.push(prefix[prefix.len() - 1] + s);
    }
    let total = prefix[prefix.len() - 1];
    let fits = |m: i64| {
        let mut from = 0;
        for _ in 0..k + 1 {
            let at = prefix.partition_point(|y| y < from + m);
            if at >= prefix.len() {
                return false;
            }
            from = prefix[at];
        }
        true
    };
    let mut lo = 1;
    let mut hi = total / (k + 1);
    while lo < hi {
        let mid = lo + (hi - lo + 1) / 2;
        if fits(mid) {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

// ---- arm 2: gallop ------------------------------------------------------
fn a2_works(sweetness: Vec[i64], k: i64, m: i64) -> bool {
    let mut count = 0;
    let mut piece = 0;
    for s in sweetness.iter() {
        piece += s;
        if piece >= m {
            count += 1;
            piece = 0;
        }
    }
    count > k
}

fn a2_maximize_sweetness(sweetness: Vec[i64], k: i64) -> i64 {
    let mut best = *sweetness.iter().min().unwrap();
    let mut step = 1;
    while step * 2 <= sweetness.iter().sum() {
        step *= 2;
    }
    while step > 0 {
        if a2_works(sweetness, k, best + step) {
            best += step;
        }
        step /= 2;
    }
    best
}

// ---- arm 3: search ------------------------------------------------------
struct A3Solution {}

impl A3Solution {
    pub fn maximize_sweetness(sweetness: Vec[i32], k: i32) -> i32 {
        let mut (lo, hi) = (*sweetness.iter().min().unwrap(), sweetness.iter().sum() / (k + 1));
        while lo < hi {
            let mid = lo + (hi - lo + 1) / 2;
            let mut (cuts, cur) = (0, 0);
            for s in ref sweetness {
                cur += s;
                if cur >= mid {
                    cuts += 1;
                    cur = 0;
                }
            }
            if cuts >= k + 1 {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        lo
    }
}

fn a3_maximize_sweetness(sweetness: Vec[i64], k: i64) -> i64 {
    let bar: Vec[i32] = sweetness.iter().map(|s| s as i32).collect();
    A3Solution.maximize_sweetness(bar, k as i32)
}

// ---- arm 4: fold --------------------------------------------------------
struct A4Solution {}

impl A4Solution {
    pub fn maximize_sweetness(sweetness: Vec[i32], k: i32) -> i32 {
        let can = |m: i32| {
            sweetness
                .iter()
                .fold((0, 0), |(cnt, cur), s| if cur + s >= m { (cnt + 1, 0) } else { (cnt, cur + s) })
                .0
                > k
        };
        let mut lo: i32 = 1;
        let mut hi = 1_000_000_000 / (k + 1);
        while lo < hi {
            let mid = (lo + hi + 1) / 2;
            if can(mid) {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        lo
    }
}

fn a4_maximize_sweetness(sweetness: Vec[i64], k: i64) -> i64 {
    let bar: Vec[i32] = sweetness.iter().map(|s| s as i32).collect();
    A4Solution.maximize_sweetness(bar, k as i32)
}


// ---- the statement read literally -----------------------------------------

// Every way to make the k cuts, as the bits of a number over the n - 1
// places between chunks, k of them set: the least sweet piece of each,
// and the sweetest of those.
fn literal(bar: Vec[i64], k: i64) -> i64 {
    let n = bar.len();
    let mut best = 0;
    for cuts in 0..(1 << (n - 1)) {
        let mut set = 0;
        for i in 0..n - 1 {
            set += (cuts >> i) & 1;
        }
        if set != k {
            continue;
        }
        let mut least = bar.iter().sum();
        let mut piece = 0;
        for i in 0..n {
            piece += bar[i];
            if i == n - 1 or (cuts >> i) & 1 == 1 {
                least = least.min(piece);
                piece = 0;
            }
        }
        best = best.max(least);
    }
    best
}

// Whether k cuts can leave every piece at least `m` sweet: walk the bar,
// cutting as soon as a piece is sweet enough.
fn fits(bar: Vec[i64], k: i64, m: i64) -> bool {
    let mut made = 0;
    let mut piece = 0;
    for s in bar.iter() {
        piece += s;
        if piece >= m {
            made += 1;
            piece = 0;
        }
    }
    made >= k + 1
}

// ---- the differential -----------------------------------------------------

fn arms(bar: Vec[i64], k: i64) -> Vec[i64] {
    [a0_maximize_sweetness(bar, k), a1_maximize_sweetness(bar, k), a2_maximize_sweetness(bar, k), a3_maximize_sweetness(bar, k), a4_maximize_sweetness(bar, k)]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["the statement read literally", "from the least chunk to the bar's share of k + 1", "the bar reversed gives the same", "every piece can be that sweet, and not one sweeter", "one more cut never makes it sweeter", "the ★ arm's answer"];
    let mut fails = Vec.filled(6, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 1231;
    for c in 0..2000 {
        let n = match c % 3 {
            0 => next_random(mut seed) % 12 + 1,
            1 => next_random(mut seed) % 188 + 13,
            _ => next_random(mut seed) % 1800 + 201,
        };
        let top = match c % 4 {
            0 => 3,
            1 => 100,
            2 => 1000,
            _ => 100000,
        };
        let bar: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let k = next_random(mut seed) % n;
        let want = if n <= 12 { literal(bar, k) } else { -1 };
        let got = arms(bar, k);
        let reversed = arms(bar.iter().rev().collect(), k);
        let more = if k + 1 < n { arms(bar, k + 1) } else { got.clone() };
        let least = *bar.iter().min().unwrap();
        let share = bar.iter().sum() / (k + 1);
        for a in 0..5 {
            let v = got[a];
            let held = [
                n > 12 or v == want,
                v >= least and v <= share,
                reversed[a] == v,
                fits(bar, k, v) and not fits(bar, k, v + 1),
                more[a] <= v,
                v == got[0],
            ];
            for p in 0..6 {
                checks += 1;
                if not held[p] {
                    fails[p] += 1;
                    if fails[p] <= 2 {
                        println(f"P{p + 1} ({names[p]}) fails on arm {a}: {n} chunks, {k} cuts -> {v}");
                    }
                }
            }
        }
        check = (check * 131 + got[0]) % 1000000007;
    }
    for p in 0..6 {
        if fails[p] > 0 {
            println(f"P{p + 1}: {fails[p]} failures");
        }
    }
    let failures = fails.iter().sum();
    println(f"2000 cases: checksum {check}, {checks} checks over {5} arms: {failures} failures");
}
