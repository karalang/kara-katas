// LeetCode #1284: Minimum Number of Flips to Convert Binary Matrix to Zero
// Matrix -- by chasing the lights down: once the first row's flips are
// chosen, a cell still lit in one row can only be cleared by flipping the
// cell below it, so every later row's flips are forced. Each of the first
// row's choices is followed down, and those that leave the last row dark
// are counted. O(2^n mn)

fn chase(mat: Vec[Vec[i64]], first: i64) -> Option[i64] {
    let rows = mat.len();
    let cols = mat[0].len();
    let mut lit: Vec[Vec[bool]] = mat.iter().map(|row| row.iter().map(|x| *x == 1).collect()).collect();
    let mut count = 0;
    for i in 0..rows {
        for j in 0..cols {
            let press = if i == 0 { (first >> j) & 1 == 1 } else { lit[i - 1][j] };
            if not press {
                continue;
            }
            count += 1;
            lit[i][j] = not lit[i][j];
            if i > 0 {
                lit[i - 1][j] = not lit[i - 1][j];
            }
            if i + 1 < rows {
                lit[i + 1][j] = not lit[i + 1][j];
            }
            if j > 0 {
                lit[i][j - 1] = not lit[i][j - 1];
            }
            if j + 1 < cols {
                lit[i][j + 1] = not lit[i][j + 1];
            }
        }
    }
    if lit[rows - 1].iter().any(|x| *x) {
        None
    } else {
        Some(count)
    }
}

fn min_flips(mat: Vec[Vec[i64]]) -> i64 {
    let cols = mat[0].len();
    (0..(1 << cols)).filter_map(|first| chase(mat, first)).min().unwrap_or(-1)
}
// ---- test harness ---------------------------------------------------------

// The matrix of `rows` by `cols` whose cells are the bits of `bits`, row by
// row from the lowest bit.
fn matrix(rows: i64, cols: i64, bits: i64) -> Vec[Vec[i64]] {
    let mut mat: Vec[Vec[i64]] = Vec.new();
    for i in 0..rows {
        let mut row: Vec[i64] = Vec.new();
        for j in 0..cols {
            row.push((bits >> (i * cols + j)) & 1);
        }
        mat.push(row);
    }
    mat
}

fn main() {
    // LeetCode's examples
    println(f"{min_flips([[0, 0], [0, 1]])} {min_flips([[0]])} {min_flips([[1, 0, 0], [1, 0, 0]])}");
    // every matrix of every shape the constraints allow, 1 by 1 to 3 by 3
    let mut check = 0;
    for rows in 1..4 {
        for cols in 1..4 {
            let mut solvable = 0;
            let mut flips = 0;
            let mut most = 0;
            for bits in 0..(1 << (rows * cols)) {
                let f = min_flips(matrix(rows, cols, bits));
                check = (check * 131 + f + 2) % 1000000007;
                if f >= 0 {
                    solvable += 1;
                    flips += f;
                    most = most.max(f);
                }
            }
            println(f"{rows} by {cols}: {solvable} of {1 << (rows * cols)} solvable, {flips} flips, at most {most}");
        }
    }
    println(f"checksum {check}");
}
