// LeetCode #1284 bench: the ★ arm (breadth-first search over bit masks) on
// every matrix of every shape, 1 by 1 to 3 by 3, 3000 rounds, every answer
// folded into a checksum.

fn min_flips(mat: Vec[Vec[i64]]) -> i64 {
    let rows = mat.len();
    let cols = mat[0].len();
    let cells = rows * cols;
    let mut start = 0;
    let mut flip: Vec[i64] = Vec.new();
    for i in 0..rows {
        for j in 0..cols {
            if mat[i][j] == 1 {
                start |= 1 << (i * cols + j);
            }
            let mut mask = 1 << (i * cols + j);
            if i > 0 {
                mask |= 1 << ((i - 1) * cols + j);
            }
            if i + 1 < rows {
                mask |= 1 << ((i + 1) * cols + j);
            }
            if j > 0 {
                mask |= 1 << (i * cols + j - 1);
            }
            if j + 1 < cols {
                mask |= 1 << (i * cols + j + 1);
            }
            flip.push(mask);
        }
    }
    let mut dist = Vec.filled(1 << cells, -1);
    dist[start] = 0;
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(start);
    while let Some(state) = queue.pop_front() {
        if state == 0 {
            return dist[state];
        }
        for mask in flip.iter() {
            let next = state ^ mask;
            if dist[next] < 0 {
                dist[next] = dist[state] + 1;
                queue.push_back(next);
            }
        }
    }
    -1
}

fn matrix(rows: i64, cols: i64, bits: i64) -> Vec[Vec[i64]] {
    let mut mat: Vec[Vec[i64]] = Vec.new();
    for i in 0..rows {
        let mut row: Vec[i64] = Vec.new();
        for j in 0..cols {
            row.push((bits >> (i * cols + j)) & 1);
        }
        mat.push(row);
    }
    mat
}

fn main() {
    let mut check = 0;
    for round in 0..3000 {
        for rows in 1..4 {
            for cols in 1..4 {
                for bits in 0..(1 << (rows * cols)) {
                    check = (check * 131 + min_flips(matrix(rows, cols, bits)) + round + 2) % 1000000007;
                }
            }
        }
    }
    println(f"3000 rounds of every matrix: checksum {check}");
}
