// LeetCode #1203: Sort Items by Groups Respecting Dependencies -- each
// item with no group given one of its own, and both sorts a depth-first
// search with three colours (unseen, on the path, done): a node reached
// again while still on the path closes a cycle, and the nodes in the
// reverse of the order they are finished are sorted. The items are then
// dealt into their groups, and the groups laid out in their order.

fn visit(u: i64, edges: Vec[Vec[i64]], colour: mut ref Vec[i64], finished: mut ref Vec[i64]) -> bool {
    colour[u] = 1;
    for v in edges[u].iter() {
        if colour[v] == 1 {
            return false;
        }
        if colour[v] == 0 and not visit(v, edges, mut colour, mut finished) {
            return false;
        }
    }
    colour[u] = 2;
    finished.push(u);
    true
}

fn topo_sort(nodes: i64, edges: Vec[Vec[i64]]) -> Option[Vec[i64]] {
    let mut colour = Vec.filled(nodes, 0);
    let mut finished = Vec.new();
    for u in 0..nodes {
        if colour[u] == 0 and not visit(u, edges, mut colour, mut finished) {
            return None;
        }
    }
    finished.reverse();
    Some(finished)
}

fn sort_items(n: i64, m: i64, group: Vec[i64], before_items: Vec[Vec[i64]]) -> Vec[i64] {
    let mut owner = Vec.new();
    let mut groups = m;
    for g in group.iter() {
        if g >= 0 {
            owner.push(g);
        } else {
            owner.push(groups);
            groups += 1;
        }
    }
    let mut item_edges: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    let mut group_edges: Vec[Vec[i64]] = Vec.filled(groups, Vec.new());
    for i in 0..n {
        for b in before_items[i].iter() {
            item_edges[b].push(i);
            if owner[b] != owner[i] {
                group_edges[owner[b]].push(owner[i]);
            }
        }
    }
    let Some(items) = topo_sort(n, item_edges) else {
        return Vec.new();
    };
    let Some(ranks) = topo_sort(groups, group_edges) else {
        return Vec.new();
    };
    let mut members: Vec[Vec[i64]] = Vec.filled(groups, Vec.new());
    for i in items.iter() {
        members[owner[i]].push(i);
    }
    let mut out = Vec.new();
    for g in ranks.iter() {
        for i in members[g].iter() {
            out.push(i);
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

// Whether `order` is an answer: every item once, each group's items side
// by side, and every item after the items it must follow.
fn valid(n: i64, group: Vec[i64], before_items: Vec[Vec[i64]], order: Vec[i64]) -> bool {
    if order.len() != n {
        return false;
    }
    let mut at = Vec.filled(n, -1);
    for k in 0..n {
        let i = order[k];
        if i < 0 or i >= n or at[i] >= 0 {
            return false;
        }
        at[i] = k;
    }
    for i in 0..n {
        for b in before_items[i].iter() {
            if at[b] > at[i] {
                return false;
            }
        }
    }
    let mut closed: Set[i64] = Set.new();
    for k in 0..n {
        let g = group[order[k]];
        if k > 0 and group[order[k - 1]] != g and g >= 0 and closed.contains(g) {
            return false;
        }
        if k > 0 and group[order[k - 1]] != g {
            closed.insert(group[order[k - 1]]);
        }
    }
    true
}

fn report(n: i64, m: i64, group: Vec[i64], before_items: Vec[Vec[i64]]) -> String {
    let order = sort_items(n, m, group, before_items);
    if order.is_empty() {
        "none".to_string()
    } else if valid(n, group, before_items, order) {
        f"an order of {n}"
    } else {
        f"INVALID {order}"
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases: Vec[(i64, i64, Vec[i64], Vec[Vec[i64]])] = [
        (8, 2, [-1, -1, 1, 0, 0, 1, 0, -1], [[], [6], [5], [6], [3, 6], [], [], []]),
        (8, 2, [-1, -1, 1, 0, 0, 1, 0, -1], [[], [6], [5], [6], [3], [], [4], []]),
        (1, 1, [-1], [[]]),
        (3, 1, [0, -1, 0], [[], [0], [1]]),
        (3, 1, [0, -1, 0], [[], [], [1]]),
        (4, 2, [0, 1, 0, 1], [[], [], [1], [2]]),
        (4, 2, [0, 1, 0, 1], [[1], [], [], [2]]),
        (5, 3, [-1, -1, -1, -1, -1], [[1], [2], [3], [4], []]),
        (2, 1, [-1, -1], [[1], [0]]),
    ];
    for (n, m, group, before_items) in cases.iter() {
        println(f"{n} {m} {group} {before_items}: {report(n, m, group, before_items)}");
    }
    let mut seed = 1203;
    let mut ordered = 0;
    let mut none = 0;
    let mut wrong = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 9 + 1;
        let m = next_random(mut seed) % n + 1;
        let group: Vec[i64] = (0..n).map(|_| next_random(mut seed) % (m + 1) - 1).collect();
        let mut before_items: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
        for i in 0..n {
            for _ in 0..next_random(mut seed) % 3 {
                let b = next_random(mut seed) % n;
                if b != i and not before_items[i].contains(b) {
                    before_items[i].push(b);
                }
            }
        }
        let r = report(n, m, group, before_items);
        if r == "none" {
            none += 1;
        } else if r.starts_with("an order") {
            ordered += 1;
        } else {
            wrong += 1;
        }
    }
    println(f"1000 random cases: {ordered} ordered, {none} with none, {wrong} invalid");
    // The constraints' top: 30000 items, a third in no group and the rest in
    // 3000 groups of runs of ten, each item after up to three of the items
    // before it.
    let n = 30000;
    let m = 3000;
    let group: Vec[i64] = (0..n).map(|i| if i % 3 == 0 { -1 } else { i / 10 }).collect();
    let mut before_items: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for i in 1..n {
        for _ in 0..next_random(mut seed) % 4 {
            let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % i;
            if not before_items[i].contains(b) {
                before_items[i].push(b);
            }
        }
    }
    println(f"30000 items, 3000 groups: {report(n, m, group, before_items)}");
    // The same, with one dependency turned round so the items close a cycle.
    before_items[0].push(n - 1);
    before_items[n - 1].push(0);
    println(f"30000 items, one cycle: {report(n, m, group, before_items)}");
}
