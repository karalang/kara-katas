// LeetCode #1203: Sort Items by Groups Respecting Dependencies -- a Rust
// solution as LeetCode's Rust users write it: `group.iter_mut()` numbering
// the items in no group, the two graphs as `vec![vec![]; m]` with in-degree
// counts, a nested `fn topo` over a `VecDeque` returning an `Option`, and
// the answer gathered by `flat_map` over the group order, each group's
// items taken with `std::mem::take`, carried to Kāra by `karac fix`.

struct Solution {}

fn topo(graph: Vec[Vec[i64]], indeg: mut ref Vec[i32]) -> Option[Vec[i64]] {
    let mut q: VecDeque[i64] = (0..graph.len()).filter(|i| indeg[i] == 0).collect();
    let mut res = Vec.with_capacity(graph.len());
    while let Some(u) = q.pop_front() {
        res.push(u);
        for v in ref graph[u] {
            indeg[v] -= 1;
            if indeg[v] == 0 {
                q.push_back(v);
            }
        }
    }
    if res.len() == graph.len() {
        Some(res)
    } else {
        None
    }
}

impl Solution {
    pub fn sort_items(n: i32, m: i32, group: own Vec[i32], before_items: Vec[Vec[i32]]) -> Vec[i32] {
        let n = n as i64;
        let mut group = group;
        let mut m = m;
        for g in group.iter_mut() {
            if *g == -1 {
                *g = m;
                m += 1;
            }
        }
        let m = m as i64;
        let mut group_graph: Vec[Vec[i64]] = Vec.filled(m, Vec.new());
        let mut item_graph: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
        let mut group_in = Vec.filled(m, 0);
        let mut item_in = Vec.filled(n, 0);
        for i in 0..n {
            for b in ref before_items[i] {
                let b = b as i64;
                item_graph[b].push(i);
                item_in[i] += 1;
                let (gb, gi) = (group[b] as i64, group[i] as i64);
                if gb != gi {
                    group_graph[gb].push(gi);
                    group_in[gi] += 1;
                }
            }
        }
        let group_order = match topo(group_graph, mut group_in) {
            Some(o) => o,
            None => return Vec.new(),
        };
        let item_order = match topo(item_graph, mut item_in) {
            Some(o) => o,
            None => return Vec.new(),
        };
        let mut buckets: Vec[Vec[i32]] = Vec.filled(m, Vec.new());
        for i in item_order {
            buckets[group[i]].push(i as i32);
        }
        group_order
            .into_iter()
            .flat_map(|g| take(mut buckets[g]).into_iter())
            .collect()
    }
}

fn sort_items(n: i64, m: i64, group: Vec[i64], before_items: Vec[Vec[i64]]) -> Vec[i64] {
    let group: Vec[i32] = group.iter().map(|g| g as i32).collect();
    let before_items: Vec[Vec[i32]] = before_items.iter().map(|b| b.iter().map(|v| v as i32).collect()).collect();
    Solution.sort_items(n as i32, m as i32, group, before_items).iter().map(|v| v as i64).collect()
}

// ---- test harness ---------------------------------------------------------

// Whether `order` is an answer: every item once, each group's items side
// by side, and every item after the items it must follow.
fn valid(n: i64, group: Vec[i64], before_items: Vec[Vec[i64]], order: Vec[i64]) -> bool {
    if order.len() != n {
        return false;
    }
    let mut at = Vec.filled(n, -1);
    for k in 0..n {
        let i = order[k];
        if i < 0 or i >= n or at[i] >= 0 {
            return false;
        }
        at[i] = k;
    }
    for i in 0..n {
        for b in before_items[i].iter() {
            if at[b] > at[i] {
                return false;
            }
        }
    }
    let mut closed: Set[i64] = Set.new();
    for k in 0..n {
        let g = group[order[k]];
        if k > 0 and group[order[k - 1]] != g and g >= 0 and closed.contains(g) {
            return false;
        }
        if k > 0 and group[order[k - 1]] != g {
            closed.insert(group[order[k - 1]]);
        }
    }
    true
}

fn report(n: i64, m: i64, group: Vec[i64], before_items: Vec[Vec[i64]]) -> String {
    let order = sort_items(n, m, group, before_items);
    if order.is_empty() {
        "none"
    } else if valid(n, group, before_items, order) {
        f"an order of {n}"
    } else {
        f"INVALID {order}"
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases: Vec[(i64, i64, Vec[i64], Vec[Vec[i64]])] = [
        (8, 2, [-1, -1, 1, 0, 0, 1, 0, -1], [[], [6], [5], [6], [3, 6], [], [], []]),
        (8, 2, [-1, -1, 1, 0, 0, 1, 0, -1], [[], [6], [5], [6], [3], [], [4], []]),
        (1, 1, [-1], [[]]),
        (3, 1, [0, -1, 0], [[], [0], [1]]),
        (3, 1, [0, -1, 0], [[], [], [1]]),
        (4, 2, [0, 1, 0, 1], [[], [], [1], [2]]),
        (4, 2, [0, 1, 0, 1], [[1], [], [], [2]]),
        (5, 3, [-1, -1, -1, -1, -1], [[1], [2], [3], [4], []]),
        (2, 1, [-1, -1], [[1], [0]]),
    ];
    for (n, m, group, before_items) in cases.iter() {
        println(f"{n} {m} {group} {before_items}: {report(n, m, group, before_items)}");
    }
    let mut seed = 1203;
    let mut ordered = 0;
    let mut none = 0;
    let mut wrong = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 9 + 1;
        let m = next_random(mut seed) % n + 1;
        let group: Vec[i64] = (0..n).map(|_| next_random(mut seed) % (m + 1) - 1).collect();
        let mut before_items: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
        for i in 0..n {
            for _ in 0..next_random(mut seed) % 3 {
                let b = next_random(mut seed) % n;
                if b != i and not before_items[i].contains(b) {
                    before_items[i].push(b);
                }
            }
        }
        let r = report(n, m, group, before_items);
        if r == "none" {
            none += 1;
        } else if r.starts_with("an order") {
            ordered += 1;
        } else {
            wrong += 1;
        }
    }
    println(f"1000 random cases: {ordered} ordered, {none} with none, {wrong} invalid");
    // The constraints' top: 30000 items, a third in no group and the rest in
    // 3000 groups of runs of ten, each item after up to three of the items
    // before it.
    let n = 30000;
    let m = 3000;
    let group: Vec[i64] = (0..n).map(|i| if i % 3 == 0 { -1 } else { i / 10 }).collect();
    let mut before_items: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for i in 1..n {
        for _ in 0..next_random(mut seed) % 4 {
            let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % i;
            if not before_items[i].contains(b) {
                before_items[i].push(b);
            }
        }
    }
    println(f"30000 items, 3000 groups: {report(n, m, group, before_items)}");
    // The same, with one dependency turned round so the items close a cycle.
    before_items[0].push(n - 1);
    before_items[n - 1].push(0);
    println(f"30000 items, one cycle: {report(n, m, group, before_items)}");
}
