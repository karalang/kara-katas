// LeetCode #1263: Minimum Moves to Move a Box to Their Target Location --
// by a 0-1 BFS over (box, player) states: a step of the player costs no
// push and goes to the front of a `VecDeque`, a push costs one and goes to
// the back, so states leave the deque in order of their pushes and the
// first time a state leaves is its least.

fn min_push_box(grid: Vec[Vec[char]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut player = 0;
    let mut box_at = 0;
    let mut target = 0;
    for r in 0..m {
        for c in 0..n {
            match grid[r][c] {
                'S' => player = r * n + c,
                'B' => box_at = r * n + c,
                'T' => target = r * n + c,
                _ => {}
            }
        }
    }
    let cells = m * n;
    let mut done = Vec.filled(cells * cells, false);
    let mut deque: VecDeque[(i64, i64, i64)] = VecDeque.new();
    deque.push_back((box_at, player, 0));
    while let Some((b, p, pushes)) = deque.pop_front() {
        if done[b * cells + p] {
            continue;
        }
        done[b * cells + p] = true;
        if b == target {
            return pushes;
        }
        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
            let r = p / n + dr;
            let c = p % n + dc;
            if r < 0 or r >= m or c < 0 or c >= n or grid[r][c] == '#' {
                continue;
            }
            let q = r * n + c;
            if q != b {
                deque.push_front((b, q, pushes));
                continue;
            }
            // The player steps into the box, which moves on the same way.
            let br = r + dr;
            let bc = c + dc;
            if br >= 0 and br < m and bc >= 0 and bc < n and grid[br][bc] != '#' {
                deque.push_back((br * n + bc, q, pushes + 1));
            }
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn parse(rows: Vec[Str]) -> Vec[Vec[char]] {
    rows.iter().map(|row| row.chars().collect()).collect()
}

// An `m` by `n` grid, each cell a wall one time in `walls`, and the
// player, the box and the target on three different cells.
fn random_grid(m: i64, n: i64, walls: i64, seed: mut ref i64) -> Vec[Vec[char]] {
    let mut grid: Vec[Vec[char]] = (0..m).map(|_| (0..n).map(|_| if next_random(mut seed) % walls == 0 { '#' } else { '.' }).collect()).collect();
    for mark in ['S', 'B', 'T'] {
        let mut p = next_random(mut seed) % (m * n);
        while ['S', 'B', 'T'].contains(grid[p / n][p % n]) {
            p = (p + 1) % (m * n);
        }
        grid[p / n][p % n] = mark;
    }
    grid
}

fn main() {
    // LeetCode's examples
    let one = parse(["######", "#T####", "#..B.#", "#.##.#", "#...S#", "######"]);
    let two = parse(["######", "#T####", "#..B.#", "####.#", "#...S#", "######"]);
    let three = parse(["######", "#T..##", "#.#B.#", "#....#", "#...S#", "######"]);
    println(f"{min_push_box(one)} {min_push_box(two)} {min_push_box(three)}");
    // 1000 random grids of 3 to 10 by 3 to 10, a cell in 8 a wall
    let mut seed = 1263;
    let mut total = 0;
    let mut stuck = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let m = next_random(mut seed) % 8 + 3;
        let n = next_random(mut seed) % 8 + 3;
        let pushes = min_push_box(random_grid(m, n, 8, mut seed));
        if pushes < 0 {
            stuck += 1;
        } else {
            total += pushes;
        }
        check = (check * 131 + pushes + 1) % 1000000007;
    }
    println(f"1000 random grids: {total} pushes, {stuck} stuck, checksum {check}");
    // the constraints' top: 20 by 20 open, the box across from its target,
    // and twice 20 by 20 a cell in 10 a wall
    let mut open: Vec[Vec[char]] = (0..20).map(|_| Vec.filled(20, '.')).collect();
    open[0][0] = 'S';
    open[1][1] = 'B';
    open[18][18] = 'T';
    println(f"{min_push_box(open)} {min_push_box(random_grid(20, 20, 10, mut seed))} {min_push_box(random_grid(20, 20, 10, mut seed))}");
}
