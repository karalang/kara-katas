// LeetCode #1263: Minimum Moves to Move a Box to Their Target Location --
// by A*: (box, player) states popped from a `PriorityQueue` in order of
// pushes so far plus the box's Manhattan distance to the target, which
// never overestimates and changes by at most one a push, so the first
// state with the box on the target has the least pushes.

struct Cell {
    row: i64,
    col: i64,
}

fn min_push_box(grid: Vec[Vec[char]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let find = |want: char| {
        for r in 0..m {
            for c in 0..n {
                if grid[r][c] == want {
                    return Cell { row: r, col: c };
                }
            }
        }
        Cell { row: -1, col: -1 }
    };
    let start = find('S');
    let crate_at = find('B');
    let target = find('T');
    let guess = |r: i64, c: i64| (r - target.row).abs() + (c - target.col).abs();
    let cells = m * n;
    let mut best: Map[i64, i64] = Map.new();
    // (estimate, pushes, box row, box col, player row, player col)
    let mut queue: PriorityQueue[(i64, i64, i64, i64, i64, i64)] = PriorityQueue.new();
    queue.push((guess(crate_at.row, crate_at.col), 0, crate_at.row, crate_at.col, start.row, start.col));
    while let Some((_, pushes, br, bc, pr, pc)) = queue.pop() {
        if br == target.row and bc == target.col {
            return pushes;
        }
        let key = (br * n + bc) * cells + pr * n + pc;
        if best.get(key).is_some_and(|b| b < pushes) {
            continue;
        }
        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
            let (r, c) = (pr + dr, pc + dc);
            if r < 0 or r >= m or c < 0 or c >= n or grid[r][c] == '#' {
                continue;
            }
            let (nbr, nbc, cost) = if r == br and c == bc { (br + dr, bc + dc, pushes + 1) } else { (br, bc, pushes) };
            if nbr < 0 or nbr >= m or nbc < 0 or nbc >= n or grid[nbr][nbc] == '#' {
                continue;
            }
            let next = (nbr * n + nbc) * cells + r * n + c;
            if best.get(next).is_none_or(|b| cost < b) {
                best.insert(next, cost);
                queue.push((cost + guess(nbr, nbc), cost, nbr, nbc, r, c));
            }
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn parse(rows: Vec[Str]) -> Vec[Vec[char]] {
    rows.iter().map(|row| row.chars().collect()).collect()
}

// An `m` by `n` grid, each cell a wall one time in `walls`, and the
// player, the box and the target on three different cells.
fn random_grid(m: i64, n: i64, walls: i64, seed: mut ref i64) -> Vec[Vec[char]] {
    let mut grid: Vec[Vec[char]] = (0..m).map(|_| (0..n).map(|_| if next_random(mut seed) % walls == 0 { '#' } else { '.' }).collect()).collect();
    for mark in ['S', 'B', 'T'] {
        let mut p = next_random(mut seed) % (m * n);
        while ['S', 'B', 'T'].contains(grid[p / n][p % n]) {
            p = (p + 1) % (m * n);
        }
        grid[p / n][p % n] = mark;
    }
    grid
}

fn main() {
    // LeetCode's examples
    let one = parse(["######", "#T####", "#..B.#", "#.##.#", "#...S#", "######"]);
    let two = parse(["######", "#T####", "#..B.#", "####.#", "#...S#", "######"]);
    let three = parse(["######", "#T..##", "#.#B.#", "#....#", "#...S#", "######"]);
    println(f"{min_push_box(one)} {min_push_box(two)} {min_push_box(three)}");
    // 1000 random grids of 3 to 10 by 3 to 10, a cell in 8 a wall
    let mut seed = 1263;
    let mut total = 0;
    let mut stuck = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let m = next_random(mut seed) % 8 + 3;
        let n = next_random(mut seed) % 8 + 3;
        let pushes = min_push_box(random_grid(m, n, 8, mut seed));
        if pushes < 0 {
            stuck += 1;
        } else {
            total += pushes;
        }
        check = (check * 131 + pushes + 1) % 1000000007;
    }
    println(f"1000 random grids: {total} pushes, {stuck} stuck, checksum {check}");
    // the constraints' top: 20 by 20 open, the box across from its target,
    // and twice 20 by 20 a cell in 10 a wall
    let mut open: Vec[Vec[char]] = (0..20).map(|_| Vec.filled(20, '.')).collect();
    open[0][0] = 'S';
    open[1][1] = 'B';
    open[18][18] = 'T';
    println(f"{min_push_box(open)} {min_push_box(random_grid(20, 20, 10, mut seed))} {min_push_box(random_grid(20, 20, 10, mut seed))}");
}
