// LeetCode #1263: the differential -- the five arms against the statement
// read literally and five more properties, on 2000 random grids.

// arm 0: min_push_box.kara
fn a0_min_push_box(grid: Vec[Vec[char]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut player = 0;
    let mut box_at = 0;
    let mut target = 0;
    for r in 0..m {
        for c in 0..n {
            match grid[r][c] {
                'S' => player = r * n + c,
                'B' => box_at = r * n + c,
                'T' => target = r * n + c,
                _ => {}
            }
        }
    }
    let cells = m * n;
    let mut done = Vec.filled(cells * cells, false);
    let mut deque: VecDeque[(i64, i64, i64)] = VecDeque.new();
    deque.push_back((box_at, player, 0));
    while let Some((b, p, pushes)) = deque.pop_front() {
        if done[b * cells + p] {
            continue;
        }
        done[b * cells + p] = true;
        if b == target {
            return pushes;
        }
        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
            let r = p / n + dr;
            let c = p % n + dc;
            if r < 0 or r >= m or c < 0 or c >= n or grid[r][c] == '#' {
                continue;
            }
            let q = r * n + c;
            if q != b {
                deque.push_front((b, q, pushes));
                continue;
            }
            // The player steps into the box, which moves on the same way.
            let br = r + dr;
            let bc = c + dc;
            if br >= 0 and br < m and bc >= 0 and bc < n and grid[br][bc] != '#' {
                deque.push_back((br * n + bc, q, pushes + 1));
            }
        }
    }
    -1
}

// arm 1: min_push_box_pushes.kara
fn a1_open(grid: Vec[Vec[char]], r: i64, c: i64) -> bool {
    r >= 0 and r < grid.len() and c >= 0 and c < grid[0].len() and grid[r][c] != '#'
}

fn a1_can_walk(grid: Vec[Vec[char]], from: (i64, i64), to: (i64, i64), box_at: (i64, i64)) -> bool {
    let n = grid[0].len();
    let mut seen: Set[i64] = Set.new();
    let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
    seen.insert(from.0 * n + from.1);
    queue.push_back(from);
    while let Some((r, c)) = queue.pop_front() {
        if (r, c) == to {
            return true;
        }
        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
            let next = (r + dr, c + dc);
            if a1_open(grid, next.0, next.1) and next != box_at and seen.insert(next.0 * n + next.1) {
                queue.push_back(next);
            }
        }
    }
    false
}

fn a1_min_push_box(grid: Vec[Vec[char]]) -> i64 {
    let mut player = (0, 0);
    let mut box_at = (0, 0);
    let mut target = (0, 0);
    for (r, row) in grid.iter().enumerate() {
        for (c, cell) in row.iter().enumerate() {
            if cell == 'S' {
                player = (r, c);
            } else if cell == 'B' {
                box_at = (r, c);
            } else if cell == 'T' {
                target = (r, c);
            }
        }
    }
    if box_at == target {
        return 0;
    }
    let moves = [(-1, 0), (1, 0), (0, -1), (0, 1)];
    // A state is the box and the player just behind it.
    let mut seen: Set[((i64, i64), (i64, i64))] = Set.new();
    let mut level: Vec[((i64, i64), (i64, i64))] = [(box_at, player)];
    let mut pushes = 0;
    while not level.is_empty() {
        pushes += 1;
        let mut next: Vec[((i64, i64), (i64, i64))] = Vec.new();
        for (b, p) in level.iter() {
            for (dr, dc) in moves.iter() {
                let behind = (b.0 - dr, b.1 - dc);
                let ahead = (b.0 + dr, b.1 + dc);
                if not a1_open(grid, behind.0, behind.1) or not a1_open(grid, ahead.0, ahead.1) {
                    continue;
                }
                if not a1_can_walk(grid, p, behind, b) or not seen.insert((ahead, b)) {
                    continue;
                }
                if ahead == target {
                    return pushes;
                }
                next.push((ahead, b));
            }
        }
        level = next;
    }
    -1
}

// arm 2: min_push_box_astar.kara
struct Cell {
    row: i64,
    col: i64,
}

fn a2_min_push_box(grid: Vec[Vec[char]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let find = |want: char| {
        for r in 0..m {
            for c in 0..n {
                if grid[r][c] == want {
                    return Cell { row: r, col: c };
                }
            }
        }
        Cell { row: -1, col: -1 }
    };
    let start = find('S');
    let crate_at = find('B');
    let target = find('T');
    let guess = |r: i64, c: i64| (r - target.row).abs() + (c - target.col).abs();
    let cells = m * n;
    let mut best: Map[i64, i64] = Map.new();
    // (estimate, pushes, box row, box col, player row, player col)
    let mut queue: PriorityQueue[(i64, i64, i64, i64, i64, i64)] = PriorityQueue.new();
    queue.push((guess(crate_at.row, crate_at.col), 0, crate_at.row, crate_at.col, start.row, start.col));
    while let Some((_, pushes, br, bc, pr, pc)) = queue.pop() {
        if br == target.row and bc == target.col {
            return pushes;
        }
        let key = (br * n + bc) * cells + pr * n + pc;
        if best.get(key).is_some_and(|b| b < pushes) {
            continue;
        }
        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
            let (r, c) = (pr + dr, pc + dc);
            if r < 0 or r >= m or c < 0 or c >= n or grid[r][c] == '#' {
                continue;
            }
            let (nbr, nbc, cost) = if r == br and c == bc { (br + dr, bc + dc, pushes + 1) } else { (br, bc, pushes) };
            if nbr < 0 or nbr >= m or nbc < 0 or nbc >= n or grid[nbr][nbc] == '#' {
                continue;
            }
            let next = (nbr * n + nbc) * cells + r * n + c;
            if best.get(next).is_none_or(|b| cost < b) {
                best.insert(next, cost);
                queue.push((cost + guess(nbr, nbc), cost, nbr, nbc, r, c));
            }
        }
    }
    -1
}

// arm 3: min_push_box_layers.kara
fn a3_min_push_box(grid: Vec[Vec[char]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let flat: Vec[char] = grid.iter().flat_map(|row| row.iter()).collect();
    let player = flat.iter().position(|ch| ch == 'S').unwrap();
    let box_at = flat.iter().position(|ch| ch == 'B').unwrap();
    let target = flat.iter().position(|ch| ch == 'T').unwrap();
    let cells = m * n;
    // The cell a step from `p` in direction `d` reaches, if any.
    let step = |p: i64, d: i64| {
        let (r, c) = (p / n, p % n);
        let (r, c) = match d {
            0 => (r - 1, c),
            1 => (r + 1, c),
            2 => (r, c - 1),
            _ => (r, c + 1),
        };
        if r < 0 or r >= m or c < 0 or c >= n or flat[r * n + c] == '#' { None } else { Some(r * n + c) }
    };
    let mut seen = Vec.filled(cells * cells, false);
    // The pushes out of the last layer, not yet claimed: a state a push
    // reaches may be reached by steps alone in the layer still flooding.
    let mut pushed: Vec[(i64, i64)] = [(box_at, player)];
    let mut pushes = 0;
    while not pushed.is_empty() {
        let mut layer: Vec[(i64, i64)] = Vec.new();
        for (b, p) in pushed.iter() {
            if not seen[b * cells + p] {
                seen[b * cells + p] = true;
                layer.push((b, p));
            }
        }
        let mut next: Vec[(i64, i64)] = Vec.new();
        let mut i = 0;
        while i < layer.len() {
            let (b, p) = layer[i];
            i += 1;
            if b == target {
                return pushes;
            }
            for d in 0..4 {
                let Some(q) = step(p, d) else {
                    continue;
                };
                if q != b {
                    if not seen[b * cells + q] {
                        seen[b * cells + q] = true;
                        layer.push((b, q));
                    }
                } else if let Some(nb) = step(b, d) {
                    next.push((nb, b));
                }
            }
        }
        pushed = next;
        pushes += 1;
    }
    -1
}

// arm 4: min_push_box_solution.kara
impl A4Solution {
    pub fn min_push_box(grid: Vec[Vec[char]]) -> i32 {
        let m = grid.len();
        let n = grid[0].len();
        let mut (sx, sy, bx, by, tx, ty) = (0, 0, 0, 0, 0, 0);
        for i in 0..m {
            for j in 0..n {
                match grid[i][j] {
                    'S' => {
                        sx = i;
                        sy = j;
                    }
                    'B' => {
                        bx = i;
                        by = j;
                    }
                    'T' => {
                        tx = i;
                        ty = j;
                    }
                    _ => {}
                }
            }
        }
        let dirs = [(0i32, 1i32), (1, 0), (0, -1), (-1, 0)];
        let ok = |x: i32, y: i32| {
            x >= 0 and y >= 0 and x < m and y < n and grid[x][y] != '#'
        };
        let mut dist = Vec.filled(m * n, Vec.filled(m * n, i32.MAX));
        let mut q = VecDeque.new();
        dist[bx * n + by][sx * n + sy] = 0;
        q.push_back((bx, by, sx, sy));
        while let Some((bx, by, sx, sy)) = q.pop_front() {
            let d = dist[bx * n + by][sx * n + sy];
            if bx == tx and by == ty {
                return d;
            }
            for (dx, dy) in dirs.iter() {
                let nx = sx as i32 + dx;
                let ny = sy as i32 + dy;
                if not ok(nx, ny) {
                    continue;
                }
                let (nx, ny) = (nx as i64, ny as i64);
                if nx == bx and ny == by {
                    let nbx = bx as i32 + dx;
                    let nby = by as i32 + dy;
                    if not ok(nbx, nby) {
                        continue;
                    }
                    let (nbx, nby) = (nbx as i64, nby as i64);
                    if dist[nbx * n + nby][nx * n + ny] > d + 1 {
                        dist[nbx * n + nby][nx * n + ny] = d + 1;
                        q.push_back((nbx, nby, nx, ny));
                    }
                } else if dist[bx * n + by][nx * n + ny] > d {
                    dist[bx * n + by][nx * n + ny] = d;
                    q.push_front((bx, by, nx, ny));
                }
            }
        }
        -1
    }
}

struct A4Solution {}

fn a4_min_push_box(grid: Vec[Vec[char]]) -> i64 {
    A4Solution.min_push_box(grid)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn parse(rows: Vec[Str]) -> Vec[Vec[char]] {
    rows.iter().map(|row| row.chars().collect()).collect()
}

// An `m` by `n` grid, each cell a wall one time in `walls`, and the
// player, the box and the target on three different cells.
fn random_grid(m: i64, n: i64, walls: i64, seed: mut ref i64) -> Vec[Vec[char]] {
    let mut grid: Vec[Vec[char]] = (0..m).map(|_| (0..n).map(|_| if next_random(mut seed) % walls == 0 { '#' } else { '.' }).collect()).collect();
    for mark in ['S', 'B', 'T'] {
        let mut p = next_random(mut seed) % (m * n);
        while ['S', 'B', 'T'].contains(grid[p / n][p % n]) {
            p = (p + 1) % (m * n);
        }
        grid[p / n][p % n] = mark;
    }
    grid
}

fn ask(arm: i64, grid: Vec[Vec[char]]) -> i64 {
    match arm {
        0 => a0_min_push_box(grid),
        1 => a1_min_push_box(grid),
        2 => a2_min_push_box(grid),
        3 => a3_min_push_box(grid),
        _ => a4_min_push_box(grid),
    }
}

// The statement read literally: the fewest pushes to every (box, player)
// state, from the start's 0, relaxed by every step and every push until
// nothing changes; `i64.MAX` stands for a state not reached.
fn literal(grid: Vec[Vec[char]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let cells = m * n;
    let at = |want: char| {
        for p in 0..cells {
            if grid[p / n][p % n] == want {
                return p;
            }
        }
        -1
    };
    let free = |r: i64, c: i64| r >= 0 and r < m and c >= 0 and c < n and grid[r][c] != '#';
    let mut fewest = Vec.filled(cells * cells, i64.MAX);
    fewest[at('B') * cells + at('S')] = 0;
    let mut changed = true;
    while changed {
        changed = false;
        for b in 0..cells {
            for p in 0..cells {
                let now = fewest[b * cells + p];
                if now == i64.MAX {
                    continue;
                }
                for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
                    let (r, c) = (p / n + dr, p % n + dc);
                    if not free(r, c) {
                        continue;
                    }
                    let (nb, cost) = if r * n + c == b { ((r + dr) * n + c + dc, now + 1) } else { (b, now) };
                    if nb != b and not free(r + dr, c + dc) {
                        continue;
                    }
                    if cost < fewest[nb * cells + r * n + c] {
                        fewest[nb * cells + r * n + c] = cost;
                        changed = true;
                    }
                }
            }
        }
    }
    let t = at('T');
    let best = (0..cells).map(|p| fewest[t * cells + p]).min().unwrap();
    if best == i64.MAX { -1 } else { best }
}

fn transposed(grid: Vec[Vec[char]]) -> Vec[Vec[char]] {
    (0..grid[0].len()).map(|c| grid.iter().map(|row| row[c]).collect()).collect()
}

fn mirrored(grid: Vec[Vec[char]]) -> Vec[Vec[char]] {
    grid.iter().map(|row| row.iter().rev().cloned().collect()).collect()
}

// `a` no smaller than `b`, -1 standing for no way at all.
fn no_fewer(a: i64, b: i64) -> bool {
    a == -1 or (b != -1 and a >= b)
}

fn main() {
    let names = ["the statement read literally: the fewest pushes, relaxed to a fixed point", "the grid transposed, the same answer", "the grid mirrored, the same answer", "-1, or at least the box's distance to the target", "a free cell walled, no fewer pushes", "the ★ arm's answer"];
    let mut fails = Vec.filled(6, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 12630;
    for _ in 0..2000 {
        let m = next_random(mut seed) % 4 + 2;
        let n = next_random(mut seed) % 4 + 3;
        let grid = random_grid(m, n, 6, mut seed);
        let want = literal(grid);
        check = (check * 131 + want + 1) % 1000000007;
        let mut walled = grid.clone();
        let mut p = next_random(mut seed) % (m * n);
        let mut tries = 0;
        while walled[p / n][p % n] != '.' and tries < m * n {
            p = (p + 1) % (m * n);
            tries += 1;
        }
        if walled[p / n][p % n] == '.' {
            walled[p / n][p % n] = '#';
        }
        let mut boxed = (0, 0);
        let mut aim = (0, 0);
        for r in 0..m {
            for c in 0..n {
                if grid[r][c] == 'B' {
                    boxed = (r, c);
                } else if grid[r][c] == 'T' {
                    aim = (r, c);
                }
            }
        }
        let far = (boxed.0 - aim.0).abs() + (boxed.1 - aim.1).abs();
        let star = ask(0, grid);
        for arm in 0..5 {
            let got = ask(arm, grid);
            let held = [got == want, ask(arm, transposed(grid)) == got, ask(arm, mirrored(grid)) == got, got == -1 or got >= far, no_fewer(ask(arm, walled), got), got == star];
            for q in 0..6 {
                checks += 1;
                if not held[q] {
                    fails[q] += 1;
                    if fails[q] <= 2 {
                        println(f"P{q + 1} ({names[q]}) fails on arm {arm}: {grid}");
                    }
                }
            }
        }
    }
    let total: i64 = fails.iter().sum();
    for q in 0..6 {
        if fails[q] > 0 {
            print(f"P{q + 1}: {fails[q]} failures ");
        }
    }
    println(f"2000 grids: checksum {check}, {checks} checks over 5 arms: {total} failures");
}
