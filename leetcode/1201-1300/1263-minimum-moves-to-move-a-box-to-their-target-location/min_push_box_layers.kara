// LeetCode #1263: Minimum Moves to Move a Box to Their Target Location --
// layer by layer: the states reached with `k` pushes are flooded by the
// player's steps, which push nothing, and every push out of the flood
// starts layer `k + 1`, the states kept in a flat `Vec[bool]` per box and
// player cell.

fn min_push_box(grid: Vec[Vec[char]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let flat: Vec[char] = grid.iter().flat_map(|row| row.iter()).collect();
    let player = flat.iter().position(|ch| ch == 'S').unwrap();
    let box_at = flat.iter().position(|ch| ch == 'B').unwrap();
    let target = flat.iter().position(|ch| ch == 'T').unwrap();
    let cells = m * n;
    // The cell a step from `p` in direction `d` reaches, if any.
    let step = |p: i64, d: i64| {
        let (r, c) = (p / n, p % n);
        let (r, c) = match d {
            0 => (r - 1, c),
            1 => (r + 1, c),
            2 => (r, c - 1),
            _ => (r, c + 1),
        };
        if r < 0 or r >= m or c < 0 or c >= n or flat[r * n + c] == '#' { None } else { Some(r * n + c) }
    };
    let mut seen = Vec.filled(cells * cells, false);
    // The pushes out of the last layer, not yet claimed: a state a push
    // reaches may be reached by steps alone in the layer still flooding.
    let mut pushed: Vec[(i64, i64)] = [(box_at, player)];
    let mut pushes = 0;
    while not pushed.is_empty() {
        let mut layer: Vec[(i64, i64)] = Vec.new();
        for (b, p) in pushed.iter() {
            if not seen[b * cells + p] {
                seen[b * cells + p] = true;
                layer.push((b, p));
            }
        }
        let mut next: Vec[(i64, i64)] = Vec.new();
        let mut i = 0;
        while i < layer.len() {
            let (b, p) = layer[i];
            i += 1;
            if b == target {
                return pushes;
            }
            for d in 0..4 {
                let Some(q) = step(p, d) else {
                    continue;
                };
                if q != b {
                    if not seen[b * cells + q] {
                        seen[b * cells + q] = true;
                        layer.push((b, q));
                    }
                } else if let Some(nb) = step(b, d) {
                    next.push((nb, b));
                }
            }
        }
        pushed = next;
        pushes += 1;
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn parse(rows: Vec[Str]) -> Vec[Vec[char]] {
    rows.iter().map(|row| row.chars().collect()).collect()
}

// An `m` by `n` grid, each cell a wall one time in `walls`, and the
// player, the box and the target on three different cells.
fn random_grid(m: i64, n: i64, walls: i64, seed: mut ref i64) -> Vec[Vec[char]] {
    let mut grid: Vec[Vec[char]] = (0..m).map(|_| (0..n).map(|_| if next_random(mut seed) % walls == 0 { '#' } else { '.' }).collect()).collect();
    for mark in ['S', 'B', 'T'] {
        let mut p = next_random(mut seed) % (m * n);
        while ['S', 'B', 'T'].contains(grid[p / n][p % n]) {
            p = (p + 1) % (m * n);
        }
        grid[p / n][p % n] = mark;
    }
    grid
}

fn main() {
    // LeetCode's examples
    let one = parse(["######", "#T####", "#..B.#", "#.##.#", "#...S#", "######"]);
    let two = parse(["######", "#T####", "#..B.#", "####.#", "#...S#", "######"]);
    let three = parse(["######", "#T..##", "#.#B.#", "#....#", "#...S#", "######"]);
    println(f"{min_push_box(one)} {min_push_box(two)} {min_push_box(three)}");
    // 1000 random grids of 3 to 10 by 3 to 10, a cell in 8 a wall
    let mut seed = 1263;
    let mut total = 0;
    let mut stuck = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let m = next_random(mut seed) % 8 + 3;
        let n = next_random(mut seed) % 8 + 3;
        let pushes = min_push_box(random_grid(m, n, 8, mut seed));
        if pushes < 0 {
            stuck += 1;
        } else {
            total += pushes;
        }
        check = (check * 131 + pushes + 1) % 1000000007;
    }
    println(f"1000 random grids: {total} pushes, {stuck} stuck, checksum {check}");
    // the constraints' top: 20 by 20 open, the box across from its target,
    // and twice 20 by 20 a cell in 10 a wall
    let mut open: Vec[Vec[char]] = (0..20).map(|_| Vec.filled(20, '.')).collect();
    open[0][0] = 'S';
    open[1][1] = 'B';
    open[18][18] = 'T';
    println(f"{min_push_box(open)} {min_push_box(random_grid(20, 20, 10, mut seed))} {min_push_box(random_grid(20, 20, 10, mut seed))}");
}
