// LeetCode #1222 bench, the Kāra ★ arm: mark the queens on an 8 by 8
// board, then walk out from the king in each of the eight directions, over
// 5000 random boards of 1 to 63 queens drawn once, 200 passes; checksum of
// the attackers in the order found.

fn queens_attackthe_king(queens: Vec[Vec[i64]], king: Vec[i64]) -> Vec[Vec[i64]] {
    let mut board = [[false; 8]; 8];
    for q in queens.iter() {
        board[q[0]][q[1]] = true;
    }
    let mut attackers: Vec[Vec[i64]] = Vec.new();
    for dx in -1..=1 {
        for dy in -1..=1 {
            if dx == 0 and dy == 0 {
                continue;
            }
            let mut x = king[0] + dx;
            let mut y = king[1] + dy;
            while x >= 0 and x < 8 and y >= 0 and y < 8 {
                if board[x][y] {
                    attackers.push([x, y]);
                    break;
                }
                x += dx;
                y += dy;
            }
        }
    }
    attackers
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1222;
    let mut boards: Vec[(Vec[Vec[i64]], Vec[i64])] = Vec.new();
    for _ in 0..5000 {
        let count = next_random(mut seed) % 63 + 1;
        let mut squares: Vec[i64] = (0..64).collect();
        for k in 0..count + 1 {
            let j = k + next_random(mut seed) % (64 - k);
            squares.swap(k, j);
        }
        let queens: Vec[Vec[i64]] = squares[0..count].iter().map(|s| [s / 8, s % 8]).collect();
        boards.push((queens, [squares[count] / 8, squares[count] % 8]));
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..200 {
        for (queens, king) in boards.iter() {
            let attackers = queens_attackthe_king(queens, king);
            total += attackers.len();
            for a in attackers.iter() {
                check = (check * 131 + a[0] * 8 + a[1] + 1) % 1000000007;
            }
        }
    }
    println(f"5000 boards of 1 to 63 queens, 200 passes: attackers total {total}, checksum {check}");
}
