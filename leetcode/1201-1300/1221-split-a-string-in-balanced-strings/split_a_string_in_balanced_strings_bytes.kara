// LeetCode #1221: Split a String in Balanced Strings -- the bytes walked
// with a `match` on `b'L'` and `b'R'`, the balance an `i32`, and a piece
// counted where it comes back to zero. O(n).

fn balanced_string_split(s: String) -> i64 {
    let mut balance: i32 = 0;
    let mut pieces = 0;
    for b in s.bytes() {
        balance += match b {
            b'L' => 1,
            _ => -1,
        };
        pieces += if balance == 0 { 1 } else { 0 };
    }
    pieces
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `half` L's and `half` R's in an order drawn from `seed`.
fn shuffled(half: i64, seed: mut ref i64) -> String {
    let mut letters: Vec[char] = Vec.new();
    for _ in 0..half {
        letters.push('L');
        letters.push('R');
    }
    let mut k = letters.len() - 1;
    while k > 0 {
        let j = next_random(mut seed) % (k + 1);
        letters.swap(k, j);
        k -= 1;
    }
    letters.iter().collect()
}

fn main() {
    for s in ["RLRRLLRLRL", "RLRRRLLRLL", "LLLLRRRR", "RL", "LLRRLR"] {
        println(f"{s}: {balanced_string_split(s)}");
    }
    let mut seed = 1221;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let half = next_random(mut seed) % 8 + 1;
        let s = shuffled(half, mut seed);
        let answer = balanced_string_split(s);
        total += answer;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"1000 random strings up to 16 letters: pieces total {total}, checksum {check}");
    // The constraints' top: 1000 letters.
    let mut alternating = String.new();
    for _ in 0..500 {
        alternating.push_str("LR");
    }
    let mut nested = String.new();
    for _ in 0..500 {
        nested.push('L');
    }
    for _ in 0..500 {
        nested.push('R');
    }
    let wide = shuffled(500, mut seed);
    println(f"1000 letters, LR over and over: {balanced_string_split(alternating)}, 500 L then 500 R: {balanced_string_split(nested)}, shuffled: {balanced_string_split(wide)}");
}
