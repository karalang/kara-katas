// LeetCode #1221 bench, the Kāra ★ arm: walk the string keeping L's count
// less R's and count the returns to zero, over 2000 random balanced strings
// of 1000 letters drawn once, 20 passes; checksum of the answers.

fn balanced_string_split(s: String) -> i64 {
    let mut balance = 0;
    let mut pieces = 0;
    for c in s.chars() {
        if c == 'L' {
            balance += 1;
        } else {
            balance -= 1;
        }
        if balance == 0 {
            pieces += 1;
        }
    }
    pieces
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1221;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..2000 {
        let mut letters: Vec[char] = Vec.new();
        for _ in 0..500 {
            letters.push('L');
            letters.push('R');
        }
        let mut k = letters.len() - 1;
        while k > 0 {
            let j = next_random(mut seed) % (k + 1);
            letters.swap(k, j);
            k -= 1;
        }
        strings.push(letters.iter().collect());
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..20 {
        for s in strings.iter() {
            let answer = balanced_string_split(s);
            total += answer;
            check = (check * 131 + answer) % 1000000007;
        }
    }
    println(f"2000 strings of 1000 letters, 20 passes: pieces total {total}, checksum {check}");
}
