// LeetCode #1221: Split a String in Balanced Strings -- the six arms
// against the statement read literally and five more properties.
// Generated from the arms; see the README.

// ---- arm 0: star --------------------------------------------------------
fn a0_balanced_string_split(s: String) -> i64 {
    let mut balance = 0;
    let mut pieces = 0;
    for c in s.chars() {
        if c == 'L' {
            balance += 1;
        } else {
            balance -= 1;
        }
        if balance == 0 {
            pieces += 1;
        }
    }
    pieces
}

// ---- arm 1: bytes -------------------------------------------------------
fn a1_balanced_string_split(s: String) -> i64 {
    let mut balance: i32 = 0;
    let mut pieces = 0;
    for b in s.bytes() {
        balance += match b {
            b'L' => 1,
            _ => -1,
        };
        pieces += if balance == 0 { 1 } else { 0 };
    }
    pieces
}

// ---- arm 2: fold --------------------------------------------------------
fn a2_balanced_string_split(s: String) -> i64 {
    let (_, pieces) = s.chars().fold((0, 0), |(balance, pieces), c| {
        let next = if c == 'L' { balance + 1 } else { balance - 1 };
        (next, if next == 0 { pieces + 1 } else { pieces })
    });
    pieces
}

// ---- arm 3: prefix ------------------------------------------------------
fn a3_balanced_string_split(s: String) -> i64 {
    let mut prefix: Vec[i64] = [0];
    for c in s.chars() {
        let last = prefix[prefix.len() - 1];
        prefix.push(if c == 'L' { last + 1 } else { last - 1 });
    }
    prefix[1..].iter().filter(|p| p == 0).count()
}

// ---- arm 4: counter -----------------------------------------------------
struct A4Solution {}

impl A4Solution {
    pub fn balanced_string_split(s: String) -> i32 {
        let mut balance = 0;
        let mut ans = 0;
        for c in s.chars() {
            if c == 'L' {
                balance += 1;
            } else {
                balance -= 1;
            }
            if balance == 0 {
                ans += 1;
            }
        }
        ans
    }
}

fn a4_balanced_string_split(s: String) -> i64 {
    A4Solution.balanced_string_split(s)
}

// ---- arm 5: scan --------------------------------------------------------
struct A5Solution {}

impl A5Solution {
    pub fn balanced_string_split(s: String) -> i32 {
        s.bytes()
            .iter()
            .scan(0, |b, c| { let b = b + if c == b'L' { 1 } else { -1 }; Some((b, b)) })
            .filter(|b| b == 0)
            .count() as i32
    }
}

fn a5_balanced_string_split(s: String) -> i64 {
    A5Solution.balanced_string_split(s)
}

// ---- the statement read literally -----------------------------------------

// Every way to cut the string into consecutive pieces, as a mask of the
// places between letters that are cut, kept when every piece holds as many
// L's as R's; the most pieces of those kept.
fn literal(s: String) -> i64 {
    let letters: Vec[char] = s.chars().collect();
    let n = letters.len();
    let mut best = 0;
    for cuts in 0..(1 << (n - 1)) {
        let mut pieces = 0;
        let mut ls = 0;
        let mut rs = 0;
        let mut every = true;
        for k in 0..n {
            if letters[k] == 'L' {
                ls += 1;
            } else {
                rs += 1;
            }
            if k == n - 1 or (cuts >> k) & 1 == 1 {
                if ls != rs {
                    every = false;
                }
                pieces += 1;
                ls = 0;
                rs = 0;
            }
        }
        if every and pieces > best {
            best = pieces;
        }
    }
    best
}

// ---- the differential -----------------------------------------------------

fn arms(s: String) -> Vec[i64] {
    [a0_balanced_string_split(s), a1_balanced_string_split(s), a2_balanced_string_split(s), a3_balanced_string_split(s), a4_balanced_string_split(s), a5_balanced_string_split(s)]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn shuffled(half: i64, seed: mut ref i64) -> String {
    let mut letters: Vec[char] = Vec.new();
    for _ in 0..half {
        letters.push('L');
        letters.push('R');
    }
    let mut k = letters.len() - 1;
    while k > 0 {
        let j = next_random(mut seed) % (k + 1);
        letters.swap(k, j);
        k -= 1;
    }
    letters.iter().collect()
}

fn main() {
    let names = ["the statement read literally", "the string reversed gives the same", "every L an R and every R an L gives the same", "two balanced strings joined give the sum of their answers", "between 1 and half the string's length", "the ★ arm's answer"];
    let mut fails = Vec.filled(6, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 1221;
    for _ in 0..2000 {
        // 1 to 7 of each letter, and a second string of 1 to 4 of each
        let half = next_random(mut seed) % 7 + 1;
        let s = shuffled(half, mut seed);
        let t = shuffled(next_random(mut seed) % 4 + 1, mut seed);
        let want = literal(s);
        let got = arms(s);
        let backwards = arms(s.chars().rev().collect());
        let swapped = arms(s.chars().map(|c| if c == 'L' { 'R' } else { 'L' }).collect());
        let alone = arms(t);
        let joined = arms(f"{s}{t}");
        for a in 0..6 {
            let v = got[a];
            let held = [
                v == want,
                backwards[a] == v,
                swapped[a] == v,
                joined[a] == v + alone[a],
                v >= 1 and v <= half,
                v == got[0],
            ];
            for p in 0..6 {
                checks += 1;
                if not held[p] {
                    fails[p] += 1;
                    if fails[p] <= 2 {
                        println(f"P{p + 1} ({names[p]}) fails on arm {a}: {s} -> {v}");
                    }
                }
            }
        }
        check = (check * 131 + want) % 1000000007;
    }
    for p in 0..6 {
        if fails[p] > 0 {
            println(f"P{p + 1}: {fails[p]} failures");
        }
    }
    let total = fails.iter().sum();
    println(f"2000 cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
}
