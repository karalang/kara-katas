// LeetCode #1261 bench, in Kāra: the ★ arm (the tree recovered from the
// root down, every value kept in a hash set) on 20 random contaminated trees
// of 10000 nodes, at most 20 levels deep, built once; 120 rounds, each tree
// recovered again and asked 10000 targets, half of them nodes' places;
// the targets found counted and folded into a checksum.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

struct FindElements {
    values: Set[i64],
}

fn recover(node: Option[TreeNode], value: i64, values: mut ref Set[i64]) {
    if let Some(n) = node {
        n.val = value;
        values.insert(value);
        recover(n.left, 2 * value + 1, mut values);
        recover(n.right, 2 * value + 2, mut values);
    }
}

impl FindElements {
    fn new(root: Option[TreeNode]) -> FindElements {
        let mut values = Set.new();
        recover(root, 0, mut values);
        FindElements { values }
    }

    fn find(self, target: i64) -> bool {
        self.values.contains(target)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The contaminated tree with a node at each heap place in `present`: the
// root at 0 and the children of place `p` at `2p + 1` and `2p + 2`, every
// value -1.
fn build(present: SortedSet[i64], at: i64) -> Option[TreeNode] {
    if not present.contains(at) {
        return None;
    }
    Some(TreeNode { val: -1, left: build(present, 2 * at + 1), right: build(present, 2 * at + 2) })
}

// `n` heap places grown from the root, each a free child of a random
// place already there, at most 20 levels below the root.
fn random_places(n: i64, seed: mut ref i64) -> SortedSet[i64] {
    let mut places: Vec[i64] = [0];
    let mut present: SortedSet[i64] = SortedSet.new();
    present.insert(0);
    while places.len() < n {
        let p = places[next_random(mut seed) % places.len()];
        let child = 2 * p + 1 + next_random(mut seed) % 2;
        if child < 2097151 and not present.contains(child) {
            present.insert(child);
            places.push(child);
        }
    }
    present
}

fn main() {
    let mut seed = 1261;
    let mut trees: Vec[Option[TreeNode]] = Vec.new();
    let mut targets: Vec[Vec[i64]] = Vec.new();
    for _ in 0..20 {
        let present = random_places(10000, mut seed);
        let places: Vec[i64] = present.iter().cloned().collect();
        let deepest = places[places.len() - 1];
        trees.push(build(present, 0));
        targets.push((0..10000).map(|q| if q % 2 == 0 { places[next_random(mut seed) % 10000] } else { next_random(mut seed) * 64 % (deepest + 1) }).collect());
    }
    let mut found = 0;
    let mut check = 0;
    for _ in 0..120 {
        for t in 0..20 {
            let tree = FindElements.new(trees[t]);
            for target in targets[t].iter() {
                if tree.find(target) {
                    found += 1;
                    check = (check * 131 + target) % 1000000007;
                }
            }
        }
    }
    println(f"120 rounds of 20 trees of 10000 nodes: {found} found, checksum {check}");
}
