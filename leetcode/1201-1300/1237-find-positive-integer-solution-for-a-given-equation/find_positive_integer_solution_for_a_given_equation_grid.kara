// LeetCode #1237: Find Positive Integer Solution for a Given Equation -- the
// grid walked row by row, each row of `y` cut short at the first value
// past `z`, the pairs gathered by `flat_map` and `filter` over ranges.
// O(x · y) calls in the worst case.

// The judge's hidden function: one of nine, each increasing in both
// arguments.
pub struct CustomFunction {
    id: i32,
}

impl CustomFunction {
    pub fn f(self, x: i32, y: i32) -> i32 {
        match self.id {
            1 => x + y,
            2 => x * y,
            3 => x * x + y,
            4 => x + y * y,
            5 => x * x + y * y,
            6 => (x + y) * (x + y),
            7 => x * x * x + y * y * y,
            8 => x * x * y,
            _ => x * y * y,
        }
    }
}

fn find_solution(customfunction: CustomFunction, z: i32) -> Vec[Vec[i32]] {
    (1..=1000)
        .flat_map(|x| (1..=1000).take_while(|y| customfunction.f(x, y) <= z).map(|y| [x, y]))
        .filter(|p| customfunction.f(p[0], p[1]) == z)
        .collect()
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples
    println(f"{find_solution(CustomFunction { id: 1 }, 5)}");
    println(f"{find_solution(CustomFunction { id: 2 }, 5)}");
    // every function and every `z` from 1 to 100
    let mut check = 0;
    let mut pairs = 0;
    for id in 1..=9 {
        for z in 1..=100 {
            let got = find_solution(CustomFunction { id: id }, z);
            pairs += got.len();
            for p in got.iter() {
                check = (check * 131 + p[0] as i64 * 1001 + p[1]) % 1000000007;
            }
        }
    }
    println(f"9 functions, z from 1 to 100: {pairs} pairs, checksum {check}");
}
