// LeetCode #1237: Find Positive Integer Solution for a Given Equation -- the arms
// against the statement read literally and five more properties.
// Generated from the arms; see the README.

// ---- arm 0: star --------------------------------------------------------
fn a0_find_solution(customfunction: CustomFunction, z: i32) -> Vec[Vec[i32]] {
    let mut out = Vec.new();
    let mut x = 1;
    let mut y = 1000;
    while x <= 1000 and y >= 1 {
        let v = customfunction.f(x, y);
        if v < z {
            x += 1;
        } else if v > z {
            y -= 1;
        } else {
            out.push([x, y]);
            x += 1;
            y -= 1;
        }
    }
    out
}

// ---- arm 1: bisect ------------------------------------------------------
fn a1_find_solution(customfunction: CustomFunction, z: i32) -> Vec[Vec[i32]] {
    let mut out = Vec.new();
    for x in 1..=1000 {
        if customfunction.f(x, 1) > z {
            break;
        }
        let mut lo = 1;
        let mut hi = 1001;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if customfunction.f(x, mid) < z {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo <= 1000 and customfunction.f(x, lo) == z {
            out.push([x, lo]);
        }
    }
    out
}

// ---- arm 2: grid --------------------------------------------------------
fn a2_find_solution(customfunction: CustomFunction, z: i32) -> Vec[Vec[i32]] {
    (1..=1000)
        .flat_map(|x| (1..=1000).take_while(|y| customfunction.f(x, y) <= z).map(|y| [x, y]))
        .filter(|p| customfunction.f(p[0], p[1]) == z)
        .collect()
}

// ---- arm 3: pointers ----------------------------------------------------
struct A3Solution {}

impl A3Solution {
    pub fn find_solution(customfunction: CustomFunction, z: i32) -> Vec[Vec[i32]] {
        let mut res = Vec.new();
        let mut (x, y) = (1, 1000);
        while x <= 1000 and y >= 1 {
            match customfunction.f(x, y).cmp(z) {
                Ordering.Less => x += 1,
                Ordering.Greater => y -= 1,
                Ordering.Equal => {
                    res.push([x, y]);
                    x += 1;
                    y -= 1;
                }
            }
        }
        res
    }
}

fn a3_find_solution(customfunction: CustomFunction, z: i32) -> Vec[Vec[i32]] {
    A3Solution.find_solution(customfunction, z)
}

// ---- arm 4: search ------------------------------------------------------
struct A4Solution {}

impl A4Solution {
    pub fn find_solution(customfunction: CustomFunction, z: i32) -> Vec[Vec[i32]] {
        let ys: Vec[i32] = (1..=1000).collect();
        let mut ans = Vec.new();
        for x in 1..=1000 {
            {
                let i = ys.partition_point(|y| customfunction.f(x, y).cmp(z) == Ordering.Less);
                if i < ys.partition_point(|y| customfunction.f(x, y).cmp(z) != Ordering.Greater) {
                    ans.push([x, ys[i]]);
                }
            }
        }
        ans
    }
}

fn a4_find_solution(customfunction: CustomFunction, z: i32) -> Vec[Vec[i32]] {
    A4Solution.find_solution(customfunction, z)
}

// ---- the judge ------------------------------------------------------------

// LeetCode's nine functions (`id` 1 to 9), and more: `a·x^p + b·y^q +
// c·x·y` with positive `a` and `b`, so that `f(x, y) >= max(x, y)` and every
// value with `x, y <= 1000` fits an `i32`; `swap` reads `f(y, x)`.
pub struct CustomFunction {
    id: i32,
    a: i32,
    b: i32,
    c: i32,
    p: i32,
    q: i32,
    swap: bool,
}

fn power(v: i32, k: i32) -> i32 {
    let mut out: i32 = 1;
    for _ in 0..k {
        out *= v;
    }
    out
}

impl CustomFunction {
    pub fn f(self, x: i32, y: i32) -> i32 {
        let (x, y) = if self.swap { (y, x) } else { (x, y) };
        match self.id {
            1 => x + y,
            2 => x * y,
            3 => x * x + y,
            4 => x + y * y,
            5 => x * x + y * y,
            6 => (x + y) * (x + y),
            7 => x * x * x + y * y * y,
            8 => x * x * y,
            9 => x * y * y,
            _ => self.a * power(x, self.p) + self.b * power(y, self.q) + self.c * x * y,
        }
    }
}

// ---- the statement read literally -----------------------------------------

// Every pair with `f(x, y) == z`. Since `f(x, y) >= max(x, y)`, no pair
// with `x` or `y` above `z` can be one, so the square up to `z` is all of
// them.
fn literal(fun: CustomFunction, z: i32) -> Vec[Vec[i32]] {
    let mut out = Vec.new();
    for x in 1..=z.min(1000) {
        for y in 1..=z.min(1000) {
            if fun.f(x, y) == z {
                out.push([x, y]);
            }
        }
    }
    out
}

// ---- the differential -----------------------------------------------------

fn arms(fun: CustomFunction, z: i32) -> Vec[Vec[Vec[i32]]] {
    [a0_find_solution(fun, z), a1_find_solution(fun, z), a2_find_solution(fun, z), a3_find_solution(fun, z), a4_find_solution(fun, z)]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn coefficient(p: i32, r: i64) -> i32 {
    match p {
        3 => 1,
        2 => (r % 100 + 1) as i32,
        _ => (r % 1000 + 1) as i32,
    }
}

fn main() {
    let names = ["the statement read literally", "every pair solves it", "no pair twice", "the function's arguments swapped give the pairs swapped", "one pair at most for each x", "the ★ arm's answer"];
    let mut fails = Vec.filled(6, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 1237;
    for c in 0..2000 {
        let id = if c % 4 == 0 { (next_random(mut seed) % 9 + 1) as i32 } else { 10 };
        let p = (next_random(mut seed) % 3 + 1) as i32;
        let q = (next_random(mut seed) % 3 + 1) as i32;
        // a third of the others with every coefficient 1, so that `z` is often reached
        let small = c % 3 == 0;
        let a = if small { 1 } else { coefficient(p, next_random(mut seed)) };
        let b = if small { 1 } else { coefficient(q, next_random(mut seed)) };
        let k = if small { 0 } else { (next_random(mut seed) % 101) as i32 };
        let z = (next_random(mut seed) % 100 + 1) as i32;
        let fun = CustomFunction { id: id, a: a, b: b, c: k, p: p, q: q, swap: false };
        let swapped = CustomFunction { id: id, a: a, b: b, c: k, p: p, q: q, swap: true };
        let want = literal(fun, z);
        let got = arms(fun, z);
        let mirror = arms(swapped, z);
        for arm in 0..5 {
            let v = got[arm].clone();
            let mut sorted = v.clone();
            sorted.sort();
            let mut distinct = sorted.clone();
            distinct.dedup();
            let mut back: Vec[Vec[i32]] = mirror[arm].iter().map(|pair| [pair[1], pair[0]]).collect();
            back.sort();
            let mut xs: Vec[i32] = v.iter().map(|pair| pair[0]).collect();
            xs.sort();
            xs.dedup();
            let mut first = got[0].clone();
            first.sort();
            let held = [
                sorted == want,
                v.iter().all(|pair| pair[0] >= 1 and pair[0] <= 1000 and pair[1] >= 1 and pair[1] <= 1000 and fun.f(pair[0], pair[1]) == z),
                distinct.len() == v.len(),
                back == sorted,
                xs.len() == v.len(),
                sorted == first,
            ];
            for t in 0..6 {
                checks += 1;
                if not held[t] {
                    fails[t] += 1;
                    if fails[t] <= 2 {
                        println(f"P{t + 1} ({names[t]}) fails on arm {arm}: id {id}, {a}x^{p} + {b}y^{q} + {k}xy = {z} -> {v}");
                    }
                }
            }
        }
        for pair in want.iter() {
            check = (check * 131 + pair[0] as i64 * 1001 + pair[1]) % 1000000007;
        }
    }
    for t in 0..6 {
        if fails[t] > 0 {
            println(f"P{t + 1}: {fails[t]} failures");
        }
    }
    let failures = fails.iter().sum();
    println(f"2000 cases: checksum {check}, {checks} checks over {5} arms: {failures} failures");
}
