// LeetCode #1237: Find Positive Integer Solution for a Given Equation --
// the ★ arm, two pointers: `x` rising from 1 and `y` falling from 1000.
// Since `f` increases in both, a value below `z` can only be helped by a
// larger `x` and one above it by a smaller `y`, so each step moves one of
// them and every solution is met. O(x + y) calls.

// The judge's hidden function: one of nine, each increasing in both
// arguments.
pub struct CustomFunction {
    id: i32,
}

impl CustomFunction {
    pub fn f(self, x: i32, y: i32) -> i32 {
        match self.id {
            1 => x + y,
            2 => x * y,
            3 => x * x + y,
            4 => x + y * y,
            5 => x * x + y * y,
            6 => (x + y) * (x + y),
            7 => x * x * x + y * y * y,
            8 => x * x * y,
            _ => x * y * y,
        }
    }
}

fn find_solution(customfunction: CustomFunction, z: i32) -> Vec[Vec[i32]] {
    let mut out = Vec.new();
    let mut x = 1;
    let mut y = 1000;
    while x <= 1000 and y >= 1 {
        let v = customfunction.f(x, y);
        if v < z {
            x += 1;
        } else if v > z {
            y -= 1;
        } else {
            out.push([x, y]);
            x += 1;
            y -= 1;
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples
    println(f"{find_solution(CustomFunction { id: 1 }, 5)}");
    println(f"{find_solution(CustomFunction { id: 2 }, 5)}");
    // every function and every `z` from 1 to 100
    let mut check = 0;
    let mut pairs = 0;
    for id in 1..=9 {
        for z in 1..=100 {
            let got = find_solution(CustomFunction { id: id }, z);
            pairs += got.len();
            for p in got.iter() {
                check = (check * 131 + p[0] as i64 * 1001 + p[1]) % 1000000007;
            }
        }
    }
    println(f"9 functions, z from 1 to 100: {pairs} pairs, checksum {check}");
}
