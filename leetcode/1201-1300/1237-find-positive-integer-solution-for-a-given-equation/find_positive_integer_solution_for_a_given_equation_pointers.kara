// LeetCode #1237: Find Positive Integer Solution for a Given Equation -- a
// Rust solution as LeetCode's Rust users write it: two pointers from `(1,
// 1000)`, a `match` on `customfunction.f(x, y).cmp(&z)` over
// `std::cmp::Ordering`'s three variants, and each pair pushed as
// `vec![x, y]`, carried to Kāra by `karac fix`.

// The judge's hidden function: one of nine, each increasing in both
// arguments.
pub struct CustomFunction {
    id: i32,
}

impl CustomFunction {
    pub fn f(self, x: i32, y: i32) -> i32 {
        match self.id {
            1 => x + y,
            2 => x * y,
            3 => x * x + y,
            4 => x + y * y,
            5 => x * x + y * y,
            6 => (x + y) * (x + y),
            7 => x * x * x + y * y * y,
            8 => x * x * y,
            _ => x * y * y,
        }
    }
}

struct Solution {}

impl Solution {
    pub fn find_solution(customfunction: CustomFunction, z: i32) -> Vec[Vec[i32]] {
        let mut res = Vec.new();
        let mut (x, y) = (1, 1000);
        while x <= 1000 and y >= 1 {
            match customfunction.f(x, y).cmp(z) {
                Ordering.Less => x += 1,
                Ordering.Greater => y -= 1,
                Ordering.Equal => {
                    res.push([x, y]);
                    x += 1;
                    y -= 1;
                }
            }
        }
        res
    }
}

fn find_solution(customfunction: CustomFunction, z: i32) -> Vec[Vec[i32]] {
    Solution.find_solution(customfunction, z)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples
    println(f"{find_solution(CustomFunction { id: 1 }, 5)}");
    println(f"{find_solution(CustomFunction { id: 2 }, 5)}");
    // every function and every `z` from 1 to 100
    let mut check = 0;
    let mut pairs = 0;
    for id in 1..=9 {
        for z in 1..=100 {
            let got = find_solution(CustomFunction { id: id }, z);
            pairs += got.len();
            for p in got.iter() {
                check = (check * 131 + p[0] as i64 * 1001 + p[1]) % 1000000007;
            }
        }
    }
    println(f"9 functions, z from 1 to 100: {pairs} pairs, checksum {check}");
}
