// LeetCode #1295: Find Numbers with Even Number of Digits -- the
// recursive arm: the digits of a number counted by recursion on the number
// with its last digit removed, and the even counts folded over the vector.
// O(n log max)

fn digit_count(x: i64) -> i64 {
    if x < 10 { 1 } else { 1 + digit_count(x / 10) }
}

fn find_numbers(nums: Vec[i64]) -> i64 {
    nums.iter().fold(0, |even, x| if digit_count(x) % 2 == 0 { even + 1 } else { even })
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's examples, and every edge between a number of digits
    // and the next
    let edges = [1, 9, 10, 99, 100, 999, 1000, 9999, 10000, 99999, 100000];
    println(f"{find_numbers([12, 345, 2, 6, 7896])} {find_numbers([555, 901, 482, 1771])} {find_numbers(edges)} {find_numbers([100000])} {find_numbers([10])}");
    // random arrays of 1 to 500 numbers, each up to 10^5, the number of
    // digits drawn first so that every length comes up as often
    let mut seed = 1295;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let len = next_random(mut seed) % 500 + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..len {
            let digits = next_random(mut seed) % 6 + 1;
            let mut low = 1;
            for _ in 1..digits {
                low *= 10;
            }
            let x = if digits == 6 { 100000 } else { low + (next_random(mut seed) * 32768 + next_random(mut seed)) % (9 * low) };
            nums.push(x);
        }
        let even = find_numbers(nums);
        total += even;
        check = (check * 131 + even) % 1000000007;
    }
    println(f"3000 random arrays: {total} with an even number of digits, checksum {check}");
}
