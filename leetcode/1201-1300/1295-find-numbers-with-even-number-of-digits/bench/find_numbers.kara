// LeetCode #1295 bench: the ★ arm (each number's digits counted by dividing
// by 10) over 200 arrays of 500 numbers up to 10^5, the number of digits
// drawn first, built once; then 500 passes, each setting one number of every
// array from the checksum so far, answering it, and folding the count into
// the checksum.

fn find_numbers(nums: Vec[i64]) -> i64 {
    let mut even = 0;
    for x in nums.iter() {
        let mut digits = 0;
        let mut rest = x;
        while rest > 0 {
            digits += 1;
            rest /= 10;
        }
        if digits % 2 == 0 {
            even += 1;
        }
    }
    even
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1295;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..200 {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..500 {
            let digits = next_random(mut seed) % 6 + 1;
            let mut low = 1;
            for _ in 1..digits {
                low *= 10;
            }
            nums.push(if digits == 6 { 100000 } else { low + (next_random(mut seed) * 32768 + next_random(mut seed)) % (9 * low) });
        }
        arrays.push(nums);
    }
    let mut check = 0;
    for p in 0..500 {
        for a in 0..arrays.len() {
            arrays[a][check % 500] = 1 + check % 100000;
            check = (check * 31 + find_numbers(arrays[a]) + p) % 1000000007;
        }
    }
    println(f"500 passes over 200 arrays of 500: checksum {check}");
}
