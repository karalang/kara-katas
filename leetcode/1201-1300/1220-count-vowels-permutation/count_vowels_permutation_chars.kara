// LeetCode #1220: Count Vowels Permutation -- a Rust solution as
// LeetCode's Rust users write it: the rule as a `HashMap<char, &str>`
// from each vowel to the vowels that may come before it, the counts as a
// `HashMap<char, i64>` rebuilt each step by `"aeiou".chars().map(..)
// .collect()`, and the total by `values().sum()`, carried to Kāra by
// `karac fix`.

struct Solution {}

impl Solution {
    pub fn count_vowel_permutation(n: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let before: Map[char, Str] =
            [('a', "eiu"), ('e', "ai"), ('i', "eo"), ('o', "i"), ('u', "io")].into_iter().collect();
        let mut counts: Map[char, i64] = "aeiou".chars().map(|c| (c, 1)).collect();
        for _ in 1..n {
            counts = "aeiou"
                .chars()
                .map(|c| (c, before[c].chars().map(|p| counts[p]).sum() % MOD))
                .collect();
        }
        (counts.values().sum() % MOD) as i32
    }
}

fn count_vowel_permutation(n: i64) -> i64 {
    Solution.count_vowel_permutation(n as i32)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    for n in [1, 2, 5, 144] {
        println(f"n = {n}: {count_vowel_permutation(n)}");
    }
    let mut check = 0;
    for n in 1..=200 {
        check = (check * 131 + count_vowel_permutation(n)) % 1000000007;
    }
    println(f"n from 1 to 200: checksum {check}");
    println(f"n = 10^4: {count_vowel_permutation(10000)}");
    println(f"n = 2 * 10^4: {count_vowel_permutation(20000)}");
}
