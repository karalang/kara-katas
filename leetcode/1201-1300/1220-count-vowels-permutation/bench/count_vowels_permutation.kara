// LeetCode #1220 bench, the Kāra ★ arm: five running counts, the strings
// of the length so far that end in each vowel, for every n from 1 to 8000;
// checksum of the answers.

fn count_vowel_permutation(n: i64) -> i64 {
    let modulus = 1_000_000_007;
    let mut (a, e, i, o, u) = (1, 1, 1, 1, 1);
    for _ in 1..n {
        a, e, i, o, u = (e + i + u) % modulus, (a + i) % modulus, (e + o) % modulus, i, (i + o) % modulus;
    }
    (a + e + i + o + u) % modulus
}

fn main() {
    let mut check = 0;
    for n in 1..=8000 {
        check = (check * 131 + count_vowel_permutation(n)) % 1000000007;
    }
    println(f"every n from 1 to 8000: checksum {check}");
}
