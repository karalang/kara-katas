// LeetCode #1220: Count Vowels Permutation -- a Rust solution as
// LeetCode's Rust users write it: the counts in a `[i64; 5]`, a fresh
// `[0; 5]` each step filled forward through a `const` table of `&[usize]`
// slices naming the vowels each may be followed by, and the total by
// `iter().sum::<i64>()`, carried to Kāra by `karac fix`. The table's rows
// differ in length, so it has no constant form in Kāra; as `karac check`
// says, it is built in the function that uses it, an `Array[Vec[usize],
// 5]`, the one edit made by hand.

struct Solution {}

const MOD: i64 = 1_000_000_007;

impl Solution {
    pub fn count_vowel_permutation(n: i32) -> i32 {
        let follows: Array[Vec[usize], 5] = [[1], [0, 2], [0, 1, 3, 4], [2, 4], [0]];
        let mut dp = [1; 5];
        for _ in 1..n {
            let mut next = [0; 5];
            for (v, count) in dp.iter().enumerate() {
                for w in follows[v] {
                    next[w] = (next[w] + count) % MOD;
                }
            }
            dp = next;
        }
        (dp.iter().sum() % MOD) as i32
    }
}

fn count_vowel_permutation(n: i64) -> i64 {
    Solution.count_vowel_permutation(n as i32)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    for n in [1, 2, 5, 144] {
        println(f"n = {n}: {count_vowel_permutation(n)}");
    }
    let mut check = 0;
    for n in 1..=200 {
        check = (check * 131 + count_vowel_permutation(n)) % 1000000007;
    }
    println(f"n from 1 to 200: checksum {check}");
    println(f"n = 10^4: {count_vowel_permutation(10000)}");
    println(f"n = 2 * 10^4: {count_vowel_permutation(20000)}");
}
