// LeetCode #1220: Count Vowels Permutation -- every length's counts kept:
// a table of n rows, row k holding for each vowel the strings of length
// k + 1 that end in it, filled forward from the rule of which vowels may
// follow each one. O(n) time and space.

fn count_vowel_permutation(n: i64) -> i64 {
    let modulus = 1_000_000_007;
    // a, e, i, o, u as 0 to 4, and the vowels each may be followed by.
    let follows: Vec[Vec[i64]] = [[1], [0, 2], [0, 1, 3, 4], [2, 4], [0]];
    let mut table: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(5, 0));
    table[0] = Vec.filled(5, 1);
    for k in 1..n {
        for v in 0..5 {
            for w in follows[v].iter() {
                table[k][w] = (table[k][w] + table[k - 1][v]) % modulus;
            }
        }
    }
    table[n - 1].iter().sum() % modulus
}

// ---- test harness ---------------------------------------------------------

fn main() {
    for n in [1, 2, 5, 144] {
        println(f"n = {n}: {count_vowel_permutation(n)}");
    }
    let mut check = 0;
    for n in 1..=200 {
        check = (check * 131 + count_vowel_permutation(n)) % 1000000007;
    }
    println(f"n from 1 to 200: checksum {check}");
    println(f"n = 10^4: {count_vowel_permutation(10000)}");
    println(f"n = 2 * 10^4: {count_vowel_permutation(20000)}");
}
