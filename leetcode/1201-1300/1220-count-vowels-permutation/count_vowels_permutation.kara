// LeetCode #1220: Count Vowels Permutation -- the ★ arm: five running
// counts, the strings of the length so far that end in each vowel; a
// letter's next count is the sum over the letters that may come before
// it. O(n).

fn count_vowel_permutation(n: i64) -> i64 {
    let modulus = 1_000_000_007;
    let mut (a, e, i, o, u) = (1, 1, 1, 1, 1);
    for _ in 1..n {
        a, e, i, o, u = (e + i + u) % modulus, (a + i) % modulus, (e + o) % modulus, i, (i + o) % modulus;
    }
    (a + e + i + o + u) % modulus
}

// ---- test harness ---------------------------------------------------------

fn main() {
    for n in [1, 2, 5, 144] {
        println(f"n = {n}: {count_vowel_permutation(n)}");
    }
    let mut check = 0;
    for n in 1..=200 {
        check = (check * 131 + count_vowel_permutation(n)) % 1000000007;
    }
    println(f"n from 1 to 200: checksum {check}");
    println(f"n = 10^4: {count_vowel_permutation(10000)}");
    println(f"n = 2 * 10^4: {count_vowel_permutation(20000)}");
}
