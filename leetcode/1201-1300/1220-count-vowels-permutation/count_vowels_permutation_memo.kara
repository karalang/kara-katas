// LeetCode #1220: Count Vowels Permutation -- top-down: the strings of a
// given length that start with a given vowel are the sum, over the vowels
// that may follow it, of the strings one shorter that start with that
// one; each (length, vowel) answer kept in a `Map`. O(n), recursing n deep.

fn ways(length: i64, first: char, memo: mut ref Map[(i64, char), i64]) -> i64 {
    if length == 1 {
        return 1;
    }
    if let Some(known) = memo.get((length, first)) {
        return known;
    }
    let next = match first {
        'a' => "e",
        'e' => "ai",
        'i' => "aeou",
        'o' => "iu",
        _ => "a",
    };
    let mut total = 0;
    for c in next.chars() {
        total = (total + ways(length - 1, c, mut memo)) % 1_000_000_007;
    }
    memo.insert((length, first), total);
    total
}

fn count_vowel_permutation(n: i64) -> i64 {
    let mut memo: Map[(i64, char), i64] = Map.new();
    let mut total = 0;
    for c in "aeiou".chars() {
        total = (total + ways(n, c, mut memo)) % 1_000_000_007;
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn main() {
    for n in [1, 2, 5, 144] {
        println(f"n = {n}: {count_vowel_permutation(n)}");
    }
    let mut check = 0;
    for n in 1..=200 {
        check = (check * 131 + count_vowel_permutation(n)) % 1000000007;
    }
    println(f"n from 1 to 200: checksum {check}");
    println(f"n = 10^4: {count_vowel_permutation(10000)}");
    println(f"n = 2 * 10^4: {count_vowel_permutation(20000)}");
}
