// LeetCode #1265: Print Immutable Linked List in Reverse -- the ★ arm, by
// recursion: a node prints after everything after it has. O(n) time and
// O(n) stack.

// The judge's interface: a node prints its value, and hands out the node
// after it.
trait ImmutableListNode {
    fn print_value(self);
    fn get_next(self) -> Option[dyn ImmutableListNode];
}

fn print_linked_list_in_reverse(head: dyn ImmutableListNode) {
    if let Some(next) = head.get_next() {
        print_linked_list_in_reverse(next);
    }
    head.print_value();
}

// ---- test harness ---------------------------------------------------------

// What the nodes have printed, in order.
shared struct Printed {
    mut values: Vec[i64],
}

// A list node, as the judge holds it: its value, its next node and where
// it prints.
shared struct Node {
    val: i64,
    next: Option[Node],
    printed: Printed,
}

impl ImmutableListNode for Node {
    fn print_value(self) {
        self.printed.values.push(self.val);
    }

    fn get_next(self) -> Option[dyn ImmutableListNode] {
        match self.next {
            Some(n) => Some(n),
            None => None,
        }
    }
}

// The list of `values`, and what its nodes print into.
fn list(values: Vec[i64]) -> (Node, Printed) {
    let printed = Printed { values: Vec.new() };
    let mut head: Option[Node] = None;
    for v in values.iter().rev() {
        head = Some(Node { val: v, next: head, printed: printed });
    }
    (head.unwrap(), printed)
}

// What printing `values` in reverse prints.
fn printed_in_reverse(values: Vec[i64]) -> Vec[i64] {
    let (head, printed) = list(values);
    print_linked_list_in_reverse(head);
    printed.values.clone()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's examples
    println(f"{printed_in_reverse([1, 2, 3, 4])}");
    println(f"{printed_in_reverse([0, -4, -1, 3, -5])}");
    println(f"{printed_in_reverse([-2, 0, 6, 4, 4, -6])}");
    // 1000 random lists of 1 to 60 values from -1000 to 1000
    let mut seed = 1265;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 60 + 1;
        let values: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 2001 - 1000).collect();
        let got = printed_in_reverse(values);
        total += got.len();
        for v in got.iter() {
            check = (check * 131 + v + 1000) % 1000000007;
        }
    }
    println(f"1000 random lists: {total} values printed, checksum {check}");
    // the constraints' top: 1000 nodes
    let got = printed_in_reverse((0..1000).map(|i| i * 7 % 2001 - 1000).collect());
    println(f"1000 nodes: first {got[0]}, last {got[999]}, {got.len()} printed");
}
