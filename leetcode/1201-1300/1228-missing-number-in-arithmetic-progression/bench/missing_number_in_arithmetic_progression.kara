// LeetCode #1228 bench: the ★ arm, binary search on the step from the
// first and last values, over 2000 random progressions of 1000 values with
// one interior value removed, drawn once and each solved 2000 times.

fn missing_number(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let step = (arr[n - 1] - arr[0]) / n;
    let mut lo = 0;
    let mut hi = n - 1;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if arr[mid] == arr[0] + mid * step {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    arr[0] + lo * step
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1228;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..2000 {
        let first = next_random(mut seed) % 100001;
        let low = -(first / 1000);
        let high = (100000 - first) / 1000;
        let step = low + next_random(mut seed) % (high - low + 1);
        let gone = next_random(mut seed) % 999 + 1;
        arrays.push((0..1001).filter(|i| i != gone).map(|i| first + i * step).collect());
    }
    let mut check = 0;
    for _ in 0..2000 {
        for arr in arrays.iter() {
            check = (check * 131 + missing_number(arr)) % 1000000007;
        }
    }
    println(f"2000 progressions of 1000 values, 2000 passes: checksum {check}");
}
