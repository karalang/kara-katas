// LeetCode #1245: Tree Diameter -- one depth-first search from node 0:
// each node's height is one more than its tallest child's, and the
// longest path through a node joins its two tallest children, so the
// diameter is the best such join seen.

fn height(adj: Vec[Vec[i64]], node: i64, parent: i64, best: mut ref i64) -> i64 {
    let mut first = 0;
    let mut second = 0;
    for child in adj[node].iter() {
        if child == parent {
            continue;
        }
        let h = height(adj, child, node, mut best) + 1;
        if h > first {
            second = first;
            first = h;
        } else if h > second {
            second = h;
        }
    }
    *best = (*best).max(first + second);
    first
}

fn tree_diameter(edges: Vec[Vec[i64]]) -> i64 {
    let n = edges.len() + 1;
    let mut adj: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adj[e[0]].push(e[1]);
        adj[e[1]].push(e[0]);
    }
    let mut best = 0;
    height(adj, 0, -1, mut best);
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random tree on `n` nodes, each node after the first hung from an
// earlier one: anywhere (`shape` 0), from one of the last three, a long
// stringy tree (1), or from one of the first four, a bushy one (2); the
// labels shuffled, so the tree's root and shape are not in its numbering.
fn random_tree(n: i64, shape: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut label: Vec[i64] = (0..n).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        label.swap(i, j);
    }
    let mut edges: Vec[Vec[i64]] = Vec.new();
    for v in 1..n {
        let parent = match shape {
            0 => next_random(mut seed) % v,
            1 => v - 1 - next_random(mut seed) % v.min(3),
            _ => next_random(mut seed) % v.min(4),
        };
        edges.push([label[parent], label[v]]);
    }
    edges
}

fn main() {
    // LeetCode's two examples
    let first = tree_diameter([[0, 1], [0, 2]]);
    let second = tree_diameter([[0, 1], [1, 2], [2, 3], [1, 4], [4, 5]]);
    println(f"{first} {second}");
    // 1000 random trees of 1 to 300 nodes, a third of each shape
    let mut seed = 1245;
    let mut total = 0;
    let mut check = 0;
    for t in 0..1000 {
        let n = next_random(mut seed) % 300 + 1;
        let d = tree_diameter(random_tree(n, t % 3, mut seed));
        total += d;
        check = (check * 131 + d) % 1000000007;
    }
    println(f"1000 random trees: total {total}, checksum {check}");
    // the constraints' top: a path of 10000 nodes, and a tree of 10000
    // nodes of each shape
    let path: Vec[Vec[i64]] = (1..10000).map(|v| [v - 1, v]).collect();
    let mut tops: Vec[i64] = [tree_diameter(path)];
    for shape in 0..3 {
        tops.push(tree_diameter(random_tree(10000, shape, mut seed)));
    }
    println(f"10000 nodes: path {tops[0]}, random {tops[1]}, stringy {tops[2]}, bushy {tops[3]}");
}
