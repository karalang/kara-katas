// LeetCode #1267 bench, in Kāra: the ★ arm (the servers in each row and
// each column counted, then each server that shares its row or column with
// another counted) on 100 random 100-by-100 grids built once, a cell a
// server one time in 2 to 9, 300 rounds; every answer folded into a
// checksum.

fn count_servers(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut rows = Vec.filled(m, 0);
    let mut cols = Vec.filled(n, 0);
    for r in 0..m {
        for c in 0..n {
            if grid[r][c] == 1 {
                rows[r] += 1;
                cols[c] += 1;
            }
        }
    }
    let mut count = 0;
    for r in 0..m {
        for c in 0..n {
            if grid[r][c] == 1 and (rows[r] > 1 or cols[c] > 1) {
                count += 1;
            }
        }
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1267;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..100 {
        let odds = next_random(mut seed) % 8 + 2;
        grids.push((0..100).map(|_| (0..100).map(|_| if next_random(mut seed) % odds == 0 { 1 } else { 0 }).collect()).collect());
    }
    let mut check = 0;
    for round in 0..300 {
        for g in 0..100 {
            check = (check * 131 + count_servers(grids[g]) + round) % 1000000007;
        }
    }
    println(f"300 rounds of 100 grids of 100 by 100: checksum {check}");
}
