// LeetCode #1281: Subtract the Product and Sum of Digits of an Integer --
// by a fold over bytes: the number formatted by `f"{n}"`, and its bytes
// folded into one (product, sum) pair, each byte less `'0'`.

fn subtract_product_and_sum(n: i64) -> i64 {
    let (product, sum) = f"{n}".bytes().iter().fold((1, 0), |(p, s), b| {
        let digit = (b - 48) as i64;
        (p * digit, s + digit)
    });
    product - sum
}
// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's examples, and the ends of the range
    println(f"{subtract_product_and_sum(234)} {subtract_product_and_sum(4421)} {subtract_product_and_sum(1)} {subtract_product_and_sum(99999)} {subtract_product_and_sum(100000)}");
    // every n the constraints allow, 1 to 10^5
    let mut total = 0;
    let mut check = 0;
    let mut zero = 0;
    for n in 1..100001 {
        let got = subtract_product_and_sum(n);
        total += got;
        if got == 0 {
            zero += 1;
        }
        check = (check * 131 + got + 1000) % 1000000007;
    }
    println(f"1 to 100000: total {total}, {zero} zero, checksum {check}");
}
