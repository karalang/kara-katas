// LeetCode #1283 bench: the ★ arm (a binary search over 1 to the largest
// number for the first divisor whose rounded-up quotients sum within the
// threshold) over one array of 5 * 10^4 numbers up to 10^6, for 150
// thresholds from 5 * 10^4 to 10^6, each drawn from the checksum so far.

fn total(nums: Vec[i32], d: i64) -> i64 {
    let mut sum = 0;
    for x in nums.iter() {
        sum += (x + d - 1) / d;
    }
    sum
}

fn smallest_divisor(nums: Vec[i32], threshold: i32) -> i32 {
    let mut lo = 1;
    let mut hi = nums.iter().max().unwrap() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if total(nums, mid) <= threshold {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo as i32
}

fn main() {
    let mut seed: i64 = 1283;
    let mut nums: Vec[i32] = Vec.new();
    for _ in 0..50000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        nums.push((1 + seed % 1000000) as i32);
    }
    let mut check: i64 = 0;
    for r in 0..150 {
        let threshold = 50000 + (check + r * 7919) % 950001;
        check = (check * 131 + smallest_divisor(nums, threshold as i32)) % 1000000007;
    }
    println(f"150 rounds over 5 * 10^4 numbers: checksum {check}");
}
