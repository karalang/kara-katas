// LeetCode #1283: Find the Smallest Divisor Given a Threshold --
// differential test of the five arms against the statement read
// literally, with five more properties.

// ---- smallest_divisor.kara ----
fn a0_total(nums: Vec[i32], d: i64) -> i64 {
    let mut sum = 0;
    for x in nums.iter() {
        sum += (x + d - 1) / d;
    }
    sum
}

fn a0_smallest_divisor(nums: Vec[i32], threshold: i32) -> i32 {
    let mut lo = 1;
    let mut hi = nums.iter().max().unwrap() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if a0_total(nums, mid) <= threshold {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo as i32
}

// ---- smallest_divisor_float.kara ----
fn a1_smallest_divisor(nums: Vec[i32], threshold: i32) -> i32 {
    let mut lo: i32 = 1;
    let mut hi: i32 = 1000000;
    let mut best = hi;
    while lo <= hi {
        let mid = lo + (hi - lo) / 2;
        let sum: i64 = nums.iter().map(|x| (x as f64 / mid as f64).ceil() as i64).sum();
        if sum <= threshold {
            best = mid;
            hi = mid - 1;
        } else {
            lo = mid + 1;
        }
    }
    best
}

// ---- smallest_divisor_gallop.kara ----
fn a2_fits(nums: Vec[i32], d: i64, threshold: i32) -> bool {
    let mut sum = 0;
    for x in nums.iter() {
        sum += (x + d - 1) / d;
        if sum > threshold {
            return false;
        }
    }
    true
}

fn a2_smallest_divisor(nums: Vec[i32], threshold: i32) -> i32 {
    let mut total = 0;
    for x in nums.iter() {
        total += x as i64;
    }
    let start = ((total + threshold - 1) / threshold).max(1);
    if a2_fits(nums, start, threshold) {
        return start as i32;
    }
    // `lo` does not fit, `lo + step` is the next to try
    let mut lo = start;
    let mut step = 1;
    while not a2_fits(nums, lo + step, threshold) {
        lo += step;
        step *= 2;
    }
    let mut hi = lo + step;
    while hi - lo > 1 {
        let mid = (lo + hi) / 2;
        if a2_fits(nums, mid, threshold) {
            hi = mid;
        } else {
            lo = mid;
        }
    }
    hi as i32
}

// ---- smallest_divisor_recursive.kara ----
fn a3_search(nums: Vec[i32], threshold: i32, lo: i64, hi: i64) -> i64 {
    if lo == hi {
        return lo;
    }
    let mid = (lo + hi) / 2;
    let sum = nums.iter().fold(0, |s, x| s + (x + mid - 1) / mid);
    if sum <= threshold {
        a3_search(nums, threshold, lo, mid)
    } else {
        a3_search(nums, threshold, mid + 1, hi)
    }
}

fn a3_smallest_divisor(nums: Vec[i32], threshold: i32) -> i32 {
    let top = nums.iter().max().unwrap();
    a3_search(nums, threshold, 1, top) as i32
}

// ---- smallest_divisor_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_smallest_divisor(nums: Vec[i32], threshold: i32) -> i32 {
        let mut (left, right) = (1i32, *nums.iter().max().unwrap());
        while left < right {
            let mid = left + (right - left) / 2;
            let sum: i32 = nums.iter().map(|x| (x + mid - 1) / mid).sum();
            if sum > threshold {
                left = mid + 1;
            } else {
                right = mid;
            }
        }
        left
    }
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n numbers from 1 to `top`, each from two draws so they reach 10^6
fn drawn(n: i64, top: i64, seed: mut ref i64) -> Vec[i32] {
    (0..n).map(|_| (1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top) as i32).collect()
}

// the sum of every number divided by d and rounded up, each quotient the
// fewest copies of d that reach the number: the copies that fit in it,
// and one more when they fall short
fn rounded_sum(nums: Vec[i32], d: i64) -> i64 {
    let mut sum = 0;
    for x in nums.iter() {
        let mut q = x / d;
        if q * d < x {
            q += 1;
        }
        sum += q;
    }
    sum
}

// the statement read literally: try the divisors 1, 2, 3 and on, and
// answer the first whose rounded sum is within the threshold; the walk
// stops at 1000 and answers -1 when none up to there is
fn literal(nums: Vec[i32], threshold: i64) -> i64 {
    for d in 1..=1000 {
        if rounded_sum(nums, d) <= threshold {
            return d;
        }
    }
    -1
}

fn arm(i: i64, nums: Vec[i32], threshold: i64) -> i64 {
    let threshold = threshold as i32;
    let nums = nums.clone();
    match i {
        0 => a0_smallest_divisor(nums, threshold),
        1 => a1_smallest_divisor(nums, threshold),
        2 => a2_smallest_divisor(nums, threshold),
        3 => a3_smallest_divisor(nums, threshold),
        _ => A4Solution.a4_smallest_divisor(nums, threshold),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, nums: Vec[i32], threshold: i64) {
    t.cases += 1;
    let want = literal(nums, threshold);
    let star = arm(0, nums, threshold);
    t.check = (t.check * 131 + star) % 1000000007;
    t.check = (t.check * 131 + threshold) % 1000000007;
    let top = nums.iter().max().unwrap() as i64;
    let reversed: Vec[i32] = nums.iter().rev().collect();
    for i in 0..5 {
        let got = arm(i, nums, threshold);
        let what = f"arm {i} on {nums} within {threshold}";
        // P1: the statement read literally, or past 1000 when no divisor
        // up to 1000 fits
        let p1 = if want > 0 { got == want } else { got > 1000 };
        expect(mut t, 1, p1, f"P1 {what}: literal {want}, got {got}");
        // P2: the answer fits and the divisor one below it does not
        let fits = got >= 1 and rounded_sum(nums, got) <= threshold;
        let least = got == 1 or rounded_sum(nums, got - 1) > threshold;
        expect(mut t, 2, fits and least, f"P2 {what}: {got} is not the least that fits");
        // P3: the largest number always fits, so the answer is never past it
        expect(mut t, 3, got >= 1 and got <= top, f"P3 {what}: {got} past the largest {top}");
        // P4: a threshold one larger never needs a larger divisor
        if threshold < 1000000 {
            let looser = arm(i, nums, threshold + 1);
            expect(mut t, 4, looser <= got, f"P4 {what}: {looser} within {threshold + 1}");
        }
        // P5: the order of the numbers does not matter
        let back = arm(i, reversed, threshold);
        expect(mut t, 5, back == got, f"P5 {what}: {back} reversed");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // the edges: one number, the threshold at n, the largest numbers, and
    // a threshold far past the sum. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[(Vec[i32], i64)] = Vec.new();
    cases.push(([1], 1));
    cases.push(([1000000], 1));
    cases.push(([1000000], 1000000));
    cases.push(([1, 1, 1], 3));
    cases.push(([2, 3, 5], 3));
    cases.push(([1000000, 1], 2));
    cases.push(([999999, 1000000], 3));
    cases.push(([7, 7, 7, 7], 4));
    cases.push(([7, 7, 7, 7], 5));
    cases.push(([19, 3], 1000000));
    // 1993 random cases of 1 to 30 numbers up to 10, 1000 or 10^6, the
    // threshold n, from n to n + 100, or up to 10^6
    let mut seed = 12831;
    for i in 0..1993 {
        let n = 1 + next_random(mut seed) % 30;
        let top = if i % 3 == 0 { 10 } else if i % 3 == 1 { 1000 } else { 1000000 };
        let nums = drawn(n, top, mut seed);
        let threshold = if i % 7 == 0 {
            n
        } else if i % 2 == 0 {
            n + next_random(mut seed) % 101
        } else {
            n + next_random(mut seed) % (1000001 - n)
        };
        cases.push((nums, threshold));
    }
    for (nums, threshold) in cases.iter() {
        check_case(mut t, nums, threshold);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
