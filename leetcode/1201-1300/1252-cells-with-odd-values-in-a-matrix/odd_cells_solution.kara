// LeetCode #1252: Cells with Odd Values in a Matrix -- a Rust solution as
// LeetCode's Rust users write it, carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn odd_cells(m: i32, n: i32, indices: Vec[Vec[i32]]) -> i32 {
        let mut mat = Vec.filled(m, Vec.filled(n, 0));
        for idx in indices.iter() {
            let (r, c) = (idx[0] as usize, idx[1] as usize);
            for j in 0..n as usize {
                mat[r][j] += 1;
            }
            for i in 0..m as usize {
                mat[i][c] += 1;
            }
        }
        mat.iter().flat_map(|v| v.iter()).filter(|x| x % 2 == 1).count() as i32
    }
}

// The harness's matrix, handed over as LeetCode's `i32` and `Vec<Vec<i32>>`.
fn odd_cells(m: i64, n: i64, indices: Vec[Vec[i64]]) -> i64 {
    let rows = indices.iter().map(|p| p.iter().map(|x| x as i32).collect()).collect();
    Solution.odd_cells(m as i32, n as i32, rows)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `k` random places in an `m` by `n` matrix, as LeetCode's `[r, c]` pairs.
fn random_indices(m: i64, n: i64, k: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut indices = Vec.new();
    for _ in 0..k {
        let r = next_random(mut seed) % m;
        let c = next_random(mut seed) % n;
        indices.push([r, c]);
    }
    indices
}

fn main() {
    // LeetCode's two examples
    let a = odd_cells(2, 3, [[0, 1], [1, 1]]);
    let b = odd_cells(2, 2, [[1, 1], [0, 0]]);
    println(f"{a} {b}");
    // 1000 random matrices of 1 to 50 rows and columns, with 1 to 100 places
    let mut seed = 1252;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let m = next_random(mut seed) % 50 + 1;
        let n = next_random(mut seed) % 50 + 1;
        let k = next_random(mut seed) % 100 + 1;
        let indices = random_indices(m, n, k, mut seed);
        let odd = odd_cells(m, n, indices);
        total += odd;
        check = (check * 131 + odd) % 1000000007;
    }
    println(f"1000 random matrices: total {total}, checksum {check}");
    // the constraints' top: 50 by 50 with 99 or 100 places, the corner 99
    // times, row `i % 50` and column `i % 37` for `i` to 99, and the 50
    // places of row 0 with 49 of column 0
    let corner = Vec.filled(99, [0, 0]);
    let stripes: Vec[Vec[i64]] = (0..100).map(|i| [i % 50, i % 37]).collect();
    let edges: Vec[Vec[i64]] = (0..99).map(|i| if i < 50 { [0, i] } else { [i - 50, 0] }).collect();
    let x = odd_cells(50, 50, corner);
    let y = odd_cells(50, 50, stripes);
    let z = odd_cells(50, 50, edges);
    println(f"50 by 50: corner {x}, stripes {y}, edges {z}");
}
