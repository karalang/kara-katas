// LeetCode #1252 bench, in Kāra: the ★ arm (the matrix itself, every cell
// of each place's row and column raised by one, then the odd cells
// counted) on 1000 random lists of 100 places in a 50 by 50 matrix built
// once, each asked 40 times; every count folded into a checksum.

fn odd_cells(m: i64, n: i64, indices: Vec[Vec[i64]]) -> i64 {
    let mut matrix = Vec.filled(m, Vec.filled(n, 0));
    for place in indices {
        let r = place[0];
        let c = place[1];
        for j in 0..n {
            matrix[r][j] += 1;
        }
        for i in 0..m {
            matrix[i][c] += 1;
        }
    }
    let mut odd = 0;
    for row in matrix {
        for v in row {
            if v % 2 == 1 {
                odd += 1;
            }
        }
    }
    odd
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1252;
    let mut cases: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..1000 {
        let mut indices = Vec.new();
        for _ in 0..100 {
            let r = next_random(mut seed) % 50;
            let c = next_random(mut seed) % 50;
            indices.push([r, c]);
        }
        cases.push(indices);
    }
    let mut check = 0;
    for _ in 0..40 {
        for indices in cases.iter() {
            check = (check * 131 + odd_cells(50, 50, indices)) % 1000000007;
        }
    }
    println(f"40 rounds of 1000 lists of 100 places in 50 by 50: checksum {check}");
}
