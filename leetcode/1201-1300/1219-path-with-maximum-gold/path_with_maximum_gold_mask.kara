// LeetCode #1219: Path with Maximum Gold -- the gold cells numbered (at
// most 25), each with the list of its neighbours with gold; a path is
// grown cell by cell with the cells it holds as the bits of an `i64`, so
// the grid is never written.

fn extend(at: i64, held: i64, gold: Vec[i64], next: Vec[Vec[i64]]) -> i64 {
    let mut best = 0;
    for to in next[at].iter() {
        if (held >> to) & 1 == 0 {
            best = max(best, extend(to, held | (1 << to), gold, next));
        }
    }
    gold[at] + best
}

fn get_maximum_gold(grid: Vec[Vec[i64]]) -> i64 {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut number: Vec[Vec[i64]] = Vec.filled(rows, Vec.filled(cols, -1));
    let mut gold: Vec[i64] = Vec.new();
    for r in 0..rows {
        for c in 0..cols {
            if grid[r][c] > 0 {
                number[r][c] = gold.len();
                gold.push(grid[r][c]);
            }
        }
    }
    let mut next: Vec[Vec[i64]] = Vec.filled(gold.len(), Vec.new());
    for r in 0..rows {
        for c in 0..cols {
            let at = number[r][c];
            if at < 0 {
                continue;
            }
            if r + 1 < rows and number[r + 1][c] >= 0 {
                next[at].push(number[r + 1][c]);
                next[number[r + 1][c]].push(at);
            }
            if c + 1 < cols and number[r][c + 1] >= 0 {
                next[at].push(number[r][c + 1]);
                next[number[r][c + 1]].push(at);
            }
        }
    }
    let mut best = 0;
    for start in 0..gold.len() {
        best = max(best, extend(start, 1 << start, gold, next));
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases: Vec[Vec[Vec[i64]]] = [
        [[0, 6, 0], [5, 8, 7], [0, 9, 0]],
        [[1, 0, 7], [2, 0, 6], [3, 4, 5], [0, 3, 0], [9, 0, 20]],
        [[0]],
        [[5]],
        [[0, 0], [0, 0]],
        [[1, 1], [1, 1]],
        [[100, 0, 100], [0, 0, 0], [100, 0, 100]],
        [[1, 2, 3, 4, 5]],
    ];
    for grid in cases.iter() {
        println(f"{grid}: {get_maximum_gold(grid)}");
    }
    let mut seed = 1219;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let rows = next_random(mut seed) % 4 + 1;
        let cols = next_random(mut seed) % 4 + 1;
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..rows {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..cols {
                let v = next_random(mut seed) % 150;
                row.push(if v < 50 { 0 } else { v - 49 });
            }
            grid.push(row);
        }
        let answer = get_maximum_gold(grid);
        total += answer;
        check = (check * 131 + answer) % 1000000007;
    }
    println(f"1000 grids up to 4 by 4: gold total {total}, checksum {check}");
    // The constraints' top: 15 by 15, at most 25 cells with gold.
    let mut scattered: Vec[Vec[i64]] = Vec.filled(15, Vec.filled(15, 0));
    let mut placed = 0;
    while placed < 25 {
        let r = next_random(mut seed) % 15;
        let c = next_random(mut seed) % 15;
        if scattered[r][c] == 0 {
            scattered[r][c] = next_random(mut seed) % 100 + 1;
            placed += 1;
        }
    }
    println(f"25 cells with gold scattered over 15 by 15: {get_maximum_gold(scattered)}");
    let mut block: Vec[Vec[i64]] = Vec.filled(15, Vec.filled(15, 0));
    for r in 5..10 {
        for c in 5..10 {
            block[r][c] = next_random(mut seed) % 100 + 1;
        }
    }
    println(f"a full 5 by 5 block of gold in 15 by 15: {get_maximum_gold(block)}");
    let mut snake: Vec[Vec[i64]] = Vec.filled(15, Vec.filled(15, 0));
    for c in 0..15 {
        snake[0][c] = next_random(mut seed) % 100 + 1;
    }
    for r in 1..11 {
        snake[r][14] = next_random(mut seed) % 100 + 1;
    }
    println(f"25 cells of gold in one bent line: {get_maximum_gold(snake)}");
    let mut apart: Vec[Vec[i64]] = Vec.filled(15, Vec.filled(15, 0));
    for k in 0..25 {
        apart[(k / 5) * 3][(k % 5) * 3] = k + 1;
    }
    println(f"25 cells of gold, none next to another: {get_maximum_gold(apart)}");
}
