// LeetCode #1296 bench: the ★ arm (counts in a `SortedMap`, each count left
// at the smallest key starting that many sets) over 20 arrays of 16666 runs
// of 6 consecutive numbers, shuffled, built once; then 10 passes, each
// swapping two numbers of every array and choosing k from 1 to 6 from the
// checksum so far, answering it, and folding the answer into the checksum.

fn is_possible_divide(nums: Vec[i64], k: i64) -> bool {
    if nums.len() % k != 0 {
        return false;
    }
    let mut count: SortedMap[i64, i64] = SortedMap.new();
    for x in nums.iter() {
        *count.entry(x).or_insert(0) += 1;
    }
    let keys: Vec[i64] = count.keys().cloned().collect();
    for x in keys.iter() {
        let sets = count[x];
        if sets == 0 {
            continue;
        }
        for y in x..x + k {
            let have = count.get(y).cloned().unwrap_or(0);
            if have < sets {
                return false;
            }
            count.insert(y, have - sets);
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // starts up to 10^4 in even arrays, so runs overlap, and up to 10^9 in odd
    let mut seed = 1296;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for a in 0..20 {
        let spread = if a % 2 == 0 { 10000 } else { 1000000000 };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..16666 {
            let start = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % spread;
            for d in 0..6 {
                nums.push(start + d);
            }
        }
        let len = nums.len();
        for i in 0..len {
            let j = i + (next_random(mut seed) * 32768 + next_random(mut seed)) % (len - i);
            let held = nums[i];
            nums[i] = nums[j];
            nums[j] = held;
        }
        arrays.push(nums);
    }
    let mut check = 0;
    for p in 0..10 {
        for a in 0..arrays.len() {
            let len = arrays[a].len();
            let i = check % len;
            let j = (check / len) % len;
            let held = arrays[a][i];
            arrays[a][i] = arrays[a][j];
            arrays[a][j] = held;
            let k = 1 + check % 6;
            let possible = is_possible_divide(arrays[a], k);
            check = (check * 31 + (if possible { 2 } else { 1 }) + p) % 1000000007;
        }
    }
    println(f"10 passes over 20 arrays of 99996: checksum {check}");
}
