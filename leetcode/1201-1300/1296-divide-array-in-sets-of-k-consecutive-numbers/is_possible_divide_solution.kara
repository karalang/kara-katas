// LeetCode #1296: Divide Array in Sets of K Consecutive Numbers -- a Rust
// solution as LeetCode's Rust users write it (a `BTreeMap<i32, i32>` of
// counts filled by `*map.entry(x).or_insert(0) += 1`, then `while let
// Some((&first, _)) = map.iter().next()` taking one set at a time, each
// count lowered through `get_mut` and removed at 0), carried to Kāra by
// `karac fix`.

struct Solution {}

impl Solution {
    pub fn is_possible_divide(nums: Vec[i32], k: i32) -> bool {
        if nums.len() % k != 0 {
            return false;
        }
        let mut map = SortedMap.new();
        for x in ref nums {
            *map.entry(x).or_insert(0) += 1;
        }
        while let Some((first, _)) = map.iter().next() {
            for v in first..first + k {
                match map.get_mut(v) {
                    Some(c) => {
                        *c -= 1;
                        if *c == 0 {
                            map.remove(v);
                        }
                    }
                    None => return false,
                }
            }
        }
        true
    }
}

fn is_possible_divide(nums: Vec[i64], k: i64) -> bool {
    Solution.is_possible_divide(nums.iter().map(|x| x as i32).collect(), k as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// runs of k consecutive numbers from random starts, shuffled; then, half the
// time, one number moved by one, which may or may not break the division
fn problem(seed: mut ref i64, groups: i64, k: i64, spread: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..groups {
        let start = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % spread;
        for d in 0..k {
            nums.push(start + d);
        }
    }
    let len = nums.len();
    for i in 0..len {
        let j = i + next_random(mut seed) % (len - i);
        let held = nums[i];
        nums[i] = nums[j];
        nums[j] = held;
    }
    if next_random(mut seed) % 2 == 0 {
        let i = next_random(mut seed) % len;
        nums[i] = if nums[i] > 1 and next_random(mut seed) % 2 == 0 { nums[i] - 1 } else { nums[i] + 1 };
    }
    nums
}

fn main() {
    // LeetCode's examples, k of 1, k of the whole array, and a run that
    // would fit if one number were not missing
    println(f"{is_possible_divide([1, 2, 3, 3, 4, 4, 5, 6], 4)} {is_possible_divide([3, 2, 1, 2, 3, 4, 3, 4, 5, 9, 10, 11], 3)} {is_possible_divide([1, 2, 3, 4], 3)} {is_possible_divide([5, 5, 7], 1)} {is_possible_divide([4, 2, 3, 1], 4)} {is_possible_divide([1, 2, 4, 5], 2)} {is_possible_divide([1, 2, 2, 3, 3, 4], 3)}");
    // random arrays of up to 40 groups of up to 8, starts spread over a
    // range that makes the groups overlap more or less often
    let mut seed = 1296;
    let mut yes = 0;
    let mut check = 0;
    for case in 0..3000 {
        let k = 1 + next_random(mut seed) % 8;
        let groups = 1 + next_random(mut seed) % 40;
        let spread = [10, 100, 1000000000][case % 3];
        let nums = problem(mut seed, groups, k, spread);
        let possible = is_possible_divide(nums, k);
        if possible {
            yes += 1;
        }
        check = (check * 131 + (if possible { 2 } else { 1 })) % 1000000007;
    }
    println(f"3000 random arrays: {yes} divide, checksum {check}");
}
