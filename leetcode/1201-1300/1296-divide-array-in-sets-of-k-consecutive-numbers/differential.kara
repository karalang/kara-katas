// LeetCode #1296: Divide Array in Sets of K Consecutive Numbers --
// differential test of the five arms against the statement read literally,
// with five more properties.
//
// The statement: given an array of integers nums and a positive integer k,
// check whether it is possible to divide this array into sets of k
// consecutive numbers.

// ---- is_possible_divide.kara ----
fn a0_is_possible_divide(nums: Vec[i64], k: i64) -> bool {
    if nums.len() % k != 0 {
        return false;
    }
    let mut count: SortedMap[i64, i64] = SortedMap.new();
    for x in nums.iter() {
        *count.entry(x).or_insert(0) += 1;
    }
    let keys: Vec[i64] = count.keys().cloned().collect();
    for x in keys.iter() {
        let sets = count[x];
        if sets == 0 {
            continue;
        }
        for y in x..x + k {
            let have = count.get(y).cloned().unwrap_or(0);
            if have < sets {
                return false;
            }
            count.insert(y, have - sets);
        }
    }
    true
}

// ---- is_possible_divide_sort.kara ----
fn a1_is_possible_divide(nums: Vec[i64], k: i64) -> bool {
    if nums.len() % k != 0 {
        return false;
    }
    let mut sorted = nums.clone();
    sorted.sort();
    let mut count: Map[i64, i64] = Map.new();
    for x in sorted.iter() {
        count[x] = count.get(x).cloned().unwrap_or(0) + 1;
    }
    for x in sorted.iter() {
        if count[x] == 0 {
            continue;
        }
        for y in x..x + k {
            match count.get(y).cloned() {
                Some(c) if c > 0 => count[y] = c - 1,
                _ => return false,
            }
        }
    }
    true
}

// ---- is_possible_divide_heap.kara ----
fn a2_is_possible_divide(nums: Vec[i64], k: i64) -> bool {
    if nums.len() % k != 0 {
        return false;
    }
    let mut heap: PriorityQueue[i64] = PriorityQueue.from(nums.clone());
    while let Some(start) = heap.pop() {
        let mut want = start + 1;
        let mut aside: Vec[i64] = Vec.new();
        while want < start + k {
            match heap.pop() {
                Some(x) if x == want => want += 1,
                Some(x) if x == want - 1 => aside.push(x),
                _ => return false,
            }
        }
        for x in aside.iter() {
            heap.push(x);
        }
    }
    true
}

// ---- is_possible_divide_open.kara ----
fn a3_is_possible_divide(nums: Vec[i64], k: i64) -> bool {
    if nums.len() % k != 0 {
        return false;
    }
    let mut sorted = nums.clone();
    sorted.sort();
    // the distinct numbers with their counts, in order
    let mut runs: Vec[(i64, i64)] = Vec.new();
    for x in sorted.iter() {
        if runs.len() > 0 and runs[runs.len() - 1].0 == x {
            runs[runs.len() - 1].1 += 1;
        } else {
            runs.push((x, 1));
        }
    }
    // sets opened at each of the last k numbers; `open` is their sum
    let mut opened: VecDeque[i64] = VecDeque.new();
    let mut open = 0;
    let mut previous = -1;
    for (x, c) in runs.iter() {
        if open > 0 and x != previous + 1 {
            return false;
        }
        if open > c {
            return false;
        }
        opened.push_back(c - open);
        open = c;
        if opened.len() == k {
            open -= opened.pop_front().unwrap();
        }
        previous = x;
    }
    open == 0
}

// ---- is_possible_divide_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn is_possible_divide(nums: Vec[i32], k: i32) -> bool {
        if nums.len() % k != 0 {
            return false;
        }
        let mut map = SortedMap.new();
        for x in ref nums {
            *map.entry(x).or_insert(0) += 1;
        }
        while let Some((first, _)) = map.iter().next() {
            for v in first..first + k {
                match map.get_mut(v) {
                    Some(c) => {
                        *c -= 1;
                        if *c == 0 {
                            map.remove(v);
                        }
                    }
                    None => return false,
                }
            }
        }
        true
    }
}

fn a4_is_possible_divide(nums: Vec[i64], k: i64) -> bool {
    A4Solution.is_possible_divide(nums.iter().map(|x| x as i32).collect(), k as i32)
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(w: i64, nums: Vec[i64], k: i64) -> bool {
    match w {
        0 => a0_is_possible_divide(nums, k),
        1 => a1_is_possible_divide(nums, k),
        2 => a2_is_possible_divide(nums, k),
        3 => a3_is_possible_divide(nums, k),
        _ => a4_is_possible_divide(nums, k),
    }
}

// The statement read literally: the first number not yet in a set goes
// into some set of k consecutive numbers that contains it, starting
// anywhere from k - 1 below it to itself, made of numbers not yet in a
// set; every such choice is tried, and the division is possible when one
// of them leaves every number in a set.
fn divide(nums: Vec[i64], k: i64, used: mut ref Vec[bool]) -> bool {
    let mut first = -1;
    for i in 0..nums.len() {
        if not used[i] {
            first = i;
            break;
        }
    }
    if first < 0 {
        return true;
    }
    let x = nums[first];
    for start in x - k + 1..x + 1 {
        // take start, start + 1, ..., start + k - 1, each from an unused place
        let mut taken: Vec[i64] = Vec.new();
        for v in start..start + k {
            let mut found = -1;
            for i in 0..nums.len() {
                if not used[i] and nums[i] == v {
                    found = i;
                    // the first number itself goes in its own set
                    if v == x {
                        found = first;
                    }
                    break;
                }
            }
            if found < 0 {
                break;
            }
            used[found] = true;
            taken.push(found);
        }
        if taken.len() == k and divide(nums, k, mut used) {
            return true;
        }
        for i in taken.iter() {
            used[i] = false;
        }
    }
    false
}

fn literal(nums: Vec[i64], k: i64) -> bool {
    let mut used: Vec[bool] = Vec.filled(nums.len(), false);
    divide(nums, k, mut used)
}

struct Case {
    nums: Vec[i64],
    k: i64,
    // P3's shift, P5's run start
    shift: i64,
    run: i64,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, c: Case) {
    let nums = ref c.nums;
    let reversed: Vec[i64] = nums.iter().rev().cloned().collect();
    let shifted: Vec[i64] = nums.iter().map(|x| x + c.shift).collect();
    let mut top = 0;
    for x in nums.iter() {
        if x > top {
            top = x;
        }
    }
    let mirrored: Vec[i64] = nums.iter().map(|x| top + 1 - x).collect();
    let mut extended = nums.clone();
    for d in 0..c.k {
        extended.push(c.run + d);
    }
    let want = literal(nums, c.k);
    let star = arm(0, nums, c.k);
    for a in 0..5 {
        let got = arm(a, nums, c.k);
        let what = f"arm {a}, case {t.cases} {nums} k {c.k} -> {got}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}, literal {want}");
        // P2: the array reversed, the same answer
        let rv = arm(a, reversed, c.k);
        expect(mut t, 2, rv == got, f"P2 {what}, reversed: {rv}");
        // P3: every number moved up by the same amount, the same answer
        let sh = arm(a, shifted, c.k);
        expect(mut t, 3, sh == got, f"P3 {what}, shifted by {c.shift}: {sh}");
        // P4: every number mirrored, x to top + 1 - x, the same answer
        let mr = arm(a, mirrored, c.k);
        expect(mut t, 4, mr == got, f"P4 {what}, mirrored: {mr}");
        // P5: one more run of k consecutive numbers, the same answer
        let ex = arm(a, extended, c.k);
        expect(mut t, 5, ex == got, f"P5 {what}, with {c.k} from {c.run}: {ex}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
    t.cases += 1;
    t.check = (t.check * 131 + (if want { 2 } else { 1 })) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 arrays of up to 12 numbers in four kinds, 500 each: runs of k from
    // starts within 6, shuffled; the same with one number moved by one;
    // any numbers up to 8; and runs whose length is not a multiple of k.
    // Every array, k, shift and run is drawn before any arm answers.
    let mut seed = 12961;
    let mut cases: Vec[Case] = Vec.new();
    for i in 0..2000 {
        let kind = i % 4;
        let k = 1 + next_random(mut seed) % 4;
        let mut nums: Vec[i64] = Vec.new();
        if kind == 2 {
            let len = 1 + next_random(mut seed) % 12;
            for _ in 0..len {
                nums.push(1 + next_random(mut seed) % 8);
            }
        } else {
            let groups = 1 + next_random(mut seed) % (12 / k);
            for _ in 0..groups {
                let start = 1 + next_random(mut seed) % 6;
                for d in 0..k {
                    nums.push(start + d);
                }
            }
            if kind == 3 {
                nums.push(1 + next_random(mut seed) % 8);
            }
            let len = nums.len();
            for p in 0..len {
                let q = p + next_random(mut seed) % (len - p);
                let held = nums[p];
                nums[p] = nums[q];
                nums[q] = held;
            }
            if kind == 1 {
                let p = next_random(mut seed) % len;
                nums[p] = if nums[p] > 1 and next_random(mut seed) % 2 == 0 { nums[p] - 1 } else { nums[p] + 1 };
            }
        }
        let shift = 1 + next_random(mut seed) % 1000;
        let run = 1 + next_random(mut seed) % 10;
        cases.push(Case { nums, k, shift, run });
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} arrays: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
