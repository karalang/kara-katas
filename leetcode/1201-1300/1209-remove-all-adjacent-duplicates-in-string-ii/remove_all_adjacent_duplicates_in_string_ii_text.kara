// LeetCode #1209: Remove All Adjacent Duplicates in String II -- the
// answer itself the stack: each letter pushed onto a `String`, and beside
// it a `Vec` of how many times the last letter has come in a row; a count
// that reaches `k` truncates the string by `k` letters and drops the
// count. O(n).

fn remove_duplicates(s: String, k: i64) -> String {
    let mut out = String.with_capacity(s.len());
    let mut streak: Vec[i64] = Vec.new();
    for c in s.chars() {
        let run = if out.ends_with(c.to_string()) { streak[streak.len() - 1] + 1 } else { 1 };
        out.push(c);
        streak.push(run);
        if run == k {
            out.truncate(out.len() - k);
            streak.truncate(streak.len() - k);
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_text(seed: mut ref i64, n: i64, letters: i64) -> String {
    let mut out = String.with_capacity(n);
    for _ in 0..n {
        out.push((b'a' + next_random(mut seed) % letters) as u8 as char);
    }
    out
}

fn digest(s: String) -> i64 {
    let mut h = 0;
    for b in s.bytes().iter() {
        h = (h * 131 + (b as i64)) % 1000000007;
    }
    h
}

fn main() {
    let cases: Vec[(String, i64)] = [
        ("abcd", 2),
        ("deeedbbcccbdaa", 3),
        ("pbbcggttciiippooaais", 2),
        ("aaa", 4),
        ("aaaa", 2),
        ("aaaaa", 2),
        ("yfttttfbbbbnnnnffbgffffgbbbbgssssgthyyyy", 4),
        ("abccbaabccba", 2),
    ];
    for (s, k) in cases.iter() {
        println(f"{s} {k}: \"{remove_duplicates(s, k)}\"");
    }
    let mut seed = 1209;
    let mut changed = 0;
    let mut left = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 20 + 1;
        let letters = next_random(mut seed) % 2 + 2;
        let k = next_random(mut seed) % 3 + 2;
        let s = random_text(mut seed, n, letters);
        let answer = remove_duplicates(s, k);
        if answer != s {
            changed += 1;
        }
        left += answer.len();
        check = (check * 131 + digest(answer) + answer.len()) % 1000000007;
    }
    println(f"1000 small cases: {changed} changed, {left} letters left, checksum {check}");
    // The constraints' top: 100000 letters, k from 2 to 10000.
    let s = random_text(mut seed, 100000, 2);
    let answer = remove_duplicates(s, 2);
    println(f"100000 random a and b, k 2: {answer.len()} left, digest {digest(answer)}");
    let s = random_text(mut seed, 100000, 3);
    let answer = remove_duplicates(s, 3);
    println(f"100000 random a, b and c, k 3: {answer.len()} left, digest {digest(answer)}");
    // 50000 letters and the same reversed: every pair at the middle goes,
    // and the next pair meets
    let half = random_text(mut seed, 50000, 26);
    let mirror: String = half.chars().rev().collect();
    let answer = remove_duplicates(f"{half}{mirror}", 2);
    println(f"50000 letters and their reverse, k 2: {answer.len()} left");
    // 3000 c, 5000 b, 10000 a, 5000 b, 7001 c: the a go, the b meet and
    // make 10000 and go, and the c meet and make 10001
    let mut s = String.new();
    for (c, n) in [('c', 3000), ('b', 5000), ('a', 10000), ('b', 5000), ('c', 7001)] {
        for _ in 0..n {
            s.push(c);
        }
    }
    let answer = remove_duplicates(s, 10000);
    println(f"runs of c, b, a, b, c, k 10000: \"{answer}\"");
}
