// LeetCode #1207: Unique Number of Occurrences -- a Rust solution as
// LeetCode's Rust users write it: the counts in a `HashMap` by
// `*freq.entry(x).or_insert(0) += 1`, and `freq.values().all(|&c|
// seen.insert(c))` over a `HashSet`, whose `insert` answers false for a
// count already in it, carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn unique_occurrences(arr: Vec[i32]) -> bool {
        let mut freq: Map[i32, i32] = Map.new();
        for x in arr.iter() {
            *freq.entry(x).or_insert(0) += 1;
        }
        let mut seen = Set.new();
        freq.values().all(|c| seen.insert(c))
    }
}

fn unique_occurrences(arr: Vec[i64]) -> bool {
    Solution.unique_occurrences(arr.iter().map(|v| v as i32).collect())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases: Vec[Vec[i64]] = [
        [1, 2, 2, 1, 1, 3],
        [1, 2],
        [-3, 0, 1, -3, 1, 1, 1, -3, 10, 0],
        [7],
        [-1000, 1000, 1000],
        [5, 5, 5, 5],
        [1, 1, 2, 2],
        [1, 2, 2, 3, 3, 3, 4, 4, 4, 4],
    ];
    for arr in cases.iter() {
        println(f"{arr}: {unique_occurrences(arr)}");
    }
    let mut seed = 1207;
    let mut yes = 0;
    let mut check = 0;
    for k in 0..1000 {
        // 1 to 30 values from 1 to 6 distinct ones near 0
        let n = next_random(mut seed) % 30 + 1;
        let spread = next_random(mut seed) % 6 + 1;
        let arr: Vec[i64] = (0..n).map(|_| next_random(mut seed) % spread - 3).collect();
        let answer = unique_occurrences(arr);
        if answer {
            yes += 1;
        }
        check = (check * 131 + if answer { 2 } else { 1 } + k % 7) % 1000000007;
    }
    println(f"1000 small cases: {yes} true, checksum {check}");
    // The constraints' top, 1000 values: v given v times for v from 1 to
    // 43 (946 values) and -1000 given 54 times.
    let mut big: Vec[i64] = Vec.new();
    for v in 1..=43 {
        for _ in 0..v {
            big.push(v);
        }
    }
    for _ in 0..54 {
        big.push(-1000);
    }
    println(f"1000 values, counts 1 to 43 and 54: {unique_occurrences(big)}");
    // One -1000 made a 1: the 1s now come twice, as the 2s do.
    big[999] = 1;
    println(f"the same with one -1000 made a 1: {unique_occurrences(big)}");
    let distinct: Vec[i64] = (0..1000).map(|i| i * 2 - 1000).collect();
    println(f"1000 distinct values: {unique_occurrences(distinct)}");
}
