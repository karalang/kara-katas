// LeetCode #1207: Unique Number of Occurrences -- the six arms against the
// statement read literally and six more properties.
// Generated from the arms; see the README.

// ---- arm 0: star --------------------------------------------------------
fn a0_unique_occurrences(arr: Vec[i64]) -> bool {
    let mut counts: Map[i64, i64] = Map.new();
    for v in arr.iter() {
        *counts.entry(v).or_insert(0) += 1;
    }
    let distinct: Set[i64] = counts.values().collect();
    distinct.len() == counts.len()
}

// ---- arm 1: runs --------------------------------------------------------
fn a1_unique_occurrences(arr: Vec[i64]) -> bool {
    let mut sorted = arr.clone();
    sorted.sort();
    let mut lengths = Vec.new();
    let mut start = 0;
    for i in 1..=sorted.len() {
        if i == sorted.len() or sorted[i] != sorted[i - 1] {
            lengths.push(i - start);
            start = i;
        }
    }
    lengths.sort();
    (1..lengths.len()).all(|i| lengths[i] != lengths[i - 1])
}

// ---- arm 2: table -------------------------------------------------------
fn a2_unique_occurrences(arr: Vec[i64]) -> bool {
    let mut counts = [0; 2001];
    for v in arr.iter() {
        counts[v + 1000] += 1;
    }
    let mut seen = [false; 1001];
    for c in counts.iter() {
        if c > 0 {
            if seen[c] {
                return false;
            }
            seen[c] = true;
        }
    }
    true
}

// ---- arm 3: owners ------------------------------------------------------
fn a3_unique_occurrences(arr: Vec[i64]) -> bool {
    let mut counts: SortedMap[i64, i64] = SortedMap.new();
    for v in arr.iter() {
        *counts.entry(v).or_insert(0) += 1;
    }
    let mut owners: SortedMap[i64, i64] = SortedMap.new();
    for (_, c) in counts.iter() {
        *owners.entry(c).or_insert(0) += 1;
    }
    owners.values().all(|n| n == 1)
}

// ---- arm 4: sets --------------------------------------------------------
struct A4Solution {}

impl A4Solution {
    pub fn unique_occurrences(arr: Vec[i32]) -> bool {
        let mut freq: Map[i32, i32] = Map.new();
        for x in arr.iter() {
            *freq.entry(x).or_insert(0) += 1;
        }
        let mut seen = Set.new();
        freq.values().all(|c| seen.insert(c))
    }
}

fn a4_unique_occurrences(arr: Vec[i64]) -> bool {
    A4Solution.unique_occurrences(arr.iter().map(|v| v as i32).collect())
}

// ---- arm 5: chunks ------------------------------------------------------
struct A5Solution {}

impl A5Solution {
    pub fn unique_occurrences(arr: own Vec[i32]) -> bool {
        let mut arr = arr;
        arr.sort();
        let mut counts: Vec[i64] = arr.chunk_by(|a, b| a == b).into_iter().map(|c| c.len()).collect();
        let n = counts.len();
        counts.sort();
        counts.dedup();
        counts.len() == n
    }
}

fn a5_unique_occurrences(arr: Vec[i64]) -> bool {
    A5Solution.unique_occurrences(arr.iter().map(|v| v as i32).collect())
}

// ---- the statement read literally -----------------------------------------

// For every two values that differ, each one's count by a walk over the
// whole array, and the two counts compared.
fn literal(arr: Vec[i64]) -> bool {
    let count = |x: i64| arr.iter().filter(|v| v == x).count();
    for i in 0..arr.len() {
        for j in 0..arr.len() {
            if arr[i] != arr[j] and count(arr[i]) == count(arr[j]) {
                return false;
            }
        }
    }
    true
}

// ---- the differential -----------------------------------------------------

fn arms(arr: Vec[i64]) -> Vec[bool] {
    [a0_unique_occurrences(arr), a1_unique_occurrences(arr), a2_unique_occurrences(arr), a3_unique_occurrences(arr), a4_unique_occurrences(arr), a5_unique_occurrences(arr)]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["the statement read literally", "the array reversed gives the same", "every value negated gives the same", "the array given twice over gives the same", "a value not in the array, added once, gives true just when the array did and no value came once", "every copy of one value taken out keeps a true answer true", "the ★ arm's answer"];
    let mut fails = Vec.filled(7, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 1207;
    for _ in 0..2000 {
        // 1 to 24 values from 1 to 5 distinct ones near 0
        let n = next_random(mut seed) % 24 + 1;
        let spread = next_random(mut seed) % 5 + 1;
        let arr: Vec[i64] = (0..n).map(|_| next_random(mut seed) % spread - 2).collect();
        let got = arms(arr);
        let want = literal(arr);
        let mut reversed = arr.clone();
        reversed.reverse();
        let back = arms(reversed);
        let negated: Vec[i64] = arr.iter().map(|v| -v).collect();
        let neg = arms(negated);
        let mut twice = arr.clone();
        twice.extend_from_slice(arr);
        let doubled = arms(twice);
        let mut fresh = arr.clone();
        fresh.push(1000);
        let added = arms(fresh);
        let once = arr.iter().any(|x| arr.iter().filter(|v| v == x).count() == 1);
        let gone: Vec[i64] = arr.iter().filter(|v| v != arr[0]).cloned().collect();
        let less = arms(gone);
        for k in 0..6 {
            let a = got[k];
            let held = [
                a == want,
                back[k] == a,
                neg[k] == a,
                doubled[k] == a,
                added[k] == (want and not once),
                not want or less[k],
                a == got[0],
            ];
            for p in 0..7 {
                checks += 1;
                if not held[p] {
                    fails[p] += 1;
                    if fails[p] <= 2 {
                        println(f"P{p + 1} ({names[p]}) fails on arm {k}: {arr} -> {a}");
                    }
                }
            }
        }
        check = (check * 131 + if want { 2 } else { 1 }) % 1000000007;
        check = (check * 131 + n) % 1000000007;
    }
    for p in 0..7 {
        if fails[p] > 0 {
            println(f"P{p + 1}: {fails[p]} failures");
        }
    }
    let total = fails.iter().sum();
    println(f"2000 cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
}
