// LeetCode #1240: Tiling a Rectangle with the Fewest Squares -- the
// benchmark: the ★ arm (backtracking on the skyline) on every rectangle up
// to 13 x 13, 200 passes; prints the total of the answers and a checksum.

fn fill(heights: mut ref Vec[i64], n: i64, count: i64, best: mut ref i64) {
    if count >= *best {
        return;
    }
    let mut at = 0;
    for j in 1..heights.len() {
        if heights[j] < heights[at] {
            at = j;
        }
    }
    let base = heights[at];
    if base == n {
        *best = count;
        return;
    }
    let mut width = 0;
    while at + width < heights.len() and heights[at + width] == base and width < n - base {
        width += 1;
    }
    for size in (1..=width).rev() {
        for j in at..at + size {
            heights[j] = base + size;
        }
        fill(mut heights, n, count + 1, mut best);
        for j in at..at + size {
            heights[j] = base;
        }
    }
}

fn tiling_rectangle(n: i64, m: i64) -> i64 {
    let mut heights = Vec.filled(m, 0);
    let mut best = n * m;
    fill(mut heights, n, 0, mut best);
    best
}

fn main() {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..200 {
        for n in 1..=13 {
            for m in 1..=13 {
                let t = tiling_rectangle(n, m);
                total += t;
                check = (check * 131 + t) % 1000000007;
            }
        }
    }
    println(f"169 rectangles, 200 passes: total {total}, checksum {check}");
}
