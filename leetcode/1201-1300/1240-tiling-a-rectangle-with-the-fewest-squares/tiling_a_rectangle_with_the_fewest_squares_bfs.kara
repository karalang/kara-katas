// LeetCode #1240: Tiling a Rectangle with the Fewest Squares -- breadth
// first over skylines: the heights of the m columns filled so far. Every
// skyline at one level grows by one square at its lowest column (the
// leftmost of them), of every size that fits, and a skyline seen before is
// not queued again. The level at which every column is full is the answer.

fn tiling_rectangle(n: i64, m: i64) -> i64 {
    let start: Vec[i64] = Vec.filled(m, 0);
    let mut seen: Set[Vec[i64]] = Set.new();
    seen.insert(start.clone());
    let mut level: Vec[Vec[i64]] = [start];
    let mut steps = 0;
    loop {
        let mut next = Vec.new();
        for heights in level.iter() {
            let low = heights.iter().min().unwrap();
            if low == n {
                return steps;
            }
            let at = heights.iter().position(|h| h == low).unwrap();
            let mut width = 0;
            while at + width < m and heights[at + width] == low and width < n - low {
                width += 1;
            }
            for size in 1..=width {
                let mut grown = heights.clone();
                for j in at..at + size {
                    grown[j] = low + size;
                }
                if seen.insert(grown.clone()) {
                    next.push(grown);
                }
            }
        }
        level = next;
        steps += 1;
    }
}


// ---- test harness ---------------------------------------------------------

fn row(n: i64) -> String {
    let answers: Vec[String] = (1..=13).map(|m| f"{tiling_rectangle(n, m)}").collect();
    answers.join(" ")
}

fn main() {
    // LeetCode's three examples
    println(f"{tiling_rectangle(2, 3)}");
    println(f"{tiling_rectangle(5, 8)}");
    println(f"{tiling_rectangle(11, 13)}");
    // the smallest, the largest square, and the longest strip
    println(f"{tiling_rectangle(1, 1)} {tiling_rectangle(13, 13)} {tiling_rectangle(1, 13)} {tiling_rectangle(13, 1)}");
    // two rows of the table: 11 x 1..13 and 13 x 1..13
    println(f"11 x 1..13: {row(11)}");
    println(f"13 x 1..13: {row(13)}");
    // every rectangle up to 13 x 13
    let mut check = 0;
    let mut total = 0;
    for n in 1..=13 {
        for m in 1..=13 {
            let t = tiling_rectangle(n, m);
            check = (check * 131 + t) % 1000000007;
            total += t;
        }
    }
    println(f"169 rectangles: checksum {check}, total {total}");
}
