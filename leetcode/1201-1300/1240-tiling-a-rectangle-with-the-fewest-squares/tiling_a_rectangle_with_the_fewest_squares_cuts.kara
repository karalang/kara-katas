// LeetCode #1240: Tiling a Rectangle with the Fewest Squares -- the
// guillotine cuts, memoised: a square is one, and any other rectangle is
// the best of every straight cut across it into two smaller ones. A tiling
// with no straight cut through it is missed, and up to 13 x 13 only one
// rectangle needs one, 11 x 13 (6 squares, against 8 by cuts), so it is
// taken as known, as LeetCode solutions of this kind do.

fn best_cut(memo: mut ref Vec[Vec[i64]], n: i64, m: i64) -> i64 {
    if n == m {
        return 1;
    }
    if memo[n][m] > 0 {
        return memo[n][m];
    }
    let mut best = n * m;
    for i in 1..=n / 2 {
        best = best.min(best_cut(mut memo, i, m) + best_cut(mut memo, n - i, m));
    }
    for j in 1..=m / 2 {
        best = best.min(best_cut(mut memo, n, j) + best_cut(mut memo, n, m - j));
    }
    memo[n][m] = best;
    best
}

fn tiling_rectangle(n: i64, m: i64) -> i64 {
    if (n == 11 and m == 13) or (n == 13 and m == 11) {
        return 6;
    }
    let mut memo = Vec.filled(n + 1, Vec.filled(m + 1, 0));
    best_cut(mut memo, n, m)
}


// ---- test harness ---------------------------------------------------------

fn row(n: i64) -> String {
    let answers: Vec[String] = (1..=13).map(|m| f"{tiling_rectangle(n, m)}").collect();
    answers.join(" ")
}

fn main() {
    // LeetCode's three examples
    println(f"{tiling_rectangle(2, 3)}");
    println(f"{tiling_rectangle(5, 8)}");
    println(f"{tiling_rectangle(11, 13)}");
    // the smallest, the largest square, and the longest strip
    println(f"{tiling_rectangle(1, 1)} {tiling_rectangle(13, 13)} {tiling_rectangle(1, 13)} {tiling_rectangle(13, 1)}");
    // two rows of the table: 11 x 1..13 and 13 x 1..13
    println(f"11 x 1..13: {row(11)}");
    println(f"13 x 1..13: {row(13)}");
    // every rectangle up to 13 x 13
    let mut check = 0;
    let mut total = 0;
    for n in 1..=13 {
        for m in 1..=13 {
            let t = tiling_rectangle(n, m);
            check = (check * 131 + t) % 1000000007;
            total += t;
        }
    }
    println(f"169 rectangles: checksum {check}, total {total}");
}
