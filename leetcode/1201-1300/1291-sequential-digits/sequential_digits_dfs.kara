// LeetCode #1291: Sequential Digits -- the depth-first arm: from each first
// digit the number grows a digit at a time while it stays within `high`,
// every one in the range kept; the depth-first order is by first digit, not
// by size, so the found numbers are sorted at the end. O(1)

fn extend(x: i64, low: i64, high: i64, found: mut ref Vec[i64]) {
    if x > high {
        return;
    }
    if x >= low {
        found.push(x);
    }
    let last = x % 10;
    if last < 9 {
        extend(x * 10 + last + 1, low, high, mut found);
    }
}

fn sequential_digits(low: i64, high: i64) -> Vec[i64] {
    let mut found: Vec[i64] = Vec.new();
    for d in 1..10 {
        extend(d, low, high, mut found);
    }
    found.sort();
    found
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn show(low: i64, high: i64) {
    let found = sequential_digits(low, high);
    let parts: Vec[String] = found.iter().map(|x| f"{x}").collect();
    println(f"low = {low}, high = {high} -> [{parts.join(", ")}]");
}

fn main() {
    // LeetCode's examples, the whole range, and ranges at the edges
    show(100, 300);
    show(1000, 13000);
    show(10, 1000000000);
    show(10, 11);
    show(12, 12);
    show(58, 155);
    show(123456789, 1000000000);
    show(123456790, 1000000000);
    // random ranges: a third anywhere, two thirds from a random power of ten
    // for a random number of digits
    let mut seed = 1291;
    let mut count = 0;
    let mut check = 0;
    for k in 0..20000 {
        let (low, high) = if k % 3 == 0 {
            let low = 10 + wide_random(mut seed) % 999999991;
            (low, low + wide_random(mut seed) % (1000000001 - low))
        } else {
            let mut base = 10;
            for _ in 0..next_random(mut seed) % 8 {
                base *= 10;
            }
            let mut span = 1;
            for _ in 0..next_random(mut seed) % 10 {
                span *= 10;
            }
            let low = base + wide_random(mut seed) % (9 * base);
            let high = low + wide_random(mut seed) % span;
            (low, if high > 1000000000 { 1000000000 } else { high })
        };
        let found = sequential_digits(low, high);
        count += found.len();
        for x in found.iter() {
            check = (check * 131 + x) % 1000000007;
        }
        check = (check * 7 + found.len()) % 1000000007;
    }
    println(f"20000 random ranges: {count} numbers, checksum {check}");
}
