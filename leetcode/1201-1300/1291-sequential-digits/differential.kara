// LeetCode #1291: Sequential Digits -- differential test of the seven arms
// against the statement read literally, with five more properties.
//
// The statement: an integer has sequential digits if and only if each digit
// in the number is one more than the previous digit. Return a sorted list of
// all the integers in the range [low, high] inclusive that have sequential
// digits.

// ---- sequential_digits.kara ----
fn a0_sequential_digits(low: i64, high: i64) -> Vec[i64] {
    let mut found: Vec[i64] = Vec.new();
    for len in 2..10 {
        for first in 1..11 - len {
            let mut x = 0;
            for d in first..first + len {
                x = x * 10 + d;
            }
            if x >= low and x <= high {
                found.push(x);
            }
        }
    }
    found
}

// ---- sequential_digits_queue.kara ----
fn a1_sequential_digits(low: i64, high: i64) -> Vec[i64] {
    let mut queue: VecDeque[i64] = VecDeque.new();
    for d in 1..10 {
        queue.push_back(d);
    }
    let mut found: Vec[i64] = Vec.new();
    while let Some(x) = queue.pop_front() {
        if x > high {
            break;
        }
        if x >= low {
            found.push(x);
        }
        let last = x % 10;
        if last < 9 {
            queue.push_back(x * 10 + last + 1);
        }
    }
    found
}

// ---- sequential_digits_window.kara ----
fn a2_sequential_digits(low: i64, high: i64) -> Vec[i64] {
    let digits = "123456789";
    let shortest = f"{low}".len();
    let longest = f"{high}".len();
    let mut found: Vec[i64] = Vec.new();
    for len in shortest..longest + 1 {
        if len > 9 {
            break;
        }
        for start in 0..10 - len {
            let x = i64.parse(digits[start..start + len]).unwrap();
            if x >= low and x <= high {
                found.push(x);
            }
        }
    }
    found
}

// ---- sequential_digits_dfs.kara ----
fn a3_extend(x: i64, low: i64, high: i64, found: mut ref Vec[i64]) {
    if x > high {
        return;
    }
    if x >= low {
        found.push(x);
    }
    let last = x % 10;
    if last < 9 {
        a3_extend(x * 10 + last + 1, low, high, mut found);
    }
}

fn a3_sequential_digits(low: i64, high: i64) -> Vec[i64] {
    let mut found: Vec[i64] = Vec.new();
    for d in 1..10 {
        a3_extend(d, low, high, mut found);
    }
    found.sort();
    found
}

// ---- sequential_digits_step.kara ----
fn a4_sequential_digits(low: i64, high: i64) -> Vec[i64] {
    let mut found: Vec[i64] = Vec.new();
    let mut start = 12;
    let mut ones = 11;
    for len in 2..10 {
        let mut x = start;
        for _ in 0..10 - len {
            if x >= low and x <= high {
                found.push(x);
            }
            x += ones;
        }
        start = start * 10 + len + 1;
        ones = ones * 10 + 1;
    }
    found
}

// ---- sequential_digits_solution.kara ----
struct A5Solution {}

impl A5Solution {
    pub fn sequential_digits(low: i32, high: i32) -> Vec[i32] {
        let s = "123456789";
        let mut ans = Vec.new();
        let (lo_len, hi_len) = (low.to_string().len(), high.to_string().len());
        for len in lo_len..=hi_len.min(9) {
            for i in 0..=9 - len {
                let num: i32 = i32.parse(s[i..i + len]).unwrap();
                if num >= low and num <= high {
                    ans.push(num);
                }
            }
        }
        ans
    }
}

fn a5_sequential_digits(low: i64, high: i64) -> Vec[i64] {
    A5Solution.sequential_digits(low as i32, high as i32).into_iter().map(|x| x as i64).collect()
}

// ---- sequential_digits_windows.kara ----
struct A6Solution {}

impl A6Solution {
    pub fn sequential_digits(low: i32, high: i32) -> Vec[i32] {
        let digits: Vec[i32] = (1..=9).collect();
        let mut ans: Vec[i32] = Vec.new();
        for len in 2..=9 {
            for w in digits.windows(len) {
                let n = w.iter().fold(0i32, |acc, d| acc * 10 + d);
                if (low..=high).contains(n) {
                    ans.push(n);
                }
            }
        }
        ans
    }
}

fn a6_sequential_digits(low: i64, high: i64) -> Vec[i64] {
    A6Solution.sequential_digits(low as i32, high as i32).into_iter().map(|x| x as i64).collect()
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn arm(w: i64, low: i64, high: i64) -> Vec[i64] {
    match w {
        0 => a0_sequential_digits(low, high),
        1 => a1_sequential_digits(low, high),
        2 => a2_sequential_digits(low, high),
        3 => a3_sequential_digits(low, high),
        4 => a4_sequential_digits(low, high),
        5 => a5_sequential_digits(low, high),
        _ => a6_sequential_digits(low, high),
    }
}

// Each digit one more than the previous, read from the last digit back.
fn has_sequential_digits(x: i64) -> bool {
    let mut rest = x / 10;
    let mut last = x % 10;
    while rest > 0 {
        if rest % 10 != last - 1 {
            return false;
        }
        last = rest % 10;
        rest /= 10;
    }
    true
}

// The statement read literally: sorted, every number in the range with
// sequential digits; and on a range of at most 3000 numbers, every number in
// it with sequential digits is there.
fn literal(low: i64, high: i64, got: Vec[i64]) -> bool {
    for i in 0..got.len() {
        let x = got[i];
        if x < low or x > high or not has_sequential_digits(x) {
            return false;
        }
        if i > 0 and got[i - 1] >= x {
            return false;
        }
    }
    if high - low <= 3000 {
        let mut k = 0;
        for x in low..high + 1 {
            if has_sequential_digits(x) {
                if k >= got.len() or got[k] != x {
                    return false;
                }
                k += 1;
            }
        }
        return k == got.len();
    }
    true
}

struct Case {
    low: i64,
    high: i64,
    // P2's split point, low <= mid <= high
    mid: i64,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, c: Case) {
    let star = arm(0, c.low, c.high);
    for a in 0..7 {
        let got = arm(a, c.low, c.high);
        let what = f"arm {a}, case {t.cases} [{c.low}, {c.high}] -> {got}";
        // P1: the statement read literally
        expect(mut t, 1, literal(c.low, c.high, got), f"P1 {what}");
        // P2: split at mid, the two answers one after the other
        let mut joined = arm(a, c.low, c.mid);
        if c.mid < c.high {
            joined.extend(arm(a, c.mid + 1, c.high).iter().cloned());
        }
        expect(mut t, 2, joined == got, f"P2 {what}, split at {c.mid}: {joined}");
        // P3: the whole range's answer, cut to this range
        let cut: Vec[i64] = arm(a, 10, 1000000000).iter().filter(|x| x >= c.low and x <= c.high).cloned().collect();
        expect(mut t, 3, cut == got, f"P3 {what}, cut from the whole: {cut}");
        // P4: each found number alone is its own answer, and the numbers
        // between two found ones have none
        let mut alone = true;
        for i in 0..got.len() {
            if arm(a, got[i], got[i]) != [got[i]] {
                alone = false;
            }
            if i > 0 and got[i] - got[i - 1] > 1 and not arm(a, got[i - 1] + 1, got[i] - 1).is_empty() {
                alone = false;
            }
        }
        expect(mut t, 4, alone, f"P4 {what}");
        // P5: one number off the bottom of the range takes off at most it
        if c.low < c.high {
            let mut want = got.clone();
            if not want.is_empty() and want[0] == c.low {
                want.remove(0);
            }
            let up = arm(a, c.low + 1, c.high);
            expect(mut t, 5, up == want, f"P5 {what}, from {c.low + 1}: {up}");
        }
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
    t.cases += 1;
    let mut h = star.len();
    for x in star.iter() {
        h = (h * 131 + x) % 1000000007;
    }
    t.check = (t.check * 31 + h) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 1500 ranges in three kinds, 500 each: within 3000 of a number with
    // sequential digits, so that P1 reads every number in it; from a random
    // power of ten over a random number of digits; and anywhere up to 10^9.
    // Every range and split is drawn before any arm answers.
    let mut seed = 12911;
    let mut cases: Vec[Case] = Vec.new();
    for i in 0..1500 {
        let kind = i % 3;
        let (low, high) = if kind == 0 {
            // a number with sequential digits: its first digit, then its length
            let first = 1 + next_random(mut seed) % 8;
            let len = 2 + next_random(mut seed) % (9 - first);
            let mut near = 0;
            for d in first..first + len {
                near = near * 10 + d;
            }
            let low = near - next_random(mut seed) % 1500;
            let high = near + next_random(mut seed) % 1500;
            (if low < 10 { 10 } else { low }, if high > 1000000000 { 1000000000 } else { high })
        } else if kind == 1 {
            let mut base = 10;
            for _ in 0..next_random(mut seed) % 8 {
                base *= 10;
            }
            let mut span = 1;
            for _ in 0..next_random(mut seed) % 10 {
                span *= 10;
            }
            let low = base + wide_random(mut seed) % (9 * base);
            let high = low + wide_random(mut seed) % span;
            (low, if high > 1000000000 { 1000000000 } else { high })
        } else {
            let low = 10 + wide_random(mut seed) % 999999991;
            (low, low + wide_random(mut seed) % (1000000001 - low))
        };
        let mid = low + wide_random(mut seed) % (high - low + 1);
        cases.push(Case { low, high, mid });
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} ranges: checksum {t.check}, {t.checks} checks over 7 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
