// LeetCode #1291 bench: the ★ arm (the 36 numbers with sequential digits
// made by length, then first digit, those in the range kept) over 10^5
// ranges built once; then 20 passes, each moving every range's low up by the
// checksum so far, answering it, and folding the count and the numbers found
// into the checksum.

fn sequential_digits(low: i64, high: i64) -> Vec[i64] {
    let mut found: Vec[i64] = Vec.new();
    for len in 2..10 {
        for first in 1..11 - len {
            let mut x = 0;
            for d in first..first + len {
                x = x * 10 + d;
            }
            if x >= low and x <= high {
                found.push(x);
            }
        }
    }
    found
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // ranges from a random power of ten over a random number of digits
    let mut seed = 1291;
    let mut ranges: Vec[(i64, i64)] = Vec.new();
    for _ in 0..100000 {
        let mut base = 10;
        for _ in 0..next_random(mut seed) % 8 {
            base *= 10;
        }
        let mut span = 1;
        for _ in 0..next_random(mut seed) % 10 {
            span *= 10;
        }
        let low = base + wide_random(mut seed) % (9 * base);
        let high = low + wide_random(mut seed) % span;
        ranges.push((low, if high > 1000000000 { 1000000000 } else { high }));
    }
    let mut check = 0;
    for p in 0..20 {
        for (low, high) in ranges.iter() {
            let moved = low + check % 1000;
            let found = sequential_digits(if moved > high { high } else { moved }, high);
            check = (check * 31 + found.len() + p) % 1000000007;
            for x in found.iter() {
                check = (check * 131 + x) % 1000000007;
            }
        }
    }
    println(f"20 passes over 10^5 ranges: checksum {check}");
}
