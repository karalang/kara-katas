// LeetCode #1292: Maximum Side Length of a Square with Sum Less than or Equal
// to Threshold -- the sliding arm: no two-dimensional table. For a side k,
// each band of k rows is summed down every column, and a window of k of
// those column sums slides along the band; the side grows while some square
// of the next side fits. O(mn) per side tried

fn some_square_fits(mat: Vec[Vec[i64]], k: i64, threshold: i64) -> bool {
    let m = mat.len();
    let n = mat[0].len();
    if k > m or k > n {
        return false;
    }
    // column sums of the band of rows [top, top + k)
    let mut column: Vec[i64] = Vec.filled(n, 0);
    for i in 0..k {
        for j in 0..n {
            column[j] += mat[i][j];
        }
    }
    for top in 0..m - k + 1 {
        if top > 0 {
            for j in 0..n {
                column[j] += mat[top + k - 1][j] - mat[top - 1][j];
            }
        }
        let mut window = 0;
        for j in 0..n {
            window += column[j];
            if j >= k {
                window -= column[j - k];
            }
            if j >= k - 1 and window <= threshold {
                return true;
            }
        }
    }
    false
}

fn max_side_length(mat: Vec[Vec[i64]], threshold: i64) -> i64 {
    let mut side = 0;
    while some_square_fits(mat, side + 1, threshold) {
        side += 1;
    }
    side
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn problem(seed: mut ref i64, m: i64, n: i64, top: i64) -> Vec[Vec[i64]] {
    let mut mat: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(wide_random(mut seed) % (top + 1));
        }
        mat.push(row);
    }
    mat
}

fn main() {
    // LeetCode's examples, a threshold of 0 over zeros and over ones, and a
    // single cell either side of the threshold
    let ex1 = [[1, 1, 3, 2, 4, 3, 2], [1, 1, 3, 2, 4, 3, 2], [1, 1, 3, 2, 4, 3, 2]];
    let ex2 = [[2, 2, 2, 2, 2], [2, 2, 2, 2, 2], [2, 2, 2, 2, 2], [2, 2, 2, 2, 2], [2, 2, 2, 2, 2]];
    println(f"{max_side_length(ex1, 4)} {max_side_length(ex2, 1)} {max_side_length([[0, 0], [0, 0]], 0)} {max_side_length([[1, 1], [1, 1]], 0)} {max_side_length([[7]], 7)} {max_side_length([[7]], 6)}");
    // random matrices up to 30 by 30 in three kinds, each with its own
    // largest value (10^4, 100, 9), and thresholds up to 10^5; then one of
    // 100 by 100 with values up to 9
    let mut seed = 1292;
    let mut total = 0;
    let mut check = 0;
    for k in 0..601 {
        let top = if k == 600 { 9 } else { [10000, 100, 9][k % 3] };
        let m = if k == 600 { 100 } else { next_random(mut seed) % 30 + 1 };
        let n = if k == 600 { 100 } else { next_random(mut seed) % 30 + 1 };
        let mat = problem(mut seed, m, n, top);
        let threshold = wide_random(mut seed) % 100001;
        let side = max_side_length(mat, threshold);
        total += side;
        check = (check * 131 + side) % 1000000007;
    }
    println(f"601 random matrices: sides total {total}, checksum {check}");
}
