// LeetCode #1292: Maximum Side Length of a Square with Sum Less than or Equal
// to Threshold -- differential test of the five arms against the statement
// read literally, with five more properties.
//
// The statement: given an m x n matrix mat of non-negative integers and an
// integer threshold, return the maximum side length of a square with a sum
// less than or equal to threshold, or 0 if there is no such square.

// ---- max_side_length.kara ----
fn a0_max_side_length(mat: Vec[Vec[i64]], threshold: i64) -> i64 {
    let m = mat.len();
    let n = mat[0].len();
    // sum[i][j]: the sum of the rows above i and the columns left of j
    let mut sum: Vec[Vec[i64]] = Vec.filled(m + 1, Vec.filled(n + 1, 0));
    let mut best = 0;
    for i in 1..m + 1 {
        for j in 1..n + 1 {
            sum[i][j] = mat[i - 1][j - 1] + sum[i - 1][j] + sum[i][j - 1] - sum[i - 1][j - 1];
            let k = best + 1;
            if i >= k and j >= k and sum[i][j] - sum[i - k][j] - sum[i][j - k] + sum[i - k][j - k] <= threshold {
                best = k;
            }
        }
    }
    best
}

// ---- max_side_length_binary.kara ----
fn a1_fits(sum: Vec[Vec[i64]], k: i64, threshold: i64) -> bool {
    let m = sum.len() - 1;
    let n = sum[0].len() - 1;
    for i in k..m + 1 {
        for j in k..n + 1 {
            if sum[i][j] - sum[i - k][j] - sum[i][j - k] + sum[i - k][j - k] <= threshold {
                return true;
            }
        }
    }
    false
}

fn a1_max_side_length(mat: Vec[Vec[i64]], threshold: i64) -> i64 {
    let m = mat.len();
    let n = mat[0].len();
    let mut sum: Vec[Vec[i64]] = Vec.filled(m + 1, Vec.filled(n + 1, 0));
    for i in 1..m + 1 {
        for j in 1..n + 1 {
            sum[i][j] = mat[i - 1][j - 1] + sum[i - 1][j] + sum[i][j - 1] - sum[i - 1][j - 1];
        }
    }
    // the answer is in [lo, hi]
    let mut lo = 0;
    let mut hi = if m < n { m } else { n };
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if a1_fits(sum, mid, threshold) {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

// ---- max_side_length_every.kara ----
fn a2_max_side_length(mat: Vec[Vec[i64]], threshold: i64) -> i64 {
    let m = mat.len();
    let n = mat[0].len();
    let mut sum: Vec[Vec[i64]] = Vec.filled(m + 1, Vec.filled(n + 1, 0));
    for i in 0..m {
        for j in 0..n {
            sum[i + 1][j + 1] = mat[i][j] + sum[i][j + 1] + sum[i + 1][j] - sum[i][j];
        }
    }
    let mut best = 0;
    for top in 0..m {
        for left in 0..n {
            let mut k = 1;
            while top + k <= m and left + k <= n {
                let s = sum[top + k][left + k] - sum[top][left + k] - sum[top + k][left] + sum[top][left];
                if s > threshold {
                    break;
                }
                if k > best {
                    best = k;
                }
                k += 1;
            }
        }
    }
    best
}

// ---- max_side_length_sliding.kara ----
fn a3_some_square_fits(mat: Vec[Vec[i64]], k: i64, threshold: i64) -> bool {
    let m = mat.len();
    let n = mat[0].len();
    if k > m or k > n {
        return false;
    }
    // column sums of the band of rows [top, top + k)
    let mut column: Vec[i64] = Vec.filled(n, 0);
    for i in 0..k {
        for j in 0..n {
            column[j] += mat[i][j];
        }
    }
    for top in 0..m - k + 1 {
        if top > 0 {
            for j in 0..n {
                column[j] += mat[top + k - 1][j] - mat[top - 1][j];
            }
        }
        let mut window = 0;
        for j in 0..n {
            window += column[j];
            if j >= k {
                window -= column[j - k];
            }
            if j >= k - 1 and window <= threshold {
                return true;
            }
        }
    }
    false
}

fn a3_max_side_length(mat: Vec[Vec[i64]], threshold: i64) -> i64 {
    let mut side = 0;
    while a3_some_square_fits(mat, side + 1, threshold) {
        side += 1;
    }
    side
}

// ---- max_side_length_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn max_side_length(mat: Vec[Vec[i32]], threshold: i32) -> i32 {
        let (m, n) = (mat.len(), mat[0].len());
        let mut p = Vec.filled(m + 1, Vec.filled(n + 1, 0));
        for i in 0..m {
            for j in 0..n {
                p[i + 1][j + 1] = p[i][j + 1] + p[i + 1][j] - p[i][j] + mat[i][j];
            }
        }
        let check = |k: i64| {
            for i in k..=m {
                for j in k..=n {
                    if p[i][j] - p[i - k][j] - p[i][j - k] + p[i - k][j - k] <= threshold {
                        return true;
                    }
                }
            }
            false
        };
        let mut (lo, hi) = (0, m.min(n));
        while lo < hi {
            let mid = (lo + hi + 1) / 2;
            if check(mid) {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        lo as i32
    }
}

fn a4_max_side_length(mat: Vec[Vec[i64]], threshold: i64) -> i64 {
    let mat32: Vec[Vec[i32]] = mat.iter().map(|row| row.iter().map(|x| x as i32).collect()).collect();
    A4Solution.max_side_length(mat32, threshold as i32)
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(w: i64, mat: Vec[Vec[i64]], threshold: i64) -> i64 {
    match w {
        0 => a0_max_side_length(mat, threshold),
        1 => a1_max_side_length(mat, threshold),
        2 => a2_max_side_length(mat, threshold),
        3 => a3_max_side_length(mat, threshold),
        _ => a4_max_side_length(mat, threshold),
    }
}

// The statement read literally: every square of every side, its cells
// added one by one, and the longest side of any whose sum is at most the
// threshold; 0 when there is none.
fn literal(mat: Vec[Vec[i64]], threshold: i64) -> i64 {
    let m = mat.len();
    let n = mat[0].len();
    let mut best = 0;
    for k in 1..m + 1 {
        for top in 0..m {
            for left in 0..n {
                if top + k > m or left + k > n {
                    continue;
                }
                let mut s = 0;
                for i in top..top + k {
                    for j in left..left + k {
                        s += mat[i][j];
                    }
                }
                if s <= threshold and k > best {
                    best = k;
                }
            }
        }
    }
    best
}

struct Case {
    mat: Vec[Vec[i64]],
    threshold: i64,
    // P5's raise of the threshold
    raise: i64,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, c: Case) {
    let m = c.mat.len();
    let n = c.mat[0].len();
    let transposed: Vec[Vec[i64]] = (0..n).map(|j| (0..m).map(|i| c.mat[i][j]).collect()).collect();
    let flipped: Vec[Vec[i64]] = c.mat.iter().rev().map(|row| row.iter().rev().cloned().collect()).collect();
    let doubled: Vec[Vec[i64]] = c.mat.iter().map(|row| row.iter().map(|x| 2 * x).collect()).collect();
    let want = literal(c.mat, c.threshold);
    let star = arm(0, c.mat, c.threshold);
    for a in 0..5 {
        let got = arm(a, c.mat, c.threshold);
        let what = f"arm {a}, case {t.cases} {c.mat} threshold {c.threshold} -> {got}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}, literal {want}");
        // P2: the matrix transposed, the same answer
        let tr = arm(a, transposed, c.threshold);
        expect(mut t, 2, tr == got, f"P2 {what}, transposed: {tr}");
        // P3: the matrix turned half round, the same answer
        let fl = arm(a, flipped, c.threshold);
        expect(mut t, 3, fl == got, f"P3 {what}, turned: {fl}");
        // P4: every cell and the threshold doubled, the same answer
        let db = arm(a, doubled, 2 * c.threshold);
        expect(mut t, 4, db == got, f"P4 {what}, doubled: {db}");
        // P5: a higher threshold, an answer at least as long
        let up = arm(a, c.mat, c.threshold + c.raise);
        expect(mut t, 5, up >= got, f"P5 {what}, threshold {c.threshold + c.raise}: {up}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
    t.cases += 1;
    t.check = (t.check * 131 + want + 1) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 matrices up to 8 by 8 in four kinds, 500 each: values up to 9,
    // up to 100, mostly 0 with a few up to 50, and all one value. The
    // threshold is drawn up to the matrix's whole sum, so that the answer
    // lands anywhere from 0 to the shorter side. Every matrix, threshold and
    // raise is drawn before any arm answers.
    let mut seed = 12921;
    let mut cases: Vec[Case] = Vec.new();
    for i in 0..2000 {
        let kind = i % 4;
        let m = 1 + next_random(mut seed) % 8;
        let n = 1 + next_random(mut seed) % 8;
        let same = next_random(mut seed) % 10;
        let mat: Vec[Vec[i64]] = (0..m)
            .map(|_| {
                (0..n)
                    .map(|_| {
                        match kind {
                            0 => next_random(mut seed) % 10,
                            1 => next_random(mut seed) % 101,
                            2 => if next_random(mut seed) % 4 == 0 { next_random(mut seed) % 51 } else { 0 },
                            _ => same,
                        }
                    })
                    .collect()
            })
            .collect();
        let mut total = 0;
        for row in mat.iter() {
            for x in row.iter() {
                total += x;
            }
        }
        let threshold = next_random(mut seed) % (total + 1);
        let raise = next_random(mut seed) % (total + 1);
        cases.push(Case { mat, threshold, raise });
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} matrices: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
