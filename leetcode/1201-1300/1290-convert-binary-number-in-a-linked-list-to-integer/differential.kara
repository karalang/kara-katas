// LeetCode #1290: Convert Binary Number in a Linked List to Integer --
// differential test of the seven arms against the statement read literally,
// with five more properties.
//
// The statement: given the head of a singly linked list whose every node is
// 0 or 1, the list holding the binary representation of a number with its
// most significant bit first, return the decimal value of the number.

shared struct ListNode {
    mut val: i64,
    mut next: Option[ListNode],
}

// ---- get_decimal_value.kara ----
fn a0_get_decimal_value(head: Option[ListNode]) -> i64 {
    let mut value = 0;
    let mut cur = head;
    while let Some(node) = cur {
        value = value * 2 + node.val;
        cur = node.next;
    }
    value
}

// ---- get_decimal_value_shift.kara ----
fn a1_get_decimal_value(head: Option[ListNode]) -> i64 {
    let mut value = 0;
    let mut cur = head;
    while let Some(node) = cur {
        value = (value << 1) | node.val;
        cur = node.next;
    }
    value
}

// ---- get_decimal_value_count.kara ----
fn a2_get_decimal_value(head: Option[ListNode]) -> i64 {
    let mut n = 0;
    let mut cur = head;
    while let Some(node) = cur {
        n += 1;
        cur = node.next;
    }
    let mut value = 0;
    let mut place = n - 1;
    cur = head;
    while let Some(node) = cur {
        if node.val == 1 {
            value += 2.pow(place as u32);
        }
        place -= 1;
        cur = node.next;
    }
    value
}

// ---- get_decimal_value_string.kara ----
fn a3_get_decimal_value(head: Option[ListNode]) -> i64 {
    let mut digits = String.new();
    let mut cur = head;
    while let Some(node) = cur {
        digits.push(char.from_digit(node.val as u32, 2).unwrap());
        cur = node.next;
    }
    let mut value = 0;
    for c in digits.chars() {
        value = value * 2 + c.to_digit(2).unwrap();
    }
    value
}

// ---- get_decimal_value_recursive.kara ----
// (value of the list from here, number of nodes from here)
fn a4_value_and_width(head: Option[ListNode]) -> (i64, i64) {
    match head {
        None => (0, 0),
        Some(node) => {
            let (rest, width) = a4_value_and_width(node.next);
            (node.val * (1 << width) + rest, width + 1)
        }
    }
}

fn a4_get_decimal_value(head: Option[ListNode]) -> i64 {
    let (value, _) = a4_value_and_width(head);
    value
}

// ---- get_decimal_value_solution.kara ----
#[derive(PartialEq, Eq, Clone, Debug)]
pub struct A5ListNode {
    pub val: i32,
    pub next: Option[A5ListNode],
}

impl A5ListNode {
    #[inline]
    fn new(val: i32) -> Self {
        A5ListNode { next: None, val }
    }
}

struct A5Solution {}

impl A5Solution {
    pub fn get_decimal_value(head: Option[A5ListNode]) -> i32 {
        let mut ans: i32 = 0;
        let mut cur = ref head;
        while let Some(node) = cur {
            ans = (ans << 1) | node.val;
            cur = ref node.next;
        }
        ans
    }
}

fn a5_get_decimal_value(head: Option[A5ListNode]) -> i64 {
    A5Solution.get_decimal_value(head)
}

// ---- get_decimal_value_radix.kara ----
#[derive(PartialEq, Eq, Clone, Debug)]
pub struct A6ListNode {
    pub val: i32,
    pub next: Option[A6ListNode],
}

impl A6ListNode {
    #[inline]
    fn new(val: i32) -> Self {
        A6ListNode { next: None, val }
    }
}

struct A6Solution {}

impl A6Solution {
    pub fn get_decimal_value(head: Option[A6ListNode]) -> i32 {
        let mut s = String.new();
        let mut cur = ref head;
        while let Some(node) = cur {
            s.push_str(node.val.to_string());
            cur = ref node.next;
        }
        i32.from_str_radix(s, 2).unwrap()
    }
}

fn a6_get_decimal_value(head: Option[A6ListNode]) -> i64 {
    A6Solution.get_decimal_value(head)
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(w: i64, bits: Vec[i64]) -> i64 {
    if w == 5 {
        let mut head: Option[A5ListNode] = None;
        for b in bits.iter().rev() {
            head = Some(A5ListNode { val: b as i32, next: head });
        }
        return a5_get_decimal_value(head);
    }
    if w == 6 {
        let mut head: Option[A6ListNode] = None;
        for b in bits.iter().rev() {
            head = Some(A6ListNode { val: b as i32, next: head });
        }
        return a6_get_decimal_value(head);
    }
    let mut head: Option[ListNode] = None;
    for b in bits.iter().rev() {
        head = Some(ListNode { val: b, next: head });
    }
    match w {
        0 => a0_get_decimal_value(head),
        1 => a1_get_decimal_value(head),
        2 => a2_get_decimal_value(head),
        3 => a3_get_decimal_value(head),
        _ => a4_get_decimal_value(head),
    }
}

// The statement read literally: the list is the number's binary
// representation, most significant bit first, so each bit stands for two to
// the power of the number of bits after it, and the value is the sum.
fn literal(bits: Vec[i64]) -> i64 {
    let n = bits.len();
    let mut value = 0;
    for i in 0..n {
        let mut place = 1;
        for _ in 0..n - 1 - i {
            place *= 2;
        }
        value += bits[i] * place;
    }
    value
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: String) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 10 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, bits: Vec[i64]) {
    let n = bits.len();
    let mut zero_after = bits.clone();
    zero_after.push(0);
    let mut one_after = bits.clone();
    one_after.push(1);
    let mut zero_before = [0];
    zero_before.extend(bits.iter().cloned());
    let flipped: Vec[i64] = bits.iter().map(|b| 1 - b).collect();
    let all_ones = (1 << n) - 1;
    let star = arm(0, bits);
    for a in 0..7 {
        let got = arm(a, bits);
        let what = f"arm {a}, case {t.cases} {bits} -> {got}";
        // P1: the statement read literally
        expect(mut t, 1, got == literal(bits), f"P1 {what}");
        // P2: a 0 after the last bit doubles the value
        let z = arm(a, zero_after);
        expect(mut t, 2, z == 2 * got, f"P2 {what}, with a 0 after: {z}");
        // P3: a 1 after the last bit doubles it and adds 1
        let o = arm(a, one_after);
        expect(mut t, 3, o == 2 * got + 1, f"P3 {what}, with a 1 after: {o}");
        // P4: a 0 in front changes nothing
        let l = arm(a, zero_before);
        expect(mut t, 4, l == got, f"P4 {what}, with a 0 in front: {l}");
        // P5: every bit flipped gives the rest of n ones
        let f = arm(a, flipped);
        expect(mut t, 5, f == all_ones - got, f"P5 {what}, flipped: {f}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
    t.cases += 1;
    t.check = (t.check * 131 + star + 1) % 1000000007;
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 3000 lists of 1 to 29 bits, so that a bit added before or after keeps
    // to the constraints' 30 nodes. A third lead with a 1, a third with a run
    // of 0s, and a third are mostly one bit, so that long runs of either come
    // up. Every list is drawn before any arm answers.
    let mut seed = 12901;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for i in 0..3000 {
        let kind = i % 3;
        let n = if i < 29 { i + 1 } else { 1 + next_random(mut seed) % 29 };
        let bits: Vec[i64] = (0..n)
            .map(|j| {
                if kind == 0 and j == 0 {
                    1
                } else if kind == 1 and j < n / 3 {
                    0
                } else if kind == 2 {
                    if next_random(mut seed) % 8 == 0 { 1 - i % 2 } else { i % 2 }
                } else {
                    next_random(mut seed) % 2
                }
            })
            .collect();
        cases.push(bits);
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} lists: checksum {t.check}, {t.checks} checks over 7 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
