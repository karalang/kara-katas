// LeetCode #1235: Maximum Profit in Job Scheduling -- the arms
// against the statement read literally and five more properties.
// Generated from the arms; see the README.

// ---- arm 0: star --------------------------------------------------------
fn a0_job_scheduling(start_time: Vec[i64], end_time: Vec[i64], profit: Vec[i64]) -> i64 {
    let n = start_time.len();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by_key(|i| end_time[i]);
    let ends: Vec[i64] = order.iter().map(|i| end_time[i]).collect();
    let mut best = Vec.filled(n + 1, 0);
    for k in 0..n {
        let job = order[k];
        let before = ends.partition_point(|e| e <= start_time[job]);
        best[k + 1] = best[k].max(best[before] + profit[job]);
    }
    best[n]
}

// ---- arm 1: starts ------------------------------------------------------
struct Job {
    start: i64,
    end: i64,
    profit: i64,
}

fn a1_job_scheduling(start_time: Vec[i64], end_time: Vec[i64], profit: Vec[i64]) -> i64 {
    let mut jobs: Vec[Job] = Vec.new();
    for i in 0..start_time.len() {
        jobs.push(Job { start: start_time[i], end: end_time[i], profit: profit[i] });
    }
    jobs.sort_by_key(|j| j.start);
    let n = jobs.len();
    let mut best = Vec.filled(n + 1, 0);
    for k in (0..n).rev() {
        let next = jobs.partition_point(|j| j.start < jobs[k].end);
        best[k] = best[k + 1].max(jobs[k].profit + best[next]);
    }
    best[0]
}

// ---- arm 2: heap --------------------------------------------------------
fn a2_job_scheduling(start_time: Vec[i64], end_time: Vec[i64], profit: Vec[i64]) -> i64 {
    let mut order: Vec[i64] = (0..start_time.len()).collect();
    order.sort_by_key(|i| start_time[i]);
    let mut open: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut done = 0;
    for i in order {
        while let Some((end, total)) = open.peek() {
            if end > start_time[i] {
                break;
            }
            done = done.max(total);
            open.pop();
        }
        open.push((end_time[i], done + profit[i]));
    }
    while let Some((_, total)) = open.pop() {
        done = done.max(total);
    }
    done
}

// ---- arm 3: table -------------------------------------------------------
fn a3_job_scheduling(start_time: Vec[i64], end_time: Vec[i64], profit: Vec[i64]) -> i64 {
    let mut order: Vec[i64] = (0..start_time.len()).collect();
    order.sort_by_key(|i| end_time[i]);
    let mut table: SortedMap[i64, i64] = SortedMap.new();
    table.insert(0, 0);
    let mut best = 0;
    for i in order {
        let (_, before) = table.floor(start_time[i]).unwrap();
        let total = before + profit[i];
        if total > best {
            best = total;
            table.insert(end_time[i], best);
        }
    }
    best
}

// ---- arm 4: sorted ------------------------------------------------------
struct A4Solution {}

impl A4Solution {
    pub fn job_scheduling(start_time: own Vec[i32], end_time: own Vec[i32], profit: own Vec[i32]) -> i32 {
        let mut jobs: Vec[(i32, i32, i32)] = end_time
            .into_iter()
            .zip(start_time.into_iter())
            .zip(profit.into_iter())
            .map(|((e, s), p)| (e, s, p))
            .collect();
        jobs.sort();
        let n = jobs.len();
        let mut dp = Vec.filled(n + 1, 0i32);
        for i in 0..n {
            let (_, s, p) = jobs[i];
            let j = jobs.partition_point(|(e, _, _)| e <= s);
            dp[i + 1] = dp[i].max(dp[j] + p);
        }
        dp[n]
    }
}

fn a4_job_scheduling(start_time: Vec[i64], end_time: Vec[i64], profit: Vec[i64]) -> i64 {
    let s: Vec[i32] = start_time.iter().map(|x| x as i32).collect();
    let e: Vec[i32] = end_time.iter().map(|x| x as i32).collect();
    let p: Vec[i32] = profit.iter().map(|x| x as i32).collect();
    A4Solution.job_scheduling(s, e, p)
}

// ---- arm 5: btree -------------------------------------------------------
struct A5Solution {}

impl A5Solution {
    pub fn job_scheduling(start_time: Vec[i32], end_time: Vec[i32], profit: Vec[i32]) -> i32 {
        let n = start_time.len();
        let mut idx: Vec[i64] = (0..n).collect();
        idx.sort_by_key(|i| end_time[i]);
        let mut dp: SortedMap[i32, i32] = SortedMap.new();
        dp.insert(0, 0);
        let mut best = 0;
        for i in ref idx {
            let prev = *dp.range_inclusive(i32.MIN, start_time[i]).next_back().unwrap().1;
            if prev + profit[i] > best {
                best = prev + profit[i];
                dp.insert(end_time[i], best);
            }
        }
        best
    }
}

fn a5_job_scheduling(start_time: Vec[i64], end_time: Vec[i64], profit: Vec[i64]) -> i64 {
    let s: Vec[i32] = start_time.iter().map(|x| x as i32).collect();
    let e: Vec[i32] = end_time.iter().map(|x| x as i32).collect();
    let p: Vec[i32] = profit.iter().map(|x| x as i32).collect();
    A5Solution.job_scheduling(s, e, p)
}

// ---- arm 6: search ------------------------------------------------------
struct A6Solution {}

impl A6Solution {
    pub fn job_scheduling(start_time: Vec[i32], end_time: Vec[i32], profit: Vec[i32]) -> i32 {
        let n = start_time.len();
        let mut jobs: Vec[Array[i32, 3]] = (0..n).map(|i| [start_time[i], end_time[i], profit[i]]).collect();
        jobs.sort_by(|a, b| a[1].cmp(b[1]));
        let mut dp: Vec[(i32, i32)] = [(0, 0)];
        for job in jobs.iter() {
            let idx = {
                let i = dp.partition_point(|(end, _)| end.cmp(job[0]) != Ordering.Greater);
                i - 1
            };
            let cur = dp[idx].1 + job[2];
            if cur > dp.last().unwrap().1 {
                dp.push((job[1], cur));
            }
        }
        dp.last().unwrap().1
    }
}

fn a6_job_scheduling(start_time: Vec[i64], end_time: Vec[i64], profit: Vec[i64]) -> i64 {
    let s: Vec[i32] = start_time.iter().map(|x| x as i32).collect();
    let e: Vec[i32] = end_time.iter().map(|x| x as i32).collect();
    let p: Vec[i32] = profit.iter().map(|x| x as i32).collect();
    A6Solution.job_scheduling(s, e, p)
}

// ---- the statement read literally -----------------------------------------

// The most profit from any set of jobs no two of which overlap, every
// subset tried: two jobs overlap when each starts before the other ends.
fn literal(start: Vec[i64], end: Vec[i64], profit: Vec[i64]) -> i64 {
    let n = start.len();
    let mut best = 0;
    for set in 0..(1 << n) {
        let mut total = 0;
        let mut apart = true;
        for i in 0..n {
            if set >> i & 1 == 1 {
                total += profit[i];
                for j in 0..i {
                    if set >> j & 1 == 1 and start[i] < end[j] and start[j] < end[i] {
                        apart = false;
                    }
                }
            }
        }
        if apart {
            best = best.max(total);
        }
    }
    best
}

// ---- the differential -----------------------------------------------------

fn arms(s: Vec[i64], e: Vec[i64], p: Vec[i64]) -> Vec[i64] {
    [a0_job_scheduling(s, e, p), a1_job_scheduling(s, e, p), a2_job_scheduling(s, e, p), a3_job_scheduling(s, e, p), a4_job_scheduling(s, e, p), a5_job_scheduling(s, e, p), a6_job_scheduling(s, e, p)]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["the statement read literally", "between the best job and all of them", "the jobs listed backwards give the same", "every time moved later gives the same", "every profit doubled doubles it", "the ★ arm's answer"];
    let mut fails = Vec.filled(6, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 1235;
    for c in 0..2000 {
        let n = match c % 3 {
            0 => next_random(mut seed) % 12 + 1,
            1 => next_random(mut seed) % 88 + 13,
            _ => next_random(mut seed) % 900 + 101,
        };
        // a narrow span gives many shared start and end times
        let span = if next_random(mut seed) % 2 == 0 { n + 5 } else { 100000 };
        let long = next_random(mut seed) % (span / 2) + 1;
        let mut s = Vec.new();
        let mut e = Vec.new();
        let mut p = Vec.new();
        for _ in 0..n {
            let at = next_random(mut seed) % span + 1;
            s.push(at);
            e.push(at + next_random(mut seed) % long + 1);
            p.push(next_random(mut seed) % 10000 + 1);
        }
        let want = if n <= 12 { literal(s, e, p) } else { -1 };
        let got = arms(s, e, p);
        let backwards = arms(s.iter().rev().collect(), e.iter().rev().collect(), p.iter().rev().collect());
        let later = arms(s.iter().map(|t| t + 1000).collect(), e.iter().map(|t| t + 1000).collect(), p);
        let doubled = arms(s, e, p.iter().map(|x| 2 * x).collect());
        let top = p.iter().max().unwrap();
        let all: i64 = p.iter().sum();
        for a in 0..7 {
            let v = got[a];
            let held = [
                n > 12 or v == want,
                v >= top and v <= all,
                backwards[a] == v,
                later[a] == v,
                doubled[a] == 2 * v,
                v == got[0],
            ];
            for q in 0..6 {
                checks += 1;
                if not held[q] {
                    fails[q] += 1;
                    if fails[q] <= 2 {
                        println(f"P{q + 1} ({names[q]}) fails on arm {a}: {s} {e} {p} -> {v}");
                    }
                }
            }
        }
        check = (check * 131 + got[0]) % 1000000007;
    }
    for q in 0..6 {
        if fails[q] > 0 {
            println(f"P{q + 1}: {fails[q]} failures");
        }
    }
    let failures = fails.iter().sum();
    println(f"2000 cases: checksum {check}, {checks} checks over {7} arms: {failures} failures");
}
