// LeetCode #1235: Maximum Profit in Job Scheduling -- a third Rust
// solution: the jobs as `[i32; 3]` arrays sorted by `sort_by(|a, b|
// a[1].cmp(&b[1]))`, and a rising list of `(end, best)` pairs searched by
// `binary_search_by(|&(end, _)| end.cmp(&job[0]))`, an `Err(i)` meaning the
// pair before `i`, carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn job_scheduling(start_time: Vec[i32], end_time: Vec[i32], profit: Vec[i32]) -> i32 {
        let n = start_time.len();
        let mut jobs: Vec[Array[i32, 3]] = (0..n).map(|i| [start_time[i], end_time[i], profit[i]]).collect();
        jobs.sort_by(|a, b| a[1].cmp(b[1]));
        let mut dp: Vec[(i32, i32)] = [(0, 0)];
        for job in jobs.iter() {
            let idx = {
                let i = dp.partition_point(|(end, _)| end.cmp(job[0]) != Ordering.Greater);
                i - 1
            };
            let cur = dp[idx].1 + job[2];
            if cur > dp.last().unwrap().1 {
                dp.push((job[1], cur));
            }
        }
        dp.last().unwrap().1
    }
}

fn job_scheduling(start_time: Vec[i64], end_time: Vec[i64], profit: Vec[i64]) -> i64 {
    let s: Vec[i32] = start_time.iter().map(|x| x as i32).collect();
    let e: Vec[i32] = end_time.iter().map(|x| x as i32).collect();
    let p: Vec[i32] = profit.iter().map(|x| x as i32).collect();
    Solution.job_scheduling(s, e, p)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` jobs from `seed`: starts below `span`, each lasting 1 to `long`, each
// worth 1 to 10^4.
fn jobs(n: i64, span: i64, long: i64, seed: mut ref i64) -> (Vec[i64], Vec[i64], Vec[i64]) {
    let mut start = Vec.new();
    let mut end = Vec.new();
    let mut profit = Vec.new();
    for _ in 0..n {
        let s = next_random(mut seed) * 32768 % span + next_random(mut seed) % span;
        let s = s % span + 1;
        start.push(s);
        end.push(s + next_random(mut seed) * 32768 % long + 1);
        profit.push(next_random(mut seed) % 10000 + 1);
    }
    (start, end, profit)
}

fn main() {
    // LeetCode's three examples, and one job
    println(f"{job_scheduling([1, 2, 3, 3], [3, 4, 5, 6], [50, 10, 40, 70])}");
    println(f"{job_scheduling([1, 2, 3, 4, 6], [3, 5, 10, 6, 9], [20, 20, 100, 70, 60])}");
    println(f"{job_scheduling([1, 1, 1], [2, 3, 4], [5, 6, 4])}");
    println(f"{job_scheduling([7], [9], [4])}");
    // 1000 random sets of 1 to 30 jobs, times up to 50
    let mut seed = 1235;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 30 + 1;
        let (start, end, profit) = jobs(n, 40, next_random(mut seed) % 10 + 1, mut seed);
        check = (check * 131 + job_scheduling(start, end, profit)) % 1000000007;
    }
    println(f"1000 random sets: checksum {check}");
    // the constraints' top, 5 * 10^4 jobs: spread over 10^9, all at once, and back to back
    let (start, end, profit) = jobs(50000, 999000000, 1000000, mut seed);
    let all: Vec[i64] = (0..50000).map(|i| i % 10000 + 1).collect();
    let chain: Vec[i64] = (0..50000).map(|i| i * 20000 + 1).collect();
    let after: Vec[i64] = chain.iter().map(|s| s + 20000).collect();
    println(f"5 * 10^4 jobs: {job_scheduling(start, end, profit)}, {job_scheduling(Vec.filled(50000, 1), Vec.filled(50000, 1000000000), all)}, {job_scheduling(chain, after, all)}");
}
