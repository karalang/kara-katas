// LeetCode #1235: Maximum Profit in Job Scheduling -- the ★ arm, benched:
// dynamic programming over the jobs sorted by end time, the jobs that end
// by each start counted by `partition_point`. O(n log n).

fn job_scheduling(start_time: Vec[i64], end_time: Vec[i64], profit: Vec[i64]) -> i64 {
    let n = start_time.len();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by_key(|i| end_time[i]);
    let ends: Vec[i64] = order.iter().map(|i| end_time[i]).collect();
    let mut best = Vec.filled(n + 1, 0);
    for k in 0..n {
        let job = order[k];
        let before = ends.partition_point(|e| e <= start_time[job]);
        best[k + 1] = best[k].max(best[before] + profit[job]);
    }
    best[n]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1235;
    let mut sets: Vec[(Vec[i64], Vec[i64], Vec[i64])] = Vec.new();
    for t in 0..20 {
        let long = 1000000 * (t % 4 + 1);
        let mut start = Vec.new();
        let mut end = Vec.new();
        let mut profit = Vec.new();
        for _ in 0..50000 {
            let s = (next_random(mut seed) * 32768 + next_random(mut seed)) % 999000000 + 1;
            start.push(s);
            end.push(s + (next_random(mut seed) * 32768 + next_random(mut seed)) % long + 1);
            profit.push(next_random(mut seed) % 10000 + 1);
        }
        sets.push((start, end, profit));
    }
    let mut check = 0;
    for _ in 0..10 {
        for (start, end, profit) in sets.iter() {
            check = (check * 131 + job_scheduling(start, end, profit)) % 1000000007;
        }
    }
    println(f"20 sets of 50000 jobs, 10 passes: checksum {check}");
}
