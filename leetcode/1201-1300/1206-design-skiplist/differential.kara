// LeetCode #1206: Design Skiplist -- the six arms against the statement
// read literally and six more properties.
// Generated from the arms; see the README.

// ---- arm 0: star --------------------------------------------------------
const A0_LEVELS: i64 = 16;

struct A0Skiplist {
    values: Vec[i64],
    next: Vec[Vec[i64]],
    free: Vec[i64],
    seed: i64,
}

impl A0Skiplist {
    fn new() -> A0Skiplist {
        A0Skiplist { values: [0], next: [Vec.filled(A0_LEVELS, -1)], free: Vec.new(), seed: 1206 }
    }

    fn height(mut ref self) -> i64 {
        let mut h = 1;
        while h < A0_LEVELS {
            self.seed = (self.seed * 1103515245 + 12345) % 2147483648;
            if (self.seed / 65536) % 2 == 1 {
                break;
            }
            h += 1;
        }
        h
    }

    // The last node on each level whose value is below `target`.
    fn path(self, target: i64) -> Vec[i64] {
        let mut path = Vec.filled(A0_LEVELS, 0);
        let mut x = 0;
        for level in (0..A0_LEVELS).rev() {
            while self.next[x][level] >= 0 and self.values[self.next[x][level]] < target {
                x = self.next[x][level];
            }
            path[level] = x;
        }
        path
    }

    fn search(self, target: i64) -> bool {
        let at = self.next[self.path(target)[0]][0];
        at >= 0 and self.values[at] == target
    }

    fn add(mut ref self, num: i64) {
        let path = self.path(num);
        let h = self.height();
        let links: Vec[i64] = (0..h).map(|level| self.next[path[level]][level]).collect();
        let node = match self.free.pop() {
            Some(slot) => {
                self.values[slot] = num;
                self.next[slot] = links;
                slot
            }
            None => {
                self.values.push(num);
                self.next.push(links);
                self.values.len() - 1
            }
        };
        for level in 0..h {
            self.next[path[level]][level] = node;
        }
    }

    fn erase(mut ref self, num: i64) -> bool {
        let path = self.path(num);
        let at = self.next[path[0]][0];
        if at < 0 or self.values[at] != num {
            return false;
        }
        for level in 0..self.next[at].len() {
            if self.next[path[level]][level] == at {
                self.next[path[level]][level] = self.next[at][level];
            }
        }
        self.free.push(at);
        true
    }
}

// ---- arm 1: sorted ------------------------------------------------------
struct A1Skiplist {
    values: Vec[i64],
}

impl A1Skiplist {
    fn new() -> A1Skiplist {
        A1Skiplist { values: Vec.new() }
    }

    // The first index whose value is not below `target`.
    fn lower_bound(self, target: i64) -> i64 {
        let mut low = 0;
        let mut high = self.values.len();
        while low < high {
            let mid = (low + high) / 2;
            if self.values[mid] < target {
                low = mid + 1;
            } else {
                high = mid;
            }
        }
        low
    }

    fn search(self, target: i64) -> bool {
        let i = self.lower_bound(target);
        i < self.values.len() and self.values[i] == target
    }

    fn add(mut ref self, num: i64) {
        let i = self.lower_bound(num);
        self.values.insert(i, num);
    }

    fn erase(mut ref self, num: i64) -> bool {
        if not self.search(num) {
            return false;
        }
        let i = self.lower_bound(num);
        self.values.remove(i);
        true
    }
}

// ---- arm 2: counts ------------------------------------------------------
struct A2Skiplist {
    counts: SortedMap[i64, i64],
}

impl A2Skiplist {
    fn new() -> A2Skiplist {
        A2Skiplist { counts: SortedMap.new() }
    }

    fn search(self, target: i64) -> bool {
        self.counts.contains_key(target)
    }

    fn add(mut ref self, num: i64) {
        *self.counts.entry(num).or_insert(0) += 1;
    }

    fn erase(mut ref self, num: i64) -> bool {
        match self.counts.get(num) {
            None => false,
            Some(1) => {
                self.counts.remove(num);
                true
            }
            Some(c) => {
                self.counts.insert(num, c - 1);
                true
            }
        }
    }
}

// ---- arm 3: linked ------------------------------------------------------
const A3_LEVELS: i64 = 16;

shared struct A3Node {
    value: i64,
    mut next: Vec[Option[A3Node]],
}

struct A3Skiplist {
    head: A3Node,
    adds: i64,
}

impl A3Skiplist {
    fn new() -> A3Skiplist {
        A3Skiplist { head: A3Node { value: 0, next: Vec.filled(A3_LEVELS, None) }, adds: 0 }
    }

    // The last node on each level whose value is below `target`.
    fn path(self, target: i64) -> Vec[A3Node] {
        let mut path = Vec.new();
        let mut x = self.head.clone();
        for level in (0..A3_LEVELS).rev() {
            loop {
                let step = match x.next[level].clone() {
                    Some(n) if n.value < target => n,
                    _ => break,
                };
                x = step;
            }
            path.push(x.clone());
        }
        path.reverse();
        path
    }

    fn search(self, target: i64) -> bool {
        match self.path(target)[0].next[0].clone() {
            Some(n) => n.value == target,
            None => false,
        }
    }

    fn add(mut ref self, num: i64) {
        let path = self.path(num);
        let mut h = 1;
        let mut k = self.adds;
        self.adds += 1;
        while h < A3_LEVELS and k % 2 == 1 {
            k /= 2;
            h += 1;
        }
        let node = A3Node { value: num, next: (0..h).map(|level| path[level].next[level].clone()).collect() };
        for level in 0..h {
            path[level].next[level] = Some(node.clone());
        }
    }

    fn erase(mut ref self, num: i64) -> bool {
        let path = self.path(num);
        let Some(at) = path[0].next[0].clone() else {
            return false;
        };
        if at.value != num {
            return false;
        }
        for level in 0..at.next.len() {
            let here = match path[level].next[level].clone() {
                Some(n) => n.ref_eq(at),
                None => false,
            };
            if here {
                path[level].next[level] = at.next[level].clone();
            }
        }
        true
    }
}

// ---- arm 4: rc ----------------------------------------------------------
const A4_MAX_LEVEL: i64 = 16;

type A4Link = Option[A4Node];

shared struct A4Node {
    mut val: i32,
    mut next: Vec[A4Link],
}

struct A4Skiplist {
    head: A4Node,
    state: u32,
}

impl A4Skiplist {
    fn new() -> Self {
        A4Skiplist {
            head: A4Node { val: -1, next: Vec.filled(A4_MAX_LEVEL, None) },
            state: 2463534242,
        }
    }

    fn random_level(mut ref self) -> i64 {
        let mut level = 1;
        loop {
            self.state ^= self.state << 13;
            self.state ^= self.state >> 17;
            self.state ^= self.state << 5;
            if level < A4_MAX_LEVEL and self.state & 3 == 0 {
                level += 1;
            } else {
                return level;
            }
        }
    }

    fn find(self, target: i32) -> Vec[A4Node] {
        let mut update = Vec.filled(A4_MAX_LEVEL, self.head.clone());
        let mut cur = self.head.clone();
        for lv in (0..A4_MAX_LEVEL).rev() {
            loop {
                let next = cur.next[lv].clone();
                match next {
                    Some(n) if n.val < target => cur = n,
                    _ => break,
                }
            }
            update[lv] = cur.clone();
        }
        update
    }

    fn search(self, target: i32) -> bool {
        let update = self.find(target);
        let next = update[0].next[0].clone();
        match next {
            Some(n) => n.val == target,
            None => false,
        }
    }

    fn add(mut ref self, num: i32) {
        let update = self.find(num);
        let level = self.random_level();
        let node = A4Node { val: num, next: Vec.filled(level, None) };
        for lv in 0..level {
            node.next[lv] = update[lv].next[lv].clone();
            update[lv].next[lv] = Some(node.clone());
        }
    }

    fn erase(mut ref self, num: i32) -> bool {
        let update = self.find(num);
        let target = match update[0].next[0].clone() {
            Some(n) if n.val == num => n,
            _ => return false,
        };
        let height = target.next.len();
        for lv in 0..height {
            let is_target = match ref update[lv].next[lv] {
                Some(n) => n.ref_eq(target),
                None => false,
            };
            if is_target {
                let after = target.next[lv].clone();
                update[lv].next[lv] = after;
            }
        }
        true
    }
}

// ---- arm 5: arena -------------------------------------------------------
const A5_MAX_LEVEL: i64 = 16;

#[derive(Clone)]
struct A5Node {
    val: i32,
    next: Vec[Option[i64]],
}

struct A5Skiplist {
    nodes: Vec[A5Node],
    rng: u64,
}

impl A5Skiplist {
    fn new() -> Self {
        A5Skiplist {
            nodes: [A5Node { val: i32.MIN, next: Vec.filled(A5_MAX_LEVEL, None) }],
            rng: 12345,
        }
    }

    fn level(mut ref self) -> i64 {
        let mut lv = 1;
        while lv < A5_MAX_LEVEL {
            self.rng = self.rng.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
            if (self.rng >> 33) % 2 == 0 {
                break;
            }
            lv += 1;
        }
        lv
    }

    fn predecessors(self, target: i32) -> Array[i64, A5_MAX_LEVEL] {
        let mut prev = [0; A5_MAX_LEVEL];
        let mut cur: i64 = 0;
        for lv in (0..A5_MAX_LEVEL).rev() {
            while let Some(nx) = self.nodes[cur].next[lv] {
                if self.nodes[nx].val < target {
                    cur = nx;
                } else {
                    break;
                }
            }
            prev[lv] = cur;
        }
        prev
    }

    fn search(self, target: i32) -> bool {
        let prev = self.predecessors(target);
        match self.nodes[prev[0]].next[0] {
            Some(nx) => self.nodes[nx].val == target,
            None => false,
        }
    }

    fn add(mut ref self, num: i32) {
        let prev = self.predecessors(num);
        let lv = self.level();
        let id = self.nodes.len();
        let mut node = A5Node { val: num, next: Vec.filled(lv, None) };
        for i in 0..lv {
            node.next[i] = self.nodes[prev[i]].next[i];
            self.nodes[prev[i]].next[i] = Some(id);
        }
        self.nodes.push(node);
    }

    fn erase(mut ref self, num: i32) -> bool {
        let prev = self.predecessors(num);
        let target = match self.nodes[prev[0]].next[0] {
            Some(nx) if self.nodes[nx].val == num => nx,
            _ => return false,
        };
        for i in 0..self.nodes[target].next.len() {
            if self.nodes[prev[i]].next[i] == Some(target) {
                self.nodes[prev[i]].next[i] = self.nodes[target].next[i];
            }
        }
        true
    }
}

// ---- the statement read literally -----------------------------------------

// The values held in a `Vec` in the order they were added: a search looks
// at every one, an add pushes, and an erase removes the first equal one.
fn literal(ops: Vec[(i64, i32)]) -> Vec[bool] {
    let mut held: Vec[i32] = Vec.new();
    let mut answers = Vec.new();
    for (op, v) in ops.iter() {
        if op == 0 {
            answers.push(held.contains(v));
        } else if op == 1 {
            held.push(v);
            answers.push(true);
        } else {
            let mut at = -1;
            for i in 0..held.len() {
                if at < 0 and held[i] == v {
                    at = i;
                }
            }
            if at >= 0 {
                held.remove(at);
            }
            answers.push(at >= 0);
        }
    }
    answers
}

// ---- the differential -----------------------------------------------------

fn play0(ops: Vec[(i64, i32)]) -> Vec[bool] {
    let mut list = A0Skiplist.new();
    ops.iter().map(|(op, v)| if op == 0 { list.search(v) } else if op == 1 { list.add(v); true } else { list.erase(v) }).collect()
}

fn play1(ops: Vec[(i64, i32)]) -> Vec[bool] {
    let mut list = A1Skiplist.new();
    ops.iter().map(|(op, v)| if op == 0 { list.search(v) } else if op == 1 { list.add(v); true } else { list.erase(v) }).collect()
}

fn play2(ops: Vec[(i64, i32)]) -> Vec[bool] {
    let mut list = A2Skiplist.new();
    ops.iter().map(|(op, v)| if op == 0 { list.search(v) } else if op == 1 { list.add(v); true } else { list.erase(v) }).collect()
}

fn play3(ops: Vec[(i64, i32)]) -> Vec[bool] {
    let mut list = A3Skiplist.new();
    ops.iter().map(|(op, v)| if op == 0 { list.search(v) } else if op == 1 { list.add(v); true } else { list.erase(v) }).collect()
}

fn play4(ops: Vec[(i64, i32)]) -> Vec[bool] {
    let mut list = A4Skiplist.new();
    ops.iter().map(|(op, v)| if op == 0 { list.search(v) } else if op == 1 { list.add(v); true } else { list.erase(v) }).collect()
}

fn play5(ops: Vec[(i64, i32)]) -> Vec[bool] {
    let mut list = A5Skiplist.new();
    ops.iter().map(|(op, v)| if op == 0 { list.search(v) } else if op == 1 { list.add(v); true } else { list.erase(v) }).collect()
}
fn arms(ops: Vec[(i64, i32)]) -> Vec[Vec[bool]] {
    [play0(ops), play1(ops), play2(ops), play3(ops), play4(ops), play5(ops)]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["the statement read literally", "an erase answers as a search just before it does", "a search just after an add finds the value", "every value one more gives the same answers", "erasing each value until refused erases as many as are held", "after that every search finds nothing", "the ★ arm's answers"];
    let mut fails = Vec.filled(7, 0);
    let mut checks = 0;
    let mut check = 0;
    let mut seed = 1206;
    for _ in 0..1000 {
        // 1 to 40 calls on values below 2, 4 or 8
        let count = next_random(mut seed) % 40 + 1;
        let top = [2, 4, 8][next_random(mut seed) % 3];
        let ops: Vec[(i64, i32)] = (0..count).map(|_| (next_random(mut seed) % 3, (next_random(mut seed) % top) as i32)).collect();
        let want = literal(ops);
        let got = arms(ops);
        let mut probed: Vec[(i64, i32)] = Vec.new();
        let mut followed: Vec[(i64, i32)] = Vec.new();
        for (op, v) in ops.iter() {
            if op == 2 {
                probed.push((0, v));
            }
            probed.push((op, v));
            followed.push((op, v));
            if op == 1 {
                followed.push((0, v));
            }
        }
        let shifted: Vec[(i64, i32)] = ops.iter().map(|(op, v)| (op, v + 1)).collect();
        // How many of each value the literal reading holds at the end.
        let mut held = Vec.filled(top, 0);
        for i in 0..count {
            let (op, v) = ops[i];
            if op == 1 {
                held[v] += 1;
            } else if op == 2 and want[i] {
                held[v] -= 1;
            }
        }
        let mut cleared = ops.clone();
        for v in 0..top {
            for _ in 0..held[v] + 1 {
                cleared.push((2, v as i32));
            }
        }
        for v in 0..top {
            cleared.push((0, v as i32));
        }
        let probes = arms(probed);
        let follows = arms(followed);
        let shifts = arms(shifted);
        let clears = arms(cleared);
        for k in 0..6 {
            let a = ref got[k];
            // P2: each erase against the search placed just before it.
            let mut p2 = true;
            let mut j = 0;
            for (op, _) in ops.iter() {
                if op == 2 {
                    p2 = p2 and probes[k][j] == probes[k][j + 1];
                    j += 2;
                } else {
                    j += 1;
                }
            }
            // P3: each search placed just after an add.
            let mut p3 = true;
            let mut j = 0;
            for (op, _) in ops.iter() {
                if op == 1 {
                    p3 = p3 and follows[k][j + 1];
                    j += 2;
                } else {
                    j += 1;
                }
            }
            // P5 and P6: the erases and searches after the calls.
            let mut p5 = true;
            let mut j = count;
            for v in 0..top {
                for e in 0..held[v] + 1 {
                    p5 = p5 and clears[k][j] == (e < held[v]);
                    j += 1;
                }
            }
            let p6 = (j..clears[k].len()).all(|i| not clears[k][i]);
            let held_ok = [a == want, p2, p3, shifts[k] == a, p5, p6, a == got[0]];
            for p in 0..7 {
                checks += 1;
                if not held_ok[p] {
                    fails[p] += 1;
                    if fails[p] <= 2 {
                        println(f"P{p + 1} ({names[p]}) fails on arm {k}: {ops}");
                    }
                }
            }
        }
        for b in got[0].iter() {
            check = (check * 131 + if b { 2 } else { 1 }) % 1000000007;
        }
        check = (check * 131 + 7) % 1000000007;
    }
    for p in 0..7 {
        if fails[p] > 0 {
            println(f"P{p + 1}: {fails[p]} failures");
        }
    }
    let total = fails.iter().sum();
    println(f"1000 cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
}
