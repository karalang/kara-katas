// LeetCode #1206: Design Skiplist -- another Rust solution: the nodes in a
// `Vec<Node>` indexed by `usize`, each node's links a `Vec<Option<usize>>`,
// the walk down by `while let Some(nx) = self.nodes[cur].next[lv]`, and
// the height from a linear congruential generator, carried to Kāra by
// `karac fix`.

const MAX_LEVEL: i64 = 16;

#[derive(Clone)]
struct Node {
    val: i32,
    next: Vec[Option[i64]],
}

struct Skiplist {
    nodes: Vec[Node],
    rng: u64,
}

impl Skiplist {
    fn new() -> Self {
        Skiplist {
            nodes: [Node { val: i32.MIN, next: Vec.filled(MAX_LEVEL, None) }],
            rng: 12345,
        }
    }

    fn level(mut ref self) -> i64 {
        let mut lv = 1;
        while lv < MAX_LEVEL {
            self.rng = self.rng.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
            if (self.rng >> 33) % 2 == 0 {
                break;
            }
            lv += 1;
        }
        lv
    }

    fn predecessors(self, target: i32) -> Array[i64, MAX_LEVEL] {
        let mut prev = [0; MAX_LEVEL];
        let mut cur: i64 = 0;
        for lv in (0..MAX_LEVEL).rev() {
            while let Some(nx) = self.nodes[cur].next[lv] {
                if self.nodes[nx].val < target {
                    cur = nx;
                } else {
                    break;
                }
            }
            prev[lv] = cur;
        }
        prev
    }

    fn search(self, target: i32) -> bool {
        let prev = self.predecessors(target);
        match self.nodes[prev[0]].next[0] {
            Some(nx) => self.nodes[nx].val == target,
            None => false,
        }
    }

    fn add(mut ref self, num: i32) {
        let prev = self.predecessors(num);
        let lv = self.level();
        let id = self.nodes.len();
        let mut node = Node { val: num, next: Vec.filled(lv, None) };
        for i in 0..lv {
            node.next[i] = self.nodes[prev[i]].next[i];
            self.nodes[prev[i]].next[i] = Some(id);
        }
        self.nodes.push(node);
    }

    fn erase(mut ref self, num: i32) -> bool {
        let prev = self.predecessors(num);
        let target = match self.nodes[prev[0]].next[0] {
            Some(nx) if self.nodes[nx].val == num => nx,
            _ => return false,
        };
        for i in 0..self.nodes[target].next.len() {
            if self.nodes[prev[i]].next[i] == Some(target) {
                self.nodes[prev[i]].next[i] = self.nodes[target].next[i];
            }
        }
        true
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random calls, a third each of search, add and erase, on values
// below `top`, as `i32`, the type LeetCode gives; every answer folded into a checksum, with how many searches
// and erases found their value.
fn run(seed: mut ref i64, count: i64, top: i64) -> String {
    let mut list = Skiplist.new();
    let mut found = 0;
    let mut erased = 0;
    let mut check = 0;
    for _ in 0..count {
        let op = next_random(mut seed) % 3;
        let v = ((next_random(mut seed) * 32768 + next_random(mut seed)) % top) as i32;
        let answer = if op == 0 {
            let hit = list.search(v);
            if hit {
                found += 1;
            }
            hit
        } else if op == 1 {
            list.add(v);
            true
        } else {
            let hit = list.erase(v);
            if hit {
                erased += 1;
            }
            hit
        };
        check = (check * 131 + op * 2 + if answer { 1 } else { 0 }) % 1000000007;
    }
    f"{found} found, {erased} erased, checksum {check}"
}

fn main() {
    let mut list = Skiplist.new();
    list.add(1);
    list.add(2);
    list.add(3);
    println(f"search(0): {list.search(0)}");
    list.add(4);
    println(f"search(1): {list.search(1)}");
    println(f"erase(0): {list.erase(0)}");
    println(f"erase(1): {list.erase(1)}");
    println(f"search(1): {list.search(1)}");
    // Duplicates: three 5s erased one at a time.
    let mut dup = Skiplist.new();
    for _ in 0..3 {
        dup.add(5);
    }
    dup.add(0);
    dup.add(20000);
    let mut gone = Vec.new();
    for _ in 0..4 {
        gone.push(dup.erase(5));
    }
    println(f"three 5s erased four times: {gone}, search(5): {dup.search(5)}, search(0): {dup.search(0)}, search(20000): {dup.search(20000)}");
    // Empty: nothing to find or erase, and an add and erase leave it empty.
    let mut empty = Skiplist.new();
    let before = empty.search(7);
    empty.add(7);
    let erased = empty.erase(7);
    println(f"empty: search(7) {before}, add and erase(7) {erased}, search(7) {empty.search(7)}, erase(7) {empty.erase(7)}");
    // Rising then falling: 0..1000 added, every even one erased.
    let mut stairs = Skiplist.new();
    for v in 0..1000 {
        stairs.add(v as i32);
    }
    for v in (0..1000).rev() {
        if v % 2 == 0 {
            stairs.erase(v as i32);
        }
    }
    let left = (0..1000).filter(|v| stairs.search(v as i32)).count();
    println(f"0..1000 added, the even ones erased: {left} left, search(999) {stairs.search(999)}, search(998) {stairs.search(998)}");
    let mut seed = 1206;
    let mut lines = Vec.new();
    for _ in 0..100 {
        lines.push(run(mut seed, 100, 10));
    }
    let mut check = 0;
    for l in lines.iter() {
        for b in l.bytes().iter() {
            check = (check * 131 + (b as i64)) % 1000000007;
        }
    }
    println(f"100 runs of 100 calls on values below 10: checksum {check}");
    println(f"50000 calls on values below 20001: {run(mut seed, 50000, 20001)}");
    println(f"50000 calls on values below 100: {run(mut seed, 50000, 100)}");
}
