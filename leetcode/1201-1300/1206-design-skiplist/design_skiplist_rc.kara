// LeetCode #1206: Design Skiplist -- a Rust solution as LeetCode's Rust
// users write it: `type Link = Option<Rc<RefCell<Node>>>`, each node's
// links a `Vec<Link>`, the walk down cloning the `Rc` it stands on and
// reading the next one through `borrow()`, the height from a xorshift
// generator kept in the list, carried to Kāra by `karac fix`.

const MAX_LEVEL: i64 = 16;

type Link = Option[Node];

shared struct Node {
    mut val: i32,
    mut next: Vec[Link],
}

struct Skiplist {
    head: Node,
    state: u32,
}

impl Skiplist {
    fn new() -> Self {
        Skiplist {
            head: Node { val: -1, next: Vec.filled(MAX_LEVEL, None) },
            state: 2463534242,
        }
    }

    fn random_level(mut ref self) -> i64 {
        let mut level = 1;
        loop {
            self.state ^= self.state << 13;
            self.state ^= self.state >> 17;
            self.state ^= self.state << 5;
            if level < MAX_LEVEL and self.state & 3 == 0 {
                level += 1;
            } else {
                return level;
            }
        }
    }

    fn find(self, target: i32) -> Vec[Node] {
        let mut update = Vec.filled(MAX_LEVEL, self.head.clone());
        let mut cur = self.head.clone();
        for lv in (0..MAX_LEVEL).rev() {
            loop {
                let next = cur.next[lv].clone();
                match next {
                    Some(n) if n.val < target => cur = n,
                    _ => break,
                }
            }
            update[lv] = cur.clone();
        }
        update
    }

    fn search(self, target: i32) -> bool {
        let update = self.find(target);
        let next = update[0].next[0].clone();
        match next {
            Some(n) => n.val == target,
            None => false,
        }
    }

    fn add(mut ref self, num: i32) {
        let update = self.find(num);
        let level = self.random_level();
        let node = Node { val: num, next: Vec.filled(level, None) };
        for lv in 0..level {
            node.next[lv] = update[lv].next[lv].clone();
            update[lv].next[lv] = Some(node.clone());
        }
    }

    fn erase(mut ref self, num: i32) -> bool {
        let update = self.find(num);
        let target = match update[0].next[0].clone() {
            Some(n) if n.val == num => n,
            _ => return false,
        };
        let height = target.next.len();
        for lv in 0..height {
            let is_target = match ref update[lv].next[lv] {
                Some(n) => n.ref_eq(target),
                None => false,
            };
            if is_target {
                let after = target.next[lv].clone();
                update[lv].next[lv] = after;
            }
        }
        true
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random calls, a third each of search, add and erase, on values
// below `top`, as `i32`, the type LeetCode gives; every answer folded into a checksum, with how many searches
// and erases found their value.
fn run(seed: mut ref i64, count: i64, top: i64) -> String {
    let mut list = Skiplist.new();
    let mut found = 0;
    let mut erased = 0;
    let mut check = 0;
    for _ in 0..count {
        let op = next_random(mut seed) % 3;
        let v = ((next_random(mut seed) * 32768 + next_random(mut seed)) % top) as i32;
        let answer = if op == 0 {
            let hit = list.search(v);
            if hit {
                found += 1;
            }
            hit
        } else if op == 1 {
            list.add(v);
            true
        } else {
            let hit = list.erase(v);
            if hit {
                erased += 1;
            }
            hit
        };
        check = (check * 131 + op * 2 + if answer { 1 } else { 0 }) % 1000000007;
    }
    f"{found} found, {erased} erased, checksum {check}"
}

fn main() {
    let mut list = Skiplist.new();
    list.add(1);
    list.add(2);
    list.add(3);
    println(f"search(0): {list.search(0)}");
    list.add(4);
    println(f"search(1): {list.search(1)}");
    println(f"erase(0): {list.erase(0)}");
    println(f"erase(1): {list.erase(1)}");
    println(f"search(1): {list.search(1)}");
    // Duplicates: three 5s erased one at a time.
    let mut dup = Skiplist.new();
    for _ in 0..3 {
        dup.add(5);
    }
    dup.add(0);
    dup.add(20000);
    let mut gone = Vec.new();
    for _ in 0..4 {
        gone.push(dup.erase(5));
    }
    println(f"three 5s erased four times: {gone}, search(5): {dup.search(5)}, search(0): {dup.search(0)}, search(20000): {dup.search(20000)}");
    // Empty: nothing to find or erase, and an add and erase leave it empty.
    let mut empty = Skiplist.new();
    let before = empty.search(7);
    empty.add(7);
    let erased = empty.erase(7);
    println(f"empty: search(7) {before}, add and erase(7) {erased}, search(7) {empty.search(7)}, erase(7) {empty.erase(7)}");
    // Rising then falling: 0..1000 added, every even one erased.
    let mut stairs = Skiplist.new();
    for v in 0..1000 {
        stairs.add(v as i32);
    }
    for v in (0..1000).rev() {
        if v % 2 == 0 {
            stairs.erase(v as i32);
        }
    }
    let left = (0..1000).filter(|v| stairs.search(v as i32)).count();
    println(f"0..1000 added, the even ones erased: {left} left, search(999) {stairs.search(999)}, search(998) {stairs.search(998)}");
    let mut seed = 1206;
    let mut lines = Vec.new();
    for _ in 0..100 {
        lines.push(run(mut seed, 100, 10));
    }
    let mut check = 0;
    for l in lines.iter() {
        for b in l.bytes().iter() {
            check = (check * 131 + (b as i64)) % 1000000007;
        }
    }
    println(f"100 runs of 100 calls on values below 10: checksum {check}");
    println(f"50000 calls on values below 20001: {run(mut seed, 50000, 20001)}");
    println(f"50000 calls on values below 100: {run(mut seed, 50000, 100)}");
}
