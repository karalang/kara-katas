// LeetCode #1227: Airplane Seat Assignment Probability -- forward along
// the chain of displaced passengers: `displaced` is the probability that
// passenger k finds their seat taken (passenger 1 always does). When a
// displaced passenger k picks, seat 1 and seats k + 1 to n are free, n - k
// + 1 of them, each equally likely; picking seat j between displaces
// passenger j, and picking seat n leaves the last passenger without their
// seat. The answer is 1 less every chance of seat n being picked. O(n).

fn nth_person_gets_nth_seat(n: i64) -> f64 {
    // the chance a passenger before k was displaced and picked seat k
    let mut reaching = 0.0;
    let mut lost = 0.0;
    for k in 1..n {
        let displaced = if k == 1 { 1.0 } else { reaching };
        let each = displaced / (n - k + 1) as f64;
        lost += each;
        reaching += each;
    }
    1.0 - lost
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then three, four and the constraints' top
    for n in [1, 2, 3, 4, 100000] {
        println(f"n={n}: {nth_person_gets_nth_seat(n):.5}");
    }
    // 300 random n from 1 to 3000
    let mut seed = 1227;
    let mut total = 0.0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 3000 + 1;
        let p = nth_person_gets_nth_seat(n);
        total += p;
    }
    println(f"300 random n from 1 to 3000: total {total:.5}");
}
