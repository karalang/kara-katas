// LeetCode #1227: Airplane Seat Assignment Probability -- by the first
// passenger's choice: seat 1 (probability 1/n) and everyone sits in their
// own seat; seat n and the last passenger cannot; seat k between, and
// passengers 2 to k - 1 sit in their own while passenger k faces the same
// problem with n - k + 1 seats, seat 1 standing in for their own. So
// f(n) = (1 + f(2) + ... + f(n - 1)) / n, kept with a running sum. O(n).

fn nth_person_gets_nth_seat(n: i64) -> f64 {
    let mut f = 1.0;
    let mut sum = 0.0;
    for m in 2..=n {
        f = (1.0 + sum) / m as f64;
        sum += f;
    }
    f
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then three, four and the constraints' top
    for n in [1, 2, 3, 4, 100000] {
        println(f"n={n}: {nth_person_gets_nth_seat(n):.5}");
    }
    // 300 random n from 1 to 3000
    let mut seed = 1227;
    let mut total = 0.0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 3000 + 1;
        let p = nth_person_gets_nth_seat(n);
        total += p;
    }
    println(f"300 random n from 1 to 3000: total {total:.5}");
}
