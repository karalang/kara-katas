// LeetCode #1227: Airplane Seat Assignment Probability -- a Rust solution
// as LeetCode's Rust users write it: the recurrence f(n) = 1/n + (n - 2)/n
// f(n - 1) (the first passenger takes seat 1, or any seat but 1 and n and
// hands the same problem one seat smaller to whoever they displace), by
// `Self::` recursion on `i32` with `as f64` casts, carried to Kāra by
// `karac fix`. Recurses n deep.

struct Solution {}

impl Solution {
    pub fn nth_person_gets_nth_seat(n: i32) -> f64 {
        if n == 1 {
            return 1.0;
        }
        1.0 / n as f64 + (n as f64 - 2.0) / n as f64 * Solution.nth_person_gets_nth_seat(n - 1)
    }
}

fn nth_person_gets_nth_seat(n: i64) -> f64 {
    Solution.nth_person_gets_nth_seat(n as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then three, four and the constraints' top
    for n in [1, 2, 3, 4, 100000] {
        println(f"n={n}: {nth_person_gets_nth_seat(n):.5}");
    }
    // 300 random n from 1 to 3000
    let mut seed = 1227;
    let mut total = 0.0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 3000 + 1;
        let p = nth_person_gets_nth_seat(n);
        total += p;
    }
    println(f"300 random n from 1 to 3000: total {total:.5}");
}
