// LeetCode #1227: Airplane Seat Assignment Probability -- another Rust
// solution: f(n) = (1 + f(2) + ... + f(n - 1)) / n in a
// `vec![0.0f64; n + 1]` over `usize`, carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn nth_person_gets_nth_seat(n: i32) -> f64 {
        let n = n as i64;
        let mut dp = Vec.filled(n + 1, 0.0);
        dp[1] = 1.0;
        let mut sum = 0.0;
        for i in 2..=n {
            dp[i] = (1.0 + sum) / i as f64;
            sum += dp[i];
        }
        dp[n]
    }
}

fn nth_person_gets_nth_seat(n: i64) -> f64 {
    Solution.nth_person_gets_nth_seat(n as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then three, four and the constraints' top
    for n in [1, 2, 3, 4, 100000] {
        println(f"n={n}: {nth_person_gets_nth_seat(n):.5}");
    }
    // 300 random n from 1 to 3000
    let mut seed = 1227;
    let mut total = 0.0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 3000 + 1;
        let p = nth_person_gets_nth_seat(n);
        total += p;
    }
    println(f"300 random n from 1 to 3000: total {total:.5}");
}
