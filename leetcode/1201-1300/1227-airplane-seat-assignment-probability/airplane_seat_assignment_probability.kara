// LeetCode #1227: Airplane Seat Assignment Probability -- the ★ arm, the
// closed form. The first passenger's random seat starts a chain: each
// passenger whose seat is taken picks at random among the free seats, and
// the chain ends when someone takes seat 1 (everyone after sits in their
// own) or seat n (the last passenger cannot). Until it ends, seats 1 and n
// are both free and equally likely to be picked, so for n >= 2 the last
// passenger gets their seat with probability 1/2. O(1).

fn nth_person_gets_nth_seat(n: i64) -> f64 {
    if n == 1 { 1.0 } else { 0.5 }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then three, four and the constraints' top
    for n in [1, 2, 3, 4, 100000] {
        println(f"n={n}: {nth_person_gets_nth_seat(n):.5}");
    }
    // 300 random n from 1 to 3000
    let mut seed = 1227;
    let mut total = 0.0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 3000 + 1;
        let p = nth_person_gets_nth_seat(n);
        total += p;
    }
    println(f"300 random n from 1 to 3000: total {total:.5}");
}
