// LeetCode #1202: Smallest String With Swaps -- the union-find kept as
// plain recursion (`find` compresses the whole path on the way back), and
// the indices sorted once by (root, letter) and once by (root, index): the
// k-th of a group in the first order is the letter for the k-th of the
// group in the second.

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    if parent[x] == x {
        return x;
    }
    let r = find(mut parent, parent[x]);
    parent[x] = r;
    r
}

fn smallest_string_with_swaps(s: String, pairs: Vec[Vec[i64]]) -> String {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut parent: Vec[i64] = (0..n).collect();
    for p in pairs.iter() {
        let a = find(mut parent, p[0]);
        let b = find(mut parent, p[1]);
        parent[a] = b;
    }
    let root: Vec[i64] = (0..n).map(|i| find(mut parent, i)).collect();
    let mut by_letter: Vec[i64] = (0..n).collect();
    by_letter.sort_by_key(|i| (root[i], bytes[i]));
    let mut by_index: Vec[i64] = (0..n).collect();
    by_index.sort_by_key(|i| (root[i], i));
    let mut out = bytes.to_vec();
    for k in 0..n {
        out[by_index[k]] = bytes[by_letter[k]];
    }
    String.from_utf8(out).unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn digest(s: String) -> i64 {
    let mut h = 0;
    for b in s.bytes().iter() {
        h = (h * 131 + (b as i64)) % 1000000007;
    }
    h
}

fn random_text(seed: mut ref i64, n: i64, letters: i64) -> String {
    let mut out = String.with_capacity(n);
    for _ in 0..n {
        out.push((b'a' + next_random(mut seed) % letters) as u8 as char);
    }
    out
}

fn main() {
    let cases: Vec[(String, Vec[Vec[i64]])] = [
        ("dcab".to_string(), [[0, 3], [1, 2]]),
        ("dcab".to_string(), [[0, 3], [1, 2], [0, 2]]),
        ("cba".to_string(), [[0, 1], [1, 2]]),
        ("zyx".to_string(), []),
        ("q".to_string(), [[0, 0]]),
        ("udyyek".to_string(), [[3, 3], [3, 0], [5, 1], [3, 1], [3, 4], [3, 5]]),
        ("pwqlmqm".to_string(), [[5, 3], [3, 0], [5, 1], [1, 1], [1, 5], [3, 0], [0, 2]]),
        ("abcd".to_string(), [[3, 0], [0, 3]]),
    ];
    for (s, pairs) in cases.iter() {
        println(f"{s} {pairs}: {smallest_string_with_swaps(s, pairs)}");
    }
    let mut seed = 1202;
    let mut changed = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 12 + 1;
        let s = random_text(mut seed, n, 5);
        let m = next_random(mut seed) % 9;
        let mut pairs: Vec[Vec[i64]] = Vec.new();
        for _ in 0..m {
            pairs.push([next_random(mut seed) % n, next_random(mut seed) % n]);
        }
        let t = smallest_string_with_swaps(s, pairs);
        if t != s {
            changed += 1;
        }
        check = (check * 131 + digest(t)) % 1000000007;
    }
    println(f"1000 random strings: {changed} changed, checksum {check}");
    let n = 100000;
    let s = random_text(mut seed, n, 26);
    let mut pairs: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        pairs.push([(next_random(mut seed) * 32768 + next_random(mut seed)) % n, (next_random(mut seed) * 32768 + next_random(mut seed)) % n]);
    }
    let t = smallest_string_with_swaps(s, pairs);
    println(f"100000 letters, 100000 random pairs: digest {digest(t)}, starts {t.substring(0, 12)}");
    let stride: Vec[Vec[i64]] = (0..n - 2).map(|i| [i, i + 2]).collect();
    let t = smallest_string_with_swaps(s, stride);
    println(f"100000 letters, each joined to the one two on: digest {digest(t)}, starts {t.substring(0, 12)}");
}
