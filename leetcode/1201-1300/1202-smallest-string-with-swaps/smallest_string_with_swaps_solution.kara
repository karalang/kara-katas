// LeetCode #1202: Smallest String With Swaps -- a Rust solution as
// LeetCode's Rust users write it: a `DSU` struct with a recursive
// `find(&mut self, x: usize)`, the groups in a `HashMap<usize,
// Vec<usize>>`, and the answer built in a `Vec<u8>` from `s.as_bytes()`,
// carried to Kāra by `karac fix`.

struct Dsu {
    parent: Vec[i64],
}

impl Dsu {
    fn new(n: i64) -> Self {
        Dsu { parent: (0..n).collect() }
    }

    fn find(mut ref self, x: i64) -> i64 {
        if self.parent[x] != x {
            self.parent[x] = self.find(self.parent[x]);
        }
        self.parent[x]
    }

    fn union(mut ref self, a: i64, b: i64) {
        let ra = self.find(a);
        let rb = self.find(b);
        if ra != rb {
            self.parent[ra] = rb;
        }
    }
}

struct Solution {}

impl Solution {
    pub fn smallest_string_with_swaps(s: String, pairs: Vec[Vec[i32]]) -> String {
        let n = s.len();
        let mut dsu = Dsu.new(n);
        for p in ref pairs {
            dsu.union(p[0], p[1]);
        }
        let mut groups: Map[i64, Vec[i64]] = Map.new();
        for i in 0..n {
            groups.entry(dsu.find(i)).or_insert(Vec.new()).push(i);
        }
        let bytes = s.bytes();
        let mut res = Vec.filled(n, 0u8);
        for (_, idx) in groups.iter() {
            let mut chars: Vec[u8] = idx.iter().map(|i| bytes[i]).collect();
            chars.sort();
            for (k, i) in idx.iter().enumerate() {
                res[i] = chars[k];
            }
        }
        String.from_utf8(res).unwrap()
    }
}

fn smallest_string_with_swaps(s: String, pairs: Vec[Vec[i64]]) -> String {
    let pairs: Vec[Vec[i32]] = pairs.iter().map(|p| p.iter().map(|v| v as i32).collect()).collect();
    Solution.smallest_string_with_swaps(s, pairs)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn digest(s: String) -> i64 {
    let mut h = 0;
    for b in s.bytes().iter() {
        h = (h * 131 + (b as i64)) % 1000000007;
    }
    h
}

fn random_text(seed: mut ref i64, n: i64, letters: i64) -> String {
    let mut out = String.with_capacity(n);
    for _ in 0..n {
        out.push((b'a' + next_random(mut seed) % letters) as u8 as char);
    }
    out
}

fn main() {
    let cases: Vec[(String, Vec[Vec[i64]])] = [
        ("dcab", [[0, 3], [1, 2]]),
        ("dcab", [[0, 3], [1, 2], [0, 2]]),
        ("cba", [[0, 1], [1, 2]]),
        ("zyx", []),
        ("q", [[0, 0]]),
        ("udyyek", [[3, 3], [3, 0], [5, 1], [3, 1], [3, 4], [3, 5]]),
        ("pwqlmqm", [[5, 3], [3, 0], [5, 1], [1, 1], [1, 5], [3, 0], [0, 2]]),
        ("abcd", [[3, 0], [0, 3]]),
    ];
    for (s, pairs) in cases.iter() {
        println(f"{s} {pairs}: {smallest_string_with_swaps(s, pairs)}");
    }
    let mut seed = 1202;
    let mut changed = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 12 + 1;
        let s = random_text(mut seed, n, 5);
        let m = next_random(mut seed) % 9;
        let mut pairs: Vec[Vec[i64]] = Vec.new();
        for _ in 0..m {
            pairs.push([next_random(mut seed) % n, next_random(mut seed) % n]);
        }
        let t = smallest_string_with_swaps(s, pairs);
        if t != s {
            changed += 1;
        }
        check = (check * 131 + digest(t)) % 1000000007;
    }
    println(f"1000 random strings: {changed} changed, checksum {check}");
    let n = 100000;
    let s = random_text(mut seed, n, 26);
    let mut pairs: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        pairs.push([(next_random(mut seed) * 32768 + next_random(mut seed)) % n, (next_random(mut seed) * 32768 + next_random(mut seed)) % n]);
    }
    let t = smallest_string_with_swaps(s, pairs);
    println(f"100000 letters, 100000 random pairs: digest {digest(t)}, starts {t.substring(0, 12)}");
    let stride: Vec[Vec[i64]] = (0..n - 2).map(|i| [i, i + 2]).collect();
    let t = smallest_string_with_swaps(s, stride);
    println(f"100000 letters, each joined to the one two on: digest {digest(t)}, starts {t.substring(0, 12)}");
}
