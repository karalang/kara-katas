// LeetCode #1202 bench: the ★ arm (a union-find over the indices, path
// halving and union by size; each group's letters, sorted, go back to its
// indices in rising order) on one string of 100000 random letters and four
// sets of pairs drawn once: 25000 random pairs, 100000 random pairs, each
// index joined to the one two on, and each to the one 1000 on. Then 10
// rounds over the four, each answer folded into a checksum.

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn smallest_string_with_swaps(s: String, pairs: Vec[Vec[i64]]) -> String {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut parent: Vec[i64] = (0..n).collect();
    let mut size = Vec.filled(n, 1);
    for p in pairs.iter() {
        let mut a = find(mut parent, p[0]);
        let mut b = find(mut parent, p[1]);
        if a != b {
            if size[a] < size[b] {
                let t = a;
                a = b;
                b = t;
            }
            parent[b] = a;
            size[a] += size[b];
        }
    }
    let mut groups: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for i in 0..n {
        let r = find(mut parent, i);
        groups[r].push(i);
    }
    let mut out = bytes.to_vec();
    for g in groups.iter() {
        let mut letters: Vec[u8] = g.iter().map(|i| bytes[i]).collect();
        letters.sort();
        for k in 0..g.len() {
            out[g[k]] = letters[k];
        }
    }
    String.from_utf8(out).unwrap()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_pairs(seed: mut ref i64, n: i64, m: i64) -> Vec[Vec[i64]] {
    let mut pairs: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        pairs.push([a, b]);
    }
    pairs
}

fn main() {
    let n = 100000;
    let mut seed = 1202;
    let mut s = String.with_capacity(n);
    for _ in 0..n {
        s.push((b'a' + next_random(mut seed) % 26) as u8 as char);
    }
    let sets = [
        random_pairs(mut seed, n, 25000),
        random_pairs(mut seed, n, 100000),
        (0..n - 2).map(|i| [i, i + 2]).collect(),
        (0..n - 1000).map(|i| [i, i + 1000]).collect(),
    ];
    let mut check = 0;
    for _ in 0..10 {
        for pairs in sets.iter() {
            let t = smallest_string_with_swaps(s, pairs);
            for b in t.bytes().iter() {
                check = (check * 131 + (b as i64)) % 1000000007;
            }
        }
    }
    println(f"10 rounds over 4 sets of pairs on 100000 letters: checksum {check}");
}
