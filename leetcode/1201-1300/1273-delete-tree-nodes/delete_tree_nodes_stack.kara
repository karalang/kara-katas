// LeetCode #1273: Delete Tree Nodes -- by an explicit stack: the nodes
// taken in depth-first order, each pushed back once more after its
// children so it is finished after them, and its sum and count folded
// into its parent's when it is. O(n), no recursion.

fn delete_tree_nodes(nodes: i64, parent: Vec[i64], value: Vec[i64]) -> i64 {
    let mut children: Vec[Vec[i64]] = Vec.filled(nodes, Vec.new());
    for i in 1..nodes {
        children[parent[i]].push(i);
    }
    let mut sum = value.clone();
    let mut kept = Vec.filled(nodes, 1);
    let mut stack: Vec[(i64, bool)] = [(0, false)];
    while let Some((node, done)) = stack.pop() {
        if not done {
            stack.push((node, true));
            for child in children[node].iter() {
                stack.push((child, false));
            }
            continue;
        }
        if sum[node] == 0 {
            kept[node] = 0;
        }
        if node != 0 {
            sum[parent[node]] += sum[node];
            kept[parent[node]] += kept[node];
        }
    }
    kept[0]
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random tree of `n` nodes rooted at 0: each new node hangs from one
// already placed (from one of the last `reach`, so a small reach makes a
// deep tree), then the labels other than 0 shuffled, so a parent's label
// can be larger than its child's.
fn random_parents(n: i64, reach: i64, seed: mut ref i64) -> Vec[i64] {
    let mut order: Vec[i64] = (0..n).collect();
    for i in (2..n).rev() {
        let j = 1 + next_random(mut seed) % i;
        order.swap(i, j);
    }
    let mut parent = Vec.filled(n, -1);
    for i in 1..n {
        let back = 1 + next_random(mut seed) % reach.min(i);
        parent[order[i]] = order[i - back];
    }
    parent
}

fn main() {
    // LeetCode's examples
    let parent = [-1, 0, 0, 1, 2, 2, 2];
    println(f"{delete_tree_nodes(7, parent, [1, -2, 4, 0, -2, -1, -1])} {delete_tree_nodes(7, parent, [1, -2, 4, 0, -2, -1, -2])}");
    // 2000 random trees of 1 to 60 nodes, values from -3 to 3 so that sums
    // of zero are common
    let mut seed = 1273;
    let mut left = 0;
    let mut check = 0;
    for case in 0..2000 {
        let n = next_random(mut seed) % 60 + 1;
        let reach = if case % 2 == 0 { 1000 } else { 2 };
        let parent = random_parents(n, reach, mut seed);
        let value: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 7 - 3).collect();
        let got = delete_tree_nodes(n, parent, value);
        left += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random trees: {left} nodes left, checksum {check}");
    // the constraints' top: 10^4 nodes as a path, as a bush, and at random,
    // the values up to 10^5 either way
    let path: Vec[i64] = (0..10000).map(|i| i - 1).collect();
    let bush = random_parents(10000, 10000, mut seed);
    let deep = random_parents(10000, 3, mut seed);
    let wide: Vec[i64] = (0..10000).map(|_| next_random(mut seed) % 200001 - 100000).collect();
    let alternating: Vec[i64] = (0..10000).map(|i| if i % 2 == 0 { 5 } else { -5 }).collect();
    println(f"{delete_tree_nodes(10000, path, alternating)} {delete_tree_nodes(10000, bush, wide)} {delete_tree_nodes(10000, deep, wide)} {delete_tree_nodes(10000, path, wide)}");
}
