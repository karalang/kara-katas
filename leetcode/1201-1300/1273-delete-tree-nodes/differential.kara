// LeetCode #1273: the differential -- the six arms against the statement
// read literally and five more properties, on 2000 random trees.

// arm 0: delete_tree_nodes.kara
fn a0_subtree(node: i64, children: Vec[Vec[i64]], value: Vec[i64]) -> (i64, i64) {
    let mut sum = value[node];
    let mut kept = 1;
    for child in children[node].iter() {
        let (s, k) = a0_subtree(child, children, value);
        sum += s;
        kept += k;
    }
    if sum == 0 {
        (0, 0)
    } else {
        (sum, kept)
    }
}

fn a0_delete_tree_nodes(nodes: i64, parent: Vec[i64], value: Vec[i64]) -> i64 {
    let mut children: Vec[Vec[i64]] = Vec.filled(nodes, Vec.new());
    for i in 1..nodes {
        children[parent[i]].push(i);
    }
    a0_subtree(0, children, value).1
}

// arm 1: delete_tree_nodes_stack.kara
fn a1_delete_tree_nodes(nodes: i64, parent: Vec[i64], value: Vec[i64]) -> i64 {
    let mut children: Vec[Vec[i64]] = Vec.filled(nodes, Vec.new());
    for i in 1..nodes {
        children[parent[i]].push(i);
    }
    let mut sum = value.clone();
    let mut kept = Vec.filled(nodes, 1);
    let mut stack: Vec[(i64, bool)] = [(0, false)];
    while let Some((node, done)) = stack.pop() {
        if not done {
            stack.push((node, true));
            for child in children[node].iter() {
                stack.push((child, false));
            }
            continue;
        }
        if sum[node] == 0 {
            kept[node] = 0;
        }
        if node != 0 {
            sum[parent[node]] += sum[node];
            kept[parent[node]] += kept[node];
        }
    }
    kept[0]
}

// arm 2: delete_tree_nodes_peel.kara
fn a2_delete_tree_nodes(nodes: i64, parent: Vec[i64], value: Vec[i64]) -> i64 {
    let mut waiting = Vec.filled(nodes, 0);
    for i in 1..nodes {
        waiting[parent[i]] += 1;
    }
    let mut sum = value.clone();
    let mut kept = Vec.filled(nodes, 1);
    let mut ready: VecDeque[i64] = (0..nodes).filter(|i| waiting[i] == 0).collect();
    while let Some(node) = ready.pop_front() {
        if sum[node] == 0 {
            kept[node] = 0;
        }
        if node == 0 {
            break;
        }
        let up = parent[node];
        sum[up] += sum[node];
        kept[up] += kept[node];
        waiting[up] -= 1;
        if waiting[up] == 0 {
            ready.push_back(up);
        }
    }
    kept[0]
}

// arm 3: delete_tree_nodes_owned.kara
struct A3Node {
    value: i64,
    children: Vec[A3Node],
}

impl A3Node {
    fn remaining(self) -> (i64, i64) {
        let (sum, kept) = self.children.iter().fold((self.value, 1), |(s, k), c| {
            let (cs, ck) = c.remaining();
            (s + cs, k + ck)
        });
        if sum == 0 { (0, 0) } else { (sum, kept) }
    }
}

fn a3_build(node: i64, children: Vec[Vec[i64]], value: Vec[i64]) -> A3Node {
    A3Node { value: value[node], children: children[node].iter().map(|c| a3_build(c, children, value)).collect() }
}

fn a3_delete_tree_nodes(nodes: i64, parent: Vec[i64], value: Vec[i64]) -> i64 {
    let mut children: Vec[Vec[i64]] = Vec.filled(nodes, Vec.new());
    for i in 1..nodes {
        children[parent[i]].push(i);
    }
    a3_build(0, children, value).remaining().1
}

// arm 4: delete_tree_nodes_shared.kara
shared struct A4TreeNode {
    value: i64,
    children: Vec[A4TreeNode],
}

fn a4_count(node: A4TreeNode) -> (i64, i64) {
    let mut sum = node.value;
    let mut kept = 1;
    for child in node.children.iter() {
        let (s, k) = a4_count(child);
        sum += s;
        kept += k;
    }
    if sum == 0 { (0, 0) } else { (sum, kept) }
}

fn a4_delete_tree_nodes(nodes: i64, parent: Vec[i64], value: Vec[i64]) -> i64 {
    let all: Vec[A4TreeNode] = (0..nodes).map(|i| A4TreeNode { value: value[i], children: Vec.new() }).collect();
    for i in 1..nodes {
        all[parent[i]].children.push(all[i]);
    }
    a4_count(all[0]).1
}

// arm 5: delete_tree_nodes_solution.kara
fn a5_dfs(u: i64, children: Vec[Vec[i64]], value: Vec[i32]) -> (i64, i32) {
    let mut sum = value[u] as i64;
    let mut cnt: i32 = 1;
    for v in ref children[u] {
        let (s, c) = a5_dfs(v, children, value);
        sum += s;
        cnt += c;
    }
    if sum == 0 {
        (0, 0)
    } else {
        (sum, cnt)
    }
}

impl A5Solution {
    pub fn delete_tree_nodes(nodes: i32, parent: Vec[i32], value: Vec[i32]) -> i32 {
        let n = nodes as i64;
        let mut children = Vec.filled(n, Vec.new());
        for i in 1..n {
            children[parent[i]].push(i);
        }
        a5_dfs(0, children, value).1
    }
}

struct A5Solution {}

fn a5_delete_tree_nodes(nodes: i64, parent: Vec[i64], value: Vec[i64]) -> i64 {
    A5Solution.delete_tree_nodes(
        nodes as i32,
        parent.iter().map(|p| p as i32).collect(),
        value.iter().map(|v| v as i32).collect(),
    )
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random tree of `n` nodes rooted at 0: each new node hangs from one
// already placed (from one of the last `reach`, so a small reach makes a
// deep tree), then the labels other than 0 shuffled, so a parent's label
// can be larger than its child's.
fn random_parents(n: i64, reach: i64, seed: mut ref i64) -> Vec[i64] {
    let mut order: Vec[i64] = (0..n).collect();
    for i in (2..n).rev() {
        let j = 1 + next_random(mut seed) % i;
        order.swap(i, j);
    }
    let mut parent = Vec.filled(n, -1);
    for i in 1..n {
        let back = 1 + next_random(mut seed) % reach.min(i);
        parent[order[i]] = order[i - back];
    }
    parent
}

// ---- the differential ------------------------------------------------------

fn arm(k: i64, n: i64, parent: Vec[i64], value: Vec[i64]) -> i64 {
    match k {
        0 => a0_delete_tree_nodes(n, parent, value),
        1 => a1_delete_tree_nodes(n, parent, value),
        2 => a2_delete_tree_nodes(n, parent, value),
        3 => a3_delete_tree_nodes(n, parent, value),
        4 => a4_delete_tree_nodes(n, parent, value),
        _ => a5_delete_tree_nodes(n, parent, value),
    }
}

// The statement read literally: a node's subtree is every node whose chain
// of parents reaches it (itself included), each subtree's sum is added up
// over all the nodes, and a node remains when no subtree holding it sums
// to zero.
fn literal(n: i64, parent: Vec[i64], value: Vec[i64]) -> i64 {
    let holds = |u: i64, v: i64| {
        let mut at = v;
        while at != -1 and at != u {
            at = parent[at];
        }
        at == u
    };
    let sums: Vec[i64] = (0..n).map(|u| (0..n).filter(|v| holds(u, v)).map(|v| value[v]).sum()).collect();
    (0..n).filter(|v| not (0..n).any(|u| holds(u, v) and sums[u] == 0)).count()
}

fn main() {
    let mut seed = 12730;
    let mut fails: Array[i64, 6] = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for case in 0..2000 {
        let n = next_random(mut seed) % 30 + 1;
        let reach = if case % 2 == 0 { 1000 } else { 2 };
        let parent = random_parents(n, reach, mut seed);
        let value: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 5 - 2).collect();
        let want = literal(n, parent, value);
        // the labels other than 0 renamed by a random permutation
        let mut name: Vec[i64] = (0..n).collect();
        for i in (2..n).rev() {
            let j = 1 + next_random(mut seed) % i;
            name.swap(i, j);
        }
        let mut parent2 = Vec.filled(n, -1);
        let mut value2 = Vec.filled(n, 0);
        for v in 0..n {
            parent2[name[v]] = if v == 0 { -1 } else { name[parent[v]] };
            value2[name[v]] = value[v];
        }
        let negated: Vec[i64] = value.iter().map(|x| -x).collect();
        let mut grown_parent = parent.clone();
        grown_parent.push(next_random(mut seed) % n);
        let mut grown_value = value.clone();
        grown_value.push(0);
        let total: i64 = value.iter().sum();
        let star = arm(0, n, parent, value);
        check = (check * 131 + star) % 1000000007;
        for k in 0..6 {
            let got = arm(k, n, parent, value);
            if got != want {
                fails[0] += 1;
            }
            // nothing left exactly when the whole tree sums to zero
            if (got == 0) != (total == 0) {
                fails[1] += 1;
            }
            if arm(k, n, parent2, value2) != got {
                fails[2] += 1;
            }
            if arm(k, n, parent, negated) != got {
                fails[3] += 1;
            }
            // a new leaf of value 0 is removed and changes nothing else
            if arm(k, n + 1, grown_parent, grown_value) != got {
                fails[4] += 1;
            }
            if got != star {
                fails[5] += 1;
            }
            checks += 6;
        }
    }
    let mut total = 0;
    for p in 0..6 {
        if fails[p] > 0 {
            print(f"P{p + 1}: {fails[p]} failures ");
        }
        total += fails[p];
    }
    println(f"2000 trees: checksum {check}, {checks} checks over 6 arms: {total} failures");
}
