// LeetCode #1233 bench: the ★ arm, sorted and each folder kept unless it
// begins with the last kept one and a `/`, over 10 random lists of 4 · 10^4
// folders of 1 to 4 names, drawn once and each solved 10 times.

fn remove_subfolders(folder: Vec[String]) -> Vec[String] {
    let mut sorted = folder.clone();
    sorted.sort();
    let mut kept: Vec[String] = Vec.new();
    for f in sorted.iter() {
        if kept.is_empty() or not f.starts_with(f"{kept[kept.len() - 1]}/") {
            kept.push(f.clone());
        }
    }
    kept
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let letters = ["a", "b", "c", "d", "e", "f", "g", "h"];
    let mut seed = 1233;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..10 {
        let mut seen: Set[String] = Set.new();
        let mut many: Vec[String] = Vec.new();
        while many.len() < 40000 {
            let d = next_random(mut seed) % 4 + 1;
            let mut f = "".to_string();
            for level in 0..d {
                f = f"{f}/";
                for _ in 0..if level == 0 { 4 } else { 2 } {
                    f = f"{f}{letters[next_random(mut seed) % 8]}";
                }
            }
            if not seen.contains(f) {
                seen.insert(f.clone());
                many.push(f);
            }
        }
        lists.push(many);
    }
    let mut kept = 0;
    for _ in 0..10 {
        for list in lists.iter() {
            kept += remove_subfolders(list).len();
        }
    }
    println(f"10 lists of 40000 folders, 10 passes: {kept} kept");
}
