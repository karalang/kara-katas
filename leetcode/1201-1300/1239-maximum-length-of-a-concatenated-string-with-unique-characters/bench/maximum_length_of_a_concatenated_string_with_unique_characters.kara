// LeetCode #1239: Maximum Length of a Concatenated String with Unique
// Characters -- the benchmark: the ★ arm (backtracking over 26-bit masks)
// on 20000 lists of 16 random words of 1 or 2 letters, built once; prints
// the total of the answers and a checksum of them.

fn mask_of(word: String) -> Option[i64] {
    let mut mask = 0;
    for b in word.bytes() {
        let bit = 1 << (b - 97);
        if mask & bit != 0 {
            return None;
        }
        mask |= bit;
    }
    Some(mask)
}

fn search(masks: Vec[i64], at: i64, taken: i64) -> i64 {
    if at == masks.len() {
        return taken.count_ones();
    }
    let mut best = search(masks, at + 1, taken);
    if taken & masks[at] == 0 {
        best = best.max(search(masks, at + 1, taken | masks[at]));
    }
    best
}

fn max_length(arr: Vec[String]) -> i64 {
    let masks: Vec[i64] = arr.iter().filter_map(|w| mask_of(w)).collect();
    search(masks, 0, 0)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1239;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..20000 {
        let mut words = Vec.new();
        for _ in 0..16 {
            let len = next_random(mut seed) % 2 + 1;
            let mut w = String.new();
            for _ in 0..len {
                w.push((b'a' + (next_random(mut seed) % 26) as u8) as char);
            }
            words.push(w);
        }
        lists.push(words);
    }
    let mut total = 0;
    let mut check = 0;
    for words in lists.iter() {
        let best = max_length(words);
        total += best;
        check = (check * 131 + best) % 1000000007;
    }
    println(f"20000 lists of 16 words: total {total}, checksum {check}");
}
