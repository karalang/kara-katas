// LeetCode #1239: Maximum Length of a Concatenated String with Unique
// Characters -- the ★ arm, backtracking over bitmasks: each word with no
// repeated letter becomes a 26-bit mask, and a search over the words in
// order either skips a word or takes it when its mask is disjoint from the
// letters taken so far. The answer is the most bits ever set. O(2^n).

fn mask_of(word: String) -> Option[i64] {
    let mut mask = 0;
    for b in word.bytes() {
        let bit = 1 << (b - 97);
        if mask & bit != 0 {
            return None;
        }
        mask |= bit;
    }
    Some(mask)
}

fn search(masks: Vec[i64], at: i64, taken: i64) -> i64 {
    if at == masks.len() {
        return taken.count_ones();
    }
    let mut best = search(masks, at + 1, taken);
    if taken & masks[at] == 0 {
        best = best.max(search(masks, at + 1, taken | masks[at]));
    }
    best
}

fn max_length(arr: Vec[String]) -> i64 {
    let masks: Vec[i64] = arr.iter().filter_map(|w| mask_of(w)).collect();
    search(masks, 0, 0)
}


// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` words of 1 to `longest` letters, each letter one of the first
// `alphabet` letters, so that words share and repeat letters.
fn random_words(seed: mut ref i64, count: i64, longest: i64, alphabet: i64) -> Vec[String] {
    let mut words = Vec.new();
    for _ in 0..count {
        let len = next_random(mut seed) % longest + 1;
        let mut w = String.new();
        for _ in 0..len {
            w.push((b'a' + (next_random(mut seed) % alphabet) as u8) as char);
        }
        words.push(w);
    }
    words
}

fn main() {
    // LeetCode's three examples, and words that each repeat a letter
    println(f"{max_length(["un", "iq", "ue"])}");
    println(f"{max_length(["cha", "r", "act", "ers"])}");
    println(f"{max_length(["abcdefghijklmnopqrstuvwxyz"])}");
    println(f"{max_length(["aa", "bb"])}");
    // 1000 random lists of 1 to 16 words of 1 to 6 letters, from 8 to 26 letters
    let mut seed = 1239;
    let mut check = 0;
    for _ in 0..1000 {
        let count = next_random(mut seed) % 16 + 1;
        let alphabet = next_random(mut seed) % 19 + 8;
        let words = random_words(mut seed, count, 6, alphabet);
        check = (check * 131 + max_length(words)) % 1000000007;
    }
    println(f"1000 random lists: checksum {check}");
    // the constraints' top: 16 words of one letter each, of up to 4 letters, and
    // 16 copies of the alphabet
    let singles: Vec[String] = (0..16).map(|k| ((b'a' + k as u8) as char).to_string()).collect();
    let long = random_words(mut seed, 16, 4, 26);
    let alphabets: Vec[String] = (0..16).map(|_| "abcdefghijklmnopqrstuvwxyz").collect();
    println(f"16 words: {max_length(singles)}, {max_length(long)}, {max_length(alphabets)}");
}
