// LeetCode #1217 bench: the ★ arm (the odd and the even chips counted,
// the lesser count the cost) on 20000 sets of 100 chips, the constraints'
// most, at positions up to 10^9, drawn once; then 20 rounds over the
// sets, every answer folded into a checksum.

fn min_cost_to_move_chips(position: Vec[i64]) -> i64 {
    let mut odd = 0;
    let mut even = 0;
    for p in position.iter() {
        if p % 2 == 1 {
            odd += 1;
        } else {
            even += 1;
        }
    }
    min(odd, even)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1217;
    let mut sets: Vec[Vec[i64]] = Vec.new();
    for _ in 0..20000 {
        let mut chips: Vec[i64] = Vec.with_capacity(100);
        for _ in 0..100 {
            chips.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1);
        }
        sets.push(chips);
    }
    let mut check = 0;
    for round in 0..20 {
        for chips in sets.iter() {
            check = (check * 131 + min_cost_to_move_chips(chips) + round) % 1000000007;
        }
    }
    println(f"20 rounds over 20000 sets of 100 chips: checksum {check}");
}
