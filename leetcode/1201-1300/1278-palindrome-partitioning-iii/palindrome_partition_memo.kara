// LeetCode #1278: Palindrome Partitioning III -- by memoised recursion: the
// fewest changes for the letters from `start` on in `parts` pieces is the
// best over the first piece's end, its own changes counted by two
// pointers, each answer kept in a `Map` keyed by (start, parts).

fn changes(c: Vec[char], from: i64, to: i64) -> i64 {
    let mut i = from;
    let mut j = to - 1;
    let mut count = 0;
    while i < j {
        if c[i] != c[j] {
            count += 1;
        }
        i += 1;
        j -= 1;
    }
    count
}

fn fewest(c: Vec[char], start: i64, parts: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    let n = c.len();
    if parts == 1 {
        return changes(c, start, n);
    }
    if let Some(known) = memo.get((start, parts)) {
        return known;
    }
    let mut best = n;
    // the first piece leaves at least one letter for each piece after it
    for end in (start + 1)..(n - parts + 2) {
        best = best.min(changes(c, start, end) + fewest(c, end, parts - 1, mut memo));
    }
    memo.insert((start, parts), best);
    best
}

fn palindrome_partition(s: Str, k: i64) -> i64 {
    let c: Vec[char] = s.chars().collect();
    let mut memo: Map[(i64, i64), i64] = Map.new();
    fewest(c, 0, k, mut memo)
}
// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A string of `n` letters from the first `letters` of the alphabet.
fn random_text(n: i64, letters: i64, seed: mut ref i64) -> String {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    let mut s = String.new();
    for _ in 0..n {
        let i = next_random(mut seed) % letters;
        s.push_str(alphabet[i..i + 1]);
    }
    s
}

fn main() {
    // LeetCode's examples
    println(f"{palindrome_partition("abc", 2)} {palindrome_partition("aabbc", 3)} {palindrome_partition("leetcode", 8)}");
    // 2000 random strings of 1 to 30 letters from 2 to 4, cut into 1 to
    // all of them
    let mut seed = 1278;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 30 + 1;
        let s = random_text(n, next_random(mut seed) % 3 + 2, mut seed);
        let k = next_random(mut seed) % n + 1;
        let got = palindrome_partition(s, k);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random strings: {total} changes, checksum {check}");
    // the constraints' top: 100 letters, the same one, two alternating,
    // and at random from all 26, cut into 1, 7 and 100
    let same = "a".repeat(100);
    let alternating = "ab".repeat(50);
    let wide = random_text(100, 26, mut seed);
    println(f"{palindrome_partition(same, 1)} {palindrome_partition(alternating, 1)} {palindrome_partition(alternating, 2)} {palindrome_partition(wide, 1)} {palindrome_partition(wide, 7)} {palindrome_partition(wide, 100)}");
}
