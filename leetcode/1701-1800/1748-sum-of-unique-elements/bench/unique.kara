// LeetCode #1748: Sum of Unique Elements -- the bench (unique.kara): one
// pass with a state per value.

fn sum_of_unique(nums: Vec[i32]) -> i32 {
    let mut seen = [0; 101];
    let mut sum: i32 = 0;
    for x in nums.iter() {
        let i = x as i64;
        if seen[i] == 0 {
            sum += x;
        } else if seen[i] == 1 {
            sum -= x;
        }
        seen[i] = min(seen[i] + 1, 2);
    }
    sum
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 50000;
    let rounds = 10;
    let n = 100;
    let mut seed = 1748;
    let arrays: Vec[Vec[i32]] = (0..count).map(|_| (0..n).map(|_| (next_random(mut seed) % 100 + 1) as i32).collect()).collect();
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in arrays.iter() {
            let answer = sum_of_unique(nums);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {n} values, {rounds} rounds: unique sums add to {sum}, checksum {check}");
}
