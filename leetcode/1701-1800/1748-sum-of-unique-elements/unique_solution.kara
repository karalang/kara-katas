// LeetCode #1748: Sum of Unique Elements -- a Rust solution as LeetCode's
// Rust users write it, carried to Kāra by `karac fix`.
//
// A count per value in a `[0; 101]` array, then the values counted once
// summed with `filter` and `sum`. O(n).

struct Solution {}

impl Solution {
    pub fn sum_of_unique(nums: Vec[i32]) -> i32 {
        let mut cnt = [0; 101];
        for x in ref nums {
            cnt[x as usize] += 1;
        }
        nums.iter().filter(|x| cnt[x as usize] == 1).sum()
    }
}

fn sum_of_unique(nums: Vec[i32]) -> i32 {
    Solution.sum_of_unique(nums)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random arrays of 1 to `most` values from 1 to `top`
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % top + 1) as i32).collect();
        let answer = sum_of_unique(nums);
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} arrays of up to {most} values from 1 to {top}: unique sums add to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, every value from 1 to
    // 100 once, and every one twice
    println(sum_of_unique([1, 2, 3, 2]));
    println(sum_of_unique([1, 1, 1, 1, 1]));
    println(sum_of_unique([1, 2, 3, 4, 5]));
    println(sum_of_unique([100]));
    println(sum_of_unique((1..101).collect()));
    println(sum_of_unique((1..101).chain(1..101).collect()));
    let mut seed = 1748;
    batch(3000, 10, 5, mut seed);
    batch(1000, 100, 50, mut seed);
    batch(1000, 100, 100, mut seed);
}
