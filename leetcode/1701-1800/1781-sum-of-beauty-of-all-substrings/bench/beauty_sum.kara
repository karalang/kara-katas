// LeetCode #1781: Sum of Beauty of All Substrings -- the bench: the ★ arm,
// the letters' counts grown from each start, over 48 strings of 500
// letters built once.

fn beauty_sum(s: String) -> i32 {
    let letters: Vec[char] = s.chars().collect();
    let n = letters.len();
    let mut total: i32 = 0;
    for i in 0..n {
        let mut counts = [0i32; 26];
        for j in i..n {
            counts[letters[j] as u32 - 'a' as u32] += 1;
            let mut most: i32 = 0;
            let mut fewest = n;
            for c in counts {
                if c > 0 {
                    most = most.max(c);
                    fewest = fewest.min(c);
                }
            }
            total += (most - fewest) as i32;
        }
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1781;
    let mut words: Vec[String] = Vec.new();
    for w in 0..48 {
        let letters = 2 + w % 12 * 2;
        let mut s = String.new();
        for _ in 0..500 {
            s.push(char.try_from((97 + next_random(mut seed) % letters) as u32).ok().unwrap());
        }
        words.push(s);
    }
    let mut check = 0;
    for w in 0..48 {
        check = (check * 31 + beauty_sum(words[w])) % 1000000007;
    }
    println(f"48 strings of 500 letters: checksum {check}");
}
