// LeetCode #1781: Sum of Beauty of All Substrings -- a Rust solution as
// LeetCode's Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn beauty_sum(s: String) -> i32 {
        let s = s.bytes();
        let n = s.len();
        let mut ans = 0;
        for i in 0..n {
            let mut cnt = [0; 26];
            for j in i..n {
                cnt[(s[j] - b'a') as usize] += 1;
                let mx = *cnt.iter().max().unwrap();
                let mn = *cnt.iter().filter(|x| x > 0).min().unwrap();
                ans += mx - mn;
            }
        }
        ans
    }
}

fn beauty_sum(s: String) -> i32 {
    Solution.beauty_sum(s)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters from the first `letters` of the alphabet
fn random_word(seed: mut ref i64, n: i64, letters: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(char.try_from((97 + next_random(mut seed) % letters) as u32).ok().unwrap());
    }
    s
}

fn main() {
    // LeetCode's two examples
    println(f"{beauty_sum("aabcb")} {beauty_sum("aabcbaa")}");
    // the edges: one letter; one letter repeated; every letter once; two
    // letters alternating; one letter far more often than another
    println(f"{beauty_sum("z")} {beauty_sum("aaaa")} {beauty_sum("abcdefghijklmnopqrstuvwxyz")} {beauty_sum("abababab")} {beauty_sum("aaaaab")}");
    // the constraints' most: 500 letters at random from all 26, 500 from
    // two, and 500 of one
    let mut seed = 1781;
    let wide = random_word(mut seed, 500, 26);
    let two = random_word(mut seed, 500, 2);
    let same = "q".repeat(500);
    println(f"the most: {beauty_sum(wide)} {beauty_sum(two)} {beauty_sum(same)}");
    // 3000 random cases of 1 to 20 letters from the first 1 to 6
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 20;
        let letters = 1 + next_random(mut seed) % 6;
        check = (check * 31 + beauty_sum(random_word(mut seed, n, letters))) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
