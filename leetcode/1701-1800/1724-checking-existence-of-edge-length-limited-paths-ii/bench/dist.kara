// LeetCode #1724: Checking Existence of Edge Length Limited Paths II --
// the bench, the ★ arm: a union-find that remembers when each link was
// made.
//
// The edges are joined in order of weight into a union-find by rank,
// never compressed, and each node keeps the weight of the edge that hung
// it under its parent. Along any path to a root those weights only grow,
// so the component of x using only edges lighter than the limit has as
// its root the last node reached while the links stay below the limit.
// Two nodes are joined under the limit when those roots are the same.
// O(m log m) to build, O(log n) a query.

struct DistanceLimitedPathsExist {
    parent: Vec[i64],
    joined: Vec[i32],
}

fn root(parent: Slice[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        x = parent[x];
    }
    x
}

impl DistanceLimitedPathsExist {
    fn new(n: i32, edge_list: Vec[Vec[i32]]) -> DistanceLimitedPathsExist {
        let mut edges = edge_list.clone();
        edges.sort_by_key(|e| e[2]);
        let mut parent: Vec[i64] = (0..n as i64).collect();
        let mut joined: Vec[i32] = Vec.filled(n, i32.MAX);
        let mut rank: Vec[i64] = Vec.filled(n, 0);
        for e in edges.iter() {
            let mut a = root(parent, e[0]);
            let mut b = root(parent, e[1]);
            if a == b {
                continue;
            }
            if rank[a] < rank[b] {
                a, b = b, a;
            }
            parent[b] = a;
            joined[b] = e[2];
            if rank[a] == rank[b] {
                rank[a] += 1;
            }
        }
        DistanceLimitedPathsExist { parent, joined }
    }

    // the root of x's component when only edges lighter than `limit` count
    fn root_below(self, x: i64, limit: i32) -> i64 {
        let mut x = x;
        while self.joined[x] < limit {
            x = self.parent[x];
        }
        x
    }

    fn query(self, p: i32, q: i32, limit: i32) -> bool {
        self.root_below(p, limit) == self.root_below(q, limit)
    }
}

// ---- the bench -------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 20;
    let rounds = 50;
    let n = 10000;
    let m = 10000;
    let asked = 10000;
    let top = 1000000000;
    let mut seed = 1724;
    let mut problems: Vec[(Vec[Vec[i32]], Vec[(i32, i32, i32)])] = Vec.new();
    for _ in 0..count {
        let mut edge_list: Vec[Vec[i32]] = Vec.new();
        for _ in 0..m {
            let u = wide(mut seed) % n;
            let mut v = wide(mut seed) % (n - 1);
            if v >= u {
                v += 1;
            }
            edge_list.push([u as i32, v as i32, (wide(mut seed) % top + 1) as i32]);
        }
        let mut queries: Vec[(i32, i32, i32)] = Vec.new();
        for _ in 0..asked {
            let p = wide(mut seed) % n;
            let mut q = wide(mut seed) % (n - 1);
            if q >= p {
                q += 1;
            }
            queries.push((p as i32, q as i32, (wide(mut seed) % top + 1) as i32));
        }
        problems.push((edge_list, queries));
    }
    let mut yes = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (edge_list, queries) in problems.iter() {
            let graph = DistanceLimitedPathsExist.new(n as i32, edge_list);
            for (p, q, limit) in queries.iter() {
                let answer = graph.query(p, q, limit);
                if answer {
                    yes += 1;
                }
                check = (check * 31 + if answer { 2 } else { 1 } + r) % 1000000007;
            }
        }
    }
    println(f"{count} graphs of {n} nodes and {m} edges, {asked} queries each, {rounds} rounds: {yes} paths, checksum {check}");
}
