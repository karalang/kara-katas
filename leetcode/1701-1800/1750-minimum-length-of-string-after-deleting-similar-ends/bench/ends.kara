// LeetCode #1750: Minimum Length of String After Deleting Similar Ends --
// the bench (ends.kara): two pointers.

fn minimum_length(s: String) -> i32 {
    let b = s.bytes();
    let mut left = 0;
    let mut right = b.len() - 1;
    while left < right and b[left] == b[right] {
        let c = b[left];
        while left <= right and b[left] == c {
            left += 1;
        }
        while right >= left and b[right] == c {
            right -= 1;
        }
    }
    (right - left + 1) as i32
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random middle of up to 1000 letters from `a` and `b`, wrapped in
// layers of one letter on both sides until the string is `n` long
fn draw(n: i64, seed: mut ref i64) -> String {
    let alphabet = "ab";
    let mut middle = String.new();
    for _ in 0..next_random(mut seed) % 1000 {
        let k = next_random(mut seed) % 2;
        middle.push_str(alphabet[k..k + 1]);
    }
    let mut front: Vec[String] = Vec.new();
    let mut back = String.new();
    let mut size = middle.len();
    while size < n {
        let k = next_random(mut seed) % 2;
        let letter = alphabet[k..k + 1];
        let before = next_random(mut seed) % 3 + 1;
        let after = next_random(mut seed) % 3 + 1;
        front.push(letter.repeat(before));
        back.push_str(letter.repeat(after));
        size += before + after;
    }
    let mut s = String.new();
    for layer in front.iter().rev() {
        s.push_str(layer);
    }
    s.push_str(middle);
    s.push_str(back);
    s
}

fn main() {
    let count = 50;
    let rounds = 40;
    let n = 100000;
    let mut seed = 1750;
    let strings: Vec[String] = (0..count).map(|_| draw(n, mut seed)).collect();
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for s in strings.iter() {
            let answer = minimum_length(s);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} strings of about {n} letters, {rounds} rounds: lengths add to {sum}, checksum {check}");
}
