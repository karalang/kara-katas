// LeetCode #1770: Maximum Score from Performing Multiplication Operations
// -- the bench: the ★ arm, a table over the operations filled from the last
// one back to the first and kept as one row.

fn maximum_score(nums: Vec[i32], multipliers: Vec[i32]) -> i32 {
    let n = nums.len();
    let m = multipliers.len();
    let mut best: Vec[i32] = Vec.filled(m + 1, 0);
    for i in (0..m).rev() {
        for left in 0..i + 1 {
            let right = n - 1 - (i - left);
            let take_left = multipliers[i] * nums[left] + best[left + 1];
            let take_right = multipliers[i] * nums[right] + best[left];
            best[left] = take_left.max(take_right);
        }
    }
    best[0]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_numbers(seed: mut ref i64, n: i64) -> Vec[i32] {
    let mut v: Vec[i32] = Vec.with_capacity(n);
    for _ in 0..n {
        v.push((next_random(mut seed) % 2001 - 1000) as i32);
    }
    v
}

fn main() {
    let mut seed = 1770;
    let mut numbers: Vec[Vec[i32]] = Vec.new();
    for _ in 0..100 {
        numbers.push(random_numbers(mut seed, 1000));
    }
    let mut weights: Vec[Vec[i32]] = Vec.new();
    for _ in 0..100 {
        weights.push(random_numbers(mut seed, 300));
    }
    let mut check = 0;
    for call in 0..2000 {
        let score = maximum_score(numbers[(check + call * 7919) % 100], weights[(check / 100 + call) % 100]);
        check = (check * 31 + score as i64 % 1000000007 + 1000000007) % 1000000007;
    }
    println(f"2000 calls over 100 lists: checksum {check}");
}
