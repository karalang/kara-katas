// LeetCode #1770: Maximum Score from Performing Multiplication Operations
// -- differential test of the five arms against the statement read
// literally, with five more properties.

// ---- maximum_score.kara ----
fn a0_maximum_score(nums: Vec[i32], multipliers: Vec[i32]) -> i32 {
    let n = nums.len();
    let m = multipliers.len();
    let mut best: Vec[i32] = Vec.filled(m + 1, 0);
    for i in (0..m).rev() {
        for left in 0..i + 1 {
            let right = n - 1 - (i - left);
            let take_left = multipliers[i] * nums[left] + best[left + 1];
            let take_right = multipliers[i] * nums[right] + best[left];
            best[left] = take_left.max(take_right);
        }
    }
    best[0]
}

// ---- maximum_score_memo.kara ----
fn a1_best_from(nums: Vec[i32], multipliers: Vec[i32], memo: mut ref Vec[Vec[Option[i32]]], i: i64, left: i64) -> i32 {
    if i == multipliers.len() {
        return 0;
    }
    if let Some(known) = memo[i][left] {
        return known;
    }
    let right = nums.len() - 1 - (i - left);
    let take_left = multipliers[i] * nums[left] + a1_best_from(nums, multipliers, mut memo, i + 1, left + 1);
    let take_right = multipliers[i] * nums[right] + a1_best_from(nums, multipliers, mut memo, i + 1, left);
    let best = take_left.max(take_right);
    memo[i][left] = Some(best);
    best
}

fn a1_maximum_score(nums: Vec[i32], multipliers: Vec[i32]) -> i32 {
    let m = multipliers.len();
    let mut memo: Vec[Vec[Option[i32]]] = Vec.filled(m, Vec.filled(m, None));
    a1_best_from(nums, multipliers, mut memo, 0, 0)
}

// ---- maximum_score_forward.kara ----
fn a2_maximum_score(nums: Vec[i32], multipliers: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut most: Vec[i32] = [0];
    for (i, mult) in multipliers.iter().enumerate() {
        let mut next: Vec[i32] = Vec.filled(i + 2, i32.MIN);
        for left in 0..i + 1 {
            let right = n - 1 - (i - left);
            next[left + 1] = next[left + 1].max(most[left] + mult * nums[left]);
            next[left] = next[left].max(most[left] + mult * nums[right]);
        }
        most = next;
    }
    most.iter().max().unwrap()
}

// ---- maximum_score_table.kara ----
fn a3_maximum_score(nums: Vec[i32], multipliers: Vec[i32]) -> i32 {
    let n = nums.len();
    let m = multipliers.len();
    let mut dp: Vec[Vec[i32]] = Vec.filled(m + 1, Vec.filled(m + 1, 0));
    for done in (0..m).rev() {
        let mult = multipliers[done];
        for l in 0..=done {
            let r = done - l;
            dp[l][r] = (mult * nums[l] + dp[l + 1][r]).max(mult * nums[n - 1 - r] + dp[l][r + 1]);
        }
    }
    dp[0][0]
}

// ---- maximum_score_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn maximum_score(nums: Vec[i32], multipliers: Vec[i32]) -> i32 {
        let n = nums.len();
        let m = multipliers.len();
        let mut dp = Vec.filled(m + 1, Vec.filled(m + 1, 0i32));
        for i in (0..m).rev() {
            for left in (0..=i).rev() {
                let right = n - 1 - (i - left);
                dp[i][left] = max(
                    multipliers[i] * nums[left] + dp[i + 1][left + 1],
                    multipliers[i] * nums[right] + dp[i + 1][left],
                );
            }
        }
        dp[0][0]
    }
}

fn a4_maximum_score(nums: Vec[i32], multipliers: Vec[i32]) -> i32 {

    A4Solution.maximum_score(nums, multipliers)

}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_numbers(seed: mut ref i64, n: i64, bound: i64) -> Vec[i32] {
    let mut v: Vec[i32] = Vec.with_capacity(n);
    for _ in 0..n {
        v.push((next_random(mut seed) % (2 * bound + 1) - bound) as i32);
    }
    v
}

// the statement read literally: every way of choosing the front or the back
// at each operation, the chosen number removed from what is left, the
// products added up, and the best score kept
fn literal(nums: Vec[i32], multipliers: Vec[i32]) -> i32 {
    let m = multipliers.len();
    let mut most = i32.MIN;
    for choice in 0..(1 << m) {
        let mut rest = nums.clone();
        let mut score: i32 = 0;
        for i in 0..m {
            let x = if (choice >> i) & 1 == 0 { rest.remove(0) } else { rest.pop().unwrap() };
            score += multipliers[i] * x;
        }
        most = most.max(score);
    }
    most
}

fn arm(i: i64, nums: Vec[i32], multipliers: Vec[i32]) -> i32 {
    match i {
        0 => a0_maximum_score(nums, multipliers),
        1 => a1_maximum_score(nums, multipliers),
        2 => a2_maximum_score(nums, multipliers),
        3 => a3_maximum_score(nums, multipliers),
        _ => a4_maximum_score(nums, multipliers),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, nums: Vec[i32], multipliers: Vec[i32]) {
    t.cases += 1;
    let n = nums.len();
    let m = multipliers.len();
    let want = literal(nums, multipliers);
    t.check = (t.check * 31 + want as i64 % 1000000007 + 1000000007) % 1000000007;
    let star = arm(0, nums, multipliers);
    // two ways to play: always the front, always the back
    let all_front: i32 = (0..m).map(|i| multipliers[i] * nums[i]).sum();
    let all_back: i32 = (0..m).map(|i| multipliers[i] * nums[n - 1 - i]).sum();
    let widest = nums.iter().map(|x| x.abs()).max().unwrap();
    let ceiling: i32 = multipliers.iter().map(|y| y.abs() * widest).sum();
    let reversed: Vec[i32] = nums.iter().rev().map(|x| *x).collect();
    let negated: Vec[i32] = nums.iter().map(|x| -x).collect();
    let negated_multipliers: Vec[i32] = multipliers.iter().map(|y| -y).collect();
    let doubled: Vec[i32] = multipliers.iter().map(|y| 2 * y).collect();
    // a number put between the two ends' reach, when there is room
    let mut wider = nums.clone();
    wider.insert(m, 1000);
    for i in 0..5 {
        let what = f"arm {i} on {nums} {multipliers}";
        let got = arm(i, nums, multipliers);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: no worse than always the front or always the back, and no
        // more than every multiplier on the widest number
        expect(mut t, 2, got >= all_front and got >= all_back and got <= ceiling, f"P2 {what}");
        // P3: the numbers reversed give the same score
        expect(mut t, 3, arm(i, reversed, multipliers) == got, f"P3 {what}");
        // P4: both lists negated give the same score, and the multipliers
        // doubled give it doubled
        expect(mut t, 4, arm(i, negated, negated_multipliers) == got and arm(i, nums, doubled) == 2 * got, f"P4 {what}");
        // P5: a number no operation can reach changes nothing
        if n >= 2 * m {
            expect(mut t, 5, arm(i, wider, multipliers) == got, f"P5 {what}");
        }
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[(Vec[i32], Vec[i32])] = [([1, 2, 3], [3, 2, 1]), ([-5, -3, -3, -2, 7, 1], [-10, -5, 3, 4, 6]), ([7], [-3]), ([1, -2, 3], [-1, -1, -1]), ([-4, -1, -9, -2], [-2, -3]), ([5, 0, -5], [0, 2]), ([1, 1, 1, 100, -100], [1, 10]), ([0, 0], [0])];
    let mut seed = 17701;
    // 1992 random cases of 1 to 10 multipliers over up to 10 numbers more,
    // half with values up to 5 either side, so that ties are common
    for _ in 0..1992 {
        let m = 1 + next_random(mut seed) % 10;
        let n = m + next_random(mut seed) % 11;
        let bound = if next_random(mut seed) % 2 == 0 { 1 + next_random(mut seed) % 5 } else { 1 + next_random(mut seed) % 1000 };
        let nums = random_numbers(mut seed, n, bound);
        let multipliers = random_numbers(mut seed, m, bound);
        cases.push((nums, multipliers));
    }
    for j in 0..cases.len() {
        check_case(mut t, cases[j].0, cases[j].1);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
