// LeetCode #1730: Shortest Path to Get Food -- the bench, the ★ arm: a
// breadth-first search from you.
//
// Every step costs the same, so the cells come off a queue in order of
// their distance from you, and the first food to come off is the
// nearest. Each cell gets its distance when first reached, which also
// marks it seen. O(m n).

fn get_food(grid: Vec[Vec[char]]) -> i32 {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut distance: Vec[Vec[i32]] = Vec.filled(rows, Vec.filled(cols, -1));
    let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
    for r in 0..rows {
        for c in 0..cols {
            if grid[r][c] == '*' {
                distance[r][c] = 0;
                queue.push_back((r, c));
            }
        }
    }
    while let Some((r, c)) = queue.pop_front() {
        if grid[r][c] == '#' {
            return distance[r][c];
        }
        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
            let (nr, nc) = (r + dr, c + dc);
            if nr < 0 or nr >= rows or nc < 0 or nc >= cols {
                continue;
            }
            if grid[nr][nc] != 'X' and distance[nr][nc] < 0 {
                distance[nr][nc] = distance[r][c] + 1;
                queue.push_back((nr, nc));
            }
        }
    }
    -1
}

// ---- the bench -------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 10;
    let rounds = 200;
    let side = 200;
    let mut seed = 1730;
    let mut problems: Vec[Vec[Vec[char]]] = Vec.new();
    for _ in 0..count {
        let mut grid: Vec[Vec[char]] = Vec.new();
        for _ in 0..side {
            let row: Vec[char] = (0..side)
                .map(|_| {
                    let r = next_random(mut seed) % 20000;
                    if r < 5000 { 'X' } else if r < 5001 { '#' } else { 'O' }
                })
                .collect();
            grid.push(row);
        }
        let at = (next_random(mut seed) * 32768 + next_random(mut seed)) % (side * side);
        grid[at / side][at % side] = '*';
        problems.push(grid);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for grid in problems.iter() {
            let answer = get_food(grid);
            sum += answer;
            check = (check * 31 + answer + 1 + r) % 1000000007;
        }
    }
    println(f"{count} grids of {side} by {side}, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
