// LeetCode #1713: Minimum Operations to Make a Subsequence -- the bench:
// the ★ arm on 20 random problems of a target of 100000 distinct values
// below 10^9 and an array of 100000 values, half of them from the target,
// LeetCode's largest, all drawn first, each answered 5 times.
//
// The array's values read as their places in the target, and the longest
// rising run of places kept by the smallest tail of each length. O(n log n).

fn min_operations(target: Vec[i32], arr: Vec[i32]) -> i32 {
    let mut place: Map[i32, i64] = Map.new();
    for (i, v) in target.iter().enumerate() {
        place[v] = i;
    }
    let mut tails: Vec[i64] = Vec.new();
    for a in arr.iter() {
        if let Some(p) = place.get(a) {
            let i = tails.partition_point(|t| t < p);
            if i == tails.len() {
                tails.push(p);
            } else {
                tails[i] = p;
            }
        }
    }
    (target.len() - tails.len()) as i32
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 20;
    let rounds = 5;
    let n = 100000;
    let mut seed = 1713;
    let mut problems: Vec[(Vec[i32], Vec[i32])] = Vec.new();
    for _ in 0..count {
        let mut target: Vec[i32] = (0..n).map(|v| v as i32).collect();
        for i in (1..n).rev() {
            let j = wide(mut seed) % (i + 1);
            target.swap(i, j);
        }
        for i in 0..n {
            target[i] = target[i] * 10000 + (next_random(mut seed) % 10000) as i32;
        }
        let mut arr: Vec[i32] = Vec.new();
        for _ in 0..n {
            if next_random(mut seed) % 2 == 0 {
                arr.push(target[wide(mut seed) % n]);
            } else {
                arr.push((wide(mut seed) % 1000000000) as i32);
            }
        }
        problems.push((target, arr));
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (target, arr) in problems.iter() {
            let answer = min_operations(target, arr);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} problems of {n} values, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
