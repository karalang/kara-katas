// LeetCode #1713: Minimum Operations to Make a Subsequence -- the places
// found in a sorted copy of the target, and the tails searched by hand.
//
// No map: the target's values sorted with their places, each value of the
// array looked up by a binary search, and the smallest tail of each run
// length kept as in the ★ arm, its binary search written out. O(n log m).

fn min_operations(target: Vec[i32], arr: Vec[i32]) -> i32 {
    let mut sorted: Vec[(i32, i64)] = target.iter().enumerate().map(|(i, v)| (v, i)).collect();
    sorted.sort();
    let mut tails: Vec[i64] = Vec.new();
    for a in arr.iter() {
        let at = sorted.partition_point(|s| s.0 < a);
        if at == sorted.len() or sorted[at].0 != a {
            continue;
        }
        let p = sorted[at].1;
        let mut lo = 0;
        let mut hi = tails.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if tails[mid] < p {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo == tails.len() {
            tails.push(p);
        } else {
            tails[lo] = p;
        }
    }
    (target.len() - tails.len()) as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random problems: a target of 1 to `most` distinct values, the
// first of a shuffle of 1 to `top`, and an array of 1 to `most` values
// from 1 to `top`; the answers summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let mut values: Vec[i32] = (1..=top).map(|v| v as i32).collect();
        for i in (1..top).rev() {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            values.swap(i, j);
        }
        let t = (next_random(mut seed) * 32768 + next_random(mut seed)) % min(most, top) + 1;
        let target: Vec[i32] = values[0..t].to_vec();
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let arr: Vec[i32] = (0..n).map(|_| ((next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1) as i32).collect();
        let answer = min_operations(target, arr) as i64;
        sum += answer;
        check = (check * 31 + answer + t + n) % 1000000007;
    }
    println(f"{count} problems of up to {most} values from 1 to {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then a target already there, one with
    // nothing in common, and an array that holds the target backwards
    println(min_operations([5, 1, 3], [9, 4, 2, 3, 4]));
    println(min_operations([6, 4, 8, 1, 3, 2], [4, 7, 6, 2, 3, 8, 6, 1]));
    println(min_operations([1, 2, 3], [1, 5, 2, 5, 3]));
    println(min_operations([1, 2], [3, 4, 5]));
    println(min_operations([1, 2, 3, 4], [4, 3, 2, 1]));
    let mut seed = 1713;
    batch(3000, 10, 12, mut seed);
    batch(300, 1000, 1500, mut seed);
    batch(10, 100000, 120000, mut seed);
}
