// LeetCode #1742: Maximum Number of Balls in a Box -- the bench
// (balls.kara): a count for every digit sum.

fn count_balls(low_limit: i32, high_limit: i32) -> i32 {
    let mut boxes = [0i32; 46];
    for ball in low_limit..high_limit + 1 {
        let mut rest = ball;
        let mut sum = 0;
        while rest > 0 {
            sum += rest % 10;
            rest /= 10;
        }
        boxes[sum] += 1;
    }
    *boxes.iter().max().unwrap()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 200;
    let rounds = 20;
    let mut seed = 1742;
    let mut ranges: Vec[(i32, i32)] = Vec.new();
    for _ in 0..count {
        let a = wide(mut seed) % 100000 + 1;
        let b = wide(mut seed) % 100000 + 1;
        ranges.push((min(a, b) as i32, max(a, b) as i32));
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (low, high) in ranges.iter() {
            let answer = count_balls(low, high);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} ranges inside 1 to 100000, {rounds} rounds: largest boxes sum to {sum}, checksum {check}");
}
