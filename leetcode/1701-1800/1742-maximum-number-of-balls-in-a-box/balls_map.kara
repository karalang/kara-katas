// LeetCode #1742: Maximum Number of Balls in a Box -- a `Map` of boxes.
//
// Each ball's digit sum comes from its decimal text, each character's
// digit added up; the boxes are a `Map` from box number to count, filled
// by `entry`, and the answer is the largest of its values. O(n log n).

fn count_balls(low_limit: i32, high_limit: i32) -> i32 {
    let mut boxes: Map[i32, i32] = Map.new();
    for ball in low_limit..high_limit + 1 {
        let number: i32 = f"{ball}".chars().map(|c| c.to_digit(10).unwrap() as i32).sum();
        *boxes.entry(number).or_insert(0) += 1;
    }
    boxes.values().max().unwrap()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random ranges inside 1 to `most`
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let a = wide(mut seed) % most + 1;
        let b = wide(mut seed) % most + 1;
        let (low, high) = (min(a, b) as i32, max(a, b) as i32);
        let answer = count_balls(low, high);
        sum += answer;
        check = (check * 31 + answer + low) % 1000000007;
    }
    println(f"{count} ranges inside 1 to {most}: largest boxes sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one ball, the whole range, and the
    // range that ends where the digit sums peak
    println(count_balls(1, 10));
    println(count_balls(5, 15));
    println(count_balls(19, 28));
    println(count_balls(1, 1));
    println(count_balls(1, 100000));
    println(count_balls(99999, 100000));
    let mut seed = 1742;
    batch(3000, 100, mut seed);
    batch(1000, 100000, mut seed);
}
