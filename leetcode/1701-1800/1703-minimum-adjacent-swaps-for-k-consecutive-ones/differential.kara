// LeetCode #1703: Minimum Adjacent Swaps for K Consecutive Ones -- the
// differential.
//
// Four arms against the statement read literally, on 3000 random arrays
// of 1 to 9 zeros and ones, at least one 1, each with a k from 1 to the
// count of 1s.
//
// P1  the answer is the statement read literally
// P2  the array reversed gives the same answer
// P3  two 0s put in front and one at the end give the same answer
// P4  k one less never costs more, and k = 1 costs nothing
// P5  each arm agrees with at least two of the other three

// ---- minmoves.kara: the ★ arm: each window's cost about its median, by prefix sums of p[j] - j

fn star_arm(nums: Vec[i32], k: i32) -> i32 {
    let mut q: Vec[i64] = Vec.new();
    for (i, v) in nums.iter().enumerate() {
        if v == 1 {
            q.push(i - q.len());
        }
    }
    let mut prefix = [0];
    for x in q.iter() {
        prefix.push(prefix[prefix.len() - 1] + x);
    }
    let mut best = i64.MAX;
    for i in 0..=q.len() - k {
        let end = i + k;
        let m = i + k / 2;
        let left = q[m] * (m - i) - (prefix[m] - prefix[i]);
        let right = (prefix[end] - prefix[m + 1]) - q[m] * (end - m - 1);
        best = min(best, left + right);
    }
    best as i32
}

// ---- minmoves_positions.kara: the positions' own prefix sums, less the block's spread

fn positions_arm(nums: Vec[i32], k: i32) -> i32 {
    let positions: Vec[i64] = nums.iter().enumerate().filter(|(_, v)| v == 1).map(|(i, _)| i).collect();
    let mut sums: Vec[i64] = Vec.filled(positions.len() + 1, 0);
    for j in 0..positions.len() {
        sums[j + 1] = sums[j] + positions[j];
    }
    let k = k as i64;
    let mut best = i64.MAX;
    for i in 0..=positions.len() - k {
        let m = i + k / 2;
        let before = m - i;
        let after = i + k - 1 - m;
        let p = positions[m];
        let lift = before * p - (sums[m] - sums[i]) - before * (before + 1) / 2;
        let drop = (sums[i + k] - sums[m + 1]) - after * p - after * (after + 1) / 2;
        best = min(best, lift + drop);
    }
    best as i32
}

// ---- minmoves_sliding.kara: the cost carried from window to window

fn sliding_arm(nums: Vec[i32], k: i32) -> i32 {
    let mut q: Vec[i64] = Vec.new();
    let mut seen = 0;
    for i in 0..nums.len() {
        if nums[i] == 1 {
            q.push(i - seen);
            seen += 1;
        }
    }
    let k = k as i64;
    let mut m = k / 2;
    let mut cost = 0;
    for j in 0..k {
        cost += (q[j] - q[m]).abs();
    }
    let mut best = cost;
    for i in 0..q.len() - k {
        cost -= q[m] - q[i];
        cost += q[i + k] - q[m];
        let d = q[m + 1] - q[m];
        cost += d * (2 * (m - i) - k);
        m += 1;
        best = min(best, cost);
    }
    best as i32
}

// ---- minmoves_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn min_moves(nums: Vec[i32], k: i32) -> i32 {
        let k = k as i64;
        let mut q: Vec[i64] = Vec.new();
        for (i, x) in nums.iter().enumerate() {
            if x == 1 {
                q.push(i - q.len());
            }
        }
        let n = q.len();
        let mut pre = Vec.filled(n + 1, 0);
        for i in 0..n {
            pre[i + 1] = pre[i] + q[i];
        }
        let mut ans = i64.MAX;
        for i in 0..=n - k {
            let j = i + k - 1;
            let mid = (i + j) / 2;
            let left = q[mid] * (mid - i) - (pre[mid] - pre[i]);
            let right = (pre[j + 1] - pre[mid + 1]) - q[mid] * (j - mid);
            ans = ans.min(left + right);
        }
        ans as i32
    }
}

fn solution_arm(nums: Vec[i32], k: i32) -> i32 {
    SolutionArm.min_moves(nums, k)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every array reachable by swapping two
// neighbours, found a swap at a time, breadth first, from the given one;
// the first with k 1s in a row is reached in the fewest moves
fn literal(nums: Vec[i32], k: i64) -> i64 {
    let mut seen: SortedSet[Vec[i32]] = SortedSet.new();
    let mut layer: Vec[Vec[i32]] = [nums.clone()];
    seen.insert(nums.clone());
    let mut moves = 0;
    loop {
        let mut next: Vec[Vec[i32]] = Vec.new();
        for a in layer.iter() {
            let mut run = 0;
            for v in a.iter() {
                run = if v == 1 { run + 1 } else { 0 };
                if run >= k {
                    return moves;
                }
            }
            for i in 0..a.len() - 1 {
                if a[i] != a[i + 1] {
                    let mut b = a.clone();
                    b.swap(i, i + 1);
                    if not seen.contains(b) {
                        seen.insert(b.clone());
                        next.push(b);
                    }
                }
            }
        }
        layer = next;
        moves += 1;
    }
}

fn arm(a: i64, nums: Vec[i32], k: i64) -> i64 {
    let nums = nums.clone();
    let k = k as i32;
    match a {
        0 => star_arm(nums, k),
        1 => positions_arm(nums, k),
        2 => sliding_arm(nums, k),
        _ => solution_arm(nums, k),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "positions", "sliding", "solution"][a]
}

fn main() {
    let mut seed = 1703;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(Vec[i32], i64)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 9 + 1;
        let lean = next_random(mut seed) % 11;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push(if next_random(mut seed) % 10 < lean { 1 } else { 0 });
        }
        if nums.iter().all(|v| v == 0) {
            nums[next_random(mut seed) % n] = 1;
        }
        let ones = nums.iter().filter(|v| v == 1).count();
        let k = next_random(mut seed) % ones + 1;
        cases.push((nums, k));
    }
    for (p, (nums, k)) in cases.iter().enumerate() {
        let want = literal(nums, k);
        check = (check * 31 + want + k + nums.len()) % 1000000007;
        let reversed: Vec[i32] = nums.iter().rev().collect();
        let mut padded: Vec[i32] = [0, 0];
        padded.extend(nums.iter());
        padded.push(0);
        let mut answers: Vec[i64] = Vec.new();
        for a in 0..4 {
            let got = arm(a, nums, k);
            let fewer = if k == 1 { got != 0 } else { arm(a, nums, k - 1) > got };
            let failed = [got != want, arm(a, reversed, k) != got, arm(a, padded, k) != got, fewer];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({nums}, k {k}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
