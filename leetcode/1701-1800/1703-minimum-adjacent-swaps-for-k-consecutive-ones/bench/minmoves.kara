// LeetCode #1703: Minimum Adjacent Swaps for K Consecutive Ones -- the
// bench: the ★ arm on 50 random arrays of 100000 values, LeetCode's
// longest, each with a random k, all drawn first, each answered 40 times.
//
// Each window of k ones costs the sum of |q[j] - q[m]| about its median,
// q[j] = p[j] - j, from prefix sums. O(n).

fn min_moves(nums: Vec[i32], k: i32) -> i32 {
    let mut q: Vec[i64] = Vec.new();
    for (i, v) in nums.iter().enumerate() {
        if v == 1 {
            q.push(i - q.len());
        }
    }
    let mut prefix = [0];
    for x in q.iter() {
        prefix.push(prefix[prefix.len() - 1] + x);
    }
    let mut best = i64.MAX;
    for i in 0..=q.len() - k {
        let end = i + k;
        let m = i + k / 2;
        let left = q[m] * (m - i) - (prefix[m] - prefix[i]);
        let right = (prefix[end] - prefix[m + 1]) - q[m] * (end - m - 1);
        best = min(best, left + right);
    }
    best as i32
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 50;
    let rounds = 40;
    let n = 100000;
    let mut seed = 1703;
    let mut arrays: Vec[(Vec[i32], i32)] = Vec.new();
    for _ in 0..count {
        // each value a 1 with a chance of its array's own, 1 to 10 in 10
        let lean = next_random(mut seed) % 10 + 1;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push(if next_random(mut seed) % 10 < lean { 1 } else { 0 });
        }
        let ones = nums.iter().filter(|v| v == 1).count();
        let k = (next_random(mut seed) % ones + 1) as i32;
        arrays.push((nums, k));
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, k) in arrays.iter() {
            let answer = min_moves(nums, k) as i64;
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {n} values, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
