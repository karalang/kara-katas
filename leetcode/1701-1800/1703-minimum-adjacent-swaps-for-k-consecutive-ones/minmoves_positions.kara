// LeetCode #1703: Minimum Adjacent Swaps for K Consecutive Ones -- the
// ones' own positions about the median, less the block's spread.
//
// The median one stays at p[m]; the L ones before it go to p[m] - L ..
// p[m] - 1 and the R after it to p[m] + 1 .. p[m] + R. The ones before
// move L * p[m] less their positions' sum less 1 + 2 + .. + L, and the
// ones after likewise; prefix sums of the positions give both. O(n).

fn min_moves(nums: Vec[i32], k: i32) -> i32 {
    let positions: Vec[i64] = nums.iter().enumerate().filter(|(_, v)| v == 1).map(|(i, _)| i).collect();
    let mut sums: Vec[i64] = Vec.filled(positions.len() + 1, 0);
    for j in 0..positions.len() {
        sums[j + 1] = sums[j] + positions[j];
    }
    let k = k as i64;
    let mut best = i64.MAX;
    for i in 0..=positions.len() - k {
        let m = i + k / 2;
        let before = m - i;
        let after = i + k - 1 - m;
        let p = positions[m];
        let lift = before * p - (sums[m] - sums[i]) - before * (before + 1) / 2;
        let drop = (sums[i + k] - sums[m + 1]) - after * p - after * (after + 1) / 2;
        best = min(best, lift + drop);
    }
    best as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random arrays of 1 to `most` values, each a 1 with a chance of
// its array's own from 0 to 10 in 10 and at least one 1, with k from 1 to
// the count of 1s; the answers summed, and a checksum
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let lean = next_random(mut seed) % 11;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push(if next_random(mut seed) % 10 < lean { 1 } else { 0 });
        }
        if nums.iter().all(|v| v == 0) {
            nums[next_random(mut seed) % n] = 1;
        }
        let ones = nums.iter().filter(|v| v == 1).count();
        let k = (next_random(mut seed) % ones + 1) as i32;
        let answer = min_moves(nums, k) as i64;
        sum += answer;
        check = (check * 31 + answer + k) % 1000000007;
    }
    println(f"{count} arrays of up to {most} values: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then k = 1, and three 1s a gap apart
    println(min_moves([1, 0, 0, 1, 0, 1], 2));
    println(min_moves([1, 0, 0, 0, 0, 0, 1, 1], 3));
    println(min_moves([1, 1, 0, 1], 2));
    println(min_moves([0, 0, 1, 0], 1));
    println(min_moves([1, 0, 1, 0, 1], 3));
    let mut seed = 1703;
    batch(3000, 12, mut seed);
    batch(300, 1000, mut seed);
    batch(10, 100000, mut seed);
}
