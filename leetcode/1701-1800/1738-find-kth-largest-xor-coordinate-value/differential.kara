// LeetCode #1738: Find Kth Largest XOR Coordinate Value -- the
// differential.
//
// Four arms against the statement read literally, on 3000 random
// matrices of 1 to 4 by 1 to 4 values below 8, each with a random k.
//
// P1  the answer is the statement read literally
// P2  the matrix transposed gives the same answer
// P3  the answer for k + 1 is at most the answer for k
// P4  a row and a column of zeros put in front give the same answer
// P5  each arm agrees with at least two of the other three

// ---- kth.kara: the ★ arm: a prefix XOR table, then a sort

fn star_arm(matrix: Vec[Vec[i32]], k: i32) -> i32 {
    let (m, n) = (matrix.len(), matrix[0].len());
    let mut prefix: Vec[Vec[i32]] = Vec.filled(m + 1, Vec.filled(n + 1, 0));
    let mut values: Vec[i32] = Vec.with_capacity(m * n);
    for i in 0..m {
        for j in 0..n {
            prefix[i + 1][j + 1] = prefix[i][j + 1] ^ prefix[i + 1][j] ^ prefix[i][j] ^ matrix[i][j];
            values.push(prefix[i + 1][j + 1]);
        }
    }
    values.sort();
    values[values.len() - k]
}

// ---- kth_heap.kara: running XORs, the k largest in a heap

fn heap_arm(matrix: Vec[Vec[i32]], k: i32) -> i32 {
    let n = matrix[0].len();
    let mut columns: Vec[i32] = Vec.filled(n, 0);
    let mut largest: PriorityQueue[i32] = PriorityQueue.new();
    for row in matrix.iter() {
        let mut value: i32 = 0;
        for j in 0..n {
            columns[j] ^= row[j];
            value ^= columns[j];
            largest.push(value);
            if largest.len() > k {
                largest.pop();
            }
        }
    }
    largest.peek().unwrap()
}

// ---- kth_bits.kara: the answer built a bit at a time

fn bits_arm(matrix: Vec[Vec[i32]], k: i32) -> i32 {
    let (m, n) = (matrix.len(), matrix[0].len());
    let mut values: Vec[i32] = Vec.new();
    let mut above: Vec[i32] = Vec.filled(n, 0);
    for i in 0..m {
        let mut row: Vec[i32] = Vec.filled(n, 0);
        for j in 0..n {
            let left = if j > 0 { row[j - 1] } else { 0 };
            let diagonal = if j > 0 { above[j - 1] } else { 0 };
            row[j] = above[j] ^ left ^ diagonal ^ matrix[i][j];
            values.push(row[j]);
        }
        above = row;
    }
    let mut answer = 0;
    for bit in (0..20).rev() {
        let candidate = answer | 1 << bit;
        if values.iter().filter(|v| v >= candidate).count() >= k {
            answer = candidate;
        }
    }
    answer
}

// ---- kth_solution.kara: LeetCode's Rust template, through karac fix

struct Solution {}

impl Solution {
    pub fn kth_largest_value(matrix: Vec[Vec[i32]], k: i32) -> i32 {
        let m = matrix.len();
        let n = matrix[0].len();
        let mut pre = Vec.filled(m + 1, Vec.filled(n + 1, 0i32));
        let mut v = Vec.with_capacity(m * n);
        for i in 1..=m {
            for j in 1..=n {
                pre[i][j] = pre[i - 1][j] ^ pre[i][j - 1] ^ pre[i - 1][j - 1] ^ matrix[i - 1][j - 1];
                v.push(pre[i][j]);
            }
        }
        v.sort_by(|a, b| b.cmp(a));
        v[k as usize - 1]
    }
}

fn solution_arm(matrix: Vec[Vec[i32]], k: i32) -> i32 {
    Solution.kth_largest_value(matrix, k)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: each coordinate's value the XOR of every
// cell from (0, 0) to it, worked out anew, and the k-th largest of them
// the one with fewer than k values above it and at least k at or above
fn literal(matrix: Slice[Vec[i32]], k: i32) -> i32 {
    let (m, n) = (matrix.len(), matrix[0].len());
    let mut values: Vec[i32] = Vec.new();
    for a in 0..m {
        for b in 0..n {
            let mut value = 0i32;
            for i in 0..a + 1 {
                for j in 0..b + 1 {
                    value ^= matrix[i][j];
                }
            }
            values.push(value);
        }
    }
    let k = k as i64;
    *values.iter().find(|v| values.iter().filter(|w| w > v).count() < k and values.iter().filter(|w| w >= v).count() >= k).unwrap()
}

fn arm(a: i64, matrix: Slice[Vec[i32]], k: i32) -> i32 {
    let matrix = matrix.to_vec();
    match a {
        0 => star_arm(matrix, k),
        1 => heap_arm(matrix, k),
        2 => bits_arm(matrix, k),
        _ => solution_arm(matrix, k),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "heap", "bits", "solution"][a]
}

fn main() {
    let mut seed = 1738;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(Vec[Vec[i32]], i32)] = Vec.new();
    for _ in 0..problems {
        let m = next_random(mut seed) % 4 + 1;
        let n = next_random(mut seed) % 4 + 1;
        let mut matrix: Vec[Vec[i32]] = Vec.new();
        for _ in 0..m {
            matrix.push((0..n).map(|_| (next_random(mut seed) % 8) as i32).collect());
        }
        let k = (next_random(mut seed) % (m * n) + 1) as i32;
        cases.push((matrix, k));
    }
    for (p, (matrix, k)) in cases.iter().enumerate() {
        let want = literal(matrix, k);
        check = (check * 31 + want + k) % 1000000007;
        let (m, n) = (matrix.len(), matrix[0].len());
        let transposed: Vec[Vec[i32]] = (0..n).map(|j| (0..m).map(|i| matrix[i][j]).collect()).collect();
        let mut padded: Vec[Vec[i32]] = [Vec.filled(n + 1, 0i32)];
        for row in matrix.iter() {
            let mut r: Vec[i32] = [0];
            r.extend(row.iter());
            padded.push(r);
        }
        let mut answers: Vec[i32] = Vec.new();
        for a in 0..4 {
            let got = arm(a, matrix, k);
            let next_ok = k == m * n or arm(a, matrix, k + 1) <= got;
            let failed = [got != want, arm(a, transposed, k) != got, not next_ok, arm(a, padded, k) != got];
            answers.push(got);
            for t in 0..4 {
                checks += 1;
                if failed[t] {
                    failures += 1;
                    by_property[t + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({matrix}, k {k}), {arm_name(a)}: P{t + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for t in 1..6 {
            if by_property[t] > 0 {
                counts.push(f"P{t}: {by_property[t]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
