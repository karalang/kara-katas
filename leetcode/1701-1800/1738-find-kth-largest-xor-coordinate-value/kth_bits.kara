// LeetCode #1738: Find Kth Largest XOR Coordinate Value -- the answer
// built one bit at a time from the top.
//
// Every value is below 2^20. The answer's bits are decided from the
// highest: with the bits above settled, the next one is 1 exactly when at
// least k values are at least the answer so far with that bit set, since
// the k-th largest is then at least that much. Each decision counts over
// all m n values, which come from the same running XORs as the ★ arm's
// table. O(20 m n).

fn kth_largest_value(matrix: Vec[Vec[i32]], k: i32) -> i32 {
    let (m, n) = (matrix.len(), matrix[0].len());
    let mut values: Vec[i32] = Vec.new();
    let mut above: Vec[i32] = Vec.filled(n, 0);
    for i in 0..m {
        let mut row: Vec[i32] = Vec.filled(n, 0);
        for j in 0..n {
            let left = if j > 0 { row[j - 1] } else { 0 };
            let diagonal = if j > 0 { above[j - 1] } else { 0 };
            row[j] = above[j] ^ left ^ diagonal ^ matrix[i][j];
            values.push(row[j]);
        }
        above = row;
    }
    let mut answer = 0;
    for bit in (0..20).rev() {
        let candidate = answer | 1 << bit;
        if values.iter().filter(|v| v >= candidate).count() >= k {
            answer = candidate;
        }
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random matrices of up to `most` by `most` values below `top`,
// each with a random k
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let m = next_random(mut seed) % most + 1;
        let n = next_random(mut seed) % most + 1;
        let mut matrix: Vec[Vec[i32]] = Vec.new();
        for _ in 0..m {
            matrix.push((0..n).map(|_| (wide(mut seed) % top) as i32).collect());
        }
        let k = (wide(mut seed) % (m * n) + 1) as i32;
        let answer = kth_largest_value(matrix, k);
        sum += answer;
        check = (check * 31 + answer + k) % 1000000007;
    }
    println(f"{count} matrices of up to {most} by {most} values below {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, every k of a 2 by 2 and
    // the largest values
    println(kth_largest_value([[5, 2], [1, 6]], 1));
    println(kth_largest_value([[5, 2], [1, 6]], 2));
    println(kth_largest_value([[5, 2], [1, 6]], 3));
    println(kth_largest_value([[0]], 1));
    println(kth_largest_value([[1000000, 1000000], [1000000, 0]], 4));
    println(kth_largest_value([[1000000, 1], [2, 3]], 1));
    let mut seed = 1738;
    batch(3000, 4, 8, mut seed);
    batch(300, 40, 1000001, mut seed);
    batch(3, 1000, 1000001, mut seed);
}
