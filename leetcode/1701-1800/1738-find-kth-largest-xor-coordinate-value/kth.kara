// LeetCode #1738: Find Kth Largest XOR Coordinate Value -- the ★ arm: every
// coordinate's value from its neighbours', then a sort.
//
// The value of (a, b) is the XOR of the rectangle from (0, 0) to it. XOR
// undoes itself, so it is the value above XOR the value to the left XOR
// the value diagonally above-left, which both of those counted, XOR the
// cell itself. A table one row and one column wider than the matrix, its
// first row and column 0, fills in one pass; the m n values are sorted,
// and the k-th from the top is the answer. O(m n log(m n)).

fn kth_largest_value(matrix: Vec[Vec[i32]], k: i32) -> i32 {
    let (m, n) = (matrix.len(), matrix[0].len());
    let mut prefix: Vec[Vec[i32]] = Vec.filled(m + 1, Vec.filled(n + 1, 0));
    let mut values: Vec[i32] = Vec.with_capacity(m * n);
    for i in 0..m {
        for j in 0..n {
            prefix[i + 1][j + 1] = prefix[i][j + 1] ^ prefix[i + 1][j] ^ prefix[i][j] ^ matrix[i][j];
            values.push(prefix[i + 1][j + 1]);
        }
    }
    values.sort();
    values[values.len() - k]
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random matrices of up to `most` by `most` values below `top`,
// each with a random k
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let m = next_random(mut seed) % most + 1;
        let n = next_random(mut seed) % most + 1;
        let mut matrix: Vec[Vec[i32]] = Vec.new();
        for _ in 0..m {
            matrix.push((0..n).map(|_| (wide(mut seed) % top) as i32).collect());
        }
        let k = (wide(mut seed) % (m * n) + 1) as i32;
        let answer = kth_largest_value(matrix, k);
        sum += answer;
        check = (check * 31 + answer + k) % 1000000007;
    }
    println(f"{count} matrices of up to {most} by {most} values below {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, every k of a 2 by 2 and
    // the largest values
    println(kth_largest_value([[5, 2], [1, 6]], 1));
    println(kth_largest_value([[5, 2], [1, 6]], 2));
    println(kth_largest_value([[5, 2], [1, 6]], 3));
    println(kth_largest_value([[0]], 1));
    println(kth_largest_value([[1000000, 1000000], [1000000, 0]], 4));
    println(kth_largest_value([[1000000, 1], [2, 3]], 1));
    let mut seed = 1738;
    batch(3000, 4, 8, mut seed);
    batch(300, 40, 1000001, mut seed);
    batch(3, 1000, 1000001, mut seed);
}
