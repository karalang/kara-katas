// LeetCode #1738: Find Kth Largest XOR Coordinate Value -- the bench
// (kth.kara): a prefix XOR table, then a sort.

fn kth_largest_value(matrix: Vec[Vec[i32]], k: i32) -> i32 {
    let (m, n) = (matrix.len(), matrix[0].len());
    let mut prefix: Vec[Vec[i32]] = Vec.filled(m + 1, Vec.filled(n + 1, 0));
    let mut values: Vec[i32] = Vec.with_capacity(m * n);
    for i in 0..m {
        for j in 0..n {
            prefix[i + 1][j + 1] = prefix[i][j + 1] ^ prefix[i + 1][j] ^ prefix[i][j] ^ matrix[i][j];
            values.push(prefix[i + 1][j + 1]);
        }
    }
    values.sort();
    values[values.len() - k]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 4;
    let rounds = 5;
    let side = 1000;
    let mut seed = 1738;
    let mut problems: Vec[(Vec[Vec[i32]], i32)] = Vec.new();
    for _ in 0..count {
        let mut matrix: Vec[Vec[i32]] = Vec.new();
        for _ in 0..side {
            matrix.push((0..side).map(|_| (wide(mut seed) % 1000001) as i32).collect());
        }
        let k = (wide(mut seed) % (side * side) + 1) as i32;
        problems.push((matrix, k));
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (matrix, k) in problems.iter() {
            let answer = kth_largest_value(matrix, k);
            sum += answer;
            check = (check * 31 + answer + k + r) % 1000000007;
        }
    }
    println(f"{count} matrices of {side} by {side}, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
