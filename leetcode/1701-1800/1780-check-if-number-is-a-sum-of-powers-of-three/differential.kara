// LeetCode #1780: Check if Number is a Sum of Powers of Three --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- check_powers_of_three.kara ----
fn a0_check_powers_of_three(n: i32) -> bool {
    let mut rest = n;
    while rest > 0 {
        if rest % 3 == 2 {
            return false;
        }
        rest /= 3;
    }
    true
}

// ---- check_powers_of_three_greedy.kara ----
fn a1_check_powers_of_three(n: i32) -> bool {
    let mut rest = n;
    let mut power = 4782969;
    while power > 0 {
        if rest >= power {
            rest -= power;
        }
        power /= 3;
    }
    rest == 0
}

// ---- check_powers_of_three_recursive.kara ----
fn a2_check_powers_of_three(n: i32) -> bool {
    match n % 3 {
        _ if n == 0 => true,
        2 => false,
        _ => a2_check_powers_of_three(n / 3),
    }
}

// ---- check_powers_of_three_sums.kara ----
fn a3_check_powers_of_three(n: i32) -> bool {
    let mut sums: Vec[i32] = [0];
    let mut power: i32 = 1;
    while power <= n {
        let more: Vec[i32] = sums.iter().map(|s| s + power).collect();
        sums.extend(more);
        power *= 3;
    }
    sums.contains(n)
}

// ---- check_powers_of_three_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn check_powers_of_three(n: i32) -> bool {
        let mut n = n;
        while n > 0 {
            if n % 3 == 2 {
                return false;
            }
            n /= 3;
        }
        true
    }
}

fn a4_check_powers_of_three(n: i32) -> bool {
    A4Solution.check_powers_of_three(n)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every choice of distinct powers of three
// up to n, kept when it sums to n
fn literal(n: i32) -> bool {
    let mut powers: Vec[i64] = Vec.new();
    let mut p = 1;
    while p <= n {
        powers.push(p);
        p *= 3;
    }
    for mask in 0..(1 << powers.len()) {
        let mut sum = 0;
        for k in 0..powers.len() {
            if (mask >> k) & 1 == 1 {
                sum += powers[k];
            }
        }
        if sum == n {
            return true;
        }
    }
    false
}

fn arm(i: i64, n: i32) -> bool {
    match i {
        0 => a0_check_powers_of_three(n),
        1 => a1_check_powers_of_three(n),
        2 => a2_check_powers_of_three(n),
        3 => a3_check_powers_of_three(n),
        _ => a4_check_powers_of_three(n),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, n: i32) {
    t.cases += 1;
    let want = literal(n);
    t.check = (t.check * 31 + if want { 2 } else { 1 }) % 1000000007;
    let star = arm(0, n);
    // the largest power of three not above n
    let mut top: i32 = 1;
    while top * 3 <= n {
        top *= 3;
    }
    let rest = n - top;
    let small = n <= 3333332;
    for i in 0..5 {
        let what = f"arm {i} on {n}";
        let got = arm(i, n);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: 3n and 3n + 1 give the same answer as n
        expect(mut t, 2, not small or (arm(i, 3 * n) == got and arm(i, 3 * n + 1) == got), f"P2 {what}");
        // P3: one more than a multiple of three, or a power of three, is
        // true when n / 3 is
        let one = n % 3 == 1 or n == top;
        expect(mut t, 3, not one or n / 3 == 0 or not arm(i, n / 3) or got, f"P3 {what}");
        // P4: 3n + 2 is never a sum
        expect(mut t, 4, not small or not arm(i, 3 * n + 2), f"P4 {what}");
        // P5: n is a sum exactly when the largest power below it leaves less
        // than itself, and that rest is 0 or a sum
        expect(mut t, 5, got == (rest < top and (rest == 0 or arm(i, rest))), f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[i32] = [12, 91, 21, 1, 2, 2187, 28, 1093, 10000000, 7174453, 7174454, 3333332];
    let mut seed = 17801;
    // 1988 random numbers from 1 to 1 to 3000
    for _ in 0..1988 {
        let bound = 1 + next_random(mut seed) % 3000;
        cases.push((1 + next_random(mut seed) % bound) as i32);
    }
    for j in 0..cases.len() {
        check_case(mut t, cases[j]);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
