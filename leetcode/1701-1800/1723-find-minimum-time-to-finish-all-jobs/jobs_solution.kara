// LeetCode #1723: Find Minimum Time to Finish All Jobs -- a Rust solution
// as LeetCode's Rust users write it, carried to Kāra by `karac fix`.
//
// Backtracking over the jobs, the longest first, with a `HashSet` of the
// loads already tried at each level so that two workers with the same
// load are tried once, and a branch cut once it reaches the best answer.

struct Solution {}

impl Solution {
    pub fn minimum_time_required(jobs: own Vec[i32], k: i32) -> i32 {
        let mut jobs = jobs;
        jobs.sort_by(|a, b| b.cmp(a));
        let mut workers = Vec.filled(k, 0);
        let mut ans = i32.MAX;
        Solution.backtrack(jobs, 0, mut workers, mut ans);
        ans
    }

    fn backtrack(jobs: Slice[i32], idx: i64, workers: mut ref Vec[i32], ans: mut ref i32) {
        if idx == jobs.len() {
            let max = *workers.iter().max().unwrap();
            *ans = (*ans).min(max);
            return;
        }
        let mut seen = Set.new();
        for i in 0..workers.len() {
            if not seen.insert(workers[i]) {
                continue;
            }
            if workers[i] + jobs[idx] >= *ans {
                continue;
            }
            workers[i] += jobs[idx];
            Solution.backtrack(jobs, idx + 1, mut workers, mut ans);
            workers[i] -= jobs[idx];
        }
    }
}

fn minimum_time_required(jobs: own Vec[i32], k: i32) -> i32 {
    Solution.minimum_time_required(jobs, k)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` problems of `least` to `most` jobs of 1 to `top` each, and 1 to
// as many workers as jobs
fn batch(count: i64, least: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum: i64 = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = least + next_random(mut seed) % (most - least + 1);
        let jobs: Vec[i32] = (0..n).map(|_| (wide(mut seed) % top + 1) as i32).collect();
        let k = (next_random(mut seed) % n + 1) as i32;
        let answer = minimum_time_required(jobs, k);
        sum += answer;
        check = (check * 31 + answer + n + k) % 1000000007;
    }
    println(f"{count} problems of {least} to {most} jobs up to {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one job, twelve equal jobs for twelve
    // workers, and the same for one
    println(minimum_time_required([3, 2, 3], 3));
    println(minimum_time_required([1, 2, 4, 7, 8], 2));
    println(minimum_time_required([5], 1));
    println(minimum_time_required(Vec.filled(12, 10000000), 12));
    println(minimum_time_required(Vec.filled(12, 10000000), 1));
    let mut seed = 1723;
    batch(3000, 1, 6, 10, mut seed);
    batch(300, 1, 10, 10000000, mut seed);
    batch(20, 12, 12, 10000000, mut seed);
}
