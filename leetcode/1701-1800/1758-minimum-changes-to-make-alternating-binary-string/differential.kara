// LeetCode #1758: Minimum Changes To Make Alternating Binary String --
// differential test of the five arms against the statement read
// literally, with five more properties.

// ---- min_operations.kara ----
fn a0_min_operations(s: String) -> i32 {
    let bytes = s.bytes();
    let mut differ = 0;
    for (i, b) in bytes.iter().enumerate() {
        if (b - b'0') as i64 != i % 2 {
            differ += 1;
        }
    }
    differ.min(bytes.len() - differ) as i32
}

// ---- min_operations_both.kara ----
fn a1_changes_to(s: String, first: char) -> i32 {
    let mut target = String.new();
    let mut next = first;
    for _ in 0..s.len() {
        target.push(next);
        next = if next == '0' { '1' } else { '0' };
    }
    s.chars().zip(target.chars()).filter(|(a, b)| a != b).count() as i32
}

fn a1_min_operations(s: String) -> i32 {
    a1_changes_to(s, '0').min(a1_changes_to(s, '1'))
}

// ---- min_operations_fold.kara ----
fn a2_min_operations(s: String) -> i32 {
    let (zero_first, one_first) = s.bytes().iter().enumerate().fold((0i32, 0i32), |(z, o), (i, b)| {
        if (b == b'1') == (i % 2 == 0) { (z + 1, o) } else { (z, o + 1) }
    });
    zero_first.min(one_first)
}

// ---- min_operations_greedy.kara ----
fn a3_walk(s: String, flip_first: bool) -> i32 {
    let mut flips = if flip_first { 1 } else { 0 };
    let mut last = 0u8;
    for (i, b) in s.bytes().iter().enumerate() {
        let mut c = b;
        if i == 0 and flip_first {
            c = if c == b'0' { b'1' } else { b'0' };
        }
        if i > 0 and c == last {
            c = if c == b'0' { b'1' } else { b'0' };
            flips += 1;
        }
        last = c;
    }
    flips
}

fn a3_min_operations(s: String) -> i32 {
    a3_walk(s, false).min(a3_walk(s, true))
}

// ---- min_operations_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn min_operations(s: String) -> i32 {
        let n = s.len() as i32;
        let mut cnt: i32 = 0;
        for (i, c) in s.chars().enumerate() {
            if (c as u32 as u8 - b'0') as i64 != i % 2 {
                cnt += 1;
            }
        }
        cnt.min(n - cnt)
    }
}

fn a4_min_operations(s: String) -> i32 {
    A4Solution.min_operations(s)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_bits(seed: mut ref i64, n: i64, ones: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(if next_random(mut seed) % 100 < ones { '1' } else { '0' });
    }
    s
}

// the statement read literally: every string of the same length, one bit
// of a mask for each character, kept when no two neighbours are equal,
// and the fewest characters of s that differ from one of them
fn literal(s: String) -> i32 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut best = n;
    for mask in 0..(1 << n) {
        let alternating = (1..n).all(|i| (mask >> i) % 2 != (mask >> (i - 1)) % 2);
        if alternating {
            let differ = (0..n).filter(|i| (mask >> i) % 2 != (bytes[i] - b'0') as i64).count();
            best = best.min(differ);
        }
    }
    best as i32
}

fn arm(i: i64, s: String) -> i32 {
    match i {
        0 => a0_min_operations(s),
        1 => a1_min_operations(s),
        2 => a2_min_operations(s),
        3 => a3_min_operations(s),
        _ => a4_min_operations(s),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, s: String, extra: char) {
    t.cases += 1;
    let want = literal(s);
    t.check = (t.check * 31 + want) % 1000000007;
    let star = arm(0, s);
    let reversed: String = s.chars().rev().collect();
    let flipped: String = s.chars().map(|c| if c == '0' { '1' } else { '0' }).collect();
    let longer = s + extra.to_string();
    for i in 0..5 {
        let what = f"arm {i} on \"{s}\"";
        let got = arm(i, s);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: the string reversed needs the same
        expect(mut t, 2, arm(i, reversed) == got, f"P2 {what}");
        // P3: every character flipped needs the same
        expect(mut t, 3, arm(i, flipped) == got, f"P3 {what}");
        // P4: no more than half the characters
        expect(mut t, 4, got <= s.len() / 2, f"P4 {what}");
        // P5: one more character changes the answer by at most one
        expect(mut t, 5, (arm(i, longer) - got).abs() <= 1, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[String] = ["0100", "10", "1111", "0", "1", "00", "0101010", "101010", "000000000", "1111111111"].iter().map(|s| s.to_string()).collect();
    let mut seed = 17581;
    // 1990 random strings of 1 to 12 characters, the chance of a '1' from
    // 0 to 100 in 100
    for _ in 0..1990 {
        let n = 1 + next_random(mut seed) % 12;
        let chance = next_random(mut seed) % 101;
        cases.push(random_bits(mut seed, n, chance));
    }
    for j in 0..cases.len() {
        let extra = if next_random(mut seed) % 2 == 0 { '0' } else { '1' };
        check_case(mut t, cases[j], extra);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
