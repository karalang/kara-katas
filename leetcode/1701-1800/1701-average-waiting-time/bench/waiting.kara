// LeetCode #1701: Average Waiting Time -- the bench: the ★ arm on 50
// random lists of 100000 customers, LeetCode's longest, arrivals and
// times up to 10^4, all drawn first, each answered 60 times.
//
// The chef finishes each order at the later of its arrival and the last
// finish, plus its time; the waits are summed as an `i64`. O(n).

fn average_waiting_time(customers: Vec[Vec[i32]]) -> f64 {
    let mut finish: i64 = 0;
    let mut waited: i64 = 0;
    for c in customers.iter() {
        finish = max(finish, c[0]) + c[1];
        waited += finish - c[0];
    }
    waited as f64 / customers.len() as f64
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 50;
    let rounds = 60;
    let n = 100000;
    let mut seed = 1701;
    let mut lists: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..count {
        let mut customers: Vec[Vec[i32]] = Vec.new();
        let mut arrival = 0;
        for _ in 0..n {
            // one arrival in ten a step later, up to 10^4, LeetCode's largest
            if next_random(mut seed) % 10 == 0 and arrival < 9999 {
                arrival += 1;
            }
            customers.push([(arrival + 1) as i32, (next_random(mut seed) % 10000 + 1) as i32]);
        }
        lists.push(customers);
    }
    let mut total = 0.0;
    let mut check = 0;
    for r in 0..rounds {
        for customers in lists.iter() {
            let answer = average_waiting_time(customers);
            total += answer;
            check = (check * 31 + (answer * 100000.0).round() as i64 + r) % 1000000007;
        }
    }
    println(f"{count} lists of {n} customers, {rounds} rounds: answers sum to {total:.5}, checksum {check}");
}
