// LeetCode #1701: Average Waiting Time -- the ★ arm: the chef's finishing
// time carried from customer to customer.
//
// A customer's order starts when both they have arrived and the chef is
// free, so the chef finishes at the later of the two plus its time, and
// the customer waits from arrival to then. The waits are summed as an
// `i64` and divided once. O(n).

fn average_waiting_time(customers: Vec[Vec[i32]]) -> f64 {
    let mut finish: i64 = 0;
    let mut waited: i64 = 0;
    for c in customers.iter() {
        finish = max(finish, c[0]) + c[1];
        waited += finish - c[0];
    }
    waited as f64 / customers.len() as f64
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random lists of 1 to `most` customers, each arriving 0 to `gap`
// after the one before and wanting 1 to `top` of the chef's time; the
// answers summed, and a checksum of each answer in units of 10^-5
fn batch(count: i64, most: i64, gap: i64, top: i64, seed: mut ref i64) {
    let mut total = 0.0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut customers: Vec[Vec[i32]] = Vec.new();
        let mut arrival = 0;
        for _ in 0..n {
            arrival += next_random(mut seed) % (gap + 1);
            customers.push([(arrival + 1) as i32, (next_random(mut seed) % top + 1) as i32]);
        }
        let answer = average_waiting_time(customers);
        total += answer;
        check = (check * 31 + (answer * 100000.0).round() as i64) % 1000000007;
    }
    println(f"{count} lists of up to {most} customers: answers sum to {total:.5}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one customer, and three who all
    // arrive at once
    println(f"{average_waiting_time([[1, 2], [2, 5], [4, 3]]):.5}");
    println(f"{average_waiting_time([[5, 2], [5, 4], [10, 3], [20, 1]]):.5}");
    println(f"{average_waiting_time([[7, 4]]):.5}");
    println(f"{average_waiting_time([[1, 1], [1, 1], [1, 1]]):.5}");
    let mut seed = 1701;
    batch(3000, 12, 5, 5, mut seed);
    batch(300, 1000, 100, 100, mut seed);
    batch(10, 100000, 10000, 10000, mut seed);
}
