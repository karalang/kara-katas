// LeetCode #1746: Maximum Subarray Sum After One Operation -- the best
// run on either side of the squared value.
//
// If `nums[i]` is the value squared, the best subarray around it is its
// square plus the best run ending just before it, or nothing, plus the
// best run starting just after it, or nothing. Two passes fill those
// runs, from the left and from the right; every i is then tried. O(n).

fn max_sum_after_operation(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut left: Vec[i32] = Vec.filled(n, 0i32);
    let mut right: Vec[i32] = Vec.filled(n, 0i32);
    for i in 1..n {
        left[i] = max(left[i - 1] + nums[i - 1], 0);
    }
    for i in (0..n - 1).rev() {
        right[i] = max(right[i + 1] + nums[i + 1], 0);
    }
    (0..n).map(|i| left[i] + nums[i] * nums[i] + right[i]).max().unwrap()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random arrays of 1 to `most` values from -`top` to `top`
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % (2 * top + 1) - top) as i32).collect();
        let answer = max_sum_after_operation(nums);
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} arrays of up to {most} values within {top}: sums add to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one value, all negative, and the
    // largest square
    println(max_sum_after_operation([2, -1, -4, -3]));
    println(max_sum_after_operation([1, -1, 1, 1, -1, -1, 1]));
    println(max_sum_after_operation([-7]));
    println(max_sum_after_operation([-3, -9, -2]));
    println(max_sum_after_operation([10000, -10000, 10000]));
    let mut seed = 1746;
    batch(3000, 8, 5, mut seed);
    batch(300, 1000, 10000, mut seed);
    batch(10, 100000, 10000, mut seed);
}
