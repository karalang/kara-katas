// LeetCode #1775: Equal Sum Arrays With Minimum Number of Operations --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- min_operations.kara ----
fn a0_min_operations(nums1: Vec[i32], nums2: Vec[i32]) -> i32 {
    let sum1: i32 = nums1.iter().sum();
    let sum2: i32 = nums2.iter().sum();
    if sum1 == sum2 {
        return 0;
    }
    let (low, high) = if sum1 < sum2 { (nums1, nums2) } else { (nums2, nums1) };
    let mut gap = (sum1 - sum2).abs();
    // gains[g]: how many changes close the gap by g
    let mut gains: Vec[i32] = Vec.filled(6, 0);
    for x in low.iter() {
        gains[6 - x] += 1;
    }
    for x in high.iter() {
        gains[x - 1] += 1;
    }
    let mut ops = 0;
    for g in (1..6).rev() {
        while gains[g] > 0 and gap > 0 {
            gap -= g as i32;
            gains[g] -= 1;
            ops += 1;
        }
    }
    if gap > 0 { -1 } else { ops }
}

// ---- min_operations_sorted.kara ----
fn a1_min_operations(nums1: Vec[i32], nums2: Vec[i32]) -> i32 {
    let sum1: i32 = nums1.iter().sum();
    let sum2: i32 = nums2.iter().sum();
    let (low, high) = if sum1 <= sum2 { (nums1, nums2) } else { (nums2, nums1) };
    let mut gains: Vec[i32] = low.iter().map(|x| 6 - x).chain(high.iter().map(|x| x - 1)).collect();
    gains.sort_by(|a, b| b.cmp(a));
    let mut gap = (sum1 - sum2).abs();
    let mut ops = 0;
    for g in gains.iter() {
        if gap <= 0 {
            break;
        }
        gap -= g;
        ops += 1;
    }
    if gap > 0 { -1 } else { ops }
}

// ---- min_operations_heap.kara ----
fn a2_min_operations(nums1: Vec[i32], nums2: Vec[i32]) -> i32 {
    let sum1: i32 = nums1.iter().sum();
    let sum2: i32 = nums2.iter().sum();
    let mut gap = (sum1 - sum2).abs();
    let mut heap: PriorityQueue[i32] = PriorityQueue.max_first();
    for x in nums1.iter() {
        heap.push(if sum1 < sum2 { 6 - x } else { x - 1 });
    }
    for x in nums2.iter() {
        heap.push(if sum1 < sum2 { x - 1 } else { 6 - x });
    }
    let mut ops = 0;
    while gap > 0 {
        match heap.pop() {
            Some(g) if g > 0 => {
                gap -= g;
                ops += 1;
            }
            _ => return -1,
        }
    }
    ops
}

// ---- min_operations_pointers.kara ----
fn a3_min_operations(nums1: Vec[i32], nums2: Vec[i32]) -> i32 {
    let mut a = nums1.clone();
    let mut b = nums2.clone();
    let mut sum_a: i32 = a.iter().sum();
    let mut sum_b: i32 = b.iter().sum();
    if sum_a > sum_b {
        mem.swap(mut a, mut b);
        mem.swap(mut sum_a, mut sum_b);
    }
    a.sort();
    b.sort();
    b.reverse();
    let mut gap = sum_b - sum_a;
    let mut (i, j) = (0, 0);
    let mut ops = 0;
    while gap > 0 {
        let up = if i < a.len() { 6 - a[i] } else { 0 };
        let down = if j < b.len() { b[j] - 1 } else { 0 };
        if up == 0 and down == 0 {
            return -1;
        }
        if up >= down {
            gap -= up;
            i += 1;
        } else {
            gap -= down;
            j += 1;
        }
        ops += 1;
    }
    ops
}

// ---- min_operations_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn min_operations(nums1: Vec[i32], nums2: Vec[i32]) -> i32 {
        let (s1, s2): (i32, i32) = (nums1.iter().sum(), nums2.iter().sum());
        if s1 == s2 {
            return 0;
        }
        let (small, big) = if s1 < s2 { (ref nums1, ref nums2) } else { (ref nums2, ref nums1) };
        let mut diff = (s1 - s2).abs();
        let mut cnt = [0; 6];
        for x in small.iter() {
            cnt[(6 - x) as usize] += 1;
        }
        for x in big.iter() {
            cnt[(x - 1) as usize] += 1;
        }
        let mut ans = 0;
        for i in (1..6).rev() {
            while cnt[i] > 0 and diff > 0 {
                diff -= i as i32;
                cnt[i] -= 1;
                ans += 1;
            }
        }
        if diff > 0 { -1 } else { ans }
    }
}

fn a4_min_operations(nums1: Vec[i32], nums2: Vec[i32]) -> i32 {

    A4Solution.min_operations(nums1, nums2)

}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_dice(seed: mut ref i64, n: i64, low: i64, high: i64) -> Vec[i32] {
    (0..n).map(|_| (low + next_random(mut seed) % (high - low + 1)) as i32).collect()
}

// the statement read literally: every choice of which numbers to change;
// the changed ones can make any sum from 1 to 6 each, the rest keep theirs,
// so the sums can be made equal when the two ranges of sums meet; the
// fewest changes that do it, or -1
fn literal(nums1: Vec[i32], nums2: Vec[i32]) -> i32 {
    let all: Vec[(i64, i32)] = nums1.iter().map(|x| (1, *x)).chain(nums2.iter().map(|x| (2, *x))).collect();
    let n = all.len();
    let mut fewest = -1;
    for mask in 0..(1 << n) {
        let mut lo = [0, 0];
        let mut hi = [0, 0];
        let mut changed = 0;
        for k in 0..n {
            let (side, x) = all[k];
            let s = side - 1;
            if (mask >> k) & 1 == 1 {
                lo[s] += 1;
                hi[s] += 6;
                changed += 1;
            } else {
                lo[s] += x;
                hi[s] += x;
            }
        }
        if lo[0] <= hi[1] and lo[1] <= hi[0] and (fewest == -1 or changed < fewest) {
            fewest = changed;
        }
    }
    fewest as i32
}

fn arm(i: i64, nums1: Vec[i32], nums2: Vec[i32]) -> i32 {
    match i {
        0 => a0_min_operations(nums1, nums2),
        1 => a1_min_operations(nums1, nums2),
        2 => a2_min_operations(nums1, nums2),
        3 => a3_min_operations(nums1, nums2),
        _ => a4_min_operations(nums1, nums2),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, nums1: Vec[i32], nums2: Vec[i32]) {
    t.cases += 1;
    let want = literal(nums1, nums2);
    t.check = (t.check * 31 + want + 1) % 1000000007;
    let star = arm(0, nums1, nums2);
    let (n1, n2) = (nums1.len(), nums2.len());
    let sum1: i32 = nums1.iter().sum();
    let sum2: i32 = nums2.iter().sum();
    let back1: Vec[i32] = nums1.iter().rev().cloned().collect();
    let back2: Vec[i32] = nums2.iter().rev().cloned().collect();
    let mut more1 = nums1.clone();
    let mut more2 = nums2.clone();
    let die = 1 + (n1 + n2) as i32 % 6;
    more1.push(die);
    more2.push(die);
    for i in 0..5 {
        let what = f"arm {i} on {nums1} {nums2}";
        let got = arm(i, nums1, nums2);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: -1 exactly when one list's most is below the other's least,
        // 0 exactly when the sums are equal, and never more changes than
        // numbers
        let apart = 6 * n1 < n2 or 6 * n2 < n1;
        let ranged = if apart { got == -1 } else { got >= 0 and got <= n1 + n2 and (got == 0) == (sum1 == sum2) };
        expect(mut t, 2, ranged, f"P2 {what}");
        // P3: the lists swapped, and each reversed, give the same answer
        expect(mut t, 3, arm(i, nums2, nums1) == got and arm(i, back1, back2) == got, f"P3 {what}");
        // P4: the same die added to both lists never needs more changes
        let wider = arm(i, more1, more2);
        expect(mut t, 4, got == -1 or (wider >= 0 and wider <= got), f"P4 {what}");
        // P5: a change closes the gap by at most 5, so at least a fifth of
        // it, rounded up, is needed
        expect(mut t, 5, apart or 5 * got >= (sum1 - sum2).abs(), f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[(Vec[i32], Vec[i32])] = [([1, 2, 3, 4, 5, 6], [1, 1, 2, 2, 2, 2]), ([1, 1, 1, 1, 1, 1, 1], [6]), ([6, 6], [1]), ([3], [3]), ([1], [6]), ([1, 1], [6, 6]), ([1, 1, 1, 1, 1, 1], [6]), ([6, 6, 6], [1, 1])];
    let mut seed = 17751;
    // 1992 random cases of 1 to 7 numbers against 1 to 5, each side's dice
    // from its own range
    for _ in 0..1992 {
        let n1 = 1 + next_random(mut seed) % 7;
        let n2 = 1 + next_random(mut seed) % 5;
        let low1 = 1 + next_random(mut seed) % 6;
        let low2 = 1 + next_random(mut seed) % 6;
        let nums1 = random_dice(mut seed, n1, low1, 6);
        let nums2 = random_dice(mut seed, n2, 1, 7 - low2);
        cases.push((nums1, nums2));
    }
    for j in 0..cases.len() {
        check_case(mut t, cases[j].0, cases[j].1);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
