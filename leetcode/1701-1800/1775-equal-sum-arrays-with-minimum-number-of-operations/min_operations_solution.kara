// LeetCode #1775: Equal Sum Arrays With Minimum Number of Operations -- a
// Rust solution as LeetCode's Rust users write it, carried to Kāra by
// `karac fix`

struct Solution {}

impl Solution {
    pub fn min_operations(nums1: Vec[i32], nums2: Vec[i32]) -> i32 {
        let (s1, s2): (i32, i32) = (nums1.iter().sum(), nums2.iter().sum());
        if s1 == s2 {
            return 0;
        }
        let (small, big) = if s1 < s2 { (ref nums1, ref nums2) } else { (ref nums2, ref nums1) };
        let mut diff = (s1 - s2).abs();
        let mut cnt = [0; 6];
        for x in small.iter() {
            cnt[(6 - x) as usize] += 1;
        }
        for x in big.iter() {
            cnt[(x - 1) as usize] += 1;
        }
        let mut ans = 0;
        for i in (1..6).rev() {
            while cnt[i] > 0 and diff > 0 {
                diff -= i as i32;
                cnt[i] -= 1;
                ans += 1;
            }
        }
        if diff > 0 { -1 } else { ans }
    }
}

fn min_operations(nums1: Vec[i32], nums2: Vec[i32]) -> i32 {

    Solution.min_operations(nums1, nums2)

}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n dice from `low` to `high`
fn random_dice(seed: mut ref i64, n: i64, low: i64, high: i64) -> Vec[i32] {
    (0..n).map(|_| (low + next_random(mut seed) % (high - low + 1)) as i32).collect()
}

fn main() {
    // LeetCode's three examples
    println(f"{min_operations([1, 2, 3, 4, 5, 6], [1, 1, 2, 2, 2, 2])} {min_operations([1, 1, 1, 1, 1, 1, 1], [6])} {min_operations([6, 6], [1])}");
    // the edges: equal already; one each, five apart; two each, ten apart;
    // seven ones against one six, out of reach; six ones against one six
    println(f"{min_operations([3], [3])} {min_operations([1], [6])} {min_operations([1, 1], [6, 6])} {min_operations([1, 1, 1, 1, 1, 1, 1], [6])} {min_operations([1, 1, 1, 1, 1, 1], [6])}");
    // the constraints' most: 100000 ones against 100000 sixes, and 100000
    // random dice against 100000 more weighted high
    let mut seed = 1775;
    let ones: Vec[i32] = Vec.filled(100000, 1);
    let sixes: Vec[i32] = Vec.filled(100000, 6);
    let a = random_dice(mut seed, 100000, 1, 6);
    let b = random_dice(mut seed, 100000, 2, 6);
    println(f"the most: {min_operations(ones, sixes)} {min_operations(a, b)}");
    // 3000 random cases of 1 to 20 dice against 1 to 20, each side's dice
    // from its own range
    let mut check = 0;
    for _ in 0..3000 {
        let n1 = 1 + next_random(mut seed) % 20;
        let n2 = 1 + next_random(mut seed) % 20;
        let low1 = 1 + next_random(mut seed) % 6;
        let low2 = 1 + next_random(mut seed) % 6;
        let nums1 = random_dice(mut seed, n1, low1, 6);
        let nums2 = random_dice(mut seed, n2, 1, 7 - low2);
        check = (check * 31 + min_operations(nums1, nums2) + 1) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
