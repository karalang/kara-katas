// LeetCode #1711: Count Good Meals -- the differential.
//
// Four arms against the statement read literally, on 3000 random lists
// of 1 to 10 dishes, each below a random bound from 1 to 17.
//
// P1  the answer is the statement read literally
// P2  the dishes listed in reverse give the same answer
// P3  one more dish of 0 adds one meal for each dish that is a power of two
// P4  every dish doubled gives the same answer
// P5  each arm agrees with at least two of the other three

// ---- meals.kara: the ★ arm: one pass, a map of the dishes seen

fn star_arm(deliciousness: Vec[i32]) -> i32 {
    let mut seen: Map[i32, i64] = Map.new();
    let mut pairs = 0;
    for d in deliciousness.iter() {
        for b in 0..22 {
            pairs += seen.get((1 << b) - d).unwrap_or(0);
        }
        seen[d] = seen.get(d).unwrap_or(0) + 1;
    }
    (pairs % 1000000007) as i32
}

// ---- meals_sorted.kara: sorted, two pointers for each power of two

fn sorted_arm(deliciousness: Vec[i32]) -> i32 {
    let mut d = deliciousness.clone();
    d.sort();
    let mut pairs: i64 = 0;
    for b in 0..22 {
        let power = 1 << b;
        let mut lo = 0;
        let mut hi = d.len() - 1;
        while lo < hi {
            let sum = d[lo] + d[hi];
            if sum < power {
                lo += 1;
            } else if sum > power {
                hi -= 1;
            } else if d[lo] == d[hi] {
                let run = hi - lo + 1;
                pairs += run * (run - 1) / 2;
                break;
            } else {
                let mut low_run = 1;
                while d[lo + low_run] == d[lo] {
                    low_run += 1;
                }
                let mut high_run = 1;
                while d[hi - high_run] == d[hi] {
                    high_run += 1;
                }
                pairs += low_run * high_run;
                lo += low_run;
                hi -= high_run;
            }
        }
    }
    (pairs % 1000000007) as i32
}

// ---- meals_counts.kara: counted by value up to the largest dish

fn counts_arm(deliciousness: Vec[i32]) -> i32 {
    let top = deliciousness.iter().max().unwrap();
    let mut count: Vec[i64] = Vec.filled(top + 1, 0);
    for d in deliciousness.iter() {
        count[d] += 1;
    }
    let mut pairs: i64 = 0;
    for v in 0..=top {
        let c = count[v];
        if c == 0 {
            continue;
        }
        for b in 0..22 {
            let w = (1 << b) - v;
            if w == v {
                pairs += c * (c - 1) / 2;
            } else if w > v and w <= top {
                pairs += c * count[w];
            }
        }
    }
    (pairs % 1000000007) as i32
}

// ---- meals_solution.kara: LeetCode's Rust template, through karac fix

struct Solution {}

impl Solution {
    pub fn count_pairs(deliciousness: Vec[i32]) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let mut count: Map[i32, i64] = Map.new();
        let mut ans: i64 = 0;
        for d in deliciousness.iter() {
            for i in 0..22 {
                let target = (1 << i) - d;
                if let Some(c) = count.get(target).cloned() {
                    ans += c;
                }
            }
            *count.entry(d).or_insert(0) += 1;
        }
        (ans % MOD) as i32
    }
}

fn solution_arm(deliciousness: Vec[i32]) -> i32 {
    Solution.count_pairs(deliciousness)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every two different dishes, by index,
// whose sum is one of 1, 2, 4, 8, ...; counted modulo 10^9 + 7
fn literal(deliciousness: Slice[i32]) -> i64 {
    let mut meals = 0;
    for i in 0..deliciousness.len() {
        for j in i + 1..deliciousness.len() {
            let sum = deliciousness[i] + deliciousness[j];
            let mut power = 1;
            while power < sum {
                power *= 2;
            }
            if power == sum {
                meals += 1;
            }
        }
    }
    meals % 1000000007
}

fn arm(a: i64, deliciousness: Slice[i32]) -> i64 {
    let deliciousness = deliciousness.to_vec();
    match a {
        0 => star_arm(deliciousness),
        1 => sorted_arm(deliciousness),
        2 => counts_arm(deliciousness),
        _ => solution_arm(deliciousness),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "sorted", "counts", "solution"][a]
}

fn main() {
    let mut seed = 1711;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[Vec[i32]] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 10 + 1;
        let top = next_random(mut seed) % 17 + 1;
        cases.push((0..n).map(|_| (next_random(mut seed) % top) as i32).collect());
    }
    for (p, deliciousness) in cases.iter().enumerate() {
        let want = literal(deliciousness);
        check = (check * 31 + want + deliciousness.len()) % 1000000007;
        let reversed: Vec[i32] = deliciousness.iter().rev().cloned().collect();
        let mut zero: Vec[i32] = deliciousness.clone();
        zero.push(0);
        let powers = deliciousness.iter().filter(|d| d > 0 and d & (d - 1) == 0).count();
        let doubled: Vec[i32] = deliciousness.iter().map(|d| d * 2).collect();
        let mut answers: Vec[i64] = Vec.new();
        for a in 0..4 {
            let got = arm(a, deliciousness);
            let failed = [got != want, arm(a, reversed) != got, arm(a, zero) != got + powers, arm(a, doubled) != got];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({deliciousness}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
