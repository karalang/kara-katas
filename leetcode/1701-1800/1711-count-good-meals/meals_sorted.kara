// LeetCode #1711: Count Good Meals -- the dishes sorted, and two pointers
// for each power of two.
//
// For each power the pointers close in from both ends: a sum too small
// moves the low one up, too large the high one down, and a match counts
// the runs of equal values at each end, or, when the two ends meet in one
// run, its pairs. O(n log n + 22 n).

fn count_pairs(deliciousness: Vec[i32]) -> i32 {
    let mut d = deliciousness.clone();
    d.sort();
    let mut pairs: i64 = 0;
    for b in 0..22 {
        let power = 1 << b;
        let mut lo = 0;
        let mut hi = d.len() - 1;
        while lo < hi {
            let sum = d[lo] + d[hi];
            if sum < power {
                lo += 1;
            } else if sum > power {
                hi -= 1;
            } else if d[lo] == d[hi] {
                let run = hi - lo + 1;
                pairs += run * (run - 1) / 2;
                break;
            } else {
                let mut low_run = 1;
                while d[lo + low_run] == d[lo] {
                    low_run += 1;
                }
                let mut high_run = 1;
                while d[hi - high_run] == d[hi] {
                    high_run += 1;
                }
                pairs += low_run * high_run;
                lo += low_run;
                hi -= high_run;
            }
        }
    }
    (pairs % 1000000007) as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random lists of 1 to `most` dishes, each 0 to `top`
// delicious; the answers summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let deliciousness: Vec[i32] = (0..n).map(|_| ((next_random(mut seed) * 32768 + next_random(mut seed)) % (top + 1)) as i32).collect();
        let answer = count_pairs(deliciousness) as i64;
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} lists of up to {most} dishes up to {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one dish, two zeros, and two dishes
    // of 2^20, the largest
    println(count_pairs([1, 3, 5, 7, 9]));
    println(count_pairs([1, 1, 1, 3, 3, 3, 7]));
    println(count_pairs([1]));
    println(count_pairs([0, 0]));
    println(count_pairs([1048576, 1048576]));
    let mut seed = 1711;
    batch(3000, 12, 16, mut seed);
    batch(300, 1000, 4096, mut seed);
    batch(10, 100000, 1000, mut seed);
}
