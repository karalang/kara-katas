// LeetCode #1711: Count Good Meals -- the bench: the ★ arm on 10 random
// lists of 100000 dishes up to 2^20, LeetCode's largest, all drawn first,
// each answered 3 times.
//
// One pass, each dish paired with the earlier dishes that make each of
// the 22 powers 2^0 to 2^21 with it, counted in a map. O(22 n).

fn count_pairs(deliciousness: Vec[i32]) -> i32 {
    let mut seen: Map[i32, i64] = Map.new();
    let mut pairs = 0;
    for d in deliciousness.iter() {
        for b in 0..22 {
            pairs += seen.get((1 << b) - d).unwrap_or(0);
        }
        seen[d] = seen.get(d).unwrap_or(0) + 1;
    }
    (pairs % 1000000007) as i32
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 10;
    let rounds = 3;
    let n = 100000;
    let top = 1 << 20;
    let mut seed = 1711;
    let mut lists: Vec[Vec[i32]] = Vec.new();
    for _ in 0..count {
        lists.push((0..n).map(|_| ((next_random(mut seed) * 32768 + next_random(mut seed)) % (top + 1)) as i32).collect());
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for deliciousness in lists.iter() {
            let answer = count_pairs(deliciousness);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} lists of {n} dishes, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
