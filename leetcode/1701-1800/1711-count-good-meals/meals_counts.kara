// LeetCode #1711: Count Good Meals -- the dishes counted by value in an
// array as long as the largest dish.
//
// Each value that occurs, with c dishes, pairs with each value w above it
// that makes a power of two, c times as many dishes as w has, and with
// itself, when it is half a power, in c (c - 1) / 2 ways. Each pair is
// counted once, from its smaller value. O(m + 22 n), m the largest dish,
// at most 2^20.

fn count_pairs(deliciousness: Vec[i32]) -> i32 {
    let top = deliciousness.iter().max().unwrap();
    let mut count: Vec[i64] = Vec.filled(top + 1, 0);
    for d in deliciousness.iter() {
        count[d] += 1;
    }
    let mut pairs: i64 = 0;
    for v in 0..=top {
        let c = count[v];
        if c == 0 {
            continue;
        }
        for b in 0..22 {
            let w = (1 << b) - v;
            if w == v {
                pairs += c * (c - 1) / 2;
            } else if w > v and w <= top {
                pairs += c * count[w];
            }
        }
    }
    (pairs % 1000000007) as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random lists of 1 to `most` dishes, each 0 to `top`
// delicious; the answers summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let deliciousness: Vec[i32] = (0..n).map(|_| ((next_random(mut seed) * 32768 + next_random(mut seed)) % (top + 1)) as i32).collect();
        let answer = count_pairs(deliciousness) as i64;
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} lists of up to {most} dishes up to {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one dish, two zeros, and two dishes
    // of 2^20, the largest
    println(count_pairs([1, 3, 5, 7, 9]));
    println(count_pairs([1, 1, 1, 3, 3, 3, 7]));
    println(count_pairs([1]));
    println(count_pairs([0, 0]));
    println(count_pairs([1048576, 1048576]));
    let mut seed = 1711;
    batch(3000, 12, 16, mut seed);
    batch(300, 1000, 4096, mut seed);
    batch(10, 100000, 1000, mut seed);
}
