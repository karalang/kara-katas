// LeetCode #1753: Maximum Score From Removing Stones -- a largest-first
// queue.
//
// The non-empty piles sit in a `PriorityQueue.max_first()`; each turn
// pops the two largest, takes a stone from each, and pushes back the
// ones that still hold stones, until fewer than two piles are left.
// O((a + b + c) log 3).

fn maximum_score(a: i32, b: i32, c: i32) -> i32 {
    let mut piles: PriorityQueue[i32] = PriorityQueue.max_first();
    for pile in [a, b, c] {
        piles.push(pile);
    }
    let mut score = 0;
    while piles.len() >= 2 {
        let first = piles.pop().unwrap() - 1;
        let second = piles.pop().unwrap() - 1;
        score += 1;
        if first > 0 {
            piles.push(first);
        }
        if second > 0 {
            piles.push(second);
        }
    }
    score
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random piles of 1 to `most` stones each
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let a = (wide(mut seed) % most + 1) as i32;
        let b = (wide(mut seed) % most + 1) as i32;
        let c = (wide(mut seed) % most + 1) as i32;
        let answer = maximum_score(a, b, c);
        sum += answer;
        check = (check * 31 + answer + a) % 1000000007;
    }
    println(f"{count} sets of piles of up to {most}: scores add to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then all ones, one pile larger than the
    // other two together, and the largest piles
    println(maximum_score(2, 4, 6));
    println(maximum_score(4, 4, 6));
    println(maximum_score(1, 8, 8));
    println(maximum_score(1, 1, 1));
    println(maximum_score(1, 2, 100000));
    println(maximum_score(100000, 100000, 100000));
    let mut seed = 1753;
    batch(3000, 6, mut seed);
    batch(3000, 1000, mut seed);
    batch(300, 100000, mut seed);
}
