// LeetCode #1753: Maximum Score From Removing Stones -- the bench
// (stones.kara): a closed form.

fn maximum_score(a: i32, b: i32, c: i32) -> i32 {
    let total = a + b + c;
    let largest = max(a, max(b, c));
    min(total / 2, total - largest)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 2000000;
    let rounds = 5;
    let mut seed = 1753;
    let piles: Vec[(i32, i32, i32)] = (0..count).map(|_| ((wide(mut seed) % 100000 + 1) as i32, (wide(mut seed) % 100000 + 1) as i32, (wide(mut seed) % 100000 + 1) as i32)).collect();
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (a, b, c) in piles.iter() {
            let answer = maximum_score(a, b, c);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} sets of piles, {rounds} rounds: scores add to {sum}, checksum {check}");
}
