// LeetCode #1779: Find Nearest Point That Has the Same X or Y Coordinate --
// the valid points filtered with their indices, and `min_by_key`, which
// keeps the first of several equal keys, picks the nearest.

fn nearest_valid_point(x: i32, y: i32, points: Vec[Vec[i32]]) -> i32 {
    points.iter().enumerate()
        .filter(|(_, p)| p[0] == x or p[1] == y)
        .min_by_key(|(_, p)| (p[0] - x).abs() + (p[1] - y).abs())
        .map(|(i, _)| i as i32)
        .unwrap_or(-1)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n points, each coordinate from 1 to `side`
fn random_points(seed: mut ref i64, n: i64, side: i64) -> Vec[Vec[i32]] {
    let mut points: Vec[Vec[i32]] = Vec.new();
    for _ in 0..n {
        let a = 1 + next_random(mut seed) % side;
        let b = 1 + next_random(mut seed) % side;
        points.push([a as i32, b as i32]);
    }
    points
}

fn main() {
    // LeetCode's three examples
    println(f"{nearest_valid_point(3, 4, [[1, 2], [3, 1], [2, 4], [2, 3], [4, 4]])} {nearest_valid_point(3, 4, [[3, 4]])} {nearest_valid_point(3, 4, [[2, 3]])}");
    // the edges: the location itself, last; two valid points equally near;
    // only a point on the same row; a nearer point that is not valid; no
    // valid point among several
    println(f"{nearest_valid_point(5, 5, [[5, 9], [1, 5], [5, 5]])} {nearest_valid_point(2, 2, [[2, 5], [5, 2]])} {nearest_valid_point(1, 1, [[2, 2], [3, 1]])} {nearest_valid_point(4, 4, [[5, 5], [4, 10]])} {nearest_valid_point(1, 1, [[2, 2], [3, 3], [4, 4]])}");
    // the constraints' most: 10000 points at random, 10000 on the same
    // column at random rows, and 10000 copies of one valid point
    let mut seed = 1779;
    let wide = random_points(mut seed, 10000, 10000);
    let column: Vec[Vec[i32]] = (0..10000).map(|_| [5000, (1 + next_random(mut seed) % 10000) as i32]).collect();
    let copies: Vec[Vec[i32]] = (0..10000).map(|_| [5000, 5001]).collect();
    println(f"the most: {nearest_valid_point(5000, 5000, wide)} {nearest_valid_point(5000, 5000, column)} {nearest_valid_point(5000, 5000, copies)}");
    // 3000 random cases of 1 to 20 points on a grid of side 1 to 6, the
    // location on the same grid
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 20;
        let side = 1 + next_random(mut seed) % 6;
        let x = 1 + next_random(mut seed) % side;
        let y = 1 + next_random(mut seed) % side;
        let points = random_points(mut seed, n, side);
        check = (check * 31 + nearest_valid_point(x as i32, y as i32, points) + 1) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
