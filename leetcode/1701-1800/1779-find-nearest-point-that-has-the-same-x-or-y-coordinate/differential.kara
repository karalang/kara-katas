// LeetCode #1779: Find Nearest Point That Has the Same X or Y Coordinate --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- nearest_valid_point.kara ----
fn a0_nearest_valid_point(x: i32, y: i32, points: Vec[Vec[i32]]) -> i32 {
    let mut best = -1;
    let mut nearest = i32.MAX;
    for i in 0..points.len() {
        let (a, b) = (points[i][0], points[i][1]);
        if a == x or b == y {
            let d = (a - x).abs() + (b - y).abs();
            if d < nearest {
                nearest = d;
                best = i as i32;
            }
        }
    }
    best
}

// ---- nearest_valid_point_first.kara ----
fn a1_nearest_valid_point(x: i32, y: i32, points: Vec[Vec[i32]]) -> i32 {
    points.iter().enumerate()
        .filter(|(_, p)| p[0] == x or p[1] == y)
        .min_by_key(|(_, p)| (p[0] - x).abs() + (p[1] - y).abs())
        .map(|(i, _)| i as i32)
        .unwrap_or(-1)
}

// ---- nearest_valid_point_pairs.kara ----
fn a2_nearest_valid_point(x: i32, y: i32, points: Vec[Vec[i32]]) -> i32 {
    let pairs: Vec[(i32, i64)] = points.iter().enumerate()
        .filter(|(_, p)| p[0] == x or p[1] == y)
        .map(|(i, p)| ((p[0] - x).abs() + (p[1] - y).abs(), i))
        .collect();
    match pairs.iter().min() {
        Some((_, i)) => i as i32,
        None => -1,
    }
}

// ---- nearest_valid_point_sorted.kara ----
fn a3_nearest_valid_point(x: i32, y: i32, points: Vec[Vec[i32]]) -> i32 {
    let mut valid: Vec[i64] = (0..points.len()).filter(|i| points[i][0] == x or points[i][1] == y).collect();
    valid.sort_by_key(|i| (points[i][0] - x).abs() + (points[i][1] - y).abs());
    match valid.first() {
        Some(i) => *i as i32,
        None => -1,
    }
}

// ---- nearest_valid_point_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn nearest_valid_point(x: i32, y: i32, points: Vec[Vec[i32]]) -> i32 {
        let mut ans = -1;
        let mut min_dist = i32.MAX;
        for (i, p) in points.iter().enumerate() {
            if p[0] == x or p[1] == y {
                let d = (p[0] - x).abs() + (p[1] - y).abs();
                if d < min_dist {
                    min_dist = d;
                    ans = i as i32;
                }
            }
        }
        ans
    }
}

fn a4_nearest_valid_point(x: i32, y: i32, points: Vec[Vec[i32]]) -> i32 {
    A4Solution.nearest_valid_point(x, y, points)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_points(seed: mut ref i64, n: i64, side: i64) -> Vec[Vec[i32]] {
    let mut points: Vec[Vec[i32]] = Vec.new();
    for _ in 0..n {
        let a = 1 + next_random(mut seed) % side;
        let b = 1 + next_random(mut seed) % side;
        points.push([a as i32, b as i32]);
    }
    points
}

// the statement read literally: every point checked for a shared x or y,
// the least Manhattan distance among the valid ones, and the first valid
// point at that distance
fn literal(x: i32, y: i32, points: Vec[Vec[i32]]) -> i32 {
    let mut valid: Vec[bool] = Vec.new();
    let mut distance: Vec[i32] = Vec.new();
    for p in points.iter() {
        valid.push(p[0] == x or p[1] == y);
        distance.push((p[0] - x).abs() + (p[1] - y).abs());
    }
    let mut least = -1;
    for k in 0..points.len() {
        if valid[k] and (least < 0 or distance[k] < least) {
            least = distance[k];
        }
    }
    for k in 0..points.len() {
        if valid[k] and distance[k] == least {
            return k as i32;
        }
    }
    -1
}

fn arm(i: i64, x: i32, y: i32, points: Vec[Vec[i32]]) -> i32 {
    match i {
        0 => a0_nearest_valid_point(x, y, points),
        1 => a1_nearest_valid_point(x, y, points),
        2 => a2_nearest_valid_point(x, y, points),
        3 => a3_nearest_valid_point(x, y, points),
        _ => a4_nearest_valid_point(x, y, points),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, x: i32, y: i32, points: Vec[Vec[i32]]) {
    t.cases += 1;
    let n = points.len();
    let want = literal(x, y, points);
    t.check = (t.check * 31 + want + 1) % 1000000007;
    let star = arm(0, x, y, points);
    let any_valid = points.iter().any(|p| p[0] == x or p[1] == y);
    let swapped: Vec[Vec[i32]] = points.iter().map(|p| [p[1], p[0]]).collect();
    let shifted: Vec[Vec[i32]] = points.iter().map(|p| [p[0] + 1000, p[1] + 1000]).collect();
    let mut with_home = points.clone();
    with_home.push([x, y]);
    for i in 0..5 {
        let what = f"arm {i} on ({x}, {y}) {points}";
        let got = arm(i, x, y, points);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: -1 exactly when no point shares x or y, else the index of one
        // that does
        let sound = if any_valid { got >= 0 and got < n as i32 and (points[got][0] == x or points[got][1] == y) } else { got == -1 };
        expect(mut t, 2, sound, f"P2 {what}");
        // P3: x and y swapped, in the location and every point, give the
        // same index
        expect(mut t, 3, arm(i, y, x, swapped) == got, f"P3 {what}");
        // P4: everything moved by 1000 on both axes gives the same index
        expect(mut t, 4, arm(i, x + 1000, y + 1000, shifted) == got, f"P4 {what}");
        // P5: the location itself added at the end is the answer unless a
        // point already sits there
        let at_home = got >= 0 and points[got][0] == x and points[got][1] == y;
        let home = arm(i, x, y, with_home);
        expect(mut t, 5, home == if at_home { got } else { n as i32 }, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[(i32, i32, Vec[Vec[i32]])] = [(3, 4, [[1, 2], [3, 1], [2, 4], [2, 3], [4, 4]]), (3, 4, [[3, 4]]), (3, 4, [[2, 3]]), (5, 5, [[5, 9], [1, 5], [5, 5]]), (2, 2, [[2, 5], [5, 2]]), (1, 1, [[2, 2], [3, 1]]), (4, 4, [[5, 5], [4, 10]]), (1, 1, [[2, 2], [3, 3], [4, 4]])];
    let mut seed = 17791;
    // 1992 random cases of 1 to 12 points on a grid of side 1 to 6, the
    // location on the same grid
    for _ in 0..1992 {
        let n = 1 + next_random(mut seed) % 12;
        let side = 1 + next_random(mut seed) % 6;
        let x = 1 + next_random(mut seed) % side;
        let y = 1 + next_random(mut seed) % side;
        cases.push((x as i32, y as i32, random_points(mut seed, n, side)));
    }
    for j in 0..cases.len() {
        check_case(mut t, cases[j].0, cases[j].1, cases[j].2);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
