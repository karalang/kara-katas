// LeetCode #1779: Find Nearest Point That Has the Same X or Y Coordinate --
// the bench: the ★ arm, one pass keeping the nearest valid point so far,
// over 20 lists of 10000 points built once, 20000 calls.

fn nearest_valid_point(x: i32, y: i32, points: Vec[Vec[i32]]) -> i32 {
    let mut best = -1;
    let mut nearest = i32.MAX;
    for i in 0..points.len() {
        let (a, b) = (points[i][0], points[i][1]);
        if a == x or b == y {
            let d = (a - x).abs() + (b - y).abs();
            if d < nearest {
                nearest = d;
                best = i as i32;
            }
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1779;
    let mut lists: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..20 {
        let mut points: Vec[Vec[i32]] = Vec.new();
        for _ in 0..10000 {
            let a = 1 + next_random(mut seed) % 100;
            let b = 1 + next_random(mut seed) % 100;
            points.push([a as i32, b as i32]);
        }
        lists.push(points);
    }
    let mut check = 0;
    for call in 0..20000 {
        let x = 1 + (check + call) % 100;
        let y = 1 + (check / 100 + call * 7) % 100;
        let found = nearest_valid_point(x as i32, y as i32, lists[call % 20]);
        check = (check * 31 + found + 1) % 1000000007;
    }
    println(f"20000 calls over 20 lists: checksum {check}");
}
