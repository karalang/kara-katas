// LeetCode #1755: Closest Subsequence Sum -- meet in the middle with two
// pointers.
//
// Each half's subset sums come from a recursion that leaves out or takes
// each value in turn, and both lists are sorted. One pointer walks the
// left sums up from the smallest and the other the right sums down from
// the largest: a pair below the goal moves the left pointer up, one
// above moves the right pointer down, and every pair seen is a candidate.
// O(2^(n/2) n).

fn collect_sums(values: Slice[i32], at: i64, sum: i32, out: mut ref Vec[i32]) {
    if at == values.len() {
        out.push(sum);
        return;
    }
    collect_sums(values, at + 1, sum, mut out);
    collect_sums(values, at + 1, sum + values[at], mut out);
}

fn min_abs_difference(nums: Vec[i32], goal: i32) -> i32 {
    let half = nums.len() / 2;
    let mut left: Vec[i32] = Vec.new();
    let mut right: Vec[i32] = Vec.new();
    collect_sums(nums[..half], 0, 0, mut left);
    collect_sums(nums[half..], 0, 0, mut right);
    left.sort();
    right.sort();
    let mut i = 0;
    let mut j = right.len() - 1;
    let mut best = i32.MAX;
    while i < left.len() and j >= 0 {
        let sum = left[i] + right[j];
        best = min(best, (sum - goal).abs());
        if sum < goal {
            i += 1;
        } else if sum > goal {
            j -= 1;
        } else {
            return 0;
        }
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random problems of 1 to `most` values within `top`, the goal
// within `reach`
fn batch(count: i64, most: i64, top: i64, reach: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let nums: Vec[i32] = (0..n).map(|_| (wide(mut seed) % (2 * top + 1) - top) as i32).collect();
        let goal = (wide(mut seed) % (2 * reach + 1) - reach) as i32;
        let answer = min_abs_difference(nums, goal);
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} problems of up to {most} values within {top}: differences add to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, the empty subsequence's
    // 0 as the closest, and the widest goal
    println(min_abs_difference([5, -7, 3, 5], 6));
    println(min_abs_difference([7, -9, 15, -2], -5));
    println(min_abs_difference([1, 2, 3], -7));
    println(min_abs_difference([4], 9));
    println(min_abs_difference([50, 60], 20));
    println(min_abs_difference([10000000, -10000000, 10000000], -1000000000));
    let mut seed = 1755;
    batch(3000, 6, 5, 20, mut seed);
    batch(300, 20, 10000000, 100000000, mut seed);
    batch(10, 40, 10000000, 1000000000, mut seed);
}
