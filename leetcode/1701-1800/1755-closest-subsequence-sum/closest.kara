// LeetCode #1755: Closest Subsequence Sum -- the ★ arm: meet in the
// middle with binary search.
//
// The values are split into two halves of at most 20, and every subset
// sum of each half is listed: a subset's sum is the sum without its
// lowest member plus that member, read off with `trailing_zeros`. The
// right half's sums are sorted; for each left sum the right sums nearest
// the rest of the goal are found by binary search, one at or above it
// and the one below. O(2^(n/2) n).

fn subset_sums(values: Slice[i32]) -> Vec[i32] {
    let count = 1 << values.len();
    let mut sums: Vec[i32] = Vec.filled(count, 0i32);
    for mask in 1..count {
        sums[mask] = sums[mask & (mask - 1)] + values[mask.trailing_zeros()];
    }
    sums
}

fn min_abs_difference(nums: Vec[i32], goal: i32) -> i32 {
    let half = nums.len() / 2;
    let left = subset_sums(nums[..half]);
    let mut right = subset_sums(nums[half..]);
    right.sort();
    let mut best = i32.MAX;
    for l in left.iter() {
        let rest = goal - l;
        let at = right.partition_point(|r| r < rest);
        if at < right.len() {
            best = min(best, right[at] - rest);
        }
        if at > 0 {
            best = min(best, rest - right[at - 1]);
        }
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random problems of 1 to `most` values within `top`, the goal
// within `reach`
fn batch(count: i64, most: i64, top: i64, reach: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let nums: Vec[i32] = (0..n).map(|_| (wide(mut seed) % (2 * top + 1) - top) as i32).collect();
        let goal = (wide(mut seed) % (2 * reach + 1) - reach) as i32;
        let answer = min_abs_difference(nums, goal);
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} problems of up to {most} values within {top}: differences add to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, the empty subsequence's
    // 0 as the closest, and the widest goal
    println(min_abs_difference([5, -7, 3, 5], 6));
    println(min_abs_difference([7, -9, 15, -2], -5));
    println(min_abs_difference([1, 2, 3], -7));
    println(min_abs_difference([4], 9));
    println(min_abs_difference([50, 60], 20));
    println(min_abs_difference([10000000, -10000000, 10000000], -1000000000));
    let mut seed = 1755;
    batch(3000, 6, 5, 20, mut seed);
    batch(300, 20, 10000000, 100000000, mut seed);
    batch(10, 40, 10000000, 1000000000, mut seed);
}
