// LeetCode #1755: Closest Subsequence Sum -- the differential.
//
// Four arms against the statement read literally, on 3000 random
// problems of 1 to 10 values from -10 to 10 and a goal from -40 to 40,
// each with a random value to append.
//
// P1  the answer is the statement read literally
// P2  the values reversed give the same answer
// P3  the values and the goal negated give the same answer
// P4  one more value never raises the answer
// P5  each arm agrees with at least two of the other three

// ---- closest.kara: the ★ arm: meet in the middle with binary search

fn star_subset_sums(values: Slice[i32]) -> Vec[i32] {
    let count = 1 << values.len();
    let mut sums: Vec[i32] = Vec.filled(count, 0i32);
    for mask in 1..count {
        sums[mask] = sums[mask & (mask - 1)] + values[mask.trailing_zeros()];
    }
    sums
}

fn star_arm(nums: Vec[i32], goal: i32) -> i32 {
    let half = nums.len() / 2;
    let left = star_subset_sums(nums[..half]);
    let mut right = star_subset_sums(nums[half..]);
    right.sort();
    let mut best = i32.MAX;
    for l in left.iter() {
        let rest = goal - l;
        let at = right.partition_point(|r| r < rest);
        if at < right.len() {
            best = min(best, right[at] - rest);
        }
        if at > 0 {
            best = min(best, rest - right[at - 1]);
        }
    }
    best
}

// ---- closest_pointers.kara: meet in the middle with two pointers

fn pointers_collect_sums(values: Slice[i32], at: i64, sum: i32, out: mut ref Vec[i32]) {
    if at == values.len() {
        out.push(sum);
        return;
    }
    pointers_collect_sums(values, at + 1, sum, mut out);
    pointers_collect_sums(values, at + 1, sum + values[at], mut out);
}

fn pointers_arm(nums: Vec[i32], goal: i32) -> i32 {
    let half = nums.len() / 2;
    let mut left: Vec[i32] = Vec.new();
    let mut right: Vec[i32] = Vec.new();
    pointers_collect_sums(nums[..half], 0, 0, mut left);
    pointers_collect_sums(nums[half..], 0, 0, mut right);
    left.sort();
    right.sort();
    let mut i = 0;
    let mut j = right.len() - 1;
    let mut best = i32.MAX;
    while i < left.len() and j >= 0 {
        let sum = left[i] + right[j];
        best = min(best, (sum - goal).abs());
        if sum < goal {
            i += 1;
        } else if sum > goal {
            j -= 1;
        } else {
            return 0;
        }
    }
    best
}

// ---- closest_set.kara: meet in the middle with an ordered set

fn set_doubled_sums(values: Slice[i32]) -> Vec[i32] {
    let mut sums: Vec[i32] = [0];
    for x in values.iter() {
        let with: Vec[i32] = sums.iter().map(|s| s + x).collect();
        sums.extend(with);
    }
    sums
}

fn set_arm(nums: Vec[i32], goal: i32) -> i32 {
    let half = nums.len() / 2;
    let left = set_doubled_sums(nums[..half]);
    let right: SortedSet[i32] = set_doubled_sums(nums[half..]).into_iter().collect();
    let mut best = i32.MAX;
    for l in left.iter() {
        let rest = goal - l;
        if let Some(above) = right.range_inclusive(rest, i32.MAX).next() {
            best = min(best, above - rest);
        }
        if let Some(below) = right.range(i32.MIN, rest).last() {
            best = min(best, rest - below);
        }
    }
    best
}

// ---- closest_solution.kara: LeetCode's Rust template, through karac fix

fn solution_sums(v: Slice[i32]) -> Vec[i32] {
    let mut res = [0i32];
    for x in v {
        let len = res.len();
        for i in 0..len {
            res.push(res[i] + x);
        }
    }
    res
}

struct Solution {}

impl Solution {
    pub fn min_abs_difference(nums: Vec[i32], goal: i32) -> i32 {
        let n = nums.len();
        let left = solution_sums(nums[..n / 2]);
        let mut right = solution_sums(nums[n / 2..]);
        right.sort();
        let mut ans = i32.MAX;
        for l in ref left {
            let t = goal - l;
            let idx = right.partition_point(|r| r < t);
            if idx < right.len() {
                ans = ans.min((right[idx] - t).abs());
            }
            if idx > 0 {
                ans = ans.min((t - right[idx - 1]).abs());
            }
        }
        ans
    }
}

fn solution_arm(nums: Vec[i32], goal: i32) -> i32 {
    Solution.min_abs_difference(nums, goal)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every subsequence, as a bit mask, the
// empty one included, summed, and the smallest distance from the goal
fn literal(nums: Slice[i32], goal: i64) -> i64 {
    let n = nums.len();
    let mut best = i64.MAX;
    for mask in 0..1 << n {
        let sum: i64 = (0..n).filter(|i| mask >> i & 1 == 1).map(|i| nums[i] as i64).sum();
        best = min(best, (sum - goal).abs());
    }
    best
}

fn arm(a: i64, nums: Slice[i32], goal: i64) -> i64 {
    let nums = nums.to_vec();
    let goal = goal as i32;
    let answer = match a {
        0 => star_arm(nums, goal),
        1 => pointers_arm(nums, goal),
        2 => set_arm(nums, goal),
        _ => solution_arm(nums, goal),
    };
    answer
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "pointers", "set", "solution"][a]
}

fn main() {
    let mut seed = 1755;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(Vec[i32], i64, i32)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 10 + 1;
        let nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 21 - 10) as i32).collect();
        let goal = next_random(mut seed) % 81 - 40;
        let extra = (next_random(mut seed) % 21 - 10) as i32;
        cases.push((nums, goal, extra));
    }
    for (p, (nums, goal, extra)) in cases.iter().enumerate() {
        let want = literal(nums, goal);
        check = (check * 31 + want + goal + 40) % 1000000007;
        let reversed: Vec[i32] = nums.iter().rev().collect();
        let negated: Vec[i32] = nums.iter().map(|x| -x).collect();
        let mut longer = nums.to_vec();
        longer.push(extra);
        let mut answers: Vec[i64] = Vec.new();
        for a in 0..4 {
            let got = arm(a, nums, goal);
            let failed = [got != want, arm(a, reversed, goal) != got, arm(a, negated, -goal) != got, arm(a, longer, goal) > got];
            answers.push(got);
            for t in 0..4 {
                checks += 1;
                if failed[t] {
                    failures += 1;
                    by_property[t + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({nums}, goal {goal}, then {extra}), {arm_name(a)}: P{t + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for t in 1..6 {
            if by_property[t] > 0 {
                counts.push(f"P{t}: {by_property[t]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
