// LeetCode #1799: Maximize Score After N Operations -- recursion with a
// memo: the best score from a set of numbers still free, every free pair
// tried as the next operation, each answer kept in a `Map` by its set,
// which fixes how many operations are behind it. O(4^n n^2) at worst

fn gcd(a: i32, b: i32) -> i32 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn best(nums: Vec[i32], free: i64, op: i32, memo: mut ref Map[i64, i32]) -> i32 {
    if free == 0 {
        return 0;
    }
    if let Some(known) = memo.get(free) {
        return known;
    }
    let m = nums.len();
    let mut most: i32 = 0;
    for i in 0..m {
        if free >> i & 1 == 0 {
            continue;
        }
        for j in i + 1..m {
            if free >> j & 1 == 1 {
                let rest = free & ~(1 << i) & ~(1 << j);
                most = most.max(op * gcd(nums[i], nums[j]) + best(nums, rest, op + 1, mut memo));
            }
        }
    }
    memo[free] = most;
    most
}

fn max_score(nums: Vec[i32]) -> i32 {
    let mut memo: Map[i64, i32] = Map.new();
    best(nums, (1 << nums.len()) - 1, 1, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    let first: Vec[i32] = [1, 2].to_vec();
    let second: Vec[i32] = [3, 4, 6, 8].to_vec();
    let third: Vec[i32] = [1, 2, 3, 4, 5, 6].to_vec();
    println(f"{max_score(first)} {max_score(second)} {max_score(third)}");
    // the edges: one pair alike; one pair coprime; six ones; a pair that
    // shares more with the others than with itself
    let alike: Vec[i32] = [5, 5].to_vec();
    let coprime: Vec[i32] = [2, 3].to_vec();
    let ones: Vec[i32] = [1, 1, 1, 1, 1, 1].to_vec();
    let crossed: Vec[i32] = [6, 10, 15, 30].to_vec();
    println(f"{max_score(alike)} {max_score(coprime)} {max_score(ones)} {max_score(crossed)}");
    // the constraints' most: 14 numbers of 10^6; and 14 at random
    let top: Vec[i32] = Vec.filled(14, 1000000);
    let mut seed = 1799;
    let wide: Vec[i32] = (0..14).map(|_| (1 + next_random(mut seed) % 1000000) as i32).collect();
    println(f"the most: {max_score(top)} {max_score(wide)}");
    // 1000 random cases of 1 to 5 pairs of numbers of 1 to 60
    let mut check = 0;
    for _ in 0..1000 {
        let n = 2 * (1 + next_random(mut seed) % 5);
        let nums: Vec[i32] = (0..n).map(|_| (1 + next_random(mut seed) % 60) as i32).collect();
        check = (check * 31 + max_score(nums)) % 1000000007;
    }
    println(f"1000 random cases: checksum {check}");
}
