// LeetCode #1799: Maximize Score After N Operations -- the bench: the ★
// arm, dynamic programming over the set of numbers taken, over 100 random
// lists of 14 numbers built once, 100 calls, each list drawn from the
// checksum so far.

fn gcd(a: i32, b: i32) -> i32 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn max_score(nums: Vec[i32]) -> i32 {
    let m = nums.len();
    let full = 1 << m;
    let mut best: Vec[i32] = Vec.filled(full, 0);
    for mask in 0..full {
        let taken = mask.count_ones();
        if taken % 2 == 1 {
            continue;
        }
        let op = (taken / 2 + 1) as i32;
        for i in 0..m {
            if mask >> i & 1 == 1 {
                continue;
            }
            for j in i + 1..m {
                if mask >> j & 1 == 1 {
                    continue;
                }
                let next = mask | 1 << i | 1 << j;
                best[next] = best[next].max(best[mask] + op * gcd(nums[i], nums[j]));
            }
        }
    }
    best[full - 1]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1799;
    let mut lists: Vec[Vec[i32]] = Vec.new();
    for _ in 0..100 {
        let nums: Vec[i32] = (0..14).map(|_| (1 + next_random(mut seed) % 1000000) as i32).collect();
        lists.push(nums);
    }
    let mut check = 0;
    for call in 0..100 {
        let nums = ref lists[(check + call) % 100];
        check = (check * 31 + max_score(nums)) % 1000000007;
    }
    println(f"100 calls over 100 lists of 14 numbers: checksum {check}");
}
