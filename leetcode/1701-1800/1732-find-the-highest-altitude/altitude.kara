// LeetCode #1732: Find the Highest Altitude -- the ★ arm: the altitudes
// listed, then the largest.
//
// The biker starts at 0, and each point's altitude is the one before it
// plus the gain between them. All n + 1 altitudes are pushed onto a list,
// starting point included, and the answer is the largest. O(n).

fn largest_altitude(gain: Vec[i32]) -> i32 {
    let mut altitudes: Vec[i32] = [0];
    for g in gain.iter() {
        altitudes.push(altitudes[altitudes.len() - 1] + g);
    }
    altitudes.iter().max().unwrap()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` trips of 1 to `most` gains from -`top` to `top`
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let gain: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % (2 * top + 1) - top) as i32).collect();
        let answer = largest_altitude(gain);
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} trips of up to {most} gains up to {top}: highest points sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one loss, and a hundred climbs of 100
    println(largest_altitude([-5, 1, 5, 0, -7]));
    println(largest_altitude([-4, -3, -2, -1, 4, 3, 2]));
    println(largest_altitude([-100]));
    println(largest_altitude(Vec.filled(100, 100)));
    let mut seed = 1732;
    batch(3000, 8, 3, mut seed);
    batch(3000, 100, 100, mut seed);
}
