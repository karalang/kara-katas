// LeetCode #1732: Find the Highest Altitude -- the differential.
//
// Four arms against the statement read literally, on 3000 random trips
// of 1 to 8 gains from -5 to 5.
//
// P1  the answer is the statement read literally
// P2  a loss of 1000 put at the end gives the same answer
// P3  every gain doubled doubles the answer
// P4  the trip run backwards, each gain negated, gives the answer less the
//     total gain: its altitudes are the trip's, each less the last
// P5  each arm agrees with at least two of the other three

// ---- altitude.kara: the ★ arm: the altitudes listed, then the largest

fn star_arm(gain: Vec[i32]) -> i32 {
    let mut altitudes: Vec[i32] = [0];
    for g in gain.iter() {
        altitudes.push(altitudes[altitudes.len() - 1] + g);
    }
    altitudes.iter().max().unwrap()
}

// ---- altitude_fold.kara: a fold over the gains

fn fold_arm(gain: Vec[i32]) -> i32 {
    let (_, highest) = gain.iter().fold((0, 0i32), |(altitude, highest), g| (altitude + g, max(highest, altitude + g)));
    highest
}

// ---- altitude_scan.kara: the altitudes as a `scan`

fn scan_arm(gain: Vec[i32]) -> i32 {
    let highest = gain
        .iter()
        .scan(0i32, |altitude, g| { let altitude = altitude + g; Some((altitude, altitude)) })
        .max()
        .unwrap();
    max(0, highest)
}

// ---- altitude_solution.kara: the Rust solution carried by `karac fix`

struct SolutionArm {}

impl SolutionArm {
    pub fn largest_altitude(gain: Vec[i32]) -> i32 {
        let mut alt: i32 = 0;
        let mut ans: i32 = 0;
        for g in gain {
            alt += g;
            ans = ans.max(alt);
        }
        ans
    }
}

fn solution_arm(gain: Vec[i32]) -> i32 {
    SolutionArm.largest_altitude(gain)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: the altitude of point i is the sum of the
// first i gains, point 0 the start at 0; the largest over the n + 1 points
fn literal(gain: Slice[i32]) -> i32 {
    let mut highest: i32 = 0;
    for i in 0..=gain.len() {
        let mut altitude: i32 = 0;
        for j in 0..i {
            altitude += gain[j];
        }
        if altitude > highest {
            highest = altitude;
        }
    }
    highest
}

fn arm(a: i64, gain: Slice[i32]) -> i32 {
    let gain = gain.to_vec();
    match a {
        0 => star_arm(gain),
        1 => fold_arm(gain),
        2 => scan_arm(gain),
        _ => solution_arm(gain),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "fold", "scan", "solution"][a]
}

fn main() {
    let mut seed = 1732;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[Vec[i32]] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 8 + 1;
        let gain: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 11 - 5) as i32).collect();
        cases.push(gain);
    }
    for (p, gain) in cases.iter().enumerate() {
        let want = literal(gain);
        check = (check * 31 + want + gain.len()) % 1000000007;
        let total: i32 = gain.iter().sum();
        let mut dropped = gain.clone();
        dropped.push(-1000);
        let doubled: Vec[i32] = gain.iter().map(|g| 2 * g).collect();
        let back: Vec[i32] = gain.iter().rev().map(|g| -g).collect();
        let mut answers: Vec[i32] = Vec.new();
        for a in 0..4 {
            let got = arm(a, gain);
            let failed = [got != want, arm(a, dropped) != got, arm(a, doubled) != 2 * got, arm(a, back) != got - total];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({gain}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
