// LeetCode #1732: Find the Highest Altitude -- the bench, the ★ arm: the
// altitudes listed, then the largest.
//
// The biker starts at 0, and each point's altitude is the one before it
// plus the gain between them. All n + 1 altitudes are pushed onto a list,
// starting point included, and the answer is the largest. O(n).

fn largest_altitude(gain: Vec[i32]) -> i32 {
    let mut altitudes: Vec[i32] = [0];
    for g in gain.iter() {
        altitudes.push(altitudes[altitudes.len() - 1] + g);
    }
    altitudes.iter().max().unwrap()
}

// ---- the bench -------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 1000;
    let rounds = 2000;
    let n = 100;
    let mut seed = 1732;
    let mut trips: Vec[Vec[i32]] = Vec.new();
    for _ in 0..count {
        let gain: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 201 - 100) as i32).collect();
        trips.push(gain);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for gain in trips.iter() {
            let answer = largest_altitude(gain);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} trips of {n} gains, {rounds} rounds: highest points sum to {sum}, checksum {check}");
}
