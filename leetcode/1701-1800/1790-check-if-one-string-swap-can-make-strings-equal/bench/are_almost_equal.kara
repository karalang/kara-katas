// LeetCode #1790: Check if One String Swap Can Make Strings Equal -- the
// bench: the ★ arm, the positions where the strings differ, over 2000 pairs
// of 100 letters built once, 4000000 calls.

fn are_almost_equal(s1: String, s2: String) -> bool {
    let a = s1.bytes();
    let b = s2.bytes();
    let mut differ: Vec[i64] = Vec.new();
    for i in 0..a.len() {
        if a[i] != b[i] {
            differ.push(i);
            if differ.len() > 2 {
                return false;
            }
        }
    }
    match differ.len() {
        0 => true,
        2 => a[differ[0]] == b[differ[1]] and a[differ[1]] == b[differ[0]],
        _ => false,
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1790;
    let mut pairs: Vec[(String, String)] = Vec.new();
    for k in 0..2000 {
        let mut a: Vec[u8] = Vec.new();
        for _ in 0..100 {
            a.push((97 + next_random(mut seed) % 26) as u8);
        }
        // the second string 0, 1 or 2 swaps from the first, or 3 letters
        // changed
        let mut b = a.clone();
        for _ in 0..k % 4 {
            let i = next_random(mut seed) % 100;
            let j = next_random(mut seed) % 100;
            if k % 4 == 3 {
                b[i] = 97 + (b[i] - 97 + 1) % 26;
            } else {
                b.swap(i, j);
            }
        }
        pairs.push((String.from_utf8(a).unwrap(), String.from_utf8(b).unwrap()));
    }
    let mut check = 0;
    for call in 0..4000000 {
        let (s1, s2) = ref pairs[(check + call) % 2000];
        check = (check * 3 + if are_almost_equal(s1, s2) { 2 } else { 1 }) % 1000000007;
    }
    println(f"4000000 calls over 2000 pairs: checksum {check}");
}
