// LeetCode #1800: Maximum Ascending Subarray Sum -- the ★ arm: one pass
// with the sum of the ascending run that ends here, which a number no
// larger than the one before starts afresh. O(n)

fn max_ascending_sum(nums: Vec[i32]) -> i32 {
    let mut run = nums[0];
    let mut best = run;
    for i in 1..nums.len() {
        if nums[i] > nums[i - 1] {
            run += nums[i];
        } else {
            run = nums[i];
        }
        best = best.max(run);
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    let first: Vec[i32] = [10, 20, 30, 5, 10, 50].to_vec();
    let second: Vec[i32] = [10, 20, 30, 40, 50].to_vec();
    let third: Vec[i32] = [12, 17, 15, 13, 10, 11, 12].to_vec();
    println(f"{max_ascending_sum(first)} {max_ascending_sum(second)} {max_ascending_sum(third)}");
    // the edges: one number; two alike, which do not ascend; falling all
    // the way; the best run last; a run broken by an equal pair
    let one: Vec[i32] = [7].to_vec();
    let alike: Vec[i32] = [5, 5].to_vec();
    let falling: Vec[i32] = [9, 7, 5, 3].to_vec();
    let last: Vec[i32] = [3, 2, 1, 2, 3].to_vec();
    let equal: Vec[i32] = [1, 2, 3, 3, 4].to_vec();
    println(f"{max_ascending_sum(one)} {max_ascending_sum(alike)} {max_ascending_sum(falling)} {max_ascending_sum(last)} {max_ascending_sum(equal)}");
    // the constraints' most: 100 numbers of 100; 1 to 100 rising; and 100
    // at random
    let flat: Vec[i32] = Vec.filled(100, 100);
    let rising: Vec[i32] = (1..101).map(|v| v as i32).collect();
    let mut seed = 1800;
    let wide: Vec[i32] = (0..100).map(|_| (1 + next_random(mut seed) % 100) as i32).collect();
    println(f"the most: {max_ascending_sum(flat)} {max_ascending_sum(rising)} {max_ascending_sum(wide)}");
    // 3000 random cases of 1 to 20 numbers of 1 to 1 + 0 to 29
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 20;
        let top = 1 + next_random(mut seed) % 30;
        let nums: Vec[i32] = (0..n).map(|_| (1 + next_random(mut seed) % top) as i32).collect();
        check = (check * 31 + max_ascending_sum(nums)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
