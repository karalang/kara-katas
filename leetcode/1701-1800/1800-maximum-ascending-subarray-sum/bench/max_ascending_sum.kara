// LeetCode #1800: Maximum Ascending Subarray Sum -- the bench: the ★ arm,
// one pass with the sum of the ascending run that ends here, over 4000
// random lists of 100 numbers from 1 to 100 built once, 400000 calls, each
// list drawn from the checksum so far.

fn max_ascending_sum(nums: Vec[i32]) -> i32 {
    let mut run = nums[0];
    let mut best = run;
    for i in 1..nums.len() {
        if nums[i] > nums[i - 1] {
            run += nums[i];
        } else {
            run = nums[i];
        }
        best = best.max(run);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1800;
    let mut lists: Vec[Vec[i32]] = Vec.new();
    for _ in 0..4000 {
        let nums: Vec[i32] = (0..100).map(|_| (1 + next_random(mut seed) % 100) as i32).collect();
        lists.push(nums);
    }
    let mut check = 0;
    for call in 0..400000 {
        let nums = ref lists[(check + call) % 4000];
        check = (check * 31 + max_ascending_sum(nums)) % 1000000007;
    }
    println(f"400000 calls over 4000 lists of 100 numbers: checksum {check}");
}
