// LeetCode #1800: Maximum Ascending Subarray Sum --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- max_ascending_sum.kara ----
fn a0_max_ascending_sum(nums: Vec[i32]) -> i32 {
    let mut run = nums[0];
    let mut best = run;
    for i in 1..nums.len() {
        if nums[i] > nums[i - 1] {
            run += nums[i];
        } else {
            run = nums[i];
        }
        best = best.max(run);
    }
    best
}

// ---- max_ascending_sum_chunk.kara ----
fn a1_max_ascending_sum(nums: Vec[i32]) -> i32 {
    nums.chunk_by(|a, b| a < b).iter().map(|run| run.iter().sum()).max().unwrap()
}

// ---- max_ascending_sum_brute.kara ----
fn a2_max_ascending_sum(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut best: i32 = 0;
    for start in 0..n {
        let mut sum = nums[start];
        best = best.max(sum);
        let mut end = start + 1;
        while end < n and nums[end] > nums[end - 1] {
            sum += nums[end];
            best = best.max(sum);
            end += 1;
        }
    }
    best
}

// ---- max_ascending_sum_fold.kara ----
fn a3_max_ascending_sum(nums: Vec[i32]) -> i32 {
    let (best, _, _) = nums.iter().fold((0i32, 0i32, 0), |(best, run, prev), x| {
        let run = if x > prev { run + x } else { x };
        (best.max(run), run, x)
    });
    best
}

// ---- max_ascending_sum_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn max_ascending_sum(nums: Vec[i32]) -> i32 {
        let mut ans = nums[0];
        let mut cur = nums[0];
        for w in nums.windows(2) {
            if w[1] > w[0] {
                cur += w[1];
            } else {
                cur = w[1];
            }
            ans = ans.max(cur);
        }
        ans
    }
}

fn a4_max_ascending_sum(nums: Vec[i32]) -> i32 {
    A4Solution.max_ascending_sum(nums)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every subarray from i to j, kept when
// each number in it is larger than the one before, its sum found afresh
fn literal(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut best: i32 = 0;
    for i in 0..n {
        for j in i..n {
            if (i + 1..j + 1).all(|k| nums[k] > nums[k - 1]) {
                let sum: i32 = (i..j + 1).map(|k| nums[k]).sum();
                best = best.max(sum);
            }
        }
    }
    best
}

fn arm(i: i64, nums: Vec[i32]) -> i32 {
    match i {
        0 => a0_max_ascending_sum(nums),
        1 => a1_max_ascending_sum(nums),
        2 => a2_max_ascending_sum(nums),
        3 => a3_max_ascending_sum(nums),
        _ => a4_max_ascending_sum(nums),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, nums: Vec[i32]) {
    t.cases += 1;
    let star = arm(0, nums);
    t.check = (t.check * 31 + star) % 1000000007;
    let want = literal(nums);
    let top = nums.iter().max().unwrap();
    let mut doubled_first = [nums[0]].to_vec();
    doubled_first.extend(nums.clone());
    let twice: Vec[i32] = nums.iter().map(|x| 2 * x).collect();
    let raised: Vec[i32] = nums.iter().map(|x| x + 1).collect();
    let total: i32 = nums.iter().sum();
    for i in 0..5 {
        let what = f"arm {i} on {nums}";
        let got = arm(i, nums);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: the first number written twice, which does not ascend,
        // gives the same answer
        expect(mut t, 2, arm(i, doubled_first) == got, f"P2 {what}");
        // P3: every number doubled doubles the answer
        expect(mut t, 3, arm(i, twice) == 2 * got, f"P3 {what}");
        // P4: every number one larger keeps the same runs, so raises the
        // answer by at least 1 and at most the count of numbers
        let up = arm(i, raised) - got;
        expect(mut t, 4, up >= 1 and up <= nums.len() as i32, f"P4 {what}");
        // P5: the answer lies between the largest number and the sum of
        // all of them
        expect(mut t, 5, got >= top and got <= total, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples, the edges, the constraints' most, and 1988
    // random cases of 1 to 30 numbers. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[Vec[i32]] = [[10, 20, 30, 5, 10, 50].to_vec(), [10, 20, 30, 40, 50].to_vec(), [12, 17, 15, 13, 10, 11, 12].to_vec(), [7].to_vec(), [5, 5].to_vec(), [9, 7, 5, 3].to_vec(), [3, 2, 1, 2, 3].to_vec(), [1, 2, 3, 3, 4].to_vec()].to_vec();
    let mut seed = 18001;
    cases.push(Vec.filled(100, 100));
    cases.push((1..101).map(|v| v as i32).collect());
    cases.push((0..100).map(|_| (1 + next_random(mut seed) % 100) as i32).collect());
    cases.push((0..100).map(|v| (100 - v) as i32).collect());
    for _ in 0..1988 {
        let n = 1 + next_random(mut seed) % 30;
        let top = 1 + next_random(mut seed) % 30;
        cases.push((0..n).map(|_| (1 + next_random(mut seed) % top) as i32).collect());
    }
    for j in 0..cases.len() {
        check_case(mut t, cases[j].clone());
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
