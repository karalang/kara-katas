// LeetCode #1714: Sum Of Special Evenly-Spaced Elements In Array --
// `step_by` over the values from x.
//
// The values a query adds are `nums[x..]` taking every y-th, which is what
// `iter().step_by(y)` yields; summed as `i64` and reduced once. The same
// walk as the direct arm, written as an iterator. O(n / y) a query.

fn solve(nums: Vec[i32], queries: Vec[Vec[i32]]) -> Vec[i32] {
    queries
        .iter()
        .map(|query| {
            let total: i64 = nums[query[0]..].iter().step_by(query[1]).map(|v| v as i64).sum();
            (total % 1000000007) as i32
        })
        .collect()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random problems of 1 to `most` values up to `top` and 1 to
// `asked` queries, each step up to `steps`; the answers summed, and a
// checksum
fn batch(count: i64, most: i64, top: i64, asked: i64, steps: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let nums: Vec[i32] = (0..n).map(|_| (wide(mut seed) % (top + 1)) as i32).collect();
        let q = next_random(mut seed) % asked + 1;
        let queries: Vec[Vec[i32]] = (0..q).map(|_| [(wide(mut seed) % n) as i32, (wide(mut seed) % steps + 1) as i32]).collect();
        let answer = solve(nums, queries);
        for a in answer.iter() {
            sum += a;
            check = (check * 31 + a) % 1000000007;
        }
        check = (check * 31 + n + q) % 1000000007;
    }
    println(f"{count} problems of up to {most} values and {asked} queries: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one value, a step past the end, and
    // the largest values summed past the modulus
    println(solve([0, 1, 2, 3, 4, 5, 6, 7], [[0, 3], [5, 1], [4, 2]]));
    println(solve([100, 200, 101, 201, 102, 202, 103, 203], [[0, 7]]));
    println(solve([5], [[0, 1], [0, 50000]]));
    println(solve([1, 2, 3], [[1, 5], [2, 1]]));
    println(solve(Vec.filled(50000, 1000000000), [[0, 1], [1, 2], [49999, 1]]));
    let mut seed = 1714;
    batch(3000, 12, 9, 6, 6, mut seed);
    batch(300, 1000, 1000000000, 300, 40, mut seed);
    batch(10, 50000, 1000000000, 1000, 50000, mut seed);
}
