// LeetCode #1714: Sum Of Special Evenly-Spaced Elements In Array -- the
// bench: the ★ arm on 5 random problems of 50000 values below 10^9 and
// 150000 queries, LeetCode's largest, half the steps below the square root
// of n and half above, all drawn first, each answered 4 times.
//
// The queries taken in order of their step; a small step's sums from every
// start found once, from the back, and a large step's walked.
// O((n + q) sqrt(n)).

fn solve(nums: Vec[i32], queries: Vec[Vec[i32]]) -> Vec[i32] {
    let modulus = 1000000007;
    let n = nums.len();
    let small = n.isqrt();
    let mut answer: Vec[i32] = Vec.filled(queries.len(), 0);
    let mut order: Vec[i64] = (0..queries.len()).collect();
    order.sort_by_key(|q| queries[q][1]);
    let mut sums: Vec[i64] = Vec.filled(n, 0);
    let mut built = 0;
    for q in order.iter() {
        let (x, y) = (queries[q][0], queries[q][1]);
        if y <= small {
            if y != built {
                for j in (0..n).rev() {
                    let after = if j + y < n { sums[j + y] } else { 0 };
                    sums[j] = (nums[j] + after) % modulus;
                }
                built = y;
            }
            answer[q] = sums[x] as i32;
        } else {
            let mut total = 0;
            let mut j = x;
            while j < n {
                total += nums[j];
                j += y;
            }
            answer[q] = (total % modulus) as i32;
        }
    }
    answer
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 5;
    let rounds = 4;
    let n = 50000;
    let q = 150000;
    let mut seed = 1714;
    let mut problems: Vec[(Vec[i32], Vec[Vec[i32]])] = Vec.new();
    for _ in 0..count {
        let nums: Vec[i32] = (0..n).map(|_| (wide(mut seed) % 1000000000) as i32).collect();
        let mut queries: Vec[Vec[i32]] = Vec.new();
        for _ in 0..q {
            let x = wide(mut seed) % n;
            let y = if next_random(mut seed) % 2 == 0 { next_random(mut seed) % 223 + 1 } else { wide(mut seed) % n + 1 };
            queries.push([x as i32, y as i32]);
        }
        problems.push((nums, queries));
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, queries) in problems.iter() {
            for a in solve(nums, queries).iter() {
                sum += a;
                check = (check * 31 + a + r) % 1000000007;
            }
        }
    }
    println(f"{count} problems of {n} values and {q} queries, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
