// LeetCode #1796: Second Largest Digit in a String -- the bench: the ★ arm,
// one pass keeping the largest digit and the largest below it, over 1000
// random strings of 100 characters built once, 1000000 calls, each string
// drawn from the checksum so far.

fn second_highest(s: String) -> i32 {
    let mut first = -1;
    let mut second = -1;
    for c in s.chars() {
        if let Some(d) = c.to_digit(10) {
            let d = d as i32;
            if d > first {
                second = first;
                first = d;
            } else if d < first and d > second {
                second = d;
            }
        }
    }
    second
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1796;
    let mut texts: Vec[String] = Vec.new();
    for _ in 0..1000 {
        let digits = 1 + next_random(mut seed) % 9;
        let mut s = String.new();
        for _ in 0..100 {
            if next_random(mut seed) % 10 < digits {
                s.push(char.from_digit((next_random(mut seed) % 10) as u32, 10).unwrap());
            } else {
                s.push("abcdef".chars().nth(next_random(mut seed) % 6).unwrap());
            }
        }
        texts.push(s);
    }
    let mut check = 0;
    for call in 0..1000000 {
        let s = ref texts[(check + call) % 1000];
        check = (check * 31 + second_highest(s) + 1) % 1000000007;
    }
    println(f"1000000 calls over 1000 strings: checksum {check}");
}
