// LeetCode #1760: Minimum Limit of Balls in a Bag -- the binary search
// written as a recursion on the range of penalties still open.

fn fits(nums: Vec[i32], max_operations: i32, penalty: i32) -> bool {
    let mut needed = 0;
    for x in nums.iter() {
        needed += (x - 1) / penalty;
        if needed > max_operations {
            return false;
        }
    }
    true
}

// the least penalty in lo..=hi that fits, hi known to fit
fn least(nums: Vec[i32], max_operations: i32, lo: i32, hi: i32) -> i32 {
    if lo == hi {
        return lo;
    }
    let mid = lo + (hi - lo) / 2;
    if fits(nums, max_operations, mid) {
        least(nums, max_operations, lo, mid)
    } else {
        least(nums, max_operations, mid + 1, hi)
    }
}

fn minimum_size(nums: Vec[i32], max_operations: i32) -> i32 {
    let most = nums.iter().max().unwrap();
    least(nums, max_operations, 1, most)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n bags of 1 to `most` balls; a draw below 32768 is widened for a large
// `most`
fn random_bags(seed: mut ref i64, n: i64, most: i64) -> Vec[i32] {
    let mut bags: Vec[i32] = Vec.new();
    for _ in 0..n {
        let r = next_random(mut seed) * 32768 + next_random(mut seed);
        bags.push((1 + r % most) as i32);
    }
    bags
}

fn main() {
    // LeetCode's two examples
    println(f"{minimum_size([9], 2)} {minimum_size([2, 4, 8, 2], 4)}");
    // the edges: no operation needed; one ball; enough operations to make
    // every ball its own bag; one operation short of that; bags all the
    // same; the largest bag alone
    println(f"{minimum_size([1, 1, 1], 5)} {minimum_size([1], 1)} {minimum_size([3, 5], 6)} {minimum_size([3, 5], 5)} {minimum_size([7, 7, 7, 7], 4)} {minimum_size([1000000000], 1)}");
    // the constraints' most: 100000 bags of up to 1000000000 balls, with
    // few, many and the most operations
    let mut seed = 1760;
    let big = random_bags(mut seed, 100000, 1000000000);
    println(f"100000 bags: {minimum_size(big, 1)} {minimum_size(big, 100000)} {minimum_size(big, 1000000000)}");
    // 3000 random cases of 1 to 20 bags of 1 to 60 balls, 1 to 40
    // operations
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 20;
        let bags = random_bags(mut seed, n, 60);
        let ops = 1 + next_random(mut seed) % 40;
        check = (check * 31 + minimum_size(bags, ops as i32)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
