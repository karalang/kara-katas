// LeetCode #1716: Calculate Money in Leetcode Bank -- a week at a time.
//
// A whole week from a Monday of m puts in 7m + 21; the weeks are added
// while seven days remain, and the days of the last, short week one by
// one. O(n / 7).

fn total_money(n: i32) -> i32 {
    let mut total: i32 = 0;
    let mut monday: i32 = 1;
    let mut left = n;
    while left >= 7 {
        total += 7 * monday + 21;
        monday += 1;
        left -= 7;
    }
    for d in 0..left {
        total += monday + d;
    }
    total
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's three examples, then one day, one week, and the last day
    println(total_money(4));
    println(total_money(10));
    println(total_money(20));
    println(total_money(1));
    println(total_money(7));
    println(total_money(1000));
    // every n the constraints allow
    let mut sum = 0;
    let mut check = 0;
    for n in 1..=1000 {
        let answer = total_money(n) as i64;
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"every n from 1 to 1000: answers sum to {sum}, checksum {check}");
}
