// LeetCode #1716: Calculate Money in Leetcode Bank -- the bench: the ★ arm
// on 500000 random n from 1 to 1000, LeetCode's range, all drawn first,
// each answered 20 times.
//
// Whole weeks and the days left, each summed in closed form. O(1).

fn total_money(n: i32) -> i32 {
    let weeks = n / 7;
    let days = n % 7;
    28 * weeks + 7 * weeks * (weeks - 1) / 2 + days * (weeks + 1) + days * (days - 1) / 2
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 500000;
    let rounds = 20;
    let mut seed = 1716;
    let ns: Vec[i32] = (0..count).map(|_| (next_random(mut seed) % 1000 + 1) as i32).collect();
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for n in ns.iter() {
            let answer = total_money(n);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} values of n, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
