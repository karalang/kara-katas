// LeetCode #1716: Calculate Money in Leetcode Bank -- day by day.
//
// A Monday puts in one more than the Monday before, the first one 1, and
// every other day one more than the day before it. O(n).

fn total_money(n: i32) -> i32 {
    let mut total = 0;
    let mut monday = 0;
    let mut today = 0;
    for day in 0..n {
        if day % 7 == 0 {
            monday += 1;
            today = monday;
        } else {
            today += 1;
        }
        total += today;
    }
    total
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's three examples, then one day, one week, and the last day
    println(total_money(4));
    println(total_money(10));
    println(total_money(20));
    println(total_money(1));
    println(total_money(7));
    println(total_money(1000));
    // every n the constraints allow
    let mut sum = 0;
    let mut check = 0;
    for n in 1..=1000 {
        let answer = total_money(n) as i64;
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"every n from 1 to 1000: answers sum to {sum}, checksum {check}");
}
