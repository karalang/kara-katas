// LeetCode #1716: Calculate Money in Leetcode Bank -- the ★ arm: whole
// weeks and the days left, each summed in closed form.
//
// Week k, from 0, puts in k + 1 to k + 7, which is 28 + 7k; w whole weeks
// make 28w + 7w(w - 1)/2. The d days after them put in w + 1 to w + d,
// which is d(w + 1) + d(d - 1)/2. O(1).

fn total_money(n: i32) -> i32 {
    let weeks = n / 7;
    let days = n % 7;
    28 * weeks + 7 * weeks * (weeks - 1) / 2 + days * (weeks + 1) + days * (days - 1) / 2
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's three examples, then one day, one week, and the last day
    println(total_money(4));
    println(total_money(10));
    println(total_money(20));
    println(total_money(1));
    println(total_money(7));
    println(total_money(1000));
    // every n the constraints allow
    let mut sum = 0;
    let mut check = 0;
    for n in 1..=1000 {
        let answer = total_money(n) as i64;
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"every n from 1 to 1000: answers sum to {sum}, checksum {check}");
}
