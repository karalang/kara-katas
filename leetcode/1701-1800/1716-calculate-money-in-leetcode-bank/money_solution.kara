// LeetCode #1716: Calculate Money in Leetcode Bank -- a Rust solution as
// LeetCode's Rust users write it: each day's deposit from its week and its
// day in the week, `(1..=n).map(|i| (i - 1) / 7 + (i - 1) % 7 + 1).sum()`.

struct Solution {}

impl Solution {
    pub fn total_money(n: i32) -> i32 {
        (1..=n).map(|i| (i - 1) / 7 + (i - 1) % 7 + 1).sum()
    }
}

fn total_money(n: i32) -> i32 {
    Solution.total_money(n)
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's three examples, then one day, one week, and the last day
    println(total_money(4));
    println(total_money(10));
    println(total_money(20));
    println(total_money(1));
    println(total_money(7));
    println(total_money(1000));
    // every n the constraints allow
    let mut sum = 0;
    let mut check = 0;
    for n in 1..=1000 {
        let answer = total_money(n) as i64;
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"every n from 1 to 1000: answers sum to {sum}, checksum {check}");
}
