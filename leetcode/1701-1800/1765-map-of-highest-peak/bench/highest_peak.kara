// LeetCode #1765: Map of Highest Peak -- the bench: the ★ arm, a
// breadth-first search from every water cell at once, with a `VecDeque`.

fn highest_peak(is_water: Vec[Vec[i32]]) -> Vec[Vec[i32]] {
    let rows = is_water.len();
    let cols = is_water[0].len();
    let mut height: Vec[Vec[i32]] = Vec.filled(rows, Vec.filled(cols, -1));
    let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
    for r in 0..rows {
        for c in 0..cols {
            if is_water[r][c] == 1 {
                height[r][c] = 0;
                queue.push_back((r, c));
            }
        }
    }
    while let Some((r, c)) = queue.pop_front() {
        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
            let nr = r + dr;
            let nc = c + dc;
            if nr >= 0 and nr < rows and nc >= 0 and nc < cols and height[nr][nc] == -1 {
                height[nr][nc] = height[r][c] + 1;
                queue.push_back((nr, nc));
            }
        }
    }
    height
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1765;
    let size = 800;
    let mut grid: Vec[Vec[i32]] = (0..size).map(|_| (0..size).map(|_| if next_random(mut seed) % 5000 == 0 { 1 } else { 0 }).collect()).collect();
    grid[0][0] = 1;
    let mut check = 0;
    for call in 0..100 {
        let r = (check + call * 7919) % size;
        let c = (check / 7 + call * 104729) % size;
        grid[r][c] = 1 - grid[r][c];
        grid[0][0] = 1;
        let height = highest_peak(grid);
        check = (check * 31 + height[c][r] + height[size - 1 - r][size - 1 - c]) % 1000000007;
    }
    println(f"100 calls on 800 by 800: checksum {check}");
}
