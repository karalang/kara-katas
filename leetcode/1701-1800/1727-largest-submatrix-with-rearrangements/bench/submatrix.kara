// LeetCode #1727: Largest Submatrix With Rearrangements -- the bench, the
// ★ arm: each row's column heights, sorted.
//
// A column's height at a row is the run of ones ending there. Taking a
// row as the bottom of the submatrix, the columns can be put in any
// order, so the best is to sort the heights: with them ascending, the
// column at k and every one after it reach at least its height, so a
// submatrix of that height is n - k columns wide. O(m n log n).

fn largest_submatrix(matrix: Vec[Vec[i32]]) -> i32 {
    let n = matrix[0].len();
    let mut heights: Vec[i32] = Vec.filled(n, 0);
    let mut best = 0;
    for row in matrix.iter() {
        for j in 0..n {
            heights[j] = if row[j] == 1 { heights[j] + 1 } else { 0 };
        }
        let mut sorted = heights.clone();
        sorted.sort();
        for k in 0..n {
            best = max(best, sorted[k] * (n - k) as i32);
        }
    }
    best
}

// ---- the bench -------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 20;
    let rounds = 50;
    let side = 316;
    let mut seed = 1727;
    let mut problems: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..count {
        let mut matrix: Vec[Vec[i32]] = Vec.new();
        for _ in 0..side {
            let row: Vec[i32] = (0..side).map(|_| if next_random(mut seed) % 8 == 0 { 0 } else { 1 }).collect();
            matrix.push(row);
        }
        problems.push(matrix);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for matrix in problems.iter() {
            let answer = largest_submatrix(matrix);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} matrices of {side} by {side}, {rounds} rounds: areas sum to {sum}, checksum {check}");
}
