// LeetCode #1727: Largest Submatrix With Rearrangements -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac
// fix`.
//
// The matrix itself turned into the column heights in place, each row
// then sorted from the tallest down with `sort_unstable_by`, and the
// j-th height times j + 1 taken at its best.

struct Solution {}

impl Solution {
    pub fn largest_submatrix(matrix: own Vec[Vec[i32]]) -> i32 {
        let mut matrix = matrix;
        let m = matrix.len();
        let n = matrix[0].len();
        for i in 1..m {
            for j in 0..n {
                if matrix[i][j] == 1 {
                    matrix[i][j] += matrix[i - 1][j];
                }
            }
        }
        let mut ans: i32 = 0;
        for row in matrix.iter_mut() {
            row.sort_by(|a, b| b.cmp(a));
            for (j, h) in row.iter().enumerate() {
                ans = ans.max(h * (j as i32 + 1));
            }
        }
        ans
    }
}

fn largest_submatrix(matrix: own Vec[Vec[i32]]) -> i32 {
    Solution.largest_submatrix(matrix)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` matrices of 1 to `most` rows and 1 to `most` columns, each cell
// a one with a chance of 3 in 4
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let m = next_random(mut seed) % most + 1;
        let n = next_random(mut seed) % most + 1;
        let mut matrix: Vec[Vec[i32]] = Vec.new();
        for _ in 0..m {
            let row: Vec[i32] = (0..n).map(|_| if next_random(mut seed) % 4 == 0 { 0 } else { 1 }).collect();
            matrix.push(row);
        }
        let answer = largest_submatrix(matrix);
        sum += answer;
        check = (check * 31 + answer + m * n) % 1000000007;
    }
    println(f"{count} matrices of up to {most} by {most}: areas sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one zero, and 316 rows of 316 ones
    println(largest_submatrix([[0, 0, 1], [1, 1, 1], [1, 0, 1]]));
    println(largest_submatrix([[1, 0, 1, 0, 1]]));
    println(largest_submatrix([[1, 1, 0], [1, 0, 1]]));
    println(largest_submatrix([[0]]));
    println(largest_submatrix(Vec.filled(316, Vec.filled(316, 1))));
    let mut seed = 1727;
    batch(3000, 5, mut seed);
    batch(300, 50, mut seed);
    batch(5, 316, mut seed);
}
