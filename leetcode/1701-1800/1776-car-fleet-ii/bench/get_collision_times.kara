// LeetCode #1776: Car Fleet II -- the bench: the ★ arm, a stack of the cars
// ahead from the right, over 20 lists of 100000 cars built once, 200 calls.

fn catch_time(cars: Vec[Vec[i32]], i: i64, j: i64) -> f64 {
    (cars[j][0] - cars[i][0]) as f64 / (cars[i][1] - cars[j][1]) as f64
}

fn get_collision_times(cars: Vec[Vec[i32]]) -> Vec[f64] {
    let n = cars.len();
    let mut answer: Vec[f64] = Vec.filled(n, -1.0);
    let mut stack: Vec[i64] = Vec.new();
    for i in (0..n).rev() {
        while let Some(j) = stack.last().cloned() {
            if cars[i][1] <= cars[j][1] or (answer[j] > 0.0 and catch_time(cars, i, j) >= answer[j]) {
                stack.pop();
            } else {
                break;
            }
        }
        if let Some(j) = stack.last().cloned() {
            answer[i] = catch_time(cars, i, j);
        }
        stack.push(i);
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1776;
    let mut lists: Vec[Vec[Vec[i32]]] = Vec.new();
    for l in 0..20 {
        let fastest = if l % 2 == 0 { 1000000 } else { 100 };
        let mut cars: Vec[Vec[i32]] = Vec.new();
        let mut position = 0;
        for _ in 0..100000 {
            position += 1 + next_random(mut seed) % 10;
            let speed = 1 + next_random(mut seed) % fastest;
            cars.push([position as i32, speed as i32]);
        }
        lists.push(cars);
    }
    let mut check = 0;
    for call in 0..200 {
        let answer = get_collision_times(lists[(check + call) % 20]);
        let t = answer[check % 100000];
        check = (check * 31 + (t * 100000.0 + 0.5).floor() as i64 + 100001) % 1000000007;
    }
    println(f"200 calls over 20 lists: checksum {check}");
}
