// LeetCode #1707: Maximum XOR With an Element From Array -- the bench: the
// ★ arm on 4 random problems of 100000 values and 100000 queries,
// LeetCode's largest, every number below 10^9, all drawn first, each
// answered 3 times.
//
// The values sorted and the queries taken in order of their limit, each
// value put into a 30-bit trie once its limit is reached; each query
// walks down taking the other bit where it can.

fn maximize_xor(nums: Vec[i32], queries: Vec[Vec[i32]]) -> Vec[i32] {
    let mut values = nums.clone();
    values.sort();
    let mut order: Vec[i64] = (0..queries.len()).collect();
    order.sort_by_key(|i| queries[i][1]);
    // children of each node, 0 for none: the root is node 0
    let mut trie: Vec[Array[i64, 2]] = [[0, 0]];
    let mut next = 0;
    let mut answer: Vec[i32] = Vec.filled(queries.len(), -1);
    for i in order.iter() {
        let (x, m) = (queries[i][0], queries[i][1]);
        while next < values.len() and values[next] <= m {
            let mut node = 0;
            for bit in (0..30).rev() {
                let b = values[next] >> bit & 1;
                if trie[node][b] == 0 {
                    trie.push([0, 0]);
                    trie[node][b] = trie.len() - 1;
                }
                node = trie[node][b];
            }
            next += 1;
        }
        if next == 0 {
            continue;
        }
        let mut node = 0;
        let mut best = 0;
        for bit in (0..30).rev() {
            let want = (x >> bit & 1) ^ 1;
            if trie[node][want] != 0 {
                best |= 1 << bit;
                node = trie[node][want];
            } else {
                node = trie[node][want ^ 1];
            }
        }
        answer[i] = best;
    }
    answer
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random value below 10^9, from two draws
fn value(seed: mut ref i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000
}

fn main() {
    let count = 4;
    let rounds = 3;
    let n = 100000;
    let mut seed = 1707;
    let mut problems: Vec[(Vec[i32], Vec[Vec[i32]])] = Vec.new();
    for _ in 0..count {
        let nums: Vec[i32] = (0..n).map(|_| value(mut seed) as i32).collect();
        let queries: Vec[Vec[i32]] = (0..n).map(|_| [value(mut seed) as i32, value(mut seed) as i32]).collect();
        problems.push((nums, queries));
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, queries) in problems.iter() {
            let answer = maximize_xor(nums, queries);
            for a in answer.iter() {
                sum += a;
                check = (check * 31 + a + 1 + r) % 1000000007;
            }
        }
    }
    println(f"{count} problems of {n} values and {n} queries, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
