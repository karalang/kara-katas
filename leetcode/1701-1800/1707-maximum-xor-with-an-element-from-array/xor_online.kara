// LeetCode #1707: Maximum XOR With an Element From Array -- an online trie
// whose every node knows its smallest value.
//
// All the values go into one trie at once, and each node keeps the
// smallest value below it. A query walks down taking the other bit where
// that child holds some value no larger than m, the same bit where only
// it does; a root whose smallest is above m means no value fits. The
// queries are answered in their own order. O((n + q) * 30).

struct Node {
    child: Array[i64, 2],
    least: i64,
}

fn maximize_xor(nums: Vec[i32], queries: Vec[Vec[i32]]) -> Vec[i32] {
    let mut trie: Vec[Node] = [Node { child: [0, 0], least: i64.MAX }];
    for v in nums.iter() {
        let mut node = 0;
        trie[0].least = min(trie[0].least, v);
        for bit in (0..30).rev() {
            let b = v >> bit & 1;
            if trie[node].child[b] == 0 {
                trie.push(Node { child: [0, 0], least: i64.MAX });
                trie[node].child[b] = trie.len() - 1;
            }
            node = trie[node].child[b];
            trie[node].least = min(trie[node].least, v);
        }
    }
    let mut answer: Vec[i32] = Vec.new();
    for query in queries.iter() {
        let (x, m) = (query[0], query[1]);
        if trie[0].least > m {
            answer.push(-1);
            continue;
        }
        let mut node = 0;
        let mut best = 0;
        for bit in (0..30).rev() {
            let want = (x >> bit & 1) ^ 1;
            let other = trie[node].child[want];
            if other != 0 and trie[other].least <= m {
                best |= 1 << bit;
                node = other;
            } else {
                node = trie[node].child[want ^ 1];
            }
        }
        answer.push(best);
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random value below `top`, from two draws so that it can pass 2^15
fn value(top: i64, seed: mut ref i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % top
}

// `count` random problems of 1 to `most` values and 1 to `most` queries,
// every number below `top`; the answers summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let q = next_random(mut seed) % most + 1;
        let nums: Vec[i32] = (0..n).map(|_| value(top, mut seed) as i32).collect();
        let queries: Vec[Vec[i32]] = (0..q).map(|_| [value(top, mut seed) as i32, value(top, mut seed) as i32]).collect();
        let answer = maximize_xor(nums, queries);
        for a in answer.iter() {
            sum += a;
            check = (check * 31 + a + 1) % 1000000007;
        }
    }
    println(f"{count} problems of up to {most} values below {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then no value small enough, and the largest
    println(maximize_xor([0, 1, 2, 3, 4], [[3, 1], [1, 3], [5, 6]]));
    println(maximize_xor([5, 2, 4, 6, 6, 3], [[12, 4], [8, 1], [6, 3]]));
    println(maximize_xor([7, 8], [[1, 6], [0, 0]]));
    println(maximize_xor([1000000000, 0], [[536870911, 1000000000]]));
    let mut seed = 1707;
    batch(3000, 8, 16, mut seed);
    batch(300, 1000, 1000000000, mut seed);
    batch(3, 100000, 1000000000, mut seed);
}
