// LeetCode #1726: Tuple with Same Product -- each pair matched inside the
// pairs that span it.
//
// With the values sorted, two pairs of one product nest: if a*d = b*c
// with a the smallest of the four, then d is the largest, and b and c lie
// between them. So for each outer pair (i, j) two pointers walk inward
// from i + 1 and j - 1, moving the low one up when the product is too
// small and the high one down when it is too large, and count the inner
// pairs whose product matches. O(n^3).

fn tuple_same_product(nums: Vec[i32]) -> i32 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    let mut nests = 0;
    for i in 0..n {
        for j in i + 3..n {
            let target = sorted[i] * sorted[j];
            let mut lo = i + 1;
            let mut hi = j - 1;
            while lo < hi {
                let product = sorted[lo] * sorted[hi];
                if product < target {
                    lo += 1;
                } else if product > target {
                    hi -= 1;
                } else {
                    nests += 1;
                    lo += 1;
                    hi -= 1;
                }
            }
        }
    }
    8 * nests
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` problems of 1 to `most` distinct values from 1 to `top`, the
// first values of a shuffle of 1 to `top`
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut pool: Vec[i32] = (1..top as i32 + 1).collect();
        for i in 0..n {
            let j = i + next_random(mut seed) % (top - i);
            pool.swap(i, j);
        }
        let nums: Vec[i32] = pool[0..n].to_vec();
        let answer = tuple_same_product(nums);
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} problems of up to {most} values up to {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one value, and the values 1 to 12
    println(tuple_same_product([2, 3, 4, 6]));
    println(tuple_same_product([1, 2, 4, 5, 10]));
    println(tuple_same_product([7]));
    println(tuple_same_product((1..13).collect()));
    let mut seed = 1726;
    batch(3000, 10, 20, mut seed);
    batch(100, 100, 200, mut seed);
    batch(3, 300, 10000, mut seed);
}
