// LeetCode #1726: Tuple with Same Product -- the bench, the ★ arm: every
// pair's product counted in a `Map`, each new pair meeting the earlier
// pairs of its product.
//
// The values are distinct, so two different pairs with one product share
// no value: a*b = a*c would make b = c. Each such two pairs give 8
// tuples, either pair first, each pair in either order. Walking every
// pair once, a pair whose product `seen` earlier pairs already have adds
// 8 * seen. O(n^2).

fn tuple_same_product(nums: Vec[i32]) -> i32 {
    let mut counts: Map[i32, i32] = Map.new();
    let mut tuples: i32 = 0;
    for i in 0..nums.len() {
        for j in i + 1..nums.len() {
            let seen = counts.entry(nums[i] * nums[j]).or_insert(0);
            tuples += 8 * *seen;
            *seen += 1;
        }
    }
    tuples
}

// ---- the bench -------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 20;
    let rounds = 3;
    let n = 1000;
    let top = 10000;
    let mut seed = 1726;
    let mut problems: Vec[Vec[i32]] = Vec.new();
    for _ in 0..count {
        let mut pool: Vec[i32] = (1..top + 1).collect();
        for i in 0..n {
            let j = i + next_random(mut seed) % (top - i);
            pool.swap(i, j);
        }
        problems.push(pool[0..n].to_vec());
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in problems.iter() {
            let answer = tuple_same_product(nums);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} problems of {n} values up to {top}, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
