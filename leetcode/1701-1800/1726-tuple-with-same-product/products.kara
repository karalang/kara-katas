// LeetCode #1726: Tuple with Same Product -- the ★ arm: every pair's
// product counted in a `Map`, each new pair meeting the earlier pairs of
// its product.
//
// The values are distinct, so two different pairs with one product share
// no value: a*b = a*c would make b = c. Each such two pairs give 8
// tuples, either pair first, each pair in either order. Walking every
// pair once, a pair whose product `seen` earlier pairs already have adds
// 8 * seen. O(n^2).

fn tuple_same_product(nums: Vec[i32]) -> i32 {
    let mut counts: Map[i32, i32] = Map.new();
    let mut tuples: i32 = 0;
    for i in 0..nums.len() {
        for j in i + 1..nums.len() {
            let seen = counts.entry(nums[i] * nums[j]).or_insert(0);
            tuples += 8 * *seen;
            *seen += 1;
        }
    }
    tuples
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` problems of 1 to `most` distinct values from 1 to `top`, the
// first values of a shuffle of 1 to `top`
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut pool: Vec[i32] = (1..top as i32 + 1).collect();
        for i in 0..n {
            let j = i + next_random(mut seed) % (top - i);
            pool.swap(i, j);
        }
        let nums: Vec[i32] = pool[0..n].to_vec();
        let answer = tuple_same_product(nums);
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} problems of up to {most} values up to {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one value, and the values 1 to 12
    println(tuple_same_product([2, 3, 4, 6]));
    println(tuple_same_product([1, 2, 4, 5, 10]));
    println(tuple_same_product([7]));
    println(tuple_same_product((1..13).collect()));
    let mut seed = 1726;
    batch(3000, 10, 20, mut seed);
    batch(100, 100, 200, mut seed);
    batch(3, 300, 10000, mut seed);
}
