// LeetCode #1798: Maximum Number of Consecutive Values You Can Make -- the
// same greedy taking the coins smallest first from a `PriorityQueue`,
// stopping at the first that leaves a gap. O(n log n)

fn get_maximum_consecutive(coins: Vec[i32]) -> i32 {
    let mut queue: PriorityQueue[i32] = PriorityQueue.new();
    for c in coins.iter() {
        queue.push(c);
    }
    let mut reach: i32 = 0;
    while let Some(c) = queue.pop() {
        if c > reach + 1 {
            break;
        }
        reach += c;
    }
    reach + 1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    let first: Vec[i32] = [1, 3].to_vec();
    let second: Vec[i32] = [1, 1, 1, 4].to_vec();
    let third: Vec[i32] = [1, 4, 10, 3, 1].to_vec();
    println(f"{get_maximum_consecutive(first)} {get_maximum_consecutive(second)} {get_maximum_consecutive(third)}");
    // the edges: one coin of 1; one coin of 2; the powers of two; three
    // ones; a coin too large after two ones
    let one: Vec[i32] = [1].to_vec();
    let two: Vec[i32] = [2].to_vec();
    let powers: Vec[i32] = [8, 4, 2, 1].to_vec();
    let ones: Vec[i32] = [1, 1, 1].to_vec();
    let gap: Vec[i32] = [5, 1, 1].to_vec();
    println(f"{get_maximum_consecutive(one)} {get_maximum_consecutive(two)} {get_maximum_consecutive(powers)} {get_maximum_consecutive(ones)} {get_maximum_consecutive(gap)}");
    // the constraints' most: 40000 coins of 40000; 40000 ones; the coins
    // 40000 down to 1; and 40000 coins at random
    let big: Vec[i32] = Vec.filled(40000, 40000);
    let small: Vec[i32] = Vec.filled(40000, 1);
    let every: Vec[i32] = (1..40001).rev().map(|v| v as i32).collect();
    let mut seed = 1798;
    let wide: Vec[i32] = (0..40000).map(|_| (1 + next_random(mut seed) % 40000) as i32).collect();
    println(f"the most: {get_maximum_consecutive(big)} {get_maximum_consecutive(small)} {get_maximum_consecutive(every)} {get_maximum_consecutive(wide)}");
    // 3000 random cases of 1 to 15 coins of 1 to 1 + 0 to 11
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 15;
        let top = 1 + next_random(mut seed) % 12;
        let coins: Vec[i32] = (0..n).map(|_| (1 + next_random(mut seed) % top) as i32).collect();
        check = (check * 31 + get_maximum_consecutive(coins)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
