// LeetCode #1798: Maximum Number of Consecutive Values You Can Make --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- get_maximum_consecutive.kara ----
fn a0_get_maximum_consecutive(coins: Vec[i32]) -> i32 {
    let mut sorted = coins.clone();
    sorted.sort();
    let mut reach: i32 = 0;
    for c in sorted.iter() {
        if c > reach + 1 {
            break;
        }
        reach += c;
    }
    reach + 1
}

// ---- get_maximum_consecutive_heap.kara ----
fn a1_get_maximum_consecutive(coins: Vec[i32]) -> i32 {
    let mut queue: PriorityQueue[i32] = PriorityQueue.new();
    for c in coins.iter() {
        queue.push(c);
    }
    let mut reach: i32 = 0;
    while let Some(c) = queue.pop() {
        if c > reach + 1 {
            break;
        }
        reach += c;
    }
    reach + 1
}

// ---- get_maximum_consecutive_count.kara ----
fn a2_get_maximum_consecutive(coins: Vec[i32]) -> i32 {
    let top = coins.iter().max().unwrap();
    let mut count: Vec[i64] = Vec.filled(top as i64 + 1, 0);
    for c in coins.iter() {
        count[c] += 1;
    }
    let mut reach: i64 = 0;
    for v in 1..top as i64 + 1 {
        if count[v] == 0 {
            continue;
        }
        if v > reach + 1 {
            break;
        }
        reach += count[v] * v;
    }
    (reach + 1) as i32
}

// ---- get_maximum_consecutive_scan.kara ----
fn a3_get_maximum_consecutive(coins: Vec[i32]) -> i32 {
    let mut sorted = coins.clone();
    sorted.sort();
    let reach = sorted.iter().scan(0i32, |reach, c| if c > reach + 1 { None } else { Some((reach + c, reach + c)) }).last().unwrap_or(0);
    reach + 1
}

// ---- get_maximum_consecutive_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn get_maximum_consecutive(coins: own Vec[i32]) -> i32 {
        let mut coins = coins;
        coins.sort();
        let mut ans: i32 = 1;
        for c in coins {
            if c > ans {
                break;
            }
            ans += c;
        }
        ans
    }
}

fn a4_get_maximum_consecutive(coins: own Vec[i32]) -> i32 {
    A4Solution.get_maximum_consecutive(coins)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every subset of the coins summed, and the
// values made counted up from 0 to the first one missing
fn literal(coins: Vec[i32]) -> i32 {
    let n = coins.len();
    let total: i64 = coins.iter().map(|c| c as i64).sum();
    let mut made: Vec[bool] = Vec.filled(total + 2, false);
    for mask in 0..(1 << n) {
        let mut sum = 0;
        for i in 0..n {
            if mask >> i & 1 == 1 {
                sum += coins[i];
            }
        }
        made[sum] = true;
    }
    let mut v = 0;
    while made[v] {
        v += 1;
    }
    v as i32
}

fn arm(i: i64, coins: Vec[i32]) -> i32 {
    match i {
        0 => a0_get_maximum_consecutive(coins),
        1 => a1_get_maximum_consecutive(coins),
        2 => a2_get_maximum_consecutive(coins),
        3 => a3_get_maximum_consecutive(coins),
        _ => a4_get_maximum_consecutive(coins.clone()),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, coins: Vec[i32]) {
    t.cases += 1;
    let star = arm(0, coins);
    t.check = (t.check * 31 + star) % 1000000007;
    let want = if coins.len() <= 14 { Some(literal(coins)) } else { None };
    let mut back = coins.clone();
    back.reverse();
    let mut one = coins.clone();
    one.push(1);
    let mut fill = coins.clone();
    fill.push(star);
    let total: i64 = coins.iter().map(|c| c as i64).sum();
    let mut far = coins.clone();
    if total + 2 <= 40000 {
        far.push((total + 2) as i32);
    }
    for i in 0..5 {
        let what = f"arm {i} on {coins}";
        let got = arm(i, coins);
        // P1: the statement read literally, while there are at most 14
        // coins
        if let Some(w) = want {
            expect(mut t, 1, got == w, f"P1 {what}");
        }
        // P2: the coins in reverse order give the same answer
        expect(mut t, 2, arm(i, back) == got, f"P2 {what}");
        // P3: one more coin of 1 raises the answer by at least 1
        expect(mut t, 3, arm(i, one) >= got + 1, f"P3 {what}");
        // P4: one more coin worth the answer at least doubles it
        expect(mut t, 4, arm(i, fill) >= 2 * got, f"P4 {what}");
        // P5: one more coin above the sum of all of them plus 1 changes
        // nothing
        expect(mut t, 5, arm(i, far) == got, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples, the edges, 3000 coins at random and 3000 ones,
    // and 1990 random cases of 1 to 14 coins. Every case is drawn before
    // any arm answers.
    let mut cases: Vec[Vec[i32]] = [[1, 3].to_vec(), [1, 1, 1, 4].to_vec(), [1, 4, 10, 3, 1].to_vec(), [1].to_vec(), [2].to_vec(), [8, 4, 2, 1].to_vec(), [1, 1, 1].to_vec(), [5, 1, 1].to_vec()].to_vec();
    let mut seed = 17981;
    cases.push((0..3000).map(|_| (1 + next_random(mut seed) % 40000) as i32).collect());
    cases.push(Vec.filled(3000, 1));
    for _ in 0..1990 {
        let n = 1 + next_random(mut seed) % 14;
        let top = 1 + next_random(mut seed) % 12;
        cases.push((0..n).map(|_| (1 + next_random(mut seed) % top) as i32).collect());
    }
    for j in 0..cases.len() {
        check_case(mut t, cases[j].clone());
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
