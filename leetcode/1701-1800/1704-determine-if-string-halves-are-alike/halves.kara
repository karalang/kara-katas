// LeetCode #1704: Determine if String Halves Are Alike -- the ★ arm: one
// pass, a vowel in the first half counted up and in the second down.
//
// The halves are alike when the count comes back to 0. A `match` on each
// byte names the ten vowels. O(n).

fn halves_are_alike(s: String) -> bool {
    let bytes = s.bytes();
    let half = bytes.len() / 2;
    let mut balance = 0;
    for (i, b) in bytes.iter().enumerate() {
        match b {
            b'a' | b'e' | b'i' | b'o' | b'u' | b'A' | b'E' | b'I' | b'O' | b'U' => {
                balance += if i < half { 1 } else { -1 };
            }
            _ => {}
        }
    }
    balance == 0
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random strings of an even 2 to `most` letters, each a vowel
// with a chance of its string's own from 0 to 10 in 10 and otherwise a
// consonant, either case; the strings alike, and a checksum
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let vowels = "aeiouAEIOU".bytes();
    let consonants = "bcdfghjklmnpqrstvwxyzBCDFGHJKLMNPQRSTVWXYZ".bytes();
    let mut alike = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = 2 * (next_random(mut seed) % (most / 2) + 1);
        let lean = next_random(mut seed) % 11;
        let mut s = String.with_capacity(n);
        for _ in 0..n {
            let b = if next_random(mut seed) % 10 < lean {
                vowels[next_random(mut seed) % vowels.len()]
            } else {
                consonants[next_random(mut seed) % consonants.len()]
            };
            s.push(b as char);
        }
        let answer = halves_are_alike(s);
        if answer {
            alike += 1;
        }
        check = (check * 31 + (if answer { 1 } else { 2 }) + n) % 1000000007;
    }
    println(f"{count} strings of up to {most} letters: {alike} alike, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then capitals, no vowels, and two vowels
    println(halves_are_alike("book"));
    println(halves_are_alike("textbook"));
    println(halves_are_alike("AbCdEfGhIo"));
    println(halves_are_alike("xyzw"));
    println(halves_are_alike("ae"));
    let mut seed = 1704;
    batch(3000, 12, mut seed);
    batch(300, 100, mut seed);
    batch(3000, 1000, mut seed);
}
