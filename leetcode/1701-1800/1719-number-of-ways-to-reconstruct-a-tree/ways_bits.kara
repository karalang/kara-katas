// LeetCode #1719: Number Of Ways To Reconstruct A Tree -- each node's
// neighbours as the bits of eight `u64` words.
//
// The same rule as the ★ arm, with the subset test a word at a time: a
// node's neighbours other than its parent must all be the parent's, so
// `mine & ~(theirs | parent's own bit)` is zero in every word. A node's
// degree is the count of its set bits. O(n^2 / 64) for the tests, O(n^2)
// to find the parents.

fn check_ways(pairs: Vec[Vec[i32]]) -> i32 {
    let words = 8;
    let mut near: Vec[Vec[u64]] = Vec.filled(501, Vec.filled(words, 0u64));
    for pair in pairs.iter() {
        let (x, y) = (pair[0], pair[1]);
        near[x][y / 64] |= 1u64 << (y % 64);
        near[y][x / 64] |= 1u64 << (x % 64);
    }
    let degree: Vec[i64] = near.iter().map(|bits| bits.iter().map(|w| w.count_ones()).sum()).collect();
    let nodes: Vec[i64] = (0..501).filter(|v| degree[v] > 0).collect();
    let n = nodes.len();
    let mut roots = 0;
    let mut ways = 1;
    for v in nodes.iter() {
        if degree[v] == n - 1 {
            roots += 1;
            continue;
        }
        // the neighbour with the fewest pairs among those with as many
        let mut parent = -1;
        for u in nodes.iter() {
            if near[v][u / 64] >> (u % 64) & 1 == 1 and degree[u] >= degree[v] {
                if parent < 0 or degree[u] < degree[parent] {
                    parent = u;
                }
            }
        }
        if parent < 0 {
            return 0;
        }
        for w in 0..words {
            let mut allowed = near[parent][w];
            if parent / 64 == w {
                allowed |= 1u64 << (parent % 64);
            }
            if near[v][w] & ~allowed != 0 {
                return 0;
            }
        }
        if degree[parent] == degree[v] {
            ways = 2;
        }
    }
    if roots == 0 {
        return 0;
    }
    if roots > 1 {
        ways = 2;
    }
    ways
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random problem over 2 to `most` nodes labelled from 1 to 500: half the
// time the ancestor pairs of a random tree, kept, with one pair dropped,
// or with one added, and half the time random pairs.
fn draw(most: i64, seed: mut ref i64) -> Vec[Vec[i32]] {
    let k = 2 + next_random(mut seed) % (most - 1);
    let mut labels: Vec[i32] = (1..=500).collect();
    for i in 0..k {
        let j = i + next_random(mut seed) % (500 - i);
        labels.swap(i, j);
    }
    let mut have: Vec[Vec[bool]] = Vec.filled(k, Vec.filled(k, false));
    if next_random(mut seed) % 2 == 0 {
        let mut parent: Vec[i64] = Vec.filled(k, -1);
        for i in 1..k {
            parent[i] = next_random(mut seed) % i;
        }
        for i in 1..k {
            let mut a = parent[i];
            while a >= 0 {
                have[i][a] = true;
                have[a][i] = true;
                a = parent[a];
            }
        }
        let mode = next_random(mut seed) % 3;
        let i = next_random(mut seed) % k;
        let j = next_random(mut seed) % k;
        if i != j {
            if mode == 1 {
                have[i][j] = false;
                have[j][i] = false;
            } else if mode == 2 {
                have[i][j] = true;
                have[j][i] = true;
            }
        }
    } else {
        for i in 0..k {
            for j in i + 1..k {
                if next_random(mut seed) % 2 == 0 {
                    have[i][j] = true;
                    have[j][i] = true;
                }
            }
        }
    }
    let mut pairs: Vec[Vec[i32]] = Vec.new();
    for i in 0..k {
        for j in i + 1..k {
            if have[i][j] {
                pairs.push([min(labels[i], labels[j]), max(labels[i], labels[j])]);
            }
        }
    }
    if pairs.is_empty() {
        pairs.push([min(labels[0], labels[1]), max(labels[0], labels[1])]);
    }
    pairs
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let pairs = draw(most, mut seed);
        let answer = check_ways(pairs);
        sum += answer;
        check = (check * 31 + answer + pairs.len()) % 1000000007;
    }
    println(f"{count} problems of up to {most} nodes: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one pair, and a star whose centre is
    // the only root
    println(check_ways([[1, 2], [2, 3]]));
    println(check_ways([[1, 2], [2, 3], [1, 3]]));
    println(check_ways([[1, 2], [2, 3], [2, 4], [1, 5]]));
    println(check_ways([[1, 500]]));
    println(check_ways([[1, 2], [1, 3], [1, 4]]));
    let mut seed = 1719;
    batch(3000, 6, mut seed);
    batch(300, 50, mut seed);
    batch(10, 500, mut seed);
}
