// LeetCode #1719: Number Of Ways To Reconstruct A Tree -- the bench
// (ways.kara): the nodes by degree, most first, each hung under the last
// earlier neighbour, which must hold every other neighbour of it.
//
// 50 problems over all 500 nodes, each the ancestor pairs of a random
// tree, half its parents picked anywhere above and half a few places
// above, so some trees run deep; one in three with a pair dropped and one
// in three with one added. All drawn first, then each answered 50 times.

fn check_ways(pairs: Vec[Vec[i32]]) -> i32 {
    let size = 501;
    let mut linked: Vec[Vec[bool]] = Vec.filled(size, Vec.filled(size, false));
    let mut degree: Vec[i64] = Vec.filled(size, 0);
    for pair in pairs.iter() {
        let (x, y) = (pair[0], pair[1]);
        linked[x][y] = true;
        linked[y][x] = true;
        degree[x] += 1;
        degree[y] += 1;
    }
    let mut nodes: Vec[i64] = (0..size).filter(|v| degree[v] > 0).collect();
    let n = nodes.len();
    nodes.sort_by_key(|v| -degree[v]);
    if degree[nodes[0]] != n - 1 {
        return 0;
    }
    let mut ways = 1;
    for i in 1..n {
        let v = nodes[i];
        // the earlier neighbour with the fewest pairs
        let mut parent = -1;
        for j in (0..i).rev() {
            if linked[v][nodes[j]] {
                parent = nodes[j];
                break;
            }
        }
        if parent < 0 {
            return 0;
        }
        for u in nodes.iter() {
            if u != parent and linked[v][u] and not linked[parent][u] {
                return 0;
            }
        }
        if degree[parent] == degree[v] {
            ways = 2;
        }
    }
    ways
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn draw(seed: mut ref i64) -> Vec[Vec[i32]] {
    let k = 500;
    let mut labels: Vec[i32] = (1..=500).collect();
    for i in 0..k {
        let j = i + next_random(mut seed) % (500 - i);
        labels.swap(i, j);
    }
    let mut have: Vec[Vec[bool]] = Vec.filled(k, Vec.filled(k, false));
    let mut parent: Vec[i64] = Vec.filled(k, -1);
    for i in 1..k {
        parent[i] = if next_random(mut seed) % 2 == 0 { next_random(mut seed) % i } else { i - 1 - next_random(mut seed) % min(i, 4) };
    }
    for i in 1..k {
        let mut a = parent[i];
        while a >= 0 {
            have[i][a] = true;
            have[a][i] = true;
            a = parent[a];
        }
    }
    let mode = next_random(mut seed) % 3;
    let i = next_random(mut seed) % k;
    let j = next_random(mut seed) % k;
    if i != j and mode > 0 {
        have[i][j] = mode == 2;
        have[j][i] = mode == 2;
    }
    let mut pairs: Vec[Vec[i32]] = Vec.new();
    for i in 0..k {
        for j in i + 1..k {
            if have[i][j] {
                pairs.push([min(labels[i], labels[j]), max(labels[i], labels[j])]);
            }
        }
    }
    pairs
}

fn main() {
    let count = 50;
    let rounds = 50;
    let mut seed = 1719;
    let problems: Vec[Vec[Vec[i32]]] = (0..count).map(|_| draw(mut seed)).collect();
    let pairs: i64 = problems.iter().map(|p| p.len()).sum();
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for p in problems.iter() {
            let answer = check_ways(p);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} problems of 500 nodes, {pairs} pairs, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
