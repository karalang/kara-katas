// LeetCode #1719: Number Of Ways To Reconstruct A Tree -- the ★ arm: the
// nodes by degree, most first, each hung under the last earlier neighbour,
// which must hold every other neighbour of it.
//
// A node's pairs are its ancestors and its descendants, so an ancestor has
// at least as many pairs as any node below it. The root is paired with
// every node. Taken by degree, most first, a node's parent is the earlier
// neighbour with the fewest pairs, and every other neighbour of the node
// must be a neighbour of that parent too, or no tree fits. A parent with
// as many pairs as its child could swap places with it: then there is
// more than one tree. The pairs as a 501 by 501 matrix. O(n^2), n the
// nodes.

fn check_ways(pairs: Vec[Vec[i32]]) -> i32 {
    let size = 501;
    let mut linked: Vec[Vec[bool]] = Vec.filled(size, Vec.filled(size, false));
    let mut degree: Vec[i64] = Vec.filled(size, 0);
    for pair in pairs.iter() {
        let (x, y) = (pair[0], pair[1]);
        linked[x][y] = true;
        linked[y][x] = true;
        degree[x] += 1;
        degree[y] += 1;
    }
    let mut nodes: Vec[i64] = (0..size).filter(|v| degree[v] > 0).collect();
    let n = nodes.len();
    nodes.sort_by_key(|v| -degree[v]);
    if degree[nodes[0]] != n - 1 {
        return 0;
    }
    let mut ways = 1;
    for i in 1..n {
        let v = nodes[i];
        // the earlier neighbour with the fewest pairs
        let mut parent = -1;
        for j in (0..i).rev() {
            if linked[v][nodes[j]] {
                parent = nodes[j];
                break;
            }
        }
        if parent < 0 {
            return 0;
        }
        for u in nodes.iter() {
            if u != parent and linked[v][u] and not linked[parent][u] {
                return 0;
            }
        }
        if degree[parent] == degree[v] {
            ways = 2;
        }
    }
    ways
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random problem over 2 to `most` nodes labelled from 1 to 500: half the
// time the ancestor pairs of a random tree, kept, with one pair dropped,
// or with one added, and half the time random pairs.
fn draw(most: i64, seed: mut ref i64) -> Vec[Vec[i32]] {
    let k = 2 + next_random(mut seed) % (most - 1);
    let mut labels: Vec[i32] = (1..=500).collect();
    for i in 0..k {
        let j = i + next_random(mut seed) % (500 - i);
        labels.swap(i, j);
    }
    let mut have: Vec[Vec[bool]] = Vec.filled(k, Vec.filled(k, false));
    if next_random(mut seed) % 2 == 0 {
        let mut parent: Vec[i64] = Vec.filled(k, -1);
        for i in 1..k {
            parent[i] = next_random(mut seed) % i;
        }
        for i in 1..k {
            let mut a = parent[i];
            while a >= 0 {
                have[i][a] = true;
                have[a][i] = true;
                a = parent[a];
            }
        }
        let mode = next_random(mut seed) % 3;
        let i = next_random(mut seed) % k;
        let j = next_random(mut seed) % k;
        if i != j {
            if mode == 1 {
                have[i][j] = false;
                have[j][i] = false;
            } else if mode == 2 {
                have[i][j] = true;
                have[j][i] = true;
            }
        }
    } else {
        for i in 0..k {
            for j in i + 1..k {
                if next_random(mut seed) % 2 == 0 {
                    have[i][j] = true;
                    have[j][i] = true;
                }
            }
        }
    }
    let mut pairs: Vec[Vec[i32]] = Vec.new();
    for i in 0..k {
        for j in i + 1..k {
            if have[i][j] {
                pairs.push([min(labels[i], labels[j]), max(labels[i], labels[j])]);
            }
        }
    }
    if pairs.is_empty() {
        pairs.push([min(labels[0], labels[1]), max(labels[0], labels[1])]);
    }
    pairs
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let pairs = draw(most, mut seed);
        let answer = check_ways(pairs);
        sum += answer;
        check = (check * 31 + answer + pairs.len()) % 1000000007;
    }
    println(f"{count} problems of up to {most} nodes: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one pair, and a star whose centre is
    // the only root
    println(check_ways([[1, 2], [2, 3]]));
    println(check_ways([[1, 2], [2, 3], [1, 3]]));
    println(check_ways([[1, 2], [2, 3], [2, 4], [1, 5]]));
    println(check_ways([[1, 500]]));
    println(check_ways([[1, 2], [1, 3], [1, 4]]));
    let mut seed = 1719;
    batch(3000, 6, mut seed);
    batch(300, 50, mut seed);
    batch(10, 500, mut seed);
}
