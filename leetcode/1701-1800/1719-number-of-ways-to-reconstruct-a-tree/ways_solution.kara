// LeetCode #1719: Number Of Ways To Reconstruct A Tree -- a Rust solution
// as LeetCode's Rust users write it: a `HashMap<i32, HashSet<i32>>` built
// with `entry().or_default()`, the nodes sorted by `sort_by` on their set
// sizes, and the parent found among the neighbours with `usize::MAX` as
// the first fewest.

struct Solution {}

impl Solution {
    pub fn check_ways(pairs: Vec[Vec[i32]]) -> i32 {
        let mut adj: Map[i32, Set[i32]] = Map.new();
        for p in ref pairs {
            adj.entry(p[0]).or_insert(Set.new()).insert(p[1]);
            adj.entry(p[1]).or_insert(Set.new()).insert(p[0]);
        }
        let n = adj.len();
        let mut nodes: Vec[i32] = adj.keys().cloned().collect();
        nodes.sort_by(|a, b| adj[b].len().cmp(adj[a].len()));
        if adj[nodes[0]].len() != n - 1 {
            return 0;
        }
        let mut res = 1;
        for node in nodes[1..] {
            let deg = adj[node].len();
            let mut parent = -1;
            let mut parent_deg = i64.MAX;
            for nb in ref adj[node] {
                let d = adj[nb].len();
                if d >= deg and d < parent_deg {
                    parent = nb;
                    parent_deg = d;
                }
            }
            if parent == -1 {
                return 0;
            }
            for nb in ref adj[node] {
                if nb != parent and not adj[parent].contains(nb) {
                    return 0;
                }
            }
            if parent_deg == deg {
                res = 2;
            }
        }
        res
    }
}

fn check_ways(pairs: Vec[Vec[i32]]) -> i32 {
    Solution.check_ways(pairs)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random problem over 2 to `most` nodes labelled from 1 to 500: half the
// time the ancestor pairs of a random tree, kept, with one pair dropped,
// or with one added, and half the time random pairs.
fn draw(most: i64, seed: mut ref i64) -> Vec[Vec[i32]] {
    let k = 2 + next_random(mut seed) % (most - 1);
    let mut labels: Vec[i32] = (1..=500).collect();
    for i in 0..k {
        let j = i + next_random(mut seed) % (500 - i);
        labels.swap(i, j);
    }
    let mut have: Vec[Vec[bool]] = Vec.filled(k, Vec.filled(k, false));
    if next_random(mut seed) % 2 == 0 {
        let mut parent: Vec[i64] = Vec.filled(k, -1);
        for i in 1..k {
            parent[i] = next_random(mut seed) % i;
        }
        for i in 1..k {
            let mut a = parent[i];
            while a >= 0 {
                have[i][a] = true;
                have[a][i] = true;
                a = parent[a];
            }
        }
        let mode = next_random(mut seed) % 3;
        let i = next_random(mut seed) % k;
        let j = next_random(mut seed) % k;
        if i != j {
            if mode == 1 {
                have[i][j] = false;
                have[j][i] = false;
            } else if mode == 2 {
                have[i][j] = true;
                have[j][i] = true;
            }
        }
    } else {
        for i in 0..k {
            for j in i + 1..k {
                if next_random(mut seed) % 2 == 0 {
                    have[i][j] = true;
                    have[j][i] = true;
                }
            }
        }
    }
    let mut pairs: Vec[Vec[i32]] = Vec.new();
    for i in 0..k {
        for j in i + 1..k {
            if have[i][j] {
                pairs.push([min(labels[i], labels[j]), max(labels[i], labels[j])]);
            }
        }
    }
    if pairs.is_empty() {
        pairs.push([min(labels[0], labels[1]), max(labels[0], labels[1])]);
    }
    pairs
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let pairs = draw(most, mut seed);
        let answer = check_ways(pairs);
        sum += answer;
        check = (check * 31 + answer + pairs.len()) % 1000000007;
    }
    println(f"{count} problems of up to {most} nodes: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one pair, and a star whose centre is
    // the only root
    println(check_ways([[1, 2], [2, 3]]));
    println(check_ways([[1, 2], [2, 3], [1, 3]]));
    println(check_ways([[1, 2], [2, 3], [2, 4], [1, 5]]));
    println(check_ways([[1, 500]]));
    println(check_ways([[1, 2], [1, 3], [1, 4]]));
    let mut seed = 1719;
    batch(3000, 6, mut seed);
    batch(300, 50, mut seed);
    batch(10, 500, mut seed);
}
