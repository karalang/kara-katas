// LeetCode #1763: Longest Nice Substring -- differential test of the
// five arms against the statement read literally, with five more
// properties.

// ---- longest_nice_substring.kara ----
fn a0_longest_nice_substring(s: String) -> String {
    let bytes = s.bytes();
    for i in 0..bytes.len() {
        let c = bytes[i];
        let other = if c.is_ascii_lowercase() { c.to_ascii_uppercase() } else { c.to_ascii_lowercase() };
        if not bytes.contains(other) {
            let left = a0_longest_nice_substring(s[..i].to_string());
            let right = a0_longest_nice_substring(s[i + 1..].to_string());
            return if right.len() > left.len() { right } else { left };
        }
    }
    s.clone()
}

// ---- longest_nice_substring_brute.kara ----
fn a1_is_nice(t: Str) -> bool {
    t.chars().all(|c| t.contains(if c.is_lowercase() { c.to_uppercase() } else { c.to_lowercase() }.to_string().as_str()))
}

fn a1_longest_nice_substring(s: String) -> String {
    let n = s.len();
    for len in (2..n + 1).rev() {
        for start in 0..n - len + 1 {
            let t = s[start..start + len];
            if a1_is_nice(t) {
                return t.to_string();
            }
        }
    }
    String.new()
}

// ---- longest_nice_substring_masks.kara ----
fn a2_longest_nice_substring(s: String) -> String {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut (best_start, best_len) = (0, 0);
    for start in 0..n {
        let mut (lower, upper) = (0u32, 0u32);
        for end in start..n {
            let c = bytes[end];
            if c.is_ascii_lowercase() {
                lower |= 1u32 << (c - b'a');
            } else {
                upper |= 1u32 << (c - b'A');
            }
            if lower == upper and end + 1 - start > best_len {
                best_start = start;
                best_len = end + 1 - start;
            }
        }
    }
    s[best_start..best_start + best_len].to_string()
}

// ---- longest_nice_substring_window.kara ----
fn a3_longest_nice_substring(s: String) -> String {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut (best_start, best_len) = (0, 0);
    let index = |c: u8| (c.to_ascii_lowercase() - b'a') as i64;
    for k in 1..27 {
        let mut lower: Vec[i64] = Vec.filled(26, 0);
        let mut upper: Vec[i64] = Vec.filled(26, 0);
        let mut (distinct, both, left) = (0, 0, 0);
        for right in 0..n {
            let c = bytes[right];
            let i = index(c);
            if lower[i] + upper[i] == 0 {
                distinct += 1;
            }
            let was_both = lower[i] > 0 and upper[i] > 0;
            if c.is_ascii_lowercase() { lower[i] += 1; } else { upper[i] += 1; }
            if not was_both and lower[i] > 0 and upper[i] > 0 {
                both += 1;
            }
            while distinct > k {
                let d = bytes[left];
                let j = index(d);
                let had_both = lower[j] > 0 and upper[j] > 0;
                if d.is_ascii_lowercase() { lower[j] -= 1; } else { upper[j] -= 1; }
                if had_both and not (lower[j] > 0 and upper[j] > 0) {
                    both -= 1;
                }
                if lower[j] + upper[j] == 0 {
                    distinct -= 1;
                }
                left += 1;
            }
            let len = right + 1 - left;
            if distinct == k and both == k and (len > best_len or (len == best_len and left < best_start)) {
                best_start = left;
                best_len = len;
            }
        }
    }
    s[best_start..best_start + best_len].to_string()
}

// ---- longest_nice_substring_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn longest_nice_substring(s: String) -> String {
        let chars: Vec[char] = s.chars().collect();
        let n = chars.len();
        let mut ans = String.new();
        for i in 0..n {
            for j in i + 1..=n {
                let sub = chars[i..j];
                let ok = sub.iter().all(|c| {
                    sub.contains(c.to_ascii_lowercase()) and sub.contains(c.to_ascii_uppercase())
                });
                if ok and j - i > ans.len() {
                    ans = sub.iter().collect();
                }
            }
        }
        ans
    }
}

fn a4_longest_nice_substring(s: String) -> String {
    A4Solution.longest_nice_substring(s)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_text(seed: mut ref i64, n: i64, letters: i64, upper: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        let base = if next_random(mut seed) % 100 < upper { 65 } else { 97 };
        s.push(char.try_from((base + next_random(mut seed) % letters) as u32).ok().unwrap());
    }
    s
}

// every letter of t has its other case in t
fn nice(t: Str) -> bool {
    let lower: Set[char] = t.chars().filter(|c| c.is_lowercase()).collect();
    let upper: Set[char] = t.chars().filter(|c| c.is_uppercase()).map(|c| c.to_lowercase()).collect();
    lower == upper
}

// the statement read literally: every substring, its start and end, and
// the longest nice one, the earliest among the longest
fn literal(s: String) -> String {
    let n = s.len();
    let mut best = String.new();
    for start in 0..n {
        for end in start + 1..n + 1 {
            let t = s[start..end];
            if nice(t) and t.len() > best.len() {
                best = t.to_string();
            }
        }
    }
    best
}

fn swap_case(s: Str) -> String {
    s.chars().map(|c| if c.is_lowercase() { c.to_uppercase() } else { c.to_lowercase() }).collect()
}

fn arm(i: i64, s: String) -> String {
    match i {
        0 => a0_longest_nice_substring(s),
        1 => a1_longest_nice_substring(s),
        2 => a2_longest_nice_substring(s),
        3 => a3_longest_nice_substring(s),
        _ => a4_longest_nice_substring(s),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, s: String) {
    t.cases += 1;
    let want = literal(s);
    let at = s.find(want.as_str()).unwrap_or(0);
    t.check = (t.check * 31 + want.len() * 100 + at) % 1000000007;
    let star = arm(0, s);
    let swapped = swap_case(s);
    // each letter moved one on in the alphabet, z to a, its case kept: no
    // case pair is made or broken
    let renamed: String = s.chars().map(|c| {
        let base = if c.is_lowercase() { 97 } else { 65 };
        char.try_from(base + (c as u32 - base + 1) % 26).ok().unwrap()
    }).collect();
    // no case has a capital Z
    let longer = s + "z";
    for i in 0..5 {
        let what = f"arm {i} on \"{s}\"";
        let got = arm(i, s);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: a nice substring of s
        expect(mut t, 2, nice(got.as_str()) and s.contains(got.as_str()), f"P2 {what}");
        // P3: every case swapped gives the answer with its cases swapped
        expect(mut t, 3, arm(i, swapped) == swap_case(got.as_str()), f"P3 {what}");
        // P4: the letters renamed give an answer as long, at the same place
        let moved = arm(i, renamed);
        expect(mut t, 4, moved.len() == got.len() and renamed.find(moved.as_str()) == s.find(got.as_str()), f"P4 {what}");
        // P5: a letter with no other case at the end changes nothing
        expect(mut t, 5, arm(i, longer) == got, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[String] = ["YazaAay", "Bb", "c", "dDzeE", "abcABx", "aAbBcC", "aAxbB", "qwertyEe", "aXXXXA"].iter().map(|s| s.to_string()).collect();
    let mut seed = 17631;
    // 1991 random strings of 1 to 14 letters from the first 1 to 5 of the
    // alphabet, a capital with a chance drawn for the string
    for _ in 0..1991 {
        let n = 1 + next_random(mut seed) % 14;
        let letters = 1 + next_random(mut seed) % 5;
        let upper = next_random(mut seed) % 101;
        cases.push(random_text(mut seed, n, letters, upper));
    }
    for j in 0..cases.len() {
        check_case(mut t, cases[j]);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
