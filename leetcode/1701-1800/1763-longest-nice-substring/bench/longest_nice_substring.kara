// LeetCode #1763: Longest Nice Substring -- the bench, mirroring the ★ arm:
// divide and conquer at each letter whose other case is missing. 1000
// strings of 100 letters, built once, each from its own number of letters
// and chance of a capital, and 500000 calls, each on a string chosen from
// the checksum so far.
fn longest_nice_substring(s: String) -> String {
    let bytes = s.bytes();
    for i in 0..bytes.len() {
        let c = bytes[i];
        let other = if c.is_ascii_lowercase() { c.to_ascii_uppercase() } else { c.to_ascii_lowercase() };
        if not bytes.contains(other) {
            let left = longest_nice_substring(s[..i].to_string());
            let right = longest_nice_substring(s[i + 1..].to_string());
            return if right.len() > left.len() { right } else { left };
        }
    }
    s.clone()
}

fn main() {
    let mut seed = 1763;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..1000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let letters = 1 + seed / 65536 % 12;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let upper = seed / 65536 % 101;
        let mut s = String.new();
        for _ in 0..100 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let base = if seed / 65536 % 100 < upper { 65 } else { 97 };
            seed = (seed * 1103515245 + 12345) % 2147483648;
            s.push(char.try_from((base + seed / 65536 % letters) as u32).ok().unwrap());
        }
        strings.push(s);
    }
    let mut check = 0;
    for call in 0..500000 {
        let s = ref strings[(check + call * 7919) % 1000];
        check = (check * 31 + longest_nice_substring(s).len()) % 1000000007;
    }
    println(f"500000 calls over 1000 strings: checksum {check}");
}
