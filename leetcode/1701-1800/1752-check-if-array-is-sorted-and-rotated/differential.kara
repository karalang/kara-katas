// LeetCode #1752: Check if Array Is Sorted and Rotated -- the
// differential.
//
// Four arms against the statement read literally, on 3000 random arrays
// of 1 to 7 values from 1 to 4, half of them sorted and rotated.
//
// P1  the answer is the statement read literally
// P2  the array rotated by one gives the same answer
// P3  the array reversed and negated gives the same answer
// P4  the array sorted answers true
// P5  each arm agrees with at least two of the other three

// ---- rotated.kara: the ★ arm: count the drops

fn star_arm(nums: Vec[i32]) -> bool {
    let drops = nums.windows(2).into_iter().filter(|w| w[0] > w[1]).count();
    let wrap = if nums[nums.len() - 1] > nums[0] { 1 } else { 0 };
    drops + wrap <= 1
}

// ---- rotated_try.kara: every rotation tried

fn try_arm(nums: Vec[i32]) -> bool {
    let n = nums.len();
    (0..n).any(|x| (0..n - 1).all(|i| nums[(x + i) % n] <= nums[(x + i + 1) % n]))
}

// ---- rotated_sort.kara: against the sorted copy

fn sort_arm(nums: Vec[i32]) -> bool {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut twice = nums.clone();
    twice.extend(nums.iter());
    let n = nums.len();
    (0..n).any(|x| twice[x..x + n] == sorted[..])
}

// ---- rotated_solution.kara: LeetCode's Rust template, through karac fix

struct Solution {}

impl Solution {
    pub fn check(nums: Vec[i32]) -> bool {
        let n = nums.len();
        let mut cnt = 0;
        for i in 0..n {
            if nums[i] > nums[(i + 1) % n] {
                cnt += 1;
            }
        }
        cnt <= 1
    }
}

fn solution_arm(nums: Vec[i32]) -> bool {
    Solution.check(nums)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: the array sorted is B, and the answer is
// whether some x makes nums[i] == B[(i + x) % n] for every i
fn literal(nums: Slice[i32]) -> bool {
    let n = nums.len();
    let mut b = nums.to_vec();
    b.sort();
    for x in 0..n {
        let mut all = true;
        for i in 0..n {
            if nums[i] != b[(i + x) % n] {
                all = false;
            }
        }
        if all {
            return true;
        }
    }
    false
}

fn arm(a: i64, nums: Slice[i32]) -> bool {
    let nums = nums.to_vec();
    let answer = match a {
        0 => star_arm(nums),
        1 => try_arm(nums),
        2 => sort_arm(nums),
        _ => solution_arm(nums),
    };
    answer
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "try", "sort", "solution"][a]
}

fn main() {
    let mut seed = 1752;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[Vec[i32]] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 7 + 1;
        let mut nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 4 + 1) as i32).collect();
        if next_random(mut seed) % 2 == 0 {
            nums.sort();
            nums.rotate_left(next_random(mut seed) % n);
        }
        cases.push(nums);
    }
    for (p, nums) in cases.iter().enumerate() {
        let want = literal(nums);
        check = (check * 31 + if want { 2 } else { 1 } + nums.len()) % 1000000007;
        let mut turned = nums.to_vec();
        turned.rotate_left(1);
        let mirrored: Vec[i32] = nums.iter().rev().map(|x| -x).collect();
        let mut sorted = nums.to_vec();
        sorted.sort();
        let mut answers: Vec[bool] = Vec.new();
        for a in 0..4 {
            let got = arm(a, nums);
            let failed = [got != want, arm(a, turned) != got, arm(a, mirrored) != got, not arm(a, sorted)];
            answers.push(got);
            for t in 0..4 {
                checks += 1;
                if failed[t] {
                    failures += 1;
                    by_property[t + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({nums}), {arm_name(a)}: P{t + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for t in 1..6 {
            if by_property[t] > 0 {
                counts.push(f"P{t}: {by_property[t]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
