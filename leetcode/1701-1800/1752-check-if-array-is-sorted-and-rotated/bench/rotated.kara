// LeetCode #1752: Check if Array Is Sorted and Rotated -- the bench
// (rotated.kara): count the drops.

fn check_rotated(nums: Vec[i32]) -> bool {
    let drops = nums.windows(2).into_iter().filter(|w| w[0] > w[1]).count();
    let wrap = if nums[nums.len() - 1] > nums[0] { 1 } else { 0 };
    drops + wrap <= 1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100000;
    let rounds = 5;
    let n = 100;
    let mut seed = 1752;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    for _ in 0..count {
        let mut nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 100 + 1) as i32).collect();
        if next_random(mut seed) % 2 == 0 {
            nums.sort();
            nums.rotate_left(next_random(mut seed) % n);
        }
        arrays.push(nums);
    }
    let mut yes = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in arrays.iter() {
            let answer = check_rotated(nums);
            if answer {
                yes += 1;
            }
            check = (check * 31 + if answer { 2 } else { 1 } + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {n} values, {rounds} rounds: {yes} sorted and rotated, checksum {check}");
}
