// LeetCode #1737: Change Minimum Characters to Satisfy One of Three
// Conditions -- the ★ arm: letter counts, and every boundary tried.
//
// For "every letter of a is below every letter of b" with the boundary
// between letter c - 1 and c, each letter of a from c up and each letter
// of b below c must change; c runs from b to z, since nothing is below
// `a`. The second condition is the first with a and b swapped. For "one
// distinct letter" every letter but the most common one shared across
// both strings must change. Each string's 26 counts and their running
// sums give every boundary's cost at once. O(m + n + 26).

fn min_characters(a: Str, b: Str) -> i64 {
    let mut count_a = [0; 26];
    let mut count_b = [0; 26];
    for c in a.chars() {
        count_a[c as i64 - 'a' as i64] += 1;
    }
    for c in b.chars() {
        count_b[c as i64 - 'a' as i64] += 1;
    }
    let (m, n) = (a.len(), b.len());
    let mut best = m + n;
    for c in 0..26 {
        best = min(best, m + n - count_a[c] - count_b[c]);
    }
    // below[c]: the letters of each string below letter c
    let mut below_a = 0;
    let mut below_b = 0;
    for c in 1..26 {
        below_a += count_a[c - 1];
        below_b += count_b[c - 1];
        best = min(best, m - below_a + below_b);
        best = min(best, n - below_b + below_a);
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random string of 1 to `most` letters from the first `letters`
fn word(most: i64, letters: i64, seed: mut ref i64) -> String {
    let n = next_random(mut seed) % most + 1;
    (0..n).map(|_| char.try_from(97 + (next_random(mut seed) % letters) as u32).ok().unwrap()).collect()
}

// `count` random pairs of strings
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let a = word(most, letters, mut seed);
        let b = word(most, letters, mut seed);
        let answer = min_characters(a, b);
        sum += answer;
        check = (check * 31 + answer + a.len()) % 1000000007;
    }
    println(f"{count} pairs of up to {most} letters from {letters}: changes sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one letter each, the same letter, and
    // `z` against `a`
    println(min_characters("aba", "caa"));
    println(min_characters("dabadd", "cda"));
    println(min_characters("a", "b"));
    println(min_characters("aaa", "aa"));
    println(min_characters("zz", "a"));
    println(min_characters("az", "az"));
    let mut seed = 1737;
    batch(3000, 6, 4, mut seed);
    batch(1000, 100, 26, mut seed);
    batch(10, 100000, 26, mut seed);
}
