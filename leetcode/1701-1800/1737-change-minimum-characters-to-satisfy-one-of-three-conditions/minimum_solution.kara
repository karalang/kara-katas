// LeetCode #1737: Change Minimum Characters to Satisfy One of Three
// Conditions -- a Rust solution as LeetCode's Rust users write it, carried
// to Kāra by `karac fix`.
//
// Each string's 26 letter counts, the third condition's cost for every
// letter, and the first two's for every boundary from running sums.
// O(m + n + 26).

struct Solution {}

impl Solution {
    pub fn min_characters(a: String, b: String) -> i32 {
        let mut ca = [0i32; 26];
        let mut cb = [0i32; 26];
        for c in a.bytes() {
            ca[(c - b'a') as usize] += 1;
        }
        for c in b.bytes() {
            cb[(c - b'a') as usize] += 1;
        }
        let (m, n) = (a.len() as i32, b.len() as i32);
        let mut ans = m + n;
        for i in 0..26 {
            ans = ans.min(m + n - ca[i] - cb[i]);
        }
        let mut (pa, pb) = (0i32, 0i32);
        for i in 0..25 {
            pa += ca[i];
            pb += cb[i];
            ans = ans.min(m - pa + pb).min(n - pb + pa);
        }
        ans
    }
}

fn min_characters(a: Str, b: Str) -> i64 {
    Solution.min_characters(a.to_string(), b.to_string())
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random string of 1 to `most` letters from the first `letters`
fn word(most: i64, letters: i64, seed: mut ref i64) -> String {
    let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
    (0..n).map(|_| char.try_from(97 + (next_random(mut seed) % letters) as u32).ok().unwrap()).collect()
}

// `count` random pairs of strings
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let a = word(most, letters, mut seed);
        let b = word(most, letters, mut seed);
        let answer = min_characters(a, b);
        sum += answer;
        check = (check * 31 + answer + a.len()) % 1000000007;
    }
    println(f"{count} pairs of up to {most} letters from {letters}: changes sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one letter each, the same letter, and
    // `z` against `a`
    println(min_characters("aba", "caa"));
    println(min_characters("dabadd", "cda"));
    println(min_characters("a", "b"));
    println(min_characters("aaa", "aa"));
    println(min_characters("zz", "a"));
    println(min_characters("az", "az"));
    let mut seed = 1737;
    batch(3000, 6, 4, mut seed);
    batch(1000, 100, 26, mut seed);
    batch(10, 100000, 26, mut seed);
}
