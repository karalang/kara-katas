// LeetCode #1737: Change Minimum Characters to Satisfy One of Three
// Conditions -- both strings sorted, every boundary found by binary
// search.
//
// With a string's letters sorted, its letters below a boundary are the
// prefix `partition_point` finds, so each boundary's cost is two searches
// per string. For the third condition a letter's run in a sorted string
// lies between the searches for it and for what follows it, and the
// letter whose two runs are longest together is kept.
// O((m + n) log(m + n)).

fn min_characters(a: Str, b: Str) -> i64 {
    let mut sa: Vec[char] = a.chars().collect();
    let mut sb: Vec[char] = b.chars().collect();
    sa.sort();
    sb.sort();
    let (m, n) = (sa.len(), sb.len());
    let mut best = m + n;
    for letter in 'b'..='z' {
        let below_a = sa.partition_point(|c| c < letter);
        let below_b = sb.partition_point(|c| c < letter);
        best = min(best, m - below_a + below_b);
        best = min(best, n - below_b + below_a);
    }
    for letter in 'a'..='z' {
        let in_a = sa.partition_point(|c| c <= letter) - sa.partition_point(|c| c < letter);
        let in_b = sb.partition_point(|c| c <= letter) - sb.partition_point(|c| c < letter);
        best = min(best, m + n - in_a - in_b);
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random string of 1 to `most` letters from the first `letters`
fn word(most: i64, letters: i64, seed: mut ref i64) -> String {
    let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
    (0..n).map(|_| char.try_from(97 + (next_random(mut seed) % letters) as u32).ok().unwrap()).collect()
}

// `count` random pairs of strings
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let a = word(most, letters, mut seed);
        let b = word(most, letters, mut seed);
        let answer = min_characters(a, b);
        sum += answer;
        check = (check * 31 + answer + a.len()) % 1000000007;
    }
    println(f"{count} pairs of up to {most} letters from {letters}: changes sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one letter each, the same letter, and
    // `z` against `a`
    println(min_characters("aba", "caa"));
    println(min_characters("dabadd", "cda"));
    println(min_characters("a", "b"));
    println(min_characters("aaa", "aa"));
    println(min_characters("zz", "a"));
    println(min_characters("az", "az"));
    let mut seed = 1737;
    batch(3000, 6, 4, mut seed);
    batch(1000, 100, 26, mut seed);
    batch(10, 100000, 26, mut seed);
}
