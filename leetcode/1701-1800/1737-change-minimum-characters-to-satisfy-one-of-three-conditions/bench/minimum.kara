// LeetCode #1737: Change Minimum Characters to Satisfy One of Three
// Conditions -- the bench (minimum.kara): letter counts, and every
// boundary tried.

fn min_characters(a: Str, b: Str) -> i64 {
    let mut count_a = [0; 26];
    let mut count_b = [0; 26];
    for c in a.chars() {
        count_a[c as i64 - 'a' as i64] += 1;
    }
    for c in b.chars() {
        count_b[c as i64 - 'a' as i64] += 1;
    }
    let (m, n) = (a.len(), b.len());
    let mut best = m + n;
    for c in 0..26 {
        best = min(best, m + n - count_a[c] - count_b[c]);
    }
    // below[c]: the letters of each string below letter c
    let mut below_a = 0;
    let mut below_b = 0;
    for c in 1..26 {
        below_a += count_a[c - 1];
        below_b += count_b[c - 1];
        best = min(best, m - below_a + below_b);
        best = min(best, n - below_b + below_a);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 20;
    let rounds = 200;
    let n = 100000;
    let mut seed = 1737;
    let mut problems: Vec[(String, String)] = Vec.new();
    for _ in 0..count {
        let a: String = (0..n).map(|_| char.try_from(97 + (next_random(mut seed) % 26) as u32).ok().unwrap()).collect();
        let b: String = (0..n).map(|_| char.try_from(97 + (next_random(mut seed) % 26) as u32).ok().unwrap()).collect();
        problems.push((a, b));
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (a, b) in problems.iter() {
            let answer = min_characters(a, b);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} pairs of {n} letters, {rounds} rounds: changes sum to {sum}, checksum {check}");
}
