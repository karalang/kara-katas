// LeetCode #1754: Largest Merge Of Two Strings -- the ★ arm: the larger
// rest goes first.
//
// At each step the letter is taken from the word whose rest, from the
// current letter to its end, is larger: two different first letters
// decide at once, and a tie is broken by the first place the rests
// differ, an exhausted rest counting as smaller. The rests are compared
// as `Str` slices. O((m + n)^2).

fn largest_merge(word1: String, word2: String) -> String {
    let mut merge = String.new();
    let mut i = 0;
    let mut j = 0;
    while i < word1.len() or j < word2.len() {
        if word1[i..] > word2[j..] {
            merge.push_str(word1[i..i + 1]);
            i += 1;
        } else {
            merge.push_str(word2[j..j + 1]);
            j += 1;
        }
    }
    merge
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 1 to `most` random letters from the first `letters`
fn word(most: i64, letters: i64, seed: mut ref i64) -> String {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    let n = next_random(mut seed) % most + 1;
    let mut s = String.new();
    for _ in 0..n {
        let k = next_random(mut seed) % letters;
        s.push_str(alphabet[k..k + 1]);
    }
    s
}

// `count` random pairs of words of up to `most` letters from the first
// `letters`, each merge folded into a checksum
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut first_a = 0;
    for _ in 0..count {
        let word1 = word(most, letters, mut seed);
        let word2 = word(most, letters, mut seed);
        let merge = largest_merge(word1, word2);
        for b in merge.bytes().iter() {
            check = (check * 31 + b) % 1000000007;
        }
        if merge.starts_with("a") {
            first_a += 1;
        }
    }
    println(f"{count} pairs of up to {most} letters from {letters}: {first_a} start with a, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one letter each, equal words, one
    // word a prefix of the other, and a tie broken far ahead
    println(largest_merge("cabaa", "bcaaa"));
    println(largest_merge("abcabc", "abdcaba"));
    println(largest_merge("a", "b"));
    println(largest_merge("abc", "abc"));
    println(largest_merge("ba", "bab"));
    println(largest_merge("aaaab", "aaaac"));
    let mut seed = 1754;
    batch(3000, 6, 2, mut seed);
    batch(1000, 100, 3, mut seed);
    batch(10, 3000, 2, mut seed);
}
