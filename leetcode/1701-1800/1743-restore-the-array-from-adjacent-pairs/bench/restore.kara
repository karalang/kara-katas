// LeetCode #1743: Restore the Array From Adjacent Pairs -- the bench
// (restore.kara): the pairs as a graph, walked from an end.

fn restore_array(adjacent_pairs: Vec[Vec[i32]]) -> Vec[i32] {
    let mut next: Map[i32, Vec[i32]] = Map.new();
    for pair in adjacent_pairs.iter() {
        next.entry(pair[0]).or_insert(Vec.new()).push(pair[1]);
        next.entry(pair[1]).or_insert(Vec.new()).push(pair[0]);
    }
    let start = next.iter().find(|(_, near)| near.len() == 1).unwrap().0;
    let mut order: Vec[i32] = [start, next[start][0]];
    while order.len() < adjacent_pairs.len() + 1 {
        let (before, last) = (order[order.len() - 2], order[order.len() - 1]);
        let near = ref next[last];
        order.push(if near[0] == before { near[1] } else { near[0] });
    }
    order
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn random_pairs(n: i64, seed: mut ref i64) -> Vec[Vec[i32]] {
    let mut taken: Set[i64] = Set.new();
    let mut values: Vec[i32] = Vec.new();
    while values.len() < n {
        let v = wide(mut seed) % 200001 - 100000;
        if taken.insert(v) {
            values.push(v as i32);
        }
    }
    let mut pairs: Vec[Vec[i32]] = Vec.new();
    for i in 1..n {
        if next_random(mut seed) % 2 == 0 {
            pairs.push([values[i - 1], values[i]]);
        } else {
            pairs.push([values[i], values[i - 1]]);
        }
    }
    for i in (1..pairs.len()).rev() {
        let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
        pairs.swap(i, j);
    }
    pairs
}

fn main() {
    let count = 10;
    let rounds = 4;
    let n = 100000;
    let mut seed = 1743;
    let problems: Vec[Vec[Vec[i32]]] = (0..count).map(|_| random_pairs(n, mut seed)).collect();
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for pairs in problems.iter() {
            let order = restore_array(pairs);
            let (first, last) = (order[0], order[order.len() - 1]);
            // either order is an answer: read it from its smaller end
            let middle = if first < last { order[order.len() / 2] } else { order[order.len() - 1 - order.len() / 2] };
            let low = min(first, last);
            sum += low;
            check = (check * 31 + low + middle + 200000 + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {n} values, {rounds} rounds: smaller ends sum to {sum}, checksum {check}");
}
