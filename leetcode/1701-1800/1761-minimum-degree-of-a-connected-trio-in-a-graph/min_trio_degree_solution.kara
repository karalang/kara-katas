// LeetCode #1761: Minimum Degree of a Connected Trio in a Graph -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn min_trio_degree(n: i32, edges: Vec[Vec[i32]]) -> i32 {
        let n = n as i64;
        let mut g = Vec.filled(n + 1, Vec.filled(n + 1, false));
        let mut deg = Vec.filled(n + 1, 0i32);
        for e in edges.iter() {
            let (u, v) = (e[0] as i64, e[1] as i64);
            g[u][v] = true;
            g[v][u] = true;
            deg[u] += 1;
            deg[v] += 1;
        }
        let mut ans = i32.MAX;
        for e in edges.iter() {
            let (u, v) = (e[0] as i64, e[1] as i64);
            for w in 1..=n {
                if g[u][w] and g[v][w] {
                    ans = ans.min(deg[u] + deg[v] + deg[w] - 6);
                }
            }
        }
        if ans == i32.MAX { -1 } else { ans }
    }
}

fn min_trio_degree(n: i32, edges: Vec[Vec[i32]]) -> i32 {
    Solution.min_trio_degree(n, edges)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a graph on n nodes, each pair joined with chance `density` in 1000
fn random_graph(seed: mut ref i64, n: i64, density: i64) -> Vec[Vec[i32]] {
    let mut edges: Vec[Vec[i32]] = Vec.new();
    for u in 1..n + 1 {
        for v in u + 1..n + 1 {
            if next_random(mut seed) % 1000 < density {
                edges.push([u as i32, v as i32].to_vec());
            }
        }
    }
    edges
}

fn main() {
    // LeetCode's two examples
    println(f"{min_trio_degree(6, [[1, 2], [1, 3], [3, 2], [4, 1], [5, 2], [3, 6]])} {min_trio_degree(7, [[1, 3], [4, 1], [4, 3], [2, 5], [5, 6], [6, 7], [7, 5], [2, 6]])}");
    // the edges: no trio; a lone triangle; a square, which has none; a
    // complete graph on 5; a triangle with an edge between two of its
    // nodes' neighbours
    println(f"{min_trio_degree(3, [[1, 2], [2, 3]])} {min_trio_degree(3, [[1, 2], [2, 3], [1, 3]])} {min_trio_degree(4, [[1, 2], [2, 3], [3, 4], [4, 1]])} {min_trio_degree(5, [[1, 2], [1, 3], [1, 4], [1, 5], [2, 3], [2, 4], [2, 5], [3, 4], [3, 5], [4, 5]])} {min_trio_degree(5, [[1, 2], [2, 3], [1, 3], [3, 4], [4, 5]])}");
    // the constraints' most: 400 nodes, sparse, middling and dense
    let mut seed = 1761;
    let sparse = random_graph(mut seed, 400, 4);
    let middling = random_graph(mut seed, 400, 50);
    let dense = random_graph(mut seed, 400, 500);
    println(f"400 nodes: {min_trio_degree(400, sparse)} {min_trio_degree(400, middling)} {min_trio_degree(400, dense)}");
    // 3000 random graphs of 2 to 12 nodes
    let mut check = 0;
    for _ in 0..3000 {
        let n = 2 + next_random(mut seed) % 11;
        let density = next_random(mut seed) % 1001;
        let edges = random_graph(mut seed, n, density);
        check = (check * 31 + min_trio_degree(n as i32, edges) + 1) % 1000000007;
    }
    println(f"3000 random graphs: checksum {check}");
}
