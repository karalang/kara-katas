// LeetCode #1761: Minimum Degree of a Connected Trio in a Graph -- the
// bench, mirroring the ★ arm: an adjacency matrix, the degrees, and every
// edge (u, v) with each w above v. One weight drawn for every pair of 400
// nodes, and 40 calls, each on the pairs whose weight is below a
// threshold chosen from the checksum so far.
fn min_trio_degree(n: i32, edges: Vec[Vec[i32]]) -> i32 {
    let n = n as i64;
    let mut joined: Vec[Vec[bool]] = Vec.filled(n + 1, Vec.filled(n + 1, false));
    let mut degree: Vec[i32] = Vec.filled(n + 1, 0);
    for e in edges.iter() {
        let (u, v) = (e[0] as i64, e[1] as i64);
        joined[u][v] = true;
        joined[v][u] = true;
        degree[u] += 1;
        degree[v] += 1;
    }
    let mut best = i32.MAX;
    for u in 1..n + 1 {
        for v in u + 1..n + 1 {
            if not joined[u][v] {
                continue;
            }
            for w in v + 1..n + 1 {
                if joined[u][w] and joined[v][w] {
                    best = best.min(degree[u] + degree[v] + degree[w] - 6);
                }
            }
        }
    }
    if best == i32.MAX { -1 } else { best }
}

fn main() {
    let mut seed = 1761;
    let mut weights: Vec[(i32, i32, i64)] = Vec.new();
    for u in 1..401 {
        for v in u + 1..401 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            weights.push((u as i32, v as i32, seed / 65536 % 1000));
        }
    }
    let mut check = 0;
    for call in 0..40 {
        let threshold = 300 + (check + call * 7919) % 500;
        let edges: Vec[Vec[i32]] = weights.iter().filter(|(_, _, w)| w < threshold).map(|(u, v, _)| [u, v].to_vec()).collect();
        check = (check * 31 + min_trio_degree(400, edges) + 1) % 1000000007;
    }
    println(f"40 calls on 400 nodes: checksum {check}");
}
