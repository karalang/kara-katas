// LeetCode #1739: Building Boxes -- a Rust solution as LeetCode's Rust
// users write it, carried to Kāra by `karac fix`.
//
// Whole staircase layers while they fit, then floor boxes one at a time,
// the k-th holding k more. O(n^(1/2)).

struct Solution {}

impl Solution {
    pub fn minimum_boxes(n: i32) -> i32 {
        let n = n as i64;
        let mut sum = 0;
        let mut k = 1;
        while sum + k * (k + 1) / 2 <= n {
            sum += k * (k + 1) / 2;
            k += 1;
        }
        k -= 1;
        let mut ans = k * (k + 1) / 2;
        let mut i = 1;
        while sum < n {
            ans += 1;
            sum += i;
            i += 1;
        }
        ans as i32
    }
}

fn minimum_boxes(n: i32) -> i32 {
    Solution.minimum_boxes(n)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random box counts from 1 to `most`
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (wide(mut seed) % most + 1) as i32;
        let answer = minimum_boxes(n);
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} counts up to {most}: floors sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then the smallest counts, a full
    // staircase of 4 layers and one box more, and the largest count
    println(minimum_boxes(3));
    println(minimum_boxes(4));
    println(minimum_boxes(10));
    println(minimum_boxes(1));
    println(minimum_boxes(2));
    println(minimum_boxes(20));
    println(minimum_boxes(21));
    println(minimum_boxes(1000000000));
    let mut sum = 0;
    for n in 1..2001 {
        sum += minimum_boxes(n);
    }
    println(f"every count from 1 to 2000: floors sum to {sum}");
    let mut seed = 1739;
    batch(3000, 1000, mut seed);
    batch(3000, 1000000000, mut seed);
}
