// LeetCode #1739: Building Boxes -- two binary searches.
//
// The full staircase that fits is the largest side s whose s (s + 1)
// (s + 2) / 6 boxes are at most n, found by a binary search; the boxes
// left over need the fewest extra floor boxes j with j (j + 1) / 2 at
// least that many, found by a second. The searches share one function
// that takes the test as a closure. O(log n).

// the smallest value in `low..high` for which `holds` is true, given
// that it is false below some value and true from there on
fn first_true(low: i64, high: i64, holds: Fn(i64) -> bool) -> i64 {
    let mut (low, high) = (low, high);
    while low < high {
        let middle = low + (high - low) / 2;
        if holds(middle) {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    low
}

fn minimum_boxes(n: i32) -> i32 {
    let n = n as i64;
    let side = first_true(0, 2000, |s| (s + 1) * (s + 2) * (s + 3) / 6 > n);
    let left = n - side * (side + 1) * (side + 2) / 6;
    let extra = first_true(0, 2000, |j| j * (j + 1) / 2 >= left);
    (side * (side + 1) / 2 + extra) as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random box counts from 1 to `most`
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (wide(mut seed) % most + 1) as i32;
        let answer = minimum_boxes(n);
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} counts up to {most}: floors sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then the smallest counts, a full
    // staircase of 4 layers and one box more, and the largest count
    println(minimum_boxes(3));
    println(minimum_boxes(4));
    println(minimum_boxes(10));
    println(minimum_boxes(1));
    println(minimum_boxes(2));
    println(minimum_boxes(20));
    println(minimum_boxes(21));
    println(minimum_boxes(1000000000));
    let mut sum = 0;
    for n in 1..2001 {
        sum += minimum_boxes(n);
    }
    println(f"every count from 1 to 2000: floors sum to {sum}");
    let mut seed = 1739;
    batch(3000, 1000, mut seed);
    batch(3000, 1000000000, mut seed);
}
