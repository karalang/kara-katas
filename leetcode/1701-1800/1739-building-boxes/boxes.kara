// LeetCode #1739: Building Boxes -- the ★ arm: the staircase layer by
// layer, then the floor a box at a time.
//
// Boxes piled in a corner as a staircase hold the most for their floor:
// a staircase whose floor is the triangle of side s, s (s + 1) / 2
// boxes, holds the s triangles 1, 3, 6, ... up to it, s (s + 1) (s + 2)
// / 6 boxes. Whole layers are added while they fit. Each floor box then
// laid along the staircase's edge lets a column one taller than the last
// stand on it, so the j-th one holds j more boxes; they are added until
// the n boxes fit. O(n^(1/2)).

fn minimum_boxes(n: i32) -> i32 {
    let n = n as i64;
    let mut placed = 0;
    let mut side = 0;
    while placed + (side + 1) * (side + 2) / 2 <= n {
        side += 1;
        placed += side * (side + 1) / 2;
    }
    let mut floor = side * (side + 1) / 2;
    let mut extra = 0;
    while placed < n {
        extra += 1;
        floor += 1;
        placed += extra;
    }
    floor as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random box counts from 1 to `most`
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (wide(mut seed) % most + 1) as i32;
        let answer = minimum_boxes(n);
        sum += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} counts up to {most}: floors sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then the smallest counts, a full
    // staircase of 4 layers and one box more, and the largest count
    println(minimum_boxes(3));
    println(minimum_boxes(4));
    println(minimum_boxes(10));
    println(minimum_boxes(1));
    println(minimum_boxes(2));
    println(minimum_boxes(20));
    println(minimum_boxes(21));
    println(minimum_boxes(1000000000));
    let mut sum = 0;
    for n in 1..2001 {
        sum += minimum_boxes(n);
    }
    println(f"every count from 1 to 2000: floors sum to {sum}");
    let mut seed = 1739;
    batch(3000, 1000, mut seed);
    batch(3000, 1000000000, mut seed);
}
