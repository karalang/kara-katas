// LeetCode #1744: Can You Eat Your Favorite Candy on Your Favorite Day?
// -- a Rust solution as LeetCode's Rust users write it, carried to Kāra
// by `karac fix`.
//
// A `vec![0i64; n + 1]` of prefix sums, and each query's two comparisons
// mapped into the answer. O(n + q).

struct Solution {}

impl Solution {
    pub fn can_eat(candies_count: Vec[i32], queries: Vec[Vec[i32]]) -> Vec[bool] {
        let mut pre = Vec.filled(candies_count.len() + 1, 0);
        for i in 0..candies_count.len() {
            pre[i + 1] = pre[i] + candies_count[i];
        }
        queries
            .iter()
            .map(|q| {
                let (t, d, c) = (q[0] as usize, q[1] as i64, q[2] as i64);
                d < pre[t + 1] and (d + 1) * c > pre[t]
            })
            .collect()
    }
}

fn can_eat(candies_count: Vec[i32], queries: Vec[Vec[i32]]) -> Vec[bool] {
    Solution.can_eat(candies_count, queries)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random problems of up to `most` types of up to `pile` candies,
// each with `asked` queries; days reach a little past the last candy and
// caps a few times the average pile, with one query in ten capped at the
// largest cap
fn batch(count: i64, most: i64, pile: i64, asked: i64, seed: mut ref i64) {
    let mut yes = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let candies: Vec[i32] = (0..n).map(|_| (wide(mut seed) % pile + 1) as i32).collect();
        let total: i64 = candies.iter().map(|c| c as i64).sum();
        let mut queries: Vec[Vec[i32]] = Vec.new();
        for _ in 0..asked {
            let t = next_random(mut seed) % n;
            let day = wide(mut seed) % (total + total / 4 + 1);
            let cap = if next_random(mut seed) % 10 == 0 { 1000000000 } else { wide(mut seed) % (3 * pile) + 1 };
            queries.push([t as i32, day as i32, cap as i32]);
        }
        let answers = can_eat(candies, queries);
        for a in answers.iter() {
            let bit = if a { 1 } else { 0 };
            yes += bit;
            check = (check * 2 + bit) % 1000000007;
        }
    }
    println(f"{count} problems of up to {most} types of up to {pile} candies, {asked} queries each: {yes} yes, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one candy eaten on day 0, a cap too
    // small to reach the type, and a day past every candy
    println(can_eat([7, 4, 5, 3, 8], [[0, 2, 2], [4, 2, 4], [2, 13, 1000000000]]));
    println(can_eat([5, 2, 6, 4, 1], [[3, 1, 2], [4, 10, 3], [3, 10, 100], [4, 100, 30], [1, 3, 1]]));
    println(can_eat([1], [[0, 0, 1], [0, 1, 1]]));
    println(can_eat([100000, 100000, 100000], [[2, 0, 1], [2, 1, 100000], [2, 0, 200001], [0, 99999, 1], [0, 100000, 1000000000]]));
    let mut seed = 1744;
    batch(3000, 6, 5, 6, mut seed);
    batch(100, 1000, 100000, 1000, mut seed);
    batch(2, 100000, 100000, 100000, mut seed);
}
