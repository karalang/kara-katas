// LeetCode #1769: Minimum Number of Operations to Move All Balls to Each
// Box -- the bench: the ★ arm, two sweeps, the moves for the balls on each
// side growing by the balls seen so far.

fn min_operations(boxes: String) -> Vec[i32] {
    let b = boxes.bytes();
    let n = b.len();
    let mut answer: Vec[i32] = Vec.filled(n, 0);
    let mut balls = 0;
    let mut moves = 0;
    for i in 0..n {
        answer[i] += moves;
        if b[i] == b'1' {
            balls += 1;
        }
        moves += balls;
    }
    balls = 0;
    moves = 0;
    for i in (0..n).rev() {
        answer[i] += moves;
        if b[i] == b'1' {
            balls += 1;
        }
        moves += balls;
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1769;
    let mut rows: Vec[String] = Vec.new();
    for _ in 0..200 {
        let full = next_random(mut seed) % 101;
        let mut s = String.new();
        for _ in 0..2000 {
            s.push(if next_random(mut seed) % 100 < full { '1' } else { '0' });
        }
        rows.push(s);
    }
    let mut check = 0;
    for call in 0..40000 {
        let answer = min_operations(rows[(check + call * 7919) % 200]);
        check = (check * 31 + answer[check % 2000]) % 1000000007;
    }
    println(f"40000 calls over 200 rows: checksum {check}");
}
