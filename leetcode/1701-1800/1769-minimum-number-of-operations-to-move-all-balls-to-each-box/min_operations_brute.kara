// LeetCode #1769: Minimum Number of Operations to Move All Balls to Each
// Box -- for every box, the distance from it to each ball, summed: a ball
// moves one box per operation. O(n^2)

fn min_operations(boxes: String) -> Vec[i32] {
    let full: Vec[i64] = boxes.chars().enumerate().filter(|(_, c)| c == '1').map(|(j, _)| j).collect();
    (0..boxes.len()).map(|i| full.iter().map(|j| (i - *j).abs()).sum() as i32).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n boxes, each holding a ball with a chance of `full` in 100
fn random_boxes(seed: mut ref i64, n: i64, full: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(if next_random(mut seed) % 100 < full { '1' } else { '0' });
    }
    s
}

fn digest(answer: Vec[i32]) -> i64 {
    answer.iter().fold(answer.len(), |check, a| (check * 31 + *a) % 1000000007)
}

fn main() {
    // LeetCode's two examples
    println(f"{min_operations("110")} {min_operations("001011")}");
    // the edges: one empty box; one full box; every box empty; every box
    // full; balls only at the two ends
    println(f"{min_operations("0")} {min_operations("1")} {min_operations("0000")} {min_operations("1111")} {min_operations("100001")}");
    // the constraints' most: 2000 boxes all full, so the end boxes need
    // 1999000 moves, and 2000 boxes half full
    let mut seed = 1769;
    let full: String = (0..2000).map(|_| '1').collect();
    let half = random_boxes(mut seed, 2000, 50);
    let a = min_operations(full);
    let b = min_operations(half);
    println(f"the most: {a[0]} {a[1999]} {digest(a)}, {digest(b)}");
    // 3000 random rows of 1 to 40 boxes, each with its own chance of a ball
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 40;
        let full = next_random(mut seed) % 101;
        let boxes = random_boxes(mut seed, n, full);
        check = (check * 31 + digest(min_operations(boxes))) % 1000000007;
    }
    println(f"3000 random rows: checksum {check}");
}
