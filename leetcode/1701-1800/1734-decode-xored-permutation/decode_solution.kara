// LeetCode #1734: Decode XORed Permutation -- a Rust solution as LeetCode's
// Rust users write it, carried to Kāra by `karac fix`.
//
// The XOR of 1 to n, less the XOR of the codes at odd places, is the first
// value; each next one is the last XORed with its code. O(n).

struct Solution {}

impl Solution {
    pub fn decode(encoded: Vec[i32]) -> Vec[i32] {
        let n = encoded.len() + 1;
        let mut total: i32 = 0;
        for i in 1..=n as i32 {
            total ^= i;
        }
        let mut odd: i32 = 0;
        for i in (1..n - 1).step_by(2) {
            odd ^= encoded[i];
        }
        let mut perm = Vec.filled(n, 0i32);
        perm[0] = total ^ odd;
        for i in 0..n - 1 {
            perm[i + 1] = perm[i] ^ encoded[i];
        }
        perm
    }
}

fn decode(encoded: Vec[i32]) -> Vec[i32] {
    Solution.decode(encoded)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random permutations of an odd n from 3 to `most`, shuffled by
// Fisher-Yates and encoded
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = 2 * (wide(mut seed) % ((most - 1) / 2)) + 3;
        let mut perm: Vec[i32] = (1..n + 1).map(|v| v as i32).collect();
        for i in (1..n).rev() {
            let j = wide(mut seed) % (i + 1);
            perm.swap(i, j);
        }
        let encoded: Vec[i32] = (0..n - 1).map(|i| perm[i] ^ perm[i + 1]).collect();
        let decoded = decode(encoded);
        if decoded != perm {
            println("wrong");
        }
        for v in decoded.iter() {
            sum += v;
            check = (check * 31 + v) % 1000000007;
        }
        check = (check * 31 + n) % 1000000007;
    }
    println(f"{count} permutations of up to {most}: values sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then the smallest n, and 1 to 9 in order
    println(decode([3, 1]));
    println(decode([6, 5, 4, 6]));
    println(decode([1, 3]));
    println(decode([3, 1, 7, 1, 3, 1, 15, 1]));
    let mut seed = 1734;
    batch(3000, 9, mut seed);
    batch(300, 1001, mut seed);
    batch(10, 99999, mut seed);
}
