// LeetCode #1734: Decode XORed Permutation -- the ★ arm: the first value
// from the XOR of every value less the XOR of every value but the first.
//
// The permutation holds 1 to n, so the XOR of all of it is the XOR of 1
// to n. n is odd, so the codes at odd places, `encoded[1]`,
// `encoded[3]`, ..., pair off every value but the first: their XOR is
// `perm[1] ^ ... ^ perm[n - 1]`. XORing that out of the whole leaves
// `perm[0]`, and from it each next value is the last XORed with its code.
// O(n).

fn decode(encoded: Vec[i32]) -> Vec[i32] {
    let n = encoded.len() + 1;
    let mut all: i32 = 0;
    for v in 1..n + 1 {
        all ^= v as i32;
    }
    let mut rest: i32 = 0;
    let mut i = 1;
    while i < n - 1 {
        rest ^= encoded[i];
        i += 2;
    }
    let mut perm: Vec[i32] = Vec.with_capacity(n);
    perm.push(all ^ rest);
    for code in encoded.iter() {
        perm.push(perm[perm.len() - 1] ^ code);
    }
    perm
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random permutations of an odd n from 3 to `most`, shuffled by
// Fisher-Yates and encoded
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = 2 * (wide(mut seed) % ((most - 1) / 2)) + 3;
        let mut perm: Vec[i32] = (1..n + 1).map(|v| v as i32).collect();
        for i in (1..n).rev() {
            let j = wide(mut seed) % (i + 1);
            perm.swap(i, j);
        }
        let encoded: Vec[i32] = (0..n - 1).map(|i| perm[i] ^ perm[i + 1]).collect();
        let decoded = decode(encoded);
        if decoded != perm {
            println("wrong");
        }
        for v in decoded.iter() {
            sum += v;
            check = (check * 31 + v) % 1000000007;
        }
        check = (check * 31 + n) % 1000000007;
    }
    println(f"{count} permutations of up to {most}: values sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then the smallest n, and 1 to 9 in order
    println(decode([3, 1]));
    println(decode([6, 5, 4, 6]));
    println(decode([1, 3]));
    println(decode([3, 1, 7, 1, 3, 1, 15, 1]));
    let mut seed = 1734;
    batch(3000, 9, mut seed);
    batch(300, 1001, mut seed);
    batch(10, 99999, mut seed);
}
