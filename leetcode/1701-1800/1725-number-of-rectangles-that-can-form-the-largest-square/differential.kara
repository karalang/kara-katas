// LeetCode #1725: Number Of Rectangles That Can Form The Largest Square
// -- the differential.
//
// Four arms against the statement read literally, on 3000 random
// problems of 1 to 7 rectangles with sides of 1 to 5.
//
// P1  the answer is the statement read literally
// P2  the rectangles in reverse order give the same answer
// P3  every rectangle turned, its length and width swapped, gives the
//     same answer
// P4  a square one larger than any rectangle's largest square added
//     makes the answer 1
// P5  each arm agrees with at least two of the other three

// ---- rectangles.kara: the ★ arm: one pass, the largest side and its count

fn star_arm(rectangles: Vec[Vec[i32]]) -> i32 {
    let mut best = 0;
    let mut count = 0;
    for r in rectangles.iter() {
        let side = min(r[0], r[1]);
        if side > best {
            best = side;
            count = 1;
        } else if side == best {
            count += 1;
        }
    }
    count
}

// ---- rectangles_fold.kara: the same pass as a fold over the shorter sides

fn fold_arm(rectangles: Vec[Vec[i32]]) -> i32 {
    let (_, count) = rectangles.iter().map(|r| min(r[0], r[1])).fold((0, 0i32), |(best, count), side| {
        if side > best {
            (side, 1)
        } else if side == best {
            (best, count + 1)
        } else {
            (best, count)
        }
    });
    count
}

// ---- rectangles_sorted.kara: the shorter sides sorted, the last run counted

fn sorted_arm(rectangles: Vec[Vec[i32]]) -> i32 {
    let mut sides: Vec[i32] = rectangles.iter().map(|r| min(r[0], r[1])).collect();
    sides.sort();
    let largest = sides[sides.len() - 1];
    let mut count = 0;
    for side in sides.iter().rev() {
        if side != largest {
            break;
        }
        count += 1;
    }
    count
}

// ---- rectangles_solution.kara: LeetCode's Rust template, through karac fix

struct SolutionArm {}

impl SolutionArm {
    pub fn count_good_rectangles(rectangles: Vec[Vec[i32]]) -> i32 {
        let sides: Vec[i32] = rectangles.iter().map(|r| r[0].min(r[1])).collect();
        let max_len = *sides.iter().max().unwrap();
        sides.iter().filter(|s| s == max_len).count() as i32
    }
}

fn solution_arm(rectangles: Vec[Vec[i32]]) -> i32 {
    SolutionArm.count_good_rectangles(rectangles)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the largest square cut from a rectangle, read literally: the side grown
// one at a time while a square of the next side still fits
fn largest_square(r: Slice[i32]) -> i32 {
    let mut k = 0;
    while k + 1 <= r[0] and k + 1 <= r[1] {
        k += 1;
    }
    k
}

// the statement read literally: maxLen the largest square of any
// rectangle, and the rectangles that can make a square of side maxLen
fn literal(rectangles: Slice[Vec[i32]]) -> i32 {
    let mut max_len = 0;
    for r in rectangles.iter() {
        max_len = max(max_len, largest_square(r));
    }
    let mut count = 0;
    for r in rectangles.iter() {
        if largest_square(r) >= max_len {
            count += 1;
        }
    }
    count
}

fn arm(a: i64, rectangles: Slice[Vec[i32]]) -> i32 {
    let rectangles = rectangles.to_vec();
    match a {
        0 => star_arm(rectangles),
        1 => fold_arm(rectangles),
        2 => sorted_arm(rectangles),
        _ => solution_arm(rectangles),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "fold", "sorted", "solution"][a]
}

fn main() {
    let mut seed = 1725;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 7 + 1;
        let mut rectangles: Vec[Vec[i32]] = Vec.new();
        for _ in 0..n {
            let l = next_random(mut seed) % 5 + 1;
            let w = next_random(mut seed) % 5 + 1;
            rectangles.push([l as i32, w as i32]);
        }
        cases.push(rectangles);
    }
    for (p, rectangles) in cases.iter().enumerate() {
        let want = literal(rectangles);
        check = (check * 31 + want + rectangles.len()) % 1000000007;
        let reversed: Vec[Vec[i32]] = rectangles.iter().rev().cloned().collect();
        let turned: Vec[Vec[i32]] = rectangles.iter().map(|r| [r[1], r[0]]).collect();
        let side = rectangles.iter().map(|r| min(r[0], r[1])).max().unwrap() + 1;
        let mut larger = rectangles.to_vec();
        larger.push([side, side]);
        let mut answers: Vec[i32] = Vec.new();
        for a in 0..4 {
            let got = arm(a, rectangles);
            let failed = [got != want, arm(a, reversed) != got, arm(a, turned) != got, arm(a, larger) != 1];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({rectangles}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
