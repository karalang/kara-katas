// LeetCode #1725: Number Of Rectangles That Can Form The Largest Square
// -- the bench, the ★ arm: one pass, the largest square so far and how
// many reach it.
//
// The largest square cut from a rectangle has the shorter side. One pass
// keeps the largest such side seen and how many rectangles give it: a
// larger side starts the count again at one, an equal one adds to it.
// O(n).

fn count_good_rectangles(rectangles: Vec[Vec[i32]]) -> i32 {
    let mut best = 0;
    let mut count = 0;
    for r in rectangles.iter() {
        let side = min(r[0], r[1]);
        if side > best {
            best = side;
            count = 1;
        } else if side == best {
            count += 1;
        }
    }
    count
}

// ---- the bench -------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 1000;
    let rounds = 50;
    let n = 1000;
    let mut seed = 1725;
    let mut problems: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..count {
        let mut rectangles: Vec[Vec[i32]] = Vec.new();
        for _ in 0..n {
            let l = next_random(mut seed) % 20 + 1;
            let w = next_random(mut seed) % 20 + 1;
            rectangles.push([l as i32, w as i32]);
        }
        problems.push(rectangles);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for rectangles in problems.iter() {
            let answer = count_good_rectangles(rectangles);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} problems of {n} rectangles, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
