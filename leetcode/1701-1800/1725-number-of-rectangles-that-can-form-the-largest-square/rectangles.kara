// LeetCode #1725: Number Of Rectangles That Can Form The Largest Square
// -- the ★ arm: one pass, the largest square so far and how many reach
// it.
//
// The largest square cut from a rectangle has the shorter side. One pass
// keeps the largest such side seen and how many rectangles give it: a
// larger side starts the count again at one, an equal one adds to it.
// O(n).

fn count_good_rectangles(rectangles: Vec[Vec[i32]]) -> i32 {
    let mut best = 0;
    let mut count = 0;
    for r in rectangles.iter() {
        let side = min(r[0], r[1]);
        if side > best {
            best = side;
            count = 1;
        } else if side == best {
            count += 1;
        }
    }
    count
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` problems of 1 to `most` rectangles with sides of 1 to `top`
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut rectangles: Vec[Vec[i32]] = Vec.new();
        for _ in 0..n {
            let l = wide(mut seed) % top + 1;
            let w = wide(mut seed) % top + 1;
            rectangles.push([l as i32, w as i32]);
        }
        let answer = count_good_rectangles(rectangles);
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} problems of up to {most} rectangles with sides up to {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one rectangle, and squares all alike
    println(count_good_rectangles([[5, 8], [3, 9], [5, 12], [16, 5]]));
    println(count_good_rectangles([[2, 3], [3, 7], [4, 3], [3, 7]]));
    println(count_good_rectangles([[1000000000, 1]]));
    println(count_good_rectangles(Vec.filled(1000, [7, 7])));
    let mut seed = 1725;
    batch(3000, 8, 6, mut seed);
    batch(300, 1000, 20, mut seed);
    batch(300, 1000, 1000000000, mut seed);
}
