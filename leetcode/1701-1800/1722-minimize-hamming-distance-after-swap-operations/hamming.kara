// LeetCode #1722: Minimize Hamming Distance After Swap Operations -- the
// ★ arm: the swaps joined into groups with a union-find, each group's
// source values counted, and each target value matched from its group's
// counts.
//
// Swaps compose: any two places joined by a chain of allowed swaps can
// trade values in any order, so within a group of joined places the
// source's values can be arranged freely, and nothing crosses between
// groups. The most places that can match in a group is the size of the
// common part of its source and target values, as multisets. A union-find
// with path halving and union by size finds the groups; a `Map` keyed by
// (group, value) counts the source's values. O((n + m) α(n)).

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn minimum_hamming_distance(source: Vec[i32], target: Vec[i32], allowed_swaps: Vec[Vec[i32]]) -> i32 {
    let n = source.len();
    let mut parent: Vec[i64] = (0..n).collect();
    let mut size: Vec[i64] = Vec.filled(n, 1);
    for swap in allowed_swaps.iter() {
        let mut a = find(mut parent, swap[0]);
        let mut b = find(mut parent, swap[1]);
        if a == b {
            continue;
        }
        if size[a] < size[b] {
            a, b = b, a;
        }
        parent[b] = a;
        size[a] += size[b];
    }
    let mut counts: Map[(i64, i32), i64] = Map.new();
    for i in 0..n {
        *counts.entry((find(mut parent, i), source[i])).or_insert(0) += 1;
    }
    let mut distance = 0;
    for i in 0..n {
        let key = (find(mut parent, i), target[i]);
        match counts.get_mut(key) {
            Some(c) if *c > 0 => *c -= 1,
            _ => distance += 1,
        }
    }
    distance
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` problems of 1 to `most` values from 1 to `top` in each array,
// and up to `swaps` allowed swaps of two different places
fn batch(count: i64, most: i64, top: i64, swaps: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let source: Vec[i32] = (0..n).map(|_| (wide(mut seed) % top + 1) as i32).collect();
        let target: Vec[i32] = (0..n).map(|_| (wide(mut seed) % top + 1) as i32).collect();
        let m = if n > 1 { next_random(mut seed) % (swaps + 1) } else { 0 };
        let mut allowed: Vec[Vec[i32]] = Vec.new();
        for _ in 0..m {
            let a = wide(mut seed) % n;
            let mut b = wide(mut seed) % (n - 1);
            if b >= a {
                b += 1;
            }
            allowed.push([a as i32, b as i32]);
        }
        let answer = minimum_hamming_distance(source, target, allowed);
        sum += answer;
        check = (check * 31 + answer + n + m) % 1000000007;
    }
    println(f"{count} problems of up to {most} values up to {top}: distances sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, and swaps that join
    // everything
    println(minimum_hamming_distance([1, 2, 3, 4], [2, 1, 4, 5], [[0, 1], [2, 3]]));
    println(minimum_hamming_distance([1, 2, 3, 4], [1, 3, 2, 4], []));
    println(minimum_hamming_distance([5, 1, 2, 4, 3], [1, 5, 4, 2, 3], [[0, 4], [4, 2], [1, 3], [1, 4]]));
    println(minimum_hamming_distance([7], [8], []));
    println(minimum_hamming_distance([3, 2, 1], [1, 2, 3], [[0, 1], [1, 2]]));
    let mut seed = 1722;
    batch(3000, 8, 4, 6, mut seed);
    batch(300, 1000, 20, 800, mut seed);
    batch(10, 100000, 100000, 100000, mut seed);
}
