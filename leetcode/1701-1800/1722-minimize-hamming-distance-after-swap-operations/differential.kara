// LeetCode #1722: Minimize Hamming Distance After Swap Operations -- the
// differential.
//
// Four arms against the statement read literally, on 3000 random
// problems: two arrays of 1 to 6 values from 1 to 3 and up to 4 allowed
// swaps of two different places.
//
// P1  the answer is the statement read literally
// P2  the source and the target swapped give the same answer
// P3  the swaps listed in reverse, each pair turned round, give the same
//     answer
// P4  with no swaps allowed, the answer is the places that differ
// P5  each arm agrees with at least two of the other three

// ---- hamming.kara: the ★ arm: a union-find and each group's counts

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn star_arm(source: Vec[i32], target: Vec[i32], allowed_swaps: Vec[Vec[i32]]) -> i32 {
    let n = source.len();
    let mut parent: Vec[i64] = (0..n).collect();
    let mut size: Vec[i64] = Vec.filled(n, 1);
    for swap in allowed_swaps.iter() {
        let mut a = find(mut parent, swap[0]);
        let mut b = find(mut parent, swap[1]);
        if a == b {
            continue;
        }
        if size[a] < size[b] {
            a, b = b, a;
        }
        parent[b] = a;
        size[a] += size[b];
    }
    let mut counts: Map[(i64, i32), i64] = Map.new();
    for i in 0..n {
        *counts.entry((find(mut parent, i), source[i])).or_insert(0) += 1;
    }
    let mut distance = 0;
    for i in 0..n {
        let key = (find(mut parent, i), target[i]);
        match counts.get_mut(key) {
            Some(c) if *c > 0 => *c -= 1,
            _ => distance += 1,
        }
    }
    distance
}

// ---- hamming_groups.kara: each group by a depth-first walk, its values sorted and matched

fn groups_arm(source: Vec[i32], target: Vec[i32], allowed_swaps: Vec[Vec[i32]]) -> i32 {
    let n = source.len();
    let mut joined: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for swap in allowed_swaps.iter() {
        joined[swap[0]].push(swap[1]);
        joined[swap[1]].push(swap[0]);
    }
    let mut seen: Vec[bool] = Vec.filled(n, false);
    let mut matched = 0;
    for start in 0..n {
        if seen[start] {
            continue;
        }
        seen[start] = true;
        let mut stack: Vec[i64] = [start];
        let mut mine: Vec[i32] = Vec.new();
        let mut wanted: Vec[i32] = Vec.new();
        while let Some(at) = stack.pop() {
            mine.push(source[at]);
            wanted.push(target[at]);
            for next in joined[at].iter() {
                if not seen[next] {
                    seen[next] = true;
                    stack.push(next);
                }
            }
        }
        mine.sort();
        wanted.sort();
        let mut (i, j) = (0, 0);
        while i < mine.len() and j < wanted.len() {
            if mine[i] == wanted[j] {
                matched += 1;
                i += 1;
                j += 1;
            } else if mine[i] < wanted[j] {
                i += 1;
            } else {
                j += 1;
            }
        }
    }
    (n - matched) as i32
}

// ---- hamming_pairs.kara: groups labelled breadth-first, (group, value) pairs sorted and merged

fn pairs_arm(source: Vec[i32], target: Vec[i32], allowed_swaps: Vec[Vec[i32]]) -> i32 {
    let n = source.len();
    let mut joined: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for swap in allowed_swaps.iter() {
        joined[swap[0]].push(swap[1]);
        joined[swap[1]].push(swap[0]);
    }
    let mut label: Vec[i64] = Vec.filled(n, -1);
    for start in 0..n {
        if label[start] >= 0 {
            continue;
        }
        label[start] = start;
        let mut queue: VecDeque[i64] = VecDeque.new();
        queue.push_back(start);
        while let Some(at) = queue.pop_front() {
            for next in joined[at].iter() {
                if label[next] < 0 {
                    label[next] = start;
                    queue.push_back(next);
                }
            }
        }
    }
    let mut have: Vec[(i64, i32)] = (0..n).map(|i| (label[i], source[i])).collect();
    let mut want: Vec[(i64, i32)] = (0..n).map(|i| (label[i], target[i])).collect();
    have.sort();
    want.sort();
    let mut matched = 0;
    let mut (i, j) = (0, 0);
    while i < n and j < n {
        if have[i] == want[j] {
            matched += 1;
            i += 1;
            j += 1;
        } else if have[i] < want[j] {
            i += 1;
        } else {
            j += 1;
        }
    }
    (n - matched) as i32
}

// ---- hamming_solution.kara: LeetCode's Rust template, through karac fix

fn solution_find(p: mut ref Vec[i64], x: i64) -> i64 {
    if p[x] != x {
        let r = solution_find(mut p, p[x]);
        p[x] = r;
    }
    p[x]
}

struct SolutionArm {}

impl SolutionArm {
    pub fn minimum_hamming_distance(source: Vec[i32], target: Vec[i32], allowed_swaps: Vec[Vec[i32]]) -> i32 {
        let n = source.len();
        let mut p: Vec[i64] = (0..n).collect();
        for s in ref allowed_swaps {
            let a = solution_find(mut p, s[0]);
            let b = solution_find(mut p, s[1]);
            p[a] = b;
        }
        let mut groups: Map[i64, Map[i32, i32]] = Map.new();
        for i in 0..n {
            let r = solution_find(mut p, i);
            *groups.entry(r).or_insert_with(Map.new).entry(source[i]).or_insert(0) += 1;
        }
        let mut res = 0;
        for i in 0..n {
            let r = solution_find(mut p, i);
            let g = groups.get_mut(r).unwrap();
            if let Some(c) = g.get_mut(target[i]) {
                if *c > 0 {
                    *c -= 1;
                    continue;
                }
            }
            res += 1;
        }
        res
    }
}

fn solution_arm(source: Vec[i32], target: Vec[i32], allowed_swaps: Vec[Vec[i32]]) -> i32 {
    SolutionArm.minimum_hamming_distance(source, target, allowed_swaps)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every arrangement of the source that the
// allowed swaps reach, any number of times in any order, found by a
// breadth-first walk; the least Hamming distance among them
fn literal(source: Slice[i32], target: Slice[i32], allowed: Slice[Vec[i32]]) -> i32 {
    let start = source.to_vec();
    let mut seen: Set[Vec[i32]] = Set.new();
    seen.insert(start.clone());
    let mut queue: VecDeque[Vec[i32]] = VecDeque.new();
    queue.push_back(start);
    let mut best = source.len();
    while let Some(now) = queue.pop_front() {
        let distance = (0..now.len()).filter(|i| now[i] != target[i]).count();
        best = min(best, distance);
        for swap in allowed.iter() {
            let mut next = now.clone();
            next.swap(swap[0], swap[1]);
            if not seen.contains(next) {
                seen.insert(next.clone());
                queue.push_back(next);
            }
        }
    }
    best as i32
}

fn arm(a: i64, source: Slice[i32], target: Slice[i32], allowed: Slice[Vec[i32]]) -> i32 {
    let (source, target, allowed) = (source.to_vec(), target.to_vec(), allowed.to_vec());
    match a {
        0 => star_arm(source, target, allowed),
        1 => groups_arm(source, target, allowed),
        2 => pairs_arm(source, target, allowed),
        _ => solution_arm(source, target, allowed),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "groups", "pairs", "solution"][a]
}

fn main() {
    let mut seed = 1722;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(Vec[i32], Vec[i32], Vec[Vec[i32]])] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 6 + 1;
        let source: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 3 + 1) as i32).collect();
        let target: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 3 + 1) as i32).collect();
        let m = if n > 1 { next_random(mut seed) % 5 } else { 0 };
        let mut allowed: Vec[Vec[i32]] = Vec.new();
        for _ in 0..m {
            let a = next_random(mut seed) % n;
            let mut b = next_random(mut seed) % (n - 1);
            if b >= a {
                b += 1;
            }
            allowed.push([a as i32, b as i32]);
        }
        cases.push((source, target, allowed));
    }
    for (p, (source, target, allowed)) in cases.iter().enumerate() {
        let want = literal(source, target, allowed);
        check = (check * 31 + want + source.len() + allowed.len()) % 1000000007;
        let turned: Vec[Vec[i32]] = allowed.iter().rev().map(|s| [s[1], s[0]]).collect();
        let differ = (0..source.len()).filter(|i| source[i] != target[i]).count() as i32;
        let none: Vec[Vec[i32]] = Vec.new();
        let mut answers: Vec[i32] = Vec.new();
        for a in 0..4 {
            let got = arm(a, source, target, allowed);
            let failed = [got != want, arm(a, target, source, allowed) != got, arm(a, source, target, turned) != got, arm(a, source, target, none) != differ];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({source}, {target}, {allowed}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
