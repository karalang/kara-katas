// LeetCode #1722: Minimize Hamming Distance After Swap Operations -- the
// groups labelled by a breadth-first walk, and (group, value) pairs of
// both arrays sorted and merged.
//
// Each place gets its group's label from a walk over the swaps with a
// `VecDeque`. Then each array becomes a list of (label, value) pairs; the
// two lists sorted, a pair matches a pair only within one group, and one
// merge counts the matches of every group at once. O(n log n + m).

fn minimum_hamming_distance(source: Vec[i32], target: Vec[i32], allowed_swaps: Vec[Vec[i32]]) -> i32 {
    let n = source.len();
    let mut joined: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for swap in allowed_swaps.iter() {
        joined[swap[0]].push(swap[1]);
        joined[swap[1]].push(swap[0]);
    }
    let mut label: Vec[i64] = Vec.filled(n, -1);
    for start in 0..n {
        if label[start] >= 0 {
            continue;
        }
        label[start] = start;
        let mut queue: VecDeque[i64] = VecDeque.new();
        queue.push_back(start);
        while let Some(at) = queue.pop_front() {
            for next in joined[at].iter() {
                if label[next] < 0 {
                    label[next] = start;
                    queue.push_back(next);
                }
            }
        }
    }
    let mut have: Vec[(i64, i32)] = (0..n).map(|i| (label[i], source[i])).collect();
    let mut want: Vec[(i64, i32)] = (0..n).map(|i| (label[i], target[i])).collect();
    have.sort();
    want.sort();
    let mut matched = 0;
    let mut (i, j) = (0, 0);
    while i < n and j < n {
        if have[i] == want[j] {
            matched += 1;
            i += 1;
            j += 1;
        } else if have[i] < want[j] {
            i += 1;
        } else {
            j += 1;
        }
    }
    (n - matched) as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` problems of 1 to `most` values from 1 to `top` in each array,
// and up to `swaps` allowed swaps of two different places
fn batch(count: i64, most: i64, top: i64, swaps: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let source: Vec[i32] = (0..n).map(|_| (wide(mut seed) % top + 1) as i32).collect();
        let target: Vec[i32] = (0..n).map(|_| (wide(mut seed) % top + 1) as i32).collect();
        let m = if n > 1 { (next_random(mut seed) * 32768 + next_random(mut seed)) % (swaps + 1) } else { 0 };
        let mut allowed: Vec[Vec[i32]] = Vec.new();
        for _ in 0..m {
            let a = wide(mut seed) % n;
            let mut b = wide(mut seed) % (n - 1);
            if b >= a {
                b += 1;
            }
            allowed.push([a as i32, b as i32]);
        }
        let answer = minimum_hamming_distance(source, target, allowed);
        sum += answer;
        check = (check * 31 + answer + n + m) % 1000000007;
    }
    println(f"{count} problems of up to {most} values up to {top}: distances sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, and swaps that join
    // everything
    println(minimum_hamming_distance([1, 2, 3, 4], [2, 1, 4, 5], [[0, 1], [2, 3]]));
    println(minimum_hamming_distance([1, 2, 3, 4], [1, 3, 2, 4], []));
    println(minimum_hamming_distance([5, 1, 2, 4, 3], [1, 5, 4, 2, 3], [[0, 4], [4, 2], [1, 3], [1, 4]]));
    println(minimum_hamming_distance([7], [8], []));
    println(minimum_hamming_distance([3, 2, 1], [1, 2, 3], [[0, 1], [1, 2]]));
    let mut seed = 1722;
    batch(3000, 8, 4, 6, mut seed);
    batch(300, 1000, 20, 800, mut seed);
    batch(10, 100000, 100000, 100000, mut seed);
}
