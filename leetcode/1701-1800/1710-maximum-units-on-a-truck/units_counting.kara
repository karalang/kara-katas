// LeetCode #1710: Maximum Units on a Truck -- the boxes counted by their
// units.
//
// A box holds 1 to 1000 units, so the boxes of each count are added up in
// an array of 1001, and the truck is filled walking it from 1000 down. No
// sort: O(n + 1000).

fn maximum_units(box_types: Vec[Vec[i32]], truck_size: i32) -> i32 {
    let mut count: Vec[i32] = Vec.filled(1001, 0);
    for t in box_types.iter() {
        count[t[1]] += t[0];
    }
    let mut room = truck_size;
    let mut total: i32 = 0;
    for units in (1i32..=1000).rev() {
        if room == 0 {
            break;
        }
        let take = min(count[units], room);
        total += take * units;
        room -= take;
    }
    total
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random problems of 1 to `most` box types, each 1 to `boxes`
// boxes of 1 to `units` units, and a truck of 1 to `truck` boxes; the
// answers summed, and a checksum
fn batch(count: i64, most: i64, boxes: i64, units: i64, truck: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut box_types: Vec[Vec[i32]] = Vec.new();
        for _ in 0..n {
            let b = next_random(mut seed) % boxes + 1;
            let u = next_random(mut seed) % units + 1;
            box_types.push([b as i32, u as i32]);
        }
        let size = (next_random(mut seed) * 32768 + next_random(mut seed)) % truck + 1;
        let answer = maximum_units(box_types, size as i32) as i64;
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} problems of up to {most} box types: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then a truck bigger than every box, one
    // box, and two types of the same units
    println(maximum_units([[1, 3], [2, 2], [3, 1]], 4));
    println(maximum_units([[5, 10], [2, 5], [4, 7], [3, 9]], 10));
    println(maximum_units([[2, 7], [3, 4]], 100));
    println(maximum_units([[1, 1]], 1));
    println(maximum_units([[3, 5], [4, 5], [1, 9]], 6));
    let mut seed = 1710;
    batch(3000, 6, 5, 5, 20, mut seed);
    batch(300, 1000, 1000, 1000, 1000000, mut seed);
    batch(10, 1000, 1000, 1000, 1000, mut seed);
}
