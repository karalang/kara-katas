// LeetCode #1710: Maximum Units on a Truck -- the bench: the ★ arm on 1000
// random problems of 1000 box types, LeetCode's most, each 1 to 1000
// boxes of 1 to 1000 units and a truck of up to 10^6 boxes, all drawn
// first, each answered 10 times.
//
// The box types sorted by units, most first, and boxes taken from the
// front until the truck is full. O(n log n).

fn maximum_units(box_types: Vec[Vec[i32]], truck_size: i32) -> i32 {
    let mut order = box_types.clone();
    order.sort_by_key(|t| -t[1]);
    let mut room = truck_size;
    let mut total: i32 = 0;
    for t in order.iter() {
        let take = min(t[0], room);
        total += take * t[1];
        room -= take;
        if room == 0 {
            break;
        }
    }
    total
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 1000;
    let rounds = 10;
    let n = 1000;
    let mut seed = 1710;
    let mut problems: Vec[(Vec[Vec[i32]], i32)] = Vec.new();
    for _ in 0..count {
        let mut box_types: Vec[Vec[i32]] = Vec.new();
        for _ in 0..n {
            let b = next_random(mut seed) % 1000 + 1;
            let u = next_random(mut seed) % 1000 + 1;
            box_types.push([b as i32, u as i32]);
        }
        let size = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000 + 1;
        problems.push((box_types, size as i32));
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (box_types, size) in problems.iter() {
            let answer = maximum_units(box_types, size);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} problems of {n} box types, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
