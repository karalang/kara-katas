// LeetCode #1706: Where Will the Ball Fall -- the differential.
//
// Four arms against the statement read literally, on 3000 random boxes of
// 1 to 6 rows by 1 to 6 columns, each board 1 with a chance of its box's
// own.
//
// P1  the answer is the statement read literally
// P2  the box mirrored, every board turned, gives the answer mirrored
// P3  a row of 1s on top moves every ball one column on, the last stuck
// P4  no two balls fall out of the same column
// P5  each arm agrees with at least two of the other three

// ---- ball.kara: the ★ arm: each ball followed down, a row at a time

fn star_arm(grid: Vec[Vec[i32]]) -> Vec[i32] {
    let n = grid[0].len();
    let mut answer: Vec[i32] = Vec.new();
    for start in 0..n {
        let mut c = start;
        for row in grid.iter() {
            let next = c + row[c];
            if next < 0 or next >= n or row[next] != row[c] {
                c = -1;
                break;
            }
            c = next;
        }
        answer.push(c as i32);
    }
    answer
}

// ---- ball_rows.kara: every ball moved together, a row at a time

fn rows_arm(grid: Vec[Vec[i32]]) -> Vec[i32] {
    let n = grid[0].len();
    let mut place: Vec[i64] = (0..n).collect();
    for row in grid.iter() {
        for b in 0..n {
            let c = place[b];
            if c < 0 {
                continue;
            }
            let next = c + row[c];
            place[b] = if 0 <= next and next < n and row[next] == row[c] { next } else { -1 };
        }
    }
    place.iter().map(|c| c as i32).collect()
}

// ---- ball_exits.kara: where a ball leaves from any column, from the bottom up

fn exits_arm(grid: Vec[Vec[i32]]) -> Vec[i32] {
    let m = grid.len();
    let n = grid[0].len();
    let mut exit: Vec[i32] = (0..n).map(|c| c as i32).collect();
    for r in (0..m).rev() {
        let row = ref grid[r];
        let mut above: Vec[i32] = Vec.filled(n, -1);
        for c in 0..n {
            let next = c + row[c];
            if 0 <= next and next < n and row[next] == row[c] {
                above[c] = exit[next];
            }
        }
        exit = above;
    }
    exit
}

// ---- ball_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn find_ball(grid: Vec[Vec[i32]]) -> Vec[i32] {
        let n = grid[0].len() as i32;
        (0..n)
            .map(|start| {
                let mut c = start;
                for row in ref grid {
                    let d = row[c as usize];
                    let nc = c + d;
                    if nc < 0 or nc >= n or row[nc as usize] != d {
                        return -1;
                    }
                    c = nc;
                }
                c
            })
            .collect()
    }
}

fn solution_arm(grid: Vec[Vec[i32]]) -> Vec[i32] {
    SolutionArm.find_ball(grid)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally, in doubled coordinates: a ball is at
// x = 2c + 1, the middle of column c, as it falls into a row. The board
// there runs corner to corner, so the ball rolls down it to the corner at
// x + 1 (a board of 1, top-left to bottom-right) or x - 1. At that corner
// the box's wall stops it, and so does the next cell's board when it ends
// at the same corner, the two making a V; otherwise the ball is under that
// board and drops into the next row in the middle of that cell.
fn literal(grid: Slice[Vec[i32]]) -> Vec[i64] {
    let n = grid[0].len();
    let mut answer: Vec[i64] = Vec.new();
    for start in 0..n {
        let mut x = 2 * start + 1;
        for row in grid.iter() {
            let board = row[(x - 1) / 2];
            let corner = x + board;
            if corner == 0 or corner == 2 * n {
                x = -1;
                break;
            }
            // the cell on the corner's other side, and where its board's
            // lower end is
            let next = (corner + board - 1) / 2;
            let lower_end = if row[next] == 1 { 2 * next + 2 } else { 2 * next };
            if lower_end == corner {
                x = -1;
                break;
            }
            x = 2 * next + 1;
        }
        answer.push(if x < 0 { -1 } else { (x - 1) / 2 });
    }
    answer
}

fn arm(a: i64, grid: Slice[Vec[i32]]) -> Vec[i64] {
    let grid = grid.to_vec();
    let got = match a {
        0 => star_arm(grid),
        1 => rows_arm(grid),
        2 => exits_arm(grid),
        _ => solution_arm(grid),
    };
    got.iter().map(|c| c as i64).collect()
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "rows", "exits", "solution"][a]
}

fn main() {
    let mut seed = 1706;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..problems {
        let m = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % 6 + 1;
        let lean = next_random(mut seed) % 11;
        let mut grid: Vec[Vec[i32]] = Vec.new();
        for _ in 0..m {
            let row: Vec[i32] = (0..n).map(|_| if next_random(mut seed) % 10 < lean { 1 } else { -1 }).collect();
            grid.push(row);
        }
        cases.push(grid);
    }
    for (p, grid) in cases.iter().enumerate() {
        let n = grid[0].len();
        let want = literal(grid);
        for w in want.iter() {
            check = (check * 31 + w + 2) % 1000000007;
        }
        check = (check * 31 + grid.len()) % 1000000007;
        let mirrored: Vec[Vec[i32]] = grid.iter().map(|row| row.iter().rev().map(|b| -b).collect()).collect();
        let mut tilted: Vec[Vec[i32]] = [Vec.filled(n, 1)];
        tilted.extend(grid.iter().cloned());
        let mut answers: Vec[Vec[i64]] = Vec.new();
        for a in 0..4 {
            let got = arm(a, grid);
            let flipped = arm(a, mirrored);
            let mirror_ok = (0..n).all(|c| flipped[n - 1 - c] == (if got[c] < 0 { -1 } else { n - 1 - got[c] }));
            let shifted = arm(a, tilted);
            let tilt_ok = (0..n).all(|c| shifted[c] == (if c + 1 < n { got[c + 1] } else { -1 }));
            let mut out: Vec[i64] = got.iter().filter(|c| c >= 0).cloned().collect();
            out.sort();
            let distinct = (1..out.len()).all(|i| out[i] != out[i - 1]);
            let failed = [got != want, not mirror_ok, not tilt_ok, not distinct];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({grid}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
