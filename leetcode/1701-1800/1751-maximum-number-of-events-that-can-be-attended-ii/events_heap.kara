// LeetCode #1751: Maximum Number of Events That Can Be Attended II -- a
// sweep over the days with a heap of finished events.
//
// The events are taken in order of their first day. Each layer j keeps,
// for the events already finished before the current one starts, the
// best total of j attended: a min-heap of ends pops every event that has
// ended, folding its totals into a running best per layer, and the
// current event's totals extend those bests by its value. O(nk + n log n).

fn max_value(events: Vec[Vec[i32]], k: i32) -> i32 {
    let mut events = events.clone();
    events.sort();
    let n = events.len();
    let k = k as i64;
    let mut totals: Vec[Vec[i32]] = Vec.filled(n, Vec.filled(k + 1, 0));
    let mut finished: Vec[i32] = Vec.filled(k + 1, 0);
    let mut ending: PriorityQueue[(i32, i64)] = PriorityQueue.new();
    let mut answer = 0;
    for i in 0..n {
        while let Some((end, e)) = ending.peek() {
            if end >= events[i][0] {
                break;
            }
            for j in 0..k + 1 {
                finished[j] = max(finished[j], totals[e][j]);
            }
            ending.pop();
        }
        for j in 1..k + 1 {
            totals[i][j] = finished[j - 1] + events[i][2];
            answer = max(answer, totals[i][j]);
        }
        ending.push((events[i][1], i));
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random problems of 1 to `most` events inside days 1 to `days`,
// each at most `span` days long and worth up to `top`, with k from 1 to
// `most_k`
fn batch(count: i64, most: i64, days: i64, span: i64, top: i64, most_k: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut events: Vec[Vec[i32]] = Vec.new();
        for _ in 0..n {
            let start = wide(mut seed) % days + 1;
            let end = min(start + next_random(mut seed) % span, days);
            let value = wide(mut seed) % top + 1;
            events.push([start as i32, end as i32, value as i32]);
        }
        let k = (next_random(mut seed) % most_k + 1) as i32;
        let answer = max_value(events, k);
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} problems of up to {most} events in {days} days: values add to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one event, two that share a day,
    // and k larger than the events
    println(max_value([[1, 2, 4], [3, 4, 3], [2, 3, 1]], 2));
    println(max_value([[1, 2, 4], [3, 4, 3], [2, 3, 10]], 2));
    println(max_value([[1, 1, 1], [2, 2, 2], [3, 3, 3], [4, 4, 4]], 3));
    println(max_value([[5, 9, 1000000]], 1));
    println(max_value([[1, 3, 5], [3, 5, 6]], 2));
    println(max_value([[1, 1, 7], [2, 2, 8]], 9));
    let mut seed = 1751;
    batch(3000, 8, 12, 4, 10, 4, mut seed);
    batch(300, 1000, 1000000000, 1000000, 1000000, 1000, mut seed);
    batch(5, 100000, 1000000000, 100000, 1000000, 10, mut seed);
}
