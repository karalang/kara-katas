// LeetCode #1751: Maximum Number of Events That Can Be Attended II --
// memoized choices.
//
// With the events sorted by their first day, the best from the i-th event
// on with j still to attend is the best of skipping it and attending it,
// then going on from the first event that starts after it ends. Each
// (i, j) is worked out once and kept. O(nk + n log n).

fn best(i: i64, j: i64, events: Slice[Vec[i32]], next: Slice[i64], memo: mut ref Vec[Vec[Option[i32]]]) -> i32 {
    if i == events.len() or j == 0 {
        return 0;
    }
    if let Some(known) = memo[i][j] {
        return known;
    }
    let skip = best(i + 1, j, events, next, mut memo);
    let take = events[i][2] + best(next[i], j - 1, events, next, mut memo);
    let answer = max(skip, take);
    memo[i][j] = Some(answer);
    answer
}

fn max_value(events: Vec[Vec[i32]], k: i32) -> i32 {
    let mut events = events.clone();
    events.sort();
    let n = events.len();
    let next: Vec[i64] = events.iter().map(|e| events.partition_point(|f| f[0] <= e[1])).collect();
    let mut memo: Vec[Vec[Option[i32]]] = Vec.filled(n, Vec.filled(k as i64 + 1, None));
    best(0, k, events, next, mut memo)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random problems of 1 to `most` events inside days 1 to `days`,
// each at most `span` days long and worth up to `top`, with k from 1 to
// `most_k`
fn batch(count: i64, most: i64, days: i64, span: i64, top: i64, most_k: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut events: Vec[Vec[i32]] = Vec.new();
        for _ in 0..n {
            let start = wide(mut seed) % days + 1;
            let end = min(start + (next_random(mut seed) * 32768 + next_random(mut seed)) % span, days);
            let value = wide(mut seed) % top + 1;
            events.push([start as i32, end as i32, value as i32]);
        }
        let k = (next_random(mut seed) % most_k + 1) as i32;
        let answer = max_value(events, k);
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} problems of up to {most} events in {days} days: values add to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one event, two that share a day,
    // and k larger than the events
    println(max_value([[1, 2, 4], [3, 4, 3], [2, 3, 1]], 2));
    println(max_value([[1, 2, 4], [3, 4, 3], [2, 3, 10]], 2));
    println(max_value([[1, 1, 1], [2, 2, 2], [3, 3, 3], [4, 4, 4]], 3));
    println(max_value([[5, 9, 1000000]], 1));
    println(max_value([[1, 3, 5], [3, 5, 6]], 2));
    println(max_value([[1, 1, 7], [2, 2, 8]], 9));
    let mut seed = 1751;
    batch(3000, 8, 12, 4, 10, 4, mut seed);
    batch(300, 1000, 1000000000, 1000000, 1000000, 1000, mut seed);
    batch(5, 100000, 1000000000, 100000, 1000000, 10, mut seed);
}
