// LeetCode #1788: Maximize the Beauty of the Garden -- the bench: the ★
// arm, a prefix sum of the positives and each beauty's first position, over
// 400 gardens of 2000 flowers from -10^4 to 10^4 built once, 10000 calls.

fn maximum_beauty(flowers: Vec[i32]) -> i32 {
    let n = flowers.len();
    let mut positive: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        positive[i + 1] = positive[i] + flowers[i].max(0);
    }
    let mut first: Map[i32, i64] = Map.new();
    let mut best = i64.MIN;
    for j in 0..n {
        let v = flowers[j];
        match first.get(v) {
            Some(i) => {
                let garden = 2 * v + positive[j] - positive[i + 1];
                best = best.max(garden);
            }
            None => {
                first[v] = j;
            }
        }
    }
    best as i32
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1788;
    let mut gardens: Vec[Vec[i32]] = Vec.new();
    for _ in 0..400 {
        let mut flowers: Vec[i32] = Vec.new();
        for _ in 0..2000 {
            flowers.push((next_random(mut seed) % 20001 - 10000) as i32);
        }
        // two flowers alike, so that a garden exists
        flowers[1999] = flowers[0];
        gardens.push(flowers);
    }
    let mut check = 0;
    for call in 0..10000 {
        let flowers = ref gardens[(check + call) % 400];
        check = (check * 31 + maximum_beauty(flowers) + 1000000000) % 1000000007;
    }
    println(f"10000 calls over 400 gardens: checksum {check}");
}
