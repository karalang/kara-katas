// LeetCode #1718: Construct the Lexicographically Largest Valid Sequence --
// a Rust solution as LeetCode's Rust users write it: a nested `fn` taking
// `&mut Vec<i32>` and `&mut Vec<bool>`, `usize` indices, and `n as usize`.

fn dfs(i: i64, n: i64, res: mut ref Vec[i32], used: mut ref Vec[bool]) -> bool {
    if i == res.len() {
        return true;
    }
    if res[i] != 0 {
        return dfs(i + 1, n, mut res, mut used);
    }
    for x in (1..=n).rev() {
        if used[x] {
            continue;
        }
        if x > 1 and (i + x >= res.len() or res[i + x] != 0) {
            continue;
        }
        used[x] = true;
        res[i] = x as i32;
        if x > 1 {
            res[i + x] = x as i32;
        }
        if dfs(i + 1, n, mut res, mut used) {
            return true;
        }
        used[x] = false;
        res[i] = 0;
        if x > 1 {
            res[i + x] = 0;
        }
    }
    false
}

struct Solution {}

impl Solution {
    pub fn construct_distanced_sequence(n: i32) -> Vec[i32] {
        let n = n as i64;
        let mut res = Vec.filled(2 * n - 1, 0);
        let mut used = Vec.filled(n + 1, false);
        dfs(0, n, mut res, mut used);
        res
    }
}

fn construct_distanced_sequence(n: i32) -> Vec[i32] {
    Solution.construct_distanced_sequence(n)
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples, then the smallest two and the largest
    println(construct_distanced_sequence(3));
    println(construct_distanced_sequence(5));
    println(construct_distanced_sequence(1));
    println(construct_distanced_sequence(2));
    println(construct_distanced_sequence(20));
    // every n the constraints allow
    let mut values = 0;
    let mut check = 0;
    for n in 1..=20 {
        for v in construct_distanced_sequence(n).iter() {
            values += 1;
            check = (check * 31 + v) % 1000000007;
        }
    }
    println(f"every n from 1 to 20: {values} values, checksum {check}");
}
