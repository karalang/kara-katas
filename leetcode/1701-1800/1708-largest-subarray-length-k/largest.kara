// LeetCode #1708: Largest Subarray Length K -- the ★ arm: the largest
// first value among the starts that leave room for k.
//
// The values are distinct, so two subarrays of length k differ at their
// first values unless they start at the same place: the largest is the
// one whose first value is largest, among the starts 0 to n - k. O(n).

fn largest_subarray(nums: Vec[i32], k: i32) -> Vec[i32] {
    let mut best = 0;
    for i in 1..=nums.len() - k {
        if nums[i] > nums[best] {
            best = i;
        }
    }
    nums[best..best + k].to_vec()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random arrays of 1 to `most` distinct values, each with a k from
// 1 to its length: the values 1 to n shuffled, each times 10 plus a random
// last digit; the answers' first values summed, and a checksum of every
// answer
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut firsts = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut nums: Vec[i32] = (1..=n).map(|v| v as i32).collect();
        for i in (1..n).rev() {
            let j = next_random(mut seed) % (i + 1);
            nums.swap(i, j);
        }
        for i in 0..n {
            nums[i] = nums[i] * 10 + (next_random(mut seed) % 10) as i32;
        }
        let k = (next_random(mut seed) % n + 1) as i32;
        let answer = largest_subarray(nums, k);
        firsts += answer[0];
        for v in answer.iter() {
            check = (check * 31 + v) % 1000000007;
        }
        check = (check * 31 + k) % 1000000007;
    }
    println(f"{count} arrays of up to {most} values: first values sum to {firsts}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then all of it and the largest last
    println(largest_subarray([1, 4, 5, 2, 3], 3));
    println(largest_subarray([1, 4, 5, 2, 3], 4));
    println(largest_subarray([1, 4, 5, 2, 3], 1));
    println(largest_subarray([3, 1, 2], 3));
    println(largest_subarray([1, 2, 9], 2));
    let mut seed = 1708;
    batch(3000, 10, mut seed);
    batch(300, 1000, mut seed);
    batch(10, 100000, mut seed);
}
