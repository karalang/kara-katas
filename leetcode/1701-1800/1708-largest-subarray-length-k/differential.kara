// LeetCode #1708: Largest Subarray Length K -- the differential.
//
// Four arms against the statement read literally, on 3000 random arrays
// of 1 to 8 distinct values, the values 1 to n shuffled, each with a k
// from 1 to n.
//
// P1  the answer is the statement read literally
// P2  every value raised by 1000 raises the answer's by 1000
// P3  the answer is k values in a row of the array
// P4  a value below all the others put in front changes nothing
// P5  each arm agrees with at least two of the other three

// ---- largest.kara: the ★ arm: the largest first value among the starts

fn star_arm(nums: Vec[i32], k: i32) -> Vec[i32] {
    let mut best = 0;
    for i in 1..=nums.len() - k {
        if nums[i] > nums[best] {
            best = i;
        }
    }
    nums[best..best + k].to_vec()
}

// ---- largest_compare.kara: every subarray compared whole, as a Vec

fn compare_arm(nums: Vec[i32], k: i32) -> Vec[i32] {
    let mut best: Vec[i32] = nums[0..k].to_vec();
    for i in 1..=nums.len() - k {
        let window = nums[i..i + k].to_vec();
        if window > best {
            best = window;
        }
    }
    best
}

// ---- largest_windows.kara: windows(k) and max()

fn windows_arm(nums: Vec[i32], k: i32) -> Vec[i32] {
    nums.windows(k).iter().max().unwrap().to_vec()
}

// ---- largest_scan.kara: the starts compared a value at a time, by hand

fn scan_arm(nums: Vec[i32], k: i32) -> Vec[i32] {
    let k = k as i64;
    let mut best = 0;
    for start in 1..=nums.len() - k {
        let mut j = 0;
        while j < k and nums[start + j] == nums[best + j] {
            j += 1;
        }
        if j < k and nums[start + j] > nums[best + j] {
            best = start;
        }
    }
    let mut answer: Vec[i32] = Vec.with_capacity(k);
    for j in 0..k {
        answer.push(nums[best + j]);
    }
    answer
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every contiguous subarray of length k,
// each compared with the best so far at the first index where they
// differ, the larger value there deciding; the largest
fn literal(nums: Slice[i32], k: i64) -> Vec[i32] {
    let mut best: Vec[i32] = Vec.new();
    for start in 0..=nums.len() - k {
        let candidate: Vec[i32] = (start..start + k).map(|i| nums[i]).collect();
        let mut larger = best.is_empty();
        for i in 0..k {
            if not best.is_empty() and candidate[i] != best[i] {
                larger = candidate[i] > best[i];
                break;
            }
        }
        if larger {
            best = candidate;
        }
    }
    best
}

fn arm(a: i64, nums: Slice[i32], k: i64) -> Vec[i32] {
    let nums = nums.to_vec();
    let k = k as i32;
    match a {
        0 => star_arm(nums, k),
        1 => compare_arm(nums, k),
        2 => windows_arm(nums, k),
        _ => scan_arm(nums, k),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "compare", "windows", "scan"][a]
}

fn main() {
    let mut seed = 1708;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(Vec[i32], i64)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 8 + 1;
        let mut nums: Vec[i32] = (1..=n).map(|v| v as i32).collect();
        for i in (1..n).rev() {
            let j = next_random(mut seed) % (i + 1);
            nums.swap(i, j);
        }
        let k = next_random(mut seed) % n + 1;
        cases.push((nums, k));
    }
    for (p, (nums, k)) in cases.iter().enumerate() {
        let want = literal(nums, k);
        for w in want.iter() {
            check = (check * 31 + w) % 1000000007;
        }
        check = (check * 31 + k + nums.len()) % 1000000007;
        let raised: Vec[i32] = nums.iter().map(|v| v + 1000).collect();
        let mut lower: Vec[i32] = [0];
        lower.extend(nums.iter());
        let mut answers: Vec[Vec[i32]] = Vec.new();
        for a in 0..4 {
            let got = arm(a, nums, k);
            let lifted: Vec[i32] = got.iter().map(|v| v + 1000).collect();
            let inside = got.len() == k and (0..=nums.len() - k).any(|s| (0..k).all(|i| nums[s + i] == got[i]));
            let failed = [got != want, arm(a, raised, k) != lifted, not inside, arm(a, lower, k) != got];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({nums}, k {k}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
