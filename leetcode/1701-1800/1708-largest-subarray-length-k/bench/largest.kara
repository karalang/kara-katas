// LeetCode #1708: Largest Subarray Length K -- the bench: the ★ arm on 50
// random arrays of 100000 distinct values below 10^9, LeetCode's largest,
// each with a random k, all drawn first, each answered 100 times.
//
// The values are distinct, so the largest subarray is the one whose first
// value is largest among the starts 0 to n - k. O(n).

fn largest_subarray(nums: Vec[i32], k: i32) -> Vec[i32] {
    let mut best = 0;
    for i in 1..=nums.len() - k {
        if nums[i] > nums[best] {
            best = i;
        }
    }
    nums[best..best + k].to_vec()
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 50;
    let rounds = 100;
    let n = 100000;
    let mut seed = 1708;
    let mut problems: Vec[(Vec[i32], i32)] = Vec.new();
    for _ in 0..count {
        let mut nums: Vec[i32] = (0..n).map(|v| v as i32).collect();
        for i in (1..n).rev() {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            nums.swap(i, j);
        }
        for i in 0..n {
            nums[i] = nums[i] * 10000 + (next_random(mut seed) % 10000) as i32;
        }
        let k = (next_random(mut seed) * 32768 + next_random(mut seed)) % n + 1;
        problems.push((nums, k as i32));
    }
    let mut chosen = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, k) in problems.iter() {
            let answer = largest_subarray(nums, k);
            chosen += answer.len();
            check = (check * 31 + answer.len() + answer[0] + answer[answer.len() - 1] + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {n} values, {rounds} rounds: {chosen} chosen, checksum {check}");
}
