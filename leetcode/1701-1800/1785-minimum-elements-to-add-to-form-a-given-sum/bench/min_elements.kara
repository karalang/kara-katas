// LeetCode #1785: Minimum Elements to Add to Form a Given Sum -- the bench:
// the ★ arm, the gap over the limit rounded up, over 4000 lists of 100
// numbers built once, 6000000 calls with the limit and the goal drawn from
// the running checksum.

fn min_elements(nums: Vec[i32], limit: i32, goal: i32) -> i32 {
    let sum: i64 = nums.iter().map(|x| x as i64).sum();
    let gap = (goal - sum).abs();
    ((gap + limit - 1) / limit) as i32
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1785;
    let mut lists: Vec[Vec[i32]] = Vec.new();
    for _ in 0..4000 {
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..100 {
            nums.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % 2000001 - 1000000) as i32);
        }
        lists.push(nums);
    }
    let mut check = 0;
    for call in 0..6000000 {
        let nums = ref lists[(check + call) % 4000];
        let limit = 1 + (check + call) % 1000000;
        let goal = check % 2000000001 - 1000000000;
        check = (check * 31 + min_elements(nums, limit as i32, goal as i32)) % 1000000007;
    }
    println(f"6000000 calls over 4000 lists: checksum {check}");
}
