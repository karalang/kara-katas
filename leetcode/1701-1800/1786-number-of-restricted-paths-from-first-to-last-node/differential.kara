// LeetCode #1786: Number of Restricted Paths From First to Last Node --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- count_restricted_paths.kara ----
fn a0_count_restricted_paths(n: i32, edges: Vec[Vec[i32]]) -> i32 {
    let mut adj: Vec[Vec[(i32, i64)]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        adj[e[0]].push((e[1], e[2]));
        adj[e[1]].push((e[0], e[2]));
    }
    let mut dist: Vec[i64] = Vec.filled(n + 1, -1);
    let mut order: Vec[i32] = Vec.new();
    let mut queue: PriorityQueue[(i64, i32)] = PriorityQueue.new();
    queue.push((0, n));
    while let Some((d, u)) = queue.pop() {
        if dist[u] != -1 {
            continue;
        }
        dist[u] = d;
        order.push(u);
        for (v, w) in adj[u].iter() {
            if dist[v] == -1 {
                queue.push((d + w, v));
            }
        }
    }
    let mut ways: Vec[i64] = Vec.filled(n + 1, 0);
    ways[n] = 1;
    for u in order.iter() {
        for (v, _) in adj[u].iter() {
            if dist[v] < dist[u] {
                ways[u] = (ways[u] + ways[v]) % 1000000007;
            }
        }
    }
    ways[1] as i32
}

// ---- count_restricted_paths_memo.kara ----
fn a1_paths_from(u: i32, n: i32, adj: Vec[Vec[(i32, i64)]], dist: Vec[i64], memo: mut ref Vec[i64]) -> i64 {
    if u == n {
        return 1;
    }
    if memo[u] >= 0 {
        return memo[u];
    }
    let mut total = 0;
    for (v, _) in adj[u].iter() {
        if dist[v] < dist[u] {
            total = (total + a1_paths_from(v, n, adj, dist, mut memo)) % 1000000007;
        }
    }
    memo[u] = total;
    total
}

fn a1_count_restricted_paths(n: i32, edges: Vec[Vec[i32]]) -> i32 {
    let mut adj: Vec[Vec[(i32, i64)]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        adj[e[0]].push((e[1], e[2]));
        adj[e[1]].push((e[0], e[2]));
    }
    let mut dist: Vec[i64] = Vec.filled(n + 1, i64.MAX);
    dist[n] = 0;
    let mut queue: PriorityQueue[(i64, i32)] = PriorityQueue.new();
    queue.push((0, n));
    while let Some((d, u)) = queue.pop() {
        if d > dist[u] {
            continue;
        }
        for (v, w) in adj[u].iter() {
            if d + w < dist[v] {
                dist[v] = d + w;
                queue.push((dist[v], v));
            }
        }
    }
    let mut memo: Vec[i64] = Vec.filled(n + 1, -1);
    a1_paths_from(1, n, adj, dist, mut memo) as i32
}

// ---- count_restricted_paths_dense.kara ----
fn a2_count_restricted_paths(n: i32, edges: Vec[Vec[i32]]) -> i32 {
    let mut adj: Vec[Vec[(i32, i64)]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        adj[e[0]].push((e[1], e[2]));
        adj[e[1]].push((e[0], e[2]));
    }
    let mut dist: Vec[i64] = Vec.filled(n + 1, i64.MAX);
    let mut settled: Vec[bool] = Vec.filled(n + 1, false);
    dist[n] = 0;
    for _ in 0..n {
        let mut u = 0;
        for x in 1..n + 1 {
            if not settled[x] and (u == 0 or dist[x] < dist[u]) {
                u = x;
            }
        }
        settled[u] = true;
        for (v, w) in adj[u].iter() {
            if dist[u] + w < dist[v] {
                dist[v] = dist[u] + w;
            }
        }
    }
    let mut nodes: Vec[i32] = (1..n + 1).collect();
    nodes.sort_by_key(|x| dist[x]);
    let mut ways: Vec[i64] = Vec.filled(n + 1, 0);
    ways[n] = 1;
    for u in nodes.iter() {
        for (v, _) in adj[u].iter() {
            if dist[v] < dist[u] {
                ways[u] = (ways[u] + ways[v]) % 1000000007;
            }
        }
    }
    ways[1] as i32
}

// ---- count_restricted_paths_kahn.kara ----
fn a3_count_restricted_paths(n: i32, edges: Vec[Vec[i32]]) -> i32 {
    let mut adj: Vec[Vec[(i32, i64)]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        adj[e[0]].push((e[1], e[2]));
        adj[e[1]].push((e[0], e[2]));
    }
    let mut dist: Vec[i64] = Vec.filled(n + 1, i64.MAX);
    let mut queued: Vec[bool] = Vec.filled(n + 1, false);
    let mut queue: VecDeque[i32] = VecDeque.new();
    dist[n] = 0;
    queue.push_back(n);
    queued[n] = true;
    while let Some(u) = queue.pop_front() {
        queued[u] = false;
        for (v, w) in adj[u].iter() {
            if dist[u] + w < dist[v] {
                dist[v] = dist[u] + w;
                if not queued[v] {
                    queued[v] = true;
                    queue.push_back(v);
                }
            }
        }
    }
    // the DAG: u -> v for each edge with v strictly nearer n
    let mut into: Vec[i32] = Vec.filled(n + 1, 0);
    for u in 1..n + 1 {
        for (v, _) in adj[u].iter() {
            if dist[v] < dist[u] {
                into[v] += 1;
            }
        }
    }
    let mut ways: Vec[i64] = Vec.filled(n + 1, 0);
    ways[1] = 1;
    let mut ready: VecDeque[i32] = VecDeque.new();
    for u in 1..n + 1 {
        if into[u] == 0 {
            ready.push_back(u);
        }
    }
    while let Some(u) = ready.pop_front() {
        for (v, _) in adj[u].iter() {
            if dist[v] < dist[u] {
                ways[v] = (ways[v] + ways[u]) % 1000000007;
                into[v] -= 1;
                if into[v] == 0 {
                    ready.push_back(v);
                }
            }
        }
    }
    ways[n] as i32
}

// ---- count_restricted_paths_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn count_restricted_paths(n: i32, edges: Vec[Vec[i32]]) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let n = n as i64;
        let mut g = Vec.filled(n + 1, Vec.new());
        for e in ref edges {
            let (u, v, w) = (e[0] as i64, e[1] as i64, e[2] as i64);
            g[u].push((v, w));
            g[v].push((u, w));
        }
        let mut dist = Vec.filled(n + 1, i64.MAX);
        dist[n] = 0;
        let mut heap = PriorityQueue.new();
        heap.push((0, n));
        while let Some((d, u)) = heap.pop() {
            if d > dist[u] {
                continue;
            }
            for (v, w) in ref g[u] {
                if d + w < dist[v] {
                    dist[v] = d + w;
                    heap.push((dist[v], v));
                }
            }
        }
        let mut idx: Vec[i64] = (1..=n).collect();
        idx.sort_by_key(|i| dist[i]);
        let mut dp = Vec.filled(n + 1, 0);
        dp[n] = 1;
        for u in ref idx {
            for (v, _) in ref g[u] {
                if dist[v] < dist[u] {
                    dp[u] = (dp[u] + dp[v]) % MOD;
                }
            }
        }
        dp[1] as i32
    }
}

fn a4_count_restricted_paths(n: i32, edges: Vec[Vec[i32]]) -> i32 {
    A4Solution.count_restricted_paths(n, edges)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a connected graph on n nodes, drawn as the harness draws it
fn random_graph(seed: mut ref i64, n: i64, extra: i64, most_w: i64) -> Vec[Vec[i32]] {
    let mut edges: Vec[Vec[i32]] = Vec.new();
    let mut joined: Set[(i64, i64)] = Set.new();
    for v in 2..n + 1 {
        let u = 1 + next_random(mut seed) % (v - 1);
        let w = 1 + next_random(mut seed) % most_w;
        joined.insert((u, v));
        edges.push([u as i32, v as i32, w as i32].to_vec());
    }
    for _ in 0..extra {
        let a = 1 + next_random(mut seed) % n;
        let b = 1 + next_random(mut seed) % n;
        let (u, v) = if a < b { (a, b) } else { (b, a) };
        if u == v or joined.contains((u, v)) {
            continue;
        }
        let w = 1 + next_random(mut seed) % most_w;
        joined.insert((u, v));
        if next_random(mut seed) % 2 == 0 {
            edges.push([u as i32, v as i32, w as i32].to_vec());
        } else {
            edges.push([v as i32, u as i32, w as i32].to_vec());
        }
    }
    edges
}

// every path from `u` that visits no node twice, carried to n; it counts
// those whose distances to n fall at every step
fn walk(u: i32, n: i32, weight: Vec[Vec[i64]], dist: Vec[i64], path: mut ref Vec[i32], on: mut ref Vec[bool]) -> i64 {
    if u == n {
        let mut falls = true;
        for i in 1..path.len() {
            if not (dist[path[i - 1]] > dist[path[i]]) {
                falls = false;
            }
        }
        return if falls { 1 } else { 0 };
    }
    let mut total = 0;
    for v in 1..n + 1 {
        if weight[u][v] > 0 and not on[v] {
            on[v] = true;
            path.push(v);
            total += walk(v, n, weight, dist, mut path, mut on);
            path.pop();
            on[v] = false;
        }
    }
    total
}

// the statement read literally: each node's distance to n by
// Floyd-Warshall over every pair, then every path from 1 to n tried, and
// the restricted ones counted
fn literal(n: i32, edges: Vec[Vec[i32]]) -> i32 {
    let big = i64.MAX / 4;
    let mut weight: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(n + 1, 0));
    let mut far: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(n + 1, big));
    for x in 1..n + 1 {
        far[x][x] = 0;
    }
    for e in edges.iter() {
        weight[e[0]][e[1]] = e[2];
        weight[e[1]][e[0]] = e[2];
        far[e[0]][e[1]] = e[2];
        far[e[1]][e[0]] = e[2];
    }
    for k in 1..n + 1 {
        for i in 1..n + 1 {
            for j in 1..n + 1 {
                if far[i][k] + far[k][j] < far[i][j] {
                    far[i][j] = far[i][k] + far[k][j];
                }
            }
        }
    }
    let dist: Vec[i64] = (0..n + 1).map(|x| far[x][n]).collect();
    let mut path: Vec[i32] = [1].to_vec();
    let mut on: Vec[bool] = Vec.filled(n + 1, false);
    on[1] = true;
    (walk(1, n, weight, dist, mut path, mut on) % 1000000007) as i32
}

fn arm(i: i64, n: i32, edges: Vec[Vec[i32]]) -> i32 {
    match i {
        0 => a0_count_restricted_paths(n, edges),
        1 => a1_count_restricted_paths(n, edges),
        2 => a2_count_restricted_paths(n, edges),
        3 => a3_count_restricted_paths(n, edges),
        _ => a4_count_restricted_paths(n, edges),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, n: i32, edges: Vec[Vec[i32]], extra_w: i32) {
    t.cases += 1;
    let star = arm(0, n, edges);
    t.check = (t.check * 31 + star) % 1000000007;
    let want = if n <= 8 { Some(literal(n, edges)) } else { None };
    // the nodes between the first and the last relabelled in reverse
    let label = |x: i32| if x == 1 or x == n { x } else { n + 1 - x };
    let moved: Vec[Vec[i32]] = edges.iter().map(|e| [label(e[0]), label(e[1]), e[2]].to_vec()).collect();
    let doubled: Vec[Vec[i32]] = edges.iter().map(|e| [e[0], e[1], 2 * e[2]].to_vec()).collect();
    let mut flipped: Vec[Vec[i32]] = edges.iter().map(|e| [e[1], e[0], e[2]].to_vec()).collect();
    flipped.reverse();
    // a node past the last, joined to it alone
    let mut longer = edges.clone();
    longer.push([n, n + 1, extra_w].to_vec());
    for i in 0..5 {
        let what = f"arm {i} on {n} nodes {edges}";
        let got = arm(i, n, edges);
        // P1: the statement read literally, while there are at most 8
        // nodes
        if let Some(w) = want {
            expect(mut t, 1, got == w, f"P1 {what}");
        }
        // P2: the nodes between the first and the last relabelled give the
        // same answer
        expect(mut t, 2, arm(i, n, moved) == got, f"P2 {what}");
        // P3: every weight doubled gives the same answer
        expect(mut t, 3, arm(i, n, doubled) == got, f"P3 {what}");
        // P4: the edges listed backwards, each from its other end, give the
        // same answer
        expect(mut t, 4, arm(i, n, flipped) == got, f"P4 {what}");
        // P5: a node past the last, joined to it alone, gives the same
        // answer
        expect(mut t, 5, arm(i, n + 1, longer) == got, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples, the edges, a line of 2000 nodes each edge 10^5,
    // a ladder of two rails of 1000 nodes, and a random graph of 2000
    // nodes and 4000 edges. Every case is drawn before any arm answers.
    let mut cases: Vec[(i32, Vec[Vec[i32]])] = Vec.new();
    let first: Vec[Vec[i32]] = [[1, 2, 3], [1, 3, 3], [2, 3, 1], [1, 4, 2], [5, 2, 2], [3, 5, 1], [5, 4, 10]].to_vec();
    let second: Vec[Vec[i32]] = [[1, 3, 1], [4, 1, 2], [7, 3, 4], [2, 5, 3], [5, 6, 1], [6, 7, 2], [7, 5, 3], [2, 6, 4]].to_vec();
    let lone: Vec[Vec[i32]] = Vec.new();
    let pair: Vec[Vec[i32]] = [[1, 2, 7]].to_vec();
    let triangle: Vec[Vec[i32]] = [[1, 2, 1], [2, 3, 1], [1, 3, 2]].to_vec();
    let square: Vec[Vec[i32]] = [[1, 2, 1], [1, 3, 1], [2, 4, 1], [3, 4, 1], [2, 3, 5]].to_vec();
    cases.push((5, first));
    cases.push((7, second));
    cases.push((1, lone));
    cases.push((2, pair));
    cases.push((3, triangle));
    cases.push((4, square));
    let mut line: Vec[Vec[i32]] = Vec.new();
    for v in 1i32..2000 {
        line.push([v, v + 1, 100000].to_vec());
    }
    cases.push((2000, line));
    let mut ladder: Vec[Vec[i32]] = Vec.new();
    for i in 1i32..1001 {
        ladder.push([i, i + 1000, 1].to_vec());
        if i < 1000 {
            ladder.push([i, i + 1, 1].to_vec());
            ladder.push([i + 1000, i + 1001, 1].to_vec());
        }
    }
    cases.push((2000, ladder));
    let mut seed = 17861;
    cases.push((2000, random_graph(mut seed, 2000, 2001, 100000)));
    // 1991 random graphs: most of 1 to 8 nodes and up to 8 more edges, the
    // weights from 1 to 4 so that distances tie; one in eight of 9 to 40
    // nodes
    for c in 0..1991 {
        let n = if c % 8 == 7 { 9 + next_random(mut seed) % 32 } else { 1 + next_random(mut seed) % 8 };
        let extra = next_random(mut seed) % 9;
        cases.push((n as i32, random_graph(mut seed, n, extra, 4)));
    }
    for j in 0..cases.len() {
        let w = (1 + next_random(mut seed) % 5) as i32;
        check_case(mut t, cases[j].0, cases[j].1, w);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
