// LeetCode #1786: Number of Restricted Paths From First to Last Node -- the
// bench: the ★ arm, Dijkstra from node n then the paths summed in the order
// the nodes settled, over 200 random graphs of 2000 nodes and up to 4000
// edges built once, 1000 calls.

fn count_restricted_paths(n: i32, edges: Vec[Vec[i32]]) -> i32 {
    let mut adj: Vec[Vec[(i32, i64)]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        adj[e[0]].push((e[1], e[2]));
        adj[e[1]].push((e[0], e[2]));
    }
    let mut dist: Vec[i64] = Vec.filled(n + 1, -1);
    let mut order: Vec[i32] = Vec.new();
    let mut queue: PriorityQueue[(i64, i32)] = PriorityQueue.new();
    queue.push((0, n));
    while let Some((d, u)) = queue.pop() {
        if dist[u] != -1 {
            continue;
        }
        dist[u] = d;
        order.push(u);
        for (v, w) in adj[u].iter() {
            if dist[v] == -1 {
                queue.push((d + w, v));
            }
        }
    }
    let mut ways: Vec[i64] = Vec.filled(n + 1, 0);
    ways[n] = 1;
    for u in order.iter() {
        for (v, _) in adj[u].iter() {
            if dist[v] < dist[u] {
                ways[u] = (ways[u] + ways[v]) % 1000000007;
            }
        }
    }
    ways[1] as i32
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a connected graph on n nodes: a random tree, each node joined to one
// before it, then up to `extra` more edges between nodes not yet joined
fn random_graph(seed: mut ref i64, n: i64, extra: i64) -> Vec[Vec[i32]] {
    let mut edges: Vec[Vec[i32]] = Vec.new();
    let mut joined: Set[(i64, i64)] = Set.new();
    for v in 2..n + 1 {
        let u = 1 + next_random(mut seed) % (v - 1);
        let w = 1 + next_random(mut seed) % 100000;
        joined.insert((u, v));
        edges.push([u as i32, v as i32, w as i32].to_vec());
    }
    for _ in 0..extra {
        let a = 1 + next_random(mut seed) % n;
        let b = 1 + next_random(mut seed) % n;
        let (u, v) = if a < b { (a, b) } else { (b, a) };
        if u == v or joined.contains((u, v)) {
            continue;
        }
        let w = 1 + next_random(mut seed) % 100000;
        joined.insert((u, v));
        edges.push([u as i32, v as i32, w as i32].to_vec());
    }
    edges
}

fn main() {
    let mut seed = 1786;
    let mut graphs: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..200 {
        graphs.push(random_graph(mut seed, 2000, 2001));
    }
    let mut check = 0;
    for call in 0..1000 {
        let edges = ref graphs[(check + call) % 200];
        check = (check * 31 + count_restricted_paths(2000, edges)) % 1000000007;
    }
    println(f"1000 calls over 200 graphs: checksum {check}");
}
