// LeetCode #1768: Merge Strings Alternately -- the bench: the ★ arm, one
// index walking both words, a letter from each word that still has one.

fn merge_alternately(word1: String, word2: String) -> String {
    let a: Vec[char] = word1.chars().collect();
    let b: Vec[char] = word2.chars().collect();
    let mut merged = String.new();
    for i in 0..a.len().max(b.len()) {
        if i < a.len() {
            merged.push(a[i]);
        }
        if i < b.len() {
            merged.push(b[i]);
        }
    }
    merged
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, n: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(char.try_from((97 + next_random(mut seed) % 26) as u32).ok().unwrap());
    }
    s
}

fn main() {
    let mut seed = 1768;
    let mut words: Vec[String] = Vec.new();
    for _ in 0..1000 {
        let n = 1 + next_random(mut seed) % 100;
        words.push(random_word(mut seed, n));
    }
    let mut check = 0;
    for call in 0..2000000 {
        let a = (check + call * 7919) % 1000;
        let b = (check / 3 + call * 104729) % 1000;
        let merged = merge_alternately(words[a], words[b]);
        let at = check % merged.len();
        check = (check * 31 + merged.len() + merged.bytes()[at]) % 1000000007;
    }
    println(f"2000000 calls over 1000 words: checksum {check}");
}
