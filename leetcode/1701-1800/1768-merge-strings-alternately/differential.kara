// LeetCode #1768: Merge Strings Alternately -- differential test of the
// five arms against the statement read literally, with five more
// properties.

// ---- merge_alternately.kara ----
fn a0_merge_alternately(word1: String, word2: String) -> String {
    let a: Vec[char] = word1.chars().collect();
    let b: Vec[char] = word2.chars().collect();
    let mut merged = String.new();
    for i in 0..a.len().max(b.len()) {
        if i < a.len() {
            merged.push(a[i]);
        }
        if i < b.len() {
            merged.push(b[i]);
        }
    }
    merged
}

// ---- merge_alternately_zip.kara ----
fn a1_merge_alternately(word1: String, word2: String) -> String {
    let mut merged = String.new();
    for (a, b) in word1.chars().zip(word2.chars()) {
        merged.push(a);
        merged.push(b);
    }
    let shared = word1.len().min(word2.len());
    merged.push_str(word1[shared..]);
    merged.push_str(word2[shared..]);
    merged
}

// ---- merge_alternately_iterators.kara ----
fn a2_merge_alternately(word1: String, word2: String) -> String {
    let mut first = word1.chars();
    let mut second = word2.chars();
    let mut merged = String.new();
    loop {
        let a = first.next();
        let b = second.next();
        if a.is_none() and b.is_none() {
            break;
        }
        if let Some(c) = a {
            merged.push(c);
        }
        if let Some(c) = b {
            merged.push(c);
        }
    }
    merged
}

// ---- merge_alternately_bytes.kara ----
fn a3_merge_alternately(word1: String, word2: String) -> String {
    let a = word1.bytes();
    let b = word2.bytes();
    let mut out: Vec[u8] = Vec.with_capacity(a.len() + b.len());
    let mut i = 0;
    while i < a.len() or i < b.len() {
        if i < a.len() {
            out.push(a[i]);
        }
        if i < b.len() {
            out.push(b[i]);
        }
        i += 1;
    }
    String.from_utf8(out).unwrap()
}

// ---- merge_alternately_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn merge_alternately(word1: String, word2: String) -> String {
        let mut res = String.with_capacity(word1.len() + word2.len());
        let mut (a, b) = (word1.chars(), word2.chars());
        loop {
            match (a.next(), b.next()) {
                (Some(x), Some(y)) => {
                    res.push(x);
                    res.push(y);
                }
                (Some(x), None) => res.push(x),
                (None, Some(y)) => res.push(y),
                (None, None) => break,
            }
        }
        res
    }
}

fn a4_merge_alternately(word1: String, word2: String) -> String {
    A4Solution.merge_alternately(word1, word2)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, n: i64, letters: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(char.try_from((97 + next_random(mut seed) % letters) as u32).ok().unwrap());
    }
    s
}

// the statement read literally: letters added in alternating order,
// starting with word1, and once a word runs out the other's added in turn
fn literal(word1: String, word2: String) -> String {
    let a: Vec[char] = word1.chars().collect();
    let b: Vec[char] = word2.chars().collect();
    let mut (i, j) = (0, 0);
    let mut first = true;
    let mut out = String.new();
    while i < a.len() or j < b.len() {
        if (first and i < a.len()) or j == b.len() {
            out.push(a[i]);
            i += 1;
        } else {
            out.push(b[j]);
            j += 1;
        }
        first = not first;
    }
    out
}

// each letter moved one on in the alphabet, z to a
fn rotated(s: Str) -> String {
    s.chars().map(|c| char.try_from(97 + (c as u32 - 97 + 1) % 26).ok().unwrap()).collect()
}

fn digest(s: String) -> i64 {
    s.bytes().iter().fold(s.len(), |check, b| (check * 31 + b) % 1000000007)
}

fn arm(i: i64, word1: String, word2: String) -> String {
    match i {
        0 => a0_merge_alternately(word1, word2),
        1 => a1_merge_alternately(word1, word2),
        2 => a2_merge_alternately(word1, word2),
        3 => a3_merge_alternately(word1, word2),
        _ => a4_merge_alternately(word1, word2),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, word1: String, word2: String) {
    t.cases += 1;
    let want = literal(word1, word2);
    t.check = (t.check * 31 + digest(want)) % 1000000007;
    let star = arm(0, word1, word2);
    let shared = word1.len().min(word2.len());
    let cut = (shared / 2).max(1);
    let r1 = rotated(word1.as_str());
    let r2 = rotated(word2.as_str());
    for i in 0..5 {
        let what = f"arm {i} on \"{word1}\" \"{word2}\"";
        let got = arm(i, word1, word2);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: every letter once, word1's first in each shared pair
        let g: Vec[char] = got.chars().collect();
        let w1: Vec[char] = word1.chars().collect();
        expect(mut t, 2, got.len() == word1.len() + word2.len() and (0..shared).all(|k| g[2 * k] == w1[k]), f"P2 {what}");
        // P3: the words swapped give each shared pair swapped
        let swapped: Vec[char] = arm(i, word2, word1).chars().collect();
        let paired = swapped.len() == g.len() and g.len() >= 2 * shared and (0..g.len()).all(|k| if k < 2 * shared { swapped[k] == g[k ^ 1] } else { swapped[k] == g[k] });
        expect(mut t, 3, paired, f"P3 {what}");
        // P4: both words cut at one place inside the shorter merge as the
        // two halves' merges joined
        if shared >= 2 {
            let halves = arm(i, word1[..cut].to_string(), word2[..cut].to_string()) + arm(i, word1[cut..].to_string(), word2[cut..].to_string());
            expect(mut t, 4, halves == got, f"P4 {what}");
        }
        // P5: the letters rotated give the answer rotated
        expect(mut t, 5, arm(i, r1, r2) == rotated(got.as_str()), f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[(String, String)] = [("abc", "pqr"), ("ab", "pqrs"), ("abcd", "pq"), ("a", "b"), ("a", "bcd"), ("abcd", "e"), ("zz", "zz"), ("xy", "yx")].iter().map(|p| (p.0.to_string(), p.1.to_string())).collect();
    let mut seed = 17681;
    // 1992 random pairs of words of 1 to 12 letters from the first 2 to 26
    // of the alphabet
    for _ in 0..1992 {
        let n1 = 1 + next_random(mut seed) % 12;
        let n2 = 1 + next_random(mut seed) % 12;
        let letters = 2 + next_random(mut seed) % 25;
        let w1 = random_word(mut seed, n1, letters);
        let w2 = random_word(mut seed, n2, letters);
        cases.push((w1, w2));
    }
    for j in 0..cases.len() {
        check_case(mut t, cases[j].0, cases[j].1);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
