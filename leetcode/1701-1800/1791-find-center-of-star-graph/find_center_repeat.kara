// LeetCode #1791: Find Center of Star Graph -- the endpoints walked edge by
// edge into a `Set`; a leaf is on one edge, so the first node seen twice is
// the center. O(1), at most three endpoints

fn find_center(edges: Vec[Vec[i32]]) -> i32 {
    let mut seen: Set[i32] = Set.new();
    for e in edges.iter() {
        for v in e.iter() {
            if not seen.insert(v) {
                return v;
            }
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a star of n nodes around `center`, its edges in a random order, each
// written from either end
fn random_star(seed: mut ref i64, n: i64, center: i64) -> Vec[Vec[i32]] {
    let mut edges: Vec[Vec[i32]] = Vec.new();
    for leaf in 1..n + 1 {
        if leaf == center {
            continue;
        }
        if next_random(mut seed) % 2 == 0 {
            edges.push([center as i32, leaf as i32].to_vec());
        } else {
            edges.push([leaf as i32, center as i32].to_vec());
        }
    }
    for i in (1..edges.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        edges.swap(i, j);
    }
    edges
}

fn main() {
    // LeetCode's two examples
    println(f"{find_center([[1, 2], [2, 3], [4, 2]].to_vec())} {find_center([[1, 2], [5, 1], [1, 3], [1, 4]].to_vec())}");
    // the edges: three nodes with the center first, second and last in
    // the first edge; the center the largest label
    println(f"{find_center([[1, 2], [1, 3]].to_vec())} {find_center([[1, 2], [3, 2]].to_vec())} {find_center([[3, 1], [2, 3]].to_vec())} {find_center([[1, 4], [4, 2], [3, 4]].to_vec())}");
    // the constraints' most: 100000 nodes around 1, 100000 and one at
    // random
    let mut seed = 1791;
    let low = random_star(mut seed, 100000, 1);
    let high = random_star(mut seed, 100000, 100000);
    let center = 1 + next_random(mut seed) % 100000;
    let wide = random_star(mut seed, 100000, center);
    println(f"the most: {find_center(low)} {find_center(high)} {find_center(wide)}");
    // 3000 random stars of 3 to 40 nodes
    let mut check = 0;
    for _ in 0..3000 {
        let n = 3 + next_random(mut seed) % 38;
        let center = 1 + next_random(mut seed) % n;
        let edges = random_star(mut seed, n, center);
        check = (check * 41 + find_center(edges)) % 1000000007;
    }
    println(f"3000 random stars: checksum {check}");
}
