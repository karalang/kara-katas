// LeetCode #1791: Find Center of Star Graph -- the bench: the ★ arm, the
// node the first two edges share, over 2000 random stars of 100 nodes
// built once, 20000000 calls.

fn find_center(edges: Vec[Vec[i32]]) -> i32 {
    let (a, b) = (edges[0][0], edges[0][1]);
    if a == edges[1][0] or a == edges[1][1] { a } else { b }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1791;
    let mut stars: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..2000 {
        let center = 1 + next_random(mut seed) % 100;
        let mut edges: Vec[Vec[i32]] = Vec.new();
        for leaf in 1..101 {
            if leaf == center {
                continue;
            }
            if next_random(mut seed) % 2 == 0 {
                edges.push([center as i32, leaf as i32].to_vec());
            } else {
                edges.push([leaf as i32, center as i32].to_vec());
            }
        }
        for i in (1..edges.len()).rev() {
            let j = next_random(mut seed) % (i + 1);
            edges.swap(i, j);
        }
        stars.push(edges);
    }
    let mut check = 0;
    for call in 0..20000000 {
        let edges = ref stars[(check + call) % 2000];
        check = (check * 41 + find_center(edges)) % 1000000007;
    }
    println(f"20000000 calls over 2000 stars: checksum {check}");
}
