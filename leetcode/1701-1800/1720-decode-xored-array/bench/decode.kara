// LeetCode #1720: Decode XORed Array -- the bench (decode.kara): each
// value the one before it XORed with the code between them.
//
// 200 arrays of 10^4 codes up to 10^5, LeetCode's largest, all drawn
// first, then each decoded 100 times.

fn decode(encoded: Vec[i32], first: i32) -> Vec[i32] {
    let mut arr: Vec[i32] = Vec.with_capacity(encoded.len() + 1);
    arr.push(first);
    for e in encoded.iter() {
        arr.push(arr[arr.len() - 1] ^ e);
    }
    arr
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 200;
    let rounds = 100;
    let n = 10000;
    let mut seed = 1720;
    let mut problems: Vec[(Vec[i32], i32)] = Vec.new();
    for _ in 0..count {
        let encoded: Vec[i32] = (0..n).map(|_| (wide(mut seed) % 100001) as i32).collect();
        let first = (wide(mut seed) % 100001) as i32;
        problems.push((encoded, first));
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (encoded, first) in problems.iter() {
            let arr = decode(encoded, first);
            sum += arr[n];
            check = (check * 31 + arr[n / 2] + arr[n] + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {n} codes, {rounds} rounds: last values sum to {sum}, checksum {check}");
}
