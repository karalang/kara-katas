// LeetCode #1720: Decode XORed Array -- the differential.
//
// Four arms against the statement read literally, on 3000 random arrays
// of 1 to 10 codes from 0 to 15 and a first value from 0 to 15.
//
// P1  the answer is the statement read literally
// P2  the answer starts with the first value and encodes to the codes
// P3  the first value XORed with a mask gives every value XORed with it
// P4  the codes reversed, from the answer's last value, give the answer
//     reversed
// P5  each arm agrees with at least two of the other three

// ---- decode.kara: the ★ arm: each value the one before XORed with the code

fn star_arm(encoded: Vec[i32], first: i32) -> Vec[i32] {
    let mut arr: Vec[i32] = Vec.with_capacity(encoded.len() + 1);
    arr.push(first);
    for e in encoded.iter() {
        arr.push(arr[arr.len() - 1] ^ e);
    }
    arr
}

// ---- decode_scan.kara: the values as a scan over the codes

fn scan_arm(encoded: Vec[i32], first: i32) -> Vec[i32] {
    once(first).chain(encoded.iter().scan(first, |last, e| Some((last ^ e, last ^ e)))).collect()
}

// ---- decode_prefix.kara: a running XOR in place, then the first value

fn prefix_arm(encoded: Vec[i32], first: i32) -> Vec[i32] {
    let n = encoded.len();
    let mut arr: Vec[i32] = Vec.filled(n + 1, 0);
    for i in 0..n {
        arr[i + 1] = arr[i] ^ encoded[i];
    }
    for v in arr.iter_mut() {
        *v ^= first;
    }
    arr
}

// ---- decode_solution.kara: LeetCode's Rust template, through karac fix

struct Solution {}

impl Solution {
    pub fn decode(encoded: Vec[i32], first: i32) -> Vec[i32] {
        once(first)
            .chain(encoded.iter().scan(first, |acc, e| { let acc = acc ^ e; Some((acc, acc)) }))
            .collect()
    }
}

fn solution_arm(encoded: Vec[i32], first: i32) -> Vec[i32] {
    Solution.decode(encoded, first)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: `arr[0]` is `first`, and each next value
// is the one value from 0 to 15 whose XOR with the one before it is the
// code between them
fn literal(encoded: Slice[i32], first: i32) -> Vec[i32] {
    let mut arr: Vec[i32] = [first];
    for i in 0..encoded.len() {
        let next = (0i32..16).find(|v| arr[i] ^ v == encoded[i]).unwrap();
        arr.push(next);
    }
    arr
}

fn arm(a: i64, encoded: Slice[i32], first: i32) -> Vec[i32] {
    let encoded = encoded.to_vec();
    match a {
        0 => star_arm(encoded, first),
        1 => scan_arm(encoded, first),
        2 => prefix_arm(encoded, first),
        _ => solution_arm(encoded, first),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "scan", "prefix", "solution"][a]
}

fn main() {
    let mut seed = 1720;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(Vec[i32], i32)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 10 + 1;
        let encoded: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 16) as i32).collect();
        let first = (next_random(mut seed) % 16) as i32;
        cases.push((encoded, first));
    }
    for (p, (encoded, first)) in cases.iter().enumerate() {
        let want = literal(encoded, first);
        for v in want.iter() {
            check = (check * 31 + v) % 1000000007;
        }
        check = (check * 31 + encoded.len()) % 1000000007;
        let mask = (p % 16) as i32;
        let reversed: Vec[i32] = encoded.iter().rev().cloned().collect();
        let mut answers: Vec[Vec[i32]] = Vec.new();
        for a in 0..4 {
            let got = arm(a, encoded, first);
            let encodes = got.len() == encoded.len() + 1 and got[0] == first and (0..encoded.len()).all(|i| got[i] ^ got[i + 1] == encoded[i]);
            let masked: Vec[i32] = got.iter().map(|v| v ^ mask).collect();
            let back: Vec[i32] = got.iter().rev().cloned().collect();
            let failed = [got != want, not encodes, arm(a, encoded, first ^ mask) != masked, arm(a, reversed, got[got.len() - 1]) != back];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({encoded}, first {first}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
