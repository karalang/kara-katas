// LeetCode #1720: Decode XORed Array -- each value from the first and a
// running XOR of the codes, written in place.
//
// XOR is associative, so `arr[i]` is `first` XORed with every code before
// it. The codes' running XOR is written over a copy of them, one place to
// the right, and each place then XORed with the first value: the array is
// filled once, with no pushes. O(n).

fn decode(encoded: Vec[i32], first: i32) -> Vec[i32] {
    let n = encoded.len();
    let mut arr: Vec[i32] = Vec.filled(n + 1, 0);
    for i in 0..n {
        arr[i + 1] = arr[i] ^ encoded[i];
    }
    for v in arr.iter_mut() {
        *v ^= first;
    }
    arr
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `count` random arrays of 1 to `most` codes from 0 to `top`, and a first
// value from 0 to `top`
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let encoded: Vec[i32] = (0..n).map(|_| (wide(mut seed) % (top + 1)) as i32).collect();
        let first = (wide(mut seed) % (top + 1)) as i32;
        for v in decode(encoded, first).iter() {
            sum += v;
            check = (check * 31 + v) % 1000000007;
        }
        check = (check * 31 + n) % 1000000007;
    }
    println(f"{count} arrays of up to {most} codes up to {top}: values sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one code, a code of 0, and the largest
    // values
    println(decode([1, 2, 3], 1));
    println(decode([6, 2, 7, 3], 4));
    println(decode([5], 0));
    println(decode([0, 0], 7));
    println(decode([100000, 1, 100000], 100000));
    let mut seed = 1720;
    batch(3000, 12, 15, mut seed);
    batch(300, 1000, 100000, mut seed);
    batch(10, 10000, 100000, mut seed);
}
