// LeetCode #1771: Maximize Palindrome Length From Subsequences -- the
// bench: the ★ arm, the longest palindromic subsequence of every stretch of
// the two words joined.

fn longest_palindrome(word1: String, word2: String) -> i32 {
    let joined = f"{word1}{word2}";
    let s = joined.bytes();
    let n = s.len();
    let split = word1.len();
    let mut dp: Vec[Vec[i32]] = Vec.filled(n, Vec.filled(n, 0));
    let mut best: i32 = 0;
    for i in (0..n).rev() {
        dp[i][i] = 1;
        for j in i + 1..n {
            if s[i] == s[j] {
                dp[i][j] = dp[i + 1][j - 1] + 2;
                if i < split and j >= split {
                    best = best.max(dp[i][j]);
                }
            } else {
                dp[i][j] = dp[i + 1][j].max(dp[i][j - 1]);
            }
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1771;
    let mut words: Vec[String] = Vec.new();
    for _ in 0..100 {
        let letters = 2 + next_random(mut seed) % 25;
        let mut s = String.new();
        for _ in 0..1000 {
            s.push(char.try_from((97 + next_random(mut seed) % letters) as u32).ok().unwrap());
        }
        words.push(s);
    }
    let mut check = 0;
    for call in 0..40 {
        let a = (check + call * 7919) % 100;
        let b = (check / 100 + call * 31 + 1) % 100;
        check = (check * 31 + longest_palindrome(words[a], words[b])) % 1000000007;
    }
    println(f"40 calls over 100 words: checksum {check}");
}
