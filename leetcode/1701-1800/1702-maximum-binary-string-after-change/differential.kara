// LeetCode #1702: Maximum Binary String After Change -- the differential.
//
// Four arms against the statement read literally, on 3000 random binary
// strings of 1 to 10 digits, each a 1 with a chance of its string's own.
//
// P1  the answer is the statement read literally
// P2  the answer is as long, has one 0 if the string has any and none if
//     not, and keeps at least the string's leading 1s
// P3  a 1 put in front gives a 1 and then the same answer
// P4  a 0 put at the end gives a 1 and then the same answer, or the
//     string and the 0 if it had no 0
// P5  each arm agrees with at least two of the other three

// ---- binary.kara: the ★ arm: one 0 left, at the first 0 plus the zeros less one

fn star_arm(binary: own String) -> String {
    let digits = binary.bytes();
    let mut first = -1;
    let mut zeros = 0;
    for (i, b) in digits.iter().enumerate() {
        if b == b'0' {
            if first < 0 {
                first = i;
            }
            zeros += 1;
        }
    }
    if zeros == 0 {
        return binary;
    }
    let mut out = String.with_capacity(digits.len());
    for i in 0..digits.len() {
        out.push(if i == first + zeros - 1 { '0' } else { '1' });
    }
    out
}

// ---- binary_greedy.kara: the moves made one at a time, from the left

fn greedy_arm(binary: String) -> String {
    let mut digits: Vec[u8] = binary.bytes().to_vec();
    let n = digits.len();
    let mut j = 0;
    for i in 0..n {
        if digits[i] == b'1' {
            continue;
        }
        j = max(j, i + 1);
        while j < n and digits[j] == b'1' {
            j += 1;
        }
        if j == n {
            break;
        }
        digits[j] = b'1';
        digits[i] = b'1';
        digits[i + 1] = b'0';
    }
    String.from_utf8(digits).unwrap()
}

// ---- binary_iter.kara: the first 0 and the zeros by iterators, the answer collected

fn iter_arm(binary: own String) -> String {
    let Some(first) = binary.chars().position(|c| c == '0') else {
        return binary;
    };
    let zeros = binary.chars().filter(|c| c == '0').count();
    (0..binary.len()).map(|i| if i == first + zeros - 1 { '0' } else { '1' }).collect()
}

// ---- binary_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn maximum_binary_string(binary: String) -> String {
        let mut s = binary.bytes().to_vec();
        if let Some(first) = s.iter().position(|c| c == b'0') {
            let zeros = s[first..].iter().filter(|c| c == b'0').count();
            for c in s.iter_mut() {
                *c = b'1';
            }
            s[first + zeros - 1] = b'0';
        }
        String.from_utf8(s).unwrap()
    }
}

fn solution_arm(binary: String) -> String {
    SolutionArm.maximum_binary_string(binary)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every string the two moves can reach,
// "00" -> "10" and "10" -> "01" anywhere, any number of times, found by a
// search from the given one; the largest of them, as a number (all are
// the same length, so as a string)
fn literal(binary: String) -> String {
    let mut seen: SortedSet[String] = SortedSet.new();
    let mut todo: Vec[String] = [binary.clone()];
    seen.insert(binary.clone());
    while let Some(s) = todo.pop() {
        let b = s.bytes();
        for i in 0..b.len() - 1 {
            let mut next = b.to_vec();
            if b[i] == b'0' and b[i + 1] == b'0' {
                next[i] = b'1';
            } else if b[i] == b'1' and b[i + 1] == b'0' {
                next[i] = b'0';
                next[i + 1] = b'1';
            } else {
                continue;
            }
            let t = String.from_utf8(next).unwrap();
            if not seen.contains(t) {
                seen.insert(t.clone());
                todo.push(t);
            }
        }
    }
    seen.iter().max().unwrap().clone()
}

fn arm(a: i64, binary: String) -> String {
    let binary = binary.clone();
    match a {
        0 => star_arm(binary),
        1 => greedy_arm(binary),
        2 => iter_arm(binary),
        _ => solution_arm(binary),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "greedy", "iter", "solution"][a]
}

fn main() {
    let mut seed = 1702;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[String] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 10 + 1;
        let lean = next_random(mut seed) % 11;
        let mut binary = String.new();
        for _ in 0..n {
            binary.push(if next_random(mut seed) % 10 < lean { '1' } else { '0' });
        }
        cases.push(binary);
    }
    for (p, binary) in cases.iter().enumerate() {
        let want = literal(binary);
        for b in want.bytes().iter() {
            check = (check * 31 + b) % 1000000007;
        }
        check = (check * 31 + binary.len()) % 1000000007;
        let has_zero = binary.contains("0");
        let lead = binary.bytes().iter().take_while(|b| b == b'1').count();
        let mut answers: Vec[String] = Vec.new();
        for a in 0..4 {
            let got = arm(a, binary);
            let shape = got.len() == binary.len()
                and got.bytes().iter().filter(|b| b == b'0').count() == (if has_zero { 1 } else { 0 })
                and got.bytes().iter().take_while(|b| b == b'1').count() >= lead;
            let one_first = arm(a, f"1{binary}") == f"1{got}";
            let zero_last = arm(a, f"{binary}0") == (if has_zero { f"1{got}" } else { f"{binary}0" });
            let failed = [got != want, not shape, not one_first, not zero_last];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({binary}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
