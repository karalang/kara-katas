// LeetCode #1702: Maximum Binary String After Change -- the bench: the ★
// arm on 50 random strings of 100000 digits, LeetCode's longest, all
// drawn first, each answered 40 times.
//
// One 0 is left, at the first 0 plus the count of zeros, less one; the
// answer is built a digit at a time. O(n).

fn maximum_binary_string(binary: String) -> String {
    let digits = binary.bytes();
    let mut first = -1;
    let mut zeros = 0;
    for (i, b) in digits.iter().enumerate() {
        if b == b'0' {
            if first < 0 {
                first = i;
            }
            zeros += 1;
        }
    }
    if zeros == 0 {
        return binary.clone();
    }
    let mut out = String.with_capacity(digits.len());
    for i in 0..digits.len() {
        out.push(if i == first + zeros - 1 { '0' } else { '1' });
    }
    out
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 50;
    let rounds = 40;
    let n = 100000;
    let mut seed = 1702;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..count {
        // each digit a 1 with a chance of its string's own, 0 to 10 in 10
        let lean = next_random(mut seed) % 11;
        let mut binary = String.with_capacity(n);
        for _ in 0..n {
            binary.push(if next_random(mut seed) % 10 < lean { '1' } else { '0' });
        }
        strings.push(binary);
    }
    let mut ones = 0;
    let mut check = 0;
    for _ in 0..rounds {
        for binary in strings.iter() {
            let answer = maximum_binary_string(binary);
            let digits = answer.bytes();
            // the 0's place, or the length when none is left
            let zero = digits.iter().position(|b| b == b'0').unwrap_or(digits.len());
            ones += digits.len() - (if zero < digits.len() { 1 } else { 0 });
            check = (check * 31 + digits[check % digits.len()] + zero) % 1000000007;
        }
    }
    println(f"{count} strings of {n} digits, {rounds} rounds: {ones} ones, checksum {check}");
}
