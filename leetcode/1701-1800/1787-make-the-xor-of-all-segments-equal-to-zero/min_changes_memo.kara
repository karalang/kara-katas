// LeetCode #1787: Make the XOR of All Segments Equal to Zero -- the DP read
// top down: the fewest changes that make groups g to k - 1 XOR to x, a
// memo of k rows by 1024, each row's least value kept once the row is
// filled. Recursion from group 0 and an XOR of 0.

fn group_counts(nums: Vec[i32], k: i32, g: i32) -> Map[i32, i32] {
    let mut count: Map[i32, i32] = Map.new();
    let mut i = g as i64;
    while i < nums.len() {
        count[nums[i]] = count.get(nums[i]).unwrap_or(0) + 1;
        i += k;
    }
    count
}

fn fewest(g: i32, x: i32, k: i32, counts: Vec[Map[i32, i32]], sizes: Vec[i32], memo: mut ref Vec[Vec[i32]], row_low: mut ref Vec[i32]) -> i32 {
    if g == k {
        return if x == 0 { 0 } else { 1000000 };
    }
    if memo[g][x] >= 0 {
        return memo[g][x];
    }
    if row_low[g + 1] < 0 {
        let mut low: i32 = 1000000;
        for y in 0..1024 {
            low = low.min(fewest(g + 1, y, k, counts, sizes, mut memo, mut row_low));
        }
        row_low[g + 1] = low;
    }
    let mut answer = row_low[g + 1] + sizes[g];
    for (v, c) in counts[g].iter() {
        answer = answer.min(fewest(g + 1, x ^ v, k, counts, sizes, mut memo, mut row_low) + sizes[g] - c);
    }
    memo[g][x] = answer;
    answer
}

fn min_changes(nums: Vec[i32], k: i32) -> i32 {
    let mut counts: Vec[Map[i32, i32]] = Vec.new();
    let mut sizes: Vec[i32] = Vec.new();
    for g in 0..k {
        let count = group_counts(nums, k, g);
        sizes.push(count.values().sum());
        counts.push(count);
    }
    let mut memo: Vec[Vec[i32]] = Vec.filled(k, Vec.filled(1024, -1));
    let mut row_low: Vec[i32] = Vec.filled(k + 1, -1);
    // the last row's least value is 0 at an XOR of 0
    row_low[k] = 0;
    fewest(0, 0, k, counts, sizes, mut memo, mut row_low)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n numbers below `most`
fn random_nums(seed: mut ref i64, n: i64, most: i64) -> Vec[i32] {
    (0..n).map(|_| (next_random(mut seed) % most) as i32).collect()
}

fn main() {
    // LeetCode's three examples
    println(f"{min_changes([1, 2, 0, 3, 0], 1)} {min_changes([3, 4, 5, 2, 1, 7, 3, 4, 7], 3)} {min_changes([1, 2, 4, 1, 2, 5, 1, 2, 6], 3)}");
    // the edges: one number, zero and not; k the whole length, its XOR
    // already 0 and not; a repeating pattern that already works; every
    // number the same, k even and odd
    println(f"{min_changes([0], 1)} {min_changes([5], 1)} {min_changes([1, 2, 3], 3)} {min_changes([1, 2, 4], 3)} {min_changes([1, 2, 3, 1, 2, 3, 1], 3)} {min_changes([7, 7, 7, 7], 2)} {min_changes([7, 7, 7, 7], 3)}");
    // the constraints' most: 2000 numbers below 1024 with k of 1, 7, 1000
    // and 2000
    let mut seed = 1787;
    let wide = random_nums(mut seed, 2000, 1024);
    println(f"the most: {min_changes(wide, 1)} {min_changes(wide, 7)} {min_changes(wide, 1000)} {min_changes(wide, 2000)}");
    // 1500 random cases of 1 to 24 numbers below 2 to 32, k from 1 to the
    // length; a quarter built from a pattern of k numbers, a few changed
    let mut check = 0;
    for c in 0..1500 {
        let n = 1 + next_random(mut seed) % 24;
        let k = 1 + next_random(mut seed) % n;
        let most = 2 + next_random(mut seed) % 31;
        let mut nums = random_nums(mut seed, n, most);
        if c % 4 == 0 {
            for i in k..n {
                nums[i] = nums[i - k];
            }
            let changed = next_random(mut seed) % 3;
            for _ in 0..changed {
                let at = next_random(mut seed) % n;
                nums[at] = (next_random(mut seed) % most) as i32;
            }
        }
        check = (check * 31 + min_changes(nums, k as i32)) % 1000000007;
    }
    println(f"1500 random cases: checksum {check}");
}
