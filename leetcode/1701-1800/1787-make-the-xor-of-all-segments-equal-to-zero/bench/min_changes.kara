// LeetCode #1787: Make the XOR of All Segments Equal to Zero -- the bench:
// the ★ arm, a DP over the k groups of positions, over 100 lists of 600
// numbers below 1024 built once, 300 calls with k from 1 to 600.

fn min_changes(nums: Vec[i32], k: i32) -> i32 {
    let mut best: Vec[i32] = Vec.filled(1024, i32.MAX / 2);
    best[0] = 0;
    for g in 0..k {
        let mut count: Map[i32, i32] = Map.new();
        let mut size: i32 = 0;
        let mut i = g;
        while i < nums.len() {
            count[nums[i]] = count.get(nums[i]).unwrap_or(0) + 1;
            size += 1;
            i += k;
        }
        let floor = best.iter().min().unwrap() + size;
        let mut next: Vec[i32] = Vec.filled(1024, floor);
        for x in 0..1024 {
            for (v, c) in count.iter() {
                let here = best[x ^ v] + size - c;
                if here < next[x] {
                    next[x] = here;
                }
            }
        }
        best = next;
    }
    best[0]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1787;
    let mut lists: Vec[Vec[i32]] = Vec.new();
    for _ in 0..100 {
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..600 {
            nums.push((next_random(mut seed) % 1024) as i32);
        }
        lists.push(nums);
    }
    let mut check = 0;
    for call in 0..300 {
        let nums = ref lists[(check + call) % 100];
        let k = 1 + (check * 7 + call) % 600;
        check = (check * 31 + min_changes(nums, k as i32)) % 1000000007;
    }
    println(f"300 calls over 100 lists: checksum {check}");
}
