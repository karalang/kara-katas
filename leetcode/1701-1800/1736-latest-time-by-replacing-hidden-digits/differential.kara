// LeetCode #1736: Latest Time by Replacing Hidden Digits -- the
// differential.
//
// Four arms against the statement read literally, on 3000 random valid
// times with each digit hidden with a chance of 1 in 2.
//
// P1  the answer is the statement read literally
// P2  the answer is a valid time that keeps every shown digit
// P3  one more digit hidden never gives an earlier time
// P4  the answer with the same digits hidden gives the answer again
// P5  each arm agrees with at least two of the other three

// ---- time.kara: the ★ arm: each hidden digit the largest allowed

fn star_arm(time: Str) -> String {
    let mut t: Vec[char] = time.chars().collect();
    if t[0] == '?' {
        t[0] = if t[1] == '?' or t[1] <= '3' { '2' } else { '1' };
    }
    if t[1] == '?' {
        t[1] = if t[0] == '2' { '3' } else { '9' };
    }
    if t[3] == '?' {
        t[3] = '5';
    }
    if t[4] == '?' {
        t[4] = '9';
    }
    t.iter().collect()
}

// ---- time_search.kara: every time of day tried, latest first

fn search_arm(time: Str) -> String {
    let pattern: Vec[char] = time.chars().collect();
    for t in (0..1440).rev() {
        let candidate = f"{t / 60 / 10}{t / 60 % 10}:{t % 60 / 10}{t % 60 % 10}";
        if candidate.chars().zip(pattern.iter()).all(|(c, p)| p == '?' or p == c) {
            return candidate;
        }
    }
    String.new()
}

// ---- time_split.kara: the latest hour and minute found apart

fn split_fits(pair: Str, value: i64) -> bool {
    let digits = [value / 10, value % 10];
    pair.chars().enumerate().all(|(i, c)| c == '?' or c as i64 - '0' as i64 == digits[i])
}

fn split_arm(time: Str) -> String {
    let hour = (0..24).rev().find(|h| split_fits(time[0..2], h)).unwrap();
    let minute = (0..60).rev().find(|m| split_fits(time[3..5], m)).unwrap();
    f"{hour / 10}{hour % 10}:{minute / 10}{minute % 10}"
}

// ---- time_solution.kara: LeetCode's Rust template, through karac fix

struct Solution {}

impl Solution {
    pub fn maximum_time(time: String) -> String {
        let mut t = time.bytes().to_vec();
        if t[0] == b'?' {
            t[0] = if t[1] == b'?' or t[1] <= b'3' { b'2' } else { b'1' };
        }
        if t[1] == b'?' {
            t[1] = if t[0] == b'2' { b'3' } else { b'9' };
        }
        if t[3] == b'?' {
            t[3] = b'5';
        }
        if t[4] == b'?' {
            t[4] = b'9';
        }
        String.from_utf8(t).unwrap()
    }
}

fn solution_arm(time: Str) -> String {
    Solution.maximum_time(time.to_string())
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every way to put a digit from 0 to 9 in
// each hidden place, kept when it is a valid time from 00:00 to 23:59,
// and the latest of them
fn literal(time: Str) -> String {
    let hidden: Vec[i64] = (0..5).filter(|i| time.chars().nth(i).unwrap() == '?').collect();
    let mut best = String.new();
    let mut ways = 1;
    for _ in hidden.iter() {
        ways *= 10;
    }
    for w in 0..ways {
        let mut t: Vec[char] = time.chars().collect();
        let mut rest = w;
        for i in hidden.iter() {
            t[i] = char.from_digit((rest % 10) as u32, 10).unwrap();
            rest /= 10;
        }
        let candidate: String = t.iter().collect();
        let hour = (t[0] as i64 - '0' as i64) * 10 + t[1] as i64 - '0' as i64;
        let minute = (t[3] as i64 - '0' as i64) * 10 + t[4] as i64 - '0' as i64;
        if hour < 24 and minute < 60 and candidate > best {
            best = candidate;
        }
    }
    best
}

fn arm(a: i64, time: Str) -> String {
    match a {
        0 => star_arm(time),
        1 => search_arm(time),
        2 => split_arm(time),
        _ => solution_arm(time),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "search", "split", "solution"][a]
}

// `time` with each place `hide` marks replaced by `?`
fn hidden_as(time: Str, hide: Slice[bool]) -> String {
    time.chars().enumerate().map(|(i, c)| if hide[i] { '?' } else { c }).collect()
}

fn main() {
    let mut seed = 1736;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(String, i64)] = Vec.new();
    for _ in 0..problems {
        let t = next_random(mut seed) % 1440;
        let shown = f"{t / 60 / 10}{t / 60 % 10}:{t % 60 / 10}{t % 60 % 10}";
        let hide: Vec[bool] = (0..5).map(|i| i != 2 and next_random(mut seed) % 2 == 0).collect();
        // one more place to hide for P3, a digit's place
        let more = [0, 1, 3, 4][next_random(mut seed) % 4];
        cases.push((hidden_as(shown, hide), more));
    }
    for (p, (time, more)) in cases.iter().enumerate() {
        let want = literal(time);
        for c in want.chars() {
            check = (check * 31 + c as i64) % 1000000007;
        }
        let hide: Vec[bool] = time.chars().map(|c| c == '?').collect();
        let mut further = hide.clone();
        further[more] = true;
        let mut answers: Vec[String] = Vec.new();
        for a in 0..4 {
            let got = arm(a, time);
            let g: Vec[char] = got.chars().collect();
            let valid = g.len() == 5 and g[2] == ':' and got[0..2] <= "23" and got[3..5] <= "59" and time.chars().zip(g.iter()).all(|(c, d)| c == '?' or c == d);
            let failed = [got != want, not valid, arm(a, hidden_as(time, further)) < got, arm(a, hidden_as(got, hide)) != got];
            answers.push(got);
            for t in 0..4 {
                checks += 1;
                if failed[t] {
                    failures += 1;
                    by_property[t + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({time}), {arm_name(a)}: P{t + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for t in 1..6 {
            if by_property[t] > 0 {
                counts.push(f"P{t}: {by_property[t]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
