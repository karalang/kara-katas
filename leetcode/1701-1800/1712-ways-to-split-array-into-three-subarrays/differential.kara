// LeetCode #1712: Ways to Split Array Into Three Subarrays -- the
// differential.
//
// Four arms against the statement read literally, on 3000 random arrays
// of 3 to 10 values, each from 0 to a random bound from 0 to 5.
//
// P1  the answer is the statement read literally
// P2  every value doubled gives the same answer
// P3  a value above the total put at the end makes good every cut whose
//     left part is at most its middle
// P4  a value above the total put in front leaves no good cut
// P5  each arm agrees with at least two of the other three

// ---- split.kara: the ★ arm: two binary searches for each end of the left part

fn star_arm(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut prefix: Vec[i64] = [0];
    for x in nums.iter() {
        prefix.push(prefix[prefix.len() - 1] + x);
    }
    let total = prefix[n];
    let mut ways = 0;
    for i in 1..n - 1 {
        let left = prefix[i];
        let lo = max(prefix.partition_point(|p| p < 2 * left), i + 1);
        let hi = min(prefix.partition_point(|p| 2 * p <= total + left), n);
        if hi > lo {
            ways += hi - lo;
        }
    }
    (ways % 1000000007) as i32
}

// ---- split_pointers.kara: two pointers over the ends of the middle

fn pointers_arm(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    let total = prefix[n];
    let mut ways = 0;
    let mut lo = 0;
    let mut hi = 0;
    for i in 1..n - 1 {
        let left = prefix[i];
        if 3 * left > total {
            break;
        }
        lo = max(lo, i + 1);
        while lo < n and prefix[lo] - left < left {
            lo += 1;
        }
        hi = max(hi, lo);
        while hi < n and prefix[hi] - left <= total - prefix[hi] {
            hi += 1;
        }
        ways += hi - lo;
    }
    (ways % 1000000007) as i32
}

// ---- split_mid.kara: counted from the end of the middle

fn mid_arm(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    let total = prefix[n];
    let mut ways = 0;
    // the first i that leaves the right no smaller than the middle, and
    // the first past those that keep the left no larger than it
    let mut first = 1;
    let mut past = 1;
    for j in 2..n {
        while first < j and prefix[j] - prefix[first] > total - prefix[j] {
            first += 1;
        }
        while past < j and 2 * prefix[past] <= prefix[j] {
            past += 1;
        }
        if past > first {
            ways += past - first;
        }
    }
    (ways % 1000000007) as i32
}

// ---- split_solution.kara: LeetCode's Rust template, through karac fix

struct Solution {}

impl Solution {
    pub fn ways_to_split(nums: Vec[i32]) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let n = nums.len();
        let mut prefix = Vec.filled(n + 1, 0);
        for i in 0..n {
            prefix[i + 1] = prefix[i] + nums[i];
        }
        let total = prefix[n];
        let mut ans: i64 = 0;
        for i in 1..n - 1 {
            if prefix[i] * 3 > total {
                break;
            }
            let lo = prefix.partition_point(|x| x < 2 * prefix[i]).max(i + 1);
            let hi = prefix.partition_point(|x| x <= (total + prefix[i]) / 2).min(n);
            if hi > lo {
                ans += (hi - lo);
            }
        }
        (ans % MOD) as i32
    }
}

fn solution_arm(nums: Vec[i32]) -> i32 {
    Solution.ways_to_split(nums)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every cut into three non-empty runs, left
// ending before i and the middle before j, each run summed afresh; the
// good ones counted modulo 10^9 + 7
fn literal(nums: Slice[i32]) -> i64 {
    let n = nums.len();
    let mut ways = 0;
    for i in 1..n {
        for j in i + 1..n {
            let left: i64 = nums[0..i].iter().sum();
            let mid: i64 = nums[i..j].iter().sum();
            let right: i64 = nums[j..n].iter().sum();
            if left <= mid and mid <= right {
                ways += 1;
            }
        }
    }
    ways % 1000000007
}

// the cuts whose left part is at most its middle, with the right part
// anything non-empty
fn left_at_most_mid(nums: Slice[i32]) -> i64 {
    let n = nums.len();
    let mut ways = 0;
    for i in 1..n {
        for j in i + 1..n {
            let left: i64 = nums[0..i].iter().sum();
            let mid: i64 = nums[i..j].iter().sum();
            if left <= mid {
                ways += 1;
            }
        }
    }
    ways
}

fn arm(a: i64, nums: Slice[i32]) -> i64 {
    let nums = nums.to_vec();
    match a {
        0 => star_arm(nums),
        1 => pointers_arm(nums),
        2 => mid_arm(nums),
        _ => solution_arm(nums),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "pointers", "mid", "solution"][a]
}

fn main() {
    let mut seed = 1712;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[Vec[i32]] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 8 + 3;
        let top = next_random(mut seed) % 6;
        cases.push((0..n).map(|_| (next_random(mut seed) % (top + 1)) as i32).collect());
    }
    for (p, nums) in cases.iter().enumerate() {
        let want = literal(nums);
        check = (check * 31 + want + nums.len()) % 1000000007;
        let total: i64 = nums.iter().sum();
        let doubled: Vec[i32] = nums.iter().map(|x| x * 2).collect();
        let mut heavy_back: Vec[i32] = nums.clone();
        heavy_back.push((total + 1) as i32);
        let heavy_front_cuts = left_at_most_mid(heavy_back);
        let mut heavy_front: Vec[i32] = [(total + 1) as i32];
        heavy_front.extend(nums.iter());
        let mut answers: Vec[i64] = Vec.new();
        for a in 0..4 {
            let got = arm(a, nums);
            let failed = [got != want, arm(a, doubled) != got, arm(a, heavy_back) != heavy_front_cuts, arm(a, heavy_front) != 0];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({nums}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
