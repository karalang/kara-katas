// LeetCode #1712: Ways to Split Array Into Three Subarrays -- the ★ arm:
// prefix sums, and for each end of the left part the range of ends of the
// middle found by two binary searches.
//
// The values are not negative, so the prefix sums never fall. With the
// left part ending at i and the middle at j, i < j < n, the left is at
// most the middle when prefix[j] >= 2 prefix[i], and the middle at most
// the right when 2 prefix[j] <= total + prefix[i]: the good j run from
// the first that passes one bound to the last within the other, and
// `partition_point` finds both. O(n log n).

fn ways_to_split(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut prefix: Vec[i64] = [0];
    for x in nums.iter() {
        prefix.push(prefix[prefix.len() - 1] + x);
    }
    let total = prefix[n];
    let mut ways = 0;
    for i in 1..n - 1 {
        let left = prefix[i];
        let lo = max(prefix.partition_point(|p| p < 2 * left), i + 1);
        let hi = min(prefix.partition_point(|p| 2 * p <= total + left), n);
        if hi > lo {
            ways += hi - lo;
        }
    }
    (ways % 1000000007) as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random arrays of 3 to `most` values, each 0 to `top`; the
// answers summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most - 2) + 3;
        let nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % (top + 1)) as i32).collect();
        let answer = ways_to_split(nums) as i64;
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} arrays of up to {most} values up to {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then all zeros, and the largest array
    // of the largest values
    println(ways_to_split([1, 1, 1]));
    println(ways_to_split([1, 2, 2, 2, 5, 0]));
    println(ways_to_split([3, 2, 1]));
    println(ways_to_split([0, 0, 0, 0, 0]));
    println(ways_to_split(Vec.filled(100000, 10000)));
    let mut seed = 1712;
    batch(3000, 12, 4, mut seed);
    batch(300, 1000, 10000, mut seed);
    batch(10, 100000, 3, mut seed);
}
