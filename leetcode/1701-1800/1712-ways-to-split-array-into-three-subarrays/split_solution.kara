// LeetCode #1712: Ways to Split Array Into Three Subarrays -- a Rust
// solution as LeetCode's Rust users write it: `vec![0; n + 1]` prefix
// sums, `partition_point(|&x| x < 2 * prefix[i])` clamped with `.max(i +
// 1)` and `.min(n)`, and `(hi - lo) as i64`.

struct Solution {}

impl Solution {
    pub fn ways_to_split(nums: Vec[i32]) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let n = nums.len();
        let mut prefix = Vec.filled(n + 1, 0);
        for i in 0..n {
            prefix[i + 1] = prefix[i] + nums[i];
        }
        let total = prefix[n];
        let mut ans: i64 = 0;
        for i in 1..n - 1 {
            if prefix[i] * 3 > total {
                break;
            }
            let lo = prefix.partition_point(|x| x < 2 * prefix[i]).max(i + 1);
            let hi = prefix.partition_point(|x| x <= (total + prefix[i]) / 2).min(n);
            if hi > lo {
                ans += hi - lo;
            }
        }
        (ans % MOD) as i32
    }
}

fn ways_to_split(nums: Vec[i32]) -> i32 {
    Solution.ways_to_split(nums)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random arrays of 3 to `most` values, each 0 to `top`; the
// answers summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (most - 2) + 3;
        let nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % (top + 1)) as i32).collect();
        let answer = ways_to_split(nums) as i64;
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} arrays of up to {most} values up to {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then all zeros, and the largest array
    // of the largest values
    println(ways_to_split([1, 1, 1]));
    println(ways_to_split([1, 2, 2, 2, 5, 0]));
    println(ways_to_split([3, 2, 1]));
    println(ways_to_split([0, 0, 0, 0, 0]));
    println(ways_to_split(Vec.filled(100000, 10000)));
    let mut seed = 1712;
    batch(3000, 12, 4, mut seed);
    batch(300, 1000, 10000, mut seed);
    batch(10, 100000, 3, mut seed);
}
