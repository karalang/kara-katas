// LeetCode #1712: Ways to Split Array Into Three Subarrays -- the bench:
// the ★ arm on 20 random arrays of 100000 values up to 10^4, LeetCode's
// largest, all drawn first, each answered 10 times.
//
// Prefix sums, and for each end of the left part the range of ends of the
// middle found by two binary searches. O(n log n).

fn ways_to_split(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut prefix: Vec[i64] = [0];
    for x in nums.iter() {
        prefix.push(prefix[prefix.len() - 1] + x);
    }
    let total = prefix[n];
    let mut ways = 0;
    for i in 1..n - 1 {
        let left = prefix[i];
        let lo = max(prefix.partition_point(|p| p < 2 * left), i + 1);
        let hi = min(prefix.partition_point(|p| 2 * p <= total + left), n);
        if hi > lo {
            ways += hi - lo;
        }
    }
    (ways % 1000000007) as i32
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 20;
    let rounds = 10;
    let n = 100000;
    let mut seed = 1712;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    for _ in 0..count {
        arrays.push((0..n).map(|_| (next_random(mut seed) % 10001) as i32).collect());
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in arrays.iter() {
            let answer = ways_to_split(nums);
            sum += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {n} values, {rounds} rounds: answers sum to {sum}, checksum {check}");
}
