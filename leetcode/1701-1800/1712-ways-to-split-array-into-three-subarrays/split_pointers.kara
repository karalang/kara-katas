// LeetCode #1712: Ways to Split Array Into Three Subarrays -- two
// pointers over the ends of the middle.
//
// As the left part grows its sum does not fall, so the first end of the
// middle that makes it no smaller than the left, and the end past the
// last that leaves the right no smaller than it, only move right: two
// pointers walk them across the array once. Once the left holds more than
// a third of the total no split is good. O(n).

fn ways_to_split(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    let total = prefix[n];
    let mut ways = 0;
    let mut lo = 0;
    let mut hi = 0;
    for i in 1..n - 1 {
        let left = prefix[i];
        if 3 * left > total {
            break;
        }
        lo = max(lo, i + 1);
        while lo < n and prefix[lo] - left < left {
            lo += 1;
        }
        hi = max(hi, lo);
        while hi < n and prefix[hi] - left <= total - prefix[hi] {
            hi += 1;
        }
        ways += hi - lo;
    }
    (ways % 1000000007) as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random arrays of 3 to `most` values, each 0 to `top`; the
// answers summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most - 2) + 3;
        let nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % (top + 1)) as i32).collect();
        let answer = ways_to_split(nums) as i64;
        sum += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} arrays of up to {most} values up to {top}: answers sum to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then all zeros, and the largest array
    // of the largest values
    println(ways_to_split([1, 1, 1]));
    println(ways_to_split([1, 2, 2, 2, 5, 0]));
    println(ways_to_split([3, 2, 1]));
    println(ways_to_split([0, 0, 0, 0, 0]));
    println(ways_to_split(Vec.filled(100000, 10000)));
    let mut seed = 1712;
    batch(3000, 12, 4, mut seed);
    batch(300, 1000, 10000, mut seed);
    batch(10, 100000, 3, mut seed);
}
