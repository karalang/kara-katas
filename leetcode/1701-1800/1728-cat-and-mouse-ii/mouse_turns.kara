// LeetCode #1728: Cat and Mouse II -- the game played back from the
// thousandth turn.
//
// The statement's limit taken as it stands: after 1000 moves, the
// mouse's and the cat's together, the mouse has lost. Going back a move
// at a time, the table of who wins from each (mouse cell, cat cell) with
// t moves made comes from the table at t + 1: on the mouse's move some
// move must win, on the cat's every move. The tables two moves apart
// soon agree, and from then on every earlier one is the same, so the
// walk back stops there rather than going on to move 0. O(turns cells^2
// (rows + cols)).

// the cells reachable in one move from `at` with jumps up to `jump`:
// staying, or up to `jump` cells in a line, stopped by a wall or the edge
fn reach(marks: Slice[Vec[char]], at: i64, jump: i32) -> Vec[i64] {
    let rows = marks.len();
    let cols = marks[0].len();
    let (r, c) = (at / cols, at % cols);
    let mut cells: Vec[i64] = [at];
    for (dr, dc) in [(0, 1), (1, 0), (0, -1), (-1, 0)] {
        for k in 1..jump as i64 + 1 {
            let (nr, nc) = (r + dr * k, c + dc * k);
            if nr < 0 or nr >= rows or nc < 0 or nc >= cols or marks[nr][nc] == '#' {
                break;
            }
            cells.push(nr * cols + nc);
        }
    }
    cells
}

fn can_mouse_win(grid: Vec[String], cat_jump: i32, mouse_jump: i32) -> bool {
    let marks: Vec[Vec[char]] = grid.iter().map(|row| row.chars().collect()).collect();
    let cols = marks[0].len();
    let cells = marks.len() * cols;
    let find = |mark: char| (0..cells).find(|at| marks[at / cols][at % cols] == mark).unwrap();
    let (mouse, cat, food) = (find('M'), find('C'), find('F'));
    let open: Vec[bool] = (0..cells).map(|at| marks[at / cols][at % cols] != '#').collect();
    let mouse_moves: Vec[Vec[i64]] = (0..cells).map(|at| if open[at] { reach(marks, at, mouse_jump) } else { Vec.new() }).collect();
    let cat_moves: Vec[Vec[i64]] = (0..cells).map(|at| if open[at] { reach(marks, at, cat_jump) } else { Vec.new() }).collect();
    // the state's own end, if it has one: 1 the mouse won, 2 the cat
    let end = |m: i64, c: i64| if m == c or c == food { 2 } else if m == food { 1 } else { 0 };
    let limit = 1000;
    // later[m * cells + c]: whether the mouse wins with t + 1 moves made;
    // after the last move it has lost unless the cells say otherwise
    let mut later: Vec[bool] = Vec.filled(cells * cells, false);
    let mut two_later: Vec[bool] = Vec.new();
    for m in 0..cells {
        for c in 0..cells {
            later[m * cells + c] = end(m, c) == 1;
        }
    }
    let mut t = limit - 1;
    loop {
        let mut now: Vec[bool] = Vec.filled(cells * cells, false);
        for m in 0..cells {
            for c in 0..cells {
                if not open[m] or not open[c] {
                    continue;
                }
                let e = end(m, c);
                now[m * cells + c] = if e != 0 {
                    e == 1
                } else if t % 2 == 0 {
                    mouse_moves[m].iter().any(|to| later[to * cells + c])
                } else {
                    cat_moves[c].iter().all(|to| later[m * cells + to])
                };
            }
        }
        if t == 0 {
            return now[mouse * cells + cat];
        }
        if now == two_later and t % 2 == 0 {
            return now[mouse * cells + cat];
        }
        two_later = later;
        later = now;
        t -= 1;
    }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a grid of `rows` by `cols`, a wall in each cell with a chance of 1 in
// 4, then the cat, the mouse and the food on three different cells
fn draw(rows: i64, cols: i64, seed: mut ref i64) -> Vec[String] {
    let cells = rows * cols;
    let mut marks: Vec[char] = (0..cells).map(|_| if next_random(mut seed) % 4 == 0 { '#' } else { '.' }).collect();
    let mut places: Vec[i64] = (0..cells).collect();
    for i in 0..3 {
        let j = i + next_random(mut seed) % (cells - i);
        places.swap(i, j);
    }
    marks[places[0]] = 'C';
    marks[places[1]] = 'M';
    marks[places[2]] = 'F';
    (0..rows).map(|r| marks[r * cols..(r + 1) * cols].iter().collect()).collect()
}

// `count` grids of 1 to `most` rows and columns, at least three cells,
// and jumps of 1 to `most`
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut wins = 0;
    let mut check = 0;
    for _ in 0..count {
        let mut rows = next_random(mut seed) % most + 1;
        let cols = next_random(mut seed) % most + 1;
        while rows * cols < 3 {
            rows += 1;
        }
        let grid = draw(rows, cols, mut seed);
        let cat_jump = (next_random(mut seed) % most + 1) as i32;
        let mouse_jump = (next_random(mut seed) % most + 1) as i32;
        let answer = can_mouse_win(grid, cat_jump, mouse_jump);
        if answer {
            wins += 1;
        }
        check = (check * 31 + if answer { 2 } else { 1 } + rows * cols) % 1000000007;
    }
    println(f"{count} grids of up to {most} by {most}: the mouse wins {wins}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then a mouse beside the food, and a cat
    // between them in a corridor
    println(can_mouse_win(["####F", "#C...", "M...."], 1, 2));
    println(can_mouse_win(["M.C...F"], 1, 4));
    println(can_mouse_win(["M.C...F"], 1, 3));
    println(can_mouse_win(["MF", "C."], 8, 1));
    println(can_mouse_win(["M.C.F"], 1, 1));
    let mut seed = 1728;
    batch(3000, 3, mut seed);
    batch(300, 5, mut seed);
    batch(20, 8, mut seed);
}
