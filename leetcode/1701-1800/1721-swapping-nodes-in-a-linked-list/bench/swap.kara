// LeetCode #1721: Swapping Nodes in a Linked List -- the bench
// (swap.kara): the kth node found, then a runner from it to the last node
// drags a second cursor from the head to the kth node from the end.
//
// 10 lists of 10^5 nodes, LeetCode's longest, and a k for each list and
// round, all drawn first; each round swaps every list once more in place,
// and the head's value after each swap goes into the checksum.

shared struct ListNode {
    mut val: i64,
    mut next: Option[ListNode],
}

fn swap_nodes(head: Option[ListNode], k: i64) -> Option[ListNode] {
    let mut first = head.unwrap();
    for _ in 1..k {
        first = first.next.unwrap();
    }
    let mut second = head.unwrap();
    let mut runner = first;
    while let Some(next) = runner.next {
        runner = next;
        second = second.next.unwrap();
    }
    let value = first.val;
    first.val = second.val;
    second.val = value;
    head
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn build(values: Slice[i64]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for v in values.iter().rev() {
        head = Some(ListNode { val: v, next: head });
    }
    head
}

fn main() {
    let count = 10;
    let rounds = 100;
    let n = 100000;
    let mut seed = 1721;
    let mut lists: Vec[Option[ListNode]] = Vec.new();
    for _ in 0..count {
        let values: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 101).collect();
        lists.push(build(values));
    }
    let ks: Vec[i64] = (0..count * rounds).map(|_| wide(mut seed) % n + 1).collect();
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for c in 0..count {
            let head = swap_nodes(lists[c], ks[r * count + c]).unwrap();
            sum += head.val;
            check = (check * 31 + head.val + r) % 1000000007;
        }
    }
    println(f"{count} lists of {n} nodes, {rounds} rounds: heads sum to {sum}, checksum {check}");
}
