// LeetCode #1756: Design Most Recently Used Queue -- a Fenwick tree of
// slots.
//
// Every value sits in a slot, the first n slots in order and one more
// slot for each fetch, at the end. A Fenwick tree counts the occupied
// slots; the k-th value is the slot where the count reaches k, found by
// descending the tree's powers of two. A fetch empties that slot and
// fills the next free one at the end. O(log(n + fetches)) per fetch.

struct MruQueue {
    tree: Vec[i32],
    slots: Vec[i32],
    used: i64,
}

impl MruQueue {
    fn new(n: i32) -> MruQueue {
        let capacity = n as i64 + 2001;
        let mut queue = MruQueue { tree: Vec.filled(capacity + 1, 0i32), slots: Vec.filled(capacity + 1, 0i32), used: 0 };
        for v in 1..n + 1 {
            queue.used += 1;
            queue.slots[queue.used] = v;
            queue.add(queue.used, 1);
        }
        queue
    }

    fn add(mut ref self, at: i64, delta: i32) {
        let mut i = at;
        while i < self.tree.len() {
            self.tree[i] += delta;
            i += i & -i;
        }
    }

    fn fetch(mut ref self, k: i32) -> i32 {
        let mut at = 0;
        let mut left = k;
        let mut step = 1;
        while step * 2 < self.tree.len() {
            step *= 2;
        }
        while step > 0 {
            if at + step < self.tree.len() and self.tree[at + step] < left {
                at += step;
                left -= self.tree[at];
            }
            step /= 2;
        }
        let slot = at + 1;
        let value = self.slots[slot];
        self.add(slot, -1);
        self.used += 1;
        self.slots[self.used] = value;
        self.add(self.used, 1);
        value
    }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random queues of 1 to `most` values, each fetched from
// `calls` times at random places
fn batch(count: i64, most: i64, calls: i64, seed: mut ref i64) {
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut queue = MruQueue.new(n as i32);
        for _ in 0..calls {
            let k = (next_random(mut seed) % n + 1) as i32;
            let got = queue.fetch(k);
            sum += got;
            check = (check * 31 + got) % 1000000007;
        }
    }
    println(f"{count} queues of up to {most} values, {calls} fetches each: fetched values add to {sum}, checksum {check}");
}

fn main() {
    // LeetCode's example, then one value fetched again and again, and the
    // last place every time
    let mut queue = MruQueue.new(8);
    println([queue.fetch(3), queue.fetch(5), queue.fetch(2), queue.fetch(8)]);
    let mut one = MruQueue.new(1);
    println([one.fetch(1), one.fetch(1)]);
    let mut last = MruQueue.new(4);
    println([last.fetch(4), last.fetch(4), last.fetch(1), last.fetch(1)]);
    let mut seed = 1756;
    batch(3000, 6, 6, mut seed);
    batch(100, 2000, 2000, mut seed);
}
