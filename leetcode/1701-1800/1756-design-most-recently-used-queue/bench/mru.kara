// LeetCode #1756: Design Most Recently Used Queue -- the bench (mru.kara):
// a Vec.

struct MruQueue {
    values: Vec[i32],
}

impl MruQueue {
    fn new(n: i32) -> MruQueue {
        MruQueue { values: (1..n + 1).collect() }
    }

    fn fetch(mut ref self, k: i32) -> i32 {
        let value = self.values.remove(k as i64 - 1);
        self.values.push(value);
        value
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 10000;
    let n = 2000;
    let calls = 2000;
    let mut seed = 1756;
    let fetches: Vec[i32] = (0..calls).map(|_| (next_random(mut seed) % n + 1) as i32).collect();
    let mut sum = 0;
    let mut check = 0;
    for r in 0..count {
        let mut queue = MruQueue.new(n as i32);
        for k in fetches.iter() {
            let got = queue.fetch(k);
            sum += got;
            check = (check * 31 + got + r) % 1000000007;
        }
    }
    println(f"{count} queues of {n} values, {calls} fetches each: fetched values add to {sum}, checksum {check}");
}
