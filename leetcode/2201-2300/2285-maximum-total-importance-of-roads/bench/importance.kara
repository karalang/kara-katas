// LeetCode #2285: Maximum Total Importance of Roads -- the bench, the ★
// arm. The degrees sorted, the k-th smallest valued k.

fn maximum_importance(n: i64, roads: Vec[(i64, i64)]) -> i64 {
    let mut degree = Vec.filled(n, 0);
    for (a, b) in roads.iter() {
        degree[a] += 1;
        degree[b] += 1;
    }
    degree.sort();
    let mut total = 0;
    for (i, d) in degree.iter().enumerate() {
        total += d * (i + 1);
    }
    total
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 200 graphs built once, each of 5000 cities and 5000 random roads;
    // then 20 passes over all of them
    let mut seed = 2285;
    let mut graphs: Vec[Vec[(i64, i64)]] = Vec.new();
    for _ in 0..200 {
        let mut roads: Vec[(i64, i64)] = Vec.new();
        while roads.len() < 5000 {
            let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % 5000;
            let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % 5000;
            if a != b {
                roads.push((a, b));
            }
        }
        graphs.push(roads);
    }
    let mut check = 0;
    for _ in 0..20 {
        for roads in graphs.iter() {
            check = (check * 31 + maximum_importance(5000, roads)) % 1000000007;
        }
    }
    println(f"20 passes over 200 graphs of 5000 cities: checksum {check}");
}
