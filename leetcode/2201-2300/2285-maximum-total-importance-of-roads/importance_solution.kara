// LeetCode #2285: Maximum Total Importance of Roads -- LeetCode's Rust
// template: `n: i32` and `Vec<Vec<i32>>` in, `i64` out; a `vec![0i64;
// n]` of degrees, `sort_unstable`, then the sum of each times its place
// plus one. Carried by `karac fix`. The adapter below hands the
// harness's values to it.

impl Solution {
    pub fn maximum_importance(n: i32, roads: Vec[Vec[i32]]) -> i64 {
        let mut deg = Vec.filled(n, 0);
        for r in roads.iter() {
            deg[r[0] as usize] += 1;
            deg[r[1] as usize] += 1;
        }
        deg.sort();
        deg.iter().enumerate().map(|(i, d)| d * (i + 1)).sum()
    }
}

struct Solution {}

fn maximum_importance(n: i64, roads: Vec[(i64, i64)]) -> i64 {
    let rows: Vec[Vec[i32]] = roads.iter().map(|(a, b)| [a as i32, b as i32]).collect();
    Solution.maximum_importance(n as i32, rows)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then one road, a complete graph on 50
    // cities, and a path through 5000 cities
    println(maximum_importance(5, [(0, 1), (1, 2), (2, 3), (0, 2), (1, 3), (2, 4)]));
    println(maximum_importance(5, [(0, 3), (2, 4), (1, 3)]));
    println(maximum_importance(2, [(0, 1)]));
    let mut complete: Vec[(i64, i64)] = Vec.new();
    for a in 0..50 {
        for b in a + 1..50 {
            complete.push((a, b));
        }
    }
    println(maximum_importance(50, complete));
    let mut path: Vec[(i64, i64)] = Vec.new();
    for a in 0..4999 {
        path.push((a, a + 1));
    }
    println(maximum_importance(5000, path));
    // 2000 graphs of 2 to 30 cities and 1 to 60 distinct roads
    let mut seed = 2285;
    let mut check = 0;
    let mut largest = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 29 + 2;
        let m = (next_random(mut seed) % 60 + 1).min(n * (n - 1) / 2);
        let mut taken = Vec.filled(n * n, false);
        let mut roads: Vec[(i64, i64)] = Vec.new();
        while roads.len() < m {
            let a = next_random(mut seed) % n;
            let b = next_random(mut seed) % n;
            if a != b and not taken[a * n + b] {
                taken[a * n + b] = true;
                taken[b * n + a] = true;
                roads.push((a, b));
            }
        }
        let answer = maximum_importance(n, roads);
        check = (check * 31 + answer) % 1000000007;
        largest = largest.max(answer);
    }
    println(f"2000 graphs: checksum {check}, largest {largest}");
}
