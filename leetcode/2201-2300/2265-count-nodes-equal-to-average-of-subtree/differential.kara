// LeetCode #2265: Count Nodes Equal to Average of Subtree -- the
// differential. The six arms, against the statement read literally: for
// every node, its subtree's values gathered into a list by a queue, and
// the node counted when its value `v` has `v * size <= sum < (v + 1) *
// size`, the floor written as bounds; no sums passed up. 300 random
// trees of 1 to 12 nodes of values from 0 to 1, 3, 10 or 1000; then 30
// chains; then 30 trees of one value. Every case is drawn before any arm
// answers.
//
// P1  the count is the literal reading's
// P2  the tree mirrored, every left child made right: the same count
// P3  1000 added to every value: the same count
// P4  at least the number of leaves and at most the number of nodes
// P5  hung as the left child of a new root of value 0: the count, plus
//     one when the whole sum is below the new size
// P6  each arm agrees with at least three of the other five

// ---- average.kara: the ★ arm, one post-order walk
fn star_sum_and_size(node: Option[TreeNode], matches: mut ref i64) -> (i64, i64) {
    let Some(n) = node else {
        return (0, 0);
    };
    let (left_sum, left_size) = star_sum_and_size(n.left, mut matches);
    let (right_sum, right_size) = star_sum_and_size(n.right, mut matches);
    let sum = left_sum + right_sum + n.val;
    let size = left_size + right_size + 1;
    if sum / size == n.val {
        *matches += 1;
    }
    (sum, size)
}

fn star_average_of_subtree(root: Option[TreeNode]) -> i64 {
    let mut matches = 0;
    star_sum_and_size(root, mut matches);
    matches
}

// ---- average_naive.kara: every subtree walked again
fn naive_total(node: Option[TreeNode]) -> (i64, i64) {
    match node {
        None => (0, 0),
        Some(n) => {
            let (ls, lc) = naive_total(n.left);
            let (rs, rc) = naive_total(n.right);
            (ls + rs + n.val, lc + rc + 1)
        }
    }
}

fn naive_count_matching(node: Option[TreeNode]) -> i64 {
    match node {
        None => 0,
        Some(n) => {
            let (sum, size) = naive_total(Some(n));
            let here = if sum / size == n.val { 1 } else { 0 };
            here + naive_count_matching(n.left) + naive_count_matching(n.right)
        }
    }
}

fn naive_average_of_subtree(root: Option[TreeNode]) -> i64 {
    naive_count_matching(root)
}

// ---- average_stack.kara: a root-first list folded backwards
fn stack_average_of_subtree(root: Option[TreeNode]) -> i64 {
    let mut order: Vec[TreeNode] = Vec.new();
    let mut parent: Vec[i64] = Vec.new();
    let mut stack: Vec[(TreeNode, i64)] = Vec.new();
    if let Some(r) = root {
        stack.push((r, -1));
    }
    while let Some((node, up)) = stack.pop() {
        let at = order.len();
        order.push(node);
        parent.push(up);
        if let Some(l) = node.left {
            stack.push((l, at));
        }
        if let Some(r) = node.right {
            stack.push((r, at));
        }
    }
    let n = order.len();
    let mut sum: Vec[i64] = order.iter().map(|t| (t.val) as i64).collect();
    let mut size = Vec.filled(n, 1);
    let mut matches = 0;
    for i in (0..n).rev() {
        if sum[i] / size[i] == order[i].val {
            matches += 1;
        }
        if parent[i] >= 0 {
            sum[parent[i]] += sum[i];
            size[parent[i]] += size[i];
        }
    }
    matches
}

// ---- average_struct.kara: `struct Tally` and `struct Part`
struct StructPart {
    sum: i64,
    size: i64,
}

struct StructTally {
    matches: i64,
}

impl StructTally {
    fn visit(mut ref self, node: Option[TreeNode]) -> StructPart {
        match node {
            None => StructPart { sum: 0, size: 0 },
            Some(n) => {
                let left = self.visit(n.left);
                let right = self.visit(n.right);
                let whole = StructPart { sum: left.sum + right.sum + n.val, size: left.size + right.size + 1 };
                if whole.sum / whole.size == n.val {
                    self.matches += 1;
                }
                whole
            }
        }
    }
}

fn struct_average_of_subtree(root: Option[TreeNode]) -> i64 {
    let mut tally = StructTally { matches: 0 };
    tally.visit(root);
    tally.matches
}

// ---- average_iter.kara: a `fold` over the two children
fn iter_walk(node: Option[TreeNode]) -> (i64, i64, i64) {
    match node {
        None => (0, 0, 0),
        Some(n) => {
            let (sum, size, matches) = [n.left, n.right]
                .iter()
                .map(|child| iter_walk(child))
                .fold((n.val as i64, 1, 0), |(s, c, m), (cs, cc, cm)| (s + cs, c + cc, m + cm));
            let here = if sum / size == n.val { 1 } else { 0 };
            (sum, size, matches + here)
        }
    }
}

fn iter_average_of_subtree(root: Option[TreeNode]) -> i64 {
    let (_, _, matches) = iter_walk(root);
    matches
}

// ---- average_solution.kara: LeetCode's Rust template
fn solution_dfs(node: Option[TreeNode], ans: mut ref i32) -> (i32, i32) {
    match node {
        None => (0, 0),
        Some(n) => {
            let (ls, lc) = solution_dfs(n.left, mut ans);
            let (rs, rc) = solution_dfs(n.right, mut ans);
            let s = ls + rs + n.val;
            let c = lc + rc + 1;
            if s / c == n.val {
                *ans += 1;
            }
            (s, c)
        }
    }
}

impl Solution {
    pub fn average_of_subtree(root: Option[TreeNode]) -> i32 {
        let mut ans = 0;
        solution_dfs(root, mut ans);
        ans
    }
}

struct Solution {}

fn solution_average_of_subtree(root: Option[TreeNode]) -> i64 {
    Solution.average_of_subtree(root)
}


// ---- the statement read literally

fn subtree_values(node: TreeNode) -> Vec[i64] {
    let mut values: Vec[i64] = Vec.new();
    let mut queue: Vec[TreeNode] = [node].to_vec();
    let mut head = 0;
    while head < queue.len() {
        let t = queue[head];
        head += 1;
        values.push(t.val);
        if let Some(l) = t.left {
            queue.push(l);
        }
        if let Some(r) = t.right {
            queue.push(r);
        }
    }
    values
}

fn all_nodes(root: Option[TreeNode]) -> Vec[TreeNode] {
    match root {
        None => Vec.new(),
        Some(r) => {
            let mut nodes: Vec[TreeNode] = [r].to_vec();
            let mut head = 0;
            while head < nodes.len() {
                let t = nodes[head];
                head += 1;
                if let Some(l) = t.left {
                    nodes.push(l);
                }
                if let Some(c) = t.right {
                    nodes.push(c);
                }
            }
            nodes
        }
    }
}

fn literal(root: Option[TreeNode]) -> i64 {
    let mut count = 0;
    for t in all_nodes(root).iter() {
        let values = subtree_values(t);
        let size = values.len();
        let sum: i64 = values.iter().sum();
        let v = t.val as i64;
        if v * size <= sum and sum < (v + 1) * size {
            count += 1;
        }
    }
    count
}

// a copy of the tree, mirrored when asked, with `add` on every value
fn copy(node: Option[TreeNode], mirror: bool, add: i64) -> Option[TreeNode] {
    match node {
        None => None,
        Some(n) => {
            let left = copy(n.left, mirror, add);
            let right = copy(n.right, mirror, add);
            let made = leaf(n.val + add);
            if mirror {
                made.left = right;
                made.right = left;
            } else {
                made.left = left;
                made.right = right;
            }
            Some(made)
        }
    }
}

fn answer(arm: i64, root: Option[TreeNode]) -> i64 {
    match arm {
        0 => star_average_of_subtree(root),
        1 => naive_average_of_subtree(root),
        2 => stack_average_of_subtree(root),
        3 => struct_average_of_subtree(root),
        4 => iter_average_of_subtree(root),
        _ => solution_average_of_subtree(root),
    }
}

// ---- test harness ---------------------------------------------------------

// LeetCode's own node: an `i32` value
shared struct TreeNode {
    val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v as i32, left: None, right: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` nodes of values from 0 to `top`, each after the first hung below a
// random earlier one, or below the last one when `chain`
fn random_tree(n: i64, top: i64, chain: bool, seed: mut ref i64) -> Option[TreeNode] {
    let nodes: Vec[TreeNode] = (0..n).map(|_| leaf(next_random(mut seed) % (top + 1))).collect();
    for k in 1..n {
        let mut at = nodes[if chain { k - 1 } else { next_random(mut seed) % k }];
        loop {
            if next_random(mut seed) % 2 == 0 {
                match at.left {
                    Some(c) => at = c,
                    None => {
                        at.left = Some(nodes[k]);
                        break;
                    }
                }
            } else {
                match at.right {
                    Some(c) => at = c,
                    None => {
                        at.right = Some(nodes[k]);
                        break;
                    }
                }
            }
        }
    }
    Some(nodes[0])
}

fn main() {
    let names = ["star", "naive", "stack", "struct", "iter", "solution"];
    let mut seed = 2265;
    let mut cases: Vec[Option[TreeNode]] = Vec.new();
    let mut shown: Vec[String] = Vec.new();
    for c in 0..360 {
        let n = next_random(mut seed) % 12 + 1;
        let tree = if c < 300 {
            random_tree(n, [1, 3, 10, 1000][c % 4], false, mut seed)
        } else if c < 330 {
            random_tree(n, [3, 10][c % 2], true, mut seed)
        } else {
            let v = next_random(mut seed) % 1001;
            let t = random_tree(n, 0, false, mut seed);
            copy(t, false, v)
        };
        let values: Vec[String] = all_nodes(tree).iter().map(|t| t.val.to_string()).collect();
        shown.push(f"[{values.join(",")}]");
        cases.push(tree);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for k in 0..cases.len() {
        let tree = cases[k];
        let truth = literal(tree);
        check = (check * 31 + truth) % 1000000007;
        let nodes = all_nodes(tree);
        let leaves = nodes.iter().filter(|t| t.left.is_none() and t.right.is_none()).count();
        let sum: i64 = nodes.iter().map(|t| t.val as i64).sum();
        let lifted = leaf(0);
        lifted.left = copy(tree, false, 0);
        let gained = if sum < nodes.len() + 1 { 1 } else { 0 };
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, copy(tree, false, 0))).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, copy(tree, true, 0)) == value,
                answer(arm, copy(tree, false, 1000)) == value,
                value >= leaves and value <= nodes.len(),
                answer(arm, Some(lifted)) == value + gained,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{shown[k]} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
