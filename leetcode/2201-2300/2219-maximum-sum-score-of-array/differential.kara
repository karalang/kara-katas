// LeetCode #2219: Maximum Sum Score of Array -- the differential. The
// six arms, against the statement read literally: at every index the
// first i + 1 numbers and the last n - i numbers each summed afresh, the
// larger kept, and the largest of those; no running sums. 300 random
// arrays of 1 to 12 numbers from -3, -100 and -10^5 to 3, 100 and 10^5
// in turn; then 30 of numbers all negative; then 30 of one number.
// Every case is drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  it is at least the first number, the last and the total, and at
//     most the positive numbers' sum, or the largest number if none is
// P3  the numbers reversed: the same answer
// P4  a 0 appended: the larger of the answer and 0
// P5  every number doubled: the answer doubled
// P6  each arm agrees with at least three of the other five

// ---- score.kara: the ★ arm, the total less the sum before
fn star_maximum_sum_score(nums: Vec[i64]) -> i64 {
    let mut total = 0;
    for x in nums.iter() {
        total += x;
    }
    let mut before = 0;
    // no score is below the smaller of the first number and the total
    let mut best = nums[0].min(total);
    for x in nums.iter() {
        let from_here = total - before;
        before += x;
        best = best.max(before).max(from_here);
    }
    best
}

// ---- score_sums.kara: both sums kept whole
fn sums_maximum_sum_score(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut prefix: Vec[i64] = Vec.filled(n, 0);
    let mut suffix: Vec[i64] = Vec.filled(n, 0);
    prefix[0] = nums[0];
    for i in 1..n {
        prefix[i] = prefix[i - 1] + nums[i];
    }
    suffix[n - 1] = nums[n - 1];
    for i in (0..n - 1).rev() {
        suffix[i] = suffix[i + 1] + nums[i];
    }
    let mut best = prefix[0].max(suffix[0]);
    for i in 1..n {
        let score = if prefix[i] > suffix[i] { prefix[i] } else { suffix[i] };
        if score > best {
            best = score;
        }
    }
    best
}

// ---- score_ends.kara: a running sum from each end
fn ends_maximum_sum_score(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut front = 0;
    let mut back = 0;
    let mut best = nums[0];
    let mut i = 0;
    while i < n {
        front += nums[i];
        back += nums[n - 1 - i];
        if front > best {
            best = front;
        }
        if back > best {
            best = back;
        }
        i += 1;
    }
    best
}

// ---- score_struct.kara: `Ledger`, `take` and `left`
struct Ledger {
    total: i64,
    taken: i64,
}

impl Ledger {
    fn of(nums: Vec[i64]) -> Ledger {
        let mut total = 0;
        for x in nums.iter() {
            total += x;
        }
        Ledger { total: total, taken: 0 }
    }

    fn left(ref self) -> i64 {
        self.total - self.taken
    }

    // the score at the next index: the sum through it or the sum from it
    fn take(mut ref self, x: i64) -> i64 {
        let from_here = self.left();
        self.taken += x;
        self.taken.max(from_here)
    }
}

fn struct_maximum_sum_score(nums: Vec[i64]) -> i64 {
    let mut ledger = Ledger.of(nums);
    let mut best: Option[i64] = None;
    for x in nums.iter() {
        let score = ledger.take(x);
        best = match best {
            None => Some(score),
            Some(b) if score > b => Some(score),
            other => other,
        };
    }
    best.unwrap()
}

// ---- score_iter.kara: `map`, `zip` and `max`
fn iter_maximum_sum_score(nums: Vec[i64]) -> i64 {
    let total: i64 = nums.iter().sum();
    let mut running = 0;
    let through: Vec[i64] = nums.iter().map(|x| {
        running += x;
        running
    }).collect();
    through.iter().zip(nums.iter()).map(|(t, x)| t.max(total - t + x)).max().unwrap()
}

// ---- score_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn maximum_sum_score(nums: Vec[i32]) -> i64 {
        let total: i64 = nums.iter().map(|x| x as i64).sum();
        let mut prefix = 0;
        let mut ans = i64.MIN;
        for x in nums.iter() {
            prefix += x as i64;
            ans = ans.max(prefix).max(total - prefix + x as i64);
        }
        ans
    }
}

struct Solution {}

fn solution_maximum_sum_score(nums: Vec[i64]) -> i64 {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.maximum_sum_score(nums)
}

// ---- the statement read literally

fn literal(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut best = 0;
    for i in 0..n {
        let mut first = 0;
        for j in 0..i + 1 {
            first += nums[j];
        }
        let mut last = 0;
        for j in i..n {
            last += nums[j];
        }
        let score = if first > last { first } else { last };
        if i == 0 or score > best {
            best = score;
        }
    }
    best
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_maximum_sum_score(nums),
        1 => sums_maximum_sum_score(nums),
        2 => ends_maximum_sum_score(nums),
        3 => struct_maximum_sum_score(nums),
        4 => iter_maximum_sum_score(nums),
        _ => solution_maximum_sum_score(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "sums", "ends", "struct", "iter", "solution"];
    let mut seed = 2219;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..360 {
        let top = [3, 100, 100000][c % 3];
        let n = next_random(mut seed) % 12 + 1;
        let one = wide_random(mut seed) % (2 * top + 1) - top;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            let x = if c < 300 {
                wide_random(mut seed) % (2 * top + 1) - top
            } else if c < 330 {
                -(wide_random(mut seed) % top) - 1
            } else {
                one
            };
            nums.push(x);
        }
        cases.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for nums in cases.iter() {
        let truth = literal(nums);
        check = (check * 31 + truth + 3000000) % 1000000007;
        let n = nums.len();
        let mut total = 0;
        let mut positive = 0;
        let mut largest = nums[0];
        for x in nums.iter() {
            total += x;
            if x > 0 {
                positive += x;
            }
            if x > largest {
                largest = x;
            }
        }
        let low = nums[0].max(nums[n - 1]).max(total);
        let high = if positive > 0 { positive } else { largest };
        let reversed: Vec[i64] = nums.iter().rev().cloned().collect();
        let mut padded = nums.clone();
        padded.push(0);
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let best = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == best {
                    same += 1;
                }
            }
            let verdicts = [
                best == truth,
                best >= low and best <= high,
                answer(arm, reversed) == best,
                answer(arm, padded) == best.max(0),
                answer(arm, doubled) == 2 * best,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} arm {names[arm]}: P{q + 1} fails, gave {best}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
