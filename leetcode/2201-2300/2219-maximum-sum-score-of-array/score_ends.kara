// LeetCode #2219: Maximum Sum Score of Array -- the largest score is
// the largest of all the prefix sums and all the suffix sums together,
// since every score is one of them and every one of them is beaten or
// matched by the score at its index; so two running sums, one from each
// end, walk toward each other in one loop. O(n).

fn maximum_sum_score(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut front = 0;
    let mut back = 0;
    let mut best = nums[0];
    for i in 0..n {
        front += nums[i];
        back += nums[n - 1 - i];
        if front > best {
            best = front;
        }
        if back > best {
            best = back;
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// n numbers from -top to top
fn draw_nums(seed: mut ref i64, n: i64, top: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push(wide_random(mut seed) % (2 * top + 1) - top);
    }
    nums
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {maximum_sum_score(nums)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number, all
    // negative, the best a suffix, and a zero sum
    show([4, 3, -2, 5]);
    show([-3, -5]);
    show([7]);
    show([-4, -1, -9]);
    show([-10, 1, 2, 3]);
    show([5, -5, 5, -5]);
    // 3000 random arrays of 1 to 30 numbers from -3, -100 and -10^5 to
    // 3, 100 and 10^5 in turn
    let mut seed = 2219;
    let mut check = 0;
    for c in 0..3000 {
        let n = next_random(mut seed) % 30 + 1;
        let nums = draw_nums(mut seed, n, [3, 100, 100000][c % 3]);
        check = (check * 31 + maximum_sum_score(nums) + 3000000) % 1000000007;
    }
    println(f"3000 arrays: checksum {check}");
    // the constraints' largest: 10^5 numbers from -10^5 to 10^5, 10^5 of
    // -10^5 and 10^5 of 10^5
    let wide = draw_nums(mut seed, 100000, 100000);
    let low: Vec[i64] = Vec.filled(100000, -100000);
    let high: Vec[i64] = Vec.filled(100000, 100000);
    println(f"10^5 random: {maximum_sum_score(wide)}; 10^5 of -10^5: {maximum_sum_score(low)}; 10^5 of 10^5: {maximum_sum_score(high)}");
}
