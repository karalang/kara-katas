// LeetCode #2247: Maximum Cost of Trip With K Highways -- a `struct
// Road` of a destination and its toll, and a `struct Planner` holding
// the roads out of every city and an `Option[i64]` for every (cities
// used, city at), `None` where no trip gets there. `Planner.new` builds
// it, `drive` (`mut ref self`) extends every trip of one size by a
// highway, and `dearest` (`ref self`) reads the answer off the trips of
// k + 1 cities. The masks are grouped by size up front.
// O(2^n * n + 2^n * m).

#[derive(Copy, Clone)]
struct Road {
    to: i64,
    toll: i64,
}

struct Planner {
    roads: Vec[Vec[Road]],
    best: Vec[Vec[Option[i64]]],
    // by_size[c]: every mask of c cities
    by_size: Vec[Vec[i64]],
}

impl Planner {
    fn new(n: i64, highways: Vec[Vec[i64]]) -> Planner {
        let mut roads: Vec[Vec[Road]] = Vec.filled(n, Vec.new());
        for h in highways.iter() {
            roads[h[0]].push(Road { to: h[1], toll: h[2] });
            roads[h[1]].push(Road { to: h[0], toll: h[2] });
        }
        let mut best: Vec[Vec[Option[i64]]] = Vec.filled(1 << n, Vec.filled(n, None));
        for v in 0..n {
            best[1 << v][v] = Some(0);
        }
        let mut by_size: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
        for mask in 1..(1 << n) {
            by_size[mask.count_ones()].push(mask);
        }
        Planner { roads, best, by_size }
    }

    fn drive(mut ref self, size: i64) {
        let n = self.roads.len();
        for mask in self.by_size[size].clone().iter() {
            for v in 0..n {
                let Some(cost) = self.best[mask][v] else { continue };
                for road in self.roads[v].clone().iter() {
                    if mask & (1 << road.to) != 0 {
                        continue;
                    }
                    let next = mask | (1 << road.to);
                    let here = cost + road.toll;
                    self.best[next][road.to] = match self.best[next][road.to] {
                        Some(seen) => Some(seen.max(here)),
                        None => Some(here),
                    };
                }
            }
        }
    }

    fn dearest(ref self, size: i64) -> Option[i64] {
        let mut found: Option[i64] = None;
        for mask in self.by_size[size].iter() {
            for cost in self.best[mask].iter() {
                if let Some(c) = cost {
                    found = Some(found.map_or(c, |f| f.max(c)));
                }
            }
        }
        found
    }
}

fn maximum_cost(n: i64, highways: Vec[Vec[i64]], k: i64) -> i64 {
    if k + 1 > n {
        return -1;
    }
    let mut planner = Planner.new(n, highways);
    for size in 1..k + 1 {
        planner.drive(size);
    }
    planner.dearest(k + 1).unwrap_or(-1)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// m distinct highways among n cities, tolls 0 to 100
fn random_highways(seed: mut ref i64, n: i64, m: i64) -> Vec[Vec[i64]] {
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for a in 0..n {
        for b in a + 1..n {
            pairs.push((a, b));
        }
    }
    for i in (1..pairs.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        pairs.swap(i, j);
    }
    pairs.iter().take(m).map(|(a, b)| {
        let toll = next_random(mut seed) % 101;
        if next_random(mut seed) % 2 == 0 { [a, b, toll].to_vec() } else { [b, a, toll].to_vec() }
    }).collect()
}

fn main() {
    // LeetCode's two examples, then four more: one highway, a trip
    // longer than the cities allow, a triangle, and a path walked whole
    let examples = [
        (5, [[0, 1, 4].to_vec(), [2, 1, 3].to_vec(), [1, 4, 11].to_vec(), [3, 2, 3].to_vec(), [3, 4, 2].to_vec()].to_vec(), 3),
        (4, [[0, 1, 3].to_vec(), [2, 3, 2].to_vec()].to_vec(), 2),
        (2, [[1, 0, 7].to_vec()].to_vec(), 1),
        (3, [[0, 1, 5].to_vec(), [1, 2, 5].to_vec()].to_vec(), 3),
        (3, [[0, 1, 1].to_vec(), [1, 2, 10].to_vec(), [2, 0, 100].to_vec()].to_vec(), 2),
        (4, [[0, 1, 0].to_vec(), [1, 2, 0].to_vec(), [2, 3, 0].to_vec()].to_vec(), 3),
    ];
    for (n, highways, k) in examples.iter() {
        println(f"n={n} {highways} k={k} -> {maximum_cost(n, highways, k)}");
    }
    // 2000 trips: 2 to 7 cities, any number of highways, k from 1 to 7
    let mut seed = 2247;
    let mut possible = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 6 + 2;
        let m = next_random(mut seed) % (n * (n - 1) / 2) + 1;
        let highways = random_highways(mut seed, n, m);
        let k = next_random(mut seed) % 7 + 1;
        let cost = maximum_cost(n, highways, k);
        if cost >= 0 {
            possible += 1;
        }
        check = (check * 31 + cost + 1) % 1000000007;
    }
    println(f"2000 trips: {possible} possible, checksum {check}");
    // the constraints' largest: 15 cities and 50 highways, k = 14 and 50
    let highways = random_highways(mut seed, 15, 50);
    println(f"15 cities, k=14: {maximum_cost(15, highways, 14)}");
    println(f"15 cities, k=50: {maximum_cost(15, highways, 50)}");
}
