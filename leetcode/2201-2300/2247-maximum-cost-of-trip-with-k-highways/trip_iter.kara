// LeetCode #2247: Maximum Cost of Trip With K Highways -- iterator
// chains: the roads gathered by `flat_map` over both directions of
// every highway and `fold`ed into lists; the masks in increasing order,
// each one's steps out found by `filter_map` over its reachable cities
// and their roads, collected, and then written into the table; the
// answer the `max` over the masks of k + 1 cities by `filter` and
// `flat_map`. O(2^n * n + 2^n * m).

fn maximum_cost(n: i64, highways: Vec[Vec[i64]], k: i64) -> i64 {
    if k + 1 > n {
        return -1;
    }
    let roads: Vec[Vec[(i64, i64)]] = highways
        .iter()
        .flat_map(|h| [(h[0], h[1], h[2]), (h[1], h[0], h[2])].into_iter())
        .fold(Vec.filled(n, Vec.new()), |lists: own Vec[Vec[(i64, i64)]], (a, b, toll)| {
            let mut lists = lists;
            lists[a].push((b, toll));
            lists
        });
    let full = 1 << n;
    let mut best: Vec[Vec[i64]] = Vec.filled(full, Vec.filled(n, -1));
    for v in 0..n {
        best[1 << v][v] = 0;
    }
    for mask in (1..full).filter(|m| m.count_ones() <= k) {
        // the steps' closures read the table through a borrow: a returned
        // closure takes its captures by move (core-semantics.md §9.3)
        let reached = ref best;
        let steps: Vec[(i64, i64, i64)] = (0..n)
            .filter(|v| reached[mask][v] >= 0)
            .flat_map(|v| roads[v].iter().filter_map(|(w, toll)| if mask & (1 << w) == 0 { Some((mask | (1 << w), w, reached[mask][v] + toll)) } else { None }))
            .collect();
        for (next, w, cost) in steps.iter() {
            best[next][w] = best[next][w].max(cost);
        }
    }
    (1..full).filter(|m| m.count_ones() == k + 1).flat_map(|m| best[m].iter()).max().unwrap_or(-1)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// m distinct highways among n cities, tolls 0 to 100
fn random_highways(seed: mut ref i64, n: i64, m: i64) -> Vec[Vec[i64]] {
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for a in 0..n {
        for b in a + 1..n {
            pairs.push((a, b));
        }
    }
    for i in (1..pairs.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        pairs.swap(i, j);
    }
    pairs.iter().take(m).map(|(a, b)| {
        let toll = next_random(mut seed) % 101;
        if next_random(mut seed) % 2 == 0 { [a, b, toll].to_vec() } else { [b, a, toll].to_vec() }
    }).collect()
}

fn main() {
    // LeetCode's two examples, then four more: one highway, a trip
    // longer than the cities allow, a triangle, and a path walked whole
    let examples = [
        (5, [[0, 1, 4].to_vec(), [2, 1, 3].to_vec(), [1, 4, 11].to_vec(), [3, 2, 3].to_vec(), [3, 4, 2].to_vec()].to_vec(), 3),
        (4, [[0, 1, 3].to_vec(), [2, 3, 2].to_vec()].to_vec(), 2),
        (2, [[1, 0, 7].to_vec()].to_vec(), 1),
        (3, [[0, 1, 5].to_vec(), [1, 2, 5].to_vec()].to_vec(), 3),
        (3, [[0, 1, 1].to_vec(), [1, 2, 10].to_vec(), [2, 0, 100].to_vec()].to_vec(), 2),
        (4, [[0, 1, 0].to_vec(), [1, 2, 0].to_vec(), [2, 3, 0].to_vec()].to_vec(), 3),
    ];
    for (n, highways, k) in examples.iter() {
        println(f"n={n} {highways} k={k} -> {maximum_cost(n, highways, k)}");
    }
    // 2000 trips: 2 to 7 cities, any number of highways, k from 1 to 7
    let mut seed = 2247;
    let mut possible = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 6 + 2;
        let m = next_random(mut seed) % (n * (n - 1) / 2) + 1;
        let highways = random_highways(mut seed, n, m);
        let k = next_random(mut seed) % 7 + 1;
        let cost = maximum_cost(n, highways, k);
        if cost >= 0 {
            possible += 1;
        }
        check = (check * 31 + cost + 1) % 1000000007;
    }
    println(f"2000 trips: {possible} possible, checksum {check}");
    // the constraints' largest: 15 cities and 50 highways, k = 14 and 50
    let highways = random_highways(mut seed, 15, 50);
    println(f"15 cities, k=14: {maximum_cost(15, highways, 14)}");
    println(f"15 cities, k=50: {maximum_cost(15, highways, 50)}");
}
