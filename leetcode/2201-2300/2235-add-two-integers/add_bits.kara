// LeetCode #2235: Add Two Integers -- no `+`: the bits that differ by
// exclusive or, the carries by and, shifted up one and added again
// until none is left. For a negative number the carry climbs through
// every bit and out of the top, so this leans on `<<` dropping the bits
// shifted past the sign, as two's complement does. At most 64 rounds.

fn sum(num1: i64, num2: i64) -> i64 {
    let mut a = num1;
    let mut b = num2;
    while b != 0 {
        let carry = (a & b) << 1;
        a = a ^ b;
        b = carry;
    }
    a
}

// ---- test harness ---------------------------------------------------------

fn show(num1: i64, num2: i64) {
    println(f"{num1} + {num2} = {sum(num1, num2)}");
}

fn main() {
    // LeetCode's two examples, then five more: both ends, both zero, a
    // sum of zero, and a carry through every bit of a negative number
    show(12, 5);
    show(-10, 4);
    show(-100, -100);
    show(100, 100);
    show(0, 0);
    show(-7, 7);
    show(-1, 1);
    // every pair from -100 to 100
    let mut check = 0;
    let mut negative = 0;
    let mut zero = 0;
    for num1 in -100..=100 {
        for num2 in -100..=100 {
            let s = sum(num1, num2);
            check = (check * 31 + s + 200) % 1000000007;
            if s < 0 {
                negative += 1;
            } else if s == 0 {
                zero += 1;
            }
        }
    }
    println(f"40401 pairs: checksum {check}, {negative} negative, {zero} zero");
}
