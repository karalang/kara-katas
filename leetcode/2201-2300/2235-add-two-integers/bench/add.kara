// LeetCode #2235: Add Two Integers -- the two added with `+`. O(1).
// The bench is dominated by drawing the numbers: the addition is one
// instruction, so this measures the loop around it.

fn sum(num1: i64, num2: i64) -> i64 {
    num1 + num2
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2235;
    let mut check = 0;
    for _ in 0..10000000 {
        let num1 = next_random(mut seed) % 201 - 100;
        let num2 = next_random(mut seed) % 201 - 100;
        check = (check * 31 + sum(num1, num2) + 200) % 1000000007;
    }
    println(f"10^7 pairs: checksum {check}");
}
