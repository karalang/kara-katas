// LeetCode #2235: Add Two Integers -- the differential. The six arms,
// against the statement read literally: a walk along the number line
// from num1, num2 unit steps up (or down, for a negative num2); no `+`
// of the two. Every pair from -100 to 100, 40401 of them, each drawn
// before any arm answers.
//
// P1  the answer is where the walk ends
// P2  the two numbers swapped: the same answer
// P3  num2 taken back off the answer by the same arm: num1
// P4  num1 one higher: the answer one higher
// P5  both numbers negated: the answer negated
// P6  each arm agrees with at least three of the other five


// ---- add.kara: the ★ arm, `+`
fn star_sum(num1: i64, num2: i64) -> i64 {
    num1 + num2
}

// ---- add_bits.kara: exclusive or and shifted carries
fn bits_sum(num1: i64, num2: i64) -> i64 {
    let mut a = num1;
    let mut b = num2;
    while b != 0 {
        let carry = (a & b) << 1;
        a = a ^ b;
        b = carry;
    }
    a
}

// ---- add_digits.kara: decimal digits by hand, carry and borrow
// the decimal digits_digits of a magnitude, least significant first
fn digits_digits(magnitude: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut m = magnitude;
    while m > 0 {
        out.push(m % 10);
        m /= 10;
    }
    out
}

fn digits_value(ds: Vec[i64]) -> i64 {
    let mut v = 0;
    for d in ds.iter().rev() {
        v = v * 10 + d;
    }
    v
}

fn digits_add_magnitudes(x: Vec[i64], y: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut carry = 0;
    for i in 0..x.len().max(y.len()) {
        let d = if i < x.len() { x[i] } else { 0 } + if i < y.len() { y[i] } else { 0 } + carry;
        out.push(d % 10);
        carry = d / 10;
    }
    if carry > 0 {
        out.push(carry);
    }
    out
}

// x - y for magnitudes with x >= y
fn digits_subtract_magnitudes(x: Vec[i64], y: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut borrow = 0;
    for i in 0..x.len() {
        let mut d = x[i] - if i < y.len() { y[i] } else { 0 } - borrow;
        if d < 0 {
            d += 10;
            borrow = 1;
        } else {
            borrow = 0;
        }
        out.push(d);
    }
    out
}

fn digits_sum(num1: i64, num2: i64) -> i64 {
    let x = digits_digits(num1.abs());
    let y = digits_digits(num2.abs());
    if (num1 < 0) == (num2 < 0) {
        let total = digits_value(digits_add_magnitudes(x, y));
        if num1 < 0 { -total } else { total }
    } else if num1.abs() >= num2.abs() {
        let difference = digits_value(digits_subtract_magnitudes(x, y));
        if num1 < 0 { -difference } else { difference }
    } else {
        let difference = digits_value(digits_subtract_magnitudes(y, x));
        if num2 < 0 { -difference } else { difference }
    }
}

// ---- add_struct.kara: `Pair` and `total`
struct Pair {
    first: i64,
    second: i64,
}

impl Pair {
    fn total(ref self) -> i64 {
        self.first + self.second
    }
}

fn struct_sum(num1: i64, num2: i64) -> i64 {
    Pair { first: num1, second: num2 }.total()
}

// ---- add_iter.kara: `iter().sum()` over an array
fn iter_sum(num1: i64, num2: i64) -> i64 {
    [num1, num2].iter().sum()
}

// ---- add_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn sum(num1: i32, num2: i32) -> i32 {
        num1 + num2
    }
}

struct Solution {}

fn solution_sum(num1: i64, num2: i64) -> i64 {
    Solution.sum(num1 as i32, num2 as i32)
}

// ---- the statement read literally

fn literal(num1: i64, num2: i64) -> i64 {
    let step = if num2 < 0 { -1 } else { 1 };
    let mut at = num1;
    let mut taken = 0;
    while taken != num2 {
        at += step;
        taken += step;
    }
    at
}

fn answer(arm: i64, num1: i64, num2: i64) -> i64 {
    match arm {
        0 => star_sum(num1, num2),
        1 => bits_sum(num1, num2),
        2 => digits_sum(num1, num2),
        3 => struct_sum(num1, num2),
        4 => iter_sum(num1, num2),
        _ => solution_sum(num1, num2),
    }
}

fn main() {
    let names = ["star", "bits", "digits", "struct", "iter", "solution"];
    let mut cases: Vec[(i64, i64)] = Vec.new();
    for num1 in -100..=100 {
        for num2 in -100..=100 {
            cases.push((num1, num2));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (num1, num2) in cases.iter() {
        let truth = literal(num1, num2);
        check = (check * 31 + truth + 200) % 1000000007;
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, num1, num2)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, num2, num1) == value,
                answer(arm, value, -num2) == num1,
                answer(arm, num1 + 1, num2) == value + 1,
                answer(arm, -num1, -num2) == -value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{num1} + {num2} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
