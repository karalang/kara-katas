// LeetCode #2235: Add Two Integers -- by hand on decimal digits, as on
// paper: the same signs add their magnitudes digit by digit with a
// carry; different signs take the smaller magnitude from the larger
// digit by digit with a borrow, and the result has the larger's sign.

// the decimal digits of a magnitude, least significant first
fn digits(magnitude: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut m = magnitude;
    while m > 0 {
        out.push(m % 10);
        m /= 10;
    }
    out
}

fn value(ds: Vec[i64]) -> i64 {
    let mut v = 0;
    for d in ds.iter().rev() {
        v = v * 10 + d;
    }
    v
}

fn add_magnitudes(x: Vec[i64], y: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut carry = 0;
    for i in 0..x.len().max(y.len()) {
        let d = if i < x.len() { x[i] } else { 0 } + if i < y.len() { y[i] } else { 0 } + carry;
        out.push(d % 10);
        carry = d / 10;
    }
    if carry > 0 {
        out.push(carry);
    }
    out
}

// x - y for magnitudes with x >= y
fn subtract_magnitudes(x: Vec[i64], y: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut borrow = 0;
    for i in 0..x.len() {
        let mut d = x[i] - if i < y.len() { y[i] } else { 0 } - borrow;
        if d < 0 {
            d += 10;
            borrow = 1;
        } else {
            borrow = 0;
        }
        out.push(d);
    }
    out
}

fn sum(num1: i64, num2: i64) -> i64 {
    let x = digits(num1.abs());
    let y = digits(num2.abs());
    if (num1 < 0) == (num2 < 0) {
        let total = value(add_magnitudes(x, y));
        if num1 < 0 { -total } else { total }
    } else if num1.abs() >= num2.abs() {
        let difference = value(subtract_magnitudes(x, y));
        if num1 < 0 { -difference } else { difference }
    } else {
        let difference = value(subtract_magnitudes(y, x));
        if num2 < 0 { -difference } else { difference }
    }
}

// ---- test harness ---------------------------------------------------------

fn show(num1: i64, num2: i64) {
    println(f"{num1} + {num2} = {sum(num1, num2)}");
}

fn main() {
    // LeetCode's two examples, then five more: both ends, both zero, a
    // sum of zero, and a carry through every bit of a negative number
    show(12, 5);
    show(-10, 4);
    show(-100, -100);
    show(100, 100);
    show(0, 0);
    show(-7, 7);
    show(-1, 1);
    // every pair from -100 to 100
    let mut check = 0;
    let mut negative = 0;
    let mut zero = 0;
    for num1 in -100..=100 {
        for num2 in -100..=100 {
            let s = sum(num1, num2);
            check = (check * 31 + s + 200) % 1000000007;
            if s < 0 {
                negative += 1;
            } else if s == 0 {
                zero += 1;
            }
        }
    }
    println(f"40401 pairs: checksum {check}, {negative} negative, {zero} zero");
}
