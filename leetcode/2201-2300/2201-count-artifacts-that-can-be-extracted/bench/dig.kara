// benchmark's Kāra version of dig.kara (LeetCode #2201, the ★ arm): the
// dug cells in a `Set`, each as r * n + c.

fn dig_artifacts(n: i64, artifacts: Vec[Array[i64, 4]], dig: Vec[Array[i64, 2]]) -> i64 {
    let mut dug: Set[i64] = Set.new();
    for d in dig.iter() {
        dug.insert(d[0] * n + d[1]);
    }
    let mut count = 0;
    for a in artifacts.iter() {
        let mut whole = true;
        for r in a[0]..=a[2] {
            for c in a[1]..=a[3] {
                if not dug.contains(r * n + c) {
                    whole = false;
                }
            }
        }
        if whole {
            count += 1;
        }
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// a site on an n by n grid: `tries` artifacts of the eight shapes, each
// dropped when it would overlap one already placed, and `digs` distinct
// cells dug, both tracked in a table of flags
fn site(n: i64, tries: i64, digs: i64, seed: mut ref i64) -> (Vec[Array[i64, 4]], Vec[Array[i64, 2]]) {
    let shapes = [(1, 1), (1, 2), (2, 1), (2, 2), (1, 3), (3, 1), (1, 4), (4, 1)];
    let mut taken = Vec.filled(n * n, false);
    let mut artifacts: Vec[Array[i64, 4]] = Vec.new();
    for _ in 0..tries {
        let (h, w) = shapes[next_random(mut seed) % 8];
        let r = wide_random(mut seed) % (n - h + 1);
        let c = wide_random(mut seed) % (n - w + 1);
        let mut free = true;
        for i in r..(r + h) {
            for j in c..(c + w) {
                if taken[i * n + j] {
                    free = false;
                }
            }
        }
        if free {
            for i in r..(r + h) {
                for j in c..(c + w) {
                    taken[i * n + j] = true;
                }
            }
            artifacts.push([r, c, r + h - 1, c + w - 1]);
        }
    }
    let mut dug = Vec.filled(n * n, false);
    let mut dig: Vec[Array[i64, 2]] = Vec.new();
    while dig.len() < digs {
        let cell = wide_random(mut seed) % (n * n);
        if not dug[cell] {
            dug[cell] = true;
            dig.push([cell / n, cell % n]);
        }
    }
    (artifacts, dig)
}

fn main() {
    let mut seed = 2201;
    let mut sites: Vec[(Vec[Array[i64, 4]], Vec[Array[i64, 2]])] = Vec.new();
    for _ in 0..8 {
        sites.push(site(1000, 20000, 300000, mut seed));
    }
    let mut check = 0;
    for _ in 0..10 {
        for (artifacts, dig) in sites.iter() {
            let count = dig_artifacts(1000, artifacts, dig);
            check = (check * 31 + count + artifacts.len()) % 1000000007;
        }
    }
    println(f"10 passes over 8 sites: checksum {check}");
}
