// LeetCode #2201: Count Artifacts That Can Be Extracted -- the
// differential. The six arms, against the statement read literally: every
// cell of every artifact looked for in the dig list itself, one by one; no
// set, no table. 300 random sites on grids of 1 to 8, with 1 to 10
// artifacts tried and up to every cell dug; then 30 with every cell dug;
// then 30 on grids of 20 to 59 with 30 tried and half the cells dug.
// Every case is drawn before any arm answers.
//
// P1  the count is the statement read literally
// P2  it is at least 0 and at most the number of artifacts and of cells dug
// P3  the dig list reversed: the same count
// P4  the site transposed, rows for columns: the same count
// P5  the first artifact's missing cells dug too: one more, unless it was
//     whole already
// P6  each arm agrees with at least three of the other five

// ---- dig.kara: the ★ arm, the dug cells in a `Set`
fn star_dig_artifacts(n: i64, artifacts: Vec[Array[i64, 4]], dig: Vec[Array[i64, 2]]) -> i64 {
    let mut dug: Set[i64] = Set.new();
    for d in dig.iter() {
        dug.insert(d[0] * n + d[1]);
    }
    let mut count = 0;
    for a in artifacts.iter() {
        let mut whole = true;
        for r in a[0]..=a[2] {
            for c in a[1]..=a[3] {
                if not dug.contains(r * n + c) {
                    whole = false;
                }
            }
        }
        if whole {
            count += 1;
        }
    }
    count
}

// ---- dig_grid.kara: a table of flags, one per cell
fn grid_dig_artifacts(n: i64, artifacts: Vec[Array[i64, 4]], dig: Vec[Array[i64, 2]]) -> i64 {
    let mut dug = Vec.filled(n * n, false);
    for d in dig.iter() {
        dug[d[0] * n + d[1]] = true;
    }
    let mut count = 0;
    for a in artifacts.iter() {
        let mut whole = true;
        for r in a[0]..=a[2] {
            for c in a[1]..=a[3] {
                whole = whole and dug[r * n + c];
            }
        }
        if whole {
            count += 1;
        }
    }
    count
}

// ---- dig_owner.kara: each cell's owner and each artifact's buried count
fn owner_dig_artifacts(n: i64, artifacts: Vec[Array[i64, 4]], dig: Vec[Array[i64, 2]]) -> i64 {
    let mut owner: Map[i64, i64] = Map.new();
    let mut buried: Vec[i64] = Vec.new();
    for (i, a) in artifacts.iter().enumerate() {
        for r in a[0]..=a[2] {
            for c in a[1]..=a[3] {
                owner.insert(r * n + c, i);
            }
        }
        buried.push((a[2] - a[0] + 1) * (a[3] - a[1] + 1));
    }
    let mut count = 0;
    for d in dig.iter() {
        if let Some(i) = owner.get(d[0] * n + d[1]) {
            buried[i] -= 1;
            if buried[i] == 0 {
                count += 1;
            }
        }
    }
    count
}

// ---- dig_struct.kara: an `Artifact` asked about a `Site`
struct Site {
    n: i64,
    dug: Set[i64],
}

impl Site {
    fn new(n: i64, dig: Vec[Array[i64, 2]]) -> Site {
        let mut dug: Set[i64] = Set.new();
        for d in dig.iter() {
            dug.insert(d[0] * n + d[1]);
        }
        Site { n: n, dug: dug }
    }

    fn is_dug(self, r: i64, c: i64) -> bool {
        self.dug.contains(r * self.n + c)
    }
}

struct Artifact {
    top: i64,
    left: i64,
    bottom: i64,
    right: i64,
}

impl Artifact {
    fn from_row(row: Array[i64, 4]) -> Artifact {
        Artifact { top: row[0], left: row[1], bottom: row[2], right: row[3] }
    }

    fn uncovered(self, site: Site) -> bool {
        for r in self.top..=self.bottom {
            for c in self.left..=self.right {
                if not site.is_dug(r, c) {
                    return false;
                }
            }
        }
        true
    }
}

fn struct_dig_artifacts(n: i64, artifacts: Vec[Array[i64, 4]], dig: Vec[Array[i64, 2]]) -> i64 {
    let site = Site.new(n, dig);
    let mut count = 0;
    for row in artifacts.iter() {
        if Artifact.from_row(row).uncovered(site) {
            count += 1;
        }
    }
    count
}

// ---- dig_iter.kara: `collect`, `filter`, `all`, `count`
fn iter_dig_artifacts(n: i64, artifacts: Vec[Array[i64, 4]], dig: Vec[Array[i64, 2]]) -> i64 {
    let dug: Set[i64] = dig.iter().map(|d| d[0] * n + d[1]).collect();
    artifacts
        .iter()
        .filter(|a| (a[0]..=a[2]).all(|r| (a[1]..=a[3]).all(|c| dug.contains(r * n + c))))
        .count()
}

// ---- dig_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn dig_artifacts(n: i32, artifacts: Vec[Vec[i32]], dig: Vec[Vec[i32]]) -> i32 {
        let _ = n;
        let dug: Set[(i32, i32)] = dig.iter().map(|d| (d[0], d[1])).collect();
        let mut count = 0;
        for a in artifacts.iter() {
            let mut whole = true;
            for r in a[0]..=a[2] {
                for c in a[1]..=a[3] {
                    if not dug.contains((r, c)) {
                        whole = false;
                    }
                }
            }
            if whole {
                count += 1;
            }
        }
        count
    }
}

struct Solution {}

fn solution_dig_artifacts(n: i64, artifacts: Vec[Array[i64, 4]], dig: Vec[Array[i64, 2]]) -> i64 {
    let rows: Vec[Vec[i32]] = artifacts.iter().map(|a| a.iter().map(|x| x as i32).collect()).collect();
    let cells: Vec[Vec[i32]] = dig.iter().map(|d| d.iter().map(|x| x as i32).collect()).collect();
    Solution.dig_artifacts(n as i32, rows, cells)
}

// ---- the statement read literally

fn literal_whole(a: Array[i64, 4], dig: Vec[Array[i64, 2]]) -> bool {
    for r in a[0]..=a[2] {
        for c in a[1]..=a[3] {
            let mut found = false;
            for d in dig.iter() {
                if d[0] == r and d[1] == c {
                    found = true;
                }
            }
            if not found {
                return false;
            }
        }
    }
    true
}

fn literal(artifacts: Vec[Array[i64, 4]], dig: Vec[Array[i64, 2]]) -> i64 {
    let mut count = 0;
    for a in artifacts.iter() {
        if literal_whole(a, dig) {
            count += 1;
        }
    }
    count
}

fn answer(arm: i64, n: i64, artifacts: Vec[Array[i64, 4]], dig: Vec[Array[i64, 2]]) -> i64 {
    match arm {
        0 => star_dig_artifacts(n, artifacts, dig),
        1 => grid_dig_artifacts(n, artifacts, dig),
        2 => owner_dig_artifacts(n, artifacts, dig),
        3 => struct_dig_artifacts(n, artifacts, dig),
        4 => iter_dig_artifacts(n, artifacts, dig),
        _ => solution_dig_artifacts(n, artifacts, dig),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// up to `tries` artifacts placed at random on an n by n grid, each one of
// the eight shapes of at most 4 cells, dropped when it would overlap one
// already placed; and `digs` distinct cells dug at random
fn random_site(n: i64, tries: i64, digs: i64, seed: mut ref i64) -> (Vec[Array[i64, 4]], Vec[Array[i64, 2]]) {
    let shapes = [(1, 1), (1, 2), (2, 1), (2, 2), (1, 3), (3, 1), (1, 4), (4, 1)];
    let mut taken: Set[i64] = Set.new();
    let mut artifacts: Vec[Array[i64, 4]] = Vec.new();
    for _ in 0..tries {
        let (h, w) = shapes[next_random(mut seed) % 8];
        if h > n or w > n {
            continue;
        }
        let r = wide_random(mut seed) % (n - h + 1);
        let c = wide_random(mut seed) % (n - w + 1);
        let mut free = true;
        for i in r..(r + h) {
            for j in c..(c + w) {
                if taken.contains(i * n + j) {
                    free = false;
                }
            }
        }
        if free {
            for i in r..(r + h) {
                for j in c..(c + w) {
                    taken.insert(i * n + j);
                }
            }
            artifacts.push([r, c, r + h - 1, c + w - 1]);
        }
    }
    let mut dug: Set[i64] = Set.new();
    let mut dig: Vec[Array[i64, 2]] = Vec.new();
    while dig.len() < digs {
        let cell = wide_random(mut seed) % (n * n);
        if not dug.contains(cell) {
            dug.insert(cell);
            dig.push([cell / n, cell % n]);
        }
    }
    (artifacts, dig)
}

fn main() {
    let names = ["star", "grid", "owner", "struct", "iter", "solution"];
    let mut seed = 2201;
    let mut cases: Vec[(i64, Vec[Array[i64, 4]], Vec[Array[i64, 2]])] = Vec.new();
    for c in 0..360 {
        loop {
            let n = if c < 330 { next_random(mut seed) % 8 + 1 } else { next_random(mut seed) % 40 + 20 };
            let tries = if c < 330 { next_random(mut seed) % 10 + 1 } else { 30 };
            let digs = if c < 300 {
                next_random(mut seed) % (n * n) + 1
            } else if c < 330 {
                n * n
            } else {
                n * n / 2
            };
            let (artifacts, dig) = random_site(n, tries, digs, mut seed);
            if artifacts.len() > 0 {
                cases.push((n, artifacts, dig));
                break;
            }
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (n, artifacts, dig) in cases.iter() {
        let truth = literal(artifacts, dig);
        check = (check * 31 + truth + artifacts.len() * 7 + dig.len()) % 1000000007;
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, n, artifacts, dig)).collect();
        let reversed: Vec[Array[i64, 2]] = dig.iter().rev().collect();
        // a list literal a closure returns is a `Vec` (kara B-2026-11-15-38),
        // so each transposed row is a typed binding
        let flipped: Vec[Array[i64, 4]] = artifacts
            .iter()
            .map(|a| {
                let t: Array[i64, 4] = [a[1], a[0], a[3], a[2]];
                t
            })
            .collect();
        let flipped_dig: Vec[Array[i64, 2]] = dig
            .iter()
            .map(|d| {
                let t: Array[i64, 2] = [d[1], d[0]];
                t
            })
            .collect();
        let first = artifacts[0];
        let first_whole = literal_whole(first, dig);
        let mut more = dig.clone();
        for r in first[0]..=first[2] {
            for c in first[1]..=first[3] {
                if not more.contains([r, c]) {
                    more.push([r, c]);
                }
            }
        }
        let gain = if first_whole { 0 } else { 1 };
        for arm in 0..6 {
            let count = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == count {
                    same += 1;
                }
            }
            let verdicts = [
                count == truth,
                count >= 0 and count <= artifacts.len() and count <= dig.len(),
                answer(arm, n, artifacts, reversed) == count,
                answer(arm, n, flipped, flipped_dig) == count,
                answer(arm, n, artifacts, more) == count + gain,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"n {n}, {artifacts}, dig {dig} arm {names[arm]}: P{q + 1} fails, answered {count}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
