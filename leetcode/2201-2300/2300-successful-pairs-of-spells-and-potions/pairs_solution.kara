// LeetCode #2300: Successful Pairs of Spells and Potions -- LeetCode's
// Rust template as a Rust user fills it in, carried by `karac fix`:
// `mut potions: Vec<i32>` sorted in place with `sort_unstable`, and
// each spell `map`ped to the potions past a `partition_point`, the
// product taken in `i64`.

struct Solution {}

impl Solution {
    pub fn successful_pairs(spells: Vec[i32], potions: own Vec[i32], success: i64) -> Vec[i32] {
        let mut potions = potions;
        potions.sort();
        let m = potions.len();
        spells
            .iter()
            .map(|s| {
                let i = potions.partition_point(|p| (s as i64) * (p as i64) < success);
                (m - i) as i32
            })
            .collect()
    }
}

fn successful_pairs(spells: Vec[i64], potions: Vec[i64], success: i64) -> Vec[i64] {
    let s: Vec[i32] = spells.iter().map(|x| x as i32).collect();
    let p: Vec[i32] = potions.iter().map(|x| x as i32).collect();
    Solution.successful_pairs(s, p, success).iter().map(|x| x as i64).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then a success every pair reaches, one
    // only the largest pair reaches, at 10^5 * 10^5, and one no pair does
    let cases: Vec[(Vec[i64], Vec[i64], i64)] = [
        ([5, 1, 3], [1, 2, 3, 4, 5], 7),
        ([3, 1, 2], [8, 5, 8], 16),
        ([4, 9], [2, 7, 7], 1),
        ([100000, 99999, 1], [100000, 7, 100000], 10000000000),
        ([1, 2, 3], [1, 2], 7),
    ];
    for (spells, potions, success) in cases.iter() {
        println(f"{successful_pairs(spells, potions, success)}");
    }
    // 2000 random cases of 1 to 40 spells and 1 to 40 potions from 1 to
    // 50, and a success from 1 to 2600
    let mut seed = 2300;
    let mut check = 0;
    let mut sum = 0;
    for _ in 0..2000 {
        let mut spells: Vec[i64] = Vec.new();
        for _ in 0..next_random(mut seed) % 40 + 1 {
            spells.push(next_random(mut seed) % 50 + 1);
        }
        let mut potions: Vec[i64] = Vec.new();
        for _ in 0..next_random(mut seed) % 40 + 1 {
            potions.push(next_random(mut seed) % 50 + 1);
        }
        let success = next_random(mut seed) % 2600 + 1;
        for x in successful_pairs(spells, potions, success).iter() {
            check = (check * 31 + x) % 1000000007;
            sum += x;
        }
    }
    println(f"2000 cases: checksum {check}, sum {sum}");
}
