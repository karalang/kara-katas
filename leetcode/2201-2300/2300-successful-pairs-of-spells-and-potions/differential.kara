// LeetCode #2300: Successful Pairs of Spells and Potions -- the
// differential. The six arms, against the statement read literally:
// every pair of a spell and a potion is listed with its product, the
// successful ones kept, and each spell's answer is the number of kept
// pairs that name it. No sorting, no search, no table. 300 random cases
// of 1 to 30 spells and potions from 1 to 30 and a success from 1 to
// 500; then 30 whose success is the product of one of their pairs;
// then 30 of numbers up to 10^5 and a success up to 10^10. Every case
// is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  each answer is from 0 to the number of potions
// P3  the potions in reverse order: the same answer
// P4  a stronger spell has at least as many successful pairs
// P5  every spell and the success doubled: the same answer
// P6  each arm agrees with at least three of the other five

// ---- pairs.kara: the ★ arm, `partition_point` over the sorted potions
fn star_pairs(spells: Vec[i64], potions: Vec[i64], success: i64) -> Vec[i64] {
    let mut sorted = potions.clone();
    sorted.sort();
    let m = sorted.len();
    let mut out: Vec[i64] = Vec.new();
    for spell in spells.iter() {
        out.push(m - sorted.partition_point(|p| spell * p < success));
    }
    out
}

// ---- pairs_naive.kara: every pair tried
fn naive_pairs(spells: Vec[i64], potions: Vec[i64], success: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for spell in spells.iter() {
        let mut count = 0;
        for potion in potions.iter() {
            if spell * potion >= success {
                count += 1;
            }
        }
        out.push(count);
    }
    out
}

// ---- pairs_table.kara: a table of potions by strength
fn table_pairs(spells: Vec[i64], potions: Vec[i64], success: i64) -> Vec[i64] {
    let mut top = 0;
    for p in potions.iter() {
        top = top.max(p);
    }
    let mut at_least: Vec[i64] = Vec.filled(top + 2, 0);
    for p in potions.iter() {
        at_least[p] += 1;
    }
    for v in (0..=top).rev() {
        at_least[v] += at_least[v + 1];
    }
    let mut out: Vec[i64] = Vec.new();
    for spell in spells.iter() {
        let need = (success + spell - 1) / spell;
        out.push(if need > top { 0 } else { at_least[need] });
    }
    out
}

// ---- pairs_sweep.kara: two sorted walks
fn sweep_pairs(spells: Vec[i64], potions: Vec[i64], success: i64) -> Vec[i64] {
    let mut sorted = potions.clone();
    sorted.sort();
    let mut order: Vec[i64] = (0..spells.len()).collect();
    order.sort_by_key(|i| spells[i]);
    let mut out: Vec[i64] = Vec.filled(spells.len(), 0);
    let mut first = sorted.len();
    for i in order.iter() {
        while first > 0 and spells[i] * sorted[first - 1] >= success {
            first -= 1;
        }
        out[i] = sorted.len() - first;
    }
    out
}

// ---- pairs_struct.kara: `struct Shelf` and a binary search of its own
struct StructShelf {
    sorted: Vec[i64],
}

impl StructShelf {
    fn new(potions: Vec[i64]) -> StructShelf {
        let mut sorted = potions.clone();
        sorted.sort();
        StructShelf { sorted }
    }

    fn at_least(self, need: i64) -> i64 {
        let mut lo = 0;
        let mut hi = self.sorted.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.sorted[mid] < need {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        self.sorted.len() - lo
    }
}

fn struct_pairs(spells: Vec[i64], potions: Vec[i64], success: i64) -> Vec[i64] {
    let shelf = StructShelf.new(potions);
    spells.iter().map(|spell| shelf.at_least((success + spell - 1) / spell)).collect()
}

// ---- pairs_solution.kara: LeetCode's Rust template
struct Solution {}

impl Solution {
    pub fn successful_pairs(spells: Vec[i32], potions: own Vec[i32], success: i64) -> Vec[i32] {
        let mut potions = potions;
        potions.sort();
        let m = potions.len();
        spells
            .iter()
            .map(|s| {
                let i = potions.partition_point(|p| (s as i64) * (p as i64) < success);
                (m - i) as i32
            })
            .collect()
    }
}

fn solution_pairs(spells: Vec[i64], potions: Vec[i64], success: i64) -> Vec[i64] {
    let s: Vec[i32] = spells.iter().map(|x| x as i32).collect();
    let p: Vec[i32] = potions.iter().map(|x| x as i32).collect();
    Solution.successful_pairs(s, p, success).iter().map(|x| x as i64).collect()
}

// ---- the statement read literally

fn literal(spells: Vec[i64], potions: Vec[i64], success: i64) -> Vec[i64] {
    let mut kept: Vec[(i64, i64)] = Vec.new();
    for i in 0..spells.len() {
        for j in 0..potions.len() {
            let product = spells[i] * potions[j];
            if product >= success {
                kept.push((i, j));
            }
        }
    }
    let mut out: Vec[i64] = Vec.new();
    for i in 0..spells.len() {
        let mut count = 0;
        for (who, _) in kept.iter() {
            if who == i {
                count += 1;
            }
        }
        out.push(count);
    }
    out
}

fn answer(arm: i64, spells: Vec[i64], potions: Vec[i64], success: i64) -> Vec[i64] {
    match arm {
        0 => star_pairs(spells, potions, success),
        1 => naive_pairs(spells, potions, success),
        2 => table_pairs(spells, potions, success),
        3 => sweep_pairs(spells, potions, success),
        4 => struct_pairs(spells, potions, success),
        _ => solution_pairs(spells, potions, success),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "naive", "table", "sweep", "struct", "solution"];
    let mut seed = 2300;
    let mut cases: Vec[(Vec[i64], Vec[i64], i64)] = Vec.new();
    for c in 0..360 {
        let top = if c < 330 { 30 } else { 100000 };
        let mut spells: Vec[i64] = Vec.new();
        for _ in 0..next_random(mut seed) % 30 + 1 {
            spells.push((next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1);
        }
        let mut potions: Vec[i64] = Vec.new();
        for _ in 0..next_random(mut seed) % 30 + 1 {
            potions.push((next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1);
        }
        let success = if c < 300 {
            next_random(mut seed) % 500 + 1
        } else if c < 330 {
            spells[next_random(mut seed) % spells.len()] * potions[next_random(mut seed) % potions.len()]
        } else {
            ((next_random(mut seed) * 32768 + next_random(mut seed)) * 5 + next_random(mut seed) % 5) % 10000000000 + 1
        };
        cases.push((spells, potions, success));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (spells, potions, success) in cases.iter() {
        let truth = literal(spells, potions, success);
        for x in truth.iter() {
            check = (check * 31 + x) % 1000000007;
        }
        let reversed: Vec[i64] = potions.iter().rev().collect();
        let doubled: Vec[i64] = spells.iter().map(|x| 2 * x).collect();
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, spells, potions, success)).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let mut in_range = value.len() == spells.len();
            for x in value.iter() {
                in_range = in_range and x >= 0 and x <= potions.len();
            }
            let mut ordered = value.len() == spells.len();
            for i in 0..value.len() {
                for j in 0..value.len() {
                    if ordered and spells[i] < spells[j] and value[i] > value[j] {
                        ordered = false;
                    }
                }
            }
            let verdicts = [
                value == truth,
                in_range,
                answer(arm, spells, reversed, success) == value,
                ordered,
                answer(arm, doubled, potions, 2 * success) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{spells} {potions} {success} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
