// LeetCode #2246: Longest Path With Different Adjacent Characters --
// iterator chains: the child lists gathered by a `fold`, the tree's
// levels by `successors` (each level the `flat_map` of the one above),
// and the levels taken deepest first. Each node's two longest chains
// come from its children of another letter by `filter`, `map` and a
// `fold` keeping the top two; a level is answered whole before its
// chains are written back. O(n).

fn longest_path(parent: Vec[i64], s: String) -> i64 {
    let n = parent.len();
    let letters: Vec[char] = s.chars().collect();
    let children: Vec[Vec[i64]] = (1..n).fold(Vec.filled(n, Vec.new()), |lists: own Vec[Vec[i64]], v| {
        let mut lists = lists;
        lists[parent[v]].push(v);
        lists
    });
    let levels: Vec[Vec[i64]] = successors(Some([0].to_vec()), |level| {
        let below: Vec[i64] = level.iter().flat_map(|v| children[v].iter()).collect();
        if below.is_empty() { None } else { Some(below) }
    })
    .collect();
    let mut down: Vec[i64] = Vec.filled(n, 1);
    let mut best = 1;
    for level in levels.iter().rev() {
        let found: Vec[(i64, i64, i64)] = level
            .iter()
            .map(|v| {
                let (first, second) = children[v]
                    .iter()
                    .filter(|c| letters[c] != letters[v])
                    .map(|c| down[c])
                    .fold((0, 0), |(a, b), d| if d > a { (d, a) } else if d > b { (a, d) } else { (a, b) });
                (v, first, second)
            })
            .collect();
        best = best.max(found.iter().map(|(_, first, second)| first + second + 1).max().unwrap_or(1));
        for (v, first, _) in found.iter() {
            down[v] = first + 1;
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// a random tree of n nodes rooted at 0: the nodes in a shuffled order,
// node 0 first, each one's parent drawn from those before it
fn random_tree(seed: mut ref i64, n: i64, letters: i64) -> (Vec[i64], String) {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut order: Vec[i64] = (0..n).collect();
    for i in (2..n).rev() {
        let j = wide_random(mut seed) % i + 1;
        order.swap(i, j);
    }
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    for i in 1..n {
        parent[order[i]] = order[wide_random(mut seed) % i];
    }
    let mut s = String.new();
    for _ in 0..n {
        s.push(alphabet[next_random(mut seed) % letters]);
    }
    (parent, s)
}

fn main() {
    // LeetCode's two examples, then four more: one node, a path of one
    // letter, a path of two letters in turn, and a star
    let examples = [
        ([-1, 0, 0, 1, 1, 2].to_vec(), "abacbe"),
        ([-1, 0, 0, 0].to_vec(), "aabc"),
        ([-1].to_vec(), "z"),
        ([-1, 0, 1, 2].to_vec(), "aaaa"),
        ([-1, 0, 1, 2].to_vec(), "abab"),
        ([-1, 0, 0, 0, 0].to_vec(), "abcde"),
    ];
    for (parent, s) in examples.iter() {
        println(f"{parent} {s} -> {longest_path(parent, s.to_string())}");
    }
    // 2000 trees of 1 to 30 nodes and 1 to 4 letters
    let mut seed = 2246;
    let mut check = 0;
    let mut most = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 30 + 1;
        let letters = next_random(mut seed) % 4 + 1;
        let (parent, s) = random_tree(mut seed, n, letters);
        let longest = longest_path(parent, s);
        most = most.max(longest);
        check = (check * 31 + longest) % 1000000007;
    }
    println(f"2000 trees: longest {most}, checksum {check}");
    // the constraints' largest: 10^5 nodes, 26 letters; then a path of
    // 10^5 nodes, two letters in turn
    let (parent, s) = random_tree(mut seed, 100000, 26);
    println(f"10^5 nodes: {longest_path(parent, s)}");
    let parent: Vec[i64] = (0..100000).map(|i| i - 1).collect();
    let mut s = String.new();
    for i in 0..100000 {
        s.push(if i % 2 == 0 { 'a' } else { 'b' });
    }
    println(f"a path of 10^5: {longest_path(parent, s)}");
}
