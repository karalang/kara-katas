// LeetCode #2246: Longest Path With Different Adjacent Characters -- the
// benchmark's Kāra arm, path.kara: child lists, breadth-first order taken
// back to front, each node's two longest chains through children of
// another letter. O(n).

fn longest_path(parent: Vec[i64], s: String) -> i64 {
    let n = parent.len();
    let letters: Vec[char] = s.chars().collect();
    let mut children: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for v in 1..n {
        children[parent[v]].push(v);
    }
    let mut order: Vec[i64] = [0].to_vec();
    let mut next = 0;
    while next < order.len() {
        let v = order[next];
        next += 1;
        for c in children[v].iter() {
            order.push(c);
        }
    }
    let mut down: Vec[i64] = Vec.filled(n, 1);
    let mut best = 1;
    for v in order.iter().rev() {
        let mut first = 0;
        let mut second = 0;
        for c in children[v].iter() {
            if letters[c] == letters[v] {
                continue;
            }
            if down[c] > first {
                second = first;
                first = down[c];
            } else if down[c] > second {
                second = down[c];
            }
        }
        down[v] = first + 1;
        best = best.max(first + second + 1);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // 40 random trees of 10^5 nodes, each node's parent drawn from those
    // numbered before it, letters drawn from 26
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut seed = 2246;
    let mut check = 0;
    for _ in 0..40 {
        let mut parent: Vec[i64] = Vec.filled(100000, -1);
        for v in 1..100000 {
            parent[v] = wide_random(mut seed) % v;
        }
        let mut s = String.new();
        for _ in 0..100000 {
            s.push(alphabet[next_random(mut seed) % 26]);
        }
        check = (check * 31 + longest_path(parent, s)) % 1000000007;
    }
    println(f"40 trees of 100000 nodes: checksum {check}");
}
