// LeetCode #2258: Escape the Spreading Fire -- the field as a struct.
// `enum Cell { Grass, Fire, Wall }` in one flat `Vec` of a `struct
// Field`, cells named by their index; `neighbours` gives the grass
// cells beside one, `burn` the minute fire reaches each by a
// breadth-first search, and `escapes` a breadth-first search of the
// person who leaves after `wait`. The largest wait that escapes is found
// by a binary search that keeps `lo` escaping and narrows from above.
// O(mn log mn).

const NEVER: i64 = 1000000000000;

enum Cell {
    Grass,
    Fire,
    Wall,
}

struct Field {
    cells: Vec[Cell],
    m: i64,
    n: i64,
}

impl Field {
    fn from(grid: Vec[Vec[i64]]) -> Field {
        let mut cells: Vec[Cell] = Vec.new();
        for row in grid.iter() {
            for v in row.iter() {
                cells.push(match v {
                    0 => Cell.Grass,
                    1 => Cell.Fire,
                    _ => Cell.Wall,
                });
            }
        }
        Field { cells, m: grid.len(), n: grid[0].len() }
    }

    fn is_grass(ref self, at: i64) -> bool {
        match self.cells[at] {
            Cell.Grass => true,
            _ => false,
        }
    }

    fn neighbours(ref self, at: i64) -> Vec[i64] {
        let (r, c) = (at / self.n, at % self.n);
        let mut out: Vec[i64] = Vec.new();
        if r > 0 and self.is_grass(at - self.n) {
            out.push(at - self.n);
        }
        if r + 1 < self.m and self.is_grass(at + self.n) {
            out.push(at + self.n);
        }
        if c > 0 and self.is_grass(at - 1) {
            out.push(at - 1);
        }
        if c + 1 < self.n and self.is_grass(at + 1) {
            out.push(at + 1);
        }
        out
    }

    fn burn(ref self) -> Vec[i64] {
        let mut at: Vec[i64] = Vec.filled(self.cells.len(), NEVER);
        let mut queue: VecDeque[i64] = VecDeque.new();
        for i in 0..self.cells.len() {
            if let Cell.Fire = self.cells[i] {
                at[i] = 0;
                queue.push_back(i);
            }
        }
        while let Some(i) = queue.pop_front() {
            for j in self.neighbours(i) {
                if at[j] == NEVER {
                    at[j] = at[i] + 1;
                    queue.push_back(j);
                }
            }
        }
        at
    }

    fn escapes(ref self, fire: Vec[i64], wait: i64) -> bool {
        let home = self.cells.len() - 1;
        if wait >= fire[0] {
            return false;
        }
        let mut when: Vec[i64] = Vec.filled(self.cells.len(), -1);
        when[0] = wait;
        let mut queue: VecDeque[i64] = VecDeque.new();
        queue.push_back(0);
        while let Some(i) = queue.pop_front() {
            let t = when[i] + 1;
            for j in self.neighbours(i) {
                if j == home and t <= fire[j] {
                    return true;
                }
                if j != home and when[j] < 0 and t < fire[j] {
                    when[j] = t;
                    queue.push_back(j);
                }
            }
        }
        false
    }
}

fn maximum_minutes(grid: Vec[Vec[i64]]) -> i64 {
    let field = Field.from(grid);
    let fire = field.burn();
    let cells = field.cells.len();
    if not field.escapes(fire, 0) {
        return -1;
    }
    if field.escapes(fire, cells) {
        return 1000000000;
    }
    let mut (lo, hi) = (0, cells - 1);
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if field.escapes(fire, mid) {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// an m by n grid: each cell a wall one time in `walls` hundred, else
// grass; the two corners grass, and one fire on a cell between them
fn grid_of(seed: mut ref i64, m: i64, n: i64, walls: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            let roll = next_random(mut seed) % 100;
            row.push(if roll < walls { 2 } else { 0 });
        }
        grid.push(row);
    }
    grid[0][0] = 0;
    grid[m - 1][n - 1] = 0;
    let k = next_random(mut seed) % (m * n - 2) + 1;
    grid[k / n][k % n] = 1;
    grid
}

fn open_grid(m: i64, n: i64) -> Vec[Vec[i64]] {
    Vec.filled(m, Vec.filled(n, 0))
}

fn main() {
    // LeetCode's three examples, then four more: fire beside the start,
    // fire held back by a wall, fire that runs along the far side to the
    // safehouse first, and fire that comes from behind
    let examples: Vec[Vec[Vec[i64]]] = [
        [[0, 2, 0, 0, 0, 0, 0].to_vec(), [0, 0, 0, 2, 2, 1, 0].to_vec(), [0, 2, 0, 0, 1, 2, 0].to_vec(), [0, 0, 2, 2, 2, 0, 2].to_vec(), [0, 0, 0, 0, 0, 0, 0].to_vec()].to_vec(),
        [[0, 0, 0, 0].to_vec(), [0, 1, 2, 0].to_vec(), [0, 2, 0, 0].to_vec()].to_vec(),
        [[0, 0, 0].to_vec(), [2, 2, 0].to_vec(), [1, 2, 0].to_vec()].to_vec(),
        [[0, 1].to_vec(), [0, 0].to_vec()].to_vec(),
        [[0, 0, 0, 0].to_vec(), [0, 2, 0, 0].to_vec(), [0, 1, 2, 0].to_vec()].to_vec(),
        [[0, 0, 0, 0, 0].to_vec(), [2, 2, 2, 2, 0].to_vec(), [1, 0, 0, 0, 0].to_vec()].to_vec(),
        [[0, 0, 0, 0, 0, 0].to_vec(), [1, 2, 2, 2, 2, 0].to_vec()].to_vec(),
    ].to_vec();
    for grid in examples.iter() {
        println(f"{grid} -> {maximum_minutes(grid)}");
    }
    // 5000 grids of 2 to 11 by 2 to 11, a wall in 4 cells and one fire
    let mut seed = 2258;
    let mut counts = [0, 0, 0];
    let mut check = 0;
    for _ in 0..5000 {
        let m = next_random(mut seed) % 10 + 2;
        let n = next_random(mut seed) % 10 + 2;
        let grid = grid_of(mut seed, m, n, 25);
        let answer = maximum_minutes(grid);
        if answer == -1 {
            counts[0] += 1;
        } else if answer == 1000000000 {
            counts[2] += 1;
        } else {
            counts[1] += 1;
        }
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"5000 grids: {counts[0]} trapped, {counts[1]} with a wait, {counts[2]} never reached, checksum {check}");
    // the constraints' most cells, 2 * 10^4: 100 by 200 with the fire
    // in the bottom-left corner behind a wall that opens only beside the
    // start, so it chases the person; 2 by 10^4 with the fire under the
    // start; 300 by 66 as a winding corridor, the fire sealed in a pocket
    let mut answers: Vec[i64] = Vec.new();
    let mut chase = open_grid(100, 200);
    for r in 1..100 {
        chase[r][1] = 2;
    }
    chase[99][0] = 1;
    answers.push(maximum_minutes(chase));
    let mut strip = open_grid(2, 10000);
    strip[1][0] = 1;
    strip[1][1] = 2;
    answers.push(maximum_minutes(strip));
    let mut winding = open_grid(300, 66);
    let mut r = 1;
    while r < 299 {
        for c in 0..66 {
            winding[r][c] = 2;
        }
        winding[r][if (r / 2) % 2 == 0 { 63 } else { 0 }] = 0;
        r += 2;
    }
    winding[0][65] = 1;
    winding[0][64] = 2;
    answers.push(maximum_minutes(winding));
    println(f"2 * 10^4 cells: {answers}");
}
