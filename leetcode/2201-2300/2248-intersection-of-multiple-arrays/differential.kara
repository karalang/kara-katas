// LeetCode #2248: Intersection of Multiple Arrays -- the differential.
// The six arms, against the statement read literally: every value from
// 1 to 1000 tried in increasing order, and kept when a scan of each
// array finds it there; no counting, sets or sorting. 300 random cases
// of 1 to 5 arrays of 1 to 8 values from 1 to 12; then 30 whose arrays
// are all orderings of one set; then 30 of one array of up to 30 values
// from 1 to 1000. Every case is drawn before any arm answers.
//
// P1  the answer is the values in every array, read literally, in order
// P2  the arrays in reverse order, each one reversed: the same answer
// P3  a copy of the first array added: the same answer
// P4  every value v written 1001 - v: the answer mirrored the same way,
//     in order
// P5  the answer strictly increasing, and itself added as one more
//     array (or [1] when empty): the same answer
// P6  each arm agrees with at least three of the other five


// ---- common.kara: the ★ arm, a count for every value
fn star_intersection(nums: Vec[Vec[i64]]) -> Vec[i64] {
    let mut count: Vec[i64] = Vec.filled(1001, 0);
    for row in nums.iter() {
        for v in row.iter() {
            count[v] += 1;
        }
    }
    let mut common: Vec[i64] = Vec.new();
    for v in 1..1001 {
        if count[v] == nums.len() {
            common.push(v);
        }
    }
    common
}

// ---- common_set.kara: `Set.intersection`, then sorted
fn set_intersection(nums: Vec[Vec[i64]]) -> Vec[i64] {
    let mut common: Set[i64] = nums[0].iter().collect();
    for row in nums.iter().skip(1) {
        let here: Set[i64] = row.iter().collect();
        common = common.intersection(here);
    }
    let mut out: Vec[i64] = common.into_iter().collect();
    out.sort();
    out
}

// ---- common_merge.kara: sorted arrays merged with two indices
fn merge_merge_common(a: Vec[i64], b: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    let mut j = 0;
    while i < a.len() and j < b.len() {
        if a[i] < b[j] {
            i += 1;
        } else if a[i] > b[j] {
            j += 1;
        } else {
            out.push(a[i]);
            i += 1;
            j += 1;
        }
    }
    out
}

fn merge_intersection(nums: Vec[Vec[i64]]) -> Vec[i64] {
    let mut common = nums[0].clone();
    common.sort();
    for row in nums.iter().skip(1) {
        let mut sorted = row.clone();
        sorted.sort();
        common = merge_merge_common(common, sorted);
    }
    common
}

// ---- common_struct.kara: `Tally` over a `SortedMap`
struct StructTally {
    counts: SortedMap[i64, i64],
    arrays: i64,
}

impl StructTally {
    fn new() -> StructTally {
        StructTally { counts: SortedMap.new(), arrays: 0 }
    }

    fn add(mut ref self, row: Vec[i64]) {
        for v in row.iter() {
            self.counts[v] = self.counts.get(v).unwrap_or(0) + 1;
        }
        self.arrays += 1;
    }

    fn everywhere(ref self) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for (v, c) in self.counts.iter() {
            if c == self.arrays {
                out.push(v);
            }
        }
        out
    }
}

fn struct_intersection(nums: Vec[Vec[i64]]) -> Vec[i64] {
    let mut tally = StructTally.new();
    for row in nums.iter() {
        tally.add(row);
    }
    tally.everywhere()
}

// ---- common_iter.kara: `filter`, `all` and `contains`
fn iter_intersection(nums: Vec[Vec[i64]]) -> Vec[i64] {
    let mut common: Vec[i64] = nums[0].iter().filter(|v| nums.iter().all(|row| row.contains(v))).collect();
    common.sort();
    common
}

// ---- common_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn intersection(nums: Vec[Vec[i32]]) -> Vec[i32] {
        let n = nums.len();
        let mut cnt = Map.new();
        for arr in ref nums {
            for x in arr {
                *cnt.entry(x).or_insert(0) += 1;
            }
        }
        let mut ans: Vec[i32] = cnt.into_iter().filter(|(_, c)| c == n).map(|(x, _)| x).collect();
        ans.sort();
        ans
    }
}

struct Solution {}

fn solution_intersection(nums: Vec[Vec[i64]]) -> Vec[i64] {
    let nums: Vec[Vec[i32]] = nums.iter().map(|row| row.iter().map(|x| x as i32).collect()).collect();
    Solution.intersection(nums).iter().map(|x| x as i64).collect()
}

// ---- the statement read literally

fn literal(nums: Vec[Vec[i64]]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for v in 1..1001 {
        let mut everywhere = true;
        for row in nums.iter() {
            let mut here = false;
            for x in row.iter() {
                if x == v {
                    here = true;
                }
            }
            if not here {
                everywhere = false;
            }
        }
        if everywhere {
            out.push(v);
        }
    }
    out
}

fn answer(arm: i64, nums: Vec[Vec[i64]]) -> Vec[i64] {
    match arm {
        0 => star_intersection(nums),
        1 => set_intersection(nums),
        2 => merge_intersection(nums),
        3 => struct_intersection(nums),
        4 => iter_intersection(nums),
        _ => solution_intersection(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_row(seed: mut ref i64, count: i64, top: i64) -> Vec[i64] {
    let mut values: Vec[i64] = (1..top + 1).collect();
    for i in (1..values.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        values.swap(i, j);
    }
    values.truncate(count);
    values
}

fn fold_list(values: Vec[i64]) -> i64 {
    values.iter().fold(values.len(), |acc, v| (acc * 1009 + v) % 1000000007)
}

fn main() {
    let names = ["star", "set", "merge", "struct", "iter", "solution"];
    let mut seed = 2248;
    let mut cases: Vec[Vec[Vec[i64]]] = Vec.new();
    for c in 0..360 {
        let mut nums: Vec[Vec[i64]] = Vec.new();
        if c < 300 {
            let rows = next_random(mut seed) % 5 + 1;
            for _ in 0..rows {
                let count = next_random(mut seed) % 8 + 1;
                nums.push(random_row(mut seed, count, 12));
            }
        } else if c < 330 {
            let rows = next_random(mut seed) % 5 + 1;
            let count = next_random(mut seed) % 8 + 1;
            let first = random_row(mut seed, count, 12);
            for _ in 0..rows {
                let mut row = first.clone();
                for i in (1..row.len()).rev() {
                    let j = next_random(mut seed) % (i + 1);
                    row.swap(i, j);
                }
                nums.push(row);
            }
        } else {
            let count = next_random(mut seed) % 30 + 1;
            nums.push(random_row(mut seed, count, 1000));
        }
        cases.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for nums in cases.iter() {
        let truth = literal(nums);
        check = (check * 31 + fold_list(truth)) % 1000000007;
        let reversed: Vec[Vec[i64]] = nums.iter().rev().map(|row| row.iter().rev().collect()).collect();
        let mut copied = nums.clone();
        copied.push(nums[0].clone());
        let mirrored: Vec[Vec[i64]] = nums.iter().map(|row| row.iter().map(|v| 1001 - v).collect()).collect();
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let expect_mirror: Vec[i64] = value.iter().rev().map(|v| 1001 - v).collect();
            let mut with_answer = nums.clone();
            with_answer.push(if value.is_empty() { [1].to_vec() } else { value.clone() });
            let mut increasing = true;
            for i in 1..value.len() {
                if value[i] <= value[i - 1] {
                    increasing = false;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, reversed) == value,
                answer(arm, copied) == value,
                answer(arm, mirrored) == expect_mirror,
                increasing and answer(arm, with_answer) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
