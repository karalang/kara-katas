// LeetCode #2248: Intersection of Multiple Arrays -- LeetCode's Rust
// template: `Vec<Vec<i32>>` in, `Vec<i32>` out, a `HashMap` of counts
// filled by `*cnt.entry(x).or_insert(0) += 1` over `for &x in arr`, then
// `into_iter().filter(|&(_, c)| c == n).map(|(x, _)| x)` and a sort.
// Carried by `karac fix`. The adapter below hands the harness's values
// to it.

impl Solution {
    pub fn intersection(nums: Vec[Vec[i32]]) -> Vec[i32] {
        let n = nums.len();
        let mut cnt = Map.new();
        for arr in ref nums {
            for x in arr {
                *cnt.entry(x).or_insert(0) += 1;
            }
        }
        let mut ans: Vec[i32] = cnt.into_iter().filter(|(_, c)| c == n).map(|(x, _)| x).collect();
        ans.sort();
        ans
    }
}

struct Solution {}

fn intersection(nums: Vec[Vec[i64]]) -> Vec[i64] {
    let nums: Vec[Vec[i32]] = nums.iter().map(|row| row.iter().map(|x| x as i32).collect()).collect();
    Solution.intersection(nums).iter().map(|x| x as i64).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` distinct values from 1 to `top`, in a shuffled order
fn random_row(seed: mut ref i64, count: i64, top: i64) -> Vec[i64] {
    let mut values: Vec[i64] = (1..top + 1).collect();
    for i in (1..values.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        values.swap(i, j);
    }
    values.truncate(count);
    values
}

fn fold_list(values: Vec[i64]) -> i64 {
    values.iter().fold(values.len(), |acc, v| (acc * 1009 + v) % 1000000007)
}

fn main() {
    // LeetCode's two examples, then four more: one array, three alike,
    // the ends of the range, and two arrays sharing everything
    let examples = [
        [[3, 1, 2, 4, 5].to_vec(), [1, 2, 3, 4].to_vec(), [3, 4, 5, 6].to_vec()].to_vec(),
        [[1, 2, 3].to_vec(), [4, 5, 6].to_vec()].to_vec(),
        [[5, 1, 3].to_vec()].to_vec(),
        [[7].to_vec(), [7].to_vec(), [7].to_vec()].to_vec(),
        [[1000, 1].to_vec(), [1, 500, 1000].to_vec()].to_vec(),
        [[9, 8, 7].to_vec(), [7, 9, 8].to_vec()].to_vec(),
    ];
    for nums in examples.iter() {
        println(f"{nums} -> {intersection(nums)}");
    }
    // 2000 cases of 1 to 6 arrays of 1 to 12 values from 1 to 20
    let mut seed = 2248;
    let mut found = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let rows = next_random(mut seed) % 6 + 1;
        let nums: Vec[Vec[i64]] = (0..rows).map(|_| {
            let count = next_random(mut seed) % 12 + 1;
            random_row(mut seed, count, 20)
        }).collect();
        let common = intersection(nums);
        found += common.len();
        check = (check * 31 + fold_list(common)) % 1000000007;
    }
    println(f"2000 cases: {found} values in common, checksum {check}");
    // the constraints' largest: one array of all 1000 values; 1000
    // arrays of one value; 10 arrays of 100 values from 1 to 120
    let whole = [random_row(mut seed, 1000, 1000)].to_vec();
    println(f"one array of 1000: checksum {fold_list(intersection(whole))}");
    let singles: Vec[Vec[i64]] = (0..1000).map(|_| [999].to_vec()).collect();
    println(f"1000 arrays of one: {intersection(singles)}");
    let tens: Vec[Vec[i64]] = (0..10).map(|_| random_row(mut seed, 100, 120)).collect();
    println(f"10 arrays of 100: {intersection(tens)}");
}
