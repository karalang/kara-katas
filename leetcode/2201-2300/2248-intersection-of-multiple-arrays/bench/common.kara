// LeetCode #2248: Intersection of Multiple Arrays -- the benchmark's
// Kāra arm, common.kara: a count for every value from 1 to 1000, kept
// where it reaches the number of arrays. O(total + 1000).

fn intersection(nums: Vec[Vec[i64]]) -> Vec[i64] {
    let mut count: Vec[i64] = Vec.filled(1001, 0);
    for row in nums.iter() {
        for v in row.iter() {
            count[v] += 1;
        }
    }
    let mut common: Vec[i64] = Vec.new();
    for v in 1..1001 {
        if count[v] == nums.len() {
            common.push(v);
        }
    }
    common
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20000 cases of 10 arrays, each 100 distinct values from 1 to 150
    // drawn by a partial shuffle
    let mut seed = 2248;
    let mut check = 0;
    let mut pool: Vec[i64] = (1..151).collect();
    for _ in 0..20000 {
        let mut nums: Vec[Vec[i64]] = Vec.new();
        for _ in 0..10 {
            for i in 0..100 {
                let j = i + next_random(mut seed) % (150 - i);
                pool.swap(i, j);
            }
            nums.push(pool[0..100].to_vec());
        }
        let common = intersection(nums);
        check = (check * 31 + common.iter().fold(common.len(), |acc, v| (acc * 1009 + v) % 1000000007)) % 1000000007;
    }
    println(f"20000 cases: checksum {check}");
}
