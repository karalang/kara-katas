// LeetCode #2231: Largest Number After Digit Swaps by Parity -- LeetCode's
// Rust template: `i32` in and out, the digits as bytes through
// `num.to_string().into_bytes()`, each parity's `filter(|&&c| (c - b'0')
// % 2 == 1)` `cloned` and sorted largest first by `sort_unstable_by(|a,
// b| b.cmp(a))`, written back over the bytes through `iter_mut()` and
// `*c = ...`, and parsed back with `String::from_utf8(d).unwrap()
// .parse().unwrap()`. Carried by `karac fix`. The adapter below hands
// the harness's values to it.

impl Solution {
    pub fn largest_integer(num: i32) -> i32 {
        let mut d: Vec[u8] = num.to_string().bytes().to_vec();
        let mut odd: Vec[u8] = d.iter().filter(|c| (c - b'0') % 2 == 1).cloned().collect();
        let mut even: Vec[u8] = d.iter().filter(|c| (c - b'0') % 2 == 0).cloned().collect();
        odd.sort_by(|a, b| b.cmp(a));
        even.sort_by(|a, b| b.cmp(a));
        let mut (i, j) = (0, 0);
        for c in d.iter_mut() {
            if (*c - b'0') % 2 == 1 {
                *c = odd[i];
                i += 1;
            } else {
                *c = even[j];
                j += 1;
            }
        }
        i32.parse(String.from_utf8(d).unwrap()).unwrap()
    }
}

struct Solution {}

fn largest_integer(num: i64) -> i64 {
    Solution.largest_integer(num as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples, then six more: one digit, the largest num,
    // evens around an odd, a 0 that must stay low, all of one parity, and
    // every digit once
    for num in [1234, 65875, 1, 1000000000, 247, 10, 86420, 123456789] {
        println(f"{num} -> {largest_integer(num)}");
    }
    // 3000 random nums of 1 to 10^9, as many with up to 4, 7 and 10 digits
    let mut seed = 2231;
    let mut check = 0;
    for c in 0..3000 {
        let num = wide_random(mut seed) % [10000, 10000000, 1000000000][c % 3] + 1;
        check = (check * 31 + largest_integer(num)) % 1000000007;
    }
    println(f"3000 nums: checksum {check}");
    // every num from 1 to 10^5
    let mut total = 0;
    for num in 1..=100000 {
        total += largest_integer(num) - num;
    }
    println(f"1 to 10^5: the swaps add {total} in all");
}
