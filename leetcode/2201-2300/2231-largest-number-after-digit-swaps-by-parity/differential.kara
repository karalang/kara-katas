// LeetCode #2231: Largest Number After Digit Swaps by Parity -- the
// differential. The six arms, against the statement read literally:
// every number reachable from num by swapping two digits of one parity,
// again and again, found by a search from num, and the largest of them;
// no sorting. 300 random nums of 1 to 6 digits; then 30 of odd digits
// only; then 30 whose digits alternate odd and even. Every case is drawn
// before any arm answers.
//
// P1  the answer is the statement read literally
// P2  it is at least num, has num's digits, and each place keeps its
//     digit's parity
// P3  the answer's own answer: itself
// P4  num * 10: the answer * 10, the 0 staying last
// P5  a 9 written before num: the answer with the 9 still before it
// P6  each arm agrees with at least three of the other five


// ---- parity.kara: the ★ arm, each parity's digits sorted into its places
fn star_largest_integer(num: i64) -> i64 {
    let digits: Vec[i64] = f"{num}".chars().map(|c| (c as i64) - 48).collect();
    let mut odd: Vec[i64] = Vec.new();
    let mut even: Vec[i64] = Vec.new();
    for d in digits.iter() {
        if d % 2 == 1 {
            odd.push(d);
        } else {
            even.push(d);
        }
    }
    odd.sort();
    even.sort();
    // the largest of each kind is now last, so each place pops its kind
    let mut largest = 0;
    for d in digits.iter() {
        let next = if d % 2 == 1 { odd.pop().unwrap() } else { even.pop().unwrap() };
        largest = largest * 10 + next;
    }
    largest
}

// ---- parity_counts.kara: a count of each digit, no sort
fn counts_largest_integer(num: i64) -> i64 {
    let mut count = Vec.filled(10, 0);
    let mut places: Vec[i64] = Vec.new();
    let mut rest = num;
    while rest > 0 {
        count[rest % 10] += 1;
        places.push(rest % 10);
        rest /= 10;
    }
    let mut largest = 0;
    for i in (0..places.len()).rev() {
        // the largest digit left of the parity of the one at this place
        let mut d = 9 - (1 - places[i] % 2);
        while count[d] == 0 {
            d -= 2;
        }
        count[d] -= 1;
        largest = largest * 10 + d;
    }
    largest
}

// ---- parity_swaps.kara: a selection sort by swaps within a parity
fn swaps_largest_integer(num: i64) -> i64 {
    let mut digits: Vec[char] = f"{num}".chars().collect();
    let n = digits.len();
    for i in 0..n {
        let mut best = i;
        for j in i + 1..n {
            let same = (digits[j] as i64) % 2 == (digits[i] as i64) % 2;
            if same and digits[j] > digits[best] {
                best = j;
            }
        }
        digits.swap(i, best);
    }
    let text: String = digits.iter().collect();
    i64.parse(text).unwrap()
}

// ---- parity_struct.kara: `Piles`, a `PriorityQueue` for each parity
struct Piles {
    odd: PriorityQueue[i64],
    even: PriorityQueue[i64],
}

impl Piles {
    fn new() -> Piles {
        Piles { odd: PriorityQueue.max_first(), even: PriorityQueue.max_first() }
    }

    fn add(mut ref self, d: i64) {
        if d % 2 == 1 {
            self.odd.push(d);
        } else {
            self.even.push(d);
        }
    }

    fn take(mut ref self, like: i64) -> i64 {
        if like % 2 == 1 {
            self.odd.pop().unwrap()
        } else {
            self.even.pop().unwrap()
        }
    }
}

fn struct_largest_integer(num: i64) -> i64 {
    let digits: Vec[i64] = f"{num}".bytes().iter().map(|b| (b - 48) as i64).collect();
    let mut piles = Piles.new();
    for d in digits.iter() {
        piles.add(d);
    }
    let mut largest = 0;
    for d in digits.iter() {
        largest = largest * 10 + piles.take(d);
    }
    largest
}

// ---- parity_iter.kara: `filter`, `rev`, `next` and `fold`
fn iter_largest_integer(num: i64) -> i64 {
    let digits: Vec[i64] = f"{num}".chars().map(|c| (c as i64) - 48).collect();
    let mut odd: Vec[i64] = digits.iter().filter(|d| d % 2 == 1).collect();
    let mut even: Vec[i64] = digits.iter().filter(|d| d % 2 == 0).collect();
    odd.sort();
    even.sort();
    let mut odds = odd.iter().rev();
    let mut evens = even.iter().rev();
    digits.iter().map(|d| if d % 2 == 1 { odds.next().unwrap() } else { evens.next().unwrap() }).fold(0, |acc, d| acc * 10 + d)
}

// ---- parity_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn largest_integer(num: i32) -> i32 {
        let mut d: Vec[u8] = num.to_string().bytes().to_vec();
        let mut odd: Vec[u8] = d.iter().filter(|c| (c - b'0') % 2 == 1).cloned().collect();
        let mut even: Vec[u8] = d.iter().filter(|c| (c - b'0') % 2 == 0).cloned().collect();
        odd.sort_by(|a, b| b.cmp(a));
        even.sort_by(|a, b| b.cmp(a));
        let mut (i, j) = (0, 0);
        for c in d.iter_mut() {
            if (*c - b'0') % 2 == 1 {
                *c = odd[i];
                i += 1;
            } else {
                *c = even[j];
                j += 1;
            }
        }
        i32.parse(String.from_utf8(d).unwrap()).unwrap()
    }
}

struct Solution {}

fn solution_largest_integer(num: i64) -> i64 {
    Solution.largest_integer(num as i32)
}

// ---- the statement read literally

fn literal(num: i64) -> i64 {
    let start = f"{num}";
    let mut seen: Set[String] = Set.new();
    let mut queue: Vec[String] = [start.clone()].to_vec();
    seen.insert(start);
    let mut best = num;
    let mut head = 0;
    while head < queue.len() {
        let here: Vec[char] = queue[head].chars().collect();
        head += 1;
        let text: String = here.iter().collect();
        let value = i64.parse(text).unwrap();
        best = best.max(value);
        for i in 0..here.len() {
            for j in i + 1..here.len() {
                if (here[i] as i64) % 2 == (here[j] as i64) % 2 {
                    let mut next = here.clone();
                    next.swap(i, j);
                    let text: String = next.iter().collect();
                    if not seen.contains(text) {
                        seen.insert(text.clone());
                        queue.push(text);
                    }
                }
            }
        }
    }
    best
}

fn answer(arm: i64, num: i64) -> i64 {
    match arm {
        0 => star_largest_integer(num),
        1 => counts_largest_integer(num),
        2 => swaps_largest_integer(num),
        3 => struct_largest_integer(num),
        4 => iter_largest_integer(num),
        _ => solution_largest_integer(num),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the digits of `num` in increasing order
fn sorted_digits(num: i64) -> Vec[char] {
    let mut digits: Vec[char] = f"{num}".chars().collect();
    digits.sort();
    digits
}

fn main() {
    let names = ["star", "counts", "swaps", "struct", "iter", "solution"];
    let mut seed = 2231;
    let mut cases: Vec[i64] = Vec.new();
    for c in 0..360 {
        let n = next_random(mut seed) % 6 + 1;
        let mut num = 0;
        for i in 0..n {
            let mut d = next_random(mut seed) % 10;
            if c >= 300 and c < 330 {
                d = d / 2 * 2 + 1;
            } else if c >= 330 {
                d = d / 2 * 2 + i % 2;
            }
            if i == 0 and d == 0 {
                d = 2;
            }
            num = num * 10 + d;
        }
        cases.push(num);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for num in cases.iter() {
        let truth = literal(num);
        check = (check * 31 + truth) % 1000000007;
        let places: Vec[char] = f"{num}".chars().collect();
        let mut nine = 9;
        for _ in 0..places.len() {
            nine *= 10;
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, num)).collect();
        for arm in 0..6 {
            let largest = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == largest {
                    same += 1;
                }
            }
            let written: Vec[char] = f"{largest}".chars().collect();
            let mut shaped = largest >= num and sorted_digits(largest) == sorted_digits(num) and written.len() == places.len();
            for i in 0..written.len().min(places.len()) {
                shaped = shaped and (written[i] as i64) % 2 == (places[i] as i64) % 2;
            }
            let verdicts = [
                largest == truth,
                shaped,
                answer(arm, largest) == largest,
                answer(arm, num * 10) == largest * 10,
                answer(arm, nine + num) == nine + largest,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{num} arm {names[arm]}: P{q + 1} fails, gave {largest}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
