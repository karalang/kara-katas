// LeetCode #2231: Largest Number After Digit Swaps by Parity -- the swaps
// themselves: a selection sort over the digits, each place from the left
// taking the largest digit of its parity anywhere to its right, by one
// swap. Each swap trades two digits of one parity, as the statement
// allows. O(d^2).

fn largest_integer(num: i64) -> i64 {
    let mut digits: Vec[char] = f"{num}".chars().collect();
    let n = digits.len();
    for i in 0..n {
        let mut best = i;
        for j in i + 1..n {
            let same = (digits[j] as i64) % 2 == (digits[i] as i64) % 2;
            if same and digits[j] > digits[best] {
                best = j;
            }
        }
        digits.swap(i, best);
    }
    let text: String = digits.iter().collect();
    i64.parse(text).unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples, then six more: one digit, the largest num,
    // evens around an odd, a 0 that must stay low, all of one parity, and
    // every digit once
    for num in [1234, 65875, 1, 1000000000, 247, 10, 86420, 123456789] {
        println(f"{num} -> {largest_integer(num)}");
    }
    // 3000 random nums of 1 to 10^9, as many with up to 4, 7 and 10 digits
    let mut seed = 2231;
    let mut check = 0;
    for c in 0..3000 {
        let num = wide_random(mut seed) % [10000, 10000000, 1000000000][c % 3] + 1;
        check = (check * 31 + largest_integer(num)) % 1000000007;
    }
    println(f"3000 nums: checksum {check}");
    // every num from 1 to 10^5
    let mut total = 0;
    for num in 1..=100000 {
        total += largest_integer(num) - num;
    }
    println(f"1 to 10^5: the swaps add {total} in all");
}
