// LeetCode #2231: Largest Number After Digit Swaps by Parity -- `Piles`,
// one `PriorityQueue` of digits for each parity, filled from the number
// with `add`; `take` hands each place the largest left of its parity.
// O(d log d).

struct Piles {
    odd: PriorityQueue[i64],
    even: PriorityQueue[i64],
}

impl Piles {
    fn new() -> Piles {
        Piles { odd: PriorityQueue.max_first(), even: PriorityQueue.max_first() }
    }

    fn add(mut ref self, d: i64) {
        if d % 2 == 1 {
            self.odd.push(d);
        } else {
            self.even.push(d);
        }
    }

    fn take(mut ref self, like: i64) -> i64 {
        if like % 2 == 1 {
            self.odd.pop().unwrap()
        } else {
            self.even.pop().unwrap()
        }
    }
}

fn largest_integer(num: i64) -> i64 {
    let digits: Vec[i64] = f"{num}".bytes().iter().map(|b| (b - 48) as i64).collect();
    let mut piles = Piles.new();
    for d in digits.iter() {
        piles.add(d);
    }
    let mut largest = 0;
    for d in digits.iter() {
        largest = largest * 10 + piles.take(d);
    }
    largest
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples, then six more: one digit, the largest num,
    // evens around an odd, a 0 that must stay low, all of one parity, and
    // every digit once
    for num in [1234, 65875, 1, 1000000000, 247, 10, 86420, 123456789] {
        println(f"{num} -> {largest_integer(num)}");
    }
    // 3000 random nums of 1 to 10^9, as many with up to 4, 7 and 10 digits
    let mut seed = 2231;
    let mut check = 0;
    for c in 0..3000 {
        let num = wide_random(mut seed) % [10000, 10000000, 1000000000][c % 3] + 1;
        check = (check * 31 + largest_integer(num)) % 1000000007;
    }
    println(f"3000 nums: checksum {check}");
    // every num from 1 to 10^5
    let mut total = 0;
    for num in 1..=100000 {
        total += largest_integer(num) - num;
    }
    println(f"1 to 10^5: the swaps add {total} in all");
}
