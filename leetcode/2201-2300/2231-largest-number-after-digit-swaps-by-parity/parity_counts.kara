// LeetCode #2231: Largest Number After Digit Swaps by Parity -- a count
// of each digit 0 to 9, no sort: each place, from the left, takes the
// largest digit of its own parity still counted. The digits are read off
// by division, least significant first, and written back from the left.
// O(d * 10).

fn largest_integer(num: i64) -> i64 {
    let mut count = Vec.filled(10, 0);
    let mut places: Vec[i64] = Vec.new();
    let mut rest = num;
    while rest > 0 {
        count[rest % 10] += 1;
        places.push(rest % 10);
        rest /= 10;
    }
    let mut largest = 0;
    for i in (0..places.len()).rev() {
        // the largest digit left of the parity of the one at this place
        let mut d = 9 - (1 - places[i] % 2);
        while count[d] == 0 {
            d -= 2;
        }
        count[d] -= 1;
        largest = largest * 10 + d;
    }
    largest
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples, then six more: one digit, the largest num,
    // evens around an odd, a 0 that must stay low, all of one parity, and
    // every digit once
    for num in [1234, 65875, 1, 1000000000, 247, 10, 86420, 123456789] {
        println(f"{num} -> {largest_integer(num)}");
    }
    // 3000 random nums of 1 to 10^9, as many with up to 4, 7 and 10 digits
    let mut seed = 2231;
    let mut check = 0;
    for c in 0..3000 {
        let num = wide_random(mut seed) % [10000, 10000000, 1000000000][c % 3] + 1;
        check = (check * 31 + largest_integer(num)) % 1000000007;
    }
    println(f"3000 nums: checksum {check}");
    // every num from 1 to 10^5
    let mut total = 0;
    for num in 1..=100000 {
        total += largest_integer(num) - num;
    }
    println(f"1 to 10^5: the swaps add {total} in all");
}
