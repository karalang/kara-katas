// LeetCode #2231: Largest Number After Digit Swaps by Parity -- digits of
// one parity can be put in any order among their own places, so the odd
// digits are sorted from largest down into the odd digits' places and the
// even ones likewise into theirs. O(d log d) for d digits.

fn largest_integer(num: i64) -> i64 {
    let digits: Vec[i64] = f"{num}".chars().map(|c| (c as i64) - 48).collect();
    let mut odd: Vec[i64] = Vec.new();
    let mut even: Vec[i64] = Vec.new();
    for d in digits.iter() {
        if d % 2 == 1 {
            odd.push(d);
        } else {
            even.push(d);
        }
    }
    odd.sort();
    even.sort();
    // the largest of each kind is now last, so each place pops its kind
    let mut largest = 0;
    for d in digits.iter() {
        let next = if d % 2 == 1 { odd.pop().unwrap() } else { even.pop().unwrap() };
        largest = largest * 10 + next;
    }
    largest
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 2231;
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        nums.push(wide_random(mut seed) % 1000000000 + 1);
    }
    let mut check = 0;
    for _ in 0..20 {
        // punch: one num drawn again before each pass over all of them
        let at = wide_random(mut seed) % 100000;
        nums[at] = wide_random(mut seed) % 1000000000 + 1;
        for num in nums.iter() {
            check = (check * 31 + largest_integer(num)) % 1000000007;
        }
    }
    println(f"20 passes over 10^5 nums: checksum {check}");
}
