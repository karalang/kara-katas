// LeetCode #2231: Largest Number After Digit Swaps by Parity -- the odd
// and even digits split by `filter` and sorted largest first with `rev`,
// then each place drawing from its own `iter` and the number `fold`ed
// back together. O(d log d).

fn largest_integer(num: i64) -> i64 {
    let digits: Vec[i64] = f"{num}".chars().map(|c| (c as i64) - 48).collect();
    let mut odd: Vec[i64] = digits.iter().filter(|d| d % 2 == 1).collect();
    let mut even: Vec[i64] = digits.iter().filter(|d| d % 2 == 0).collect();
    odd.sort();
    even.sort();
    let mut odds = odd.iter().rev();
    let mut evens = even.iter().rev();
    digits.iter().map(|d| if d % 2 == 1 { odds.next().unwrap() } else { evens.next().unwrap() }).fold(0, |acc, d| acc * 10 + d)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples, then six more: one digit, the largest num,
    // evens around an odd, a 0 that must stay low, all of one parity, and
    // every digit once
    for num in [1234, 65875, 1, 1000000000, 247, 10, 86420, 123456789] {
        println(f"{num} -> {largest_integer(num)}");
    }
    // 3000 random nums of 1 to 10^9, as many with up to 4, 7 and 10 digits
    let mut seed = 2231;
    let mut check = 0;
    for c in 0..3000 {
        let num = wide_random(mut seed) % [10000, 10000000, 1000000000][c % 3] + 1;
        check = (check * 31 + largest_integer(num)) % 1000000007;
    }
    println(f"3000 nums: checksum {check}");
    // every num from 1 to 10^5
    let mut total = 0;
    for num in 1..=100000 {
        total += largest_integer(num) - num;
    }
    println(f"1 to 10^5: the swaps add {total} in all");
}
