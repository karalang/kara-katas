// LeetCode #2272: Substring With Largest Variance -- the ★ arm. For each
// ordered pair of letters in the string, `a` counted up and `b` down,
// the variance is the largest sum of a substring holding at least one
// `b`. Kadane's scan carries two sums ending at each letter: `diff`, the
// best with or without a `b`, never below 0, and `with_b`, the best
// holding a `b`. O(k^2 n) for k letters used.

fn largest_variance(s: String) -> i64 {
    let bytes = s.bytes();
    let mut seen = [false; 26];
    for c in bytes.iter() {
        seen[c - b'a'] = true;
    }
    let mut best = 0;
    for a in b'a'..=b'z' {
        for b in b'a'..=b'z' {
            if a == b or not seen[a - b'a'] or not seen[b - b'a'] {
                continue;
            }
            let mut diff = 0;
            let mut with_b = i64.MIN / 2;
            for c in bytes.iter() {
                if c == a {
                    diff += 1;
                    with_b += 1;
                } else if c == b {
                    with_b = diff - 1;
                    diff = (diff - 1).max(0);
                }
                best = best.max(with_b);
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `len` letters from the first `k` of the alphabet
fn letters(seed: mut ref i64, len: i64, k: i64) -> String {
    let mut s = String.new();
    for _ in 0..len {
        s.push((b'a' + (next_random(mut seed) % k) as u8) as char);
    }
    s
}

fn main() {
    // LeetCode's two examples, then five more: two letters, one letter
    // with a single other, a run interrupted, a b at either end, and two
    // letters alternating
    for s in ["aababbb", "abcde", "ab", "aaaab", "aaabaaa", "baaaab", "abababab"] {
        println(f"{s} -> {largest_variance(s.to_string())}");
    }
    // 2000 strings of 1 to 40 letters from the first 2, 3, 5 or 26
    let mut seed = 2272;
    let mut check = 0;
    for t in 0..2000 {
        let len = next_random(mut seed) % 40 + 1;
        let s = letters(mut seed, len, [2, 3, 5, 26][t % 4]);
        check = (check * 31 + largest_variance(s)) % 1000000007;
    }
    println(f"2000 strings: checksum {check}");
    // the constraints' longest, 10^4 letters: random from the first 5, `a`
    // with one `b` in the middle, and random from the first 3
    let random = letters(mut seed, 10000, 5);
    let lone = f"{"a".repeat(5000)}b{"a".repeat(4999)}";
    let three = letters(mut seed, 10000, 3);
    let answers = [largest_variance(random), largest_variance(lone), largest_variance(three)];
    println(f"10^4 letters: {answers}");
}
