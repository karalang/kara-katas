// LeetCode #2210: Count Hills and Valleys in an Array -- the dedup arm:
// a copy of the numbers with each run of equal ones squeezed to one by
// `dedup`, after which every hill or valley is a single number strictly
// above or below both its neighbours. O(n).

fn count_hill_valley(nums: Vec[i64]) -> i64 {
    let mut squeezed = nums.clone();
    squeezed.dedup();
    let mut count = 0;
    for i in 1..squeezed.len() - 1 {
        let (a, b, c) = (squeezed[i - 1], squeezed[i], squeezed[i + 1]);
        if (b > a and b > c) or (b < a and b < c) {
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {count_hill_valley(nums)}");
}

fn main() {
    // LeetCode's two examples, then four more: three numbers alike, a
    // plateau as a hill, a valley at either end that does not count, and
    // a zigzag
    show([2, 4, 1, 1, 6, 5]);
    show([6, 6, 5, 5, 4, 1]);
    show([7, 7, 7]);
    show([1, 3, 3, 3, 2]);
    show([1, 5, 5, 1, 1, 5, 5]);
    show([1, 2, 1, 2, 1, 2, 1]);
    // 3000 random arrays of 3 to 30 numbers up to 3, 10 and 100 in turn
    let mut seed = 2210;
    let mut most = 0;
    let mut check = 0;
    for c in 0..3000 {
        let n = next_random(mut seed) % 28 + 3;
        let top = [3, 10, 100][c % 3];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % top + 1);
        }
        let found = count_hill_valley(nums);
        most = most.max(found);
        check = (check * 31 + found) % 1000000007;
    }
    println(f"3000 arrays: most {most}, checksum {check}");
    // the constraints' longest: 100 numbers, a zigzag of 1 and 100, every
    // number in pairs, and 100 alike
    let zigzag: Vec[i64] = (0..100).map(|i| if i % 2 == 0 { 1 } else { 100 }).collect();
    let pairs: Vec[i64] = (0..100).map(|i| if i / 2 % 2 == 0 { 1 } else { 100 }).collect();
    let flat: Vec[i64] = Vec.filled(100, 100);
    println(f"zigzag {count_hill_valley(zigzag)}, pairs {count_hill_valley(pairs)}, flat {count_hill_valley(flat)}");
}
