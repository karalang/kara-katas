// LeetCode #2245: Maximum Trailing Zeros in a Cornered Path -- no
// subtraction: four sweeps, left to right, right to left, top down and
// bottom up, each leaving at every cell the (twos, fives) of the run
// that ends there, the cell included. A corner adds a horizontal run to
// a vertical one and takes the cell's own factors off once. O(m * n).

fn factors(value: i64) -> (i64, i64) {
    let mut v = value;
    let mut twos = 0;
    while v % 2 == 0 {
        v /= 2;
        twos += 1;
    }
    let mut fives = 0;
    while v % 5 == 0 {
        v /= 5;
        fives += 1;
    }
    (twos, fives)
}

fn max_trailing_zeros(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let cell: Vec[Vec[(i64, i64)]] = grid.iter().map(|row| row.iter().map(|v| factors(v)).collect()).collect();
    let mut from_left = cell.clone();
    let mut from_right = cell.clone();
    let mut from_top = cell.clone();
    let mut from_bottom = cell.clone();
    for i in 0..m {
        for j in 1..n {
            let (t, f) = from_left[i][j - 1];
            from_left[i][j] = (from_left[i][j].0 + t, from_left[i][j].1 + f);
            let k = n - 1 - j;
            let (t, f) = from_right[i][k + 1];
            from_right[i][k] = (from_right[i][k].0 + t, from_right[i][k].1 + f);
        }
    }
    for j in 0..n {
        for i in 1..m {
            let (t, f) = from_top[i - 1][j];
            from_top[i][j] = (from_top[i][j].0 + t, from_top[i][j].1 + f);
            let k = m - 1 - i;
            let (t, f) = from_bottom[k + 1][j];
            from_bottom[k][j] = (from_bottom[k][j].0 + t, from_bottom[k][j].1 + f);
        }
    }
    let mut best = 0;
    for i in 0..m {
        for j in 0..n {
            let (ct, cf) = cell[i][j];
            for (ht, hf) in [from_left[i][j], from_right[i][j]] {
                for (vt, vf) in [from_top[i][j], from_bottom[i][j]] {
                    best = best.max((ht + vt - ct).min(hf + vf - cf));
                }
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_grid(seed: mut ref i64, rows: i64, cols: i64, top: i64) -> Vec[Vec[i64]] {
    (0..rows).map(|_| (0..cols).map(|_| next_random(mut seed) % top + 1).collect()).collect()
}

fn main() {
    // LeetCode's two examples, then four more: one cell, one row, one
    // column, and a 125 and an 8 joined only through a turn
    let examples = [
        [[23, 17, 15, 3, 20].to_vec(), [8, 1, 20, 27, 11].to_vec(), [9, 4, 6, 2, 21].to_vec(), [40, 9, 1, 10, 6].to_vec(), [22, 7, 4, 5, 3].to_vec()].to_vec(),
        [[4, 3, 2].to_vec(), [7, 6, 1].to_vec(), [8, 8, 8].to_vec()].to_vec(),
        [[10].to_vec()].to_vec(),
        [[2, 5, 10, 1000].to_vec()].to_vec(),
        [[25].to_vec(), [4].to_vec(), [1].to_vec()].to_vec(),
        [[1, 125, 1].to_vec(), [1, 1, 1].to_vec(), [8, 1, 1].to_vec()].to_vec(),
    ];
    for grid in examples.iter() {
        println(f"{grid} -> {max_trailing_zeros(grid)}");
    }
    // 2000 grids of 1 to 8 rows and 1 to 8 columns, values 1 to 50
    let mut seed = 2245;
    let mut check = 0;
    let mut most = 0;
    for _ in 0..2000 {
        let rows = next_random(mut seed) % 8 + 1;
        let cols = next_random(mut seed) % 8 + 1;
        let grid = random_grid(mut seed, rows, cols, 50);
        let zeros = max_trailing_zeros(grid);
        most = most.max(zeros);
        check = (check * 31 + zeros + 1) % 1000000007;
    }
    println(f"2000 grids: most {most}, checksum {check}");
    // the constraints' largest: 250 * 400 cells, values up to 1000; then
    // one row of 10^5 cells
    let grid = random_grid(mut seed, 250, 400, 1000);
    println(f"250 x 400: {max_trailing_zeros(grid)}");
    let grid = random_grid(mut seed, 1, 100000, 1000);
    println(f"1 x 100000: {max_trailing_zeros(grid)}");
}
