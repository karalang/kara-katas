// LeetCode #2245: Maximum Trailing Zeros in a Cornered Path -- the
// trailing zeros of a product are the fewer of its factors of 2 and of
// 5, and both only add up along a path. Each row and each column gets
// prefix sums of the twos and the fives; every cell is tried as the
// corner, its row's part to the left or to the right (the corner
// included) joined to its column's part above or below (the corner
// left out). A straight path is never better than a cornered one that
// extends it, so the four corners cover everything. O(m * n).

fn count_factor(value: i64, p: i64) -> i64 {
    let mut v = value;
    let mut count = 0;
    while v % p == 0 {
        v /= p;
        count += 1;
    }
    count
}

fn max_trailing_zeros(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    // row_twos[i][j] counts the twos of grid[i][0..j]; col_twos[i][j]
    // those of grid[0..i][j]
    let mut row_twos: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n + 1, 0));
    let mut row_fives: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n + 1, 0));
    let mut col_twos: Vec[Vec[i64]] = Vec.filled(m + 1, Vec.filled(n, 0));
    let mut col_fives: Vec[Vec[i64]] = Vec.filled(m + 1, Vec.filled(n, 0));
    for i in 0..m {
        for j in 0..n {
            let t = count_factor(grid[i][j], 2);
            let f = count_factor(grid[i][j], 5);
            row_twos[i][j + 1] = row_twos[i][j] + t;
            row_fives[i][j + 1] = row_fives[i][j] + f;
            col_twos[i + 1][j] = col_twos[i][j] + t;
            col_fives[i + 1][j] = col_fives[i][j] + f;
        }
    }
    let mut best = 0;
    for i in 0..m {
        for j in 0..n {
            let left = (row_twos[i][j + 1], row_fives[i][j + 1]);
            let right = (row_twos[i][n] - row_twos[i][j], row_fives[i][n] - row_fives[i][j]);
            let up = (col_twos[i][j], col_fives[i][j]);
            let down = (col_twos[m][j] - col_twos[i + 1][j], col_fives[m][j] - col_fives[i + 1][j]);
            for (ht, hf) in [left, right] {
                for (vt, vf) in [up, down] {
                    best = best.max((ht + vt).min(hf + vf));
                }
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_grid(seed: mut ref i64, rows: i64, cols: i64, top: i64) -> Vec[Vec[i64]] {
    (0..rows).map(|_| (0..cols).map(|_| next_random(mut seed) % top + 1).collect()).collect()
}

fn main() {
    // LeetCode's two examples, then four more: one cell, one row, one
    // column, and a 125 and an 8 joined only through a turn
    let examples = [
        [[23, 17, 15, 3, 20].to_vec(), [8, 1, 20, 27, 11].to_vec(), [9, 4, 6, 2, 21].to_vec(), [40, 9, 1, 10, 6].to_vec(), [22, 7, 4, 5, 3].to_vec()].to_vec(),
        [[4, 3, 2].to_vec(), [7, 6, 1].to_vec(), [8, 8, 8].to_vec()].to_vec(),
        [[10].to_vec()].to_vec(),
        [[2, 5, 10, 1000].to_vec()].to_vec(),
        [[25].to_vec(), [4].to_vec(), [1].to_vec()].to_vec(),
        [[1, 125, 1].to_vec(), [1, 1, 1].to_vec(), [8, 1, 1].to_vec()].to_vec(),
    ];
    for grid in examples.iter() {
        println(f"{grid} -> {max_trailing_zeros(grid)}");
    }
    // 2000 grids of 1 to 8 rows and 1 to 8 columns, values 1 to 50
    let mut seed = 2245;
    let mut check = 0;
    let mut most = 0;
    for _ in 0..2000 {
        let rows = next_random(mut seed) % 8 + 1;
        let cols = next_random(mut seed) % 8 + 1;
        let grid = random_grid(mut seed, rows, cols, 50);
        let zeros = max_trailing_zeros(grid);
        most = most.max(zeros);
        check = (check * 31 + zeros + 1) % 1000000007;
    }
    println(f"2000 grids: most {most}, checksum {check}");
    // the constraints' largest: 250 * 400 cells, values up to 1000; then
    // one row of 10^5 cells
    let grid = random_grid(mut seed, 250, 400, 1000);
    println(f"250 x 400: {max_trailing_zeros(grid)}");
    let grid = random_grid(mut seed, 1, 100000, 1000);
    println(f"1 x 100000: {max_trailing_zeros(grid)}");
}
