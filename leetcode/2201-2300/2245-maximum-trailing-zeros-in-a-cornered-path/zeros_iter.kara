// LeetCode #2245: Maximum Trailing Zeros in a Cornered Path -- iterator
// chains: the grid `map`ped to (twos, fives) pairs, each row's and each
// column's running sums by `scan` behind a `once((0, 0))`, and the best
// corner by `flat_map` over the cells, each trying its two sides with
// its two ends, then `max`. O(m * n).

fn factor(value: i64, p: i64) -> i64 {
    if value % p == 0 { 1 + factor(value / p, p) } else { 0 }
}

fn add(a: (i64, i64), b: (i64, i64)) -> (i64, i64) {
    (a.0 + b.0, a.1 + b.1)
}

fn sub(a: (i64, i64), b: (i64, i64)) -> (i64, i64) {
    (a.0 - b.0, a.1 - b.1)
}

fn max_trailing_zeros(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let cells: Vec[Vec[(i64, i64)]] = grid.iter().map(|row| row.iter().map(|v| (factor(v, 2), factor(v, 5))).collect()).collect();
    let rows: Vec[Vec[(i64, i64)]] = cells
        .iter()
        .map(|row| once((0, 0)).chain(row.iter().scan((0, 0), |sum, c| { let sum = add(sum, c); Some((sum, sum)) })).collect())
        .collect();
    let cols: Vec[Vec[(i64, i64)]] = (0..n)
        .map(|j| once((0, 0)).chain((0..m).scan((0, 0), |sum, i| { let sum = add(sum, cells[i][j]); Some((sum, sum)) })).collect())
        .collect();
    (0..m)
        .flat_map(|i| (0..n).map(|j| (i, j)))
        .map(|(i, j)| {
            let sides = [rows[i][j + 1], sub(rows[i][n], rows[i][j])];
            let ends = [cols[j][i], sub(cols[j][m], cols[j][i + 1])];
            sides.iter().flat_map(|h| ends.iter().map(|v| add(h, v))).map(|(t, f)| t.min(f)).max().unwrap_or(0)
        })
        .max()
        .unwrap_or(0)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_grid(seed: mut ref i64, rows: i64, cols: i64, top: i64) -> Vec[Vec[i64]] {
    (0..rows).map(|_| (0..cols).map(|_| next_random(mut seed) % top + 1).collect()).collect()
}

fn main() {
    // LeetCode's two examples, then four more: one cell, one row, one
    // column, and a 125 and an 8 joined only through a turn
    let examples = [
        [[23, 17, 15, 3, 20].to_vec(), [8, 1, 20, 27, 11].to_vec(), [9, 4, 6, 2, 21].to_vec(), [40, 9, 1, 10, 6].to_vec(), [22, 7, 4, 5, 3].to_vec()].to_vec(),
        [[4, 3, 2].to_vec(), [7, 6, 1].to_vec(), [8, 8, 8].to_vec()].to_vec(),
        [[10].to_vec()].to_vec(),
        [[2, 5, 10, 1000].to_vec()].to_vec(),
        [[25].to_vec(), [4].to_vec(), [1].to_vec()].to_vec(),
        [[1, 125, 1].to_vec(), [1, 1, 1].to_vec(), [8, 1, 1].to_vec()].to_vec(),
    ];
    for grid in examples.iter() {
        println(f"{grid} -> {max_trailing_zeros(grid)}");
    }
    // 2000 grids of 1 to 8 rows and 1 to 8 columns, values 1 to 50
    let mut seed = 2245;
    let mut check = 0;
    let mut most = 0;
    for _ in 0..2000 {
        let rows = next_random(mut seed) % 8 + 1;
        let cols = next_random(mut seed) % 8 + 1;
        let grid = random_grid(mut seed, rows, cols, 50);
        let zeros = max_trailing_zeros(grid);
        most = most.max(zeros);
        check = (check * 31 + zeros + 1) % 1000000007;
    }
    println(f"2000 grids: most {most}, checksum {check}");
    // the constraints' largest: 250 * 400 cells, values up to 1000; then
    // one row of 10^5 cells
    let grid = random_grid(mut seed, 250, 400, 1000);
    println(f"250 x 400: {max_trailing_zeros(grid)}");
    let grid = random_grid(mut seed, 1, 100000, 1000);
    println(f"1 x 100000: {max_trailing_zeros(grid)}");
}
