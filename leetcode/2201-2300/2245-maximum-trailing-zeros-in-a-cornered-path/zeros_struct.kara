// LeetCode #2245: Maximum Trailing Zeros in a Cornered Path -- a `struct
// Factors` of twos and fives (`Factors.of`, `plus`, `minus`, `zeros`,
// all `ref self`) and a `struct Prefix` holding the running `Factors`
// of every row and column, with `row_span` and `col_span` answering a
// stretch of one row or one column; every cell tried as the corner.
// O(m * n).

#[derive(Copy, Clone)]
struct Factors {
    twos: i64,
    fives: i64,
}

impl Factors {
    fn none() -> Factors {
        Factors { twos: 0, fives: 0 }
    }

    fn of(value: i64) -> Factors {
        let mut v = value;
        let mut f = Factors.none();
        while v % 2 == 0 {
            v /= 2;
            f.twos += 1;
        }
        while v % 5 == 0 {
            v /= 5;
            f.fives += 1;
        }
        f
    }

    fn plus(ref self, other: Factors) -> Factors {
        Factors { twos: self.twos + other.twos, fives: self.fives + other.fives }
    }

    fn minus(ref self, other: Factors) -> Factors {
        Factors { twos: self.twos - other.twos, fives: self.fives - other.fives }
    }

    fn zeros(ref self) -> i64 {
        self.twos.min(self.fives)
    }
}

struct Prefix {
    // rows[i][j]: grid[i][0..j]; cols[j][i]: grid[0..i][j]
    rows: Vec[Vec[Factors]],
    cols: Vec[Vec[Factors]],
}

impl Prefix {
    fn build(grid: Vec[Vec[i64]]) -> Prefix {
        let m = grid.len();
        let n = grid[0].len();
        let mut rows: Vec[Vec[Factors]] = Vec.filled(m, Vec.filled(n + 1, Factors.none()));
        let mut cols: Vec[Vec[Factors]] = Vec.filled(n, Vec.filled(m + 1, Factors.none()));
        for i in 0..m {
            for j in 0..n {
                let f = Factors.of(grid[i][j]);
                rows[i][j + 1] = rows[i][j].plus(f);
                cols[j][i + 1] = cols[j][i].plus(f);
            }
        }
        Prefix { rows, cols }
    }

    // the cells from..to (to excluded) of row i
    fn row_span(ref self, i: i64, from: i64, to: i64) -> Factors {
        self.rows[i][to].minus(self.rows[i][from])
    }

    // the cells from..to (to excluded) of column j
    fn col_span(ref self, j: i64, from: i64, to: i64) -> Factors {
        self.cols[j][to].minus(self.cols[j][from])
    }
}

fn max_trailing_zeros(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let prefix = Prefix.build(grid);
    let mut best = 0;
    for i in 0..m {
        for j in 0..n {
            let sides = [prefix.row_span(i, 0, j + 1), prefix.row_span(i, j, n)];
            let ends = [prefix.col_span(j, 0, i), prefix.col_span(j, i + 1, m)];
            for h in sides.iter() {
                for v in ends.iter() {
                    best = best.max(h.plus(v).zeros());
                }
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_grid(seed: mut ref i64, rows: i64, cols: i64, top: i64) -> Vec[Vec[i64]] {
    (0..rows).map(|_| (0..cols).map(|_| next_random(mut seed) % top + 1).collect()).collect()
}

fn main() {
    // LeetCode's two examples, then four more: one cell, one row, one
    // column, and a 125 and an 8 joined only through a turn
    let examples = [
        [[23, 17, 15, 3, 20].to_vec(), [8, 1, 20, 27, 11].to_vec(), [9, 4, 6, 2, 21].to_vec(), [40, 9, 1, 10, 6].to_vec(), [22, 7, 4, 5, 3].to_vec()].to_vec(),
        [[4, 3, 2].to_vec(), [7, 6, 1].to_vec(), [8, 8, 8].to_vec()].to_vec(),
        [[10].to_vec()].to_vec(),
        [[2, 5, 10, 1000].to_vec()].to_vec(),
        [[25].to_vec(), [4].to_vec(), [1].to_vec()].to_vec(),
        [[1, 125, 1].to_vec(), [1, 1, 1].to_vec(), [8, 1, 1].to_vec()].to_vec(),
    ];
    for grid in examples.iter() {
        println(f"{grid} -> {max_trailing_zeros(grid)}");
    }
    // 2000 grids of 1 to 8 rows and 1 to 8 columns, values 1 to 50
    let mut seed = 2245;
    let mut check = 0;
    let mut most = 0;
    for _ in 0..2000 {
        let rows = next_random(mut seed) % 8 + 1;
        let cols = next_random(mut seed) % 8 + 1;
        let grid = random_grid(mut seed, rows, cols, 50);
        let zeros = max_trailing_zeros(grid);
        most = most.max(zeros);
        check = (check * 31 + zeros + 1) % 1000000007;
    }
    println(f"2000 grids: most {most}, checksum {check}");
    // the constraints' largest: 250 * 400 cells, values up to 1000; then
    // one row of 10^5 cells
    let grid = random_grid(mut seed, 250, 400, 1000);
    println(f"250 x 400: {max_trailing_zeros(grid)}");
    let grid = random_grid(mut seed, 1, 100000, 1000);
    println(f"1 x 100000: {max_trailing_zeros(grid)}");
}
