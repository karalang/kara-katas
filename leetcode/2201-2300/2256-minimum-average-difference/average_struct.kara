// LeetCode #2256: Minimum Average Difference -- a `struct Split` of the
// two sides' sums and counts, all on the right to begin with, whose
// `shift` (`mut ref self`) moves one value to the left and whose `gap`
// (`ref self`) is the difference of the two rounded-down averages, an
// empty side's taken as 0 by `average`. O(n).

struct Split {
    left_sum: i64,
    left_count: i64,
    right_sum: i64,
    right_count: i64,
}

fn average(sum: i64, count: i64) -> i64 {
    if count == 0 { 0 } else { sum / count }
}

impl Split {
    fn of(nums: Vec[i64]) -> Split {
        Split { left_sum: 0, left_count: 0, right_sum: nums.iter().sum(), right_count: nums.len() }
    }

    fn shift(mut ref self, value: i64) {
        self.left_sum += value;
        self.left_count += 1;
        self.right_sum -= value;
        self.right_count -= 1;
    }

    fn gap(ref self) -> i64 {
        (average(self.left_sum, self.left_count) - average(self.right_sum, self.right_count)).abs()
    }
}

fn minimum_average_difference(nums: Vec[i64]) -> i64 {
    let mut split = Split.of(nums);
    let mut best: Option[(i64, i64)] = None;
    for (i, value) in nums.iter().enumerate() {
        split.shift(value);
        let gap = split.gap();
        best = match best {
            Some((g, _)) if g <= gap => best,
            _ => Some((gap, i)),
        };
    }
    best.unwrap().1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples, then four more: every value alike, a tie
    // the first index must win, the last index (whose right side is
    // empty), and the constraints' largest values
    let examples: Vec[Vec[i64]] = [
        [2, 5, 3, 9, 5, 3].to_vec(),
        [0].to_vec(),
        [4, 4, 4, 4].to_vec(),
        [1, 3, 2].to_vec(),
        [9, 1, 1, 1, 30].to_vec(),
        [100000, 0, 100000, 100000].to_vec(),
    ].to_vec();
    for nums in examples.iter() {
        println(f"{nums} -> {minimum_average_difference(nums)}");
    }
    // 2000 cases of 1 to 12 values from 0 to 10
    let mut seed = 2256;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 11).collect();
        let index = minimum_average_difference(nums);
        total += index;
        check = (check * 31 + index + 1) % 1000000007;
    }
    println(f"2000 cases: indices summing to {total}, checksum {check}");
    // the constraints' largest, 10^5 values up to 10^5, three times: any
    // value, values near 10^5, and values that only grow
    let any: Vec[i64] = (0..100000).map(|_| wide_random(mut seed) % 100001).collect();
    let high: Vec[i64] = (0..100000).map(|_| 100000 - next_random(mut seed) % 3).collect();
    let rising: Vec[i64] = (0..100000).map(|i| i + 1).collect();
    println(f"10^5 values: {minimum_average_difference(any)}, {minimum_average_difference(high)}, {minimum_average_difference(rising)}");
}
