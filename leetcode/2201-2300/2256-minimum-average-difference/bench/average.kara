// LeetCode #2256: Minimum Average Difference -- the benchmark copy of
// average.kara: one pass with the total known, each side's average its
// sum divided by its count, rounded down, an empty side's 0, and the
// first index whose two averages are nearest.

fn minimum_average_difference(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let total: i64 = nums.iter().sum();
    let mut left = 0;
    let mut best = 0;
    let mut best_gap = -1;
    for i in 0..n {
        left += nums[i];
        let right = total - left;
        let left_average = left / (i + 1);
        let right_average = if i + 1 == n { 0 } else { right / (n - i - 1) };
        let gap = (left_average - right_average).abs();
        if best_gap < 0 or gap < best_gap {
            best_gap = gap;
            best = i;
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // 20 cases of 10^5 values from 0 to 10^5
    let mut seed = 2256;
    let mut check = 0;
    for _ in 0..20 {
        let nums: Vec[i64] = (0..100000).map(|_| wide_random(mut seed) % 100001).collect();
        check = (check * 31 + minimum_average_difference(nums) + 1) % 1000000007;
    }
    println(f"20 cases of 10^5 values: checksum {check}");
}
