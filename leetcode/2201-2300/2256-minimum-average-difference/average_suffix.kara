// LeetCode #2256: Minimum Average Difference -- from the right: a
// suffix-sum array built backwards, `suffix[i]` the sum from i to the
// end, and the left side's sum the total less `suffix[i + 1]`. The loop
// that picks the index still runs left to right so that a tie keeps the
// first. O(n) time and O(n) room.

fn minimum_average_difference(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut suffix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in (0..n).rev() {
        suffix[i] = suffix[i + 1] + nums[i];
    }
    let mut best = 0;
    let mut best_gap = i64.MAX;
    for i in 0..n {
        let right = suffix[i + 1];
        let left = suffix[0] - right;
        let gap = (left / (i + 1) - if i + 1 < n { right / (n - i - 1) } else { 0 }).abs();
        if gap < best_gap {
            best_gap = gap;
            best = i;
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples, then four more: every value alike, a tie
    // the first index must win, the last index (whose right side is
    // empty), and the constraints' largest values
    let examples: Vec[Vec[i64]] = [
        [2, 5, 3, 9, 5, 3].to_vec(),
        [0].to_vec(),
        [4, 4, 4, 4].to_vec(),
        [1, 3, 2].to_vec(),
        [9, 1, 1, 1, 30].to_vec(),
        [100000, 0, 100000, 100000].to_vec(),
    ].to_vec();
    for nums in examples.iter() {
        println(f"{nums} -> {minimum_average_difference(nums)}");
    }
    // 2000 cases of 1 to 12 values from 0 to 10
    let mut seed = 2256;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 11).collect();
        let index = minimum_average_difference(nums);
        total += index;
        check = (check * 31 + index + 1) % 1000000007;
    }
    println(f"2000 cases: indices summing to {total}, checksum {check}");
    // the constraints' largest, 10^5 values up to 10^5, three times: any
    // value, values near 10^5, and values that only grow
    let any: Vec[i64] = (0..100000).map(|_| wide_random(mut seed) % 100001).collect();
    let high: Vec[i64] = (0..100000).map(|_| 100000 - next_random(mut seed) % 3).collect();
    let rising: Vec[i64] = (0..100000).map(|i| i + 1).collect();
    println(f"10^5 values: {minimum_average_difference(any)}, {minimum_average_difference(high)}, {minimum_average_difference(rising)}");
}
