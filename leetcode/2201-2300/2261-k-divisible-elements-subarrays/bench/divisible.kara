// LeetCode #2261: K Divisible Elements Subarrays -- the ★ arm. From every
// start the subarray grows one element at a time, counting the elements
// divisible by `p`, and stops once that count passes `k`; every subarray
// on the way goes into a `Set[Vec[i64]]`, which keeps one of each. O(n^3)
// for the copies and hashes, n <= 200.

fn count_distinct(nums: Vec[i64], k: i64, p: i64) -> i64 {
    let mut seen: Set[Vec[i64]] = Set.new();
    for start in 0..nums.len() {
        let mut divisible = 0;
        let mut run: Vec[i64] = Vec.new();
        for end in start..nums.len() {
            if nums[end] % p == 0 {
                divisible += 1;
            }
            if divisible > k {
                break;
            }
            run.push(nums[end]);
            seen.insert(run.clone());
        }
    }
    seen.len()
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 40 arrays of the constraints' longest, 200 elements from 1 to 200,
    // p from 2 to 9 and k from 5 to 200
    let mut seed = 2261;
    let mut check = 0;
    for _ in 0..40 {
        let nums: Vec[i64] = (0..200).map(|_| next_random(mut seed) % 200 + 1).collect();
        let p = next_random(mut seed) % 8 + 2;
        let k = next_random(mut seed) % 196 + 5;
        check = (check * 31 + count_distinct(nums, k, p)) % 1000000007;
    }
    println(f"40 arrays of 200: checksum {check}");
}
