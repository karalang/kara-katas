// LeetCode #2261: K Divisible Elements Subarrays -- the ★ arm. From every
// start the subarray grows one element at a time, counting the elements
// divisible by `p`, and stops once that count passes `k`; every subarray
// on the way goes into a `Set[Vec[i64]]`, which keeps one of each. O(n^3)
// for the copies and hashes, n <= 200.

fn count_distinct(nums: Vec[i64], k: i64, p: i64) -> i64 {
    let mut seen: Set[Vec[i64]] = Set.new();
    for start in 0..nums.len() {
        let mut divisible = 0;
        let mut run: Vec[i64] = Vec.new();
        for end in start..nums.len() {
            if nums[end] % p == 0 {
                divisible += 1;
            }
            if divisible > k {
                break;
            }
            run.push(nums[end]);
            seen.insert(run.clone());
        }
    }
    seen.len()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then four more: one element that is
    // divisible with k = 1, all one value, nothing divisible, and every
    // element divisible with k = 1
    let examples: Vec[(Vec[i64], i64, i64)] = [
        ([2, 3, 3, 2, 2].to_vec(), 2, 2),
        ([1, 2, 3, 4].to_vec(), 4, 1),
        ([6].to_vec(), 1, 3),
        ([5, 5, 5, 5].to_vec(), 2, 5),
        ([1, 3, 7, 9].to_vec(), 1, 2),
        ([4, 8, 4, 8].to_vec(), 1, 4),
    ].to_vec();
    for (nums, k, p) in examples.iter() {
        println(f"{nums} k={k} p={p} -> {count_distinct(nums, k, p)}");
    }
    // 2000 arrays of 1 to 20 elements from 1 to 10, k from 1 to the
    // length, p from 1 to 10
    let mut seed = 2261;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 20 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 10 + 1).collect();
        let k = next_random(mut seed) % n + 1;
        let p = next_random(mut seed) % 10 + 1;
        let answer = count_distinct(nums, k, p);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"2000 arrays: {total} subarrays, checksum {check}");
    // the constraints' longest, 200 elements: all 1 with p = 1 and k = 50;
    // random from 1 to 200 with p = 7 and k = 200; 1 to 200 in order with
    // p = 2 and k = 10; and random from 1 to 3 with p = 3 and k = 20
    let ones: Vec[i64] = Vec.filled(200, 1);
    let random: Vec[i64] = (0..200).map(|_| next_random(mut seed) % 200 + 1).collect();
    let ordered: Vec[i64] = (1..201).collect();
    let small: Vec[i64] = (0..200).map(|_| next_random(mut seed) % 3 + 1).collect();
    let answers = [
        count_distinct(ones, 50, 1),
        count_distinct(random, 200, 7),
        count_distinct(ordered, 10, 2),
        count_distinct(small, 20, 3),
    ];
    println(f"200 elements: {answers}");
}
