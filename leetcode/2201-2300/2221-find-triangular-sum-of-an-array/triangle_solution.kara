// LeetCode #2221: Find Triangular Sum of an Array -- LeetCode's Rust
// template: a `mut nums: Vec<i32>` in, `i32` out, the rounds done in
// place over the parameter itself with `usize` indices. Carried by
// `karac fix`. The adapter below hands the harness's values to it.

impl Solution {
    pub fn triangular_sum(nums: own Vec[i32]) -> i32 {
        let mut nums = nums;
        let n = nums.len();
        for len in (1..n).rev() {
            for i in 0..len {
                nums[i] = (nums[i] + nums[i + 1]) % 10;
            }
        }
        nums[0]
    }
}

struct Solution {}

fn triangular_sum(nums: Vec[i64]) -> i64 {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.triangular_sum(nums)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {triangular_sum(nums)}");
}

fn main() {
    // LeetCode's two examples, then four more: two nines, all zeros, a
    // lone 1 at the start of eight, and 1 to 9
    show([1, 2, 3, 4, 5]);
    show([5]);
    show([9, 9]);
    show([0, 0, 0, 0]);
    show([1, 0, 0, 0, 0, 0, 0, 0]);
    show([1, 2, 3, 4, 5, 6, 7, 8, 9]);
    // 3000 random arrays of 1 to 40 digits
    let mut seed = 2221;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 40 + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % 10);
        }
        check = (check * 31 + triangular_sum(nums)) % 1000000007;
    }
    println(f"3000 arrays: checksum {check}");
    // the constraints' largest: 1000 random digits, and 1000 nines
    let mut wide: Vec[i64] = Vec.new();
    for _ in 0..1000 {
        wide.push(next_random(mut seed) % 10);
    }
    let nines: Vec[i64] = Vec.filled(1000, 9);
    println(f"1000 random digits: {triangular_sum(wide)}; 1000 nines: {triangular_sum(nines)}");
}
