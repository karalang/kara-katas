// LeetCode #2221: Find Triangular Sum of an Array -- the rounds done in
// place: each round writes (nums[i] + nums[i + 1]) % 10 over nums[i],
// left to right, so nums[i + 1] is still the old one when it is read,
// and the live part shrinks by one; the first digit is the answer.
// O(n^2).

fn triangular_sum(nums: Vec[i64]) -> i64 {
    let mut row = nums.clone();
    let n = row.len();
    for live in (1..n).rev() {
        for i in 0..live {
            row[i] = (row[i] + row[i + 1]) % 10;
        }
    }
    row[0]
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2221;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..8 {
        // 1000 digits, the constraints' largest
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..1000 {
            nums.push(next_random(mut seed) % 10);
        }
        arrays.push(nums);
    }
    let mut check = 0;
    for a in 0..8 {
        for r in 0..8 {
            // punch: one digit is drawn again before each answer
            arrays[a][r * 113] = next_random(mut seed) % 10;
            check = (check * 31 + triangular_sum(arrays[a])) % 1000000007;
        }
    }
    println(f"8 arrays of 1000 digits, 8 punches: checksum {check}");
}
