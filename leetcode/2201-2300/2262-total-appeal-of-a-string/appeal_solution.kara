// LeetCode #2262: Total Appeal of A String -- LeetCode's Rust template:
// `String` in, `i64` out. The bytes by `as_bytes`, the last positions in
// a `[-1i64; 26]`, and the appeal of the substrings ending at each
// position kept in `cur`, its `i as i64 - last[c]` new first appearances
// added before `cur` goes into the answer. Carried by `karac fix`. The
// adapter below hands the harness's values to it.

impl Solution {
    pub fn appeal_sum(s: String) -> i64 {
        let s = s.bytes();
        let mut last = [-1; 26];
        let mut ans: i64 = 0;
        let mut cur: i64 = 0;
        for (i, b) in s.iter().enumerate() {
            let c = (b - b'a') as usize;
            cur += i - last[c];
            ans += cur;
            last[c] = i;
        }
        ans
    }
}

struct Solution {}

fn appeal_sum(s: String) -> i64 {
    Solution.appeal_sum(s)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `len` letters from the first `letters` of the alphabet
fn word(seed: mut ref i64, len: i64, letters: i64) -> String {
    let mut s = String.new();
    for _ in 0..len {
        s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    s
}

fn main() {
    // LeetCode's two examples, then four more: one letter, one letter
    // three times, every letter once, and a palindrome
    for s in ["abbca", "code", "z", "aaa", "abcdefghijklmnopqrstuvwxyz", "racecar"] {
        println(f"{s} -> {appeal_sum(s.to_string())}");
    }
    // 3000 strings of 1 to 40 letters from the first 1, 2, 3, 5 or 26
    let mut seed = 2262;
    let mut check = 0;
    for t in 0..3000 {
        let len = next_random(mut seed) % 40 + 1;
        let s = word(mut seed, len, [1, 2, 3, 5, 26][t % 5]);
        check = (check * 31 + appeal_sum(s)) % 1000000007;
    }
    println(f"3000 strings: checksum {check}");
    // the constraints' longest, 10^5 letters: all `a`, `abc` repeated,
    // and random from all 26
    let all_a = "a".repeat(100000);
    let cycle = "abc".repeat(33334).substring(0, 100000);
    let random = word(mut seed, 100000, 26);
    let answers = [appeal_sum(all_a), appeal_sum(cycle), appeal_sum(random)];
    println(f"10^5 letters: {answers}");
}
