// LeetCode #2262: Total Appeal of A String -- the ★ arm. Count each
// character where it first appears in a substring: the character at `i`
// is the first of its letter in every substring that starts after the
// letter's previous position `last` and at or before `i`, and ends at or
// after `i`. That is `(i - last) * (n - i)` substrings, summed over every
// position, with `last` kept per letter in an `Array[i64, 26]`. O(n).

fn appeal_sum(s: String) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut last: Array[i64, 26] = [-1; 26];
    let mut total = 0;
    for i in 0..n {
        let c = (bytes[i] - b'a') as i64;
        total += (i - last[c]) * (n - i);
        last[c] = i;
    }
    total
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 40 strings of the constraints' longest, 10^5 letters, from the
    // first 1 to 26 letters of the alphabet
    let mut seed = 2262;
    let mut check = 0;
    for t in 0..40 {
        let letters = t % 26 + 1;
        let mut s = String.new();
        for _ in 0..100000 {
            s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        check = (check * 31 + appeal_sum(s)) % 1000000007;
    }
    println(f"40 strings of 10^5: checksum {check}");
}
