// LeetCode #2281: Sum of Total Strength of Wizards -- the differential.
// The six arms, against the statement read literally: every group from
// every left end to every right end, its weakest strength and its total
// found by walking it, their product added up, modulo 10^9 + 7. No
// stacks and no prefix sums. 300 random armies of 1 to 12 wizards of
// strength up to 2, 5 or 1000; then 30 of wizards all alike; then 30
// rising or falling. Every case is drawn before any arm answers.
//
// P1  the total is the literal reading's
// P2  the army reversed: the same total
// P3  every strength times 3: the total times 9
// P4  between the least strength and the greatest times the sum of every
//     group's strengths
// P5  a wizard of the least strength added at the front: the total grown
//     by that strength times the sums of the groups the wizard starts
// P6  each arm agrees with at least three of the other five

// ---- wizards.kara: the ★ arm, two stacks and prefix sums of prefix sums
const STAR_MOD: i64 = 1000000007;

fn star_total_strength(strength: Vec[i64]) -> i64 {
    let n = strength.len();
    let mut left: Vec[i64] = Vec.filled(n, -1);
    let mut right: Vec[i64] = Vec.filled(n, n);
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..n {
        while stack.len() > 0 and strength[stack[stack.len() - 1]] >= strength[i] {
            stack.pop();
        }
        if stack.len() > 0 {
            left[i] = stack[stack.len() - 1];
        }
        stack.push(i);
    }
    stack.clear();
    for i in (0..n).rev() {
        while stack.len() > 0 and strength[stack[stack.len() - 1]] > strength[i] {
            stack.pop();
        }
        if stack.len() > 0 {
            right[i] = stack[stack.len() - 1];
        }
        stack.push(i);
    }
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = (prefix[i] + strength[i]) % STAR_MOD;
    }
    let mut twice: Vec[i64] = Vec.filled(n + 2, 0);
    for i in 0..n + 1 {
        twice[i + 1] = (twice[i] + prefix[i]) % STAR_MOD;
    }
    let mut total = 0;
    for i in 0..n {
        let (l, r) = (left[i], right[i]);
        let ends = (i - l) * ((twice[r + 1] - twice[i + 1] + STAR_MOD) % STAR_MOD) % STAR_MOD;
        let starts = (r - i) * ((twice[i + 1] - twice[l + 1] + STAR_MOD) % STAR_MOD) % STAR_MOD;
        let groups = (ends - starts + STAR_MOD) % STAR_MOD;
        total = (total + strength[i] % STAR_MOD * groups) % STAR_MOD;
    }
    total
}

// ---- wizards_onepass.kara: one stack, each wizard summed as it is popped
const ONEPASS_MOD: i64 = 1000000007;

fn onepass_total_strength(strength: Vec[i64]) -> i64 {
    let n = strength.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = (prefix[i] + strength[i]) % ONEPASS_MOD;
    }
    let mut twice: Vec[i64] = Vec.filled(n + 2, 0);
    for i in 0..n + 1 {
        twice[i + 1] = (twice[i] + prefix[i]) % ONEPASS_MOD;
    }
    let mut total = 0;
    let mut stack: Vec[i64] = Vec.new();
    for r in 0..n + 1 {
        let arriving = if r < n { strength[r] } else { 0 };
        while stack.len() > 0 and strength[stack[stack.len() - 1]] >= arriving {
            let i = stack.pop().unwrap();
            let l = if stack.len() > 0 { stack[stack.len() - 1] } else { -1 };
            let ends = (i - l) * ((twice[r + 1] - twice[i + 1] + ONEPASS_MOD) % ONEPASS_MOD) % ONEPASS_MOD;
            let starts = (r - i) * ((twice[i + 1] - twice[l + 1] + ONEPASS_MOD) % ONEPASS_MOD) % ONEPASS_MOD;
            total = (total + strength[i] % ONEPASS_MOD * ((ends - starts + ONEPASS_MOD) % ONEPASS_MOD)) % ONEPASS_MOD;
        }
        stack.push(r);
    }
    total
}

// ---- wizards_dp.kara: the groups by their right ends
const DP_MOD: i64 = 1000000007;

fn dp_total_strength(strength: Vec[i64]) -> i64 {
    let n = strength.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = (prefix[i] + strength[i]) % DP_MOD;
    }
    let mut twice: Vec[i64] = Vec.filled(n + 2, 0);
    for i in 0..n + 1 {
        twice[i + 1] = (twice[i] + prefix[i]) % DP_MOD;
    }
    let mut weakest: Vec[i64] = Vec.filled(n, 0);
    let mut weighted: Vec[i64] = Vec.filled(n, 0);
    let mut stack: Vec[i64] = Vec.new();
    let mut total = 0;
    for r in 0..n {
        while stack.len() > 0 and strength[stack[stack.len() - 1]] >= strength[r] {
            stack.pop();
        }
        let s = strength[r] % DP_MOD;
        if stack.len() > 0 {
            let j = stack[stack.len() - 1];
            weakest[r] = (weakest[j] + s * (r - j)) % DP_MOD;
            weighted[r] = (weighted[j] + s * ((twice[r + 1] - twice[j + 1] + DP_MOD) % DP_MOD)) % DP_MOD;
        } else {
            weakest[r] = s * (r + 1) % DP_MOD;
            weighted[r] = s * twice[r + 1] % DP_MOD;
        }
        stack.push(r);
        total = (total + prefix[r + 1] * weakest[r] % DP_MOD - weighted[r] + DP_MOD) % DP_MOD;
    }
    total
}

// ---- wizards_struct.kara: `struct Army`, the ties counted at the leftmost
const STRUCT_MOD: i64 = 1000000007;

struct StructArmy {
    strength: Vec[i64],
    prefix: Vec[i64],
    twice: Vec[i64],
}

impl StructArmy {
    fn new(strength: Vec[i64]) -> StructArmy {
        let n = strength.len();
        let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
        for i in 0..n {
            prefix[i + 1] = (prefix[i] + strength[i]) % STRUCT_MOD;
        }
        let mut twice: Vec[i64] = Vec.filled(n + 2, 0);
        for i in 0..n + 1 {
            twice[i + 1] = (twice[i] + prefix[i]) % STRUCT_MOD;
        }
        StructArmy { strength: strength.clone(), prefix: prefix, twice: twice }
    }

    // the prefix sums `P[a] + ... + P[b - 1]`
    fn span(self, a: i64, b: i64) -> i64 {
        (self.twice[b] - self.twice[a] + STRUCT_MOD) % STRUCT_MOD
    }

    // for each wizard, the nearest no stronger one on the left, or -1,
    // and the nearest weaker on the right, or the army's size: a group
    // whose weakest strength repeats is counted at the leftmost, where
    // the other arms count it at the rightmost
    fn reach(self) -> (Vec[i64], Vec[i64]) {
        let n = self.strength.len();
        let mut left: Vec[i64] = Vec.filled(n, -1);
        let mut right: Vec[i64] = Vec.filled(n, n);
        let mut stack: Vec[i64] = Vec.new();
        for i in 0..n {
            while stack.len() > 0 and self.strength[stack[stack.len() - 1]] > self.strength[i] {
                right[stack.pop().unwrap()] = i;
            }
            stack.push(i);
        }
        stack.clear();
        for i in (0..n).rev() {
            while stack.len() > 0 and self.strength[stack[stack.len() - 1]] >= self.strength[i] {
                left[stack.pop().unwrap()] = i;
            }
            stack.push(i);
        }
        (left, right)
    }

    fn groups(self, i: i64, l: i64, r: i64) -> i64 {
        let ends = (i - l) * self.span(i + 1, r + 1) % STRUCT_MOD;
        let starts = (r - i) * self.span(l + 1, i + 1) % STRUCT_MOD;
        (ends - starts + STRUCT_MOD) % STRUCT_MOD
    }

    fn total(self) -> i64 {
        let (left, right) = self.reach();
        let mut total = 0;
        for i in 0..self.strength.len() {
            total = (total + self.strength[i] % STRUCT_MOD * self.groups(i, left[i], right[i])) % STRUCT_MOD;
        }
        total
    }
}

fn struct_total_strength(strength: Vec[i64]) -> i64 {
    StructArmy.new(strength).total()
}

// ---- wizards_iter.kara: `scan`, `chain`, `map` and `fold`
const ITER_MOD: i64 = 1000000007;

fn iter_total_strength(strength: Vec[i64]) -> i64 {
    let n = strength.len();
    let prefix: Vec[i64] = [0]
        .iter()
        .cloned()
        .chain(strength.iter().scan(0, |sum, x| {
            let sum = (sum + x) % ITER_MOD;
            Some((sum, sum))
        }))
        .collect();
    let twice: Vec[i64] = [0]
        .iter()
        .cloned()
        .chain(prefix.iter().scan(0, |sum, p| {
            let sum = (sum + p) % ITER_MOD;
            Some((sum, sum))
        }))
        .collect();
    let mut left: Vec[i64] = Vec.filled(n, -1);
    let mut right: Vec[i64] = Vec.filled(n, n);
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..n {
        while stack.len() > 0 and strength[stack[stack.len() - 1]] >= strength[i] {
            stack.pop();
        }
        left[i] = if stack.len() > 0 { stack[stack.len() - 1] } else { -1 };
        stack.push(i);
    }
    stack.clear();
    for i in (0..n).rev() {
        while stack.len() > 0 and strength[stack[stack.len() - 1]] > strength[i] {
            stack.pop();
        }
        right[i] = if stack.len() > 0 { stack[stack.len() - 1] } else { n };
        stack.push(i);
    }
    (0..n)
        .map(|i| {
            let (l, r) = (left[i], right[i]);
            let ends = (i - l) * ((twice[r + 1] - twice[i + 1] + ITER_MOD) % ITER_MOD) % ITER_MOD;
            let starts = (r - i) * ((twice[i + 1] - twice[l + 1] + ITER_MOD) % ITER_MOD) % ITER_MOD;
            strength[i] % ITER_MOD * ((ends - starts + ITER_MOD) % ITER_MOD) % ITER_MOD
        })
        .fold(0, |total, share| (total + share) % ITER_MOD)
}

// ---- wizards_solution.kara: LeetCode's Rust template
impl Solution {
    pub fn total_strength(strength: Vec[i32]) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let n = strength.len();
        let s: Vec[i64] = strength.iter().map(|x| x as i64).collect();
        let mut left = Vec.filled(n, -1);
        let mut right = Vec.filled(n, n);
        let mut st: Vec[i64] = Vec.new();
        for i in 0..n {
            while let Some(t) = st.last().cloned() {
                if s[t] >= s[i] {
                    st.pop();
                } else {
                    break;
                }
            }
            left[i] = st.last().map_or(-1, |t| t);
            st.push(i);
        }
        st.clear();
        for i in (0..n).rev() {
            while let Some(t) = st.last().cloned() {
                if s[t] > s[i] {
                    st.pop();
                } else {
                    break;
                }
            }
            right[i] = st.last().map_or(n, |t| t);
            st.push(i);
        }
        let mut pre = Vec.filled(n + 2, 0);
        let mut acc = 0;
        for i in 0..n {
            acc = (acc + s[i]) % MOD;
            pre[i + 2] = (pre[i + 1] + acc) % MOD;
        }
        let mut ans = 0;
        for i in 0..n {
            let l = left[i] + 1;
            let r = right[i] - 1;
            let tot = ((i - l + 1) * (pre[r + 2] - pre[i + 1]) % MOD
                - (r - i + 1) * (pre[i + 1] - pre[l]) % MOD)
                % MOD;
            ans = (ans + s[i] * tot) % MOD;
        }
        ((ans + MOD) % MOD) as i32
    }
}

struct Solution {}

fn solution_total_strength(strength: Vec[i64]) -> i64 {
    Solution.total_strength(strength.iter().map(|x| x as i32).collect())
}


// ---- the statement read literally

fn literal(strength: Vec[i64]) -> i64 {
    let n = strength.len();
    let mut total = 0;
    for l in 0..n {
        for r in l..n {
            let mut weakest = strength[l];
            let mut sum = 0;
            for k in l..r + 1 {
                weakest = weakest.min(strength[k]);
                sum += strength[k];
            }
            total = (total + weakest * sum % 1000000007) % 1000000007;
        }
    }
    total
}

fn answer(arm: i64, strength: Vec[i64]) -> i64 {
    match arm {
        0 => star_total_strength(strength),
        1 => onepass_total_strength(strength),
        2 => dp_total_strength(strength),
        3 => struct_total_strength(strength),
        4 => iter_total_strength(strength),
        _ => solution_total_strength(strength),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "onepass", "dp", "struct", "iter", "solution"];
    let modulus = 1000000007;
    let mut seed = 2281;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..360 {
        let n = next_random(mut seed) % 12 + 1;
        let mut strength: Vec[i64] = Vec.new();
        if c < 300 {
            let high = [2, 5, 1000][c % 3];
            for _ in 0..n {
                strength.push(next_random(mut seed) % high + 1);
            }
        } else if c < 330 {
            let x = next_random(mut seed) % 1000 + 1;
            for _ in 0..n {
                strength.push(x);
            }
        } else {
            let start = next_random(mut seed) % 100 + 1;
            let step = next_random(mut seed) % 5 + 1;
            for i in 0..n {
                strength.push(if c % 2 == 0 { start + i * step } else { start + (n - 1 - i) * step });
            }
        }
        cases.push(strength);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for strength in cases.iter() {
        let truth = literal(strength);
        check = (check * 31 + truth) % 1000000007;
        let n = strength.len();
        let back: Vec[i64] = strength.iter().rev().cloned().collect();
        let tripled: Vec[i64] = strength.iter().map(|x| 3 * x).collect();
        // every group's strengths summed: wizard `i` is in `(i + 1) * (n - i)`
        let mut groups = 0;
        let mut least = strength[0];
        let mut most = strength[0];
        for i in 0..n {
            groups += strength[i] * (i + 1) * (n - i);
            least = least.min(strength[i]);
            most = most.max(strength[i]);
        }
        // the front wizard starts n + 1 groups, the k-th of which holds it
        // and the first k wizards
        let mut front: Vec[i64] = [least].to_vec();
        front.extend(strength.iter().cloned());
        let mut started = 0;
        let mut sum = least;
        for k in 0..n + 1 {
            started += sum;
            if k < n {
                sum += strength[k];
            }
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, strength)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, back) == value,
                answer(arm, tripled) == 9 * value % modulus,
                value >= least * groups and value <= most * groups,
                answer(arm, front) == (value + least * started) % modulus,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{strength} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
