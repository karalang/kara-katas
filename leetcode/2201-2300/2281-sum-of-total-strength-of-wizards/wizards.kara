// LeetCode #2281: Sum of Total Strength of Wizards -- the ★ arm. Each
// group is counted at its weakest wizard, the rightmost one when the
// weakest strength repeats: wizard `i` is the weakest of every group
// from just past the nearest weaker wizard on its left, `L`, to just
// before the nearest one no stronger on its right, `R`, both found by a
// monotonic stack. The groups' totals there are differences of prefix
// sums, and summed over every left and right end they are differences
// of the prefix sums' own prefix sums:
//
//   (i - L) * (PP[R + 1] - PP[i + 1]) - (R - i) * (PP[i + 1] - PP[L + 1])
//
// all taken modulo 10^9 + 7. O(n).

const MOD: i64 = 1000000007;

fn total_strength(strength: Vec[i64]) -> i64 {
    let n = strength.len();
    let mut left: Vec[i64] = Vec.filled(n, -1);
    let mut right: Vec[i64] = Vec.filled(n, n);
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..n {
        while stack.len() > 0 and strength[stack[stack.len() - 1]] >= strength[i] {
            stack.pop();
        }
        if stack.len() > 0 {
            left[i] = stack[stack.len() - 1];
        }
        stack.push(i);
    }
    stack.clear();
    for i in (0..n).rev() {
        while stack.len() > 0 and strength[stack[stack.len() - 1]] > strength[i] {
            stack.pop();
        }
        if stack.len() > 0 {
            right[i] = stack[stack.len() - 1];
        }
        stack.push(i);
    }
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = (prefix[i] + strength[i]) % MOD;
    }
    let mut twice: Vec[i64] = Vec.filled(n + 2, 0);
    for i in 0..n + 1 {
        twice[i + 1] = (twice[i] + prefix[i]) % MOD;
    }
    let mut total = 0;
    for i in 0..n {
        let (l, r) = (left[i], right[i]);
        let ends = (i - l) * ((twice[r + 1] - twice[i + 1] + MOD) % MOD) % MOD;
        let starts = (r - i) * ((twice[i + 1] - twice[l + 1] + MOD) % MOD) % MOD;
        let groups = (ends - starts + MOD) % MOD;
        total = (total + strength[i] % MOD * groups) % MOD;
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    let high = next_random(mut seed);
    high * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples, then five more: one wizard, the strongest
    // alone, three alike, rising and falling
    let examples = [
        [1, 3, 1, 2].to_vec(),
        [5, 4, 6].to_vec(),
        [7].to_vec(),
        [1000000000].to_vec(),
        [2, 2, 2].to_vec(),
        [1, 2, 3, 4, 5].to_vec(),
        [5, 4, 3, 2, 1].to_vec(),
    ];
    for strength in examples.iter() {
        println(f"{strength} -> {total_strength(strength)}");
    }
    // 2000 armies of 1 to 40 wizards of strength up to 3, 100 or 10^9
    let mut seed = 2281;
    let mut check = 0;
    for t in 0..2000 {
        let n = next_random(mut seed) % 40 + 1;
        let high = [3, 100, 1000000000][t % 3];
        let strength: Vec[i64] = (0..n).map(|_| wide_random(mut seed) % high + 1).collect();
        check = (check * 31 + total_strength(strength)) % 1000000007;
    }
    println(f"2000 armies: checksum {check}");
    // the constraints' largest, 10^5 wizards: random up to 10^9, all of
    // strength 10^9, and rising from 1
    let random: Vec[i64] = (0..100000).map(|_| wide_random(mut seed) % 1000000000 + 1).collect();
    let alike: Vec[i64] = Vec.filled(100000, 1000000000);
    let rising: Vec[i64] = (1..100001).collect();
    let answers = [total_strength(random), total_strength(alike), total_strength(rising)];
    println(f"10^5 wizards: {answers}");
}
