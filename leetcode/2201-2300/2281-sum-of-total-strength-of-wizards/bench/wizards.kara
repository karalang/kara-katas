// LeetCode #2281: Sum of Total Strength of Wizards -- the bench, the ★
// arm. Two monotonic stacks for how far each wizard stays the weakest,
// and the groups' totals from prefix sums of prefix sums. O(n).

const MOD: i64 = 1000000007;

fn total_strength(strength: Vec[i64]) -> i64 {
    let n = strength.len();
    let mut left: Vec[i64] = Vec.filled(n, -1);
    let mut right: Vec[i64] = Vec.filled(n, n);
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..n {
        while stack.len() > 0 and strength[stack[stack.len() - 1]] >= strength[i] {
            stack.pop();
        }
        if stack.len() > 0 {
            left[i] = stack[stack.len() - 1];
        }
        stack.push(i);
    }
    stack.clear();
    for i in (0..n).rev() {
        while stack.len() > 0 and strength[stack[stack.len() - 1]] > strength[i] {
            stack.pop();
        }
        if stack.len() > 0 {
            right[i] = stack[stack.len() - 1];
        }
        stack.push(i);
    }
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = (prefix[i] + strength[i]) % MOD;
    }
    let mut twice: Vec[i64] = Vec.filled(n + 2, 0);
    for i in 0..n + 1 {
        twice[i + 1] = (twice[i] + prefix[i]) % MOD;
    }
    let mut total = 0;
    for i in 0..n {
        let (l, r) = (left[i], right[i]);
        let ends = (i - l) * ((twice[r + 1] - twice[i + 1] + MOD) % MOD) % MOD;
        let starts = (r - i) * ((twice[i + 1] - twice[l + 1] + MOD) % MOD) % MOD;
        let groups = (ends - starts + MOD) % MOD;
        total = (total + strength[i] % MOD * groups) % MOD;
    }
    total
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 30 armies of the constraints' largest, 10^5 wizards of strength 1
    // to 10^9
    let mut seed = 2281;
    let mut check = 0;
    for _ in 0..30 {
        let mut strength: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            let high = next_random(mut seed);
            strength.push((high * 32768 + next_random(mut seed)) % 1000000000 + 1);
        }
        check = (check * 31 + total_strength(strength)) % 1000000007;
    }
    println(f"30 armies of 10^5: checksum {check}");
}
