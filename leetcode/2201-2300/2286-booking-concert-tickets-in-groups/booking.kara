// LeetCode #2286: Booking Concert Tickets in Groups -- the ★ arm. A
// segment tree over the rows keeps each range's largest free run and its
// total free seats: `gather` walks down to the leftmost row with k free,
// `scatter` sums the free seats up to `max_row` and then fills rows from
// the first one not full. O(log n) per call, amortized for `scatter`.

struct BookMyShow {
    seats: i64,
    size: i64,
    most: Vec[i64],
    free: Vec[i64],
}

impl BookMyShow {
    fn new(n: i64, m: i64) -> BookMyShow {
        let mut size = 1;
        while size < n {
            size *= 2;
        }
        let mut most = Vec.filled(2 * size, 0);
        let mut free = Vec.filled(2 * size, 0);
        for r in 0..n {
            most[size + r] = m;
            free[size + r] = m;
        }
        for p in (1..size).rev() {
            most[p] = most[2 * p].max(most[2 * p + 1]);
            free[p] = free[2 * p] + free[2 * p + 1];
        }
        BookMyShow { seats: m, size: size, most: most, free: free }
    }

    fn set(mut ref self, row: i64, left: i64) {
        let mut p = self.size + row;
        self.most[p] = left;
        self.free[p] = left;
        p /= 2;
        while p >= 1 {
            self.most[p] = self.most[2 * p].max(self.most[2 * p + 1]);
            self.free[p] = self.free[2 * p] + self.free[2 * p + 1];
            p /= 2;
        }
    }

    // the leftmost row with at least k free seats, if any
    fn leftmost(self, k: i64) -> Option[i64] {
        if self.most[1] < k {
            return None;
        }
        let mut p = 1;
        while p < self.size {
            p = if self.most[2 * p] >= k { 2 * p } else { 2 * p + 1 };
        }
        Some(p - self.size)
    }

    // the free seats in rows 0 to `row`
    fn free_through(self, row: i64) -> i64 {
        let mut total = 0;
        let mut lo = self.size;
        let mut hi = self.size + row + 1;
        while lo < hi {
            if lo % 2 == 1 {
                total += self.free[lo];
                lo += 1;
            }
            if hi % 2 == 1 {
                hi -= 1;
                total += self.free[hi];
            }
            lo /= 2;
            hi /= 2;
        }
        total
    }

    fn gather(mut ref self, k: i64, max_row: i64) -> Vec[i64] {
        match self.leftmost(k) {
            Some(row) if row <= max_row => {
                let left = self.free[self.size + row];
                self.set(row, left - k);
                [row, self.seats - left]
            }
            _ => [],
        }
    }

    fn scatter(mut ref self, k: i64, max_row: i64) -> bool {
        if self.free_through(max_row) < k {
            return false;
        }
        let mut need = k;
        while need > 0 {
            let row = self.leftmost(1).unwrap();
            let left = self.free[self.size + row];
            let take = left.min(need);
            self.set(row, left - take);
            need -= take;
        }
        true
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// one call's answer folded into a checksum: a gather's row and seat, or
// 0 for none; a scatter's 1 or 2
fn run(n: i64, m: i64, calls: i64, high: i64, seed: mut ref i64) -> (i64, i64) {
    let mut show = BookMyShow.new(n, m);
    let mut check = 0;
    let mut booked = 0;
    for _ in 0..calls {
        let k = wide_random(mut seed) % high + 1;
        let max_row = next_random(mut seed) % n;
        let mark = if next_random(mut seed) % 2 == 0 {
            let got = show.gather(k, max_row);
            if got.len() == 2 {
                booked += k;
                (got[0] * 1000003 + got[1]) % 1000000007 + 3
            } else {
                0
            }
        } else if show.scatter(k, max_row) {
            booked += k;
            1
        } else {
            2
        };
        check = (check * 31 + mark) % 1000000007;
    }
    (check, booked)
}

fn main() {
    // LeetCode's example
    let mut show = BookMyShow.new(2, 5);
    println(f"{show.gather(4, 0)} {show.gather(2, 0)} {show.scatter(5, 1)} {show.scatter(5, 1)}");
    // a row filled exactly, then a gather past `max_row`, then a scatter
    // that takes every seat left
    let mut show = BookMyShow.new(3, 4);
    println(f"{show.gather(4, 0)} {show.gather(1, 0)} {show.gather(3, 2)} {show.scatter(5, 2)} {show.scatter(1, 2)}");
    // 400 small shows of 1 to 20 rows of 1 to 20 seats, 1 to 60 calls
    // asking for up to twice a row
    let mut seed = 2286;
    let mut check = 0;
    let mut booked = 0;
    for _ in 0..400 {
        let n = next_random(mut seed) % 20 + 1;
        let m = next_random(mut seed) % 20 + 1;
        let calls = next_random(mut seed) % 60 + 1;
        let (c, b) = run(n, m, calls, 2 * m, mut seed);
        check = (check * 31 + c) % 1000000007;
        booked += b;
    }
    println(f"400 shows: checksum {check}, {booked} seats booked");
    // one show of 2000 rows of 10^9 seats and 5000 calls of up to 2 * 10^9
    let (c, b) = run(2000, 1000000000, 5000, 2000000000, mut seed);
    println(f"2000 rows of 10^9: checksum {c}, {b} seats booked");
}
