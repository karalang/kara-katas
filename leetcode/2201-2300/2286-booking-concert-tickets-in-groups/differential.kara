// LeetCode #2286: Booking Concert Tickets in Groups -- the differential.
// The six arms, against the statement read literally: a grid of seats,
// each taken or not; a `gather` looks row by row, from row 0, for k
// free seats side by side, at the smallest seat they can start from; a
// `scatter` counts the free seats through `max_row` and takes the
// smallest seat of the smallest row, one at a time. No counts. 300
// random shows of 1 to 20 rows of 1 to 20 seats; then 30 of one row;
// then 30 of 1 to 50 rows of 10^9 seats, too many to lay out, judged by
// P2 to P6 only. Every show and its calls are drawn before any arm
// answers.
//
// P1  every answer is the literal reading's (20 seats or fewer)
// P2  a gather's [r, c] has r <= max_row and c + k <= m, and the seats
//     booked never pass n * m
// P3  a gather's seat c is the count already booked in row r by the
//     arm's own answers: each gather where it said, each scatter from
//     the smallest row with a seat free
// P4  the same calls on a show with one more row: the same answers
// P5  after the calls, scatters of every seat left all book, and then a
//     gather of 1 finds none
// P6  each arm agrees with at least three of the other five

// ---- booking.kara: the ★ arm, a segment tree of largest run and total
struct StarBookMyShow {
    seats: i64,
    size: i64,
    most: Vec[i64],
    free: Vec[i64],
}

impl StarBookMyShow {
    fn new(n: i64, m: i64) -> StarBookMyShow {
        let mut size = 1;
        while size < n {
            size *= 2;
        }
        let mut most = Vec.filled(2 * size, 0);
        let mut free = Vec.filled(2 * size, 0);
        for r in 0..n {
            most[size + r] = m;
            free[size + r] = m;
        }
        for p in (1..size).rev() {
            most[p] = most[2 * p].max(most[2 * p + 1]);
            free[p] = free[2 * p] + free[2 * p + 1];
        }
        StarBookMyShow { seats: m, size: size, most: most, free: free }
    }

    fn set(mut ref self, row: i64, left: i64) {
        let mut p = self.size + row;
        self.most[p] = left;
        self.free[p] = left;
        p /= 2;
        while p >= 1 {
            self.most[p] = self.most[2 * p].max(self.most[2 * p + 1]);
            self.free[p] = self.free[2 * p] + self.free[2 * p + 1];
            p /= 2;
        }
    }

    // the leftmost row with at least k free seats, if any
    fn leftmost(self, k: i64) -> Option[i64] {
        if self.most[1] < k {
            return None;
        }
        let mut p = 1;
        while p < self.size {
            p = if self.most[2 * p] >= k { 2 * p } else { 2 * p + 1 };
        }
        Some(p - self.size)
    }

    // the free seats in rows 0 to `row`
    fn free_through(self, row: i64) -> i64 {
        let mut total = 0;
        let mut lo = self.size;
        let mut hi = self.size + row + 1;
        while lo < hi {
            if lo % 2 == 1 {
                total += self.free[lo];
                lo += 1;
            }
            if hi % 2 == 1 {
                hi -= 1;
                total += self.free[hi];
            }
            lo /= 2;
            hi /= 2;
        }
        total
    }

    fn gather(mut ref self, k: i64, max_row: i64) -> Vec[i64] {
        match self.leftmost(k) {
            Some(row) if row <= max_row => {
                let left = self.free[self.size + row];
                self.set(row, left - k);
                [row, self.seats - left]
            }
            _ => [],
        }
    }

    fn scatter(mut ref self, k: i64, max_row: i64) -> bool {
        if self.free_through(max_row) < k {
            return false;
        }
        let mut need = k;
        while need > 0 {
            let row = self.leftmost(1).unwrap();
            let left = self.free[self.size + row];
            let take = left.min(need);
            self.set(row, left - take);
            need -= take;
        }
        true
    }
}

// ---- booking_naive.kara: the rows walked from 0
struct NaiveBookMyShow {
    seats: i64,
    taken: Vec[i64],
}

impl NaiveBookMyShow {
    fn new(n: i64, m: i64) -> NaiveBookMyShow {
        NaiveBookMyShow { seats: m, taken: Vec.filled(n, 0) }
    }

    fn gather(mut ref self, k: i64, max_row: i64) -> Vec[i64] {
        for row in 0..max_row + 1 {
            if self.seats - self.taken[row] >= k {
                let first = self.taken[row];
                self.taken[row] += k;
                return [row, first];
            }
        }
        []
    }

    fn scatter(mut ref self, k: i64, max_row: i64) -> bool {
        let mut free = 0;
        for row in 0..max_row + 1 {
            free += self.seats - self.taken[row];
        }
        if free < k {
            return false;
        }
        let mut need = k;
        for row in 0..max_row + 1 {
            let take = (self.seats - self.taken[row]).min(need);
            self.taken[row] += take;
            need -= take;
        }
        true
    }
}

// ---- booking_blocks.kara: blocks of about sqrt(n) rows
struct BlocksBookMyShow {
    seats: i64,
    width: i64,
    left: Vec[i64],
    most: Vec[i64],
    free: Vec[i64],
}

impl BlocksBookMyShow {
    fn new(n: i64, m: i64) -> BlocksBookMyShow {
        let mut width = 1;
        while width * width < n {
            width += 1;
        }
        let blocks = (n + width - 1) / width;
        let mut free = Vec.filled(blocks, 0);
        for row in 0..n {
            free[row / width] += m;
        }
        BlocksBookMyShow { seats: m, width: width, left: Vec.filled(n, m), most: Vec.filled(blocks, m), free: free }
    }

    fn take(mut ref self, row: i64, count: i64) {
        self.left[row] -= count;
        let b = row / self.width;
        self.free[b] -= count;
        let mut most = 0;
        for r in b * self.width..((b + 1) * self.width).min(self.left.len()) {
            most = most.max(self.left[r]);
        }
        self.most[b] = most;
    }

    fn gather(mut ref self, k: i64, max_row: i64) -> Vec[i64] {
        for b in 0..self.most.len() {
            if b * self.width > max_row {
                break;
            }
            if self.most[b] < k {
                continue;
            }
            for row in b * self.width..((b + 1) * self.width).min(max_row + 1) {
                if self.left[row] >= k {
                    let first = self.seats - self.left[row];
                    self.take(row, k);
                    return [row, first];
                }
            }
        }
        []
    }

    fn scatter(mut ref self, k: i64, max_row: i64) -> bool {
        let full = (max_row + 1) / self.width;
        let mut free = 0;
        for b in 0..full {
            free += self.free[b];
        }
        for row in full * self.width..max_row + 1 {
            free += self.left[row];
        }
        if free < k {
            return false;
        }
        let mut need = k;
        let mut row = 0;
        while need > 0 {
            if row % self.width == 0 and self.free[row / self.width] == 0 {
                row += self.width;
                continue;
            }
            let count = self.left[row].min(need);
            if count > 0 {
                self.take(row, count);
                need -= count;
            }
            row += 1;
        }
        true
    }
}

// ---- booking_fenwick.kara: a Fenwick tree and the first row not full
struct FenwickBookMyShow {
    seats: i64,
    left: Vec[i64],
    tree: Vec[i64],
    first: i64,
}

impl FenwickBookMyShow {
    fn new(n: i64, m: i64) -> FenwickBookMyShow {
        let mut tree = Vec.filled(n + 1, 0);
        for i in 1..n + 1 {
            tree[i] += m;
            let up = i + (i & (0 - i));
            if up <= n {
                tree[up] += tree[i];
            }
        }
        FenwickBookMyShow { seats: m, left: Vec.filled(n, m), tree: tree, first: 0 }
    }

    fn take(mut ref self, row: i64, count: i64) {
        self.left[row] -= count;
        let mut i = row + 1;
        while i < self.tree.len() {
            self.tree[i] -= count;
            i += i & (0 - i);
        }
        while self.first < self.left.len() and self.left[self.first] == 0 {
            self.first += 1;
        }
    }

    fn free_through(self, row: i64) -> i64 {
        let mut total = 0;
        let mut i = row + 1;
        while i > 0 {
            total += self.tree[i];
            i -= i & (0 - i);
        }
        total
    }

    fn gather(mut ref self, k: i64, max_row: i64) -> Vec[i64] {
        for row in self.first..max_row + 1 {
            if self.left[row] >= k {
                let first = self.seats - self.left[row];
                self.take(row, k);
                return [row, first];
            }
        }
        []
    }

    fn scatter(mut ref self, k: i64, max_row: i64) -> bool {
        if self.free_through(max_row) < k {
            return false;
        }
        let mut need = k;
        while need > 0 {
            let row = self.first;
            let count = self.left[row].min(need);
            self.take(row, count);
            need -= count;
        }
        true
    }
}

// ---- booking_iter.kara: `position`, `sum` and `iter_mut`
struct IterBookMyShow {
    seats: i64,
    left: Vec[i64],
}

impl IterBookMyShow {
    fn new(n: i64, m: i64) -> IterBookMyShow {
        IterBookMyShow { seats: m, left: Vec.filled(n, m) }
    }

    fn gather(mut ref self, k: i64, max_row: i64) -> Vec[i64] {
        match self.left.iter().take(max_row + 1).position(|f| f >= k) {
            Some(row) => {
                let first = self.seats - self.left[row];
                self.left[row] -= k;
                [row, first]
            }
            None => [],
        }
    }

    fn scatter(mut ref self, k: i64, max_row: i64) -> bool {
        if self.left.iter().take(max_row + 1).sum() < k {
            return false;
        }
        let mut need = k;
        for f in self.left.iter_mut() {
            if need == 0 {
                break;
            }
            let count = (*f).min(need);
            *f -= count;
            need -= count;
        }
        true
    }
}

// ---- booking_solution.kara: LeetCode's Rust template
struct SolutionBookMyShow {
    n: i64,
    m: i64,
    mx: Vec[i64],
    sm: Vec[i64],
}

impl SolutionBookMyShow {
    fn new(n: i32, m: i32) -> Self {
        let n = n as i64;
        let mut s = SolutionBookMyShow { n, m: m, mx: Vec.filled(4 * n, 0), sm: Vec.filled(4 * n, 0) };
        s.build(1, 0, n - 1);
        s
    }

    fn build(mut ref self, node: i64, l: i64, r: i64) {
        if l == r {
            self.mx[node] = self.m;
            self.sm[node] = self.m;
            return;
        }
        let mid = (l + r) / 2;
        self.build(node * 2, l, mid);
        self.build(node * 2 + 1, mid + 1, r);
        self.mx[node] = self.mx[node * 2].max(self.mx[node * 2 + 1]);
        self.sm[node] = self.sm[node * 2] + self.sm[node * 2 + 1];
    }

    fn update(mut ref self, node: i64, l: i64, r: i64, i: i64, v: i64) {
        if l == r {
            self.mx[node] -= v;
            self.sm[node] -= v;
            return;
        }
        let mid = (l + r) / 2;
        if i <= mid {
            self.update(node * 2, l, mid, i, v);
        } else {
            self.update(node * 2 + 1, mid + 1, r, i, v);
        }
        self.mx[node] = self.mx[node * 2].max(self.mx[node * 2 + 1]);
        self.sm[node] = self.sm[node * 2] + self.sm[node * 2 + 1];
    }

    fn first(self, node: i64, l: i64, r: i64, k: i64, max_row: i64) -> Option[i64] {
        if self.mx[node] < k or l > max_row {
            return None;
        }
        if l == r {
            return Some(l);
        }
        let mid = (l + r) / 2;
        if let Some(i) = self.first(node * 2, l, mid, k, max_row) {
            return Some(i);
        }
        self.first(node * 2 + 1, mid + 1, r, k, max_row)
    }

    fn sum(self, node: i64, l: i64, r: i64, max_row: i64) -> i64 {
        if l > max_row {
            return 0;
        }
        if r <= max_row {
            return self.sm[node];
        }
        let mid = (l + r) / 2;
        self.sum(node * 2, l, mid, max_row) + self.sum(node * 2 + 1, mid + 1, r, max_row)
    }

    fn gather(mut ref self, k: i32, max_row: i32) -> Vec[i32] {
        let k = k as i64;
        match self.first(1, 0, self.n - 1, k, max_row) {
            Some(i) => {
                let used = self.m - (self.sum(1, 0, self.n - 1, i) - if i > 0 { self.sum(1, 0, self.n - 1, i - 1) } else { 0 });
                self.update(1, 0, self.n - 1, i, k);
                [i as i32, used as i32]
            }
            None => Vec.new(),
        }
    }

    fn scatter(mut ref self, k: i32, max_row: i32) -> bool {
        let mut k = k as i64;
        if self.sum(1, 0, self.n - 1, max_row) < k {
            return false;
        }
        while k > 0 {
            let i = self.first(1, 0, self.n - 1, 1, max_row).unwrap();
            let free = self.sum(1, 0, self.n - 1, i) - if i > 0 { self.sum(1, 0, self.n - 1, i - 1) } else { 0 };
            let take = free.min(k);
            self.update(1, 0, self.n - 1, i, take);
            k -= take;
        }
        true
    }
}

struct SolutionShow {
    inner: SolutionBookMyShow,
}

impl SolutionShow {
    fn new(n: i64, m: i64) -> SolutionShow {
        SolutionShow { inner: SolutionBookMyShow.new(n as i32, m as i32) }
    }

    fn gather(mut ref self, k: i64, max_row: i64) -> Vec[i64] {
        self.inner.gather(k as i32, max_row as i32).iter().map(|x| x as i64).collect()
    }

    fn scatter(mut ref self, k: i64, max_row: i64) -> bool {
        self.inner.scatter(k as i32, max_row as i32)
    }
}


// ---- the statement read literally

struct Hall {
    taken: Vec[Vec[bool]],
}

impl Hall {
    fn gather(mut ref self, k: i64, max_row: i64) -> Vec[i64] {
        let m = self.taken[0].len();
        for r in 0..max_row + 1 {
            for c in 0..m - k + 1 {
                let mut free = true;
                for s in c..c + k {
                    if self.taken[r][s] {
                        free = false;
                    }
                }
                if free {
                    for s in c..c + k {
                        self.taken[r][s] = true;
                    }
                    return [r, c];
                }
            }
        }
        []
    }

    fn scatter(mut ref self, k: i64, max_row: i64) -> bool {
        let mut free = 0;
        for r in 0..max_row + 1 {
            for t in self.taken[r].iter() {
                if not t {
                    free += 1;
                }
            }
        }
        if free < k {
            return false;
        }
        let mut need = k;
        for r in 0..max_row + 1 {
            for s in 0..self.taken[r].len() {
                if need > 0 and not self.taken[r][s] {
                    self.taken[r][s] = true;
                    need -= 1;
                }
            }
        }
        true
    }
}

// a call's answer as one number: a gather's row and seat, -1 for none;
// a scatter's -2 or -3
fn mark_of(got: Vec[i64]) -> i64 {
    if got.len() == 2 { got[0] * 4294967296 + got[1] } else { -1 }
}

fn mark_bool(b: bool) -> i64 {
    if b { -2 } else { -3 }
}

fn literal(n: i64, m: i64, calls: Vec[(bool, i64, i64)]) -> Vec[i64] {
    let mut hall = Hall { taken: Vec.filled(n, Vec.filled(m, false)) };
    let mut marks: Vec[i64] = Vec.new();
    for (gather, k, max_row) in calls.iter() {
        if gather {
            marks.push(if k <= m { mark_of(hall.gather(k, max_row)) } else { -1 });
        } else {
            marks.push(mark_bool(hall.scatter(k, max_row)));
        }
    }
    marks
}

fn play(arm: i64, n: i64, m: i64, calls: Vec[(bool, i64, i64)]) -> Vec[i64] {
    let mut marks: Vec[i64] = Vec.new();
    if arm == 0 {
        let mut show = StarBookMyShow.new(n, m);
        for (gather, k, max_row) in calls.iter() {
            marks.push(if gather { mark_of(show.gather(k, max_row)) } else { mark_bool(show.scatter(k, max_row)) });
        }
    } else if arm == 1 {
        let mut show = NaiveBookMyShow.new(n, m);
        for (gather, k, max_row) in calls.iter() {
            marks.push(if gather { mark_of(show.gather(k, max_row)) } else { mark_bool(show.scatter(k, max_row)) });
        }
    } else if arm == 2 {
        let mut show = BlocksBookMyShow.new(n, m);
        for (gather, k, max_row) in calls.iter() {
            marks.push(if gather { mark_of(show.gather(k, max_row)) } else { mark_bool(show.scatter(k, max_row)) });
        }
    } else if arm == 3 {
        let mut show = FenwickBookMyShow.new(n, m);
        for (gather, k, max_row) in calls.iter() {
            marks.push(if gather { mark_of(show.gather(k, max_row)) } else { mark_bool(show.scatter(k, max_row)) });
        }
    } else if arm == 4 {
        let mut show = IterBookMyShow.new(n, m);
        for (gather, k, max_row) in calls.iter() {
            marks.push(if gather { mark_of(show.gather(k, max_row)) } else { mark_bool(show.scatter(k, max_row)) });
        }
    } else {
        let mut show = SolutionShow.new(n, m);
        for (gather, k, max_row) in calls.iter() {
            marks.push(if gather { mark_of(show.gather(k, max_row)) } else { mark_bool(show.scatter(k, max_row)) });
        }
    }
    marks
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// the seats booked by each answer, and whether every gather's seat is
// the count its row already had (P3)
fn ledger(n: i64, m: i64, calls: Vec[(bool, i64, i64)], marks: Vec[i64]) -> (i64, bool) {
    let mut row_booked = Vec.filled(n, 0);
    let mut booked = 0;
    let mut steady = true;
    for i in 0..calls.len() {
        let (gather, k, _) = calls[i];
        let mark = marks[i];
        if gather and mark >= 0 {
            let r = mark / 4294967296;
            let c = mark % 4294967296;
            if r >= n or c != row_booked[r] {
                steady = false;
            } else {
                row_booked[r] += k;
            }
            booked += k;
        } else if not gather and mark == -2 {
            let mut need = k;
            for r in 0..n {
                let take = (m - row_booked[r]).min(need);
                row_booked[r] += take;
                need -= take;
            }
            booked += k;
        }
    }
    (booked, steady)
}

fn main() {
    let names = ["star", "naive", "blocks", "fenwick", "iter", "solution"];
    let mut seed = 2286;
    let mut cases: Vec[(i64, i64, Vec[(bool, i64, i64)])] = Vec.new();
    for c in 0..360 {
        let n = if c < 300 { next_random(mut seed) % 20 + 1 } else if c < 330 { 1 } else { next_random(mut seed) % 50 + 1 };
        let m = if c < 330 { next_random(mut seed) % 20 + 1 } else { 1000000000 };
        let count = next_random(mut seed) % 60 + 1;
        let mut calls: Vec[(bool, i64, i64)] = Vec.new();
        for _ in 0..count {
            let k = wide_random(mut seed) % (2 * m).min(1073741823) + 1;
            let max_row = next_random(mut seed) % n;
            calls.push((next_random(mut seed) % 2 == 0, k, max_row));
        }
        cases.push((n, m, calls));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (n, m, calls) in cases.iter() {
        let truth: Vec[i64] = if m <= 20 { literal(n, m, calls) } else { Vec.new() };
        for t in truth.iter() {
            check = (check * 31 + t % 1000000007 + 4) % 1000000007;
        }
        let got: Vec[Vec[i64]] = (0..6).map(|arm| play(arm, n, m, calls)).collect();
        for arm in 0..6 {
            let marks = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == marks {
                    same += 1;
                }
            }
            let mut valid = true;
            for i in 0..calls.len() {
                let (gather, k, max_row) = calls[i];
                if gather and marks[i] >= 0 {
                    let r = marks[i] / 4294967296;
                    let c = marks[i] % 4294967296;
                    if r > max_row or c + k > m {
                        valid = false;
                    }
                }
            }
            let (booked, steady) = ledger(n, m, calls, marks);
            let wider = play(arm, n + 1, m, calls);
            let mut more = calls.clone();
            // every seat left, in scatters of at most 10^9 (the limit on k)
            let left = n * m - booked;
            let mut rest = left;
            while rest > 0 {
                more.push((false, rest.min(1000000000), n - 1));
                rest -= rest.min(1000000000);
            }
            more.push((true, 1, n - 1));
            let after = play(arm, n, m, more);
            let mut tail_ok = after[more.len() - 1] == -1;
            for i in calls.len()..more.len() - 1 {
                tail_ok = tail_ok and after[i] == -2;
            }
            let verdicts = [
                m > 20 or marks == truth,
                valid and booked <= n * m,
                steady,
                wider == marks,
                left < 0 or (tail_ok and after[..calls.len()] == marks[..]),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"n {n} m {m} {calls.len()} calls arm {names[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
