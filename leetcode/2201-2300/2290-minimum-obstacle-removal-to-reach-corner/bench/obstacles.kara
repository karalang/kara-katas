// LeetCode #2290: Minimum Obstacle Removal to Reach Corner -- the bench,
// the ★ arm. A 0-1 breadth-first search over a `VecDeque`: a step onto
// an empty cell to the front, one onto an obstacle to the back.

fn minimum_obstacles(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut cost: Vec[i64] = Vec.filled(m * n, -1);
    let mut best: Vec[i64] = Vec.filled(m * n, i64.MAX);
    let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
    best[0] = 0;
    queue.push_back((0, 0));
    let moves = [(0, 1), (1, 0), (0, -1), (-1, 0)];
    while let Some((r, c)) = queue.pop_front() {
        if cost[r * n + c] >= 0 {
            continue;
        }
        let here = best[r * n + c];
        cost[r * n + c] = here;
        if r == m - 1 and c == n - 1 {
            return here;
        }
        for (dr, dc) in moves.iter() {
            let (nr, nc) = (r + dr, c + dc);
            if nr < 0 or nc < 0 or nr >= m or nc >= n {
                continue;
            }
            let step = grid[nr][nc];
            if here + step < best[nr * n + nc] {
                best[nr * n + nc] = here + step;
                if step == 0 {
                    queue.push_front((nr, nc));
                } else {
                    queue.push_back((nr, nc));
                }
            }
        }
    }
    best[m * n - 1]
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10 grids of 200 by 200 built once, each cell an obstacle with
    // chance 4 in 10, the corners empty; then 5 passes over all of them
    let mut seed = 2290;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..10 {
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..200 {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..200 {
                row.push(if next_random(mut seed) % 10 < 4 { 1 } else { 0 });
            }
            grid.push(row);
        }
        grid[0][0] = 0;
        grid[199][199] = 0;
        grids.push(grid);
    }
    let mut check = 0;
    for _ in 0..5 {
        let mut total = 0;
        for grid in grids.iter() {
            total += minimum_obstacles(grid);
        }
        check = (check * 31 + total) % 1000000007;
    }
    println(f"5 passes over 10 grids of 200x200: checksum {check}");
}
