// LeetCode #2269: Find the K-Beauty of a Number -- the ★ arm. The
// number's decimal string, every substring of length `k` parsed back to
// a number and counted when it is not 0 and divides `num`. O(d k) for d
// digits.

fn divisor_substrings(num: i64, k: i64) -> i64 {
    let s = num.to_string();
    let mut beauty = 0;
    for i in 0..=s.len() - k {
        let part = i64.parse(s[i..i + k]).unwrap();
        if part != 0 and num % part == 0 {
            beauty += 1;
        }
    }
    beauty
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then five more: one digit, the whole
    // number, a zero window, a number of equal digits, and the largest
    for (num, k) in [(240, 2), (430043, 2), (7, 1), (123456, 6), (1000, 2), (111111111, 3), (1000000000, 1)] {
        println(f"{num}, {k} -> {divisor_substrings(num, k)}");
    }
    // 3000 numbers below 10^1 to 10^9, each with a random k
    let mut seed = 2269;
    let mut total = 0;
    let mut check = 0;
    for t in 0..3000 {
        let digits = t % 9 + 1;
        let mut num = 0;
        for _ in 0..digits {
            num = num * 10 + next_random(mut seed) % 10;
        }
        if num == 0 {
            num = 1;
        }
        let k = next_random(mut seed) % num.to_string().len() + 1;
        let b = divisor_substrings(num, k);
        total += b;
        check = (check * 31 + b) % 1000000007;
    }
    println(f"3000 numbers: total {total}, checksum {check}");
    // every k for three numbers of ten digits' reach: 10^9, 999999999 and
    // 735134400
    for num in [1000000000, 999999999, 735134400] {
        let all: Vec[i64] = (1..=num.to_string().len()).map(|k| divisor_substrings(num, k)).collect();
        println(f"{num}: {all}");
    }
}
