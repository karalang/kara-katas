// LeetCode #2269: Find the K-Beauty of a Number -- the differential. The
// six arms, against the statement read literally: the number's digits
// taken off by `% 10`, every substring by its start and end, kept when
// it is `k` long, its value built digit by digit, and counted when it is
// not 0 and divides the number. No string of the number and no window.
// 300 random numbers of 1 to 8 digits, each with a random `k`; then 30
// of one digit repeated; then 30 of one digit followed by zeros. Every
// case is drawn before any arm answers.
//
// P1  the beauty is the literal reading's
// P2  `k` the number of digits: exactly 1
// P3  at least 0 and at most the number of windows, digits - k + 1
// P4  a 0 put after the number: at least the same beauty
// P5  `k` 1: the nonzero digits that divide the number, counted digit by
//     digit
// P6  each arm agrees with at least three of the other five

// ---- beauty.kara: the ★ arm, every substring parsed
fn star_divisor_substrings(num: i64, k: i64) -> i64 {
    let s = num.to_string();
    let mut beauty = 0;
    for i in 0..=s.len() - k {
        let part = i64.parse(s[i..i + k]).unwrap();
        if part != 0 and num % part == 0 {
            beauty += 1;
        }
    }
    beauty
}

// ---- beauty_arith.kara: the windows by `/` and `%`
fn arith_divisor_substrings(num: i64, k: i64) -> i64 {
    let mut width = 1;
    for _ in 0..k {
        width *= 10;
    }
    let mut beauty = 0;
    let mut shift = 1;
    while num / shift >= width / 10 {
        let part = num / shift % width;
        if part != 0 and num % part == 0 {
            beauty += 1;
        }
        shift *= 10;
    }
    beauty
}

// ---- beauty_rolling.kara: the window's value rolled along
fn rolling_divisor_substrings(num: i64, k: i64) -> i64 {
    let s = num.to_string();
    let mut width = 1;
    for _ in 0..k {
        width *= 10;
    }
    let mut value = 0;
    let mut beauty = 0;
    for (i, c) in s.chars().enumerate() {
        value = (value * 10 + c.to_digit(10).unwrap()) % width;
        if i + 1 >= k and value != 0 and num % value == 0 {
            beauty += 1;
        }
    }
    beauty
}

// ---- beauty_struct.kara: `struct Window` pushed a digit at a time
struct StructWindow {
    value: i64,
    seen: i64,
    k: i64,
    width: i64,
}

impl StructWindow {
    fn new(k: i64) -> StructWindow {
        let mut width = 1;
        for _ in 0..k {
            width *= 10;
        }
        StructWindow { value: 0, seen: 0, k: k, width: width }
    }

    fn push(mut ref self, digit: i64) {
        self.value = (self.value * 10 + digit) % self.width;
        self.seen += 1;
    }

    fn full(self) -> bool {
        self.seen >= self.k
    }
}

fn struct_divisor_substrings(num: i64, k: i64) -> i64 {
    let mut window = StructWindow.new(k);
    let mut beauty = 0;
    for b in num.to_string().bytes() {
        window.push(b - b'0');
        if window.full() and window.value != 0 and num % window.value == 0 {
            beauty += 1;
        }
    }
    beauty
}

// ---- beauty_iter.kara: `windows(k)` folded, filtered, counted
fn iter_divisor_substrings(num: i64, k: i64) -> i64 {
    num.to_string()
        .bytes()
        .windows(k)
        .into_iter()
        .map(|w| w.iter().fold(0, |v, b| v * 10 + (b - b'0')))
        .filter(|part| part != 0 and num % part == 0)
        .count()
}

// ---- beauty_solution.kara: LeetCode's Rust template
impl Solution {
    pub fn divisor_substrings(num: i32, k: i32) -> i32 {
        let s = num.to_string();
        let k = k as i64;
        let mut ans = 0;
        for i in 0..=s.len() - k {
            let t: i32 = i32.parse(s[i..i + k]).unwrap();
            if t != 0 and num % t == 0 {
                ans += 1;
            }
        }
        ans
    }
}

struct Solution {}

fn solution_divisor_substrings(num: i64, k: i64) -> i64 {
    Solution.divisor_substrings(num as i32, k as i32)
}


// ---- the statement read literally

// the decimal digits of `num`, the first one first
fn digits_of(num: i64) -> Vec[i64] {
    let mut d: Vec[i64] = Vec.new();
    let mut n = num;
    while n > 0 {
        d.push(n % 10);
        n /= 10;
    }
    d.reverse();
    d
}

fn literal(num: i64, k: i64) -> i64 {
    let d = digits_of(num);
    let mut beauty = 0;
    for start in 0..d.len() {
        for end in start + 1..=d.len() {
            if end - start != k {
                continue;
            }
            let mut value = 0;
            for i in start..end {
                value = value * 10 + d[i];
            }
            if value != 0 and num % value == 0 {
                beauty += 1;
            }
        }
    }
    beauty
}

fn answer(arm: i64, num: i64, k: i64) -> i64 {
    match arm {
        0 => star_divisor_substrings(num, k),
        1 => arith_divisor_substrings(num, k),
        2 => rolling_divisor_substrings(num, k),
        3 => struct_divisor_substrings(num, k),
        4 => iter_divisor_substrings(num, k),
        _ => solution_divisor_substrings(num, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "arith", "rolling", "struct", "iter", "solution"];
    let mut seed = 2269;
    let mut cases: Vec[(i64, i64)] = Vec.new();
    for c in 0..360 {
        let len = next_random(mut seed) % 8 + 1;
        let mut num = 0;
        if c < 300 {
            for _ in 0..len {
                num = num * 10 + next_random(mut seed) % 10;
            }
            if num == 0 {
                num = 7;
            }
        } else if c < 330 {
            let digit = next_random(mut seed) % 9 + 1;
            for _ in 0..len {
                num = num * 10 + digit;
            }
        } else {
            num = next_random(mut seed) % 9 + 1;
            for _ in 1..len {
                num *= 10;
            }
        }
        let k = next_random(mut seed) % digits_of(num).len() + 1;
        cases.push((num, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (num, k) in cases.iter() {
        let truth = literal(num, k);
        check = (check * 31 + truth) % 1000000007;
        let d = digits_of(num);
        let mut by_digit = 0;
        for x in d.iter() {
            if x != 0 and num % x == 0 {
                by_digit += 1;
            }
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, num, k)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, num, d.len()) == 1,
                value >= 0 and value <= d.len() - k + 1,
                answer(arm, num * 10, k) >= value,
                answer(arm, num, 1) == by_digit,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{num}, {k} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
