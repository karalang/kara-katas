// LeetCode #2269: Find the K-Beauty of a Number -- the ★ arm. The
// number's decimal string, every substring of length `k` parsed back to
// a number and counted when it is not 0 and divides `num`. O(d k) for d
// digits.

fn divisor_substrings(num: i64, k: i64) -> i64 {
    let s = num.to_string();
    let mut beauty = 0;
    for i in 0..=s.len() - k {
        let part = i64.parse(s[i..i + k]).unwrap();
        if part != 0 and num % part == 0 {
            beauty += 1;
        }
    }
    beauty
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 200000 numbers below 10^9, from two draws, with k from 1 to 9 in turn
    // and cut to the number's own length
    let mut seed = 2269;
    let mut check = 0;
    for t in 0..200000 {
        let num = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1;
        let k = (t % 9 + 1).min(num.to_string().len());
        check = (check * 31 + divisor_substrings(num, k)) % 1000000007;
    }
    println(f"200000 numbers: checksum {check}");
}
