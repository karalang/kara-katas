// LeetCode #2232: Minimize Result by Adding Parentheses to Expression --
// each candidate written out in full, the parentheses `insert`ed into
// the expression's characters, and then evaluated as it reads: a number
// before "(" multiplies the sum inside, and one after ")" multiplies
// again. The first smallest candidate is the answer.

// the value of a string such as "12(3+45)6"
fn evaluate(candidate: String) -> i64 {
    let mut outside = 1;
    let mut inside = 0;
    let mut number = 0;
    for c in candidate.chars() {
        match c {
            '(' => {
                if number > 0 {
                    outside *= number;
                }
                number = 0;
            }
            '+' => {
                inside += number;
                number = 0;
            }
            ')' => {
                inside += number;
                number = 0;
            }
            _ => number = number * 10 + (c as i64) - 48,
        }
    }
    if number > 0 {
        outside *= number;
    }
    outside * inside
}

fn minimize_result(expression: String) -> String {
    let plus = expression.find("+").unwrap();
    let mut best = i64.MAX;
    let mut answer = String.new();
    for open in 0..plus {
        for close in plus + 2..=expression.len() {
            let mut chars: Vec[char] = expression.chars().collect();
            chars.insert(close, ')');
            chars.insert(open, '(');
            let candidate: String = chars.iter().collect();
            let value = evaluate(candidate);
            if value < best {
                best = value;
                answer = candidate;
            }
        }
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random digits of 1 to 9
fn draw_digits(seed: mut ref i64, count: i64) -> String {
    let mut digits = String.new();
    for _ in 0..count {
        digits.push(char.try_from((49 + next_random(mut seed) % 9) as u32).ok().unwrap());
    }
    digits
}

fn main() {
    // LeetCode's three examples, then four more: one digit each side,
    // both sides split, the longest left side, and the longest right side
    for expression in ["247+38", "12+34", "999+999", "1+1", "11+11", "12345678+9", "1+23456789"] {
        println(f"{expression} -> {minimize_result(expression)}");
    }
    // 3000 random expressions of 3 to 10 characters
    let mut seed = 2232;
    let mut check = 0;
    for _ in 0..3000 {
        let left = next_random(mut seed) % 8 + 1;
        let right = next_random(mut seed) % (9 - left) + 1;
        let expression = f"{draw_digits(mut seed, left)}+{draw_digits(mut seed, right)}";
        for b in minimize_result(expression).bytes() {
            check = (check * 31 + b) % 1000000007;
        }
    }
    println(f"3000 expressions: checksum {check}");
    // every expression of two digits on each side, by its parentheses
    let mut wrapped = 0;
    let mut split = 0;
    for a in 11..100 {
        for b in 11..100 {
            if a % 10 != 0 and b % 10 != 0 {
                let answer = minimize_result(f"{a}+{b}");
                if answer.starts_with("(") and answer.ends_with(")") {
                    wrapped += 1;
                } else {
                    split += 1;
                }
            }
        }
    }
    println(f"6561 two-digit sums: {wrapped} wrapped whole, {split} split");
}
