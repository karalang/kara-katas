// LeetCode #2266: Count Number of Texts -- by runs. Presses of different
// keys never share a letter, so the count is the product over the runs
// of one key. A run of `n` presses on a key of `k` letters means as many
// messages as the ways to write `n` as an ordered sum of parts 1 to `k`;
// two tables of those, for `k` = 3 and 4, are filled up to the longest
// run first. Modulo 10^9 + 7. O(n).

const MOD: i64 = 1000000007;

fn table(parts: i64, upto: i64) -> Vec[i64] {
    let mut t = Vec.filled(upto + 1, 0);
    t[0] = 1;
    for n in 1..upto + 1 {
        for p in 1..parts + 1 {
            if p <= n {
                t[n] = (t[n] + t[n - p]) % MOD;
            }
        }
    }
    t
}

fn count_texts(pressed_keys: String) -> i64 {
    let keys: Vec[char] = pressed_keys.chars().collect();
    let three = table(3, keys.len());
    let four = table(4, keys.len());
    let mut total = 1;
    let mut start = 0;
    while start < keys.len() {
        let mut end = start;
        while end < keys.len() and keys[end] == keys[start] {
            end += 1;
        }
        let run = end - start;
        let ways = if keys[start] == '7' or keys[start] == '9' { four[run] } else { three[run] };
        total = total * ways % MOD;
        start = end;
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `len` presses from the keys in `keys`
fn presses(seed: mut ref i64, len: i64, keys: Str) -> String {
    let k = keys.bytes();
    let mut s = String.new();
    for _ in 0..len {
        s.push(k[next_random(mut seed) % k.len()] as char);
    }
    s
}

fn main() {
    // LeetCode's two examples, then five more: one press, a run of four on
    // a three-letter key and on a four-letter key, two keys alternating,
    // and a run of five sevens
    for keys in ["22233", "222222222222222222222222222222222222", "8", "2222", "7777", "232323", "77777"] {
        println(f"{keys} -> {count_texts(keys.to_string())}");
    }
    // 2000 presses of 1 to 40 keys from "2", "79", "27", "234" or all eight
    let mut seed = 2266;
    let mut check = 0;
    for t in 0..2000 {
        let len = next_random(mut seed) % 40 + 1;
        let pressed = presses(mut seed, len, ["2", "79", "27", "234", "23456789"][t % 5]);
        check = (check * 31 + count_texts(pressed)) % 1000000007;
    }
    println(f"2000 presses: checksum {check}");
    // the constraints' longest, 10^5 presses: all `7`, all `2`, and random
    // from `7` and `9`
    let sevens = "7".repeat(100000);
    let twos = "2".repeat(100000);
    let mixed = presses(mut seed, 100000, "79");
    let answers = [count_texts(sevens), count_texts(twos), count_texts(mixed)];
    println(f"10^5 presses: {answers}");
}
