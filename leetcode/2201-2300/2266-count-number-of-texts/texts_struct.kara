// LeetCode #2266: Count Number of Texts -- a struct of the keypad.
// `struct Keypad` keeps the counts for the last four prefixes, newest
// first, in an `Array[i64, 4]`, the key of the current run and its
// length; `press` (`mut ref self`) takes one key. O(n).

const MOD: i64 = 1000000007;

struct Keypad {
    recent: Array[i64, 4],
    key: u8,
    run: i64,
}

impl Keypad {
    fn new() -> Keypad {
        Keypad { recent: [1, 0, 0, 0], key: 0, run: 0 }
    }

    fn letters(key: u8) -> i64 {
        match key {
            b'7' | b'9' => 4,
            _ => 3,
        }
    }

    fn press(mut ref self, key: u8) {
        if key == self.key {
            self.run += 1;
        } else {
            self.key = key;
            self.run = 1;
        }
        let reach = self.run.min(Keypad.letters(key));
        let mut now = 0;
        for back in 0..reach {
            now = (now + self.recent[back]) % MOD;
        }
        for i in (1..4).rev() {
            self.recent[i] = self.recent[i - 1];
        }
        self.recent[0] = now;
    }
}

fn count_texts(pressed_keys: String) -> i64 {
    let mut pad = Keypad.new();
    for key in pressed_keys.bytes() {
        pad.press(key);
    }
    pad.recent[0]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `len` presses from the keys in `keys`
fn presses(seed: mut ref i64, len: i64, keys: Str) -> String {
    let k = keys.bytes();
    let mut s = String.new();
    for _ in 0..len {
        s.push(k[next_random(mut seed) % k.len()] as char);
    }
    s
}

fn main() {
    // LeetCode's two examples, then five more: one press, a run of four on
    // a three-letter key and on a four-letter key, two keys alternating,
    // and a run of five sevens
    for keys in ["22233", "222222222222222222222222222222222222", "8", "2222", "7777", "232323", "77777"] {
        println(f"{keys} -> {count_texts(keys.to_string())}");
    }
    // 2000 presses of 1 to 40 keys from "2", "79", "27", "234" or all eight
    let mut seed = 2266;
    let mut check = 0;
    for t in 0..2000 {
        let len = next_random(mut seed) % 40 + 1;
        let pressed = presses(mut seed, len, ["2", "79", "27", "234", "23456789"][t % 5]);
        check = (check * 31 + count_texts(pressed)) % 1000000007;
    }
    println(f"2000 presses: checksum {check}");
    // the constraints' longest, 10^5 presses: all `7`, all `2`, and random
    // from `7` and `9`
    let sevens = "7".repeat(100000);
    let twos = "2".repeat(100000);
    let mixed = presses(mut seed, 100000, "79");
    let answers = [count_texts(sevens), count_texts(twos), count_texts(mixed)];
    println(f"10^5 presses: {answers}");
}
