// LeetCode #2242: Maximum Score of a Node Sequence -- each node's
// neighbours sorted by score, largest first, and cut to three; every
// edge as the middle one tries the nine pairs of a neighbour of one end
// and a neighbour of the other, all four distinct. O(n + m log m).

fn maximum_score(scores: Vec[i64], edges: Vec[(i64, i64)]) -> i64 {
    let n = scores.len();
    let mut best3: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for (a, b) in edges.iter() {
        best3[a].push(b);
        best3[b].push(a);
    }
    for node in 0..n {
        best3[node].sort_by(|x, y| scores[y].cmp(scores[x]));
        best3[node].truncate(3);
    }
    let mut best = -1;
    for (b, c) in edges.iter() {
        for a in best3[b].iter() {
            if a == c {
                continue;
            }
            for d in best3[c].iter() {
                if d != a and d != b {
                    best = best.max(scores[a] + scores[b] + scores[c] + scores[d]);
                }
            }
        }
    }
    best
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // 40 graphs of 50000 nodes and 50000 edges, edge j joining node j to
    // the node 1 to 24998 after it, round the ring, so that no two edges
    // join the same pair; scores up to 10^8
    let n = 50000;
    let mut seed = 2242;
    let mut check = 0;
    for _ in 0..40 {
        let scores: Vec[i64] = (0..n).map(|_| wide_random(mut seed) % 100000000 + 1).collect();
        let edges: Vec[(i64, i64)] = (0..n).map(|j| (j, (j + 1 + wide_random(mut seed) % (n / 2 - 2)) % n)).collect();
        check = (check * 31 + maximum_score(scores, edges)) % 1000000007;
    }
    println(f"40 graphs of 50000 nodes: checksum {check}");
}
