// LeetCode #2270: Number of Ways to Split Array -- the ★ arm. The total
// once, then the left part's sum as it grows; a split after index `i` is
// valid when the left sum is at least the rest, `total - left`. The sums
// reach 10^10, past an `i32`. O(n).

fn ways_to_split_array(nums: Vec[i64]) -> i64 {
    let total: i64 = nums.iter().sum();
    let mut left = 0;
    let mut ways = 0;
    for i in 0..nums.len() - 1 {
        left += nums[i];
        if left >= total - left {
            ways += 1;
        }
    }
    ways
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 100 arrays of the constraints' longest, 10^5 values from -10^5 to
    // 10^5, built afresh
    let mut seed = 2270;
    let mut check = 0;
    for _ in 0..100 {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            nums.push(next_random(mut seed) % 200001 - 100000);
        }
        check = (check * 31 + ways_to_split_array(nums)) % 1000000007;
    }
    println(f"100 arrays of 10^5: checksum {check}");
}
