// LeetCode #2283: Check if Number Has Equal Digit Count and Digit Value
// -- LeetCode's Rust template: `String` in, `bool` out; `[0usize; 10]`
// counted over `num.bytes()`, then `enumerate().all(..)` comparing each
// count with `(b - b'0') as usize`. Carried by `karac fix`. The adapter
// below hands the harness's values to it.

impl Solution {
    pub fn digit_count(num: String) -> bool {
        let mut cnt = [0usize; 10];
        for b in num.bytes() {
            cnt[(b - b'0') as usize] += 1;
        }
        num.bytes().iter().enumerate().all(|(i, b)| cnt[i] == (b - b'0'))
    }
}

struct Solution {}

fn digit_count(num: Str) -> bool {
    Solution.digit_count(num.to_string())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then the other self-describing strings,
    // one of each length that has one, and near misses
    let examples = [
        "1210", "030", "2020", "21200", "3211000", "42101000", "521001000", "6210001000",
        "0", "1", "10", "1211", "2120", "6210001001",
    ];
    for num in examples.iter() {
        println(f"{num} -> {digit_count(num)}");
    }
    // 5000 strings of 1 to 10 digits, each below 3, at most the length,
    // or any; and the true ones counted
    let mut seed = 2283;
    let mut check = 0;
    let mut held = 0;
    for t in 0..5000 {
        let n = next_random(mut seed) % 10 + 1;
        let high = [3, n.min(9) + 1, 10][t % 3];
        let mut num = String.new();
        for _ in 0..n {
            num.push((b'0' + (next_random(mut seed) % high) as u8) as char);
        }
        let answer = digit_count(num);
        check = (check * 31 + (if answer { 1 } else { 0 })) % 1000000007;
        if answer {
            held += 1;
        }
    }
    println(f"5000 strings: checksum {check}, {held} true");
    // every string of 4 digits, each below 5: those that hold
    let mut found: Vec[String] = Vec.new();
    for v in 0..625 {
        let mut num = String.new();
        let mut rest = v;
        for _ in 0..4 {
            num.push((b'0' + (rest % 5) as u8) as char);
            rest /= 5;
        }
        if digit_count(num) {
            found.push(num);
        }
    }
    println(f"4 digits below 5: {found}");
}
