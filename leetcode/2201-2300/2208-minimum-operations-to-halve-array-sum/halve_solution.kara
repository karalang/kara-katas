// LeetCode #2208: Minimum Operations to Halve Array Sum -- LeetCode's Rust
// template: `Vec<i32>` in, `i32` out, the numbers shifted left 20 places
// into a `BinaryHeap<i64>`, the largest first, halved until half the sum
// is gone. Carried by `karac fix`. The adapter below hands the harness's
// numbers to it.

impl Solution {
    pub fn halve_array(nums: Vec[i32]) -> i32 {
        let mut heap: PriorityQueue[i64] = PriorityQueue.max_first_from(nums.iter().map(|x| (x as i64) << 20).collect());
        let total: i64 = heap.iter().sum();
        let mut removed = 0;
        let mut ops = 0;
        while removed * 2 < total {
            let x = heap.pop().unwrap();
            removed += x / 2;
            heap.push(x / 2);
            ops += 1;
        }
        ops
    }
}

struct Solution {}

fn halve_array(nums: Vec[i64]) -> i64 {
    let narrow: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.halve_array(narrow)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {halve_array(nums)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number, two alike, one
    // large among small ones, and both ends of the range
    show([5, 19, 8, 1]);
    show([3, 8, 20]);
    show([7]);
    show([4, 4]);
    show([100, 1, 1, 1]);
    show([10000000, 1]);
    // 2000 random arrays of 1 to 12 numbers up to 10, 1000 and 10^7 in turn
    let mut seed = 2208;
    let mut most = 0;
    let mut check = 0;
    for c in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let top = [10, 1000, 10000000][c % 3];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(wide_random(mut seed) % top + 1);
        }
        let ops = halve_array(nums);
        most = most.max(ops);
        check = (check * 31 + ops) % 1000000007;
    }
    println(f"2000 arrays: most {most}, checksum {check}");
    // the constraints' largest: 10^5 numbers, all 10^7, then random up to
    // 10^7, then one 10^7 among ones
    let same: Vec[i64] = Vec.filled(100000, 10000000);
    println(f"10^5 of 10^7 -> {halve_array(same)}");
    let mut wide: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        wide.push(wide_random(mut seed) % 10000000 + 1);
    }
    println(f"10^5 random -> {halve_array(wide)}");
    let mut lone: Vec[i64] = Vec.filled(100000, 1);
    lone[50000] = 10000000;
    println(f"10^7 among 99999 ones -> {halve_array(lone)}");
}
