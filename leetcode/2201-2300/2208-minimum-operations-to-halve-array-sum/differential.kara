// LeetCode #2208: Minimum Operations to Halve Array Sum -- the
// differential. The six arms, against the statement read literally: for
// k = 1, 2, ... every way to share k halvings among the numbers tried,
// each number's halvings worked exactly on the number shifted left 20
// places, until one way takes off half the sum; no heap, no greed. 300
// random arrays of 1 to 8 numbers up to 10, 1000 and 10^7 in turn; then 30
// of one number repeated; then 30 with one number far above the rest.
// Every case is drawn before any arm answers.
//
// P1  the count is the statement read literally
// P2  it is at least 1 and at most n, one halving of every number
// P3  the array reversed: the same count
// P4  every number doubled: the same count
// P5  the array followed by itself: no fewer, and at most twice as many
// P6  each arm agrees with at least three of the other five

import std.cmp.Reverse;

// ---- halve.kara: the ★ arm, a `PriorityQueue` of `Reverse[F64]`

fn star_halve_array(nums: Vec[i64]) -> i64 {
    let mut heap: PriorityQueue[Reverse[F64]] = PriorityQueue.new();
    let mut total = 0.0;
    for x in nums.iter() {
        total += x as f64;
        heap.push(Reverse { value: F64.from(x as f64) });
    }
    let mut removed = 0.0;
    let mut ops = 0;
    while removed < total / 2.0 {
        let Reverse { value: top } = heap.pop().unwrap();
        let half = top.value / 2.0;
        removed += half;
        heap.push(Reverse { value: F64.from(half) });
        ops += 1;
    }
    ops
}

// ---- halve_scaled.kara: exact integers shifted left 20 places

fn scaled_halve_array(nums: Vec[i64]) -> i64 {
    let mut heap: PriorityQueue[Reverse[i64]] = PriorityQueue.new();
    let mut total = 0;
    for x in nums.iter() {
        total += x << 20;
        heap.push(Reverse { value: x << 20 });
    }
    let mut removed = 0;
    let mut ops = 0;
    while 2 * removed < total {
        let Reverse { value: top } = heap.pop().unwrap();
        removed += top / 2;
        heap.push(Reverse { value: top / 2 });
        ops += 1;
    }
    ops
}

// ---- halve_queues.kara: the sorted numbers and a `VecDeque` of halves
fn queues_halve_array(nums: Vec[i64]) -> i64 {
    let mut sorted: Vec[f64] = nums.iter().map(|x| x as f64).collect();
    sorted.sort_by(|a, b| b.total_cmp(a));
    let total: f64 = sorted.iter().sum();
    let mut halves: VecDeque[f64] = VecDeque.new();
    let mut next = 0;
    let mut removed = 0.0;
    let mut ops = 0;
    while removed < total / 2.0 {
        let from_sorted = next < sorted.len()
            and (halves.is_empty() or sorted[next] >= *halves.front().unwrap());
        let top = if from_sorted {
            next += 1;
            sorted[next - 1]
        } else {
            halves.pop_front().unwrap()
        };
        removed += top / 2.0;
        halves.push_back(top / 2.0);
        ops += 1;
    }
    ops
}

// ---- halve_struct.kara: a hand-written `MaxHeap`
struct MaxHeap {
    items: Vec[f64],
}

impl MaxHeap {
    fn new() -> MaxHeap {
        MaxHeap { items: Vec.new() }
    }

    fn push(mut ref self, x: f64) {
        self.items.push(x);
        let mut i = self.items.len() - 1;
        while i > 0 and self.items[(i - 1) / 2] < self.items[i] {
            self.items.swap(i, (i - 1) / 2);
            i = (i - 1) / 2;
        }
    }

    // the top halved in place and sifted down; the half it lost
    fn halve_top(mut ref self) -> f64 {
        let half = self.items[0] / 2.0;
        self.items[0] = half;
        let n = self.items.len();
        let mut i = 0;
        loop {
            let mut big = i;
            for c in [2 * i + 1, 2 * i + 2] {
                if c < n and self.items[c] > self.items[big] {
                    big = c;
                }
            }
            if big == i {
                break;
            }
            self.items.swap(i, big);
            i = big;
        }
        half
    }
}

fn struct_halve_array(nums: Vec[i64]) -> i64 {
    let mut heap = MaxHeap.new();
    let mut total = 0.0;
    for x in nums.iter() {
        heap.push(x as f64);
        total += x as f64;
    }
    let mut removed = 0.0;
    let mut ops = 0;
    while removed < total / 2.0 {
        removed += heap.halve_top();
        ops += 1;
    }
    ops
}

// ---- halve_iter.kara: `collect`, `sum`, and `take_while` over `repeat`

fn iter_halve_array(nums: Vec[i64]) -> i64 {
    let mut heap: PriorityQueue[Reverse[i64]] = nums.iter().map(|x| Reverse { value: x << 20 }).collect();
    let total: i64 = nums.iter().map(|x| x << 20).sum();
    let mut removed = 0;
    repeat(0)
        .take_while(|_| {
            if 2 * removed >= total {
                return false;
            }
            let Reverse { value: top } = heap.pop().unwrap();
            removed += top / 2;
            heap.push(Reverse { value: top / 2 });
            true
        })
        .count()
}

// ---- halve_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn halve_array(nums: Vec[i32]) -> i32 {
        let mut heap: PriorityQueue[i64] = PriorityQueue.max_first_from(nums.iter().map(|x| (x as i64) << 20).collect());
        let total: i64 = heap.iter().sum();
        let mut removed = 0;
        let mut ops = 0;
        while removed * 2 < total {
            let x = heap.pop().unwrap();
            removed += x / 2;
            heap.push(x / 2);
            ops += 1;
        }
        ops
    }
}

struct Solution {}

fn solution_halve_array(nums: Vec[i64]) -> i64 {
    let narrow: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.halve_array(narrow)
}

// ---- the statement read literally

// whether `left` halvings shared among nums[i..] (each number's share
// tried in turn) take off, with `gone` already taken, at least half of
// `total`; every amount shifted left 20 places
fn shares_reach(scaled: Vec[i64], i: i64, left: i64, gone: i64, total: i64) -> bool {
    if 2 * gone >= total {
        return true;
    }
    if i == scaled.len() or left == 0 {
        return false;
    }
    for c in 0..(left + 1) {
        let taken = scaled[i] - (scaled[i] >> c);
        if shares_reach(scaled, i + 1, left - c, gone + taken, total) {
            return true;
        }
    }
    false
}

fn literal(nums: Vec[i64]) -> i64 {
    let scaled: Vec[i64] = nums.iter().map(|x| x << 20).collect();
    let total: i64 = scaled.iter().sum();
    let mut k = 1;
    while not shares_reach(scaled, 0, k, 0, total) {
        k += 1;
    }
    k
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_halve_array(nums),
        1 => scaled_halve_array(nums),
        2 => queues_halve_array(nums),
        3 => struct_halve_array(nums),
        4 => iter_halve_array(nums),
        _ => solution_halve_array(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "scaled", "queues", "struct", "iter", "solution"];
    let mut seed = 2208;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..360 {
        let n = next_random(mut seed) % 8 + 1;
        let top = [10, 1000, 10000000][c % 3];
        let mut nums: Vec[i64] = Vec.new();
        if c < 300 {
            for _ in 0..n {
                nums.push(wide_random(mut seed) % top + 1);
            }
        } else if c < 330 {
            let x = wide_random(mut seed) % top + 1;
            for _ in 0..n {
                nums.push(x);
            }
        } else {
            for _ in 0..n {
                nums.push(next_random(mut seed) % 10 + 1);
            }
            let at = next_random(mut seed) % n;
            nums[at] = wide_random(mut seed) % 10000000 + 1000;
        }
        cases.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for nums in cases.iter() {
        let n = nums.len();
        let truth = literal(nums);
        check = (check * 31 + truth) % 1000000007;
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums)).collect();
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let mut twice = nums.clone();
        for x in nums.iter() {
            twice.push(x);
        }
        for arm in 0..6 {
            let ops = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == ops {
                    same += 1;
                }
            }
            let both = answer(arm, twice);
            let verdicts = [
                ops == truth,
                ops >= 1 and ops <= n,
                answer(arm, reversed) == ops,
                answer(arm, doubled) == ops,
                both >= ops and both <= 2 * ops,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} arm {names[arm]}: P{q + 1} fails, answered {ops}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
