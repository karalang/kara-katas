// benchmark's Kāra version of halve.kara (LeetCode #2208, the ★ arm):
// greedily halve the largest number, kept in a `PriorityQueue` of
// `Reverse[F64]` so the largest pops first, until the halves taken add up
// to half the sum.

import std.cmp.Reverse;

fn halve_array(nums: Vec[i64]) -> i64 {
    let mut heap: PriorityQueue[Reverse[F64]] = PriorityQueue.new();
    let mut total = 0.0;
    for x in nums.iter() {
        total += x as f64;
        heap.push(Reverse { value: F64.from(x as f64) });
    }
    let mut removed = 0.0;
    let mut ops = 0;
    while removed < total / 2.0 {
        let Reverse { value: top } = heap.pop().unwrap();
        let half = top.value / 2.0;
        removed += half;
        heap.push(Reverse { value: F64.from(half) });
        ops += 1;
    }
    ops
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 2208;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for a in 0..12 {
        let top = [10, 1000, 10000000][a % 3];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            nums.push(wide_random(mut seed) % top + 1);
        }
        arrays.push(nums);
    }
    // each array halved once
    let mut check = 0;
    for a in 0..12 {
        check = (check * 31 + halve_array(arrays[a])) % 1000000007;
    }
    println(f"12 arrays of 10^5: checksum {check}");
}
