// LeetCode #2236: Root Equals Sum of Children -- the root and its two
// children matched in one `match`, the root's value against their sum.
// The bench builds each tree before checking it, so it measures the
// three allocations of a `shared struct` node and their release as
// much as the check.

fn check_tree(root: Option[TreeNode]) -> bool {
    match root {
        Some(node) => match (node.left, node.right) {
            (Some(left), Some(right)) => node.val == left.val + right.val,
            _ => false,
        },
        None => false,
    }
}

// ---- bench ------------------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

impl TreeNode {
    fn new(val: i32) -> TreeNode {
        TreeNode { val: val, left: None, right: None }
    }
}

fn tree(root: i64, left: i64, right: i64) -> Option[TreeNode] {
    let node = TreeNode.new(root as i32);
    node.left = Some(TreeNode.new(left as i32));
    node.right = Some(TreeNode.new(right as i32));
    Some(node)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2236;
    let mut holding = 0;
    let mut check = 0;
    for _ in 0..1000000 {
        let left = next_random(mut seed) % 101 - 50;
        let right = next_random(mut seed) % 101 - 50;
        let root = left + right + next_random(mut seed) % 3 - 1;
        let holds = check_tree(tree(root, left, right));
        if holds {
            holding += 1;
        }
        check = (check * 2 + if holds { 1 } else { 0 }) % 1000000007;
    }
    println(f"10^6 trees: {holding} hold, checksum {check}");
}
