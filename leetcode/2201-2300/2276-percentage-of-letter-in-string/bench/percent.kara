// LeetCode #2276: Percentage of Letter in String -- the ★ arm. The
// letter's occurrences counted in one pass over the characters, then
// `count * 100 / len`, which integer division rounds down as asked.
// O(n).

fn percentage_letter(s: String, letter: char) -> i64 {
    let mut count = 0;
    for c in s.chars() {
        if c == letter {
            count += 1;
        }
    }
    count * 100 / s.len()
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 100000 strings of the constraints' longest, 100 letters from the
    // first 4, each asked for one of the first 4, built afresh
    let mut seed = 2276;
    let mut check = 0;
    for _ in 0..100000 {
        let mut s = String.new();
        for _ in 0..100 {
            s.push((b'a' + (next_random(mut seed) % 4) as u8) as char);
        }
        let letter = (b'a' + (next_random(mut seed) % 4) as u8) as char;
        check = (check * 31 + percentage_letter(s, letter)) % 1000000007;
    }
    println(f"100000 strings of 100: checksum {check}");
}
