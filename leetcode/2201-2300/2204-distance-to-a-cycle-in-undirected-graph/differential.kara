// LeetCode #2204: Distance to a Cycle in Undirected Graph -- the
// differential. The six arms, against the statement read literally: a
// node is on the cycle when one of its edges leaves it and comes back
// another way, found by a search with that edge taken out, and each
// node's distance by its own breadth-first search to the nearest such
// node. 300 random graphs of 3 to 9 nodes with a cycle of 3 to all of
// them; then 30 that are one ring; then 30 of 10 to 14 nodes on a
// triangle. Every case is drawn before any arm answers.
//
// P1  the distances are the statement read literally
// P2  the nodes at 0 are 3 or more and the edges among them as many, and
//     every other node has a neighbour one nearer
// P3  the edges listed in reverse, each with its ends swapped: the same
// P4  every node v renamed n - 1 - v: the distances in reverse
// P5  a new leaf hung on node 0: the same for the rest, and the leaf one
//     farther than node 0
// P6  each arm agrees with at least three of the other five

// ---- cycle.kara: the ★ arm, leaves peeled by degree, then one breadth-first search
fn star_distance_to_cycle(n: i64, edges: Vec[Array[i64, 2]]) -> Vec[i64] {
    let mut adj: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    let mut degree = Vec.filled(n, 0);
    for e in edges.iter() {
        adj[e[0]].push(e[1]);
        adj[e[1]].push(e[0]);
        degree[e[0]] += 1;
        degree[e[1]] += 1;
    }
    let mut leaves: VecDeque[i64] = VecDeque.new();
    for v in 0..n {
        if degree[v] == 1 {
            leaves.push_back(v);
        }
    }
    let mut peeled = Vec.filled(n, false);
    while let Some(v) = leaves.pop_front() {
        peeled[v] = true;
        for u in adj[v].iter() {
            degree[u] -= 1;
            if degree[u] == 1 {
                leaves.push_back(u);
            }
        }
    }
    let mut dist = Vec.filled(n, -1);
    let mut frontier: VecDeque[i64] = VecDeque.new();
    for v in 0..n {
        if not peeled[v] {
            dist[v] = 0;
            frontier.push_back(v);
        }
    }
    while let Some(v) = frontier.pop_front() {
        for u in adj[v].iter() {
            if dist[u] < 0 {
                dist[u] = dist[v] + 1;
                frontier.push_back(u);
            }
        }
    }
    dist
}

// ---- cycle_dfs.kara: the back edge of a depth-first search and its parent chains
fn dfs_distance_to_cycle(n: i64, edges: Vec[Array[i64, 2]]) -> Vec[i64] {
    let mut adj: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adj[e[0]].push(e[1]);
        adj[e[1]].push(e[0]);
    }
    let mut parent = Vec.filled(n, -1);
    let mut seen = Vec.filled(n, false);
    let mut stack: Vec[i64] = [0];
    seen[0] = true;
    let mut ends = (-1, -1);
    while let Some(v) = stack.pop() {
        for u in adj[v].iter() {
            if not seen[u] {
                seen[u] = true;
                parent[u] = v;
                stack.push(u);
            } else if u != parent[v] and ends.0 < 0 {
                ends = (v, u);
            }
        }
    }
    // the two ends' ancestors: the cycle runs from each end up to the
    // first ancestor they share
    let (a, b) = ends;
    let mut above_a = Vec.filled(n, false);
    let mut x = a;
    while x >= 0 {
        above_a[x] = true;
        x = parent[x];
    }
    let mut meet = b;
    while not above_a[meet] {
        meet = parent[meet];
    }
    let mut dist = Vec.filled(n, -1);
    for start in [a, b] {
        let mut y = start;
        while y != meet {
            dist[y] = 0;
            y = parent[y];
        }
    }
    dist[meet] = 0;
    let mut frontier: VecDeque[i64] = VecDeque.new();
    for v in 0..n {
        if dist[v] == 0 {
            frontier.push_back(v);
        }
    }
    while let Some(v) = frontier.pop_front() {
        for u in adj[v].iter() {
            if dist[u] < 0 {
                dist[u] = dist[v] + 1;
                frontier.push_back(u);
            }
        }
    }
    dist
}

// ---- cycle_union.kara: the edge a disjoint-set forest finds closing the cycle
fn union_find(root: mut ref Vec[i64], v: i64) -> i64 {
    let mut x = v;
    while root[x] != x {
        root[x] = root[root[x]];
        x = root[x];
    }
    x
}

fn union_distance_to_cycle(n: i64, edges: Vec[Array[i64, 2]]) -> Vec[i64] {
    let mut root: Vec[i64] = (0..n).collect();
    let mut closing = 0;
    for (i, e) in edges.iter().enumerate() {
        let (ra, rb) = (union_find(mut root, e[0]), union_find(mut root, e[1]));
        if ra == rb {
            closing = i;
        } else {
            root[ra] = rb;
        }
    }
    let mut adj: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for (i, e) in edges.iter().enumerate() {
        if i != closing {
            adj[e[0]].push(e[1]);
            adj[e[1]].push(e[0]);
        }
    }
    let (a, b) = (edges[closing][0], edges[closing][1]);
    let mut back = Vec.filled(n, -1);
    back[a] = a;
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(a);
    while let Some(v) = queue.pop_front() {
        for u in adj[v].iter() {
            if back[u] < 0 {
                back[u] = v;
                queue.push_back(u);
            }
        }
    }
    let mut dist = Vec.filled(n, -1);
    let mut x = b;
    while x != a {
        dist[x] = 0;
        x = back[x];
    }
    dist[a] = 0;
    adj[a].push(b);
    adj[b].push(a);
    let mut frontier: VecDeque[i64] = VecDeque.new();
    for v in 0..n {
        if dist[v] == 0 {
            frontier.push_back(v);
        }
    }
    while let Some(v) = frontier.pop_front() {
        for u in adj[v].iter() {
            if dist[u] < 0 {
                dist[u] = dist[v] + 1;
                frontier.push_back(u);
            }
        }
    }
    dist
}

// ---- cycle_struct.kara: a `Graph` peeled into a `Peeling`
struct Graph {
    adj: Vec[Vec[i64]],
}

struct Peeling {
    on_cycle: Vec[bool],
}

impl Graph {
    fn from_edges(n: i64, edges: Vec[Array[i64, 2]]) -> Graph {
        let mut adj: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
        for e in edges.iter() {
            adj[e[0]].push(e[1]);
            adj[e[1]].push(e[0]);
        }
        Graph { adj: adj }
    }

    fn peel(self) -> Peeling {
        let n = self.adj.len();
        let mut degree: Vec[i64] = self.adj.iter().map(|a| a.len()).collect();
        let mut on_cycle = Vec.filled(n, true);
        let mut stack: Vec[i64] = (0..n).filter(|v| degree[v] == 1).collect();
        while let Some(v) = stack.pop() {
            on_cycle[v] = false;
            for u in self.adj[v].iter() {
                degree[u] -= 1;
                if degree[u] == 1 {
                    stack.push(u);
                }
            }
        }
        Peeling { on_cycle: on_cycle }
    }

    fn layers(self, from: Peeling) -> Vec[i64] {
        let mut dist: Vec[i64] = from.on_cycle.iter().map(|c| if c { 0 } else { -1 }).collect();
        let mut layer: Vec[i64] = (0..self.adj.len()).filter(|v| dist[v] == 0).collect();
        let mut depth = 0;
        while layer.len() > 0 {
            depth += 1;
            let mut next: Vec[i64] = Vec.new();
            for v in layer.iter() {
                for u in self.adj[v].iter() {
                    if dist[u] < 0 {
                        dist[u] = depth;
                        next.push(u);
                    }
                }
            }
            layer = next;
        }
        dist
    }
}

fn struct_distance_to_cycle(n: i64, edges: Vec[Array[i64, 2]]) -> Vec[i64] {
    let graph = Graph.from_edges(n, edges);
    graph.layers(graph.peel())
}

// ---- cycle_iter.kara: `fold`, `flat_map`, `filter` in rounds
fn iter_distance_to_cycle(n: i64, edges: Vec[Array[i64, 2]]) -> Vec[i64] {
    let adj: Vec[Vec[i64]] = edges.iter().fold(Vec.filled(n, Vec.new()), |acc, e| {
        let mut a = acc;
        a[e[0]].push(e[1]);
        a[e[1]].push(e[0]);
        a
    });
    let mut live = Vec.filled(n, true);
    let mut leaves: Vec[i64] = (0..n).filter(|v| adj[v].len() == 1).collect();
    while leaves.len() > 0 {
        leaves.iter().for_each(|v| { live[v] = false; });
        let mut next: Vec[i64] = leaves.iter().flat_map(|v| adj[v].iter()).filter(|u| live[u] and adj[u].iter().filter(|w| live[w]).count() == 1).collect();
        next.sort();
        next.dedup();
        leaves = next;
    }
    let mut dist: Vec[i64] = live.iter().map(|l| if l { 0 } else { -1 }).collect();
    let mut ring: Vec[i64] = (0..n).filter(|v| live[v]).collect();
    let mut depth = 0;
    while ring.len() > 0 {
        depth += 1;
        let reached: Vec[i64] = ring.iter().flat_map(|v| adj[v].iter()).filter(|u| dist[u] < 0).collect();
        ring = Vec.new();
        for u in reached.iter() {
            if dist[u] < 0 {
                dist[u] = depth;
                ring.push(u);
            }
        }
    }
    dist
}

// ---- cycle_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn distance_to_cycle(n: i32, edges: Vec[Vec[i32]]) -> Vec[i32] {
        let n = n as i64;
        let mut g = Vec.filled(n, Vec.new());
        let mut deg = Vec.filled(n, 0);
        for e in edges.iter() {
            let (a, b) = (e[0] as i64, e[1] as i64);
            g[a].push(b);
            g[b].push(a);
            deg[a] += 1;
            deg[b] += 1;
        }
        let mut q = VecDeque.new();
        for i in 0..n {
            if deg[i] == 1 {
                q.push_back(i);
            }
        }
        while let Some(u) = q.pop_front() {
            for v in ref g[u] {
                deg[v] -= 1;
                if deg[v] == 1 {
                    q.push_back(v);
                }
            }
            deg[u] = 0;
        }
        let mut ans = Vec.filled(n, i32.MAX);
        for i in 0..n {
            if deg[i] >= 2 {
                ans[i] = 0;
                q.push_back(i);
            }
        }
        while let Some(u) = q.pop_front() {
            for v in ref g[u] {
                if ans[v] == i32.MAX {
                    ans[v] = ans[u] + 1;
                    q.push_back(v);
                }
            }
        }
        ans
    }
}

struct Solution {}

fn solution_distance_to_cycle(n: i64, edges: Vec[Array[i64, 2]]) -> Vec[i64] {
    let rows: Vec[Vec[i32]] = edges.iter().map(|e| e.iter().map(|x| x as i32).collect()).collect();
    Solution.distance_to_cycle(n as i32, rows).iter().map(|d| d as i64).collect()
}

// ---- the statement read literally

// whether `to` can be reached from `from` without the edge numbered `cut`
fn joined(n: i64, edges: Vec[Array[i64, 2]], cut: i64, from: i64, to: i64) -> bool {
    let mut seen = Vec.filled(n, false);
    seen[from] = true;
    let mut grew = true;
    while grew {
        grew = false;
        for (i, e) in edges.iter().enumerate() {
            if i != cut and seen[e[0]] != seen[e[1]] {
                seen[e[0]] = true;
                seen[e[1]] = true;
                grew = true;
            }
        }
    }
    seen[to]
}

fn literal(n: i64, edges: Vec[Array[i64, 2]]) -> Vec[i64] {
    let mut on_cycle = Vec.filled(n, false);
    for (i, e) in edges.iter().enumerate() {
        if joined(n, edges, i, e[0], e[1]) {
            on_cycle[e[0]] = true;
            on_cycle[e[1]] = true;
        }
    }
    let mut out: Vec[i64] = Vec.new();
    for v in 0..n {
        let mut dist = Vec.filled(n, -1);
        dist[v] = 0;
        let mut layer: Vec[i64] = [v];
        let mut found = if on_cycle[v] { 0 } else { -1 };
        while found < 0 and layer.len() > 0 {
            let mut next: Vec[i64] = Vec.new();
            for x in layer.iter() {
                for e in edges.iter() {
                    for (p, q) in [(e[0], e[1]), (e[1], e[0])] {
                        if p == x and dist[q] < 0 {
                            dist[q] = dist[x] + 1;
                            next.push(q);
                            if on_cycle[q] and found < 0 {
                                found = dist[q];
                            }
                        }
                    }
                }
            }
            layer = next;
        }
        out.push(found);
    }
    out
}

fn answer(arm: i64, n: i64, edges: Vec[Array[i64, 2]]) -> Vec[i64] {
    match arm {
        0 => star_distance_to_cycle(n, edges),
        1 => dfs_distance_to_cycle(n, edges),
        2 => union_distance_to_cycle(n, edges),
        3 => struct_distance_to_cycle(n, edges),
        4 => iter_distance_to_cycle(n, edges),
        _ => solution_distance_to_cycle(n, edges),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// as the harness draws them: the nodes shuffled, the first `ring` joined
// in a ring, each later one hung on a node before it, and the edges
// shuffled with each end order drawn at random
fn random_graph(n: i64, ring: i64, seed: mut ref i64) -> Vec[Array[i64, 2]] {
    let mut order: Vec[i64] = (0..n).collect();
    for i in (1..n).rev() {
        let j = wide_random(mut seed) % (i + 1);
        order.swap(i, j);
    }
    let mut edges: Vec[Array[i64, 2]] = Vec.new();
    for i in 0..ring {
        edges.push([order[i], order[(i + 1) % ring]]);
    }
    for i in ring..n {
        edges.push([order[i], order[wide_random(mut seed) % i]]);
    }
    for i in (1..n).rev() {
        let j = wide_random(mut seed) % (i + 1);
        edges.swap(i, j);
    }
    for i in 0..n {
        if next_random(mut seed) % 2 == 1 {
            edges[i] = [edges[i][1], edges[i][0]];
        }
    }
    edges
}

fn main() {
    let names = ["star", "dfs", "union", "struct", "iter", "solution"];
    let mut seed = 2204;
    let mut cases: Vec[(i64, Vec[Array[i64, 2]])] = Vec.new();
    for c in 0..360 {
        let n = if c < 330 { next_random(mut seed) % 7 + 3 } else { next_random(mut seed) % 5 + 10 };
        let ring = if c < 300 { next_random(mut seed) % (n - 2) + 3 } else if c < 330 { n } else { 3 };
        cases.push((n, random_graph(n, ring, mut seed)));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (n, edges) in cases.iter() {
        let truth = literal(n, edges);
        for d in truth.iter() {
            check = (check * 31 + d + 1) % 1000000007;
        }
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, n, edges)).collect();
        // a list literal a closure returns is a `Vec` (kara B-2026-11-15-38),
        // so each new edge is a typed binding
        let turned: Vec[Array[i64, 2]] = edges
            .iter()
            .rev()
            .map(|e| {
                let t: Array[i64, 2] = [e[1], e[0]];
                t
            })
            .collect();
        let renamed: Vec[Array[i64, 2]] = edges
            .iter()
            .map(|e| {
                let r: Array[i64, 2] = [n - 1 - e[0], n - 1 - e[1]];
                r
            })
            .collect();
        let mut grown = edges.clone();
        grown.push([n, 0]);
        for arm in 0..6 {
            let dist = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == dist {
                    same += 1;
                }
            }
            let mut sound = dist.len() == n;
            if sound {
                let zeros = dist.iter().filter(|d| d == 0).count();
                let inner = edges.iter().filter(|e| dist[e[0]] == 0 and dist[e[1]] == 0).count();
                sound = zeros >= 3 and inner == zeros;
                for v in 0..n {
                    if dist[v] != 0 and not edges.iter().any(|e| (e[0] == v and dist[e[1]] == dist[v] - 1) or (e[1] == v and dist[e[0]] == dist[v] - 1)) {
                        sound = false;
                    }
                }
            }
            let back: Vec[i64] = answer(arm, n, renamed).iter().rev().collect();
            let longer = answer(arm, n + 1, grown);
            let mut kept = longer.len() == n + 1 and dist.len() == n;
            if kept {
                kept = longer[n] == dist[0] + 1;
                for v in 0..n {
                    if longer[v] != dist[v] {
                        kept = false;
                    }
                }
            }
            let verdicts = [
                dist == truth,
                sound,
                answer(arm, n, turned) == dist,
                back == dist,
                kept,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"n {n}, {edges} arm {names[arm]}: P{q + 1} fails, answered {dist}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
