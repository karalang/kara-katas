// LeetCode #2215: Find the Difference of Two Arrays -- the differential.
// The six arms, against the statement read literally: each number of one
// array, in order, looked for in the other array number by number, and
// listed when it is missing there and not listed already; no sets, no
// sorting. Each arm's lists are sorted before they are compared, since
// they may come in any order. 300 random pairs of 1 to 12 numbers spread
// over -3..3, -30..30 and -1000..1000 in turn; then 30 pairs of one
// number repeated; then 30 with the second array a part of the first.
// Every case is drawn before any arm answers.
//
// P1  the sorted lists are the statement read literally
// P2  each list has no number twice, and every number in it is in its
//     own array and not in the other
// P3  the arrays swapped: the lists swapped
// P4  both arrays reversed: the same lists
// P5  each array followed by itself: the same lists
// P6  each arm agrees with at least three of the other five


// ---- difference.kara: the ★ arm, two `Set`s and `filter`
fn star_find_difference(nums1: Vec[i64], nums2: Vec[i64]) -> Vec[Vec[i64]] {
    let first: Set[i64] = nums1.iter().collect();
    let second: Set[i64] = nums2.iter().collect();
    let only_first: Vec[i64] = first.iter().filter(|x| not second.contains(x)).collect();
    let only_second: Vec[i64] = second.iter().filter(|x| not first.contains(x)).collect();
    [only_first, only_second]
}

// ---- difference_merge.kara: sorted, squeezed and walked together
fn merge_find_difference(nums1: Vec[i64], nums2: Vec[i64]) -> Vec[Vec[i64]] {
    let mut a = nums1.clone();
    let mut b = nums2.clone();
    a.sort();
    a.dedup();
    b.sort();
    b.dedup();
    let mut only_a: Vec[i64] = Vec.new();
    let mut only_b: Vec[i64] = Vec.new();
    let mut i = 0;
    let mut j = 0;
    while i < a.len() or j < b.len() {
        if j == b.len() or (i < a.len() and a[i] < b[j]) {
            only_a.push(a[i]);
            i += 1;
        } else if i == a.len() or b[j] < a[i] {
            only_b.push(b[j]);
            j += 1;
        } else {
            i += 1;
            j += 1;
        }
    }
    [only_a, only_b]
}

// ---- difference_marks.kara: two tables of 2001 marks
fn marks_find_difference(nums1: Vec[i64], nums2: Vec[i64]) -> Vec[Vec[i64]] {
    let mut in_first: Vec[bool] = Vec.filled(2001, false);
    let mut in_second: Vec[bool] = Vec.filled(2001, false);
    for x in nums1.iter() {
        in_first[x + 1000] = true;
    }
    for x in nums2.iter() {
        in_second[x + 1000] = true;
    }
    let mut answer: Vec[Vec[i64]] = [Vec.new(), Vec.new()];
    for v in -1000..=1000 {
        if in_first[v + 1000] and not in_second[v + 1000] {
            answer[0].push(v);
        } else if in_second[v + 1000] and not in_first[v + 1000] {
            answer[1].push(v);
        }
    }
    answer
}

// ---- difference_struct.kara: `Bag` and `without`
struct Bag {
    numbers: SortedSet[i64],
}

impl Bag {
    fn of(nums: Vec[i64]) -> Bag {
        let mut numbers: SortedSet[i64] = SortedSet.new();
        for x in nums.iter() {
            numbers.insert(x);
        }
        Bag { numbers: numbers }
    }

    fn without(ref self, other: Bag) -> Vec[i64] {
        let mut kept: Vec[i64] = Vec.new();
        for x in self.numbers.iter() {
            if not other.numbers.contains(x) {
                kept.push(x);
            }
        }
        kept
    }
}

fn struct_find_difference(nums1: Vec[i64], nums2: Vec[i64]) -> Vec[Vec[i64]] {
    let first = Bag.of(nums1);
    let second = Bag.of(nums2);
    [first.without(second), second.without(first)]
}

// ---- difference_iter.kara: `SortedSet` and `difference`
fn iter_find_difference(nums1: Vec[i64], nums2: Vec[i64]) -> Vec[Vec[i64]] {
    let first: SortedSet[i64] = nums1.iter().collect();
    let second: SortedSet[i64] = nums2.iter().collect();
    [first.difference(second).into_iter().collect(), second.difference(first).into_iter().collect()]
}

// ---- difference_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn find_difference(nums1: Vec[i32], nums2: Vec[i32]) -> Vec[Vec[i32]] {
        let s1: Set[i32] = nums1.clone().into_iter().collect();
        let s2: Set[i32] = nums2.clone().into_iter().collect();
        [s1.difference(s2).into_iter().cloned().collect(), s2.difference(s1).into_iter().cloned().collect()]
    }
}

struct Solution {}

fn solution_find_difference(nums1: Vec[i64], nums2: Vec[i64]) -> Vec[Vec[i64]] {
    let a: Vec[i32] = nums1.iter().map(|x| x as i32).collect();
    let b: Vec[i32] = nums2.iter().map(|x| x as i32).collect();
    Solution.find_difference(a, b).iter().map(|list| list.iter().map(|x| x as i64).collect()).collect()
}


// ---- the statement read literally

fn found(nums: Vec[i64], x: i64) -> bool {
    for y in nums.iter() {
        if y == x {
            return true;
        }
    }
    false
}

fn missing_from(own: Vec[i64], other: Vec[i64]) -> Vec[i64] {
    let mut listed: Vec[i64] = Vec.new();
    for x in own.iter() {
        if not found(other, x) and not found(listed, x) {
            listed.push(x);
        }
    }
    listed.sort();
    listed
}

fn literal(nums1: Vec[i64], nums2: Vec[i64]) -> Vec[Vec[i64]] {
    [missing_from(nums1, nums2), missing_from(nums2, nums1)]
}

fn raw(arm: i64, nums1: Vec[i64], nums2: Vec[i64]) -> Vec[Vec[i64]] {
    match arm {
        0 => star_find_difference(nums1, nums2),
        1 => merge_find_difference(nums1, nums2),
        2 => marks_find_difference(nums1, nums2),
        3 => struct_find_difference(nums1, nums2),
        4 => iter_find_difference(nums1, nums2),
        _ => solution_find_difference(nums1, nums2),
    }
}

// the arm's lists sorted, since either may come in any order
fn answer(arm: i64, nums1: Vec[i64], nums2: Vec[i64]) -> Vec[Vec[i64]] {
    let mut lists = raw(arm, nums1, nums2);
    for list in lists.iter_mut() {
        list.sort();
    }
    lists
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Case {
    nums1: Vec[i64],
    nums2: Vec[i64],
}

fn main() {
    let names = ["star", "merge", "marks", "struct", "iter", "solution"];
    let mut seed = 2215;
    let mut cases: Vec[Case] = Vec.new();
    for c in 0..360 {
        let spread = [3, 30, 1000][c % 3];
        let n1 = next_random(mut seed) % 12 + 1;
        let n2 = next_random(mut seed) % 12 + 1;
        let mut nums1: Vec[i64] = Vec.new();
        let mut nums2: Vec[i64] = Vec.new();
        let one = next_random(mut seed) % (2 * spread + 1) - spread;
        for _ in 0..n1 {
            nums1.push(if c >= 300 and c < 330 { one } else { next_random(mut seed) % (2 * spread + 1) - spread });
        }
        for _ in 0..n2 {
            nums2.push(if c < 300 { next_random(mut seed) % (2 * spread + 1) - spread } else if c < 330 { one } else { nums1[next_random(mut seed) % n1] });
        }
        cases.push(Case { nums1: nums1, nums2: nums2 });
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for case in cases.iter() {
        let nums1 = ref case.nums1;
        let nums2 = ref case.nums2;
        let truth = literal(nums1, nums2);
        for list in truth.iter() {
            check = (check * 31 + 1001) % 1000000007;
            for x in list.iter() {
                check = (check * 31 + x + 1000) % 1000000007;
            }
        }
        let reversed1: Vec[i64] = nums1.iter().rev().collect();
        let reversed2: Vec[i64] = nums2.iter().rev().collect();
        let mut twice1 = nums1.clone();
        twice1.extend(nums1.iter());
        let mut twice2 = nums2.clone();
        twice2.extend(nums2.iter());
        let got: Vec[Vec[Vec[i64]]] = (0..6).map(|arm| answer(arm, nums1, nums2)).collect();
        for arm in 0..6 {
            let lists = ref got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == *lists {
                    same += 1;
                }
            }
            let mut sound = lists.len() == 2;
            if sound {
                for side in 0..2 {
                    let own = if side == 0 { nums1 } else { nums2 };
                    let other = if side == 0 { nums2 } else { nums1 };
                    for i in 0..lists[side].len() {
                        let x = lists[side][i];
                        if not found(own, x) or found(other, x) or (i > 0 and lists[side][i - 1] == x) {
                            sound = false;
                        }
                    }
                }
            }
            let swapped = answer(arm, nums2, nums1);
            let verdicts = [
                *lists == truth,
                sound,
                swapped.len() == 2 and lists.len() == 2 and swapped[0] == lists[1] and swapped[1] == lists[0],
                answer(arm, reversed1, reversed2) == *lists,
                answer(arm, twice1, twice2) == *lists,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums1} and {nums2} arm {names[arm]}: P{q + 1} fails, gave {lists}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
