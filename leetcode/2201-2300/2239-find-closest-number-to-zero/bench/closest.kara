// LeetCode #2239: Find Closest Number to Zero -- one scan, a number
// kept when nearer to zero, or as near and larger. O(n).

fn find_closest_number(nums: Vec[i64]) -> i64 {
    let mut closest = nums[0];
    for x in nums.iter() {
        if x.abs() < closest.abs() or (x.abs() == closest.abs() and x > closest) {
            closest = x;
        }
    }
    closest
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 2239;
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..1000 {
        nums.push(wide_random(mut seed) % 200001 - 100000);
    }
    let mut check = 0;
    for _ in 0..100000 {
        // punch: one number drawn again before each pass
        let at = next_random(mut seed) % 1000;
        nums[at] = wide_random(mut seed) % 200001 - 100000;
        check = (check * 31 + find_closest_number(nums) + 100000) % 1000000007;
    }
    println(f"100000 passes over 1000 numbers: checksum {check}");
}
