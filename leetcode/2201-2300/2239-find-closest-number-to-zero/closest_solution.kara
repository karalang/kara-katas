// LeetCode #2239: Find Closest Number to Zero -- LeetCode's Rust
// template: `Vec<i32>` in, `i32` out; `nums.into_iter()` with
// `min_by_key(|&x| (x.abs(), -x))` and `unwrap`. Carried by `karac
// fix`. The adapter below hands the harness's values to it.

impl Solution {
    pub fn find_closest_number(nums: Vec[i32]) -> i32 {
        nums.clone().into_iter().min_by_key(|x| (x.abs(), -x)).unwrap()
    }
}

struct Solution {}

fn find_closest_number(nums: Vec[i64]) -> i64 {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.find_closest_number(nums)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {find_closest_number(nums)}");
}

fn main() {
    // LeetCode's two examples, then five more: one negative number, a
    // tie at both ends, a zero, the constraints' ends, and a tie whose
    // negative half comes first and twice
    show([-4, -2, 1, 4, 8]);
    show([2, -1, 1]);
    show([-1]);
    show([-5, 5]);
    show([3, 0, -3]);
    show([-100000, 100000]);
    show([-3, -3, 2, -2]);
    // 3000 random arrays of 1 to 50 numbers up to 10, 1000 and 10^5 in
    // size in turn, of either sign
    let mut seed = 2239;
    let mut check = 0;
    let mut positive = 0;
    for c in 0..3000 {
        let n = next_random(mut seed) % 50 + 1;
        let top = [10, 1000, 100000][c % 3];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(wide_random(mut seed) % (2 * top + 1) - top);
        }
        let closest = find_closest_number(nums);
        if closest > 0 {
            positive += 1;
        }
        check = (check * 31 + closest + 100000) % 1000000007;
    }
    println(f"3000 arrays: checksum {check}, {positive} positive");
    // the constraints' largest: 1000 random numbers; then 1000 numbers
    // all past 500 from zero, the nearest -501 (twice) and 502
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..1000 {
        nums.push(wide_random(mut seed) % 200001 - 100000);
    }
    println(f"1000 random numbers: {find_closest_number(nums)}");
    let mut far: Vec[i64] = Vec.new();
    for k in 0..1000 {
        far.push(if k % 2 == 0 { -501 - k } else { 501 + k });
    }
    far.push(-501);
    println(f"1000 numbers beyond 500: {find_closest_number(far)}");
}
