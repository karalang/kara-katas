// LeetCode #2207: Maximize Number of Subsequences in a String -- the
// struct arm: a `Tally` fed one letter at a time, keeping how many of each
// pattern letter it has seen and how many pairs they make, then asked for
// its best with one letter added.

struct Tally {
    first: char,
    second: char,
    firsts: i64,
    seconds: i64,
    pairs: i64,
}

impl Tally {
    fn new(first: char, second: char) -> Tally {
        Tally { first: first, second: second, firsts: 0, seconds: 0, pairs: 0 }
    }

    fn feed(mut ref self, ch: char) {
        if ch == self.second {
            self.pairs += self.firsts;
            self.seconds += 1;
        }
        if ch == self.first {
            self.firsts += 1;
        }
    }

    fn best_with_one_more(self) -> i64 {
        self.pairs + self.firsts.max(self.seconds)
    }
}

fn maximum_subsequence_count(text: String, pattern: String) -> i64 {
    let p: Vec[char] = pattern.chars().collect();
    let mut tally = Tally.new(p[0], p[1]);
    for ch in text.chars() {
        tally.feed(ch);
    }
    tally.best_with_one_more()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut w = String.new();
    for _ in 0..n {
        w.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    w
}

fn show(text: String, pattern: String) {
    println(f"\"{text}\", \"{pattern}\" -> {maximum_subsequence_count(text, pattern)}");
}

fn main() {
    // LeetCode's two examples, then four more: a pattern of one letter
    // twice, a text holding neither letter, the second letter only, and
    // the second letter before every first
    show("abdcdbc", "ac");
    show("aabb", "ab");
    show("aaa", "aa");
    show("xyz", "ab");
    show("bbb", "ab");
    show("bbaa", "ab");
    // 3000 random texts of 1 to 30 letters from 2, 3 and 26 in turn, each
    // pattern drawn from the same letters
    let mut seed = 2207;
    let mut best = 0;
    let mut check = 0;
    for c in 0..3000 {
        let letters = [2, 3, 26][c % 3];
        let n = next_random(mut seed) % 30 + 1;
        let text = random_word(n, letters, mut seed);
        let pattern = random_word(2, letters, mut seed);
        let got = maximum_subsequence_count(text, pattern);
        best = best.max(got);
        check = (check * 31 + got) % 1000000007;
    }
    println(f"3000 texts: most {best}, checksum {check}");
    // the constraints' largest: 10^5 letters, half a then half b, and all a
    let mut half = String.new();
    for i in 0..100000 {
        half.push(if i < 50000 { 'a' } else { 'b' });
    }
    println(f"50000 a then 50000 b, \"ab\" -> {maximum_subsequence_count(half, "ab")}");
    let mut same = String.new();
    for _ in 0..100000 {
        same.push('a');
    }
    println(f"10^5 a, \"aa\" -> {maximum_subsequence_count(same, "aa")}");
    println(f"10^5 a, \"ba\" -> {maximum_subsequence_count(same, "ba")}");
}
