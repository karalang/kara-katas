// benchmark's Kāra version of subsequences.kara (LeetCode #2207, the ★
// arm): one pass counting the first letter so far, each second letter
// adding that count, then the more common letter added.

fn maximum_subsequence_count(text: String, pattern: String) -> i64 {
    let p: Vec[char] = pattern.chars().collect();
    let first = p[0];
    let second = p[1];
    let mut firsts = 0;
    let mut seconds = 0;
    let mut pairs = 0;
    for ch in text.chars() {
        if ch == second {
            pairs += firsts;
            seconds += 1;
        }
        if ch == first {
            firsts += 1;
        }
    }
    pairs + firsts.max(seconds)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut w = String.new();
    for _ in 0..n {
        w.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    w
}

fn main() {
    let mut seed = 2207;
    let mut texts: Vec[String] = Vec.new();
    for t in 0..12 {
        texts.push(random_word(100000, [2, 3, 26][t % 3], mut seed));
    }
    // each pass asks every text about its own pattern
    let mut check = 0;
    for p in 0..50 {
        for t in 0..12 {
            let letters = [2, 3, 26][t % 3];
            let mut pattern = String.new();
            pattern.push((97 + p % letters) as u8 as char);
            pattern.push((97 + (p * 7 + t) % letters) as u8 as char);
            check = (check * 31 + maximum_subsequence_count(texts[t], pattern)) % 1000000007;
        }
    }
    println(f"50 passes over 12 texts: checksum {check}");
}
