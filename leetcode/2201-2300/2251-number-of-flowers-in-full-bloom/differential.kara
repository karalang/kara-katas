// LeetCode #2251: Number of Flowers in Full Bloom -- the differential.
// The six arms, against the statement read literally: for every person,
// every flower tried, counted when start <= t <= end; no sorting or
// searching. 300 random cases of 1 to 8 flowers and 1 to 8 people with
// days 1 to 10; then 30 with days up to 5 * 10^8, so that moved they stay
// in bounds; then 30 whose people stand on a flower's first or last day
// or the day either side of it. Every case is drawn before any arm
// answers.
//
// P1  each count is the flowers in bloom on the person's day, read
//     literally
// P2  the flowers and the people both reversed: the counts reversed
// P3  a flower from day 1 to day 10^9 added: every count one more
// P4  every day moved 7 later: the same counts
// P5  every flower of more than one day split in two at its middle: the
//     same counts
// P6  each arm agrees with at least three of the other five


// ---- flowers.kara: the ★ arm, two `partition_point`s on sorted starts and ends
fn star_full_bloom_flowers(flowers: Vec[Vec[i64]], people: Vec[i64]) -> Vec[i64] {
    let mut starts: Vec[i64] = flowers.iter().map(|f| f[0]).collect();
    let mut ends: Vec[i64] = flowers.iter().map(|f| f[1]).collect();
    starts.sort();
    ends.sort();
    people
        .iter()
        .map(|t| starts.partition_point(|s| s <= t) - ends.partition_point(|e| e < t))
        .collect()
}

// ---- flowers_sweep.kara: people by day, two forward pointers
fn sweep_full_bloom_flowers(flowers: Vec[Vec[i64]], people: Vec[i64]) -> Vec[i64] {
    let mut starts: Vec[i64] = flowers.iter().map(|f| f[0]).collect();
    let mut ends: Vec[i64] = flowers.iter().map(|f| f[1]).collect();
    starts.sort();
    ends.sort();
    let mut order: Vec[i64] = (0..people.len()).collect();
    order.sort_by_key(|i| people[i]);
    let mut counts: Vec[i64] = Vec.filled(people.len(), 0);
    let mut started = 0;
    let mut ended = 0;
    for i in order.iter() {
        let t = people[i];
        while started < starts.len() and starts[started] <= t {
            started += 1;
        }
        while ended < ends.len() and ends[ended] < t {
            ended += 1;
        }
        counts[i] = started - ended;
    }
    counts
}

// ---- flowers_diff.kara: a `SortedMap` of changes, its running counts searched
fn diff_full_bloom_flowers(flowers: Vec[Vec[i64]], people: Vec[i64]) -> Vec[i64] {
    let mut change: SortedMap[i64, i64] = SortedMap.new();
    for f in flowers.iter() {
        *change.entry(f[0]).or_insert(0) += 1;
        *change.entry(f[1] + 1).or_insert(0) -= 1;
    }
    let mut days: Vec[i64] = Vec.new();
    let mut from: Vec[i64] = Vec.new();
    let mut open = 0;
    for (day, delta) in change.iter() {
        open += delta;
        days.push(day);
        from.push(open);
    }
    people
        .iter()
        .map(|t| {
            let at = days.partition_point(|d| d <= t);
            if at == 0 { 0 } else { from[at - 1] }
        })
        .collect()
}

// ---- flowers_struct.kara: `Garden`, a hand-written search
struct StructGarden {
    starts: Vec[i64],
    ends: Vec[i64],
}

// how many of the sorted `values` are at most x: the first index past x,
// by halving [low, high)
fn struct_at_most(values: Vec[i64], x: i64) -> i64 {
    let mut low = 0;
    let mut high = values.len();
    while low < high {
        let mid = (low + high) / 2;
        if values[mid] <= x {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    low
}

impl StructGarden {
    fn plant(flowers: Vec[Vec[i64]]) -> StructGarden {
        let mut starts: Vec[i64] = Vec.new();
        let mut ends: Vec[i64] = Vec.new();
        for f in flowers.iter() {
            starts.push(f[0]);
            ends.push(f[1]);
        }
        starts.sort();
        ends.sort();
        StructGarden { starts, ends }
    }

    fn in_bloom(ref self, t: i64) -> i64 {
        struct_at_most(self.starts, t) - struct_at_most(self.ends, t - 1)
    }
}

fn struct_full_bloom_flowers(flowers: Vec[Vec[i64]], people: Vec[i64]) -> Vec[i64] {
    let garden = StructGarden.plant(flowers);
    people.iter().map(|t| garden.in_bloom(t)).collect()
}

// ---- flowers_iter.kara: one sorted list of events, `chain` and `scan`
fn iter_full_bloom_flowers(flowers: Vec[Vec[i64]], people: Vec[i64]) -> Vec[i64] {
    let mut events: Vec[(i64, i64, i64)] = flowers
        .iter()
        .map(|f| (f[0], 0, 0))
        .chain(people.iter().enumerate().map(|(i, t)| (t, 1, i)))
        .chain(flowers.iter().map(|f| (f[1], 2, 0)))
        .collect();
    events.sort();
    let mut seen: Vec[(i64, i64)] = events
        .iter()
        .scan(0, |open, event| {
            let (_, kind, i) = event;
            let now = if kind == 0 { open + 1 } else if kind == 2 { open - 1 } else { open };
            Some((now, if kind == 1 { Some((i, now)) } else { None }))
        })
        .filter_map(|seen| seen)
        .collect();
    seen.sort();
    seen.iter().map(|(_, count)| count).collect()
}

// ---- flowers_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn full_bloom_flowers(flowers: own Vec[Vec[i32]], people: Vec[i32]) -> Vec[i32] {
        let mut flowers = flowers;
        flowers.sort();
        let mut order: Vec[i64] = (0..people.len()).collect();
        order.sort_by_key(|i| people[i]);
        let mut heap = PriorityQueue.new();
        let mut ans = Vec.filled(people.len(), 0);
        let mut j = 0;
        for i in order {
            let t = people[i];
            while j < flowers.len() and flowers[j][0] <= t {
                heap.push(flowers[j][1]);
                j += 1;
            }
            while let Some(e) = heap.peek().cloned() {
                if e < t {
                    heap.pop();
                } else {
                    break;
                }
            }
            ans[i] = heap.len() as i32;
        }
        ans
    }
}

struct Solution {}

fn solution_full_bloom_flowers(flowers: Vec[Vec[i64]], people: Vec[i64]) -> Vec[i64] {
    let flowers: Vec[Vec[i32]] = flowers.iter().map(|f| f.iter().map(|v| v as i32).collect()).collect();
    let people: Vec[i32] = people.iter().map(|t| t as i32).collect();
    Solution.full_bloom_flowers(flowers, people).iter().map(|c| c as i64).collect()
}

// ---- the statement read literally

fn literal(flowers: Vec[Vec[i64]], people: Vec[i64]) -> Vec[i64] {
    let mut counts: Vec[i64] = Vec.new();
    for t in people.iter() {
        let mut count = 0;
        for f in flowers.iter() {
            if f[0] <= t and t <= f[1] {
                count += 1;
            }
        }
        counts.push(count);
    }
    counts
}

fn answer(arm: i64, flowers: Vec[Vec[i64]], people: Vec[i64]) -> Vec[i64] {
    match arm {
        0 => star_full_bloom_flowers(flowers, people),
        1 => sweep_full_bloom_flowers(flowers, people),
        2 => diff_full_bloom_flowers(flowers, people),
        3 => struct_full_bloom_flowers(flowers, people),
        4 => iter_full_bloom_flowers(flowers, people),
        _ => solution_full_bloom_flowers(flowers, people),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn random_flowers(seed: mut ref i64, count: i64, top: i64) -> Vec[Vec[i64]] {
    (0..count).map(|_| {
        let a = wide_random(mut seed) % top + 1;
        let b = wide_random(mut seed) % top + 1;
        [a.min(b), a.max(b)].to_vec()
    }).collect()
}

fn fold_list(values: Vec[i64]) -> i64 {
    values.iter().fold(values.len(), |acc, v| (acc * 1009 + v) % 1000000007)
}

fn main() {
    let names = ["star", "sweep", "diff", "struct", "iter", "solution"];
    let mut seed = 2251;
    let mut cases: Vec[(Vec[Vec[i64]], Vec[i64])] = Vec.new();
    for c in 0..360 {
        let f = next_random(mut seed) % 8 + 1;
        let p = next_random(mut seed) % 8 + 1;
        let top = if c >= 300 and c < 330 { 500000000 } else { 10 };
        let flowers = random_flowers(mut seed, f, top);
        let people: Vec[i64] = (0..p).map(|_| {
            if c >= 330 {
                let at = ref flowers[next_random(mut seed) % f];
                match next_random(mut seed) % 4 {
                    0 => (at[0] - 1).max(1),
                    1 => at[0],
                    2 => at[1],
                    _ => at[1] + 1,
                }
            } else {
                wide_random(mut seed) % top + 1
            }
        }).collect();
        cases.push((flowers, people));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (flowers, people) in cases.iter() {
        let truth = literal(flowers, people);
        check = (check * 31 + fold_list(truth)) % 1000000007;
        let rev_flowers: Vec[Vec[i64]] = flowers.iter().rev().map(|f| f.clone()).collect();
        let rev_people: Vec[i64] = people.iter().rev().collect();
        let mut with_all = flowers.clone();
        with_all.push([1, 1000000000].to_vec());
        let moved_flowers: Vec[Vec[i64]] = flowers.iter().map(|f| [f[0] + 7, f[1] + 7].to_vec()).collect();
        let moved_people: Vec[i64] = people.iter().map(|t| t + 7).collect();
        let mut halves: Vec[Vec[i64]] = Vec.new();
        for f in flowers.iter() {
            if f[0] < f[1] {
                let middle = (f[0] + f[1]) / 2;
                halves.push([f[0], middle].to_vec());
                halves.push([middle + 1, f[1]].to_vec());
            } else {
                halves.push(f.clone());
            }
        }
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, flowers, people)).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let reversed: Vec[i64] = value.iter().rev().collect();
            let raised: Vec[i64] = value.iter().map(|v| v + 1).collect();
            let verdicts = [
                value == truth,
                answer(arm, rev_flowers, rev_people) == reversed,
                answer(arm, with_all, people) == raised,
                answer(arm, moved_flowers, moved_people) == value,
                answer(arm, halves, people) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{flowers} {people} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
