// LeetCode #2241: Design an ATM Machine -- the counts of the five
// banknotes, smallest first; a withdrawal plans as many of each as fit,
// largest first, and takes the plan only when it pays the whole amount.
// O(1) a call.

struct Atm {
    counts: Vec[i64],
}

impl Atm {
    fn new() -> Atm {
        Atm { counts: Vec.filled(5, 0) }
    }

    fn deposit(mut ref self, banknotes_count: Vec[i64]) {
        for i in 0..5 {
            self.counts[i] += banknotes_count[i];
        }
    }

    fn withdraw(mut ref self, amount: i64) -> Vec[i64] {
        let values = [20, 50, 100, 200, 500];
        let mut plan: Vec[i64] = Vec.filled(5, 0);
        let mut left = amount;
        for i in (0..5).rev() {
            plan[i] = (left / values[i]).min(self.counts[i]);
            left -= plan[i] * values[i];
        }
        if left != 0 {
            return [-1].to_vec();
        }
        for i in 0..5 {
            self.counts[i] -= plan[i];
        }
        plan
    }
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 2241;
    let mut paid = 0;
    let mut check = 0;
    let mut counts: Vec[i64] = Vec.filled(5, 0);
    for _ in 0..200 {
        let mut atm = Atm.new();
        for _ in 0..5000 {
            if next_random(mut seed) % 2 == 0 {
                for i in 0..5 {
                    counts[i] = wide_random(mut seed) % 1000000001;
                }
                atm.deposit(counts);
            } else {
                let amount = (wide_random(mut seed) % 100000000 + 1) * 10;
                let answer = atm.withdraw(amount);
                if answer[0] >= 0 {
                    paid += 1;
                }
                for n in answer.iter() {
                    check = (check * 31 + n % 1000000007 + 1) % 1000000007;
                }
            }
        }
    }
    println(f"200 machines of 5000 calls: {paid} withdrawals paid, checksum {check}");
}
