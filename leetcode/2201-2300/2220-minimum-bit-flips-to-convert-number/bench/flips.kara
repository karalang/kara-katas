// LeetCode #2220: Minimum Bit Flips to Convert Number -- a bit has to be
// flipped exactly where start and goal differ, which is where start ^
// goal has a 1; those are counted by clearing the lowest 1 with
// x & (x - 1) until none is left. O(number of flips).

fn min_bit_flips(start: i64, goal: i64) -> i64 {
    let mut differ = start ^ goal;
    let mut flips = 0;
    while differ != 0 {
        differ = differ & (differ - 1);
        flips += 1;
    }
    flips
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 2220;
    // 10^5 pairs up to 10^9
    let mut starts: Vec[i64] = Vec.new();
    let mut goals: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        starts.push(wide_random(mut seed) % 1000000001);
        goals.push(wide_random(mut seed) % 1000000001);
    }
    let mut check = 0;
    for r in 0..50 {
        // punch: one goal is drawn again before each round
        goals[r * 1999] = wide_random(mut seed) % 1000000001;
        let mut total = 0;
        for i in 0..100000 {
            total += min_bit_flips(starts[i], goals[i]);
        }
        check = (check * 31 + total) % 1000000007;
    }
    println(f"10^5 pairs, 50 punches: checksum {check}");
}
