// LeetCode #2288: Apply Discount to Prices -- the bench, the ★ arm.
// Split on spaces; a `$` and then only digits is a price, discounted in
// whole cents and written back with two decimals.

fn is_price(word: Str) -> bool {
    word.len() > 1 and word.starts_with("$") and word.bytes().iter().skip(1).all(|b| b.is_ascii_digit())
}

fn discount_prices(sentence: Str, discount: i64) -> String {
    let mut words: Vec[String] = Vec.new();
    for word in sentence.split(" ") {
        if is_price(word) {
            let price = i64.parse(word[1..]).unwrap();
            let cents = price * (100 - discount);
            words.push(f"${cents / 100}.{cents % 100:02}");
        } else {
            words.push(word.to_string());
        }
    }
    words.join(" ")
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a price, a `$` before letters, a plain word, or digits with no `$`
fn word(seed: mut ref i64) -> String {
    let kind = next_random(mut seed) % 4;
    let len = next_random(mut seed) % 8 + 1;
    let mut w = String.new();
    if kind < 2 {
        w.push('$');
    }
    for _ in 0..len {
        let r = next_random(mut seed);
        w.push(if kind == 0 or kind == 3 { (b'0' + (r % 10) as u8) as char } else { (b'a' + (r % 26) as u8) as char });
    }
    w
}

fn main() {
    // 4000 sentences of 12 words built once; then 50 passes, the discount
    // the pass number times 2
    let mut seed = 2288;
    let mut sentences: Vec[String] = Vec.new();
    for _ in 0..4000 {
        let mut words: Vec[String] = Vec.new();
        for _ in 0..12 {
            words.push(word(mut seed));
        }
        sentences.push(words.join(" "));
    }
    let mut check = 0;
    for pass in 0..50 {
        for sentence in sentences.iter() {
            let answer = discount_prices(sentence, pass * 2);
            check = (check * 31 + answer.len() + answer.bytes()[answer.len() - 2]) % 1000000007;
        }
    }
    println(f"50 passes over 4000 sentences: checksum {check}");
}
