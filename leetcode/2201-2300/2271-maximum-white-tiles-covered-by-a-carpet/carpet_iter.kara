// LeetCode #2271: Maximum White Tiles Covered by a Carpet -- in chains.
// The sorted tiles' prefix sums by `scan`, then a `map` over each tile
// that finds the first tile starting past the carpet with
// `partition_point`, takes the sum between, less the overhang, and a
// `max` over all. O(m log m).

fn maximum_white_tiles(tiles: Vec[Vec[i64]], carpet_len: i64) -> i64 {
    let mut sorted = tiles.clone();
    sorted.sort();
    let mut prefix: Vec[i64] = [0].to_vec();
    prefix.extend(sorted.iter().scan(0, |sum, t| {
        let sum = sum + t[1] - t[0] + 1;
        Some((sum, sum))
    }));
    (0..sorted.len())
        .map(|i| {
            let end = sorted[i][0] + carpet_len - 1;
            let j = sorted.partition_point(|t| t[0] <= end);
            prefix[j] - prefix[i] - (sorted[j - 1][1] - end).max(0)
        })
        .max()
        .unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `m` tiles of lengths 1 to `long` with gaps of 0 to `gap` between them,
// from 1 on, then shuffled
fn random_tiles(seed: mut ref i64, m: i64, long: i64, gap: i64) -> Vec[Vec[i64]] {
    let mut tiles: Vec[Vec[i64]] = Vec.new();
    let mut at = 1;
    for _ in 0..m {
        at += next_random(mut seed) % (gap + 1);
        let end = at + next_random(mut seed) % long;
        tiles.push([at, end].to_vec());
        at = end + 1;
    }
    for i in (1..m).rev() {
        let k = next_random(mut seed) % (i + 1);
        tiles.swap(i, k);
    }
    tiles
}

fn main() {
    // LeetCode's two examples, then five more: one tile longer than the
    // carpet, one shorter, tiles touching end to end, a carpet of 1, and a
    // carpet reaching across a wide gap
    let examples = [
        ([[1, 5].to_vec(), [10, 11].to_vec(), [12, 18].to_vec(), [20, 25].to_vec(), [30, 32].to_vec()].to_vec(), 10),
        ([[10, 11].to_vec(), [1, 1].to_vec()].to_vec(), 2),
        ([[1, 100].to_vec()].to_vec(), 7),
        ([[5, 6].to_vec()].to_vec(), 7),
        ([[1, 3].to_vec(), [4, 6].to_vec(), [7, 9].to_vec()].to_vec(), 5),
        ([[8, 8].to_vec(), [2, 4].to_vec()].to_vec(), 1),
        ([[1, 2].to_vec(), [1000, 1003].to_vec(), [1005, 1005].to_vec()].to_vec(), 1000),
    ];
    for (tiles, carpet_len) in examples.iter() {
        println(f"{tiles}, {carpet_len} -> {maximum_white_tiles(tiles, carpet_len)}");
    }
    // 2000 sets of 1 to 12 tiles, lengths to 1, 5 or 20, gaps to 0, 3 or
    // 30, with carpets of 1 to 60
    let mut seed = 2271;
    let mut check = 0;
    for t in 0..2000 {
        let m = next_random(mut seed) % 12 + 1;
        let tiles = random_tiles(mut seed, m, [1, 5, 20][t % 3], [0, 3, 30][t / 3 % 3]);
        let carpet_len = next_random(mut seed) % 60 + 1;
        check = (check * 31 + maximum_white_tiles(tiles, carpet_len)) % 1000000007;
    }
    println(f"2000 sets: checksum {check}");
    // the constraints' largest, 5 * 10^4 tiles: lengths to 10^4 and gaps
    // to 10^4 under carpets of 10^3, 10^6 and 10^9
    let big = random_tiles(mut seed, 50000, 10000, 10000);
    let answers = [maximum_white_tiles(big, 1000), maximum_white_tiles(big, 1000000), maximum_white_tiles(big, 1000000000)];
    println(f"5 * 10^4 tiles: {answers}");
}
