// LeetCode #2213: Longest Substring of One Repeating Character -- the
// blocks arm: the word cut into blocks of about sqrt(n) letters, each
// block summed up by its longest run from the start, from the end and
// inside. A query rescans only its own block; the answer walks the
// blocks left to right, carrying the run that reaches each block's start.
// O(n + k sqrt n).

fn rescan(letters: Vec[char], b: i64, width: i64, prefix: mut ref Vec[i64], suffix: mut ref Vec[i64], inner: mut ref Vec[i64]) {
    let start = b * width;
    let end = (start + width).min(letters.len());
    let mut run = 0;
    let mut best = 0;
    prefix[b] = 0;
    for i in start..end {
        run = if i > start and letters[i] == letters[i - 1] { run + 1 } else { 1 };
        if run == i - start + 1 {
            prefix[b] = run;
        }
        best = best.max(run);
    }
    suffix[b] = run;
    inner[b] = best;
}

fn longest(letters: Vec[char], width: i64, prefix: Vec[i64], suffix: Vec[i64], inner: Vec[i64]) -> i64 {
    let mut best = 0;
    let mut run = 0;
    for b in 0..prefix.len() {
        let start = b * width;
        let length = (start + width).min(letters.len()) - start;
        let head = if b > 0 and letters[start - 1] == letters[start] { run + prefix[b] } else { prefix[b] };
        best = best.max(inner[b]).max(head);
        run = if prefix[b] == length { head } else { suffix[b] };
    }
    best
}

fn longest_repeating(s: String, query_characters: String, query_indices: Vec[i64]) -> Vec[i64] {
    let mut letters: Vec[char] = s.chars().collect();
    let n = letters.len();
    let mut width = 1;
    while width * width < n {
        width += 1;
    }
    let blocks = (n + width - 1) / width;
    let mut prefix: Vec[i64] = Vec.filled(blocks, 0);
    let mut suffix: Vec[i64] = Vec.filled(blocks, 0);
    let mut inner: Vec[i64] = Vec.filled(blocks, 0);
    for b in 0..blocks {
        rescan(letters, b, width, mut prefix, mut suffix, mut inner);
    }
    let mut lengths: Vec[i64] = Vec.new();
    for (letter, at) in query_characters.chars().zip(query_indices.iter()) {
        letters[at] = letter;
        rescan(letters, at / width, width, mut prefix, mut suffix, mut inner);
        lengths.push(longest(letters, width, prefix, suffix, inner));
    }
    lengths
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut word = String.new();
    for _ in 0..n {
        word.push(['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z'][next_random(mut seed) % letters]);
    }
    word
}

fn random_indices(k: i64, n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut indices: Vec[i64] = Vec.new();
    for _ in 0..k {
        indices.push(next_random(mut seed) % n);
    }
    indices
}

fn show(s: String, query_characters: String, query_indices: Vec[i64]) {
    println(f"\"{s}\" with \"{query_characters}\" at {query_indices} -> {longest_repeating(s, query_characters, query_indices)}");
}

fn main() {
    // LeetCode's two examples, then four more: one letter, a run broken in
    // the middle, two runs joined, and a letter set to what it was
    show("babacc", "bcb", [1, 3, 3]);
    show("abyzz", "aa", [2, 1]);
    show("a", "b", [0]);
    show("aaaaaaa", "ba", [3, 3]);
    show("aabaa", "a", [2]);
    show("abcabc", "aab", [0, 0, 4]);
    // 3000 random words of 1 to 30 letters, each with 1 to 30 queries,
    // the letters drawn from 2, 3 and 26 in turn
    let mut seed = 2213;
    let mut check = 0;
    for t in 0..3000 {
        let letters = [2, 3, 26][t % 3];
        let n = next_random(mut seed) % 30 + 1;
        let k = next_random(mut seed) % 30 + 1;
        let s = random_word(n, letters, mut seed);
        let query_characters = random_word(k, letters, mut seed);
        let query_indices = random_indices(k, n, mut seed);
        for length in longest_repeating(s, query_characters, query_indices) {
            check = (check * 31 + length) % 1000000007;
        }
    }
    println(f"3000 words: checksum {check}");
    // the constraints' largest: 10^5 letters of 'a' and 'b' with 10^5
    // random queries, then 10^5 'a's with the middle letter broken and
    // mended in turn
    let s = random_word(100000, 2, mut seed);
    let query_characters = random_word(100000, 2, mut seed);
    let query_indices = random_indices(100000, 100000, mut seed);
    let lengths = longest_repeating(s, query_characters, query_indices);
    let total = lengths.iter().sum();
    println(f"10^5 random: total {total}, last {lengths[99999]}");
    let mut plain = String.new();
    let mut flips = String.new();
    for i in 0..100000 {
        plain.push('a');
        flips.push(if i % 2 == 0 { 'b' } else { 'a' });
    }
    let lengths = longest_repeating(plain, flips, Vec.filled(100000, 50000));
    println(f"10^5 alike: first {lengths[0]}, last {lengths[99999]}, total {lengths.iter().sum()}");
}
