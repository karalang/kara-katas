// LeetCode #2213: Longest Substring of One Repeating Character -- a
// segment tree over the letters, each node keeping the longest run that
// starts its range, the longest that ends it, and the longest inside it;
// two halves join when the letters either side of the middle match. Each
// query changes one letter and mends the nodes above it. O((n + k) log n).

fn pull(node: i64, lo: i64, hi: i64, letters: Vec[char], prefix: mut ref Vec[i64], suffix: mut ref Vec[i64], best: mut ref Vec[i64]) {
    let mid = (lo + hi) / 2;
    let left = 2 * node;
    let right = 2 * node + 1;
    let joined = letters[mid] == letters[mid + 1];
    prefix[node] = if joined and prefix[left] == mid - lo + 1 { prefix[left] + prefix[right] } else { prefix[left] };
    suffix[node] = if joined and suffix[right] == hi - mid { suffix[right] + suffix[left] } else { suffix[right] };
    best[node] = best[left].max(best[right]);
    if joined {
        best[node] = best[node].max(suffix[left] + prefix[right]);
    }
}

fn build(node: i64, lo: i64, hi: i64, letters: Vec[char], prefix: mut ref Vec[i64], suffix: mut ref Vec[i64], best: mut ref Vec[i64]) {
    if lo == hi {
        prefix[node] = 1;
        suffix[node] = 1;
        best[node] = 1;
        return;
    }
    let mid = (lo + hi) / 2;
    build(2 * node, lo, mid, letters, mut prefix, mut suffix, mut best);
    build(2 * node + 1, mid + 1, hi, letters, mut prefix, mut suffix, mut best);
    pull(node, lo, hi, letters, mut prefix, mut suffix, mut best);
}

fn update(node: i64, lo: i64, hi: i64, at: i64, letters: Vec[char], prefix: mut ref Vec[i64], suffix: mut ref Vec[i64], best: mut ref Vec[i64]) {
    if lo == hi {
        return;
    }
    let mid = (lo + hi) / 2;
    if at <= mid {
        update(2 * node, lo, mid, at, letters, mut prefix, mut suffix, mut best);
    } else {
        update(2 * node + 1, mid + 1, hi, at, letters, mut prefix, mut suffix, mut best);
    }
    pull(node, lo, hi, letters, mut prefix, mut suffix, mut best);
}

fn longest_repeating(s: String, query_characters: String, query_indices: Vec[i64]) -> Vec[i64] {
    let mut letters: Vec[char] = s.chars().collect();
    let n = letters.len();
    let mut prefix: Vec[i64] = Vec.filled(4 * n, 0);
    let mut suffix: Vec[i64] = Vec.filled(4 * n, 0);
    let mut best: Vec[i64] = Vec.filled(4 * n, 0);
    build(1, 0, n - 1, letters, mut prefix, mut suffix, mut best);
    let mut lengths: Vec[i64] = Vec.new();
    for (letter, at) in query_characters.chars().zip(query_indices.iter()) {
        letters[at] = letter;
        update(1, 0, n - 1, at, letters, mut prefix, mut suffix, mut best);
        lengths.push(best[1]);
    }
    lengths
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut word = String.new();
    for _ in 0..n {
        word.push(['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z'][next_random(mut seed) % letters]);
    }
    word
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 2213;
    let mut words: Vec[(String, String, Vec[i64])] = Vec.new();
    for w in 0..6 {
        // 10^5 letters from 2, 3 and 26 in turn, with 10^5 queries
        let letters = [2, 3, 26][w % 3];
        let s = random_word(100000, letters, mut seed);
        let query_characters = random_word(100000, letters, mut seed);
        let mut query_indices: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            query_indices.push(wide_random(mut seed) % 100000);
        }
        words.push((s, query_characters, query_indices));
    }
    let mut check = 0;
    for (s, query_characters, query_indices) in words.iter() {
        for length in longest_repeating(s, query_characters, query_indices) {
            check = (check * 31 + length) % 1000000007;
        }
    }
    println(f"6 words of 10^5: checksum {check}");
}
