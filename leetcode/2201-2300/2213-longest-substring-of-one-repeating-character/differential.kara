// LeetCode #2213: Longest Substring of One Repeating Character -- the
// differential. The six arms, against the statement read literally: after
// each query the letter set, every substring checked letter by letter for
// one repeating letter, and the longest such kept; no runs, no tree. 300
// random words of 1 to 12 letters with 1 to 12 queries, the letters drawn
// from 2, 3 and 26 in turn; then 30 of one letter queried with two; then
// 30 with every query at one index. Every case is drawn before any arm
// answers.
//
// P1  the lengths are the statement read literally
// P2  one length for each query, each from 1 to the word's length
// P3  the word reversed and every index mirrored: the same lengths
// P4  every letter moved 7 on in the alphabet, round from z to a: the
//     same lengths
// P5  the queries cut in two, the second half asked of the word the
//     first half left: the same lengths
// P6  each arm agrees with at least three of the other five


// ---- repeating.kara: the ★ arm, a segment tree of three arrays
fn star_pull(node: i64, lo: i64, hi: i64, letters: Vec[char], prefix: mut ref Vec[i64], suffix: mut ref Vec[i64], best: mut ref Vec[i64]) {
    let mid = (lo + hi) / 2;
    let left = 2 * node;
    let right = 2 * node + 1;
    let joined = letters[mid] == letters[mid + 1];
    prefix[node] = if joined and prefix[left] == mid - lo + 1 { prefix[left] + prefix[right] } else { prefix[left] };
    suffix[node] = if joined and suffix[right] == hi - mid { suffix[right] + suffix[left] } else { suffix[right] };
    best[node] = best[left].max(best[right]);
    if joined {
        best[node] = best[node].max(suffix[left] + prefix[right]);
    }
}

fn star_build(node: i64, lo: i64, hi: i64, letters: Vec[char], prefix: mut ref Vec[i64], suffix: mut ref Vec[i64], best: mut ref Vec[i64]) {
    if lo == hi {
        prefix[node] = 1;
        suffix[node] = 1;
        best[node] = 1;
        return;
    }
    let mid = (lo + hi) / 2;
    star_build(2 * node, lo, mid, letters, mut prefix, mut suffix, mut best);
    star_build(2 * node + 1, mid + 1, hi, letters, mut prefix, mut suffix, mut best);
    star_pull(node, lo, hi, letters, mut prefix, mut suffix, mut best);
}

fn star_update(node: i64, lo: i64, hi: i64, at: i64, letters: Vec[char], prefix: mut ref Vec[i64], suffix: mut ref Vec[i64], best: mut ref Vec[i64]) {
    if lo == hi {
        return;
    }
    let mid = (lo + hi) / 2;
    if at <= mid {
        star_update(2 * node, lo, mid, at, letters, mut prefix, mut suffix, mut best);
    } else {
        star_update(2 * node + 1, mid + 1, hi, at, letters, mut prefix, mut suffix, mut best);
    }
    star_pull(node, lo, hi, letters, mut prefix, mut suffix, mut best);
}

fn star_longest_repeating(s: String, query_characters: String, query_indices: Vec[i64]) -> Vec[i64] {
    let mut letters: Vec[char] = s.chars().collect();
    let n = letters.len();
    let mut prefix: Vec[i64] = Vec.filled(4 * n, 0);
    let mut suffix: Vec[i64] = Vec.filled(4 * n, 0);
    let mut best: Vec[i64] = Vec.filled(4 * n, 0);
    star_build(1, 0, n - 1, letters, mut prefix, mut suffix, mut best);
    let mut lengths: Vec[i64] = Vec.new();
    for (letter, at) in query_characters.chars().zip(query_indices.iter()) {
        letters[at] = letter;
        star_update(1, 0, n - 1, at, letters, mut prefix, mut suffix, mut best);
        lengths.push(best[1]);
    }
    lengths
}

// ---- repeating_runs.kara: the runs in a `SortedMap`, their lengths counted
fn runs_add(runs: mut ref SortedMap[i64, i64], counts: mut ref SortedMap[i64, i64], start: i64, end: i64) {
    runs.insert(start, end);
    let length = end - start + 1;
    counts[length] = (counts.get(length) ?? 0) + 1;
}

fn runs_drop_run(runs: mut ref SortedMap[i64, i64], counts: mut ref SortedMap[i64, i64], start: i64) -> i64 {
    let end = runs.remove(start).unwrap();
    let length = end - start + 1;
    if counts[length] == 1 {
        counts.remove(length);
    } else {
        counts[length] -= 1;
    }
    end
}

fn runs_longest_repeating(s: String, query_characters: String, query_indices: Vec[i64]) -> Vec[i64] {
    let mut letters: Vec[char] = s.chars().collect();
    let n = letters.len();
    let mut runs: SortedMap[i64, i64] = SortedMap.new();
    let mut counts: SortedMap[i64, i64] = SortedMap.new();
    let mut start = 0;
    for i in 1..=n {
        if i == n or letters[i] != letters[start] {
            runs_add(mut runs, mut counts, start, i - 1);
            start = i;
        }
    }
    let mut lengths: Vec[i64] = Vec.new();
    for (letter, at) in query_characters.chars().zip(query_indices.iter()) {
        if letters[at] != letter {
            // split the run the letter sits in
            let first = *runs.floor(at).unwrap().0;
            let last = runs_drop_run(mut runs, mut counts, first);
            if first < at {
                runs_add(mut runs, mut counts, first, at - 1);
            }
            if at < last {
                runs_add(mut runs, mut counts, at + 1, last);
            }
            letters[at] = letter;
            // join it with the runs either side of the same letter
            let mut lo = at;
            let mut hi = at;
            if at > 0 and letters[at - 1] == letter {
                lo = *runs.floor(at - 1).unwrap().0;
                runs_drop_run(mut runs, mut counts, lo);
            }
            if at + 1 < n and letters[at + 1] == letter {
                hi = runs_drop_run(mut runs, mut counts, at + 1);
            }
            runs_add(mut runs, mut counts, lo, hi);
        }
        lengths.push(*counts.last().unwrap().0);
    }
    lengths
}

// ---- repeating_blocks.kara: blocks of sqrt(n) letters
fn blocks_rescan(letters: Vec[char], b: i64, width: i64, prefix: mut ref Vec[i64], suffix: mut ref Vec[i64], inner: mut ref Vec[i64]) {
    let start = b * width;
    let end = (start + width).min(letters.len());
    let mut run = 0;
    let mut best = 0;
    prefix[b] = 0;
    for i in start..end {
        run = if i > start and letters[i] == letters[i - 1] { run + 1 } else { 1 };
        if run == i - start + 1 {
            prefix[b] = run;
        }
        best = best.max(run);
    }
    suffix[b] = run;
    inner[b] = best;
}

fn blocks_longest(letters: Vec[char], width: i64, prefix: Vec[i64], suffix: Vec[i64], inner: Vec[i64]) -> i64 {
    let mut best = 0;
    let mut run = 0;
    for b in 0..prefix.len() {
        let start = b * width;
        let length = (start + width).min(letters.len()) - start;
        let head = if b > 0 and letters[start - 1] == letters[start] { run + prefix[b] } else { prefix[b] };
        best = best.max(inner[b]).max(head);
        run = if prefix[b] == length { head } else { suffix[b] };
    }
    best
}

fn blocks_longest_repeating(s: String, query_characters: String, query_indices: Vec[i64]) -> Vec[i64] {
    let mut letters: Vec[char] = s.chars().collect();
    let n = letters.len();
    let mut width = 1;
    while width * width < n {
        width += 1;
    }
    let blocks = (n + width - 1) / width;
    let mut prefix: Vec[i64] = Vec.filled(blocks, 0);
    let mut suffix: Vec[i64] = Vec.filled(blocks, 0);
    let mut inner: Vec[i64] = Vec.filled(blocks, 0);
    for b in 0..blocks {
        blocks_rescan(letters, b, width, mut prefix, mut suffix, mut inner);
    }
    let mut lengths: Vec[i64] = Vec.new();
    for (letter, at) in query_characters.chars().zip(query_indices.iter()) {
        letters[at] = letter;
        blocks_rescan(letters, at / width, width, mut prefix, mut suffix, mut inner);
        lengths.push(blocks_longest(letters, width, prefix, suffix, inner));
    }
    lengths
}

// ---- repeating_struct.kara: `Stretch` and `join`, a bottom-up tree
#[derive(Copy, Clone)]
struct Stretch {
    first: char,
    last: char,
    length: i64,
    prefix: i64,
    suffix: i64,
    best: i64,
}

impl Stretch {
    fn letter(c: char) -> Stretch {
        Stretch { first: c, last: c, length: 1, prefix: 1, suffix: 1, best: 1 }
    }

    fn empty() -> Stretch {
        Stretch { first: 'a', last: 'a', length: 0, prefix: 0, suffix: 0, best: 0 }
    }

    fn join(ref self, other: Stretch) -> Stretch {
        if other.length == 0 {
            return *self;
        }
        if self.length == 0 {
            return other;
        }
        let meet = self.last == other.first;
        let prefix = if meet and self.prefix == self.length { self.length + other.prefix } else { self.prefix };
        let suffix = if meet and other.suffix == other.length { other.length + self.suffix } else { other.suffix };
        let across = if meet { self.suffix + other.prefix } else { 0 };
        Stretch {
            first: self.first,
            last: other.last,
            length: self.length + other.length,
            prefix: prefix,
            suffix: suffix,
            best: self.best.max(other.best).max(across),
        }
    }
}

fn struct_longest_repeating(s: String, query_characters: String, query_indices: Vec[i64]) -> Vec[i64] {
    let n = s.len();
    let mut size = 1;
    while size < n {
        size *= 2;
    }
    let mut tree: Vec[Stretch] = Vec.filled(2 * size, Stretch.empty());
    for (i, c) in s.chars().enumerate() {
        tree[size + i] = Stretch.letter(c);
    }
    for node in (1..size).rev() {
        tree[node] = tree[2 * node].join(tree[2 * node + 1]);
    }
    let mut lengths: Vec[i64] = Vec.new();
    for (letter, at) in query_characters.chars().zip(query_indices.iter()) {
        let mut node = size + at;
        tree[node] = Stretch.letter(letter);
        while node > 1 {
            node /= 2;
            tree[node] = tree[2 * node].join(tree[2 * node + 1]);
        }
        lengths.push(tree[1].best);
    }
    lengths
}

// ---- repeating_iter.kara: the levels by `chunks(2)` and `map`
// a iter_node over [start, end), its halves meeting at mid
fn iter_join(letters: Vec[char], start: i64, mid: i64, end: i64, left: (i64, i64, i64), right: (i64, i64, i64)) -> (i64, i64, i64) {
    let (left_prefix, left_suffix, left_best) = left;
    let (right_prefix, right_suffix, right_best) = right;
    let meet = letters[mid - 1] == letters[mid];
    let prefix = if meet and left_prefix == mid - start { left_prefix + right_prefix } else { left_prefix };
    let suffix = if meet and right_suffix == end - mid { right_suffix + left_suffix } else { right_suffix };
    let across = if meet { left_suffix + right_prefix } else { 0 };
    (prefix, suffix, left_best.max(right_best).max(across))
}

// level h's iter_node j from level h - 1
fn iter_node(levels: Vec[Vec[(i64, i64, i64)]], letters: Vec[char], h: i64, j: i64) -> (i64, i64, i64) {
    let below = ref levels[h - 1];
    if 2 * j + 1 == below.len() {
        return below[2 * j];
    }
    let width = 1 << (h - 1);
    let start = 2 * j * width;
    let mid = start + width;
    let end = (mid + width).min(letters.len());
    iter_join(letters, start, mid, end, below[2 * j], below[2 * j + 1])
}

fn iter_longest_repeating(s: String, query_characters: String, query_indices: Vec[i64]) -> Vec[i64] {
    let mut letters: Vec[char] = s.chars().collect();
    let mut levels: Vec[Vec[(i64, i64, i64)]] = Vec.new();
    levels.push(letters.iter().map(|_| (1, 1, 1)).collect());
    while levels[levels.len() - 1].len() > 1 {
        let width = 1 << (levels.len() - 1);
        let next: Vec[(i64, i64, i64)] = levels[levels.len() - 1].chunks(2).into_iter().enumerate().map(|(j, pair)| {
            if pair.len() == 1 {
                return pair[0];
            }
            let start = 2 * j * width;
            iter_join(letters, start, start + width, (start + 2 * width).min(letters.len()), pair[0], pair[1])
        }).collect();
        levels.push(next);
    }
    let top = levels.len() - 1;
    query_characters.chars().zip(query_indices.iter()).map(|(letter, at)| {
        letters[at] = letter;
        for h in 1..=top {
            let j = at >> h;
            levels[h][j] = iter_node(levels, letters, h, j);
        }
        levels[top][0].2
    }).collect()
}

// ---- repeating_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn longest_repeating(s: String, query_characters: String, query_indices: Vec[i32]) -> Vec[i32] {
        let mut s = s.bytes().to_vec();
        let n = s.len();
        let mut tree = SegTree.new(n);
        tree.build(1, 0, n - 1, s);
        let mut ans = Vec.with_capacity(query_indices.len());
        for (i, c) in query_characters.bytes().iter().enumerate() {
            let at = query_indices[i] as i64;
            s[at] = c;
            tree.update(1, 0, n - 1, at, s);
            ans.push(tree.best[1]);
        }
        ans
    }
}

struct SegTree {
    pre: Vec[i32],
    suf: Vec[i32],
    best: Vec[i32],
}

impl SegTree {
    fn new(n: i64) -> Self {
        SegTree { pre: Vec.filled(4 * n, 0), suf: Vec.filled(4 * n, 0), best: Vec.filled(4 * n, 0) }
    }

    fn pull(mut ref self, node: i64, lo: i64, hi: i64, s: Slice[u8]) {
        let mid = (lo + hi) / 2;
        let (l, r) = (2 * node, 2 * node + 1);
        let joined = s[mid] == s[mid + 1];
        self.pre[node] = if joined and self.pre[l] == (mid - lo + 1) as i32 { self.pre[l] + self.pre[r] } else { self.pre[l] };
        self.suf[node] = if joined and self.suf[r] == (hi - mid) as i32 { self.suf[r] + self.suf[l] } else { self.suf[r] };
        self.best[node] = self.best[l].max(self.best[r]);
        if joined {
            self.best[node] = self.best[node].max(self.suf[l] + self.pre[r]);
        }
    }

    fn build(mut ref self, node: i64, lo: i64, hi: i64, s: Slice[u8]) {
        if lo == hi {
            self.pre[node] = 1;
            self.suf[node] = 1;
            self.best[node] = 1;
            return;
        }
        let mid = (lo + hi) / 2;
        self.build(2 * node, lo, mid, s);
        self.build(2 * node + 1, mid + 1, hi, s);
        self.pull(node, lo, hi, s);
    }

    fn update(mut ref self, node: i64, lo: i64, hi: i64, at: i64, s: Slice[u8]) {
        if lo == hi {
            return;
        }
        let mid = (lo + hi) / 2;
        if at <= mid {
            self.update(2 * node, lo, mid, at, s);
        } else {
            self.update(2 * node + 1, mid + 1, hi, at, s);
        }
        self.pull(node, lo, hi, s);
    }
}

struct Solution {}

fn solution_longest_repeating(s: String, query_characters: String, query_indices: Vec[i64]) -> Vec[i64] {
    let indices: Vec[i32] = query_indices.iter().map(|x| x as i32).collect();
    Solution.longest_repeating(s, query_characters, indices).iter().map(|x| x as i64).collect()
}


// ---- the statement read literally

// the longest substring of one repeating letter, every substring tried
fn longest_literal(letters: Vec[char]) -> i64 {
    let n = letters.len();
    let mut best = 0;
    for i in 0..n {
        for j in i..n {
            let mut alike = true;
            for m in i..=j {
                if letters[m] != letters[i] {
                    alike = false;
                }
            }
            if alike {
                best = best.max(j - i + 1);
            }
        }
    }
    best
}

fn literal(s: String, query_characters: String, query_indices: Vec[i64]) -> Vec[i64] {
    let mut letters: Vec[char] = s.chars().collect();
    let mut lengths: Vec[i64] = Vec.new();
    for (letter, at) in query_characters.chars().zip(query_indices.iter()) {
        letters[at] = letter;
        lengths.push(longest_literal(letters));
    }
    lengths
}

fn answer(arm: i64, s: String, query_characters: String, query_indices: Vec[i64]) -> Vec[i64] {
    match arm {
        0 => star_longest_repeating(s, query_characters, query_indices),
        1 => runs_longest_repeating(s, query_characters, query_indices),
        2 => blocks_longest_repeating(s, query_characters, query_indices),
        3 => struct_longest_repeating(s, query_characters, query_indices),
        4 => iter_longest_repeating(s, query_characters, query_indices),
        _ => solution_longest_repeating(s, query_characters, query_indices),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

const ALPHABET: Array[char, 26] = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z'];

fn moved(word: String) -> String {
    word.chars().map(|c| ALPHABET[((c as i64) - ('a' as i64) + 7) % 26]).collect()
}

struct Case {
    word: String,
    letters: String,
    indices: Vec[i64],
}

fn main() {
    let names = ["star", "runs", "blocks", "struct", "iter", "solution"];
    let mut seed = 2213;
    let mut cases: Vec[Case] = Vec.new();
    for c in 0..360 {
        let alphabet = if c < 300 { [2, 3, 26][c % 3] } else { 2 };
        let n = next_random(mut seed) % 12 + 1;
        let k = next_random(mut seed) % 12 + 1;
        let one = next_random(mut seed) % n;
        let mut word = String.new();
        for _ in 0..n {
            word.push(if c >= 300 and c < 330 { 'a' } else { ALPHABET[next_random(mut seed) % alphabet] });
        }
        let mut letters = String.new();
        let mut indices: Vec[i64] = Vec.new();
        for _ in 0..k {
            letters.push(ALPHABET[next_random(mut seed) % alphabet]);
            indices.push(if c >= 330 { one } else { next_random(mut seed) % n });
        }
        cases.push(Case { word: word, letters: letters, indices: indices });
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for case in cases.iter() {
        let word = ref case.word;
        let letters = ref case.letters;
        let indices = ref case.indices;
        let n = word.len();
        let k = indices.len();
        let truth = literal(word, letters, indices);
        for length in truth.iter() {
            check = (check * 31 + length) % 1000000007;
        }
        let reversed: String = word.chars().rev().collect();
        let mirrored: Vec[i64] = indices.iter().map(|i| n - 1 - i).collect();
        let half = k / 2;
        let mut after: Vec[char] = word.chars().collect();
        let firsts: Vec[char] = letters.chars().collect();
        for q in 0..half {
            after[indices[q]] = firsts[q];
        }
        let after_word: String = after.iter().collect();
        let first_letters: String = firsts[0..half].iter().collect();
        let second_letters: String = firsts[half..k].iter().collect();
        let first_indices: Vec[i64] = indices[0..half].to_vec();
        let second_indices: Vec[i64] = indices[half..k].to_vec();
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, word, letters, indices)).collect();
        for arm in 0..6 {
            let lengths = ref got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == *lengths {
                    same += 1;
                }
            }
            let mut cut = if half > 0 { answer(arm, word, first_letters, first_indices) } else { Vec.new() };
            cut.extend(answer(arm, after_word, second_letters, second_indices));
            let verdicts = [
                *lengths == truth,
                lengths.len() == k and lengths.iter().all(|x| x >= 1 and x <= n),
                answer(arm, reversed, letters, mirrored) == *lengths,
                answer(arm, moved(word), moved(letters), indices) == *lengths,
                cut == *lengths,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"\"{word}\" with \"{letters}\" at {indices} arm {names[arm]}: P{q + 1} fails, gave {lengths}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
