// LeetCode #2243: Calculate Digit Sum of a String -- while the string is
// longer than k, it is rebuilt group by group: each group of k
// characters cut with `substring`, its digits summed, and the sum
// written back. O(n) a round.

fn digit_sum(s: String, k: i64) -> String {
    let mut current = s.clone();
    while current.len() > k {
        let mut next = String.new();
        let mut start = 0;
        while start < current.len() {
            let end = (start + k).min(current.len());
            let mut sum = 0;
            for ch in current.substring(start, end).chars() {
                sum += (ch as i64) - ('0' as i64);
            }
            next.push_str(f"{sum}");
            start = end;
        }
        current = next;
    }
    current
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn digits_of(seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..100 {
        s.push(char.from_digit((next_random(mut seed) % 10) as u32, 10).unwrap());
    }
    s
}

fn main() {
    // 1000 strings of 100 digits built once, then 200 passes over all of
    // them with k from 2 to 5, one string drawn again before each
    let mut seed = 2243;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..1000 {
        strings.push(digits_of(mut seed));
    }
    let mut check = 0;
    for pass in 0..200 {
        let at = next_random(mut seed) % 1000;
        strings[at] = digits_of(mut seed);
        let k = pass % 4 + 2;
        for s in strings.iter() {
            for ch in digit_sum(s, k).chars() {
                check = (check * 31 + (ch as i64)) % 1000000007;
            }
        }
    }
    println(f"200 passes over 1000 strings: checksum {check}");
}
