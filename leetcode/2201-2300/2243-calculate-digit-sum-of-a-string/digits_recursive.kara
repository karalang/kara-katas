// LeetCode #2243: Calculate Digit Sum of a String -- recursion: a string
// no longer than k is the answer; otherwise one round is built (each
// group's digits summed with `to_digit`, the sums written with
// `to_string` and joined) and the answer is the round's answer.
// O(n) a round.

fn one_round(s: String, k: i64) -> String {
    let chars: Vec[char] = s.chars().collect();
    let mut parts: Vec[String] = Vec.new();
    let mut start = 0;
    while start < chars.len() {
        let mut sum = 0;
        for i in start..(start + k).min(chars.len()) {
            sum += chars[i].to_digit(10).unwrap();
        }
        parts.push(sum.to_string());
        start += k;
    }
    parts.join("")
}

fn digit_sum(s: String, k: i64) -> String {
    if s.len() <= k {
        return s.clone();
    }
    digit_sum(one_round(s, k), k)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `length` digits, each below `top`
fn digits_of(length: i64, top: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..length {
        s.push(char.from_digit((next_random(mut seed) % top) as u32, 10).unwrap());
    }
    s
}

fn main() {
    // LeetCode's two examples, then four more: no round needed, one
    // digit a group, a group sum of two digits growing the string, and
    // the constraints' longest of nines
    let examples = [
        ("11111222223", 3),
        ("00000000", 3),
        ("1234", 4),
        ("9999", 2),
        ("98765", 2),
        ("9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999", 2),
    ];
    for (s, k) in examples.iter() {
        println(f"{s} {k} -> {digit_sum(s, k)}");
    }
    // 3000 strings of 1 to 100 digits below 1 to 10, k from 2 to 100,
    // then from 2 to 5
    let mut seed = 2243;
    let mut check = 0;
    let mut length_total = 0;
    for c in 0..3000 {
        let length = next_random(mut seed) % 100 + 1;
        let top = next_random(mut seed) % 10 + 1;
        let s = digits_of(length, top, mut seed);
        let k = if c < 1500 { next_random(mut seed) % 99 + 2 } else { next_random(mut seed) % 4 + 2 };
        let answer = digit_sum(s, k);
        length_total += answer.len();
        for ch in answer.chars() {
            check = (check * 31 + (ch as i64)) % 1000000007;
        }
    }
    println(f"3000 strings: {length_total} digits answered, checksum {check}");
}
