// LeetCode #2255: Count Prefixes of a Given String -- the benchmark copy
// of prefixes.kara: each word tested with `s.starts_with(word)` and the
// ones that hold counted by `filter` and `count`.

fn count_prefixes(words: Vec[String], s: String) -> i64 {
    words.iter().filter(|w| s.starts_with(w)).count()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, longest: i64, letters: i64) -> String {
    let length = next_random(mut seed) % longest + 1;
    let chars: Vec[String] = (0..length).map(|_| {
        let k = next_random(mut seed) % letters;
        "abcde".substring(k, k + 1)
    }).collect();
    chars.join("")
}

fn main() {
    // 500 cases of 1000 words of up to 10 letters, from 1 to 5 letters,
    // and an s of up to 10
    let mut seed = 2255;
    let mut check = 0;
    for c in 0..500 {
        let letters = c % 5 + 1;
        let words: Vec[String] = (0..1000).map(|_| random_word(mut seed, 10, letters)).collect();
        let s = random_word(mut seed, 10, letters);
        check = (check * 31 + count_prefixes(words, s) + 1) % 1000000007;
    }
    println(f"500 cases of 1000 words: checksum {check}");
}
