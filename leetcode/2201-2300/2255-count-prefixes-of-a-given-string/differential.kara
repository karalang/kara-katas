// LeetCode #2255: Count Prefixes of a Given String -- the differential.
// The six arms, against the statement read literally: for every word,
// every beginning of s cut by `substring(0, k)` for k from 0 to |s|, and
// the word counted when one of them equals it; no `starts_with`, no
// byte or character walk. 300 random cases of 1 to 8 words of 1 to 4
// letters and an s of 1 to 6, from 2 letters; then 30 with words and s
// of up to 10 letters from 5; then 30 whose words are beginnings of s,
// some with one letter changed. Every case is drawn before any arm
// answers.
//
// P1  the count is the words that are beginnings of s, read literally
// P2  the words in reverse order: the same count
// P3  s itself added as a word: the count one more
// P4  every word and s with "e" put in front: the same count
// P5  s with one more letter added as a word: the same count
// P6  each arm agrees with at least three of the other five


// ---- prefixes.kara: the ★ arm, `starts_with`, `filter` and `count`
fn star_count_prefixes(words: Vec[String], s: String) -> i64 {
    words.iter().filter(|w| s.starts_with(w)).count()
}

// ---- prefixes_bytes.kara: bytes compared in a `while` loop
fn bytes_count_prefixes(words: Vec[String], s: String) -> i64 {
    let text = s.bytes();
    let mut count = 0;
    for word in words.iter() {
        let w = word.bytes();
        if w.len() > text.len() {
            continue;
        }
        let mut i = 0;
        while i < w.len() and w[i] == text[i] {
            i += 1;
        }
        if i == w.len() {
            count += 1;
        }
    }
    count
}

// ---- prefixes_set.kara: s's own prefixes in a `Set[String]`
fn set_count_prefixes(words: Vec[String], s: String) -> i64 {
    let mut prefixes: Set[String] = Set.new();
    for k in 1..s.len() + 1 {
        prefixes.insert(s[0..k].to_string());
    }
    let mut count = 0;
    for word in words.iter() {
        if prefixes.contains(word) {
            count += 1;
        }
    }
    count
}

// ---- prefixes_struct.kara: `Text` and `begins_with`, characters `zip`ped
struct StructText {
    chars: Vec[char],
}

impl StructText {
    fn of(s: String) -> StructText {
        StructText { chars: s.chars().collect() }
    }

    fn begins_with(ref self, word: String) -> bool {
        let mut length = 0;
        for (a, b) in word.chars().zip(self.chars.iter()) {
            if a != b {
                return false;
            }
            length += 1;
        }
        length == word.chars().count()
    }
}

fn struct_count_prefixes(words: Vec[String], s: String) -> i64 {
    let text = StructText.of(s);
    let mut count = 0;
    for word in words.iter() {
        if text.begins_with(word) {
            count += 1;
        }
    }
    count
}

// ---- prefixes_iter.kara: `filter`, `zip` and `all`
fn iter_count_prefixes(words: Vec[String], s: String) -> i64 {
    words
        .iter()
        .filter(|w| w.len() <= s.len() and w.chars().zip(s.chars()).all(|(a, b)| a == b))
        .count()
}

// ---- prefixes_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn count_prefixes(words: Vec[String], s: String) -> i32 {
        words.iter().filter(|w| s.starts_with(w.as_str())).count() as i32
    }
}

struct Solution {}

fn solution_count_prefixes(words: Vec[String], s: String) -> i64 {
    Solution.count_prefixes(words, s)
}

// ---- the statement read literally

fn literal(words: Vec[String], s: String) -> i64 {
    let mut count = 0;
    for word in words.iter() {
        let mut found = false;
        for k in 0..s.len() + 1 {
            if s.substring(0, k) == word {
                found = true;
            }
        }
        if found {
            count += 1;
        }
    }
    count
}

fn answer(arm: i64, words: Vec[String], s: String) -> i64 {
    match arm {
        0 => star_count_prefixes(words, s),
        1 => bytes_count_prefixes(words, s),
        2 => set_count_prefixes(words, s),
        3 => struct_count_prefixes(words, s),
        4 => iter_count_prefixes(words, s),
        _ => solution_count_prefixes(words, s),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, longest: i64, letters: i64) -> String {
    let length = next_random(mut seed) % longest + 1;
    let chars: Vec[String] = (0..length).map(|_| {
        let k = next_random(mut seed) % letters;
        "abcde".substring(k, k + 1)
    }).collect();
    chars.join("")
}

fn main() {
    let names = ["star", "bytes", "set", "struct", "iter", "solution"];
    let mut seed = 2255;
    let mut cases: Vec[(Vec[String], String)] = Vec.new();
    for c in 0..360 {
        let n = next_random(mut seed) % 8 + 1;
        let (longest, letters) = if c < 300 { (4, 2) } else { (10, 5) };
        let s = random_word(mut seed, if c < 300 { 6 } else { 10 }, letters);
        let words: Vec[String] = (0..n).map(|_| {
            if c < 330 {
                random_word(mut seed, longest, letters)
            } else {
                let cut = s.substring(0, next_random(mut seed) % s.len() + 1);
                if next_random(mut seed) % 2 == 0 {
                    cut
                } else {
                    let k = next_random(mut seed) % letters;
                    f"{cut.substring(0, cut.len() - 1)}{"abcde".substring(k, k + 1)}"
                }
            }
        }).collect();
        cases.push((words, s));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (words, s) in cases.iter() {
        let truth = literal(words, s);
        check = (check * 31 + truth + 1) % 1000000007;
        let reversed: Vec[String] = words.iter().rev().map(|w| w.clone()).collect();
        let mut with_s = words.clone();
        with_s.push(s.clone());
        let fronted: Vec[String] = words.iter().map(|w| f"e{w}").collect();
        let fronted_s = f"e{s}";
        let mut with_longer = words.clone();
        with_longer.push(f"{s}a");
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, words, s)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, reversed, s) == value,
                answer(arm, with_s, s) == value + 1,
                answer(arm, fronted, fronted_s) == value,
                answer(arm, with_longer, s) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{words} {s} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
