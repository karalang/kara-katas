// LeetCode #2294: Partition Array Such That Maximum Difference Is K --
// the iterator arm. Sort, then `fold` the numbers into the count of
// groups and the low end of the open one. O(n log n).

fn partition_array(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let (groups, _) = sorted.iter().fold((0, 0), |(groups, low), x| if groups == 0 or x - low > k { (groups + 1, x) } else { (groups, low) });
    groups
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; then one number, k of 0 with repeats,
    // a k that spans everything, and numbers exactly k apart
    let cases: Vec[(Vec[i64], i64)] = [
        ([3, 6, 1, 2, 5], 2),
        ([1, 2, 3], 1),
        ([2, 2, 4, 5], 0),
        ([7], 3),
        ([5, 5, 5, 6, 6, 0], 0),
        ([100000, 0, 50000], 100000),
        ([0, 4, 8, 12, 16], 4),
    ];
    for (nums, k) in cases.iter() {
        println(f"{nums.len()} numbers, k {k}: {partition_array(nums, k)}");
    }
    // 3000 random arrays of 1 to 60 numbers from 0 to 1, 2, .. 200, k
    // from 0 to 30
    let mut seed = 2294;
    let mut check = 0;
    let mut sum = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 60 + 1;
        let top = next_random(mut seed) % 200 + 1;
        let k = next_random(mut seed) % 31;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % (top + 1));
        }
        let groups = partition_array(nums, k);
        check = (check * 31 + groups) % 1000000007;
        sum += groups;
    }
    println(f"3000 arrays: checksum {check}, {sum} groups");
}
