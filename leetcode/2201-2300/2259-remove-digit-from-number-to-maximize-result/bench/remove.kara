// LeetCode #2259: Remove Digit From Number to Maximize Result -- the ★
// arm. Every candidate has the same length, so the larger is the one
// whose first difference is larger. Removing the occurrence at `i`
// shifts in the next digit there, which wins exactly when it is larger
// than `digit`; so the first occurrence followed by a larger digit is
// the best, and failing that the last occurrence, which keeps every
// earlier digit in place. One pass over the bytes. O(n).

fn remove_digit(number: String, digit: char) -> String {
    let bytes = number.bytes();
    let d = digit as u32 as u8;
    let mut last = 0;
    for i in 0..bytes.len() {
        if bytes[i] == d {
            last = i;
            if i + 1 < bytes.len() and bytes[i + 1] > d {
                break;
            }
        }
    }
    f"{number.substring(0, last)}{number.substring(last + 1, number.len())}"
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10^6 numbers of 100 digits, each a window of a pool of 10^6
    // random digits from '1' to '9' at a random offset, the digit to
    // remove the window's middle one
    let mut seed = 2259;
    let mut pool = String.new();
    for _ in 0..1000000 {
        pool.push((b'1' + (next_random(mut seed) % 9) as u8) as char);
    }
    let mut check = 0;
    for _ in 0..1000000 {
        let at = (next_random(mut seed) * 32768 + next_random(mut seed)) % (1000000 - 100);
        let number = pool.substring(at, at + 100);
        let digit = number.bytes()[50] as char;
        let answer = remove_digit(number, digit);
        for b in answer.bytes() {
            check = (check * 131 + b) % 1000000007;
        }
    }
    println(f"10^6 numbers of 100 digits: checksum {check}");
}
