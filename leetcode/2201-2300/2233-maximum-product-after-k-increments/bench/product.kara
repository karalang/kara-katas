// LeetCode #2233: Maximum Product After K Increments -- the smallest
// number raised by one, k times over, through a min-heap; then the heap
// emptied, the product taken modulo 10^9 + 7. O((n + k) log n).

fn maximum_product(nums: Vec[i64], k: i64) -> i64 {
    let mut queue: PriorityQueue[i64] = PriorityQueue.new();
    for x in nums.iter() {
        queue.push(x);
    }
    for _ in 0..k {
        let smallest = queue.pop().unwrap();
        queue.push(smallest + 1);
    }
    let mut product = 1;
    while let Some(x) = queue.pop() {
        product = product * x % 1000000007;
    }
    product
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 2233;
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..20000 {
        nums.push(wide_random(mut seed) % 1000001);
    }
    let mut check = 0;
    for _ in 0..150 {
        // punch: one number drawn again before each pass
        let at = next_random(mut seed) % 20000;
        nums[at] = wide_random(mut seed) % 1000001;
        check = (check * 31 + maximum_product(nums, 50000)) % 1000000007;
    }
    println(f"150 passes over 20000 numbers, k = 50000: checksum {check}");
}
