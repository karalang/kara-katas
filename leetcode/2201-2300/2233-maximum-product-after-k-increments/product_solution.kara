// LeetCode #2233: Maximum Product After K Increments -- LeetCode's Rust
// template: `Vec<i32>` and `i32` in and out, a `BinaryHeap<Reverse<i64>>`
// `collect`ed from `nums.into_iter().map(|x| Reverse(x as i64))`, each
// increment popped as `let Reverse(x) = heap.pop().unwrap()` and pushed
// back as `Reverse(x + 1)`, and the product a `fold` over
// `heap.into_iter()` with the pattern `|acc, Reverse(x)|` and the
// modulus `1_000_000_007i64`. Carried by `karac fix`. The adapter below
// hands the harness's values to it.

import std.cmp.Reverse;

impl Solution {
    pub fn maximum_product(nums: Vec[i32], k: i32) -> i32 {
        let mut heap: PriorityQueue[Reverse[i64]] = PriorityQueue.max_first_from(nums.clone().into_iter().map(|x| Reverse { value: x as i64 }).collect());
        for _ in 0..k {
            let Reverse { value: x } = heap.pop().unwrap();
            heap.push(Reverse { value: x + 1 });
        }
        let m = 1_000_000_007;
        heap.into_iter().fold(1, |acc, Reverse { value: x }| acc * x % m) as i32
    }
}

struct Solution {}

fn maximum_product(nums: Vec[i64], k: i64) -> i64 {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.maximum_product(nums, k as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn show(nums: Vec[i64], k: i64) {
    println(f"{nums}, k = {k} -> {maximum_product(nums, k)}");
}

fn main() {
    // LeetCode's two examples, then five more: one number, two zeros and
    // one increment, increments enough to level everything, a product
    // past the modulus, and all equal
    show([0, 4], 5);
    show([6, 3, 3, 2], 2);
    show([0], 1);
    show([0, 0], 1);
    show([1, 2, 3, 4], 10);
    show([1000000, 999999, 999998], 3);
    show([5, 5, 5], 4);
    // 3000 random cases of 1 to 20 numbers of up to 10, 1000 and 10^6 in
    // turn, k from 1 to 100
    let mut seed = 2233;
    let mut check = 0;
    for c in 0..3000 {
        let n = next_random(mut seed) % 20 + 1;
        let top = [10, 1000, 1000000][c % 3];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(wide_random(mut seed) % (top + 1));
        }
        let k = next_random(mut seed) % 100 + 1;
        check = (check * 31 + maximum_product(nums, k)) % 1000000007;
    }
    println(f"3000 cases: checksum {check}");
    // the constraints' largest: 10^5 numbers of up to 10^6, k = 10^5;
    // then 10^5 numbers of up to 10, so that the increments level them
    for top in [1000000, 10] {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            nums.push(wide_random(mut seed) % (top + 1));
        }
        println(f"10^5 numbers of up to {top}, k = 10^5: {maximum_product(nums, 100000)}");
    }
}
