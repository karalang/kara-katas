// LeetCode #2233: Maximum Product After K Increments -- the
// differential. The six arms, against the statement read literally:
// every way of sharing the k increments among the numbers tried, each
// product taken, and the largest; no heap and no levelling. The cases
// are small enough that no product reaches 10^9 + 7, so the remainder
// is the product itself. 300 random cases of 1 to 4 numbers of up to 6,
// k from 1 to 6; then 30 of 5 numbers of up to 10, k from 1 to 8; then
// 30 of zeros only, k from 1 to 5, where too few increments leave a
// zero. Every case is drawn before any arm answers.
//
// P1  the answer is the largest product, read literally
// P2  the answer is at least the product with all k increments given
//     to one smallest number, and below 10^9 + 7
// P3  the numbers reversed: the same answer
// P4  one increment more: no smaller answer
// P5  a 1 appended to the numbers: no smaller answer
// P6  each arm agrees with at least three of the other five

import std.cmp.Reverse;

// ---- product.kara: the ★ arm, a min-heap raising its smallest k times
fn star_maximum_product(nums: Vec[i64], k: i64) -> i64 {
    let mut queue: PriorityQueue[i64] = PriorityQueue.new();
    for x in nums.iter() {
        queue.push(x);
    }
    for _ in 0..k {
        let smallest = queue.pop().unwrap();
        queue.push(smallest + 1);
    }
    let mut product = 1;
    while let Some(x) = queue.pop() {
        product = product * x % 1000000007;
    }
    product
}

// ---- product_sorted.kara: the smallest numbers levelled up, sorted
fn sorted_maximum_product(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    let mut left = k;
    // the first `i` numbers all stand at `level`
    let mut i = 1;
    let mut level = sorted[0];
    while i < n and left >= (sorted[i] - level) * i {
        left -= (sorted[i] - level) * i;
        level = sorted[i];
        i += 1;
    }
    let mut product = 1;
    for j in 0..n {
        let value = if j < i {
            level + left / i + if j < left % i { 1 } else { 0 }
        } else {
            sorted[j]
        };
        product = product * value % 1000000007;
    }
    product
}

// ---- product_buckets.kara: a count per value, moved up a bucket at a time
fn buckets_power(base: i64, exponent: i64) -> i64 {
    let mut result = 1;
    let mut b = base % 1000000007;
    let mut e = exponent;
    while e > 0 {
        if e % 2 == 1 {
            result = result * b % 1000000007;
        }
        b = b * b % 1000000007;
        e /= 2;
    }
    result
}

fn buckets_maximum_product(nums: Vec[i64], k: i64) -> i64 {
    let mut largest = 0;
    for x in nums.iter() {
        largest = largest.max(x);
    }
    let mut count = Vec.filled(largest + k + 2, 0);
    for x in nums.iter() {
        count[x] += 1;
    }
    let mut left = k;
    let mut v = 0;
    while left > 0 {
        if count[v] > 0 {
            let moving = count[v].min(left);
            count[v] -= moving;
            count[v + 1] += moving;
            left -= moving;
        }
        v += 1;
    }
    let mut product = 1;
    for value in 0..count.len() {
        if count[value] > 0 {
            product = product * buckets_power(value, count[value]) % 1000000007;
        }
    }
    product
}

// ---- product_struct.kara: `Increments`, `raise_smallest` and `product`
struct Increments {
    queue: PriorityQueue[i64],
}

impl Increments {
    fn new(nums: Vec[i64]) -> Increments {
        let mut queue: PriorityQueue[i64] = PriorityQueue.new();
        for x in nums.iter() {
            queue.push(x);
        }
        Increments { queue: queue }
    }

    fn raise_smallest(mut ref self) {
        let smallest = self.queue.pop().unwrap();
        self.queue.push(smallest + 1);
    }

    fn product(mut ref self) -> i64 {
        let mut product = 1;
        while let Some(x) = self.queue.pop() {
            product = product * x % 1000000007;
        }
        product
    }
}

fn struct_maximum_product(nums: Vec[i64], k: i64) -> i64 {
    let mut increments = Increments.new(nums);
    for _ in 0..k {
        increments.raise_smallest();
    }
    increments.product()
}

// ---- product_iter.kara: the level found by binary search, then `fold`
fn iter_maximum_product(nums: Vec[i64], k: i64) -> i64 {
    let cost = |m: i64| nums.iter().map(|x| (m - x).max(0)).sum();
    let mut low = nums.iter().min().unwrap();
    let mut high = low + k;
    while low < high {
        let m = (low + high + 1) / 2;
        if cost(m) <= k {
            low = m;
        } else {
            high = m - 1;
        }
    }
    let mut spare = k - cost(low);
    let raised: Vec[i64] = nums.iter().map(|x| x.max(low)).collect();
    raised.iter().fold(1, |product, value| {
        let lifted = if value == low and spare > 0 {
            spare -= 1;
            value + 1
        } else {
            value
        };
        product * lifted % 1000000007
    })
}

// ---- product_solution.kara: LeetCode's Rust template, carried by `karac fix`

impl Solution {
    pub fn maximum_product(nums: Vec[i32], k: i32) -> i32 {
        let mut heap: PriorityQueue[Reverse[i64]] = PriorityQueue.max_first_from(nums.clone().into_iter().map(|x| Reverse { value: x as i64 }).collect());
        for _ in 0..k {
            let Reverse { value: x } = heap.pop().unwrap();
            heap.push(Reverse { value: x + 1 });
        }
        let m = 1_000_000_007;
        heap.into_iter().fold(1, |acc, Reverse { value: x }| acc * x % m) as i32
    }
}

struct Solution {}

fn solution_maximum_product(nums: Vec[i64], k: i64) -> i64 {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.maximum_product(nums, k as i32)
}

// ---- the statement read literally

// the largest product when the increments `left` are shared among the
// numbers from `at` on, `so_far` the product of those before
fn literal_best(nums: Vec[i64], at: i64, left: i64, so_far: i64) -> i64 {
    if at == nums.len() - 1 {
        return so_far * (nums[at] + left);
    }
    let mut best = -1;
    for give in 0..=left {
        best = best.max(literal_best(nums, at + 1, left - give, so_far * (nums[at] + give)));
    }
    best
}

fn literal(nums: Vec[i64], k: i64) -> i64 {
    literal_best(nums, 0, k, 1)
}

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_maximum_product(nums, k),
        1 => sorted_maximum_product(nums, k),
        2 => buckets_maximum_product(nums, k),
        3 => struct_maximum_product(nums, k),
        4 => iter_maximum_product(nums, k),
        _ => solution_maximum_product(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "sorted", "buckets", "struct", "iter", "solution"];
    let mut seed = 2233;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for c in 0..360 {
        let (n, top, most) = if c < 300 {
            (next_random(mut seed) % 4 + 1, 6, 6)
        } else if c < 330 {
            (5, 10, 8)
        } else {
            (next_random(mut seed) % 5 + 1, 0, 5)
        };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % (top + 1));
        }
        let k = next_random(mut seed) % most + 1;
        cases.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (nums, k) in cases.iter() {
        let truth = literal(nums, k);
        check = (check * 31 + truth) % 1000000007;
        let mut lifted = nums.clone();
        let mut smallest = 0;
        for j in 0..lifted.len() {
            if lifted[j] < lifted[smallest] {
                smallest = j;
            }
        }
        lifted[smallest] += k;
        let floor = lifted.iter().fold(1, |p, x| p * x);
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let mut longer = nums.clone();
        longer.push(1);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                value >= floor and value < 1000000007,
                answer(arm, reversed, k) == value,
                answer(arm, nums, k + 1) >= value,
                answer(arm, longer, k) >= value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums}, k = {k} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
