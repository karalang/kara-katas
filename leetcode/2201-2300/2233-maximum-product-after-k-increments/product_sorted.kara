// LeetCode #2233: Maximum Product After K Increments -- sorted, the
// increments fill the smallest numbers up level by level: the first i,
// all at one level, rise together to the next number's value while the
// increments last; what is left then spreads over those i as evenly as
// it goes, k / i each and one more for k % i of them. O(n log n).

fn maximum_product(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    let mut left = k;
    // the first `i` numbers all stand at `level`
    let mut i = 1;
    let mut level = sorted[0];
    while i < n and left >= (sorted[i] - level) * i {
        left -= (sorted[i] - level) * i;
        level = sorted[i];
        i += 1;
    }
    let mut product = 1;
    for j in 0..n {
        let value = if j < i {
            level + left / i + if j < left % i { 1 } else { 0 }
        } else {
            sorted[j]
        };
        product = product * value % 1000000007;
    }
    product
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn show(nums: Vec[i64], k: i64) {
    println(f"{nums}, k = {k} -> {maximum_product(nums, k)}");
}

fn main() {
    // LeetCode's two examples, then five more: one number, two zeros and
    // one increment, increments enough to level everything, a product
    // past the modulus, and all equal
    show([0, 4], 5);
    show([6, 3, 3, 2], 2);
    show([0], 1);
    show([0, 0], 1);
    show([1, 2, 3, 4], 10);
    show([1000000, 999999, 999998], 3);
    show([5, 5, 5], 4);
    // 3000 random cases of 1 to 20 numbers of up to 10, 1000 and 10^6 in
    // turn, k from 1 to 100
    let mut seed = 2233;
    let mut check = 0;
    for c in 0..3000 {
        let n = next_random(mut seed) % 20 + 1;
        let top = [10, 1000, 1000000][c % 3];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(wide_random(mut seed) % (top + 1));
        }
        let k = next_random(mut seed) % 100 + 1;
        check = (check * 31 + maximum_product(nums, k)) % 1000000007;
    }
    println(f"3000 cases: checksum {check}");
    // the constraints' largest: 10^5 numbers of up to 10^6, k = 10^5;
    // then 10^5 numbers of up to 10, so that the increments level them
    for top in [1000000, 10] {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            nums.push(wide_random(mut seed) % (top + 1));
        }
        println(f"10^5 numbers of up to {top}, k = 10^5: {maximum_product(nums, 100000)}");
    }
}
