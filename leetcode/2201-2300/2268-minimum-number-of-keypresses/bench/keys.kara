// LeetCode #2268: Minimum Number of Keypresses -- the ★ arm. Each letter
// costs its count times the presses of its place on its button, and the
// nine buttons give nine first places, nine second and eight third. So
// the counts sorted from the largest take the places in order: the i-th
// costs `i / 9 + 1` presses. O(n + 26 log 26).

fn minimum_keypresses(s: String) -> i64 {
    let mut count = Vec.filled(26, 0);
    for b in s.bytes() {
        count[b - b'a'] += 1;
    }
    count.sort_by(|a, b| b.cmp(a));
    let mut total = 0;
    for (i, c) in count.iter().enumerate() {
        total += c * (i / 9 + 1);
    }
    total
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 40 strings of the constraints' longest, 10^5 letters, from the first
    // 3, 10, 12 and 26 letters in turn
    let mut seed = 2268;
    let mut check = 0;
    for t in 0..40 {
        let k = [3, 10, 12, 26][t % 4];
        let mut s = String.new();
        for _ in 0..100000 {
            s.push((b'a' + (next_random(mut seed) % k) as u8) as char);
        }
        check = (check * 31 + minimum_keypresses(s)) % 1000000007;
    }
    println(f"40 strings of 10^5: checksum {check}");
}
