// LeetCode #2211: Count Collisions on a Road -- the stack arm: the cars
// pushed onto a `Vec` as a stack of what is left on the road so far;
// a left-mover pops the right-movers it meets, turning them into one
// still wreck, and a still car does the same to the right-movers before
// it. O(n).

fn count_collisions(directions: String) -> i64 {
    let mut road: Vec[char] = Vec.new();
    let mut total = 0;
    for car in directions.chars() {
        let mut car = car;
        if car == 'L' and road.len() > 0 and road[road.len() - 1] != 'L' {
            // a right-mover just before it hits head on; a wreck takes it
            total += if road[road.len() - 1] == 'R' { 2 } else { 1 };
            road.pop();
            car = 'S';
        }
        if car == 'S' {
            while road.len() > 0 and road[road.len() - 1] == 'R' {
                road.pop();
                total += 1;
            }
        }
        road.push(car);
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_road(n: i64, seed: mut ref i64) -> String {
    let mut road = String.new();
    for _ in 0..n {
        road.push(['L', 'R', 'S'][next_random(mut seed) % 3]);
    }
    road
}

fn show(directions: String) {
    println(f"\"{directions}\" -> {count_collisions(directions)}");
}

fn main() {
    // LeetCode's two examples, then four more: one car, every car still,
    // two cars head on, and a column of cars running into a still one
    show("RLRSLL");
    show("LLRR");
    show("S");
    show("SSSS");
    show("RL");
    show("RRRRS");
    // 3000 random roads of 1 to 30 cars
    let mut seed = 2211;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 30 + 1;
        check = (check * 31 + count_collisions(random_road(n, mut seed))) % 1000000007;
    }
    println(f"3000 roads: checksum {check}");
    // the constraints' longest: 10^5 random cars, then 10^5 cars all
    // driving right into one still car at the end
    let wide = random_road(100000, mut seed);
    let mut column = String.new();
    for _ in 0..99999 {
        column.push('R');
    }
    column.push('S');
    println(f"10^5 random -> {count_collisions(wide)}, 10^5 into a still car -> {count_collisions(column)}");
}
