// LeetCode #2296: Design a Text Editor -- the gap-buffer arm. `struct
// GapBuffer` keeps the text in one `Vec[char]` with a gap at the cursor,
// `buf[start..end]`. Adding fills the gap from the left, doubling the
// buffer when the gap closes; deleting widens it; a move copies letters
// across it. O(k) per call, amortized.

struct GapBuffer {
    buf: Vec[char],
    start: i64,
    end: i64,
}

impl GapBuffer {
    fn new() -> GapBuffer {
        GapBuffer { buf: Vec.filled(16, ' '), start: 0, end: 16 }
    }

    // a buffer twice the size, the letters after the gap moved to its end
    fn grow(mut ref self) {
        let size = self.buf.len() * 2;
        let after = self.buf.len() - self.end;
        let mut bigger: Vec[char] = Vec.filled(size, ' ');
        for i in 0..self.start {
            bigger[i] = self.buf[i];
        }
        for i in 0..after {
            bigger[size - after + i] = self.buf[self.end + i];
        }
        self.buf = bigger;
        self.end = size - after;
    }

    fn add_text(mut ref self, text: Str) {
        for c in text.chars() {
            if self.start == self.end {
                self.grow();
            }
            self.buf[self.start] = c;
            self.start += 1;
        }
    }

    fn delete_text(mut ref self, k: i64) -> i64 {
        let n = k.min(self.start);
        self.start -= n;
        n
    }

    fn cursor_left(mut ref self, k: i64) -> String {
        for _ in 0..k.min(self.start) {
            self.start -= 1;
            self.end -= 1;
            self.buf[self.end] = self.buf[self.start];
        }
        self.tail()
    }

    fn cursor_right(mut ref self, k: i64) -> String {
        for _ in 0..k.min(self.buf.len() - self.end) {
            self.buf[self.start] = self.buf[self.end];
            self.start += 1;
            self.end += 1;
        }
        self.tail()
    }

    fn tail(self) -> String {
        self.buf[self.start - self.start.min(10)..self.start].iter().collect()
    }
}

fn run(calls: Vec[(i64, i64, String)]) -> Vec[String] {
    let mut editor = GapBuffer.new();
    let mut answers: Vec[String] = Vec.new();
    for (kind, k, text) in calls.iter() {
        match kind {
            0 => editor.add_text(text),
            1 => answers.push(f"{editor.delete_text(k)}"),
            2 => answers.push(editor.cursor_left(k)),
            _ => answers.push(editor.cursor_right(k)),
        }
    }
    answers
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a call is (kind, k, text): 0 addText(text), 1 deleteText(k),
// 2 cursorLeft(k), 3 cursorRight(k). Texts of 1 to 40 lowercase
// letters and `k` from 1 to 40, as the constraints allow
fn calls_of(count: i64, seed: mut ref i64) -> Vec[(i64, i64, String)] {
    let mut calls: Vec[(i64, i64, String)] = Vec.new();
    for _ in 0..count {
        let kind = next_random(mut seed) % 4;
        let k = next_random(mut seed) % 40 + 1;
        let mut text = String.new();
        if kind == 0 {
            for _ in 0..k {
                text.push((b'a' + (next_random(mut seed) % 26) as u8) as char);
            }
        }
        calls.push((kind, k, text));
    }
    calls
}

fn tally(answers: Vec[String], check: i64) -> i64 {
    let mut c = check;
    for answer in answers.iter() {
        for b in answer.bytes() {
            c = (c * 131 + b) % 1000000007;
        }
        c = (c * 131 + 1) % 1000000007;
    }
    c
}

fn main() {
    // LeetCode's example; then a delete and a move past either end, a
    // text typed into the middle, and a long text whose tail is ten
    // letters
    let examples: Vec[Vec[(i64, i64, String)]] = [
        [(0, 0, "leetcode"), (1, 4, ""), (0, 0, "practice"), (3, 3, ""), (2, 8, ""), (1, 10, ""), (2, 2, ""), (3, 6, "")].to_vec(),
        [(1, 5, ""), (2, 3, ""), (3, 3, ""), (0, 0, "ab"), (1, 40, ""), (2, 1, ""), (3, 1, "")].to_vec(),
        [(0, 0, "hello"), (2, 2, ""), (0, 0, "XYZ"), (3, 40, ""), (2, 4, ""), (1, 2, ""), (3, 1, "")].to_vec(),
        [(0, 0, "abcdefghijklmnopqrstuvwxyz"), (2, 3, ""), (3, 2, ""), (2, 40, ""), (3, 13, ""), (1, 13, ""), (3, 40, "")].to_vec(),
    ].to_vec();
    for calls in examples.iter() {
        println(run(calls).join("|"));
    }
    // 3000 editors of 1 to 30 calls
    let mut seed = 2296;
    let mut answered = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let count = next_random(mut seed) % 30 + 1;
        let answers = run(calls_of(count, mut seed));
        answered += answers.len();
        check = tally(answers, check);
    }
    println(f"3000 small editors: {answered} answers, checksum {check}");
    // 5 editors of 2 * 10^4 calls, as many as the constraints allow
    answered = 0;
    check = 0;
    for _ in 0..5 {
        let answers = run(calls_of(20000, mut seed));
        answered += answers.len();
        check = tally(answers, check);
    }
    println(f"5 editors of 2 * 10^4 calls: {answered} answers, checksum {check}");
}
