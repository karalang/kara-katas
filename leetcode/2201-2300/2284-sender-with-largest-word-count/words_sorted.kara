// LeetCode #2284: Sender With Largest Word Count -- the sorted arm. Pair
// each sender with its message's word count, sort the pairs by sender,
// and total each run of one sender. Runs come in name order, so a later
// run that ties wins. O(n log n).

fn largest_word_count(messages: Vec[String], senders: Vec[String]) -> String {
    let mut pairs: Vec[(String, i64)] = Vec.new();
    for i in 0..senders.len() {
        pairs.push((senders[i].clone(), messages[i].split(" ").count()));
    }
    pairs.sort_by(|a, b| a.0.cmp(b.0));
    let mut best = String.new();
    let mut most = 0;
    let mut i = 0;
    while i < pairs.len() {
        let mut total = 0;
        let mut j = i;
        while j < pairs.len() and pairs[j].0 == pairs[i].0 {
            total += pairs[j].1;
            j += 1;
        }
        if total >= most {
            best = pairs[i].0.clone();
            most = total;
        }
        i = j;
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then a tie broken by case, a tie broken by
    // a prefix, and one sender
    let cases = [
        (
            ["Hello userTwooo", "Hi userThree", "Wonderful day Alice", "Nice day userThree"],
            ["Alice", "userTwo", "userThree", "Alice"],
        ),
        (["How is leetcode for everyone", "Leetcode is useful for practice"], ["Bob", "Charlie"]),
        (["a b", "c d"], ["bob", "Bob"]),
        (["x y z", "x y", "q"], ["Alice", "Al", "Al"]),
        (["one"], ["Z"]),
    ];
    for (messages, senders) in cases.iter() {
        let m: Vec[String] = messages.iter().map(|s| s.to_string()).collect();
        let s: Vec[String] = senders.iter().map(|s| s.to_string()).collect();
        println(f"{senders} -> {largest_word_count(m, s)}");
    }
    // 3000 cases of 1 to 40 messages, each from one of the first 2 to 8
    // names of the pool, of 1 to 6 words of 1 to 3 letters
    let pool = ["Al", "al", "Alice", "alice", "B", "b", "Bo", "Zed", "zed", "ZED"];
    let mut seed = 2284;
    let mut check = 0;
    let mut first = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 40 + 1;
        let k = next_random(mut seed) % 7 + 2;
        let mut messages: Vec[String] = Vec.new();
        let mut senders: Vec[String] = Vec.new();
        for _ in 0..n {
            senders.push(pool[next_random(mut seed) % k].to_string());
            let w = next_random(mut seed) % 6 + 1;
            let mut message = String.new();
            for j in 0..w {
                if j > 0 {
                    message.push(' ');
                }
                let len = next_random(mut seed) % 3 + 1;
                for _ in 0..len {
                    message.push((b'a' + (next_random(mut seed) % 26) as u8) as char);
                }
            }
            messages.push(message);
        }
        let answer = largest_word_count(messages, senders);
        let mut at = 0;
        for (i, name) in pool.iter().enumerate() {
            if name == answer {
                at = i + 1;
            }
        }
        check = (check * 31 + at) % 1000000007;
        if at == 1 {
            first += 1;
        }
    }
    println(f"3000 cases: checksum {check}, {first} won by Al");
}
