// LeetCode #2227: Encrypt and Decrypt Strings -- the differential. The
// six arms, against the statement read literally: a letter encrypted by
// finding its place among the keys, and a string decrypted by trying
// every key whose value is each pair in turn, every decryption written
// out, and those in the dictionary counted; nothing kept ahead. 300
// random cases of 1 to 8 keys, values of 2 and 3 letters, up to 8 words
// of 1 to 4 letters and 12 calls; then 30 with every value the same;
// then 30 with values of all 26 letters, so that they seldom repeat.
// Every case is drawn before any arm answers.
//
// P1  the answers are the statement read literally
// P2  each encryption "" or twice as long as its word, each count from
//     0 to the size of the dictionary
// P3  the dictionary reversed: the same answers
// P4  each dictionary word's encryption, unless "", decrypts to at
//     least 1, and the counts of the distinct encryptions add up to the
//     words that encrypt
// P5  one more word in the dictionary: each count the same, or one more
//     exactly where the string is that word's encryption
// P6  each arm agrees with at least three of the other five


// ---- encrypter.kara: the ★ arm, a `Map` of values and a `Map` counting the dictionary's encryptions
struct StarEncrypter {
    table: Map[char, String],
    counts: Map[String, i64],
}

impl StarEncrypter {
    fn new(keys: Vec[char], values: Vec[String], dictionary: Vec[String]) -> StarEncrypter {
        let mut table: Map[char, String] = Map.new();
        for i in 0..keys.len() {
            table.insert(keys[i], values[i].clone());
        }
        let mut encrypter = StarEncrypter { table: table, counts: Map.new() };
        for word in dictionary.iter() {
            let secret = encrypter.encrypt(word);
            if not secret.is_empty() {
                let before = encrypter.counts.get(secret).unwrap_or(0);
                encrypter.counts.insert(secret, before + 1);
            }
        }
        encrypter
    }

    // "" when a letter is no key
    fn encrypt(self, word1: String) -> String {
        let mut secret = String.new();
        for c in word1.chars() {
            match self.table.get(c) {
                Some(value) => secret.push_str(value),
                None => return String.new(),
            }
        }
        secret
    }

    fn decrypt(self, word2: String) -> i64 {
        self.counts.get(word2).unwrap_or(0)
    }
}

// the answers of `calls` on a new `StarEncrypter`, each an encryption (true)
// or a decryption, its count written out
fn star_replay(keys: Vec[char], values: Vec[String], dictionary: Vec[String], calls: Vec[(bool, String)]) -> Vec[String] {
    let encrypter = StarEncrypter.new(keys, values, dictionary);
    let mut answers: Vec[String] = Vec.new();
    for (encrypting, word) in calls.iter() {
        if encrypting {
            answers.push(encrypter.encrypt(word));
        } else {
            answers.push(f"{encrypter.decrypt(word)}");
        }
    }
    answers
}

// ---- encrypter_array.kara: the values in a `Vec` of 26, the words read as bytes
struct ArrayEncrypter {
    table: Vec[String],
    counts: Map[String, i64],
}

impl ArrayEncrypter {
    fn new(keys: Vec[char], values: Vec[String], dictionary: Vec[String]) -> ArrayEncrypter {
        let mut table = Vec.filled(26, String.new());
        for i in 0..keys.len() {
            table[(keys[i] as i64) - 97] = values[i].clone();
        }
        let mut encrypter = ArrayEncrypter { table: table, counts: Map.new() };
        for word in dictionary.iter() {
            let secret = encrypter.encrypt(word);
            if secret.len() > 0 {
                encrypter.counts.insert(secret.clone(), encrypter.decrypt(secret) + 1);
            }
        }
        encrypter
    }

    fn encrypt(self, word1: String) -> String {
        let mut secret = String.new();
        for b in word1.bytes() {
            let value = ref self.table[(b as i64) - 97];
            if value.is_empty() {
                return String.new();
            }
            secret.push_str(value);
        }
        secret
    }

    fn decrypt(self, word2: String) -> i64 {
        self.counts.get(word2).unwrap_or(0)
    }
}

// the answers of `calls` on a new `ArrayEncrypter`, each an encryption (true)
// or a decryption, its count written out
fn array_replay(keys: Vec[char], values: Vec[String], dictionary: Vec[String], calls: Vec[(bool, String)]) -> Vec[String] {
    let encrypter = ArrayEncrypter.new(keys, values, dictionary);
    let mut answers: Vec[String] = Vec.new();
    for (encrypting, word) in calls.iter() {
        if encrypting {
            answers.push(encrypter.encrypt(word));
        } else {
            answers.push(f"{encrypter.decrypt(word)}");
        }
    }
    answers
}

// ---- encrypter_trie.kara: the dictionary as a trie, the string walked a pair at a time
#[derive(Clone)]
struct TrieNode {
    next: Vec[i64],
    ends: bool,
}

struct TrieEncrypter {
    table: Map[char, String],
    keys_of: Map[String, Vec[char]],
    trie: Vec[TrieNode],
}

impl TrieEncrypter {
    fn new(keys: Vec[char], values: Vec[String], dictionary: Vec[String]) -> TrieEncrypter {
        let mut table: Map[char, String] = Map.new();
        let mut keys_of: Map[String, Vec[char]] = Map.new();
        for i in 0..keys.len() {
            table.insert(keys[i], values[i].clone());
            let mut those = keys_of.get(values[i]).cloned().unwrap_or(Vec.new());
            those.push(keys[i]);
            keys_of.insert(values[i].clone(), those.clone());
        }
        let mut trie = [TrieNode { next: Vec.filled(26, -1), ends: false }].to_vec();
        for word in dictionary.iter() {
            let mut at = 0;
            for b in word.bytes() {
                let letter = (b as i64) - 97;
                if trie[at].next[letter] < 0 {
                    trie[at].next[letter] = trie.len();
                    trie.push(TrieNode { next: Vec.filled(26, -1), ends: false });
                }
                at = trie[at].next[letter];
            }
            trie[at].ends = true;
        }
        TrieEncrypter { table: table, keys_of: keys_of, trie: trie }
    }

    fn encrypt(self, word1: String) -> String {
        let mut secret = String.new();
        for c in word1.chars() {
            match self.table.get(c) {
                Some(value) => secret.push_str(value),
                None => return String.new(),
            }
        }
        secret
    }

    // the words below trie node `at` that the rest of `pairs`, from
    // `from` on, decrypts to
    fn walk(self, pairs: Vec[String], from: i64, at: i64) -> i64 {
        if from == pairs.len() {
            return if self.trie[at].ends { 1 } else { 0 };
        }
        let mut found = 0;
        if let Some(keys) = self.keys_of.get(pairs[from]) {
            for key in keys.iter() {
                let child = self.trie[at].next[(key as i64) - 97];
                if child >= 0 {
                    found += self.walk(pairs, from + 1, child);
                }
            }
        }
        found
    }

    fn decrypt(self, word2: String) -> i64 {
        let letters: Vec[char] = word2.chars().collect();
        let mut pairs: Vec[String] = Vec.new();
        for i in (0..letters.len()).step_by(2) {
            pairs.push(f"{letters[i]}{letters[i + 1]}");
        }
        self.walk(pairs, 0, 0)
    }
}

// the answers of `calls` on a new `TrieEncrypter`, each an encryption (true)
// or a decryption, its count written out
fn trie_replay(keys: Vec[char], values: Vec[String], dictionary: Vec[String], calls: Vec[(bool, String)]) -> Vec[String] {
    let encrypter = TrieEncrypter.new(keys, values, dictionary);
    let mut answers: Vec[String] = Vec.new();
    for (encrypting, word) in calls.iter() {
        if encrypting {
            answers.push(encrypter.encrypt(word));
        } else {
            answers.push(f"{encrypter.decrypt(word)}");
        }
    }
    answers
}

// ---- encrypter_scan.kara: every dictionary word encrypted again at each decryption
struct ScanEncrypter {
    table: Map[char, String],
    dictionary: Vec[String],
}

impl ScanEncrypter {
    fn new(keys: Vec[char], values: Vec[String], dictionary: Vec[String]) -> ScanEncrypter {
        let mut table: Map[char, String] = Map.new();
        for i in 0..keys.len() {
            table.insert(keys[i], values[i].clone());
        }
        ScanEncrypter { table: table, dictionary: dictionary.clone() }
    }

    fn encrypt(self, word1: String) -> String {
        let mut secret = String.new();
        for c in word1.chars() {
            match self.table.get(c) {
                Some(value) => secret.push_str(value),
                None => return String.new(),
            }
        }
        secret
    }

    fn decrypt(self, word2: String) -> i64 {
        let mut found = 0;
        for word in self.dictionary.iter() {
            if self.encrypt(word) == word2 {
                found += 1;
            }
        }
        found
    }
}

// the answers of `calls` on a new `ScanEncrypter`, each an encryption (true)
// or a decryption, its count written out
fn scan_replay(keys: Vec[char], values: Vec[String], dictionary: Vec[String], calls: Vec[(bool, String)]) -> Vec[String] {
    let encrypter = ScanEncrypter.new(keys, values, dictionary);
    let mut answers: Vec[String] = Vec.new();
    for (encrypting, word) in calls.iter() {
        if encrypting {
            answers.push(encrypter.encrypt(word));
        } else {
            answers.push(f"{encrypter.decrypt(word)}");
        }
    }
    answers
}

// ---- encrypter_iter.kara: `zip`, `all`, `map` and `join`, the counts a `fold`
struct IterEncrypter {
    table: Map[char, String],
    counts: Map[String, i64],
}

impl IterEncrypter {
    fn new(keys: Vec[char], values: Vec[String], dictionary: Vec[String]) -> IterEncrypter {
        let table: Map[char, String] = keys.iter().zip(values.iter().cloned()).collect();
        let mut encrypter = IterEncrypter { table: table, counts: Map.new() };
        let secrets: Vec[String] = dictionary.iter().map(|word| encrypter.encrypt(word)).filter(|s| not s.is_empty()).collect();
        encrypter.counts = secrets.iter().fold(Map.new(), |counts: own Map[String, i64], secret| {
            let mut counts = counts;
            let before = counts.get(secret).unwrap_or(0);
            counts.insert(secret.clone(), before + 1);
            counts
        });
        encrypter
    }

    fn encrypt(self, word1: String) -> String {
        if word1.chars().all(|c| self.table.contains_key(c)) {
            let parts: Vec[String] = word1.chars().map(|c| self.table[c].clone()).collect();
            parts.join("")
        } else {
            String.new()
        }
    }

    fn decrypt(self, word2: String) -> i64 {
        self.counts.get(word2).unwrap_or(0)
    }
}

// the answers of `calls` on a new `IterEncrypter`, each an encryption (true)
// or a decryption, its count written out
fn iter_replay(keys: Vec[char], values: Vec[String], dictionary: Vec[String], calls: Vec[(bool, String)]) -> Vec[String] {
    let encrypter = IterEncrypter.new(keys, values, dictionary);
    let mut answers: Vec[String] = Vec.new();
    for (encrypting, word) in calls.iter() {
        if encrypting {
            answers.push(encrypter.encrypt(word));
        } else {
            answers.push(f"{encrypter.decrypt(word)}");
        }
    }
    answers
}

// ---- encrypter_solution.kara: LeetCode's Rust template, carried by `karac fix`
struct SolutionEncrypter {
    map: Map[char, String],
    count: Map[String, i32],
}

impl SolutionEncrypter {
    fn new(keys: Vec[char], values: Vec[String], dictionary: Vec[String]) -> Self {
        let mut map = Map.new();
        for (k, v) in keys.clone().into_iter().zip(values.clone().into_iter()) {
            map.insert(k, v);
        }
        let mut e = SolutionEncrypter { map, count: Map.new() };
        for w in dictionary {
            let s = e.encrypt(w);
            if not s.is_empty() {
                *e.count.entry(s).or_insert(0) += 1;
            }
        }
        e
    }

    fn encrypt(self, word1: String) -> String {
        let mut res = String.new();
        for c in word1.chars() {
            match self.map.get(c) {
                Some(v) => res.push_str(v),
                None => return String.new(),
            }
        }
        res
    }

    fn decrypt(self, word2: String) -> i32 {
        *self.count.get(word2).unwrap_or(0)
    }
}

// the answers of `calls` on a new `SolutionEncrypter`, each an encryption (true)
// or a decryption, its count written out
fn solution_replay(keys: Vec[char], values: Vec[String], dictionary: Vec[String], calls: Vec[(bool, String)]) -> Vec[String] {
    let encrypter = SolutionEncrypter.new(keys, values, dictionary);
    let mut answers: Vec[String] = Vec.new();
    for (encrypting, word) in calls.iter() {
        if encrypting {
            answers.push(encrypter.encrypt(word));
        } else {
            answers.push(f"{encrypter.decrypt(word)}");
        }
    }
    answers
}

// ---- the statement read literally

fn literal_encrypt(keys: Vec[char], values: Vec[String], word1: String) -> String {
    let mut secret = String.new();
    for c in word1.chars() {
        let mut place = -1;
        for i in 0..keys.len() {
            if keys[i] == c {
                place = i;
            }
        }
        if place < 0 {
            return String.new();
        }
        secret.push_str(values[place]);
    }
    secret
}

// every string `word2` decrypts to, from pair `from` on, after `made`
fn decryptions(keys: Vec[char], values: Vec[String], word2: String, from: i64, made: own String, out: mut ref Set[String]) {
    if from * 2 == word2.len() {
        out.insert(made);
        return;
    }
    let pair = word2.substring(from * 2, from * 2 + 2);
    for i in 0..keys.len() {
        if values[i] == pair {
            decryptions(keys, values, word2, from + 1, f"{made}{keys[i]}", mut out);
        }
    }
}

fn literal(keys: Vec[char], values: Vec[String], dictionary: Vec[String], calls: Vec[(bool, String)]) -> Vec[String] {
    let mut answers: Vec[String] = Vec.new();
    for (encrypting, word) in calls.iter() {
        if encrypting {
            answers.push(literal_encrypt(keys, values, word));
        } else {
            let mut out: Set[String] = Set.new();
            decryptions(keys, values, word, 0, String.new(), mut out);
            let mut found = 0;
            for word in dictionary.iter() {
                if out.contains(word) {
                    found += 1;
                }
            }
            answers.push(f"{found}");
        }
    }
    answers
}

fn answer(arm: i64, keys: Vec[char], values: Vec[String], dictionary: Vec[String], calls: Vec[(bool, String)]) -> Vec[String] {
    match arm {
        0 => star_replay(keys, values, dictionary, calls),
        1 => array_replay(keys, values, dictionary, calls),
        2 => trie_replay(keys, values, dictionary, calls),
        3 => scan_replay(keys, values, dictionary, calls),
        4 => iter_replay(keys, values, dictionary, calls),
        _ => solution_replay(keys, values, dictionary, calls),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn draw_word(seed: mut ref i64, length: i64, letters: i64) -> String {
    let mut word = String.new();
    for _ in 0..length {
        word.push(char.try_from((97 + next_random(mut seed) % letters) as u32).ok().unwrap());
    }
    word
}

struct Case {
    keys: Vec[char],
    values: Vec[String],
    dictionary: Vec[String],
    calls: Vec[(bool, String)],
    extra: String,
}

fn main() {
    let names = ["star", "array", "trie", "scan", "iter", "solution"];
    let mut seed = 2227;
    let mut cases: Vec[Case] = Vec.new();
    for c in 0..360 {
        let m = next_random(mut seed) % 8 + 1;
        let v = if c < 300 { c % 2 + 2 } else { 26 };
        let mut keys: Vec[char] = Vec.new();
        let mut values: Vec[String] = Vec.new();
        for i in 0..m {
            keys.push(char.try_from((97 + i) as u32).ok().unwrap());
            values.push(if c >= 300 and c < 330 { "aa" } else { draw_word(mut seed, 2, v) });
        }
        let mut dictionary: Vec[String] = Vec.new();
        let mut seen: Set[String] = Set.new();
        for _ in 0..next_random(mut seed) % 8 + 1 {
            let word = draw_word(mut seed, next_random(mut seed) % 4 + 1, m + 1);
            if not seen.contains(word) {
                seen.insert(word.clone());
                dictionary.push(word);
            }
        }
        // a word of keys not in the dictionary, for P5
        let mut extra = draw_word(mut seed, next_random(mut seed) % 4 + 1, m);
        while seen.contains(extra) {
            extra = draw_word(mut seed, next_random(mut seed) % 4 + 1, m);
        }
        let mut calls: Vec[(bool, String)] = Vec.new();
        for _ in 0..12 {
            let kind = next_random(mut seed) % 4;
            let plain = if kind == 1 {
                dictionary[next_random(mut seed) % dictionary.len()].clone()
            } else if kind == 2 {
                extra.clone()
            } else {
                draw_word(mut seed, next_random(mut seed) % 4 + 1, m + 1)
            };
            if kind == 0 {
                calls.push((true, plain));
            } else {
                let mut secret = String.new();
                for ch in plain.chars() {
                    let at = (ch as i64) - 97;
                    secret.push_str(if at < m { values[at].clone() } else { draw_word(mut seed, 2, v) });
                }
                calls.push((false, secret));
            }
        }
        cases.push(Case { keys: keys, values: values, dictionary: dictionary, calls: calls, extra: extra });
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for case in cases.iter() {
        let keys = ref case.keys;
        let values = ref case.values;
        let dictionary = ref case.dictionary;
        let calls = ref case.calls;
        let truth = literal(keys, values, dictionary, calls);
        for answer in truth.iter() {
            for b in answer.bytes() {
                check = (check * 31 + b) % 1000000007;
            }
            check = (check * 31 + 7) % 1000000007;
        }
        let reversed: Vec[String] = dictionary.iter().rev().cloned().collect();
        let mut grown = dictionary.clone();
        grown.push(case.extra.clone());
        let extra_secret = literal_encrypt(keys, values, case.extra);
        let own_words: Vec[(bool, String)] = dictionary.iter().map(|w| (true, w.clone())).collect();
        let got: Vec[Vec[String]] = (0..6).map(|arm| answer(arm, keys, values, dictionary, calls)).collect();
        for arm in 0..6 {
            let answers = ref got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == answers {
                    same += 1;
                }
            }
            let mut shaped = answers.len() == calls.len();
            for i in 0..answers.len().min(calls.len()) {
                if calls[i].0 {
                    shaped = shaped and (answers[i].is_empty() or answers[i].len() == 2 * calls[i].1.len());
                } else {
                    let count = i64.parse(answers[i]).unwrap_or(-1);
                    shaped = shaped and count >= 0 and count <= dictionary.len();
                }
            }
            // P4: encrypt every word, then decrypt each distinct encryption
            let secrets = answer(arm, keys, values, dictionary, own_words);
            let mut distinct: Vec[String] = Vec.new();
            let mut encrypting = 0;
            for s in secrets.iter() {
                if not s.is_empty() {
                    encrypting += 1;
                    if not distinct.contains(s) {
                        distinct.push(s.clone());
                    }
                }
            }
            let back_calls: Vec[(bool, String)] = distinct.iter().map(|s| (false, s.clone())).collect();
            let back = answer(arm, keys, values, dictionary, back_calls);
            let mut total = 0;
            let mut each_found = true;
            for b in back.iter() {
                let count = i64.parse(b).unwrap_or(0);
                total += count;
                each_found = each_found and count >= 1;
            }
            let round_trip = each_found and total == encrypting;
            // P5: one more word
            let more = answer(arm, keys, values, grown, calls);
            let mut one_more = more.len() == answers.len();
            for i in 0..more.len().min(answers.len()) {
                if calls[i].0 {
                    one_more = one_more and more[i] == answers[i];
                } else {
                    let before = i64.parse(answers[i]).unwrap_or(-1);
                    let after = i64.parse(more[i]).unwrap_or(-1);
                    let want = if not extra_secret.is_empty() and calls[i].1 == extra_secret { before + 1 } else { before };
                    one_more = one_more and after == want;
                }
            }
            let verdicts = [
                answers == truth,
                shaped,
                answer(arm, keys, values, reversed, calls) == answers,
                round_trip,
                one_more,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"keys {keys} values {values} dictionary {dictionary} calls {calls} arm {names[arm]}: P{q + 1} fails, gave {answers}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
