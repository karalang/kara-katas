// LeetCode #2226: Maximum Candies Allocated to K Children -- `Piles`,
// holding the candies and the largest pile, with `shares` (how many
// x-sized shares the piles cut into) and `best` (the binary search for
// the largest share that still feeds k). O(n log max).

struct Piles {
    candies: Vec[i64],
    largest: i64,
}

impl Piles {
    fn new(candies: Vec[i64]) -> Piles {
        let largest = candies.iter().max().unwrap_or(0);
        Piles { candies: candies.clone(), largest: largest }
    }

    fn shares(ref self, x: i64) -> i64 {
        let mut shares = 0;
        for pile in self.candies.iter() {
            shares += pile / x;
        }
        shares
    }

    fn best(ref self, k: i64) -> i64 {
        let mut low = 0;
        let mut high = self.largest;
        while low < high {
            let x = (low + high + 1) / 2;
            if self.shares(x) >= k {
                low = x;
            } else {
                high = x - 1;
            }
        }
        low
    }
}

fn maximum_candies(candies: Vec[i64], k: i64) -> i64 {
    Piles.new(candies).best(k)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn show(candies: Vec[i64], k: i64) {
    println(f"{candies}, k = {k} -> {maximum_candies(candies, k)}");
}

fn main() {
    // LeetCode's two examples, then four more: one pile for one child,
    // the largest pile, a pile split three ways, and an answer the
    // smallest pile cannot give
    show([5, 8, 6], 3);
    show([2, 5], 11);
    show([1], 1);
    show([10000000], 1);
    show([9], 3);
    show([4, 7, 5], 4);
    // 3000 random cases of 1 to 20 piles of up to 10, 1000 and 10^7
    // candies in turn, k from 1 to a little past the candies in all
    let mut seed = 2226;
    let mut check = 0;
    for c in 0..3000 {
        let n = next_random(mut seed) % 20 + 1;
        let top = [10, 1000, 10000000][c % 3];
        let mut candies: Vec[i64] = Vec.new();
        let mut total = 0;
        for _ in 0..n {
            let pile = wide_random(mut seed) % top + 1;
            candies.push(pile);
            total += pile;
        }
        let k = wide_random(mut seed) % (total + total / 10 + 1) + 1;
        check = (check * 31 + maximum_candies(candies, k)) % 1000000007;
    }
    println(f"3000 cases: checksum {check}");
    // the constraints' largest: 10^5 piles of up to 10^7, k from 1 to 10^12
    let mut piles: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        piles.push(wide_random(mut seed) % 10000000 + 1);
    }
    for k in [1, 100000, 1000000000, 1000000000000] {
        println(f"10^5 piles, k = {k}: {maximum_candies(piles, k)}");
    }
}
