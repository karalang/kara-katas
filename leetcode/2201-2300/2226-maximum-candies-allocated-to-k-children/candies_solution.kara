// LeetCode #2226: Maximum Candies Allocated to K Children -- LeetCode's
// Rust template: `Vec<i32>` and `i64` in, `i32` out, the bounds a tuple
// with the largest pile through `*candies.iter().max().unwrap()`, the
// middle as `lo + (hi - lo + 1) / 2`, and the shares a `map(|&c| (c /
// mid) as i64).sum()` typed `i64`. Carried by `karac fix`. The adapter
// below hands the harness's values to it.

impl Solution {
    pub fn maximum_candies(candies: Vec[i32], k: i64) -> i32 {
        let mut (lo, hi) = (0i32, *candies.iter().max().unwrap());
        while lo < hi {
            let mid = lo + (hi - lo + 1) / 2;
            let cnt: i64 = candies.iter().map(|c| (c / mid) as i64).sum();
            if cnt >= k {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        lo
    }
}

struct Solution {}

fn maximum_candies(candies: Vec[i64], k: i64) -> i64 {
    let candies: Vec[i32] = candies.iter().map(|x| x as i32).collect();
    Solution.maximum_candies(candies, k)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn show(candies: Vec[i64], k: i64) {
    println(f"{candies}, k = {k} -> {maximum_candies(candies, k)}");
}

fn main() {
    // LeetCode's two examples, then four more: one pile for one child,
    // the largest pile, a pile split three ways, and an answer the
    // smallest pile cannot give
    show([5, 8, 6], 3);
    show([2, 5], 11);
    show([1], 1);
    show([10000000], 1);
    show([9], 3);
    show([4, 7, 5], 4);
    // 3000 random cases of 1 to 20 piles of up to 10, 1000 and 10^7
    // candies in turn, k from 1 to a little past the candies in all
    let mut seed = 2226;
    let mut check = 0;
    for c in 0..3000 {
        let n = next_random(mut seed) % 20 + 1;
        let top = [10, 1000, 10000000][c % 3];
        let mut candies: Vec[i64] = Vec.new();
        let mut total = 0;
        for _ in 0..n {
            let pile = wide_random(mut seed) % top + 1;
            candies.push(pile);
            total += pile;
        }
        let k = wide_random(mut seed) % (total + total / 10 + 1) + 1;
        check = (check * 31 + maximum_candies(candies, k)) % 1000000007;
    }
    println(f"3000 cases: checksum {check}");
    // the constraints' largest: 10^5 piles of up to 10^7, k from 1 to 10^12
    let mut piles: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        piles.push(wide_random(mut seed) % 10000000 + 1);
    }
    for k in [1, 100000, 1000000000, 1000000000000] {
        println(f"10^5 piles, k = {k}: {maximum_candies(piles, k)}");
    }
}
