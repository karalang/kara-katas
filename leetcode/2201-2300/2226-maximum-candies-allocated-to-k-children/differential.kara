// LeetCode #2226: Maximum Candies Allocated to K Children -- the
// differential. The six arms, against the statement read literally:
// every share size from the largest pile down tried, each pile cut by
// taking that many candies off it again and again, and the first size
// that hands k children a share is the answer, else 0; no division, no
// search. 300 random cases of 1 to 8 piles of up to 10, 50 and 200
// candies in turn, k from 1 to a little past the candies in all; then 30
// with k the candies in all; then 30 with k one. Every case is drawn
// before any arm answers.
//
// P1  the answer is the statement read literally
// P2  it is at least 0 and at most both the largest pile and the
//     candies in all over k
// P3  the piles reversed: the same answer
// P4  one more child: no more candies each
// P5  every pile doubled: twice the answer, or one more than that
// P6  each arm agrees with at least three of the other five


// ---- candies.kara: the ★ arm, a binary search on the answer
fn star_maximum_candies(candies: Vec[i64], k: i64) -> i64 {
    let mut low = 0;
    let mut high = candies.iter().max().unwrap_or(0);
    while low < high {
        let x = (low + high + 1) / 2;
        let mut shares = 0;
        for pile in candies.iter() {
            shares += pile / x;
        }
        if shares >= k {
            low = x;
        } else {
            high = x - 1;
        }
    }
    low
}

// ---- candies_bits.kara: the answer built a bit at a time from 2^23 down
fn bits_feeds(candies: Vec[i64], x: i64, k: i64) -> bool {
    let mut shares = 0;
    for pile in candies.iter() {
        shares += pile / x;
    }
    shares >= k
}

fn bits_maximum_candies(candies: Vec[i64], k: i64) -> i64 {
    let mut answer = 0;
    let mut bit = 1 << 23;
    while bit > 0 {
        if bits_feeds(candies, answer | bit, k) {
            answer |= bit;
        }
        bit >>= 1;
    }
    answer
}

// ---- candies_bound.kara: a half-open search under the tighter bound, the count stopping at k
fn bound_maximum_candies(candies: Vec[i64], k: i64) -> i64 {
    let mut largest = 0;
    let mut total = 0;
    for pile in candies.iter() {
        largest = largest.max(pile);
        total += pile;
    }
    // shares of 1 to `low - 1` all feed k; shares of `high` do not
    let mut low = 1;
    let mut high = largest.min(total / k) + 1;
    while low < high {
        let x = low + (high - low) / 2;
        let mut shares = 0;
        let mut i = 0;
        while i < candies.len() and shares < k {
            shares += candies[i] / x;
            i += 1;
        }
        if shares >= k {
            low = x + 1;
        } else {
            high = x;
        }
    }
    low - 1
}

// ---- candies_struct.kara: `Piles`, `shares` and `best`
struct Piles {
    candies: Vec[i64],
    largest: i64,
}

impl Piles {
    fn new(candies: Vec[i64]) -> Piles {
        let largest = candies.iter().max().unwrap_or(0);
        Piles { candies: candies.clone(), largest: largest }
    }

    fn shares(ref self, x: i64) -> i64 {
        let mut shares = 0;
        for pile in self.candies.iter() {
            shares += pile / x;
        }
        shares
    }

    fn best(ref self, k: i64) -> i64 {
        let mut low = 0;
        let mut high = self.largest;
        while low < high {
            let x = (low + high + 1) / 2;
            if self.shares(x) >= k {
                low = x;
            } else {
                high = x - 1;
            }
        }
        low
    }
}

fn struct_maximum_candies(candies: Vec[i64], k: i64) -> i64 {
    Piles.new(candies).best(k)
}

// ---- candies_iter.kara: a closure `feeds` over `map` and `sum`
fn iter_maximum_candies(candies: Vec[i64], k: i64) -> i64 {
    let feeds = |x: i64| candies.iter().map(|pile| pile / x).sum() >= k;
    let mut low = 0;
    let mut high = candies.iter().max().unwrap_or(0);
    while low < high {
        let x = (low + high + 1) / 2;
        if feeds(x) {
            low = x;
        } else {
            high = x - 1;
        }
    }
    low
}

// ---- candies_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn maximum_candies(candies: Vec[i32], k: i64) -> i32 {
        let mut (lo, hi) = (0i32, *candies.iter().max().unwrap());
        while lo < hi {
            let mid = lo + (hi - lo + 1) / 2;
            let cnt: i64 = candies.iter().map(|c| (c / mid) as i64).sum();
            if cnt >= k {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        lo
    }
}

struct Solution {}

fn solution_maximum_candies(candies: Vec[i64], k: i64) -> i64 {
    let candies: Vec[i32] = candies.iter().map(|x| x as i32).collect();
    Solution.maximum_candies(candies, k)
}

// ---- the statement read literally

fn literal(candies: Vec[i64], k: i64) -> i64 {
    let mut largest = 0;
    for pile in candies.iter() {
        largest = largest.max(pile);
    }
    let mut x = largest;
    while x > 0 {
        let mut served = 0;
        for pile in candies.iter() {
            let mut left = pile;
            while left >= x {
                left -= x;
                served += 1;
            }
        }
        if served >= k {
            return x;
        }
        x -= 1;
    }
    0
}

fn answer(arm: i64, candies: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_maximum_candies(candies, k),
        1 => bits_maximum_candies(candies, k),
        2 => bound_maximum_candies(candies, k),
        3 => struct_maximum_candies(candies, k),
        4 => iter_maximum_candies(candies, k),
        _ => solution_maximum_candies(candies, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Case {
    candies: Vec[i64],
    k: i64,
}

fn main() {
    let names = ["star", "bits", "bound", "struct", "iter", "solution"];
    let mut seed = 2226;
    let mut cases: Vec[Case] = Vec.new();
    for c in 0..360 {
        let n = next_random(mut seed) % 8 + 1;
        let top = [10, 50, 200][c % 3];
        let mut candies: Vec[i64] = Vec.new();
        let mut total = 0;
        for _ in 0..n {
            let pile = next_random(mut seed) % top + 1;
            candies.push(pile);
            total += pile;
        }
        let k = if c < 300 {
            next_random(mut seed) % (total + total / 10 + 1) + 1
        } else if c < 330 {
            total
        } else {
            1
        };
        cases.push(Case { candies: candies, k: k });
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for case in cases.iter() {
        let candies = ref case.candies;
        let k = case.k;
        let truth = literal(candies, k);
        check = (check * 31 + truth) % 1000000007;
        let mut largest = 0;
        let mut total = 0;
        for pile in candies.iter() {
            largest = largest.max(pile);
            total += pile;
        }
        let reversed: Vec[i64] = candies.iter().rev().collect();
        let doubled: Vec[i64] = candies.iter().map(|p| 2 * p).collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, candies, k)).collect();
        for arm in 0..6 {
            let each = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == each {
                    same += 1;
                }
            }
            let twice = answer(arm, doubled, k);
            let verdicts = [
                each == truth,
                each >= 0 and each <= largest and each <= total / k,
                answer(arm, reversed, k) == each,
                answer(arm, candies, k + 1) <= each,
                twice == 2 * each or twice == 2 * each + 1,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{candies}, k = {k} arm {names[arm]}: P{q + 1} fails, gave {each}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
