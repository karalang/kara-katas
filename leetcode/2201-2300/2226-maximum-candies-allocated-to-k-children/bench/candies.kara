// LeetCode #2226: Maximum Candies Allocated to K Children -- a binary
// search on the answer: x candies each can be handed out when the piles
// cut into x-sized shares give at least k of them, and fewer candies
// each only gives more shares, so the largest such x lies between 0 and
// the largest pile. O(n log max).

fn maximum_candies(candies: Vec[i64], k: i64) -> i64 {
    let mut low = 0;
    let mut high = candies.iter().max().unwrap_or(0);
    while low < high {
        let x = (low + high + 1) / 2;
        let mut shares = 0;
        for pile in candies.iter() {
            shares += pile / x;
        }
        if shares >= k {
            low = x;
        } else {
            high = x - 1;
        }
    }
    low
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 2226;
    let mut lists: Vec[Vec[i64]] = Vec.new();
    for _ in 0..4 {
        let mut piles: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            piles.push(wide_random(mut seed) % 10000000 + 1);
        }
        lists.push(piles);
    }
    let children = [1000, 1000000, 1000000000, 100000000000];
    let mut check = 0;
    for _ in 0..25 {
        for l in 0..4 {
            // punch: one pile is drawn again before each answer
            let at = wide_random(mut seed) % 100000;
            lists[l][at] = wide_random(mut seed) % 10000000 + 1;
            check = (check * 31 + maximum_candies(lists[l], children[l])) % 1000000007;
        }
    }
    println(f"100 answers over 10^5 piles: checksum {check}");
}
