// LeetCode #2212: Maximum Points in an Archery Competition -- the
// differential. The six arms, against the statement read literally: every
// way to shoot Bob's arrows into the 12 sections tried, and the most
// points any of them wins; no masks, no sets of sections. 300 random
// contests of 1 to 6 arrows; then 30 with Alice's arrows all in section
// 0; then 30 with them all in one section. Every case is drawn before any
// arm answers.
//
// P1  the points of the arm's arrows are the statement read literally
// P2  the arm's arrows are 12 counts of at least 0 adding up to Bob's
// P3  the points are at least those of the best section Bob can afford
//     alone, and at most 66
// P4  one more arrow each, Alice's in section 0: no fewer points
// P5  11 more arrows each, Alice's in section 0: all 66 points
// P6  each arm agrees with at least three of the other five

// ---- archery.kara: the ★ arm, every mask of sections
fn star_maximum_bob_points(num_arrows: i64, alice_arrows: Vec[i64]) -> Vec[i64] {
    let mut best_mask = 0;
    let mut best_points = -1;
    for mask in 0..4096 {
        let mut cost = 0;
        let mut points = 0;
        for k in 0..12 {
            if mask >> k & 1 == 1 {
                cost += alice_arrows[k] + 1;
                points += k;
            }
        }
        if cost <= num_arrows and points > best_points {
            best_points = points;
            best_mask = mask;
        }
    }
    let mut bob: Vec[i64] = Vec.filled(12, 0);
    let mut left = num_arrows;
    for k in 0..12 {
        if best_mask >> k & 1 == 1 {
            bob[k] = alice_arrows[k] + 1;
            left -= bob[k];
        }
    }
    bob[0] += left;
    bob
}

// ---- archery_knapsack.kara: fewest arrows by sections and points
fn knapsack_maximum_bob_points(num_arrows: i64, alice_arrows: Vec[i64]) -> Vec[i64] {
    let never = num_arrows + 1;
    // fewest[k][p]: the fewest arrows winning exactly p points from the
    // first k sections
    let mut fewest: Vec[Vec[i64]] = Vec.filled(13, Vec.filled(67, never));
    fewest[0][0] = 0;
    for k in 0..12 {
        for p in 0..67 {
            fewest[k + 1][p] = fewest[k][p];
            if p >= k and fewest[k][p - k] + alice_arrows[k] + 1 < fewest[k + 1][p] {
                fewest[k + 1][p] = fewest[k][p - k] + alice_arrows[k] + 1;
            }
        }
    }
    let mut p = 66;
    while fewest[12][p] > num_arrows {
        p -= 1;
    }
    let mut bob: Vec[i64] = Vec.filled(12, 0);
    let mut k = 12;
    while k > 0 {
        if fewest[k][p] != fewest[k - 1][p] {
            bob[k - 1] = alice_arrows[k - 1] + 1;
            p -= k - 1;
        }
        k -= 1;
    }
    bob[0] += num_arrows - bob.iter().sum();
    bob
}

// ---- archery_search.kara: depth-first, cut by the points still open
fn search_search(k: i64, left: i64, points: i64, alice: Vec[i64], plan: mut ref Vec[i64], best: mut ref Vec[i64], best_points: mut ref i64) {
    if points + k * (k + 1) / 2 <= *best_points {
        return;
    }
    if k == 0 {
        *best_points = points;
        *best = plan.clone();
        best[0] += left;
        return;
    }
    let s = k;
    if left > alice[s] {
        plan[s] = alice[s] + 1;
        search_search(k - 1, left - plan[s], points + s, alice, mut plan, mut best, mut best_points);
        plan[s] = 0;
    }
    search_search(k - 1, left, points, alice, mut plan, mut best, mut best_points);
}

fn search_maximum_bob_points(num_arrows: i64, alice_arrows: Vec[i64]) -> Vec[i64] {
    let mut plan: Vec[i64] = Vec.filled(12, 0);
    let mut best: Vec[i64] = Vec.filled(12, 0);
    let mut best_points = -1;
    search_search(11, num_arrows, 0, alice_arrows, mut plan, mut best, mut best_points);
    best
}

// ---- archery_struct.kara: `Plan` and its prices
struct Plan {
    mask: i64,
}

impl Plan {
    fn wins(ref self, k: i64) -> bool {
        self.mask >> k & 1 == 1
    }

    fn cost(ref self, alice: Vec[i64]) -> i64 {
        (0..12).filter(|k| self.wins(k)).map(|k| alice[k] + 1).sum()
    }

    fn points(ref self) -> i64 {
        (0..12).filter(|k| self.wins(k)).sum()
    }

    fn arrows(ref self, num_arrows: i64, alice: Vec[i64]) -> Vec[i64] {
        let mut bob: Vec[i64] = (0..12).map(|k| if self.wins(k) { alice[k] + 1 } else { 0 }).collect();
        bob[0] += num_arrows - self.cost(alice);
        bob
    }
}

fn struct_maximum_bob_points(num_arrows: i64, alice_arrows: Vec[i64]) -> Vec[i64] {
    let mut best = Plan { mask: 0 };
    for mask in 1..4096 {
        let plan = Plan { mask: mask };
        if plan.cost(alice_arrows) <= num_arrows and plan.points() > best.points() {
            best = plan;
        }
    }
    best.arrows(num_arrows, alice_arrows)
}

// ---- archery_iter.kara: `filter` and `max_by_key` over the masks
fn iter_maximum_bob_points(num_arrows: i64, alice_arrows: Vec[i64]) -> Vec[i64] {
    let cost = |mask: i64| (0..12).filter(|k| mask >> k & 1 == 1).map(|k| alice_arrows[k] + 1).sum();
    let points = |mask: i64| (0..12).filter(|k| mask >> k & 1 == 1).sum();
    let best = (0..4096).filter(|m| cost(m) <= num_arrows).max_by_key(|m| points(m)).unwrap();
    let mut bob: Vec[i64] = (0..12).map(|k| if best >> k & 1 == 1 { alice_arrows[k] + 1 } else { 0 }).collect();
    bob[0] += num_arrows - cost(best);
    bob
}

// ---- archery_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn maximum_bob_points(num_arrows: i32, alice_arrows: Vec[i32]) -> Vec[i32] {
        let mut best = 0u32;
        let mut best_points = -1;
        for mask in 0..(1u32 << 12) {
            let mut cost = 0;
            let mut points = 0;
            for k in 0..12 {
                if mask & (1 << k) != 0 {
                    cost += alice_arrows[k] + 1;
                    points += k as i32;
                }
            }
            if cost <= num_arrows and points > best_points {
                best_points = points;
                best = mask;
            }
        }
        let mut bob = Vec.filled(12, 0);
        let mut left = num_arrows;
        for k in 0..12 {
            if best & (1 << k) != 0 {
                bob[k] = alice_arrows[k] + 1;
                left -= bob[k];
            }
        }
        bob[0] += left;
        bob
    }
}

struct Solution {}

fn solution_maximum_bob_points(num_arrows: i64, alice_arrows: Vec[i64]) -> Vec[i64] {
    let alice: Vec[i32] = alice_arrows.iter().map(|x| x as i32).collect();
    Solution.maximum_bob_points(num_arrows as i32, alice).iter().map(|x| x as i64).collect()
}

// ---- the statement read literally

// the most points Bob wins with `left` arrows still to shoot into
// sections k to 11, every split of them tried
fn shoot(alice: Vec[i64], k: i64, left: i64) -> i64 {
    if k == 11 {
        return if left > alice[11] { 11 } else { 0 };
    }
    let mut best = 0;
    for here in 0..(left + 1) {
        let won = if here > alice[k] { k } else { 0 };
        best = best.max(won + shoot(alice, k + 1, left - here));
    }
    best
}

fn literal(num_arrows: i64, alice: Vec[i64]) -> i64 {
    shoot(alice, 0, num_arrows)
}

fn score(num_arrows: i64, alice: Vec[i64], bob: Vec[i64]) -> i64 {
    if bob.len() != 12 or bob.iter().any(|b| b < 0) or bob.iter().sum() != num_arrows {
        return -1;
    }
    (0..12).filter(|k| bob[k] > alice[k]).sum()
}

fn answer(arm: i64, num_arrows: i64, alice: Vec[i64]) -> Vec[i64] {
    match arm {
        0 => star_maximum_bob_points(num_arrows, alice),
        1 => knapsack_maximum_bob_points(num_arrows, alice),
        2 => search_maximum_bob_points(num_arrows, alice),
        3 => struct_maximum_bob_points(num_arrows, alice),
        4 => iter_maximum_bob_points(num_arrows, alice),
        _ => solution_maximum_bob_points(num_arrows, alice),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Contest {
    arrows: i64,
    alice: Vec[i64],
}

fn main() {
    let names = ["star", "knapsack", "search", "struct", "iter", "solution"];
    let mut seed = 2212;
    let mut cases: Vec[Contest] = Vec.new();
    for c in 0..360 {
        let n = next_random(mut seed) % 6 + 1;
        let mut alice: Vec[i64] = Vec.filled(12, 0);
        let one = next_random(mut seed) % 12;
        for _ in 0..n {
            let k = if c < 300 { next_random(mut seed) % 12 } else if c < 330 { 0 } else { one };
            alice[k] += 1;
        }
        cases.push(Contest { arrows: n, alice: alice });
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for case in cases.iter() {
        let n = case.arrows;
        let alice = ref case.alice;
        let truth = literal(n, alice);
        check = (check * 31 + truth) % 1000000007;
        let alone = (0..12).filter(|k| alice[k] + 1 <= n).max().unwrap_or(0);
        let mut one_more = alice.clone();
        one_more[0] += 1;
        let mut eleven_more = alice.clone();
        eleven_more[0] += 11;
        let got: Vec[i64] = (0..6).map(|arm| score(n, alice, answer(arm, n, alice))).collect();
        for arm in 0..6 {
            let points = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == points {
                    same += 1;
                }
            }
            let verdicts = [
                points == truth,
                points >= 0,
                points >= alone and points <= 66,
                score(n + 1, one_more, answer(arm, n + 1, one_more)) >= points,
                score(n + 11, eleven_more, answer(arm, n + 11, eleven_more)) == 66,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{n} vs {alice} arm {names[arm]}: P{q + 1} fails, scored {points}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
