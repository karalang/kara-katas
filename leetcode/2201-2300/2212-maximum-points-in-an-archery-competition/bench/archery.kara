// benchmark's Kāra version of archery.kara (LeetCode #2212, the ★ arm):
// all 2^12 sets of sections tried as bit masks, Bob paying alice[k] + 1
// arrows for each, the best he can afford kept, and the arrows left over
// put in section 0.

fn maximum_bob_points(num_arrows: i64, alice_arrows: Vec[i64]) -> Vec[i64] {
    let mut best_mask = 0;
    let mut best_points = -1;
    for mask in 0..4096 {
        let mut cost = 0;
        let mut points = 0;
        for k in 0..12 {
            if mask >> k & 1 == 1 {
                cost += alice_arrows[k] + 1;
                points += k;
            }
        }
        if cost <= num_arrows and points > best_points {
            best_points = points;
            best_mask = mask;
        }
    }
    let mut bob: Vec[i64] = Vec.filled(12, 0);
    let mut left = num_arrows;
    for k in 0..12 {
        if best_mask >> k & 1 == 1 {
            bob[k] = alice_arrows[k] + 1;
            left -= bob[k];
        }
    }
    bob[0] += left;
    bob
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2212;
    let mut contests: Vec[(i64, Vec[i64])] = Vec.new();
    for _ in 0..3000 {
        // up to 10^5 arrows, Alice's shot into 12 sections in random shares
        let n = next_random(mut seed) * 4 % 100000 + 1;
        let mut alice: Vec[i64] = Vec.filled(12, 0);
        let mut left = n;
        for k in 0..11 {
            let take = next_random(mut seed) % (left / 4 + 1);
            alice[k] = take;
            left -= take;
        }
        alice[11] = left;
        contests.push((n, alice));
    }
    let mut check = 0;
    for (n, alice) in contests.iter() {
        let bob = maximum_bob_points(n, alice);
        for k in 0..12 {
            check = (check * 31 + bob[k]) % 1000000007;
        }
    }
    println(f"3000 contests: checksum {check}");
}
