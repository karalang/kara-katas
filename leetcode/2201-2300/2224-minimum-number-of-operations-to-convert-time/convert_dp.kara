// LeetCode #2224: Minimum Number of Operations to Convert Time -- no
// trust in greed: the fewest steps to cover every gap from 0 up, each
// the best of one step of 1, 5, 15 or 60 after a smaller gap, as in
// coin change. Each time is read by `split(':')` and `i64.parse`.
// O(gap).

fn minutes_of(time: String) -> i64 {
    let parts: Vec[String] = time.split(":").map(|p| p.to_string()).collect();
    i64.parse(parts[0]).unwrap() * 60 + i64.parse(parts[1]).unwrap()
}

fn convert_time(current: String, correct: String) -> i64 {
    let gap = minutes_of(correct) - minutes_of(current);
    let mut fewest: Vec[i64] = Vec.filled(gap + 1, 0);
    for g in 1..gap + 1 {
        let mut best = fewest[g - 1] + 1;
        for step in [5, 15, 60] {
            if step <= g and fewest[g - step] + 1 < best {
                best = fewest[g - step] + 1;
            }
        }
        fewest[g] = best;
    }
    fewest[gap]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// minutes since midnight as "HH:MM"
fn clock(minutes: i64) -> String {
    let hours = minutes / 60;
    let rest = minutes % 60;
    let h = if hours < 10 { f"0{hours}" } else { f"{hours}" };
    let m = if rest < 10 { f"0{rest}" } else { f"{rest}" };
    f"{h}:{m}"
}

fn show(current: String, correct: String) {
    println(f"{current} -> {correct}: {convert_time(current, correct)}");
}

fn main() {
    // LeetCode's two examples, then four more: no change, the whole
    // day, one of each step, and four of the smallest
    show("02:30", "04:35");
    show("11:00", "11:01");
    show("09:09", "09:09");
    show("00:00", "23:59");
    show("10:00", "11:21");
    show("12:56", "13:00");
    // 3000 random pairs, the earlier one first
    let mut seed = 2224;
    let mut check = 0;
    for _ in 0..3000 {
        let a = next_random(mut seed) % 1440;
        let b = next_random(mut seed) % 1440;
        let (low, high) = if a <= b { (a, b) } else { (b, a) };
        check = (check * 31 + convert_time(clock(low), clock(high))) % 1000000007;
    }
    println(f"3000 pairs: checksum {check}");
    // every pair of the times 00:00, 00:29, 00:58, ... in order
    let mut total = 0;
    let mut pairs = 0;
    for a in 0..50 {
        for b in a..50 {
            total += convert_time(clock(a * 29), clock(b * 29));
            pairs += 1;
        }
    }
    println(f"{pairs} pairs 29 minutes apart: {total} operations");
}
