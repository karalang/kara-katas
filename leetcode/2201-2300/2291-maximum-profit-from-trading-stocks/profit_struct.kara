// LeetCode #2291: Maximum Profit From Trading Stocks -- the struct arm.
// `struct Stock` holds a price and a price to come; `struct Table` is
// the full two-dimensional knapsack, a row per stock considered and a
// column per budget, each cell the better of skipping the stock and
// buying it. O(n * budget).

struct Stock {
    now: i64,
    later: i64,
}

impl Stock {
    fn gain(self) -> i64 {
        self.later - self.now
    }
}

struct Table {
    rows: Vec[Vec[i64]],
}

impl Table {
    fn fill(stocks: Vec[Stock], budget: i64) -> Table {
        let mut rows: Vec[Vec[i64]] = [Vec.filled(budget + 1, 0)];
        for s in stocks.iter() {
            let last = rows[rows.len() - 1].clone();
            let mut row = last.clone();
            for b in s.now..budget + 1 {
                row[b] = row[b].max(last[b - s.now] + s.gain());
            }
            rows.push(row);
        }
        Table { rows: rows }
    }

    fn answer(self) -> i64 {
        let last = ref self.rows[self.rows.len() - 1];
        last[last.len() - 1]
    }
}

fn maximum_profit(present: Vec[i64], future: Vec[i64], budget: i64) -> i64 {
    let mut stocks: Vec[Stock] = Vec.new();
    for i in 0..present.len() {
        stocks.push(Stock { now: present[i], later: future[i] });
    }
    Table.fill(stocks, budget).answer()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; then a budget of 0, free stocks, every
    // stock at a loss, and one stock costing the whole budget
    let cases = [
        ([5, 4, 6, 2, 3], [8, 5, 4, 3, 5], 10),
        ([2, 2, 5], [3, 4, 10], 6),
        ([3, 3, 12], [0, 3, 15], 10),
        ([1, 2], [5, 9], 0),
        ([0, 0, 3], [4, 0, 9], 2),
        ([5, 6, 7], [5, 1, 0], 100),
        ([10, 1, 1], [30, 5, 5], 10),
    ];
    for (present, future, budget) in cases.iter() {
        println(f"{present.len()} stocks, budget {budget}: {maximum_profit(present, future, budget)}");
    }
    // 2000 random markets of 1 to 10 stocks, prices 0 to 100, budgets 0
    // to 400
    let mut seed = 2291;
    let mut check = 0;
    let mut sum = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 10 + 1;
        let mut present: Vec[i64] = Vec.new();
        let mut future: Vec[i64] = Vec.new();
        for _ in 0..n {
            present.push(next_random(mut seed) % 101);
            future.push(next_random(mut seed) % 101);
        }
        let budget = next_random(mut seed) % 401;
        let profit = maximum_profit(present, future, budget);
        check = (check * 31 + profit) % 1000000007;
        sum += profit;
    }
    println(f"2000 markets: checksum {check}, {sum} profit");
}
