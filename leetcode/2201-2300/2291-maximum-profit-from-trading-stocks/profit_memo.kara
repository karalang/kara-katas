// LeetCode #2291: Maximum Profit From Trading Stocks -- the memo arm.
// The naive recursion with its answers kept in a `Map[(i64, i64), i64]`
// keyed by the stock and the budget left. O(n * budget).

fn best_from(i: i64, left: i64, present: Vec[i64], future: Vec[i64], memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if i == present.len() {
        return 0;
    }
    if let Some(known) = memo.get((i, left)) {
        return known;
    }
    let mut best = best_from(i + 1, left, present, future, mut memo);
    if present[i] <= left {
        best = best.max(future[i] - present[i] + best_from(i + 1, left - present[i], present, future, mut memo));
    }
    memo.insert((i, left), best);
    best
}

fn maximum_profit(present: Vec[i64], future: Vec[i64], budget: i64) -> i64 {
    let mut memo: Map[(i64, i64), i64] = Map.new();
    best_from(0, budget, present, future, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; then a budget of 0, free stocks, every
    // stock at a loss, and one stock costing the whole budget
    let cases = [
        ([5, 4, 6, 2, 3], [8, 5, 4, 3, 5], 10),
        ([2, 2, 5], [3, 4, 10], 6),
        ([3, 3, 12], [0, 3, 15], 10),
        ([1, 2], [5, 9], 0),
        ([0, 0, 3], [4, 0, 9], 2),
        ([5, 6, 7], [5, 1, 0], 100),
        ([10, 1, 1], [30, 5, 5], 10),
    ];
    for (present, future, budget) in cases.iter() {
        println(f"{present.len()} stocks, budget {budget}: {maximum_profit(present, future, budget)}");
    }
    // 2000 random markets of 1 to 10 stocks, prices 0 to 100, budgets 0
    // to 400
    let mut seed = 2291;
    let mut check = 0;
    let mut sum = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 10 + 1;
        let mut present: Vec[i64] = Vec.new();
        let mut future: Vec[i64] = Vec.new();
        for _ in 0..n {
            present.push(next_random(mut seed) % 101);
            future.push(next_random(mut seed) % 101);
        }
        let budget = next_random(mut seed) % 401;
        let profit = maximum_profit(present, future, budget);
        check = (check * 31 + profit) % 1000000007;
        sum += profit;
    }
    println(f"2000 markets: checksum {check}, {sum} profit");
}
