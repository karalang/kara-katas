// LeetCode #2291: Maximum Profit From Trading Stocks -- the bench, the
// ★ arm. A 0/1 knapsack row over the budget, run downwards for each
// stock that gains.

fn maximum_profit(present: Vec[i64], future: Vec[i64], budget: i64) -> i64 {
    let mut best: Vec[i64] = Vec.filled(budget + 1, 0);
    for i in 0..present.len() {
        let cost = present[i];
        let gain = future[i] - present[i];
        if gain <= 0 {
            continue;
        }
        for b in (cost..budget + 1).rev() {
            best[b] = best[b].max(best[b - cost] + gain);
        }
    }
    best[budget]
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 100 markets of 500 stocks built once, prices 0 to 100, then each
    // answered with a budget of 1000
    let mut seed = 2291;
    let mut markets: Vec[(Vec[i64], Vec[i64])] = Vec.new();
    for _ in 0..100 {
        let mut present: Vec[i64] = Vec.new();
        let mut future: Vec[i64] = Vec.new();
        for _ in 0..500 {
            present.push(next_random(mut seed) % 101);
            future.push(next_random(mut seed) % 101);
        }
        markets.push((present, future));
    }
    let mut check = 0;
    for (present, future) in markets.iter() {
        check = (check * 31 + maximum_profit(present, future, 1000)) % 1000000007;
    }
    println(f"100 markets of 500 stocks, budget 1000: checksum {check}");
}
