// LeetCode #2299: Strong Password Checker II -- the differential. The
// six arms, against the statement read literally: the letters counted
// one by one; each kind looked for by walking its list of letters, the
// alphabet, the digits and the twelve special letters, against every
// letter of the password; and each letter compared with the one after.
// No ranges, no flags. 300 random passwords of 1 to 20 letters, the
// letters of each kind drawn from 1 to 12 of its letters in a row,
// wrapping round, from a random one on; then 30 built to be strong;
// then 30 built strong and then broken in one way. Every case is drawn
// before any arm answers.
//
// P1  the answer is the literal reading's
// P2  every letter's case swapped: the same answer
// P3  the password reversed: the same answer
// P4  every letter written twice: not strong
// P5  every letter moved one on within its kind, the last to the first:
//     the same answer
// P6  each arm agrees with at least three of the other five

// ---- strong.kara: the ★ arm, a `match` setting four flags
fn star_strong(password: Str) -> bool {
    if password.len() < 8 {
        return false;
    }
    let mut lower = false;
    let mut upper = false;
    let mut digit = false;
    let mut special = false;
    let mut prev = ' ';
    for c in password.chars() {
        if c == prev {
            return false;
        }
        match c {
            'a'..='z' => lower = true,
            'A'..='Z' => upper = true,
            '0'..='9' => digit = true,
            '!' | '@' | '#' | '$' | '%' | '^' | '&' | '*' | '(' | ')' | '-' | '+' => special = true,
            _ => {}
        }
        prev = c;
    }
    lower and upper and digit and special
}

// ---- strong_naive.kara: one scan for each rule
fn naive_strong(password: Str) -> bool {
    if password.len() < 8 {
        return false;
    }
    let letters: Vec[char] = password.chars().collect();
    for i in 1..letters.len() {
        if letters[i] == letters[i - 1] {
            return false;
        }
    }
    let specials: Vec[char] = "!@#$%^&*()-+".chars().collect();
    let mut lower = false;
    for c in letters.iter() {
        if c.is_ascii_lowercase() {
            lower = true;
        }
    }
    let mut upper = false;
    for c in letters.iter() {
        if c.is_ascii_uppercase() {
            upper = true;
        }
    }
    let mut digit = false;
    for c in letters.iter() {
        if c.is_ascii_digit() {
            digit = true;
        }
    }
    let mut special = false;
    for c in letters.iter() {
        for s in specials.iter() {
            if c == s {
                special = true;
            }
        }
    }
    lower and upper and digit and special
}

// ---- strong_mask.kara: the kinds as bits of a mask
fn mask_strong(password: Str) -> bool {
    let s = password.bytes();
    if s.len() < 8 {
        return false;
    }
    let mut mask = 0;
    for i in 0..s.len() {
        if i > 0 and s[i] == s[i - 1] {
            return false;
        }
        let c = s[i];
        mask |= if c >= b'a' and c <= b'z' {
            1
        } else if c >= b'A' and c <= b'Z' {
            2
        } else if c >= b'0' and c <= b'9' {
            4
        } else {
            8
        };
    }
    mask == 15
}

// ---- strong_iter.kara: `zip`, `all`, `map` and `fold`
fn iter_kind(c: char) -> i64 {
    if c.is_ascii_lowercase() {
        1
    } else if c.is_ascii_uppercase() {
        2
    } else if c.is_ascii_digit() {
        4
    } else if "!@#$%^&*()-+".chars().any(|s| s == c) {
        8
    } else {
        0
    }
}

fn iter_strong(password: Str) -> bool {
    password.len() >= 8
        and password.chars().zip(password.chars().skip(1)).all(|(a, b)| a != b)
        and password.chars().map(iter_kind).fold(0, |m, k| m | k) == 15
}

// ---- strong_struct.kara: `enum Kind` into a `Set[Kind]`
#[derive(PartialEq, Eq, Hash)]
enum StructKind {
    Lower,
    Upper,
    Digit,
    Special,
}

fn struct_kind_of(c: char) -> Option[StructKind] {
    if c.is_ascii_lowercase() {
        Some(StructKind.Lower)
    } else if c.is_ascii_uppercase() {
        Some(StructKind.Upper)
    } else if c.is_ascii_digit() {
        Some(StructKind.Digit)
    } else if "!@#$%^&*()-+".chars().any(|s| s == c) {
        Some(StructKind.Special)
    } else {
        None
    }
}

fn struct_strong(password: Str) -> bool {
    if password.len() < 8 {
        return false;
    }
    let mut seen: Set[StructKind] = Set.new();
    let mut prev: Option[char] = None;
    for c in password.chars() {
        if prev == Some(c) {
            return false;
        }
        if let Some(k) = struct_kind_of(c) {
            seen.insert(k);
        }
        prev = Some(c);
    }
    seen.len() == 4
}

// ---- strong_solution.kara: LeetCode's Rust template
struct Solution {}

impl Solution {
    pub fn strong_password_checker_ii(password: String) -> bool {
        let s: Vec[char] = password.chars().collect();
        if s.len() < 8 {
            return false;
        }
        if s.windows(2).into_iter().any(|w| w[0] == w[1]) {
            return false;
        }
        let mut (lower, upper, digit, special) = (false, false, false, false);
        for c in ref s {
            if c.is_ascii_lowercase() {
                lower = true;
            } else if c.is_ascii_uppercase() {
                upper = true;
            } else if c.is_ascii_digit() {
                digit = true;
            } else if "!@#$%^&*()-+".contains(c.to_string()) {
                special = true;
            }
        }
        lower and upper and digit and special
    }
}

fn solution_strong(password: Str) -> bool {
    Solution.strong_password_checker_ii(password.to_string())
}

// ---- the statement read literally

fn has_one_of(password: Vec[char], kind: Str) -> bool {
    for c in password.iter() {
        for k in kind.chars() {
            if c == k {
                return true;
            }
        }
    }
    false
}

fn literal(password: Str) -> bool {
    let letters: Vec[char] = password.chars().collect();
    let mut count = 0;
    for _ in letters.iter() {
        count += 1;
    }
    let mut repeat = false;
    for i in 0..count - 1 {
        if letters[i] == letters[i + 1] {
            repeat = true;
        }
    }
    count >= 8
        and has_one_of(letters, LOWER)
        and has_one_of(letters, UPPER)
        and has_one_of(letters, DIGITS)
        and has_one_of(letters, SPECIAL)
        and not repeat
}

const LOWER: Str = "abcdefghijklmnopqrstuvwxyz";
const UPPER: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
const DIGITS: Str = "0123456789";
const SPECIAL: Str = "!@#$%^&*()-+";

fn answer(arm: i64, password: Str) -> bool {
    match arm {
        0 => star_strong(password),
        1 => naive_strong(password),
        2 => mask_strong(password),
        3 => iter_strong(password),
        4 => struct_strong(password),
        _ => solution_strong(password),
    }
}

// each letter put through `f`
fn mapped(password: Str, f: Fn(char) -> char) -> String {
    let mut s = String.new();
    for c in password.chars() {
        s.push(f(c));
    }
    s
}

fn swap_case(c: char) -> char {
    if c.is_ascii_lowercase() {
        c.to_ascii_uppercase()
    } else {
        c.to_ascii_lowercase()
    }
}

// the letter after `c` in its kind's list, the last to the first
fn one_on(c: char) -> char {
    for kind in [LOWER, UPPER, DIGITS, SPECIAL] {
        let letters: Vec[char] = kind.chars().collect();
        for i in 0..letters.len() {
            if letters[i] == c {
                return letters[(i + 1) % letters.len()];
            }
        }
    }
    c
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// one of the `width` letters of `kind` from `from` on, wrapping round
fn pick(seed: mut ref i64, kind: Str, from: i64, width: i64) -> char {
    let letters: Vec[char] = kind.chars().collect();
    letters[(from + next_random(mut seed) % width.min(letters.len())) % letters.len()]
}

fn main() {
    let names = ["star", "naive", "mask", "iter", "struct", "solution"];
    let kinds = [LOWER, UPPER, DIGITS, SPECIAL];
    let mut seed = 2299;
    let mut cases: Vec[String] = Vec.new();
    for c in 0..360 {
        let mut s = String.new();
        if c < 300 {
            let n = next_random(mut seed) % 20 + 1;
            let width = next_random(mut seed) % 12 + 1;
            let from = next_random(mut seed) % 26;
            for _ in 0..n {
                s.push(pick(mut seed, kinds[next_random(mut seed) % 4], from, width));
            }
        } else {
            // strong: 8 to 20 letters, the four kinds first in a random
            // order, then any, each unlike the one before
            let n = next_random(mut seed) % 13 + 8;
            let first = next_random(mut seed) % 4;
            let from = next_random(mut seed) % 26;
            let mut letters: Vec[char] = Vec.new();
            for i in 0..n {
                let kind = if i < 4 { (first + i) % 4 } else { next_random(mut seed) % 4 };
                let mut x = pick(mut seed, kinds[kind], from, 12);
                while letters.len() > 0 and letters[letters.len() - 1] == x {
                    x = pick(mut seed, kinds[kind], from, 12);
                }
                letters.push(x);
            }
            if c >= 330 {
                // broken: a letter doubled, the length cut to 7, or every
                // letter of one kind made a letter of another
                let way = next_random(mut seed) % 3;
                if way == 0 {
                    let at = next_random(mut seed) % n;
                    letters.insert(at, letters[at]);
                } else if way == 1 {
                    letters.truncate(7);
                } else {
                    let gone = next_random(mut seed) % 4;
                    let into: Vec[char] = kinds[(gone + 1) % 4].chars().collect();
                    for i in 0..letters.len() {
                        if kinds[gone].contains(letters[i].to_string()) {
                            letters[i] = into[i % 2];
                        }
                    }
                }
            }
            for x in letters.iter() {
                s.push(x);
            }
        }
        cases.push(s);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for p in cases.iter() {
        let truth = literal(p);
        check = (check * 31 + if truth { p.len() } else { 100 + p.len() }) % 1000000007;
        let swapped = mapped(p, swap_case);
        let reversed: String = p.chars().rev().collect();
        let mut doubled = String.new();
        for c in p.chars() {
            doubled.push(c);
            doubled.push(c);
        }
        let moved = mapped(p, one_on);
        let got: Vec[bool] = (0..6).map(|arm| answer(arm, p)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, swapped) == value,
                answer(arm, reversed) == value,
                not answer(arm, doubled),
                answer(arm, moved) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{p} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
