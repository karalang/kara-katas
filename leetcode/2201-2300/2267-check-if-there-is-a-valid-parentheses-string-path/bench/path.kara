// LeetCode #2267: Check if There Is a Valid Parentheses String Path --
// the ★ arm. `reach[i][j][b]` says some path from the top left to cell
// (i, j) ends with `b` brackets open and never went below 0. Each cell
// takes its balances from the cell above and the cell to the left,
// moved by its own bracket. The path is valid when the bottom right
// reaches 0. A path of odd length, or one that starts with `)`, cannot
// be. O(m n (m + n)).

fn has_valid_path(grid: Vec[Vec[char]]) -> bool {
    let m = grid.len();
    let n = grid[0].len();
    if (m + n - 1) % 2 == 1 or grid[0][0] == ')' or grid[m - 1][n - 1] == '(' {
        return false;
    }
    let most = (m + n) / 2 + 1;
    let mut reach = Vec.filled(m, Vec.filled(n, Vec.filled(most + 1, false)));
    reach[0][0][1] = true;
    for i in 0..m {
        for j in 0..n {
            if i == 0 and j == 0 {
                continue;
            }
            let step = if grid[i][j] == '(' { 1 } else { -1 };
            for b in 0..most + 1 {
                let from = b - step;
                if from < 0 or from > most {
                    continue;
                }
                if (i > 0 and reach[i - 1][j][from]) or (j > 0 and reach[i][j - 1][from]) {
                    reach[i][j][b] = true;
                }
            }
        }
    }
    reach[m - 1][n - 1][0]
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 grids of the constraints' largest, 100 by 99, `(` at 50 to 69 in
    // 100, the top left `(` and the bottom right `)`
    let mut seed = 2267;
    let mut found = 0;
    let mut check = 0;
    for t in 0..20 {
        let open = 50 + t;
        let mut grid: Vec[Vec[char]] = (0..100)
            .map(|_| (0..99).map(|_| if next_random(mut seed) % 100 < open { '(' } else { ')' }).collect())
            .collect();
        grid[0][0] = '(';
        grid[99][98] = ')';
        let valid = has_valid_path(grid);
        if valid {
            found += 1;
        }
        check = (check * 31 + if valid { 2 } else { 1 }) % 1000000007;
    }
    println(f"20 grids of 100 by 99: {found} with a path, checksum {check}");
}
