// LeetCode #2267: Check if There Is a Valid Parentheses String Path -- a
// struct that sweeps the rows. `struct Sweep` holds, for each column of
// the last row swept, the lowest and highest balance a path can end with
// there; between them every balance of the same parity is reachable, as
// moving one step right or down only ever changes both by one.
// `next_row` (`mut ref self`) sweeps one row. O(m n).

struct Sweep {
    low: Vec[i64],
    high: Vec[i64],
}

impl Sweep {
    fn new(n: i64) -> Sweep {
        Sweep { low: Vec.filled(n, i64.MAX), high: Vec.filled(n, -1) }
    }

    fn next_row(mut ref self, row: Vec[char], first: bool) {
        for j in 0..row.len() {
            let mut low = self.low[j];
            let mut high = self.high[j];
            if first and j == 0 {
                low = 0;
                high = 0;
            }
            if j > 0 {
                low = low.min(self.low[j - 1]);
                high = high.max(self.high[j - 1]);
            }
            if high < 0 {
                self.low[j] = i64.MAX;
                self.high[j] = -1;
                continue;
            }
            if row[j] == '(' {
                low += 1;
                high += 1;
            } else {
                low = if low == 0 { 1 } else { low - 1 };
                high -= 1;
            }
            self.low[j] = if high < 0 { i64.MAX } else { low };
            self.high[j] = high;
        }
    }
}

fn has_valid_path(grid: Vec[Vec[char]]) -> bool {
    let n = grid[0].len();
    let mut sweep = Sweep.new(n);
    for i in 0..grid.len() {
        sweep.next_row(grid[i], i == 0);
    }
    sweep.low[n - 1] == 0
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// an `m` by `n` grid, each cell `(` with chance `open` in 100
fn random_grid(seed: mut ref i64, m: i64, n: i64, open: i64) -> Vec[Vec[char]] {
    (0..m)
        .map(|_| (0..n).map(|_| if next_random(mut seed) % 100 < open { '(' } else { ')' }).collect())
        .collect()
}

fn grid_of(rows: Vec[String]) -> Vec[Vec[char]] {
    rows.iter().map(|r| r.chars().collect()).collect()
}

fn main() {
    // LeetCode's two examples, then five more: one cell, a pair in a row,
    // a pair down a column, an odd path, and `)` at the start
    let examples = [
        ["(((", ")()", "(()", "(()"].to_vec(),
        ["))", "(("].to_vec(),
        ["("].to_vec(),
        ["()"].to_vec(),
        ["(", ")"].to_vec(),
        ["((", "))"].to_vec(),
        [")(", "()"].to_vec(),
    ];
    for rows in examples.iter() {
        println(f"{rows} -> {has_valid_path(grid_of(rows))}");
    }
    // 2000 grids of 1 to 8 rows and columns, `(` half the time or 60 in
    // 100
    let mut seed = 2267;
    let mut found = 0;
    let mut check = 0;
    for t in 0..2000 {
        let m = next_random(mut seed) % 8 + 1;
        let n = next_random(mut seed) % 8 + 1;
        let valid = has_valid_path(random_grid(mut seed, m, n, [50, 60][t % 2]));
        if valid {
            found += 1;
        }
        check = (check * 31 + if valid { 2 } else { 1 }) % 1000000007;
    }
    println(f"2000 grids: {found} with a path, checksum {check}");
    // the constraints' largest, 100 by 100: random at 55 in 100, a
    // checkerboard, and `(` above the anti-diagonal with `)` below it
    let random = random_grid(mut seed, 100, 99, 55);
    let checker: Vec[Vec[char]] = (0..100).map(|i| (0..99).map(|j| if (i + j) % 2 == 0 { '(' } else { ')' }).collect()).collect();
    let split: Vec[Vec[char]] = (0..100).map(|i| (0..99).map(|j| if i + j < 99 { '(' } else { ')' }).collect()).collect();
    let answers = [has_valid_path(random), has_valid_path(checker), has_valid_path(split)];
    println(f"100 by 99: {answers}");
}
