// LeetCode #2275: Largest Combination With Bitwise AND Greater Than
// Zero -- the ★ arm. An AND is above zero exactly when some bit is set
// in every value combined, so the largest combination is the most values
// sharing one bit: count, for each of the 24 bits below 2^24 > 10^7, the
// values that have it. O(24 n).

fn largest_combination(candidates: Vec[i64]) -> i64 {
    let mut best = 0;
    for bit in 0..24 {
        let mut count = 0;
        for x in candidates.iter() {
            if (x >> bit) & 1 == 1 {
                count += 1;
            }
        }
        best = best.max(count);
    }
    best
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 100 lists of the constraints' largest, 10^5 values from 1 to 10^7,
    // built afresh
    let mut seed = 2275;
    let mut check = 0;
    for _ in 0..100 {
        let mut candidates: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            let high = next_random(mut seed);
            candidates.push((high * 32768 + next_random(mut seed)) % 10000000 + 1);
        }
        check = (check * 31 + largest_combination(candidates)) % 1000000007;
    }
    println(f"100 lists of 10^5: checksum {check}");
}
