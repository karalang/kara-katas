// LeetCode #2275: Largest Combination With Bitwise AND Greater Than
// Zero -- the differential. The six arms, against the statement read
// literally: every combination of the values, as a mask over their
// places, its AND taken, and the largest whose AND is above zero. No
// bits counted. 300 random lists of 1 to 10 values up to 3, 15, 255 or
// 10^6; then 30 of one value repeated; then 30 of distinct powers of
// two. Every case is drawn before any arm answers.
//
// P1  the size is the literal reading's
// P2  the list reversed: the same size
// P3  every value doubled, its bits one place up: the same size
// P4  at least 1 and at most the number of values, and all of them when
//     the AND of the whole list is above zero
// P5  the list twice over: twice the size
// P6  each arm agrees with at least three of the other five

// ---- combo.kara: the ★ arm, the values counted per bit
fn star_largest_combination(candidates: Vec[i64]) -> i64 {
    let mut best = 0;
    for bit in 0..24 {
        let mut count = 0;
        for x in candidates.iter() {
            if (x >> bit) & 1 == 1 {
                count += 1;
            }
        }
        best = best.max(count);
    }
    best
}

// ---- combo_tally.kara: each value's bits shifted into a tally
fn tally_largest_combination(candidates: Vec[i64]) -> i64 {
    let mut counts = [0; 24];
    for x in candidates.iter() {
        let mut rest = x;
        let mut bit = 0;
        while rest > 0 {
            counts[bit] += rest & 1;
            rest >>= 1;
            bit += 1;
        }
    }
    let mut best = 0;
    for c in counts.iter() {
        best = best.max(c);
    }
    best
}

// ---- combo_lowbit.kara: each set bit by `trailing_zeros`
fn lowbit_largest_combination(candidates: Vec[i64]) -> i64 {
    let mut counts = [0; 24];
    for x in candidates.iter() {
        let mut rest = x;
        while rest != 0 {
            counts[rest.trailing_zeros()] += 1;
            rest &= rest - 1;
        }
    }
    let mut best = 0;
    for c in counts.iter() {
        best = best.max(c);
    }
    best
}

// ---- combo_struct.kara: `struct BitTally` added a value at a time
struct StructBitTally {
    counts: Array[i64, 24],
}

impl StructBitTally {
    fn new() -> StructBitTally {
        StructBitTally { counts: [0; 24] }
    }

    fn add(mut ref self, x: i64) {
        for bit in 0..24 {
            if x & (1 << bit) != 0 {
                self.counts[bit] += 1;
            }
        }
    }

    fn largest(self) -> i64 {
        let mut best = 0;
        for c in self.counts.iter() {
            best = best.max(c);
        }
        best
    }
}

fn struct_largest_combination(candidates: Vec[i64]) -> i64 {
    let mut tally = StructBitTally.new();
    for x in candidates.iter() {
        tally.add(x);
    }
    tally.largest()
}

// ---- combo_iter.kara: `filter` and `count` per bit, then `max`
fn iter_largest_combination(candidates: Vec[i64]) -> i64 {
    (0..24)
        .map(|bit| candidates.iter().filter(|x| (x >> bit) & 1 == 1).count())
        .max()
        .unwrap()
}

// ---- combo_solution.kara: LeetCode's Rust template
impl Solution {
    pub fn largest_combination(candidates: Vec[i32]) -> i32 {
        let mut ans: i32 = 0;
        for b in 0..24 {
            let cnt = candidates.iter().filter(|x| (x >> b) & 1 == 1).count() as i32;
            ans = ans.max(cnt);
        }
        ans
    }
}

struct Solution {}

fn solution_largest_combination(candidates: Vec[i64]) -> i64 {
    Solution.largest_combination(candidates.iter().map(|x| x as i32).collect())
}


// ---- the statement read literally

fn literal(candidates: Vec[i64]) -> i64 {
    let n = candidates.len();
    let mut best = 0;
    for mask in 1..(1 << n) {
        let mut meet = -1;
        let mut size = 0;
        for i in 0..n {
            if mask & (1 << i) != 0 {
                meet &= candidates[i];
                size += 1;
            }
        }
        if meet > 0 {
            best = best.max(size);
        }
    }
    best
}

fn answer(arm: i64, candidates: Vec[i64]) -> i64 {
    match arm {
        0 => star_largest_combination(candidates),
        1 => tally_largest_combination(candidates),
        2 => lowbit_largest_combination(candidates),
        3 => struct_largest_combination(candidates),
        4 => iter_largest_combination(candidates),
        _ => solution_largest_combination(candidates),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "tally", "lowbit", "struct", "iter", "solution"];
    let mut seed = 2275;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..360 {
        let n = next_random(mut seed) % 10 + 1;
        let mut candidates: Vec[i64] = Vec.new();
        if c < 300 {
            let high = [3, 15, 255, 1000000][c % 4];
            for _ in 0..n {
                candidates.push((next_random(mut seed) * 32768 + next_random(mut seed)) % high + 1);
            }
        } else if c < 330 {
            let x = next_random(mut seed) % 1000 + 1;
            for _ in 0..n {
                candidates.push(x);
            }
        } else {
            let start = next_random(mut seed) % 10;
            for i in 0..n {
                candidates.push(1 << (start + i));
            }
        }
        cases.push(candidates);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for candidates in cases.iter() {
        let truth = literal(candidates);
        check = (check * 31 + truth) % 1000000007;
        let back: Vec[i64] = candidates.iter().rev().cloned().collect();
        let doubled: Vec[i64] = candidates.iter().map(|x| 2 * x).collect();
        let mut twice = candidates.clone();
        twice.extend(candidates.iter().cloned());
        let all = candidates.iter().fold(-1, |acc, x| acc & x);
        let n = candidates.len();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, candidates)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, back) == value,
                answer(arm, doubled) == value,
                value >= 1 and value <= n and (all == 0 or value == n),
                answer(arm, twice) == 2 * value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{candidates} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
