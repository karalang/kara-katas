// LeetCode #2275: Largest Combination With Bitwise AND Greater Than
// Zero -- a tally per value. Each value is shifted down a bit at a time,
// adding its low bit into an `Array[i64, 24]` of counts; the most
// common bit's count is the answer. O(n log max).

fn largest_combination(candidates: Vec[i64]) -> i64 {
    let mut counts = [0; 24];
    for x in candidates.iter() {
        let mut rest = x;
        let mut bit = 0;
        while rest > 0 {
            counts[bit] += rest & 1;
            rest >>= 1;
            bit += 1;
        }
    }
    let mut best = 0;
    for c in counts.iter() {
        best = best.max(c);
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` values from 1 to `high`, drawn from two calls so that they reach
// past 2^15
fn values(seed: mut ref i64, n: i64, high: i64) -> Vec[i64] {
    (0..n).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % high + 1).collect()
}

fn main() {
    // LeetCode's two examples, then five more: one value, four bits
    // apart, one value thrice, the largest value, and three values that
    // share bits only in pairs
    let examples = [
        [16, 17, 71, 62, 12, 24, 14].to_vec(),
        [8, 8].to_vec(),
        [1].to_vec(),
        [1, 2, 4, 8].to_vec(),
        [7, 7, 7].to_vec(),
        [10000000].to_vec(),
        [3, 5, 6].to_vec(),
    ];
    for candidates in examples.iter() {
        println(f"{candidates} -> {largest_combination(candidates)}");
    }
    // 2000 lists of 1 to 40 values up to 15, 1000 or 10^7
    let mut seed = 2275;
    let mut check = 0;
    for t in 0..2000 {
        let n = next_random(mut seed) % 40 + 1;
        let candidates = values(mut seed, n, [15, 1000, 10000000][t % 3]);
        check = (check * 31 + largest_combination(candidates)) % 1000000007;
    }
    println(f"2000 lists: checksum {check}");
    // the constraints' largest, 10^5 values: random up to 10^7, every
    // value from 1 to 10^5, and the powers of two below 2^24 in turn
    let random = values(mut seed, 100000, 10000000);
    let every: Vec[i64] = (1..=100000).collect();
    let powers: Vec[i64] = (0..100000).map(|i| 1 << (i % 24)).collect();
    let answers = [largest_combination(random), largest_combination(every), largest_combination(powers)];
    println(f"10^5 values: {answers}");
}
