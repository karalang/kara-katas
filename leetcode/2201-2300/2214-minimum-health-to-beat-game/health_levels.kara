// LeetCode #2214: Minimum Health to Beat Game -- the levels arm: the
// armor tried on every level in turn, each try costing the sum less what
// the armor saves on that level, and the cheapest kept; the total is
// summed first. O(n).

fn minimum_health(damage: Vec[i64], armor: i64) -> i64 {
    let mut total = 0;
    for d in damage.iter() {
        total += d;
    }
    let mut cheapest = total;
    for d in damage.iter() {
        cheapest = cheapest.min(total - d.min(armor));
    }
    cheapest + 1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn random_damage(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut damage: Vec[i64] = Vec.new();
    for _ in 0..n {
        damage.push(wide_random(mut seed) % (top + 1));
    }
    damage
}

fn show(damage: Vec[i64], armor: i64) {
    println(f"{damage} with armor {armor} -> {minimum_health(damage, armor)}");
}

fn main() {
    // LeetCode's three examples, then four more: one level, no damage at
    // all, armor beyond every level, and the largest level twice
    show([2, 7, 4, 3], 4);
    show([2, 5, 3, 4], 7);
    show([3, 3, 3], 0);
    show([5], 2);
    show([0, 0, 0], 5);
    show([1, 2, 3], 100);
    show([9, 1, 9], 6);
    // 3000 random games of 1 to 30 levels, damage up to 10, 1000 and
    // 10^5 in turn, the armor up to the same
    let mut seed = 2214;
    let mut check = 0;
    for t in 0..3000 {
        let top = [10, 1000, 100000][t % 3];
        let n = next_random(mut seed) % 30 + 1;
        let damage = random_damage(n, top, mut seed);
        let armor = wide_random(mut seed) % (top + 1);
        check = (check * 31 + minimum_health(damage, armor)) % 1000000007;
    }
    println(f"3000 games: checksum {check}");
    // the constraints' largest: 10^5 levels of 10^5 damage with all the
    // armor, then 10^5 random levels with none
    let heavy: Vec[i64] = Vec.filled(100000, 100000);
    let random = random_damage(100000, 100000, mut seed);
    println(f"10^5 at 10^5 -> {minimum_health(heavy, 100000)}, 10^5 random -> {minimum_health(random, 0)}");
}
