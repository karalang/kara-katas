// LeetCode #2293: Min Max Game -- the naive arm, the statement's
// algorithm as written: each round makes `newNums` of half the length,
// fills it from `nums` by the parity of the index, and replaces `nums`
// with it. O(n), with a fresh array each round.

fn min_max_game(nums: Vec[i64]) -> i64 {
    let mut nums = nums.clone();
    while nums.len() > 1 {
        let mut new_nums: Vec[i64] = Vec.filled(nums.len() / 2, 0);
        for i in 0..new_nums.len() {
            if i % 2 == 0 {
                new_nums[i] = nums[2 * i].min(nums[2 * i + 1]);
            } else {
                new_nums[i] = nums[2 * i].max(nums[2 * i + 1]);
            }
        }
        nums = new_nums;
    }
    nums[0]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then two numbers, rising and falling runs
    // of eight, all equal, and the largest values the constraints allow
    let cases: Vec[Vec[i64]] = [
        [1, 3, 5, 2, 4, 8, 2, 2],
        [3],
        [7, 2],
        [1, 2, 3, 4, 5, 6, 7, 8],
        [8, 7, 6, 5, 4, 3, 2, 1],
        [4, 4, 4, 4],
        [1000000000, 1, 1, 1000000000],
    ];
    for nums in cases.iter() {
        println(f"{nums.len()} numbers: {min_max_game(nums)}");
    }
    // 3000 random arrays of 1 to 1024 numbers, a power of two, from 1 to
    // 10^9
    let mut seed = 2293;
    let mut check = 0;
    let mut sum = 0;
    for _ in 0..3000 {
        let n = 1 << (next_random(mut seed) % 11);
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1);
        }
        let last = min_max_game(nums);
        check = (check * 31 + last) % 1000000007;
        sum += last;
    }
    println(f"3000 arrays: checksum {check}, sum {sum}");
}
