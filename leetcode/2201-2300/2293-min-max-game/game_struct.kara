// LeetCode #2293: Min Max Game -- the struct arm. `enum Pick` is the
// rule a slot of the next round follows, `Min` or `Max`, chosen by its
// index; `struct Round` holds the numbers of one round and makes the
// next. O(n).

enum Pick {
    Min,
    Max,
}

impl Pick {
    fn at(i: i64) -> Pick {
        if i % 2 == 0 { Pick.Min } else { Pick.Max }
    }

    fn of(self, a: i64, b: i64) -> i64 {
        match self {
            Pick.Min => a.min(b),
            Pick.Max => a.max(b),
        }
    }
}

struct Round {
    numbers: Vec[i64],
}

impl Round {
    fn done(self) -> bool {
        self.numbers.len() == 1
    }

    fn next(self) -> Round {
        let mut numbers: Vec[i64] = Vec.new();
        for i in 0..self.numbers.len() / 2 {
            numbers.push(Pick.at(i).of(self.numbers[2 * i], self.numbers[2 * i + 1]));
        }
        Round { numbers: numbers }
    }
}

fn min_max_game(nums: Vec[i64]) -> i64 {
    let mut round = Round { numbers: nums.clone() };
    while not round.done() {
        round = round.next();
    }
    round.numbers[0]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then two numbers, rising and falling runs
    // of eight, all equal, and the largest values the constraints allow
    let cases: Vec[Vec[i64]] = [
        [1, 3, 5, 2, 4, 8, 2, 2],
        [3],
        [7, 2],
        [1, 2, 3, 4, 5, 6, 7, 8],
        [8, 7, 6, 5, 4, 3, 2, 1],
        [4, 4, 4, 4],
        [1000000000, 1, 1, 1000000000],
    ];
    for nums in cases.iter() {
        println(f"{nums.len()} numbers: {min_max_game(nums)}");
    }
    // 3000 random arrays of 1 to 1024 numbers, a power of two, from 1 to
    // 10^9
    let mut seed = 2293;
    let mut check = 0;
    let mut sum = 0;
    for _ in 0..3000 {
        let n = 1 << (next_random(mut seed) % 11);
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1);
        }
        let last = min_max_game(nums);
        check = (check * 31 + last) % 1000000007;
        sum += last;
    }
    println(f"3000 arrays: checksum {check}, sum {sum}");
}
