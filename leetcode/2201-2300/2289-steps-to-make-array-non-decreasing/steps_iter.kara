// LeetCode #2289: Steps to Make Array Non-decreasing -- the iterator arm.
// From the right, `fold` a stack of the elements still to be eaten, each
// with the steps its eater needs to reach past it: an element eats every
// smaller one on top of the stack, one step each at least, and as many as
// the eaten one needed. The answer is the most any element needs. O(n).

fn total_steps(nums: Vec[i64]) -> i64 {
    let (_, most) = nums.iter().rev().fold((Vec.new(), 0), |(stack, most): own (Vec[(i64, i64)], i64), x| {
        let mut stack = stack;
        let mut most = most;
        let mut need = 0;
        while stack.len() > 0 and stack[stack.len() - 1].0 < x {
            need = (need + 1).max(stack[stack.len() - 1].1);
            stack.pop();
        }
        most = most.max(need);
        stack.push((x, need));
        (stack, most)
    });
    most
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then one element, all equal, strictly
    // decreasing, a large first element before an increasing run, and a
    // saw of falling runs
    let mut cases: Vec[Vec[i64]] = [
        [5, 3, 4, 4, 7, 3, 6, 11, 8, 5, 11],
        [4, 5, 7, 7, 13],
        [1],
        [7, 7, 7, 7],
        [9, 8, 7, 6, 5, 4, 3, 2, 1],
        [10, 1, 2, 3, 4, 5, 6, 1, 2, 3],
        [5, 4, 3, 6, 5, 4, 7, 6, 5, 8, 1],
    ];
    let mut long: Vec[i64] = [1000000000];
    for i in 1..2000 {
        long.push(i);
    }
    cases.push(long);
    for nums in cases.iter() {
        println(f"{nums.len()} elements: {total_steps(nums)}");
    }
    // 3000 random arrays of 1 to 60 elements from 1 to 1, 2, .. 50
    let mut seed = 2289;
    let mut check = 0;
    let mut sum = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 60 + 1;
        let top = next_random(mut seed) % 50 + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % top + 1);
        }
        let steps = total_steps(nums);
        check = (check * 31 + steps) % 1000000007;
        sum += steps;
    }
    println(f"3000 arrays: checksum {check}, {sum} steps");
}
