// LeetCode #2264: Largest 3-Same-Digit Number in String -- the ★ arm.
// One pass over the bytes: wherever three running are the same digit,
// that digit is a candidate, and the largest is kept. The answer is it
// three times, or "" when there is none. O(n).

fn largest_good_integer(num: String) -> String {
    let b = num.bytes();
    let mut best: Option[u8] = None;
    for i in 2..b.len() {
        if b[i - 2] == b[i] and b[i - 1] == b[i] {
            if best.is_none() or b[i] > best.unwrap() {
                best = Some(b[i]);
            }
        }
    }
    match best {
        Some(d) => (d as char).to_string().repeat(3),
        None => String.new(),
    }
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 2000 numbers of the constraints' longest, 1000 digits, from the
    // first 4 or all 10 in turn; the answer as a number, 1000 for none
    let mut seed = 2264;
    let mut check = 0;
    for t in 0..2000 {
        let digits = if t % 2 == 0 { 4 } else { 10 };
        let mut num = String.new();
        for _ in 0..1000 {
            num.push((b'0' + (next_random(mut seed) % digits) as u8) as char);
        }
        let good = largest_good_integer(num);
        let score = if good.is_empty() { 1000 } else { i64.parse(good).unwrap() };
        check = (check * 31 + score) % 1000000007;
    }
    println(f"2000 numbers of 1000: checksum {check}");
}
