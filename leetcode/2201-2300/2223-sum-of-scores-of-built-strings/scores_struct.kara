// LeetCode #2223: Sum of Scores of Built Strings -- a `struct ZBox`
// holding the letters and the rightmost match [left, right) found so
// far, with `reach` (`ref self`) matching letters from a start, and
// `score` (`mut ref self`) working out z at the next index from the
// box and moving it. O(n).

struct ZBox {
    chars: Vec[char],
    z: Vec[i64],
    left: i64,
    right: i64,
}

impl ZBox {
    fn reach(ref self, i: i64, from: i64) -> i64 {
        let mut k = from;
        while i + k < self.chars.len() and self.chars[k] == self.chars[i + k] {
            k += 1;
        }
        k
    }

    fn score(mut ref self, i: i64) -> i64 {
        let known = if i < self.right { (self.right - i).min(self.z[i - self.left]) } else { 0 };
        let z = self.reach(i, known);
        self.z.push(z);
        if i + z > self.right {
            self.left = i;
            self.right = i + z;
        }
        z
    }
}

fn sum_scores(s: String) -> i64 {
    let chars: Vec[char] = s.chars().collect();
    let n = chars.len();
    let mut zbox = ZBox { chars: chars, z: [n].to_vec(), left: 0, right: 0 };
    let mut total = n;
    for i in 1..n {
        total += zbox.score(i);
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters from the first `letters` of the alphabet
fn draw_word(seed: mut ref i64, n: i64, letters: i64) -> String {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut s = String.new();
    for _ in 0..n {
        s.push(alphabet[next_random(mut seed) % letters]);
    }
    s
}

fn show(s: String) {
    println(f"\"{s}\" -> {sum_scores(s)}");
}

fn main() {
    // LeetCode's two examples, then four more: one letter, one letter
    // throughout, all different, and a repeated pair
    show("babab");
    show("azbazbzaz");
    show("a");
    show("aaaa");
    show("abcd");
    show("abab");
    // 3000 random strings of 1 to 40 letters from 1, 2 and 26 letters in
    // turn
    let mut seed = 2223;
    let mut check = 0;
    for c in 0..3000 {
        let n = next_random(mut seed) % 40 + 1;
        let s = draw_word(mut seed, n, [1, 2, 26][c % 3]);
        check = (check * 31 + sum_scores(s)) % 1000000007;
    }
    println(f"3000 strings: checksum {check}");
    // the constraints' largest: 10^5 of one letter, whose sum passes
    // i32, and 10^5 random from two letters
    let mut same = String.new();
    for _ in 0..100000 {
        same.push('a');
    }
    let wide = draw_word(mut seed, 100000, 2);
    println(f"10^5 alike: {sum_scores(same)}; 10^5 of two letters: {sum_scores(wide)}");
}
