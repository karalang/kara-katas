// LeetCode #2223: Sum of Scores of Built Strings -- each score by
// binary search on its length: a prefix of the suffix at i matches the
// prefix of s when their polynomial hashes agree, under two moduli so
// that a false match is out of reach, each hash read off a table of
// prefix hashes in O(1). O(n log n).

struct Hasher {
    modulus: i64,
    prefix: Vec[i64],
    power: Vec[i64],
}

fn hasher(chars: Vec[char], base: i64, modulus: i64) -> Hasher {
    let n = chars.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    let mut power: Vec[i64] = Vec.filled(n + 1, 1);
    for i in 0..n {
        prefix[i + 1] = (prefix[i] * base + (chars[i] as i64)) % modulus;
        power[i + 1] = power[i] * base % modulus;
    }
    Hasher { modulus: modulus, prefix: prefix, power: power }
}

// the hash of s[from..from + len]
fn hash_of(h: Hasher, from: i64, len: i64) -> i64 {
    let m = h.modulus;
    ((h.prefix[from + len] - h.prefix[from] * h.power[len]) % m + m) % m
}

fn sum_scores(s: String) -> i64 {
    let chars: Vec[char] = s.chars().collect();
    let n = chars.len();
    let a = hasher(chars, 131, 1000000007);
    let b = hasher(chars, 137, 998244353);
    let mut total = n;
    for i in 1..n {
        let mut low = 0;
        let mut high = n - i;
        while low < high {
            let mid = (low + high + 1) / 2;
            if hash_of(a, i, mid) == hash_of(a, 0, mid) and hash_of(b, i, mid) == hash_of(b, 0, mid) {
                low = mid;
            } else {
                high = mid - 1;
            }
        }
        total += low;
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters from the first `letters` of the alphabet
fn draw_word(seed: mut ref i64, n: i64, letters: i64) -> String {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut s = String.new();
    for _ in 0..n {
        s.push(alphabet[next_random(mut seed) % letters]);
    }
    s
}

fn show(s: String) {
    println(f"\"{s}\" -> {sum_scores(s)}");
}

fn main() {
    // LeetCode's two examples, then four more: one letter, one letter
    // throughout, all different, and a repeated pair
    show("babab");
    show("azbazbzaz");
    show("a");
    show("aaaa");
    show("abcd");
    show("abab");
    // 3000 random strings of 1 to 40 letters from 1, 2 and 26 letters in
    // turn
    let mut seed = 2223;
    let mut check = 0;
    for c in 0..3000 {
        let n = next_random(mut seed) % 40 + 1;
        let s = draw_word(mut seed, n, [1, 2, 26][c % 3]);
        check = (check * 31 + sum_scores(s)) % 1000000007;
    }
    println(f"3000 strings: checksum {check}");
    // the constraints' largest: 10^5 of one letter, whose sum passes
    // i32, and 10^5 random from two letters
    let mut same = String.new();
    for _ in 0..100000 {
        same.push('a');
    }
    let wide = draw_word(mut seed, 100000, 2);
    println(f"10^5 alike: {sum_scores(same)}; 10^5 of two letters: {sum_scores(wide)}");
}
