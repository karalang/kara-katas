// LeetCode #2216: Minimum Deletions to Make Array Beautiful -- the iter
// arm: a `fold` over the numbers carrying the pairs made and the first
// number of the pair still open, an `Option`, then the deletions from the
// pairs. O(n).

fn min_deletion(nums: Vec[i64]) -> i64 {
    let (pairs, _) = nums.iter().fold((0, None), |(pairs, open), x| match open {
        None => (pairs, Some(x)),
        Some(first) if first != x => (pairs + 1, None),
        _ => (pairs, open),
    });
    nums.len() - 2 * pairs
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn random_nums(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        nums.push(wide_random(mut seed) % (top + 1));
    }
    nums
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {min_deletion(nums)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number, two alike,
    // already beautiful, and one value throughout
    show([1, 1, 2, 3, 5]);
    show([1, 1, 2, 2, 3, 3]);
    show([7]);
    show([4, 4]);
    show([1, 2, 1, 2]);
    show([9, 9, 9, 9, 9]);
    // 3000 random arrays of 1 to 30 numbers up to 1, 3 and 10^5 in turn
    let mut seed = 2216;
    let mut check = 0;
    for t in 0..3000 {
        let top = [1, 3, 100000][t % 3];
        let n = next_random(mut seed) % 30 + 1;
        check = (check * 31 + min_deletion(random_nums(n, top, mut seed))) % 1000000007;
    }
    println(f"3000 arrays: checksum {check}");
    // the constraints' largest: 10^5 numbers of 0 and 1, then 10^5 alike
    let coin = random_nums(100000, 1, mut seed);
    let same: Vec[i64] = Vec.filled(100000, 5);
    println(f"10^5 of 0 and 1 -> {min_deletion(coin)}, 10^5 alike -> {min_deletion(same)}");
}
