// LeetCode #2287: Rearrange Characters to Make Target String -- the
// iterator arm. For each letter of `target`, `filter` and `count` over
// both strings, and `min` of the quotients. O(|target| * (|s| +
// |target|)).

fn rearrange_characters(s: Str, target: Str) -> i64 {
    target
        .chars()
        .map(|c| s.chars().filter(|x| x == c).count() / target.chars().filter(|x| x == c).count())
        .min()
        .unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn word(len: i64, letters: i64, seed: mut ref i64) -> String {
    let mut w = String.new();
    for _ in 0..len {
        w.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    w
}

fn main() {
    // LeetCode's three examples, then a target longer than `s`, one
    // letter alone, and `s` that is the target ten times over
    let cases = [
        ("ilovecodingonleetcode", "code"),
        ("abcba", "abc"),
        ("abbaccaddaeea", "aaaaa"),
        ("ab", "abc"),
        ("zzzzzzz", "z"),
        ("codecodecodecodecodecodecodecodecodecode", "code"),
    ];
    for (s, target) in cases.iter() {
        println(f"{s} {target} -> {rearrange_characters(s, target)}");
    }
    // 3000 cases: `s` of 1 to 100 letters and `target` of 1 to 10, both
    // from the first 1 to 26 letters
    let mut seed = 2287;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let letters = next_random(mut seed) % 26 + 1;
        let s_len = next_random(mut seed) % 100 + 1;
        let t_len = next_random(mut seed) % 10 + 1;
        let s = word(s_len, letters, mut seed);
        let target = word(t_len, letters, mut seed);
        let answer = rearrange_characters(s, target);
        check = (check * 31 + answer) % 1000000007;
        total += answer;
    }
    println(f"3000 cases: checksum {check}, {total} copies in all");
}
