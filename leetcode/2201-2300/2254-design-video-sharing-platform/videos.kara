// LeetCode #2254: Design Video Sharing Platform -- the videos in a
// `Vec[Option[Video]]` indexed by id, and the ids freed by `remove` in a
// `PriorityQueue`, which pops the smallest first: `upload` takes the
// smallest freed id, or a new slot at the end when none is free. A watch
// cuts `content[start..end + 1]` with the end held to the last minute.
// Every call O(1) but upload and remove, O(log n).

struct Video {
    content: String,
    views: i64,
    likes: i64,
    dislikes: i64,
}

struct Platform {
    slots: Vec[Option[Video]],
    free: PriorityQueue[i64],
}

impl Platform {
    fn new() -> Platform {
        Platform { slots: Vec.new(), free: PriorityQueue.new() }
    }

    fn upload(mut ref self, video: own String) -> i64 {
        let held = Some(Video { content: video, views: 0, likes: 0, dislikes: 0 });
        match self.free.pop() {
            Some(id) => {
                self.slots[id] = held;
                id
            }
            None => {
                self.slots.push(held);
                self.slots.len() - 1
            }
        }
    }

    fn remove(mut ref self, id: i64) {
        if id < self.slots.len() and self.slots[id].is_some() {
            self.slots[id] = None;
            self.free.push(id);
        }
    }

    fn watch(mut ref self, id: i64, start: i64, end: i64) -> String {
        if id >= self.slots.len() {
            return "-1";
        }
        match self.slots[id] {
            Some(mut ref video) => {
                video.views += 1;
                let last = end.min(video.content.len() - 1);
                video.content[start..last + 1].to_string()
            }
            None => "-1",
        }
    }

    fn like(mut ref self, id: i64) {
        if id < self.slots.len() {
            if let Some(mut ref video) = self.slots[id] {
                video.likes += 1;
            }
        }
    }

    fn dislike(mut ref self, id: i64) {
        if id < self.slots.len() {
            if let Some(mut ref video) = self.slots[id] {
                video.dislikes += 1;
            }
        }
    }

    fn get_likes_and_dislikes(ref self, id: i64) -> Vec[i64] {
        if id < self.slots.len() {
            if let Some(video) = self.slots[id] {
                return [video.likes, video.dislikes].to_vec();
            }
        }
        [-1].to_vec()
    }

    fn get_views(ref self, id: i64) -> i64 {
        if id < self.slots.len() {
            if let Some(video) = self.slots[id] {
                return video.views;
            }
        }
        -1
    }
}

fn run(calls: Vec[(i64, Vec[i64], String)]) -> Vec[String] {
    let mut platform = Platform.new();
    let mut answers: Vec[String] = Vec.new();
    for (kind, args, text) in calls.iter() {
        match kind {
            0 => answers.push(f"{platform.upload(text.clone())}"),
            1 => platform.remove(args[0]),
            2 => answers.push(platform.watch(args[0], args[1], args[2])),
            3 => platform.like(args[0]),
            4 => platform.dislike(args[0]),
            5 => answers.push(f"{platform.get_likes_and_dislikes(args[0])}"),
            _ => answers.push(f"{platform.get_views(args[0])}"),
        }
    }
    answers
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a call is (kind, numbers, text): 0 upload(text), 1 remove(id),
// 2 watch(id, start, end), 3 like(id), 4 dislike(id),
// 5 getLikesAndDislikes(id), 6 getViews(id). `count` calls, ids up to one
// past the uploads so far, videos of 3 to `longest` digits, and a watch
// from minute 0 to 2 for 1 to 8 minutes
fn calls_of(count: i64, longest: i64, seed: mut ref i64) -> Vec[(i64, Vec[i64], String)] {
    let mut calls: Vec[(i64, Vec[i64], String)] = Vec.new();
    let mut uploads = 0;
    for _ in 0..count {
        let pick = next_random(mut seed) % 10;
        let id = next_random(mut seed) % (uploads + 2);
        if pick < 3 {
            let length = next_random(mut seed) % (longest - 2) + 3;
            let digits: Vec[String] = (0..length).map(|_| f"{next_random(mut seed) % 10}").collect();
            calls.push((0, Vec.new(), digits.join("")));
            uploads += 1;
        } else if pick == 3 {
            calls.push((1, [id].to_vec(), ""));
        } else if pick < 6 {
            let start = next_random(mut seed) % 3;
            let end = start + next_random(mut seed) % 8 + 1;
            calls.push((2, [id, start, end].to_vec(), ""));
        } else {
            calls.push((pick - 3, [id].to_vec(), ""));
        }
    }
    calls
}

fn tally(answers: Vec[String], check: i64) -> i64 {
    let mut c = check;
    for answer in answers.iter() {
        for b in answer.bytes() {
            c = (c * 131 + b) % 1000000007;
        }
        c = (c * 131 + 1) % 1000000007;
    }
    c
}

fn main() {
    // LeetCode's two examples, then four more: freed ids taken back
    // smallest first, a watch past the end, a video removed twice, and a
    // reused id that starts again from no views, likes or dislikes
    let examples: Vec[Vec[(i64, Vec[i64], String)]] = [
        [(0, Vec.new(), "123"), (0, Vec.new(), "456"), (1, [4].to_vec(), ""), (1, [0].to_vec(), ""), (0, Vec.new(), "789"), (2, [1, 0, 5].to_vec(), ""), (2, [1, 0, 1].to_vec(), ""), (3, [1].to_vec(), ""), (4, [1].to_vec(), ""), (4, [1].to_vec(), ""), (5, [1].to_vec(), ""), (6, [1].to_vec(), "")].to_vec(),
        [(2, [0, 0, 1].to_vec(), ""), (3, [0].to_vec(), ""), (4, [0].to_vec(), ""), (5, [0].to_vec(), ""), (6, [0].to_vec(), "")].to_vec(),
        [(0, Vec.new(), "1"), (0, Vec.new(), "22"), (0, Vec.new(), "333"), (0, Vec.new(), "4444"), (1, [2].to_vec(), ""), (1, [0].to_vec(), ""), (0, Vec.new(), "55"), (0, Vec.new(), "66"), (0, Vec.new(), "77"), (2, [2, 0, 9].to_vec(), "")].to_vec(),
        [(0, Vec.new(), "0123456789"), (2, [0, 7, 100000].to_vec(), ""), (2, [0, 9, 10].to_vec(), ""), (2, [0, 0, 9].to_vec(), ""), (6, [0].to_vec(), "")].to_vec(),
        [(0, Vec.new(), "42"), (1, [0].to_vec(), ""), (1, [0].to_vec(), ""), (5, [0].to_vec(), ""), (6, [0].to_vec(), ""), (0, Vec.new(), "7"), (5, [0].to_vec(), "")].to_vec(),
        [(0, Vec.new(), "900"), (3, [0].to_vec(), ""), (3, [0].to_vec(), ""), (4, [0].to_vec(), ""), (2, [0, 1, 2].to_vec(), ""), (1, [0].to_vec(), ""), (0, Vec.new(), "8"), (5, [0].to_vec(), ""), (6, [0].to_vec(), ""), (2, [0, 0, 3].to_vec(), "")].to_vec(),
    ].to_vec();
    for calls in examples.iter() {
        println(f"{calls} -> {run(calls)}");
    }
    // 3000 platforms of 1 to 30 calls, videos of 3 to 8 digits
    let mut seed = 2254;
    let mut answered = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let count = next_random(mut seed) % 30 + 1;
        let answers = run(calls_of(count, 8, mut seed));
        answered += answers.len();
        check = tally(answers, check);
    }
    println(f"3000 small platforms: {answered} answers, checksum {check}");
    // 4 platforms of 2.5 * 10^4 calls, 10^5 in all as the constraints
    // allow, videos of 3 to 8 digits
    answered = 0;
    check = 0;
    for _ in 0..4 {
        let answers = run(calls_of(25000, 8, mut seed));
        answered += answers.len();
        check = tally(answers, check);
    }
    println(f"4 large platforms: {answered} answers, checksum {check}");
}
