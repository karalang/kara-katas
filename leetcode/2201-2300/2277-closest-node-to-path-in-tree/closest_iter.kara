// LeetCode #2277: Closest Node to Path in Tree -- in chains. Each
// node's neighbours by a `filter` over the edges; every node's distances
// by a search from it, each step's unseen neighbours by `filter`; then
// per query, the nodes that add nothing to the path's length by
// `filter`, and the nearest by `min_by_key`. O(n e + n^2 + q n).

fn distances(n: i64, adj: Vec[Vec[i64]], from: i64) -> Vec[i64] {
    let mut dist: Vec[i64] = Vec.filled(n, -1);
    dist[from] = 0;
    let mut queue: Vec[i64] = [from].to_vec();
    let mut head = 0;
    while head < queue.len() {
        let v = queue[head];
        head += 1;
        let fresh: Vec[i64] = adj[v].iter().filter(|w| dist[w] < 0).cloned().collect();
        for w in fresh {
            dist[w] = dist[v] + 1;
            queue.push(w);
        }
    }
    dist
}

fn closest_node(n: i64, edges: Vec[Vec[i64]], query: Vec[Vec[i64]]) -> Vec[i64] {
    let adj: Vec[Vec[i64]] = (0..n)
        .map(|v| edges.iter().filter(|e| e[0] == v or e[1] == v).map(|e| e[0] + e[1] - v).collect())
        .collect();
    let dist: Vec[Vec[i64]] = (0..n).map(|v| distances(n, adj, v)).collect();
    query
        .iter()
        .map(|q| {
            (0..n)
                .filter(|u| dist[q[0]][u] + dist[u][q[1]] == dist[q[0]][q[1]])
                .min_by_key(|u| dist[u][q[2]])
                .unwrap()
        })
        .collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random tree of `n` nodes, each node joined to one of the `reach`
// before it, then relabelled at random and its edges shuffled
fn tree(seed: mut ref i64, n: i64, reach: i64) -> Vec[Vec[i64]] {
    let mut label: Vec[i64] = (0..n).collect();
    for j in (1..n).rev() {
        let r = next_random(mut seed) % (j + 1);
        label.swap(j, r);
    }
    let mut edges: Vec[Vec[i64]] = Vec.new();
    for i in 1..n {
        let parent = i - 1 - next_random(mut seed) % reach.min(i);
        if next_random(mut seed) % 2 == 0 {
            edges.push([label[i], label[parent]].to_vec());
        } else {
            edges.push([label[parent], label[i]].to_vec());
        }
    }
    for j in (1..edges.len()).rev() {
        let r = next_random(mut seed) % (j + 1);
        edges.swap(j, r);
    }
    edges
}

fn queries(seed: mut ref i64, n: i64, m: i64) -> Vec[Vec[i64]] {
    (0..m).map(|_| [next_random(mut seed) % n, next_random(mut seed) % n, next_random(mut seed) % n].to_vec()).collect()
}

fn main() {
    // LeetCode's three examples, then three more: one node, a path
    // asked both ways, and a star
    let examples = [
        (7, [[0, 1], [0, 2], [0, 3], [1, 4], [2, 5], [2, 6]].to_vec(), [[5, 3, 4], [5, 3, 6]].to_vec()),
        (3, [[0, 1], [1, 2]].to_vec(), [[0, 1, 2]].to_vec()),
        (3, [[0, 1], [1, 2]].to_vec(), [[0, 0, 0]].to_vec()),
        (1, Vec.new(), [[0, 0, 0]].to_vec()),
        (5, [[0, 1], [1, 2], [2, 3], [3, 4]].to_vec(), [[0, 4, 2], [4, 0, 2], [1, 3, 0]].to_vec()),
        (5, [[0, 1], [0, 2], [0, 3], [0, 4]].to_vec(), [[1, 2, 3], [3, 3, 4]].to_vec()),
    ];
    for (n, edges, query) in examples.iter() {
        let edges: Vec[Vec[i64]] = edges.iter().map(|e| e.to_vec()).collect();
        let query: Vec[Vec[i64]] = query.iter().map(|q| q.to_vec()).collect();
        println(f"{n} {edges} {query} -> {closest_node(n, edges, query)}");
    }
    // 500 trees of 1 to 30 nodes, each joined to one of the 1, 3 or all
    // before it, with 1 to 10 queries
    let mut seed = 2277;
    let mut check = 0;
    for t in 0..500 {
        let n = next_random(mut seed) % 30 + 1;
        let edges = tree(mut seed, n, [1, 3, 1000][t % 3]);
        let m = next_random(mut seed) % 10 + 1;
        let query = queries(mut seed, n, m);
        for a in closest_node(n, edges, query).iter() {
            check = (check * 31 + a) % 1000000007;
        }
    }
    println(f"500 trees: checksum {check}");
    // the constraints' largest, 1000 nodes and 1000 queries: a random
    // tree and a path, each answer summed
    let mut sums: Vec[i64] = Vec.new();
    for reach in [1000, 1] {
        let edges = tree(mut seed, 1000, reach);
        let query = queries(mut seed, 1000, 1000);
        sums.push(closest_node(1000, edges, query).iter().sum());
    }
    println(f"1000 nodes: {sums}");
}
