// LeetCode #2244: Minimum Rounds to Complete All Tasks -- the tasks of
// each difficulty counted in a `Map`; a lone task gives -1, any other
// count c takes ceil(c / 3) rounds, summed. O(n).

fn minimum_rounds(tasks: Vec[i64]) -> i64 {
    let mut counts: Map[i64, i64] = Map.new();
    for t in tasks.iter() {
        counts[t] = counts.get(t).unwrap_or(0) + 1;
    }
    let mut rounds = 0;
    for (_, c) in counts.iter() {
        if c == 1 {
            return -1;
        }
        rounds += (c + 2) / 3;
    }
    rounds
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // 40 lists of 10^5 tasks: 3 * 10^4 difficulties up to 10^9, the
    // tasks drawn from them in pairs, so that no task is alone and every
    // difficulty is counted to the end
    let mut seed = 2244;
    let mut check = 0;
    for _ in 0..40 {
        let kinds: Vec[i64] = (0..30000).map(|_| wide_random(mut seed) % 1000000000 + 1).collect();
        let mut tasks: Vec[i64] = Vec.new();
        for _ in 0..50000 {
            let t = kinds[wide_random(mut seed) % 30000];
            tasks.push(t);
            tasks.push(t);
        }
        check = (check * 31 + minimum_rounds(tasks) + 1) % 1000000007;
    }
    println(f"40 lists of 100000 tasks: checksum {check}");
}
