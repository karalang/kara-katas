// LeetCode #2217: Find Palindrome With Fixed Length -- the differential.
// The six arms, against the statement read literally: every number of
// the length tried in order, each written out and checked against its
// reverse, the palindromes listed, and each query the one at its place
// or -1 past the end; no halves. 300 random cases of 1 to 8 queries of
// length 1 to 4, each query up to twice the palindromes of that length;
// then 30 of length 5; then 30 asking for the last palindrome of length
// 1 to 4 and the one after. Every case is drawn before any arm answers.
//
// P1  the answers are the statement read literally
// P2  one answer for each query, each -1 or a palindrome of the length
// P3  the queries reversed: the answers reversed
// P4  each query asked again one higher: -1 or a larger palindrome,
//     and -1 again after a -1
// P5  the partner length (one more for an odd length, one less for an
//     even one) shares the halves: -1 where it is -1, else the same
//     palindrome with its middle digit written once more or once less
// P6  each arm agrees with at least three of the other five


// ---- palindrome.kara: the ★ arm, the half mirrored by arithmetic
fn star_kth_palindrome(queries: Vec[i64], int_length: i64) -> Vec[i64] {
    let half = (int_length + 1) / 2;
    let mut low = 1;
    for _ in 1..half {
        low *= 10;
    }
    let mut answer: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let first = low + q - 1;
        if first >= low * 10 {
            answer.push(-1);
            continue;
        }
        let mut palindrome = first;
        let mut rest = if int_length % 2 == 1 { first / 10 } else { first };
        while rest > 0 {
            palindrome = palindrome * 10 + rest % 10;
            rest /= 10;
        }
        answer.push(palindrome);
    }
    answer
}

// ---- palindrome_string.kara: the half written out and reversed
fn string_kth_palindrome(queries: Vec[i64], int_length: i64) -> Vec[i64] {
    let half = (int_length + 1) / 2;
    let mut low = 1;
    for _ in 1..half {
        low *= 10;
    }
    let mut answer: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let first = low + q - 1;
        let text = first.to_string();
        if text.len() > half {
            answer.push(-1);
            continue;
        }
        let mut whole = text.clone();
        let back: String = text.chars().rev().skip(int_length % 2).collect();
        whole.push_str(back);
        answer.push(i64.parse(whole).unwrap());
    }
    answer
}

// ---- palindrome_digits.kara: q - 1 counted out in the half's digits
fn digits_kth_palindrome(queries: Vec[i64], int_length: i64) -> Vec[i64] {
    let half = (int_length + 1) / 2;
    let mut answer: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let mut left = q - 1;
        let mut digits: Vec[i64] = Vec.filled(int_length, 0);
        for place in (0..half).rev() {
            let digit = if place == 0 { left + 1 } else { left % 10 };
            left /= 10;
            digits[place] = digit;
            digits[int_length - 1 - place] = digit;
        }
        if digits[0] > 9 {
            answer.push(-1);
            continue;
        }
        let mut number = 0;
        for d in digits.iter() {
            number = number * 10 + d;
        }
        answer.push(number);
    }
    answer
}

// ---- palindrome_struct.kara: `Palindromes`, `count` and `nth`
struct Palindromes {
    length: i64,
    low: i64,
}

impl Palindromes {
    fn of(length: i64) -> Palindromes {
        let mut low = 1;
        for _ in 1..(length + 1) / 2 {
            low *= 10;
        }
        Palindromes { length: length, low: low }
    }

    fn count(ref self) -> i64 {
        9 * self.low
    }

    fn nth(ref self, n: i64) -> Option[i64] {
        if n > self.count() {
            return None;
        }
        let first = self.low + n - 1;
        let mut whole = first;
        let mut rest = if self.length % 2 == 1 { first / 10 } else { first };
        while rest > 0 {
            whole = whole * 10 + rest % 10;
            rest /= 10;
        }
        Some(whole)
    }
}

fn struct_kth_palindrome(queries: Vec[i64], int_length: i64) -> Vec[i64] {
    let palindromes = Palindromes.of(int_length);
    let mut answer: Vec[i64] = Vec.new();
    for q in queries.iter() {
        answer.push(palindromes.nth(q).unwrap_or(-1));
    }
    answer
}

// ---- palindrome_iter.kara: `chain`, `rev`, `skip` and `fold`
fn iter_kth_palindrome(queries: Vec[i64], int_length: i64) -> Vec[i64] {
    let half = (int_length + 1) / 2;
    let low = (1..half).fold(1, |p, _| p * 10);
    queries.iter().map(|q| {
        let first = low + q - 1;
        if first >= 10 * low {
            return -1;
        }
        let digits: Vec[char] = first.to_string().chars().collect();
        digits.iter().chain(digits.iter().rev().skip(int_length % 2)).fold(0, |n, c| n * 10 + (c as i64 - '0' as i64))
    }).collect()
}

// ---- palindrome_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn kth_palindrome(queries: Vec[i32], int_length: i32) -> Vec[i64] {
        let half = ((int_length + 1) / 2) as u32;
        let low = 10.pow(half - 1);
        queries
            .iter()
            .map(|q| {
                let first = low + q as i64 - 1;
                if first >= low * 10 {
                    return -1;
                }
                let s = first.to_string();
                let rev: String = s.chars().rev().skip((int_length % 2)).collect();
                i64.parse(f"{s}{rev}").unwrap()
            })
            .collect()
    }
}

struct Solution {}

fn solution_kth_palindrome(queries: Vec[i64], int_length: i64) -> Vec[i64] {
    let queries: Vec[i32] = queries.iter().map(|q| q as i32).collect();
    Solution.kth_palindrome(queries, int_length as i32)
}


// ---- the statement read literally

fn is_palindrome(x: i64) -> bool {
    let text: Vec[char] = x.to_string().chars().collect();
    let n = text.len();
    for i in 0..n {
        if text[i] != text[n - 1 - i] {
            return false;
        }
    }
    true
}

fn literal(queries: Vec[i64], int_length: i64) -> Vec[i64] {
    let mut low = 1;
    for _ in 1..int_length {
        low *= 10;
    }
    let mut listed: Vec[i64] = Vec.new();
    for x in low..10 * low {
        if is_palindrome(x) {
            listed.push(x);
        }
    }
    queries.iter().map(|q| if q <= listed.len() { listed[q - 1] } else { -1 }).collect()
}

fn answer(arm: i64, queries: Vec[i64], int_length: i64) -> Vec[i64] {
    match arm {
        0 => star_kth_palindrome(queries, int_length),
        1 => string_kth_palindrome(queries, int_length),
        2 => digits_kth_palindrome(queries, int_length),
        3 => struct_kth_palindrome(queries, int_length),
        4 => iter_kth_palindrome(queries, int_length),
        _ => solution_kth_palindrome(queries, int_length),
    }
}

// the palindrome of the partner length with the same half
fn partner(p: i64, int_length: i64) -> i64 {
    if p == -1 {
        return -1;
    }
    let text: Vec[char] = p.to_string().chars().collect();
    let half = (int_length + 1) / 2;
    let mut out = String.new();
    for i in 0..text.len() {
        out.push(text[i]);
        if i == half - 1 and int_length % 2 == 1 {
            out.push(text[i]);
        }
        if i == half - 1 and int_length % 2 == 0 {
            // the even length's middle pair becomes one digit
            for j in (i + 2)..text.len() {
                out.push(text[j]);
            }
            break;
        }
    }
    i64.parse(out).unwrap()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Case {
    queries: Vec[i64],
    length: i64,
}

fn main() {
    let names = ["star", "string", "digits", "struct", "iter", "solution"];
    let mut seed = 2217;
    let mut cases: Vec[Case] = Vec.new();
    for c in 0..360 {
        let length = if c < 300 { next_random(mut seed) % 4 + 1 } else if c < 330 { 5 } else { c % 4 + 1 };
        let mut count = 9;
        for _ in 0..(length - 1) / 2 {
            count *= 10;
        }
        let mut queries: Vec[i64] = Vec.new();
        if c < 330 {
            let k = next_random(mut seed) % 8 + 1;
            for _ in 0..k {
                queries.push(next_random(mut seed) % (2 * count) + 1);
            }
        } else {
            queries.push(count);
            queries.push(count + 1);
        }
        cases.push(Case { queries: queries, length: length });
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for case in cases.iter() {
        let queries = ref case.queries;
        let length = case.length;
        let truth = literal(queries, length);
        for p in truth.iter() {
            check = (check * 31 + p + 1) % 1000000007;
        }
        let reversed: Vec[i64] = queries.iter().rev().collect();
        let higher: Vec[i64] = queries.iter().map(|q| q + 1).collect();
        let other = if length % 2 == 1 { length + 1 } else { length - 1 };
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, queries, length)).collect();
        for arm in 0..6 {
            let ps = ref got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == *ps {
                    same += 1;
                }
            }
            let mut sound = ps.len() == queries.len();
            if sound {
                for p in ps.iter() {
                    if p != -1 and (not is_palindrome(p) or p.to_string().len() != length) {
                        sound = false;
                    }
                }
            }
            let back: Vec[i64] = answer(arm, reversed, length).iter().rev().collect();
            let up = answer(arm, higher, length);
            let mut rising = up.len() == ps.len();
            if rising {
                for i in 0..ps.len() {
                    if not (up[i] == -1 or (ps[i] != -1 and up[i] > ps[i])) {
                        rising = false;
                    }
                }
            }
            let mut shared = true;
            if other >= 1 {
                let partners = answer(arm, queries, other);
                if partners.len() != ps.len() {
                    shared = false;
                } else {
                    for i in 0..ps.len() {
                        if partners[i] != partner(ps[i], length) {
                            shared = false;
                        }
                    }
                }
            }
            let verdicts = [
                *ps == truth,
                sound,
                back == *ps,
                rising,
                shared,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{queries} of length {length} arm {names[arm]}: P{q + 1} fails, gave {ps}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
