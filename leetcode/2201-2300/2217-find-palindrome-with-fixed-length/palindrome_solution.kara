// LeetCode #2217: Find Palindrome With Fixed Length -- LeetCode's Rust
// template: a `Vec<i32>` and an `i32` in, `Vec<i64>` out, the smallest
// half by `10_i64.pow(half - 1)` with `half` a `u32`, and each answer
// the half's `to_string` followed by its characters reversed, the middle
// skipped by `skip(.. as usize)`, through `format!` and
// `parse::<i64>().unwrap()`. Carried by `karac fix`. The adapter below
// hands the harness's values to it.

impl Solution {
    pub fn kth_palindrome(queries: Vec[i32], int_length: i32) -> Vec[i64] {
        let half = ((int_length + 1) / 2) as u32;
        let low = 10.pow(half - 1);
        queries
            .iter()
            .map(|q| {
                let first = low + q as i64 - 1;
                if first >= low * 10 {
                    return -1;
                }
                let s = first.to_string();
                let rev: String = s.chars().rev().skip((int_length % 2)).collect();
                i64.parse(f"{s}{rev}").unwrap()
            })
            .collect()
    }
}

struct Solution {}

fn kth_palindrome(queries: Vec[i64], int_length: i64) -> Vec[i64] {
    let queries: Vec[i32] = queries.iter().map(|q| q as i32).collect();
    Solution.kth_palindrome(queries, int_length as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw of 30 bits, since one draw stops at 32767
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn show(queries: Vec[i64], int_length: i64) {
    println(f"{queries} of length {int_length} -> {kth_palindrome(queries, int_length)}");
}

fn main() {
    // LeetCode's two examples, then four more: length 1 to its end and
    // past it, length 2, the last of length 15, and 10^9
    show([1, 2, 3, 4, 5, 90], 3);
    show([2, 4, 6], 4);
    show([1, 9, 10], 1);
    show([1, 9, 10], 2);
    show([90000000, 90000001], 15);
    show([1000000000, 1], 15);
    // 3000 random cases of 1 to 20 queries of length 1 to 15, each query
    // up to twice the palindromes of that length, and at most 10^9
    let mut seed = 2217;
    let mut check = 0;
    for _ in 0..3000 {
        let int_length = next_random(mut seed) % 15 + 1;
        let k = next_random(mut seed) % 20 + 1;
        let mut count = 9;
        for _ in 0..(int_length - 1) / 2 {
            count *= 10;
        }
        let mut queries: Vec[i64] = Vec.new();
        for _ in 0..k {
            queries.push(wide_random(mut seed) % (2 * count).min(1000000000) + 1);
        }
        for p in kth_palindrome(queries, int_length) {
            check = (check * 31 + p + 1) % 1000000007;
        }
    }
    println(f"3000 cases: checksum {check}");
    // the constraints' largest: 5 * 10^4 queries of length 15 up to 10^9,
    // and 5 * 10^4 of length 14 counting up from 1
    let mut wide: Vec[i64] = Vec.new();
    let mut counting: Vec[i64] = Vec.new();
    for i in 0..50000 {
        wide.push(wide_random(mut seed) % 1000000000 + 1);
        counting.push(i + 1);
    }
    let long = kth_palindrome(wide, 15);
    let found = long.iter().filter(|p| p != -1).count();
    let total = long.iter().filter(|p| p != -1).map(|p| p % 1000000007).sum() % 1000000007;
    let even = kth_palindrome(counting, 14);
    println(f"5 * 10^4 of length 15: {found} found, sum {total}; 5 * 10^4 of length 14: last {even[49999]}");
}
