// LeetCode #2263: Make Array Non-decreasing or Non-increasing -- the
// differential. The six arms, against the statement read literally:
// every non-decreasing and every non-increasing target array whose
// values lie from 0 to the largest value, built a position at a time,
// the cost of each the sum of its distances, the least kept; no heap,
// no candidate values. 300 random arrays of 1 to 7 values from 0 to 1,
// 2, 3 or 5; then 30 already sorted, half rising and half falling; then
// 30 of one value with one position changed. Every case is drawn before
// any arm answers.
//
// P1  the cost is the literal reading's
// P2  the array reversed: the same cost
// P3  every value v made 10 - v: the same cost
// P4  1000 added to every value: the same cost
// P5  no more than the cost of making every value the median, and 0
//     exactly when the array is already sorted one way or the other
// P6  each arm agrees with at least three of the other five

// ---- convert.kara: the ★ arm, the slope trick on a max-first heap
fn star_nondecreasing_cost(nums: Vec[i64]) -> i64 {
    let mut heap: PriorityQueue[i64] = PriorityQueue.max_first();
    let mut cost = 0;
    for x in nums.iter() {
        heap.push(x);
        if heap.peek().unwrap() > x {
            cost += heap.pop().unwrap() - x;
            heap.push(x);
        }
    }
    cost
}

fn star_convert_array(nums: Vec[i64]) -> i64 {
    let reversed: Vec[i64] = nums.iter().rev().collect();
    star_nondecreasing_cost(nums).min(star_nondecreasing_cost(reversed))
}

// ---- convert_dp.kara: costs per candidate value, rising and falling
fn dp_convert_array(nums: Vec[i64]) -> i64 {
    let mut values = nums.clone();
    values.sort();
    values.dedup();
    let m = values.len();
    let mut up = Vec.filled(m, 0);
    let mut down = Vec.filled(m, 0);
    for x in nums.iter() {
        let mut best = up[0];
        for j in 0..m {
            best = best.min(up[j]);
            up[j] = best + (x - values[j]).abs();
        }
        let mut best = down[m - 1];
        for j in (0..m).rev() {
            best = best.min(down[j]);
            down[j] = best + (x - values[j]).abs();
        }
    }
    let lowest_up = up.iter().min().unwrap();
    let lowest_down = down.iter().min().unwrap();
    lowest_up.min(lowest_down)
}

// ---- convert_sorted.kara: the slope trick on a sorted `Vec`
fn sorted_insert_sorted(pinned: mut ref Vec[i64], x: i64) {
    let mut lo = 0;
    let mut hi = pinned.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if pinned[mid] <= x {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    pinned.insert(lo, x);
}

fn sorted_cost_from_left(nums: Vec[i64]) -> i64 {
    let mut pinned: Vec[i64] = Vec.new();
    let mut cost = 0;
    for x in nums.iter() {
        sorted_insert_sorted(mut pinned, x);
        let top = pinned[pinned.len() - 1];
        if top > x {
            cost += top - x;
            pinned.pop();
            sorted_insert_sorted(mut pinned, x);
        }
    }
    cost
}

fn sorted_convert_array(nums: Vec[i64]) -> i64 {
    let mut reversed = nums.clone();
    reversed.reverse();
    sorted_cost_from_left(nums).min(sorted_cost_from_left(reversed))
}

// ---- convert_struct.kara: `struct Slope`, fed the values and their negations
struct StructSlope {
    pinned: PriorityQueue[i64],
    cost: i64,
}

impl StructSlope {
    fn new() -> StructSlope {
        StructSlope { pinned: PriorityQueue.max_first(), cost: 0 }
    }

    fn feed(mut ref self, x: i64) {
        self.pinned.push(x);
        let top = self.pinned.peek().unwrap();
        if top > x {
            self.cost += top - x;
            self.pinned.pop();
            self.pinned.push(x);
        }
    }
}

fn struct_convert_array(nums: Vec[i64]) -> i64 {
    let mut rising = StructSlope.new();
    let mut falling = StructSlope.new();
    for x in nums.iter() {
        rising.feed(x);
        falling.feed(-x);
    }
    rising.cost.min(falling.cost)
}

// ---- convert_iter.kara: a `fold` of `scan`s over the candidates
fn iter_cheapest(nums: Vec[i64], values: Vec[i64]) -> i64 {
    let start: Vec[i64] = values.iter().map(|_| 0).collect();
    nums.iter()
        .fold(start, |costs, x| {
            values.iter()
                .zip(costs.iter())
                .scan(costs[0], |best, (v, c)| {
                    let best = best.min(c);
                    Some((best, best + (x - v).abs()))
                })
                .collect()
        })
        .iter()
        .min()
        .unwrap()
}

fn iter_convert_array(nums: Vec[i64]) -> i64 {
    let mut values = nums.clone();
    values.sort();
    values.dedup();
    let falling: Vec[i64] = values.iter().rev().collect();
    iter_cheapest(nums, values).min(iter_cheapest(nums, falling))
}

// ---- convert_solution.kara: LeetCode's Rust template
impl Solution {
    pub fn convert_array(nums: Vec[i32]) -> i32 {
        let cost = |v: ref Vec[i32]| {
            let mut pq = PriorityQueue.max_first();
            let mut ans: i32 = 0;
            for x in v {
                if let Some(t) = pq.peek().cloned() {
                    if t > x {
                        ans += t - x;
                        pq.pop();
                        pq.push(x);
                    }
                }
                pq.push(x);
            }
            ans
        };
        let mut r = nums.clone();
        r.reverse();
        cost(nums).min(cost(r))
    }
}

struct Solution {}

fn solution_convert_array(nums: Vec[i64]) -> i64 {
    let values: Vec[i32] = nums.iter().map(|v| v as i32).collect();
    Solution.convert_array(values)
}


// ---- the statement read literally

// the least cost of the targets from position `i` on, each value no
// less than `low` and no more than `high`, rising or falling
fn targets(nums: Vec[i64], i: i64, low: i64, high: i64, rising: bool) -> i64 {
    if i == nums.len() {
        return 0;
    }
    let mut best = -1;
    for t in low..high + 1 {
        let rest = if rising {
            targets(nums, i + 1, t, high, rising)
        } else {
            targets(nums, i + 1, low, t, rising)
        };
        let cost = (nums[i] - t).abs() + rest;
        if best < 0 or cost < best {
            best = cost;
        }
    }
    best
}

fn literal(nums: Vec[i64]) -> i64 {
    let mut largest = 0;
    for x in nums.iter() {
        if x > largest {
            largest = x;
        }
    }
    let up = targets(nums, 0, 0, largest, true);
    let down = targets(nums, 0, 0, largest, false);
    if up < down { up } else { down }
}

fn sorted_one_way(nums: Vec[i64]) -> bool {
    let mut up = true;
    let mut down = true;
    for i in 1..nums.len() {
        if nums[i] < nums[i - 1] {
            up = false;
        }
        if nums[i] > nums[i - 1] {
            down = false;
        }
    }
    up or down
}

fn to_median(nums: Vec[i64]) -> i64 {
    let mut s = nums.clone();
    s.sort();
    let m = s[s.len() / 2];
    let mut total = 0;
    for x in nums.iter() {
        total += (x - m).abs();
    }
    total
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_convert_array(nums),
        1 => dp_convert_array(nums),
        2 => sorted_convert_array(nums),
        3 => struct_convert_array(nums),
        4 => iter_convert_array(nums),
        _ => solution_convert_array(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "dp", "sorted", "struct", "iter", "solution"];
    let mut seed = 2263;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..360 {
        let len = next_random(mut seed) % 7 + 1;
        let mut nums: Vec[i64] = Vec.new();
        if c < 300 {
            let top = [1, 2, 3, 5][c % 4];
            for _ in 0..len {
                nums.push(next_random(mut seed) % (top + 1));
            }
        } else if c < 330 {
            for _ in 0..len {
                nums.push(next_random(mut seed) % 6);
            }
            nums.sort();
            if c % 2 == 1 {
                nums.reverse();
            }
        } else {
            let v = next_random(mut seed) % 6;
            for _ in 0..len {
                nums.push(v);
            }
            let at = next_random(mut seed) % len;
            nums[at] = next_random(mut seed) % 6;
        }
        cases.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for nums in cases.iter() {
        let truth = literal(nums);
        check = (check * 31 + truth) % 1000000007;
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let mirrored: Vec[i64] = nums.iter().map(|x| 10 - x).collect();
        let raised: Vec[i64] = nums.iter().map(|x| x + 1000).collect();
        let ceiling = to_median(nums);
        let sorted = sorted_one_way(nums);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, reversed) == value,
                answer(arm, mirrored) == value,
                answer(arm, raised) == value,
                value >= 0 and value <= ceiling and (value == 0) == sorted,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
