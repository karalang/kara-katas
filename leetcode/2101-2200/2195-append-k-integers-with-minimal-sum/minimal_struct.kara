// LeetCode #2195: Append K Integers With Minimal Sum -- a `struct Gaps`
// that walks the sorted numbers and `impl Iterator` for it, each `next`
// the next run of missing numbers as a `Gap` of its first and last (the
// last run open to the top); the runs taken from the front, each cut to
// what is still wanted and added by the sum of an arithmetic series.
// O(n log n).

struct Gap {
    first: i64,
    last: i64,
}

impl Gap {
    fn len(ref self) -> i64 {
        self.last - self.first + 1
    }
}

struct Gaps {
    sorted: Vec[i64],
    at: i64,
    seen: i64,
}

impl Iterator for Gaps {
    type Item = Gap;

    fn next(mut ref self) -> Option[Gap] {
        while self.at < self.sorted.len() {
            let x = self.sorted[self.at];
            self.at += 1;
            if x > self.seen + 1 {
                let gap = Gap { first: self.seen + 1, last: x - 1 };
                self.seen = x;
                return Some(gap);
            }
            if x > self.seen {
                self.seen = x;
            }
        }
        if self.at == self.sorted.len() {
            self.at += 1;
            return Some(Gap { first: self.seen + 1, last: i64.MAX / 4 });
        }
        None
    }
}

fn minimal_k_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let gaps = Gaps { sorted: sorted, at: 0, seen: 0 };
    let mut wanted = k;
    let mut sum = 0;
    for gap in gaps {
        if wanted == 0 {
            break;
        }
        let take = if gap.len() < wanted { gap.len() } else { wanted };
        sum += (gap.first + gap.first + take - 1) * take / 2;
        wanted -= take;
    }
    sum
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn big_random(seed: mut ref i64) -> i64 {
    let a = next_random(mut seed);
    let b = next_random(mut seed);
    a * 32768 + b
}

fn show(nums: Vec[i64], k: i64) {
    println(f"{nums}, {k} -> {minimal_k_sum(nums, k)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number, the numbers
    // 1 to 5 already there, repeats, and the constraints' largest
    show([1, 4, 25, 10, 25].to_vec(), 2);
    show([5, 6].to_vec(), 6);
    show([1].to_vec(), 1);
    show([3, 1, 2, 5, 4].to_vec(), 3);
    show([2, 2, 2, 7, 7].to_vec(), 4);
    show([1000000000].to_vec(), 100000000);
    // 3000 random cases of 1 to 30 numbers below 10, 100 and 10^9 in
    // turn, with k from 1 to 50, 1000 and 10^8
    let mut seed = 2195;
    let mut check = 0;
    for round in 0..3000 {
        let n = next_random(mut seed) % 30 + 1;
        let top = [10, 100, 1000000000][round % 3];
        let reach = [50, 1000, 100000000][(round / 3) % 3];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(big_random(mut seed) % top + 1);
        }
        let k = big_random(mut seed) % reach + 1;
        check = (check * 31 + minimal_k_sum(nums, k) % 1000000007) % 1000000007;
    }
    println(f"3000 cases: checksum {check}");
    // the constraints' longest, 10^5 numbers below 10^9 and k = 10^8;
    // and 10^5 numbers 1 to 10^5 shuffled, k = 1
    let mut wide: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        wide.push(big_random(mut seed) % 1000000000 + 1);
    }
    let mut full: Vec[i64] = Vec.new();
    for i in 0..100000 {
        full.push(i + 1);
    }
    for i in (1..100000).rev() {
        let j = big_random(mut seed) % (i + 1);
        full.swap(i, j);
    }
    println(f"10^5 numbers: {minimal_k_sum(wide, 100000000)} {minimal_k_sum(full, 1)}");
}
