// LeetCode #2195: Append K Integers With Minimal Sum -- the differential.
// The six arms, against the statement read literally: the positive
// numbers counted up from 1, each one the list does not hold appended,
// until k are; no series and no sort. 300 random cases of 1 to 10
// numbers of 1 to 20, k from 1 to 30; then 30 where the list is 1 to m
// shuffled; then 30 of numbers up to 10^9 with k from 70000 to 99999,
// whose sums pass 2^31. Every case is drawn before any arm answers.
//
// P1  the sum is the statement read literally
// P2  the sum lies between 1 + .. + k and that plus k times the count of
//     distinct numbers
// P3  every number listed twice: the same sum
// P4  the list reversed: the same sum
// P5  k one more: the sum grows by a number the list does not hold,
//     larger than the growth from k - 1 to k
// P6  each arm agrees with at least three of the other five

// ---- minimal.kara: the ★ arm, the gaps walked, each a series
fn star_run_sum(from: i64, to: i64) -> i64 {
    (from + to) * (to - from + 1) / 2
}

fn star_minimal_k_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut wanted = k;
    let mut sum = 0;
    let mut last = 0;
    for x in sorted.iter() {
        if x > last + 1 and wanted > 0 {
            let take = if x - last - 1 < wanted { x - last - 1 } else { wanted };
            sum += star_run_sum(last + 1, last + take);
            wanted -= take;
        }
        if x > last {
            last = x;
        }
    }
    if wanted > 0 {
        sum += star_run_sum(last + 1, last + wanted);
    }
    sum
}

// ---- minimal_bump.kara: 1 to k, bumped past each number in a `SortedSet`
fn bump_minimal_k_sum(nums: Vec[i64], k: i64) -> i64 {
    let distinct: SortedSet[i64] = nums.iter().collect();
    let mut top = k;
    let mut sum = k * (k + 1) / 2;
    for x in distinct.iter() {
        if x > top {
            break;
        }
        top += 1;
        sum += top - x;
    }
    sum
}

// ---- minimal_search.kara: the largest appended by binary search
fn search_minimal_k_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut d = nums.clone();
    d.sort();
    d.dedup();
    let mut prefix: Vec[i64] = [0].to_vec();
    for x in d.iter() {
        prefix.push(prefix[prefix.len() - 1] + x);
    }
    let missing = |x: i64| x - d.partition_point(|v| v <= x);
    let mut lo = k;
    let mut hi = k + d.len();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if missing(mid) >= k {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    let inside = d.partition_point(|v| v <= lo);
    lo * (lo + 1) / 2 - prefix[inside]
}

// ---- minimal_struct.kara: `Gaps`, an `impl Iterator` of `Gap`s
struct Gap {
    first: i64,
    last: i64,
}

impl Gap {
    fn len(ref self) -> i64 {
        self.last - self.first + 1
    }
}

struct Gaps {
    sorted: Vec[i64],
    at: i64,
    seen: i64,
}

impl Iterator for Gaps {
    type Item = Gap;

    fn next(mut ref self) -> Option[Gap] {
        while self.at < self.sorted.len() {
            let x = self.sorted[self.at];
            self.at += 1;
            if x > self.seen + 1 {
                let gap = Gap { first: self.seen + 1, last: x - 1 };
                self.seen = x;
                return Some(gap);
            }
            if x > self.seen {
                self.seen = x;
            }
        }
        if self.at == self.sorted.len() {
            self.at += 1;
            return Some(Gap { first: self.seen + 1, last: i64.MAX / 4 });
        }
        None
    }
}

fn struct_minimal_k_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let gaps = Gaps { sorted: sorted, at: 0, seen: 0 };
    let mut wanted = k;
    let mut sum = 0;
    for gap in gaps {
        if wanted == 0 {
            break;
        }
        let take = if gap.len() < wanted { gap.len() } else { wanted };
        sum += (gap.first + gap.first + take - 1) * take / 2;
        wanted -= take;
    }
    sum
}

// ---- minimal_iter.kara: `windows(2)`, `scan`, `sum`
fn iter_minimal_k_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut bounds: Vec[i64] = once(0).chain(nums.iter().cloned()).collect();
    bounds.sort();
    bounds.dedup();
    let top = bounds[bounds.len() - 1];
    let taken: Vec[(i64, i64)] = bounds
        .windows(2)
        .into_iter()
        .scan(k, |wanted, w| {
            let gap = w[1] - w[0] - 1;
            let take = if gap < wanted { gap } else { wanted };
            Some((wanted - take, (take, (w[0] + 1 + w[0] + take) * take / 2)))
        })
        .collect();
    let used: i64 = taken.iter().map(|(t, _)| t).sum();
    let inside: i64 = taken.iter().map(|(_, s)| s).sum();
    let rest = k - used;
    inside + (top + 1 + top + rest) * rest / 2
}

// ---- minimal_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn minimal_k_sum(nums: own Vec[i32], k: i32) -> i64 {
        let mut nums = nums;
        nums.sort();
        nums.dedup();
        let mut top = k as i64;
        let mut ans: i64 = top * (top + 1) / 2;
        for x in ref nums {
            let x = x as i64;
            if x > top {
                break;
            }
            top += 1;
            ans += top - x;
        }
        ans
    }
}

struct Solution {}

fn solution_minimal_k_sum(nums: Vec[i64], k: i64) -> i64 {
    let narrow: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.minimal_k_sum(narrow, k as i32)
}

// ---- the statement read literally

fn literal(nums: Vec[i64], k: i64) -> i64 {
    let held: Set[i64] = nums.iter().collect();
    let mut sum = 0;
    let mut appended = 0;
    let mut x = 0;
    while appended < k {
        x += 1;
        if not held.contains(x) {
            sum += x;
            appended += 1;
        }
    }
    sum
}

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_minimal_k_sum(nums, k),
        1 => bump_minimal_k_sum(nums, k),
        2 => search_minimal_k_sum(nums, k),
        3 => struct_minimal_k_sum(nums, k),
        4 => iter_minimal_k_sum(nums, k),
        _ => solution_minimal_k_sum(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "bump", "search", "struct", "iter", "solution"];
    let mut seed = 2195;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for c in 0..360 {
        let mut nums: Vec[i64] = Vec.new();
        if c < 300 {
            let n = next_random(mut seed) % 10 + 1;
            for _ in 0..n {
                nums.push(next_random(mut seed) % 20 + 1);
            }
        } else if c < 330 {
            let m = next_random(mut seed) % 12 + 1;
            for v in 1..=m {
                nums.push(v);
            }
            for i in (1..nums.len()).rev() {
                let j = next_random(mut seed) % (i + 1);
                nums.swap(i, j);
            }
        } else {
            let n = next_random(mut seed) % 10 + 1;
            for _ in 0..n {
                nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1);
            }
        }
        let k = if c >= 330 { next_random(mut seed) % 30000 + 70000 } else { next_random(mut seed) % 30 + 1 };
        cases.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (nums, k) in cases.iter() {
        let truth = literal(nums, k);
        check = (check * 31 + truth % 1000000007 + k) % 1000000007;
        let held: Set[i64] = nums.iter().collect();
        let base = k * (k + 1) / 2;
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        let mut twice = nums.clone();
        for v in nums.iter() {
            twice.push(v);
        }
        let reversed: Vec[i64] = nums.iter().rev().collect();
        for arm in 0..6 {
            let sum = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == sum {
                    same += 1;
                }
            }
            let grown = answer(arm, nums, k + 1) - sum;
            let before = if k > 1 { sum - answer(arm, nums, k - 1) } else { 0 };
            let verdicts = [
                sum == truth,
                sum >= base and sum <= base + k * held.len(),
                answer(arm, twice, k) == sum,
                answer(arm, reversed, k) == sum,
                grown >= 1 and not held.contains(grown) and grown > before,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums}, {k} arm {names[arm]}: P{q + 1} fails, answered {sum}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
