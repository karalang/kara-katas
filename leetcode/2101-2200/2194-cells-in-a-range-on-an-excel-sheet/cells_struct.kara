// LeetCode #2194: Cells in a Range on an Excel Sheet -- a `struct Cell`
// of a column letter and a row number, written by an `impl Display`, and
// a `struct Corners` of two corner cells, read by `parse` from the range
// and walked by `cells` (`ref self`), column by column. O(cells).

struct Cell {
    col: char,
    row: i64,
}

impl Display for Cell {
    fn to_string(ref self) -> String {
        f"{self.col}{self.row}"
    }
}

struct Corners {
    from: Cell,
    to: Cell,
}

impl Corners {
    fn parse(s: String) -> Corners {
        let b: Vec[u8] = s.bytes().to_vec();
        Corners {
            from: Cell { col: b[0] as char, row: b[1] - 48 },
            to: Cell { col: b[3] as char, row: b[4] - 48 },
        }
    }

    fn cells(ref self) -> Vec[Cell] {
        let mut out: Vec[Cell] = Vec.new();
        for col in self.from.col..=self.to.col {
            for row in self.from.row..=self.to.row {
                out.push(Cell { col: col, row: row });
            }
        }
        out
    }
}

fn cells_in_range(s: String) -> Vec[String] {
    Corners.parse(s).cells().iter().map(|c| c.to_string()).collect()
}

// ---- test harness ---------------------------------------------------------

fn show(s: String) {
    println(f"{s} -> {cells_in_range(s)}");
}

fn main() {
    // LeetCode's two examples, then four more: one cell, one column, one
    // row, and the whole sheet's corners
    show("K1:L2");
    show("A1:F1");
    show("C7:C7");
    show("Z1:Z9");
    show("B5:E5");
    show("A1:Z9");
    // every range there is: each pair of columns A to Z with each pair of
    // rows 1 to 9
    let letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let mut ranges = 0;
    let mut cells = 0;
    let mut check = 0;
    for c1 in 0..26 {
        for c2 in c1..26 {
            for r1 in 1..10 {
                for r2 in r1..10 {
                    let s = f"{letters[c1..(c1 + 1)]}{r1}:{letters[c2..(c2 + 1)]}{r2}";
                    let got = cells_in_range(s);
                    ranges += 1;
                    cells += got.len();
                    for cell in got.iter() {
                        for b in cell.bytes().iter() {
                            check = (check * 31 + b) % 1000000007;
                        }
                    }
                }
            }
        }
    }
    println(f"{ranges} ranges: {cells} cells, checksum {check}");
}
