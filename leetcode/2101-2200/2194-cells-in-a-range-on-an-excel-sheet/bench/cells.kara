// benchmark copy of cells.kara (LeetCode #2194, the ★ arm): two loops
// over the range's bytes. See ../README.md § Benchmarks.

fn cells_in_range(s: String) -> Vec[String] {
    let b: Vec[u8] = s.bytes().to_vec();
    let mut cells: Vec[String] = Vec.new();
    for col in b[0]..=b[3] {
        for row in b[1]..=b[4] {
            cells.push(String.from_utf8([col, row].to_vec()).unwrap());
        }
    }
    cells
}

fn main() {
    let letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let mut ranges: Vec[String] = Vec.new();
    for c1 in 0..26 {
        for c2 in c1..26 {
            for r1 in 1..10 {
                for r2 in r1..10 {
                    ranges.push(f"{letters[c1..(c1 + 1)]}{r1}:{letters[c2..(c2 + 1)]}{r2}");
                }
            }
        }
    }
    let mut check = 0;
    for _ in 0..20 {
        for s in ranges.iter() {
            let cells = cells_in_range(s);
            let last: Vec[u8] = cells[cells.len() - 1].bytes().to_vec();
            check = (check * 31 + cells.len() * 1000 + last[0] as i64 * 10 + last[1]) % 1000000007;
        }
    }
    println(f"20 passes over {ranges.len()} ranges: checksum {check}");
}
