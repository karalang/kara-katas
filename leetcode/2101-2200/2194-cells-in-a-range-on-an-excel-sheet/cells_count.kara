// LeetCode #2194: Cells in a Range on an Excel Sheet -- the cells counted
// first, columns times rows, and each one made from its index alone: the
// index divided by the rows gives the column, the remainder the row, each
// added to the corner's byte. `Vec.from_fn` builds the list. O(cells).

fn cells_in_range(s: String) -> Vec[String] {
    let b: Vec[u8] = s.bytes().to_vec();
    let cols = (b[3] - b[0] + 1) as i64;
    let rows = (b[4] - b[1] + 1) as i64;
    Vec.from_fn(cols * rows, |i| {
        let col = b[0] + (i / rows) as u8;
        let row = b[1] + (i % rows) as u8;
        String.from_utf8([col, row].to_vec()).unwrap()
    })
}

// ---- test harness ---------------------------------------------------------

fn show(s: String) {
    println(f"{s} -> {cells_in_range(s)}");
}

fn main() {
    // LeetCode's two examples, then four more: one cell, one column, one
    // row, and the whole sheet's corners
    show("K1:L2");
    show("A1:F1");
    show("C7:C7");
    show("Z1:Z9");
    show("B5:E5");
    show("A1:Z9");
    // every range there is: each pair of columns A to Z with each pair of
    // rows 1 to 9
    let letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let mut ranges = 0;
    let mut cells = 0;
    let mut check = 0;
    for c1 in 0..26 {
        for c2 in c1..26 {
            for r1 in 1..10 {
                for r2 in r1..10 {
                    let s = f"{letters[c1..(c1 + 1)]}{r1}:{letters[c2..(c2 + 1)]}{r2}";
                    let got = cells_in_range(s);
                    ranges += 1;
                    cells += got.len();
                    for cell in got.iter() {
                        for b in cell.bytes().iter() {
                            check = (check * 31 + b) % 1000000007;
                        }
                    }
                }
            }
        }
    }
    println(f"{ranges} ranges: {cells} cells, checksum {check}");
}
