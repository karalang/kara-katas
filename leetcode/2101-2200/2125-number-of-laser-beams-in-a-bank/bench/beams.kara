// LeetCode #2125: Number of Laser Beams in a Bank -- the benchmark,
// beams.kara's ★ arm. 12 banks of 500 rows of 500 cells built once, each
// cell a device with chance a quarter, a half or three quarters in turn;
// then every bank solved 500 times, one cell flipped before each solve.

fn number_of_beams(bank: Vec[String]) -> i64 {
    let mut prev = 0;
    let mut beams = 0;
    for row in bank.iter() {
        let devices = row.bytes().iter().filter(|c| c == b'1').count();
        if devices > 0 {
            beams += prev * devices;
            prev = devices;
        }
    }
    beams
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2125;
    let mut banks: Vec[Vec[String]] = Vec.new();
    for b in 0..12 {
        let mut bank: Vec[String] = Vec.new();
        for _ in 0..500 {
            let mut cells: Vec[u8] = Vec.new();
            for _ in 0..500 {
                cells.push(if next_random(mut seed) % 4 < b % 3 + 1 { b'1' } else { b'0' });
            }
            bank.push(String.from_utf8(cells).unwrap());
        }
        banks.push(bank);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..500 {
        for b in 0..12 {
            let r = next_random(mut seed) % 500;
            let c = next_random(mut seed) % 500;
            let mut cells = banks[b][r].bytes().to_vec();
            cells[c] = if cells[c] == b'1' { b'0' } else { b'1' };
            banks[b][r] = String.from_utf8(cells).unwrap();
            let beams = number_of_beams(banks[b]);
            total += beams;
            check = (check * 31 + beams + round) % 1000000007;
        }
    }
    println(f"6000 solves: {total} beams, checksum {check}");
}
