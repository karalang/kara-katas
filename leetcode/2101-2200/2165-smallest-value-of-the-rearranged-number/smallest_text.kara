// LeetCode #2165: Smallest Value of the Rearranged Number -- by text: the
// number's characters without the sign sorted, rising or falling; when
// rising, the first character other than '0' found by `position` is
// `remove`d and `insert`ed in front; the characters `collect`ed into a
// `String` and read back by `i64.parse`. O(d log d).

fn smallest_number(num: i64) -> i64 {
    let mut chars: Vec[char] = num.abs().to_string().chars().collect();
    chars.sort();
    if num < 0 {
        chars.reverse();
    }
    if num >= 0 {
        match chars.iter().position(|c| c != '0') {
            Some(at) => {
                let lead = chars.remove(at);
                chars.insert(0, lead);
            }
            None => {}
        }
    }
    let text: String = chars.into_iter().collect();
    let size = i64.parse(text).unwrap();
    if num < 0 { -size } else { size }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(num: i64) {
    println(f"{num} -> {smallest_number(num)}");
}

fn main() {
    // LeetCode's two examples, then six more: zero, the least and the most
    // the constraints allow, zeros inside, a single digit below zero, and
    // ten below zero
    show(310);
    show(-7605);
    show(0);
    show(-1000000000000000);
    show(1000000000000000);
    show(1020);
    show(-8);
    show(-10);
    // 2000 random numbers of 1 to 15 digits, about half of them below
    // zero, the digits from 0 to 1, 0 to 4 or 0 to 9 in turn
    let mut seed = 2165;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let length = next_random(mut seed) % 15 + 1;
        let top = [2, 5, 10][round % 3];
        let mut num = 0;
        for _ in 0..length {
            num = num * 10 + next_random(mut seed) % top;
        }
        if next_random(mut seed) % 2 == 1 {
            num = -num;
        }
        let s = smallest_number(num);
        total += s % 1000000007;
        check = (check * 31 + s % 1000000007 + 1000000007) % 1000000007;
    }
    println(f"2000 numbers: {total} in all, checksum {check}");
    // the digits 0 to 9 in every rotation, each way of signing
    let mut every = 0;
    for start in 0..10 {
        let mut num = 0;
        for k in 0..10 {
            num = num * 10 + (start + k) % 10;
        }
        every = (every * 31 + smallest_number(num) % 1000000007 + 1000000007) % 1000000007;
        every = (every * 31 + smallest_number(-num) % 1000000007 + 1000000007) % 1000000007;
    }
    println(f"20 rotations: checksum {every}");
}
