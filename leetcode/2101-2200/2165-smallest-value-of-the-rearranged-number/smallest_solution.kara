// LeetCode #2165: Smallest Value of the Rearranged Number -- LeetCode's
// Rust template: the digits as the bytes of `num.abs().to_string()
// .into_bytes()`, `sort_unstable_by` and `sort_unstable`, `position(|&c| c
// != b'0')` and `swap`, read back by `String::from_utf8(..)` and
// `parse::<i64>()`, written as Rust. Carried by `karac fix`.

impl Solution {
    pub fn smallest_number(num: i64) -> i64 {
        let mut d: Vec[u8] = num.abs().to_string().bytes().to_vec();
        if num < 0 {
            d.sort_by(|a, b| b.cmp(a));
            return -i64.parse(String.from_utf8(d).unwrap()).unwrap();
        }
        d.sort();
        if let Some(i) = d.iter().position(|c| c != b'0') {
            d.swap(0, i);
        }
        i64.parse(String.from_utf8(d).unwrap()).unwrap()
    }
}

struct Solution {}

fn smallest_number(num: i64) -> i64 {
    Solution.smallest_number(num)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(num: i64) {
    println(f"{num} -> {smallest_number(num)}");
}

fn main() {
    // LeetCode's two examples, then six more: zero, the least and the most
    // the constraints allow, zeros inside, a single digit below zero, and
    // ten below zero
    show(310);
    show(-7605);
    show(0);
    show(-1000000000000000);
    show(1000000000000000);
    show(1020);
    show(-8);
    show(-10);
    // 2000 random numbers of 1 to 15 digits, about half of them below
    // zero, the digits from 0 to 1, 0 to 4 or 0 to 9 in turn
    let mut seed = 2165;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let length = next_random(mut seed) % 15 + 1;
        let top = [2, 5, 10][round % 3];
        let mut num = 0;
        for _ in 0..length {
            num = num * 10 + next_random(mut seed) % top;
        }
        if next_random(mut seed) % 2 == 1 {
            num = -num;
        }
        let s = smallest_number(num);
        total += s % 1000000007;
        check = (check * 31 + s % 1000000007 + 1000000007) % 1000000007;
    }
    println(f"2000 numbers: {total} in all, checksum {check}");
    // the digits 0 to 9 in every rotation, each way of signing
    let mut every = 0;
    for start in 0..10 {
        let mut num = 0;
        for k in 0..10 {
            num = num * 10 + (start + k) % 10;
        }
        every = (every * 31 + smallest_number(num) % 1000000007 + 1000000007) % 1000000007;
        every = (every * 31 + smallest_number(-num) % 1000000007 + 1000000007) % 1000000007;
    }
    println(f"20 rotations: checksum {every}");
}
