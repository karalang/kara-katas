// LeetCode #2164: Sort Even and Odd Indices Independently -- a `struct
// Deal` that `deal`s the list into two hands by place (`own` the list),
// puts each hand in order with `arrange` (`mut ref self`), and `weave`s
// them back (`own self`), taking from the front of each hand in turn by
// `VecDeque.pop_front`. A hand is `collect`ed into a `VecDeque` and taken
// back out by `mem.take`. O(n log n).

struct Deal {
    even: VecDeque[i64],
    odd: VecDeque[i64],
}

impl Deal {
    fn deal(nums: own Vec[i64]) -> Deal {
        let mut even: Vec[i64] = Vec.new();
        let mut odd: Vec[i64] = Vec.new();
        for (i, x) in nums.into_iter().enumerate() {
            if i % 2 == 0 {
                even.push(x);
            } else {
                odd.push(x);
            }
        }
        Deal { even: even.into_iter().collect(), odd: odd.into_iter().collect() }
    }

    fn arrange(mut ref self) {
        let mut even: Vec[i64] = mem.take(mut self.even).into_iter().collect();
        let mut odd: Vec[i64] = mem.take(mut self.odd).into_iter().collect();
        even.sort();
        odd.sort();
        odd.reverse();
        self.even = even.into_iter().collect();
        self.odd = odd.into_iter().collect();
    }

    fn weave(own self) -> Vec[i64] {
        let mut deal = self;
        let mut out: Vec[i64] = Vec.new();
        loop {
            match deal.even.pop_front() {
                Some(x) => out.push(x),
                None => break,
            }
            match deal.odd.pop_front() {
                Some(x) => out.push(x),
                None => break,
            }
        }
        out
    }
}

fn sort_even_odd(nums: Vec[i64]) -> Vec[i64] {
    let mut deal = Deal.deal(nums.clone());
    deal.arrange();
    deal.weave()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {sort_even_odd(nums)}");
}

fn fold(out: Vec[i64], check: i64) -> i64 {
    let mut check = check;
    for x in out.iter() {
        check = (check * 31 + x) % 1000000007;
    }
    check
}

fn main() {
    // LeetCode's two examples, then four more: one number, two, already in
    // order, and every number the same
    show([4, 1, 2, 3].to_vec());
    show([2, 1].to_vec());
    show([7].to_vec());
    show([3, 9].to_vec());
    show([1, 9, 2, 8, 3, 7].to_vec());
    show([5, 5, 5, 5, 5].to_vec());
    // 2000 random lists of 1 to 12 numbers from 1 to 3, 10 or 100 in turn
    let mut seed = 2164;
    let mut check = 0;
    for round in 0..2000 {
        let len = next_random(mut seed) % 12 + 1;
        let most = [3, 10, 100][round % 3];
        let nums: Vec[i64] = (0..len).map(|_| next_random(mut seed) % most + 1).collect();
        check = fold(sort_even_odd(nums), check);
    }
    println(f"2000 lists: checksum {check}");
    // the constraints' largest, 100 numbers: at random, falling, and rising
    let random: Vec[i64] = (0..100).map(|_| next_random(mut seed) % 100 + 1).collect();
    println(f"100 at random: checksum {fold(sort_even_odd(random), 0)}");
    let falling: Vec[i64] = (0..100).map(|i| 100 - i).collect();
    println(f"100 falling: {sort_even_odd(falling)}");
    let rising: Vec[i64] = (0..100).map(|i| i + 1).collect();
    println(f"100 rising: checksum {fold(sort_even_odd(rising), 0)}");
}
