// LeetCode #2130: Maximum Twin Sum of a Linked List -- the differential.
// The six arms, against the statement read literally: for every node,
// its twin found by walking from the head to the place as far from the
// start as the node is from the end, and the largest of the sums over
// every node, both halves. 300 random lists of 2 to 12 values from 1 to
// 20; then 30 of 2 to 40 values from 1 to 100000; then 30 of 2 to 12 of
// one value; every one drawn before any arm answers. Each arm is given
// a freshly built list for every question, since one arm changes the
// list it is given.
//
// P1  the answer is the statement read literally
// P2  the list reversed: the same answer
// P3  every value doubled: twice the answer
// P4  a value put at each end: the larger of the answer and their sum
// P5  the two halves swapped: the same answer
// P6  each arm agrees with at least three of the other five

// ---- twins.kara: the ★ arm, the values read out, each with its twin
shared struct StarListNode {
    val: i64,
    mut next: Option[StarListNode],
}

fn star_pair_sum(head: Option[StarListNode]) -> i64 {
    let mut values: Vec[i64] = Vec.new();
    let mut node = head;
    while let Some(n) = node {
        values.push(n.val);
        node = n.next;
    }
    let len = values.len();
    let mut best = 0;
    for i in 0..len / 2 {
        best = best.max(values[i] + values[len - 1 - i]);
    }
    best
}

// ---- twins_reverse.kara: the first half turned back by the slow runner
shared struct ReverseListNode {
    val: i64,
    mut next: Option[ReverseListNode],
}

fn reverse_pair_sum(head: Option[ReverseListNode]) -> i64 {
    let mut slow = head;
    let mut fast = head;
    let mut back: Option[ReverseListNode] = None;
    while let Some(f) = fast {
        fast = f.next.unwrap().next;
        let node = slow.unwrap();
        slow = node.next;
        node.next = back;
        back = Some(node);
    }
    let mut best = 0;
    while let (Some(a), Some(b)) = (back, slow) {
        best = best.max(a.val + b.val);
        back = a.next;
        slow = b.next;
    }
    best
}

// ---- twins_stack.kara: the first half pushed, popped against the second
shared struct StackListNode {
    val: i64,
    mut next: Option[StackListNode],
}

fn stack_pair_sum(head: Option[StackListNode]) -> i64 {
    let mut n = 0;
    let mut node = head;
    while let Some(x) = node {
        n += 1;
        node = x.next;
    }
    let mut stack: Vec[i64] = Vec.new();
    let mut best = 0;
    let mut i = 0;
    node = head;
    while let Some(x) = node {
        if i < n / 2 {
            stack.push(x.val);
        } else {
            best = best.max(x.val + stack.pop().unwrap());
        }
        i += 1;
        node = x.next;
    }
    best
}

// ---- twins_rec.kara: recursion to the end, a front cursor on the way back
shared struct RecListNode {
    val: i64,
    mut next: Option[RecListNode],
}

fn rec_twin_max(node: Option[RecListNode], front: mut ref Option[RecListNode]) -> i64 {
    match node {
        None => 0,
        Some(n) => {
            let deeper = rec_twin_max(n.next, mut front);
            let f = front.unwrap();
            *front = f.next;
            deeper.max(n.val + f.val)
        }
    }
}

fn rec_pair_sum(head: Option[RecListNode]) -> i64 {
    let mut front = head;
    rec_twin_max(head, mut front)
}

// ---- twins_deque.kara: an `impl Iterator` into a `VecDeque`, emptied from both ends
shared struct DequeListNode {
    val: i64,
    mut next: Option[DequeListNode],
}

struct DequeWalk {
    node: Option[DequeListNode],
}

impl Iterator for DequeWalk {
    type Item = i64;

    fn next(mut ref self) -> Option[i64] {
        let n = self.node?;
        self.node = n.next;
        Some(n.val)
    }
}

fn deque_pair_sum(head: Option[DequeListNode]) -> i64 {
    let mut values: VecDeque[i64] = DequeWalk { node: head }.collect();
    let mut best = 0;
    while let (Some(a), Some(b)) = (values.pop_front(), values.pop_back()) {
        best = best.max(a + b);
    }
    best
}

// ---- twins_solution.kara: LeetCode's Rust template, carried by `karac fix`
// Definition for singly-linked list.
#[derive(PartialEq, Eq, Clone, Debug)]
pub struct SolutionListNode {
    pub val: i32,
    pub next: Option[SolutionListNode],
}

impl SolutionListNode {
    #[inline]
    fn new(val: i32) -> Self {
        SolutionListNode { next: None, val }
    }
}

struct SolutionSolution {}

impl SolutionSolution {
    pub fn pair_sum(head: Option[SolutionListNode]) -> i32 {
        let mut vals = Vec.new();
        let mut cur = ref head;
        while let Some(node) = cur {
            vals.push(node.val);
            cur = ref node.next;
        }
        let n = vals.len();
        (0..n / 2).map(|i| vals[i] + vals[n - 1 - i]).max().unwrap()
    }
}

fn solution_pair_sum(head: Option[SolutionListNode]) -> i64 {
    SolutionSolution.pair_sum(head)
}

// ---- the statement read literally

fn literal(values: Vec[i64]) -> i64 {
    let head = star_build(values);
    let mut n = 0;
    let mut node = head;
    while let Some(x) = node {
        n += 1;
        node = x.next;
    }
    let mut best = 0;
    let mut i = 0;
    node = head;
    while let Some(x) = node {
        let mut twin = head.unwrap();
        for _ in 0..n - 1 - i {
            twin = twin.next.unwrap();
        }
        best = best.max(x.val + twin.val);
        i += 1;
        node = x.next;
    }
    best
}

fn star_build(values: Vec[i64]) -> Option[StarListNode] {
    let mut head: Option[StarListNode] = None;
    for v in values.iter().rev() {
        head = Some(StarListNode { val: v, next: head });
    }
    head
}

fn reverse_build(values: Vec[i64]) -> Option[ReverseListNode] {
    let mut head: Option[ReverseListNode] = None;
    for v in values.iter().rev() {
        head = Some(ReverseListNode { val: v, next: head });
    }
    head
}

fn stack_build(values: Vec[i64]) -> Option[StackListNode] {
    let mut head: Option[StackListNode] = None;
    for v in values.iter().rev() {
        head = Some(StackListNode { val: v, next: head });
    }
    head
}

fn rec_build(values: Vec[i64]) -> Option[RecListNode] {
    let mut head: Option[RecListNode] = None;
    for v in values.iter().rev() {
        head = Some(RecListNode { val: v, next: head });
    }
    head
}

fn deque_build(values: Vec[i64]) -> Option[DequeListNode] {
    let mut head: Option[DequeListNode] = None;
    for v in values.iter().rev() {
        head = Some(DequeListNode { val: v, next: head });
    }
    head
}

fn solution_build(values: Vec[i64]) -> Option[SolutionListNode] {
    let mut head: Option[SolutionListNode] = None;
    for v in values.iter().rev() {
        head = Some(SolutionListNode { val: v as i32, next: head });
    }
    head
}

fn answer(arm: i64, values: Vec[i64]) -> i64 {
    match arm {
        0 => star_pair_sum(star_build(values)),
        1 => reverse_pair_sum(reverse_build(values)),
        2 => stack_pair_sum(stack_build(values)),
        3 => rec_pair_sum(rec_build(values)),
        4 => deque_pair_sum(deque_build(values)),
        _ => solution_pair_sum(solution_build(values)),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "reverse", "stack", "rec", "deque", "solution"];
    let mut seed = 2130;
    let mut problems: Vec[Vec[i64]] = Vec.new();
    for t in 0..360 {
        let mut values: Vec[i64] = Vec.new();
        if t < 300 {
            let n = 2 * (next_random(mut seed) % 6 + 1);
            for _ in 0..n {
                values.push(next_random(mut seed) % 20 + 1);
            }
        } else if t < 330 {
            let n = 2 * (next_random(mut seed) % 20 + 1);
            for _ in 0..n {
                values.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1);
            }
        } else {
            let n = 2 * (next_random(mut seed) % 6 + 1);
            let v = next_random(mut seed) % 100 + 1;
            for _ in 0..n {
                values.push(v);
            }
        }
        problems.push(values);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut t = 0;
    for values in problems.iter() {
        let n = values.len();
        let truth = literal(values);
        check = (check * 31 + truth * 4 + n) % 1000000007;
        let reversed: Vec[i64] = values.iter().rev().collect();
        let doubled: Vec[i64] = values.iter().map(|v| 2 * v).collect();
        let x = t % 200 + 1;
        let y = (t * 7) % 150 + 1;
        let mut ends = [x].to_vec();
        ends.extend(values.iter());
        ends.push(y);
        let mut swapped: Vec[i64] = values[n / 2..].to_vec();
        swapped.extend(values[..n / 2].iter());
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, values)).collect();
        for arm in 0..6 {
            let a = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == a {
                    same += 1;
                }
            }
            let verdicts = [
                a == truth,
                answer(arm, reversed) == a,
                answer(arm, doubled) == 2 * a,
                answer(arm, ends) == a.max(x + y),
                answer(arm, swapped) == a,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{values} arm {names[arm]}: P{q + 1} fails, answered {a}, literal {truth}");
                    }
                }
            }
        }
        t += 1;
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} lists: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
