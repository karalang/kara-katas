// LeetCode #2130: Maximum Twin Sum of a Linked List -- LeetCode's Rust
// template (`Option<Box<ListNode>>` with `i32` values): the values read
// out through a `&` cursor, `&head` then `&node.next`, and the twins'
// largest sum by `map` and `max`, written as Rust. Carried by `karac
// fix`. The harness converts its `i64` values at `build`.

// Definition for singly-linked list.
#[derive(PartialEq, Eq, Clone, Debug)]
pub struct ListNode {
    pub val: i32,
    pub next: Option[ListNode],
}

impl ListNode {
    #[inline]
    fn new(val: i32) -> Self {
        ListNode { next: None, val }
    }
}

struct Solution {}

impl Solution {
    pub fn pair_sum(head: Option[ListNode]) -> i32 {
        let mut vals = Vec.new();
        let mut cur = ref head;
        while let Some(node) = cur {
            vals.push(node.val);
            cur = ref node.next;
        }
        let n = vals.len();
        (0..n / 2).map(|i| vals[i] + vals[n - 1 - i]).max().unwrap()
    }
}

fn pair_sum(head: Option[ListNode]) -> i64 {
    Solution.pair_sum(head)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn build(values: Vec[i64]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for v in values.iter().rev() {
        head = Some(ListNode { val: v as i32, next: head });
    }
    head
}

fn show(values: Vec[i64]) {
    println(f"{values} -> {pair_sum(build(values))}");
}

fn main() {
    // LeetCode's three examples, then four more: one pair, the largest
    // twins in the middle, at the ends, and two equal sums
    show([5, 4, 2, 1].to_vec());
    show([4, 2, 2, 3].to_vec());
    show([1, 100000].to_vec());
    show([7, 7].to_vec());
    show([1, 2, 9, 9, 2, 1].to_vec());
    show([9, 1, 2, 3, 4, 9].to_vec());
    show([3, 5, 1, 2, 4, 6].to_vec());
    // 2000 random lists of 2 to 20 values from 1 to 100
    let mut seed = 2130;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = 2 * (next_random(mut seed) % 10 + 1);
        let mut values: Vec[i64] = Vec.new();
        for _ in 0..n {
            values.push(next_random(mut seed) % 100 + 1);
        }
        let sum = pair_sum(build(values));
        total += sum;
        check = (check * 31 + sum) % 1000000007;
    }
    println(f"2000 lists: {total} in all, checksum {check}");
    // the constraints' largest: 100000 nodes of 1 to 100000 in order, and
    // 100000 random ones
    let ladder: Vec[i64] = (1..100001).collect();
    let mut random: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        random.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1);
    }
    let a = pair_sum(build(ladder));
    let b = pair_sum(build(random));
    println(f"100000 nodes: {a} in order, {b} at random");
}
