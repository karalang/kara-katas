// LeetCode #2122: Recover the Original Array -- the benchmark,
// recover.kara's ★ arm: each positive even distance from the smallest
// number tried as 2k, smallest first, the sorted numbers paired by two
// pointers. 40 arrays of 2000 numbers, an original of 1000 values from
// 1 to 1000, 10000 or 100000 in turn shifted by a k up to 500, built
// once; then 200 rounds over all of them, every number one larger in
// each round than in the one before.

fn recover_array(nums: Vec[i64]) -> Vec[i64] {
    let mut sorted = nums.clone();
    sorted.sort();
    let m = sorted.len();
    for i in 1..m {
        let gap = sorted[i] - sorted[0];
        if gap == 0 or gap % 2 != 0 or (i > 1 and gap == sorted[i - 1] - sorted[0]) {
            continue;
        }
        let k = gap / 2;
        let mut used = Vec.filled(m, false);
        let mut original: Vec[i64] = Vec.new();
        let mut high = 0;
        for low in 0..m {
            if used[low] {
                continue;
            }
            while high < m and (used[high] or high <= low or sorted[high] < sorted[low] + 2 * k) {
                high += 1;
            }
            if high == m or sorted[high] != sorted[low] + 2 * k {
                break;
            }
            used[high] = true;
            original.push(sorted[low] + k);
        }
        if original.len() * 2 == m {
            return original;
        }
    }
    Vec.new()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2122;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for g in 0..40 {
        let top = [1000, 10000, 100000][g % 3];
        let k = next_random(mut seed) % 500 + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..1000 {
            let x = (next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1 + k;
            nums.push(x - k);
            nums.push(x + k);
        }
        for i in (1..nums.len()).rev() {
            let j = next_random(mut seed) % (i + 1);
            nums.swap(i, j);
        }
        arrays.push(nums);
    }
    let mut sizes = 0;
    let mut check = 0;
    for _ in 0..200 {
        for g in 0..40 {
            for i in 0..arrays[g].len() {
                arrays[g][i] += 1;
            }
            let original = recover_array(arrays[g]);
            sizes += original.len();
            for v in original.iter() {
                check = (check * 31 + v) % 1000000007;
            }
        }
    }
    println(f"8000 solves: {sizes} values recovered, checksum {check}");
}
