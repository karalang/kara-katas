// LeetCode #2136: Earliest Possible Day of Full Bloom -- a search on the
// day. A day d can be met when every seed is planted by d less its grow
// time: with the seeds taken by grow time, longest first, the days
// planted so far never pass the deadline of the seed just finished. That
// test is monotone in d, so the earliest day is found by halving the
// range from 1 to every plant time plus the longest grow; plant times
// are summed by grow time once, so each test walks one bucket a grow time.
// O(n + 10000 log(n * 10000)).

fn can_bloom_by(day: i64, planting: Vec[i64]) -> bool {
    let mut planted = 0;
    for grow in (1..planting.len()).rev() {
        planted += planting[grow];
        if planting[grow] > 0 and planted > day - grow {
            return false;
        }
    }
    true
}

fn earliest_full_bloom(plant_time: Vec[i64], grow_time: Vec[i64]) -> i64 {
    let longest = grow_time.iter().max().unwrap();
    let mut planting: Vec[i64] = Vec.filled(longest + 1, 0);
    for i in 0..plant_time.len() {
        planting[grow_time[i]] += plant_time[i];
    }
    let mut low = 1;
    let mut high = plant_time.iter().sum() + longest;
    while low < high {
        let mid = (low + high) / 2;
        if can_bloom_by(mid, planting) {
            high = mid;
        } else {
            low = mid + 1;
        }
    }
    low
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(plant_time: Vec[i64], grow_time: Vec[i64]) {
    println(f"{plant_time} {grow_time} -> {earliest_full_bloom(plant_time, grow_time)}");
}

fn main() {
    // LeetCode's three examples, then four more: equal grow times, equal
    // plant times, a long grow behind a long plant, and the largest values
    show([1, 4, 3].to_vec(), [2, 3, 1].to_vec());
    show([1, 2, 3, 2].to_vec(), [2, 1, 2, 1].to_vec());
    show([1].to_vec(), [1].to_vec());
    show([3, 1, 2].to_vec(), [5, 5, 5].to_vec());
    show([2, 2, 2].to_vec(), [1, 6, 3].to_vec());
    show([9, 1].to_vec(), [1, 9].to_vec());
    show([10000, 10000].to_vec(), [10000, 10000].to_vec());
    // 2000 random gardens of 1 to 10 seeds, times of 1 to 3, 1 to 10 or 1
    // to 100 in turn
    let mut seed = 2136;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 10 + 1;
        let top = [3, 10, 100][round % 3];
        let plant: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let grow: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let day = earliest_full_bloom(plant, grow);
        total += day;
        check = (check * 31 + day + n) % 1000000007;
    }
    println(f"2000 gardens: {total} days in all, checksum {check}");
    // the constraints' largest, 100000 seeds of times up to 10000: all the
    // largest, grow times falling as plant times rise, and at random
    let same: Vec[i64] = Vec.filled(100000, 10000);
    let rising: Vec[i64] = (0..100000).map(|i| i % 10000 + 1).collect();
    let falling: Vec[i64] = (0..100000).map(|i| 10000 - i % 10000).collect();
    let plant: Vec[i64] = (0..100000).map(|_| next_random(mut seed) % 10000 + 1).collect();
    let grow: Vec[i64] = (0..100000).map(|_| next_random(mut seed) % 10000 + 1).collect();
    let x = earliest_full_bloom(same, same);
    let y = earliest_full_bloom(rising, falling);
    let z = earliest_full_bloom(plant, grow);
    println(f"100000 seeds: {x} all largest, {y} rising against falling, {z} at random");
}
