// LeetCode #2136: Earliest Possible Day of Full Bloom -- the differential.
// The six arms, against the statement read literally: every way to spend
// each day planting one seed, a seed's planting split across days as the
// statement allows, is searched by its days still to plant, and the
// earliest day by which every seed has bloomed is kept; no order is
// assumed and no seed is assumed planted in one piece. 300 random gardens
// of 1 to 5 seeds, times of 1 to 3; then 30 of 1 to 4 seeds with one grow
// time; then 30 of 1 to 3 seeds, plant times of 1 to 3 and grow times of
// 1 to 20; every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the seeds in reverse order: the same answer
// P3  every grow time one more: one day more
// P4  a seed of one day's planting and one day's growth added: the later
//     of the answer and every planting day plus 2
// P5  every time doubled: twice the answer
// P6  each arm agrees with at least three of the other five


// ---- bloom.kara: the ★ arm, indices sorted by grow time, longest first
fn star_earliest_full_bloom(plant_time: Vec[i64], grow_time: Vec[i64]) -> i64 {
    let mut order: Vec[i64] = (0..plant_time.len()).collect();
    order.sort_by(|a, b| grow_time[b].cmp(grow_time[a]));
    let mut planted = 0;
    let mut bloom = 0;
    for i in order.iter() {
        planted += plant_time[i];
        bloom = bloom.max(planted + grow_time[i]);
    }
    bloom
}

// ---- bloom_buckets.kara: plant times summed by grow time
fn buckets_earliest_full_bloom(plant_time: Vec[i64], grow_time: Vec[i64]) -> i64 {
    let longest = grow_time.iter().max().unwrap();
    let mut planting: Vec[i64] = Vec.filled(longest + 1, 0);
    for i in 0..plant_time.len() {
        planting[grow_time[i]] += plant_time[i];
    }
    let mut planted = 0;
    let mut bloom = 0;
    for grow in (1..longest + 1).rev() {
        if planting[grow] > 0 {
            planted += planting[grow];
            bloom = bloom.max(planted + grow);
        }
    }
    bloom
}

// ---- bloom_pairs.kara: (grow, plant) tuples sorted and folded from the back
fn pairs_earliest_full_bloom(plant_time: Vec[i64], grow_time: Vec[i64]) -> i64 {
    let mut seeds: Vec[(i64, i64)] = grow_time.iter().zip(plant_time.iter()).collect();
    seeds.sort();
    let (_, bloom) = seeds.iter().rev().fold((0, 0), |(planted, bloom), (grow, plant)| {
        (planted + plant, bloom.max(planted + plant + grow))
    });
    bloom
}

// ---- bloom_struct.kara: a `Seed` with its own `Ord`
struct StructSeed {
    plant: i64,
    grow: i64,
}

impl PartialEq for StructSeed {
    fn eq(self, other: StructSeed) -> bool {
        self.grow == other.grow
    }
}

impl Eq for StructSeed {}

impl PartialOrd for StructSeed {
    fn partial_cmp(self, other: StructSeed) -> Option[Ordering] {
        Some(self.cmp(other))
    }
}

impl Ord for StructSeed {
    // the longer grow is the smaller: it is planted first
    fn cmp(self, other: StructSeed) -> Ordering {
        other.grow.cmp(self.grow)
    }
}

fn struct_earliest_full_bloom(plant_time: Vec[i64], grow_time: Vec[i64]) -> i64 {
    let mut seeds: Vec[StructSeed] = (0..plant_time.len()).map(|i| StructSeed { plant: plant_time[i], grow: grow_time[i] }).collect();
    seeds.sort();
    let mut planted = 0;
    let mut bloom = 0;
    for s in seeds.iter() {
        planted += s.plant;
        bloom = bloom.max(planted + s.grow);
    }
    bloom
}

// ---- bloom_search.kara: a search on the day
fn search_can_bloom_by(day: i64, planting: Vec[i64]) -> bool {
    let mut planted = 0;
    for grow in (1..planting.len()).rev() {
        planted += planting[grow];
        if planting[grow] > 0 and planted > day - grow {
            return false;
        }
    }
    true
}

fn search_earliest_full_bloom(plant_time: Vec[i64], grow_time: Vec[i64]) -> i64 {
    let longest = grow_time.iter().max().unwrap();
    let mut planting: Vec[i64] = Vec.filled(longest + 1, 0);
    for i in 0..plant_time.len() {
        planting[grow_time[i]] += plant_time[i];
    }
    let mut low = 1;
    let mut high = plant_time.iter().sum() + longest;
    while low < high {
        let mid = (low + high) / 2;
        if search_can_bloom_by(mid, planting) {
            high = mid;
        } else {
            low = mid + 1;
        }
    }
    low
}

// ---- bloom_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn earliest_full_bloom(plant_time: Vec[i32], grow_time: Vec[i32]) -> i32 {
        let mut idx: Vec[i64] = (0..plant_time.len()).collect();
        idx.sort_by(|a, b| grow_time[b].cmp(grow_time[a]));
        let mut cur: i32 = 0;
        let mut ans: i32 = 0;
        for i in idx {
            cur += plant_time[i];
            ans = ans.max(cur + grow_time[i]);
        }
        ans
    }
}

struct SolutionSolution {}

fn solution_earliest_full_bloom(plant_time: Vec[i64], grow_time: Vec[i64]) -> i64 {
    let p: Vec[i32] = plant_time.iter().map(|v| v as i32).collect();
    let g: Vec[i32] = grow_time.iter().map(|v| v as i32).collect();
    SolutionSolution.earliest_full_bloom(p, g)
}


// ---- the statement read literally

// the earliest day by which every seed has bloomed, from a state of days
// still to plant per seed (base 4) on the given day
fn latest_bloom(left: Vec[i64], grow: Vec[i64], day: i64, memo: mut ref Map[i64, i64]) -> i64 {
    let mut key = 0;
    for x in left.iter() {
        key = key * 4 + x;
    }
    if let Some(v) = memo.get(key) {
        return v;
    }
    let mut best = -1;
    for i in 0..left.len() {
        if left[i] > 0 {
            let mut next = left.clone();
            next[i] -= 1;
            // planted through `day`; a seed done today blooms grow days on
            let done_here = if next[i] == 0 { day + 1 + grow[i] } else { 0 };
            let rest = latest_bloom(next, grow, day + 1, mut memo);
            let worst = done_here.max(rest);
            if best < 0 or worst < best {
                best = worst;
            }
        }
    }
    if best < 0 {
        best = 0;
    }
    memo.insert(key, best);
    best
}

fn literal(plant: Vec[i64], grow: Vec[i64]) -> i64 {
    let mut memo: Map[i64, i64] = Map.new();
    latest_bloom(plant, grow, 0, mut memo)
}

fn answer(arm: i64, plant: Vec[i64], grow: Vec[i64]) -> i64 {
    match arm {
        0 => star_earliest_full_bloom(plant, grow),
        1 => buckets_earliest_full_bloom(plant, grow),
        2 => pairs_earliest_full_bloom(plant, grow),
        3 => struct_earliest_full_bloom(plant, grow),
        4 => search_earliest_full_bloom(plant, grow),
        _ => solution_earliest_full_bloom(plant, grow),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Garden {
    plant: Vec[i64],
    grow: Vec[i64],
}

fn main() {
    let names = ["star", "buckets", "pairs", "struct", "search", "solution"];
    let mut seed = 2136;
    let mut gardens: Vec[Garden] = Vec.new();
    for t in 0..360 {
        let n = if t < 300 { next_random(mut seed) % 5 + 1 } else if t < 330 { next_random(mut seed) % 4 + 1 } else { next_random(mut seed) % 3 + 1 };
        let plant: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 3 + 1).collect();
        let one = next_random(mut seed) % 3 + 1;
        let grow: Vec[i64] = (0..n)
            .map(|_| if t < 300 { next_random(mut seed) % 3 + 1 } else if t < 330 { one } else { next_random(mut seed) % 20 + 1 })
            .collect();
        gardens.push(Garden { plant, grow });
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for g in gardens.iter() {
        let truth = literal(g.plant, g.grow);
        let n = g.plant.len();
        check = (check * 31 + truth * 8 + n) % 1000000007;
        let total: i64 = g.plant.iter().sum();
        let plant_back: Vec[i64] = g.plant.iter().rev().collect();
        let grow_back: Vec[i64] = g.grow.iter().rev().collect();
        let grow_more: Vec[i64] = g.grow.iter().map(|x| x + 1).collect();
        let mut plant_one = g.plant.clone();
        plant_one.push(1);
        let mut grow_one = g.grow.clone();
        grow_one.push(1);
        let plant_twice: Vec[i64] = g.plant.iter().map(|x| 2 * x).collect();
        let grow_twice: Vec[i64] = g.grow.iter().map(|x| 2 * x).collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, g.plant, g.grow)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, plant_back, grow_back) == x,
                answer(arm, g.plant, grow_more) == x + 1,
                answer(arm, plant_one, grow_one) == x.max(total + 2),
                answer(arm, plant_twice, grow_twice) == 2 * x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{g.plant} {g.grow} arm {names[arm]}: P{q + 1} fails, answered {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{gardens.len()} gardens: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
