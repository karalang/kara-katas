// LeetCode #2136: Earliest Possible Day of Full Bloom -- the benchmark,
// bloom.kara's ★ arm. 10 gardens of 100000 seeds built once, times of 1
// to 10000; then every garden solved 10 times, one seed's plant and grow
// times drawn anew before each solve.

fn earliest_full_bloom(plant_time: Vec[i64], grow_time: Vec[i64]) -> i64 {
    let mut order: Vec[i64] = (0..plant_time.len()).collect();
    order.sort_by(|a, b| grow_time[b].cmp(grow_time[a]));
    let mut planted = 0;
    let mut bloom = 0;
    for i in order.iter() {
        planted += plant_time[i];
        bloom = bloom.max(planted + grow_time[i]);
    }
    bloom
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2136;
    let mut plants: Vec[Vec[i64]] = Vec.new();
    let mut grows: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10 {
        let mut plant: Vec[i64] = Vec.new();
        let mut grow: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            plant.push(next_random(mut seed) % 10000 + 1);
            grow.push(next_random(mut seed) % 10000 + 1);
        }
        plants.push(plant);
        grows.push(grow);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..10 {
        for g in 0..10 {
            let at = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000;
            plants[g][at] = next_random(mut seed) % 10000 + 1;
            grows[g][at] = next_random(mut seed) % 10000 + 1;
            let day = earliest_full_bloom(plants[g], grows[g]);
            total += day;
            check = (check * 31 + day + round) % 1000000007;
        }
    }
    println(f"100 solves: {total} days in all, checksum {check}");
}
