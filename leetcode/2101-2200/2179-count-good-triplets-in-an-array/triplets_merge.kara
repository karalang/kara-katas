// LeetCode #2179: Count Good Triplets in an Array -- by merge sort: the
// places in nums2, read in nums1's order, sorted by merging halves; as
// an element of the right half is merged, every element of the left
// half already taken is an earlier and smaller place, and is added to
// its count. Each middle's later and larger ones then follow from its
// own place. O(n log n).

fn sort_counting(seq: Vec[i64], order: mut ref Vec[i64], low: i64, high: i64, smaller: mut ref Vec[i64]) {
    if high - low < 2 {
        return;
    }
    let mid = (low + high) / 2;
    sort_counting(seq, mut order, low, mid, mut smaller);
    sort_counting(seq, mut order, mid, high, mut smaller);
    let mut merged: Vec[i64] = Vec.new();
    let mut i = low;
    let mut j = mid;
    while i < mid or j < high {
        if j == high or (i < mid and seq[order[i]] < seq[order[j]]) {
            merged.push(order[i]);
            i += 1;
        } else {
            smaller[order[j]] += i - low;
            merged.push(order[j]);
            j += 1;
        }
    }
    for k in 0..merged.len() {
        order[low + k] = merged[k];
    }
}

fn good_triplets(nums1: Vec[i64], nums2: Vec[i64]) -> i64 {
    let n = nums1.len();
    let mut place: Vec[i64] = Vec.filled(n, 0);
    for i in 0..n {
        place[nums2[i]] = i;
    }
    let seq: Vec[i64] = nums1.iter().map(|v| place[v]).collect();
    let mut order: Vec[i64] = (0..n).collect();
    let mut smaller: Vec[i64] = Vec.filled(n, 0);
    sort_counting(seq, mut order, 0, n, mut smaller);
    let mut total = 0;
    for i in 0..n {
        let larger = (n - 1 - seq[i]) - (i - smaller[i]);
        total += smaller[i] * larger;
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn shuffled(n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut perm: Vec[i64] = (0..n).collect();
    let mut i = n - 1;
    while i > 0 {
        let a = next_random(mut seed);
        let b = next_random(mut seed);
        let j = (a * 32768 + b) % (i + 1);
        perm.swap(i, j);
        i -= 1;
    }
    perm
}

fn show(nums1: Vec[i64], nums2: Vec[i64]) {
    println(f"{nums1}, {nums2} -> {good_triplets(nums1, nums2)}");
}

fn main() {
    // LeetCode's two examples, then four more: one triplet, the same
    // three reversed, a permutation against itself, and three swapped
    // neighbours, one of each pair to choose
    show([2, 0, 1, 3], [0, 1, 2, 3]);
    show([4, 0, 1, 3, 2], [4, 1, 0, 2, 3]);
    show([0, 1, 2], [0, 1, 2]);
    show([0, 1, 2], [2, 1, 0]);
    show([3, 1, 4, 0, 2], [3, 1, 4, 0, 2]);
    show([1, 0, 3, 2, 5, 4], [0, 1, 2, 3, 4, 5]);
    // 2000 random pairs of permutations of 3 to 10 or 3 to 32 values
    let mut seed = 2179;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % [8, 30][round % 2] + 3;
        let nums1 = shuffled(n, mut seed);
        let nums2 = shuffled(n, mut seed);
        let found = good_triplets(nums1, nums2);
        total += found;
        check = (check * 31 + found % 1000000007 + n) % 1000000007;
    }
    println(f"2000 pairs: {total} in all, checksum {check}");
    // the constraints' largest, 10^5 values: one order twice, against its
    // reverse, and two at random
    let n = 100000;
    let same: Vec[i64] = (0..n).collect();
    let back: Vec[i64] = (0..n).rev().collect();
    let a = shuffled(n, mut seed);
    let b = shuffled(n, mut seed);
    println(f"{n} values: {good_triplets(same, same)} {good_triplets(same, back)} {good_triplets(a, b)}");
}
