// LeetCode #2179: Count Good Triplets in an Array -- the benchmark's
// Kāra arm: the ★ arm, a Fenwick tree over the places in nums2.

fn good_triplets(nums1: Vec[i64], nums2: Vec[i64]) -> i64 {
    let n = nums1.len();
    let mut place: Vec[i64] = Vec.filled(n, 0);
    for i in 0..n {
        place[nums2[i]] = i;
    }
    let mut tree: Vec[i64] = Vec.filled(n + 1, 0);
    let mut total = 0;
    for i in 0..n {
        let p = place[nums1[i]];
        let mut smaller = 0;
        let mut j = p;
        while j > 0 {
            smaller += tree[j];
            j -= j & -j;
        }
        let larger = (n - 1 - p) - (i - smaller);
        total += smaller * larger;
        j = p + 1;
        while j <= n {
            tree[j] += 1;
            j += j & -j;
        }
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn shuffled(n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut perm: Vec[i64] = (0..n).collect();
    let mut i = n - 1;
    while i > 0 {
        let a = next_random(mut seed);
        let b = next_random(mut seed);
        let j = (a * 32768 + b) % (i + 1);
        perm.swap(i, j);
        i -= 1;
    }
    perm
}

fn main() {
    let n = 100000;
    let mut seed = 2179;
    let first = shuffled(n, mut seed);
    let second = shuffled(n, mut seed);
    let mut check = 0;
    for _ in 0..40 {
        let a = next_random(mut seed);
        let b = next_random(mut seed);
        let offset = (a * 32768 + b) % n;
        let rotated: Vec[i64] = (0..n).map(|i| second[(i + offset) % n]).collect();
        let found = good_triplets(first, rotated);
        check = (check * 31 + found % 1000000007) % 1000000007;
    }
    println(f"40 solves: checksum {check}");
}
