// LeetCode #2102: Sequentially Ordinal Rank Tracker -- the differential.
// The five Kāra arms (the Rust template's `Reverse` has no Kāra spelling
// yet; see the README), against the statement read literally: at the
// `i`th `get`, every place added so far sorted, best first, and the one at
// index `i - 1` taken. 300 random runs of 1 to 20 calls with names of 1
// to 3 letters from a to d and scores of 1 to 3, so that ties are common;
// then 20 runs where every score is the same; then 20 runs with names of
// 1 to 10 letters and scores of 1 to 10^5; a `get` only when there are
// more adds than gets so far; every one drawn before any arm answers.
//
// P1  the answers are the statement read literally
// P2  at the `i`th `get`, exactly `i - 1` of the places added so far are
//     better than the one returned, counted without sorting
// P3  every score replaced by its rank among the run's scores: the same
//     answers
// P4  the adds first and the gets after them: the best places, best
//     first, as many as there were gets
// P5  a place worse than all others added first: the same answers
// P6  each arm agrees with at least two of the other four

// ---- rank_tracker.kara: the ★ arm, two heaps of a `Place` with its own `Ord`
struct StarPlace {
    score: i64,
    name: String,
}

impl PartialEq for StarPlace {
    fn eq(self, other: StarPlace) -> bool {
        self.score == other.score and self.name == other.name
    }
}

impl Eq for StarPlace {}

impl PartialOrd for StarPlace {
    fn partial_cmp(self, other: StarPlace) -> Option[Ordering] {
        Some(self.cmp(other))
    }
}

impl Ord for StarPlace {
    // greater is better
    fn cmp(self, other: StarPlace) -> Ordering {
        self.score.cmp(other.score).then(other.name.cmp(self.name))
    }
}

struct StarSORTracker {
    served: PriorityQueue[StarPlace],
    waiting: PriorityQueue[StarPlace],
}

impl StarSORTracker {
    fn new() -> StarSORTracker {
        StarSORTracker { served: PriorityQueue.new(), waiting: PriorityQueue.max_first() }
    }

    fn add(mut ref self, name: own String, score: i64) {
        self.served.push(StarPlace { score, name });
        let worst = self.served.pop().unwrap();
        self.waiting.push(worst);
    }

    fn get(mut ref self) -> String {
        let best = self.waiting.pop().unwrap();
        let name = best.name.clone();
        self.served.push(best);
        name
    }
}

fn star_answers(ops: Vec[(String, i64)]) -> Vec[String] {
    let mut tracker = StarSORTracker.new();
    let mut out: Vec[String] = Vec.new();
    for (name, score) in ops.iter() {
        if name.is_empty() {
            out.push(tracker.get());
        } else {
            tracker.add(name.clone(), score);
        }
    }
    out
}

// ---- rank_tracker_tuples.kara: two heaps of `(-score, name)` tuples
struct TuplesSORTracker {
    served: PriorityQueue[(i64, String)],
    waiting: PriorityQueue[(i64, String)],
}

impl TuplesSORTracker {
    fn new() -> TuplesSORTracker {
        TuplesSORTracker { served: PriorityQueue.max_first(), waiting: PriorityQueue.new() }
    }

    fn add(mut ref self, name: own String, score: i64) {
        self.served.push((-score, name));
        if let Some(worst) = self.served.pop() {
            self.waiting.push(worst);
        }
    }

    fn get(mut ref self) -> String {
        let (key, name) = self.waiting.pop().unwrap();
        self.served.push((key, name.clone()));
        name
    }
}

fn tuples_answers(ops: Vec[(String, i64)]) -> Vec[String] {
    let mut tracker = TuplesSORTracker.new();
    let mut out: Vec[String] = Vec.new();
    for (name, score) in ops.iter() {
        if name.is_empty() {
            out.push(tracker.get());
        } else {
            tracker.add(name.clone(), score);
        }
    }
    out
}

// ---- rank_tracker_sorted.kara: one sorted `Vec`, read by index
struct SortedSORTracker {
    places: Vec[(i64, String)],
    asked: i64,
}

impl SortedSORTracker {
    fn new() -> SortedSORTracker {
        SortedSORTracker { places: Vec.new(), asked: 0 }
    }

    fn add(mut ref self, name: own String, score: i64) {
        let place = (-score, name);
        let at = self.places.partition_point(|p| p < place);
        self.places.insert(at, place);
    }

    fn get(mut ref self) -> String {
        self.asked += 1;
        self.places[self.asked - 1].1.clone()
    }
}

fn sorted_answers(ops: Vec[(String, i64)]) -> Vec[String] {
    let mut tracker = SortedSORTracker.new();
    let mut out: Vec[String] = Vec.new();
    for (name, score) in ops.iter() {
        if name.is_empty() {
            out.push(tracker.get());
        } else {
            tracker.add(name.clone(), score);
        }
    }
    out
}

// ---- rank_tracker_fenwick.kara: a sparse Fenwick tree over the scores
struct FenwickSORTracker {
    tree: Map[i64, i64],
    names: Map[i64, Vec[String]],
    asked: i64,
}

const FENWICK_TOP: i64 = 100001;

impl FenwickSORTracker {
    fn new() -> FenwickSORTracker {
        FenwickSORTracker { tree: Map.new(), names: Map.new(), asked: 0 }
    }

    fn add(mut ref self, name: own String, score: i64) {
        let rank = FENWICK_TOP - score;
        let bucket = self.names.entry(rank).or_insert(Vec.new());
        let at = bucket.partition_point(|n| n < name);
        bucket.insert(at, name);
        let mut i = rank;
        while i <= FENWICK_TOP {
            *self.tree.entry(i).or_insert(0) += 1;
            i += i & -i;
        }
    }

    fn get(mut ref self) -> String {
        self.asked += 1;
        let mut left = self.asked;
        let mut at = 0;
        let mut step = 1 << 17;
        while step > 0 {
            let next = at + step;
            if next <= FENWICK_TOP {
                let count = self.tree.get(next) ?? 0;
                if count < left {
                    at = next;
                    left -= count;
                }
            }
            step /= 2;
        }
        self.names[at + 1][left - 1].clone()
    }
}

fn fenwick_answers(ops: Vec[(String, i64)]) -> Vec[String] {
    let mut tracker = FenwickSORTracker.new();
    let mut out: Vec[String] = Vec.new();
    for (name, score) in ops.iter() {
        if name.is_empty() {
            out.push(tracker.get());
        } else {
            tracker.add(name.clone(), score);
        }
    }
    out
}

// ---- rank_tracker_sets.kara: two `SortedSet`s
struct SetsSORTracker {
    served: SortedSet[(i64, String)],
    waiting: SortedSet[(i64, String)],
}

impl SetsSORTracker {
    fn new() -> SetsSORTracker {
        SetsSORTracker { served: SortedSet.new(), waiting: SortedSet.new() }
    }

    fn add(mut ref self, name: own String, score: i64) {
        self.served.insert((-score, name));
        let worst = self.served.pop_last().unwrap();
        self.waiting.insert(worst);
    }

    fn get(mut ref self) -> String {
        let best = self.waiting.pop_first().unwrap();
        let name = best.1.clone();
        self.served.insert(best);
        name
    }
}

fn sets_answers(ops: Vec[(String, i64)]) -> Vec[String] {
    let mut tracker = SetsSORTracker.new();
    let mut out: Vec[String] = Vec.new();
    for (name, score) in ops.iter() {
        if name.is_empty() {
            out.push(tracker.get());
        } else {
            tracker.add(name.clone(), score);
        }
    }
    out
}

// ---- the statement read literally

fn literal(ops: Vec[(String, i64)]) -> Vec[String] {
    let mut added: Vec[(i64, String)] = Vec.new();
    let mut out: Vec[String] = Vec.new();
    for (name, score) in ops.iter() {
        if name.is_empty() {
            let mut ranked = added.clone();
            ranked.sort();
            out.push(ranked[out.len()].1.clone());
        } else {
            added.push((-score, name.clone()));
        }
    }
    out
}

fn better(a_score: i64, a_name: Str, b_score: i64, b_name: Str) -> bool {
    a_score > b_score or (a_score == b_score and a_name < b_name)
}

// P2: each answer has exactly as many better places before it as gets
fn counted_right(ops: Vec[(String, i64)], got: Vec[String]) -> bool {
    let mut seen: Vec[(String, i64)] = Vec.new();
    let mut asked = 0;
    for (name, score) in ops.iter() {
        if name.is_empty() {
            if asked >= got.len() {
                return false;
            }
            let answer = got[asked].clone();
            let Some(at) = seen.iter().position(|(n, _)| n == answer) else {
                return false;
            };
            let s = seen[at].1;
            let above = seen.iter().filter(|(n, t)| better(t, n, s, answer)).count();
            if above != asked {
                return false;
            }
            asked += 1;
        } else {
            seen.push((name.clone(), score));
        }
    }
    asked == got.len()
}

fn answer(arm: i64, ops: Vec[(String, i64)]) -> Vec[String] {
    match arm {
        0 => star_answers(ops),
        1 => tuples_answers(ops),
        2 => sorted_answers(ops),
        3 => fenwick_answers(ops),
        _ => sets_answers(ops),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn fresh_name(seed: mut ref i64, longest: i64, letters: i64, taken: mut ref Set[String]) -> String {
    loop {
        let len = next_random(mut seed) % longest + 1;
        let mut name = String.new();
        for _ in 0..len {
            name.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        if taken.insert(name.clone()) {
            return name;
        }
    }
}

fn main() {
    let names = ["star", "tuples", "sorted", "fenwick", "sets"];
    let mut seed = 2102;
    let mut problems: Vec[Vec[(String, i64)]] = Vec.new();
    for t in 0..340 {
        let calls = next_random(mut seed) % 20 + 1;
        let same = next_random(mut seed) % 100000 + 1;
        let mut taken: Set[String] = Set.new();
        let mut ops: Vec[(String, i64)] = Vec.new();
        let mut added = 0;
        let mut asked = 0;
        for _ in 0..calls {
            if asked < added and next_random(mut seed) % 2 == 0 {
                ops.push((String.new(), 0));
                asked += 1;
            } else {
                if t < 300 {
                    ops.push((fresh_name(mut seed, 3, 4, mut taken), next_random(mut seed) % 3 + 1));
                } else if t < 320 {
                    ops.push((fresh_name(mut seed, 3, 4, mut taken), same));
                } else {
                    ops.push((fresh_name(mut seed, 10, 26, mut taken), wide_random(mut seed) % 100000 + 1));
                }
                added += 1;
            }
        }
        problems.push(ops);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for ops in problems.iter() {
        let truth = literal(ops);
        for name in truth.iter() {
            for b in name.bytes() {
                check = (check * 31 + b) % 1000000007;
            }
            check = (check * 31 + 7) % 1000000007;
        }
        check = (check * 31 + 11) % 1000000007;
        let mut scores: Vec[i64] = ops.iter().filter(|(n, _)| not n.is_empty()).map(|(_, s)| s).collect();
        scores.sort();
        scores.dedup();
        let ranked: Vec[(String, i64)] = ops.iter().map(|(n, s)| if n.is_empty() { (n.clone(), s) } else { (n.clone(), scores.binary_search(s).unwrap() + 1) }).collect();
        let (adds, gets): (Vec[(String, i64)], Vec[(String, i64)]) = ops.iter().cloned().partition(|(n, _)| not n.is_empty());
        let mut later = adds.clone();
        later.extend(gets.clone());
        let mut best: Vec[(i64, String)] = adds.iter().map(|(n, s)| (-s, n.clone())).collect();
        best.sort();
        let best_first: Vec[String] = best.iter().take(gets.len()).map(|(_, n)| n.clone()).collect();
        let mut padded = [("zzzzzzzzzz", 1)].to_vec();
        padded.extend(ops.iter().cloned());
        let got: Vec[Vec[String]] = (0..5).map(|arm| answer(arm, ops)).collect();
        for arm in 0..5 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                counted_right(ops, x),
                answer(arm, ranked) == x,
                answer(arm, later) == best_first,
                answer(arm, padded) == x,
                same >= 2,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{ops} arm {names[arm]}: P{q + 1} fails, answers {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} runs: checksum {check}, {checks} checks over 5 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
