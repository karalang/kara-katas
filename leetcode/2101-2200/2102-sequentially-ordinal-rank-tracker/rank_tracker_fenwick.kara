// LeetCode #2102: Sequentially Ordinal Rank Tracker -- a Fenwick tree over
// the scores. Score `s` sits at rank `100001 - s`, so rank 1 is the best
// score; a sparse Fenwick tree in a `Map` counts the places at each rank,
// and each rank keeps its names sorted in a `Vec`. The `i`th `get` walks
// down the tree by powers of two to the rank holding the `i`th best
// place, and reads that rank's name by what is left of `i`. O(log^2 n) a
// call, plus the bucket's insert.

struct SORTracker {
    tree: Map[i64, i64],
    names: Map[i64, Vec[String]],
    asked: i64,
}

const TOP: i64 = 100001;

impl SORTracker {
    fn new() -> SORTracker {
        SORTracker { tree: Map.new(), names: Map.new(), asked: 0 }
    }

    fn add(mut ref self, name: own String, score: i64) {
        let rank = TOP - score;
        let bucket = self.names.entry(rank).or_insert(Vec.new());
        let at = bucket.partition_point(|n| n < name);
        bucket.insert(at, name);
        let mut i = rank;
        while i <= TOP {
            *self.tree.entry(i).or_insert(0) += 1;
            i += i & -i;
        }
    }

    fn get(mut ref self) -> String {
        self.asked += 1;
        let mut left = self.asked;
        let mut at = 0;
        let mut step = 1 << 17;
        while step > 0 {
            let next = at + step;
            if next <= TOP {
                let count = self.tree.get(next) ?? 0;
                if count < left {
                    at = next;
                    left -= count;
                }
            }
            step /= 2;
        }
        self.names[at + 1][left - 1].clone()
    }
}

fn answers(ops: Vec[(String, i64)]) -> Vec[String] {
    let mut tracker = SORTracker.new();
    let mut out: Vec[String] = Vec.new();
    for (name, score) in ops.iter() {
        if name.is_empty() {
            out.push(tracker.get());
        } else {
            tracker.add(name.clone(), score);
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// a lowercase name of 1 to `longest` letters, not among `taken`
fn fresh_name(seed: mut ref i64, longest: i64, letters: i64, taken: mut ref Set[String]) -> String {
    loop {
        let len = next_random(mut seed) % longest + 1;
        let mut name = String.new();
        for _ in 0..len {
            name.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        if taken.insert(name.clone()) {
            return name;
        }
    }
}

fn fold(check: i64, name: Str) -> i64 {
    let mut c = check;
    for b in name.bytes() {
        c = (c * 31 + b) % 1000000007;
    }
    (c * 31 + 7) % 1000000007
}

fn main() {
    // LeetCode's example, then three more: every place tied on score, so
    // names alone decide; a better place added after each get; and one
    // place only. An empty name is a `get`.
    let examples: Vec[Vec[(String, i64)]] = [
        [("bradford", 2), ("branford", 3), ("", 0), ("alps", 2), ("", 0), ("orland", 2), ("", 0), ("orlando", 3), ("", 0), ("alpine", 2), ("", 0), ("", 0)].iter().map(|(n, s)| (n.to_string(), s)).collect(),
        [("c", 5), ("b", 5), ("a", 5), ("", 0), ("", 0), ("", 0)].iter().map(|(n, s)| (n.to_string(), s)).collect(),
        [("m", 1), ("", 0), ("l", 2), ("", 0), ("k", 3), ("", 0), ("z", 100000), ("", 0)].iter().map(|(n, s)| (n.to_string(), s)).collect(),
        [("solo", 7), ("", 0)].iter().map(|(n, s)| (n.to_string(), s)).collect(),
    ].to_vec();
    for ops in examples.iter() {
        println(f"{answers(ops)}");
    }
    // 3000 random runs of 1 to 30 calls: names of 1 to 3 letters from
    // a to d with scores of 1 to 3, so that ties are common, or of 1 to 10
    // letters with scores of 1 to 10^5; a `get` only when there are more
    // adds than gets so far
    let mut seed = 2102;
    let mut gets = 0;
    let mut check = 0;
    for round in 0..3000 {
        let calls = next_random(mut seed) % 30 + 1;
        let mut taken: Set[String] = Set.new();
        let mut ops: Vec[(String, i64)] = Vec.new();
        let mut added = 0;
        let mut asked = 0;
        for _ in 0..calls {
            if asked < added and next_random(mut seed) % 2 == 0 {
                ops.push((String.new(), 0));
                asked += 1;
            } else if round % 2 == 0 {
                ops.push((fresh_name(mut seed, 3, 4, mut taken), next_random(mut seed) % 3 + 1));
                added += 1;
            } else {
                ops.push((fresh_name(mut seed, 10, 26, mut taken), wide_random(mut seed) % 100000 + 1));
                added += 1;
            }
        }
        for name in answers(ops).iter() {
            gets += 1;
            check = fold(check, name);
        }
    }
    println(f"3000 runs: {gets} gets, checksum {check}");
    // the constraints' largest: 4 * 10^4 calls, 20000 adds of scores
    // that fall and rise in waves, each followed by a get
    let mut taken: Set[String] = Set.new();
    let mut ops: Vec[(String, i64)] = Vec.new();
    for i in 0..20000 {
        ops.push((fresh_name(mut seed, 10, 26, mut taken), (i * 7919) % 1000 + 1));
        ops.push((String.new(), 0));
    }
    let got = answers(ops);
    let mut big = 0;
    for name in got.iter() {
        big = fold(big, name);
    }
    println(f"40000 calls: first {got[0]}, 10000th {got[9999]}, last {got[got.len() - 1]}, checksum {big}");
}
