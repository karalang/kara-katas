// LeetCode #2192: All Ancestors of a Node in a Directed Acyclic Graph --
// a `struct Bits`, a set of nodes as words of a `u64` each, made `empty`
// for n nodes, that `add`s a node and `absorb`s another set (`mut ref
// self`) and lists its `members` (`ref self`). Each node's set is filled
// by recursion up the edges, memoized in an `Option[Bits]` per node: a
// parent, and the parent's own set. O(n e / 64).

#[derive(Clone)]
struct Bits {
    words: Vec[u64],
}

impl Bits {
    fn empty(n: i64) -> Bits {
        Bits { words: Vec.filled(n / 64 + 1, 0u64) }
    }

    fn add(mut ref self, i: i64) {
        self.words[i / 64] |= 1u64 << (i % 64);
    }

    fn absorb(mut ref self, other: Bits) {
        for w in 0..self.words.len() {
            self.words[w] |= other.words[w];
        }
    }

    fn members(ref self) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for w in 0..self.words.len() {
            for b in 0..64 {
                if self.words[w] >> b & 1u64 == 1u64 {
                    out.push(w * 64 + b);
                }
            }
        }
        out
    }
}

fn fill(v: i64, n: i64, parents: Vec[Vec[i64]], memo: mut ref Vec[Option[Bits]]) -> Bits {
    if let Some(done) = memo[v].clone() {
        return done;
    }
    let mut set = Bits.empty(n);
    for p in parents[v].iter() {
        set.add(p);
        let above = fill(p, n, parents, mut memo);
        set.absorb(above);
    }
    memo[v] = Some(set.clone());
    set
}

fn get_ancestors(n: i64, edges: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let mut parents: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        parents[e[1]].push(e[0]);
    }
    let mut memo: Vec[Option[Bits]] = Vec.filled(n, None);
    let mut ancestors: Vec[Vec[i64]] = Vec.new();
    for v in 0..n {
        ancestors.push(fill(v, n, parents, mut memo).members());
    }
    ancestors
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random DAG of n nodes and about `want` edges: each edge runs from an
// earlier node to a later one in a random order of the nodes, and no edge
// is drawn twice
fn random_dag(n: i64, want: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut order: Vec[i64] = Vec.new();
    for v in 0..n {
        order.push(v);
    }
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        order.swap(i, j);
    }
    let mut taken: Set[i64] = Set.new();
    let mut edges: Vec[Vec[i64]] = Vec.new();
    if n < 2 {
        return edges;
    }
    for _ in 0..want {
        let a = next_random(mut seed) % n;
        let b = next_random(mut seed) % n;
        if a != b {
            let (lo, hi) = if a < b { (a, b) } else { (b, a) };
            if taken.insert(lo * n + hi) {
                edges.push([order[lo], order[hi]].to_vec());
            }
        }
    }
    edges
}

fn checksum(lists: Vec[Vec[i64]], check: i64) -> i64 {
    let mut c = check;
    for list in lists.iter() {
        c = (c * 31 + list.len()) % 1000000007;
        for a in list.iter() {
            c = (c * 31 + a + 1) % 1000000007;
        }
    }
    c
}

fn show(n: i64, edges: Vec[Vec[i64]]) {
    println(f"{n}, {edges} -> {get_ancestors(n, edges)}");
}

fn main() {
    // LeetCode's two examples, then four more: one node, no edges, a
    // chain, and two nodes with every other node above them
    show(8, [[0, 3].to_vec(), [0, 4].to_vec(), [1, 3].to_vec(), [2, 4].to_vec(), [2, 7].to_vec(), [3, 5].to_vec(), [3, 6].to_vec(), [3, 7].to_vec(), [4, 6].to_vec()].to_vec());
    show(5, [[0, 1].to_vec(), [0, 2].to_vec(), [0, 3].to_vec(), [0, 4].to_vec(), [1, 2].to_vec(), [1, 3].to_vec(), [1, 4].to_vec(), [2, 3].to_vec(), [2, 4].to_vec(), [3, 4].to_vec()].to_vec());
    show(1, Vec.new());
    show(3, Vec.new());
    show(4, [[3, 2].to_vec(), [2, 1].to_vec(), [1, 0].to_vec()].to_vec());
    show(5, [[4, 0].to_vec(), [3, 0].to_vec(), [2, 4].to_vec(), [1, 3].to_vec(), [2, 1].to_vec()].to_vec());
    // 300 random DAGs of 1 to 25 nodes, sparse and dense in turn
    let mut seed = 2192;
    let mut total = 0;
    let mut check = 0;
    for round in 0..300 {
        let n = next_random(mut seed) % 25 + 1;
        let want = if round % 2 == 0 { n } else { n * n / 2 };
        let edges = random_dag(n, want, mut seed);
        let lists = get_ancestors(n, edges);
        for list in lists.iter() {
            total += list.len();
        }
        check = checksum(lists, check);
    }
    println(f"300 DAGs: {total} ancestors, checksum {check}");
    // the constraints' largest, 1000 nodes and 2000 edges
    let edges = random_dag(1000, 2000, mut seed);
    let lists = get_ancestors(1000, edges);
    let mut most = 0;
    for list in lists.iter() {
        if list.len() > most {
            most = list.len();
        }
    }
    println(f"1000 nodes, {edges.len()} edges: most ancestors {most}, checksum {checksum(lists, 0)}");
}
