// LeetCode #2115: Find All Possible Recipes from Given Supplies -- the
// benchmark, recipes.kara's ★ arm: Kahn's order over names, a `Map` from
// each ingredient to the recipes needing it and a `VecDeque` starting
// with the supplies. 40 kitchens of 100 recipes are built once, each
// recipe needing 1 to 8 items among 60 possible supplies, of which 56
// are had, and the recipes before it; each kitchen is then solved 10 times,
// one ingredient of one recipe renamed before each solve so that no
// solve repeats the one before.

fn find_all_recipes(recipes: Vec[String], ingredients: Vec[Vec[String]], supplies: Vec[String]) -> Vec[String] {
    let mut needed_by: Map[String, Vec[i64]] = Map.new();
    let mut lacking: Vec[i64] = Vec.new();
    for i in 0..recipes.len() {
        lacking.push(ingredients[i].len());
        for item in ingredients[i].iter() {
            needed_by.entry(item.clone()).or_insert(Vec.new()).push(i);
        }
    }
    let mut queue: VecDeque[String] = VecDeque.new();
    for s in supplies.iter() {
        queue.push_back(s.clone());
    }
    let mut made: Vec[String] = Vec.new();
    while let Some(item) = queue.pop_front() {
        if let Some(users) = needed_by.get(item) {
            for i in users.iter() {
                lacking[i] -= 1;
                if lacking[i] == 0 {
                    made.push(recipes[i].clone());
                    queue.push_back(recipes[i].clone());
                }
            }
        }
    }
    made
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2115;
    let recipes: Vec[String] = (0..100).map(|i| f"r{i}").collect();
    let supplies: Vec[String] = (0..56).map(|i| f"s{i}").collect();
    let mut kitchens: Vec[Vec[Vec[String]]] = Vec.new();
    for _ in 0..40 {
        let mut ingredients: Vec[Vec[String]] = Vec.new();
        for i in 0..100 {
            let mut need: Vec[String] = Vec.new();
            for _ in 0..next_random(mut seed) % 8 + 1 {
                let pick = next_random(mut seed) % (60 + i);
                let item = if pick < 60 { f"s{pick}" } else { f"r{pick - 60}" };
                if not need.contains(item) {
                    need.push(item);
                }
            }
            if need.is_empty() {
                need.push("s0");
            }
            ingredients.push(need);
        }
        kitchens.push(ingredients);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..10 {
        for k in 0..40 {
            let i = (round * 37 + k) % 100;
            kitchens[k][i][0] = f"s{(round + k) % 50}";
            let got = find_all_recipes(recipes, kitchens[k], supplies);
            total += got.len();
            check = (check * 31 + got.len()) % 1000000007;
        }
    }
    println(f"400 solves: {total} recipes made, checksum {check}");
}
