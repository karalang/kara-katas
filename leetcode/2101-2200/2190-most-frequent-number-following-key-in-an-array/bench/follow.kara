// LeetCode #2190: Most Frequent Number Following Key In an Array -- the
// benchmark's Kāra arm: the ★ arm, counts in a list, the leader kept as
// met.

fn most_frequent(nums: Vec[i64], key: i64) -> i64 {
    let mut counts: Vec[i64] = Vec.filled(1001, 0);
    let mut best = 0;
    let mut target = -1;
    for i in 1..nums.len() {
        if nums[i - 1] == key {
            let x = nums[i];
            counts[x] += 1;
            if counts[x] > best {
                best = counts[x];
                target = x;
            }
        }
    }
    target
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn big_random(seed: mut ref i64) -> i64 {
    let a = next_random(mut seed);
    let b = next_random(mut seed);
    a * 32768 + b
}

fn main() {
    let mut seed = 2190;
    let row: Vec[i64] = (0..1000000).map(|_| next_random(mut seed) % 100 + 1).collect();
    let mut check = 0;
    for _ in 0..200000 {
        let start = big_random(mut seed) % 999001;
        let key = row[start];
        let target = most_frequent(row[start..(start + 1000)].to_vec(), key);
        check = (check * 31 + target) % 1000000007;
    }
    println(f"200000 solves: checksum {check}");
}
