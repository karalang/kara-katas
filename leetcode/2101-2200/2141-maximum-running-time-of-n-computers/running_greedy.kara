// LeetCode #2141: Maximum Running Time of N Computers -- greedy. A battery
// holding more than the fleet's average share can give a computer its
// whole run alone and still have charge it can never use, so it is set
// aside with its computer; once the largest battery left holds no more
// than the average, swapping shares the rest evenly and the answer is the
// charge left over the computers left. Sorted largest first. O(len log
// len).

fn max_run_time(n: i64, batteries: Vec[i64]) -> i64 {
    let mut sorted = batteries.clone();
    sorted.sort_by(|a, b| b.cmp(a));
    let mut rest: i64 = sorted.iter().sum();
    let mut computers = n;
    for b in sorted.iter() {
        if b > rest / computers {
            computers -= 1;
            rest -= b;
        } else {
            break;
        }
    }
    rest / computers
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(n: i64, batteries: Vec[i64]) {
    println(f"{n} {batteries} -> {max_run_time(n, batteries)}");
}

fn main() {
    // LeetCode's two examples, then four more: one computer, a computer
    // for every battery, one battery too large to share, and the most
    // charge one computer can use
    show(2, [3, 3, 3].to_vec());
    show(2, [1, 1, 1, 1].to_vec());
    show(1, [5].to_vec());
    show(3, [4, 9, 2].to_vec());
    show(2, [100, 1, 1].to_vec());
    show(1, [1000000000, 1000000000, 1000000000].to_vec());
    // 2000 random fleets of 1 to 12 batteries of 1 to 10 or 1 to 10^9 in
    // turn, for 1 computer up to one for every battery
    let mut seed = 2141;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let count = next_random(mut seed) % 12 + 1;
        let n = next_random(mut seed) % count + 1;
        let top = [10, 1000000000][round % 2];
        let batteries: Vec[i64] = (0..count).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1).collect();
        let minutes = max_run_time(n, batteries);
        total += minutes;
        check = (check * 31 + minutes % 1000000007 + n) % 1000000007;
    }
    println(f"2000 fleets: {total} minutes in all, checksum {check}");
    // the constraints' largest, 100000 batteries of up to 10^9: every one
    // the largest for 100000 computers, at random for one computer, and at
    // random for 50000
    let full: Vec[i64] = Vec.filled(100000, 1000000000);
    let random: Vec[i64] = (0..100000).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1).collect();
    let x = max_run_time(100000, full);
    let y = max_run_time(1, random);
    let z = max_run_time(50000, random);
    println(f"100000 batteries: {x} all full, {y} for one computer, {z} for 50000");
}
