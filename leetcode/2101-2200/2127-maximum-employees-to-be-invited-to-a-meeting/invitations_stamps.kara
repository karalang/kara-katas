// LeetCode #2127: Maximum Employees to Be Invited to a Meeting -- each
// walk along the favorites stamps the people it passes with where it
// started and how far it had come; meeting its own stamp closes a cycle.
// Then each mutual pair's longest tail is found by levels, breadth first,
// over the lists of who favors whom.

fn longest_tail(fans: Vec[Vec[i64]], top: i64, partner: i64) -> i64 {
    let mut level = [top].to_vec();
    let mut depth = 0;
    loop {
        let mut next: Vec[i64] = Vec.new();
        for p in level.iter() {
            for q in fans[p].iter() {
                if q != partner {
                    next.push(q);
                }
            }
        }
        if next.is_empty() {
            return depth;
        }
        depth += 1;
        level = next;
    }
}

fn maximum_invitations(favorite: Vec[i64]) -> i64 {
    let n = favorite.len();
    let mut started: Vec[i64] = Vec.filled(n, -1);
    let mut step: Vec[i64] = Vec.filled(n, 0);
    let mut largest_cycle = 0;
    for start in 0..n {
        if started[start] >= 0 {
            continue;
        }
        let mut j = start;
        let mut k = 0;
        while started[j] < 0 {
            started[j] = start;
            step[j] = k;
            k += 1;
            j = favorite[j];
        }
        if started[j] == start {
            largest_cycle = largest_cycle.max(k - step[j]);
        }
    }
    let mut fans: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for i in 0..n {
        fans[favorite[i]].push(i);
    }
    let mut pairs = 0;
    for a in 0..n {
        let b = favorite[a];
        if a < b and favorite[b] == a {
            pairs += 2 + longest_tail(fans, a, b) + longest_tail(fans, b, a);
        }
    }
    largest_cycle.max(pairs)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(favorite: Vec[i64]) {
    println(f"{favorite} -> {maximum_invitations(favorite)}");
}

fn main() {
    // LeetCode's three examples, then three more: one pair, two pairs
    // each with a tail, and a triangle beside a pair
    show([2, 2, 1, 2].to_vec());
    show([1, 2, 0].to_vec());
    show([3, 0, 1, 4, 1].to_vec());
    show([1, 0].to_vec());
    show([1, 0, 3, 2, 0, 2].to_vec());
    show([1, 2, 0, 4, 3].to_vec());
    // 3000 random tables of 2 to 12 employees
    let mut seed = 2127;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 11 + 2;
        let mut favorite: Vec[i64] = Vec.new();
        for i in 0..n {
            favorite.push((i + 1 + next_random(mut seed) % (n - 1)) % n);
        }
        let invited = maximum_invitations(favorite);
        total += invited;
        check = (check * 31 + invited) % 1000000007;
    }
    println(f"3000 tables: {total} invited, checksum {check}");
    // the constraints' largest: 100000 in one ring, a pair with a tail of
    // 99998, and 100000 random favorites
    let n = 100000;
    let ring: Vec[i64] = (0..n).map(|i| (i + 1) % n).collect();
    let tail: Vec[i64] = (0..n).map(|i| if i < 2 { 1 - i } else { i - 1 }).collect();
    let mut random: Vec[i64] = Vec.new();
    for i in 0..n {
        random.push((i + 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % (n - 1)) % n);
    }
    let a = maximum_invitations(ring);
    let b = maximum_invitations(tail);
    let c = maximum_invitations(random);
    println(f"100000 employees: {a} in a ring, {b} with a tail, {c} at random");
}
