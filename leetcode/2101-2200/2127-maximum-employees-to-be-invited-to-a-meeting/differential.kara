// LeetCode #2127: Maximum Employees to Be Invited to a Meeting -- the
// differential. The six arms, against the statement read literally: every
// set of employees tried, and every way to seat that set around the
// table, the first seat fixed; a seating works when each one sits next to
// their favorite. 300 random tables of 2 to 7 employees; then 30 whose
// favorites are mostly mutual pairs with people favoring them; then 30
// of 2 to 10, a ring with a chain into it, which runs down the numbers
// or up them into person 0; every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the employees numbered backwards: the same answer
// P3  one more employee, favoring someone already there: the answer or
//     one more
// P4  a ring of three more employees, apart: the larger of the answer
//     and 3
// P5  a mutual pair more, apart: the answer, or one or two more
// P6  each arm agrees with at least three of the other five

// ---- invitations.kara: the ★ arm, Kahn's order then the cycles
fn star_maximum_invitations(favorite: Vec[i64]) -> i64 {
    let n = favorite.len();
    let mut indegree: Vec[i64] = Vec.filled(n, 0);
    for f in favorite.iter() {
        indegree[f] += 1;
    }
    let mut chain: Vec[i64] = Vec.filled(n, 0);
    let mut queue: VecDeque[i64] = VecDeque.new();
    for i in 0..n {
        if indegree[i] == 0 {
            queue.push_back(i);
        }
    }
    while let Some(i) = queue.pop_front() {
        let f = favorite[i];
        chain[f] = chain[f].max(chain[i] + 1);
        indegree[f] -= 1;
        if indegree[f] == 0 {
            queue.push_back(f);
        }
    }
    let mut largest_cycle = 0;
    let mut pairs = 0;
    for i in 0..n {
        if indegree[i] == 0 {
            continue;
        }
        let mut length = 0;
        let mut j = i;
        while indegree[j] != 0 {
            indegree[j] = 0;
            length += 1;
            j = favorite[j];
        }
        if length == 2 {
            pairs += 2 + chain[i] + chain[favorite[i]];
        } else {
            largest_cycle = largest_cycle.max(length);
        }
    }
    largest_cycle.max(pairs)
}

// ---- invitations_stamps.kara: walks stamped by their start, tails by levels
fn stamps_longest_tail(fans: Vec[Vec[i64]], top: i64, partner: i64) -> i64 {
    let mut level = [top].to_vec();
    let mut depth = 0;
    loop {
        let mut next: Vec[i64] = Vec.new();
        for p in level.iter() {
            for q in fans[p].iter() {
                if q != partner {
                    next.push(q);
                }
            }
        }
        if next.is_empty() {
            return depth;
        }
        depth += 1;
        level = next;
    }
}

fn stamps_maximum_invitations(favorite: Vec[i64]) -> i64 {
    let n = favorite.len();
    let mut started: Vec[i64] = Vec.filled(n, -1);
    let mut step: Vec[i64] = Vec.filled(n, 0);
    let mut largest_cycle = 0;
    for start in 0..n {
        if started[start] >= 0 {
            continue;
        }
        let mut j = start;
        let mut k = 0;
        while started[j] < 0 {
            started[j] = start;
            step[j] = k;
            k += 1;
            j = favorite[j];
        }
        if started[j] == start {
            largest_cycle = largest_cycle.max(k - step[j]);
        }
    }
    let mut fans: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for i in 0..n {
        fans[favorite[i]].push(i);
    }
    let mut pairs = 0;
    for a in 0..n {
        let b = favorite[a];
        if a < b and favorite[b] == a {
            pairs += 2 + stamps_longest_tail(fans, a, b) + stamps_longest_tail(fans, b, a);
        }
    }
    largest_cycle.max(pairs)
}

// ---- invitations_struct.kara: an `Office` with a recursive `tail`
struct StructOffice {
    favorite: Vec[i64],
    fans: Vec[Vec[i64]],
}

impl StructOffice {
    fn new(favorite: Vec[i64]) -> StructOffice {
        let n = favorite.len();
        let mut fans: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
        for i in 0..n {
            fans[favorite[i]].push(i);
        }
        StructOffice { favorite: favorite.clone(), fans: fans }
    }

    fn tail(ref self, person: i64, skip: i64) -> i64 {
        let mut longest = 0;
        for fan in self.fans[person].iter() {
            if fan != skip {
                longest = longest.max(1 + self.tail(fan, -1));
            }
        }
        longest
    }

    fn cycle_from(ref self, start: i64, seen: mut ref Vec[bool]) -> i64 {
        let mut path: Vec[i64] = Vec.new();
        let mut j = start;
        while not seen[j] {
            seen[j] = true;
            path.push(j);
            j = self.favorite[j];
        }
        match path.iter().position(|p| p == j) {
            Some(at) => path.len() - at,
            None => 0,
        }
    }
}

fn struct_maximum_invitations(favorite: Vec[i64]) -> i64 {
    let office = StructOffice.new(favorite);
    let n = favorite.len();
    let mut seen: Vec[bool] = Vec.filled(n, false);
    let mut largest_cycle = 0;
    for i in 0..n {
        if not seen[i] {
            largest_cycle = largest_cycle.max(office.cycle_from(i, mut seen));
        }
    }
    let mut pairs = 0;
    for a in 0..n {
        let b = favorite[a];
        if a < b and favorite[b] == a {
            pairs += 2 + office.tail(a, b) + office.tail(b, a);
        }
    }
    largest_cycle.max(pairs)
}

// ---- invitations_walk.kara: an explicit stack unwound into distances
fn walk_maximum_invitations(favorite: Vec[i64]) -> i64 {
    let n = favorite.len();
    // 0 never seen, 1 on the current walk, 2 settled
    let mut state: Vec[i64] = Vec.filled(n, 0);
    let mut reaches: Vec[i64] = Vec.filled(n, -1);
    let mut distance: Vec[i64] = Vec.filled(n, 0);
    let mut cycle_length: Vec[i64] = Vec.filled(n, 0);
    for start in 0..n {
        let mut stack: Vec[i64] = Vec.new();
        let mut j = start;
        while state[j] == 0 {
            state[j] = 1;
            stack.push(j);
            j = favorite[j];
        }
        if state[j] == 1 {
            let mut members: Vec[i64] = Vec.new();
            while let Some(p) = stack.pop() {
                members.push(p);
                if p == j {
                    break;
                }
            }
            for p in members.iter() {
                state[p] = 2;
                reaches[p] = p;
                cycle_length[p] = members.len();
            }
        }
        while let Some(p) = stack.pop() {
            let f = favorite[p];
            state[p] = 2;
            reaches[p] = reaches[f];
            distance[p] = distance[f] + 1;
        }
    }
    let mut longest: Vec[i64] = Vec.filled(n, 0);
    for p in 0..n {
        let r = reaches[p];
        longest[r] = longest[r].max(distance[p]);
    }
    let mut largest_cycle = 0;
    let mut pairs = 0;
    for p in 0..n {
        if reaches[p] != p {
            continue;
        }
        if cycle_length[p] == 2 {
            pairs += 1 + longest[p];
        } else {
            largest_cycle = largest_cycle.max(cycle_length[p]);
        }
    }
    largest_cycle.max(pairs)
}

// ---- invitations_colors.kara: a `Map` of places on the walk, tails by a stack
fn colors_maximum_invitations(favorite: Vec[i64]) -> i64 {
    let n = favorite.len();
    let mut done: Vec[bool] = Vec.filled(n, false);
    let mut largest_cycle = 0;
    for start in 0..n {
        let mut place: Map[i64, i64] = Map.new();
        let mut j = start;
        while not done[j] and not place.contains_key(j) {
            place[j] = place.len();
            j = favorite[j];
        }
        if let Some(at) = place.get(j) {
            largest_cycle = largest_cycle.max(place.len() - at);
        }
        for (p, _) in place.iter() {
            done[p] = true;
        }
    }
    let mut fans: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for i in 0..n {
        fans[favorite[i]].push(i);
    }
    let mut pairs = 0;
    for a in 0..n {
        let b = favorite[a];
        if a > b or favorite[b] != a {
            continue;
        }
        pairs += 2;
        for (top, partner) in [(a, b), (b, a)] {
            let mut deepest = 0;
            let mut stack = [(top, 0)].to_vec();
            while let Some((p, depth)) = stack.pop() {
                deepest = deepest.max(depth);
                for q in fans[p].iter() {
                    if q != partner {
                        stack.push((q, depth + 1));
                    }
                }
            }
            pairs += deepest;
        }
    }
    largest_cycle.max(pairs)
}

// ---- invitations_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn maximum_invitations(favorite: Vec[i32]) -> i32 {
        let n = favorite.len();
        let mut indeg = Vec.filled(n, 0);
        for f in ref favorite {
            indeg[f] += 1;
        }
        let mut depth = Vec.filled(n, 1i32);
        let mut q: VecDeque[i64] = (0..n).filter(|i| indeg[i] == 0).collect();
        while let Some(u) = q.pop_front() {
            let v = favorite[u] as i64;
            depth[v] = depth[v].max(depth[u] + 1);
            indeg[v] -= 1;
            if indeg[v] == 0 {
                q.push_back(v);
            }
        }
        let mut max_cycle: i32 = 0;
        let mut two_cycles: i32 = 0;
        for i in 0..n {
            if indeg[i] == 0 {
                continue;
            }
            let mut len: i32 = 0;
            let mut j = i;
            while indeg[j] != 0 {
                indeg[j] = 0;
                len += 1;
                j = favorite[j];
            }
            if len == 2 {
                two_cycles += depth[i] + depth[favorite[i]];
            } else {
                max_cycle = max_cycle.max(len);
            }
        }
        max_cycle.max(two_cycles)
    }
}

struct SolutionSolution {}

fn solution_maximum_invitations(favorite: Vec[i64]) -> i64 {
    SolutionSolution.maximum_invitations(favorite.iter().map(|f| f as i32).collect())
}

// ---- the statement read literally

fn seated(favorite: Vec[i64], order: Vec[i64]) -> bool {
    let k = order.len();
    for p in 0..k {
        let f = favorite[order[p]];
        if f != order[(p + 1) % k] and f != order[(p + k - 1) % k] {
            return false;
        }
    }
    true
}

fn arrange(favorite: Vec[i64], order: mut ref Vec[i64], left: mut ref Vec[i64]) -> bool {
    if left.is_empty() {
        return seated(favorite, order);
    }
    for i in 0..left.len() {
        let person = left.remove(i);
        order.push(person);
        let works = arrange(favorite, mut order, mut left);
        order.pop();
        left.insert(i, person);
        if works {
            return true;
        }
    }
    false
}

fn literal(favorite: Vec[i64]) -> i64 {
    let n = favorite.len();
    let mut best = 0;
    for set in 1..(1 << n) {
        let people: Vec[i64] = (0..n).filter(|i| set & (1 << i) != 0).collect();
        if people.len() < 2 or people.len() <= best {
            continue;
        }
        let mut order = [people[0]].to_vec();
        let mut left = people[1..].to_vec();
        if arrange(favorite, mut order, mut left) {
            best = people.len();
        }
    }
    best
}

fn answer(arm: i64, favorite: Vec[i64]) -> i64 {
    match arm {
        0 => star_maximum_invitations(favorite),
        1 => stamps_maximum_invitations(favorite),
        2 => struct_maximum_invitations(favorite),
        3 => walk_maximum_invitations(favorite),
        4 => colors_maximum_invitations(favorite),
        _ => solution_maximum_invitations(favorite),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "stamps", "struct", "walk", "colors", "solution"];
    let mut seed = 2127;
    let mut problems: Vec[Vec[i64]] = Vec.new();
    for t in 0..360 {
        let mut favorite: Vec[i64] = Vec.new();
        if t < 300 {
            let n = next_random(mut seed) % 6 + 2;
            for i in 0..n {
                favorite.push((i + 1 + next_random(mut seed) % (n - 1)) % n);
            }
        } else if t < 330 {
            // pairs 0-1, 2-3, ..., then the rest favor someone at random
            let n = next_random(mut seed) % 6 + 2;
            let pairs = next_random(mut seed) % (n / 2) + 1;
            for i in 0..n {
                if i < 2 * pairs {
                    favorite.push(i ^ 1);
                } else {
                    favorite.push(next_random(mut seed) % i);
                }
            }
        } else {
            // a ring, the rest a chain into it: down the numbers into the
            // ring's last person, or every other time up them into person 0
            let n = next_random(mut seed) % 9 + 2;
            let ring = next_random(mut seed) % (n - 1) + 2;
            for i in 0..n {
                favorite.push(if i < ring {
                    (i + 1) % ring
                } else if t % 2 == 0 {
                    i - 1
                } else if i + 1 < n {
                    i + 1
                } else {
                    0
                });
            }
        }
        problems.push(favorite);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for favorite in problems.iter() {
        let n = favorite.len();
        let truth = literal(favorite);
        check = (check * 31 + truth * 8 + n) % 1000000007;
        let mut backwards: Vec[i64] = Vec.filled(n, 0);
        for i in 0..n {
            backwards[n - 1 - i] = n - 1 - favorite[i];
        }
        let mut one_more = favorite.clone();
        one_more.push(favorite[0]);
        let mut ringed = favorite.clone();
        ringed.extend([n + 1, n + 2, n].iter());
        let mut paired = favorite.clone();
        paired.extend([n + 1, n].iter());
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, favorite)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let more = answer(arm, one_more);
            let two = answer(arm, paired);
            let verdicts = [
                x == truth,
                answer(arm, backwards) == x,
                more == x or more == x + 1,
                answer(arm, ringed) == x.max(3),
                two >= x and two <= x + 2,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{favorite} arm {names[arm]}: P{q + 1} fails, answered {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} tables: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
