// LeetCode #2127: Maximum Employees to Be Invited to a Meeting -- the ★
// arm. Each employee points at a favorite, so every group of them ends in
// one cycle. A cycle of three or more can only sit alone, all of it; a
// pair who favor each other can sit with the longest chain leading into
// each of them, and every such pair can share the table. The people no
// one favors are peeled off first (Kahn's order over a `VecDeque`),
// carrying the longest chain into each person; what is left are the
// cycles. O(n).

fn maximum_invitations(favorite: Vec[i64]) -> i64 {
    let n = favorite.len();
    let mut indegree: Vec[i64] = Vec.filled(n, 0);
    for f in favorite.iter() {
        indegree[f] += 1;
    }
    let mut chain: Vec[i64] = Vec.filled(n, 0);
    let mut queue: VecDeque[i64] = VecDeque.new();
    for i in 0..n {
        if indegree[i] == 0 {
            queue.push_back(i);
        }
    }
    while let Some(i) = queue.pop_front() {
        let f = favorite[i];
        chain[f] = chain[f].max(chain[i] + 1);
        indegree[f] -= 1;
        if indegree[f] == 0 {
            queue.push_back(f);
        }
    }
    let mut largest_cycle = 0;
    let mut pairs = 0;
    for i in 0..n {
        if indegree[i] == 0 {
            continue;
        }
        let mut length = 0;
        let mut j = i;
        while indegree[j] != 0 {
            indegree[j] = 0;
            length += 1;
            j = favorite[j];
        }
        if length == 2 {
            pairs += 2 + chain[i] + chain[favorite[i]];
        } else {
            largest_cycle = largest_cycle.max(length);
        }
    }
    largest_cycle.max(pairs)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(favorite: Vec[i64]) {
    println(f"{favorite} -> {maximum_invitations(favorite)}");
}

fn main() {
    // LeetCode's three examples, then three more: one pair, two pairs
    // each with a tail, and a triangle beside a pair
    show([2, 2, 1, 2].to_vec());
    show([1, 2, 0].to_vec());
    show([3, 0, 1, 4, 1].to_vec());
    show([1, 0].to_vec());
    show([1, 0, 3, 2, 0, 2].to_vec());
    show([1, 2, 0, 4, 3].to_vec());
    // 3000 random tables of 2 to 12 employees
    let mut seed = 2127;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 11 + 2;
        let mut favorite: Vec[i64] = Vec.new();
        for i in 0..n {
            favorite.push((i + 1 + next_random(mut seed) % (n - 1)) % n);
        }
        let invited = maximum_invitations(favorite);
        total += invited;
        check = (check * 31 + invited) % 1000000007;
    }
    println(f"3000 tables: {total} invited, checksum {check}");
    // the constraints' largest: 100000 in one ring, a pair with a tail of
    // 99998, and 100000 random favorites
    let n = 100000;
    let ring: Vec[i64] = (0..n).map(|i| (i + 1) % n).collect();
    let tail: Vec[i64] = (0..n).map(|i| if i < 2 { 1 - i } else { i - 1 }).collect();
    let mut random: Vec[i64] = Vec.new();
    for i in 0..n {
        random.push((i + 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % (n - 1)) % n);
    }
    let a = maximum_invitations(ring);
    let b = maximum_invitations(tail);
    let c = maximum_invitations(random);
    println(f"100000 employees: {a} in a ring, {b} with a tail, {c} at random");
}
