// LeetCode #2113: Elements in Array After Removing and Replacing Elements
// -- the benchmark, elements.kara's ★ arm: each query's minute modulo the
// period `2n`, then one value or -1 for its phase. 20 arrays of 100
// values from 0 to 100 and 10^5 queries at minutes 0 to 10^5 are built
// once; then 50 solves each answer every query against one of the
// arrays, one query's minute moved on by one before each solve so that
// no solve repeats the one before.

fn element_in_nums(nums: Vec[i64], queries: Vec[(i64, i64)]) -> Vec[i64] {
    let n = nums.len();
    let mut ans: Vec[i64] = Vec.new();
    for (time, index) in queries.iter() {
        let t = time % (2 * n);
        if t < n {
            if index < n - t {
                ans.push(nums[t + index]);
            } else {
                ans.push(-1);
            }
        } else if index < t - n {
            ans.push(nums[index]);
        } else {
            ans.push(-1);
        }
    }
    ans
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2113;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..20 {
        let nums: Vec[i64] = (0..100).map(|_| next_random(mut seed) % 101).collect();
        arrays.push(nums);
    }
    let mut queries: Vec[(i64, i64)] = Vec.new();
    for _ in 0..100000 {
        let time = next_random(mut seed) % 100001;
        queries.push((time, next_random(mut seed) % 100));
    }
    let mut total = 0;
    let mut check = 0;
    for s in 0..50 {
        let j = s * 1999 % 100000;
        queries[j] = (queries[j].0 + 1, queries[j].1);
        let mut sum = 0;
        for x in element_in_nums(arrays[s % 20], queries).iter() {
            sum += x;
        }
        total += sum;
        check = (check * 31 + sum) % 1000000007;
    }
    println(f"50 solves: {total} summed, checksum {check}");
}
