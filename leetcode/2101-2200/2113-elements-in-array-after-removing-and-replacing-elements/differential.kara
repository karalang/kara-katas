// LeetCode #2113: Elements in Array After Removing and Replacing
// Elements -- the differential. The six arms, against the statement
// read literally: the process run minute by minute from minute 0 to the
// query's, the first value removed each minute until none is left and
// then the original values put back one a minute, and the place read.
// 300 random arrays of 1 to 6 values from 0 to 100, each asked 1 to 12
// queries at minutes 0 to 40; then 30 of up to 30 values asked 1 to 40
// queries at minutes up to 200; then 30 of up to 100 values asked at the
// minutes next to the period's turns (`2mn` and `2mn + n`, one either
// side and on it); every one drawn before any arm answers.
//
// P1  the answers are the statement read literally
// P2  every answer is -1 or one of the values
// P3  every minute moved on by one period, `2n`: the same answers
// P4  every value raised by 5: every answer but a -1 raised by 5
// P5  the queries reversed: the answers reversed
// P6  each arm agrees with at least three of the other five

// ---- elements.kara: the ★ arm, each minute modulo the period
fn star_element_in_nums(nums: Vec[i64], queries: Vec[(i64, i64)]) -> Vec[i64] {
    let n = nums.len();
    let mut ans: Vec[i64] = Vec.new();
    for (time, index) in queries.iter() {
        let t = time % (2 * n);
        if t < n {
            if index < n - t {
                ans.push(nums[t + index]);
            } else {
                ans.push(-1);
            }
        } else if index < t - n {
            ans.push(nums[index]);
        } else {
            ans.push(-1);
        }
    }
    ans
}

// ---- elements_table.kara: a table of the period's arrays
fn table_element_in_nums(nums: Vec[i64], queries: Vec[(i64, i64)]) -> Vec[i64] {
    let n = nums.len();
    let mut period: Vec[Vec[i64]] = Vec.new();
    for t in 0..2 * n {
        if t < n {
            period.push(nums[t..].to_vec());
        } else {
            period.push(nums[..t - n].to_vec());
        }
    }
    queries
        .iter()
        .map(|(time, index)| period[time % (2 * n)].get(index).cloned() ?? -1)
        .collect()
}

// ---- elements_deque.kara: the process in a `VecDeque`, queries sorted
fn deque_element_in_nums(nums: Vec[i64], queries: Vec[(i64, i64)]) -> Vec[i64] {
    let n = nums.len();
    let mut order: Vec[i64] = (0..queries.len()).collect();
    order.sort_by_key(|j| queries[j].0 % (2 * n));
    let mut ans = Vec.filled(queries.len(), -1);
    let mut now: VecDeque[i64] = VecDeque.new();
    for x in nums.iter() {
        now.push_back(x);
    }
    let mut minute = 0;
    for j in order.iter() {
        let (time, index) = queries[j];
        while minute < time % (2 * n) {
            if minute < n {
                now.pop_front();
            } else {
                now.push_back(nums[minute - n]);
            }
            minute += 1;
        }
        if index < now.len() {
            ans[j] = now[index];
        }
    }
    ans
}

// ---- elements_phase.kara: an `enum Phase`
enum PhasePhase {
    Removing(i64),
    Restoring(i64),
}

impl PhasePhase {
    fn at(time: i64, n: i64) -> PhasePhase {
        let t = time % (2 * n);
        if t < n { PhasePhase.Removing(t) } else { PhasePhase.Restoring(t - n) }
    }

    fn read(self, nums: Vec[i64], index: i64) -> Option[i64] {
        match self {
            PhasePhase.Removing(gone) if gone + index < nums.len() => Some(nums[gone + index]),
            PhasePhase.Restoring(back) if index < back => Some(nums[index]),
            _ => None,
        }
    }
}

fn phase_element_in_nums(nums: Vec[i64], queries: Vec[(i64, i64)]) -> Vec[i64] {
    queries
        .iter()
        .map(|(time, index)| PhasePhase.at(time, nums.len()).read(nums, index) ?? -1)
        .collect()
}

// ---- elements_iter.kara: `skip`, `take` and `nth`
fn iter_element_in_nums(nums: Vec[i64], queries: Vec[(i64, i64)]) -> Vec[i64] {
    let n = nums.len();
    let mut ans: Vec[i64] = Vec.new();
    for (time, index) in queries.iter() {
        let t = time % (2 * n);
        let found = if t < n {
            nums.iter().skip(t).nth(index)
        } else {
            nums.iter().take(t - n).nth(index)
        };
        ans.push(found ?? -1);
    }
    ans
}

// ---- elements_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn element_in_nums(nums: Vec[i32], queries: Vec[Vec[i32]]) -> Vec[i32] {
        let n = nums.len();
        queries
            .iter()
            .map(|q| {
                let t = q[0] % (2 * n);
                let i = q[1] as i64;
                if t < n {
                    if i < n - t { nums[t + i] } else { -1 }
                } else if i < t - n {
                    nums[i]
                } else {
                    -1
                }
            })
            .collect()
    }
}

struct SolutionSolution {}

fn solution_element_in_nums(nums: Vec[i64], queries: Vec[(i64, i64)]) -> Vec[i64] {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    let queries: Vec[Vec[i32]] = queries.iter().map(|(t, i)| [t as i32, i as i32]).collect();
    SolutionSolution.element_in_nums(nums, queries).iter().map(|x| x as i64).collect()
}

// ---- the statement read literally

fn literal(nums: Vec[i64], queries: Vec[(i64, i64)]) -> Vec[i64] {
    let n = nums.len();
    let mut ans: Vec[i64] = Vec.new();
    for (time, index) in queries.iter() {
        let mut now = nums.clone();
        let mut removing = true;
        let mut back = 0;
        for _ in 0..time {
            if removing {
                now.remove(0);
                if now.is_empty() {
                    removing = false;
                    back = 0;
                }
            } else {
                now.push(nums[back]);
                back += 1;
                if back == n {
                    removing = true;
                }
            }
        }
        ans.push(if index < now.len() { now[index] } else { -1 });
    }
    ans
}

fn answer(arm: i64, nums: Vec[i64], queries: Vec[(i64, i64)]) -> Vec[i64] {
    match arm {
        0 => star_element_in_nums(nums, queries),
        1 => table_element_in_nums(nums, queries),
        2 => deque_element_in_nums(nums, queries),
        3 => phase_element_in_nums(nums, queries),
        4 => iter_element_in_nums(nums, queries),
        _ => solution_element_in_nums(nums, queries),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "table", "deque", "phase", "iter", "solution"];
    let mut seed = 2113;
    let mut problems: Vec[(Vec[i64], Vec[(i64, i64)])] = Vec.new();
    for t in 0..360 {
        let n = if t < 300 {
            next_random(mut seed) % 6 + 1
        } else if t < 330 {
            next_random(mut seed) % 30 + 1
        } else {
            next_random(mut seed) % 100 + 1
        };
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 101).collect();
        let q = if t < 300 { next_random(mut seed) % 12 + 1 } else { next_random(mut seed) % 40 + 1 };
        let mut queries: Vec[(i64, i64)] = Vec.new();
        for _ in 0..q {
            let time = if t < 300 {
                next_random(mut seed) % 41
            } else if t < 330 {
                next_random(mut seed) % 201
            } else {
                let turn = 2 * n * (next_random(mut seed) % 3) + n * (next_random(mut seed) % 2);
                (turn + next_random(mut seed) % 3 - 1).max(0)
            };
            queries.push((time, next_random(mut seed) % n));
        }
        problems.push((nums, queries));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (nums, queries) in problems.iter() {
        let truth = literal(nums, queries);
        for x in truth.iter() {
            check = (check * 31 + x + 1) % 1000000007;
        }
        let n = nums.len();
        let raised: Vec[i64] = nums.iter().map(|x| x + 5).collect();
        let later: Vec[(i64, i64)] = queries.iter().map(|(time, index)| (time + 2 * n, index)).collect();
        let mut reversed = queries.clone();
        reversed.reverse();
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, nums, queries)).collect();
        for arm in 0..6 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let mut flipped = answer(arm, nums, reversed);
            flipped.reverse();
            let verdicts = [
                x == truth,
                x.len() == queries.len() and x.iter().all(|a| a == -1 or nums.contains(a)),
                answer(arm, nums, later) == x,
                answer(arm, raised, queries) == Vec[i64].from_iter(x.iter().map(|a| if a == -1 { -1 } else { a + 5 })),
                flipped == x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} at {queries} arm {names[arm]}: P{q + 1} fails, answers {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} arrays: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
