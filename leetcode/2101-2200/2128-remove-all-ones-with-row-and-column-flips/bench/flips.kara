// LeetCode #2128: Remove All Ones With Row and Column Flips -- the
// benchmark, flips.kara's ★ arm. 20 grids of 300 by 300 built once from a
// zero grid's rows and columns flipped; then every grid solved 100 times,
// one random row flipped before each solve, and every other time one
// random cell flipped for that solve and back after it.

fn remove_ones(grid: Vec[Vec[i64]]) -> bool {
    let first = ref grid[0];
    for row in grid.iter() {
        for j in 0..row.len() {
            if row[j] ^ row[0] != first[j] ^ first[0] {
                return false;
            }
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 300;
    let mut seed = 2128;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..20 {
        let mut columns: Vec[i64] = Vec.new();
        for _ in 0..n {
            columns.push(next_random(mut seed) % 2);
        }
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            let r = next_random(mut seed) % 2;
            grid.push(columns.iter().map(|c| c ^ r).collect());
        }
        grids.push(grid);
    }
    let mut cleared = 0;
    let mut check = 0;
    for round in 0..100 {
        for k in 0..20 {
            let r = next_random(mut seed) % n;
            for c in grids[k][r].iter_mut() {
                *c = 1 - *c;
            }
            let broken = next_random(mut seed) % 2 == 0;
            let i = next_random(mut seed) % n;
            let j = next_random(mut seed) % n;
            if broken {
                grids[k][i][j] = 1 - grids[k][i][j];
            }
            if remove_ones(grids[k]) {
                cleared += 1;
                check = (check * 31 + round * 20 + k) % 1000000007;
            }
            if broken {
                grids[k][i][j] = 1 - grids[k][i][j];
            }
        }
    }
    println(f"2000 solves: {cleared} cleared, checksum {check}");
}
