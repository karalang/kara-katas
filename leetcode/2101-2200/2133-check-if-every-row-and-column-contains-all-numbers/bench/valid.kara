// LeetCode #2133: Check if Every Row and Column Contains All Numbers --
// the benchmark, valid.kara's ★ arm. 10 Latin squares of order 100 built
// once; then 20000 solves, each of one square: on an odd round two of its
// rows swapped for good, which keeps it valid, and on an even round two
// cells of a row swapped for the solve and back after.

fn check_valid(matrix: Vec[Vec[i64]]) -> bool {
    let n = matrix.len();
    let mut mark: Vec[i64] = Vec.filled(n + 1, -1);
    for i in 0..n {
        // line 2i is row i, line 2i + 1 is column i
        for j in 0..n {
            let v = matrix[i][j];
            if mark[v] == 2 * i {
                return false;
            }
            mark[v] = 2 * i;
        }
        for j in 0..n {
            let v = matrix[j][i];
            if mark[v] == 2 * i + 1 {
                return false;
            }
            mark[v] = 2 * i + 1;
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn latin(n: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut rows: Vec[i64] = (0..n).collect();
    let mut symbols: Vec[i64] = (1..n + 1).collect();
    for i in (1..n).rev() {
        rows.swap(i, next_random(mut seed) % (i + 1));
        symbols.swap(i, next_random(mut seed) % (i + 1));
    }
    (0..n).map(|r| (0..n).map(|c| symbols[(rows[r] + c) % n]).collect()).collect()
}

fn main() {
    let mut seed = 2133;
    let mut squares: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..10 {
        squares.push(latin(100, mut seed));
    }
    let mut valid = 0;
    let mut check = 0;
    for round in 0..20000 {
        let k = next_random(mut seed) % 10;
        let r = next_random(mut seed) % 100;
        let a = next_random(mut seed) % 100;
        let b = next_random(mut seed) % 100;
        let mut ok = false;
        if round % 2 == 1 {
            squares[k].swap(a, b);
            ok = check_valid(squares[k]);
        } else {
            squares[k][r].swap(a, b);
            ok = check_valid(squares[k]);
            squares[k][r].swap(a, b);
        }
        let x = if ok { 1 } else { 0 };
        valid += x;
        check = (check * 31 + x + squares[k][r][a]) % 1000000007;
    }
    println(f"20000 solves: {valid} valid, checksum {check}");
}
