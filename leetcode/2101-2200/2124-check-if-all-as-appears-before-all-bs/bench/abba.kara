// LeetCode #2124: Check if All A's Appears Before All B's -- the
// benchmark, abba.kara's ★ arm: the answer is that "ba" does not occur.
// 100000 strings of 100 letters built once, each some a's then some b's
// with a quarter of them given one letter out of order; then 50 rounds
// over all of them, one string's letter flipped before each round.

fn check_string(s: String) -> bool {
    not s.contains("ba")
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2124;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..100000 {
        let split = next_random(mut seed) % 101;
        let mut letters: Vec[u8] = Vec.new();
        for i in 0..100 {
            letters.push(if i < split { b'a' } else { b'b' });
        }
        if next_random(mut seed) % 4 == 0 {
            let at = next_random(mut seed) % 100;
            letters[at] = if letters[at] == b'a' { b'b' } else { b'a' };
        }
        strings.push(String.from_utf8(letters).unwrap());
    }
    let mut ordered = 0;
    let mut check = 0;
    for round in 0..50 {
        let k = round * 7919 % 100000;
        let at = round * 31 % 100;
        let mut letters = strings[k].bytes().to_vec();
        letters[at] = if letters[at] == b'a' { b'b' } else { b'a' };
        strings[k] = String.from_utf8(letters).unwrap();
        for i in 0..strings.len() {
            if check_string(strings[i]) {
                ordered += 1;
                check = (check * 31 + i) % 1000000007;
            }
        }
    }
    println(f"5000000 checks: {ordered} in order, checksum {check}");
}
