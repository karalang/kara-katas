// LeetCode #2132: Stamping the Grid -- the benchmark, stamp.kara's ★ arm.
// A grid of 400 by 500 built once, rooms of 3 by 3 behind walls; then
// solved 100 times, one cell flipped and a stamp of 1 to 3 by 1 to 3
// drawn before each solve, the cell flipped back after.
fn possible_to_stamp(grid: Vec[Vec[i64]], stamp_height: i64, stamp_width: i64) -> bool {
    let m = grid.len();
    let n = grid[0].len();
    let w = n + 1;
    // full[r * w + c]: the occupied cells above row r and left of column c
    let mut full: Vec[i64] = Vec.filled((m + 1) * w, 0);
    for r in 0..m {
        for c in 0..n {
            full[(r + 1) * w + c + 1] = grid[r][c] + full[r * w + c + 1] + full[(r + 1) * w + c] - full[r * w + c];
        }
    }
    let mut marks: Vec[i64] = Vec.filled((m + 1) * w, 0);
    for r in 0..m - stamp_height + 1 {
        for c in 0..n - stamp_width + 1 {
            let r2 = r + stamp_height;
            let c2 = c + stamp_width;
            if full[r2 * w + c2] - full[r * w + c2] - full[r2 * w + c] + full[r * w + c] == 0 {
                marks[r * w + c] += 1;
                marks[r * w + c2] -= 1;
                marks[r2 * w + c] -= 1;
                marks[r2 * w + c2] += 1;
            }
        }
    }
    // marks summed in place: the stamps over each cell
    for r in 0..m {
        for c in 0..n {
            if r > 0 {
                marks[r * w + c] += marks[(r - 1) * w + c];
            }
            if c > 0 {
                marks[r * w + c] += marks[r * w + c - 1];
            }
            if r > 0 and c > 0 {
                marks[r * w + c] -= marks[(r - 1) * w + c - 1];
            }
            if grid[r][c] == 0 and marks[r * w + c] == 0 {
                return false;
            }
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2132;
    // rooms of 3 by 3 behind walls, a wall on every row and column that
    // leaves 3 over when divided by 4
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for r in 0..400 {
        let mut row: Vec[i64] = Vec.new();
        for c in 0..500 {
            row.push(if r % 4 == 3 or c % 4 == 3 { 1 } else { 0 });
        }
        grid.push(row);
    }
    let mut stamped = 0;
    let mut check = 0;
    for round in 0..100 {
        let at = (next_random(mut seed) * 32768 + next_random(mut seed)) % 200000;
        grid[at / 500][at % 500] = 1 - grid[at / 500][at % 500];
        let h = next_random(mut seed) % 3 + 1;
        let w = next_random(mut seed) % 3 + 1;
        let fits = if possible_to_stamp(grid, h, w) { 1 } else { 0 };
        grid[at / 500][at % 500] = 1 - grid[at / 500][at % 500];
        stamped += fits;
        check = (check * 31 + fits + at + round) % 1000000007;
    }
    println(f"100 solves: {stamped} stamped, checksum {check}");
}
