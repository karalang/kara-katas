// LeetCode #2129: Capitalize the Title -- the differential. The six arms,
// against the statement read literally: each letter looked up in the
// alphabet in both cases, its word found by scanning left and right to a
// space, and the letter written as a capital when it starts a word of
// three letters or more and in small otherwise. 300 random titles of 1
// to 5 words of 1 to 5 letters; then 30 of words of 1 to 3 letters only;
// then 30 of one word of 1 to 8; every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the words in reverse order: the answer's words reversed
// P3  every letter's case swapped: the same answer
// P4  the title written twice with a space between: the answer twice
// P5  the answer capitalized again: the same answer
// P6  each arm agrees with at least three of the other five

// ---- title.kara: the ★ arm, split, lowered, the long words raised
fn star_capitalize_title(title: Str) -> String {
    let words: Vec[String] = title
        .split(" ")
        .map(|w| {
            let lower = w.to_lowercase();
            if lower.len() <= 2 {
                lower
            } else {
                f"{lower[..1].to_uppercase()}{lower[1..]}"
            }
        })
        .collect();
    words.join(" ")
}

// ---- title_bytes.kara: one pass over the bytes, each word closed at its space
fn bytes_capitalize_title(title: Str) -> String {
    let bytes = title.bytes();
    let n = bytes.len();
    let mut out = String.new();
    let mut start = 0;
    for i in 0..n + 1 {
        if i < n and bytes[i] != 32 {
            continue;
        }
        for k in start..i {
            let mut b = bytes[k];
            if b >= 65 and b <= 90 {
                b += 32;
            }
            if k == start and i - start > 2 {
                b -= 32;
            }
            out.push(char.try_from(b as u32).ok().unwrap());
        }
        if i < n {
            out.push(' ');
        }
        start = i + 1;
    }
    out
}

// ---- title_chars.kara: a `Vec[char]` word handed on at each space
fn chars_capitalize_title(title: Str) -> String {
    let mut out = String.new();
    let mut word: Vec[char] = Vec.new();
    for c in title.chars().chain(" ".chars()) {
        if c != ' ' {
            word.push(c.to_ascii_lowercase());
            continue;
        }
        if word.len() > 2 {
            word[0] = word[0].to_ascii_uppercase();
        }
        if not out.is_empty() {
            out.push(' ');
        }
        for w in word.iter() {
            out.push(w);
        }
        word.clear();
    }
    out
}

// ---- title_struct.kara: a `Word` whose `capitalized` matches on its length
struct StructWord {
    text: String,
}

impl StructWord {
    fn capitalized(ref self) -> String {
        let lower = self.text.to_lowercase();
        match lower.len() {
            0..=2 => lower,
            _ => lower[..1].to_uppercase() + lower[1..].to_string(),
        }
    }
}

fn struct_capitalize_title(title: Str) -> String {
    title
        .split(" ")
        .map(|w| StructWord { text: w.to_string() }.capitalized())
        .fold(String.new(), |acc, w| if acc.is_empty() { w } else { acc + " " + w })
}

// ---- title_words.kara: `split_whitespace`, each long word rewritten in place
fn words_capitalize_title(title: Str) -> String {
    let mut words: Vec[String] = title.split_whitespace().map(|w| w.to_lowercase()).collect();
    for w in words.iter_mut() {
        if w.len() >= 3 {
            *w = f"{w[..1].to_uppercase()}{w[1..]}";
        }
    }
    words.join(" ")
}

// ---- title_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn capitalize_title(title: String) -> String {
        Vec[String].from_iter(title
            .split(" ")
            .map(|w| {
                let lower = w.to_lowercase();
                if lower.len() <= 2 {
                    lower
                } else {
                    let mut cs = lower.chars();
                    match cs.next() {
                        Some(f) => f.to_string().to_uppercase() + cs.as_str().to_string(),
                        None => String.new(),
                    }
                }
            })
            )
            .join(" ")
    }
}

struct SolutionSolution {}

fn solution_capitalize_title(title: Str) -> String {
    SolutionSolution.capitalize_title(title.to_string())
}

// ---- the statement read literally

fn literal(title: Str) -> String {
    let small = "abcdefghijklmnopqrstuvwxyz";
    let capital = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let cells: Vec[char] = title.chars().collect();
    let n = cells.len();
    let mut out = String.new();
    for i in 0..n {
        if cells[i] == ' ' {
            out.push(' ');
            continue;
        }
        let mut start = i;
        while start > 0 and cells[start - 1] != ' ' {
            start -= 1;
        }
        let mut end = i;
        while end < n and cells[end] != ' ' {
            end += 1;
        }
        let mut k = 0;
        for (j, c) in small.chars().enumerate() {
            if c == cells[i] {
                k = j;
            }
        }
        for (j, c) in capital.chars().enumerate() {
            if c == cells[i] {
                k = j;
            }
        }
        if i == start and end - start >= 3 {
            out.push_str(capital[k..k + 1]);
        } else {
            out.push_str(small[k..k + 1]);
        }
    }
    out
}

fn answer(arm: i64, title: Str) -> String {
    match arm {
        0 => star_capitalize_title(title),
        1 => bytes_capitalize_title(title),
        2 => chars_capitalize_title(title),
        3 => struct_capitalize_title(title),
        4 => words_capitalize_title(title),
        _ => solution_capitalize_title(title),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn reversed_words(s: Str) -> String {
    let words: Vec[Str] = s.split(" ").collect();
    let back: Vec[Str] = words.iter().rev().collect();
    back.join(" ")
}

fn swapped(s: Str) -> String {
    s.chars()
        .map(|c| if c.is_ascii_uppercase() { c.to_ascii_lowercase() } else { c.to_ascii_uppercase() })
        .collect()
}

fn main() {
    let names = ["star", "bytes", "chars", "struct", "words", "solution"];
    let letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let mut seed = 2129;
    let mut problems: Vec[String] = Vec.new();
    for t in 0..360 {
        let mut words = 1;
        let mut longest = 8;
        if t < 300 {
            words = next_random(mut seed) % 5 + 1;
            longest = 5;
        } else if t < 330 {
            words = next_random(mut seed) % 6 + 1;
            longest = 3;
        }
        let mut title = String.new();
        for w in 0..words {
            if w > 0 {
                title.push_str(" ");
            }
            let len = next_random(mut seed) % longest + 1;
            for _ in 0..len {
                let k = next_random(mut seed) % 52;
                title.push_str(letters[k..k + 1]);
            }
        }
        problems.push(title);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for title in problems.iter() {
        let truth = literal(title);
        for b in truth.bytes() {
            check = (check * 31 + b) % 1000000007;
        }
        check = (check * 31 + truth.len()) % 1000000007;
        let back = reversed_words(title);
        let turned = swapped(title);
        let twice = f"{title} {title}";
        let got: Vec[String] = (0..6).map(|arm| answer(arm, title)).collect();
        for arm in 0..6 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, back) == reversed_words(x),
                answer(arm, turned) == x,
                answer(arm, twice) == f"{x} {x}",
                answer(arm, x) == x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"\"{title}\" arm {names[arm]}: P{q + 1} fails, answered \"{x}\", literal \"{truth}\"");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} titles: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
