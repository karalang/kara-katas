// LeetCode #2155: All Divisions With the Highest Score of a Binary Array
// -- the benchmark: the ★ arm over four lists of 100000 bits, one bit
// flipped before each of 200 solves.

fn max_score_indices(nums: Vec[i64]) -> Vec[i64] {
    let mut right_ones = nums.iter().filter(|x| x == 1).count();
    let mut left_zeros = 0;
    let mut top = right_ones;
    let mut found: Vec[i64] = [0].to_vec();
    for (i, x) in nums.iter().enumerate() {
        if x == 0 {
            left_zeros += 1;
        } else {
            right_ones -= 1;
        }
        let score = left_zeros + right_ones;
        if score > top {
            top = score;
            found.clear();
        }
        if score == top {
            found.push(i + 1);
        }
    }
    found
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2155;
    let mut lists: Vec[Vec[i64]] = Vec.new();
    for _ in 0..4 {
        let bits: Vec[i64] = (0..100000).map(|_| next_random(mut seed) % 2).collect();
        lists.push(bits);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..50 {
        for s in 0..4 {
            let at = next_random(mut seed) % 100000;
            lists[s][at] = 1 - lists[s][at];
            let out = max_score_indices(lists[s]);
            total += out.len();
            check = (check * 31 + out.len() + out[0] + out[out.len() - 1] + round) % 1000000007;
        }
    }
    println(f"200 solves: {total} divisions in all, checksum {check}");
}
