// LeetCode #2172: Maximum AND Sum of Array -- LeetCode's Rust template:
// each slot split into two places, a `vec![0; 1 << m]` over the masks,
// `count_ones() as usize`, `(j / 2 + 1) as i32`, `1usize << m`, written
// as Rust. Carried by `karac fix`. The adapter below hands the harness's
// numbers to it.

impl Solution {
    pub fn maximum_and_sum(nums: Vec[i32], num_slots: i32) -> i32 {
        let n = nums.len();
        let m = (num_slots * 2) as i64;
        let mut dp = Vec.filled(1 << m, 0i32);
        let mut ans: i32 = 0;
        for mask in 0..(1 << m) {
            let c = mask.count_ones();
            if c >= n {
                ans = ans.max(dp[mask]);
                continue;
            }
            for j in 0..m {
                if mask & (1 << j) == 0 {
                    let next = mask | (1 << j);
                    dp[next] = dp[next].max(dp[mask] + (nums[c] & (j / 2 + 1) as i32));
                }
            }
        }
        ans
    }
}

struct Solution {}

fn maximum_and_sum(nums: Vec[i64], num_slots: i64) -> i64 {
    Solution.maximum_and_sum(nums.iter().map(|x| x as i32).collect(), num_slots as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64], num_slots: i64) {
    println(f"{nums}, {num_slots} -> {maximum_and_sum(nums, num_slots)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number in one slot, two
    // numbers sharing one slot, eighteen 15s in nine slots, and the slot
    // numbers themselves
    show([1, 2, 3, 4, 5, 6], 3);
    show([1, 3, 10, 4, 7, 1], 9);
    show([5], 1);
    show([1, 3], 1);
    show(Vec.filled(18, 15), 9);
    show([1, 2, 3, 4, 5, 6, 7, 8, 9], 9);
    // 2000 random cases of 1 to 6 slots, each holding 1 to twice the slots
    // numbers of 1 to 15
    let mut seed = 2172;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let num_slots = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % (2 * num_slots) + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 15 + 1).collect();
        let best = maximum_and_sum(nums, num_slots);
        total += best;
        check = (check * 31 + best + n) % 1000000007;
    }
    println(f"2000 cases: {total} in all, checksum {check}");
    // the constraints' largest: nine slots and eighteen numbers at random,
    // three times
    let mut largest: Vec[i64] = Vec.new();
    for _ in 0..3 {
        let nums: Vec[i64] = (0..18).map(|_| next_random(mut seed) % 15 + 1).collect();
        largest.push(maximum_and_sum(nums, 9));
    }
    println(f"9 slots, 18 numbers: {largest}");
}
