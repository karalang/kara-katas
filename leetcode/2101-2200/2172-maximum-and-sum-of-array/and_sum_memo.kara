// LeetCode #2172: Maximum AND Sum of Array -- top down: the best sum for
// the numbers from the next one on, given the slots' fill in base 3, by
// recursion over the slot the next number takes, each fill's answer
// remembered in a memo (`mut ref`). The fill alone says which number is
// next. O(3^slots * slots).

fn rest_best(nums: Vec[i64], powers: Vec[i64], fill: i64, placed: i64, memo: mut ref Vec[i64]) -> i64 {
    if placed == nums.len() {
        return 0;
    }
    if memo[fill] >= 0 {
        return memo[fill];
    }
    let mut best = 0;
    for slot in 0..powers.len() {
        if fill / powers[slot] % 3 < 2 {
            let sum = (nums[placed] & (slot + 1)) + rest_best(nums, powers, fill + powers[slot], placed + 1, mut memo);
            best = best.max(sum);
        }
    }
    memo[fill] = best;
    best
}

fn maximum_and_sum(nums: Vec[i64], num_slots: i64) -> i64 {
    let powers: Vec[i64] = (0..num_slots).map(|k| 3.pow(k as u32)).collect();
    let mut memo: Vec[i64] = Vec.filled(3.pow(num_slots as u32), -1);
    rest_best(nums, powers, 0, 0, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64], num_slots: i64) {
    println(f"{nums}, {num_slots} -> {maximum_and_sum(nums, num_slots)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number in one slot, two
    // numbers sharing one slot, eighteen 15s in nine slots, and the slot
    // numbers themselves
    show([1, 2, 3, 4, 5, 6], 3);
    show([1, 3, 10, 4, 7, 1], 9);
    show([5], 1);
    show([1, 3], 1);
    show(Vec.filled(18, 15), 9);
    show([1, 2, 3, 4, 5, 6, 7, 8, 9], 9);
    // 2000 random cases of 1 to 6 slots, each holding 1 to twice the slots
    // numbers of 1 to 15
    let mut seed = 2172;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let num_slots = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % (2 * num_slots) + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 15 + 1).collect();
        let best = maximum_and_sum(nums, num_slots);
        total += best;
        check = (check * 31 + best + n) % 1000000007;
    }
    println(f"2000 cases: {total} in all, checksum {check}");
    // the constraints' largest: nine slots and eighteen numbers at random,
    // three times
    let mut largest: Vec[i64] = Vec.new();
    for _ in 0..3 {
        let nums: Vec[i64] = (0..18).map(|_| next_random(mut seed) % 15 + 1).collect();
        largest.push(maximum_and_sum(nums, 9));
    }
    println(f"9 slots, 18 numbers: {largest}");
}
