// LeetCode #2172: Maximum AND Sum of Array -- a `struct Ternary` of the
// powers of 3 for the slots, which reads a fill's `digit` for a slot, how
// many numbers it has `placed`, and whether a slot `has_room`, and which
// knows its `size`; the fills are walked in order and each one's best is
// pushed forward. O(3^slots * slots).

struct Ternary {
    powers: Vec[i64],
}

impl Ternary {
    fn of(slots: i64) -> Ternary {
        let mut powers: Vec[i64] = Vec.new();
        let mut p = 1;
        for _ in 0..slots {
            powers.push(p);
            p *= 3;
        }
        Ternary { powers }
    }

    fn size(ref self) -> i64 {
        let last = self.powers.len() - 1;
        self.powers[last] * 3
    }

    fn digit(ref self, fill: i64, slot: i64) -> i64 {
        fill / self.powers[slot] % 3
    }

    fn has_room(ref self, fill: i64, slot: i64) -> bool {
        self.digit(fill, slot) < 2
    }

    fn placed(ref self, fill: i64) -> i64 {
        let mut total = 0;
        for slot in 0..self.powers.len() {
            total += self.digit(fill, slot);
        }
        total
    }
}

fn maximum_and_sum(nums: Vec[i64], num_slots: i64) -> i64 {
    let fills = Ternary.of(num_slots);
    let mut best: Vec[i64] = Vec.filled(fills.size(), -1);
    best[0] = 0;
    let mut answer = 0;
    for fill in 0..fills.size() {
        if best[fill] < 0 {
            continue;
        }
        let placed = fills.placed(fill);
        if placed == nums.len() {
            answer = answer.max(best[fill]);
            continue;
        }
        for slot in 0..num_slots {
            if fills.has_room(fill, slot) {
                let next = fill + fills.powers[slot];
                best[next] = best[next].max(best[fill] + (nums[placed] & (slot + 1)));
            }
        }
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64], num_slots: i64) {
    println(f"{nums}, {num_slots} -> {maximum_and_sum(nums, num_slots)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number in one slot, two
    // numbers sharing one slot, eighteen 15s in nine slots, and the slot
    // numbers themselves
    show([1, 2, 3, 4, 5, 6], 3);
    show([1, 3, 10, 4, 7, 1], 9);
    show([5], 1);
    show([1, 3], 1);
    show(Vec.filled(18, 15), 9);
    show([1, 2, 3, 4, 5, 6, 7, 8, 9], 9);
    // 2000 random cases of 1 to 6 slots, each holding 1 to twice the slots
    // numbers of 1 to 15
    let mut seed = 2172;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let num_slots = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % (2 * num_slots) + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 15 + 1).collect();
        let best = maximum_and_sum(nums, num_slots);
        total += best;
        check = (check * 31 + best + n) % 1000000007;
    }
    println(f"2000 cases: {total} in all, checksum {check}");
    // the constraints' largest: nine slots and eighteen numbers at random,
    // three times
    let mut largest: Vec[i64] = Vec.new();
    for _ in 0..3 {
        let nums: Vec[i64] = (0..18).map(|_| next_random(mut seed) % 15 + 1).collect();
        largest.push(maximum_and_sum(nums, 9));
    }
    println(f"9 slots, 18 numbers: {largest}");
}
