// LeetCode #2172: Maximum AND Sum of Array -- pulled, by iterators: each
// fill in base 3 has its digits by `map`, the numbers placed by `sum`,
// and its best from the slots it holds a number in, `filter`ed, each
// `map`ped to the fill without that number plus what the number gives
// there, and their `max`; the answer the `max` over the fills that hold
// every number. O(3^slots * slots).

fn maximum_and_sum(nums: Vec[i64], num_slots: i64) -> i64 {
    let powers: Vec[i64] = (0..num_slots).map(|k| 3.pow(k as u32)).collect();
    let size = 3.pow(num_slots as u32);
    let mut best: Vec[i64] = Vec.filled(size, 0);
    let mut placed: Vec[i64] = Vec.filled(size, 0);
    for fill in 1..size {
        let digits: Vec[i64] = powers.iter().map(|p| fill / p % 3).collect();
        placed[fill] = digits.iter().sum();
        if placed[fill] > nums.len() {
            continue;
        }
        let number = nums[placed[fill] - 1];
        best[fill] = (0..num_slots)
            .filter(|s| digits[s] > 0)
            .map(|s| best[fill - powers[s]] + (number & (s + 1)))
            .max()
            .unwrap();
    }
    (0..size).filter(|f| placed[f] == nums.len()).map(|f| best[f]).max().unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64], num_slots: i64) {
    println(f"{nums}, {num_slots} -> {maximum_and_sum(nums, num_slots)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number in one slot, two
    // numbers sharing one slot, eighteen 15s in nine slots, and the slot
    // numbers themselves
    show([1, 2, 3, 4, 5, 6], 3);
    show([1, 3, 10, 4, 7, 1], 9);
    show([5], 1);
    show([1, 3], 1);
    show(Vec.filled(18, 15), 9);
    show([1, 2, 3, 4, 5, 6, 7, 8, 9], 9);
    // 2000 random cases of 1 to 6 slots, each holding 1 to twice the slots
    // numbers of 1 to 15
    let mut seed = 2172;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let num_slots = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % (2 * num_slots) + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 15 + 1).collect();
        let best = maximum_and_sum(nums, num_slots);
        total += best;
        check = (check * 31 + best + n) % 1000000007;
    }
    println(f"2000 cases: {total} in all, checksum {check}");
    // the constraints' largest: nine slots and eighteen numbers at random,
    // three times
    let mut largest: Vec[i64] = Vec.new();
    for _ in 0..3 {
        let nums: Vec[i64] = (0..18).map(|_| next_random(mut seed) % 15 + 1).collect();
        largest.push(maximum_and_sum(nums, 9));
    }
    println(f"9 slots, 18 numbers: {largest}");
}
