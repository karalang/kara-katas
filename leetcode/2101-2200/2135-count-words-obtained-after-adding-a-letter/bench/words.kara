// LeetCode #2135: Count Words Obtained After Adding a Letter -- the
// benchmark, words.kara's ★ arm. 4 pairs of lists of 50000 words built
// once, each word of 1 to 6 distinct letters from the first 12; then
// every pair solved 25 times, one start word and one target word
// replaced by new ones before each solve.

fn letters(w: Str) -> i64 {
    let mut mask = 0;
    for b in w.bytes() {
        mask |= 1 << (b - 97);
    }
    mask
}

fn word_count(start_words: Vec[String], target_words: Vec[String]) -> i64 {
    let starts: Set[i64] = start_words.iter().map(|w| letters(w)).collect();
    let mut count = 0;
    for w in target_words.iter() {
        let mask = letters(w);
        for b in w.bytes() {
            if starts.contains(mask ^ (1 << (b - 97))) {
                count += 1;
                break;
            }
        }
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn word(len: i64, k: i64, seed: mut ref i64) -> String {
    let mut letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().take(k).collect();
    let mut out = String.new();
    for i in 0..len {
        let j = i + next_random(mut seed) % (k - i);
        letters.swap(i, j);
        out.push(letters[i]);
    }
    out
}

fn main() {
    let mut seed = 2135;
    let mut starts: Vec[Vec[String]] = Vec.new();
    let mut targets: Vec[Vec[String]] = Vec.new();
    for _ in 0..4 {
        let mut s: Vec[String] = Vec.new();
        let mut t: Vec[String] = Vec.new();
        for _ in 0..50000 {
            let len = next_random(mut seed) % 6 + 1;
            s.push(word(len, 12, mut seed));
        }
        for _ in 0..50000 {
            let len = next_random(mut seed) % 6 + 1;
            t.push(word(len, 12, mut seed));
        }
        starts.push(s);
        targets.push(t);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..25 {
        for p in 0..4 {
            let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % 50000;
            let len = next_random(mut seed) % 6 + 1;
            starts[p][a] = word(len, 12, mut seed);
            let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % 50000;
            let len = next_random(mut seed) % 6 + 1;
            targets[p][b] = word(len, 12, mut seed);
            let count = word_count(starts[p], targets[p]);
            total += count;
            check = (check * 31 + count + round) % 1000000007;
        }
    }
    println(f"100 solves: {total} words in all, checksum {check}");
}
