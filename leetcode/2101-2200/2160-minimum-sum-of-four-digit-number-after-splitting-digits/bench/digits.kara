// LeetCode #2160: Minimum Sum of Four Digit Number After Splitting Digits
// -- the benchmark: the ★ arm over all 9000 numbers of four digits, 200
// times, each pass starting at a different number so that no pass repeats
// the one before.

fn minimum_sum(num: i64) -> i64 {
    let mut d: Vec[i64] = num.to_string().chars().map(|c| c.to_digit(10).unwrap() as i64).collect();
    d.sort();
    (d[0] * 10 + d[2]) + (d[1] * 10 + d[3])
}

fn main() {
    let mut total = 0;
    let mut check = 0;
    for pass in 0..200 {
        for k in 0..9000 {
            let num = 1000 + (k + 37 * pass) % 9000;
            let sum = minimum_sum(num);
            total += sum;
            check = (check * 31 + sum + pass) % 1000000007;
        }
    }
    println(f"1800000 solves: {total} in all, checksum {check}");
}
