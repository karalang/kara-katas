// LeetCode #2186: Minimum Number of Steps to Make Two Strings Anagram II
// -- the benchmark's Kāra arm: the ★ arm, one balance of 26 counts.

fn min_steps(s: String, t: String) -> i64 {
    let mut balance: Vec[i64] = Vec.filled(26, 0);
    for b in s.bytes() {
        balance[b - 97] += 1;
    }
    for b in t.bytes() {
        balance[b - 97] -= 1;
    }
    let mut steps = 0;
    for d in balance.iter() {
        steps += d.abs();
    }
    steps
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2186;
    let mut row = String.new();
    for _ in 0..1000000 {
        row.push((97 + next_random(mut seed) % 26) as u8 as char);
    }
    let mut check = 0;
    for _ in 0..200 {
        let a = next_random(mut seed);
        let b = next_random(mut seed);
        let c = next_random(mut seed);
        let d = next_random(mut seed);
        let i = (a * 32768 + b) % 800001;
        let j = (c * 32768 + d) % 800001;
        let steps = min_steps(row[i..(i + 200000)].to_string(), row[j..(j + 200000)].to_string());
        check = (check * 31 + steps) % 1000000007;
    }
    println(f"200 solves: checksum {check}");
}
