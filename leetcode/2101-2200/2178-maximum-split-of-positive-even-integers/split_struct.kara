// LeetCode #2178: Maximum Split of Positive Even Integers -- a `struct
// Split` of the parts so far and what is left, made `of` a sum, that
// `can_take` the next even (`ref self`), `take`s it (`mut ref self`), and
// is `finish`ed by putting the rest on its last part. O(sqrt(finalSum)).

struct Split {
    parts: Vec[i64],
    left: i64,
}

impl Split {
    fn of(final_sum: i64) -> Split {
        Split { parts: Vec.new(), left: final_sum }
    }

    fn next(ref self) -> i64 {
        2 * (self.parts.len() + 1)
    }

    fn can_take(ref self) -> bool {
        self.left >= self.next()
    }

    fn take(mut ref self) {
        let part = self.next();
        self.parts.push(part);
        self.left -= part;
    }

    fn finish(own self) -> Vec[i64] {
        let mut parts = self.parts;
        let last = parts.len() - 1;
        parts[last] += self.left;
        parts
    }
}

fn maximum_even_split(final_sum: i64) -> Vec[i64] {
    if final_sum % 2 != 0 {
        return Vec.new();
    }
    let mut split = Split.of(final_sum);
    while split.can_take() {
        split.take();
    }
    split.finish()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(final_sum: i64) {
    println(f"{final_sum} -> {maximum_even_split(final_sum)}");
}

fn fold(check: i64, parts: Vec[i64]) -> i64 {
    let mut check = (check * 31 + parts.len()) % 1000000007;
    for p in parts.iter() {
        check = (check * 31 + p % 1000000007) % 1000000007;
    }
    check
}

fn main() {
    // LeetCode's three examples, then four more: 2, 4, 1, and 38, which
    // leaves 8 after 2 to 10, too little for a 12
    show(12);
    show(7);
    show(28);
    show(2);
    show(4);
    show(1);
    show(38);
    // 2000 random sums of up to 100, 10^4 or 10^6 in turn, about half of
    // them even
    let mut seed = 2178;
    let mut parts_in_all = 0;
    let mut check = 0;
    for round in 0..2000 {
        let top = [100, 10000, 1000000][round % 3];
        let a = next_random(mut seed);
        let b = next_random(mut seed);
        let final_sum = (a * 32768 + b) % top + 1;
        let parts = maximum_even_split(final_sum);
        parts_in_all += parts.len();
        check = fold(check, parts);
    }
    println(f"2000 sums: {parts_in_all} parts in all, checksum {check}");
    // the constraints' largest: 10^10 and the even sum just under it
    for final_sum in [10000000000, 9999999998] {
        let parts = maximum_even_split(final_sum);
        let last = parts[parts.len() - 1];
        println(f"{final_sum}: {parts.len()} parts, the last {last}, checksum {fold(0, parts)}");
    }
}
