// LeetCode #2103: Rings and Rods -- a `Set` of colors per rod. The ten
// rods are a `Vec[Set[char]]`; each ring's color goes into its rod's set
// from the string's `chars()` taken two at a time with `zip` over the
// even and odd positions, and the rods whose set holds three colors are
// counted. O(n).

fn count_points(rings: Str) -> i64 {
    let mut rods: Vec[Set[char]] = Vec.filled(10, Set.new());
    let colors = rings.chars().step_by(2);
    let places = rings.chars().skip(1).step_by(2);
    for (color, rod) in colors.zip(places) {
        rods[rod.to_digit(10).unwrap()].insert(color);
    }
    rods.iter().filter(|s| s.len() == 3).count()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then four more: every rod holding all
    // three, one color many times, two colors only, and the longest a
    // string may be
    let mut every = String.new();
    for d in 0..10 {
        every.push_str(f"R{d}G{d}B{d}");
    }
    let examples = [
        "B0B6G0R6R0R6G9",
        "B0R0G0R9R0B0G0",
        "G4",
        every,
        "R3R3R3R3",
        "R1G1R2G2",
        "R0G1B2".repeat(33) + "R0",
    ];
    for rings in examples.iter() {
        println(f"{rings} -> {count_points(rings)}");
    }
    // 3000 random strings of 1 to 100 rings on rods 0 to 9, or on rods 0
    // to 2 so that rods fill up
    let mut seed = 2103;
    let mut total = 0;
    let mut check = 0;
    for round in 0..3000 {
        let n = next_random(mut seed) % 100 + 1;
        let rods = if round % 2 == 0 { 10 } else { 3 };
        let mut rings = String.new();
        for _ in 0..n {
            rings.push("RGB".bytes()[next_random(mut seed) % 3] as char);
            rings.push((b'0' + (next_random(mut seed) % rods) as u8) as char);
        }
        let got = count_points(rings);
        total += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"3000 strings: {total} rods with all three, checksum {check}");
}
