// LeetCode #2139: Minimum Moves to Reach Target Score -- the benchmark,
// moves.kara's ★ arm. 1000 targets of 1 to 10^9 built once; then 4000
// rounds over them, round r asking each target plus r with r % 40
// doubles, 4000000 solves in all.

fn min_moves(target: i64, max_doubles: i64) -> i64 {
    let mut target = target;
    let mut doubles = max_doubles;
    let mut moves = 0;
    while target > 1 and doubles > 0 {
        if target % 2 == 1 {
            target -= 1;
        } else {
            target /= 2;
            doubles -= 1;
        }
        moves += 1;
    }
    moves + target - 1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2139;
    let mut targets: Vec[i64] = Vec.new();
    for _ in 0..1000 {
        targets.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..4000 {
        for i in 0..1000 {
            let moves = min_moves(targets[i] + r, r % 40);
            total += moves;
            check = (check * 31 + moves) % 1000000007;
        }
    }
    println(f"4000000 solves: {total} moves in all, checksum {check}");
}
