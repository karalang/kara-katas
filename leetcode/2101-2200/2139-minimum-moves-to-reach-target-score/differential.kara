// LeetCode #2139: Minimum Moves to Reach Target Score -- the
// differential. The six arms, against the statement read literally: a
// search, breadth first, from 1 with no double spent, each move adding 1
// or, while doubles are left, doubling, until the target is reached;
// numbers past the target are never needed, since neither move makes a
// number smaller. No order of the moves is assumed. 300 random targets of
// 1 to 200 with 0 to 8 doubles; then 30 powers of two up to 2^9 with 0 to
// 10; then 30 of one less than a power of two; every one drawn before
// any arm answers.
//
// P1  the moves are the statement read literally
// P2  one double more: no more moves
// P3  no doubles: the target less 1
// P4  the target doubled, with one double more: one move more
// P5  the target doubled and one added, with one double more: two more
// P6  each arm agrees with at least three of the other five

// ---- moves.kara: the ★ arm, from the target back to 1
fn star_min_moves(target: i64, max_doubles: i64) -> i64 {
    let mut target = target;
    let mut doubles = max_doubles;
    let mut moves = 0;
    while target > 1 and doubles > 0 {
        if target % 2 == 1 {
            target -= 1;
        } else {
            target /= 2;
            doubles -= 1;
        }
        moves += 1;
    }
    moves + target - 1
}

// ---- moves_rec.kara: recursive
fn rec_min_moves(target: i64, max_doubles: i64) -> i64 {
    if target == 1 {
        0
    } else if max_doubles == 0 {
        target - 1
    } else if target % 2 == 1 {
        1 + rec_min_moves(target - 1, max_doubles)
    } else {
        1 + rec_min_moves(target / 2, max_doubles - 1)
    }
}

// ---- moves_bits.kara: by the bits
fn bits_min_moves(target: i64, max_doubles: i64) -> i64 {
    let width = 63 - target.leading_zeros();
    let halvings = width.min(max_doubles);
    let low = target & ((1 << halvings) - 1);
    halvings + low.count_ones() + (target >> halvings) - 1
}

// ---- moves_struct.kara: a `Climb` taken back one move at a time
struct ClimbClimb {
    at: i64,
    doubles: i64,
    moves: i64,
}

impl ClimbClimb {
    fn can_halve(ref self) -> bool {
        self.at > 1 and self.doubles > 0
    }

    fn back(mut ref self) {
        if self.at % 2 == 1 {
            self.at -= 1;
        } else {
            self.at /= 2;
            self.doubles -= 1;
        }
        self.moves += 1;
    }

    fn total(ref self) -> i64 {
        self.moves + self.at - 1
    }
}

fn climb_min_moves(target: i64, max_doubles: i64) -> i64 {
    let mut climb = ClimbClimb { at: target, doubles: max_doubles, moves: 0 };
    while climb.can_halve() {
        climb.back();
    }
    climb.total()
}

// ---- moves_forward.kara: forward from 1, a `fold` over the low bits
fn forward_min_moves(target: i64, max_doubles: i64) -> i64 {
    let mut width = 0;
    while (target >> (width + 1)) > 0 {
        width += 1;
    }
    let low = width.min(max_doubles);
    let top = target >> low;
    let (reached, moves) = (0..low).rev().fold((top, top - 1), |(at, moves), bit| {
        let one = (target >> bit) & 1;
        (2 * at + one, moves + 1 + one)
    });
    if reached == target { moves } else { -1 }
}

// ---- moves_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn min_moves(target: own i32, max_doubles: own i32) -> i32 {
        let mut target = target;
        let mut max_doubles = max_doubles;
        let mut moves: i32 = 0;
        while target > 1 and max_doubles > 0 {
            if target % 2 == 1 {
                target -= 1;
            } else {
                target /= 2;
                max_doubles -= 1;
            }
            moves += 1;
        }
        moves + target - 1
    }
}

struct SolutionSolution {}

fn solution_min_moves(target: i64, max_doubles: i64) -> i64 {
    SolutionSolution.min_moves(target as i32, max_doubles as i32)
}


// ---- the statement read literally

fn literal(target: i64, max_doubles: i64) -> i64 {
    // the fewest moves to each number with each count of doubles spent
    let width = max_doubles + 1;
    let mut seen: Vec[bool] = Vec.filled((target + 1) * width, false);
    let mut frontier: Vec[(i64, i64)] = [(1, 0)].to_vec();
    seen[width] = true;
    let mut moves = 0;
    while frontier.len() > 0 {
        let mut next: Vec[(i64, i64)] = Vec.new();
        for (at, spent) in frontier.iter() {
            if at == target {
                return moves;
            }
            let mut steps: Vec[(i64, i64)] = [(at + 1, spent)].to_vec();
            if spent < max_doubles {
                steps.push((2 * at, spent + 1));
            }
            for (to, used) in steps.iter() {
                if to <= target and not seen[to * width + used] {
                    seen[to * width + used] = true;
                    next.push((to, used));
                }
            }
        }
        frontier = next;
        moves += 1;
    }
    -1
}

fn answer(arm: i64, target: i64, max_doubles: i64) -> i64 {
    match arm {
        0 => star_min_moves(target, max_doubles),
        1 => rec_min_moves(target, max_doubles),
        2 => bits_min_moves(target, max_doubles),
        3 => climb_min_moves(target, max_doubles),
        4 => forward_min_moves(target, max_doubles),
        _ => solution_min_moves(target, max_doubles),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "rec", "bits", "climb", "forward", "solution"];
    let mut seed = 2139;
    let mut cases: Vec[(i64, i64)] = Vec.new();
    for t in 0..360 {
        let target = if t < 300 {
            next_random(mut seed) % 200 + 1
        } else if t < 330 {
            1 << (next_random(mut seed) % 10)
        } else {
            (1 << (next_random(mut seed) % 8 + 1)) - 1
        };
        let doubles = next_random(mut seed) % (if t < 300 { 9 } else { 11 });
        cases.push((target, doubles));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (target, doubles) in cases.iter() {
        let truth = literal(target, doubles);
        check = (check * 31 + truth + doubles) % 1000000007;
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, target, doubles)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, target, doubles + 1) <= x,
                answer(arm, target, 0) == target - 1,
                answer(arm, 2 * target, doubles + 1) == x + 1,
                answer(arm, 2 * target + 1, doubles + 1) == x + 2,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{target} {doubles} arm {names[arm]}: P{q + 1} fails, answered {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} targets: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
