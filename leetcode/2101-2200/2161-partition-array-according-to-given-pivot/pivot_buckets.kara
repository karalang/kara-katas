// LeetCode #2161: Partition Array According to Given Pivot -- one pass
// that drops each number into one of three lists by a `match` on
// `x.cmp(pivot)`, then the lists joined, Rust's `append` written by `karac fix`
// as `extend(mem.take(mut ..))`. O(n), three lists.

fn pivot_array(nums: Vec[i64], pivot: i64) -> Vec[i64] {
    let mut below: Vec[i64] = Vec.new();
    let mut equal: Vec[i64] = Vec.new();
    let mut above: Vec[i64] = Vec.new();
    for x in nums.iter() {
        match x.cmp(pivot) {
            Ordering.Less => below.push(x),
            Ordering.Equal => equal.push(x),
            Ordering.Greater => above.push(x),
        }
    }
    below.extend(mem.take(mut equal));
    below.extend(mem.take(mut above));
    below
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn show(nums: Vec[i64], pivot: i64) {
    println(f"{nums}, {pivot} -> {pivot_array(nums, pivot)}");
}

fn fold(out: Vec[i64], check: i64) -> i64 {
    let mut check = check;
    for x in out.iter() {
        check = (check * 31 + x + 1000001) % 1000000007;
    }
    check
}

fn main() {
    // LeetCode's two examples, then four more: one number, all the pivot,
    // all but one below it, and the pivot first and last
    show([9, 12, 5, 10, 14, 3, 10].to_vec(), 10);
    show([-3, 4, 3, 2].to_vec(), 2);
    show([7].to_vec(), 7);
    show([4, 4, 4].to_vec(), 4);
    show([3, 1, 2, 9].to_vec(), 9);
    show([5, 8, 1, 5].to_vec(), 5);
    // 2000 random lists of 1 to 12 numbers within 5, 50 or 10^6 of 0 in
    // turn, the pivot one of them
    let mut seed = 2161;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let reach = [5, 50, 1000000][round % 3];
        let nums: Vec[i64] = (0..n).map(|_| wide_random(mut seed) % (2 * reach + 1) - reach).collect();
        let pivot = nums[next_random(mut seed) % n];
        check = fold(pivot_array(nums, pivot), check);
    }
    println(f"2000 lists: checksum {check}");
    // the constraints' largest, 100000 numbers: at random within 10^6 of 0,
    // and all one number
    let random: Vec[i64] = (0..100000).map(|_| wide_random(mut seed) % 2000001 - 1000000).collect();
    let pivot = random[wide_random(mut seed) % 100000];
    let out = pivot_array(random, pivot);
    println(f"100000 at random, pivot {pivot}: first {out[0]}, last {out[99999]}, checksum {fold(out, 0)}");
    let same: Vec[i64] = Vec.filled(100000, -1000000);
    let out = pivot_array(same, -1000000);
    println(f"100000 the same: first {out[0]}, last {out[99999]}, checksum {fold(out, 0)}");
}
