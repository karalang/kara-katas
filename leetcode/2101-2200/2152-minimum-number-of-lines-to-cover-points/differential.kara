// LeetCode #2152: Minimum Number of Lines to Cover Points -- the
// differential. The six arms, against the statement read literally: the
// points are split into groups in every way there is, each point joining
// a group already begun or starting one, and a split counts when every
// group lies on one line, three points at a time; the fewest groups of
// any split is the answer, since a line can be given the points it
// covers and a group on one line is covered by it. No mask is formed.
// 300 random sets of 1 to 7 points in -2 to 2 or -6 to 6 in turn; then
// 30 with every point but one on one line; then 30 on two lines; every
// one drawn before any arm answers.
//
// P1  the fewest lines are the statement read literally
// P2  the points in reverse order: the same
// P3  every point moved by (7, -3): the same
// P4  every point turned a quarter round the origin: the same
// P5  every point sheared, (x, y) to (x + 2y, y): the same
// P6  each arm agrees with at least three of the other five

// ---- lines.kara: the ★ arm, forwards over the masks from the lowest uncovered point
fn star_minimum_lines(points: Vec[Vec[i64]]) -> i64 {
    let n = points.len();
    let full = (1 << n) - 1;
    let mut fewest: Vec[i64] = Vec.filled(1 << n, n + 1);
    fewest[0] = 0;
    for mask in 0..full {
        if fewest[mask] > n {
            continue;
        }
        let mut i = 0;
        while (mask >> i) & 1 == 1 {
            i += 1;
        }
        let alone = mask | (1 << i);
        fewest[alone] = fewest[alone].min(fewest[mask] + 1);
        for j in i + 1..n {
            let mut line = 0;
            for k in 0..n {
                let cross = (points[j][0] - points[i][0]) * (points[k][1] - points[i][1]) - (points[j][1] - points[i][1]) * (points[k][0] - points[i][0]);
                if cross == 0 {
                    line |= 1 << k;
                }
            }
            fewest[mask | line] = fewest[mask | line].min(fewest[mask] + 1);
        }
    }
    fewest[full]
}

// ---- lines_memo.kara: top down over the points left, remembered in a `Map`
fn memo_collinear(points: Vec[Vec[i64]], a: i64, b: i64, c: i64) -> bool {
    (points[b][0] - points[a][0]) * (points[c][1] - points[a][1]) == (points[b][1] - points[a][1]) * (points[c][0] - points[a][0])
}

fn memo_fewest(points: Vec[Vec[i64]], left: i64, memo: mut ref Map[i64, i64]) -> i64 {
    if left == 0 {
        return 0;
    }
    if let Some(known) = memo.get(left) {
        return known;
    }
    let n = points.len();
    let i = left.trailing_zeros();
    let rest = left ^ (1 << i);
    let mut best = 1 + memo_fewest(points, rest, mut memo);
    for j in i + 1..n {
        if (rest >> j) & 1 == 1 {
            let mut after = rest;
            for k in 0..n {
                if (after >> k) & 1 == 1 and memo_collinear(points, i, j, k) {
                    after ^= 1 << k;
                }
            }
            best = best.min(1 + memo_fewest(points, after, mut memo));
        }
    }
    memo.insert(left, best);
    best
}

fn memo_minimum_lines(points: Vec[Vec[i64]]) -> i64 {
    let mut memo: Map[i64, i64] = Map.new();
    memo_fewest(points, (1 << points.len()) - 1, mut memo)
}

// ---- lines_bfs.kara: breadth first, one line a step
fn bfs_minimum_lines(points: Vec[Vec[i64]]) -> i64 {
    let n = points.len();
    let full = (1 << n) - 1;
    let mut through: Vec[i64] = Vec.new();
    for i in 0..n {
        for j in i + 1..n {
            let mut line = 0;
            for k in 0..n {
                let (dx, dy) = (points[j][0] - points[i][0], points[j][1] - points[i][1]);
                let (ex, ey) = (points[k][0] - points[i][0], points[k][1] - points[i][1]);
                if dx * ey == dy * ex {
                    line |= 1 << k;
                }
            }
            through.push(line);
        }
    }
    let mut reached: Vec[bool] = Vec.filled(1 << n, false);
    reached[0] = true;
    let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
    queue.push_back((0, 0));
    while let Some((mask, lines)) = queue.pop_front() {
        if mask == full {
            return lines;
        }
        let i = (~mask).trailing_zeros();
        let mut nexts = [mask | (1 << i)].to_vec();
        for line in through.iter() {
            if (line >> i) & 1 == 1 {
                nexts.push(mask | line);
            }
        }
        for next in nexts.iter() {
            if not reached[next] {
                reached[next] = true;
                queue.push_back((next, lines + 1));
            }
        }
    }
    n
}

// ---- lines_struct.kara: a `Point` that knows what it is `on`, a `Cover` that `extend`s
struct Point {
    x: i64,
    y: i64,
}

impl Point {
    fn on(ref self, a: Point, b: Point) -> bool {
        (b.x - a.x) * (self.y - a.y) == (b.y - a.y) * (self.x - a.x)
    }
}

struct Cover {
    points: Vec[Point],
    fewest: Vec[i64],
}

impl Cover {
    fn new(points: own Vec[Point]) -> Cover {
        let n = points.len();
        let mut fewest: Vec[i64] = Vec.filled(1 << n, n + 1);
        fewest[0] = 0;
        Cover { points, fewest }
    }

    fn reach(mut ref self, mask: i64, lines: i64) {
        if lines < self.fewest[mask] {
            self.fewest[mask] = lines;
        }
    }

    fn extend(mut ref self, mask: i64) {
        let n = self.points.len();
        let lines = self.fewest[mask] + 1;
        let mut i = 0;
        while (mask >> i) & 1 == 1 {
            i += 1;
        }
        self.reach(mask | (1 << i), lines);
        for j in i + 1..n {
            let mut line = 0;
            for k in 0..n {
                if self.points[k].on(self.points[i], self.points[j]) {
                    line |= 1 << k;
                }
            }
            self.reach(mask | line, lines);
        }
    }

    fn best(ref self) -> i64 {
        self.fewest[self.fewest.len() - 1]
    }
}

fn cover_minimum_lines(points: Vec[Vec[i64]]) -> i64 {
    let mut cover = Cover.new(points.iter().map(|p| Point { x: p[0], y: p[1] }).collect());
    for mask in 0..cover.fewest.len() - 1 {
        cover.extend(mask);
    }
    cover.best()
}

// ---- lines_set.kara: the distinct lines first, every line from every mask
fn set_minimum_lines(points: Vec[Vec[i64]]) -> i64 {
    let n = points.len();
    let mut distinct: Set[i64] = Set.new();
    for i in 0..n {
        distinct.insert(1 << i);
        for j in i + 1..n {
            let on = (0..n).filter(|k| (points[j][0] - points[i][0]) * (points[k][1] - points[i][1]) == (points[j][1] - points[i][1]) * (points[k][0] - points[i][0])).fold(0, |line, k| line | (1 << k));
            distinct.insert(on);
        }
    }
    let lines: Vec[i64] = distinct.iter().cloned().collect();
    let full = (1 << n) - 1;
    let mut fewest: Vec[i64] = Vec.filled(1 << n, n + 1);
    fewest[0] = 0;
    for mask in 0..full {
        for line in lines.iter() {
            let next = mask | line;
            if next != mask {
                fewest[next] = fewest[next].min(fewest[mask] + 1);
            }
        }
    }
    fewest[full]
}

// ---- lines_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn minimum_lines(points: Vec[Vec[i32]]) -> i32 {
        let n = points.len();
        let full = (1usize << n) - 1;
        let mut dp = Vec.filled(1 << n, i32.MAX);
        dp[0] = 0;
        for mask in 0..(1usize << n) {
            if dp[mask] == i32.MAX or mask == full {
                continue;
            }
            let i = (0..n).find(|k| mask & (1 << k) == 0).unwrap();
            dp[mask | 1 << i] = dp[mask | 1 << i].min(dp[mask] + 1);
            for j in i + 1..n {
                let mut line = 0usize;
                for k in 0..n {
                    let (dx1, dy1) = (points[j][0] - points[i][0], points[j][1] - points[i][1]);
                    let (dx2, dy2) = (points[k][0] - points[i][0], points[k][1] - points[i][1]);
                    if dx1 * dy2 == dx2 * dy1 {
                        line |= 1 << k;
                    }
                }
                let next = mask | line;
                dp[next] = dp[next].min(dp[mask] + 1);
            }
        }
        dp[full]
    }
}

struct SolutionSolution {}

fn solution_minimum_lines(points: Vec[Vec[i64]]) -> i64 {
    let rows: Vec[Vec[i32]] = points.iter().map(|p| p.iter().map(|v| v as i32).collect()).collect();
    SolutionSolution.minimum_lines(rows)
}


// ---- the statement read literally

fn on_one_line(points: Vec[Vec[i64]], group: Vec[i64]) -> bool {
    for a in 0..group.len() {
        for b in a + 1..group.len() {
            for c in b + 1..group.len() {
                let (p, q, r) = (ref points[group[a]], ref points[group[b]], ref points[group[c]]);
                if (q[0] - p[0]) * (r[1] - p[1]) != (q[1] - p[1]) * (r[0] - p[0]) {
                    return false;
                }
            }
        }
    }
    true
}

fn split(points: Vec[Vec[i64]], next: i64, groups: mut ref Vec[Vec[i64]], best: mut ref i64) {
    if groups.len() >= *best {
        return;
    }
    if next == points.len() {
        *best = groups.len();
        return;
    }
    for g in 0..groups.len() {
        groups[g].push(next);
        if on_one_line(points, groups[g]) {
            split(points, next + 1, mut groups, mut best);
        }
        groups[g].pop();
    }
    groups.push([next].to_vec());
    split(points, next + 1, mut groups, mut best);
    groups.pop();
}

fn literal(points: Vec[Vec[i64]]) -> i64 {
    let mut groups: Vec[Vec[i64]] = Vec.new();
    let mut best = points.len() + 1;
    split(points, 0, mut groups, mut best);
    best
}

fn answer(arm: i64, points: Vec[Vec[i64]]) -> i64 {
    match arm {
        0 => star_minimum_lines(points),
        1 => memo_minimum_lines(points),
        2 => bfs_minimum_lines(points),
        3 => cover_minimum_lines(points),
        4 => set_minimum_lines(points),
        _ => solution_minimum_lines(points),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "memo", "bfs", "cover", "set", "solution"];
    let mut seed = 2152;
    let mut sets: Vec[Vec[Vec[i64]]] = Vec.new();
    for t in 0..360 {
        let n = next_random(mut seed) % 7 + 1;
        let mut points: Vec[Vec[i64]] = Vec.new();
        if t < 300 {
            let reach = [2, 6][t % 2];
            while points.len() < n {
                let p = [next_random(mut seed) % (2 * reach + 1) - reach, next_random(mut seed) % (2 * reach + 1) - reach].to_vec();
                if not points.contains(p) {
                    points.push(p);
                }
            }
        } else if t < 330 {
            let (dx, dy) = (next_random(mut seed) % 3 + 1, next_random(mut seed) % 5 - 2);
            for k in 0..n {
                points.push([k * dx - 3, k * dy + 1].to_vec());
            }
            points.push([-5, 9].to_vec());
        } else {
            for k in 0..n {
                points.push(if k % 2 == 0 { [k, 2 * k].to_vec() } else { [k, 7 - k].to_vec() });
            }
        }
        sets.push(points);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for points in sets.iter() {
        let truth = literal(points);
        check = (check * 31 + truth + points.len()) % 1000000007;
        let reversed: Vec[Vec[i64]] = points.iter().rev().cloned().collect();
        let moved: Vec[Vec[i64]] = points.iter().map(|p| [p[0] + 7, p[1] - 3].to_vec()).collect();
        let turned: Vec[Vec[i64]] = points.iter().map(|p| [-p[1], p[0]].to_vec()).collect();
        let sheared: Vec[Vec[i64]] = points.iter().map(|p| [p[0] + 2 * p[1], p[1]].to_vec()).collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, points)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, reversed) == x,
                answer(arm, moved) == x,
                answer(arm, turned) == x,
                answer(arm, sheared) == x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{points} arm {names[arm]}: P{q + 1} fails, answered {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{sets.len()} sets: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
