// LeetCode #2168: Unique Substrings With Equal Digit Frequency -- every
// substring from each start walked down a trie of the digits, its nodes
// ten children each in one flat `Vec[i64]`; a node is made the first time
// its substring is seen, and counted then if the substring's digits are
// equally often. No text and no hash. O(n^2) time and nodes.

fn equal_digit_frequency(s: Str) -> i64 {
    let digits = s.bytes();
    let n = digits.len();
    let mut children: Vec[i64] = Vec.filled(10, 0);
    let mut unique = 0;
    for i in 0..n {
        let mut counts = [0; 10];
        let mut kinds = 0;
        let mut most = 0;
        let mut node = 0;
        for j in i..n {
            let d = (digits[j] - b'0') as i64;
            if counts[d] == 0 {
                kinds += 1;
            }
            counts[d] += 1;
            most = most.max(counts[d]);
            if children[node * 10 + d] == 0 {
                children[node * 10 + d] = children.len() / 10;
                children.extend([0; 10]);
                if most * kinds == j - i + 1 {
                    unique += 1;
                }
            }
            node = children[node * 10 + d];
        }
    }
    unique
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(s: Str) {
    println(f"\"{s}\" -> {equal_digit_frequency(s)}");
}

fn digits(length: i64, top: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..length {
        s.push_str(f"{next_random(mut seed) % top}");
    }
    s
}

fn main() {
    // LeetCode's two examples, then four more: one digit, one digit
    // repeated, every digit once, and two digits taking turns
    show("1212");
    show("12321");
    show("7");
    show("44444");
    show("0123456789");
    show("909090");
    // 2000 random strings of 1 to 20 digits from 0 to 1, 0 to 2 or 0 to 9
    // in turn
    let mut seed = 2168;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let length = next_random(mut seed) % 20 + 1;
        let s = digits(length, [2, 3, 10][round % 3], mut seed);
        let u = equal_digit_frequency(s);
        total += u;
        check = (check * 31 + u) % 1000000007;
    }
    println(f"2000 strings: {total} in all, checksum {check}");
    // the constraints' largest: 1000 digits at random from 0 to 9 and from
    // 0 to 1, and the ten digits a hundred times over
    let wide = digits(1000, 10, mut seed);
    let narrow = digits(1000, 2, mut seed);
    let cycle = "0123456789".repeat(100);
    println(f"1000 digits: {equal_digit_frequency(wide)} {equal_digit_frequency(narrow)} {equal_digit_frequency(cycle)}");
}
