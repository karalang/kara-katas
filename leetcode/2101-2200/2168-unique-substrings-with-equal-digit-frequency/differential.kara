// LeetCode #2168: Unique Substrings With Equal Digit Frequency -- the
// differential. The six arms, against the statement read literally: every
// substring, its digits counted afresh, kept when every digit it has
// appears as often as every other, and kept once by comparing its text
// with each one kept before; no running counts, no set and no hash. 300
// random strings of 1 to 12 digits from 0 to 1, 0 to 2 or 0 to 9 in
// turn; then 30 of two digits taking turns with a slip; then 30 of
// different digits only; every one drawn before any arm answers.
//
// P1  the count is the statement read literally
// P2  the string reversed: the same count
// P3  every digit d made (3d + 7) % 10: the same count
// P4  the count at least the different digits, and at most every
//     substring, n(n + 1) / 2
// P5  the string written twice: at least the same count
// P6  each arm agrees with at least three of the other five



// ---- equal.kara: the ★ arm, running counts, a `Set[String]` of the texts
fn star_equal_digit_frequency(s: Str) -> i64 {
    let digits = s.bytes();
    let n = digits.len();
    let mut found: Set[String] = Set.new();
    for i in 0..n {
        let mut counts = [0; 10];
        let mut kinds = 0;
        let mut most = 0;
        for j in i..n {
            let d = (digits[j] - b'0') as i64;
            if counts[d] == 0 {
                kinds += 1;
            }
            counts[d] += 1;
            most = most.max(counts[d]);
            if most * kinds == j - i + 1 {
                found.insert(s[i..=j].to_string());
            }
        }
    }
    found.len()
}

// ---- equal_hash.kara: two polynomial hashes and the length in a `Set`
fn hash_equal_digit_frequency(s: Str) -> i64 {
    let digits = s.bytes();
    let n = digits.len();
    let mut found: Set[(i64, i64, i64)] = Set.new();
    for i in 0..n {
        let mut counts = [0; 10];
        let mut kinds = 0;
        let mut most = 0;
        let mut first = 0;
        let mut second = 0;
        for j in i..n {
            let d = (digits[j] - b'0') as i64;
            first = (first * 11 + d + 1) % 1000000007;
            second = (second * 13 + d + 1) % 998244353;
            if counts[d] == 0 {
                kinds += 1;
            }
            counts[d] += 1;
            most = most.max(counts[d]);
            if most * kinds == j - i + 1 {
                found.insert((first, second, j - i + 1));
            }
        }
    }
    found.len()
}

// ---- equal_trie.kara: a trie of every substring, a node counted when made
fn trie_equal_digit_frequency(s: Str) -> i64 {
    let digits = s.bytes();
    let n = digits.len();
    let mut children: Vec[i64] = Vec.filled(10, 0);
    let mut unique = 0;
    for i in 0..n {
        let mut counts = [0; 10];
        let mut kinds = 0;
        let mut most = 0;
        let mut node = 0;
        for j in i..n {
            let d = (digits[j] - b'0') as i64;
            if counts[d] == 0 {
                kinds += 1;
            }
            counts[d] += 1;
            most = most.max(counts[d]);
            if children[node * 10 + d] == 0 {
                children[node * 10 + d] = children.len() / 10;
                children.extend([0; 10]);
                if most * kinds == j - i + 1 {
                    unique += 1;
                }
            }
            node = children[node * 10 + d];
        }
    }
    unique
}

// ---- equal_tally.kara: a `Tally` of the digits, a `Vec[String]` sorted and deduplicated
struct Tally {
    counts: Array[i64, 10],
    kinds: i64,
    most: i64,
    length: i64,
}

impl Tally {
    fn new() -> Tally {
        Tally { counts: [0; 10], kinds: 0, most: 0, length: 0 }
    }

    fn add(mut ref self, d: i64) {
        if self.counts[d] == 0 {
            self.kinds += 1;
        }
        self.counts[d] += 1;
        self.most = self.most.max(self.counts[d]);
        self.length += 1;
    }

    fn even(self) -> bool {
        self.most * self.kinds == self.length
    }
}

fn tally_equal_digit_frequency(s: Str) -> i64 {
    let n = s.len();
    let mut found: Vec[String] = Vec.new();
    for i in 0..n {
        let mut tally = Tally.new();
        for (k, c) in s[i..].chars().enumerate() {
            tally.add(c.to_digit(10).unwrap());
            if tally.even() {
                found.push(s[i..(i + k + 1)].to_string());
            }
        }
    }
    found.sort();
    found.dedup();
    found.len()
}

// ---- equal_iter.kara: `scan`, `filter`, `map` and `flat_map` into a `SortedSet`
fn iter_even_ends(s: Str, i: i64) -> Vec[i64] {
    s[i..]
        .bytes()
        .iter()
        .scan([0; 10], |counts, b| {
            let mut counts = counts;
            counts[b - b'0'] += 1;
            let kinds = counts.iter().filter(|c| c > 0).count();
            let most = counts.iter().max().unwrap();
            let length = counts.iter().sum();
            Some((counts, most * kinds == length))
        })
        .enumerate()
        .filter(|(_, even)| even)
        .map(|(k, _)| i + k + 1)
        .collect()
}

fn iter_equal_digit_frequency(s: Str) -> i64 {
    let found: SortedSet[String] = (0..s.len())
        .flat_map(|i| iter_even_ends(s, i).into_iter().map(|j| s[i..j].to_string()))
        .collect();
    found.len()
}

// ---- equal_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn equal_digit_frequency(s: String) -> i32 {
        let b = s.bytes();
        let n = b.len();
        let mut seen: Set[Slice[u8]] = Set.new();
        for i in 0..n {
            let mut cnt = [0; 10];
            let mut distinct = 0;
            let mut mx: i64 = 0;
            for j in i..n {
                let d = (b[j] - b'0') as i64;
                if cnt[d] == 0 {
                    distinct += 1;
                }
                cnt[d] += 1;
                mx = mx.max(cnt[d]);
                if mx * distinct == j - i + 1 {
                    seen.insert(b[i..=j]);
                }
            }
        }
        seen.len() as i32
    }
}

struct Solution {}

fn solution_equal_digit_frequency(s: Str) -> i64 {
    Solution.equal_digit_frequency(s.to_string())
}


// ---- the statement read literally

fn even(t: Str) -> bool {
    let mut counts = [0; 10];
    for c in t.chars() {
        counts[c.to_digit(10).unwrap()] += 1;
    }
    let mut seen = 0;
    for k in 0..10 {
        if counts[k] > 0 {
            if seen > 0 and counts[k] != seen {
                return false;
            }
            seen = counts[k];
        }
    }
    true
}

fn literal(s: Str) -> i64 {
    let n = s.len();
    let mut kept: Vec[String] = Vec.new();
    for i in 0..n {
        for j in (i + 1)..=n {
            let t = s[i..j].to_string();
            if even(t) and not kept.contains(t) {
                kept.push(t);
            }
        }
    }
    kept.len()
}

fn answer(arm: i64, s: Str) -> i64 {
    match arm {
        0 => star_equal_digit_frequency(s),
        1 => hash_equal_digit_frequency(s),
        2 => trie_equal_digit_frequency(s),
        3 => tally_equal_digit_frequency(s),
        4 => iter_equal_digit_frequency(s),
        _ => solution_equal_digit_frequency(s),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "hash", "trie", "tally", "iter", "solution"];
    let mut seed = 2168;
    let mut strings: Vec[String] = Vec.new();
    for t in 0..360 {
        let mut s = String.new();
        let length = next_random(mut seed) % 12 + 1;
        if t < 300 {
            let top = [2, 3, 10][t % 3];
            for _ in 0..length {
                s.push_str(f"{next_random(mut seed) % top}");
            }
        } else if t < 330 {
            let a = next_random(mut seed) % 10;
            let b = (a + 1 + next_random(mut seed) % 9) % 10;
            let slip = next_random(mut seed) % length;
            for k in 0..length {
                let d = if (k % 2 == 0) != (k == slip) { a } else { b };
                s.push_str(f"{d}");
            }
        } else {
            let mut pool: Vec[i64] = (0..10).collect();
            for _ in 0..(length.min(10)) {
                s.push_str(f"{pool.remove(next_random(mut seed) % pool.len())}");
            }
        }
        strings.push(s);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for s in strings.iter() {
        let truth = literal(s);
        check = (check * 31 + truth) % 1000000007;
        let n = s.len();
        let reversed: String = s.chars().rev().collect();
        let renamed: String = s.chars().map(|c| char.from_digit((3 * c.to_digit(10).unwrap() + 7) % 10, 10).unwrap()).collect();
        let mut kinds = 0;
        for d in 0..10 {
            if s.contains(f"{d}") {
                kinds += 1;
            }
        }
        let twice = f"{s}{s}";
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, s)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, reversed) == x,
                answer(arm, renamed) == x,
                x >= kinds and x <= n * (n + 1) / 2,
                answer(arm, twice) >= x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"\"{s}\" arm {names[arm]}: P{q + 1} fails, answered {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{strings.len()} strings: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
