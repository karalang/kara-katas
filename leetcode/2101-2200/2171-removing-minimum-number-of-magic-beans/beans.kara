// LeetCode #2171: Removing Minimum Number of Magic Beans -- the ★ arm.
// Every bag left keeps as many beans as the smallest bag left, so the
// bags are sorted and each one in turn is tried as that smallest: the
// bags before it are emptied and the ones from it on are cut down to it,
// which keeps `beans[i] * (n - i)` beans. The answer is the total less
// the most that any choice keeps. O(n log n).

fn minimum_removal(beans: Vec[i64]) -> i64 {
    let mut sorted = beans.clone();
    sorted.sort();
    let n = sorted.len();
    let mut total = 0;
    let mut kept = 0;
    for i in 0..n {
        total += sorted[i];
        kept = kept.max(sorted[i] * (n - i));
    }
    total - kept
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(beans: Vec[i64]) {
    println(f"{beans} -> {minimum_removal(beans)}");
}

fn main() {
    // LeetCode's two examples, then four more: one bag, every bag the
    // same, one bag far larger than the rest, and bags rising one at a time
    show([4, 1, 6, 5]);
    show([2, 10, 3, 2]);
    show([7]);
    show([3, 3, 3, 3]);
    show([1, 1, 1, 100000]);
    show([1, 2, 3, 4, 5, 6, 7, 8]);
    // 2000 random rows of 1 to 20 bags, each up to 10, 1000 or 10^5 beans
    // in turn
    let mut seed = 2171;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let top = [10, 1000, 100000][round % 3];
        let length = next_random(mut seed) % 20 + 1;
        let mut beans: Vec[i64] = Vec.new();
        for _ in 0..length {
            beans.push((next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1);
        }
        let removed = minimum_removal(beans);
        total += removed;
        check = (check * 31 + removed % 1000000007) % 1000000007;
    }
    println(f"2000 rows: {total} in all, checksum {check}");
    // the constraints' largest: 10^5 bags at random up to 10^5 beans, and
    // 10^5 bags of 10^5 beans each but one
    let mut wide: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        wide.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1);
    }
    let mut full: Vec[i64] = Vec.filled(100000, 100000);
    full[0] = 1;
    println(f"100000 bags: {minimum_removal(wide)} {minimum_removal(full)}");
}
