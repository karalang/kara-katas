// LeetCode #2171: Removing Minimum Number of Magic Beans -- the
// benchmark's ★ arm: the bags of a window copied and sorted, each tried
// as the smallest left.

fn minimum_removal(beans: Slice[i64]) -> i64 {
    let mut sorted = beans.to_vec();
    sorted.sort();
    let n = sorted.len();
    let mut total = 0;
    let mut kept = 0;
    for i in 0..n {
        total += sorted[i];
        kept = kept.max(sorted[i] * (n - i));
    }
    total - kept
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2171;
    let mut row: Vec[i64] = Vec.new();
    for _ in 0..400000 {
        row.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1);
    }
    let mut check = 0;
    for _ in 0..100 {
        let start = (next_random(mut seed) * 32768 + next_random(mut seed)) % 300001;
        let removed = minimum_removal(row[start..(start + 100000)]);
        check = (check * 31 + removed % 1000000007) % 1000000007;
    }
    println(f"100 solves: checksum {check}");
}
