// LeetCode #2123: Minimum Operations to Remove Adjacent Ones in Matrix --
// LeetCode's Rust template (`Vec<Vec<i32>>` to `i32`): Kuhn's augmenting
// paths as a recursive `fn` taking the graph and the match by `&` and
// `&mut`, with `usize` cells and `Option<usize>` partners, written as
// Rust. Carried by `karac fix`. The adapter below hands the harness's
// grids to it.

fn dfs(u: i64, adj: Vec[Vec[i64]], mate: mut ref Vec[Option[i64]], vis: mut ref Vec[bool]) -> bool {
    for v in ref adj[u] {
        if vis[v] {
            continue;
        }
        vis[v] = true;
        if mate[v].is_none() or dfs(mate[v].unwrap(), adj, mut mate, mut vis) {
            mate[v] = Some(u);
            return true;
        }
    }
    false
}

impl Solution {
    pub fn minimum_operations(grid: Vec[Vec[i32]]) -> i32 {
        let m = grid.len();
        let n = grid[0].len();
        let mut adj: Vec[Vec[i64]] = Vec.filled(m * n, Vec.new());
        for i in 0..m {
            for j in 0..n {
                if grid[i][j] == 1 and (i + j) % 2 == 0 {
                    if i > 0 and grid[i - 1][j] == 1 {
                        adj[i * n + j].push((i - 1) * n + j);
                    }
                    if i + 1 < m and grid[i + 1][j] == 1 {
                        adj[i * n + j].push((i + 1) * n + j);
                    }
                    if j > 0 and grid[i][j - 1] == 1 {
                        adj[i * n + j].push(i * n + j - 1);
                    }
                    if j + 1 < n and grid[i][j + 1] == 1 {
                        adj[i * n + j].push(i * n + j + 1);
                    }
                }
            }
        }
        let mut mate: Vec[Option[i64]] = Vec.filled(m * n, None);
        let mut ans = 0;
        for u in 0..m * n {
            if adj[u].is_empty() {
                continue;
            }
            let mut vis = Vec.filled(m * n, false);
            if dfs(u, adj, mut mate, mut vis) {
                ans += 1;
            }
        }
        ans
    }
}

struct Solution {}

fn minimum_operations(grid: Vec[Vec[i64]]) -> i64 {
    let g: Vec[Vec[i32]] = grid.iter().map(|row| row.iter().map(|x| x as i32).collect()).collect();
    Solution.minimum_operations(g)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then four more: one cell, a row of ones,
    // a plus sign, and a 3 by 3 block of ones
    let examples: Vec[Vec[Vec[i64]]] = [
        [[1, 1, 0].to_vec(), [0, 1, 1].to_vec(), [1, 1, 1].to_vec()].to_vec(),
        [[0, 0, 0].to_vec(), [0, 0, 0].to_vec(), [0, 0, 0].to_vec()].to_vec(),
        [[0, 1].to_vec(), [1, 0].to_vec()].to_vec(),
        [[1].to_vec()].to_vec(),
        [[1, 1, 1, 1, 1].to_vec()].to_vec(),
        [[0, 1, 0].to_vec(), [1, 1, 1].to_vec(), [0, 1, 0].to_vec()].to_vec(),
        [[1, 1, 1].to_vec(), [1, 1, 1].to_vec(), [1, 1, 1].to_vec()].to_vec(),
    ].to_vec();
    for grid in examples.iter() {
        println(f"{grid} -> {minimum_operations(grid)}");
    }
    // 1000 random grids of 1 to 8 by 1 to 8, each cell a one with chance
    // a quarter, a half or three quarters in turn
    let mut seed = 2123;
    let mut total = 0;
    let mut check = 0;
    for round in 0..1000 {
        let rows = next_random(mut seed) % 8 + 1;
        let cols = next_random(mut seed) % 8 + 1;
        let chance = [1, 2, 3][round % 3];
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..rows {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..cols {
                row.push(if next_random(mut seed) % 4 < chance { 1 } else { 0 });
            }
            grid.push(row);
        }
        let got = minimum_operations(grid);
        total += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"1000 grids: {total} operations, checksum {check}");
    // the constraints' largest: 300 by 300, all ones, and with each cell
    // a one with chance one half
    let full: Vec[Vec[i64]] = (0..300).map(|_| Vec.filled(300, 1)).collect();
    println(f"300 by 300 ones: {minimum_operations(full)}");
    let mut half: Vec[Vec[i64]] = Vec.new();
    for _ in 0..300 {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..300 {
            row.push(next_random(mut seed) % 2);
        }
        half.push(row);
    }
    println(f"300 by 300 half ones: {minimum_operations(half)}");
}
