// LeetCode #2123: Minimum Operations to Remove Adjacent Ones in Matrix --
// the benchmark, isolated.kara's ★ arm: the ones a bipartite graph by the
// parity of row plus column, the answer a maximum matching grown by
// Kuhn's augmenting paths. 12 grids of 300 by 300, each cell a one with
// chance a quarter, a half or three quarters in turn, built once; then
// 10 rounds over all of them, one cell flipped before each solve.

fn try_match(u: i64, adj: Vec[Vec[i64]], partner: mut ref Vec[i64], seen: mut ref Vec[i64], stamp: i64) -> bool {
    for v in adj[u].iter() {
        if seen[v] == stamp {
            continue;
        }
        seen[v] = stamp;
        if partner[v] < 0 or try_match(partner[v], adj, mut partner, mut seen, stamp) {
            partner[v] = u;
            return true;
        }
    }
    false
}

fn minimum_operations(grid: Vec[Vec[i64]]) -> i64 {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut adj: Vec[Vec[i64]] = Vec.new();
    for _ in 0..rows * cols {
        adj.push(Vec.new());
    }
    for r in 0..rows {
        for c in 0..cols {
            if grid[r][c] == 0 or (r + c) % 2 != 0 {
                continue;
            }
            for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)].iter() {
                let (nr, nc) = (r + dr, c + dc);
                if nr >= 0 and nr < rows and nc >= 0 and nc < cols and grid[nr][nc] == 1 {
                    adj[r * cols + c].push(nr * cols + nc);
                }
            }
        }
    }
    let mut partner = Vec.filled(rows * cols, -1);
    let mut seen = Vec.filled(rows * cols, -1);
    let mut matched = 0;
    for u in 0..rows * cols {
        if not adj[u].is_empty() and try_match(u, adj, mut partner, mut seen, u) {
            matched += 1;
        }
    }
    matched
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2123;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for g in 0..12 {
        let chance = [1, 2, 3][g % 3];
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..300 {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..300 {
                row.push(if next_random(mut seed) % 4 < chance { 1 } else { 0 });
            }
            grid.push(row);
        }
        grids.push(grid);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..10 {
        for g in 0..12 {
            let cell = (round * 7919 + g * 104729) % 90000;
            grids[g][cell / 300][cell % 300] = 1 - grids[g][cell / 300][cell % 300];
            let got = minimum_operations(grids[g]);
            total += got;
            check = (check * 31 + got) % 1000000007;
        }
    }
    println(f"120 solves: {total} operations, checksum {check}");
}
