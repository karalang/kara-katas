// LeetCode #2123: Minimum Operations to Remove Adjacent Ones in Matrix --
// the struct arm. A `Matching` owns the graph of ones and the partner of
// every odd one; `grow` (`mut ref self`) looks for an augmenting path
// from one even one, and `size` counts the matched odd ones. Before any
// path is searched, `greedy` matches every even one it can to a free
// neighbour, so most searches end at once. O(V * E).

struct Matching {
    adj: Vec[Vec[i64]],
    partner: Vec[i64],
    seen: Vec[bool],
}

impl Matching {
    fn new(grid: Vec[Vec[i64]]) -> Matching {
        let rows = grid.len();
        let cols = grid[0].len();
        let mut adj: Vec[Vec[i64]] = Vec.new();
        for r in 0..rows {
            for c in 0..cols {
                let mut next: Vec[i64] = Vec.new();
                if grid[r][c] == 1 and (r + c) % 2 == 0 {
                    for (nr, nc) in [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)].iter() {
                        if nr >= 0 and nr < rows and nc >= 0 and nc < cols and grid[nr][nc] == 1 {
                            next.push(nr * cols + nc);
                        }
                    }
                }
                adj.push(next);
            }
        }
        let cells = rows * cols;
        Matching { adj: adj, partner: Vec.filled(cells, -1), seen: Vec.filled(cells, false) }
    }

    fn greedy(mut ref self) -> Vec[bool] {
        let mut done = Vec.filled(self.adj.len(), false);
        for u in 0..self.adj.len() {
            for v in self.adj[u].iter() {
                if self.partner[v] < 0 {
                    self.partner[v] = u;
                    done[u] = true;
                    break;
                }
            }
        }
        done
    }

    fn grow(mut ref self, u: i64) -> bool {
        for i in 0..self.adj[u].len() {
            let v = self.adj[u][i];
            if self.seen[v] {
                continue;
            }
            self.seen[v] = true;
            if self.partner[v] < 0 or self.grow(self.partner[v]) {
                self.partner[v] = u;
                return true;
            }
        }
        false
    }

    fn size(self) -> i64 {
        self.partner.iter().filter(|p| p >= 0).count()
    }
}

fn minimum_operations(grid: Vec[Vec[i64]]) -> i64 {
    let mut matching = Matching.new(grid);
    let done = matching.greedy();
    for u in 0..done.len() {
        if done[u] or matching.adj[u].is_empty() {
            continue;
        }
        matching.seen = Vec.filled(done.len(), false);
        matching.grow(u);
    }
    matching.size()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then four more: one cell, a row of ones,
    // a plus sign, and a 3 by 3 block of ones
    let examples: Vec[Vec[Vec[i64]]] = [
        [[1, 1, 0].to_vec(), [0, 1, 1].to_vec(), [1, 1, 1].to_vec()].to_vec(),
        [[0, 0, 0].to_vec(), [0, 0, 0].to_vec(), [0, 0, 0].to_vec()].to_vec(),
        [[0, 1].to_vec(), [1, 0].to_vec()].to_vec(),
        [[1].to_vec()].to_vec(),
        [[1, 1, 1, 1, 1].to_vec()].to_vec(),
        [[0, 1, 0].to_vec(), [1, 1, 1].to_vec(), [0, 1, 0].to_vec()].to_vec(),
        [[1, 1, 1].to_vec(), [1, 1, 1].to_vec(), [1, 1, 1].to_vec()].to_vec(),
    ].to_vec();
    for grid in examples.iter() {
        println(f"{grid} -> {minimum_operations(grid)}");
    }
    // 1000 random grids of 1 to 8 by 1 to 8, each cell a one with chance
    // a quarter, a half or three quarters in turn
    let mut seed = 2123;
    let mut total = 0;
    let mut check = 0;
    for round in 0..1000 {
        let rows = next_random(mut seed) % 8 + 1;
        let cols = next_random(mut seed) % 8 + 1;
        let chance = [1, 2, 3][round % 3];
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..rows {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..cols {
                row.push(if next_random(mut seed) % 4 < chance { 1 } else { 0 });
            }
            grid.push(row);
        }
        let got = minimum_operations(grid);
        total += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"1000 grids: {total} operations, checksum {check}");
    // the constraints' largest: 300 by 300, all ones, and with each cell
    // a one with chance one half
    let full: Vec[Vec[i64]] = (0..300).map(|_| Vec.filled(300, 1)).collect();
    println(f"300 by 300 ones: {minimum_operations(full)}");
    let mut half: Vec[Vec[i64]] = Vec.new();
    for _ in 0..300 {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..300 {
            row.push(next_random(mut seed) % 2);
        }
        half.push(row);
    }
    println(f"300 by 300 half ones: {minimum_operations(half)}");
}
