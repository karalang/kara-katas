// LeetCode #2123: Minimum Operations to Remove Adjacent Ones in Matrix --
// the breadth-first arm. No graph is built: from each even one in turn,
// a breadth-first search over the grid alternates a step to an adjacent
// odd one with the step back along that one's match, keeping each odd
// cell's parent; the first free odd one ends an augmenting path, which
// is flipped by walking the parents back. Iterative throughout. O(V * E).

fn minimum_operations(grid: Vec[Vec[i64]]) -> i64 {
    let rows = grid.len();
    let cols = grid[0].len();
    let cells = rows * cols;
    let steps = [(-1, 0), (1, 0), (0, -1), (0, 1)];
    let mut match_of = Vec.filled(cells, -1);
    let mut parent = Vec.filled(cells, -1);
    let mut visited = Vec.filled(cells, -1);
    let mut matched = 0;
    for start in 0..cells {
        let (r0, c0) = (start / cols, start % cols);
        if grid[r0][c0] == 0 or (r0 + c0) % 2 != 0 {
            continue;
        }
        let mut queue: VecDeque[i64] = VecDeque.new();
        queue.push_back(start);
        let mut free = -1;
        while let Some(u) = queue.pop_front() {
            let (r, c) = (u / cols, u % cols);
            for (dr, dc) in steps.iter() {
                let (nr, nc) = (r + dr, c + dc);
                if nr < 0 or nr >= rows or nc < 0 or nc >= cols or grid[nr][nc] == 0 {
                    continue;
                }
                let v = nr * cols + nc;
                if visited[v] == start {
                    continue;
                }
                visited[v] = start;
                parent[v] = u;
                if match_of[v] < 0 {
                    free = v;
                    break;
                }
                queue.push_back(match_of[v]);
            }
            if free >= 0 {
                break;
            }
        }
        if free < 0 {
            continue;
        }
        let mut v = free;
        while v >= 0 {
            let u = parent[v];
            let next = match_of[u];
            match_of[v] = u;
            match_of[u] = v;
            v = if u == start { -1 } else { next };
        }
        matched += 1;
    }
    matched
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then four more: one cell, a row of ones,
    // a plus sign, and a 3 by 3 block of ones
    let examples: Vec[Vec[Vec[i64]]] = [
        [[1, 1, 0].to_vec(), [0, 1, 1].to_vec(), [1, 1, 1].to_vec()].to_vec(),
        [[0, 0, 0].to_vec(), [0, 0, 0].to_vec(), [0, 0, 0].to_vec()].to_vec(),
        [[0, 1].to_vec(), [1, 0].to_vec()].to_vec(),
        [[1].to_vec()].to_vec(),
        [[1, 1, 1, 1, 1].to_vec()].to_vec(),
        [[0, 1, 0].to_vec(), [1, 1, 1].to_vec(), [0, 1, 0].to_vec()].to_vec(),
        [[1, 1, 1].to_vec(), [1, 1, 1].to_vec(), [1, 1, 1].to_vec()].to_vec(),
    ].to_vec();
    for grid in examples.iter() {
        println(f"{grid} -> {minimum_operations(grid)}");
    }
    // 1000 random grids of 1 to 8 by 1 to 8, each cell a one with chance
    // a quarter, a half or three quarters in turn
    let mut seed = 2123;
    let mut total = 0;
    let mut check = 0;
    for round in 0..1000 {
        let rows = next_random(mut seed) % 8 + 1;
        let cols = next_random(mut seed) % 8 + 1;
        let chance = [1, 2, 3][round % 3];
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..rows {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..cols {
                row.push(if next_random(mut seed) % 4 < chance { 1 } else { 0 });
            }
            grid.push(row);
        }
        let got = minimum_operations(grid);
        total += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"1000 grids: {total} operations, checksum {check}");
    // the constraints' largest: 300 by 300, all ones, and with each cell
    // a one with chance one half
    let full: Vec[Vec[i64]] = (0..300).map(|_| Vec.filled(300, 1)).collect();
    println(f"300 by 300 ones: {minimum_operations(full)}");
    let mut half: Vec[Vec[i64]] = Vec.new();
    for _ in 0..300 {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..300 {
            row.push(next_random(mut seed) % 2);
        }
        half.push(row);
    }
    println(f"300 by 300 half ones: {minimum_operations(half)}");
}
