// LeetCode #2111: Minimum Operations to Make the Array K-Increasing --
// the benchmark, increasing.kara's ★ arm: each chain's patience tails,
// the first tail above each value found with `partition_point`. 10
// arrays of 10^5 random values from 1 to 10^5 are built once; each is
// then solved 10 times, with `k` from 1 to 10, one value moved before
// each solve so that no solve repeats the one before.

fn k_increasing(arr: Vec[i64], k: i64) -> i64 {
    let mut changes = 0;
    for r in 0..k {
        let mut tails: Vec[i64] = Vec.new();
        let mut len = 0;
        let mut i = r;
        while i < arr.len() {
            let x = arr[i];
            let at = tails.partition_point(|t| t <= x);
            if at == tails.len() {
                tails.push(x);
            } else {
                tails[at] = x;
            }
            len += 1;
            i += k;
        }
        changes += len - tails.len();
    }
    changes
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2111;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10 {
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            let hi = next_random(mut seed);
            let lo = next_random(mut seed);
            arr.push((hi * 32768 + lo) % 100000 + 1);
        }
        arrays.push(arr);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..10 {
        for a in 0..10 {
            let at = round * 9973 + a;
            arrays[a][at] = arrays[a][at] % 100000 + 1;
            let got = k_increasing(arrays[a], round + 1);
            total += got;
            check = (check * 31 + got) % 1000000007;
        }
    }
    println(f"100 solves: {total} operations, checksum {check}");
}
