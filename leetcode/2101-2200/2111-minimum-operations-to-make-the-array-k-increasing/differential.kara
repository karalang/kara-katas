// LeetCode #2111: Minimum Operations to Make the Array K-Increasing --
// the differential. The six arms, against the statement read literally:
// the most values that can stay, each kept value no smaller than the
// kept value before it `k`, `2k`, ... places back, found by trying every
// earlier kept place (quadratic), the rest changed. 300 random arrays of
// 1 to 10 values from 1 to 4; then 30 of up to 120 values from 1 to 30
// with `k` from 1 to 5; then 30 of up to 120 that mostly rise, with `k`
// from 1 to 3; every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer is at least 0 and at most `n - k`
// P3  every value raised by 7: the same answer
// P4  `k` values above them all appended, one to each chain: the same answer
// P5  every value raised by 7 and a 1 appended: the answer plus one
// P6  each arm agrees with at least three of the other five

// ---- increasing.kara: the ★ arm, patience piles per chain
fn star_k_increasing(arr: Vec[i64], k: i64) -> i64 {
    let mut changes = 0;
    for r in 0..k {
        let mut tails: Vec[i64] = Vec.new();
        let mut len = 0;
        let mut i = r;
        while i < arr.len() {
            let x = arr[i];
            let at = tails.partition_point(|t| t <= x);
            if at == tails.len() {
                tails.push(x);
            } else {
                tails[at] = x;
            }
            len += 1;
            i += k;
        }
        changes += len - tails.len();
    }
    changes
}

// ---- increasing_search.kara: a hand-written binary search
fn search_kept(chain: Vec[i64]) -> i64 {
    let mut tails: Vec[i64] = Vec.new();
    for x in chain.iter() {
        let mut lo = 0;
        let mut hi = tails.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if tails[mid] <= x {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo == tails.len() {
            tails.push(x);
        } else {
            tails[lo] = x;
        }
    }
    tails.len()
}

fn search_k_increasing(arr: Vec[i64], k: i64) -> i64 {
    let mut changes = 0;
    for r in 0..k {
        let chain: Vec[i64] = arr.iter().skip(r).step_by(k).collect();
        changes += chain.len() - search_kept(chain);
    }
    changes
}

// ---- increasing_fenwick.kara: a Fenwick tree of best lengths
fn fenwick_best_up_to(tree: Vec[i64], v: i64) -> i64 {
    let mut best = 0;
    let mut i = v;
    while i > 0 {
        best = best.max(tree[i]);
        i -= i & -i;
    }
    best
}

fn fenwick_raise(tree: mut ref Vec[i64], v: i64, len: i64) {
    let mut i = v;
    while i < tree.len() {
        tree[i] = tree[i].max(len);
        i += i & -i;
    }
}

fn fenwick_clear(tree: mut ref Vec[i64], v: i64) {
    let mut i = v;
    while i < tree.len() {
        tree[i] = 0;
        i += i & -i;
    }
}

fn fenwick_k_increasing(arr: Vec[i64], k: i64) -> i64 {
    let mut tree = Vec.filled(100001, 0);
    let mut changes = 0;
    for r in 0..k {
        let mut longest = 0;
        let mut len = 0;
        let mut i = r;
        while i < arr.len() {
            let here = fenwick_best_up_to(tree, arr[i]) + 1;
            fenwick_raise(mut tree, arr[i], here);
            longest = longest.max(here);
            len += 1;
            i += k;
        }
        let mut i = r;
        while i < arr.len() {
            fenwick_clear(mut tree, arr[i]);
            i += k;
        }
        changes += len - longest;
    }
    changes
}

// ---- increasing_struct.kara: a `Piles`
struct StructPiles {
    tops: Vec[i64],
}

impl StructPiles {
    fn new() -> StructPiles {
        StructPiles {
            tops: Vec.new(),
        }
    }

    fn place(mut ref self, x: i64) {
        let mut at = {
            let i = self.tops.partition_point(|y| y < x);
            if i < self.tops.len() and self.tops[i] == x {
                i
            } else {
                i
            }
        };
        while at < self.tops.len() and self.tops[at] <= x {
            at += 1;
        }
        if at == self.tops.len() {
            self.tops.push(x);
        } else {
            self.tops[at] = x;
        }
    }
}

fn struct_k_increasing(arr: Vec[i64], k: i64) -> i64 {
    let mut changes = 0;
    for r in 0..k {
        let mut piles = StructPiles.new();
        let mut len = 0;
        for i in (r..arr.len()).step_by(k) {
            piles.place(arr[i]);
            len += 1;
        }
        changes += len - piles.tops.len();
    }
    changes
}

// ---- increasing_fold.kara: `map`, `fold` and `sum`
fn fold_k_increasing(arr: Vec[i64], k: i64) -> i64 {
    (0..k).map(|r| {
        let places: Vec[i64] = (r..arr.len()).step_by(k).collect();
        let len = places.len();
        let tails = places.iter().fold(Vec.new(), |tails, i| {
            let mut tails = tails;
            let at = tails.partition_point(|t| t <= arr[i]);
            if at == tails.len() {
                tails.push(arr[i]);
            } else {
                tails[at] = arr[i];
            }
            tails
        });
        len - tails.len()
    }).sum()
}

// ---- increasing_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn k_increasing(arr: Vec[i32], k: i32) -> i32 {
        let k = k as i64;
        let mut ans: i32 = 0;
        for i in 0..k {
            let mut tails: Vec[i32] = Vec.new();
            let mut len: i32 = 0;
            for j in (i..arr.len()).step_by(k) {
                len += 1;
                let x = arr[j];
                let pos = tails.partition_point(|t| t <= x);
                if pos == tails.len() {
                    tails.push(x);
                } else {
                    tails[pos] = x;
                }
            }
            ans += len - tails.len() as i32;
        }
        ans
    }
}

struct SolutionSolution {}

fn solution_k_increasing(arr: Vec[i64], k: i64) -> i64 {
    SolutionSolution.k_increasing(arr.iter().map(|x| x as i32).collect(), k as i32)
}

// ---- the statement read literally

fn literal(arr: Vec[i64], k: i64) -> i64 {
    let n = arr.len();
    let mut kept: Vec[i64] = Vec.new();
    let mut most = 0;
    for i in 0..n {
        let mut best = 1;
        for j in 0..i {
            if (i - j) % k == 0 and arr[j] <= arr[i] and kept[j] + 1 > best {
                best = kept[j] + 1;
            }
        }
        kept.push(best);
    }
    for r in 0..k {
        let mut chain_most = 0;
        for i in 0..n {
            if i % k == r and kept[i] > chain_most {
                chain_most = kept[i];
            }
        }
        most += chain_most;
    }
    n - most
}

fn answer(arm: i64, arr: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_k_increasing(arr, k),
        1 => search_k_increasing(arr, k),
        2 => fenwick_k_increasing(arr, k),
        3 => struct_k_increasing(arr, k),
        4 => fold_k_increasing(arr, k),
        _ => solution_k_increasing(arr, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "search", "fenwick", "struct", "fold", "solution"];
    let mut seed = 2111;
    let mut problems: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..360 {
        let n = if t < 300 { next_random(mut seed) % 10 + 1 } else { next_random(mut seed) % 120 + 1 };
        let arr: Vec[i64] = if t < 300 {
            (0..n).map(|_| next_random(mut seed) % 4 + 1).collect()
        } else if t < 330 {
            (0..n).map(|_| next_random(mut seed) % 30 + 1).collect()
        } else {
            (0..n).map(|i| i + next_random(mut seed) % 8 + 1).collect()
        };
        let k = if t < 300 {
            next_random(mut seed) % n + 1
        } else if t < 330 {
            next_random(mut seed) % n.min(5) + 1
        } else {
            next_random(mut seed) % n.min(3) + 1
        };
        problems.push((arr, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (arr, k) in problems.iter() {
        let truth = literal(arr, k);
        check = (check * 31 + truth) % 1000000007;
        let n = arr.len();
        let raised: Vec[i64] = arr.iter().map(|x| x + 7).collect();
        let top = arr.iter().max().unwrap() + 1;
        let mut topped = arr.clone();
        for _ in 0..k {
            topped.push(top);
        }
        let mut lowered = raised.clone();
        lowered.push(1);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, arr, k)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                x >= 0 and x <= n - k,
                answer(arm, raised, k) == x,
                answer(arm, topped, k) == x,
                answer(arm, lowered, k) == x + 1,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{arr}, k = {k} arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} arrays: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
