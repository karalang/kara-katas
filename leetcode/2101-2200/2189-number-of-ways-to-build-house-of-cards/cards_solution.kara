// LeetCode #2189: Number of Ways to Build House of Cards -- LeetCode's
// Rust template: `n: i32`, `-> i32`, a `vec![0i32; n + 1]` of counts
// indexed by `usize`, each width's cards offered once from the top
// down by `(cost..=n).rev()`, written as Rust. Carried by `karac fix`.
// The adapter below hands the harness's n to it.

impl Solution {
    pub fn house_of_cards(n: i32) -> i32 {
        let n = n as i64;
        let mut dp = Vec.filled(n + 1, 0i32);
        dp[0] = 1;
        let mut k = 1;
        while 3 * k - 1 <= n {
            let cost = 3 * k - 1;
            for s in (cost..=n).rev() {
                dp[s] += dp[s - cost];
            }
            k += 1;
        }
        dp[n]
    }
}

struct Solution {}

fn house_of_cards(n: i64) -> i64 {
    Solution.house_of_cards(n as i32)
}

// ---- test harness ---------------------------------------------------------

fn show(n: i64) {
    println(f"{n} -> {house_of_cards(n)}");
}

fn main() {
    // LeetCode's three examples, then three more: one card, the least
    // house of two rows, and the constraints' largest
    show(16);
    show(2);
    show(4);
    show(1);
    show(7);
    show(500);
    // every n the constraints allow, 1 to 500
    let mut total = 0;
    let mut check = 0;
    let mut built = 0;
    for n in 1..=500 {
        let ways = house_of_cards(n);
        total += ways;
        if ways > 0 {
            built += 1;
        }
        check = (check * 31 + ways % 1000000007) % 1000000007;
    }
    println(f"1 to 500 cards: {built} build a house, {total} houses in all, checksum {check}");
}
