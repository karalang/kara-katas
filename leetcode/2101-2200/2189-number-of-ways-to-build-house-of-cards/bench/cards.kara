// LeetCode #2189: Number of Ways to Build House of Cards -- the
// benchmark's Kāra arm: the ★ arm, a 0/1 knapsack over the row widths.

fn house_of_cards(n: i64) -> i64 {
    let mut ways: Vec[i64] = Vec.filled(n + 1, 0);
    ways[0] = 1;
    let mut k = 1;
    while 3 * k - 1 <= n {
        let cost = 3 * k - 1;
        let mut s = n;
        while s >= cost {
            ways[s] += ways[s - cost];
            s -= 1;
        }
        k += 1;
    }
    ways[n]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2189;
    let mut check = 0;
    for _ in 0..20000 {
        let n = next_random(mut seed) % 500 + 1;
        check = (check * 31 + house_of_cards(n) % 1000000007) % 1000000007;
    }
    println(f"20000 solves: checksum {check}");
}
