// LeetCode #2189: Number of Ways to Build House of Cards -- a table by
// the widest row: `top[k][s]` counts the houses of s cards whose bottom
// row is exactly k triangles wide, the sum of the houses of s - (3k - 1)
// cards whose bottom row is narrower, read off a running sum by width.
// O(n^2 / 3).

fn house_of_cards(n: i64) -> i64 {
    let widest = (n + 1) / 3;
    // narrower[s]: the houses of s cards with every row narrower than k,
    // the empty house among them
    let mut narrower: Vec[i64] = Vec.filled(n + 1, 0);
    narrower[0] = 1;
    let mut total = 0;
    for k in 1..=widest {
        let cost = 3 * k - 1;
        let mut top: Vec[i64] = Vec.filled(n + 1, 0);
        for s in cost..=n {
            top[s] = narrower[s - cost];
        }
        total += top[n];
        for s in 0..=n {
            narrower[s] += top[s];
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn show(n: i64) {
    println(f"{n} -> {house_of_cards(n)}");
}

fn main() {
    // LeetCode's three examples, then three more: one card, the least
    // house of two rows, and the constraints' largest
    show(16);
    show(2);
    show(4);
    show(1);
    show(7);
    show(500);
    // every n the constraints allow, 1 to 500
    let mut total = 0;
    let mut check = 0;
    let mut built = 0;
    for n in 1..=500 {
        let ways = house_of_cards(n);
        total += ways;
        if ways > 0 {
            built += 1;
        }
        check = (check * 31 + ways % 1000000007) % 1000000007;
    }
    println(f"1 to 500 cards: {built} build a house, {total} houses in all, checksum {check}");
}
