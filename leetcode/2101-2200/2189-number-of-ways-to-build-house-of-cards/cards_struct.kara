// LeetCode #2189: Number of Ways to Build House of Cards -- a `struct
// Deck` of how many houses each number of cards up to its size builds,
// made `of` a size with the empty house alone; a row width is `offer`ed
// to it (`mut ref self`) and taken at most once, and it says how many
// houses `use_all` its cards (`ref self`). O(n^2 / 3).

struct Deck {
    ways: Vec[i64],
}

impl Deck {
    fn of(size: i64) -> Deck {
        let mut ways: Vec[i64] = Vec.filled(size + 1, 0);
        ways[0] = 1;
        Deck { ways: ways }
    }

    fn size(ref self) -> i64 {
        self.ways.len() - 1
    }

    fn offer(mut ref self, width: i64) {
        let cost = 3 * width - 1;
        for s in (cost..=self.size()).rev() {
            self.ways[s] += self.ways[s - cost];
        }
    }

    fn use_all(ref self) -> i64 {
        self.ways[self.size()]
    }
}

fn house_of_cards(n: i64) -> i64 {
    let mut deck = Deck.of(n);
    let mut width = 1;
    while 3 * width - 1 <= n {
        deck.offer(width);
        width += 1;
    }
    deck.use_all()
}

// ---- test harness ---------------------------------------------------------

fn show(n: i64) {
    println(f"{n} -> {house_of_cards(n)}");
}

fn main() {
    // LeetCode's three examples, then three more: one card, the least
    // house of two rows, and the constraints' largest
    show(16);
    show(2);
    show(4);
    show(1);
    show(7);
    show(500);
    // every n the constraints allow, 1 to 500
    let mut total = 0;
    let mut check = 0;
    let mut built = 0;
    for n in 1..=500 {
        let ways = house_of_cards(n);
        total += ways;
        if ways > 0 {
            built += 1;
        }
        check = (check * 31 + ways % 1000000007) % 1000000007;
    }
    println(f"1 to 500 cards: {built} build a house, {total} houses in all, checksum {check}");
}
