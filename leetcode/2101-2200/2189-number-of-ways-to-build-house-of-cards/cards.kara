// LeetCode #2189: Number of Ways to Build House of Cards -- the ★ arm.
// A row of k triangles takes 3k - 1 cards, and each row above a row
// has fewer triangles than it, so a house is a set of distinct row
// widths whose cards add up to n. Counted as a 0/1 knapsack: each width
// k offered once, the counts for every number of cards updated from the
// top down so no width is taken twice. O(n^2 / 3).

fn house_of_cards(n: i64) -> i64 {
    let mut ways: Vec[i64] = Vec.filled(n + 1, 0);
    ways[0] = 1;
    let mut k = 1;
    while 3 * k - 1 <= n {
        let cost = 3 * k - 1;
        let mut s = n;
        while s >= cost {
            ways[s] += ways[s - cost];
            s -= 1;
        }
        k += 1;
    }
    ways[n]
}

// ---- test harness ---------------------------------------------------------

fn show(n: i64) {
    println(f"{n} -> {house_of_cards(n)}");
}

fn main() {
    // LeetCode's three examples, then three more: one card, the least
    // house of two rows, and the constraints' largest
    show(16);
    show(2);
    show(4);
    show(1);
    show(7);
    show(500);
    // every n the constraints allow, 1 to 500
    let mut total = 0;
    let mut check = 0;
    let mut built = 0;
    for n in 1..=500 {
        let ways = house_of_cards(n);
        total += ways;
        if ways > 0 {
            built += 1;
        }
        check = (check * 31 + ways % 1000000007) % 1000000007;
    }
    println(f"1 to 500 cards: {built} build a house, {total} houses in all, checksum {check}");
}
