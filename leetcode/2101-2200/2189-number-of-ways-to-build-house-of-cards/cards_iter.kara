// LeetCode #2189: Number of Ways to Build House of Cards -- by
// iterators: the row widths that fit `take_while`n from a range, `map`ped
// to their cards, and a `fold` over them of the counts for every number
// of cards, each step a new list `collect`ed from a `map` over the
// numbers: what it was, plus what it was a row's cards fewer.
// O(n^2 / 3).

fn house_of_cards(n: i64) -> i64 {
    let start: Vec[i64] = (0..=n).map(|s| if s == 0 { 1 } else { 0 }).collect();
    let ways = (1..)
        .map(|k| 3 * k - 1)
        .take_while(|cost| cost <= n)
        .fold(start, |prev, cost| {
            (0..=n).map(|s| if s >= cost { prev[s] + prev[s - cost] } else { prev[s] }).collect()
        });
    ways[n]
}

// ---- test harness ---------------------------------------------------------

fn show(n: i64) {
    println(f"{n} -> {house_of_cards(n)}");
}

fn main() {
    // LeetCode's three examples, then three more: one card, the least
    // house of two rows, and the constraints' largest
    show(16);
    show(2);
    show(4);
    show(1);
    show(7);
    show(500);
    // every n the constraints allow, 1 to 500
    let mut total = 0;
    let mut check = 0;
    let mut built = 0;
    for n in 1..=500 {
        let ways = house_of_cards(n);
        total += ways;
        if ways > 0 {
            built += 1;
        }
        check = (check * 31 + ways % 1000000007) % 1000000007;
    }
    println(f"1 to 500 cards: {built} build a house, {total} houses in all, checksum {check}");
}
