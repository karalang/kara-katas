// LeetCode #2106: Maximum Fruits Harvested After at Most K Steps --
// bench. The ★ arm's sliding window: 20 fields of 10^5 fruits built
// once, then 10 walks per field.

fn steps(l: i64, r: i64, start: i64) -> i64 {
    if l >= start {
        r - start
    } else if r <= start {
        start - l
    } else {
        (2 * (start - l) + (r - start)).min((start - l) + 2 * (r - start))
    }
}

fn max_total_fruits(fruits: Vec[Vec[i64]], start: i64, k: i64) -> i64 {
    let mut left = 0;
    let mut sum = 0;
    let mut best = 0;
    for right in 0..fruits.len() {
        sum += fruits[right][1];
        while left <= right and steps(fruits[left][0], fruits[right][0], start) > k {
            sum -= fruits[left][1];
            left += 1;
        }
        best = best.max(sum);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 2106;
    let mut fields: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..20 {
        let mut fruits: Vec[Vec[i64]] = Vec.new();
        for p in 0..200000 {
            if next_random(mut seed) % 2 == 0 {
                fruits.push([p, wide_random(mut seed) % 10000 + 1].to_vec());
            }
        }
        fields.push(fruits);
    }
    let mut total = 0;
    let mut check = 0;
    for fruits in fields.iter() {
        for _ in 0..10 {
            let start = wide_random(mut seed) % 200001;
            let k = wide_random(mut seed) % 200001;
            let got = max_total_fruits(fruits, start, k);
            total += got;
            check = (check * 31 + got) % 1000000007;
        }
    }
    println(f"200 walks: {total} fruits, checksum {check}");
}
