// LeetCode #2157: Groups of Strings -- the benchmark: the ★ arm over four
// lists of 5000 words of 1 to 8 letters from the first 20, one word
// replaced before each of 100 solves.

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn unite(parent: mut ref Vec[i64], size: mut ref Vec[i64], a: i64, b: i64) {
    let ra = find(mut parent, a);
    let rb = find(mut parent, b);
    if ra == rb {
        return;
    }
    let (big, small) = if size[ra] >= size[rb] { (ra, rb) } else { (rb, ra) };
    parent[small] = big;
    size[big] += size[small];
}

fn group_strings(words: Vec[String]) -> Vec[i64] {
    let n = words.len();
    let masks: Vec[i64] = words.iter().map(|w| w.bytes().iter().fold(0, |m, b| m | (1 << (b - b'a')))).collect();
    let mut parent: Vec[i64] = (0..n).collect();
    let mut size: Vec[i64] = Vec.filled(n, 1);
    let mut first: Map[i64, i64] = Map.new();
    for i in 0..n {
        match first.get(masks[i]) {
            Some(j) => unite(mut parent, mut size, i, j),
            None => {
                first.insert(masks[i], i);
            }
        }
    }
    let mut blanked: Map[i64, i64] = Map.new();
    for i in 0..n {
        for bit in 0..26 {
            if (masks[i] >> bit) & 1 == 1 {
                let less = masks[i] ^ (1 << bit);
                if let Some(j) = first.get(less) {
                    unite(mut parent, mut size, i, j);
                }
                match blanked.get(less) {
                    Some(j) => unite(mut parent, mut size, i, j),
                    None => {
                        blanked.insert(less, i);
                    }
                }
            }
        }
    }
    let mut groups = 0;
    let mut largest = 0;
    for i in 0..n {
        if find(mut parent, i) == i {
            groups += 1;
            largest = largest.max(size[i]);
        }
    }
    [groups, largest].to_vec()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn word(seed: mut ref i64) -> String {
    let length = next_random(mut seed) % 8 + 1;
    let mut w = String.new();
    while w.len() < length {
        let c = (b'a' + (next_random(mut seed) % 20) as u8) as char;
        if not w.contains(c.to_string()) {
            w.push(c);
        }
    }
    w
}

fn main() {
    let mut seed = 2157;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..4 {
        let words: Vec[String] = (0..5000).map(|_| word(mut seed)).collect();
        lists.push(words);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..25 {
        for l in 0..4 {
            let at = next_random(mut seed) % 5000;
            lists[l][at] = word(mut seed);
            let answer = group_strings(lists[l]);
            total += answer[0];
            check = (check * 31 + answer[0] * 10007 + answer[1] + round) % 1000000007;
        }
    }
    println(f"100 solves: {total} groups in all, checksum {check}");
}
