// LeetCode #2157: Groups of Strings -- LeetCode's Rust template: a
// `HashMap<i32, usize>` of each set's first word and one of each set with
// a letter blanked out, a union-find whose `find` is a function nested in
// the method, `vec![1; n]`, `c as u8 - b'a'`, and the answer as
// `vec![groups as i32, largest as i32]`, written as Rust. Carried by
// `karac fix`. The adapter below hands the harness's words to it and its
// answer back.

fn find(p: mut ref Vec[i64], x: i64) -> i64 {
    if p[x] != x {
        let r = find(mut p, p[x]);
        p[x] = r;
    }
    p[x]
}

impl Solution {
    pub fn group_strings(words: Vec[String]) -> Vec[i32] {
        let n = words.len();
        let mut p: Vec[i64] = (0..n).collect();
        let mut sz = Vec.filled(n, 1);
        let mut masks = Vec.filled(n, 0i32);
        for (i, w) in words.iter().enumerate() {
            for c in w.chars() {
                masks[i] |= 1 << (c as u32 as u8 - b'a');
            }
        }
        let mut first: Map[i32, i64] = Map.new();
        let mut blank: Map[i32, i64] = Map.new();
        let mut pairs: Vec[(i64, i64)] = Vec.new();
        for i in 0..n {
            if let Some(j) = first.get(masks[i]).cloned() {
                pairs.push((i, j));
            } else {
                first.insert(masks[i], i);
            }
        }
        for i in 0..n {
            for b in 0..26 {
                if masks[i] >> b & 1 == 1 {
                    let less = masks[i] ^ (1 << b);
                    if let Some(j) = first.get(less).cloned() {
                        pairs.push((i, j));
                    }
                    if let Some(j) = blank.get(less).cloned() {
                        pairs.push((i, j));
                    } else {
                        blank.insert(less, i);
                    }
                }
            }
        }
        for (a, b) in pairs {
            let ra = find(mut p, a);
            let rb = find(mut p, b);
            if ra != rb {
                if sz[ra] < sz[rb] {
                    p[ra] = rb;
                    sz[rb] += sz[ra];
                } else {
                    p[rb] = ra;
                    sz[ra] += sz[rb];
                }
            }
        }
        let mut groups = 0;
        let mut largest = 0;
        for i in 0..n {
            if find(mut p, i) == i {
                groups += 1;
                largest = largest.max(sz[i]);
            }
        }
        [groups as i32, largest as i32]
    }
}

struct Solution {}

fn group_strings(words: Vec[String]) -> Vec[i64] {
    Solution.group_strings(words.clone()).iter().map(|x| x as i64).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a word of 1 to most distinct letters from the first alphabet
fn word(most: i64, alphabet: i64, seed: mut ref i64) -> String {
    let length = next_random(mut seed) % most + 1;
    let mut w = String.new();
    while w.len() < length {
        let c = (b'a' + (next_random(mut seed) % alphabet) as u8) as char;
        if not w.contains(c.to_string()) {
            w.push(c);
        }
    }
    w
}

fn show(words: Vec[String]) {
    println(f"{words} -> {group_strings(words)}");
}

fn main() {
    // LeetCode's two examples, then four more: one word, the same letters
    // in two orders, three words apart, and three joined only by replacing
    show(["a", "b", "ab", "cde"].iter().map(|w| w.to_string()).collect());
    show(["a", "ab", "abc"].iter().map(|w| w.to_string()).collect());
    show(["xyz"].iter().map(|w| w.to_string()).collect());
    show(["ab", "ba"].iter().map(|w| w.to_string()).collect());
    show(["ab", "cd", "ef"].iter().map(|w| w.to_string()).collect());
    show(["ab", "ac", "bc"].iter().map(|w| w.to_string()).collect());
    // 2000 random lists of 1 to 8 words of 1 to 4 letters from the first
    // 4, 6 or 26 in turn
    let mut seed = 2157;
    let mut groups = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 8 + 1;
        let alphabet = [4, 6, 26][round % 3];
        let words: Vec[String] = (0..n).map(|_| word(4, alphabet, mut seed)).collect();
        let answer = group_strings(words);
        groups += answer[0];
        check = (check * 31 + answer[0] * 100 + answer[1] + n) % 1000000007;
    }
    println(f"2000 lists: {groups} groups in all, checksum {check}");
    // the constraints' largest, 20000 words: of 1 to 5 letters from the
    // first 10, and of 1 to 26 from all 26
    for (most, alphabet) in [(5, 10), (26, 26)] {
        let words: Vec[String] = (0..20000).map(|_| word(most, alphabet, mut seed)).collect();
        let answer = group_strings(words);
        println(f"20000 words of 1 to {most} letters from {alphabet}: {answer[0]} groups, the largest {answer[1]}");
    }
}
