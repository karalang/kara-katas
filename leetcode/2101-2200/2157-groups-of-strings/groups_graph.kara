// LeetCode #2157: Groups of Strings -- a graph of the words and of the
// sets they meet at: each word is an edge to its own set and to each set
// it makes by losing a letter. A word one letter shorter meets it at the
// shorter word's own set, and a word one letter replaced meets it at the
// set both make by losing the letter that differs (or any letter, when
// the sets are the same), so one kind of key serves all three rules.
// Each group is a component, found by a depth-first search with an
// explicit stack and counted by its words. O(26 n) map lookups.

fn group_strings(words: Vec[String]) -> Vec[i64] {
    let n = words.len();
    let mut keys: Map[i64, i64] = Map.new();
    let mut edges: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        edges.push(Vec.new());
    }
    for (i, w) in words.iter().enumerate() {
        let mask = w.bytes().iter().fold(0, |m, b| m | (1 << (b - b'a')));
        let mut wanted: Vec[i64] = [mask].to_vec();
        for bit in 0..26 {
            if (mask >> bit) & 1 == 1 {
                wanted.push(mask ^ (1 << bit));
            }
        }
        for key in wanted.iter() {
            let node = match keys.get(key) {
                Some(node) => node,
                None => {
                    let node = edges.len();
                    keys.insert(key, node);
                    edges.push(Vec.new());
                    node
                }
            };
            edges[i].push(node);
            edges[node].push(i);
        }
    }
    let mut seen: Vec[bool] = Vec.filled(edges.len(), false);
    let mut groups = 0;
    let mut largest = 0;
    for start in 0..n {
        if seen[start] {
            continue;
        }
        seen[start] = true;
        groups += 1;
        let mut size = 0;
        let mut stack: Vec[i64] = [start].to_vec();
        while let Some(node) = stack.pop() {
            if node < n {
                size += 1;
            }
            for next in edges[node].iter() {
                if not seen[next] {
                    seen[next] = true;
                    stack.push(next);
                }
            }
        }
        largest = largest.max(size);
    }
    [groups, largest].to_vec()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a word of 1 to most distinct letters from the first alphabet
fn word(most: i64, alphabet: i64, seed: mut ref i64) -> String {
    let length = next_random(mut seed) % most + 1;
    let mut w = String.new();
    while w.len() < length {
        let c = (b'a' + (next_random(mut seed) % alphabet) as u8) as char;
        if not w.contains(c.to_string()) {
            w.push(c);
        }
    }
    w
}

fn show(words: Vec[String]) {
    println(f"{words} -> {group_strings(words)}");
}

fn main() {
    // LeetCode's two examples, then four more: one word, the same letters
    // in two orders, three words apart, and three joined only by replacing
    show(["a", "b", "ab", "cde"].iter().map(|w| w.to_string()).collect());
    show(["a", "ab", "abc"].iter().map(|w| w.to_string()).collect());
    show(["xyz"].iter().map(|w| w.to_string()).collect());
    show(["ab", "ba"].iter().map(|w| w.to_string()).collect());
    show(["ab", "cd", "ef"].iter().map(|w| w.to_string()).collect());
    show(["ab", "ac", "bc"].iter().map(|w| w.to_string()).collect());
    // 2000 random lists of 1 to 8 words of 1 to 4 letters from the first
    // 4, 6 or 26 in turn
    let mut seed = 2157;
    let mut groups = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 8 + 1;
        let alphabet = [4, 6, 26][round % 3];
        let words: Vec[String] = (0..n).map(|_| word(4, alphabet, mut seed)).collect();
        let answer = group_strings(words);
        groups += answer[0];
        check = (check * 31 + answer[0] * 100 + answer[1] + n) % 1000000007;
    }
    println(f"2000 lists: {groups} groups in all, checksum {check}");
    // the constraints' largest, 20000 words: of 1 to 5 letters from the
    // first 10, and of 1 to 26 from all 26
    for (most, alphabet) in [(5, 10), (26, 26)] {
        let words: Vec[String] = (0..20000).map(|_| word(most, alphabet, mut seed)).collect();
        let answer = group_strings(words);
        println(f"20000 words of 1 to {most} letters from {alphabet}: {answer[0]} groups, the largest {answer[1]}");
    }
}
