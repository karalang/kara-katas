// LeetCode #2157: Groups of Strings -- a `struct Groups`, a union-find
// whose `root` halves no path but points the whole path at the root once
// found, by recursion (`mut ref self`), whose `join` hangs the smaller
// tree under the larger, and which `tally`s its groups (`ref self`). One
// map keyed both by each set and, tagged with a 27th bit, by each set
// with a letter blanked out. O(26 n) map lookups.

struct Groups {
    parent: Vec[i64],
    size: Vec[i64],
}

impl Groups {
    fn of(n: i64) -> Groups {
        Groups { parent: (0..n).collect(), size: Vec.filled(n, 1) }
    }

    fn root(mut ref self, x: i64) -> i64 {
        if self.parent[x] == x {
            return x;
        }
        let r = self.root(self.parent[x]);
        self.parent[x] = r;
        r
    }

    fn join(mut ref self, a: i64, b: i64) {
        let ra = self.root(a);
        let rb = self.root(b);
        if ra == rb {
            return;
        }
        if self.size[ra] < self.size[rb] {
            self.parent[ra] = rb;
            self.size[rb] += self.size[ra];
        } else {
            self.parent[rb] = ra;
            self.size[ra] += self.size[rb];
        }
    }

    fn tally(ref self) -> Vec[i64] {
        let mut groups = 0;
        let mut largest = 0;
        for i in 0..self.parent.len() {
            if self.parent[i] == i {
                groups += 1;
                largest = largest.max(self.size[i]);
            }
        }
        [groups, largest].to_vec()
    }
}

const BLANK: i64 = 1 << 26;

fn group_strings(words: Vec[String]) -> Vec[i64] {
    let n = words.len();
    let mut masks: Vec[i64] = Vec.new();
    for w in words.iter() {
        let mut mask = 0;
        for c in w.chars() {
            mask |= 1 << (c as i64 - 'a' as i64);
        }
        masks.push(mask);
    }
    let mut groups = Groups.of(n);
    let mut seen: Map[i64, i64] = Map.new();
    for i in 0..n {
        if let Some(j) = seen.get(masks[i]) {
            groups.join(i, j);
        } else {
            seen.insert(masks[i], i);
        }
    }
    for i in 0..n {
        let mut rest = masks[i];
        while rest != 0 {
            let low = rest & -rest;
            rest ^= low;
            let less = masks[i] ^ low;
            if let Some(j) = seen.get(less) {
                groups.join(i, j);
            }
            if let Some(j) = seen.get(less | BLANK) {
                groups.join(i, j);
            } else {
                seen.insert(less | BLANK, i);
            }
        }
    }
    groups.tally()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a word of 1 to most distinct letters from the first alphabet
fn word(most: i64, alphabet: i64, seed: mut ref i64) -> String {
    let length = next_random(mut seed) % most + 1;
    let mut w = String.new();
    while w.len() < length {
        let c = (b'a' + (next_random(mut seed) % alphabet) as u8) as char;
        if not w.contains(c.to_string()) {
            w.push(c);
        }
    }
    w
}

fn show(words: Vec[String]) {
    println(f"{words} -> {group_strings(words)}");
}

fn main() {
    // LeetCode's two examples, then four more: one word, the same letters
    // in two orders, three words apart, and three joined only by replacing
    show(["a", "b", "ab", "cde"].iter().map(|w| w.to_string()).collect());
    show(["a", "ab", "abc"].iter().map(|w| w.to_string()).collect());
    show(["xyz"].iter().map(|w| w.to_string()).collect());
    show(["ab", "ba"].iter().map(|w| w.to_string()).collect());
    show(["ab", "cd", "ef"].iter().map(|w| w.to_string()).collect());
    show(["ab", "ac", "bc"].iter().map(|w| w.to_string()).collect());
    // 2000 random lists of 1 to 8 words of 1 to 4 letters from the first
    // 4, 6 or 26 in turn
    let mut seed = 2157;
    let mut groups = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 8 + 1;
        let alphabet = [4, 6, 26][round % 3];
        let words: Vec[String] = (0..n).map(|_| word(4, alphabet, mut seed)).collect();
        let answer = group_strings(words);
        groups += answer[0];
        check = (check * 31 + answer[0] * 100 + answer[1] + n) % 1000000007;
    }
    println(f"2000 lists: {groups} groups in all, checksum {check}");
    // the constraints' largest, 20000 words: of 1 to 5 letters from the
    // first 10, and of 1 to 26 from all 26
    for (most, alphabet) in [(5, 10), (26, 26)] {
        let words: Vec[String] = (0..20000).map(|_| word(most, alphabet, mut seed)).collect();
        let answer = group_strings(words);
        println(f"20000 words of 1 to {most} letters from {alphabet}: {answer[0]} groups, the largest {answer[1]}");
    }
}
