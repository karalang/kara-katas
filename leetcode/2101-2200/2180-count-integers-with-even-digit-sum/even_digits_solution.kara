// LeetCode #2180: Count Integers With Even Digit Sum -- LeetCode's Rust
// template: `num: i32`, `-> i32`, `for x in 1..=num`, a `while` over
// the digits, written as Rust. Carried by `karac fix`. The adapter below
// hands the harness's number to it.

impl Solution {
    pub fn count_even(num: i32) -> i32 {
        let mut ans = 0;
        for x in 1..=num {
            let mut s = 0;
            let mut y = x;
            while y > 0 {
                s += y % 10;
                y /= 10;
            }
            if s % 2 == 0 {
                ans += 1;
            }
        }
        ans
    }
}

struct Solution {}

fn count_even(num: i64) -> i64 {
    Solution.count_even(num as i32)
}

// ---- test harness ---------------------------------------------------------

fn show(num: i64) {
    println(f"{num} -> {count_even(num)}");
}

fn main() {
    // LeetCode's two examples, then four more: 1, 2, 11, the first
    // past a decade whose digits sum evenly, and the constraints' largest
    for num in [4, 30, 1, 2, 11, 1000] {
        show(num);
    }
    // every number the constraints allow
    let mut total = 0;
    let mut check = 0;
    for num in 1..1001 {
        let found = count_even(num);
        total += found;
        check = (check * 31 + found) % 1000000007;
    }
    println(f"every number from 1 to 1000: {total} in all, checksum {check}");
}
