// LeetCode #2180: Count Integers With Even Digit Sum -- the ★ arm. At
// most 1000, so every number from 1 to num is tried: its digits summed
// by remainders of 10, and counted when the sum is even. O(num log num).

fn count_even(num: i64) -> i64 {
    let mut count = 0;
    for x in 1..(num + 1) {
        let mut total = 0;
        let mut rest = x;
        while rest > 0 {
            total += rest % 10;
            rest /= 10;
        }
        if total % 2 == 0 {
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn show(num: i64) {
    println(f"{num} -> {count_even(num)}");
}

fn main() {
    // LeetCode's two examples, then four more: 1, 2, 11, the first
    // past a decade whose digits sum evenly, and the constraints' largest
    for num in [4, 30, 1, 2, 11, 1000] {
        show(num);
    }
    // every number the constraints allow
    let mut total = 0;
    let mut check = 0;
    for num in 1..1001 {
        let found = count_even(num);
        total += found;
        check = (check * 31 + found) % 1000000007;
    }
    println(f"every number from 1 to 1000: {total} in all, checksum {check}");
}
