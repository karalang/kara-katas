// LeetCode #2180: Count Integers With Even Digit Sum -- by iterators:
// the numbers from 1 to num `filter`ed to those whose digits, the
// `chars` of the number written out `map`ped through `to_digit` and
// `sum`med, give an even sum, and `count`ed. O(num log num).

fn count_even(num: i64) -> i64 {
    (1..(num + 1))
        .filter(|x| {
            let total: i64 = f"{x}".chars().map(|c| c.to_digit(10).unwrap()).sum();
            total % 2 == 0
        })
        .count()
}

// ---- test harness ---------------------------------------------------------

fn show(num: i64) {
    println(f"{num} -> {count_even(num)}");
}

fn main() {
    // LeetCode's two examples, then four more: 1, 2, 11, the first
    // past a decade whose digits sum evenly, and the constraints' largest
    for num in [4, 30, 1, 2, 11, 1000] {
        show(num);
    }
    // every number the constraints allow
    let mut total = 0;
    let mut check = 0;
    for num in 1..1001 {
        let found = count_even(num);
        total += found;
        check = (check * 31 + found) % 1000000007;
    }
    println(f"every number from 1 to 1000: {total} in all, checksum {check}");
}
