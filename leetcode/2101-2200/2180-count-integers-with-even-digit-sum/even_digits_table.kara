// LeetCode #2180: Count Integers With Even Digit Sum -- by a table: the
// parity of each number's digit sum is its last digit's parity flipped
// by the parity of the number with that digit dropped, x / 10, which is
// already in the table; the even ones from 1 to num are counted as the
// table grows. O(num).

fn count_even(num: i64) -> i64 {
    let mut odd: Vec[bool] = Vec.filled(num + 1, false);
    let mut count = 0;
    for x in 1..(num + 1) {
        odd[x] = odd[x / 10] != (x % 2 == 1);
        if not odd[x] {
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn show(num: i64) {
    println(f"{num} -> {count_even(num)}");
}

fn main() {
    // LeetCode's two examples, then four more: 1, 2, 11, the first
    // past a decade whose digits sum evenly, and the constraints' largest
    for num in [4, 30, 1, 2, 11, 1000] {
        show(num);
    }
    // every number the constraints allow
    let mut total = 0;
    let mut check = 0;
    for num in 1..1001 {
        let found = count_even(num);
        total += found;
        check = (check * 31 + found) % 1000000007;
    }
    println(f"every number from 1 to 1000: {total} in all, checksum {check}");
}
