// LeetCode #2180: Count Integers With Even Digit Sum -- in closed form:
// from 0 on, the numbers 10a to 10a + 9 hold exactly five with an even
// digit sum, and in any two in a row one is even and one odd but at a
// decade's turn; so the count from 1 to num is num / 2, less one more
// when num's own digit sum is odd and num is even. O(log num).

fn digit_sum(x: i64) -> i64 {
    let mut total = 0;
    let mut rest = x;
    while rest > 0 {
        total += rest % 10;
        rest /= 10;
    }
    total
}

fn count_even(num: i64) -> i64 {
    if digit_sum(num) % 2 == 0 {
        num / 2
    } else {
        (num - 1) / 2
    }
}

// ---- test harness ---------------------------------------------------------

fn show(num: i64) {
    println(f"{num} -> {count_even(num)}");
}

fn main() {
    // LeetCode's two examples, then four more: 1, 2, 11, the first
    // past a decade whose digits sum evenly, and the constraints' largest
    for num in [4, 30, 1, 2, 11, 1000] {
        show(num);
    }
    // every number the constraints allow
    let mut total = 0;
    let mut check = 0;
    for num in 1..1001 {
        let found = count_even(num);
        total += found;
        check = (check * 31 + found) % 1000000007;
    }
    println(f"every number from 1 to 1000: {total} in all, checksum {check}");
}
