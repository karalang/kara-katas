// LeetCode #2180: Count Integers With Even Digit Sum -- a `struct
// Odometer` of the digits, lowest first, and their running sum, made
// `at_zero`; it `tick`s one on (`mut ref self`), carrying each 9 over
// to a 0, and says whether it reads `even` (`ref self`). Counting from
// 1 to num is num ticks. O(num) amortised.

struct Odometer {
    digits: Vec[i64],
    total: i64,
}

impl Odometer {
    fn at_zero() -> Odometer {
        Odometer { digits: [0], total: 0 }
    }

    fn tick(mut ref self) {
        let mut place = 0;
        while place < self.digits.len() and self.digits[place] == 9 {
            self.digits[place] = 0;
            self.total -= 9;
            place += 1;
        }
        if place == self.digits.len() {
            self.digits.push(0);
        }
        self.digits[place] += 1;
        self.total += 1;
    }

    fn even(ref self) -> bool {
        self.total % 2 == 0
    }
}

fn count_even(num: i64) -> i64 {
    let mut odometer = Odometer.at_zero();
    let mut count = 0;
    for _ in 0..num {
        odometer.tick();
        if odometer.even() {
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn show(num: i64) {
    println(f"{num} -> {count_even(num)}");
}

fn main() {
    // LeetCode's two examples, then four more: 1, 2, 11, the first
    // past a decade whose digits sum evenly, and the constraints' largest
    for num in [4, 30, 1, 2, 11, 1000] {
        show(num);
    }
    // every number the constraints allow
    let mut total = 0;
    let mut check = 0;
    for num in 1..1001 {
        let found = count_even(num);
        total += found;
        check = (check * 31 + found) % 1000000007;
    }
    println(f"every number from 1 to 1000: {total} in all, checksum {check}");
}
