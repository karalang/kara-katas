// LeetCode #2169: Count Operations to Obtain Zero -- a `struct Pair` that
// keeps its numbers larger first, made `of` two numbers; `round` takes
// the smaller from the larger as often as it goes and gives how many
// times (`mut ref self`), and `done` says whether one is 0 (`ref self`).
// O(log max) rounds.

struct Pair {
    larger: i64,
    smaller: i64,
}

impl Pair {
    fn of(a: i64, b: i64) -> Pair {
        Pair { larger: a.max(b), smaller: a.min(b) }
    }

    fn done(self) -> bool {
        self.smaller == 0
    }

    fn round(mut ref self) -> i64 {
        let times = self.larger / self.smaller;
        let rest = self.larger - times * self.smaller;
        self.larger = self.smaller;
        self.smaller = rest;
        times
    }
}

fn count_operations(num1: i64, num2: i64) -> i64 {
    let mut pair = Pair.of(num1, num2);
    let mut ops = 0;
    while not pair.done() {
        ops += pair.round();
    }
    ops
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(num1: i64, num2: i64) {
    println(f"({num1}, {num2}) -> {count_operations(num1, num2)}");
}

fn main() {
    // LeetCode's two examples, then six more: both zero, one zero, equal,
    // one and the most, the most and one, and two neighbouring Fibonacci
    // numbers, which take the most rounds of division
    show(2, 3);
    show(10, 10);
    show(0, 0);
    show(0, 7);
    show(5, 5);
    show(1, 100000);
    show(100000, 1);
    show(75025, 46368);
    // 2000 random pairs, each number up to 10, 1000 or 10^5 in turn, about
    // one in ten of them 0
    let mut seed = 2169;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let top = [11, 1001, 100001][round % 3];
        let mut pair = [0, 0];
        for k in 0..2 {
            if next_random(mut seed) % 10 > 0 {
                pair[k] = (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
            }
        }
        let ops = count_operations(pair[0], pair[1]);
        total += ops;
        check = (check * 31 + ops) % 1000000007;
    }
    println(f"2000 pairs: {total} in all, checksum {check}");
    // every pair up to 300
    let mut every = 0;
    for a in 0..=300 {
        for b in 0..=300 {
            every = (every * 31 + count_operations(a, b)) % 1000000007;
        }
    }
    println(f"90601 pairs up to 300: checksum {every}");
}
