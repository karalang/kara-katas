// LeetCode #2169: Count Operations to Obtain Zero -- Euclid's algorithm
// by recursion: `match` on how the two compare, the larger divided by
// the smaller, and the rest handed down with the smaller. O(log max)
// calls.

fn count_operations(num1: i64, num2: i64) -> i64 {
    match (num1, num2) {
        (0, _) | (_, 0) => 0,
        (a, b) if a >= b => a / b + count_operations(a % b, b),
        (a, b) => b / a + count_operations(a, b % a),
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(num1: i64, num2: i64) {
    println(f"({num1}, {num2}) -> {count_operations(num1, num2)}");
}

fn main() {
    // LeetCode's two examples, then six more: both zero, one zero, equal,
    // one and the most, the most and one, and two neighbouring Fibonacci
    // numbers, which take the most rounds of division
    show(2, 3);
    show(10, 10);
    show(0, 0);
    show(0, 7);
    show(5, 5);
    show(1, 100000);
    show(100000, 1);
    show(75025, 46368);
    // 2000 random pairs, each number up to 10, 1000 or 10^5 in turn, about
    // one in ten of them 0
    let mut seed = 2169;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let top = [11, 1001, 100001][round % 3];
        let mut pair = [0, 0];
        for k in 0..2 {
            if next_random(mut seed) % 10 > 0 {
                pair[k] = (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
            }
        }
        let ops = count_operations(pair[0], pair[1]);
        total += ops;
        check = (check * 31 + ops) % 1000000007;
    }
    println(f"2000 pairs: {total} in all, checksum {check}");
    // every pair up to 300
    let mut every = 0;
    for a in 0..=300 {
        for b in 0..=300 {
            every = (every * 31 + count_operations(a, b)) % 1000000007;
        }
    }
    println(f"90601 pairs up to 300: checksum {every}");
}
