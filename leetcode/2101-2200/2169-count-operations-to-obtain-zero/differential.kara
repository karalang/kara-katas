// LeetCode #2169: Count Operations to Obtain Zero -- the differential. The
// six arms, against the statement read literally: the larger number less
// the smaller, `num1` taken from when they are equal, one operation at a
// time until one is 0; no division. 300 random pairs, each number up to
// 10, 100 or 1000 in turn and about one in ten 0; then 30 of neighbouring
// Fibonacci numbers and multiples of them; then 30 where one number
// divides the other; every one drawn before any arm answers.
//
// P1  the count is the statement read literally
// P2  the numbers swapped: the same count
// P3  both numbers three times as large: the same count
// P4  the smaller added to the larger, when neither is 0: one more
// P5  the count, when neither is 0, at least the larger over the smaller
//     and at most the larger; 0 otherwise
// P6  each arm agrees with at least three of the other five



// ---- operations.kara: the ★ arm, Euclid's algorithm counting a / b each round
fn star_count_operations(num1: i64, num2: i64) -> i64 {
    let mut a = num1.max(num2);
    let mut b = num1.min(num2);
    let mut ops = 0;
    while b > 0 {
        ops += a / b;
        let rest = a % b;
        a = b;
        b = rest;
    }
    ops
}

// ---- operations_subtract.kara: the operation one at a time
fn subtract_count_operations(num1: i64, num2: i64) -> i64 {
    let mut num1 = num1;
    let mut num2 = num2;
    let mut ops = 0;
    while num1 != 0 and num2 != 0 {
        if num1 >= num2 {
            num1 -= num2;
        } else {
            num2 -= num1;
        }
        ops += 1;
    }
    ops
}

// ---- operations_recursive.kara: Euclid's algorithm by recursion and `match`
fn recursive_count_operations(num1: i64, num2: i64) -> i64 {
    match (num1, num2) {
        (0, _) | (_, 0) => 0,
        (a, b) if a >= b => a / b + recursive_count_operations(a % b, b),
        (a, b) => b / a + recursive_count_operations(a, b % a),
    }
}

// ---- operations_struct.kara: a `Pair`, larger first, a `round` at a time
struct Pair {
    larger: i64,
    smaller: i64,
}

impl Pair {
    fn of(a: i64, b: i64) -> Pair {
        Pair { larger: a.max(b), smaller: a.min(b) }
    }

    fn done(self) -> bool {
        self.smaller == 0
    }

    fn round(mut ref self) -> i64 {
        let times = self.larger / self.smaller;
        let rest = self.larger - times * self.smaller;
        self.larger = self.smaller;
        self.smaller = rest;
        times
    }
}

fn struct_count_operations(num1: i64, num2: i64) -> i64 {
    let mut pair = Pair.of(num1, num2);
    let mut ops = 0;
    while not pair.done() {
        ops += pair.round();
    }
    ops
}

// ---- operations_iter.kara: `successors`, `map` and `sum`
fn iter_count_operations(num1: i64, num2: i64) -> i64 {
    successors(Some((num1.max(num2), num1.min(num2))), |(a, b)| if b > 0 { Some((b, a % b)) } else { None })
        .map(|(a, b)| if b > 0 { a / b } else { 0 })
        .sum()
}

// ---- operations_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn count_operations(num1: i32, num2: i32) -> i32 {
        let mut num1 = num1;
        let mut num2 = num2;
        let mut ops: i32 = 0;
        while num1 != 0 and num2 != 0 {
            if num1 >= num2 {
                ops += num1 / num2;
                num1 %= num2;
            } else {
                ops += num2 / num1;
                num2 %= num1;
            }
        }
        ops
    }
}

struct Solution {}

fn solution_count_operations(num1: i64, num2: i64) -> i64 {
    Solution.count_operations(num1 as i32, num2 as i32)
}


// ---- the statement read literally

fn literal(num1: i64, num2: i64) -> i64 {
    let mut a = num1;
    let mut b = num2;
    let mut ops = 0;
    while a != 0 and b != 0 {
        if a >= b {
            a -= b;
        } else {
            b -= a;
        }
        ops += 1;
    }
    ops
}

fn answer(arm: i64, num1: i64, num2: i64) -> i64 {
    match arm {
        0 => star_count_operations(num1, num2),
        1 => subtract_count_operations(num1, num2),
        2 => recursive_count_operations(num1, num2),
        3 => struct_count_operations(num1, num2),
        4 => iter_count_operations(num1, num2),
        _ => solution_count_operations(num1, num2),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "subtract", "recursive", "struct", "iter", "solution"];
    let mut seed = 2169;
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for t in 0..360 {
        let pair = if t < 300 {
            let top = [11, 101, 1001][t % 3];
            let mut p = [0, 0];
            for k in 0..2 {
                if next_random(mut seed) % 10 > 0 {
                    p[k] = next_random(mut seed) % top;
                }
            }
            (p[0], p[1])
        } else if t < 330 {
            let mut a = 1;
            let mut b = 1;
            for _ in 0..(next_random(mut seed) % 12) {
                let c = a + b;
                a = b;
                b = c;
            }
            let k = next_random(mut seed) % 5 + 1;
            if next_random(mut seed) % 2 == 0 { (k * a, k * b) } else { (k * b, k * a) }
        } else {
            let small = next_random(mut seed) % 20 + 1;
            let times = next_random(mut seed) % 30 + 1;
            if next_random(mut seed) % 2 == 0 { (small, small * times) } else { (small * times, small) }
        };
        pairs.push(pair);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (num1, num2) in pairs.iter() {
        let truth = literal(num1, num2);
        check = (check * 31 + truth) % 1000000007;
        let larger = num1.max(num2);
        let smaller = num1.min(num2);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, num1, num2)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let added = if smaller > 0 {
                if num1 >= num2 { answer(arm, num1 + num2, num2) } else { answer(arm, num1, num1 + num2) }
            } else {
                x + 1
            };
            let bounded = if smaller > 0 { x >= larger / smaller and x <= larger } else { x == 0 };
            let verdicts = [
                x == truth,
                answer(arm, num2, num1) == x,
                answer(arm, 3 * num1, 3 * num2) == x,
                added == x + 1,
                bounded,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"({num1}, {num2}) arm {names[arm]}: P{q + 1} fails, answered {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{pairs.len()} pairs: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
