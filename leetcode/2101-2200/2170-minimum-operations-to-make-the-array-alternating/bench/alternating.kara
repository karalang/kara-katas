// LeetCode #2170: Minimum Operations to Make the Array Alternating -- the
// benchmark's ★ arm: each side of a window counted in a `Map`, its two
// most frequent kept, the second taken when the favourites clash.

fn top_two(nums: Slice[i64], start: i64) -> ((i64, i64), (i64, i64)) {
    let mut counts: Map[i64, i64] = Map.new();
    let mut i = start;
    while i < nums.len() {
        *counts.entry(nums[i]).or_insert(0) += 1;
        i += 2;
    }
    let mut first = (0, 0);
    let mut second = (0, 0);
    for (value, count) in counts.iter() {
        if count > first.1 {
            second = first;
            first = (value, count);
        } else if count > second.1 {
            second = (value, count);
        }
    }
    (first, second)
}

fn minimum_operations(nums: Slice[i64]) -> i64 {
    let n = nums.len();
    let (even_first, even_second) = top_two(nums, 0);
    let (odd_first, odd_second) = top_two(nums, 1);
    if even_first.0 != odd_first.0 {
        n - even_first.1 - odd_first.1
    } else {
        n - (even_first.1 + odd_second.1).max(even_second.1 + odd_first.1)
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2170;
    let mut row: Vec[i64] = Vec.new();
    for _ in 0..400000 {
        let a = next_random(mut seed);
        let b = next_random(mut seed);
        row.push((a * 32768 + b) % 1000 + 1);
    }
    let mut check = 0;
    for _ in 0..100 {
        let a = next_random(mut seed);
        let b = next_random(mut seed);
        let start = (a * 32768 + b) % 300001;
        let ops = minimum_operations(row[start..(start + 100000)]);
        check = (check * 31 + ops) % 1000000007;
    }
    println(f"100 solves: checksum {check}");
}
