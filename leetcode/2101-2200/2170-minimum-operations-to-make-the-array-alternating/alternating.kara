// LeetCode #2170: Minimum Operations to Make the Array Alternating -- the
// ★ arm. An alternating array holds one number on every even place and
// another on every odd place, so each side keeps its most frequent
// number and changes the rest. When both sides' favourite is the same
// number, one side settles for its second; so each side's two most
// frequent counts are kept, from a `Map` of counts. O(n).

fn top_two(nums: Vec[i64], start: i64) -> ((i64, i64), (i64, i64)) {
    let mut counts: Map[i64, i64] = Map.new();
    let mut i = start;
    while i < nums.len() {
        *counts.entry(nums[i]).or_insert(0) += 1;
        i += 2;
    }
    let mut first = (0, 0);
    let mut second = (0, 0);
    for (value, count) in counts.iter() {
        if count > first.1 {
            second = first;
            first = (value, count);
        } else if count > second.1 {
            second = (value, count);
        }
    }
    (first, second)
}

fn minimum_operations(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let (even_first, even_second) = top_two(nums, 0);
    let (odd_first, odd_second) = top_two(nums, 1);
    if even_first.0 != odd_first.0 {
        n - even_first.1 - odd_first.1
    } else {
        n - (even_first.1 + odd_second.1).max(even_second.1 + odd_first.1)
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {minimum_operations(nums)}");
}

fn main() {
    // LeetCode's two examples, then five more: one number, two the same,
    // two different, already alternating, and both places' favourite the
    // same with a close second
    show([3, 1, 3, 2, 4, 3]);
    show([1, 2, 2, 2, 2]);
    show([7]);
    show([5, 5]);
    show([5, 6]);
    show([4, 9, 4, 9, 4]);
    show([1, 1, 1, 1, 2, 1, 2]);
    // 2000 random lists of 1 to 20 numbers from 1 to 2, 1 to 4 or 1 to 10^5
    // in turn
    let mut seed = 2170;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let length = next_random(mut seed) % 20 + 1;
        let top = [2, 4, 100000][round % 3];
        let nums: Vec[i64] = (0..length).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1).collect();
        let ops = minimum_operations(nums);
        total += ops;
        check = (check * 31 + ops) % 1000000007;
    }
    println(f"2000 lists: {total} in all, checksum {check}");
    // the constraints' largest: 10^5 numbers from 1 to 3, from 1 to 10^5,
    // and one number throughout
    let few: Vec[i64] = (0..100000).map(|_| next_random(mut seed) % 3 + 1).collect();
    let many: Vec[i64] = (0..100000).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1).collect();
    let same: Vec[i64] = Vec.filled(100000, 8);
    println(f"100000 numbers: {minimum_operations(few)} {minimum_operations(many)} {minimum_operations(same)}");
}
