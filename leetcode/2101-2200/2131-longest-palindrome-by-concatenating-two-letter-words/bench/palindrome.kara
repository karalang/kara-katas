// LeetCode #2131: Longest Palindrome by Concatenating Two Letter Words --
// the benchmark, palindrome.kara's ★ arm. 20 lists of 100000 words over
// the first 8 letters built once; then every list solved 10 times, one
// word replaced by a random one before each solve.

fn longest_palindrome(words: Vec[String]) -> i64 {
    let mut count: Vec[i64] = Vec.filled(26 * 26, 0);
    for w in words.iter() {
        let b = w.bytes();
        count[(b[0] - 97) as i64 * 26 + (b[1] - 97)] += 1;
    }
    let mut length = 0;
    let mut middle = false;
    for x in 0..26 {
        length += count[x * 26 + x] / 2 * 4;
        if count[x * 26 + x] % 2 == 1 {
            middle = true;
        }
        for y in x + 1..26 {
            length += count[x * 26 + y].min(count[y * 26 + x]) * 4;
        }
    }
    if middle {
        length += 2;
    }
    length
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn word(seed: mut ref i64) -> String {
    let letters = "abcdefgh";
    let a = next_random(mut seed) % 8;
    let b = next_random(mut seed) % 8;
    f"{letters[a..a + 1]}{letters[b..b + 1]}"
}

fn main() {
    let mut seed = 2131;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..20 {
        let mut words: Vec[String] = Vec.new();
        for _ in 0..100000 {
            words.push(word(mut seed));
        }
        lists.push(words);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..10 {
        for k in 0..20 {
            let at = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000;
            lists[k][at] = word(mut seed);
            let length = longest_palindrome(lists[k]);
            total += length;
            check = (check * 31 + length + round) % 1000000007;
        }
    }
    println(f"200 solves: {total} letters in all, checksum {check}");
}
