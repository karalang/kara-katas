// LeetCode #2131: Longest Palindrome by Concatenating Two Letter Words --
// one pass: a word whose reverse is waiting takes it as a mirrored pair,
// four letters; otherwise it waits itself. At the end, a doubled word
// still waiting can sit in the middle. Waiting words counted in a
// `Vec[i64]` indexed by the word's two letters.

fn longest_palindrome(words: Vec[String]) -> i64 {
    let mut waiting: Vec[i64] = Vec.filled(26 * 26, 0);
    let mut length = 0;
    for w in words.iter() {
        let b = w.bytes();
        let x = (b[0] - b'a') as i64;
        let y = (b[1] - b'a') as i64;
        if waiting[y * 26 + x] > 0 {
            waiting[y * 26 + x] -= 1;
            length += 4;
        } else {
            waiting[x * 26 + y] += 1;
        }
    }
    if (0..26).any(|x| waiting[x * 26 + x] > 0) {
        length += 2;
    }
    length
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(words: Vec[String]) {
    println(f"{words} -> {longest_palindrome(words)}");
}

fn strings(words: Vec[Str]) -> Vec[String] {
    words.iter().map(|w| w.to_string()).collect()
}

fn main() {
    // LeetCode's three examples, then four more: one doubled word, two,
    // a word and two of its reverse, and a word with no partner
    show(strings(["lc", "cl", "gg"].to_vec()));
    show(strings(["ab", "ty", "yt", "lc", "cl", "ab"].to_vec()));
    show(strings(["cc", "ll", "xx"].to_vec()));
    show(strings(["aa"].to_vec()));
    show(strings(["aa", "aa"].to_vec()));
    show(strings(["ab", "ba", "ba"].to_vec()));
    show(strings(["ab"].to_vec()));
    // 2000 random lists of 1 to 12 words over the first 2, 3 or 5 letters
    let letters = "abcdefghijklmnopqrstuvwxyz";
    let mut seed = 2131;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let k = [2, 3, 5][round % 3];
        let mut words: Vec[String] = Vec.new();
        for _ in 0..n {
            let a = next_random(mut seed) % k;
            let b = next_random(mut seed) % k;
            words.push(f"{letters[a..a + 1]}{letters[b..b + 1]}");
        }
        let length = longest_palindrome(words);
        total += length;
        check = (check * 31 + length) % 1000000007;
    }
    println(f"2000 lists: {total} letters in all, checksum {check}");
    // the constraints' largest: 100000 of "aa", 100000 of "ab" and "ba" in
    // turn, and 100000 random words
    let same: Vec[String] = Vec.filled(100000, "aa");
    let turns: Vec[String] = (0..100000).map(|i| if i % 2 == 0 { "ab" } else { "ba" }).collect();
    let mut random: Vec[String] = Vec.new();
    for _ in 0..100000 {
        let a = next_random(mut seed) % 26;
        let b = next_random(mut seed) % 26;
        random.push(f"{letters[a..a + 1]}{letters[b..b + 1]}");
    }
    let x = longest_palindrome(same);
    let y = longest_palindrome(turns);
    let z = longest_palindrome(random);
    println(f"100000 words: {x} of one, {y} in turn, {z} at random");
}
