// LeetCode #2137: Pour Water Between Buckets to Make Water Levels Equal --
// the benchmark, water.kara's ★ arm. 10 lists of 100000 buckets built
// once, of 0 to 100000; then every list solved 10 times, one bucket
// redrawn before each solve and the loss drawn anew.

fn equalize_water(buckets: Vec[i64], loss: i64) -> f64 {
    let keep = (100 - loss) as f64 / 100.0;
    let mut low = 0.0;
    let mut high = buckets.iter().max().unwrap() as f64;
    for _ in 0..64 {
        let mid = (low + high) / 2.0;
        let mut spare = 0.0;
        let mut need = 0.0;
        for b in buckets.iter() {
            let w = b as f64;
            if w > mid {
                spare += (w - mid) * keep;
            } else {
                need += mid - w;
            }
        }
        if spare >= need {
            low = mid;
        } else {
            high = mid;
        }
    }
    low
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2137;
    let mut lists: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10 {
        let mut buckets: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            buckets.push(next_random(mut seed) % 100001);
        }
        lists.push(buckets);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..10 {
        for l in 0..10 {
            let at = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000;
            lists[l][at] = next_random(mut seed) % 100001;
            let loss = next_random(mut seed) % 100;
            let level = equalize_water(lists[l], loss);
            let scaled = (level * 1048576.0 + 0.5).floor() as i64;
            total += scaled;
            check = (check * 31 + scaled + round) % 1000000007;
        }
    }
    println(f"100 solves: {total} in all, in steps of 2^-20, checksum {check}");
}
