// LeetCode #2146: K Highest Ranked Items Within a Price Range -- LeetCode's
// Rust template: a `VecDeque` search with `usize` cells and `as i32`
// casts, the four directions as `[(i32, i32); 4]`, the items ranked by
// `sort_unstable` on tuples and cut by `truncate`, written as Rust.
// Carried by `karac fix`. The adapter below hands the harness's grid to
// it.

impl Solution {
    pub fn highest_ranked_k_items(grid: Vec[Vec[i32]], pricing: Vec[i32], start: Vec[i32], k: i32) -> Vec[Vec[i32]] {
        let (m, n) = (grid.len(), grid[0].len());
        let (low, high) = (pricing[0], pricing[1]);
        let dirs: Array[(i32, i32), 4] = [(1, 0), (-1, 0), (0, 1), (0, -1)];
        let mut seen = Vec.filled(m, Vec.filled(n, false));
        let (sr, sc) = (start[0] as i64, start[1] as i64);
        seen[sr][sc] = true;
        let mut q = VecDeque.new();
        q.push_back((sr, sc, 0));
        let mut items: Vec[(i32, i32, i64, i64)] = Vec.new();
        while let Some((r, c, d)) = q.pop_front() {
            let p = grid[r][c];
            if p >= low and p <= high {
                items.push((d, p, r, c));
            }
            for (dr, dc) in dirs.iter() {
                let nr = r as i32 + dr;
                let nc = c as i32 + dc;
                if nr < 0 or nc < 0 or nr >= m as i32 or nc >= n as i32 {
                    continue;
                }
                let (nr, nc) = (nr as i64, nc as i64);
                if seen[nr][nc] or grid[nr][nc] == 0 {
                    continue;
                }
                seen[nr][nc] = true;
                q.push_back((nr, nc, d + 1));
            }
        }
        items.sort();
        items.truncate(k);
        items.into_iter().map(|(_, _, r, c)| [r as i32, c as i32]).collect()
    }
}

struct Solution {}

fn highest_ranked_k_items(grid: Vec[Vec[i64]], pricing: Vec[i64], start: Vec[i64], k: i64) -> Vec[Vec[i64]] {
    let g: Vec[Vec[i32]] = grid.iter().map(|row| row.iter().map(|v| v as i32).collect()).collect();
    let p: Vec[i32] = pricing.iter().map(|v| v as i32).collect();
    let s: Vec[i32] = start.iter().map(|v| v as i32).collect();
    Solution.highest_ranked_k_items(g, p, s, k as i32)
        .into_iter()
        .map(|cell| cell.into_iter().map(|v| v as i64).collect())
        .collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(grid: Vec[Vec[i64]], pricing: Vec[i64], start: Vec[i64], k: i64) {
    println(f"{pricing} {start} {k} -> {highest_ranked_k_items(grid, pricing, start, k)}");
}

fn main() {
    // LeetCode's three examples, then three more: the start an item in
    // range itself, fewer items than k behind a wall, and four items at
    // one distance and one price, ranked by row and then column
    show([[1, 2, 0, 1].to_vec(), [1, 3, 0, 1].to_vec(), [0, 2, 5, 1].to_vec()].to_vec(), [2, 5].to_vec(), [0, 0].to_vec(), 3);
    show([[1, 2, 0, 1].to_vec(), [1, 3, 3, 1].to_vec(), [0, 2, 5, 1].to_vec()].to_vec(), [2, 3].to_vec(), [2, 3].to_vec(), 2);
    show([[1, 1, 1].to_vec(), [0, 0, 1].to_vec(), [2, 3, 4].to_vec()].to_vec(), [2, 3].to_vec(), [0, 0].to_vec(), 3);
    show([[4].to_vec()].to_vec(), [4, 4].to_vec(), [0, 0].to_vec(), 1);
    show([[2, 0, 2].to_vec(), [1, 0, 2].to_vec()].to_vec(), [2, 2].to_vec(), [0, 0].to_vec(), 5);
    show([[1, 3, 1].to_vec(), [3, 1, 3].to_vec(), [1, 3, 1].to_vec()].to_vec(), [3, 3].to_vec(), [1, 1].to_vec(), 3);
    // 2000 random grids of up to 6 by 6, a wall one cell in 4, prices of
    // 1 to 5 or 1 to 100000 in turn, a random range from 2 up, start and k
    let mut seed = 2146;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let m = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % 6 + 1;
        let top = [5, 100000][round % 2];
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..m {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..n {
                row.push(if next_random(mut seed) % 4 == 0 { 0 } else { next_random(mut seed) % top + 1 });
            }
            grid.push(row);
        }
        let sr = next_random(mut seed) % m;
        let sc = next_random(mut seed) % n;
        if grid[sr][sc] == 0 {
            grid[sr][sc] = 1;
        }
        let a = next_random(mut seed) % top + 1;
        let b = next_random(mut seed) % top + 1;
        let k = next_random(mut seed) % (m * n) + 1;
        let cells = highest_ranked_k_items(grid, [a.min(b).max(2), a.max(b).max(2)].to_vec(), [sr, sc].to_vec(), k);
        total += cells.len();
        for cell in cells.iter() {
            check = (check * 31 + cell[0] * 1000 + cell[1] + 1) % 1000000007;
        }
    }
    println(f"2000 grids: {total} items in all, checksum {check}");
    // the constraints' largest, 316 by 316 cells: every price from 1 up,
    // the odd rows broken by walls, every item ranked from the middle and
    // the ten cheapest from a corner
    let mut grid: Vec[Vec[i64]] = (0..316).map(|r| (0..316).map(|c| (r * 316 + c) % 100000 + 1).collect()).collect();
    for r in (1..316).step_by(2) {
        for c in 0..316 {
            if (c + r / 2) % 50 == 0 {
                grid[r][c] = 0;
            }
        }
    }
    let every = highest_ranked_k_items(grid, [2, 100000].to_vec(), [158, 158].to_vec(), 99856);
    let cheap = highest_ranked_k_items(grid, [2, 1000].to_vec(), [0, 0].to_vec(), 10);
    let mut sum = 0;
    for cell in every.iter() {
        sum = (sum * 31 + cell[0] * 1000 + cell[1] + 1) % 1000000007;
    }
    let first: Vec[Vec[i64]] = every.iter().take(3).cloned().collect();
    let cheapest: Vec[Vec[i64]] = cheap.iter().take(3).cloned().collect();
    println(f"316 x 316: {every.len()} items ranked, checksum {sum}, first {first}, cheap {cheapest}");
}
