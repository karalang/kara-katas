// LeetCode #2121: Intervals Between Identical Elements -- the struct arm.
// A `Group` holds one value's indices in order. Its first index is
// answered by summing the gaps to the rest; moving from one index to the
// next, a gap of `g` brings the `k` copies behind `g` farther and the
// `c - k` ahead `g` nearer, so `spread_into` (`mut ref` to the answer)
// walks the list with that one step. O(n).

struct Group {
    positions: Vec[i64],
}

impl Group {
    fn spread_into(self, answer: mut ref Vec[i64]) {
        let p = ref self.positions;
        let c = p.len();
        let mut distance = 0;
        for j in 1..c {
            distance += p[j] - p[0];
        }
        answer[p[0]] = distance;
        for k in 1..c {
            distance += (2 * k - c) * (p[k] - p[k - 1]);
            answer[p[k]] = distance;
        }
    }
}

fn get_distances(arr: Vec[i64]) -> Vec[i64] {
    let mut groups: Map[i64, Group] = Map.new();
    for i in 0..arr.len() {
        groups.entry(arr[i]).or_insert(Group { positions: Vec.new() }).positions.push(i);
    }
    let mut answer = Vec.filled(arr.len(), 0);
    for (_, group) in groups.iter() {
        group.spread_into(mut answer);
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then four more: one element, every value
    // different, every value the same, and two values alternating
    let examples: Vec[Vec[i64]] = [
        [2, 1, 3, 1, 2, 3, 3].to_vec(),
        [10, 5, 10, 10].to_vec(),
        [7].to_vec(),
        [1, 2, 3, 4, 5].to_vec(),
        [4, 4, 4, 4, 4, 4].to_vec(),
        [1, 2, 1, 2, 1, 2, 1].to_vec(),
    ].to_vec();
    for arr in examples.iter() {
        println(f"{arr} -> {get_distances(arr)}");
    }
    // 2000 random arrays of 1 to 40 values from 1 to 1, 3, 10 or 100000
    let mut seed = 2121;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 40 + 1;
        let top = [1, 3, 10, 100000][round % 4];
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            arr.push(next_random(mut seed) % top + 1);
        }
        for d in get_distances(arr).iter() {
            total += d;
            check = (check * 31 + d) % 1000000007;
        }
    }
    println(f"2000 arrays: distances sum to {total}, checksum {check}");
    // the constraints' largest: 100000 equal values, and 100000 values
    // from 1 to 7 in a cycle
    let same = Vec.filled(100000, 5);
    let far = get_distances(same);
    println(f"100000 equal: first {far[0]}, middle {far[50000]}, last {far[99999]}");
    let cycle: Vec[i64] = (0..100000).map(|i| i % 7 + 1).collect();
    let spread = get_distances(cycle);
    println(f"100000 in a cycle of 7: sum {spread.iter().sum()}, first {spread[0]}, last {spread[99999]}");
}
