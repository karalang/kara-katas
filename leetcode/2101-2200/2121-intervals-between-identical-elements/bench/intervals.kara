// LeetCode #2121: Intervals Between Identical Elements -- the benchmark,
// intervals.kara's ★ arm: each value's indices gathered in a `Map`, then
// one running sum per list. 40 arrays of 50000 values from 1 to 10, 100,
// 1000 or 10000 in turn, built once; then 20 rounds over all of them,
// one value raised by one before each solve.

fn get_distances(arr: Vec[i64]) -> Vec[i64] {
    let mut positions: Map[i64, Vec[i64]] = Map.new();
    for i in 0..arr.len() {
        positions.entry(arr[i]).or_insert(Vec.new()).push(i);
    }
    let mut answer = Vec.filled(arr.len(), 0);
    for (_, p) in positions.iter() {
        let c = p.len();
        let total: i64 = p.iter().sum();
        let mut before = 0;
        for k in 0..c {
            let after = total - before - p[k];
            answer[p[k]] = k * p[k] - before + after - (c - k - 1) * p[k];
            before += p[k];
        }
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2121;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for g in 0..40 {
        let top = [10, 100, 1000, 10000][g % 4];
        let arr: Vec[i64] = (0..50000).map(|_| next_random(mut seed) % top + 1).collect();
        arrays.push(arr);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..20 {
        for g in 0..40 {
            arrays[g][(round * 7919 + g * 104729) % 50000] += 1;
            let sum: i64 = get_distances(arrays[g]).iter().sum();
            total += sum;
            check = (check * 31 + sum % 1000000007) % 1000000007;
        }
    }
    println(f"800 solves: distances sum to {total}, checksum {check}");
}
