// LeetCode #2147: Number of Ways to Divide a Long Corridor -- by states.
// Walking the corridor, the ways so far are counted by how many seats
// the open section holds: none, one or two. A seat moves none to one and
// one to two, and moves two to one by a divider just before it; a plant
// keeps every state, and may also close a section of two with a divider
// just before it, opening one of none. The ways that end with a full
// section are the answer. O(n), no `Vec`.

fn number_of_ways(corridor: String) -> i64 {
    let modulus = 1000000007;
    let mut none = 1;
    let mut one = 0;
    let mut two = 0;
    for ch in corridor.chars() {
        if ch == 'S' {
            let next_one = (none + two) % modulus;
            two = one;
            one = next_one;
            none = 0;
        } else {
            none = (none + two) % modulus;
        }
    }
    two
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(corridor: String) {
    println(f"{corridor} -> {number_of_ways(corridor)}");
}

fn main() {
    // LeetCode's three examples, then three more: no seat, one pair, and
    // three pairs with gaps of two and three
    show("SSPPSPS");
    show("PPSPSP");
    show("S");
    show("PPPP");
    show("SS");
    show("SSPSSPPSS");
    // 2000 random corridors of 1 to 20 places, a seat one place in 2, 3
    // or 6 in turn
    let mut seed = 2147;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 20 + 1;
        let one_in = [2, 3, 6][round % 3];
        let mut corridor = String.new();
        for _ in 0..n {
            corridor.push(if next_random(mut seed) % one_in == 0 { 'S' } else { 'P' });
        }
        let ways = number_of_ways(corridor);
        total += ways;
        check = (check * 31 + ways + n) % 1000000007;
    }
    println(f"2000 corridors: {total} ways in all, checksum {check}");
    // the constraints' largest, 100000 places: every one a seat, seats
    // and plants in turn, and at random, a seat one place in 4, with the
    // last place making the seats even
    let seats = "S".repeat(100000);
    let spaced = "SPSP".repeat(25000);
    let mut random = String.new();
    let mut count = 0;
    for _ in 0..99999 {
        if next_random(mut seed) % 4 == 0 {
            random.push('S');
            count += 1;
        } else {
            random.push('P');
        }
    }
    random.push(if count % 2 == 1 { 'S' } else { 'P' });
    println(f"100000 places: {number_of_ways(seats)} all seats, {number_of_ways(spaced)} spaced, {number_of_ways(random)} at random");
}
