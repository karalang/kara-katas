// LeetCode #2104: Sum of Subarray Ranges -- bench. The ★ arm's two
// monotonic stacks: 1000 arrays of 1000 numbers built once, then 10
// passes over them.

fn sub_array_ranges(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut sum = 0;
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..=n {
        while not stack.is_empty() and (i == n or nums[stack.last().unwrap()] < nums[i]) {
            let top = stack.pop().unwrap();
            let left = if stack.is_empty() { -1 } else { stack.last().unwrap() };
            sum += nums[top] * (top - left) * (i - top);
        }
        stack.push(i);
    }
    stack.clear();
    for i in 0..=n {
        while not stack.is_empty() and (i == n or nums[stack.last().unwrap()] > nums[i]) {
            let top = stack.pop().unwrap();
            let left = if stack.is_empty() { -1 } else { stack.last().unwrap() };
            sum -= nums[top] * (top - left) * (i - top);
        }
        stack.push(i);
    }
    sum
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 2104;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..1000 {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..1000 {
            nums.push(wide_random(mut seed) % 2000000001 - 1000000000);
        }
        arrays.push(nums);
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..10 {
        for nums in arrays.iter() {
            let got = sub_array_ranges(nums) % 1000000007;
            total = (total + got) % 1000000007;
            check = (check * 31 + got) % 1000000007;
        }
    }
    println(f"10000 arrays: total {total}, checksum {check}");
}
