// LeetCode #2104: Sum of Subarray Ranges -- the ★ arm. The sum of every
// subarray's largest less the sum of every subarray's smallest. Each
// number is the largest of (i - left) * (right - i) subarrays, where
// `left` is the nearest place before it holding a number at least as
// large and `right` the nearest after holding a larger one; a stack of
// places, kept falling, finds both as the number is popped. The same
// for the smallest with a rising stack. O(n).

fn sub_array_ranges(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut sum = 0;
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..=n {
        while not stack.is_empty() and (i == n or nums[stack.last().unwrap()] < nums[i]) {
            let top = stack.pop().unwrap();
            let left = if stack.is_empty() { -1 } else { stack.last().unwrap() };
            sum += nums[top] * (top - left) * (i - top);
        }
        stack.push(i);
    }
    stack.clear();
    for i in 0..=n {
        while not stack.is_empty() and (i == n or nums[stack.last().unwrap()] > nums[i]) {
            let top = stack.pop().unwrap();
            let left = if stack.is_empty() { -1 } else { stack.last().unwrap() };
            sum -= nums[top] * (top - left) * (i - top);
        }
        stack.push(i);
    }
    sum
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's three examples, then four more: one number, all equal,
    // the two extremes, and a valley of repeats
    let examples = [
        [1, 2, 3].to_vec(),
        [1, 3, 3].to_vec(),
        [4, -2, -3, 4, 1].to_vec(),
        [5].to_vec(),
        [7, 7, 7, 7].to_vec(),
        [-1000000000, 1000000000].to_vec(),
        [3, 1, 1, 1, 3].to_vec(),
    ];
    for nums in examples.iter() {
        println(f"{nums} -> {sub_array_ranges(nums)}");
    }
    // 3000 random arrays of 1 to 60 numbers, from -20 to 20 so that ties
    // are common, or from -10^9 to 10^9
    let mut seed = 2104;
    let mut total = 0;
    let mut check = 0;
    for round in 0..3000 {
        let n = next_random(mut seed) % 60 + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            if round % 2 == 0 {
                nums.push(next_random(mut seed) % 41 - 20);
            } else {
                nums.push(wide_random(mut seed) % 2000000001 - 1000000000);
            }
        }
        let got = sub_array_ranges(nums);
        total += got % 1000000007;
        check = (check * 31 + got % 1000000007 + 1000000007) % 1000000007;
    }
    println(f"3000 arrays: total {total}, checksum {check}");
    // the constraints' largest, 1000 numbers: rising, alternating between
    // the extremes, and random over the whole range
    let rising: Vec[i64] = (0..1000).map(|i| i * 2000000 - 1000000000).collect();
    let alternating: Vec[i64] = (0..1000).map(|i| if i % 2 == 0 { 1000000000 } else { -1000000000 }).collect();
    let spread: Vec[i64] = (0..1000).map(|_| wide_random(mut seed) % 2000000001 - 1000000000).collect();
    println(f"rising -> {sub_array_ranges(rising)}");
    println(f"alternating -> {sub_array_ranges(alternating)}");
    println(f"spread -> {sub_array_ranges(spread)}");
}
