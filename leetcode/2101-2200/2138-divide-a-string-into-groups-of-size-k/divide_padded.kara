// LeetCode #2138: Divide a String Into Groups of Size k -- padded first.
// The string is made up with the fill to a whole number of groups before
// any is cut, so that every group is the same plain slice, collected by
// `map` over the group numbers. O(n + k).

fn divide_string(s: String, k: i64, fill: char) -> Vec[String] {
    let mut padded = s.clone();
    while padded.len() % k != 0 {
        padded.push(fill);
    }
    (0..padded.len() / k).map(|g| padded[g * k..g * k + k].to_string()).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn letters(seed: mut ref i64, n: i64, kinds: i64) -> String {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    let mut s = String.new();
    for _ in 0..n {
        let at = next_random(mut seed) % kinds;
        s.push_str(alphabet[at..at + 1]);
    }
    s
}

fn show(s: String, k: i64, fill: char) {
    println(f"\"{s}\" {k} {fill} -> {divide_string(s, k, fill)}");
}

fn main() {
    // LeetCode's two examples, then four more: groups of one, one group
    // longer than the string, one group exactly the string, and a fill
    // that is also a letter of the string
    show("abcdefghi", 3, 'x');
    show("abcdefghij", 3, 'x');
    show("abc", 1, 'q');
    show("ab", 5, 'z');
    show("kara", 4, 'y');
    show("aabba", 2, 'a');
    // 2000 random strings of 1 to 20 letters from the first 2, 5 or 26 in
    // turn, k of 1 to 8 and a random fill; each group's letters hashed
    let mut seed = 2138;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 20 + 1;
        let s = letters(mut seed, n, [2, 5, 26][round % 3]);
        let k = next_random(mut seed) % 8 + 1;
        let fill = letters(mut seed, 1, 26).chars().next().unwrap();
        let groups = divide_string(s, k, fill);
        total += groups.len();
        for g in groups.iter() {
            for b in g.bytes().iter() {
                check = (check * 131 + b as i64) % 1000000007;
            }
            check = (check * 131 + 1) % 1000000007;
        }
    }
    println(f"2000 strings: {total} groups, checksum {check}");
    // the constraints' largest, 100 letters, in groups of 1, 7 and 100
    let s = letters(mut seed, 100, 26);
    let ones = divide_string(s, 1, 'x');
    let sevens = divide_string(s, 7, 'x');
    let whole = divide_string(s, 100, 'x');
    println(f"100 letters: {ones.len()} groups of 1, {sevens.len()} of 7 ending {sevens[sevens.len() - 1]}, {whole.len()} of 100");
}
