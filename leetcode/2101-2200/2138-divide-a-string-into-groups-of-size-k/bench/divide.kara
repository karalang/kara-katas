// LeetCode #2138: Divide a String Into Groups of Size k -- the benchmark,
// divide.kara's ★ arm. 1000 strings of 100 letters built once; then 100
// rounds over them, one letter of the string redrawn before each solve
// and k and the fill drawn anew, 100000 solves in all.

fn divide_string(s: String, k: i64, fill: char) -> Vec[String] {
    let n = s.len();
    let mut groups: Vec[String] = Vec.new();
    let mut start = 0;
    while start < n {
        let mut group = s[start..(start + k).min(n)].to_string();
        while group.len() < k {
            group.push(fill);
        }
        groups.push(group);
        start += k;
    }
    groups
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut seed = 2138;
    let mut strings: Vec[Vec[char]] = Vec.new();
    for _ in 0..1000 {
        let mut s: Vec[char] = Vec.new();
        for _ in 0..100 {
            s.push(alphabet[next_random(mut seed) % 26]);
        }
        strings.push(s);
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..100 {
        for i in 0..1000 {
            let at = next_random(mut seed) % 100;
            strings[i][at] = alphabet[next_random(mut seed) % 26];
            let k = next_random(mut seed) % 100 + 1;
            let fill = alphabet[next_random(mut seed) % 26];
            let s: String = strings[i].iter().collect();
            let groups = divide_string(s, k, fill);
            total += groups.len();
            for b in groups[groups.len() - 1].bytes().iter() {
                check = (check * 131 + b as i64) % 1000000007;
            }
        }
    }
    println(f"100000 solves: {total} groups, checksum {check}");
}
