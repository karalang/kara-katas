// LeetCode #2193: Minimum Number of Moves to Make Palindrome -- each
// letter given the place it takes in the palindrome, its k-th from the
// left paired with its k-th from the right, the pairs laid outward in the
// order their left ends come, a lone letter in the middle; the moves are
// the inversions of those places, counted by a merge sort that recurses
// on two halves. O(n log n).

fn targets(s: String) -> Vec[i64] {
    let b: Vec[u8] = s.bytes().to_vec();
    let n = b.len();
    let mut used: Vec[bool] = Vec.filled(n, false);
    let mut target: Vec[i64] = Vec.filled(n, 0);
    let mut next = 0;
    let mut right = n - 1;
    for i in 0..n {
        if used[i] {
            continue;
        }
        used[i] = true;
        let mut j = right;
        while j > i and (used[j] or b[j] != b[i]) {
            j -= 1;
        }
        if j == i {
            target[i] = n / 2;
        } else {
            used[j] = true;
            target[i] = next;
            target[j] = n - 1 - next;
            next += 1;
        }
        while right > 0 and used[right] {
            right -= 1;
        }
    }
    target
}

// sorts `v` and returns its inversions
fn sort_count(v: own Vec[i64]) -> (Vec[i64], i64) {
    if v.len() <= 1 {
        return (v, 0);
    }
    let mid = v.len() / 2;
    let (left, a) = sort_count(v[0..mid].to_vec());
    let (right, b) = sort_count(v[mid..v.len()].to_vec());
    let mut merged: Vec[i64] = Vec.new();
    let mut count = a + b;
    let mut i = 0;
    let mut j = 0;
    while i < left.len() or j < right.len() {
        if j == right.len() or (i < left.len() and left[i] <= right[j]) {
            merged.push(left[i]);
            i += 1;
        } else {
            merged.push(right[j]);
            count += left.len() - i;
            j += 1;
        }
    }
    (merged, count)
}

fn min_moves_to_make_palindrome(s: String) -> i64 {
    let (_, moves) = sort_count(targets(s));
    moves
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a shuffled palindrome of n letters from the first `letters` of the
// alphabet: a random half, its mirror, and a middle letter when n is odd
fn random_word(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut chars: Vec[char] = Vec.new();
    for _ in 0..(n / 2) {
        let c = char.try_from((97 + next_random(mut seed) % letters) as u32).unwrap();
        chars.push(c);
        chars.push(c);
    }
    if n % 2 == 1 {
        chars.push(char.try_from((97 + next_random(mut seed) % letters) as u32).unwrap());
    }
    for i in (1..chars.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        chars.swap(i, j);
    }
    chars.iter().collect()
}

fn show(s: String) {
    println(f"{s} -> {min_moves_to_make_palindrome(s)}");
}

fn main() {
    // LeetCode's two examples, then six more: one letter, a palindrome
    // already, the middle letter at the front, a palindrome twice over, a
    // pair crossed, and pairs in the wrong halves
    show("aabb");
    show("letelt");
    show("z");
    show("racecar");
    show("xaa");
    show("abcdcbaabcdcba");
    show("abab");
    show("bbaaddcc");
    // 3000 random words of 1 to 40 letters, of 2, 5 and 26 letters in turn
    let mut seed = 2193;
    let mut total = 0;
    let mut check = 0;
    for round in 0..3000 {
        let n = next_random(mut seed) % 40 + 1;
        let letters = [2, 5, 26][round % 3];
        let s = random_word(n, letters, mut seed);
        let moves = min_moves_to_make_palindrome(s);
        total += moves;
        check = (check * 31 + moves + n) % 1000000007;
    }
    println(f"3000 words: {total} moves, checksum {check}");
    // the constraints' longest, 2000 letters: of 26, of 2, and a half
    // followed by itself
    let wide = random_word(2000, 26, mut seed);
    let narrow = random_word(2000, 2, mut seed);
    let half = random_word(1000, 26, mut seed);
    let doubled = f"{half}{half}";
    println(f"2000 letters: {min_moves_to_make_palindrome(wide)} {min_moves_to_make_palindrome(narrow)} {min_moves_to_make_palindrome(doubled)}");
}
