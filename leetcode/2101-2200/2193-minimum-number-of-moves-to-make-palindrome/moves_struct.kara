// LeetCode #2193: Minimum Number of Moves to Make Palindrome -- each
// letter given the place it takes in the palindrome (the k-th of a
// letter from the left paired with its k-th from the right, the pairs
// laid outward in the order their left ends come, a lone letter in the
// middle), and the moves counted as the inversions of those places by a
// `struct Fenwick`, which `add`s a place (`mut ref self`) and counts the
// places `below` one (`ref self`). O(n log n).

struct Fenwick {
    tree: Vec[i64],
}

impl Fenwick {
    fn new(n: i64) -> Fenwick {
        Fenwick { tree: Vec.filled(n + 1, 0) }
    }

    fn add(mut ref self, place: i64) {
        let mut i = place + 1;
        while i < self.tree.len() {
            self.tree[i] += 1;
            i += i & -i;
        }
    }

    fn below(ref self, place: i64) -> i64 {
        let mut i = place;
        let mut count = 0;
        while i > 0 {
            count += self.tree[i];
            i -= i & -i;
        }
        count
    }
}

fn targets(s: String) -> Vec[i64] {
    let b: Vec[u8] = s.bytes().to_vec();
    let n = b.len();
    let mut at: Vec[Vec[i64]] = Vec.filled(26, Vec.new());
    for i in 0..n {
        at[b[i] - 97].push(i);
    }
    let mut hi: Vec[i64] = at.iter().map(|v| v.len() - 1).collect();
    let mut target: Vec[i64] = Vec.filled(n, -1);
    let mut next = 0;
    for i in 0..n {
        if target[i] >= 0 {
            continue;
        }
        let c = b[i] - 97;
        let j = at[c][hi[c]];
        hi[c] -= 1;
        if j == i {
            target[i] = n / 2;
        } else {
            target[i] = next;
            target[j] = n - 1 - next;
            next += 1;
        }
    }
    target
}

fn min_moves_to_make_palindrome(s: String) -> i64 {
    let target = targets(s);
    let n = target.len();
    let mut seen = Fenwick.new(n);
    let mut moves = 0;
    for i in 0..n {
        moves += i - seen.below(target[i] + 1);
        seen.add(target[i]);
    }
    moves
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a shuffled palindrome of n letters from the first `letters` of the
// alphabet: a random half, its mirror, and a middle letter when n is odd
fn random_word(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut chars: Vec[char] = Vec.new();
    for _ in 0..(n / 2) {
        let c = char.try_from((97 + next_random(mut seed) % letters) as u32).unwrap();
        chars.push(c);
        chars.push(c);
    }
    if n % 2 == 1 {
        chars.push(char.try_from((97 + next_random(mut seed) % letters) as u32).unwrap());
    }
    for i in (1..chars.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        chars.swap(i, j);
    }
    chars.iter().collect()
}

fn show(s: String) {
    println(f"{s} -> {min_moves_to_make_palindrome(s)}");
}

fn main() {
    // LeetCode's two examples, then six more: one letter, a palindrome
    // already, the middle letter at the front, a palindrome twice over, a
    // pair crossed, and pairs in the wrong halves
    show("aabb");
    show("letelt");
    show("z");
    show("racecar");
    show("xaa");
    show("abcdcbaabcdcba");
    show("abab");
    show("bbaaddcc");
    // 3000 random words of 1 to 40 letters, of 2, 5 and 26 letters in turn
    let mut seed = 2193;
    let mut total = 0;
    let mut check = 0;
    for round in 0..3000 {
        let n = next_random(mut seed) % 40 + 1;
        let letters = [2, 5, 26][round % 3];
        let s = random_word(n, letters, mut seed);
        let moves = min_moves_to_make_palindrome(s);
        total += moves;
        check = (check * 31 + moves + n) % 1000000007;
    }
    println(f"3000 words: {total} moves, checksum {check}");
    // the constraints' longest, 2000 letters: of 26, of 2, and a half
    // followed by itself
    let wide = random_word(2000, 26, mut seed);
    let narrow = random_word(2000, 2, mut seed);
    let half = random_word(1000, 26, mut seed);
    let doubled = f"{half}{half}";
    println(f"2000 letters: {min_moves_to_make_palindrome(wide)} {min_moves_to_make_palindrome(narrow)} {min_moves_to_make_palindrome(doubled)}");
}
