// LeetCode #2184: Number of Ways to Build Sturdy Brick Wall -- the
// benchmark's Kāra arm: the ★ arm, rows by recursion and the pairs that
// fit listed once.

fn fill(at: i64, joints: i64, width: i64, bricks: Vec[i64], rows: mut ref Vec[i64]) {
    if at == width {
        rows.push(joints);
        return;
    }
    for b in bricks.iter() {
        let end = at + b;
        if end < width {
            fill(end, joints | (1 << end), width, bricks, mut rows);
        } else if end == width {
            fill(end, joints, width, bricks, mut rows);
        }
    }
}

fn build_wall(height: i64, width: i64, bricks: Vec[i64]) -> i64 {
    let mut rows: Vec[i64] = Vec.new();
    fill(0, 0, width, bricks, mut rows);
    let n = rows.len();
    let mut fits: Vec[Vec[i64]] = Vec.new();
    for a in 0..n {
        let mut on: Vec[i64] = Vec.new();
        for b in 0..n {
            if rows[a] & rows[b] == 0 {
                on.push(b);
            }
        }
        fits.push(on);
    }
    let mut ways: Vec[i64] = Vec.filled(n, 1);
    for _ in 1..height {
        let mut next: Vec[i64] = Vec.filled(n, 0);
        for a in 0..n {
            for b in fits[a].iter() {
                next[b] = (next[b] + ways[a]) % 1000000007;
            }
        }
        ways = next;
    }
    let mut total = 0;
    for w in ways.iter() {
        total = (total + w) % 1000000007;
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2184;
    let mut check = 0;
    for _ in 0..1000 {
        let height = next_random(mut seed) % 51 + 50;
        let mut bricks: Vec[i64] = [1].to_vec();
        for b in 2..11 {
            if next_random(mut seed) % 2 == 0 {
                bricks.push(b);
            }
        }
        check = (check * 31 + build_wall(height, 10, bricks)) % 1000000007;
    }
    println(f"1000 walls: checksum {check}");
}
