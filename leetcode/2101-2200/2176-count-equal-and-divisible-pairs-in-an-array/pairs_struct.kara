// LeetCode #2176: Count Equal and Divisible Pairs in an Array -- a
// `struct Tally` of the indices met so far for each number, in a `Map[i64,
// Vec[i64]]`, and k; each index `meets` (`mut ref self`) the earlier ones
// with its number, counting those it pairs with, and is then `recorded`.
// O(n^2).

struct Tally {
    met: Map[i64, Vec[i64]],
    k: i64,
}

impl Tally {
    fn of(k: i64) -> Tally {
        Tally { met: Map.new(), k }
    }

    fn pairs_with(ref self, x: i64, j: i64) -> i64 {
        match self.met.get(x) {
            Some(earlier) => earlier.iter().filter(|i| i * j % self.k == 0).count(),
            None => 0,
        }
    }

    fn meets(mut ref self, x: i64, j: i64) -> i64 {
        let pairs = self.pairs_with(x, j);
        self.met.entry(x).or_insert(Vec.new()).push(j);
        pairs
    }
}

fn count_pairs(nums: Vec[i64], k: i64) -> i64 {
    let mut tally = Tally.of(k);
    let mut pairs = 0;
    for (j, x) in nums.iter().enumerate() {
        pairs += tally.meets(x, j);
    }
    pairs
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64], k: i64) {
    println(f"{nums}, {k} -> {count_pairs(nums, k)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number, two equal
    // numbers that need index 0, equal numbers at indices whose product
    // misses k, and every pair divisible
    show([3, 1, 2, 2, 2, 1, 3], 2);
    show([1, 2, 3, 4], 1);
    show([5], 3);
    show([4, 4], 7);
    show([7, 9, 9, 7, 9], 5);
    show([6, 6, 6, 6, 6], 1);
    // 2000 random lists of 1 to 30 numbers of 1 to 3 or 1 to 10 in turn,
    // with a k of 1 to 12
    let mut seed = 2176;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 30 + 1;
        let k = next_random(mut seed) % 12 + 1;
        let top = [3, 10][round % 2];
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let pairs = count_pairs(nums, k);
        total += pairs;
        check = (check * 31 + pairs + k) % 1000000007;
    }
    println(f"2000 lists: {total} in all, checksum {check}");
    // the constraints' largest, 100 numbers: all one number with k 1 and
    // 100, and at random from 1 to 4 with k 6
    let same: Vec[i64] = Vec.filled(100, 1);
    let mixed: Vec[i64] = (0..100).map(|_| next_random(mut seed) % 4 + 1).collect();
    println(f"100 numbers: {count_pairs(same, 1)} {count_pairs(same, 100)} {count_pairs(mixed, 6)}");
}
