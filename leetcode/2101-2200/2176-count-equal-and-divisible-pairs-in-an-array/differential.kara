// LeetCode #2176: Count Equal and Divisible Pairs in an Array -- the
// differential. The six arms, against the statement read literally: every
// ordered pair of different indices with equal numbers whose product is
// a multiple of k, counted, and halved, since each pair is met twice. 300
// random lists of 1 to 12 numbers of 1 to 2, 1 to 4 or 1 to 20 in turn,
// with a k of 1 to 12; then 30 of one number throughout; then 30 with k
// a prime above the length; every one drawn before any arm answers.
//
// P1  the count is the statement read literally
// P2  every number 7 more: the same count
// P3  every number x made 3x + 1: the same count
// P4  a number not in the list put at its end: the same count
// P5  the count at most the pairs of equal numbers, and at least the
//     equal numbers' pairs with index 0
// P6  each arm agrees with at least three of the other five

// ---- pairs.kara: the ★ arm, every pair of indices
fn star_count_pairs(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut pairs = 0;
    for i in 0..n {
        for j in (i + 1)..n {
            if nums[i] == nums[j] and i * j % k == 0 {
                pairs += 1;
            }
        }
    }
    pairs
}

// ---- pairs_grouped.kara: the indices grouped by number in a `SortedMap`
fn grouped_count_pairs(nums: Vec[i64], k: i64) -> i64 {
    let mut groups: SortedMap[i64, Vec[i64]] = SortedMap.new();
    for (i, x) in nums.iter().enumerate() {
        groups.entry(x).or_insert(Vec.new()).push(i);
    }
    let mut pairs = 0;
    for (_, indices) in groups.iter() {
        for a in 0..indices.len() {
            for b in (a + 1)..indices.len() {
                if indices[a] * indices[b] % k == 0 {
                    pairs += 1;
                }
            }
        }
    }
    pairs
}

// ---- pairs_gcd.kara: earlier indices counted by the divisor they are multiples of
fn gcd_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd_gcd(b, a % b) }
}

fn gcd_count_pairs(nums: Vec[i64], k: i64) -> i64 {
    let divisors: Vec[i64] = (1..(k + 1)).filter(|d| k % d == 0).collect();
    let mut seen: Map[(i64, i64), i64] = Map.new();
    let mut pairs = 0;
    for (j, x) in nums.iter().enumerate() {
        let need = k / gcd_gcd(j, k);
        pairs += seen.get((x, need)).unwrap_or(0);
        for d in divisors.iter() {
            if j % d == 0 {
                *seen.entry((x, d)).or_insert(0) += 1;
            }
        }
    }
    pairs
}

// ---- pairs_struct.kara: a `Tally` of the indices met for each number
struct Tally {
    met: Map[i64, Vec[i64]],
    k: i64,
}

impl Tally {
    fn of(k: i64) -> Tally {
        Tally { met: Map.new(), k }
    }

    fn pairs_with(ref self, x: i64, j: i64) -> i64 {
        match self.met.get(x) {
            Some(earlier) => earlier.iter().filter(|i| i * j % self.k == 0).count(),
            None => 0,
        }
    }

    fn meets(mut ref self, x: i64, j: i64) -> i64 {
        let pairs = self.pairs_with(x, j);
        self.met.entry(x).or_insert(Vec.new()).push(j);
        pairs
    }
}

fn struct_count_pairs(nums: Vec[i64], k: i64) -> i64 {
    let mut tally = Tally.of(k);
    let mut pairs = 0;
    for (j, x) in nums.iter().enumerate() {
        pairs += tally.meets(x, j);
    }
    pairs
}

// ---- pairs_iter.kara: `filter`, `count`, `map` and `sum`
fn iter_count_pairs(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    (0..n).map(|i| ((i + 1)..n).filter(|j| nums[i] == nums[j] and i * j % k == 0).count()).sum()
}

// ---- pairs_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn count_pairs(nums: Vec[i32], k: i32) -> i32 {
        let n = nums.len();
        let mut count = 0;
        for i in 0..n {
            for j in i + 1..n {
                if nums[i] == nums[j] and (i * j) % k == 0 {
                    count += 1;
                }
            }
        }
        count
    }
}

struct Solution {}

fn solution_count_pairs(nums: Vec[i64], k: i64) -> i64 {
    Solution.count_pairs(nums.iter().map(|x| x as i32).collect(), k as i32)
}


// ---- the statement read literally

fn literal(nums: Vec[i64], k: i64) -> i64 {
    let mut twice = 0;
    for i in 0..nums.len() {
        for j in 0..nums.len() {
            if i != j and nums[i] == nums[j] and (i * j) % k == 0 {
                twice += 1;
            }
        }
    }
    twice / 2
}

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_count_pairs(nums, k),
        1 => grouped_count_pairs(nums, k),
        2 => gcd_count_pairs(nums, k),
        3 => struct_count_pairs(nums, k),
        4 => iter_count_pairs(nums, k),
        _ => solution_count_pairs(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "grouped", "gcd", "struct", "iter", "solution"];
    let mut seed = 2176;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..360 {
        let n = next_random(mut seed) % 12 + 1;
        let k = if t < 330 { next_random(mut seed) % 12 + 1 } else { [13, 17, 19][t % 3] };
        let top = if t < 300 { [2, 4, 20][t % 3] } else if t < 330 { 1 } else { 3 };
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        cases.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (nums, k) in cases.iter() {
        let truth = literal(nums, k);
        check = (check * 31 + truth + k) % 1000000007;
        let shifted: Vec[i64] = nums.iter().map(|x| x + 7).collect();
        let renamed: Vec[i64] = nums.iter().map(|x| 3 * x + 1).collect();
        let mut longer = nums.clone();
        longer.push(1000);
        let mut equal = 0;
        let mut with_first = 0;
        for i in 0..nums.len() {
            for j in (i + 1)..nums.len() {
                if nums[i] == nums[j] {
                    equal += 1;
                    if i == 0 {
                        with_first += 1;
                    }
                }
            }
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, shifted, k) == x,
                answer(arm, renamed, k) == x,
                answer(arm, longer, k) == x,
                with_first <= x and x <= equal,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums}, {k} arm {names[arm]}: P{q + 1} fails, answered {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} lists: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
