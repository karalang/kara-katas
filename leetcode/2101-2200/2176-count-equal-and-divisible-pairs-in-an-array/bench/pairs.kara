// LeetCode #2176: Count Equal and Divisible Pairs in an Array -- the
// benchmark's ★ arm: every pair of indices of a window of 100 numbers.

fn count_pairs(nums: Slice[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut pairs = 0;
    for i in 0..n {
        for j in (i + 1)..n {
            if nums[i] == nums[j] and i * j % k == 0 {
                pairs += 1;
            }
        }
    }
    pairs
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2176;
    let mut row: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        row.push(next_random(mut seed) % 5 + 1);
    }
    let mut check = 0;
    for _ in 0..20000 {
        let start = next_random(mut seed) % 99901;
        let k = next_random(mut seed) % 100 + 1;
        let pairs = count_pairs(row[start..(start + 100)], k);
        check = (check * 31 + pairs) % 1000000007;
    }
    println(f"20000 solves: checksum {check}");
}
