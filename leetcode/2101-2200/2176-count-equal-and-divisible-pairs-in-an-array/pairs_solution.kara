// LeetCode #2176: Count Equal and Divisible Pairs in an Array -- LeetCode's
// Rust template: two index loops over `nums.len()`, `(i * j) % k as
// usize == 0`, `nums: Vec<i32>`, `k: i32`, written as Rust. Carried by
// `karac fix`. The adapter below hands the harness's list to it.

impl Solution {
    pub fn count_pairs(nums: Vec[i32], k: i32) -> i32 {
        let n = nums.len();
        let mut count = 0;
        for i in 0..n {
            for j in i + 1..n {
                if nums[i] == nums[j] and (i * j) % k == 0 {
                    count += 1;
                }
            }
        }
        count
    }
}

struct Solution {}

fn count_pairs(nums: Vec[i64], k: i64) -> i64 {
    Solution.count_pairs(nums.iter().map(|x| x as i32).collect(), k as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64], k: i64) {
    println(f"{nums}, {k} -> {count_pairs(nums, k)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number, two equal
    // numbers that need index 0, equal numbers at indices whose product
    // misses k, and every pair divisible
    show([3, 1, 2, 2, 2, 1, 3], 2);
    show([1, 2, 3, 4], 1);
    show([5], 3);
    show([4, 4], 7);
    show([7, 9, 9, 7, 9], 5);
    show([6, 6, 6, 6, 6], 1);
    // 2000 random lists of 1 to 30 numbers of 1 to 3 or 1 to 10 in turn,
    // with a k of 1 to 12
    let mut seed = 2176;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 30 + 1;
        let k = next_random(mut seed) % 12 + 1;
        let top = [3, 10][round % 2];
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let pairs = count_pairs(nums, k);
        total += pairs;
        check = (check * 31 + pairs + k) % 1000000007;
    }
    println(f"2000 lists: {total} in all, checksum {check}");
    // the constraints' largest, 100 numbers: all one number with k 1 and
    // 100, and at random from 1 to 4 with k 6
    let same: Vec[i64] = Vec.filled(100, 1);
    let mixed: Vec[i64] = (0..100).map(|_| next_random(mut seed) % 4 + 1).collect();
    println(f"100 numbers: {count_pairs(same, 1)} {count_pairs(same, 100)} {count_pairs(mixed, 6)}");
}
