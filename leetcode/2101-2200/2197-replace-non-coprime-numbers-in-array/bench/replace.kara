// benchmark copy of replace.kara (LeetCode #2197, the ★ arm): a stack
// merged at its top. See ../README.md § Benchmarks.

fn gcd(a: i64, b: i64) -> i64 {
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let r = x % y;
        x = y;
        y = r;
    }
    x
}

fn replace_non_coprimes(nums: Vec[i64]) -> Vec[i64] {
    let mut stack: Vec[i64] = Vec.new();
    for x in nums.iter() {
        let mut cur = x;
        while let Some(top) = stack.last() {
            let g = gcd(top, cur);
            if g == 1 {
                break;
            }
            cur = top / g * cur;
            stack.pop();
        }
        stack.push(cur);
    }
    stack
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn divisors(m: i64) -> Vec[i64] {
    (1..100001).filter(|d| m % d == 0).collect()
}

fn main() {
    // 12 arrays of 10^5 numbers, drawn in turn from the divisors of
    // 2^4 3^3 5^2 7 11 13, of 2^6 3^4 17 19, and from 1 and six primes
    // near 10^5
    let pools = [
        divisors(10810800),
        divisors(1674432),
        [1, 99991, 99989, 99971, 99961, 99929, 99923].to_vec(),
    ];
    let mut seed = 2197;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for a in 0..12 {
        let pool = ref pools[a % 3];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            nums.push(pool[wide_random(mut seed) % pool.len()]);
        }
        arrays.push(nums);
    }
    let mut check = 0;
    for _ in 0..100 {
        for nums in arrays.iter() {
            let out = replace_non_coprimes(nums);
            check = (check * 31 + out.len()) % 1000000007;
            check = (check * 31 + out[out.len() / 2]) % 1000000007;
        }
    }
    println(f"100 passes over 12 arrays: checksum {check}");
}
