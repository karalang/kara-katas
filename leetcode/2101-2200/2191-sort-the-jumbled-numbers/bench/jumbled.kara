// benchmark copy of jumbled.kara (LeetCode #2191, the ★ arm): (value,
// place) pairs sorted. See ../README.md § Benchmarks.

fn mapped(mapping: Vec[i64], n: i64) -> i64 {
    if n == 0 {
        return mapping[0];
    }
    let mut rest = n;
    let mut value = 0;
    let mut place = 1;
    while rest > 0 {
        value += mapping[rest % 10] * place;
        place *= 10;
        rest /= 10;
    }
    value
}

fn sort_jumbled(mapping: Vec[i64], nums: Vec[i64]) -> Vec[i64] {
    let mut keyed: Vec[(i64, i64)] = Vec.new();
    for i in 0..nums.len() {
        keyed.push((mapped(mapping, nums[i]), i));
    }
    keyed.sort();
    let mut sorted: Vec[i64] = Vec.new();
    for (_, i) in keyed {
        sorted.push(nums[i]);
    }
    sorted
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn big_random(seed: mut ref i64) -> i64 {
    let a = next_random(mut seed);
    let b = next_random(mut seed);
    a * 32768 + b
}

fn main() {
    let mut seed = 2191;
    let row: Vec[i64] = (0..1000000).map(|_| big_random(mut seed) % 1000000000).collect();
    let mut check = 0;
    for _ in 0..200 {
        let mut mapping: Vec[i64] = (0..10).collect();
        for i in (1..10).rev() {
            let j = next_random(mut seed) % (i + 1);
            mapping.swap(i, j);
        }
        let start = big_random(mut seed) % 970001;
        let sorted = sort_jumbled(mapping, row[start..(start + 30000)].to_vec());
        for x in sorted.iter() {
            check = (check * 31 + x % 1000003) % 1000000007;
        }
    }
    println(f"200 solves: checksum {check}");
}
