// LeetCode #2117: Abbreviating the Product of a Range -- the fold arm.
// Each number is split by a helper into its 2s, its 5s and what is left;
// one `fold` over `left..=right` then carries the ★ arm's state as a
// tuple, and a second over the unpaired factors puts them back.

fn split(i: i64) -> (i64, i64, i64) {
    let mut x = i;
    let mut twos = 0;
    let mut fives = 0;
    while x % 2 == 0 {
        x /= 2;
        twos += 1;
    }
    while x % 5 == 0 {
        x /= 5;
        fives += 1;
    }
    (twos, fives, x)
}

fn times(state: (i64, i64), x: i64) -> (i64, i64) {
    let cap = 100000000000;
    let (last, exact) = state;
    (last * x % 100000, if exact > cap / x { cap } else { exact * x })
}

fn abbreviate_product(left: i64, right: i64) -> String {
    let (twos, fives, state, lead) = (left..=right).fold((0, 0, (1, 1), 1.0), |(t, f, s, l), i| {
        let (dt, df, x) = split(i);
        let mut l = l * i as f64;
        while l >= 1e12 {
            l /= 10.0;
        }
        (t + dt, f + df, times(s, x), l)
    });
    let zeros = twos.min(fives);
    let unpaired: Vec[i64] = (zeros..twos).map(|_| 2).chain((zeros..fives).map(|_| 5)).collect();
    let (last, exact) = unpaired.iter().fold(state, |s, p| times(s, p));
    if exact < 10000000000 {
        return f"{exact}e{zeros}";
    }
    let mut lead = lead;
    while lead >= 1e5 {
        lead /= 10.0;
    }
    f"{lead as i64}...{last:05}e{zeros}"
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then five more: one number, ten alone,
    // the constraints' last two, a product of exactly ten digits after
    // its zeros, and one of eleven
    let examples = [(1, 4), (2, 11), (371, 375), (1, 1), (10, 10), (9999, 10000), (1, 15), (1, 16)];
    for (left, right) in examples.iter() {
        println(f"[{left}, {right}] -> {abbreviate_product(left, right)}");
    }
    // 1000 random ranges: `left` from 1 to 10000, and up to 60 numbers
    let mut seed = 2117;
    let mut zeros = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let left = next_random(mut seed) % 10000 + 1;
        let right = (left + next_random(mut seed) % 61).min(10000);
        let got = abbreviate_product(left, right);
        for b in got.bytes().iter() {
            check = (check * 31 + b as i64) % 1000000007;
        }
        zeros += i64.parse(got.split("e").last().unwrap()).unwrap();
    }
    println(f"1000 ranges: {zeros} trailing zeros, checksum {check}");
    // long ranges: the first 3000 numbers and the last 1000
    println(f"[1, 3000] -> {abbreviate_product(1, 3000)}");
    println(f"[9001, 10000] -> {abbreviate_product(9001, 10000)}");
}
