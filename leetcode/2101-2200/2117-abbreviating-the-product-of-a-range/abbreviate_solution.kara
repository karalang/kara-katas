// LeetCode #2117: Abbreviating the Product of a Range -- LeetCode's Rust
// template (`i32, i32` to `String`): the ★ arm's factors of 2 and 5
// pulled out, with `u64` state and `format!`, written as Rust. Carried by
// `karac fix`. The adapter below hands the harness's ranges to it.

impl Solution {
    pub fn abbreviate_product(left: i32, right: i32) -> String {
        const CAP: u64 = 100_000_000_000;
        let mut (twos, fives) = (0, 0);
        let mut (last, exact) = (1u64, 1u64);
        let mut lead = 1.0;
        for i in left..=right {
            let mut x = i as u64;
            while x % 2 == 0 {
                x /= 2;
                twos += 1;
            }
            while x % 5 == 0 {
                x /= 5;
                fives += 1;
            }
            last = last * x % 100_000;
            exact = (exact * x).min(CAP);
            lead *= i as f64;
            while lead >= 1e12 {
                lead /= 10.0;
            }
        }
        let zeros = twos.min(fives);
        for _ in zeros..twos {
            last = last * 2 % 100_000;
            exact = (exact * 2).min(CAP);
        }
        for _ in zeros..fives {
            last = last * 5 % 100_000;
            exact = (exact * 5).min(CAP);
        }
        if exact < 10_000_000_000 {
            return f"{exact}e{zeros}";
        }
        while lead >= 1e5 {
            lead /= 10.0;
        }
        f"{lead as u64}...{last:05}e{zeros}"
    }
}

struct Solution {}

fn abbreviate_product(left: i64, right: i64) -> String {
    Solution.abbreviate_product(left as i32, right as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then five more: one number, ten alone,
    // the constraints' last two, a product of exactly ten digits after
    // its zeros, and one of eleven
    let examples = [(1, 4), (2, 11), (371, 375), (1, 1), (10, 10), (9999, 10000), (1, 15), (1, 16)];
    for (left, right) in examples.iter() {
        println(f"[{left}, {right}] -> {abbreviate_product(left, right)}");
    }
    // 1000 random ranges: `left` from 1 to 10000, and up to 60 numbers
    let mut seed = 2117;
    let mut zeros = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let left = next_random(mut seed) % 10000 + 1;
        let right = (left + next_random(mut seed) % 61).min(10000);
        let got = abbreviate_product(left, right);
        for b in got.bytes().iter() {
            check = (check * 31 + b as i64) % 1000000007;
        }
        zeros += i64.parse(got.split("e").last().unwrap()).unwrap();
    }
    println(f"1000 ranges: {zeros} trailing zeros, checksum {check}");
    // long ranges: the first 3000 numbers and the last 1000
    println(f"[1, 3000] -> {abbreviate_product(1, 3000)}");
    println(f"[9001, 10000] -> {abbreviate_product(9001, 10000)}");
}
