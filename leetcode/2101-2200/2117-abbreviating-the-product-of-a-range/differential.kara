// LeetCode #2117: Abbreviating the Product of a Range -- the
// differential. The six arms, against the statement read literally: the
// product worked out one decimal digit at a time, its trailing zeros
// counted off, and the answer cut from what is left. 300 random ranges
// with `left` from 1 to 9999 and up to 40 numbers; then 30 starting at
// 1 to 30 with up to 30 numbers, where short answers live; then 30 that
// end at 9999, every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer is well formed: digits, `e` and the zero count; ten
//     digits at most, or five, `...` and five; never a zero last before `e`
// P3  one more number: a short answer times it, with its zeros moved to
//     the count, is the next answer whenever that is short too
// P4  the zero count never falls when a range takes one more number at
//     either end
// P5  one more number with no factor 2 or 5: when both answers are long,
//     the last five digits are multiplied by it and the zeros stay
// P6  each arm agrees with at least three of the other five

// ---- abbreviate.kara: the ★ arm, the factors of 2 and 5 pulled out
fn star_abbreviate_product(left: i64, right: i64) -> String {
    let cap = 100000000000;
    let mut twos = 0;
    let mut fives = 0;
    let mut last = 1;
    let mut exact = 1;
    let mut lead = 1.0;
    for i in left..=right {
        let mut x = i;
        while x % 2 == 0 {
            x /= 2;
            twos += 1;
        }
        while x % 5 == 0 {
            x /= 5;
            fives += 1;
        }
        last = last * x % 100000;
        exact = if exact > cap / x { cap } else { exact * x };
        lead *= i as f64;
        while lead >= 1e12 {
            lead /= 10.0;
        }
    }
    let zeros = twos.min(fives);
    for _ in 0..twos - zeros {
        last = last * 2 % 100000;
        exact = if exact > cap / 2 { cap } else { exact * 2 };
    }
    for _ in 0..fives - zeros {
        last = last * 5 % 100000;
        exact = if exact > cap / 5 { cap } else { exact * 5 };
    }
    if exact < 10000000000 {
        return f"{exact}e{zeros}";
    }
    while lead >= 1e5 {
        lead /= 10.0;
    }
    f"{lead as i64}...{last:05}e{zeros}"
}

// ---- abbreviate_limbs.kara: the product exactly, in base 10000
fn limbs_abbreviate_product(left: i64, right: i64) -> String {
    let base = 10000;
    let mut limbs: Vec[i64] = [1].to_vec();
    for i in left..=right {
        let mut carry = 0;
        for k in 0..limbs.len() {
            let v = limbs[k] * i + carry;
            limbs[k] = v % base;
            carry = v / base;
        }
        while carry > 0 {
            limbs.push(carry % base);
            carry /= base;
        }
    }
    let mut digits: String = f"{limbs[limbs.len() - 1]}";
    for k in (0..limbs.len() - 1).rev() {
        digits.push_str(f"{limbs[k]:04}");
    }
    let mut kept: Str = digits.as_str();
    while let Some(rest) = kept.strip_suffix("0") {
        kept = rest;
    }
    let zeros = digits.len() - kept.len();
    if kept.len() <= 10 {
        return f"{kept}e{zeros}";
    }
    f"{kept[..5]}...{kept[kept.len() - 5..]}e{zeros}"
}

// ---- abbreviate_legendre.kara: 2s and 5s counted per power, `log10` for the lead
fn legendre_count(left: i64, right: i64, p: i64) -> i64 {
    let mut total = 0;
    let mut power = p;
    while power <= right {
        total += right / power - (left - 1) / power;
        power *= p;
    }
    total
}

fn legendre_power_mod(base: i64, exp: i64, m: i64) -> i64 {
    let mut result = 1;
    let mut b = base % m;
    let mut e = exp;
    while e > 0 {
        if e % 2 == 1 {
            result = result * b % m;
        }
        b = b * b % m;
        e /= 2;
    }
    result
}

fn legendre_abbreviate_product(left: i64, right: i64) -> String {
    let cap = 100000000000;
    let twos = legendre_count(left, right, 2);
    let fives = legendre_count(left, right, 5);
    let zeros = twos.min(fives);
    let mut last = 1;
    let mut exact = 1;
    let mut logs = 0.0;
    for i in left..=right {
        let mut x = i;
        while x % 2 == 0 {
            x /= 2;
        }
        while x % 5 == 0 {
            x /= 5;
        }
        last = last * x % 100000;
        exact = if exact > cap / x { cap } else { exact * x };
        logs += (i as f64).log10();
    }
    let (p, extra) = if twos > zeros { (2, twos - zeros) } else { (5, fives - zeros) };
    last = last * legendre_power_mod(p, extra, 100000) % 100000;
    for _ in 0..extra {
        if exact < cap {
            exact = if exact > cap / p { cap } else { exact * p };
        }
    }
    if exact < 10000000000 {
        return f"{exact}e{zeros}";
    }
    let first = 10.0.pow(logs - logs.floor() + 4.0) as i64;
    f"{first}...{last:05}e{zeros}"
}

// ---- abbreviate_struct.kara: a `Product`
struct StructProduct {
    twos: i64,
    fives: i64,
    last: i64,
    exact: i64,
    lead: f64,
}

impl StructProduct {
    fn new() -> StructProduct {
        StructProduct { twos: 0, fives: 0, last: 1, exact: 1, lead: 1.0 }
    }

    fn mul(mut ref self, x: i64) {
        let cap = 100000000000;
        self.last = self.last * x % 100000;
        self.exact = if self.exact > cap / x { cap } else { self.exact * x };
    }

    fn times(mut ref self, i: i64) {
        let mut x = i;
        while x % 2 == 0 {
            x /= 2;
            self.twos += 1;
        }
        while x % 5 == 0 {
            x /= 5;
            self.fives += 1;
        }
        self.mul(x);
        self.lead *= i as f64;
        while self.lead >= 1e12 {
            self.lead /= 10.0;
        }
    }

    fn abbreviated(mut ref self) -> String {
        let zeros = self.twos.min(self.fives);
        for _ in zeros..self.twos {
            self.mul(2);
        }
        for _ in zeros..self.fives {
            self.mul(5);
        }
        if self.exact < 10000000000 {
            return f"{self.exact}e{zeros}";
        }
        let mut lead = self.lead;
        while lead >= 1e5 {
            lead /= 10.0;
        }
        f"{lead as i64}...{self.last:05}e{zeros}"
    }
}

fn struct_abbreviate_product(left: i64, right: i64) -> String {
    let mut product = StructProduct.new();
    for i in left..=right {
        product.times(i);
    }
    product.abbreviated()
}

// ---- abbreviate_fold.kara: a `fold` with a tuple
fn fold_split(i: i64) -> (i64, i64, i64) {
    let mut x = i;
    let mut twos = 0;
    let mut fives = 0;
    while x % 2 == 0 {
        x /= 2;
        twos += 1;
    }
    while x % 5 == 0 {
        x /= 5;
        fives += 1;
    }
    (twos, fives, x)
}

fn fold_times(state: (i64, i64), x: i64) -> (i64, i64) {
    let cap = 100000000000;
    let (last, exact) = state;
    (last * x % 100000, if exact > cap / x { cap } else { exact * x })
}

fn fold_abbreviate_product(left: i64, right: i64) -> String {
    let (twos, fives, state, lead) = (left..=right).fold((0, 0, (1, 1), 1.0), |(t, f, s, l), i| {
        let (dt, df, x) = fold_split(i);
        let mut l = l * i as f64;
        while l >= 1e12 {
            l /= 10.0;
        }
        (t + dt, f + df, fold_times(s, x), l)
    });
    let zeros = twos.min(fives);
    let unpaired: Vec[i64] = (zeros..twos).map(|_| 2).chain((zeros..fives).map(|_| 5)).collect();
    let (last, exact) = unpaired.iter().fold(state, |s, p| fold_times(s, p));
    if exact < 10000000000 {
        return f"{exact}e{zeros}";
    }
    let mut lead = lead;
    while lead >= 1e5 {
        lead /= 10.0;
    }
    f"{lead as i64}...{last:05}e{zeros}"
}

// ---- abbreviate_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn abbreviate_product(left: i32, right: i32) -> String {
        const CAP: u64 = 100_000_000_000;
        let mut (twos, fives) = (0, 0);
        let mut (last, exact) = (1u64, 1u64);
        let mut lead = 1.0;
        for i in left..=right {
            let mut x = i as u64;
            while x % 2 == 0 {
                x /= 2;
                twos += 1;
            }
            while x % 5 == 0 {
                x /= 5;
                fives += 1;
            }
            last = last * x % 100_000;
            exact = (exact * x).min(CAP);
            lead *= i as f64;
            while lead >= 1e12 {
                lead /= 10.0;
            }
        }
        let zeros = twos.min(fives);
        for _ in zeros..twos {
            last = last * 2 % 100_000;
            exact = (exact * 2).min(CAP);
        }
        for _ in zeros..fives {
            last = last * 5 % 100_000;
            exact = (exact * 5).min(CAP);
        }
        if exact < 10_000_000_000 {
            return f"{exact}e{zeros}";
        }
        while lead >= 1e5 {
            lead /= 10.0;
        }
        f"{lead as u64}...{last:05}e{zeros}"
    }
}

struct SolutionSolution {}

fn solution_abbreviate_product(left: i64, right: i64) -> String {
    SolutionSolution.abbreviate_product(left as i32, right as i32)
}

// ---- the statement read literally

fn literal(left: i64, right: i64) -> String {
    let mut digits: Vec[i64] = [1].to_vec();
    for i in left..=right {
        let mut carry = 0;
        for k in 0..digits.len() {
            let v = digits[k] * i + carry;
            digits[k] = v % 10;
            carry = v / 10;
        }
        while carry > 0 {
            digits.push(carry % 10);
            carry /= 10;
        }
    }
    let mut zeros = 0;
    while digits[zeros] == 0 {
        zeros += 1;
    }
    let mut text: String = "";
    for k in (zeros..digits.len()).rev() {
        text.push((b'0' + digits[k] as u8) as char);
    }
    if text.len() <= 10 {
        return f"{text}e{zeros}";
    }
    f"{text.slice(0, 5)}...{text.slice(text.len() - 5, text.len())}e{zeros}"
}

fn answer(arm: i64, left: i64, right: i64) -> String {
    match arm {
        0 => star_abbreviate_product(left, right),
        1 => limbs_abbreviate_product(left, right),
        2 => legendre_abbreviate_product(left, right),
        3 => struct_abbreviate_product(left, right),
        4 => fold_abbreviate_product(left, right),
        _ => solution_abbreviate_product(left, right),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The answer's parts: the digits before `e` (with `...` when long) and the
// zero count, or `None` when the text is not of that shape.
fn parts(text: String) -> Option[(String, i64)] {
    let pieces: Vec[Str] = text.split("e").collect();
    if pieces.len() != 2 {
        return None;
    }
    let zeros = i64.parse(pieces[1]).ok()?;
    Some((pieces[0].to_string(), zeros))
}

fn well_formed(text: String) -> bool {
    let Some((head, zeros)) = parts(text) else {
        return false;
    };
    if zeros < 0 or head.is_empty() or head.ends_with("0") or head.starts_with("0") {
        return false;
    }
    let digits = |s: Str| s.chars().all(|c| c.is_ascii_digit());
    let halves: Vec[Str] = head.split("...").collect();
    match halves.len() {
        1 => head.len() <= 10 and digits(head),
        2 => halves[0].len() == 5 and halves[1].len() == 5 and digits(halves[0]) and digits(halves[1]),
        _ => false,
    }
}

fn zeros_of(text: String) -> i64 {
    match parts(text) {
        Some((_, z)) => z,
        None => -1,
    }
}

fn main() {
    let names = ["star", "limbs", "legendre", "struct", "fold", "solution"];
    let mut seed = 2117;
    let mut problems: Vec[(i64, i64)] = Vec.new();
    for t in 0..360 {
        if t < 300 {
            let left = next_random(mut seed) % 9999 + 1;
            problems.push((left, (left + next_random(mut seed) % 40).min(9999)));
        } else if t < 330 {
            let left = next_random(mut seed) % 30 + 1;
            problems.push((left, left + next_random(mut seed) % 30));
        } else {
            problems.push((9999 - next_random(mut seed) % 40, 9999));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (left, right) in problems.iter() {
        let (left, right) = (left.min(right), right);
        let truth = literal(left, right);
        for b in truth.bytes().iter() {
            check = (check * 31 + b as i64) % 1000000007;
        }
        let next = right + 1;
        let got: Vec[String] = (0..6).map(|arm| answer(arm, left, right)).collect();
        for arm in 0..6 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let longer = answer(arm, left, next);
            let mut multiplied = true;
            if let (Some((head, zeros)), Some((head2, zeros2))) = (parts(x), parts(longer)) {
                if head.contains("...") and head2.contains("...") and next % 2 != 0 and next % 5 != 0 {
                    let last = i64.parse(head.slice(head.len() - 5, head.len())).unwrap_or(0);
                    let last2 = i64.parse(head2.slice(head2.len() - 5, head2.len())).unwrap_or(-1);
                    multiplied = last * next % 100000 == last2 and zeros == zeros2;
                }
            }
            let mut short_grown = true;
            if let (Some((head, zeros)), Some((head2, _))) = (parts(x), parts(longer)) {
                if not head.contains("...") and not head2.contains("...") {
                    let mut value = i64.parse(head).unwrap_or(0) * next;
                    let mut z = zeros;
                    while value % 10 == 0 {
                        value /= 10;
                        z += 1;
                    }
                    short_grown = f"{value}e{z}" == longer;
                }
            }
            let wider = if left > 1 { answer(arm, left - 1, right) } else { longer.clone() };
            let verdicts = [
                x == truth,
                well_formed(x),
                short_grown,
                zeros_of(longer) >= zeros_of(x) and zeros_of(wider) >= zeros_of(x),
                multiplied,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"[{left}, {right}] arm {names[arm]}: P{q + 1} fails, answered {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} ranges: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
