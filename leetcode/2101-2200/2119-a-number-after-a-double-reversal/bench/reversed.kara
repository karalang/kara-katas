// LeetCode #2119: A Number After a Double Reversal -- the benchmark. The
// ★ arm answers with one remainder, which leaves nothing to time, so the
// bench runs the arithmetic arm, the statement's own work: each number's
// digits reversed by `% 10` and `/ 10`, twice. 1000000 numbers up to
// 10^6, a third of them ending in zeros, built once; then 100 rounds over
// all of them, one number raised by one before each.

fn reverse(num: i64) -> i64 {
    let mut n = num;
    let mut out = 0;
    while n > 0 {
        out = out * 10 + n % 10;
        n /= 10;
    }
    out
}

fn is_same_after_reversals(num: i64) -> bool {
    reverse(reverse(num)) == num
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2119;
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..1000000 {
        let mut num = next_random(mut seed) % 1000001;
        if next_random(mut seed) % 3 == 0 {
            num = num / 1000 * 1000;
        }
        nums.push(num);
    }
    let mut same = 0;
    let mut check = 0;
    for round in 0..100 {
        nums[round * 7919 % 1000000] += 1;
        for num in nums.iter() {
            if is_same_after_reversals(num) {
                same += 1;
                check = (check * 31 + num % 1000) % 1000000007;
            }
        }
    }
    println(f"100000000 checks: {same} the same, checksum {check}");
}
