// LeetCode #2119: A Number After a Double Reversal -- the struct arm. A
// `Digits` holds a number's digits, the most significant first, with no
// leading zero; `reversed` turns them around and drops the zeros that
// come first, which is what reversing the number does. The double
// reversal returns `num` when the digits come back the same.

struct Digits {
    digits: Vec[i64],
}

impl Digits {
    fn of(num: i64) -> Digits {
        let mut digits: Vec[i64] = Vec.new();
        let mut n = num;
        while n > 0 {
            digits.push(n % 10);
            n /= 10;
        }
        digits.reverse();
        Digits { digits: digits }
    }

    fn reversed(self) -> Digits {
        let digits: Vec[i64] = self.digits.iter().rev().skip_while(|d| d == 0).collect();
        Digits { digits: digits }
    }
}

fn is_same_after_reversals(num: i64) -> bool {
    let digits = Digits.of(num);
    digits.reversed().reversed().digits == digits.digits
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then four more: one digit, a zero inside,
    // the constraints' largest, and one ending in many zeros
    let examples = [526, 1800, 0, 7, 101, 1000000, 120000];
    for num in examples.iter() {
        println(f"{num} -> {is_same_after_reversals(num)}");
    }
    // 5000 random numbers from 0 to 10^6, a third of them multiplied by a
    // power of ten so that some end in zeros
    let mut seed = 2119;
    let mut same = 0;
    let mut check = 0;
    for _ in 0..5000 {
        let mut num = next_random(mut seed) % 1000001;
        if next_random(mut seed) % 3 == 0 {
            num = num / 1000 * 10.pow((next_random(mut seed) % 4) as u32);
        }
        let got = is_same_after_reversals(num);
        if got {
            same += 1;
        }
        check = (check * 31 + if got { num % 1000 } else { 7 }) % 1000000007;
    }
    println(f"5000 numbers: {same} the same, checksum {check}");
}
