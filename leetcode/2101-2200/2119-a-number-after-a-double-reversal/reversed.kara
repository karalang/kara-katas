// LeetCode #2119: A Number After a Double Reversal -- the ★ arm, the
// last digit. Reversing drops the zeros a number ends with, since they
// become leading zeros, and drops nothing else; the second reversal
// puts every other digit back. So the double reversal returns `num`
// exactly when `num` ends in no zero, or is zero itself. O(1).

fn is_same_after_reversals(num: i64) -> bool {
    num == 0 or num % 10 != 0
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then four more: one digit, a zero inside,
    // the constraints' largest, and one ending in many zeros
    let examples = [526, 1800, 0, 7, 101, 1000000, 120000];
    for num in examples.iter() {
        println(f"{num} -> {is_same_after_reversals(num)}");
    }
    // 5000 random numbers from 0 to 10^6, a third of them multiplied by a
    // power of ten so that some end in zeros
    let mut seed = 2119;
    let mut same = 0;
    let mut check = 0;
    for _ in 0..5000 {
        let mut num = next_random(mut seed) % 1000001;
        if next_random(mut seed) % 3 == 0 {
            num = num / 1000 * 10.pow((next_random(mut seed) % 4) as u32);
        }
        let got = is_same_after_reversals(num);
        if got {
            same += 1;
        }
        check = (check * 31 + if got { num % 1000 } else { 7 }) % 1000000007;
    }
    println(f"5000 numbers: {same} the same, checksum {check}");
}
