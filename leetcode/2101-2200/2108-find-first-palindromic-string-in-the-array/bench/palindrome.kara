// LeetCode #2108: Find First Palindromic String in the Array -- the
// benchmark, palindrome.kara's ★ arm: each word's bytes read from both
// ends towards the middle. 200 lists of 100 words of 100 letters are
// built once, each word a palindrome with one letter of its inner half
// changed in all but one word in 200, so most checks walk to that
// letter; each list is then searched 50 times.

fn is_palindrome(w: String) -> bool {
    let b = w.bytes();
    let mut i = 0;
    let mut j = b.len() - 1;
    while i < j {
        if b[i] != b[j] {
            return false;
        }
        i += 1;
        j -= 1;
    }
    true
}

fn first_palindrome(words: Vec[String]) -> String {
    for w in words.iter() {
        if is_palindrome(w) {
            return w.clone();
        }
    }
    String.new()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut seed = 2108;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..200 {
        let mut words: Vec[String] = Vec.new();
        for _ in 0..100 {
            let mut letters: Vec[i64] = Vec.new();
            for _ in 0..50 {
                letters.push(next_random(mut seed) % 26);
            }
            for i in 0..50 {
                letters.push(letters[49 - i]);
            }
            if next_random(mut seed) % 200 != 0 {
                let at = 25 + next_random(mut seed) % 50;
                letters[at] = (letters[at] + 1 + next_random(mut seed) % 25) % 26;
            }
            words.push(String.from_iter(letters.iter().map(|l| alphabet[l])));
        }
        lists.push(words);
    }
    let mut found = 0;
    let mut letters_total = 0;
    let mut check = 0;
    for _ in 0..50 {
        for words in lists.iter() {
            let got = first_palindrome(words);
            if got.len() > 0 {
                found += 1;
            }
            letters_total += got.len();
            for c in got.chars().take(3) {
                check = (check * 31 + c as i64) % 1000000007;
            }
            check = (check * 31 + got.len()) % 1000000007;
        }
    }
    println(f"10000 searches: {found} found, {letters_total} letters, checksum {check}");
}
