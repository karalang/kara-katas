// LeetCode #2108: Find First Palindromic String in the Array -- the
// differential. The six arms, against the statement read literally:
// the words in order, each letter compared with the one as far from the
// other end. 300 random lists of 1 to 8 words of 1 to 5 letters from the
// first 1 to 3 letters; then 30 of 1 to 100 words of up to 100 letters
// from two; then 30 of palindromes with one letter of each changed or
// not; every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer is empty or one of the words, and reads the same
//     reversed
// P3  a one-letter word appended: the same answer, or that word when
//     there was none
// P4  every word reversed: the same answer
// P5  every letter renamed, `a` to `z`, `b` to `y` and so on: the answer
//     renamed
// P6  each arm agrees with at least three of the other five

// ---- palindrome.kara: the ★ arm, bytes from both ends
fn star_is_palindrome(w: String) -> bool {
    let b = w.bytes();
    let mut i = 0;
    let mut j = b.len() - 1;
    while i < j {
        if b[i] != b[j] {
            return false;
        }
        i += 1;
        j -= 1;
    }
    true
}

fn star_first_palindrome(words: Vec[String]) -> String {
    for w in words.iter() {
        if star_is_palindrome(w) {
            return w.clone();
        }
    }
    String.new()
}

// ---- palindrome_reverse.kara: each word reversed into a `String`
fn reverse_first_palindrome(words: Vec[String]) -> String {
    for w in words.iter() {
        let reversed: String = w.chars().rev().collect();
        if reversed == w {
            return w.clone();
        }
    }
    String.new()
}

// ---- palindrome_iter.kara: `find` with `zip` and `all`
fn iter_first_palindrome(words: Vec[String]) -> String {
    words
        .iter()
        .find(|w| w.chars().zip(w.chars().rev()).all(|(a, b)| a == b))
        .cloned()
        .unwrap_or(String.new())
}

// ---- palindrome_recursive.kara: a recursive check
fn recursive_mirrored(letters: Vec[char], lo: i64, hi: i64) -> bool {
    if lo >= hi {
        return true;
    }
    letters[lo] == letters[hi] and recursive_mirrored(letters, lo + 1, hi - 1)
}

fn recursive_first_palindrome(words: Vec[String]) -> String {
    let mut i = 0;
    while i < words.len() {
        let letters: Vec[char] = words[i].chars().collect();
        if recursive_mirrored(letters, 0, letters.len() - 1) {
            return words[i].clone();
        }
        i += 1;
    }
    String.new()
}

// ---- palindrome_struct.kara: a `Word`
struct StructWord {
    text: String,
    letters: Vec[char],
}

impl StructWord {
    fn new(text: String) -> StructWord {
        StructWord { text: text.clone(), letters: text.chars().collect() }
    }

    fn is_palindrome(self) -> bool {
        let n = self.letters.len();
        (0..n / 2).all(|k| self.letters[k] == self.letters[n - 1 - k])
    }
}

fn struct_first_palindrome(words: Vec[String]) -> String {
    match words.iter().map(|w| StructWord.new(w)).filter(|w| w.is_palindrome()).next() {
        Some(w) => w.text,
        None => String.new(),
    }
}

// ---- palindrome_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn first_palindrome(words: Vec[String]) -> String {
        words.clone()
            .into_iter()
            .find(|w| String.from_iter(w.chars().rev()) == *w)
            .unwrap_or_default()
    }
}

struct SolutionSolution {}

fn solution_first_palindrome(words: Vec[String]) -> String {
    SolutionSolution.first_palindrome(words.clone())
}

// ---- the statement read literally

fn literal(words: Vec[String]) -> String {
    for w in words.iter() {
        let letters: Vec[char] = w.chars().collect();
        let n = letters.len();
        let mut same = true;
        for i in 0..n {
            if letters[i] != letters[n - 1 - i] {
                same = false;
            }
        }
        if same {
            return w.clone();
        }
    }
    String.new()
}

fn answer(arm: i64, words: Vec[String]) -> String {
    match arm {
        0 => star_first_palindrome(words),
        1 => reverse_first_palindrome(words),
        2 => iter_first_palindrome(words),
        3 => recursive_first_palindrome(words),
        4 => struct_first_palindrome(words),
        _ => solution_first_palindrome(words),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn renamed(w: String) -> String {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut out = String.new();
    for c in w.chars() {
        out.push(alphabet[25 - alphabet.iter().position(|a| a == c).unwrap()]);
    }
    out
}

fn main() {
    let names = ["star", "reverse", "iter", "recursive", "struct", "solution"];
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut seed = 2108;
    let mut problems: Vec[Vec[String]] = Vec.new();
    for t in 0..360 {
        let (n, longest, letters) = if t < 300 {
            (next_random(mut seed) % 8 + 1, next_random(mut seed) % 5 + 1, next_random(mut seed) % 3 + 1)
        } else {
            (next_random(mut seed) % 100 + 1, 100, 2)
        };
        let mut words: Vec[String] = Vec.new();
        for _ in 0..n {
            let len = next_random(mut seed) % longest + 1;
            let mut letters_of: Vec[char] = Vec.new();
            for _ in 0..len {
                letters_of.push(alphabet[next_random(mut seed) % letters]);
            }
            if t >= 330 {
                // a palindrome: the first half mirrored, then one letter
                // changed or not
                for i in 0..len / 2 {
                    letters_of[len - 1 - i] = letters_of[i];
                }
                if next_random(mut seed) % 4 != 0 {
                    let at = next_random(mut seed) % len;
                    letters_of[at] = alphabet[next_random(mut seed) % letters];
                }
            }
            words.push(String.from_iter(letters_of.iter().cloned()));
        }
        problems.push(words);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for words in problems.iter() {
        let truth = literal(words);
        check = (check * 31 + truth.len()) % 1000000007;
        for c in truth.chars() {
            check = (check * 31 + c as i64) % 1000000007;
        }
        let mut appended = words.clone();
        appended.push("q");
        let reversed: Vec[String] = words.iter().map(|w| String.from_iter(w.chars().rev())).collect();
        let renamed_words: Vec[String] = words.iter().map(|w| renamed(w)).collect();
        let got: Vec[String] = (0..6).map(|arm| answer(arm, words)).collect();
        for arm in 0..6 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let reads_back = String.from_iter(x.chars().rev()) == x;
            let after = answer(arm, appended);
            let verdicts = [
                x == truth,
                (x.len() == 0 or words.contains(x)) and reads_back,
                if x.len() == 0 { after == "q" } else { after == x },
                answer(arm, reversed) == x,
                answer(arm, renamed_words) == renamed(x),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{words} arm {names[arm]}: P{q + 1} fails, answer \"{x}\", literal \"{truth}\"");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} lists: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
