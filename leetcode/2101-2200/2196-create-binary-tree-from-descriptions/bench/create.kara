// benchmark copy of create.kara (LeetCode #2196, the ★ arm): a `Map` of
// nodes made as named, a `Set` of children. See ../README.md § Benchmarks.

fn node_of(nodes: mut ref Map[i64, TreeNode], v: i64) -> TreeNode {
    if let Some(n) = nodes.get(v) {
        return n;
    }
    let n = leaf(v);
    nodes.insert(v, n);
    n
}

fn create_binary_tree(descriptions: Vec[Array[i64, 3]]) -> Option[TreeNode] {
    let mut nodes: Map[i64, TreeNode] = Map.new();
    let mut children: Set[i64] = Set.new();
    for d in descriptions.iter() {
        let parent = node_of(mut nodes, d[0]);
        let child = node_of(mut nodes, d[1]);
        if d[2] == 1 {
            parent.left = Some(child);
        } else {
            parent.right = Some(child);
        }
        children.insert(d[1]);
    }
    for d in descriptions.iter() {
        if not children.contains(d[0]) {
            return nodes.get(d[0]).cloned();
        }
    }
    None
}

shared struct TreeNode {
    val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// a random tree of 10^4 + 1 nodes, its values a random 10^4 + 1 of 1 to
// 10^5, written as its descriptions in a random order
fn random_descriptions(seed: mut ref i64) -> Vec[Array[i64, 3]] {
    let n = 10001;
    let mut values: Vec[i64] = (1..100001).collect();
    for i in 0..n {
        values.swap(i, i + wide_random(mut seed) % (100000 - i));
    }
    let mut free: Vec[(i64, i64)] = [(0, 1), (0, 0)].to_vec();
    let mut descriptions: Vec[Array[i64, 3]] = Vec.new();
    for k in 1..n {
        let pick = wide_random(mut seed) % free.len();
        let (p, side) = free[pick];
        free.swap_remove(pick);
        descriptions.push([values[p], values[k], side]);
        free.push((k, 1));
        free.push((k, 0));
    }
    for i in (1..descriptions.len()).rev() {
        descriptions.swap(i, wide_random(mut seed) % (i + 1));
    }
    descriptions
}

// the nodes' count and the sum of their values times their depths
fn weigh(root: Option[TreeNode]) -> (i64, i64) {
    let mut stack: Vec[(TreeNode, i64)] = Vec.new();
    if let Some(r) = root {
        stack.push((r, 1));
    }
    let mut count = 0;
    let mut weight = 0;
    while let Some((n, depth)) = stack.pop() {
        count += 1;
        weight += n.val * depth;
        if let Some(l) = n.left {
            stack.push((l, depth + 1));
        }
        if let Some(r) = n.right {
            stack.push((r, depth + 1));
        }
    }
    (count, weight)
}

fn main() {
    let mut seed = 2196;
    let mut sets: Vec[Vec[Array[i64, 3]]] = Vec.new();
    for _ in 0..20 {
        sets.push(random_descriptions(mut seed));
    }
    let mut check = 0;
    for _ in 0..50 {
        for d in sets.iter() {
            let root = create_binary_tree(d);
            let (count, weight) = weigh(root);
            check = (check * 31 + count + weight % 1000000007) % 1000000007;
        }
    }
    println(f"50 passes over 20 trees: checksum {check}");
}
