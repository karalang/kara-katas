// LeetCode #2120: Execution of All Suffix Instructions Staying in a Grid
// -- the differential. The six arms, against the statement read
// literally: the grid's cells put in a `Set`, and each suffix walked
// until the robot's next cell is not one of them. 300 random grids of
// side 1 to 6 with 1 to 20 moves; then 30 of side up to 20 with up to 80
// moves; then 30 of side 1 to 3, where most moves leave; every one drawn
// before any arm answers.
//
// P1  the answers are the statement read literally
// P2  there is one answer per instruction, and the answer for `i` is
//     between 0 and the `m - i` moves left
// P3  the grid seen in a mirror (`L` and `R` swapped, the start's column
//     reflected): the same answers
// P4  the grid transposed (`L` with `U`, `R` with `D`, the start's row
//     and column swapped): the same answers
// P5  a grid one larger, the same start: no answer falls
// P6  each arm agrees with at least three of the other five

// ---- suffix.kara: the ★ arm, each suffix simulated
fn star_execute_instructions(n: i64, start_pos: Vec[i64], s: String) -> Vec[i64] {
    let moves = s.bytes();
    let m = moves.len();
    let mut answer: Vec[i64] = Vec.new();
    for i in 0..m {
        let mut row = start_pos[0];
        let mut col = start_pos[1];
        let mut count = 0;
        for j in i..m {
            match moves[j] {
                b'L' => col -= 1,
                b'R' => col += 1,
                b'U' => row -= 1,
                _ => row += 1,
            }
            if row < 0 or row >= n or col < 0 or col >= n {
                break;
            }
            count += 1;
        }
        answer.push(count);
    }
    answer
}

// ---- suffix_struct.kara: a `Robot` that steps
struct StructRobot {
    n: i64,
    row: i64,
    col: i64,
}

impl StructRobot {
    fn step(mut ref self, instruction: char) -> bool {
        let (dr, dc) = match instruction {
            'L' => (0, -1),
            'R' => (0, 1),
            'U' => (-1, 0),
            _ => (1, 0),
        };
        let (row, col) = (self.row + dr, self.col + dc);
        if row < 0 or row >= self.n or col < 0 or col >= self.n {
            return false;
        }
        self.row = row;
        self.col = col;
        true
    }
}

fn struct_execute_instructions(n: i64, start_pos: Vec[i64], s: String) -> Vec[i64] {
    let moves: Vec[char] = s.chars().collect();
    let mut answer: Vec[i64] = Vec.new();
    for i in 0..moves.len() {
        let mut robot = StructRobot { n: n, row: start_pos[0], col: start_pos[1] };
        let mut count = 0;
        while i + count < moves.len() and robot.step(moves[i + count]) {
            count += 1;
        }
        answer.push(count);
    }
    answer
}

// ---- suffix_scan.kara: `scan` and `take_while` over the moves
fn scan_delta(c: u8) -> (i64, i64) {
    match c {
        b'L' => (0, -1),
        b'R' => (0, 1),
        b'U' => (-1, 0),
        _ => (1, 0),
    }
}

fn scan_execute_instructions(n: i64, start_pos: Vec[i64], s: String) -> Vec[i64] {
    let deltas: Vec[(i64, i64)] = s.bytes().iter().map(|c| scan_delta(c)).collect();
    (0..deltas.len())
        .map(|i| {
            deltas[i..]
                .iter()
                .scan((start_pos[0], start_pos[1]), |at, (dr, dc)| { let at = (at.0 + dr, at.1 + dc); Some((at, at)) })
                .take_while(|(r, c)| r >= 0 and r < n and c >= 0 and c < n)
                .count()
        })
        .collect()
}

// ---- suffix_recurse.kara: the moves made, recursively
fn recurse_moves_from(n: i64, s: Slice[u8], j: i64, row: i64, col: i64) -> i64 {
    if j == s.len() {
        return 0;
    }
    let (r, c) = if s[j] == b'L' {
        (row, col - 1)
    } else if s[j] == b'R' {
        (row, col + 1)
    } else if s[j] == b'U' {
        (row - 1, col)
    } else {
        (row + 1, col)
    };
    if r < 0 or r >= n or c < 0 or c >= n {
        return 0;
    }
    1 + recurse_moves_from(n, s, j + 1, r, c)
}

fn recurse_execute_instructions(n: i64, start_pos: Vec[i64], s: String) -> Vec[i64] {
    let bytes = s.bytes();
    (0..bytes.len()).map(|i| recurse_moves_from(n, bytes, i, start_pos[0], start_pos[1])).collect()
}

// ---- suffix_bounds.kara: the farthest offsets in each direction
fn bounds_execute_instructions(n: i64, start_pos: Vec[i64], s: String) -> Vec[i64] {
    let moves: Vec[char] = s.chars().collect();
    let (r0, c0) = (start_pos[0], start_pos[1]);
    let mut answer: Vec[i64] = Vec.new();
    for i in 0..moves.len() {
        let mut (dr, dc) = (0, 0);
        let mut (up, down, left, right) = (0, 0, 0, 0);
        let mut count = 0;
        for c in moves[i..].iter() {
            match c {
                'L' => dc -= 1,
                'R' => dc += 1,
                'U' => dr -= 1,
                _ => dr += 1,
            }
            up = up.min(dr);
            down = down.max(dr);
            left = left.min(dc);
            right = right.max(dc);
            if r0 + up < 0 or r0 + down >= n or c0 + left < 0 or c0 + right >= n {
                break;
            }
            count += 1;
        }
        answer.push(count);
    }
    answer
}

// ---- suffix_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn execute_instructions(n: i32, start_pos: Vec[i32], s: String) -> Vec[i32] {
        let s = s.bytes();
        let m = s.len();
        let mut ans = Vec.filled(m, 0);
        for i in 0..m {
            let mut (r, c) = (start_pos[0], start_pos[1]);
            for j in i..m {
                match s[j] {
                    b'L' => c -= 1,
                    b'R' => c += 1,
                    b'U' => r -= 1,
                    _ => r += 1,
                }
                if r < 0 or r >= n or c < 0 or c >= n {
                    break;
                }
                ans[i] += 1;
            }
        }
        ans
    }
}

struct SolutionSolution {}

fn solution_execute_instructions(n: i64, start_pos: Vec[i64], s: String) -> Vec[i64] {
    let start: Vec[i32] = start_pos.iter().map(|x| x as i32).collect();
    SolutionSolution.execute_instructions(n as i32, start, s).iter().map(|x| x as i64).collect()
}

// ---- the statement read literally

fn literal(n: i64, start_pos: Vec[i64], s: String) -> Vec[i64] {
    let mut cells: Set[(i64, i64)] = Set.new();
    for r in 0..n {
        for c in 0..n {
            cells.insert((r, c));
        }
    }
    let moves: Vec[char] = s.chars().collect();
    let mut answer: Vec[i64] = Vec.new();
    for i in 0..moves.len() {
        let mut at = (start_pos[0], start_pos[1]);
        let mut count = 0;
        for j in i..moves.len() {
            let next = match moves[j] {
                'L' => (at.0, at.1 - 1),
                'R' => (at.0, at.1 + 1),
                'U' => (at.0 - 1, at.1),
                _ => (at.0 + 1, at.1),
            };
            if not cells.contains(next) {
                break;
            }
            at = next;
            count += 1;
        }
        answer.push(count);
    }
    answer
}

fn answer(arm: i64, n: i64, start_pos: Vec[i64], s: String) -> Vec[i64] {
    match arm {
        0 => star_execute_instructions(n, start_pos, s),
        1 => struct_execute_instructions(n, start_pos, s),
        2 => scan_execute_instructions(n, start_pos, s),
        3 => recurse_execute_instructions(n, start_pos, s),
        4 => bounds_execute_instructions(n, start_pos, s),
        _ => solution_execute_instructions(n, start_pos, s),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn swapped(s: String, pairs: Vec[(char, char)]) -> String {
    s.chars()
        .map(|c| {
            let mut out = c;
            for (a, b) in pairs.iter() {
                if c == a {
                    out = b;
                } else if c == b {
                    out = a;
                }
            }
            out
        })
        .collect()
}

fn main() {
    let names = ["star", "struct", "scan", "recurse", "bounds", "solution"];
    let mut seed = 2120;
    let mut problems: Vec[(i64, Vec[i64], String)] = Vec.new();
    for t in 0..360 {
        let (n, m) = if t < 300 {
            (next_random(mut seed) % 6 + 1, next_random(mut seed) % 20 + 1)
        } else if t < 330 {
            (next_random(mut seed) % 20 + 1, next_random(mut seed) % 80 + 1)
        } else {
            (next_random(mut seed) % 3 + 1, next_random(mut seed) % 20 + 1)
        };
        let start = [next_random(mut seed) % n, next_random(mut seed) % n].to_vec();
        let mut s: String = "";
        for _ in 0..m {
            s.push(['L', 'R', 'U', 'D'][next_random(mut seed) % 4]);
        }
        problems.push((n, start, s));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (n, start, s) in problems.iter() {
        let truth = literal(n, start, s);
        for c in truth.iter() {
            check = (check * 31 + c) % 1000000007;
        }
        let m = s.len();
        let mirror_s = swapped(s, [('L', 'R')].to_vec());
        let mirror_start = [start[0], n - 1 - start[1]].to_vec();
        let flip_s = swapped(s, [('L', 'U'), ('R', 'D')].to_vec());
        let flip_start = [start[1], start[0]].to_vec();
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, n, start, s)).collect();
        for arm in 0..6 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let mut sized = x.len() == m;
            for i in 0..x.len() {
                if x[i] < 0 or x[i] > m - i {
                    sized = false;
                }
            }
            let larger = answer(arm, n + 1, start, s);
            let mut grown = larger.len() == x.len();
            for i in 0..x.len().min(larger.len()) {
                if larger[i] < x[i] {
                    grown = false;
                }
            }
            let verdicts = [
                x == truth,
                sized,
                answer(arm, n, mirror_start, mirror_s) == x,
                answer(arm, n, flip_start, flip_s) == x,
                grown,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"n={n} start={start} {s} arm {names[arm]}: P{q + 1} fails, answered {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} grids: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
