// LeetCode #2182: Construct String With Repeat Limit -- a `struct Tally`
// of the letters left, made `of` a string, that finds the `largest_below`
// a letter (`ref self`) and `take`s up to some of one (`mut ref self`),
// saying how many it took. The string is built from what it gives. O(26
// n) at worst.

struct Tally {
    counts: Vec[i64],
}

impl Tally {
    fn of(s: String) -> Tally {
        let mut counts: Vec[i64] = Vec.filled(26, 0);
        for b in s.bytes() {
            counts[b - 97] += 1;
        }
        Tally { counts: counts }
    }

    fn largest_below(ref self, top: i64) -> Option[i64] {
        let mut letter = top - 1;
        while letter >= 0 {
            if self.counts[letter] > 0 {
                return Some(letter);
            }
            letter -= 1;
        }
        None
    }

    fn take(mut ref self, letter: i64, most: i64) -> i64 {
        let took = self.counts[letter].min(most);
        self.counts[letter] -= took;
        took
    }
}

fn repeat_limited_string(s: String, repeat_limit: i64) -> String {
    let mut tally = Tally.of(s);
    let mut out = String.new();
    let mut top = 26;
    while let Some(big) = tally.largest_below(top) {
        let took = tally.take(big, repeat_limit);
        for _ in 0..took {
            out.push((97 + big) as u8 as char);
        }
        if tally.counts[big] == 0 {
            top = big;
            continue;
        }
        let Some(small) = tally.largest_below(big) else {
            break;
        };
        tally.take(small, 1);
        out.push((97 + small) as u8 as char);
        top = big + 1;
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn checksum(t: String) -> i64 {
    t.bytes().iter().fold(0, |check, b| (check * 31 + b as i64) % 1000000007)
}

fn random_letters(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    s
}

fn main() {
    // LeetCode's two examples, then five more: one letter, one letter
    // past its limit, a limit of one with no repeats, two letters taking
    // turns, and the largest letter run out with the next one left over
    let examples = [("cczazcc", 3), ("aababab", 2), ("a", 1), ("zzzz", 1), ("abc", 1), ("zzzzyyyy", 2), ("bbbbba", 2)];
    for (s, k) in examples.iter() {
        println(f"\"{s}\", {k} -> \"{repeat_limited_string(s.to_string(), k)}\"");
    }
    // 2000 random strings of 1 to 30 letters, from a to c or a to z in
    // turn, with a limit of 1 to 5
    let mut seed = 2182;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 30 + 1;
        let letters = [3, 26][round % 2];
        let k = next_random(mut seed) % 5 + 1;
        let s = random_letters(n, letters, mut seed);
        let t = repeat_limited_string(s, k);
        total += t.len();
        check = (check * 31 + checksum(t) + k) % 1000000007;
    }
    println(f"2000 strings: {total} letters kept, checksum {check}");
    // the constraints' largest, 10^5 letters: at random with a limit of
    // 1, then all z but one a, with limits from 1 to the length
    let s = random_letters(100000, 26, mut seed);
    let t = repeat_limited_string(s, 1);
    println(f"100000 random letters, limit 1: {t.len()} kept, checksum {checksum(t)}");
    let mut s = String.new();
    for _ in 0..99999 {
        s.push('z');
    }
    s.push('a');
    for k in [1, 50000, 100000] {
        let t = repeat_limited_string(s, k);
        println(f"99999 z and one a, limit {k}: {t.len()} kept, checksum {checksum(t)}");
    }
}
