// LeetCode #2182: Construct String With Repeat Limit -- the benchmark's
// Kāra arm: the ★ arm, the largest letter up to the limit, the next one
// between.

fn repeat_limited_string(s: String, repeat_limit: i64) -> String {
    let mut counts: Vec[i64] = Vec.filled(26, 0);
    for b in s.bytes() {
        counts[b - 97] += 1;
    }
    let mut out = String.new();
    let mut big = 25;
    loop {
        while big >= 0 and counts[big] == 0 {
            big -= 1;
        }
        if big < 0 {
            break;
        }
        let take = counts[big].min(repeat_limit);
        for _ in 0..take {
            out.push((97 + big) as u8 as char);
        }
        counts[big] -= take;
        if counts[big] == 0 {
            continue;
        }
        let mut small = big - 1;
        while small >= 0 and counts[small] == 0 {
            small -= 1;
        }
        if small < 0 {
            break;
        }
        out.push((97 + small) as u8 as char);
        counts[small] -= 1;
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2182;
    let mut row = String.new();
    for _ in 0..1000000 {
        row.push((97 + next_random(mut seed) % 26) as u8 as char);
    }
    let mut check = 0;
    for _ in 0..400 {
        let a = next_random(mut seed);
        let b = next_random(mut seed);
        let start = (a * 32768 + b) % 900001;
        let k = next_random(mut seed) % 3 + 1;
        let t = repeat_limited_string(row[start..(start + 100000)].to_string(), k);
        for c in t.bytes() {
            check = (check * 31 + c) % 1000000007;
        }
    }
    println(f"400 solves: checksum {check}");
}
