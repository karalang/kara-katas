// LeetCode #2198: Number of Single Divisor Triplets -- the ★ arm: the
// numbers are at most 100, so they are tallied by value, and every
// ordered triple (a, b, c) of the values the array holds is tried: when
// exactly one of the three divides a + b + c, its index triples are
// counted: the tally's product, each value's count stepped down once for
// each time it came earlier in the triple. O(n + 100^3).

fn single_divisor_triplet(nums: Vec[i64]) -> i64 {
    let mut count = [0; 101];
    for x in nums.iter() {
        count[x] += 1;
    }
    let mut total = 0;
    for a in 1..101 {
        if count[a] == 0 {
            continue;
        }
        for b in 1..101 {
            if count[b] == 0 {
                continue;
            }
            for c in 1..101 {
                if count[c] == 0 {
                    continue;
                }
                let sum = a + b + c;
                let by_a = sum % a == 0;
                let by_b = sum % b == 0;
                let by_c = sum % c == 0;
                if (by_a and not by_b and not by_c) or (by_b and not by_a and not by_c) or (by_c and not by_a and not by_b) {
                    let second = if b == a { count[b] - 1 } else { count[b] };
                    let third = count[c] - (if c == a { 1 } else { 0 }) - (if c == b { 1 } else { 0 });
                    total += count[a] * second * third;
                }
            }
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {single_divisor_triplet(nums)}");
}

fn main() {
    // LeetCode's three examples, then three more: three numbers that are
    // a single divisor triplet in every order, one value with one other,
    // and every value once
    show([4, 6, 7, 3, 2]);
    show([1, 2, 2]);
    show([1, 1, 1]);
    show([2, 3, 4]);
    show([3, 3, 3, 3, 1]);
    show((1..101).collect());
    // 200 random arrays of 3 to 60 numbers up to 6, 20 and 100 in turn
    let mut seed = 2198;
    let mut check = 0;
    for round in 0..200 {
        let n = next_random(mut seed) % 58 + 3;
        let top = [6, 20, 100][round % 3];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % top + 1);
        }
        check = (check * 31 + single_divisor_triplet(nums)) % 1000000007;
    }
    println(f"200 arrays: checksum {check}");
    // the constraints' longest: 10^5 numbers up to 100, and 10^5 numbers
    // of two values
    let mut wide: Vec[i64] = Vec.new();
    let mut two: Vec[i64] = Vec.new();
    for i in 0..100000 {
        wide.push(next_random(mut seed) % 100 + 1);
        two.push(if i % 3 == 0 { 2 } else { 4 });
    }
    println(f"10^5 numbers: {single_divisor_triplet(wide)}; two values: {single_divisor_triplet(two)}");
}
