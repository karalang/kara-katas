// LeetCode #2198: Number of Single Divisor Triplets -- the differential.
// The six arms, against the statement read literally: every ordered
// triple of distinct indices tried, and counted when exactly one of its
// three numbers divides their sum; no tally. 300 random arrays of 3 to 30
// numbers up to 6, 20 and 100 in turn; then 30 of one number repeated;
// then 30 of two numbers. Every case is drawn before any arm answers.
//
// P1  the count is the statement read literally
// P2  it is a multiple of 6, the orders of three indices, and at most
//     n (n - 1) (n - 2)
// P3  the array reversed: the same count
// P4  every number multiplied by the largest factor that keeps them all
//     at most 100: the same count
// P5  one more number x appended: the count grows by 3 times the ordered
//     pairs of other indices that make a single divisor triplet with x
// P6  each arm agrees with at least three of the other five

// ---- count.kara: the ★ arm, every ordered triple of the values held
fn star_single_divisor_triplet(nums: Vec[i64]) -> i64 {
    let mut count = [0; 101];
    for x in nums.iter() {
        count[x] += 1;
    }
    let mut total = 0;
    for a in 1..101 {
        if count[a] == 0 {
            continue;
        }
        for b in 1..101 {
            if count[b] == 0 {
                continue;
            }
            for c in 1..101 {
                if count[c] == 0 {
                    continue;
                }
                let sum = a + b + c;
                let by_a = sum % a == 0;
                let by_b = sum % b == 0;
                let by_c = sum % c == 0;
                if (by_a and not by_b and not by_c) or (by_b and not by_a and not by_c) or (by_c and not by_a and not by_b) {
                    let second = if b == a { count[b] - 1 } else { count[b] };
                    let third = count[c] - (if c == a { 1 } else { 0 }) - (if c == b { 1 } else { 0 });
                    total += count[a] * second * third;
                }
            }
        }
    }
    total
}

// ---- count_sorted.kara: a <= b <= c, counted by the multiset's shape
fn sorted_single(a: i64, b: i64, c: i64) -> bool {
    let sum = a + b + c;
    let mut divides = 0;
    for d in [a, b, c] {
        if sum % d == 0 {
            divides += 1;
        }
    }
    divides == 1
}

fn sorted_single_divisor_triplet(nums: Vec[i64]) -> i64 {
    let mut count = [0; 101];
    for x in nums.iter() {
        count[x] += 1;
    }
    let mut total = 0;
    for a in 1..101 {
        for b in a..101 {
            for c in b..101 {
                if count[a] == 0 or count[b] == 0 or count[c] == 0 or not sorted_single(a, b, c) {
                    continue;
                }
                total += if a < b and b < c {
                    6 * count[a] * count[b] * count[c]
                } else if a == b {
                    3 * count[a] * (count[a] - 1) * count[c]
                } else {
                    3 * count[a] * count[b] * (count[b] - 1)
                };
            }
        }
    }
    total
}

// ---- count_distinct.kara: the `SortedMap`'s entries only
fn distinct_single_divisor_triplet(nums: Vec[i64]) -> i64 {
    let mut tally: SortedMap[i64, i64] = SortedMap.new();
    for x in nums.iter() {
        tally.insert(x, tally.get(x).unwrap_or(0) + 1);
    }
    let entries: Vec[(i64, i64)] = tally.iter().collect();
    let d = entries.len();
    let mut total = 0;
    for i in 0..d {
        let (a, ca) = entries[i];
        for j in 0..d {
            let (b, cb) = entries[j];
            for k in 0..d {
                let (c, cc) = entries[k];
                let sum = a + b + c;
                let hits = (if sum % a == 0 { 1 } else { 0 }) + (if sum % b == 0 { 1 } else { 0 }) + (if sum % c == 0 { 1 } else { 0 });
                if hits != 1 {
                    continue;
                }
                let second = if j == i { cb - 1 } else { cb };
                let third = cc - (if k == i { 1 } else { 0 }) - (if k == j { 1 } else { 0 });
                total += ca * second * third;
            }
        }
    }
    total
}

// ---- count_struct.kara: `Tally` and `Triple`
struct Triple {
    a: i64,
    b: i64,
    c: i64,
}

impl Triple {
    fn is_single(ref self) -> bool {
        let sum = self.a + self.b + self.c;
        let by_a = sum % self.a == 0;
        let by_b = sum % self.b == 0;
        let by_c = sum % self.c == 0;
        by_a != by_b != by_c and not (by_a and by_b and by_c)
    }
}

struct Tally {
    count: Vec[i64],
}

impl Tally {
    fn of(nums: Vec[i64]) -> Tally {
        let mut count = Vec.filled(101, 0);
        for x in nums.iter() {
            count[x] += 1;
        }
        Tally { count: count }
    }

    fn ordered(ref self, t: Triple) -> i64 {
        let first = self.count[t.a];
        let second = self.count[t.b] - (if t.b == t.a { 1 } else { 0 });
        let third = self.count[t.c] - (if t.c == t.a { 1 } else { 0 }) - (if t.c == t.b { 1 } else { 0 });
        first * second * third
    }
}

fn struct_single_divisor_triplet(nums: Vec[i64]) -> i64 {
    let tally = Tally.of(nums);
    let mut total = 0;
    let held: Vec[i64] = (1..101).filter(|v| tally.count[v] > 0).collect();
    for a in held.iter() {
        for b in held.iter() {
            for c in held.iter() {
                let t = Triple { a: a, b: b, c: c };
                if t.is_single() {
                    total += tally.ordered(t);
                }
            }
        }
    }
    total
}

// ---- count_iter.kara: nested `flat_map`, `filter`, `map`, `sum`
fn iter_single_divisor_triplet(nums: Vec[i64]) -> i64 {
    let mut count = Vec.filled(101, 0);
    for x in nums.iter() {
        count[x] += 1;
    }
    let values: Vec[i64] = (1..101).filter(|v| count[v] > 0).collect();
    // each closure below hands on an iterator over the values, so each
    // holds a view of them rather than the vector (kara B-2026-11-15-32)
    let held = ref values;
    held.iter()
        .flat_map(|a| held.iter().flat_map(|b| held.iter().map(|c| (a, b, c))))
        .filter(|(a, b, c)| [a, b, c].iter().filter(|d| (a + b + c) % d == 0).count() == 1)
        .map(|(a, b, c)| count[a] * (count[b] - (if b == a { 1 } else { 0 })) * (count[c] - (if c == a { 1 } else { 0 }) - (if c == b { 1 } else { 0 })))
        .sum()
}

// ---- count_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn single_divisor_triplet(nums: Vec[i32]) -> i64 {
        let mut cnt = [0; 101];
        for x in ref nums {
            cnt[x as usize] += 1;
        }
        let mut ans = 0;
        for a in 1..=100usize {
            if cnt[a] == 0 {
                continue;
            }
            for b in 1..=100usize {
                if cnt[b] == 0 {
                    continue;
                }
                for c in 1..=100usize {
                    if cnt[c] == 0 {
                        continue;
                    }
                    let s = a + b + c;
                    let d = (s % a == 0) as i32 + (s % b == 0) as i32 + (s % c == 0) as i32;
                    if d != 1 {
                        continue;
                    }
                    ans += match (a == b, b == c, a == c) {
                        (true, _, _) => cnt[a] * (cnt[a] - 1) * cnt[c],
                        (_, true, _) => cnt[a] * cnt[b] * (cnt[b] - 1),
                        (_, _, true) => cnt[a] * cnt[b] * (cnt[a] - 1),
                        _ => cnt[a] * cnt[b] * cnt[c],
                    };
                }
            }
        }
        ans
    }
}

struct Solution {}

fn solution_single_divisor_triplet(nums: Vec[i64]) -> i64 {
    let narrow: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.single_divisor_triplet(narrow)
}

// ---- the statement read literally

fn single_by_hand(a: i64, b: i64, c: i64) -> bool {
    let sum = a + b + c;
    let mut hits = 0;
    if sum % a == 0 {
        hits += 1;
    }
    if sum % b == 0 {
        hits += 1;
    }
    if sum % c == 0 {
        hits += 1;
    }
    hits == 1
}

fn literal(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut total = 0;
    for i in 0..n {
        for j in 0..n {
            for k in 0..n {
                if i != j and j != k and i != k and single_by_hand(nums[i], nums[j], nums[k]) {
                    total += 1;
                }
            }
        }
    }
    total
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_single_divisor_triplet(nums),
        1 => sorted_single_divisor_triplet(nums),
        2 => distinct_single_divisor_triplet(nums),
        3 => struct_single_divisor_triplet(nums),
        4 => iter_single_divisor_triplet(nums),
        _ => solution_single_divisor_triplet(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "sorted", "distinct", "struct", "iter", "solution"];
    let mut seed = 2198;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for c in 0..360 {
        let n = next_random(mut seed) % 28 + 3;
        let mut nums: Vec[i64] = Vec.new();
        if c < 300 {
            let top = [6, 20, 100][c % 3];
            for _ in 0..n {
                nums.push(next_random(mut seed) % top + 1);
            }
        } else if c < 330 {
            let x = next_random(mut seed) % 100 + 1;
            for _ in 0..n {
                nums.push(x);
            }
        } else {
            let x = next_random(mut seed) % 100 + 1;
            let y = next_random(mut seed) % 100 + 1;
            for _ in 0..n {
                nums.push(if next_random(mut seed) % 2 == 0 { x } else { y });
            }
        }
        let extra = next_random(mut seed) % 100 + 1;
        cases.push((nums, extra));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (nums, extra) in cases.iter() {
        let truth = literal(nums);
        check = (check * 31 + truth % 1000000007) % 1000000007;
        let n = nums.len();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums)).collect();
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let largest = nums.iter().max().unwrap();
        let factor = 100 / largest;
        let scaled: Vec[i64] = nums.iter().map(|x| x * factor).collect();
        let mut longer = nums.clone();
        longer.push(extra);
        let mut pairs = 0;
        for j in 0..n {
            for k in 0..n {
                if j != k and single_by_hand(extra, nums[j], nums[k]) {
                    pairs += 1;
                }
            }
        }
        for arm in 0..6 {
            let count = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == count {
                    same += 1;
                }
            }
            let verdicts = [
                count == truth,
                count % 6 == 0 and count >= 0 and count <= n * (n - 1) * (n - 2),
                answer(arm, reversed) == count,
                answer(arm, scaled) == count,
                answer(arm, longer) - count == 3 * pairs,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} + {extra} arm {names[arm]}: P{q + 1} fails, answered {count}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
