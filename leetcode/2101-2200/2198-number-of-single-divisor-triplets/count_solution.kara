// LeetCode #2198: Number of Single Divisor Triplets -- LeetCode's Rust
// template: `Vec<i32>` in, `i64` out, the tally a `[i64; 101]` indexed
// by `as usize`, three loops over `1..=100usize` that `continue` past a
// value the array lacks, the divisor count summed from `bool`s cast `as
// i32`, and the ordered index triples by a `match` on which values are
// alike. Carried by `karac fix`. The adapter below hands the harness's
// numbers to it.

impl Solution {
    pub fn single_divisor_triplet(nums: Vec[i32]) -> i64 {
        let mut cnt = [0; 101];
        for x in ref nums {
            cnt[x as usize] += 1;
        }
        let mut ans = 0;
        for a in 1..=100usize {
            if cnt[a] == 0 {
                continue;
            }
            for b in 1..=100usize {
                if cnt[b] == 0 {
                    continue;
                }
                for c in 1..=100usize {
                    if cnt[c] == 0 {
                        continue;
                    }
                    let s = a + b + c;
                    let d = (s % a == 0) as i32 + (s % b == 0) as i32 + (s % c == 0) as i32;
                    if d != 1 {
                        continue;
                    }
                    ans += match (a == b, b == c, a == c) {
                        (true, _, _) => cnt[a] * (cnt[a] - 1) * cnt[c],
                        (_, true, _) => cnt[a] * cnt[b] * (cnt[b] - 1),
                        (_, _, true) => cnt[a] * cnt[b] * (cnt[a] - 1),
                        _ => cnt[a] * cnt[b] * cnt[c],
                    };
                }
            }
        }
        ans
    }
}

struct Solution {}

fn single_divisor_triplet(nums: Vec[i64]) -> i64 {
    let narrow: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.single_divisor_triplet(narrow)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {single_divisor_triplet(nums)}");
}

fn main() {
    // LeetCode's three examples, then three more: three numbers that are
    // a single divisor triplet in every order, one value with one other,
    // and every value once
    show([4, 6, 7, 3, 2]);
    show([1, 2, 2]);
    show([1, 1, 1]);
    show([2, 3, 4]);
    show([3, 3, 3, 3, 1]);
    show((1..101).collect());
    // 200 random arrays of 3 to 60 numbers up to 6, 20 and 100 in turn
    let mut seed = 2198;
    let mut check = 0;
    for round in 0..200 {
        let n = next_random(mut seed) % 58 + 3;
        let top = [6, 20, 100][round % 3];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % top + 1);
        }
        check = (check * 31 + single_divisor_triplet(nums)) % 1000000007;
    }
    println(f"200 arrays: checksum {check}");
    // the constraints' longest: 10^5 numbers up to 100, and 10^5 numbers
    // of two values
    let mut wide: Vec[i64] = Vec.new();
    let mut two: Vec[i64] = Vec.new();
    for i in 0..100000 {
        wide.push(next_random(mut seed) % 100 + 1);
        two.push(if i % 3 == 0 { 2 } else { 4 });
    }
    println(f"10^5 numbers: {single_divisor_triplet(wide)}; two values: {single_divisor_triplet(two)}");
}
