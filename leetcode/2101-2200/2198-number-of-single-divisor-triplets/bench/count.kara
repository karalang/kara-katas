// benchmark copy of count.kara (LeetCode #2198, the ★ arm): every ordered
// triple of the values held. See ../README.md § Benchmarks.

fn single_divisor_triplet(nums: Vec[i64]) -> i64 {
    let mut count = [0; 101];
    for x in nums.iter() {
        count[x] += 1;
    }
    let mut total = 0;
    for a in 1..101 {
        if count[a] == 0 {
            continue;
        }
        for b in 1..101 {
            if count[b] == 0 {
                continue;
            }
            for c in 1..101 {
                if count[c] == 0 {
                    continue;
                }
                let sum = a + b + c;
                let by_a = sum % a == 0;
                let by_b = sum % b == 0;
                let by_c = sum % c == 0;
                if (by_a and not by_b and not by_c) or (by_b and not by_a and not by_c) or (by_c and not by_a and not by_b) {
                    let second = if b == a { count[b] - 1 } else { count[b] };
                    let third = count[c] - (if c == a { 1 } else { 0 }) - (if c == b { 1 } else { 0 });
                    total += count[a] * second * third;
                }
            }
        }
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 arrays of 10^5 numbers, each drawn up to its own top, 81 to 100
    let mut seed = 2198;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for a in 0..20 {
        let top = 81 + a;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            nums.push(next_random(mut seed) % top + 1);
        }
        arrays.push(nums);
    }
    let mut check = 0;
    for _ in 0..10 {
        for nums in arrays.iter() {
            check = (check * 31 + single_divisor_triplet(nums) % 1000000007) % 1000000007;
        }
    }
    println(f"10 passes over 20 arrays: checksum {check}");
}
