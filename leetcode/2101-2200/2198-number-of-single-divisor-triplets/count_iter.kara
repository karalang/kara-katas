// LeetCode #2198: Number of Single Divisor Triplets -- iterator chains:
// the values the array holds `filter`ed from 1 to 100 by their counts,
// every ordered triple of them reached by nested `flat_map`s over a view
// of them, kept by `filter` when exactly one of the three divides the
// sum (`count` over the three), and each `map`ped to its index triples
// and `sum`med. O(n + 100^3).

fn single_divisor_triplet(nums: Vec[i64]) -> i64 {
    let mut count = Vec.filled(101, 0);
    for x in nums.iter() {
        count[x] += 1;
    }
    let values: Vec[i64] = (1..101).filter(|v| count[v] > 0).collect();
    // each closure below hands on an iterator over the values, so each
    // holds a view of them rather than the vector (kara B-2026-11-15-32)
    let held = ref values;
    held.iter()
        .flat_map(|a| held.iter().flat_map(|b| held.iter().map(|c| (a, b, c))))
        .filter(|(a, b, c)| [a, b, c].iter().filter(|d| (a + b + c) % d == 0).count() == 1)
        .map(|(a, b, c)| count[a] * (count[b] - (if b == a { 1 } else { 0 })) * (count[c] - (if c == a { 1 } else { 0 }) - (if c == b { 1 } else { 0 })))
        .sum()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {single_divisor_triplet(nums)}");
}

fn main() {
    // LeetCode's three examples, then three more: three numbers that are
    // a single divisor triplet in every order, one value with one other,
    // and every value once
    show([4, 6, 7, 3, 2]);
    show([1, 2, 2]);
    show([1, 1, 1]);
    show([2, 3, 4]);
    show([3, 3, 3, 3, 1]);
    show((1..101).collect());
    // 200 random arrays of 3 to 60 numbers up to 6, 20 and 100 in turn
    let mut seed = 2198;
    let mut check = 0;
    for round in 0..200 {
        let n = next_random(mut seed) % 58 + 3;
        let top = [6, 20, 100][round % 3];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % top + 1);
        }
        check = (check * 31 + single_divisor_triplet(nums)) % 1000000007;
    }
    println(f"200 arrays: checksum {check}");
    // the constraints' longest: 10^5 numbers up to 100, and 10^5 numbers
    // of two values
    let mut wide: Vec[i64] = Vec.new();
    let mut two: Vec[i64] = Vec.new();
    for i in 0..100000 {
        wide.push(next_random(mut seed) % 100 + 1);
        two.push(if i % 3 == 0 { 2 } else { 4 });
    }
    println(f"10^5 numbers: {single_divisor_triplet(wide)}; two values: {single_divisor_triplet(two)}");
}
