// LeetCode #2140: Solving Questions With Brainpower -- the benchmark,
// brainpower.kara's ★ arm. 10 lists of 100000 questions built once,
// points of 1 to 100000 and brainpower of 0 to 20; then every list solved
// 20 times, one question redrawn before each solve.

fn most_points(questions: Vec[Vec[i64]]) -> i64 {
    let n = questions.len();
    let mut best: Vec[i64] = Vec.filled(n + 1, 0);
    for i in (0..n).rev() {
        let next = (i + 1 + questions[i][1]).min(n);
        best[i] = best[i + 1].max(questions[i][0] + best[next]);
    }
    best[0]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2140;
    let mut lists: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..10 {
        let mut questions: Vec[Vec[i64]] = Vec.new();
        for _ in 0..100000 {
            let points = next_random(mut seed) % 100000 + 1;
            let brainpower = next_random(mut seed) % 21;
            questions.push([points, brainpower].to_vec());
        }
        lists.push(questions);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..20 {
        for l in 0..10 {
            let at = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000;
            lists[l][at][0] = next_random(mut seed) % 100000 + 1;
            lists[l][at][1] = next_random(mut seed) % 21;
            let points = most_points(lists[l]);
            total += points;
            check = (check * 31 + points + round) % 1000000007;
        }
    }
    println(f"200 solves: {total} points in all, checksum {check}");
}
