// LeetCode #2163: Minimum Difference in Sums After Removal of Elements --
// the heaps written by hand: a `Vec` kept as a binary heap by `sift_up`
// and `sift_down` (`mut ref Vec`), ordered by a `sign` of 1 for largest
// first and -1 for smallest first. Rather than pushing and then popping,
// a number better than the top replaces it and sinks: the top is the
// worst kept. O(n log n).

fn above(a: i64, b: i64, sign: i64) -> bool {
    a * sign > b * sign
}

fn sift_up(heap: mut ref Vec[i64], sign: i64) {
    let mut i = heap.len() - 1;
    while i > 0 {
        let parent = (i - 1) / 2;
        if not above(heap[i], heap[parent], sign) {
            break;
        }
        heap.swap(i, parent);
        i = parent;
    }
}

fn sift_down(heap: mut ref Vec[i64], sign: i64) {
    let mut i = 0;
    loop {
        let mut top = i;
        for child in [2 * i + 1, 2 * i + 2] {
            if child < heap.len() and above(heap[child], heap[top], sign) {
                top = child;
            }
        }
        if top == i {
            break;
        }
        heap.swap(i, top);
        i = top;
    }
}

// the sums of the n best of xs[0..n + k] for each k, best meaning smallest
// for sign 1 (the worst, the largest, on top) and largest for sign -1
fn best_sums(xs: Vec[i64], n: i64, sign: i64) -> Vec[i64] {
    let mut heap: Vec[i64] = Vec.new();
    let mut sum = 0;
    let mut out: Vec[i64] = Vec.new();
    for x in xs.iter() {
        if heap.len() < n {
            heap.push(x);
            sift_up(mut heap, sign);
            sum += x;
        } else if above(heap[0], x, sign) {
            sum += x - heap[0];
            heap[0] = x;
            sift_down(mut heap, sign);
        }
        if heap.len() == n {
            out.push(sum);
        }
    }
    out
}

fn minimum_difference(nums: Vec[i64]) -> i64 {
    let n = nums.len() / 3;
    let left = best_sums(nums[0..2 * n].to_vec(), n, 1);
    let right = best_sums(nums[n..3 * n].iter().rev().collect(), n, -1);
    (0..n + 1).map(|k| left[k] - right[n - k]).min().unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {minimum_difference(nums)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number a part, all the
    // same, rising, and falling
    show([3, 1, 2].to_vec());
    show([7, 9, 5, 8, 1, 3].to_vec());
    show([4, 4, 4].to_vec());
    show([6, 6, 6, 6, 6, 6].to_vec());
    show([1, 2, 3, 4, 5, 6, 7, 8, 9].to_vec());
    show([9, 8, 7, 6, 5, 4, 3, 2, 1].to_vec());
    // 2000 random lists of 3 to 15 numbers from 1 to 10, 100 or 10^5 in turn
    let mut seed = 2163;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 5 + 1;
        let most = [10, 100, 100000][round % 3];
        let nums: Vec[i64] = (0..3 * n).map(|_| wide_random(mut seed) % most + 1).collect();
        let d = minimum_difference(nums);
        total += d;
        check = (check * 31 + d + 1000000000) % 1000000007;
    }
    println(f"2000 lists: {total} in all, checksum {check}");
    // the constraints' largest, 300000 numbers: at random, and all one number
    let random: Vec[i64] = (0..300000).map(|_| wide_random(mut seed) % 100000 + 1).collect();
    println(f"300000 at random: {minimum_difference(random)}");
    let same: Vec[i64] = Vec.filled(300000, 100000);
    println(f"300000 the same: {minimum_difference(same)}");
}
