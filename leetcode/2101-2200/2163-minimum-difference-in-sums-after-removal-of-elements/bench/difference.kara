// LeetCode #2163: Minimum Difference in Sums After Removal of Elements --
// the benchmark: the ★ arm over four lists of 300000 numbers built once,
// one number replaced before each of 20 solves.

fn minimum_difference(nums: Vec[i64]) -> i64 {
    let n = nums.len() / 3;
    // left[k]: the least sum of n numbers from the first n + k
    let mut kept: PriorityQueue[i64] = PriorityQueue.max_first();
    let mut sum = 0;
    let mut left: Vec[i64] = Vec.new();
    for i in 0..2 * n {
        kept.push(nums[i]);
        sum += nums[i];
        if kept.len() > n {
            sum -= kept.pop().unwrap();
        }
        if i >= n - 1 {
            left.push(sum);
        }
    }
    // the second part from nums[i..], taken from the back
    let mut kept: PriorityQueue[i64] = PriorityQueue.new();
    let mut sum = 0;
    let mut best = i64.MAX;
    for i in (n..3 * n).rev() {
        kept.push(nums[i]);
        sum += nums[i];
        if kept.len() > n {
            sum -= kept.pop().unwrap();
        }
        if i <= 2 * n {
            best = best.min(left[i - n] - sum);
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 2163;
    let mut lists: Vec[Vec[i64]] = Vec.new();
    for _ in 0..4 {
        lists.push((0..300000).map(|_| wide_random(mut seed) % 100000 + 1).collect());
    }
    let mut check = 0;
    for round in 0..5 {
        for k in 0..4 {
            let at = wide_random(mut seed) % 300000;
            lists[k][at] = wide_random(mut seed) % 100000 + 1;
            let d = minimum_difference(lists[k].clone());
            check = (check * 31 + d + 1000000000000) % 1000000007;
        }
    }
    println(f"20 solves: checksum {check}");
}
