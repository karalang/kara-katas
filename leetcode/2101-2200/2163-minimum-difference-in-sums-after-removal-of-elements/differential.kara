// LeetCode #2163: Minimum Difference in Sums After Removal of Elements --
// the differential. The six arms, against the statement read literally:
// every choice of n numbers removed, what is left cut in half, and the
// least first half's sum less the second's taken; no heaps, no prefix and
// no suffix. 300 random lists of 3 to 12 numbers from 1 to 5, 50 or 10^5
// in turn; then 30 of one number; then 30 falling; every one drawn before
// any arm answers.
//
// P1  the difference is the statement read literally
// P2  every number 7 more: the same difference
// P3  every number doubled: the difference doubled
// P4  the list reversed and every number negated: the same difference
// P5  the list sorted: its n smallest less its n largest
// P6  each arm agrees with at least three of the other five

// ---- difference.kara: the ★ arm, a `PriorityQueue` each way
fn star_minimum_difference(nums: Vec[i64]) -> i64 {
    let n = nums.len() / 3;
    // left[k]: the least sum of n numbers from the first n + k
    let mut kept: PriorityQueue[i64] = PriorityQueue.max_first();
    let mut sum = 0;
    let mut left: Vec[i64] = Vec.new();
    for i in 0..2 * n {
        kept.push(nums[i]);
        sum += nums[i];
        if kept.len() > n {
            sum -= kept.pop().unwrap();
        }
        if i >= n - 1 {
            left.push(sum);
        }
    }
    // the second part from nums[i..], taken from the back
    let mut kept: PriorityQueue[i64] = PriorityQueue.new();
    let mut sum = 0;
    let mut best = i64.MAX;
    for i in (n..3 * n).rev() {
        kept.push(nums[i]);
        sum += nums[i];
        if kept.len() > n {
            sum -= kept.pop().unwrap();
        }
        if i <= 2 * n {
            best = best.min(left[i - n] - sum);
        }
    }
    best
}

// ---- difference_multiset.kara: a `SortedMap` of counts, dropping by `last` and `first`
fn multiset_take_one(counts: mut ref SortedMap[i64, i64], key: i64) {
    let left = counts[key] - 1;
    if left == 0 {
        counts.remove(key);
    } else {
        counts[key] = left;
    }
}

fn multiset_add_one(counts: mut ref SortedMap[i64, i64], key: i64) {
    let had = counts.get(key).cloned().unwrap_or(0);
    counts[key] = had + 1;
}

fn multiset_minimum_difference(nums: Vec[i64]) -> i64 {
    let n = nums.len() / 3;
    let mut counts: SortedMap[i64, i64] = SortedMap.new();
    let mut sum = 0;
    let mut left: Vec[i64] = Vec.new();
    for i in 0..2 * n {
        multiset_add_one(mut counts, nums[i]);
        sum += nums[i];
        if i >= n {
            let (top, _) = counts.last().unwrap();
            let top = *top;
            multiset_take_one(mut counts, top);
            sum -= top;
        }
        if i >= n - 1 {
            left.push(sum);
        }
    }
    let mut counts: SortedMap[i64, i64] = SortedMap.new();
    let mut sum = 0;
    let mut best = i64.MAX;
    for i in (n..3 * n).rev() {
        multiset_add_one(mut counts, nums[i]);
        sum += nums[i];
        if i < 2 * n {
            let (low, _) = counts.first().unwrap();
            let low = *low;
            multiset_take_one(mut counts, low);
            sum -= low;
        }
        if i <= 2 * n {
            best = best.min(left[i - n] - sum);
        }
    }
    best
}

// ---- difference_struct.kara: a `Keeper` that keeps the n best it is `offer`ed
struct Keeper {
    worst_first: PriorityQueue[i64],
    keep: i64,
    sum: i64,
}

impl Keeper {
    fn smallest(keep: i64) -> Keeper {
        Keeper { worst_first: PriorityQueue.max_first(), keep: keep, sum: 0 }
    }

    fn largest(keep: i64) -> Keeper {
        Keeper { worst_first: PriorityQueue.new(), keep: keep, sum: 0 }
    }

    fn offer(mut ref self, x: i64) {
        self.worst_first.push(x);
        self.sum += x;
        if self.worst_first.len() > self.keep {
            self.sum -= self.worst_first.pop().unwrap();
        }
    }

    fn sums(mut ref self, xs: Vec[i64]) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for x in xs.iter() {
            self.offer(x);
            if self.worst_first.len() == self.keep {
                out.push(self.sum);
            }
        }
        out
    }
}

fn keeper_minimum_difference(nums: Vec[i64]) -> i64 {
    let n = nums.len() / 3;
    let front: Vec[i64] = nums[0..2 * n].to_vec();
    let back: Vec[i64] = nums[n..3 * n].iter().rev().collect();
    let left = Keeper.smallest(n).sums(front);
    let right = Keeper.largest(n).sums(back);
    let mut best = i64.MAX;
    for k in 0..n + 1 {
        best = best.min(left[k] - right[n - k]);
    }
    best
}

// ---- difference_heap.kara: the heaps by hand, `sift_up` and `sift_down`
fn heap_above(a: i64, b: i64, sign: i64) -> bool {
    a * sign > b * sign
}

fn heap_sift_up(heap: mut ref Vec[i64], sign: i64) {
    let mut i = heap.len() - 1;
    while i > 0 {
        let parent = (i - 1) / 2;
        if not heap_above(heap[i], heap[parent], sign) {
            break;
        }
        heap.swap(i, parent);
        i = parent;
    }
}

fn heap_sift_down(heap: mut ref Vec[i64], sign: i64) {
    let mut i = 0;
    loop {
        let mut top = i;
        for child in [2 * i + 1, 2 * i + 2] {
            if child < heap.len() and heap_above(heap[child], heap[top], sign) {
                top = child;
            }
        }
        if top == i {
            break;
        }
        heap.swap(i, top);
        i = top;
    }
}

// the sums of the n best of xs[0..n + k] for each k, best meaning smallest
// for sign 1 (the worst, the largest, on top) and largest for sign -1
fn heap_best_sums(xs: Vec[i64], n: i64, sign: i64) -> Vec[i64] {
    let mut heap: Vec[i64] = Vec.new();
    let mut sum = 0;
    let mut out: Vec[i64] = Vec.new();
    for x in xs.iter() {
        if heap.len() < n {
            heap.push(x);
            heap_sift_up(mut heap, sign);
            sum += x;
        } else if heap_above(heap[0], x, sign) {
            sum += x - heap[0];
            heap[0] = x;
            heap_sift_down(mut heap, sign);
        }
        if heap.len() == n {
            out.push(sum);
        }
    }
    out
}

fn heap_minimum_difference(nums: Vec[i64]) -> i64 {
    let n = nums.len() / 3;
    let left = heap_best_sums(nums[0..2 * n].to_vec(), n, 1);
    let right = heap_best_sums(nums[n..3 * n].iter().rev().collect(), n, -1);
    (0..n + 1).map(|k| left[k] - right[n - k]).min().unwrap()
}

// ---- difference_fenwick.kara: Fenwick trees of counts and sums over the ranks
fn fenwick_add(tree: mut ref Vec[i64], rank: i64, by: i64) {
    let mut i = rank + 1;
    while i < tree.len() {
        tree[i] += by;
        i += i & -i;
    }
}

// the sum of the k smallest numbers counted in `counts` and `sums`
fn fenwick_smallest_sum(counts: Vec[i64], sums: Vec[i64], values: Vec[i64], k: i64) -> i64 {
    let size = counts.len() - 1;
    let mut step = 1;
    while step * 2 <= size {
        step *= 2;
    }
    let mut at = 0;
    let mut need = k;
    let mut total = 0;
    while step > 0 {
        if at + step <= size and counts[at + step] <= need {
            at += step;
            need -= counts[at];
            total += sums[at];
        }
        step /= 2;
    }
    // what is still needed are copies of the next value up
    if need > 0 {
        total += need * values[at];
    }
    total
}

fn fenwick_minimum_difference(nums: Vec[i64]) -> i64 {
    let n = nums.len() / 3;
    let mut values = nums.clone();
    values.sort();
    values.dedup();
    let rank = |x: i64| values.binary_search(x).unwrap();
    let size = values.len() + 1;
    let mut counts: Vec[i64] = Vec.filled(size, 0);
    let mut sums: Vec[i64] = Vec.filled(size, 0);
    let mut left: Vec[i64] = Vec.new();
    for i in 0..2 * n {
        fenwick_add(mut counts, rank(nums[i]), 1);
        fenwick_add(mut sums, rank(nums[i]), nums[i]);
        if i >= n - 1 {
            left.push(fenwick_smallest_sum(counts, sums, values, n));
        }
    }
    let mut counts: Vec[i64] = Vec.filled(size, 0);
    let mut sums: Vec[i64] = Vec.filled(size, 0);
    let mut suffix = 0;
    let mut best = i64.MAX;
    for i in (n..3 * n).rev() {
        fenwick_add(mut counts, rank(nums[i]), 1);
        fenwick_add(mut sums, rank(nums[i]), nums[i]);
        suffix += nums[i];
        if i <= 2 * n {
            let largest = suffix - fenwick_smallest_sum(counts, sums, values, 3 * n - i - n);
            best = best.min(left[i - n] - largest);
        }
    }
    best
}

// ---- difference_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn minimum_difference(nums: Vec[i32]) -> i64 {
        let n = nums.len() / 3;
        let mut left = Vec.filled(n + 1, 0);
        let mut heap = PriorityQueue.max_first();
        let mut sum: i64 = 0;
        for i in 0..2 * n {
            heap.push(nums[i]);
            sum += nums[i];
            if heap.len() > n {
                sum -= heap.pop().unwrap();
            }
            if i + 1 >= n {
                left[i + 1 - n] = sum;
            }
        }
        let mut heap = PriorityQueue.new();
        let mut sum: i64 = 0;
        let mut ans = i64.MAX;
        for i in (n..3 * n).rev() {
            heap.push(nums[i]);
            sum += nums[i];
            if heap.len() > n {
                sum -= heap.pop().unwrap();
            }
            if i <= 2 * n {
                ans = ans.min(left[i - n] - sum);
            }
        }
        ans
    }
}

struct SolutionSolution {}

fn solution_minimum_difference(nums: Vec[i64]) -> i64 {
    SolutionSolution.minimum_difference(nums.iter().map(|x| x as i32).collect())
}


// ---- the statement read literally

// every way to keep `left` of the numbers from `at` on, in order, each
// way's least difference folded into `best`
fn choose(nums: Vec[i64], at: i64, kept: mut ref Vec[i64], left: i64, best: mut ref i64) {
    if left == 0 {
        let half = kept.len() / 2;
        let mut first = 0;
        let mut second = 0;
        for k in 0..kept.len() {
            if k < half {
                first += kept[k];
            } else {
                second += kept[k];
            }
        }
        if first - second < *best {
            *best = first - second;
        }
        return;
    }
    if nums.len() - at < left {
        return;
    }
    kept.push(nums[at]);
    choose(nums, at + 1, mut kept, left - 1, mut best);
    kept.pop();
    choose(nums, at + 1, mut kept, left, mut best);
}

fn literal(nums: Vec[i64]) -> i64 {
    let mut best = i64.MAX;
    let mut kept: Vec[i64] = Vec.new();
    choose(nums, 0, mut kept, nums.len() / 3 * 2, mut best);
    best
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_minimum_difference(nums),
        1 => multiset_minimum_difference(nums),
        2 => keeper_minimum_difference(nums),
        3 => heap_minimum_difference(nums),
        4 => fenwick_minimum_difference(nums),
        _ => solution_minimum_difference(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "multiset", "keeper", "heap", "fenwick", "solution"];
    let mut seed = 2163;
    let mut lists: Vec[Vec[i64]] = Vec.new();
    for t in 0..360 {
        let n = next_random(mut seed) % 4 + 1;
        let most = [5, 50, 100000][t % 3];
        let mut nums: Vec[i64] = (0..3 * n).map(|_| wide_random(mut seed) % most + 1).collect();
        if t >= 300 and t < 330 {
            nums = Vec.filled(3 * n, nums[0]);
        } else if t >= 330 {
            nums.sort_by(|a, b| b.cmp(a));
        }
        lists.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for nums in lists.iter() {
        let n = nums.len() / 3;
        let truth = literal(nums);
        check = (check * 31 + truth + 1000000000) % 1000000007;
        let raised: Vec[i64] = nums.iter().map(|x| x + 7).collect();
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let mirrored: Vec[i64] = nums.iter().rev().map(|x| -x).collect();
        let mut sorted = nums.clone();
        sorted.sort();
        let ends = sorted[0..n].iter().sum() - sorted[2 * n..3 * n].iter().sum();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, raised) == x,
                answer(arm, doubled) == 2 * x,
                answer(arm, mirrored) == x,
                answer(arm, sorted) == ends,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} arm {names[arm]}: P{q + 1} fails, answered {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{lists.len()} lists: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
