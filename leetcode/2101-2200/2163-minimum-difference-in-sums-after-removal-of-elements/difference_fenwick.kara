// LeetCode #2163: Minimum Difference in Sums After Removal of Elements --
// two Fenwick trees over the numbers' ranks, one of counts and one of
// sums, for the prefix and again for the suffix. The sum of the k
// smallest numbers in so far is found by descending the trees by powers
// of two; the n largest of a suffix are its sum less its smallest
// len - n. O(n log n).

fn add(tree: mut ref Vec[i64], rank: i64, by: i64) {
    let mut i = rank + 1;
    while i < tree.len() {
        tree[i] += by;
        i += i & -i;
    }
}

// the sum of the k smallest numbers counted in `counts` and `sums`
fn smallest_sum(counts: Vec[i64], sums: Vec[i64], values: Vec[i64], k: i64) -> i64 {
    let size = counts.len() - 1;
    let mut step = 1;
    while step * 2 <= size {
        step *= 2;
    }
    let mut at = 0;
    let mut need = k;
    let mut total = 0;
    while step > 0 {
        if at + step <= size and counts[at + step] <= need {
            at += step;
            need -= counts[at];
            total += sums[at];
        }
        step /= 2;
    }
    // what is still needed are copies of the next value up
    if need > 0 {
        total += need * values[at];
    }
    total
}

fn minimum_difference(nums: Vec[i64]) -> i64 {
    let n = nums.len() / 3;
    let mut values = nums.clone();
    values.sort();
    values.dedup();
    let rank = |x: i64| values.binary_search(x).unwrap();
    let size = values.len() + 1;
    let mut counts: Vec[i64] = Vec.filled(size, 0);
    let mut sums: Vec[i64] = Vec.filled(size, 0);
    let mut left: Vec[i64] = Vec.new();
    for i in 0..2 * n {
        add(mut counts, rank(nums[i]), 1);
        add(mut sums, rank(nums[i]), nums[i]);
        if i >= n - 1 {
            left.push(smallest_sum(counts, sums, values, n));
        }
    }
    let mut counts: Vec[i64] = Vec.filled(size, 0);
    let mut sums: Vec[i64] = Vec.filled(size, 0);
    let mut suffix = 0;
    let mut best = i64.MAX;
    for i in (n..3 * n).rev() {
        add(mut counts, rank(nums[i]), 1);
        add(mut sums, rank(nums[i]), nums[i]);
        suffix += nums[i];
        if i <= 2 * n {
            let largest = suffix - smallest_sum(counts, sums, values, 3 * n - i - n);
            best = best.min(left[i - n] - largest);
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {minimum_difference(nums)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number a part, all the
    // same, rising, and falling
    show([3, 1, 2].to_vec());
    show([7, 9, 5, 8, 1, 3].to_vec());
    show([4, 4, 4].to_vec());
    show([6, 6, 6, 6, 6, 6].to_vec());
    show([1, 2, 3, 4, 5, 6, 7, 8, 9].to_vec());
    show([9, 8, 7, 6, 5, 4, 3, 2, 1].to_vec());
    // 2000 random lists of 3 to 15 numbers from 1 to 10, 100 or 10^5 in turn
    let mut seed = 2163;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 5 + 1;
        let most = [10, 100, 100000][round % 3];
        let nums: Vec[i64] = (0..3 * n).map(|_| wide_random(mut seed) % most + 1).collect();
        let d = minimum_difference(nums);
        total += d;
        check = (check * 31 + d + 1000000000) % 1000000007;
    }
    println(f"2000 lists: {total} in all, checksum {check}");
    // the constraints' largest, 300000 numbers: at random, and all one number
    let random: Vec[i64] = (0..300000).map(|_| wide_random(mut seed) % 100000 + 1).collect();
    println(f"300000 at random: {minimum_difference(random)}");
    let same: Vec[i64] = Vec.filled(300000, 100000);
    println(f"300000 the same: {minimum_difference(same)}");
}
