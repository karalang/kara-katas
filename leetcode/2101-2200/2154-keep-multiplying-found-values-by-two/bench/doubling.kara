// LeetCode #2154: Keep Multiplying Found Values by Two -- the benchmark's
// ★ arm: a window's numbers collected into a `Set`, and the start doubled
// for as long as the set holds it.

fn find_final_value(nums: Slice[i64], original: i64) -> i64 {
    let found: Set[i64] = nums.iter().cloned().collect();
    let mut value = original;
    while found.contains(value) {
        value *= 2;
    }
    value
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2154;
    let mut row: Vec[i64] = Vec.new();
    for _ in 0..400000 {
        row.push(next_random(mut seed) % 1000 + 1);
    }
    let mut check = 0;
    for _ in 0..20000 {
        let a = next_random(mut seed);
        let b = next_random(mut seed);
        let start = (a * 32768 + b) % 399001;
        let original = next_random(mut seed) % 1000 + 1;
        let value = find_final_value(row[start..(start + 1000)], original);
        check = (check * 31 + value) % 1000000007;
    }
    println(f"20000 solves: checksum {check}");
}
