// LeetCode #2154: Keep Multiplying Found Values by Two -- a `struct
// Ledger` of the numbers found, a `Map[i64, i64]` of how many times each
// was met, that `has` a value (`ref self`) and `follow`s a value up its
// chain of doubles. O(n + log of the greatest number).

struct Ledger {
    met: Map[i64, i64],
}

impl Ledger {
    fn of(nums: Vec[i64]) -> Ledger {
        let mut met: Map[i64, i64] = Map.new();
        for x in nums.iter() {
            *met.entry(x).or_insert(0) += 1;
        }
        Ledger { met }
    }

    fn has(ref self, value: i64) -> bool {
        self.met.get(value).unwrap_or(0) > 0
    }

    fn follow(ref self, start: i64) -> i64 {
        let mut value = start;
        while self.has(value) {
            value *= 2;
        }
        value
    }
}

fn find_final_value(nums: Vec[i64], original: i64) -> i64 {
    Ledger.of(nums).follow(original)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(nums: Vec[i64], original: i64) {
    println(f"{nums}, {original} -> {find_final_value(nums, original)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number found, every
    // power of two from 1, a chain broken at its first step, and the
    // constraints' greatest found
    show([5, 3, 6, 1, 12], 3);
    show([2, 7, 9], 4);
    show([1], 1);
    show((0..10).map(|k| 1 << k).collect(), 1);
    show([2, 4], 1);
    show([1000], 1000);
    // 2000 random lists of 1 to 15 numbers of 1 to 16, with a start of 1
    // to 4; and of a start's chain in part, shuffled among others, in turn
    let mut seed = 2154;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 15 + 1;
        let original = next_random(mut seed) % 4 + 1;
        let nums: Vec[i64] = if round % 2 == 0 {
            (0..n).map(|_| next_random(mut seed) % 16 + 1).collect()
        } else {
            let mut nums: Vec[i64] = (0..n).map(|k| if next_random(mut seed) % 4 == 0 { next_random(mut seed) % 100 + 1 } else { original << (k % 6) }).collect();
            for i in (1..n).rev() {
                let j = next_random(mut seed) % (i + 1);
                nums.swap(i, j);
            }
            nums
        };
        let last = find_final_value(nums, original);
        total += last;
        check = (check * 31 + last + n) % 1000000007;
    }
    println(f"2000 lists: {total} in all, checksum {check}");
    // the constraints' largest, 1000 numbers: every number from 1, every
    // number from 1 but 512, and at random, each from a start of 1
    let every: Vec[i64] = (1..1001).collect();
    let gap: Vec[i64] = (1..1001).map(|x| if x == 512 { 511 } else { x }).collect();
    let random: Vec[i64] = (0..1000).map(|_| next_random(mut seed) % 1000 + 1).collect();
    println(f"1000 numbers: {find_final_value(every, 1)} every one, {find_final_value(gap, 1)} but 512, {find_final_value(random, 1)} at random");
}
