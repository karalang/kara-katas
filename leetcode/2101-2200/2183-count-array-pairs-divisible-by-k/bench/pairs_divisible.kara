// LeetCode #2183: Count Array Pairs Divisible by K -- the benchmark's
// Kāra arm: the ★ arm, the numbers counted by their gcd with k and the
// gcds paired.

fn gcd(a: i64, b: i64) -> i64 {
    let mut a = a;
    let mut b = b;
    while b != 0 {
        let r = a % b;
        a = b;
        b = r;
    }
    a
}

fn count_pairs(nums: Vec[i64], k: i64) -> i64 {
    let mut by_gcd: Vec[i64] = Vec.filled(k + 1, 0);
    for x in nums.iter() {
        by_gcd[gcd(x, k)] += 1;
    }
    // the divisors of k that some number has as its gcd, found in pairs
    // d and k / d up to the square root
    let mut divisors: Vec[i64] = Vec.new();
    let mut d = 1;
    while d * d <= k {
        if k % d == 0 {
            if by_gcd[d] > 0 {
                divisors.push(d);
            }
            if d * d != k and by_gcd[k / d] > 0 {
                divisors.push(k / d);
            }
        }
        d += 1;
    }
    let mut pairs = 0;
    for a in 0..divisors.len() {
        for b in a..divisors.len() {
            let g = divisors[a];
            let h = divisors[b];
            if g * h % k == 0 {
                if a == b {
                    pairs += by_gcd[g] * (by_gcd[g] - 1) / 2;
                } else {
                    pairs += by_gcd[g] * by_gcd[h];
                }
            }
        }
    }
    pairs
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn big_random(seed: mut ref i64) -> i64 {
    let a = next_random(mut seed);
    let b = next_random(mut seed);
    a * 32768 + b
}

fn main() {
    let mut seed = 2183;
    let row: Vec[i64] = (0..1000000).map(|_| big_random(mut seed) % 100000 + 1).collect();
    let mut check = 0;
    for _ in 0..200 {
        let start = big_random(mut seed) % 900001;
        let k = big_random(mut seed) % 100000 + 1;
        let found = count_pairs(row[start..(start + 100000)].to_vec(), k);
        check = (check * 31 + found % 1000000007) % 1000000007;
    }
    println(f"200 solves: checksum {check}");
}
