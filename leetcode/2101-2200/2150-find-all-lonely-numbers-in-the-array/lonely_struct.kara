// LeetCode #2150: Find All Lonely Numbers in the Array -- a `struct
// Census` taken `of` the list, holding a `SortedMap` of counts, and
// asked how many times a number was `met` and whether it is `alone`
// (`ref self`); its numbers in order, kept when alone. O(n log n).

struct Census {
    counts: SortedMap[i64, i64],
}

impl Census {
    fn of(nums: Vec[i64]) -> Census {
        let mut counts: SortedMap[i64, i64] = SortedMap.new();
        for x in nums.iter() {
            counts.insert(x, counts.get(x).unwrap_or(0) + 1);
        }
        Census { counts }
    }

    fn met(ref self, x: i64) -> i64 {
        self.counts.get(x).unwrap_or(0)
    }

    fn alone(ref self, x: i64) -> bool {
        self.met(x) == 1 and self.met(x - 1) == 0 and self.met(x + 1) == 0
    }
}

fn find_lonely(nums: Vec[i64]) -> Vec[i64] {
    let census = Census.of(nums);
    let mut out: Vec[i64] = Vec.new();
    for x in census.counts.keys() {
        if census.alone(x) {
            out.push(x);
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the lonely numbers in ascending order, since any order is allowed
fn lonely(nums: Vec[i64]) -> Vec[i64] {
    let mut out = find_lonely(nums);
    out.sort();
    out
}

fn show(nums: Vec[i64]) {
    println(f"{nums} -> {lonely(nums)}");
}

fn main() {
    // LeetCode's two examples, then four more: one number, one number
    // twice, a run with no gap, and 0 beside the constraints' greatest
    show([10, 6, 5, 8].to_vec());
    show([1, 3, 5, 3].to_vec());
    show([7].to_vec());
    show([7, 7].to_vec());
    show([4, 2, 3, 5].to_vec());
    show([0, 1000000, 2, 999998].to_vec());
    // 2000 random lists of 1 to 12 numbers of 0 to 9, of 0 to 30 and of 0
    // to 1000 in turn
    let mut seed = 2150;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let top = [10, 31, 1001][round % 3];
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top).collect();
        let out = lonely(nums);
        total += out.len();
        for x in out.iter() {
            check = (check * 31 + x + 1) % 1000000007;
        }
        check = (check * 31 + n) % 1000000007;
    }
    println(f"2000 lists: {total} lonely in all, checksum {check}");
    // the constraints' largest, 100000 numbers: every even number from 0,
    // every number from 0 once and the first half again, and at random
    // from the whole range
    let evens: Vec[i64] = (0..100000).map(|i| 2 * i).collect();
    let runs: Vec[i64] = (0..100000).map(|i| if i < 66667 { i } else { i - 66667 }).collect();
    let random: Vec[i64] = (0..100000).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000001).collect();
    for (name, nums) in [("evens", evens), ("runs", runs), ("at random", random)] {
        let out = lonely(nums);
        let mut sum = 0;
        for x in out.iter() {
            sum = (sum * 31 + x + 1) % 1000000007;
        }
        println(f"100000 numbers {name}: {out.len()} lonely, checksum {sum}");
    }
}
