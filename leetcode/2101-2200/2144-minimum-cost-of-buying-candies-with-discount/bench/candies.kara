// LeetCode #2144: Minimum Cost of Buying Candies With Discount -- the
// benchmark, candies.kara's ★ arm. 1000 baskets of 100 candies of 1 to
// 100 built once; then every basket solved 100 times, one candy redrawn
// before each solve.

fn minimum_cost(cost: Vec[i64]) -> i64 {
    let mut dearest_first = cost.clone();
    dearest_first.sort_by(|a, b| b.cmp(a));
    dearest_first.iter().enumerate().filter(|(i, _)| i % 3 != 2).map(|(_, c)| c).sum()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2144;
    let mut baskets: Vec[Vec[i64]] = Vec.new();
    for _ in 0..1000 {
        let cost: Vec[i64] = (0..100).map(|_| next_random(mut seed) % 100 + 1).collect();
        baskets.push(cost);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..100 {
        for b in 0..1000 {
            let at = next_random(mut seed) % 100;
            baskets[b][at] = next_random(mut seed) % 100 + 1;
            let paid = minimum_cost(baskets[b]);
            total += paid;
            check = (check * 31 + paid + round) % 1000000007;
        }
    }
    println(f"100000 solves: {total} paid in all, checksum {check}");
}
