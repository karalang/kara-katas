// LeetCode #2144: Minimum Cost of Buying Candies With Discount -- a `struct
// Till` that `ring`s up the candies dearest first (`mut ref self`), each
// two paid for earning the next one free, and gives the `total` (`ref
// self`). O(n log n).

struct Till {
    paid: i64,
    earned: i64,
}

impl Till {
    fn ring(mut ref self, price: i64) {
        if self.earned == 2 {
            self.earned = 0;
        } else {
            self.paid += price;
            self.earned += 1;
        }
    }

    fn total(ref self) -> i64 {
        self.paid
    }
}

fn minimum_cost(cost: Vec[i64]) -> i64 {
    let mut dearest_first = cost.clone();
    dearest_first.sort_by(|a, b| b.cmp(a));
    let mut till = Till { paid: 0, earned: 0 };
    for price in dearest_first.iter() {
        till.ring(price);
    }
    till.total()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(cost: Vec[i64]) {
    println(f"{cost} -> {minimum_cost(cost)}");
}

fn main() {
    // LeetCode's three examples, then three more: one candy, three equal,
    // and a free candy as cheap as the cheaper of the two bought
    show([1, 2, 3].to_vec());
    show([6, 5, 7, 9, 2, 2].to_vec());
    show([5, 5].to_vec());
    show([1].to_vec());
    show([3, 3, 3].to_vec());
    show([100, 1, 1].to_vec());
    // 2000 random baskets of 1 to 20 candies of 1 to 100 or 1 to 5 in turn
    let mut seed = 2144;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let n = next_random(mut seed) % 20 + 1;
        let top = [100, 5][round % 2];
        let cost: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let paid = minimum_cost(cost);
        total += paid;
        check = (check * 31 + paid + n) % 1000000007;
    }
    println(f"2000 baskets: {total} paid in all, checksum {check}");
    // the constraints' largest, 100 candies: every one 100, one of each
    // price from 1 to 100, and at random
    let full: Vec[i64] = Vec.filled(100, 100);
    let every: Vec[i64] = (1..101).collect();
    let random: Vec[i64] = (0..100).map(|_| next_random(mut seed) % 100 + 1).collect();
    println(f"100 candies: {minimum_cost(full)} all 100, {minimum_cost(every)} one of each, {minimum_cost(random)} at random");
}
