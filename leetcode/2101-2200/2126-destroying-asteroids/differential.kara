// LeetCode #2126: Destroying Asteroids -- the differential. The six
// arms, against the statement read literally: the asteroids may be hit
// in any order, so every set of them the planet can destroy in some order
// is found, one asteroid at a time from the empty set; the answer is
// whether the set of all of them is among those. 300 random cases, a
// mass of 1 to 10 and 1 to 8 asteroids of up to 5, 15 or 40 in turn;
// then 30 of up to 10 asteroids that double, each perhaps one heavier;
// then 30 of up to 8 asteroids of one mass; every one drawn before any
// arm answers.
//
// P1  the answer is the statement read literally
// P2  the asteroids in reverse order: the same answer
// P3  a planet one heavier: true if this one is; a planet as heavy as
//     the heaviest asteroid: true
// P4  an asteroid as heavy as the planet and every asteroid together
//     added at the front: the same answer
// P5  the planet and every asteroid twice as heavy: the same answer
// P6  each arm agrees with at least three of the other five

// ---- asteroids.kara: the ★ arm, sorted, lightest first
fn star_asteroids_destroyed(mass: i64, asteroids: Vec[i64]) -> bool {
    let mut sorted = asteroids.clone();
    sorted.sort();
    let mut planet = mass;
    for a in sorted.iter() {
        if planet < a {
            return false;
        }
        planet += a;
    }
    true
}

// ---- asteroids_heap.kara: a `PriorityQueue`, smallest first, with an early answer
fn heap_asteroids_destroyed(mass: i64, asteroids: Vec[i64]) -> bool {
    let heaviest = asteroids.iter().max().unwrap_or(0);
    let mut heap = PriorityQueue.from(asteroids.clone());
    let mut planet = mass;
    while let Some(a) = heap.pop() {
        if planet >= heaviest {
            return true;
        }
        if planet < a {
            return false;
        }
        planet += a;
    }
    true
}

// ---- asteroids_counts.kara: a `SortedMap` of counts by mass
fn counts_asteroids_destroyed(mass: i64, asteroids: Vec[i64]) -> bool {
    let mut counts: SortedMap[i64, i64] = SortedMap.new();
    for a in asteroids.iter() {
        *counts.entry(a).or_insert(0) += 1;
    }
    let mut planet = mass;
    for (a, k) in counts.iter() {
        if planet < a {
            return false;
        }
        planet += a * k;
    }
    true
}

// ---- asteroids_iter.kara: `try_fold` over the sorted masses
fn iter_asteroids_destroyed(mass: i64, asteroids: Vec[i64]) -> bool {
    let mut sorted = asteroids.clone();
    sorted.sort();
    sorted
        .iter()
        .try_fold(mass, |planet, a| if planet >= a { Some(planet + a) } else { None })
        .is_some()
}

// ---- asteroids_struct.kara: a `Planet` that absorbs one asteroid at a time
struct StructPlanet {
    mass: i64,
}

impl StructPlanet {
    fn absorb(mut ref self, asteroid: i64) -> bool {
        if self.mass < asteroid {
            return false;
        }
        self.mass += asteroid;
        true
    }
}

fn struct_asteroids_destroyed(mass: i64, asteroids: Vec[i64]) -> bool {
    let mut sorted = asteroids.clone();
    sorted.sort();
    let mut planet = StructPlanet { mass: mass };
    sorted.iter().all(|a| planet.absorb(a))
}

// ---- asteroids_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn asteroids_destroyed(mass: i32, asteroids: own Vec[i32]) -> bool {
        let mut asteroids = asteroids;
        asteroids.sort();
        let mut m = mass as i64;
        for a in asteroids {
            if m < a {
                return false;
            }
            m += a;
        }
        true
    }
}

struct SolutionSolution {}

fn solution_asteroids_destroyed(mass: i64, asteroids: Vec[i64]) -> bool {
    SolutionSolution.asteroids_destroyed(mass as i32, asteroids.iter().map(|a| a as i32).collect())
}

// ---- the statement read literally

fn literal(mass: i64, asteroids: Vec[i64]) -> bool {
    let n = asteroids.len();
    let full = (1 << n) - 1;
    let mut reached: Vec[bool] = Vec.filled(full + 1, false);
    reached[0] = true;
    for set in 0..full + 1 {
        if not reached[set] {
            continue;
        }
        let mut planet = mass;
        for i in 0..n {
            if set & (1 << i) != 0 {
                planet += asteroids[i];
            }
        }
        for i in 0..n {
            if set & (1 << i) == 0 and planet >= asteroids[i] {
                reached[set | (1 << i)] = true;
            }
        }
    }
    reached[full]
}

fn answer(arm: i64, mass: i64, asteroids: Vec[i64]) -> bool {
    match arm {
        0 => star_asteroids_destroyed(mass, asteroids),
        1 => heap_asteroids_destroyed(mass, asteroids),
        2 => counts_asteroids_destroyed(mass, asteroids),
        3 => iter_asteroids_destroyed(mass, asteroids),
        4 => struct_asteroids_destroyed(mass, asteroids),
        _ => solution_asteroids_destroyed(mass, asteroids),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "heap", "counts", "iter", "struct", "solution"];
    let mut seed = 2126;
    let mut problems: Vec[(i64, Vec[i64])] = Vec.new();
    for t in 0..360 {
        let mut asteroids: Vec[i64] = Vec.new();
        let mut mass = 1;
        if t < 300 {
            mass = next_random(mut seed) % 10 + 1;
            let n = next_random(mut seed) % 8 + 1;
            let top = [5, 15, 40][t % 3];
            for _ in 0..n {
                asteroids.push(next_random(mut seed) % top + 1);
            }
        } else if t < 330 {
            mass = next_random(mut seed) % 3 + 1;
            let n = next_random(mut seed) % 10 + 1;
            let mut a = mass;
            for _ in 0..n {
                asteroids.push(a + next_random(mut seed) % 2);
                a *= 2;
            }
            for i in 0..asteroids.len() {
                let j = next_random(mut seed) % asteroids.len();
                asteroids.swap(i, j);
            }
        } else {
            mass = next_random(mut seed) % 6 + 1;
            let n = next_random(mut seed) % 8 + 1;
            let a = next_random(mut seed) % 8 + 1;
            for _ in 0..n {
                asteroids.push(a);
            }
        }
        problems.push((mass, asteroids));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (mass, asteroids) in problems.iter() {
        let truth = literal(mass, asteroids);
        check = (check * 31 + mass * 2 + asteroids.len() * 3 + if truth { 1 } else { 0 }) % 1000000007;
        let reversed: Vec[i64] = asteroids.iter().rev().collect();
        let heaviest = asteroids.iter().max().unwrap_or(0);
        let mut fronted = [mass + asteroids.iter().sum()].to_vec();
        fronted.extend(asteroids.iter());
        let doubled: Vec[i64] = asteroids.iter().map(|a| 2 * a).collect();
        let got: Vec[bool] = (0..6).map(|arm| answer(arm, mass, asteroids)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, mass, reversed) == x,
                (answer(arm, mass + 1, asteroids) or not x) and answer(arm, heaviest, asteroids),
                answer(arm, mass, fronted) == x,
                answer(arm, 2 * mass, doubled) == x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"mass {mass}, {asteroids} arm {names[arm]}: P{q + 1} fails, answered {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
