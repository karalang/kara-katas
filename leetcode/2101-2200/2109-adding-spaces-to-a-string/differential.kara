// LeetCode #2109: Adding Spaces to a String -- the differential. The
// six arms, against the statement read literally: each letter in turn,
// a space before it when its place is among `spaces`, found by a search
// of all of them. 300 random strings of 1 to 12 letters with a space
// before each with odds of one in three; then 30 of up to 300 letters
// with odds of one in two; then 30 of up to 50 letters with a space
// before every letter or before the first only; every one drawn before
// any arm answers, and each with at least one space.
//
// P1  the answer is the statement read literally
// P2  the answer is `n + k` long, holds `k` spaces, and is `s` once they
//     are taken out
// P3  every letter's case swapped: the answer's case swapped
// P4  the last space left out: the answer with that space taken out
// P5  a `Z` appended to `s`: the answer with a `Z` appended
// P6  each arm agrees with at least three of the other five

// ---- spaces.kara: the ★ arm, one walk with an index into the spaces
fn star_add_spaces(s: String, spaces: Vec[i64]) -> String {
    let mut out = String.with_capacity(s.len() + spaces.len());
    let mut next = 0;
    for (i, c) in s.chars().enumerate() {
        if next < spaces.len() and spaces[next] == i {
            out.push(' ');
            next += 1;
        }
        out.push(c);
    }
    out
}

// ---- spaces_slices.kara: the pieces between spaces, joined
fn slices_add_spaces(s: String, spaces: Vec[i64]) -> String {
    let mut pieces: Vec[String] = Vec.new();
    let mut last = 0;
    for p in spaces.iter() {
        pieces.push(s[last..p].to_string());
        last = p;
    }
    pieces.push(s[last..].to_string());
    pieces.join(" ")
}

// ---- spaces_bytes.kara: a `Vec[u8]` made a `String`
fn bytes_add_spaces(s: String, spaces: Vec[i64]) -> String {
    let bytes = s.bytes();
    let mut out: Vec[u8] = Vec.with_capacity(bytes.len() + spaces.len());
    let mut i = 0;
    let mut next = 0;
    while i < bytes.len() {
        if next < spaces.len() and spaces[next] == i {
            out.push(b' ');
            next += 1;
        }
        out.push(bytes[i]);
        i += 1;
    }
    String.from_utf8(out).unwrap()
}

// ---- spaces_set.kara: a `Set` of places and `flat_map`
fn set_add_spaces(s: String, spaces: Vec[i64]) -> String {
    let marks: Set[i64] = spaces.iter().collect();
    let out: String = s
        .chars()
        .enumerate()
        .flat_map(|(i, c)| if marks.contains(i) { [' ', c].to_vec() } else { [c].to_vec() }.into_iter())
        .collect();
    out
}

// ---- spaces_iterator.kara: a `Spaced` iterator
struct IteratorSpaced {
    letters: Vec[char],
    spaces: Vec[i64],
    at: i64,
    next_space: i64,
}

impl Iterator for IteratorSpaced {
    type Item = char;

    fn next(mut ref self) -> Option[char] {
        if self.at >= self.letters.len() {
            return None;
        }
        if self.next_space < self.spaces.len() and self.spaces[self.next_space] == self.at {
            self.next_space += 1;
            return Some(' ');
        }
        let c = self.letters[self.at];
        self.at += 1;
        Some(c)
    }
}

fn iterator_add_spaces(s: String, spaces: Vec[i64]) -> String {
    let spaced = IteratorSpaced { letters: s.chars().collect(), spaces: spaces.clone(), at: 0, next_space: 0 };
    spaced.collect()
}

// ---- spaces_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn add_spaces(s: String, spaces: Vec[i32]) -> String {
        let mut ans = String.with_capacity(s.len() + spaces.len());
        let mut last = 0;
        for sp in spaces.iter() {
            let sp = sp as i64;
            ans.push_str(s[last..sp]);
            ans.push(' ');
            last = sp;
        }
        ans.push_str(s[last..]);
        ans
    }
}

struct SolutionSolution {}

fn solution_add_spaces(s: String, spaces: Vec[i64]) -> String {
    SolutionSolution.add_spaces(s, spaces.iter().map(|p| p as i32).collect())
}

// ---- the statement read literally

fn literal(s: String, spaces: Vec[i64]) -> String {
    let mut out = String.new();
    for (i, c) in s.chars().enumerate() {
        for p in spaces.iter() {
            if p == i {
                out.push(' ');
            }
        }
        out.push(c);
    }
    out
}

fn answer(arm: i64, s: String, spaces: Vec[i64]) -> String {
    match arm {
        0 => star_add_spaces(s, spaces),
        1 => slices_add_spaces(s, spaces),
        2 => bytes_add_spaces(s, spaces),
        3 => set_add_spaces(s, spaces),
        4 => iterator_add_spaces(s, spaces),
        _ => solution_add_spaces(s, spaces),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn swapped(s: String) -> String {
    String.from_iter(s.chars().map(|c| if c.is_lowercase() { c.to_ascii_uppercase() } else { c.to_ascii_lowercase() }))
}

fn main() {
    let names = ["star", "slices", "bytes", "set", "iterator", "solution"];
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".chars().collect();
    let mut seed = 2109;
    let mut problems: Vec[(String, Vec[i64])] = Vec.new();
    for t in 0..360 {
        let n = if t < 300 {
            next_random(mut seed) % 12 + 1
        } else if t < 330 {
            next_random(mut seed) % 300 + 1
        } else {
            next_random(mut seed) % 50 + 1
        };
        let mut s = String.new();
        let mut spaces: Vec[i64] = Vec.new();
        for i in 0..n {
            s.push(letters[next_random(mut seed) % 52]);
            let due = if t < 300 {
                next_random(mut seed) % 3 == 0
            } else if t < 330 {
                next_random(mut seed) % 2 == 0
            } else {
                t % 2 == 0 or i == 0
            };
            if due {
                spaces.push(i);
            }
        }
        if spaces.is_empty() {
            spaces.push(next_random(mut seed) % n);
        }
        problems.push((s, spaces));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (s, spaces) in problems.iter() {
        let truth = literal(s, spaces);
        for c in truth.chars() {
            check = (check * 31 + c as i64) % 1000000007;
        }
        let k = spaces.len();
        let fewer: Vec[i64] = spaces[..k - 1].to_vec();
        let last_at = spaces[k - 1] + k - 1;
        let longer = s.clone() + "Z";
        let got: Vec[String] = (0..6).map(|arm| answer(arm, s, spaces)).collect();
        for arm in 0..6 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let letters_only = String.from_iter(x.chars().filter(|c| c != ' '));
            let blanks = x.chars().filter(|c| c == ' ').count();
            let without_last = String.from_iter(x.chars().enumerate().filter(|(i, _)| i != last_at).map(|(_, c)| c));
            let verdicts = [
                x == truth,
                x.len() == s.len() + k and blanks == k and letters_only == s,
                answer(arm, swapped(s), spaces) == swapped(x),
                k == 1 or answer(arm, s, fewer) == without_last,
                answer(arm, longer, spaces) == x.clone() + "Z",
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"\"{s}\" {spaces} arm {names[arm]}: P{q + 1} fails, answer \"{x}\", literal \"{truth}\"");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} strings: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
