// LeetCode #2109: Adding Spaces to a String -- the benchmark,
// spaces.kara's ★ arm: one walk over the letters with an index into the
// spaces. 20 strings of 3 * 10^5 letters, each with a space due before a
// letter with odds of one in three, are built once; each is then spaced
// 5 times.

fn add_spaces(s: String, spaces: Vec[i64]) -> String {
    let mut out = String.with_capacity(s.len() + spaces.len());
    let mut next = 0;
    for (i, c) in s.chars().enumerate() {
        if next < spaces.len() and spaces[next] == i {
            out.push(' ');
            next += 1;
        }
        out.push(c);
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".chars().collect();
    let mut seed = 2109;
    let mut rows: Vec[(String, Vec[i64])] = Vec.new();
    for _ in 0..20 {
        let mut s = String.new();
        let mut spaces: Vec[i64] = Vec.new();
        for i in 0..300000 {
            s.push(letters[next_random(mut seed) % 52]);
            if next_random(mut seed) % 3 == 0 {
                spaces.push(i);
            }
        }
        rows.push((s, spaces));
    }
    let mut total = 0;
    let mut check = 0;
    for (s, spaces) in rows.iter() {
        for _ in 0..5 {
            let got = add_spaces(s, spaces);
            total += got.len();
            let b = got.bytes();
            let mut j = 0;
            while j < b.len() {
                check = (check * 31 + b[j]) % 1000000007;
                j += 997;
            }
        }
    }
    println(f"100 strings: {total} characters, checksum {check}");
}
