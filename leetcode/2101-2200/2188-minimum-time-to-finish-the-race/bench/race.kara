// LeetCode #2188: Minimum Time to Finish the Race -- the benchmark's
// Kāra arm: the ★ arm, the runs on one tire, then the laps bottom up.

fn minimum_finish_time(tires: Vec[Vec[i64]], change_time: i64, num_laps: i64) -> i64 {
    // run[k]: the least time for k laps on one tire, for as many k as pay
    let mut run: Vec[i64] = [0].to_vec();
    for tire in tires.iter() {
        let f = tire[0];
        let r = tire[1];
        let mut lap = f;
        let mut sum = 0;
        let mut k = 1;
        while k <= num_laps and lap <= change_time + f {
            sum += lap;
            if k == run.len() {
                run.push(sum);
            } else if sum < run[k] {
                run[k] = sum;
            }
            lap *= r;
            k += 1;
        }
    }
    // best[n]: the least time for n laps, each run after the first
    // paying for a change
    let mut best: Vec[i64] = Vec.filled(num_laps + 1, 0);
    for n in 1..=num_laps {
        let mut least = run[1] * n + change_time * (n - 1);
        let mut k = 1;
        while k < run.len() and k <= n {
            let pit = if k == n { 0 } else { change_time };
            least = least.min(best[n - k] + pit + run[k]);
            k += 1;
        }
        best[n] = least;
    }
    best[num_laps]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn big_random(seed: mut ref i64) -> i64 {
    let a = next_random(mut seed);
    let b = next_random(mut seed);
    a * 32768 + b
}

fn main() {
    let mut seed = 2188;
    let mut row: Vec[Vec[i64]] = Vec.new();
    for _ in 0..100000 {
        let f = big_random(mut seed) % 100 + 1;
        let r = next_random(mut seed) % 4 + 2;
        row.push([f, r].to_vec());
    }
    let mut check = 0;
    for _ in 0..5000 {
        let start = big_random(mut seed) % 99901;
        let change_time = big_random(mut seed) % 100000 + 1;
        let num_laps = 1000;
        let t = minimum_finish_time(row[start..(start + 100)].to_vec(), change_time, num_laps);
        check = (check * 31 + t % 1000000007) % 1000000007;
    }
    println(f"5000 solves: checksum {check}");
}
