// LeetCode #2188: Minimum Time to Finish the Race -- the ★ arm: the
// least time to run k laps on one tire without a change, for each k
// while some tire's next lap is still cheaper than a change and a fresh
// first lap; then the laps laid out as runs between changes, the least
// time for each number of laps from the least for fewer. A run never
// needs more laps than about 18, as a lap's time doubles at least each
// lap. O(tires * 18 + laps * 18).

fn minimum_finish_time(tires: Vec[Vec[i64]], change_time: i64, num_laps: i64) -> i64 {
    // run[k]: the least time for k laps on one tire, for as many k as pay
    let mut run: Vec[i64] = [0].to_vec();
    for tire in tires.iter() {
        let f = tire[0];
        let r = tire[1];
        let mut lap = f;
        let mut sum = 0;
        let mut k = 1;
        while k <= num_laps and lap <= change_time + f {
            sum += lap;
            if k == run.len() {
                run.push(sum);
            } else if sum < run[k] {
                run[k] = sum;
            }
            lap *= r;
            k += 1;
        }
    }
    // best[n]: the least time for n laps, each run after the first
    // paying for a change
    let mut best: Vec[i64] = Vec.filled(num_laps + 1, 0);
    for n in 1..=num_laps {
        let mut least = run[1] * n + change_time * (n - 1);
        let mut k = 1;
        while k < run.len() and k <= n {
            let pit = if k == n { 0 } else { change_time };
            least = least.min(best[n - k] + pit + run[k]);
            k += 1;
        }
        best[n] = least;
    }
    best[num_laps]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn big_random(seed: mut ref i64) -> i64 {
    let a = next_random(mut seed);
    let b = next_random(mut seed);
    a * 32768 + b
}

fn show(tires: Vec[Vec[i64]], change_time: i64, num_laps: i64) {
    println(f"{tires}, {change_time}, {num_laps} -> {minimum_finish_time(tires, change_time, num_laps)}");
}

fn main() {
    // LeetCode's two examples, then four more: one lap, a change too
    // dear to make, a change cheaper than any second lap, and the
    // constraints' largest of every number on one tire
    show([[2, 3].to_vec(), [3, 4].to_vec()].to_vec(), 5, 4);
    show([[1, 10].to_vec(), [2, 2].to_vec(), [3, 4].to_vec()].to_vec(), 6, 5);
    show([[7, 2].to_vec()].to_vec(), 3, 1);
    show([[1, 2].to_vec()].to_vec(), 100000, 10);
    show([[5, 100000].to_vec(), [6, 2].to_vec()].to_vec(), 1, 6);
    show([[100000, 100000].to_vec()].to_vec(), 100000, 1000);
    // 2000 random races of 1 to 10 tires: small numbers and 1 to 20 laps,
    // and numbers up to the constraints' and 1 to 1000 laps, in turn
    let mut seed = 2188;
    let mut total = 0;
    let mut check = 0;
    for round in 0..2000 {
        let big = round % 2 == 1;
        let n = next_random(mut seed) % 10 + 1;
        let mut tires: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            let f = if big { big_random(mut seed) % 100000 + 1 } else { next_random(mut seed) % 10 + 1 };
            let r = if big { big_random(mut seed) % 99999 + 2 } else { next_random(mut seed) % 4 + 2 };
            tires.push([f, r].to_vec());
        }
        let change_time = if big { big_random(mut seed) % 100000 + 1 } else { next_random(mut seed) % 20 + 1 };
        let num_laps = if big { next_random(mut seed) % 1000 + 1 } else { next_random(mut seed) % 20 + 1 };
        let best = minimum_finish_time(tires, change_time, num_laps);
        total = (total + best) % 1000000007;
        check = (check * 31 + best % 1000000007 + n) % 1000000007;
    }
    println(f"2000 races: {total} in all, checksum {check}");
    // the constraints' largest, 10^5 tires and 1000 laps: every tire
    // [1, 2] with a change of 1, and tires at random with a change of
    // 10^5 and of 1
    let mut alike: Vec[Vec[i64]] = Vec.new();
    let mut mixed: Vec[Vec[i64]] = Vec.new();
    for _ in 0..100000 {
        alike.push([1, 2].to_vec());
        let f = big_random(mut seed) % 100000 + 1;
        let r = big_random(mut seed) % 99999 + 2;
        mixed.push([f, r].to_vec());
    }
    println(f"10^5 tires: {minimum_finish_time(alike, 1, 1000)} {minimum_finish_time(mixed, 100000, 1000)} {minimum_finish_time(mixed, 1, 1000)}");
}
