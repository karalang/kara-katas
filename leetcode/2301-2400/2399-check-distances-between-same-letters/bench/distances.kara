// LeetCode #2399: Check Distances Between Same Letters -- the bench, the
// ★ arm: the first index of each letter, checked at its second.

fn check_distances(s: String, distance: Vec[i64]) -> bool {
    let mut first: Vec[i64] = Vec.filled(26, -1);
    let b = s.bytes();
    for i in 0..b.len() {
        let c = (b[i] - b'a') as i64;
        if first[c] < 0 {
            first[c] = i;
        } else if i - first[c] - 1 != distance[c] {
            return false;
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// All 26 letters, each twice, shuffled, and the distances true of it;
// when `off`, one letter's distance is one away from its true one.
fn case(seed: mut ref i64, off: bool) -> (String, Vec[i64]) {
    let mut b: Vec[u8] = Vec.new();
    for i in 0..52 {
        b.push(b'a' + (i / 2) as u8);
    }
    for i in 1..52 {
        let j = next_random(mut seed) % (i + 1);
        let x = b[i];
        b[i] = b[j];
        b[j] = x;
    }
    let mut distance: Vec[i64] = Vec.filled(26, 0);
    let mut first: Vec[i64] = Vec.filled(26, -1);
    for i in 0..52 {
        let c = (b[i] - b'a') as i64;
        if first[c] < 0 {
            first[c] = i;
        } else {
            distance[c] = i - first[c] - 1;
        }
    }
    if off {
        let letter = next_random(mut seed) % 26;
        distance[letter] += if distance[letter] == 0 {
            1
        } else {
            -1
        };
    }
    (String.from_utf8(b).unwrap(), distance)
}

fn main() {
    // 1000 strings, every other one with a distance off by one; each pass
    // answers them all and folds every answer, plus the pass
    let mut seed = 2399;
    let cases: Vec[(String, Vec[i64])] = (0..1000).map(|i| case(mut seed, i % 2 == 1)).collect();
    let mut check = 0;
    let mut yes = 0;
    for p in 0..2000 {
        for c in cases.iter() {
            let (s, distance) = c;
            let answer = check_distances(s, distance);
            if answer {
                yes += 1;
            }
            check = (check * 31 + if answer {
                2
            } else {
                1
            } + p) % 1000000007;
        }
    }
    println(f"2000 passes over 1000 strings of 52 letters: checksum {check}, {yes} yes");
}
