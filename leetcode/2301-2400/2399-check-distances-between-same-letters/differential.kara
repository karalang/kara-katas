// LeetCode #2399: Check Distances Between Same Letters -- the
// differential. The six arms, against the statement read literally: for
// every two indexes holding the same letter, the letters strictly between
// them are counted one by one and compared with that letter's distance.
// No first-index table. 360 random strings of 1 to 26 distinct letters,
// each twice, shuffled; a third with every distance true, a third with
// one letter's off by one, and a third with one letter's drawn at random.
// Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the letters renamed one along the alphabet, and the distances with
//     them: the same answer
// P3  the string reversed: the same answer
// P4  the distances of letters not in the string changed: the same
//     answer
// P5  when the answer is yes, one letter's distance one more: no
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn distances_literally(s: String, distance: Vec[i64]) -> bool {
    let b = s.bytes();
    for i in 0..b.len() {
        for j in i + 1..b.len() {
            if b[i] == b[j] {
                let mut between = 0;
                for _ in i + 1..j {
                    between += 1;
                }
                if between != distance[b[i] - b'a'] {
                    return false;
                }
            }
        }
    }
    true
}

// ---- star (distances.kara) -----------------------------------------------

fn star_check_distances(s: String, distance: Vec[i64]) -> bool {
    let mut first: Vec[i64] = Vec.filled(26, -1);
    let b = s.bytes();
    for i in 0..b.len() {
        let c = (b[i] - b'a') as i64;
        if first[c] < 0 {
            first[c] = i;
        } else if i - first[c] - 1 != distance[c] {
            return false;
        }
    }
    true
}

// ---- letters (distances_letters.kara) ------------------------------------

fn letters_check_distances(s: String, distance: Vec[i64]) -> bool {
    let b = s.bytes();
    for c in 0..26 {
        let letter = b'a' + c as u8;
        let mut first = 0;
        while first < b.len() and b[first] != letter {
            first += 1;
        }
        if first == b.len() {
            continue;
        }
        let mut last = b.len() - 1;
        while b[last] != letter {
            last -= 1;
        }
        if last - first - 1 != distance[c] {
            return false;
        }
    }
    true
}

// ---- map (distances_map.kara) --------------------------------------------

fn map_check_distances(s: String, distance: Vec[i64]) -> bool {
    let mut seen: Map[char, i64] = Map.new();
    let mut i = 0;
    for c in s.chars() {
        match seen.get(c) {
            Some(j) => {
                let letter = (c as u32 - 'a' as u32) as i64;
                if i - j - 1 != distance[letter] {
                    return false;
                }
            },
            None => {
                seen.insert(c, i);
            },
        }
        i += 1;
    }
    true
}

// ---- sort (distances_sort.kara) ------------------------------------------

fn sort_check_distances(s: String, distance: Vec[i64]) -> bool {
    let b = s.bytes();
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for i in 0..b.len() {
        pairs.push(((b[i] - b'a') as i64, i));
    }
    pairs.sort();
    let mut k = 0;
    while k < pairs.len() {
        let (c, first) = pairs[k];
        let (_, second) = pairs[k + 1];
        if second - first - 1 != distance[c] {
            return false;
        }
        k += 2;
    }
    true
}

// ---- iter (distances_iter.kara) ------------------------------------------

fn iter_check_distances(s: String, distance: Vec[i64]) -> bool {
    let b = s.bytes();
    b.iter().enumerate().all(|(i, c)| {
        let first = b.iter().position(|x| x == c).unwrap();
        let partner = i + distance[c - b'a'] + 1;
        first != i or partner < b.len() and b[partner] == c
    })
}

// ---- solution (distances_solution.kara) ----------------------------------

struct Solution {}

impl Solution {
    pub fn check_distances(s: String, distance: Vec[i32]) -> bool {
        let mut first = [-1i32; 26];
        for (i, c) in s.bytes().iter().enumerate() {
            let k = (c - b'a') as usize;
            if first[k] < 0 {
                first[k] = i as i32;
            } else if i as i32 - first[k] - 1 != distance[k] {
                return false;
            }
        }
        true
    }
}

fn solution_check_distances(s: String, distance: Vec[i64]) -> bool {
    let distance: Vec[i32] = distance.iter().map(|v| v as i32).collect();
    Solution.check_distances(s, distance)
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, s: String, distance: Vec[i64]) -> bool {
    match arm {
        0 => star_check_distances(s, distance),
        1 => letters_check_distances(s, distance),
        2 => map_check_distances(s, distance),
        3 => sort_check_distances(s, distance),
        4 => iter_check_distances(s, distance),
        _ => solution_check_distances(s, distance),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "letters", "map", "sort", "iter", "solution"];
    let mut seed = 2399;
    let mut cases: Vec[(String, Vec[i64])] = Vec.new();
    for t in 0..360 {
        let m = 1 + next_random(mut seed) % 26;
        let mut letters: Vec[i64] = (0..26).collect();
        for i in 1..26 {
            let j = next_random(mut seed) % (i + 1);
            let x = letters[i];
            letters[i] = letters[j];
            letters[j] = x;
        }
        let mut b: Vec[u8] = Vec.new();
        for i in 0..m {
            b.push(b'a' + letters[i] as u8);
            b.push(b'a' + letters[i] as u8);
        }
        for i in 1..b.len() {
            let j = next_random(mut seed) % (i + 1);
            let x = b[i];
            b[i] = b[j];
            b[j] = x;
        }
        let mut distance: Vec[i64] = (0..26).map(|_| next_random(mut seed) % 50).collect();
        let mut first: Vec[i64] = Vec.filled(26, -1);
        for i in 0..b.len() {
            let c = b[i] - b'a';
            if first[c] < 0 {
                first[c] = i;
            } else {
                distance[c] = i - first[c] - 1;
            }
        }
        let letter = b[next_random(mut seed) % b.len()] - b'a';
        if t % 3 == 1 {
            distance[letter] += if distance[letter] == 0 {
                1
            } else {
                -1
            };
        } else if t % 3 == 2 {
            distance[letter] = next_random(mut seed) % 50;
        }
        cases.push((String.from_utf8(b).unwrap(), distance));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (s, distance) = cases[c].clone();
        let b = s.bytes();
        let truth = distances_literally(s, distance);
        check = (check * 31 + if truth {
            2
        } else {
            1
        }) % 1000000007;
        let renamed = String.from_utf8(b.iter().map(|x| b'a' + (x - b'a' + 1) % 26).collect()).unwrap();
        let moved: Vec[i64] = (0..26).map(|i| distance[(i + 25) % 26]).collect();
        let mut backwards = b.to_vec();
        backwards.reverse();
        let reversed = String.from_utf8(backwards).unwrap();
        let mut absent = distance.clone();
        for i in 0..26 {
            if not b.contains(b'a' + i as u8) {
                absent[i] = (absent[i] + 7) % 50;
            }
        }
        let mut off = distance.clone();
        off[b[0] - b'a'] += 1;
        let got: Vec[bool] = (0..6).map(|arm| answer(arm, s, distance)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [value == truth, answer(arm, renamed, moved) == value, answer(arm, reversed, distance) == value, answer(arm, s, absent) == value, not value or not answer(arm, s, off), same >= 3];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
