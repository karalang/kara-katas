// LeetCode #2399: Check Distances Between Same Letters -- iterators. Every
// index `i` is paired by `enumerate` with its byte, and `all` asks of each
// that the byte `distance + 1` further on, if there is one, is the same
// letter exactly when this is the letter's first index, found by
// `position`. O(n^2) at worst, n at most 52.

fn check_distances(s: String, distance: Vec[i64]) -> bool {
    let b = s.bytes();
    b.iter().enumerate().all(|(i, c)| {
        let first = b.iter().position(|x| x == c).unwrap();
        let partner = i + distance[c - b'a'] + 1;
        first != i or partner < b.len() and b[partner] == c
    })
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A string of `m` distinct letters, each twice, shuffled, and the
// distances that are true of it; letters not in it get random distances.
fn case(seed: mut ref i64, m: i64) -> (String, Vec[i64]) {
    let mut letters: Vec[i64] = (0..26).collect();
    for i in 1..26 {
        let j = next_random(mut seed) % (i + 1);
        let t = letters[i];
        letters[i] = letters[j];
        letters[j] = t;
    }
    let mut b: Vec[u8] = Vec.new();
    for i in 0..m {
        b.push(b'a' + letters[i] as u8);
        b.push(b'a' + letters[i] as u8);
    }
    for i in 1..b.len() {
        let j = next_random(mut seed) % (i + 1);
        let t = b[i];
        b[i] = b[j];
        b[j] = t;
    }
    let mut distance: Vec[i64] = (0..26).map(|_| next_random(mut seed) % 50).collect();
    let mut first: Vec[i64] = Vec.filled(26, -1);
    for i in 0..b.len() {
        let c = (b[i] - b'a') as i64;
        if first[c] < 0 {
            first[c] = i;
        } else {
            distance[c] = i - first[c] - 1;
        }
    }
    (String.from_utf8(b).unwrap(), distance)
}

fn main() {
    // LeetCode's two examples; a letter twice side by side, with 0 and
    // with 1; every letter twice in order, true and with z off by one;
    // then 3000 random strings of 1 to 26 letters each twice, a third
    // with true distances, a third with one letter's off by one, and a
    // third with one letter's drawn at random, with a checksum and the
    // count of yes
    let mut example: Vec[i64] = Vec.filled(26, 0);
    example[0] = 1;
    example[1] = 3;
    example[2] = 0;
    example[4] = 5;
    println(f"{check_distances("abaccb", example)}");
    let mut second: Vec[i64] = Vec.filled(26, 0);
    second[0] = 1;
    println(f"{check_distances("aa", second)}");
    println(f"{check_distances("zz", Vec.filled(26, 0))} {check_distances("zz", Vec.filled(26, 1))}");
    let mut seed = 2399;
    let alphabet = String.from_utf8((0..52).map(|i| b'a' + (i % 26) as u8).collect()).unwrap();
    let mut far: Vec[i64] = Vec.filled(26, 25);
    println(f"{check_distances(alphabet, far)}");
    far[25] = 24;
    println(f"{check_distances(alphabet, far)}");
    let mut check = 0;
    let mut yes = 0;
    for t in 0..3000 {
        let m = 1 + next_random(mut seed) % 26;
        let mut (s, distance) = case(mut seed, m);
        let letter = (s.bytes()[next_random(mut seed) % s.len()] - b'a') as i64;
        if t % 3 == 1 {
            distance[letter] += if distance[letter] == 0 {
                1
            } else {
                -1
            };
        } else if t % 3 == 2 {
            distance[letter] = next_random(mut seed) % 50;
        }
        let ok = check_distances(s, distance);
        check = (check * 31 + if ok {
            2
        } else {
            1
        }) % 1000000007;
        if ok {
            yes += 1;
        }
    }
    println(f"3000 strings: checksum {check}, {yes} yes");
}
