// LeetCode #2320: Count Number of Ways to Place Houses -- iterators: one
// side's placements ending empty and ending in a house `fold`ed over
// the plots after the first, and their sum squared. O(n).

fn count_house_placements(n: i64) -> i64 {
    let (empty, house) = (1..n).fold((1, 1), |(empty, house), _| ((empty + house) % 1000000007, empty));
    let side = (empty + house) % 1000000007;
    side * side % 1000000007
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples; then three plots a side, ten, a hundred,
    // and the most plots
    for n in [1, 2, 3, 10, 100, 10000] {
        println(f"{n}: {count_house_placements(n)}");
    }
    // every count of plots from 1 to 300
    let mut check = 0;
    let mut total = 0;
    for n in 1..=300 {
        let ways = count_house_placements(n);
        check = (check * 31 + ways) % 1000000007;
        total += ways;
    }
    println(f"300 counts: checksum {check}, {total} in all");
}
