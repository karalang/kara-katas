// LeetCode #2320: Count Number of Ways to Place Houses -- every length
// kept: `ways[i]`, one side's placements on `i` plots, is those with the
// last plot empty, `ways[i - 1]`, and those with a house there and the
// plot before empty, `ways[i - 2]`; the answer is `ways[n]` squared.
// O(n) time and space.

fn count_house_placements(n: i64) -> i64 {
    let mut ways: Vec[i64] = Vec.filled(n + 1, 0);
    ways[0] = 1;
    ways[1] = 2;
    for i in 2..=n {
        ways[i] = (ways[i - 1] + ways[i - 2]) % 1000000007;
    }
    ways[n] * ways[n] % 1000000007
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples; then three plots a side, ten, a hundred,
    // and the most plots
    for n in [1, 2, 3, 10, 100, 10000] {
        println(f"{n}: {count_house_placements(n)}");
    }
    // every count of plots from 1 to 300
    let mut check = 0;
    let mut total = 0;
    for n in 1..=300 {
        let ways = count_house_placements(n);
        check = (check * 31 + ways) % 1000000007;
        total += ways;
    }
    println(f"300 counts: checksum {check}, {total} in all");
}
