// LeetCode #2320: Count Number of Ways to Place Houses -- by matrix
// powers: one side's count is the Fibonacci number `F(n + 2)`, the top
// left of `[[1, 1], [1, 0]]` raised to `n + 1`, found by repeated
// squaring; the answer is its square. O(log n).

fn multiply(a: Array[Array[i64, 2], 2], b: Array[Array[i64, 2], 2]) -> Array[Array[i64, 2], 2] {
    let mut c = [[0; 2]; 2];
    for i in 0..2 {
        for j in 0..2 {
            for k in 0..2 {
                c[i][j] = (c[i][j] + a[i][k] * b[k][j]) % 1000000007;
            }
        }
    }
    c
}

fn count_house_placements(n: i64) -> i64 {
    let mut result: Array[Array[i64, 2], 2] = [[1, 0], [0, 1]];
    let mut base: Array[Array[i64, 2], 2] = [[1, 1], [1, 0]];
    let mut power = n + 1;
    while power > 0 {
        if power % 2 == 1 {
            result = multiply(result, base);
        }
        base = multiply(base, base);
        power /= 2;
    }
    let side = result[0][0];
    side * side % 1000000007
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples; then three plots a side, ten, a hundred,
    // and the most plots
    for n in [1, 2, 3, 10, 100, 10000] {
        println(f"{n}: {count_house_placements(n)}");
    }
    // every count of plots from 1 to 300
    let mut check = 0;
    let mut total = 0;
    for n in 1..=300 {
        let ways = count_house_placements(n);
        check = (check * 31 + ways) % 1000000007;
        total += ways;
    }
    println(f"300 counts: checksum {check}, {total} in all");
}
