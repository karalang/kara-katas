// LeetCode #2320: Count Number of Ways to Place Houses -- the
// differential. The six arms, against the statement read literally:
// every way to put a house or none on each of the `2 n` plots, as the
// bits of a number, is tried, and counted when no two houses stand on
// adjacent plots of the same side. That runs for 1 to 9 plots a side.
// Every arm answers for each count of plots from 1 to 360.
//
// P1  the answer is the literal reading's, for 1 to 9 plots
// P2  the answer is below 10^9 + 7, and from 2 to 20 plots, before any
//     reduction, a square, more than the answer for one plot fewer and
//     at most four times it
// P3  from 4 plots on, the answer is twice the answers for one and two
//     plots fewer less the answer for three fewer, modulo 10^9 + 7
// P4  from 3 plots on, the answer times the answer for two plots fewer
//     is the square of the answer for one fewer, plus 1 for an odd
//     count and less 1 for an even one, modulo 10^9 + 7
// P5  each arm agrees with at least three of the other five

// ---- houses.kara
fn star_count_house_placements(n: i64) -> i64 {
    let modulus = 1000000007;
    let mut empty = 1;
    let mut house = 1;
    for _ in 1..n {
        let next_empty = (empty + house) % modulus;
        house = empty;
        empty = next_empty;
    }
    let side = (empty + house) % modulus;
    side * side % modulus
}

// ---- houses_joint.kara
fn joint_count_house_placements(n: i64) -> i64 {
    let mut ends = [1, 1, 1, 1];
    for _ in 1..n {
        let mut next = [0, 0, 0, 0];
        for s in 0..4 {
            for t in 0..4 {
                if s & t == 0 {
                    next[s] = (next[s] + ends[t]) % 1000000007;
                }
            }
        }
        ends = next;
    }
    (ends[0] + ends[1] + ends[2] + ends[3]) % 1000000007
}

// ---- houses_table.kara
fn table_count_house_placements(n: i64) -> i64 {
    let mut ways: Vec[i64] = Vec.filled(n + 1, 0);
    ways[0] = 1;
    ways[1] = 2;
    for i in 2..=n {
        ways[i] = (ways[i - 1] + ways[i - 2]) % 1000000007;
    }
    ways[n] * ways[n] % 1000000007
}

// ---- houses_matrix.kara
fn matrix_multiply(a: Array[Array[i64, 2], 2], b: Array[Array[i64, 2], 2]) -> Array[Array[i64, 2], 2] {
    let mut c = [[0; 2]; 2];
    for i in 0..2 {
        for j in 0..2 {
            for k in 0..2 {
                c[i][j] = (c[i][j] + a[i][k] * b[k][j]) % 1000000007;
            }
        }
    }
    c
}

fn matrix_count_house_placements(n: i64) -> i64 {
    let mut result: Array[Array[i64, 2], 2] = [[1, 0], [0, 1]];
    let mut base: Array[Array[i64, 2], 2] = [[1, 1], [1, 0]];
    let mut power = n + 1;
    while power > 0 {
        if power % 2 == 1 {
            result = matrix_multiply(result, base);
        }
        base = matrix_multiply(base, base);
        power /= 2;
    }
    let side = result[0][0];
    side * side % 1000000007
}

// ---- houses_iter.kara
fn iter_count_house_placements(n: i64) -> i64 {
    let (empty, house) = (1..n).fold((1, 1), |(empty, house), _| ((empty + house) % 1000000007, empty));
    let side = (empty + house) % 1000000007;
    side * side % 1000000007
}

// ---- houses_solution.kara
struct Solution {}

impl Solution {
    pub fn count_house_placements(n: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let n = n as i64;
        let mut dp = Vec.filled(n + 2, 0);
        dp[0] = 1;
        dp[1] = 2;
        for i in 2..=n {
            dp[i] = (dp[i - 1] + dp[i - 2]) % MOD;
        }
        (dp[n] * dp[n] % MOD) as i32
    }
}

fn solution_count_house_placements(n: i64) -> i64 {
    Solution.count_house_placements(n as i32)
}

// ---- the statement read literally ------------------------------------------

fn literal(n: i64) -> i64 {
    // bit `i` is plot `i` of the first side, bit `n + i` plot `i` of
    // the second
    let mut count = 0;
    for plan in 0..(1 << (2 * n)) {
        let mut fits = true;
        for side in 0..2 {
            for i in 0..n - 1 {
                let here = (plan >> (side * n + i)) & 1;
                let next = (plan >> (side * n + i + 1)) & 1;
                if here == 1 and next == 1 {
                    fits = false;
                }
            }
        }
        if fits {
            count += 1;
        }
    }
    count % 1000000007
}

fn answer(arm: i64, n: i64) -> i64 {
    match arm {
        0 => star_count_house_placements(n),
        1 => joint_count_house_placements(n),
        2 => table_count_house_placements(n),
        3 => matrix_count_house_placements(n),
        4 => iter_count_house_placements(n),
        _ => solution_count_house_placements(n),
    }
}

fn is_square(v: i64) -> bool {
    let mut r = 0;
    while r * r < v {
        r += 1;
    }
    r * r == v
}

fn main() {
    let names = ["star", "joint", "table", "matrix", "iter", "solution"];
    let modulus = 1000000007;
    let top = 360;
    let mut truth: Vec[i64] = Vec.new();
    let mut check = 0;
    for n in 1..=9 {
        let t = literal(n);
        truth.push(t);
        check = (check * 31 + t) % modulus;
    }
    // got[arm][n - 1]
    let got: Vec[Vec[i64]] = (0..6).map(|arm| (1..=top).map(|n| answer(arm, n)).collect()).collect();
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0];
    let mut checks = 0;
    for n in 1..=top {
        for arm in 0..6 {
            let value = got[arm][n - 1];
            let mut verdicts: Vec[(i64, bool)] = Vec.new();
            if n <= 9 {
                verdicts.push((0, value == truth[n - 1]));
            }
            let mut range = value >= 0 and value < modulus;
            if range and n >= 2 and n <= 20 {
                let before = got[arm][n - 2];
                range = is_square(value) and value > before and value <= 4 * before;
            }
            verdicts.push((1, range));
            let back = |k: i64| got[arm][n - 1 - k];
            if n >= 4 {
                let sum = ((2 * back(1) + 2 * back(2) - back(3)) % modulus + modulus) % modulus;
                verdicts.push((2, value == sum));
            }
            if n >= 3 {
                let shift = if n % 2 == 1 { 1 } else { modulus - 1 };
                let middle = (back(1) + shift) % modulus;
                verdicts.push((3, value * back(2) % modulus == middle * middle % modulus));
            }
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o][n - 1] == value {
                    same += 1;
                }
            }
            verdicts.push((4, same >= 3));
            for (q, ok) in verdicts.iter() {
                checks += 1;
                if not ok {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{n} plots, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{top} counts of plots: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..5 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
