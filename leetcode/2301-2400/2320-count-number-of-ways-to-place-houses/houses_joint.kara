// LeetCode #2320: Count Number of Ways to Place Houses -- both sides at
// once: each plot index holds one of four states, no house, a house on
// the first side, on the second, or on both, as two bits, and a state
// can follow another when they share no bit. The counts of the four
// are rolled forward together. O(16 n).

fn count_house_placements(n: i64) -> i64 {
    let mut ends = [1, 1, 1, 1];
    for _ in 1..n {
        let mut next = [0, 0, 0, 0];
        for s in 0..4 {
            for t in 0..4 {
                if s & t == 0 {
                    next[s] = (next[s] + ends[t]) % 1000000007;
                }
            }
        }
        ends = next;
    }
    (ends[0] + ends[1] + ends[2] + ends[3]) % 1000000007
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples; then three plots a side, ten, a hundred,
    // and the most plots
    for n in [1, 2, 3, 10, 100, 10000] {
        println(f"{n}: {count_house_placements(n)}");
    }
    // every count of plots from 1 to 300
    let mut check = 0;
    let mut total = 0;
    for n in 1..=300 {
        let ways = count_house_placements(n);
        check = (check * 31 + ways) % 1000000007;
        total += ways;
    }
    println(f"300 counts: checksum {check}, {total} in all");
}
