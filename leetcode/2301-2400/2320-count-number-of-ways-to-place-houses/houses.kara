// LeetCode #2320: Count Number of Ways to Place Houses -- the ★ arm. The
// two sides never touch, so the answer is one side's count squared; on
// one side, the placements of the plots so far ending in an empty plot
// and ending in a house are rolled forward a plot at a time. O(n).

fn count_house_placements(n: i64) -> i64 {
    let modulus = 1000000007;
    let mut empty = 1;
    let mut house = 1;
    for _ in 1..n {
        let next_empty = (empty + house) % modulus;
        house = empty;
        empty = next_empty;
    }
    let side = (empty + house) % modulus;
    side * side % modulus
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples; then three plots a side, ten, a hundred,
    // and the most plots
    for n in [1, 2, 3, 10, 100, 10000] {
        println(f"{n}: {count_house_placements(n)}");
    }
    // every count of plots from 1 to 300
    let mut check = 0;
    let mut total = 0;
    for n in 1..=300 {
        let ways = count_house_placements(n);
        check = (check * 31 + ways) % 1000000007;
        total += ways;
    }
    println(f"300 counts: checksum {check}, {total} in all");
}
