// LeetCode #2369: Check if There is a Valid Partition For The Array -- the
// bench, the ★ arm: good[i] says whether the first i values split into
// valid blocks, from the last block before i and the values before it.

fn valid_partition(nums: Vec[i64]) -> bool {
    let n = nums.len();
    let mut good: Vec[bool] = Vec.filled(n + 1, false);
    good[0] = true;
    for i in 2..n + 1 {
        let a = nums[i - 1];
        let b = nums[i - 2];
        if a == b and good[i - 2] {
            good[i] = true;
        }
        if i >= 3 and good[i - 3] {
            let c = nums[i - 3];
            if (a == b and b == c) or (b == c + 1 and a == b + 1) {
                good[i] = true;
            }
        }
    }
    good[n]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // array a: about 10^5 values in random blocks of two or three equal
    // values or three rising, the values up to 4^(a + 1); when a is odd, one
    // value near the end then raised by one
    let mut seed = 2369;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    let mut top = 4;
    for a in 0..10 {
        let mut nums: Vec[i64] = Vec.new();
        while nums.len() < 100000 {
            let kind = next_random(mut seed) % 3;
            let v = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
            if kind == 0 {
                nums.push(v);
                nums.push(v);
            } else if kind == 1 {
                nums.push(v);
                nums.push(v);
                nums.push(v);
            } else {
                nums.push(v);
                nums.push(v + 1);
                nums.push(v + 2);
            }
        }
        if a % 2 == 1 {
            let at = nums.len() - 1 - next_random(mut seed) % 100;
            nums[at] += 1;
        }
        arrays.push(nums);
        top *= 4;
    }
    let mut check = 0;
    for p in 0..20 {
        for a in 0..10 {
            let valid = if valid_partition(arrays[a]) { a + 1 } else { 0 };
            check = (check * 31 + valid + p) % 1000000007;
        }
    }
    println(f"20 passes over 10 arrays of about 10^5 values: checksum {check}");
}
