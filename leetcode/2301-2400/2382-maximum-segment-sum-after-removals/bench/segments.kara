// LeetCode #2382: Maximum Segment Sum After Removals -- the bench, the ★
// arm: the removals undone in reverse with a union-find, each root
// keeping its segment's sum.

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut root = x;
    while parent[root] != root {
        parent[root] = parent[parent[root]];
        root = parent[root];
    }
    root
}

fn join(parent: mut ref Vec[i64], sum: mut ref Vec[i64], a: i64, b: i64) {
    let ra = find(mut parent, a);
    let rb = find(mut parent, b);
    if ra != rb {
        parent[ra] = rb;
        sum[rb] += sum[ra];
    }
}

fn maximum_segment_sum(nums: Vec[i64], remove_queries: Vec[i64]) -> Vec[i64] {
    let n = nums.len();
    let mut parent: Vec[i64] = (0..n).collect();
    let mut sum: Vec[i64] = Vec.filled(n, 0);
    let mut back: Vec[bool] = Vec.filled(n, false);
    let mut answer: Vec[i64] = Vec.filled(n, 0);
    let mut best = 0;
    for k in (1..n).rev() {
        let x = remove_queries[k];
        back[x] = true;
        sum[x] = nums[x];
        if x > 0 and back[x - 1] {
            join(mut parent, mut sum, x - 1, x);
        }
        if x + 1 < n and back[x + 1] {
            join(mut parent, mut sum, x + 1, x);
        }
        best = best.max(sum[find(mut parent, x)]);
        answer[k - 1] = best;
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    let high = next_random(mut seed);
    high * 32768 + next_random(mut seed)
}

fn main() {
    // 10 arrays of 10^5 values, array a's values from 1 to 10^a, each with
    // its own random order of removals
    let mut seed = 2382;
    let n = 100000;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    let mut orders: Vec[Vec[i64]] = Vec.new();
    for a in 0..10 {
        let mut top = 1;
        for _ in 0..a {
            top *= 10;
        }
        arrays.push((0..n).map(|_| 1 + wide(mut seed) % top).collect());
        let mut order: Vec[i64] = (0..n).collect();
        for i in (1..n).rev() {
            let j = wide(mut seed) % (i + 1);
            order.swap(i, j);
        }
        orders.push(order);
    }
    let mut check = 0;
    for p in 0..10 {
        for a in 0..10 {
            let answer = maximum_segment_sum(arrays[a], orders[a]);
            for v in answer.iter() {
                check = (check * 31 + v + p) % 1000000007;
            }
        }
    }
    println(f"10 passes over 10 arrays of 10^5 values: checksum {check}");
}
