// LeetCode #2316: Count Unreachable Pairs of Nodes in an Undirected
// Graph -- the bench, the ★ arm in Kāra. Union-find with union by size
// and path halving, then each set's root, met in order, pairs its size
// with every node of the sets before it.

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn count_pairs(n: i64, edges: Vec[(i64, i64)]) -> i64 {
    let mut parent: Vec[i64] = (0..n).collect();
    let mut size = Vec.filled(n, 1);
    for (a, b) in edges.iter() {
        let mut ra = find(mut parent, a);
        let mut rb = find(mut parent, b);
        if ra != rb {
            if size[ra] < size[rb] {
                let t = ra;
                ra = rb;
                rb = t;
            }
            parent[rb] = ra;
            size[ra] += size[rb];
        }
    }
    let mut before = 0;
    let mut pairs = 0;
    for x in 0..n {
        if parent[x] == x {
            pairs += size[x] * before;
            before += size[x];
        }
    }
    pairs
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10 graphs of 10^5 nodes built once, graph `g` joining each node `i`
    // after the first, one time in `g + 2` out of `g + 3`, to a random
    // node before it, so no edge repeats; then 50 passes, pass `p`
    // taking graph `(a + p) % 10` at step `a`
    let n = 100000;
    let mut seed = 2316;
    let mut graphs: Vec[Vec[(i64, i64)]] = Vec.new();
    for g in 0..10 {
        let mut edges: Vec[(i64, i64)] = Vec.new();
        for i in 1..n {
            if next_random(mut seed) % (g + 3) != 0 {
                let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % i;
                edges.push((i, j));
            }
        }
        graphs.push(edges);
    }
    let mut check = 0;
    for p in 0..50 {
        for a in 0..10 {
            check = (check * 31 + count_pairs(n, graphs[(a + p) % 10]) % 1000000007) % 1000000007;
        }
    }
    println(f"50 passes over 10 graphs of 10^5 nodes: checksum {check}");
}
