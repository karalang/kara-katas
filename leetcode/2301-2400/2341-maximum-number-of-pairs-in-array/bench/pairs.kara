// LeetCode #2341: Maximum Number of Pairs in Array -- the bench, the ★
// arm: each value counted in a table of 101, the pairs every count's half
// and the leftovers its parity.

fn number_of_pairs(nums: Vec[i64]) -> Vec[i64] {
    let mut counts: Vec[i64] = Vec.filled(101, 0);
    for x in nums {
        counts[x] += 1;
    }
    let mut pairs = 0;
    let mut left = 0;
    for c in counts {
        pairs += c / 2;
        left += c % 2;
    }
    [pairs, left].to_vec()
}

fn scrambled(index: i64) -> i64 {
    index * 2654435761 % 2147483647
}

fn main() {
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for a in 0..10 {
        let nums: Vec[i64] = (0..100000).map(|i| scrambled(a * 100000 + i) % 101).collect();
        arrays.push(nums);
    }
    let mut check = 0;
    for p in 0..50 {
        for nums in arrays.iter() {
            let answer = number_of_pairs(nums);
            check = (check * 31 + answer[0] * 101 + answer[1] + p) % 1000000007;
        }
    }
    println(f"50 passes over 10 arrays of 10^5 values: checksum {check}");
}
