// LeetCode #2326: Spiral Matrix IV -- LeetCode's Rust template as a Rust
// user fills it in, carried by `karac fix`: LeetCode's `ListNode` of
// `i32` behind `Option<Box<ListNode>>`, an `i32` walker turning by a
// table of moves, and `usize` indices.

// Definition for singly-linked list.
#[derive(PartialEq, Eq, Clone, Debug)]
pub struct ListNode {
    pub val: i32,
    pub next: Option[ListNode],
}

impl ListNode {
    #[inline]
    fn new(val: i32) -> Self {
        ListNode { next: None, val }
    }
}

struct Solution {}

impl Solution {
    pub fn spiral_matrix(m: i32, n: i32, head: Option[ListNode]) -> Vec[Vec[i32]] {
        let mut res = Vec.filled(m, Vec.filled(n, -1));
        let dirs = [(0, 1), (1, 0), (0, -1), (-1, 0)];
        let mut (r, c, d) = (0i32, 0i32, 0usize);
        let mut cur = head;
        while let Some(node) = cur {
            res[r as usize][c as usize] = node.val;
            let (nr, nc) = (r + dirs[d].0, c + dirs[d].1);
            if nr < 0 or nr >= m or nc < 0 or nc >= n or res[nr as usize][nc as usize] != -1 {
                d = (d + 1) % 4;
            }
            r += dirs[d].0 as i32;
            c += dirs[d].1 as i32;
            cur = ref node.next;
        }
        res
    }
}

fn spiral_matrix(m: i64, n: i64, head: Option[ListNode]) -> Vec[Vec[i64]] {
    Solution.spiral_matrix(m as i32, n as i32, head)
        .into_iter()
        .map(|row| row.into_iter().map(|v| v as i64).collect())
        .collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn build(values: Vec[i64]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for v in values.iter().rev() {
        head = Some(ListNode { val: v as i32, next: head });
    }
    head
}

fn show(grid: Vec[Vec[i64]]) -> String {
    let rows: Vec[String] = grid.iter().map(|row| {
        let cells: Vec[String] = row.iter().map(|v| f"{v}").collect();
        f"[{cells.join(",")}]"
    }).collect();
    f"[{rows.join(",")}]"
}

fn fold(grid: Vec[Vec[i64]], check: mut ref i64, empty: mut ref i64) {
    for row in grid.iter() {
        for v in row.iter() {
            *check = (*check * 31 + v + 1) % 1000000007;
            if v == -1 {
                *empty += 1;
            }
        }
    }
}

fn main() {
    // LeetCode's two examples; then one cell, a column of five, a full
    // 4 by 4, and 300 by 300 with 50000 values, folded to a checksum
    println(show(spiral_matrix(3, 5, build([3, 0, 2, 6, 8, 1, 7, 9, 4, 2, 5, 5, 0].to_vec()))));
    println(show(spiral_matrix(1, 4, build([0, 1, 2].to_vec()))));
    println(show(spiral_matrix(1, 1, build([7].to_vec()))));
    println(show(spiral_matrix(5, 1, build([1, 2, 3].to_vec()))));
    println(show(spiral_matrix(4, 4, build((1..=16).collect()))));
    let mut seed = 2326;
    let values: Vec[i64] = (0..50000).map(|_| next_random(mut seed) % 1001).collect();
    let mut check = 0;
    let mut empty = 0;
    fold(spiral_matrix(300, 300, build(values)), mut check, mut empty);
    println(f"300 by 300: checksum {check}, {empty} empty");
    // 1000 random grids of 1 to 8 by 1 to 8, each with 1 to m n values
    // from 0 to 1000
    let mut check = 0;
    let mut empty = 0;
    for _ in 0..1000 {
        let m = next_random(mut seed) % 8 + 1;
        let n = next_random(mut seed) % 8 + 1;
        let length = next_random(mut seed) % (m * n) + 1;
        let values: Vec[i64] = (0..length).map(|_| next_random(mut seed) % 1001).collect();
        fold(spiral_matrix(m, n, build(values)), mut check, mut empty);
    }
    println(f"1000 grids: checksum {check}, {empty} empty");
}
