// LeetCode #2360: Longest Cycle in a Graph -- iterators: from every start,
// the walk as a `scan` that stamps each node it passes and stops at a node
// already stamped or at the end; the cycle closed, if any, from the stamp
// on the node it stopped at; the longest by `filter_map` and `max`.

fn longest_cycle(edges: Vec[i64]) -> i64 {
    let n = edges.len();
    let mut stamp: Vec[i64] = Vec.filled(n, -1);
    let mut time = 0;
    (0..n)
        .filter_map(|start| {
            let began = time;
            let stop = (0..n + 1)
                .scan(start, |node, _| {
                    if node == -1 or stamp[node] != -1 {
                        None
                    } else {
                        stamp[node] = time;
                        time += 1;
                        Some((edges[node], edges[node]))
                    }
                })
                .last()
                .unwrap_or(start);
            if stop != -1 and stamp[stop] >= began { Some(time - stamp[stop]) } else { None }
        })
        .max()
        .unwrap_or(-1)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; two nodes pointing at each other; a cycle of
    // 2000; a chain of 2000 into a cycle of 1000; 1000 cycles of 2 and one
    // of 3 at the end; a chain of 3000 with no cycle
    println(f"{longest_cycle([3, 3, 4, 2, 3])}");
    println(f"{longest_cycle([2, -1, 3, 1])}");
    println(f"{longest_cycle([1, 0])}");
    let ring: Vec[i64] = (0..2000).map(|i| (i + 1) % 2000).collect();
    println(f"{longest_cycle(ring)}");
    let tail: Vec[i64] = (0..3000).map(|i| if i == 2999 { 2000 } else { i + 1 }).collect();
    println(f"{longest_cycle(tail)}");
    let pairs: Vec[i64] = (0..2003).map(|i| if i >= 2000 { 2000 + (i - 1999) % 3 } else { i ^ 1 }).collect();
    println(f"{longest_cycle(pairs)}");
    let chain: Vec[i64] = (0..3000).map(|i| if i < 2999 { i + 1 } else { -1 }).collect();
    println(f"{longest_cycle(chain)}");
    // 3000 random graphs of 2 to 30 nodes, each edge -1 with a chance of 1
    // in 1 to 1 in 8 and otherwise to another node
    let mut seed = 2360;
    let mut check = 0;
    let mut cyclic = 0;
    for _ in 0..3000 {
        let n = 2 + next_random(mut seed) % 29;
        let odds = 1 + next_random(mut seed) % 8;
        let mut edges: Vec[i64] = Vec.new();
        for i in 0..n {
            edges.push(if odds > 1 and next_random(mut seed) % odds == 0 { -1 } else { (i + 1 + next_random(mut seed) % (n - 1)) % n });
        }
        let m = longest_cycle(edges);
        check = (check * 31 + m + 2) % 1000000007;
        if m > 0 {
            cyclic += 1;
        }
    }
    println(f"3000 graphs: checksum {check}, cycles in {cyclic}");
}
