// LeetCode #2396: Strictly Palindromic Number -- the bench, the ★ arm:
// every base tried, each base's digits taken into a list and checked from
// both ends.

fn palindrome_in_base(n: i64, b: i64) -> bool {
    let mut digits: Vec[i64] = Vec.new();
    let mut m = n;
    while m > 0 {
        digits.push(m % b);
        m /= b;
    }
    let mut i = 0;
    let mut j = digits.len() - 1;
    while i < j {
        if digits[i] != digits[j] {
            return false;
        }
        i += 1;
        j -= 1;
    }
    true
}

fn is_strictly_palindromic(n: i64) -> bool {
    for b in 2..n - 1 {
        if not palindrome_in_base(n, b) {
            return false;
        }
    }
    true
}

fn main() {
    // every n from 4 to 10000: each base from 2 to n - 2 tested, the count
    // of palindromes folded with the answer
    let mut check = 0;
    let mut total = 0;
    for n in 4..10001 {
        let mut count = 0;
        for b in 2..n - 1 {
            if palindrome_in_base(n, b) {
                count += 1;
            }
        }
        total += count;
        check = (check * 31 + count + if is_strictly_palindromic(n) {
            1
        } else {
            0
        }) % 1000000007;
    }
    println(f"every base of every n from 4 to 10000: checksum {check}, {total} palindromes");
}
