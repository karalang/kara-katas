// LeetCode #2376: Count Special Integers -- every special number up to n
// written out. A depth-first walk from each first digit appends each
// unused digit in turn, stopping as soon as the number passes n, since a
// larger digit only makes it larger. One step per special number, at
// most 5974650 for n of 2 * 10^9.

fn extend(value: i64, used: i64, n: i64) -> i64 {
    let mut count = 1;
    for d in 0..10 {
        if used & (1 << d) == 0 {
            let next = value * 10 + d;
            if next > n {
                break;
            }
            count += extend(next, used | (1 << d), n);
        }
    }
    count
}

fn count_special_numbers(n: i64) -> i64 {
    let mut count = 0;
    for d in 1..10 {
        if d > n {
            break;
        }
        count += extend(d, 1 << d, n);
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; 1 and 10; 2 * 10^9 and 123456789; then
    // 2000 random n of 1 to 5 digits, with a checksum and how many are
    // special themselves
    println(f"{count_special_numbers(20)} {count_special_numbers(5)} {count_special_numbers(135)}");
    println(f"{count_special_numbers(1)} {count_special_numbers(10)}");
    println(f"{count_special_numbers(2000000000)} {count_special_numbers(123456789)}");
    let mut seed = 2376;
    let mut check = 0;
    let mut special = 0;
    for _ in 0..2000 {
        let digits = 1 + next_random(mut seed) % 5;
        let mut top = 1;
        for _ in 0..digits {
            top *= 10;
        }
        let n = 1 + next_random(mut seed) % (top - 1);
        let t = count_special_numbers(n);
        check = (check * 31 + t) % 1000000007;
        if t > count_special_numbers(n - 1) or n == 1 {
            special += 1;
        }
    }
    println(f"2000 values: checksum {check}, {special} special themselves");
}
