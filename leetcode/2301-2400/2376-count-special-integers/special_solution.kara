// LeetCode #2376: Count Special Integers -- LeetCode's Rust template, as
// Rust writes it, carried by karac fix. The digits from
// n.to_string().into_bytes(), the shorter numbers counted by length, then
// a [false; 10] array of the digits used, each place adding its smaller
// unused digits times the arrangements of the places after it.

struct Solution {}

impl Solution {
    pub fn count_special_numbers(n: i32) -> i32 {
        let s: Vec[u8] = n.to_string().bytes().to_vec();
        let m = s.len();
        let mut res: i32 = 0;
        for len in 1..m {
            let mut cur: i32 = 9;
            for k in 0..len - 1 {
                cur *= 9 - k as i32;
            }
            res += cur;
        }
        let mut used = [false; 10];
        for i in 0..m {
            let d = (s[i] - b'0') as usize;
            let start = if i == 0 { 1 } else { 0 };
            for x in start..d {
                if not used[x] {
                    let mut cur: i32 = 1;
                    for k in 0..(m - 1 - i) {
                        cur *= (9 - i - k) as i32;
                    }
                    res += cur;
                }
            }
            if used[d] {
                return res;
            }
            used[d] = true;
        }
        res + 1
    }
}

fn count_special_numbers(n: i64) -> i64 {
    Solution.count_special_numbers(n as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; 1 and 10; 2 * 10^9 and 123456789; then
    // 2000 random n of 1 to 5 digits, with a checksum and how many are
    // special themselves
    println(f"{count_special_numbers(20)} {count_special_numbers(5)} {count_special_numbers(135)}");
    println(f"{count_special_numbers(1)} {count_special_numbers(10)}");
    println(f"{count_special_numbers(2000000000)} {count_special_numbers(123456789)}");
    let mut seed = 2376;
    let mut check = 0;
    let mut special = 0;
    for _ in 0..2000 {
        let digits = 1 + next_random(mut seed) % 5;
        let mut top = 1;
        for _ in 0..digits {
            top *= 10;
        }
        let n = 1 + next_random(mut seed) % (top - 1);
        let t = count_special_numbers(n);
        check = (check * 31 + t) % 1000000007;
        if t > count_special_numbers(n - 1) or n == 1 {
            special += 1;
        }
    }
    println(f"2000 values: checksum {check}, {special} special themselves");
}
