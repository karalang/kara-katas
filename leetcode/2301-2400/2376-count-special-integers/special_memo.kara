// LeetCode #2376: Count Special Integers -- digit DP with a memo. The
// numbers are written place by place from the left, each place given a
// digit not yet used; while the digits so far equal n's, a place may go
// no higher than n's digit. Once a number has started and fallen below
// n, its count depends only on the place and the set of digits used, so
// it is kept by (place, set). O(10 * 2^10 * L).

fn count_from(digits: Vec[i64], pos: i64, mask: i64, tight: bool, started: bool, memo: mut ref Vec[i64]) -> i64 {
    if pos == digits.len() {
        return if started { 1 } else { 0 };
    }
    let key = pos * 1024 + mask;
    if not tight and started and memo[key] >= 0 {
        return memo[key];
    }
    let top = if tight { digits[pos] } else { 9 };
    let mut total = 0;
    for d in 0..top + 1 {
        if not started and d == 0 {
            total += count_from(digits, pos + 1, mask, tight and d == top, false, mut memo);
        } else if mask & (1 << d) == 0 {
            total += count_from(digits, pos + 1, mask | (1 << d), tight and d == top, true, mut memo);
        }
    }
    if not tight and started {
        memo[key] = total;
    }
    total
}

fn count_special_numbers(n: i64) -> i64 {
    let digits: Vec[i64] = n.to_string().bytes().iter().map(|b| (b - b'0') as i64).collect();
    let mut memo: Vec[i64] = Vec.filled(digits.len() * 1024, -1);
    count_from(digits, 0, 0, true, false, mut memo)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; 1 and 10; 2 * 10^9 and 123456789; then
    // 2000 random n of 1 to 5 digits, with a checksum and how many are
    // special themselves
    println(f"{count_special_numbers(20)} {count_special_numbers(5)} {count_special_numbers(135)}");
    println(f"{count_special_numbers(1)} {count_special_numbers(10)}");
    println(f"{count_special_numbers(2000000000)} {count_special_numbers(123456789)}");
    let mut seed = 2376;
    let mut check = 0;
    let mut special = 0;
    for _ in 0..2000 {
        let digits = 1 + next_random(mut seed) % 5;
        let mut top = 1;
        for _ in 0..digits {
            top *= 10;
        }
        let n = 1 + next_random(mut seed) % (top - 1);
        let t = count_special_numbers(n);
        check = (check * 31 + t) % 1000000007;
        if t > count_special_numbers(n - 1) or n == 1 {
            special += 1;
        }
    }
    println(f"2000 values: checksum {check}, {special} special themselves");
}
