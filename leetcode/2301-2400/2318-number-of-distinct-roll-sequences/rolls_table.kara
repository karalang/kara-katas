// LeetCode #2318: Number of Distinct Roll Sequences -- every length
// kept: `count[i][a][b]` is the number of sequences of `i + 2` rolls
// ending in `a + 1` then `b + 1`, each layer built from the one before
// and none thrown away. O(216 n) time and O(36 n) space.

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn distinct_sequences(n: i64) -> i64 {
    if n == 1 {
        return 6;
    }
    let mut count: Vec[Vec[Vec[i64]]] = Vec.filled(n - 1, Vec.filled(6, Vec.filled(6, 0)));
    for a in 0..6 {
        for b in 0..6 {
            if a != b and gcd(a + 1, b + 1) == 1 {
                count[0][a][b] = 1;
            }
        }
    }
    for i in 1..n - 1 {
        for b in 0..6 {
            for c in 0..6 {
                if b != c and gcd(b + 1, c + 1) == 1 {
                    for a in 0..6 {
                        if a != c {
                            count[i][b][c] = (count[i][b][c] + count[i - 1][a][b]) % 1000000007;
                        }
                    }
                }
            }
        }
    }
    let mut total = 0;
    for a in 0..6 {
        for b in 0..6 {
            total = (total + count[n - 2][a][b]) % 1000000007;
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples; then one roll, three, ten, a hundred,
    // and the largest count of rolls
    for n in [4, 2, 1, 3, 10, 100, 10000] {
        println(f"{n}: {distinct_sequences(n)}");
    }
    // every count of rolls from 1 to 300
    let mut check = 0;
    let mut total = 0;
    for n in 1..=300 {
        let ways = distinct_sequences(n);
        check = (check * 31 + ways) % 1000000007;
        total += ways;
    }
    println(f"300 counts: checksum {check}, {total} in all");
}
