// LeetCode #2318: Number of Distinct Roll Sequences -- LeetCode's Rust
// template as a Rust user fills it in, carried by `karac fix`: a `gcd`
// nested in the method, `dp[a][b]` over the rolls 1 to 6 with index 0
// unused, `usize` loops, and an `i32` answer.

struct Solution {}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

impl Solution {
    pub fn distinct_sequences(n: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        if n == 1 {
            return 6;
        }
        let mut dp = Vec.filled(7, Vec.filled(7, 0));
        for a in 1..=6 {
            for b in 1..=6 {
                if a != b and gcd(a, b) == 1 {
                    dp[a][b] = 1;
                }
            }
        }
        for _ in 2..n {
            let mut next = Vec.filled(7, Vec.filled(7, 0));
            for a in 1..=6 {
                for b in 1..=6 {
                    if dp[a][b] == 0 {
                        continue;
                    }
                    for c in 1..=6 {
                        if c != a and c != b and gcd(b, c) == 1 {
                            next[b][c] = (next[b][c] + dp[a][b]) % MOD;
                        }
                    }
                }
            }
            dp = next;
        }
        let mut total = 0;
        for row in ref dp {
            for x in row {
                total = (total + x) % MOD;
            }
        }
        total as i32
    }
}

fn distinct_sequences(n: i64) -> i64 {
    Solution.distinct_sequences(n as i32)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples; then one roll, three, ten, a hundred,
    // and the largest count of rolls
    for n in [4, 2, 1, 3, 10, 100, 10000] {
        println(f"{n}: {distinct_sequences(n)}");
    }
    // every count of rolls from 1 to 300
    let mut check = 0;
    let mut total = 0;
    for n in 1..=300 {
        let ways = distinct_sequences(n);
        check = (check * 31 + ways) % 1000000007;
        total += ways;
    }
    println(f"300 counts: checksum {check}, {total} in all");
}
