// LeetCode #2318: Number of Distinct Roll Sequences -- the ★ arm. A
// sequence can grow by a roll exactly when the roll is coprime with the
// last one and differs from the last two, so the count of sequences
// ending in each pair of rolls is all that needs carrying: a 6 by 6
// table, rolled forward once per roll. O(216 n).

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn distinct_sequences(n: i64) -> i64 {
    let modulus = 1000000007;
    if n == 1 {
        return 6;
    }
    // ends[a][b]: sequences whose last two rolls are a + 1 then b + 1
    let mut ends = [[0; 6]; 6];
    for a in 0..6 {
        for b in 0..6 {
            if a != b and gcd(a + 1, b + 1) == 1 {
                ends[a][b] = 1;
            }
        }
    }
    for _ in 2..n {
        let mut next = [[0; 6]; 6];
        for a in 0..6 {
            for b in 0..6 {
                if ends[a][b] > 0 {
                    for c in 0..6 {
                        if c != a and c != b and gcd(b + 1, c + 1) == 1 {
                            next[b][c] = (next[b][c] + ends[a][b]) % modulus;
                        }
                    }
                }
            }
        }
        ends = next;
    }
    let mut total = 0;
    for a in 0..6 {
        for b in 0..6 {
            total = (total + ends[a][b]) % modulus;
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples; then one roll, three, ten, a hundred,
    // and the largest count of rolls
    for n in [4, 2, 1, 3, 10, 100, 10000] {
        println(f"{n}: {distinct_sequences(n)}");
    }
    // every count of rolls from 1 to 300
    let mut check = 0;
    let mut total = 0;
    for n in 1..=300 {
        let ways = distinct_sequences(n);
        check = (check * 31 + ways) % 1000000007;
        total += ways;
    }
    println(f"300 counts: checksum {check}, {total} in all");
}
