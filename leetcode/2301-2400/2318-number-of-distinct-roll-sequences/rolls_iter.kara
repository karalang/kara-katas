// LeetCode #2318: Number of Distinct Roll Sequences -- iterators: the 36
// pair counts in one flat `Vec`, each step `map`ping every pair `(b, c)`
// to the `sum` of the counts of the pairs `(a, b)` that `filter` lets
// precede it, and the last counts `fold`ed into the total. O(216 n).

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn distinct_sequences(n: i64) -> i64 {
    if n == 1 {
        return 6;
    }
    let fits = |b: i64, c: i64| b != c and gcd(b + 1, c + 1) == 1;
    let mut ends: Vec[i64] = (0..36).map(|s| if fits(s / 6, s % 6) { 1 } else { 0 }).collect();
    for _ in 2..n {
        ends = (0..36)
            .map(|s| {
                let (b, c) = (s / 6, s % 6);
                if fits(b, c) { (0..6).filter(|a| a != c).map(|a| ends[a * 6 + b]).sum() % 1000000007 } else { 0 }
            })
            .collect();
    }
    ends.iter().fold(0, |total, x| (total + x) % 1000000007)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples; then one roll, three, ten, a hundred,
    // and the largest count of rolls
    for n in [4, 2, 1, 3, 10, 100, 10000] {
        println(f"{n}: {distinct_sequences(n)}");
    }
    // every count of rolls from 1 to 300
    let mut check = 0;
    let mut total = 0;
    for n in 1..=300 {
        let ways = distinct_sequences(n);
        check = (check * 31 + ways) % 1000000007;
        total += ways;
    }
    println(f"300 counts: checksum {check}, {total} in all");
}
