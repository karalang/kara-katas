// LeetCode #2379: Minimum Recolors to Get K Consecutive Black Blocks --
// the ★ arm, a sliding window. The white blocks of the first k counted,
// then the window moved one block at a time, counting the block that
// enters and dropping the one that leaves; the fewest whites seen is the
// answer. O(n).

fn minimum_recolors(blocks: String, k: i64) -> i64 {
    let b = blocks.bytes();
    let mut whites = 0;
    for i in 0..k {
        if b[i] == b'W' {
            whites += 1;
        }
    }
    let mut fewest = whites;
    for i in k..b.len() {
        if b[i] == b'W' {
            whites += 1;
        }
        if b[i - k] == b'W' {
            whites -= 1;
        }
        fewest = fewest.min(whites);
    }
    fewest
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one white block; 100 white blocks with k
    // of 100; 100 blocks alternating, every k from 1 to 100 summed; then
    // 2000 random strings of 1 to 100 blocks, white with a chance of 0
    // to 9 in 10, and k from 1 to their length, with a checksum and how
    // many need no recoloring
    println(f"{minimum_recolors("WBBWWBBWBW", 7)} {minimum_recolors("WBWBBBW", 2)}");
    println(f"{minimum_recolors("W", 1)}");
    let white = String.from_utf8(Vec.filled(100, b'W')).unwrap();
    let turns = String.from_utf8((0..100).map(|i| if i % 2 == 0 { b'B' } else { b'W' }).collect()).unwrap();
    let total: i64 = (1..101).map(|k| minimum_recolors(turns, k)).sum();
    println(f"{minimum_recolors(white, 100)} {total}");
    let mut seed = 2379;
    let mut check = 0;
    let mut none = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 100;
        let chance = next_random(mut seed) % 10;
        let k = 1 + next_random(mut seed) % n;
        let letters: Vec[u8] = (0..n).map(|_| if next_random(mut seed) % 10 < chance { b'W' } else { b'B' }).collect();
        let t = minimum_recolors(String.from_utf8(letters).unwrap(), k);
        check = (check * 31 + t) % 1000000007;
        if t == 0 {
            none += 1;
        }
    }
    println(f"2000 strings: checksum {check}, {none} need no recoloring");
}
