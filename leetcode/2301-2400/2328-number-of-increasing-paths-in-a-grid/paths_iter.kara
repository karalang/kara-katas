// LeetCode #2328: Number of Increasing Paths in a Grid -- iterators: the
// cells as flat indices, `sort_by_key` on their values, largest first,
// and a `fold` over them that keeps the counts in a flat `Vec`, each
// cell's one plus the `sum` of the counts of the neighbours `filter`
// keeps, those inside the grid and larger. O(m n log(m n)).

const MOD: i64 = 1000000007;

fn count_paths(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let value = |i: i64| grid[i / n][i % n];
    let mut order: Vec[i64] = (0..m * n).collect();
    order.sort_by_key(|i| -value(i));
    let counts = order.iter().fold(Vec.filled(m * n, 0), |counts, i| {
        let (r, c) = (i / n, i % n);
        let larger = [(r, c + 1), (r + 1, c), (r, c - 1), (r - 1, c)]
            .iter()
            .filter(|(nr, nc)| nr >= 0 and nr < m and nc >= 0 and nc < n and value(nr * n + nc) > value(i))
            .map(|(nr, nc)| counts[nr * n + nc])
            .fold(0, |sum, x| (sum + x) % MOD);
        let mut counts = counts;
        counts[i] = (1 + larger) % MOD;
        counts
    });
    counts.iter().fold(0, |sum, x| (sum + x) % MOD)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_grid(seed: mut ref i64, m: i64, n: i64, top: i64) -> Vec[Vec[i64]] {
    (0..m).map(|_| (0..n).map(|_| next_random(mut seed) % top + 1).collect()).collect()
}

fn main() {
    // LeetCode's two examples; then one cell, a 3 by 3 of equal values,
    // a row of 1 to 10, and 300 by 300 with values from 1 to 100
    println(f"{count_paths([[1, 1].to_vec(), [3, 4].to_vec()].to_vec())}");
    println(f"{count_paths([[1].to_vec(), [2].to_vec()].to_vec())}");
    println(f"{count_paths([[5].to_vec()].to_vec())}");
    println(f"{count_paths(Vec.filled(3, Vec.filled(3, 7)))}");
    let row: Vec[i64] = (1..=10).collect();
    println(f"{count_paths([row].to_vec())}");
    let mut seed = 2328;
    println(f"300 by 300: {count_paths(random_grid(mut seed, 300, 300, 100))}");
    // 1000 random grids of 1 to 6 by 1 to 6 with values from 1 to 5
    let mut check = 0;
    let mut total = 0;
    for _ in 0..1000 {
        let m = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % 6 + 1;
        let paths = count_paths(random_grid(mut seed, m, n, 5));
        check = (check * 31 + paths) % 1000000007;
        total = (total + paths) % 1000000007;
    }
    println(f"1000 grids: checksum {check}, total {total}");
}
