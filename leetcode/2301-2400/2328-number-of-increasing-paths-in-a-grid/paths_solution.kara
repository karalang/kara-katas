// LeetCode #2328: Number of Increasing Paths in a Grid -- LeetCode's Rust
// template as a Rust user fills it in, carried by `karac fix`: a memoized
// `dfs` over `&Vec<Vec<i32>>` and a `&mut` table of `i64`, `usize`
// indices checked against the grid with `as i32` arithmetic, and an
// `i32` answer.

fn dfs(grid: Vec[Vec[i32]], memo: mut ref Vec[Vec[i64]], i: i64, j: i64) -> i64 {
    if memo[i][j] != 0 {
        return memo[i][j];
    }
    let mut res = 1;
    let dirs = [(0, 1), (1, 0), (0, -1), (-1, 0)];
    for (di, dj) in dirs.iter() {
        let (ni, nj) = (i as i32 + di, j as i32 + dj);
        if ni >= 0 and nj >= 0 and (ni) < grid.len() and (nj) < grid[0].len()
            and grid[ni][nj] > grid[i][j]
        {
            res = (res + dfs(grid, mut memo, ni, nj)) % 1_000_000_007;
        }
    }
    memo[i][j] = res;
    res
}

impl Solution {
    pub fn count_paths(grid: Vec[Vec[i32]]) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let (m, n) = (grid.len(), grid[0].len());
        let mut memo = Vec.filled(m, Vec.filled(n, 0));
        let mut ans = 0;
        for i in 0..m {
            for j in 0..n {
                ans = (ans + dfs(grid, mut memo, i, j)) % MOD;
            }
        }
        ans as i32
    }
}

struct Solution {}

fn count_paths(grid: Vec[Vec[i64]]) -> i64 {
    let g: Vec[Vec[i32]] = grid.iter().map(|row| row.iter().map(|v| v as i32).collect()).collect();
    Solution.count_paths(g)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_grid(seed: mut ref i64, m: i64, n: i64, top: i64) -> Vec[Vec[i64]] {
    (0..m).map(|_| (0..n).map(|_| next_random(mut seed) % top + 1).collect()).collect()
}

fn main() {
    // LeetCode's two examples; then one cell, a 3 by 3 of equal values,
    // a row of 1 to 10, and 300 by 300 with values from 1 to 100
    println(f"{count_paths([[1, 1].to_vec(), [3, 4].to_vec()].to_vec())}");
    println(f"{count_paths([[1].to_vec(), [2].to_vec()].to_vec())}");
    println(f"{count_paths([[5].to_vec()].to_vec())}");
    println(f"{count_paths(Vec.filled(3, Vec.filled(3, 7)))}");
    let row: Vec[i64] = (1..=10).collect();
    println(f"{count_paths([row].to_vec())}");
    let mut seed = 2328;
    println(f"300 by 300: {count_paths(random_grid(mut seed, 300, 300, 100))}");
    // 1000 random grids of 1 to 6 by 1 to 6 with values from 1 to 5
    let mut check = 0;
    let mut total = 0;
    for _ in 0..1000 {
        let m = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % 6 + 1;
        let paths = count_paths(random_grid(mut seed, m, n, 5));
        check = (check * 31 + paths) % 1000000007;
        total = (total + paths) % 1000000007;
    }
    println(f"1000 grids: checksum {check}, total {total}");
}
