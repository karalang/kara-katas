// LeetCode #2328: Number of Increasing Paths in a Grid -- Kahn's order:
// each cell waits on its smaller neighbours, the cells with none start
// in a `VecDeque`, and as each cell leaves it hands its count of paths
// ending there to every larger neighbour and frees it once all that
// neighbour's smaller ones are done. The answer adds up the paths
// ending at every cell. O(m n).

const MOD: i64 = 1000000007;

fn count_paths(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let moves = [(0, 1), (1, 0), (0, -1), (-1, 0)];
    let mut waiting: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n, 0));
    let mut ending: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n, 1));
    let mut ready: VecDeque[(i64, i64)] = VecDeque.new();
    for r in 0..m {
        for c in 0..n {
            for (dr, dc) in moves {
                let (nr, nc) = (r + dr, c + dc);
                if nr >= 0 and nr < m and nc >= 0 and nc < n and grid[nr][nc] < grid[r][c] {
                    waiting[r][c] += 1;
                }
            }
            if waiting[r][c] == 0 {
                ready.push_back((r, c));
            }
        }
    }
    let mut total = 0;
    while let Some((r, c)) = ready.pop_front() {
        total = (total + ending[r][c]) % MOD;
        for (dr, dc) in moves {
            let (nr, nc) = (r + dr, c + dc);
            if nr >= 0 and nr < m and nc >= 0 and nc < n and grid[nr][nc] > grid[r][c] {
                ending[nr][nc] = (ending[nr][nc] + ending[r][c]) % MOD;
                waiting[nr][nc] -= 1;
                if waiting[nr][nc] == 0 {
                    ready.push_back((nr, nc));
                }
            }
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_grid(seed: mut ref i64, m: i64, n: i64, top: i64) -> Vec[Vec[i64]] {
    (0..m).map(|_| (0..n).map(|_| next_random(mut seed) % top + 1).collect()).collect()
}

fn main() {
    // LeetCode's two examples; then one cell, a 3 by 3 of equal values,
    // a row of 1 to 10, and 300 by 300 with values from 1 to 100
    println(f"{count_paths([[1, 1].to_vec(), [3, 4].to_vec()].to_vec())}");
    println(f"{count_paths([[1].to_vec(), [2].to_vec()].to_vec())}");
    println(f"{count_paths([[5].to_vec()].to_vec())}");
    println(f"{count_paths(Vec.filled(3, Vec.filled(3, 7)))}");
    let row: Vec[i64] = (1..=10).collect();
    println(f"{count_paths([row].to_vec())}");
    let mut seed = 2328;
    println(f"300 by 300: {count_paths(random_grid(mut seed, 300, 300, 100))}");
    // 1000 random grids of 1 to 6 by 1 to 6 with values from 1 to 5
    let mut check = 0;
    let mut total = 0;
    for _ in 0..1000 {
        let m = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % 6 + 1;
        let paths = count_paths(random_grid(mut seed, m, n, 5));
        check = (check * 31 + paths) % 1000000007;
        total = (total + paths) % 1000000007;
    }
    println(f"1000 grids: checksum {check}, total {total}");
}
