// LeetCode #2328: Number of Increasing Paths in a Grid -- the bench, the ★
// arm. The paths that start at a cell are the one of that cell alone and,
// for each neighbour holding more, every path starting there. So the
// cells are sorted by value, largest first, and each cell's count is
// built from its larger neighbours', all of which are already done.
// The answer is every cell's count added up. O(m n log(m n)).

const MOD: i64 = 1000000007;

fn count_paths(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let n = grid[0].len();
    let mut cells: Vec[(i64, i64, i64)] = Vec.new();
    for r in 0..m {
        for c in 0..n {
            cells.push((grid[r][c], r, c));
        }
    }
    cells.sort();
    cells.reverse();
    let moves = [(0, 1), (1, 0), (0, -1), (-1, 0)];
    let mut from: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n, 1));
    let mut total = 0;
    for (value, r, c) in cells.iter() {
        for (dr, dc) in moves.iter() {
            let (nr, nc) = (r + dr, c + dc);
            if nr >= 0 and nr < m and nc >= 0 and nc < n and grid[nr][nc] > value {
                from[r][c] = (from[r][c] + from[nr][nc]) % MOD;
            }
        }
        total = (total + from[r][c]) % MOD;
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10 grids of 250 by 400 with values from 1 to 1000, built once; 3
    // passes count the paths of every grid
    let mut seed = 2328;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..10 {
        let grid: Vec[Vec[i64]] = (0..250).map(|_| (0..400).map(|_| next_random(mut seed) % 1000 + 1).collect()).collect();
        grids.push(grid);
    }
    let mut check = 0;
    for p in 0..3 {
        for k in 0..10 {
            check = (check * 31 + count_paths(grids[k]) + p) % 1000000007;
        }
    }
    println(f"3 passes over 10 grids of 10^5 cells: checksum {check}");
}
