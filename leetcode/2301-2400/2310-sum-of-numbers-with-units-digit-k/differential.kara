// LeetCode #2310: Sum of Numbers With Units Digit K -- the differential.
// The six arms, against the statement read literally: for each size from
// 0 up, every multiset of that many positive numbers ending in `k`, as
// a non-increasing list, is searched for one summing to `num`; the first
// size that has one is the answer, and -1 when a size beyond `num` is
// reached. Every `num` from 0 to 60 with every `k` from 0 to 9, 610
// cases.
//
// P1  the answer is the literal reading's
// P2  the answer is 0 exactly when `num` is 0, and otherwise -1 or from
//     1 to 10
// P3  `num + 10`, where the answer `n` is 1 or more: `n` again
// P4  `num - 10`, where the answer `n` is 1 or more and `num - 10` is
//     at least `n k` and above 0: `n` again
// P5  `num - k`, where the answer `n` is 2 or more: `n - 1`
// P6  each arm agrees with at least three of the other five

// ---- units.kara: the ★ arm, counts 1 to 10
fn star_numbers(num: i64, k: i64) -> i64 {
    if num == 0 {
        return 0;
    }
    for n in 1..=10 {
        if n * k <= num and (num - n * k) % 10 == 0 {
            return n;
        }
    }
    -1
}

// ---- units_naive.kara: coin change
fn naive_numbers(num: i64, k: i64) -> i64 {
    let mut coins: Vec[i64] = Vec.new();
    let mut coin = if k == 0 { 10 } else { k };
    while coin <= num {
        coins.push(coin);
        coin += 10;
    }
    let mut fewest = Vec.filled(num + 1, -1);
    fewest[0] = 0;
    for s in 1..=num {
        for c in coins.iter() {
            if c <= s and fewest[s - c] >= 0 and (fewest[s] < 0 or fewest[s - c] + 1 < fewest[s]) {
                fewest[s] = fewest[s - c] + 1;
            }
        }
    }
    fewest[num]
}

// ---- units_bfs.kara: breadth first over the sums
fn bfs_numbers(num: i64, k: i64) -> i64 {
    let mut steps = Vec.filled(num + 1, -1);
    steps[0] = 0;
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(0);
    while let Some(s) = queue.pop_front() {
        if s == num {
            return steps[s];
        }
        let mut add = if k == 0 { 10 } else { k };
        while s + add <= num {
            if steps[s + add] < 0 {
                steps[s + add] = steps[s] + 1;
                queue.push_back(s + add);
            }
            add += 10;
        }
    }
    -1
}

// ---- units_digit.kara: the units digit walked
fn digit_numbers(num: i64, k: i64) -> i64 {
    if num == 0 {
        return 0;
    }
    let mut digit = 0;
    let mut total = 0;
    for n in 1..=10 {
        digit = (digit + k) % 10;
        total += k;
        if total > num {
            return -1;
        }
        if digit == num % 10 {
            return n;
        }
    }
    -1
}

// ---- units_iter.kara: `find` over 1 to 10
fn iter_numbers(num: i64, k: i64) -> i64 {
    if num == 0 {
        0
    } else {
        (1..=10).find(|n| n * k <= num and (num - n * k) % 10 == 0).unwrap_or(-1)
    }
}

// ---- units_solution.kara: LeetCode's Rust template
struct Solution {}

impl Solution {
    pub fn minimum_numbers(num: i32, k: i32) -> i32 {
        if num == 0 {
            return 0;
        }
        for i in 1i32..=10 {
            if i * k <= num and (num - i * k) % 10 == 0 {
                return i;
            }
        }
        -1
    }
}

fn solution_numbers(num: i64, k: i64) -> i64 {
    Solution.minimum_numbers(num as i32, k as i32)
}

// ---- the statement read literally ------------------------------------------

// whether `count` more positive numbers ending in `k`, none above `most`,
// sum to `left`
fn literal_fits(left: i64, count: i64, most: i64, k: i64) -> bool {
    if count == 0 {
        return left == 0;
    }
    let mut part = most;
    while part >= 1 {
        if part % 10 == k and part <= left and literal_fits(left - part, count - 1, part, k) {
            return true;
        }
        part -= 1;
    }
    false
}

fn literal(num: i64, k: i64) -> i64 {
    for size in 0..=num {
        if literal_fits(num, size, num, k) {
            return size;
        }
    }
    -1
}

fn answer(arm: i64, num: i64, k: i64) -> i64 {
    match arm {
        0 => star_numbers(num, k),
        1 => naive_numbers(num, k),
        2 => bfs_numbers(num, k),
        3 => digit_numbers(num, k),
        4 => iter_numbers(num, k),
        _ => solution_numbers(num, k),
    }
}

fn main() {
    let names = ["star", "naive", "bfs", "digit", "iter", "solution"];
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut cases = 0;
    for num in 0..=60 {
        for k in 0..10 {
            cases += 1;
            let truth = literal(num, k);
            check = (check * 31 + truth + 1) % 1000000007;
            let got: Vec[i64] = (0..6).map(|arm| answer(arm, num, k)).collect();
            for arm in 0..6 {
                let value = got[arm];
                let mut same = 0;
                for o in 0..6 {
                    if o != arm and got[o] == value {
                        same += 1;
                    }
                }
                let shape = if num == 0 { value == 0 } else { value == -1 or (value >= 1 and value <= 10) };
                let verdicts = [
                    value == truth,
                    shape,
                    value < 1 or answer(arm, num + 10, k) == value,
                    value < 1 or num - 10 < value * k or num - 10 <= 0 or answer(arm, num - 10, k) == value,
                    value < 2 or answer(arm, num - k, k) == value - 1,
                    same >= 3,
                ];
                for q in 0..6 {
                    checks += 1;
                    if not verdicts[q] {
                        by_property[q] += 1;
                        if failures.len() < 10 {
                            failures.push(f"{num}, {k} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                        }
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
