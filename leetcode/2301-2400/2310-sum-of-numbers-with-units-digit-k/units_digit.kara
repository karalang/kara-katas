// LeetCode #2310: Sum of Numbers With Units Digit K -- the units digit
// walked: `n` numbers of `k` end in `digit`, which moves on by `k` mod 10
// with each number, and `total` by `k`; the first `n` whose digit is
// `num`'s, while `total` stays within `num`, is the answer. Ten steps
// cover every digit the walk can reach. O(1), with no multiplication.

fn minimum_numbers(num: i64, k: i64) -> i64 {
    if num == 0 {
        return 0;
    }
    let mut digit = 0;
    let mut total = 0;
    for n in 1..=10 {
        digit = (digit + k) % 10;
        total += k;
        if total > num {
            return -1;
        }
        if digit == num % 10 {
            return n;
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; then 10 made of one 10, 0 that needs no
    // number at all, and the largest sum with each units digit
    let cases = [(58, 9), (37, 2), (0, 7), (10, 0), (0, 0), (3000, 9), (2999, 1), (3000, 3), (2998, 5)];
    for (num, k) in cases {
        println(f"{num}, {k}: {minimum_numbers(num, k)}");
    }
    // every sum from 0 to 200 with every units digit
    let mut check = 0;
    let mut impossible = 0;
    for num in 0..=200 {
        for k in 0..10 {
            let size = minimum_numbers(num, k);
            check = (check * 31 + size + 1) % 1000000007;
            if size < 0 {
                impossible += 1;
            }
        }
    }
    println(f"2010 cases: checksum {check}, {impossible} impossible");
}
