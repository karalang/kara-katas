// LeetCode #2310: Sum of Numbers With Units Digit K -- the ★ arm. A set
// of `n` numbers ending in `k` sums to `n k` plus some multiple of 10, and
// any multiple of 10 can be added to one of them. So the answer is the
// least `n` from 1 to 10 with `n k <= num` and `num - n k` a multiple of
// 10, since `n` and `n + 10` leave the same units digit; 0 for a sum of
// 0, and -1 when no `n` fits. O(1).

fn minimum_numbers(num: i64, k: i64) -> i64 {
    if num == 0 {
        return 0;
    }
    for n in 1..=10 {
        if n * k <= num and (num - n * k) % 10 == 0 {
            return n;
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; then 10 made of one 10, 0 that needs no
    // number at all, and the largest sum with each units digit
    let cases = [(58, 9), (37, 2), (0, 7), (10, 0), (0, 0), (3000, 9), (2999, 1), (3000, 3), (2998, 5)];
    for (num, k) in cases {
        println(f"{num}, {k}: {minimum_numbers(num, k)}");
    }
    // every sum from 0 to 200 with every units digit
    let mut check = 0;
    let mut impossible = 0;
    for num in 0..=200 {
        for k in 0..10 {
            let size = minimum_numbers(num, k);
            check = (check * 31 + size + 1) % 1000000007;
            if size < 0 {
                impossible += 1;
            }
        }
    }
    println(f"2010 cases: checksum {check}, {impossible} impossible");
}
