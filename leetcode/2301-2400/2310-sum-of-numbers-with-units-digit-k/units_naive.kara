// LeetCode #2310: Sum of Numbers With Units Digit K -- coin change: the
// numbers ending in `k` up to `num` are the coins, any number of each,
// and `fewest[s]` is the fewest coins summing to `s`, built from 0 up.
// O(num^2 / 10).

fn minimum_numbers(num: i64, k: i64) -> i64 {
    let mut coins: Vec[i64] = Vec.new();
    let mut coin = if k == 0 { 10 } else { k };
    while coin <= num {
        coins.push(coin);
        coin += 10;
    }
    let mut fewest = Vec.filled(num + 1, -1);
    fewest[0] = 0;
    for s in 1..=num {
        for c in coins.iter() {
            if c <= s and fewest[s - c] >= 0 and (fewest[s] < 0 or fewest[s - c] + 1 < fewest[s]) {
                fewest[s] = fewest[s - c] + 1;
            }
        }
    }
    fewest[num]
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; then 10 made of one 10, 0 that needs no
    // number at all, and the largest sum with each units digit
    let cases = [(58, 9), (37, 2), (0, 7), (10, 0), (0, 0), (3000, 9), (2999, 1), (3000, 3), (2998, 5)];
    for (num, k) in cases {
        println(f"{num}, {k}: {minimum_numbers(num, k)}");
    }
    // every sum from 0 to 200 with every units digit
    let mut check = 0;
    let mut impossible = 0;
    for num in 0..=200 {
        for k in 0..10 {
            let size = minimum_numbers(num, k);
            check = (check * 31 + size + 1) % 1000000007;
            if size < 0 {
                impossible += 1;
            }
        }
    }
    println(f"2010 cases: checksum {check}, {impossible} impossible");
}
