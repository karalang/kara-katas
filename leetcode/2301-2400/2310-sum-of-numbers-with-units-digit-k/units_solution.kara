// LeetCode #2310: Sum of Numbers With Units Digit K -- LeetCode's Rust
// template as a Rust user fills it in, carried by `karac fix`: `i32` in
// and out, the counts 1 to 10 tried with `&&` between the two tests.

struct Solution {}

impl Solution {
    pub fn minimum_numbers(num: i32, k: i32) -> i32 {
        if num == 0 {
            return 0;
        }
        for i in 1i32..=10 {
            if i * k <= num and (num - i * k) % 10 == 0 {
                return i;
            }
        }
        -1
    }
}

fn minimum_numbers(num: i64, k: i64) -> i64 {
    Solution.minimum_numbers(num as i32, k as i32)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; then 10 made of one 10, 0 that needs no
    // number at all, and the largest sum with each units digit
    let cases = [(58, 9), (37, 2), (0, 7), (10, 0), (0, 0), (3000, 9), (2999, 1), (3000, 3), (2998, 5)];
    for (num, k) in cases {
        println(f"{num}, {k}: {minimum_numbers(num, k)}");
    }
    // every sum from 0 to 200 with every units digit
    let mut check = 0;
    let mut impossible = 0;
    for num in 0..=200 {
        for k in 0..10 {
            let size = minimum_numbers(num, k);
            check = (check * 31 + size + 1) % 1000000007;
            if size < 0 {
                impossible += 1;
            }
        }
    }
    println(f"2010 cases: checksum {check}, {impossible} impossible");
}
