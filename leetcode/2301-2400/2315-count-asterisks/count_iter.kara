// LeetCode #2315: Count Asterisks -- iterators: the characters `fold`ed
// into the number of bars seen and the stars counted, a star counting
// while the bars are even.

fn count_asterisks(s: String) -> i64 {
    let (_, count) = s.chars().fold((0, 0), |(bars, count), c| match c {
        '|' => (bars + 1, count),
        '*' if bars % 2 == 0 => (bars, count + 1),
        _ => (bars, count),
    });
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` characters, a bar one time in `bars` and a star one time in
// `stars` of the rest, the others letters; one bar more at the end if
// the bars came out odd
fn text(seed: mut ref i64, n: i64, bars: i64, stars: i64) -> String {
    let mut s = String.new();
    let mut count = 0;
    for _ in 0..n {
        if next_random(mut seed) % bars == 0 {
            s.push('|');
            count += 1;
        } else if next_random(mut seed) % stars == 0 {
            s.push('*');
        } else {
            s.push((b'a' + (next_random(mut seed) % 26) as u8) as char);
        }
    }
    if count % 2 == 1 {
        s.push('|');
    }
    s
}

fn main() {
    // LeetCode's three examples; then stars only inside a pair, stars
    // and no bars, two empty pairs around stars, and stars on both sides
    let cases = ["l|*e*et|c**o|*de|", "iamprogrammer", "yo|uar|e**|b|e***au|tifu|l", "|*|", "**", "||**||", "*|*|*|*|*"];
    for s in cases {
        println(f"{s}: {count_asterisks(s.to_string())}");
    }
    // 999 characters, a third of them bars
    let mut seed = 2315;
    println(f"999 characters: {count_asterisks(text(mut seed, 999, 3, 2))}");
    // 2000 random strings of 1 to 40 characters, bars one time in 2 to
    // 8 and stars one time in 1 to 4 of the rest
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 40 + 1;
        let bars = next_random(mut seed) % 7 + 2;
        let stars = next_random(mut seed) % 4 + 1;
        let stars_out = count_asterisks(text(mut seed, n, bars, stars));
        check = (check * 31 + stars_out) % 1000000007;
        total += stars_out;
    }
    println(f"2000 strings: checksum {check}, {total} stars in all");
}
