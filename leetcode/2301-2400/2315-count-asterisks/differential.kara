// LeetCode #2315: Count Asterisks -- the differential. The six arms,
// against the statement read literally: the places of the bars are
// listed and taken two at a time, the first and second, the third and
// fourth, and a star is counted unless some pair has it between its
// two bars. 300 random strings of 1 to 40 characters; then 30 with no
// bars; then 30 of up to 1000 characters, a bar one time in 2. Every
// case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the answer is at most the number of stars
// P3  the string reversed: the same answer
// P4  a star put at each end: two more
// P5  the string between two more bars: the stars it holds less the
//     answer
// P6  each arm agrees with at least three of the other five

// ---- count.kara
fn star_count_asterisks(s: String) -> i64 {
    let mut inside = false;
    let mut count = 0;
    for c in s.chars() {
        if c == '|' {
            inside = not inside;
        } else if c == '*' and not inside {
            count += 1;
        }
    }
    count
}

// ---- count_naive.kara
fn naive_count_asterisks(s: String) -> i64 {
    let chars: Vec[char] = s.chars().collect();
    let mut count = 0;
    for i in 0..chars.len() {
        if chars[i] == '*' {
            let mut bars = 0;
            for j in 0..i {
                if chars[j] == '|' {
                    bars += 1;
                }
            }
            if bars % 2 == 0 {
                count += 1;
            }
        }
    }
    count
}

// ---- count_split.kara
fn split_count_asterisks(s: String) -> i64 {
    let mut count = 0;
    for (i, piece) in s.split("|").enumerate() {
        if i % 2 == 0 {
            count += piece.matches("*").count();
        }
    }
    count
}

// ---- count_pairs.kara
fn pairs_count_asterisks(s: String) -> i64 {
    let all = s.chars().filter(|c| c == '*').count();
    let mut inside = 0;
    let mut from = 0;
    while let Some(open) = s[from..].find("|") {
        let start = from + open + 1;
        let close = start + s[start..].find("|").unwrap();
        inside += s[start..close].chars().filter(|c| c == '*').count();
        from = close + 1;
    }
    all - inside
}

// ---- count_iter.kara
fn iter_count_asterisks(s: String) -> i64 {
    let (_, count) = s.chars().fold((0, 0), |(bars, count), c| match c {
        '|' => (bars + 1, count),
        '*' if bars % 2 == 0 => (bars, count + 1),
        _ => (bars, count),
    });
    count
}

// ---- count_solution.kara
struct Solution {}

impl Solution {
    pub fn count_asterisks(s: String) -> i32 {
        let mut inside = false;
        let mut count = 0;
        for c in s.chars() {
            match c {
                '|' => inside = not inside,
                '*' if not inside => count += 1,
                _ => {}
            }
        }
        count
    }
}

fn solution_count_asterisks(s: String) -> i64 {
    Solution.count_asterisks(s)
}

// ---- the statement read literally ------------------------------------------

fn literal(s: String) -> i64 {
    let chars: Vec[char] = s.chars().collect();
    let mut bars: Vec[i64] = Vec.new();
    for i in 0..chars.len() {
        if chars[i] == '|' {
            bars.push(i);
        }
    }
    let mut count = 0;
    for i in 0..chars.len() {
        if chars[i] == '*' {
            let mut between = false;
            let mut p = 0;
            while p + 1 < bars.len() {
                if bars[p] < i and i < bars[p + 1] {
                    between = true;
                }
                p += 2;
            }
            if not between {
                count += 1;
            }
        }
    }
    count
}

fn answer(arm: i64, s: String) -> i64 {
    match arm {
        0 => star_count_asterisks(s),
        1 => naive_count_asterisks(s),
        2 => split_count_asterisks(s),
        3 => pairs_count_asterisks(s),
        4 => iter_count_asterisks(s),
        _ => solution_count_asterisks(s),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` characters, a bar one time in `bars` and a star one time in
// `stars` of the rest, the others letters; one bar more at the end if
// the bars came out odd
fn text(seed: mut ref i64, n: i64, bars: i64, stars: i64) -> String {
    let mut s = String.new();
    let mut count = 0;
    for _ in 0..n {
        if next_random(mut seed) % bars == 0 {
            s.push('|');
            count += 1;
        } else if next_random(mut seed) % stars == 0 {
            s.push('*');
        } else {
            s.push((b'a' + (next_random(mut seed) % 26) as u8) as char);
        }
    }
    if count % 2 == 1 {
        s.push('|');
    }
    s
}

fn main() {
    let names = ["star", "naive", "split", "pairs", "iter", "solution"];
    let mut seed = 2315;
    let mut cases: Vec[String] = Vec.new();
    for c in 0..360 {
        if c < 300 {
            let n = next_random(mut seed) % 40 + 1;
            let bars = next_random(mut seed) % 7 + 2;
            let stars = next_random(mut seed) % 4 + 1;
            cases.push(text(mut seed, n, bars, stars));
        } else if c < 330 {
            let n = next_random(mut seed) % 40 + 1;
            cases.push(text(mut seed, n, 1000000, 2));
        } else {
            let n = next_random(mut seed) % 997 + 1;
            cases.push(text(mut seed, n, 2, 2));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for s in cases.iter() {
        let truth = literal(s);
        check = (check * 31 + truth) % 1000000007;
        let stars = s.chars().filter(|c| c == '*').count();
        let reversed: String = s.chars().rev().collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, s)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                value >= 0 and value <= stars,
                answer(arm, reversed) == value,
                answer(arm, f"*{s}*") == value + 2,
                answer(arm, f"|{s}|") == stars - value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{s} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
