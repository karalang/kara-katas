// LeetCode #2365: Task Scheduler II -- the bench, the ★ arm: the day goes
// forward one for each task, and jumps to the day after the type's last
// run plus `space` when that is later; a map keeps each type's last day.

fn task_scheduler_ii(tasks: Vec[i64], space: i64) -> i64 {
    let mut last: Map[i64, i64] = Map.new();
    let mut day = 0;
    for task in tasks.iter() {
        day += 1;
        if let Some(before) = last.get(task) {
            day = day.max(before + space + 1);
        }
        last[task] = day;
    }
    day
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // list a: 10^5 tasks of 4^(a / 2 + 1) types (at most 10^5) up to
    // 10^9, with a space of 3^a
    let mut seed = 2365;
    let mut lists: Vec[(Vec[i64], i64)] = Vec.new();
    let mut space = 1;
    for a in 0..10 {
        let kinds = (1 << (2 * (a / 2 + 1))).min(100000);
        let types: Vec[i64] = (0..kinds).map(|_| 1 + wide_random(mut seed) % 1000000000).collect();
        let tasks: Vec[i64] = (0..100000).map(|_| types[wide_random(mut seed) % kinds]).collect();
        lists.push((tasks, space));
        space *= 3;
    }
    let mut check = 0;
    for p in 0..20 {
        for list in lists.iter() {
            check = (check * 31 + task_scheduler_ii(list.0, list.1) % 1000000007 + p) % 1000000007;
        }
    }
    println(f"20 passes over 10 lists of 10^5 tasks: checksum {check}");
}
