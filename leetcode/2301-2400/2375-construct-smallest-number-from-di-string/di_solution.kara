// LeetCode #2375: Construct Smallest Number From DI String -- LeetCode's
// Rust template, as Rust writes it, carried by karac fix. The pattern's
// chars with one more I chained on by std::iter::once, each digit pushed
// as a char, and the stack emptied into the result at every I.

struct Solution {}

impl Solution {
    pub fn smallest_number(pattern: String) -> String {
        let mut res = String.new();
        let mut stack: Vec[char] = Vec.new();
        for (i, c) in pattern.chars().chain(once('I')).enumerate() {
            stack.push((b'1' + i as u8) as char);
            if c == 'I' {
                while let Some(d) = stack.pop() {
                    res.push(d);
                }
            }
        }
        res
    }
}

fn smallest_number(pattern: String) -> String {
    Solution.smallest_number(pattern)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples; one letter of each; then every pattern of
    // 1 to 8 letters, 510 in all, with a checksum of the numbers and how
    // many begin with 1
    println(smallest_number("IIIDIDDD"));
    println(smallest_number("DDD"));
    println(f"{smallest_number("I")} {smallest_number("D")}");
    let mut check = 0;
    let mut ones = 0;
    let mut count = 0;
    for n in 1..9 {
        for mask in 0..1 << n {
            let letters: Vec[u8] = (0..n).map(|i| if (mask >> i) & 1 == 1 { b'D' } else { b'I' }).collect();
            let number = smallest_number(String.from_utf8(letters).unwrap());
            let value: i64 = i64.parse(number).unwrap();
            check = (check * 31 + value) % 1000000007;
            if number.starts_with("1") {
                ones += 1;
            }
            count += 1;
        }
    }
    println(f"{count} patterns: checksum {check}, {ones} begin with 1");
}
