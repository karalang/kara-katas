// LeetCode #2357: Make Array Zero by Subtracting Equal Amounts -- a table:
// one flag for each value from 0 to 100, set as the values are read, then
// the flags from 1 up counted. O(n + 100).

fn minimum_operations(nums: Vec[i64]) -> i64 {
    let mut present = [false; 101];
    for x in nums.iter() {
        present[x] = true;
    }
    let mut count = 0;
    for v in 1..101 {
        if present[v] {
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; all zeros; 1 to 100; 100 copies of 100
    println(f"{minimum_operations([1, 5, 0, 3, 5])}");
    println(f"{minimum_operations([0])}");
    println(f"{minimum_operations(Vec.filled(100, 0))}");
    println(f"{minimum_operations((1..101).collect())}");
    println(f"{minimum_operations(Vec.filled(100, 100))}");
    // 5000 random arrays of 1 to 100 values from 0 to 1 up to 0 to 100
    let mut seed = 2357;
    let mut check = 0;
    let mut total = 0;
    let mut zero = 0;
    for _ in 0..5000 {
        let n = 1 + next_random(mut seed) % 100;
        let top = 2 + next_random(mut seed) % 100;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top).collect();
        let m = minimum_operations(nums);
        check = (check * 31 + m) % 1000000007;
        total += m;
        if m == 0 {
            zero += 1;
        }
    }
    println(f"5000 arrays: checksum {check}, operations {total}, {zero} already zero");
}
