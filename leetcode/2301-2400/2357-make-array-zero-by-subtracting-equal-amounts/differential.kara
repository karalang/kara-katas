// LeetCode #2357: Make Array Zero by Subtracting Equal Amounts -- the
// differential. The six arms, against the statement read literally: the
// operation done on a fresh copy of the array each time, the least
// positive value found and subtracted from every positive value, and the
// operations counted until every value is 0. No distinct values counted.
// 300 random arrays of 1 to 100 values from 0 to 1 up to 0 to 100; then
// 30 of 100 values from 0 to 100; then 30 of up to 100 values, nine in
// ten of them 0. Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  from 0 to the number of positive values, and 0 exactly when every
//     value is 0
// P3  the values reversed: the same answer
// P4  every positive value x made 101 - x: the same answer
// P5  the values given twice over and a 0 added: the same answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn operations_literally(nums: Vec[i64]) -> i64 {
    let mut current = nums.clone();
    let mut count = 0;
    while current.iter().any(|x| x > 0) {
        let x = current.iter().filter(|v| v > 0).min().unwrap();
        let mut next: Vec[i64] = Vec.new();
        for v in current.iter() {
            next.push(if v > 0 { v - x } else { v });
        }
        current = next;
        count += 1;
    }
    count
}

// ---- star (zero.kara) ----------------------------------------------------

fn star_minimum_operations(nums: Vec[i64]) -> i64 {
    let mut seen: Set[i64] = Set.new();
    for x in nums.iter() {
        if x > 0 {
            seen.insert(x);
        }
    }
    seen.len()
}

// ---- simulate (zero_simulate.kara) ---------------------------------------

fn simulate_minimum_operations(nums: Vec[i64]) -> i64 {
    let mut values = nums.clone();
    let mut operations = 0;
    loop {
        let mut least = 0;
        for x in values.iter() {
            if x > 0 and (least == 0 or x < least) {
                least = x;
            }
        }
        if least == 0 {
            return operations;
        }
        for k in 0..values.len() {
            if values[k] > 0 {
                values[k] -= least;
            }
        }
        operations += 1;
    }
}

// ---- sorted (zero_sorted.kara) -------------------------------------------

fn sorted_minimum_operations(nums: Vec[i64]) -> i64 {
    let mut values = nums.clone();
    values.sort();
    let mut count = 0;
    let mut previous = 0;
    for x in values.iter() {
        if x != previous {
            count += 1;
            previous = x;
        }
    }
    count
}

// ---- table (zero_table.kara) ---------------------------------------------

fn table_minimum_operations(nums: Vec[i64]) -> i64 {
    let mut present = [false; 101];
    for x in nums.iter() {
        present[x] = true;
    }
    let mut count = 0;
    for v in 1..101 {
        if present[v] {
            count += 1;
        }
    }
    count
}

// ---- iter (zero_iter.kara) -----------------------------------------------

fn iter_minimum_operations(nums: Vec[i64]) -> i64 {
    let positive: Set[i64] = nums.iter().filter(|x| x > 0).collect();
    positive.len()
}

// ---- solution (zero_solution.kara) ---------------------------------------

struct Solution {}

impl Solution {
    pub fn minimum_operations(nums: own Vec[i32]) -> i32 {
        Set.from_iter(nums.into_iter().filter(|x| x > 0)).len() as i32
    }
}

fn solution_minimum_operations(nums: Vec[i64]) -> i64 {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.minimum_operations(nums)
}

// ---- the checks -------------------------------------------------------------

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_minimum_operations(nums),
        1 => simulate_minimum_operations(nums),
        2 => sorted_minimum_operations(nums),
        3 => table_minimum_operations(nums),
        4 => iter_minimum_operations(nums),
        _ => solution_minimum_operations(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "simulate", "sorted", "table", "iter", "solution"];
    let mut seed = 2357;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..360 {
        let mut nums: Vec[i64] = Vec.new();
        if c < 300 {
            let n = 1 + next_random(mut seed) % 100;
            let top = 2 + next_random(mut seed) % 100;
            for _ in 0..n {
                nums.push(next_random(mut seed) % top);
            }
        } else if c < 330 {
            for _ in 0..100 {
                nums.push(next_random(mut seed) % 101);
            }
        } else {
            let n = 1 + next_random(mut seed) % 100;
            for _ in 0..n {
                nums.push(if next_random(mut seed) % 10 == 0 { next_random(mut seed) % 101 } else { 0 });
            }
        }
        cases.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let nums = cases[c].clone();
        let truth = operations_literally(nums);
        check = (check * 31 + truth + 1) % 1000000007;
        let positive = nums.iter().filter(|x| x > 0).count();
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let reflected: Vec[i64] = nums.iter().map(|x| if x > 0 { 101 - x } else { 0 }).collect();
        let mut twice = nums.clone();
        twice.extend(nums.iter());
        twice.push(0);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                value >= 0 and value <= positive and (value == 0) == (positive == 0),
                answer(arm, reversed) == value,
                answer(arm, reflected) == value,
                answer(arm, twice) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
