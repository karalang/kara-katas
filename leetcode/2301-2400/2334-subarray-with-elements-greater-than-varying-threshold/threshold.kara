// LeetCode #2334: Subarray With Elements Greater Than Varying Threshold --
// the ★ arm. Any size that works may be returned; every arm here returns
// the largest, so that their answers can be compared. A subarray of
// length k works when its least element times k exceeds the threshold,
// and the longest subarray in which nums[i] is the least runs between
// the nearest smaller elements on either side, which a monotonic stack
// finds in one pass each way. The answer is the widest such run whose
// least element passes. O(n).

fn valid_subarray_size(nums: Vec[i64], threshold: i64) -> i64 {
    let n = nums.len();
    // left[i]: the nearest index before i holding a smaller value, or -1;
    // right[i]: the nearest after it, or n
    let mut left: Vec[i64] = Vec.filled(n, -1);
    let mut right: Vec[i64] = Vec.filled(n, n);
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..n {
        while stack.len() > 0 and nums[stack[stack.len() - 1]] >= nums[i] {
            right[stack.pop().unwrap()] = i;
        }
        if stack.len() > 0 {
            left[i] = stack[stack.len() - 1];
        }
        stack.push(i);
    }
    let mut best = -1;
    for i in 0..n {
        let width = right[i] - left[i] - 1;
        if nums[i] * width > threshold {
            best = best.max(width);
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_nums(seed: mut ref i64, n: i64, top: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        let draw = next_random(mut seed) * 32768 + next_random(mut seed);
        nums.push(draw % top + 1);
    }
    nums
}

fn main() {
    // LeetCode's two examples; then no size that works, one element just
    // short and just over, a rising run, and 2000 values up to 10^9
    // against a threshold of 10^9
    println(f"{valid_subarray_size([1, 3, 4, 3, 1].to_vec(), 6)}");
    println(f"{valid_subarray_size([6, 5, 6, 5, 8].to_vec(), 7)}");
    println(f"{valid_subarray_size([1, 1, 1].to_vec(), 10)}");
    println(f"{valid_subarray_size([1000000000].to_vec(), 1000000000)}");
    println(f"{valid_subarray_size([1000000000].to_vec(), 999999999)}");
    println(f"{valid_subarray_size((1..=100).collect(), 2500)}");
    let mut seed = 2334;
    let big = random_nums(mut seed, 2000, 1000000000);
    println(f"{valid_subarray_size(big, 1000000000)}");
    // 2000 random cases of 1 to 12 values from 1 to 20, threshold from 1
    // to 60
    let mut check = 0;
    let mut found = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let nums = random_nums(mut seed, n, 20);
        let threshold = next_random(mut seed) % 60 + 1;
        let size = valid_subarray_size(nums, threshold);
        check = (check * 31 + size + 1) % 1000000007;
        if size > 0 {
            found += 1;
        }
    }
    println(f"2000 cases: checksum {check}, {found} with a size");
}
