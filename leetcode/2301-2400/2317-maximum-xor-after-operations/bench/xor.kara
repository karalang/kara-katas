// LeetCode #2317: Maximum XOR After Operations -- the bench, the ★ arm in
// Kāra. The operation can clear any of a number's bits and set none, so
// the most is the OR of all the numbers.

fn maximum_xor(nums: Vec[i64]) -> i64 {
    let mut all = 0;
    for x in nums.iter() {
        all |= x;
    }
    all
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 arrays of 10^5 numbers built once, array `a` with the bits of
    // a random number up to 10^8 under a mask of `a + 4` random bits;
    // then 100 passes, pass `p` taking array `(a + p) % 20` at step `a`
    let mut seed = 2317;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for a in 0..20 {
        let mut mask = 0;
        for _ in 0..a + 4 {
            mask |= 1 << (next_random(mut seed) % 27);
        }
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            let hi = next_random(mut seed);
            nums.push((hi * 32768 + next_random(mut seed)) % 100000001 & mask);
        }
        arrays.push(nums);
    }
    let mut check = 0;
    for p in 0..100 {
        for a in 0..20 {
            check = (check * 31 + maximum_xor(arrays[(a + p) % 20])) % 1000000007;
        }
    }
    println(f"100 passes over 20 arrays of 10^5 numbers: checksum {check}");
}
