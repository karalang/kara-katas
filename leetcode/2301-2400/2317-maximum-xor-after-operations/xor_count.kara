// LeetCode #2317: Maximum XOR After Operations -- counted: one pass
// fills a table of how many numbers hold each bit, and the bits with a
// count above zero make the answer. O(n).

fn maximum_xor(nums: Vec[i64]) -> i64 {
    let mut count = [0; 27];
    for x in nums.iter() {
        let mut rest = x;
        let mut bit = 0;
        while rest > 0 {
            count[bit] += rest & 1;
            rest >>= 1;
            bit += 1;
        }
    }
    let mut best = 0;
    for bit in 0..27 {
        if count[bit] > 0 {
            best |= 1 << bit;
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then one zero, one number, two equal
    // numbers, and the largest number beside a power of two it holds
    // and one it does not
    let cases = [[3, 2, 4, 6].to_vec(), [1, 2, 3, 9, 2].to_vec(), [0].to_vec(), [12345].to_vec(), [5, 5].to_vec(), [100000000, 67108864, 33554432].to_vec()];
    for nums in cases {
        println(maximum_xor(nums));
    }
    // 10^5 numbers up to 10^8, each with only the bits of a random mask
    let mut seed = 2317;
    let mut big: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        let value = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000001;
        big.push(value & (next_random(mut seed) * 4096));
    }
    println(maximum_xor(big));
    // 1000 random arrays of 1 to 30 numbers below 2^1 to 2^27
    let mut check = 0;
    let mut ones = 0;
    for _ in 0..1000 {
        let n = next_random(mut seed) % 30 + 1;
        let top = 1 << (next_random(mut seed) % 27 + 1);
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % top);
        }
        let best = maximum_xor(nums);
        check = (check * 31 + best) % 1000000007;
        ones += best.count_ones();
    }
    println(f"1000 arrays: checksum {check}, {ones} bits set in all");
}
