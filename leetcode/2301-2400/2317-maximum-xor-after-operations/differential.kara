// LeetCode #2317: Maximum XOR After Operations -- the differential. The
// six arms, against the statement read literally: each number in turn
// is given `nums[i] & (nums[i] ^ x)` for every `x` below the next power
// of two, or left as it is, and a table of the XORs reachable so far is
// carried through; the largest XOR in it is the answer. 300 random
// arrays of 1 to 6 numbers below 2^1 to 2^4; then 30 of one number
// repeated; then 30 of 1 to 6 numbers below 2^6. Every case is drawn
// before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the answer is at least every number and the XOR of them all
// P3  the numbers reversed: the same answer
// P4  every number twice: the same answer
// P5  `2^26` added to the numbers: `2^26` more
// P6  each arm agrees with at least three of the other five

// ---- xor.kara
fn star_maximum_xor(nums: Vec[i64]) -> i64 {
    let mut all = 0;
    for x in nums.iter() {
        all |= x;
    }
    all
}

// ---- xor_naive.kara
fn naive_maximum_xor(nums: Vec[i64]) -> i64 {
    let mut best = 0;
    for bit in 0..27 {
        let mut held = false;
        for x in nums.iter() {
            if (x >> bit) & 1 == 1 {
                held = true;
            }
        }
        if held {
            best += 1 << bit;
        }
    }
    best
}

// ---- xor_ops.kara
fn ops_maximum_xor(nums: Vec[i64]) -> i64 {
    let mut nums = nums.clone();
    for bit in 0..27 {
        let x = 1 << bit;
        let mut holders = 0;
        let mut last = -1;
        for i in 0..nums.len() {
            if nums[i] & x != 0 {
                holders += 1;
                last = i;
            }
        }
        if holders > 0 and holders % 2 == 0 {
            nums[last] = nums[last] & (nums[last] ^ x);
        }
    }
    let mut result = 0;
    for v in nums.iter() {
        result ^= v;
    }
    result
}

// ---- xor_count.kara
fn count_maximum_xor(nums: Vec[i64]) -> i64 {
    let mut count = [0; 27];
    for x in nums.iter() {
        let mut rest = x;
        let mut bit = 0;
        while rest > 0 {
            count[bit] += rest & 1;
            rest >>= 1;
            bit += 1;
        }
    }
    let mut best = 0;
    for bit in 0..27 {
        if count[bit] > 0 {
            best |= 1 << bit;
        }
    }
    best
}

// ---- xor_iter.kara
fn iter_maximum_xor(nums: Vec[i64]) -> i64 {
    nums.iter().fold(0, |all, x| all | x)
}

// ---- xor_solution.kara
struct Solution {}

impl Solution {
    pub fn maximum_xor(nums: own Vec[i32]) -> i32 {
        nums.into_iter().fold(0, |a, b| a | b)
    }
}

fn solution_maximum_xor(nums: Vec[i64]) -> i64 {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.maximum_xor(nums)
}

// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64]) -> i64 {
    let mut size = 1;
    for x in nums.iter() {
        while size <= x {
            size *= 2;
        }
    }
    let mut reach = Vec.filled(size, false);
    reach[0] = true;
    for v in nums.iter() {
        let mut next = Vec.filled(size, false);
        for r in 0..size {
            if reach[r] {
                for x in 0..size {
                    next[r ^ (v & (v ^ x))] = true;
                }
            }
        }
        reach = next;
    }
    let mut best = 0;
    for r in 0..size {
        if reach[r] {
            best = r;
        }
    }
    best
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_maximum_xor(nums),
        1 => naive_maximum_xor(nums),
        2 => ops_maximum_xor(nums),
        3 => count_maximum_xor(nums),
        4 => iter_maximum_xor(nums),
        _ => solution_maximum_xor(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "naive", "ops", "count", "iter", "solution"];
    let mut seed = 2317;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..360 {
        let n = next_random(mut seed) % 6 + 1;
        let top = if c < 300 { 1 << (next_random(mut seed) % 4 + 1) } else { 64 };
        let mut nums: Vec[i64] = Vec.new();
        if c >= 300 and c < 330 {
            let v = next_random(mut seed) % 64;
            for _ in 0..n {
                nums.push(v);
            }
        } else {
            for _ in 0..n {
                nums.push(next_random(mut seed) % top);
            }
        }
        cases.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for nums in cases.iter() {
        let truth = literal(nums);
        check = (check * 31 + truth) % 1000000007;
        let mut plain = 0;
        let mut largest = 0;
        for x in nums.iter() {
            plain ^= x;
            largest = largest.max(x);
        }
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let mut twice: Vec[i64] = nums.clone();
        twice.extend(nums.iter());
        let mut more: Vec[i64] = nums.clone();
        more.push(1 << 26);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                value >= largest and value >= plain,
                answer(arm, reversed) == value,
                answer(arm, twice) == value,
                answer(arm, more) == value + (1 << 26),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
