// LeetCode #2389: Longest Subsequence With Limited Sum -- offline, with
// two pointers. The values sorted, and the queries' places sorted by
// their limits; one pointer walks the values' running sum forward as the
// limits grow, so each query starts where the smaller one before it
// stopped. O(n log n + m log m).

fn answer_queries(nums: Vec[i64], queries: Vec[i64]) -> Vec[i64] {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut order: Vec[i64] = (0..queries.len()).collect();
    order.sort_by_key(|i| queries[i]);
    let mut answer: Vec[i64] = Vec.filled(queries.len(), 0);
    let mut taken = 0;
    let mut used = 0;
    for i in order.iter() {
        while taken < sorted.len() and used + sorted[taken] <= queries[i] {
            used += sorted[taken];
            taken += 1;
        }
        answer[i] = taken;
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    let high = next_random(mut seed);
    high * 32768 + next_random(mut seed)
}

fn fold(check: i64, values: Vec[i64]) -> i64 {
    let mut c = check;
    for v in values.iter() {
        c = (c * 31 + v) % 1000000007;
    }
    c
}

fn main() {
    // LeetCode's two examples; a query of 0 and one of everything; equal
    // values, each limit around a multiple; then 1000 values up to 10^6
    // with 1000 queries up to 10^9, as a checksum; then 3000 random arrays
    // of 1 to 30 values up to 1 to 100, with 1 to 10 queries up to the sum
    // and a little more, with a checksum and the total length
    println(f"{answer_queries([4, 5, 2, 1], [3, 10, 21])}");
    println(f"{answer_queries([2, 3, 4, 5], [1])}");
    println(f"{answer_queries([7, 1, 3], [0, 11, 100])}");
    println(f"{answer_queries([5, 5, 5, 5], [4, 5, 9, 10, 15, 19, 20, 21])}");
    let mut seed = 2389;
    let nums: Vec[i64] = (0..1000).map(|_| 1 + wide(mut seed) % 1000000).collect();
    let queries: Vec[i64] = (0..1000).map(|_| 1 + wide(mut seed) % 1000000000).collect();
    println(f"1000 queries: checksum {fold(0, answer_queries(nums, queries))}");
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 30;
        let top = 1 + next_random(mut seed) % 100;
        let nums: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % top).collect();
        let sum: i64 = nums.iter().sum();
        let m = 1 + next_random(mut seed) % 10;
        let queries: Vec[i64] = (0..m).map(|_| next_random(mut seed) % (sum + 5)).collect();
        let answer = answer_queries(nums, queries);
        check = fold(check, answer);
        total += answer.iter().sum();
    }
    println(f"3000 arrays: checksum {check}, lengths summing to {total}");
}
