// LeetCode #2350: Shortest Impossible Sequence of Rolls -- stamps: no
// clearing; each face keeps the number of the last piece it appeared in,
// so a face is new to the current piece when its stamp is older. O(n + k).

fn shortest_sequence(rolls: Vec[i64], k: i64) -> i64 {
    let mut stamp: Vec[i64] = Vec.filled(k + 1, -1);
    let mut piece = 0;
    let mut distinct = 0;
    for r in rolls {
        if stamp[r] != piece {
            stamp[r] = piece;
            distinct += 1;
            if distinct == k {
                piece += 1;
                distinct = 0;
            }
        }
    }
    piece + 1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; then one face rolled 10^5 times, 10^5
    // rolls cycling through 1000 faces, and 10^5 faces each rolled once
    println(f"{shortest_sequence([4, 2, 1, 2, 3, 3, 2, 4, 1].to_vec(), 4)}");
    println(f"{shortest_sequence([1, 1, 2, 2].to_vec(), 2)}");
    println(f"{shortest_sequence([1, 1, 3, 2, 2, 2, 3, 3].to_vec(), 4)}");
    println(f"{shortest_sequence(Vec.filled(100000, 1), 1)}");
    println(f"{shortest_sequence((0..100000).map(|i| i % 1000 + 1).collect(), 1000)}");
    println(f"{shortest_sequence((0..100000).map(|i| 100000 - i).collect(), 100000)}");
    // 2000 random cases of 1 to 40 rolls of a die with 1 to 6 faces
    let mut seed = 2350;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 40;
        let k = 1 + next_random(mut seed) % 6;
        let rolls: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % k).collect();
        let answer = shortest_sequence(rolls, k);
        check = (check * 31 + answer) % 1000000007;
        total += answer;
    }
    println(f"2000 cases: checksum {check}, sum {total}");
}
