// LeetCode #2366: Minimum Replacements to Sort the Array -- LeetCode's
// Rust template, carried over by `karac fix`: greedy from the right, the
// bound and the operations in `i64` over `i32` values.

struct Solution {}

impl Solution {
    pub fn minimum_replacement(nums: Vec[i32]) -> i64 {
        let mut bound = *nums.last().unwrap() as i64;
        let mut ops: i64 = 0;
        for x in nums.iter().rev().skip(1) {
            let v = x as i64;
            let k = (v + bound - 1) / bound;
            ops += k - 1;
            bound = v / k;
        }
        ops
    }
}

fn minimum_replacement(nums: Vec[i64]) -> i64 {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.minimum_replacement(nums)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one value; 10^5 values of 10^9 before a 1;
    // 10^5 values falling from 10^9; 10^5 values rising; then 2000 random
    // arrays of 1 to 40 values from 1 to 1 to 60
    println(f"{minimum_replacement([3, 9, 3])}");
    println(f"{minimum_replacement([1, 2, 3, 4, 5])}");
    println(f"{minimum_replacement([7])}");
    let mut heavy: Vec[i64] = (0..99999).map(|_| 1000000000).collect();
    heavy.push(1);
    println(f"{minimum_replacement(heavy)}");
    let falling: Vec[i64] = (0..100000).map(|i| 1000000000 - i * 9999).collect();
    println(f"{minimum_replacement(falling)}");
    let rising: Vec[i64] = (0..100000).map(|i| i + 1).collect();
    println(f"{minimum_replacement(rising)}");
    let mut seed = 2366;
    let mut check = 0;
    let mut sorted = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 40;
        let top = 1 + next_random(mut seed) % 60;
        let nums: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % top).collect();
        let ops = minimum_replacement(nums);
        check = (check * 31 + ops) % 1000000007;
        if ops == 0 {
            sorted += 1;
        }
    }
    println(f"2000 arrays: checksum {check}, {sorted} already sorted");
}
