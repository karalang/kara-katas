// LeetCode #2366: Minimum Replacements to Sort the Array -- the bench, the
// ★ arm: greedy from the right, a value over the bound split into the
// fewest pieces that fit, the bound becoming the smallest piece of the
// most even split.

fn minimum_replacement(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut bound = nums[n - 1];
    let mut ops = 0;
    for i in (0..n - 1).rev() {
        let v = nums[i];
        if v <= bound {
            bound = v;
        } else {
            let k = (v + bound - 1) / bound;
            ops += k - 1;
            bound = v / k;
        }
    }
    ops
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // array a: 10^5 values from 1 to 10^(a - 1) when a > 0, and a falling
    // run from 10^9 when a is 0
    let mut seed = 2366;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    let mut top = 1;
    for a in 0..10 {
        let nums: Vec[i64] = if a == 0 {
            (0..100000).map(|i| 1000000000 - i * 9999).collect()
        } else {
            (0..100000).map(|_| 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top).collect()
        };
        arrays.push(nums);
        if a > 0 {
            top *= 10;
        }
    }
    let mut check = 0;
    for p in 0..100 {
        for nums in arrays.iter() {
            check = (check * 31 + minimum_replacement(nums) % 1000000007 + p) % 1000000007;
        }
    }
    println(f"100 passes over 10 arrays of 10^5 values: checksum {check}");
}
