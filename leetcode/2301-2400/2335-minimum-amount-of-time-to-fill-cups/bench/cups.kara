// LeetCode #2335: Minimum Amount of Time to Fill Cups -- the bench, the ★
// arm: the larger of the most cups of one kind and half of all the cups,
// rounded up. O(1).

fn fill_cups(amount: Vec[i64]) -> i64 {
    let most = amount[0].max(amount[1]).max(amount[2]);
    let all = amount[0] + amount[1] + amount[2];
    most.max((all + 1) / 2)
}

fn main() {
    // 3 passes over every amount from 0 to 100 cups of each kind, one
    // `Vec` of three refilled for each call; pass `p` folds each answer
    // plus `p` into the checksum
    let mut amount: Vec[i64] = [0, 0, 0].to_vec();
    let mut check = 0;
    for p in 0..3 {
        for a in 0..=100 {
            for b in 0..=100 {
                for c in 0..=100 {
                    amount[0] = a;
                    amount[1] = b;
                    amount[2] = c;
                    check = (check * 31 + fill_cups(amount) + p) % 1000000007;
                }
            }
        }
    }
    println(f"3 passes over 101^3 amounts: checksum {check}");
}
