// LeetCode #2335: Minimum Amount of Time to Fill Cups -- the
// differential. The six arms, against the statement read literally:
// from the cups still wanted, every second may fill two cups of
// different kinds or one cup of any kind, every such choice tried, and
// the fewest seconds to fill them all kept, memoized by the cups left.
// No formula and no greed. 300 random cases of 0 to 8 cups of each
// kind; then 30 with one kind of up to 100 cups and the others up to
// 10; then 30 of up to 100 of each; every hundredth case no cups at
// all. Every case is drawn before any arm answers.
//
// P1  up to 8 cups of each kind, the answer is the literal reading's
// P2  the answer is at least the most cups of one kind and half of all
//     the cups, and at most all the cups
// P3  the kinds in any of the six orders: the same answer
// P4  one cup more of any one kind: no fewer seconds, and at most one
//     more
// P5  every kind with as many cups as the most of them: half of all
//     those cups, rounded up
// P6  each arm agrees with at least three of the other five

// ---- star (cups.kara) ----------------------------------------------------

fn star_fill_cups(amount: Vec[i64]) -> i64 {
    let most = amount[0].max(amount[1]).max(amount[2]);
    let all = amount[0] + amount[1] + amount[2];
    most.max((all + 1) / 2)
}

// ---- greedy (cups_greedy.kara) -------------------------------------------

fn greedy_fill_cups(amount: own Vec[i64]) -> i64 {
    let mut left = amount;
    let mut seconds = 0;
    loop {
        left.sort();
        if left[2] == 0 {
            return seconds;
        }
        left[2] -= 1;
        if left[1] > 0 {
            left[1] -= 1;
        }
        seconds += 1;
    }
}

// ---- heap (cups_heap.kara) -----------------------------------------------

fn heap_fill_cups(amount: Vec[i64]) -> i64 {
    let mut kinds: PriorityQueue[i64] = PriorityQueue.max_first();
    for cups in amount.iter() {
        if cups > 0 {
            kinds.push(cups);
        }
    }
    let mut seconds = 0;
    while let Some(first) = kinds.pop() {
        if let Some(second) = kinds.pop() {
            if second > 1 {
                kinds.push(second - 1);
            }
        }
        if first > 1 {
            kinds.push(first - 1);
        }
        seconds += 1;
    }
    seconds
}

// ---- search (cups_search.kara) -------------------------------------------

fn search_enough(amount: Vec[i64], seconds: i64) -> bool {
    let mut all = 0;
    for cups in amount.iter() {
        if cups > seconds {
            return false;
        }
        all += cups;
    }
    all <= 2 * seconds
}

fn search_fill_cups(amount: Vec[i64]) -> i64 {
    let mut low = 0;
    let mut high = amount[0] + amount[1] + amount[2];
    while low < high {
        let middle = (low + high) / 2;
        if search_enough(amount, middle) {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    low
}

// ---- iter (cups_iter.kara) -----------------------------------------------

fn iter_fill_cups(amount: Vec[i64]) -> i64 {
    let all: i64 = amount.iter().sum();
    (0..=all).find(|seconds| amount.iter().all(|cups| cups <= seconds) and all <= 2 * seconds).unwrap()
}

// ---- solution (cups_solution.kara) ---------------------------------------

impl Solution {
    pub fn fill_cups(amount: own Vec[i32]) -> i32 {
        let mut amount = amount;
        amount.sort();
        let (a, b, c) = (amount[0], amount[1], amount[2]);
        if a + b <= c {
            c
        } else {
            (a + b + c + 1) / 2
        }
    }
}

struct Solution {}

fn solution_fill_cups(amount: Vec[i64]) -> i64 {
    let amount: Vec[i32] = amount.iter().map(|x| x as i32).collect();
    Solution.fill_cups(amount)
}
// ---- the statement read literally ------------------------------------------

fn seconds_literally(cups: Vec[i64], memo: mut ref Map[Vec[i64], i64]) -> i64 {
    if cups[0] == 0 and cups[1] == 0 and cups[2] == 0 {
        return 0;
    }
    if let Some(known) = memo.get(cups) {
        return known;
    }
    let mut best = -1;
    for i in 0..3 {
        if cups[i] > 0 {
            // one cup of kind i
            let mut one = cups.clone();
            one[i] -= 1;
            let after = seconds_literally(one, mut memo) + 1;
            if best < 0 or after < best {
                best = after;
            }
            // and one of a different kind j beside it
            for j in i + 1..3 {
                if cups[j] > 0 {
                    let mut two = cups.clone();
                    two[i] -= 1;
                    two[j] -= 1;
                    let after = seconds_literally(two, mut memo) + 1;
                    if after < best {
                        best = after;
                    }
                }
            }
        }
    }
    memo.insert(cups.clone(), best);
    best
}

fn answer(arm: i64, amount: Vec[i64]) -> i64 {
    match arm {
        0 => star_fill_cups(amount),
        1 => greedy_fill_cups(amount.clone()),
        2 => heap_fill_cups(amount),
        3 => search_fill_cups(amount),
        4 => iter_fill_cups(amount),
        _ => solution_fill_cups(amount),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "greedy", "heap", "search", "iter", "solution"];
    let orders = [[0, 2, 1], [1, 0, 2], [1, 2, 0], [2, 0, 1], [2, 1, 0]];
    let mut seed = 2335;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..360 {
        let mut amount: Vec[i64] = Vec.new();
        for k in 0..3 {
            let top = if c < 300 { 8 } else if c < 330 and k == c % 3 { 100 } else if c < 330 { 10 } else { 100 };
            amount.push(next_random(mut seed) % (top + 1));
        }
        if c % 100 == 0 {
            amount = [0, 0, 0].to_vec();
        }
        cases.push(amount);
    }
    let mut memo: Map[Vec[i64], i64] = Map.new();
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, amount) in cases.iter().enumerate() {
        let small = c < 300;
        let truth = if small { seconds_literally(amount, mut memo) } else { -1 };
        if small {
            check = (check * 31 + truth) % 1000000007;
        }
        let most = amount.iter().max().unwrap();
        let all: i64 = amount.iter().sum();
        let level: Vec[i64] = [most, most, most].to_vec();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, amount)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let mut reordered = true;
            for order in orders.iter() {
                let turned: Vec[i64] = order.iter().map(|k| amount[k]).collect();
                if answer(arm, turned) != value {
                    reordered = false;
                }
            }
            let mut one_more = true;
            for k in 0..3 {
                let mut more = amount.clone();
                more[k] += 1;
                let after = answer(arm, more);
                if after < value or after > value + 1 {
                    one_more = false;
                }
            }
            let verdicts = [
                not small or value == truth,
                value >= most and 2 * value >= all and value <= all,
                reordered,
                one_more,
                answer(arm, level) == (3 * most + 1) / 2,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
