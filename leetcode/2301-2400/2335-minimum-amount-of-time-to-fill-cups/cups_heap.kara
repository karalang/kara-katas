// LeetCode #2335: Minimum Amount of Time to Fill Cups -- a
// `PriorityQueue.max_first()` of the kinds still wanting cups: each
// second pops the two with the most left, fills one cup of each, and
// pushes back those not yet done.

fn fill_cups(amount: Vec[i64]) -> i64 {
    let mut kinds: PriorityQueue[i64] = PriorityQueue.max_first();
    for cups in amount.iter() {
        if cups > 0 {
            kinds.push(cups);
        }
    }
    let mut seconds = 0;
    while let Some(first) = kinds.pop() {
        if let Some(second) = kinds.pop() {
            if second > 1 {
                kinds.push(second - 1);
            }
        }
        if first > 1 {
            kinds.push(first - 1);
        }
        seconds += 1;
    }
    seconds
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; then no cups, 100 of each, 100 of one
    // kind, and one kind just short of the other two together
    println(f"{fill_cups([1, 4, 2].to_vec())}");
    println(f"{fill_cups([5, 4, 4].to_vec())}");
    println(f"{fill_cups([5, 0, 0].to_vec())}");
    println(f"{fill_cups([0, 0, 0].to_vec())}");
    println(f"{fill_cups([100, 100, 100].to_vec())}");
    println(f"{fill_cups([0, 100, 0].to_vec())}");
    println(f"{fill_cups([40, 99, 60].to_vec())}");
    // 2000 random cases of 0 to 100 cups of each kind, a kind left empty
    // one time in 5
    let mut seed = 2335;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let mut amount: Vec[i64] = Vec.new();
        for _ in 0..3 {
            let cups = if next_random(mut seed) % 5 == 0 { 0 } else { next_random(mut seed) % 101 };
            amount.push(cups);
        }
        let seconds = fill_cups(amount);
        check = (check * 31 + seconds) % 1000000007;
        total += seconds;
    }
    println(f"2000 cases: checksum {check}, total {total}");
}
