// LeetCode #2302: Count Subarrays With Score Less Than K -- prefix sums
// and a binary search: for each end, the subarrays ending there score
// less the later they start, so the earliest start whose score is under
// `k` is found by bisection over `prefix`, and every start from it on
// counts. O(n log n).

fn count_subarrays(nums: Vec[i64], k: i64) -> i64 {
    let mut prefix: Vec[i64] = [0].to_vec();
    for x in nums.iter() {
        prefix.push(prefix[prefix.len() - 1] + x);
    }
    let mut count = 0;
    for end in 1..=nums.len() {
        // the first start in 0..end whose score is under k, or end
        let mut lo = 0;
        let mut hi = end;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if (prefix[end] - prefix[mid]) * (end - mid) < k {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        count += end - lo;
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then k = 1, which no subarray is under; a
    // k every subarray is under; one element; and 2000 elements of 10^5
    // with k = 10^15, which every subarray is under
    let mut cases: Vec[(Vec[i64], i64)] = [
        ([2, 1, 4, 3, 5], 10),
        ([1, 1, 1], 5),
        ([3, 1, 2], 1),
        ([3, 1, 2], 100),
        ([7], 8),
    ];
    let big: Vec[i64] = Vec.filled(2000, 100000);
    cases.push((big, 1000000000000000));
    for (nums, k) in cases.iter() {
        println(f"n = {nums.len()}, k = {k}: {count_subarrays(nums, k)}");
    }
    // 2000 random arrays of 1 to 60 elements from 1 to 20, with k from 1
    // to 3000
    let mut seed = 2302;
    let mut check = 0;
    let mut sum = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 60 + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % 20 + 1);
        }
        let k = next_random(mut seed) % 3000 + 1;
        let count = count_subarrays(nums, k);
        check = (check * 31 + count) % 1000000007;
        sum += count;
    }
    println(f"2000 arrays: checksum {check}, {sum} subarrays");
}
