// LeetCode #2342: Max Sum of a Pair With Equal Sum of Digits -- LeetCode's
// Rust template as a Rust user fills it in, carried by `karac fix`: a
// `HashMap` from each digit sum to the largest value seen, read through
// `if let Some(&b) = best.get(&s)` and raised through `entry().or_insert`.

impl Solution {
    pub fn maximum_sum(nums: Vec[i32]) -> i32 {
        let mut best: Map[i32, i32] = Map.new();
        let mut ans: i32 = -1;
        for x in nums.iter() {
            let mut s = 0;
            let mut y = x;
            while y > 0 {
                s += y % 10;
                y /= 10;
            }
            if let Some(b) = best.get(s).cloned() {
                ans = ans.max(b + x);
            }
            let e = best.entry(s).or_insert(0);
            *e = (*e).max(x);
        }
        ans
    }
}

struct Solution {}

fn maximum_sum(nums: Vec[i64]) -> i64 {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.maximum_sum(nums)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then one value, the largest digit sum
    // twice, 10^9 among its own digit sum, and 2000 values spread to 10^9
    println(f"{maximum_sum([18, 43, 36, 13, 7].to_vec())}");
    println(f"{maximum_sum([10, 12, 19, 14].to_vec())}");
    println(f"{maximum_sum([1].to_vec())}");
    println(f"{maximum_sum([999999999, 999999999].to_vec())}");
    println(f"{maximum_sum([1000000000, 1, 10, 100].to_vec())}");
    let big: Vec[i64] = (0..2000).map(|i| (i * 982451653 + 13) % 1000000000 + 1).collect();
    println(f"{maximum_sum(big)}");
    // 2000 random cases of 1 to 30 values up to 10, 100, 10^4 or 10^9
    let tops = [10, 100, 10000, 1000000000];
    let mut seed = 2342;
    let mut check = 0;
    let mut total = 0;
    let mut found = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 30;
        let top = tops[next_random(mut seed) % 4];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            let high = next_random(mut seed);
            nums.push(1 + (high * 32768 + next_random(mut seed)) % top);
        }
        let answer = maximum_sum(nums);
        check = (check * 31 + answer + 1) % 1000000007;
        total += answer;
        if answer >= 0 {
            found += 1;
        }
    }
    println(f"2000 cases: checksum {check}, sum {total}, with a pair {found}");
}
