// LeetCode #2342: Max Sum of a Pair With Equal Sum of Digits -- sorted:
// the values as (digit sum, value) pairs in order, so that each digit
// sum's two largest values are its last two, side by side. O(n log n).

fn digit_sum(x: i64) -> i64 {
    let mut rest = x;
    let mut s = 0;
    while rest > 0 {
        s += rest % 10;
        rest /= 10;
    }
    s
}

fn maximum_sum(nums: Vec[i64]) -> i64 {
    let mut keyed: Vec[(i64, i64)] = nums.iter().map(|x| (digit_sum(x), x)).collect();
    keyed.sort();
    let mut answer = -1;
    for i in 1..keyed.len() {
        let (s, x) = keyed[i];
        let (t, y) = keyed[i - 1];
        let last_of_its_sum = i + 1 == keyed.len() or keyed[i + 1].0 != s;
        if s == t and last_of_its_sum {
            answer = answer.max(x + y);
        }
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then one value, the largest digit sum
    // twice, 10^9 among its own digit sum, and 2000 values spread to 10^9
    println(f"{maximum_sum([18, 43, 36, 13, 7].to_vec())}");
    println(f"{maximum_sum([10, 12, 19, 14].to_vec())}");
    println(f"{maximum_sum([1].to_vec())}");
    println(f"{maximum_sum([999999999, 999999999].to_vec())}");
    println(f"{maximum_sum([1000000000, 1, 10, 100].to_vec())}");
    let big: Vec[i64] = (0..2000).map(|i| (i * 982451653 + 13) % 1000000000 + 1).collect();
    println(f"{maximum_sum(big)}");
    // 2000 random cases of 1 to 30 values up to 10, 100, 10^4 or 10^9
    let tops = [10, 100, 10000, 1000000000];
    let mut seed = 2342;
    let mut check = 0;
    let mut total = 0;
    let mut found = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 30;
        let top = tops[next_random(mut seed) % 4];
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            let high = next_random(mut seed);
            nums.push(1 + (high * 32768 + next_random(mut seed)) % top);
        }
        let answer = maximum_sum(nums);
        check = (check * 31 + answer + 1) % 1000000007;
        total += answer;
        if answer >= 0 {
            found += 1;
        }
    }
    println(f"2000 cases: checksum {check}, sum {total}, with a pair {found}");
}
