// LeetCode #2358: Maximum Number of Groups Entering a Competition -- the
// differential. The six arms, against the statement read literally: every
// way to cut the class into groups of strictly rising sizes is searched,
// size by size, for the most groups; the sorted grades dealt out in that
// order give the groups rising sums too, which is checked. No triangle
// numbers. 300 random classes of 1 to 40 students graded 1 to 1 up to 1
// to 10^5; then 30 of up to 3000; then 30 whose sizes sit next to a
// triangle number. Every case is drawn before any arm answers.
//
// P1  up to 40 students, the answer is the literal reading's
// P2  k (k + 1) / 2 <= n < (k + 1) (k + 2) / 2
// P3  every grade made 1: the same answer
// P4  k + 1 more students: one more group
// P5  one student fewer, when there are two or more: the same answer or
//     one fewer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn most_rising_sizes(left: i64, smallest: i64) -> i64 {
    let mut best = if left == 0 { 0 } else { -1 };
    for size in smallest..left + 1 {
        let rest = most_rising_sizes(left - size, size + 1);
        if rest >= 0 and rest + 1 > best {
            best = rest + 1;
        }
    }
    best
}

fn groups_literally(grades: Vec[i64]) -> i64 {
    let k = most_rising_sizes(grades.len(), 1);
    let mut sorted = grades.clone();
    sorted.sort();
    let mut sums: Vec[i64] = Vec.new();
    let mut next = 0;
    for size in 1..k + 1 {
        let take = if size == k { sorted.len() - next } else { size };
        sums.push(sorted[next..next + take].iter().sum());
        next += take;
    }
    for j in 1..sums.len() {
        if sums[j] <= sums[j - 1] {
            return -1;
        }
    }
    k
}

// ---- star (groups.kara) --------------------------------------------------

fn star_maximum_groups(grades: Vec[i64]) -> i64 {
    let n = grades.len();
    let mut k = 0;
    let mut used = 0;
    while used + k + 1 <= n {
        k += 1;
        used += k;
    }
    k
}

// ---- greedy (groups_greedy.kara) -----------------------------------------

fn greedy_maximum_groups(grades: Vec[i64]) -> i64 {
    let mut sorted = grades.clone();
    sorted.sort();
    let mut groups: Vec[Vec[i64]] = Vec.new();
    let mut next = 0;
    while next + groups.len() + 1 <= sorted.len() {
        let size = groups.len() + 1;
        groups.push(sorted[next..next + size].to_vec());
        next += size;
    }
    let last = groups.len() - 1;
    while next < sorted.len() {
        groups[last].push(sorted[next]);
        next += 1;
    }
    for j in 1..groups.len() {
        let before: i64 = groups[j - 1].iter().sum();
        let after: i64 = groups[j].iter().sum();
        if groups[j].len() <= groups[j - 1].len() or after <= before {
            return j;
        }
    }
    groups.len()
}

// ---- search (groups_search.kara) -----------------------------------------

fn search_maximum_groups(grades: Vec[i64]) -> i64 {
    let n = grades.len();
    let mut lo = 1;
    let mut hi = n;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if mid * (mid + 1) / 2 <= n {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

// ---- root (groups_root.kara) ---------------------------------------------

fn root_maximum_groups(grades: Vec[i64]) -> i64 {
    let n = grades.len();
    let mut k = (((8 * n + 1) as f64).sqrt() - 1.0) as i64 / 2;
    while k * (k + 1) / 2 > n {
        k -= 1;
    }
    while (k + 1) * (k + 2) / 2 <= n {
        k += 1;
    }
    k
}

// ---- iter (groups_iter.kara) ---------------------------------------------

fn iter_maximum_groups(grades: Vec[i64]) -> i64 {
    let n = grades.len();
    (1..n + 1)
        .scan(0, |used, k| Some((used + k, used + k)))
        .take_while(|used| used <= n)
        .count()
}

// ---- solution (groups_solution.kara) -------------------------------------

struct Solution {}

impl Solution {
    pub fn maximum_groups(grades: Vec[i32]) -> i32 {
        let n = grades.len() as i32;
        let mut (k, used) = (0, 0);
        while used + k + 1 <= n {
            k += 1;
            used += k;
        }
        k
    }
}

fn solution_maximum_groups(grades: Vec[i64]) -> i64 {
    let grades: Vec[i32] = grades.iter().map(|x| x as i32).collect();
    Solution.maximum_groups(grades)
}

// ---- the checks -------------------------------------------------------------

fn answer(arm: i64, grades: Vec[i64]) -> i64 {
    match arm {
        0 => star_maximum_groups(grades),
        1 => greedy_maximum_groups(grades),
        2 => search_maximum_groups(grades),
        3 => root_maximum_groups(grades),
        4 => iter_maximum_groups(grades),
        _ => solution_maximum_groups(grades),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "greedy", "search", "root", "iter", "solution"];
    let mut seed = 2358;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..360 {
        let n = if c < 300 {
            1 + next_random(mut seed) % 40
        } else if c < 330 {
            1 + next_random(mut seed) % 3000
        } else {
            let t = 1 + next_random(mut seed) % 70;
            (t * (t + 1) / 2 + next_random(mut seed) % 3 - 1).max(1)
        };
        let top = if c < 300 { 1 + next_random(mut seed) % 100000 } else { 100000 };
        cases.push((0..n).map(|_| 1 + next_random(mut seed) % top).collect());
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let grades = cases[c].clone();
        let n = grades.len();
        let small = n <= 40;
        let truth = if small { groups_literally(grades) } else { -1 };
        if small {
            check = (check * 31 + truth + 1) % 1000000007;
        }
        let ones: Vec[i64] = Vec.filled(n, 1);
        let fewer: Vec[i64] = grades[1..].to_vec();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, grades)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let mut more = grades.clone();
            for g in 0..value + 1 {
                more.push(1 + g % 7);
            }
            let less = if n >= 2 { answer(arm, fewer) } else { value };
            let verdicts = [
                not small or value == truth,
                value * (value + 1) / 2 <= n and n < (value + 1) * (value + 2) / 2,
                answer(arm, ones) == value,
                answer(arm, more) == value + 1,
                less == value or less == value - 1,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
