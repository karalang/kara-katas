// LeetCode #2358: Maximum Number of Groups Entering a Competition -- the
// root: k (k + 1) / 2 <= n solved as k = (sqrt(8 n + 1) - 1) / 2, the
// square root taken in `f64` and the result nudged by whole steps until
// it is exact. O(1).

fn maximum_groups(grades: Vec[i64]) -> i64 {
    let n = grades.len();
    let mut k = (((8 * n + 1) as f64).sqrt() - 1.0) as i64 / 2;
    while k * (k + 1) / 2 > n {
        k -= 1;
    }
    while (k + 1) * (k + 2) / 2 <= n {
        k += 1;
    }
    k
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one student; three; 10^5 students
    println(f"{maximum_groups([10, 6, 12, 7, 3, 5])}");
    println(f"{maximum_groups([8, 8])}");
    println(f"{maximum_groups([1])}");
    println(f"{maximum_groups([3, 2, 1])}");
    println(f"{maximum_groups((0..100000).map(|i| i * 7919 % 100000 + 1).collect())}");
    // 3000 random classes of 1 to 300 students graded 1 to 10^5
    let mut seed = 2358;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 300;
        let grades: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % 100000).collect();
        let k = maximum_groups(grades);
        check = (check * 31 + k) % 1000000007;
        total += k;
    }
    println(f"3000 classes: checksum {check}, groups {total}");
}
