// LeetCode #2358: Maximum Number of Groups Entering a Competition -- the
// groups built: the grades sorted, then group j given the next j + 1
// students while that many are left, the rest added to the last group,
// and the groups counted once both conditions are checked. O(n log n).

fn maximum_groups(grades: Vec[i64]) -> i64 {
    let mut sorted = grades.clone();
    sorted.sort();
    let mut groups: Vec[Vec[i64]] = Vec.new();
    let mut next = 0;
    while next + groups.len() + 1 <= sorted.len() {
        let size = groups.len() + 1;
        groups.push(sorted[next..next + size].to_vec());
        next += size;
    }
    let last = groups.len() - 1;
    while next < sorted.len() {
        groups[last].push(sorted[next]);
        next += 1;
    }
    for j in 1..groups.len() {
        let before: i64 = groups[j - 1].iter().sum();
        let after: i64 = groups[j].iter().sum();
        if groups[j].len() <= groups[j - 1].len() or after <= before {
            return j;
        }
    }
    groups.len()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one student; three; 10^5 students
    println(f"{maximum_groups([10, 6, 12, 7, 3, 5])}");
    println(f"{maximum_groups([8, 8])}");
    println(f"{maximum_groups([1])}");
    println(f"{maximum_groups([3, 2, 1])}");
    println(f"{maximum_groups((0..100000).map(|i| i * 7919 % 100000 + 1).collect())}");
    // 3000 random classes of 1 to 300 students graded 1 to 10^5
    let mut seed = 2358;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 300;
        let grades: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % 100000).collect();
        let k = maximum_groups(grades);
        check = (check * 31 + k) % 1000000007;
        total += k;
    }
    println(f"3000 classes: checksum {check}, groups {total}");
}
