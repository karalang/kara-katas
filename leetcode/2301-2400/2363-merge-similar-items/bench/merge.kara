// LeetCode #2363: Merge Similar Items -- the bench, the ★ arm: every item
// of both lists added into a sorted map from value to total weight, which
// walks out in order of value.

fn merge_similar_items(items1: Vec[Vec[i64]], items2: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let mut totals: SortedMap[i64, i64] = SortedMap.new();
    for item in items1.iter().chain(items2.iter()) {
        *totals.entry(item[0]).or_insert(0) += item[1];
    }
    totals.iter().map(|(value, weight)| [value, weight]).collect()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_items(seed: mut ref i64, count: i64) -> Vec[Vec[i64]] {
    // count distinct values from 1 to 1000 in a shuffled order, each with
    // a weight of 1 to 1000
    let mut values: Vec[i64] = (1..1001).collect();
    for i in (1..1000).rev() {
        values.swap(i, next_random(mut seed) % (i + 1));
    }
    (0..count).map(|i| [values[i], 1 + next_random(mut seed) % 1000]).collect()
}

fn main() {
    // pair a: lists of 100 (a + 1) and 1000 - 50 a items
    let mut seed = 2363;
    let mut pairs: Vec[(Vec[Vec[i64]], Vec[Vec[i64]])] = Vec.new();
    for a in 0..10 {
        let items1 = random_items(mut seed, 100 * (a + 1));
        let items2 = random_items(mut seed, 1000 - 50 * a);
        pairs.push((items1, items2));
    }
    let mut check = 0;
    for p in 0..400 {
        for pair in pairs.iter() {
            let merged = merge_similar_items(pair.0, pair.1);
            let last = merged[merged.len() - 1].clone();
            check = (check * 31 + merged.len() * 1009 + last[1] + p) % 1000000007;
        }
    }
    println(f"400 passes over 10 pairs of lists: checksum {check}");
}
