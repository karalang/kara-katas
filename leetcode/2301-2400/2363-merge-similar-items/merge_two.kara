// LeetCode #2363: Merge Similar Items -- two pointers: both lists sorted
// by value, then merged as merge sort merges, a value in both written
// once with the two weights added. O(n log n + m log m).

fn merge_similar_items(items1: Vec[Vec[i64]], items2: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let mut a = items1.clone();
    let mut b = items2.clone();
    a.sort();
    b.sort();
    let mut merged: Vec[Vec[i64]] = Vec.new();
    let mut i = 0;
    let mut j = 0;
    while i < a.len() or j < b.len() {
        if j == b.len() or (i < a.len() and a[i][0] < b[j][0]) {
            merged.push(a[i].clone());
            i += 1;
        } else if i == a.len() or b[j][0] < a[i][0] {
            merged.push(b[j].clone());
            j += 1;
        } else {
            merged.push([a[i][0], a[i][1] + b[j][1]]);
            i += 1;
            j += 1;
        }
    }
    merged
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(items: Vec[Vec[i64]]) -> String {
    let parts: Vec[String] = items.iter().map(|p| f"[{p[0]},{p[1]}]").collect();
    "[" + parts.join(",") + "]"
}

fn random_items(seed: mut ref i64, count: i64, values: i64) -> Vec[Vec[i64]] {
    // count distinct values from 1 to values, each with a weight of 1 to 1000
    let mut used: Vec[bool] = Vec.filled(values + 1, false);
    let mut items: Vec[Vec[i64]] = Vec.new();
    while items.len() < count {
        let v = 1 + next_random(mut seed) % values;
        if not used[v] {
            used[v] = true;
            items.push([v, 1 + next_random(mut seed) % 1000]);
        }
    }
    items
}

fn main() {
    // LeetCode's three examples; one item in each list with the same
    // value; 1000 items each with every value; then 2000 random pairs of
    // lists of 1 to 30 items with values from 1 to 1 to 60
    println(show(merge_similar_items([[1, 1], [4, 5], [3, 8]].to_vec(), [[3, 1], [1, 5]].to_vec())));
    println(show(merge_similar_items([[1, 1], [3, 2], [2, 3]].to_vec(), [[2, 1], [3, 2], [1, 3]].to_vec())));
    println(show(merge_similar_items([[1, 3], [2, 2]].to_vec(), [[7, 1], [2, 2], [1, 4]].to_vec())));
    println(show(merge_similar_items([[1000, 1000]].to_vec(), [[1000, 1000]].to_vec())));
    let all: Vec[Vec[i64]] = (1..1001).rev().map(|v| [v, v]).collect();
    let odd: Vec[Vec[i64]] = (1..1001).map(|v| [v, v % 7 + 1]).collect();
    let big = merge_similar_items(all, odd);
    let total: i64 = big.iter().map(|p| p[0] * p[1]).sum();
    println(f"{big.len()} values, {total}");
    let mut seed = 2363;
    let mut check = 0;
    let mut shared = 0;
    for _ in 0..2000 {
        let values = 1 + next_random(mut seed) % 60;
        let n = 1 + next_random(mut seed) % values.min(30);
        let m = 1 + next_random(mut seed) % values.min(30);
        let items1 = random_items(mut seed, n, values);
        let items2 = random_items(mut seed, m, values);
        let merged = merge_similar_items(items1, items2);
        for p in merged.iter() {
            check = (check * 31 + p[0] * 1009 + p[1]) % 1000000007;
        }
        check = (check * 31 + merged.len()) % 1000000007;
        shared += n + m - merged.len();
    }
    println(f"2000 pairs: checksum {check}, {shared} values in both");
}
