// LeetCode #2303: Calculate Amount Paid in Taxes -- the bench, the ★
// arm. Walk the brackets in order, taxing the part of the income inside
// each at its percent, summed in hundredths and divided once at the end.

fn calculate_tax(brackets: Vec[(i64, i64)], income: i64) -> f64 {
    let mut hundredths = 0;
    let mut below = 0;
    for (upper, percent) in brackets.iter() {
        if below >= income {
            break;
        }
        hundredths += (upper.min(income) - below) * percent;
        below = upper;
    }
    (hundredths as f64) / 100.0
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 lists of 100 brackets built once, the upper bound of bracket i
    // 10 (i + 1) less 0 to 4, the last 1000, each percent 0 to 100; then
    // 100 passes, each taxing every income from 0 to 1000 under every list
    let mut seed = 2303;
    let mut lists: Vec[Vec[(i64, i64)]] = Vec.new();
    for _ in 0..20 {
        let mut brackets: Vec[(i64, i64)] = Vec.new();
        for i in 0..100 {
            let less = if i == 99 { 0 } else { next_random(mut seed) % 5 };
            brackets.push((10 * (i + 1) - less, next_random(mut seed) % 101));
        }
        lists.push(brackets);
    }
    let mut check = 0;
    for _ in 0..100 {
        for brackets in lists.iter() {
            for income in 0..=1000 {
                let tax = ((calculate_tax(brackets, income) * 100.0).round()) as i64;
                check = (check * 31 + tax) % 1000000007;
            }
        }
    }
    println(f"100 passes over 20 lists of 100 brackets and 1001 incomes: checksum {check}");
}
