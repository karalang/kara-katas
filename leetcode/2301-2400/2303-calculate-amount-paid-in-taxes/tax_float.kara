// LeetCode #2303: Calculate Amount Paid in Taxes -- in floating point
// throughout, as the statement's answer is: each bracket adds its taxed
// part times its percent over 100 to an `f64`, and the walk stops once
// the income is used up. O(brackets).

fn calculate_tax(brackets: Vec[(i64, i64)], income: i64) -> f64 {
    let mut tax = 0.0;
    let mut left = income;
    let mut below = 0;
    for (upper, percent) in brackets.iter() {
        let part = left.min(upper - below);
        tax += (part as f64) * (percent as f64) / 100.0;
        left -= part;
        below = upper;
        if left == 0 {
            break;
        }
    }
    tax
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; then an income on a bracket's upper
    // bound, a bracket of 100 percent, and the largest income all taxed
    // in full
    let cases: Vec[(Vec[(i64, i64)], i64)] = [
        ([(3, 50), (7, 10), (12, 25)], 10),
        ([(1, 0), (4, 25), (5, 50)], 2),
        ([(2, 50)], 0),
        ([(5, 10), (9, 20)], 5),
        ([(1, 0), (2, 100), (10, 33)], 10),
        ([(1000, 100)], 1000),
    ];
    for (brackets, income) in cases.iter() {
        println(f"{income}: {calculate_tax(brackets, income):.5}");
    }
    // 2000 random cases of 1 to 10 brackets, the upper bounds rising to
    // at most 1000, percents from 0 to 100, and an income from 0 to the
    // last upper bound
    let mut seed = 2303;
    let mut check = 0;
    let mut cents = 0;
    for _ in 0..2000 {
        let mut brackets: Vec[(i64, i64)] = Vec.new();
        let mut upper = 0;
        for _ in 0..next_random(mut seed) % 10 + 1 {
            if upper < 1000 {
                upper = (upper + next_random(mut seed) % 150 + 1).min(1000);
                brackets.push((upper, next_random(mut seed) % 101));
            }
        }
        let income = next_random(mut seed) % (upper + 1);
        let tax = ((calculate_tax(brackets, income) * 100.0).round()) as i64;
        check = (check * 31 + tax) % 1000000007;
        cents += tax;
    }
    println(f"2000 cases: checksum {check}, {cents} cents in all");
}
