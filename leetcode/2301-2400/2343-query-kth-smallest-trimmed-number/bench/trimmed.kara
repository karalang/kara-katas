// LeetCode #2343: Query Kth Smallest Trimmed Number -- the bench, the ★
// arm: for each query the indices sorted by their trimmed text, as an
// owned key, and then by index, and the k-th taken.

fn smallest_trimmed_numbers(nums: Vec[String], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let width = nums[0].len();
    let mut answer: Vec[i64] = Vec.new();
    for query in queries {
        let (k, trim) = (query[0], query[1]);
        let mut order: Vec[i64] = (0..nums.len()).collect();
        order.sort_by_key(|i| (nums[i][width - trim..].to_string(), i));
        answer.push(order[k - 1]);
    }
    answer
}

fn scrambled(index: i64) -> i64 {
    index * 2654435761 % 2147483647
}

fn main() {
    let mut cases: Vec[(Vec[String], Vec[Vec[i64]])] = Vec.new();
    for c in 0..10 {
        let mut nums: Vec[String] = Vec.new();
        for i in 0..100 {
            let mut s = String.new();
            for d in 0..100 {
                s.push_str(f"{scrambled(c * 10000 + i * 100 + d) % 10}");
            }
            nums.push(s);
        }
        let queries: Vec[Vec[i64]] = (0..100)
            .map(|q| [1 + scrambled(c * 1000 + q + 500000) % 100, 1 + scrambled(c * 1000 + q + 700000) % 100].to_vec())
            .collect();
        cases.push((nums, queries));
    }
    let mut check = 0;
    for p in 0..50 {
        for (nums, queries) in cases.iter() {
            for i in smallest_trimmed_numbers(nums, queries) {
                check = (check * 31 + i + p) % 1000000007;
            }
        }
    }
    println(f"50 passes over 10 cases of 100 numbers of 100 digits under 100 queries: checksum {check}");
}
