// LeetCode #2338: Count the Number of Ideal Arrays -- the differential.
// The six arms, against the statement read literally: every array of n
// values from 1 to maxValue, made as the digits of a counter, and those
// in which each value divides the next counted. No chains, no binomials
// and no primes. 300 random cases of 2 to 4 places and values up to 1 to
// 8; then 30 of up to 60 places and values up to 300; then 30 of up to
// 3000 places and values up to 12, whose counts pass the modulus. Every
// case is drawn before any arm answers.
//
// P1  up to 4 places and values up to 8, the answer is the literal
//     reading's
// P2  two places: the sum over v of maxValue / v, each value's multiples
// P3  maxValue the largest prime p it reaches: p adds n arrays to p - 1
// P4  values up to 1, 2 and 3: 1, n + 1 and 2n + 1 arrays
// P5  the arrays ending at a times b, for a and b coprime, are those
//     ending at a times those ending at b
// P6  each arm agrees with at least three of the other five

const MODULUS: i64 = 1000000007;
const LONGEST: i64 = 14;

// ---- the statement read literally ------------------------------------------

fn ideal_literally(n: i64, max_value: i64) -> i64 {
    let mut digits: Vec[i64] = Vec.filled(n, 1);
    let mut count = 0;
    loop {
        let mut ideal = true;
        for i in 1..n {
            if digits[i] % digits[i - 1] != 0 {
                ideal = false;
            }
        }
        if ideal {
            count += 1;
        }
        let mut i = 0;
        while i < n and digits[i] == max_value {
            digits[i] = 1;
            i += 1;
        }
        if i == n {
            break;
        }
        digits[i] += 1;
    }
    count
}

// ---- star (ideal.kara) ---------------------------------------------------

fn star_power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut base = base % MODULUS;
    let mut exp = exp;
    while exp > 0 {
        if exp % 2 == 1 {
            result = result * base % MODULUS;
        }
        base = base * base % MODULUS;
        exp /= 2;
    }
    result
}

// C(m, k) for k from 0 below `count`, each from the one before.
fn star_binomials(m: i64, count: i64) -> Vec[i64] {
    let mut out: Vec[i64] = [1].to_vec();
    for k in 1..count {
        let next = out[k - 1] * ((m - k + 1) % MODULUS) % MODULUS * star_power(k, MODULUS - 2) % MODULUS;
        out.push(next);
    }
    out
}

fn star_ideal_arrays(n: i64, max_value: i64) -> i64 {
    let ways = star_binomials(n - 1, LONGEST);
    let mut ends: Vec[i64] = Vec.filled(max_value + 1, 1);
    ends[0] = 0;
    let mut answer = 0;
    for k in 0..LONGEST {
        let mut total = 0;
        for v in 1..=max_value {
            total = (total + ends[v]) % MODULUS;
        }
        answer = (answer + total * ways[k]) % MODULUS;
        let mut following: Vec[i64] = Vec.filled(max_value + 1, 0);
        for d in 1..=max_value {
            if ends[d] != 0 {
                let mut m = 2 * d;
                while m <= max_value {
                    following[m] = (following[m] + ends[d]) % MODULUS;
                    m += d;
                }
            }
        }
        ends = following;
    }
    answer
}

// ---- naive (ideal_naive.kara) --------------------------------------------

fn naive_ideal_arrays(n: i64, max_value: i64) -> i64 {
    let mut ending: Vec[i64] = Vec.filled(max_value + 1, 1);
    ending[0] = 0;
    for _ in 1..n {
        let mut longer: Vec[i64] = Vec.filled(max_value + 1, 0);
        for last in 1..=max_value {
            let mut next = last;
            while next <= max_value {
                longer[next] = (longer[next] + ending[last]) % MODULUS;
                next += last;
            }
        }
        ending = longer;
    }
    let mut answer = 0;
    for v in 1..=max_value {
        answer = (answer + ending[v]) % MODULUS;
    }
    answer
}

// ---- primes (ideal_primes.kara) ------------------------------------------

fn primes_power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut base = base % MODULUS;
    let mut exp = exp;
    while exp > 0 {
        if exp % 2 == 1 {
            result = result * base % MODULUS;
        }
        base = base * base % MODULUS;
        exp /= 2;
    }
    result
}

// C(n - 1 + e, e), the ways to place e rises among n places.
fn primes_rises(n: i64, e: i64) -> i64 {
    let mut ways = 1;
    for k in 1..=e {
        ways = ways * ((n - 1 + k) % MODULUS) % MODULUS * primes_power(k, MODULUS - 2) % MODULUS;
    }
    ways
}

fn primes_ideal_arrays(n: i64, max_value: i64) -> i64 {
    let mut answer = 0;
    for v in 1..=max_value {
        let mut rest = v;
        let mut ways = 1;
        let mut p = 2;
        while p * p <= rest {
            let mut e = 0;
            while rest % p == 0 {
                rest /= p;
                e += 1;
            }
            if e > 0 {
                ways = ways * primes_rises(n, e) % MODULUS;
            }
            p += 1;
        }
        if rest > 1 {
            ways = ways * primes_rises(n, 1) % MODULUS;
        }
        answer = (answer + ways) % MODULUS;
    }
    answer
}

// ---- memo (ideal_memo.kara) ----------------------------------------------

fn memo_chains(v: i64, k: i64, max_value: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if k == 0 {
        return 1;
    }
    if let Some(known) = memo.get((v, k)) {
        return known;
    }
    let mut count = 0;
    let mut m = 2 * v;
    while m <= max_value {
        count = (count + memo_chains(m, k - 1, max_value, mut memo)) % MODULUS;
        m += v;
    }
    memo.insert((v, k), count);
    count
}

fn memo_ideal_arrays(n: i64, max_value: i64) -> i64 {
    // row[k] = C(i, k) for i up to n - 1, kept to the first LONGEST
    let mut row: Vec[i64] = Vec.filled(LONGEST, 0);
    row[0] = 1;
    for _ in 0..n - 1 {
        for k in (1..LONGEST).rev() {
            row[k] = (row[k] + row[k - 1]) % MODULUS;
        }
    }
    let mut memo: Map[(i64, i64), i64] = Map.new();
    let mut answer = 0;
    for k in 0..LONGEST {
        let mut starts = 0;
        for v in 1..=max_value {
            starts = (starts + memo_chains(v, k, max_value, mut memo)) % MODULUS;
        }
        answer = (answer + starts * row[k]) % MODULUS;
    }
    answer
}

// ---- iter (ideal_iter.kara) ----------------------------------------------

fn iter_power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut base = base % MODULUS;
    let mut exp = exp;
    while exp > 0 {
        if exp % 2 == 1 {
            result = result * base % MODULUS;
        }
        base = base * base % MODULUS;
        exp /= 2;
    }
    result
}

fn iter_ideal_arrays(n: i64, max_value: i64) -> i64 {
    let mut divisors: Vec[Vec[i64]] = (0..=max_value).map(|_| Vec.new()).collect();
    for d in 1..=max_value {
        for m in (2 * d..=max_value).step_by(d) {
            divisors[m].push(d);
        }
    }
    let ways: Vec[i64] = (0..LONGEST)
        .scan(1, |c, k| {
            let next = c * ((n - 1 - k) % MODULUS) % MODULUS * iter_power(k + 1, MODULUS - 2) % MODULUS;
            Some((next, c))
        })
        .collect();
    let mut level: Vec[i64] = (0..=max_value).map(|v| if v == 0 { 0 } else { 1 }).collect();
    let mut totals: Vec[i64] = Vec.new();
    for _ in 0..LONGEST {
        totals.push(level.iter().fold(0, |s, x| (s + x) % MODULUS));
        level = (0..=max_value)
            .map(|v| divisors[v].iter().fold(0, |s, d| (s + level[d]) % MODULUS))
            .collect();
    }
    totals.iter().zip(ways.iter()).fold(0, |s, (t, w)| (s + t * w) % MODULUS)
}

// ---- solution (ideal_solution.kara) --------------------------------------

impl Solution {
    pub fn ideal_arrays(n: i32, max_value: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let n = n as i64;
        let m = max_value as i64;
        let mut c = Vec.filled(n + 15, Vec.filled(15, 0));
        for i in 0..n + 15 {
            c[i][0] = 1;
            for j in 1..=i.min(14) {
                c[i][j] = (c[i - 1][j - 1] + c[i - 1][j]) % MOD;
            }
        }
        let mut ans: i64 = 0;
        for v in 1..=m {
            let mut x = v;
            let mut res: i64 = 1;
            let mut p = 2;
            while p * p <= x {
                let mut e = 0;
                while x % p == 0 {
                    x /= p;
                    e += 1;
                }
                if e > 0 {
                    res = res * c[n - 1 + e][e] % MOD;
                }
                p += 1;
            }
            if x > 1 {
                res = res * c[n][1] % MOD;
            }
            ans = (ans + res) % MOD;
        }
        ans as i32
    }
}

struct Solution {}

fn solution_ideal_arrays(n: i64, max_value: i64) -> i64 {
    Solution.ideal_arrays(n as i32, max_value as i32)
}

// ---- the checks -------------------------------------------------------------

fn answer(arm: i64, n: i64, max_value: i64) -> i64 {
    match arm {
        0 => star_ideal_arrays(n, max_value),
        1 => naive_ideal_arrays(n, max_value),
        2 => primes_ideal_arrays(n, max_value),
        3 => memo_ideal_arrays(n, max_value),
        4 => iter_ideal_arrays(n, max_value),
        _ => solution_ideal_arrays(n, max_value),
    }
}

// The arrays of n places ending at v: those up to v less those up to v - 1.
fn ending_at(arm: i64, n: i64, v: i64) -> i64 {
    ((answer(arm, n, v) - answer(arm, n, v - 1)) % MODULUS + MODULUS) % MODULUS
}

fn is_prime(v: i64) -> bool {
    if v < 2 {
        return false;
    }
    let mut d = 2;
    while d * d <= v {
        if v % d == 0 {
            return false;
        }
        d += 1;
    }
    true
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "naive", "primes", "memo", "iter", "solution"];
    let mut seed = 2338;
    let mut cases: Vec[(i64, i64)] = Vec.new();
    for c in 0..360 {
        let (most_n, most_value) = if c < 300 { (4, 8) } else if c < 330 { (60, 300) } else { (3000, 12) };
        let n = 2 + next_random(mut seed) % (most_n - 1);
        let max_value = 1 + next_random(mut seed) % most_value;
        cases.push((n, max_value));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (n, max_value) = cases[c];
        let small = c < 300;
        let truth = if small { ideal_literally(n, max_value) } else { -1 };
        if small {
            check = (check * 31 + truth) % 1000000007;
        }
        let mut multiples = 0;
        for v in 1..=max_value {
            multiples += max_value / v;
        }
        let mut prime = max_value;
        while prime >= 2 and not is_prime(prime) {
            prime -= 1;
        }
        // a coprime pair whose product is at most maxValue, if any
        let mut pair = (0, 0);
        for a in 2..=max_value {
            for b in a + 1..=max_value / a {
                if gcd(a, b) == 1 {
                    pair = (a, b);
                }
            }
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, n, max_value)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let prime_step = prime < 2 or ending_at(arm, n, prime) == n % MODULUS;
            let small_values = answer(arm, n, 1) == 1 and answer(arm, n, 2) == n + 1 and answer(arm, n, 3) == 2 * n + 1;
            let (a, b) = pair;
            let product = a == 0 or ending_at(arm, n, a * b) == ending_at(arm, n, a) * ending_at(arm, n, b) % MODULUS;
            let verdicts = [
                not small or value == truth,
                answer(arm, 2, max_value) == multiples,
                prime_step,
                small_values,
                product,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} (n {n}, maxValue {max_value}), arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
