// LeetCode #2338: Count the Number of Ideal Arrays -- LeetCode's Rust
// template as a Rust user fills it in, carried by `karac fix`: a `const`
// modulus inside the method, a `vec!` table of binomials by Pascal's rule
// over `usize` indices, and each value's prime exponents by trial
// division, C(n - 1 + e, e) for each.

impl Solution {
    pub fn ideal_arrays(n: i32, max_value: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let n = n as i64;
        let m = max_value as i64;
        let mut c = Vec.filled(n + 15, Vec.filled(15, 0));
        for i in 0..n + 15 {
            c[i][0] = 1;
            for j in 1..=i.min(14) {
                c[i][j] = (c[i - 1][j - 1] + c[i - 1][j]) % MOD;
            }
        }
        let mut ans: i64 = 0;
        for v in 1..=m {
            let mut x = v;
            let mut res: i64 = 1;
            let mut p = 2;
            while p * p <= x {
                let mut e = 0;
                while x % p == 0 {
                    x /= p;
                    e += 1;
                }
                if e > 0 {
                    res = res * c[n - 1 + e][e] % MOD;
                }
                p += 1;
            }
            if x > 1 {
                res = res * c[n][1] % MOD;
            }
            ans = (ans + res) % MOD;
        }
        ans as i32
    }
}

struct Solution {}

fn ideal_arrays(n: i64, max_value: i64) -> i64 {
    Solution.ideal_arrays(n as i32, max_value as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then a single value allowed, ten thousand
    // places of it, ten thousand places up to 60, three places up to ten
    // thousand, and 300 places up to 3000
    println(f"{ideal_arrays(2, 5)}");
    println(f"{ideal_arrays(5, 3)}");
    println(f"{ideal_arrays(2, 1)}");
    println(f"{ideal_arrays(10000, 1)}");
    println(f"{ideal_arrays(10000, 60)}");
    println(f"{ideal_arrays(3, 10000)}");
    println(f"{ideal_arrays(300, 3000)}");
    // 2000 random cases of 2 to 40 places and values up to 1 to 80
    let mut seed = 2338;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = 2 + next_random(mut seed) % 39;
        let max_value = 1 + next_random(mut seed) % 80;
        let count = ideal_arrays(n, max_value);
        check = (check * 31 + count) % 1000000007;
        total += count;
    }
    println(f"2000 cases: checksum {check}, total {total}");
}
