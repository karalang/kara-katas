// LeetCode #2338: Count the Number of Ideal Arrays -- the ★ arm. An ideal
// array is a chain of distinct values, each dividing the next, spread over
// the n places in order: a chain of k + 1 values goes in C(n - 1, k) ways,
// choosing where each new value starts. A chain is at most 14 values long,
// since 2^14 passes 10^4, so the chains ending at each value are counted
// level by level, each level pushing its counts on to every multiple.
// O(maxValue log maxValue) a level.

const MODULUS: i64 = 1000000007;
const LONGEST: i64 = 14;

fn power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut base = base % MODULUS;
    let mut exp = exp;
    while exp > 0 {
        if exp % 2 == 1 {
            result = result * base % MODULUS;
        }
        base = base * base % MODULUS;
        exp /= 2;
    }
    result
}

// C(m, k) for k from 0 below `count`, each from the one before.
fn binomials(m: i64, count: i64) -> Vec[i64] {
    let mut out: Vec[i64] = [1].to_vec();
    for k in 1..count {
        let next = out[k - 1] * ((m - k + 1) % MODULUS) % MODULUS * power(k, MODULUS - 2) % MODULUS;
        out.push(next);
    }
    out
}

fn ideal_arrays(n: i64, max_value: i64) -> i64 {
    let ways = binomials(n - 1, LONGEST);
    let mut ends: Vec[i64] = Vec.filled(max_value + 1, 1);
    ends[0] = 0;
    let mut answer = 0;
    for k in 0..LONGEST {
        let mut total = 0;
        for v in 1..=max_value {
            total = (total + ends[v]) % MODULUS;
        }
        answer = (answer + total * ways[k]) % MODULUS;
        let mut following: Vec[i64] = Vec.filled(max_value + 1, 0);
        for d in 1..=max_value {
            if ends[d] != 0 {
                let mut m = 2 * d;
                while m <= max_value {
                    following[m] = (following[m] + ends[d]) % MODULUS;
                    m += d;
                }
            }
        }
        ends = following;
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then a single value allowed, ten thousand
    // places of it, ten thousand places up to 60, three places up to ten
    // thousand, and 300 places up to 3000
    println(f"{ideal_arrays(2, 5)}");
    println(f"{ideal_arrays(5, 3)}");
    println(f"{ideal_arrays(2, 1)}");
    println(f"{ideal_arrays(10000, 1)}");
    println(f"{ideal_arrays(10000, 60)}");
    println(f"{ideal_arrays(3, 10000)}");
    println(f"{ideal_arrays(300, 3000)}");
    // 2000 random cases of 2 to 40 places and values up to 1 to 80
    let mut seed = 2338;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = 2 + next_random(mut seed) % 39;
        let max_value = 1 + next_random(mut seed) % 80;
        let count = ideal_arrays(n, max_value);
        check = (check * 31 + count) % 1000000007;
        total += count;
    }
    println(f"2000 cases: checksum {check}, total {total}");
}
