// LeetCode #2338: Count the Number of Ideal Arrays -- by the last value's
// primes: along an ideal array each prime's exponent never falls, so the
// arrays ending at v are, for each prime p^e of v, the ways to raise the
// exponent from 0 to e over the n places, C(n - 1 + e, e), all multiplied.
// O(maxValue sqrt maxValue).

const MODULUS: i64 = 1000000007;

fn power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut base = base % MODULUS;
    let mut exp = exp;
    while exp > 0 {
        if exp % 2 == 1 {
            result = result * base % MODULUS;
        }
        base = base * base % MODULUS;
        exp /= 2;
    }
    result
}

// C(n - 1 + e, e), the ways to place e rises among n places.
fn rises(n: i64, e: i64) -> i64 {
    let mut ways = 1;
    for k in 1..=e {
        ways = ways * ((n - 1 + k) % MODULUS) % MODULUS * power(k, MODULUS - 2) % MODULUS;
    }
    ways
}

fn ideal_arrays(n: i64, max_value: i64) -> i64 {
    let mut answer = 0;
    for v in 1..=max_value {
        let mut rest = v;
        let mut ways = 1;
        let mut p = 2;
        while p * p <= rest {
            let mut e = 0;
            while rest % p == 0 {
                rest /= p;
                e += 1;
            }
            if e > 0 {
                ways = ways * rises(n, e) % MODULUS;
            }
            p += 1;
        }
        if rest > 1 {
            ways = ways * rises(n, 1) % MODULUS;
        }
        answer = (answer + ways) % MODULUS;
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then a single value allowed, ten thousand
    // places of it, ten thousand places up to 60, three places up to ten
    // thousand, and 300 places up to 3000
    println(f"{ideal_arrays(2, 5)}");
    println(f"{ideal_arrays(5, 3)}");
    println(f"{ideal_arrays(2, 1)}");
    println(f"{ideal_arrays(10000, 1)}");
    println(f"{ideal_arrays(10000, 60)}");
    println(f"{ideal_arrays(3, 10000)}");
    println(f"{ideal_arrays(300, 3000)}");
    // 2000 random cases of 2 to 40 places and values up to 1 to 80
    let mut seed = 2338;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = 2 + next_random(mut seed) % 39;
        let max_value = 1 + next_random(mut seed) % 80;
        let count = ideal_arrays(n, max_value);
        check = (check * 31 + count) % 1000000007;
        total += count;
    }
    println(f"2000 cases: checksum {check}, total {total}");
}
