// LeetCode #2349: Design a Number Container System -- the differential.
// The six arms, against the statement read literally: no container is
// kept at all, only the calls so far; find reads them back from the
// latest, and an index holds the number of the latest change that names
// it. The least index whose latest change gave the number, or -1. 300
// random scripts of 1 to 20 calls over indices 1 to 8 and numbers 1 to
// 4, three changes to every two finds; then 30 of up to 300 calls over
// indices up to 10^9 and numbers 1 to 3; then 30 of up to 300 calls over
// indices 1 to 3 and numbers 1 and 2. Every script is drawn before any
// arm answers.
//
// P1  up to 20 calls, the answers are the literal reading's
// P2  one answer to each find, each -1 or an index some earlier change
//     named
// P3  every index doubled: every answer doubled, -1 kept
// P4  every number made 100 more, in the changes and the finds: the same
//     answers
// P5  every find made twice in a row: each answer twice
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn answers_literally(calls: Vec[(i64, i64, i64)]) -> Vec[i64] {
    let mut answers: Vec[i64] = Vec.new();
    for c in 0..calls.len() {
        let (kind, number, _) = calls[c];
        if kind == 0 {
            continue;
        }
        let mut best = -1;
        for d in 0..c {
            let (was, index, given) = calls[d];
            if was != 0 or given != number {
                continue;
            }
            let mut latest = true;
            for e in d + 1..c {
                if calls[e].0 == 0 and calls[e].1 == index {
                    latest = false;
                }
            }
            if latest and (best < 0 or index < best) {
                best = index;
            }
        }
        answers.push(best);
    }
    answers
}

// ---- star (containers.kara) ----------------------------------------------

struct StarContainers {
    at: Map[i64, i64],
    heaps: Map[i64, PriorityQueue[i64]],
}

impl StarContainers {
    fn new() -> StarContainers {
        StarContainers { at: Map.new(), heaps: Map.new() }
    }

    fn change(mut ref self, index: i64, number: i64) {
        self.at[index] = number;
        if not self.heaps.contains_key(number) {
            self.heaps[number] = PriorityQueue.new();
        }
        self.heaps[number].push(index);
    }

    fn find(mut ref self, number: i64) -> i64 {
        if not self.heaps.contains_key(number) {
            return -1;
        }
        while let Some(top) = self.heaps[number].peek() {
            if self.at[top] == number {
                return top;
            }
            self.heaps[number].pop();
        }
        -1
    }
}

fn star_run(calls: Vec[(i64, i64, i64)]) -> Vec[i64] {
    let mut containers = StarContainers.new();
    let mut answers: Vec[i64] = Vec.new();
    for (kind, a, b) in calls.iter() {
        if kind == 0 {
            containers.change(a, b);
        } else {
            answers.push(containers.find(a));
        }
    }
    answers
}

// ---- set (containers_set.kara) -------------------------------------------

struct SetContainers {
    at: Map[i64, i64],
    holders: Map[i64, SortedSet[i64]],
}

impl SetContainers {
    fn new() -> SetContainers {
        SetContainers { at: Map.new(), holders: Map.new() }
    }

    fn change(mut ref self, index: i64, number: i64) {
        if let Some(old) = self.at.get(index) {
            self.holders[old].remove(index);
        }
        self.at[index] = number;
        if not self.holders.contains_key(number) {
            self.holders[number] = SortedSet.new();
        }
        self.holders[number].insert(index);
    }

    fn find(self, number: i64) -> i64 {
        match self.holders.get(number) {
            Some(set) => set.min().unwrap_or(-1),
            None => -1,
        }
    }
}

fn set_run(calls: Vec[(i64, i64, i64)]) -> Vec[i64] {
    let mut containers = SetContainers.new();
    let mut answers: Vec[i64] = Vec.new();
    for (kind, a, b) in calls.iter() {
        if kind == 0 {
            containers.change(a, b);
        } else {
            answers.push(containers.find(a));
        }
    }
    answers
}

// ---- naive (containers_naive.kara) ---------------------------------------

struct NaiveContainers {
    pairs: Vec[(i64, i64)],
}

impl NaiveContainers {
    fn new() -> NaiveContainers {
        NaiveContainers { pairs: Vec.new() }
    }

    fn change(mut ref self, index: i64, number: i64) {
        for i in 0..self.pairs.len() {
            if self.pairs[i].0 == index {
                self.pairs[i] = (index, number);
                return;
            }
        }
        self.pairs.push((index, number));
    }

    fn find(self, number: i64) -> i64 {
        let mut best = -1;
        for (index, held) in self.pairs.iter() {
            if held == number and (best < 0 or index < best) {
                best = index;
            }
        }
        best
    }
}

fn naive_run(calls: Vec[(i64, i64, i64)]) -> Vec[i64] {
    let mut containers = NaiveContainers.new();
    let mut answers: Vec[i64] = Vec.new();
    for (kind, a, b) in calls.iter() {
        if kind == 0 {
            containers.change(a, b);
        } else {
            answers.push(containers.find(a));
        }
    }
    answers
}

// ---- walk (containers_walk.kara) -----------------------------------------

struct WalkContainers {
    at: SortedMap[i64, i64],
}

impl WalkContainers {
    fn new() -> WalkContainers {
        WalkContainers { at: SortedMap.new() }
    }

    fn change(mut ref self, index: i64, number: i64) {
        self.at[index] = number;
    }

    fn find(self, number: i64) -> i64 {
        for (index, held) in self.at.iter() {
            if held == number {
                return index;
            }
        }
        -1
    }
}

fn walk_run(calls: Vec[(i64, i64, i64)]) -> Vec[i64] {
    let mut containers = WalkContainers.new();
    let mut answers: Vec[i64] = Vec.new();
    for (kind, a, b) in calls.iter() {
        if kind == 0 {
            containers.change(a, b);
        } else {
            answers.push(containers.find(a));
        }
    }
    answers
}

// ---- iter (containers_iter.kara) -----------------------------------------

struct IterContainers {
    at: Map[i64, i64],
}

impl IterContainers {
    fn new() -> IterContainers {
        IterContainers { at: Map.new() }
    }

    fn change(mut ref self, index: i64, number: i64) {
        self.at.insert(index, number);
    }

    fn find(self, number: i64) -> i64 {
        self.at.iter().filter(|(_, held)| held == number).map(|(index, _)| index).min().unwrap_or(-1)
    }
}

fn iter_run(calls: Vec[(i64, i64, i64)]) -> Vec[i64] {
    let mut containers = IterContainers.new();
    let mut answers: Vec[i64] = Vec.new();
    for (kind, a, b) in calls.iter() {
        if kind == 0 {
            containers.change(a, b);
        } else {
            answers.push(containers.find(a));
        }
    }
    answers
}

// ---- solution (containers_solution.kara) ---------------------------------

struct SolutionContainers {
    idx: Map[i32, i32],
    pos: Map[i32, SortedSet[i32]],
}

impl SolutionContainers {
    fn new() -> Self {
        SolutionContainers {
            idx: Map.new(),
            pos: Map.new(),
        }
    }

    fn change(mut ref self, index: i32, number: i32) {
        if let Some(old) = self.idx.get(index).cloned() {
            if let Some(set) = self.pos.get_mut(old) {
                set.remove(index);
            }
        }
        self.idx.insert(index, number);
        self.pos.entry(number).or_insert(SortedSet.new()).insert(index);
    }

    fn find(self, number: i32) -> i32 {
        self.pos
            .get(number)
            .and_then(|s| s.iter().next().cloned())
            .unwrap_or(-1)
    }
}

fn solution_run(calls: Vec[(i64, i64, i64)]) -> Vec[i64] {
    let mut containers = SolutionContainers.new();
    let mut answers: Vec[i64] = Vec.new();
    for (kind, a, b) in calls.iter() {
        if kind == 0 {
            containers.change(a as i32, b as i32);
        } else {
            answers.push(containers.find(a as i32));
        }
    }
    answers
}

// ---- the checks -------------------------------------------------------------

fn answer(arm: i64, calls: Vec[(i64, i64, i64)]) -> Vec[i64] {
    match arm {
        0 => star_run(calls),
        1 => set_run(calls),
        2 => naive_run(calls),
        3 => walk_run(calls),
        4 => iter_run(calls),
        _ => solution_run(calls),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "set", "naive", "walk", "iter", "solution"];
    let mut seed = 2349;
    let mut cases: Vec[Vec[(i64, i64, i64)]] = Vec.new();
    for c in 0..360 {
        let (most, indices, numbers) = if c < 300 {
            (20, 8, 4)
        } else if c < 330 {
            (300, 1000000000, 3)
        } else {
            (300, 3, 2)
        };
        let n = 1 + next_random(mut seed) % most;
        let mut calls: Vec[(i64, i64, i64)] = Vec.new();
        for _ in 0..n {
            if next_random(mut seed) % 5 < 3 {
                let high = next_random(mut seed);
                let index = 1 + (high * 32768 + next_random(mut seed)) % indices;
                calls.push((0, index, 1 + next_random(mut seed) % numbers));
            } else {
                calls.push((1, 1 + next_random(mut seed) % numbers, 0));
            }
        }
        cases.push(calls);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let calls = cases[c].clone();
        let small = c < 300;
        let truth = if small { answers_literally(calls) } else { Vec.new() };
        for a in truth.iter() {
            check = (check * 31 + a + 2) % 1000000007;
        }
        let finds = calls.iter().filter(|(kind, _, _)| kind == 1).count();
        let doubled: Vec[(i64, i64, i64)] = calls.iter().map(|(kind, a, b)| if kind == 0 { (kind, 2 * a, b) } else { (kind, a, b) }).collect();
        let shifted: Vec[(i64, i64, i64)] = calls.iter().map(|(kind, a, b)| if kind == 0 { (kind, a, b + 100) } else { (kind, a + 100, b) }).collect();
        let mut twice: Vec[(i64, i64, i64)] = Vec.new();
        for call in calls.iter() {
            twice.push(call);
            if call.0 == 1 {
                twice.push(call);
            }
        }
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, calls)).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let mut named = value.len() == finds;
            let mut f = 0;
            for e in 0..calls.len() {
                if calls[e].0 == 1 and f < value.len() {
                    let a = value[f];
                    let mut seen = a == -1;
                    for d in 0..e {
                        if calls[d].0 == 0 and calls[d].1 == a {
                            seen = true;
                        }
                    }
                    named = named and seen;
                    f += 1;
                }
            }
            let expect_doubled: Vec[i64] = value.iter().map(|a| if a < 0 { a } else { 2 * a }).collect();
            let mut expect_twice: Vec[i64] = Vec.new();
            for a in value.iter() {
                expect_twice.push(a);
                expect_twice.push(a);
            }
            let verdicts = [
                not small or value == truth,
                named,
                answer(arm, doubled) == expect_doubled,
                answer(arm, shifted) == value,
                answer(arm, twice) == expect_twice,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
