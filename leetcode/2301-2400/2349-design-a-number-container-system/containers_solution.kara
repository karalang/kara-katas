// LeetCode #2349: Design a Number Container System -- LeetCode's Rust
// template as a Rust user fills it in, carried by `karac fix`: a
// `HashMap<i32, i32>` from index to number and a `HashMap<i32,
// BTreeSet<i32>>` from number to indices, the old index removed through
// `if let Some(&old)` and `get_mut`, the new one put in through
// `entry().or_default()`, and find as `and_then` on the set's
// `iter().next().copied()`.

struct NumberContainers {
    idx: Map[i32, i32],
    pos: Map[i32, SortedSet[i32]],
}

impl NumberContainers {
    fn new() -> Self {
        NumberContainers {
            idx: Map.new(),
            pos: Map.new(),
        }
    }

    fn change(mut ref self, index: i32, number: i32) {
        if let Some(old) = self.idx.get(index).cloned() {
            if let Some(set) = self.pos.get_mut(old) {
                set.remove(index);
            }
        }
        self.idx.insert(index, number);
        self.pos.entry(number).or_insert(SortedSet.new()).insert(index);
    }

    fn find(self, number: i32) -> i32 {
        self.pos
            .get(number)
            .and_then(|s| s.iter().next().cloned())
            .unwrap_or(-1)
    }
}

fn run(calls: Vec[(i64, i64, i64)]) -> Vec[i64] {
    let mut containers = NumberContainers.new();
    let mut answers: Vec[i64] = Vec.new();
    for (kind, a, b) in calls.iter() {
        if kind == 0 {
            containers.change(a as i32, b as i32);
        } else {
            answers.push(containers.find(a as i32));
        }
    }
    answers
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn tally(answers: Vec[i64], check: i64) -> i64 {
    let mut check = check;
    for a in answers.iter() {
        check = (check * 31 + a + 2) % 1000000007;
    }
    check
}

fn show(answers: Vec[i64]) -> String {
    let words: Vec[String] = answers.iter().map(|a| f"{a}").collect();
    words.join(" ")
}

fn main() {
    // LeetCode's example; an index changed twice; the largest index and
    // number; then 2 * 10^4 calls over 500 indices and 50 numbers
    println(show(run([(1, 10, 0), (0, 2, 10), (0, 1, 10), (0, 3, 10), (0, 5, 10), (1, 10, 0), (0, 1, 20), (1, 10, 0)].to_vec())));
    println(show(run([(0, 1, 5), (0, 1, 6), (1, 5, 0), (1, 6, 0)].to_vec())));
    println(show(run([(0, 1000000000, 1000000000), (1, 1000000000, 0), (0, 1, 1000000000), (1, 1000000000, 0)].to_vec())));
    let mut calls: Vec[(i64, i64, i64)] = Vec.new();
    for i in 0..20000 {
        if i % 3 == 2 {
            calls.push((1, i % 51 + 1, 0));
        } else {
            calls.push((0, i * 7919 % 500 + 1, i % 50 + 1));
        }
    }
    let answers = run(calls);
    let found = answers.iter().filter(|a| a >= 0).count();
    println(f"2 * 10^4 calls: checksum {tally(answers, 0)}, found {found} of {answers.len()}");
    // 2000 random scripts of 1 to 40 calls over indices 1 to 8 and numbers
    // 1 to 4, three changes to every two finds
    let mut seed = 2349;
    let mut check = 0;
    let mut total = 0;
    let mut missing = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 40;
        let mut calls: Vec[(i64, i64, i64)] = Vec.new();
        for _ in 0..n {
            if next_random(mut seed) % 5 < 3 {
                let index = 1 + next_random(mut seed) % 8;
                calls.push((0, index, 1 + next_random(mut seed) % 4));
            } else {
                calls.push((1, 1 + next_random(mut seed) % 4, 0));
            }
        }
        let answers = run(calls);
        check = tally(answers, check);
        total += answers.iter().sum();
        missing += answers.iter().filter(|a| a < 0).count();
    }
    println(f"2000 scripts: checksum {check}, sum {total}, missing {missing}");
}
