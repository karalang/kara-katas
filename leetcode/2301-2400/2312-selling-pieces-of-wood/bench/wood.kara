// LeetCode #2312: Selling Pieces of Wood -- the bench, the ★ arm in
// Kāra. Bottom up over every size: each piece its own price or the most
// of any one cut across it.

fn selling_wood(m: i64, n: i64, prices: Vec[(i64, i64, i64)]) -> i64 {
    let mut best: Vec[Vec[i64]] = Vec.filled(m + 1, Vec.filled(n + 1, 0));
    for (h, w, price) in prices.iter() {
        best[h][w] = price;
    }
    for h in 1..=m {
        for w in 1..=n {
            for i in 1..h {
                best[h][w] = best[h][w].max(best[i][w] + best[h - i][w]);
            }
            for j in 1..w {
                best[h][w] = best[h][w].max(best[h][j] + best[h][w - j]);
            }
        }
    }
    best[m][n]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10 lists of up to 2000 prices for pieces up to 200 by 200, built
    // once, each shape at most once; then 2 passes, pass `p` adding `p`
    // to every price
    let mut seed = 2312;
    let mut lists: Vec[Vec[(i64, i64, i64)]] = Vec.new();
    for _ in 0..10 {
        let mut used = Vec.filled(200 * 200, false);
        let mut prices: Vec[(i64, i64, i64)] = Vec.new();
        for _ in 0..2000 {
            let h = next_random(mut seed) % 200 + 1;
            let w = next_random(mut seed) % 200 + 1;
            let price = next_random(mut seed) % 1000000 + 1;
            if not used[(h - 1) * 200 + w - 1] {
                used[(h - 1) * 200 + w - 1] = true;
                prices.push((h, w, price));
            }
        }
        lists.push(prices);
    }
    let mut check = 0;
    for p in 0..2 {
        for a in 0..10 {
            let prices: Vec[(i64, i64, i64)] = lists[a].iter().map(|(h, w, price)| (h, w, price + p)).collect();
            check = (check * 31 + selling_wood(200, 200, prices)) % 1000000007;
        }
    }
    println(f"2 passes over 10 lists of 2000 prices on 200 by 200: checksum {check}");
}
