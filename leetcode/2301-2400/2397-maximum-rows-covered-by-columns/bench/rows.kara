// LeetCode #2397: Maximum Rows Covered by Columns -- the bench, the ★
// arm: each row as the mask of its 1s, every mask of numSelect columns
// tried.

fn maximum_rows(matrix: Vec[Vec[i64]], num_select: i64) -> i64 {
    let n = matrix[0].len();
    let masks: Vec[i64] = matrix.iter().map(|row| {
        let mut mask = 0;
        for c in 0..n {
            if row[c] == 1 {
                mask |= 1 << c;
            }
        }
        mask
    }).collect();
    let mut best = 0;
    for chosen in 0..1 << n {
        if chosen.count_ones() != num_select {
            continue;
        }
        let mut covered = 0;
        for mask in masks.iter() {
            if mask & chosen == mask {
                covered += 1;
            }
        }
        best = best.max(covered);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// m rows of n cells, each 1 with chance one in `odds`.
fn grid(seed: mut ref i64, m: i64, n: i64, odds: i64) -> Vec[Vec[i64]] {
    (0..m).map(|_| (0..n).map(|_| if next_random(mut seed) % odds == 0 {
        1
    } else {
        0
    }).collect()).collect()
}

fn main() {
    // 200 grids of 12 by 12, each 1 with chance one in 2 to 5; each pass
    // answers every grid for every choice of 1 to 12 columns
    let mut seed = 2397;
    let grids: Vec[Vec[Vec[i64]]] = (0..200).map(|g| grid(mut seed, 12, 12, 2 + g % 4)).collect();
    let mut check = 0;
    for p in 0..10 {
        for g in grids.iter() {
            for k in 1..13 {
                check = (check * 31 + maximum_rows(g, k) + p) % 1000000007;
            }
        }
    }
    println(f"10 passes over 200 grids of 12 by 12, every choice: checksum {check}");
}
