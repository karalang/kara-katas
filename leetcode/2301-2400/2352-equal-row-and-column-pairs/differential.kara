// LeetCode #2352: Equal Row and Column Pairs -- the differential. The six
// arms, against the statement read literally: for every row and every
// column, the row written out and the column written out as lists, and
// the pair counted when the lists have the same length and the same value
// at every place. 300 random grids of 1 to 6 rows of values from 1 to 1
// up to 1 to 3; then 40 symmetric grids of up to 40 rows of 1 and 2; then
// 20 grids of 50 to 120 rows whose cell (i, j) is (a i j + b) mod m. Every
// case is drawn before any arm answers.
//
// P1  up to 40 rows, the answer is the literal reading's
// P2  from 0 to n^2, and at least n when the grid is symmetric
// P3  the grid transposed: the same answer
// P4  every value x made 3 x + 1: the same answer
// P5  the grid turned half a circle, cell (i, j) taken from
//     (n - 1 - i, n - 1 - j): the same answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn pairs_literally(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut total = 0;
    for r in 0..n {
        for c in 0..n {
            let mut row: Vec[i64] = Vec.new();
            for k in 0..n {
                row.push(grid[r][k]);
            }
            let mut column: Vec[i64] = Vec.new();
            for k in 0..n {
                column.push(grid[k][c]);
            }
            let mut equal = row.len() == column.len();
            for k in 0..row.len() {
                if row[k] != column[k] {
                    equal = false;
                }
            }
            if equal {
                total += 1;
            }
        }
    }
    total
}

// ---- star (pairs.kara) ---------------------------------------------------

fn star_equal_pairs(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut rows: Map[Vec[i64], i64] = Map.new();
    for row in grid.iter() {
        let count = rows.get(row).unwrap_or(0);
        rows.insert(row.clone(), count + 1);
    }
    let mut total = 0;
    for j in 0..n {
        let column: Vec[i64] = (0..n).map(|i| grid[i][j]).collect();
        total += rows.get(column).unwrap_or(0);
    }
    total
}

// ---- naive (pairs_naive.kara) --------------------------------------------

fn naive_equal_pairs(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut total = 0;
    for r in 0..n {
        for c in 0..n {
            let mut k = 0;
            while k < n and grid[r][k] == grid[k][c] {
                k += 1;
            }
            if k == n {
                total += 1;
            }
        }
    }
    total
}

// ---- transpose (pairs_transpose.kara) ------------------------------------

fn transpose_equal_pairs(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut flipped: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(n, 0));
    for i in 0..n {
        for j in 0..n {
            flipped[j][i] = grid[i][j];
        }
    }
    let mut total = 0;
    for row in grid.iter() {
        for column in flipped.iter() {
            if row == column {
                total += 1;
            }
        }
    }
    total
}

// ---- sorted (pairs_sorted.kara) ------------------------------------------

fn sorted_equal_pairs(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut rows = grid.clone();
    rows.sort();
    let mut columns: Vec[Vec[i64]] = (0..n).map(|j| (0..n).map(|i| grid[i][j]).collect()).collect();
    columns.sort();
    let mut total = 0;
    let mut r = 0;
    let mut c = 0;
    while r < n and c < n {
        if rows[r] < columns[c] {
            r += 1;
        } else if columns[c] < rows[r] {
            c += 1;
        } else {
            let mut r_end = r;
            while r_end < n and rows[r_end] == rows[r] {
                r_end += 1;
            }
            let mut c_end = c;
            while c_end < n and columns[c_end] == columns[c] {
                c_end += 1;
            }
            total += (r_end - r) * (c_end - c);
            r = r_end;
            c = c_end;
        }
    }
    total
}

// ---- iter (pairs_iter.kara) ----------------------------------------------

fn iter_equal_pairs(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    (0..n)
        .map(|j| {
            let column: Vec[i64] = grid.iter().map(|row| row[j]).collect();
            grid.iter().filter(|row| row == column).count()
        })
        .sum()
}

// ---- solution (pairs_solution.kara) --------------------------------------

struct Solution {}

impl Solution {
    pub fn equal_pairs(grid: Vec[Vec[i32]]) -> i32 {
        let n = grid.len();
        let mut rows: Map[Vec[i32], i32] = Map.new();
        for row in ref grid {
            *rows.entry(row.clone()).or_insert(0) += 1;
        }
        let mut total: i32 = 0;
        for j in 0..n {
            let column: Vec[i32] = (0..n).map(|i| grid[i][j]).collect();
            if let Some(count) = rows.get(column).cloned() {
                total += count;
            }
        }
        total
    }
}

fn solution_equal_pairs(grid: Vec[Vec[i64]]) -> i64 {
    let grid: Vec[Vec[i32]] = grid.iter().map(|row| row.iter().map(|x| x as i32).collect()).collect();
    Solution.equal_pairs(grid)
}

// ---- the checks -------------------------------------------------------------

fn answer(arm: i64, grid: Vec[Vec[i64]]) -> i64 {
    match arm {
        0 => star_equal_pairs(grid),
        1 => naive_equal_pairs(grid),
        2 => transpose_equal_pairs(grid),
        3 => sorted_equal_pairs(grid),
        4 => iter_equal_pairs(grid),
        _ => solution_equal_pairs(grid),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "naive", "transpose", "sorted", "iter", "solution"];
    let mut seed = 2352;
    let mut cases: Vec[Vec[Vec[i64]]] = Vec.new();
    for c in 0..360 {
        let mut grid: Vec[Vec[i64]] = Vec.new();
        if c < 300 {
            let n = 1 + next_random(mut seed) % 6;
            let top = 1 + next_random(mut seed) % 3;
            for _ in 0..n {
                grid.push((0..n).map(|_| 1 + next_random(mut seed) % top).collect());
            }
        } else if c < 340 {
            let n = 1 + next_random(mut seed) % 40;
            grid = Vec.filled(n, Vec.filled(n, 0));
            for i in 0..n {
                for j in i..n {
                    let v = 1 + next_random(mut seed) % 2;
                    grid[i][j] = v;
                    grid[j][i] = v;
                }
            }
        } else {
            let n = 50 + next_random(mut seed) % 71;
            let a = 1 + next_random(mut seed) % 5;
            let b = next_random(mut seed) % 10;
            let m = 2 + next_random(mut seed) % 9;
            for i in 0..n {
                grid.push((0..n).map(|j| (a * i * j + b) % m).collect());
            }
        }
        cases.push(grid);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let grid = cases[c].clone();
        let n = grid.len();
        let small = n <= 40;
        let truth = if small { pairs_literally(grid) } else { -1 };
        if small {
            check = (check * 31 + truth + 1) % 1000000007;
        }
        let mut symmetric = true;
        for i in 0..n {
            for j in 0..n {
                if grid[i][j] != grid[j][i] {
                    symmetric = false;
                }
            }
        }
        let transposed: Vec[Vec[i64]] = (0..n).map(|i| (0..n).map(|j| grid[j][i]).collect()).collect();
        let relabelled: Vec[Vec[i64]] = grid.iter().map(|row| row.iter().map(|x| 3 * x + 1).collect()).collect();
        let turned: Vec[Vec[i64]] = (0..n).map(|i| (0..n).map(|j| grid[n - 1 - i][n - 1 - j]).collect()).collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, grid)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == truth,
                value >= 0 and value <= n * n and (not symmetric or value >= n),
                answer(arm, transposed) == value,
                answer(arm, relabelled) == value,
                answer(arm, turned) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
