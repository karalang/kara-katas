// LeetCode #2384: Largest Palindromic Number -- the bench, the ★ arm: the
// digits counted, the left half from 9 down with no 0 leading, the
// largest digit left over in the middle, the half reversed after it.

fn largest_palindromic(num: String) -> String {
    let mut count: Vec[i64] = Vec.filled(10, 0);
    for c in num.bytes().iter() {
        count[c - b'0'] += 1;
    }
    let mut half: Vec[u8] = Vec.new();
    for d in (0..10).rev() {
        if d == 0 and half.is_empty() {
            break;
        }
        for _ in 0..count[d] / 2 {
            half.push(b'0' + d as u8);
        }
    }
    let mut out = half.clone();
    for d in (0..10).rev() {
        if count[d] % 2 == 1 {
            out.push(b'0' + d as u8);
            break;
        }
    }
    if out.is_empty() {
        return "0".to_string();
    }
    for i in (0..half.len()).rev() {
        out.push(half[i]);
    }
    String.from_utf8(out).unwrap()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 100 strings of 10^4 digits, string s's below 1 + s % 10, each a 0
    // with a chance of s % 7 in 10; each pass folds every answer's length
    // and middle digit
    let mut seed = 2384;
    let mut strings: Vec[String] = Vec.new();
    for s in 0..100 {
        let b: Vec[u8] = (0..10000).map(|_| if next_random(mut seed) % 10 < s % 7 {
            b'0'
        } else {
            b'0' + (next_random(mut seed) % (1 + s % 10)) as u8
        }).collect();
        strings.push(String.from_utf8(b).unwrap());
    }
    let mut check = 0;
    for p in 0..200 {
        for s in 0..100 {
            let answer = largest_palindromic(strings[s]);
            let b = answer.bytes();
            check = (check * 31 + b.len() + b[b.len() / 2] + p) % 1000000007;
        }
    }
    println(f"200 passes over 100 strings of 10^4 digits: checksum {check}");
}
