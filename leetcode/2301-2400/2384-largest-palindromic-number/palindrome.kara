// LeetCode #2384: Largest Palindromic Number -- the ★ arm. The digits
// counted; the left half takes each digit's pairs from 9 down, but no
// 0s while it is still empty, as they would lead; the middle is the
// largest digit left over; the right half is the left reversed. O(n).

fn largest_palindromic(num: String) -> String {
    let mut count: Vec[i64] = Vec.filled(10, 0);
    for c in num.bytes().iter() {
        count[c - b'0'] += 1;
    }
    let mut half: Vec[u8] = Vec.new();
    for d in (0..10).rev() {
        if d == 0 and half.is_empty() {
            break;
        }
        for _ in 0..count[d] / 2 {
            half.push(b'0' + d as u8);
        }
    }
    let mut out = half.clone();
    for d in (0..10).rev() {
        if count[d] % 2 == 1 {
            out.push(b'0' + d as u8);
            break;
        }
    }
    if out.is_empty() {
        return "0".to_string();
    }
    for i in (0..half.len()).rev() {
        out.push(half[i]);
    }
    String.from_utf8(out).unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn fold(check: i64, s: String) -> i64 {
    let mut c = check;
    for b in s.bytes().iter() {
        c = (c * 31 + b as i64) % 1000000007;
    }
    c
}

fn digits(n: i64, zeros: i64, top: i64, seed: mut ref i64) -> String {
    let b: Vec[u8] = (0..n).map(|_| if next_random(mut seed) % 10 < zeros {
        b'0'
    } else {
        b'0' + (next_random(mut seed) % top) as u8
    }).collect();
    String.from_utf8(b).unwrap()
}

fn main() {
    // LeetCode's two examples; one 0, two 0s, three 0s; ten different
    // digits; 0s around a pair of 1s; then 10^5 random digits and 10^5
    // 0s with one 5, by length and checksum; then 3000 random strings of
    // 1 to 30 digits below 1 to 10, with a chance of 0 to 9 in 10 of a 0,
    // with a checksum and the total length
    println(largest_palindromic("444947137"));
    println(largest_palindromic("00009"));
    println(f"{largest_palindromic("0")} {largest_palindromic("00")} {largest_palindromic("000")}");
    println(f"{largest_palindromic("1234567890")} {largest_palindromic("010010")}");
    let mut seed = 2384;
    let big = largest_palindromic(digits(100000, 0, 10, mut seed));
    let mut zeros: Vec[u8] = Vec.filled(100000, b'0');
    zeros[50000] = b'5';
    let lone = largest_palindromic(String.from_utf8(zeros).unwrap());
    println(f"{big.len()} digits, checksum {fold(0, big)}; {lone}");
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 30;
        let top = 1 + next_random(mut seed) % 10;
        let zeros = next_random(mut seed) % 10;
        let answer = largest_palindromic(digits(n, zeros, top, mut seed));
        check = fold(check, answer);
        total += answer.len();
    }
    println(f"3000 strings: checksum {check}, {total} digits in all");
}
