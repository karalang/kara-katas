// LeetCode #2354: Number of Excellent Pairs -- every pair: the distinct
// values, and for each ordered pair of them the bits of a OR b and of
// a AND b counted as the statement says. O(d^2) for d distinct values.

fn count_excellent_pairs(nums: Vec[i64], k: i64) -> i64 {
    let distinct: SortedSet[i64] = nums.iter().collect();
    let values: Vec[i64] = distinct.iter().collect();
    let mut total = 0;
    for a in values.iter() {
        for b in values.iter() {
            if (a | b).count_ones() + (a & b).count_ones() >= k {
                total += 1;
            }
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one value with k at its bits doubled and one
    // past; 10^5 values that are all 2^30 - 1; 10^5 values over 2000
    // distinct with k from 1 to 60
    println(f"{count_excellent_pairs([1, 2, 3, 1], 3)}");
    println(f"{count_excellent_pairs([5, 1, 1], 10)}");
    println(f"{count_excellent_pairs([7], 6)}");
    println(f"{count_excellent_pairs([7], 7)}");
    println(f"{count_excellent_pairs(Vec.filled(100000, 1073741823), 60)}");
    let many: Vec[i64] = (0..100000).map(|i| i * 7919 % 2000 * 524309 % 1000000000 + 1).collect();
    let answers: Vec[String] = (0..9).map(|j| f"{count_excellent_pairs(many, 1 + 7 * j)}").collect();
    println(answers.join(" "));
    // 2000 random arrays of 1 to 30 values from 1 to 2^b, b from 1 to 30,
    // and k from 1 to 2 b + 1
    let mut seed = 2354;
    let mut check = 0;
    let mut total = 0;
    let mut none = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 30;
        let b = 1 + next_random(mut seed) % 30;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            let high = next_random(mut seed);
            nums.push(1 + (high * 32768 + next_random(mut seed)) % (1 << b));
        }
        let k = 1 + next_random(mut seed) % (2 * b + 1);
        let p = count_excellent_pairs(nums, k);
        check = (check * 31 + p) % 1000000007;
        total += p;
        if p == 0 {
            none += 1;
        }
    }
    println(f"2000 arrays: checksum {check}, pairs {total}, {none} with none");
}
