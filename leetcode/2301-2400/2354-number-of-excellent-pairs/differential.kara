// LeetCode #2354: Number of Excellent Pairs -- the differential. The six
// arms, against the statement read literally: every ordered pair of
// distinct values, the bits of a OR b and of a AND b counted one place at
// a time, and the pair counted when the two counts reach k. No bit counts
// added. 300 random arrays of 1 to 30 values from 1 to 2^b, b from 1 to
// 30, with k from 1 to 2 b + 1; then 30 of up to 300 values from 1 to 64;
// then 30 of up to 300 values of 25 to 30 bits set, with k from 40 to 60.
// Every case is drawn before any arm answers.
//
// P1  up to 60 values, the answer is the literal reading's
// P2  from 0 to d^2 for d distinct values, and the answer less the values
//     whose bits doubled reach k is even, since a pair of two values
//     counts both ways
// P3  k lowered by one: no fewer pairs
// P4  the values given twice over: the same answer
// P5  the low 30 bits of every value reversed: the same answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn bits_literally(x: i64) -> i64 {
    let mut count = 0;
    for place in 0..31 {
        if x / (1 << place) % 2 == 1 {
            count += 1;
        }
    }
    count
}

fn pairs_literally(nums: Vec[i64], k: i64) -> i64 {
    let mut values: Vec[i64] = Vec.new();
    for x in nums.iter() {
        if not values.contains(x) {
            values.push(x);
        }
    }
    let mut total = 0;
    for a in values.iter() {
        for b in values.iter() {
            if bits_literally(a | b) + bits_literally(a & b) >= k {
                total += 1;
            }
        }
    }
    total
}

// ---- star (excellent.kara) -----------------------------------------------

fn star_count_excellent_pairs(nums: Vec[i64], k: i64) -> i64 {
    let distinct: Set[i64] = nums.iter().collect();
    let mut by_bits = [0; 31];
    for x in distinct.iter() {
        by_bits[x.count_ones()] += 1;
    }
    let mut total = 0;
    for a in 0..31 {
        for b in 0..31 {
            if a + b >= k {
                total += by_bits[a] * by_bits[b];
            }
        }
    }
    total
}

// ---- pointers (excellent_pointers.kara) ----------------------------------

fn pointers_count_excellent_pairs(nums: Vec[i64], k: i64) -> i64 {
    let mut values = nums.clone();
    values.sort();
    values.dedup();
    let mut bits: Vec[i64] = values.iter().map(|x| x.count_ones()).collect();
    bits.sort();
    let d = bits.len();
    let mut total = 0;
    let mut high = d;
    for low in 0..d {
        while high > 0 and bits[low] + bits[high - 1] >= k {
            high -= 1;
        }
        total += d - high;
    }
    total
}

// ---- search (excellent_search.kara) --------------------------------------

fn search_count_excellent_pairs(nums: Vec[i64], k: i64) -> i64 {
    let distinct: Set[i64] = nums.iter().collect();
    let mut bits: Vec[i64] = distinct.iter().map(|x| x.count_ones()).collect();
    bits.sort();
    let d = bits.len();
    let mut total = 0;
    for a in bits.iter() {
        let mut lo = 0;
        let mut hi = d;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if a + bits[mid] >= k {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        total += d - lo;
    }
    total
}

// ---- naive (excellent_naive.kara) ----------------------------------------

fn naive_count_excellent_pairs(nums: Vec[i64], k: i64) -> i64 {
    let distinct: SortedSet[i64] = nums.iter().collect();
    let values: Vec[i64] = distinct.iter().collect();
    let mut total = 0;
    for a in values.iter() {
        for b in values.iter() {
            if (a | b).count_ones() + (a & b).count_ones() >= k {
                total += 1;
            }
        }
    }
    total
}

// ---- iter (excellent_iter.kara) ------------------------------------------

fn iter_count_excellent_pairs(nums: Vec[i64], k: i64) -> i64 {
    let distinct: Set[i64] = nums.iter().collect();
    let by_bits = distinct.iter().fold([0; 31], |tally, x| {
        let mut tally = tally;
        tally[x.count_ones()] += 1;
        tally
    });
    (0..31)
        .flat_map(|a| (0..31).filter(|b| a + b >= k).map(|b| by_bits[a] * by_bits[b]))
        .sum()
}

// ---- solution (excellent_solution.kara) ----------------------------------

struct Solution {}

impl Solution {
    pub fn count_excellent_pairs(nums: own Vec[i32], k: i32) -> i64 {
        let distinct: Set[i32] = nums.into_iter().collect();
        let mut by_bits = [0; 32];
        for x in distinct {
            by_bits[x.count_ones() as usize] += 1;
        }
        let mut total = 0;
        for a in 0..32 {
            for b in 0..32 {
                if (a + b) as i32 >= k {
                    total += by_bits[a] * by_bits[b];
                }
            }
        }
        total
    }
}

fn solution_count_excellent_pairs(nums: Vec[i64], k: i64) -> i64 {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.count_excellent_pairs(nums, k as i32)
}

// ---- the checks -------------------------------------------------------------

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_count_excellent_pairs(nums, k),
        1 => pointers_count_excellent_pairs(nums, k),
        2 => search_count_excellent_pairs(nums, k),
        3 => naive_count_excellent_pairs(nums, k),
        4 => iter_count_excellent_pairs(nums, k),
        _ => solution_count_excellent_pairs(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn reversed_bits(x: i64) -> i64 {
    let mut out = 0;
    for place in 0..30 {
        if x >> place & 1 == 1 {
            out |= 1 << (29 - place);
        }
    }
    out
}

fn main() {
    let names = ["star", "pointers", "search", "naive", "iter", "solution"];
    let mut seed = 2354;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for c in 0..360 {
        let mut nums: Vec[i64] = Vec.new();
        let mut k = 0;
        if c < 300 {
            let n = 1 + next_random(mut seed) % 30;
            let b = 1 + next_random(mut seed) % 30;
            for _ in 0..n {
                let high = next_random(mut seed);
                nums.push(1 + (high * 32768 + next_random(mut seed)) % (1 << b));
            }
            k = 1 + next_random(mut seed) % (2 * b + 1);
        } else if c < 330 {
            let n = 1 + next_random(mut seed) % 300;
            for _ in 0..n {
                nums.push(1 + next_random(mut seed) % 64);
            }
            k = 1 + next_random(mut seed) % 14;
        } else {
            let n = 1 + next_random(mut seed) % 300;
            for _ in 0..n {
                let mut x = (1 << 30) - 1;
                let clear = next_random(mut seed) % 6;
                for _ in 0..clear {
                    x &= ~(1 << (next_random(mut seed) % 30));
                }
                nums.push(x);
            }
            k = 40 + next_random(mut seed) % 21;
        }
        cases.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (nums, k) = cases[c].clone();
        let small = nums.len() <= 60;
        let truth = if small { pairs_literally(nums, k) } else { -1 };
        if small {
            check = (check * 31 + truth + 1) % 1000000007;
        }
        let distinct: SortedSet[i64] = nums.iter().collect();
        let d = distinct.len();
        let alone = distinct.iter().filter(|x| 2 * bits_literally(x) >= k).count();
        let mut twice = nums.clone();
        twice.extend(nums.iter());
        let reversed: Vec[i64] = nums.iter().map(|x| reversed_bits(x)).collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == truth,
                value >= 0 and value <= d * d and (value - alone) % 2 == 0,
                k == 1 or answer(arm, nums, k - 1) >= value,
                answer(arm, twice, k) == value,
                answer(arm, reversed, k) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
