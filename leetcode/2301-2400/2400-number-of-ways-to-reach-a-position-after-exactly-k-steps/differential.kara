// LeetCode #2400: Number of Ways to Reach a Position After Exactly k
// Steps -- the differential. The six arms against the statement read
// literally: every one of the 2^k ways to choose left or right at each
// step walked out, and those that end at endPos counted. 360 cases: a
// third with k up to 12, which the literal reading answers; a third with
// k from 13 to 120 and an end it can reach; and a third with k from 13 to
// 120 and an end drawn up to 3 past what it can reach, of either parity.
// Every case is drawn before any arm answers.
//
// P1  k up to 12: the answer is the literal reading's
// P2  start and end swapped: the same answer
// P3  start and end both moved 7 along: the same answer
// P4  k from 2: the ways through the last step's two neighbours of the
//     end, with k - 1 steps, sum to the answer
// P5  k up to 40: the answers over every end from start - k to start + k
//     sum to 2^k
// P6  each arm agrees with at least three of the other five

const MOD: i64 = 1000000007;

// ---- the statement read literally ------------------------------------------

fn ways_literally(start_pos: i64, end_pos: i64, k: i64) -> i64 {
    let mut count = 0;
    for choice in 0..1 << k {
        let mut at = start_pos;
        for step in 0..k {
            if choice >> step & 1 == 1 {
                at += 1;
            } else {
                at -= 1;
            }
        }
        if at == end_pos {
            count += 1;
        }
    }
    count % MOD
}

// ---- star (ways.kara) ----------------------------------------------------

fn star_power(base: i64, exponent: i64) -> i64 {
    let mut result = 1;
    let mut b = base % MOD;
    let mut e = exponent;
    while e > 0 {
        if e % 2 == 1 {
            result = result * b % MOD;
        }
        b = b * b % MOD;
        e /= 2;
    }
    result
}

fn star_number_of_ways(start_pos: i64, end_pos: i64, k: i64) -> i64 {
    let d = (end_pos - start_pos).abs();
    if d > k or (k - d) % 2 == 1 {
        return 0;
    }
    let toward = (k + d) / 2;
    let mut factorial: Vec[i64] = Vec.filled(k + 1, 1);
    for i in 1..k + 1 {
        factorial[i] = factorial[i - 1] * i % MOD;
    }
    factorial[k] * star_power(factorial[toward], MOD - 2) % MOD * star_power(factorial[k - toward], MOD - 2) % MOD
}

// ---- dp (ways_dp.kara) ---------------------------------------------------

fn dp_number_of_ways(start_pos: i64, end_pos: i64, k: i64) -> i64 {
    let offset = end_pos - start_pos;
    if offset.abs() > k {
        return 0;
    }
    let width = 2 * k + 1;
    let mut row: Vec[i64] = Vec.filled(width, 0);
    row[k] = 1;
    for _ in 0..k {
        let mut next: Vec[i64] = Vec.filled(width, 0);
        for i in 0..width {
            if row[i] == 0 {
                continue;
            }
            if i > 0 {
                next[i - 1] = (next[i - 1] + row[i]) % MOD;
            }
            if i + 1 < width {
                next[i + 1] = (next[i + 1] + row[i]) % MOD;
            }
        }
        row = next;
    }
    row[k + offset]
}

// ---- pascal (ways_pascal.kara) -------------------------------------------

fn pascal_binomial(n: i64, r: i64) -> i64 {
    let mut row: Vec[i64] = [1];
    for i in 1..n + 1 {
        let mut next: Vec[i64] = Vec.filled(i + 1, 1);
        for j in 1..i {
            next[j] = (row[j - 1] + row[j]) % MOD;
        }
        row = next;
    }
    row[r]
}

fn pascal_number_of_ways(start_pos: i64, end_pos: i64, k: i64) -> i64 {
    let d = (end_pos - start_pos).abs();
    if d > k or (k - d) % 2 != 0 {
        return 0;
    }
    pascal_binomial(k, (k + d) / 2)
}

// ---- memo (ways_memo.kara) -----------------------------------------------

fn memo_ways(gap: i64, left: i64, memo: mut ref Vec[Vec[i64]]) -> i64 {
    let gap = gap.abs();
    if gap > left {
        return 0;
    }
    if left == 0 {
        return 1;
    }
    if memo[gap][left] >= 0 {
        return memo[gap][left];
    }
    let total = (memo_ways(gap - 1, left - 1, mut memo) + memo_ways(gap + 1, left - 1, mut memo)) % MOD;
    memo[gap][left] = total;
    total
}

fn memo_number_of_ways(start_pos: i64, end_pos: i64, k: i64) -> i64 {
    let mut memo: Vec[Vec[i64]] = (0..k + 2).map(|_| Vec.filled(k + 1, -1)).collect();
    memo_ways(end_pos - start_pos, k, mut memo)
}

// ---- iter (ways_iter.kara) -----------------------------------------------

fn iter_number_of_ways(start_pos: i64, end_pos: i64, k: i64) -> i64 {
    let offset = end_pos - start_pos;
    if offset.abs() > k {
        return 0;
    }
    let width = 2 * k + 1;
    let first: Vec[i64] = (0..width).map(|i| if i == k {
        1
    } else {
        0
    }).collect();
    let last = (0..k).fold(first, |row, _| {
        (0..width).map(|i| {
            let below = if i > 0 {
                row[i - 1]
            } else {
                0
            };
            let above = if i + 1 < width {
                row[i + 1]
            } else {
                0
            };
            (below + above) % MOD
        }).collect()
    });
    last[k + offset]
}

// ---- solution (ways_solution.kara) ---------------------------------------

struct Solution {}

impl Solution {
    pub fn number_of_ways(start_pos: i32, end_pos: i32, k: i32) -> i32 {
        const MOD: i64 = 1000000007;
        let d = (end_pos - start_pos).abs() as i64;
        let k = k as i64;
        if d > k or (k - d) % 2 == 1 {
            return 0;
        }
        let mut dp = Vec.filled(k + 1, Vec.filled(k + 1, 0));
        for i in 0..=k {
            dp[i][0] = 1;
            for j in 1..=i {
                dp[i][j] = (dp[i - 1][j - 1] + dp[i - 1][j]) % MOD;
            }
        }
        dp[k][(k + d) / 2] as i32
    }
}

fn solution_number_of_ways(start_pos: i64, end_pos: i64, k: i64) -> i64 {
    Solution.number_of_ways(start_pos as i32, end_pos as i32, k as i32)
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, start_pos: i64, end_pos: i64, k: i64) -> i64 {
    match arm {
        0 => star_number_of_ways(start_pos, end_pos, k),
        1 => dp_number_of_ways(start_pos, end_pos, k),
        2 => pascal_number_of_ways(start_pos, end_pos, k),
        3 => memo_number_of_ways(start_pos, end_pos, k),
        4 => iter_number_of_ways(start_pos, end_pos, k),
        _ => solution_number_of_ways(start_pos, end_pos, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "dp", "pascal", "memo", "iter", "solution"];
    let mut seed = 2400;
    let mut cases: Vec[(i64, i64, i64)] = Vec.new();
    for t in 0..360 {
        let k = if t % 3 == 0 {
            1 + next_random(mut seed) % 12
        } else {
            13 + next_random(mut seed) % 108
        };
        let start = 1 + next_random(mut seed) % 1000;
        let mut end = start - k + 2 * (next_random(mut seed) % (k + 1));
        if t % 3 == 0 {
            end = start + next_random(mut seed) % (2 * k + 1) - k;
        } else if t % 3 == 2 {
            end = start + next_random(mut seed) % (2 * k + 7) - k - 3;
        }
        cases.push((start, end.max(1).min(1000), k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (s, e, k) = cases[c];
        let truth = if k <= 12 {
            ways_literally(s, e, k)
        } else {
            -1
        };
        if truth >= 0 {
            check = (check * 31 + truth) % MOD;
        }
        let shift = if s.max(e) + 7 <= 1000 {
            7
        } else {
            -7
        };
        let mut all_ways = 1;
        for _ in 0..k {
            all_ways = all_ways * 2 % MOD;
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, s, e, k)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let mut every_end = 0;
            if k <= 40 {
                for end in s - k..s + k + 1 {
                    every_end = (every_end + answer(arm, s, end, k)) % MOD;
                }
            }
            let verdicts = [truth < 0 or value == truth, answer(arm, e, s, k) == value, answer(arm, s + shift, e + shift, k) == value, k < 2 or (answer(arm, s, e - 1, k - 1) + answer(arm, s, e + 1, k - 1)) % MOD == value, k > 40 or every_end == all_ways, same >= 3];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
