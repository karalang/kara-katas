// LeetCode #2400: Number of Ways to Reach a Position After Exactly k
// Steps -- the bench, the ★ arm: C(k, (k + d) / 2) from factorials modulo
// 10^9 + 7 and Fermat's inverse.

const MOD: i64 = 1000000007;

fn power(base: i64, exponent: i64) -> i64 {
    let mut result = 1;
    let mut b = base % MOD;
    let mut e = exponent;
    while e > 0 {
        if e % 2 == 1 {
            result = result * b % MOD;
        }
        b = b * b % MOD;
        e /= 2;
    }
    result
}

fn number_of_ways(start_pos: i64, end_pos: i64, k: i64) -> i64 {
    let d = (end_pos - start_pos).abs();
    if d > k or (k - d) % 2 == 1 {
        return 0;
    }
    let toward = (k + d) / 2;
    let mut factorial: Vec[i64] = Vec.filled(k + 1, 1);
    for i in 1..k + 1 {
        factorial[i] = factorial[i - 1] * i % MOD;
    }
    factorial[k] * power(factorial[toward], MOD - 2) % MOD * power(factorial[k - toward], MOD - 2) % MOD
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 300000 queries of k up to 1000, each end drawn within k of its start
    // at k's parity and kept to 1 to 1000; every answer folded
    let mut seed = 2400;
    let mut check = 0;
    let mut zeros = 0;
    for _ in 0..300000 {
        let k = 1 + next_random(mut seed) % 1000;
        let start = 1 + next_random(mut seed) % 1000;
        let end = (start - k + 2 * (next_random(mut seed) % (k + 1))).max(1).min(1000);
        let w = number_of_ways(start, end, k);
        if w == 0 {
            zeros += 1;
        }
        check = (check * 31 + w) % MOD;
    }
    println(f"300000 queries of k up to 1000: checksum {check}, {zeros} zeros");
}
