// LeetCode #2309: Greatest English Letter in Upper and Lower Case -- two
// tables of 26 flags, one for each case, filled by `match`ing each
// letter on its range, then read from `Z` down. O(n).

fn greatest_letter(s: String) -> String {
    let mut lower = [false; 26];
    let mut upper = [false; 26];
    for c in s.chars() {
        match c {
            'a'..='z' => lower[(c as i64) - ('a' as i64)] = true,
            'A'..='Z' => upper[(c as i64) - ('A' as i64)] = true,
            _ => {}
        }
    }
    let mut i = 25;
    while i >= 0 {
        if lower[i] and upper[i] {
            return (('A' as i64 + i) as u8 as char).to_string();
        }
        i -= 1;
    }
    String.new()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; then one letter in both cases, `Z` and
    // `z` far apart, `a` and `A` alone, and every letter in one case
    for s in ["lEeTcOdE", "arRAzFif", "AbCdEfGhIjK", "qQ", "zabcdefghijklmnopqrstuvwxyZ", "Aa", "ABCDEFGHIJKLMNOPQRSTUVWXYZ"] {
        let letter = greatest_letter(s.to_string());
        println(f"\"{s}\": \"{letter}\"");
    }
    // 2000 random strings of 1 to 60 letters, each from a random handful
    // of the 52, so that a pair turns up about half the time
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".chars().collect();
    let mut seed = 2309;
    let mut check = 0;
    let mut found = 0;
    for _ in 0..2000 {
        let pool = next_random(mut seed) % 24 + 1;
        let mut from: Vec[char] = Vec.new();
        for _ in 0..pool {
            from.push(letters[next_random(mut seed) % 52]);
        }
        let mut s = String.new();
        for _ in 0..next_random(mut seed) % 60 + 1 {
            s.push(from[next_random(mut seed) % pool]);
        }
        let letter = greatest_letter(s);
        let code = if letter.len() == 0 { 0 } else { letter.bytes()[0] as i64 };
        check = (check * 31 + code) % 1000000007;
        if code > 0 {
            found += 1;
        }
    }
    println(f"2000 strings: checksum {check}, {found} with a letter in both cases");
}
