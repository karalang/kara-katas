// LeetCode #2304: Minimum Path Cost in a Grid -- the bench, the ★ arm.
// Row by row, each column of the next row takes the least over the row
// before of the cost so far plus the move, plus its own value.

fn min_path_cost(grid: Vec[Vec[i64]], move_cost: Vec[Vec[i64]]) -> i64 {
    let n = grid[0].len();
    let mut best = grid[0].clone();
    for r in 1..grid.len() {
        let mut next = Vec.filled(n, i64.MAX);
        for j in 0..n {
            for k in 0..n {
                next[j] = next[j].min(best[k] + move_cost[grid[r - 1][k]][j]);
            }
            next[j] += grid[r][j];
        }
        best = next;
    }
    best.iter().min().unwrap()
}

// ---- bench harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 grids of 50 by 50, the numbers 0 to 2499 shuffled, and 20 tables
    // of move costs from 1 to 100, built once; then 40 passes, grid `a`
    // in pass `p` priced by table (a + p) % 20
    let mut seed = 2304;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    let mut tables: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..20 {
        let mut values: Vec[i64] = (0..2500).collect();
        for i in (1..2500).rev() {
            let j = next_random(mut seed) % (i + 1);
            values.swap(i, j);
        }
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for r in 0..50 {
            grid.push(values[r * 50..(r + 1) * 50].to_vec());
        }
        grids.push(grid);
        let mut table: Vec[Vec[i64]] = Vec.new();
        for _ in 0..2500 {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..50 {
                row.push(next_random(mut seed) % 100 + 1);
            }
            table.push(row);
        }
        tables.push(table);
    }
    let mut check = 0;
    for p in 0..40 {
        for a in 0..20 {
            check = (check * 31 + min_path_cost(grids[a], tables[(a + p) % 20])) % 1000000007;
        }
    }
    println(f"40 passes over 20 grids of 50 by 50: checksum {check}");
}
