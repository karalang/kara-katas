// LeetCode #2305: Fair Distribution of Cookies -- over subsets of the
// bags: `sum[mask]` the cookies in the bags of `mask`, and `dp[mask]`
// the least unfairness giving the bags of `mask` to the children so far.
// Each new child takes some subset `sub` of `mask`, every one walked
// with `sub = (sub - 1) & mask`, and the rest go to the children before.
// O(k 3^n).

fn distribute_cookies(cookies: Vec[i64], k: i64) -> i64 {
    let n = cookies.len();
    let full = (1 << n) - 1;
    let mut sum = Vec.filled(full + 1, 0);
    for mask in 1..=full {
        let low = mask & (0 - mask);
        let mut i = 0;
        while (1 << i) != low {
            i += 1;
        }
        sum[mask] = sum[mask ^ low] + cookies[i];
    }
    let mut dp = sum.clone();
    for _ in 1..k {
        let mut next = dp.clone();
        for mask in 1..=full {
            let mut sub = mask;
            while sub > 0 {
                next[mask] = next[mask].min(sum[sub].max(dp[mask ^ sub]));
                sub = (sub - 1) & mask;
            }
        }
        dp = next;
    }
    dp[full]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then a child for every bag, two children
    // and eight equal bags of 10^5, and three children and bags that
    // split evenly only one way
    println(distribute_cookies([8, 15, 10, 20, 8].to_vec(), 2));
    println(distribute_cookies([6, 1, 3, 2, 2, 4, 1, 2].to_vec(), 3));
    println(distribute_cookies([5, 9, 1, 7].to_vec(), 4));
    println(distribute_cookies([100000, 100000, 100000, 100000, 100000, 100000, 100000, 100000].to_vec(), 2));
    println(distribute_cookies([9, 7, 5, 4, 3, 2, 1, 1].to_vec(), 3));
    // 500 random cases of 2 to 6 bags of 1 to 10^5 cookies, and 2 to as
    // many children as bags
    let mut seed = 2305;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..500 {
        let n = next_random(mut seed) % 5 + 2;
        let k = next_random(mut seed) % (n - 1) + 2;
        let mut cookies: Vec[i64] = Vec.new();
        for _ in 0..n {
            cookies.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1);
        }
        let unfairness = distribute_cookies(cookies, k);
        check = (check * 31 + unfairness) % 1000000007;
        total += unfairness;
    }
    println(f"500 cases: checksum {check}, {total} in all");
}
