// LeetCode #2337: Move Pieces to Obtain a String -- the differential. The
// six arms, against the statement read literally: every string the
// start can become, found by trying each allowed move, an `L` one place
// left into a blank or an `R` one place right into one, from every
// string found, until no new one appears; the answer is whether the
// target is among them. No matching of pieces. 300 random cases of 1 to
// 8 places, the target half the time the start moved 0 to 20 times by
// allowed moves; then 30 of up to 40 places, three in four blank; then
// 30 of up to 2000 places, the target the start moved up to 100000
// times. Every case is drawn before any arm answers.
//
// P1  up to 8 places, the answer is the literal reading's
// P2  the start to itself: true; and true only for the same pieces in
//     the same order
// P3  both strings reversed with `L` and `R` swapped: the same answer
// P4  where true, the target moved on by allowed moves: still true
// P5  true both ways only for equal strings
// P6  each arm agrees with at least three of the other five

// ---- star (pieces.kara) --------------------------------------------------

fn star_can_change(start: String, target: String) -> bool {
    let a = start.bytes();
    let b = target.bytes();
    let n = a.len();
    let mut i = 0;
    let mut j = 0;
    loop {
        while i < n and a[i] == b'_' {
            i += 1;
        }
        while j < n and b[j] == b'_' {
            j += 1;
        }
        if i == n or j == n {
            return i == n and j == n;
        }
        if a[i] != b[j] {
            return false;
        }
        if a[i] == b'L' and i < j {
            return false;
        }
        if a[i] == b'R' and i > j {
            return false;
        }
        i += 1;
        j += 1;
    }
}

// ---- lists (pieces_lists.kara) -------------------------------------------

fn lists_pieces(line: String) -> Vec[(char, i64)] {
    let mut found: Vec[(char, i64)] = Vec.new();
    let mut place = 0;
    for c in line.chars() {
        if c != '_' {
            found.push((c, place));
        }
        place += 1;
    }
    found
}

fn lists_can_change(start: String, target: String) -> bool {
    let from = lists_pieces(start);
    let to = lists_pieces(target);
    if from.len() != to.len() {
        return false;
    }
    for k in 0..from.len() {
        let (letter, was) = from[k];
        let (wanted, now) = to[k];
        if letter != wanted {
            return false;
        }
        if letter == 'L' and now > was {
            return false;
        }
        if letter == 'R' and now < was {
            return false;
        }
    }
    true
}

// ---- counts (pieces_counts.kara) -----------------------------------------

fn counts_can_change(start: String, target: String) -> bool {
    if start.replace("_", "") != target.replace("_", "") {
        return false;
    }
    let a: Vec[char] = start.chars().collect();
    let b: Vec[char] = target.chars().collect();
    let mut start_l = 0;
    let mut target_l = 0;
    let mut start_r = 0;
    let mut target_r = 0;
    for k in 0..a.len() {
        if a[k] == 'L' {
            start_l += 1;
        }
        if b[k] == 'L' {
            target_l += 1;
        }
        if a[k] == 'R' {
            start_r += 1;
        }
        if b[k] == 'R' {
            target_r += 1;
        }
        if target_l < start_l or start_r < target_r {
            return false;
        }
    }
    true
}

// ---- moves (pieces_moves.kara) -------------------------------------------

fn moves_can_change(start: String, target: String) -> bool {
    let mut cells: Vec[char] = start.chars().collect();
    let want: Vec[char] = target.chars().collect();
    let n = cells.len();
    let mut from: Vec[i64] = Vec.new();
    let mut to: Vec[i64] = Vec.new();
    for k in 0..n {
        if cells[k] != '_' {
            from.push(k);
        }
        if want[k] != '_' {
            to.push(k);
        }
    }
    if from.len() != to.len() {
        return false;
    }
    for p in 0..from.len() {
        let mut at = from[p];
        if cells[at] == 'L' {
            while at > to[p] and cells[at - 1] == '_' {
                cells[at - 1] = 'L';
                cells[at] = '_';
                at -= 1;
            }
        }
    }
    for p in (0..from.len()).rev() {
        let mut at = from[p];
        if cells[at] == 'R' {
            while at < to[p] and cells[at + 1] == '_' {
                cells[at + 1] = 'R';
                cells[at] = '_';
                at += 1;
            }
        }
    }
    cells == want
}

// ---- iter (pieces_iter.kara) ---------------------------------------------

fn iter_can_change(start: String, target: String) -> bool {
    let from: Vec[(i64, char)] = start.chars().enumerate().filter(|(_, c)| c != '_').collect();
    let to: Vec[(i64, char)] = target.chars().enumerate().filter(|(_, c)| c != '_').collect();
    from.len() == to.len() and from.iter().zip(to.iter()).all(|((was, letter), (now, wanted))| {
        letter == wanted and (letter == 'L' and now <= was or letter == 'R' and now >= was)
    })
}

// ---- solution (pieces_solution.kara) -------------------------------------

impl Solution {
    pub fn can_change(start: String, target: String) -> bool {
        let s = start.bytes();
        let t = target.bytes();
        let n = s.len();
        let mut (i, j) = (0, 0);
        while i < n or j < n {
            while i < n and s[i] == b'_' {
                i += 1;
            }
            while j < n and t[j] == b'_' {
                j += 1;
            }
            if i == n or j == n {
                return i == n and j == n;
            }
            if s[i] != t[j] {
                return false;
            }
            if s[i] == b'L' and i < j {
                return false;
            }
            if s[i] == b'R' and i > j {
                return false;
            }
            i += 1;
            j += 1;
        }
        true
    }
}

struct Solution {}

fn solution_can_change(start: String, target: String) -> bool {
    Solution.can_change(start, target)
}
// ---- the statement read literally ------------------------------------------

fn literal(start: String, target: String) -> bool {
    let mut seen: Set[String] = Set.new();
    seen.insert(start.clone());
    let mut todo: Vec[String] = [start.clone()].to_vec();
    while let Some(line) = todo.pop() {
        let cells: Vec[char] = line.chars().collect();
        for i in 0..cells.len() {
            let mut next = cells.clone();
            if cells[i] == 'L' and i > 0 and cells[i - 1] == '_' {
                next[i - 1] = 'L';
                next[i] = '_';
            } else if cells[i] == 'R' and i + 1 < cells.len() and cells[i + 1] == '_' {
                next[i + 1] = 'R';
                next[i] = '_';
            } else {
                continue;
            }
            let found: String = next.iter().collect();
            if not seen.contains(found) {
                seen.insert(found.clone());
                todo.push(found);
            }
        }
    }
    seen.contains(target)
}

fn answer(arm: i64, start: String, target: String) -> bool {
    match arm {
        0 => star_can_change(start, target),
        1 => lists_can_change(start, target),
        2 => counts_can_change(start, target),
        3 => moves_can_change(start, target),
        4 => iter_can_change(start, target),
        _ => solution_can_change(start, target),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_line(seed: mut ref i64, n: i64, blanks_in_4: i64) -> String {
    let mut line = String.new();
    for _ in 0..n {
        let r = next_random(mut seed) % 4;
        line.push(if r < blanks_in_4 { '_' } else if r % 2 == 0 { 'L' } else { 'R' });
    }
    line
}

fn moved(seed: mut ref i64, line: String, moves: i64) -> String {
    let mut cells: Vec[char] = line.chars().collect();
    let n = cells.len();
    for _ in 0..moves {
        let i = next_random(mut seed) % n;
        if cells[i] == 'L' and i > 0 and cells[i - 1] == '_' {
            cells[i - 1] = 'L';
            cells[i] = '_';
        } else if cells[i] == 'R' and i + 1 < n and cells[i + 1] == '_' {
            cells[i + 1] = 'R';
            cells[i] = '_';
        }
    }
    cells.iter().collect()
}

// reversed, with `L` and `R` swapped
fn mirrored(line: String) -> String {
    line.chars().rev().map(|c| if c == 'L' { 'R' } else if c == 'R' { 'L' } else { c }).collect()
}

fn main() {
    let names = ["star", "lists", "counts", "moves", "iter", "solution"];
    let mut seed = 2337;
    let mut cases: Vec[(String, String, String)] = Vec.new();
    for c in 0..360 {
        let (n, blanks, most) = if c < 300 {
            (next_random(mut seed) % 8 + 1, 2, 20)
        } else if c < 330 {
            (next_random(mut seed) % 40 + 1, 3, 200)
        } else {
            (next_random(mut seed) % 2000 + 1, 2, 100000)
        };
        let start = random_line(mut seed, n, blanks);
        let target = if c >= 330 or next_random(mut seed) % 2 == 0 {
            let moves = next_random(mut seed) % (most + 1);
            moved(mut seed, start, moves)
        } else {
            random_line(mut seed, n, blanks)
        };
        let further = moved(mut seed, target, n);
        cases.push((start, target, further));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (start, target, further)) in cases.iter().enumerate() {
        let small = start.len() <= 8;
        let truth = small and literal(start, target);
        if small {
            check = (check * 31 + if truth { 2 } else { 1 }) % 1000000007;
        }
        let same_pieces = start.replace("_", "") == target.replace("_", "");
        let got: Vec[bool] = (0..6).map(|arm| answer(arm, start, target)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == truth,
                answer(arm, start, start) and (not value or same_pieces),
                answer(arm, mirrored(start), mirrored(target)) == value,
                not value or answer(arm, start, further),
                not (value and answer(arm, target, start)) or start == target,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
