// LeetCode #2327: Number of People Aware of a Secret -- LeetCode's Rust
// template as a Rust user fills it in, carried by `karac fix`: `i32`
// arguments turned to `usize`, a `dp` of the people learning each day,
// each day's entry summed over the window of earlier days that are
// sharing, and an `i32` answer.

struct Solution {}

impl Solution {
    pub fn people_aware_of_secret(n: i32, delay: i32, forget: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let (n, delay, forget) = (n as i64, delay as i64, forget as i64);
        let mut dp = Vec.filled(n + 1, 0);
        dp[1] = 1;
        for i in 2..=n {
            let lo = if i > forget { i - forget + 1 } else { 1 };
            if i > delay {
                for j in lo..=i - delay {
                    dp[i] = (dp[i] + dp[j]) % MOD;
                }
            }
        }
        let mut ans = 0;
        for i in n - forget + 1..=n {
            ans = (ans + dp[i]) % MOD;
        }
        ans as i32
    }
}

fn people_aware_of_secret(n: i64, delay: i64, forget: i64) -> i64 {
    Solution.people_aware_of_secret(n as i32, delay as i32, forget as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then the shortest case, everyone sharing
    // every day for 1000 days, the first person sharing once on the last
    // day, and a delay of 3 with a forget of 7 over 1000 days
    println(f"{people_aware_of_secret(6, 2, 4)}");
    println(f"{people_aware_of_secret(4, 1, 3)}");
    println(f"{people_aware_of_secret(2, 1, 2)}");
    println(f"{people_aware_of_secret(1000, 1, 1000)}");
    println(f"{people_aware_of_secret(1000, 999, 1000)}");
    println(f"{people_aware_of_secret(1000, 3, 7)}");
    // 2000 random cases of 2 to 300 days, forget from 2 to n and delay
    // from 1 to forget - 1
    let mut seed = 2327;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 299 + 2;
        let forget = next_random(mut seed) % (n - 1) + 2;
        let delay = next_random(mut seed) % (forget - 1) + 1;
        let aware = people_aware_of_secret(n, delay, forget);
        check = (check * 31 + aware) % 1000000007;
        total = (total + aware) % 1000000007;
    }
    println(f"2000 cases: checksum {check}, total {total}");
}
