// LeetCode #2327: Number of People Aware of a Secret -- by age: a
// `VecDeque` holds how many people learned the secret 0, 1, ...,
// `forget - 1` days ago, youngest at the front. Each day the oldest
// forget and drop off the back, everyone ages by one, and the people of
// age `delay` or more each tell one newcomer, pushed at the front.
// O(n forget).

const MOD: i64 = 1000000007;

fn people_aware_of_secret(n: i64, delay: i64, forget: i64) -> i64 {
    let mut ages: VecDeque[i64] = VecDeque.new();
    ages.push_back(1);
    for _ in 1..forget {
        ages.push_back(0);
    }
    for _ in 2..=n {
        ages.pop_back();
        ages.push_front(0);
        let mut newcomers = 0;
        for (age, count) in ages.iter().enumerate() {
            if age >= delay {
                newcomers = (newcomers + count) % MOD;
            }
        }
        ages[0] = newcomers;
    }
    ages.iter().fold(0, |sum, count| (sum + count) % MOD)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then the shortest case, everyone sharing
    // every day for 1000 days, the first person sharing once on the last
    // day, and a delay of 3 with a forget of 7 over 1000 days
    println(f"{people_aware_of_secret(6, 2, 4)}");
    println(f"{people_aware_of_secret(4, 1, 3)}");
    println(f"{people_aware_of_secret(2, 1, 2)}");
    println(f"{people_aware_of_secret(1000, 1, 1000)}");
    println(f"{people_aware_of_secret(1000, 999, 1000)}");
    println(f"{people_aware_of_secret(1000, 3, 7)}");
    // 2000 random cases of 2 to 300 days, forget from 2 to n and delay
    // from 1 to forget - 1
    let mut seed = 2327;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 299 + 2;
        let forget = next_random(mut seed) % (n - 1) + 2;
        let delay = next_random(mut seed) % (forget - 1) + 1;
        let aware = people_aware_of_secret(n, delay, forget);
        check = (check * 31 + aware) % 1000000007;
        total = (total + aware) % 1000000007;
    }
    println(f"2000 cases: checksum {check}, total {total}");
}
