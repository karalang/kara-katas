// LeetCode #2327: Number of People Aware of a Secret -- the bench, the ★
// arm. A running count of the people sharing gains those who learned the
// secret `delay` days back and loses those who learned it `forget` days
// back, and that many learn it each day. O(n).

const MOD: i64 = 1000000007;

fn people_aware_of_secret(n: i64, delay: i64, forget: i64) -> i64 {
    let mut learned: Vec[i64] = Vec.filled(n + 1, 0);
    learned[1] = 1;
    let mut sharing = 0;
    for day in 2..=n {
        if day - delay >= 1 {
            sharing = (sharing + learned[day - delay]) % MOD;
        }
        if day - forget >= 1 {
            sharing = (sharing - learned[day - forget] + MOD) % MOD;
        }
        learned[day] = sharing;
    }
    let mut aware = 0;
    for day in (n - forget + 1)..=n {
        aware = (aware + learned[day]) % MOD;
    }
    aware
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 3000 pairs of forget from 2 to 990 and delay below it, drawn once;
    // pass `p` asks for case `k` over `990 + (k + p) % 11` days
    let mut seed = 2327;
    let mut cases: Vec[(i64, i64)] = Vec.new();
    for _ in 0..3000 {
        let forget = next_random(mut seed) % 989 + 2;
        let delay = next_random(mut seed) % (forget - 1) + 1;
        cases.push((delay, forget));
    }
    let mut check = 0;
    for p in 0..10 {
        for k in 0..3000 {
            let (delay, forget) = cases[k];
            let n = 990 + (k + p) % 11;
            check = (check * 31 + people_aware_of_secret(n, delay, forget)) % 1000000007;
        }
    }
    println(f"10 passes over 3000 cases of up to 1000 days: checksum {check}");
}
