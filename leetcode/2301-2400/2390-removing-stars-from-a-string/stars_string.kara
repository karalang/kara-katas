// LeetCode #2390: Removing Stars From a String -- the answer as a String
// that is its own stack. Each char is pushed onto it, and a star pops its
// last char. O(n).

fn remove_stars(s: String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == '*' {
            out.pop();
        } else {
            out.push(c);
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn starred(seed: mut ref i64, len: i64, odds: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut depth = 0;
    for _ in 0..len {
        if depth > 0 and next_random(mut seed) % odds == 0 {
            out.push(b'*');
            depth -= 1;
        } else {
            out.push(b'a' + (next_random(mut seed) % 26) as u8);
            depth += 1;
        }
    }
    String.from_utf8(out).unwrap()
}

fn letters_checksum(s: String) -> i64 {
    let mut check = 0;
    for b in s.bytes().iter() {
        check = (check * 31 + (b - b'a' + 1)) % 1000000007;
    }
    check
}

fn main() {
    // LeetCode's two examples; a star taking the first letter, stars in a
    // row, no stars; 10^5 characters with a star a third of the time, and
    // with a star half the time, as checksums and lengths; then 3000
    // random strings of 1 to 30 characters, with a checksum, the total
    // length left, and how many come back empty
    println(f"[{remove_stars("leet**cod*e")}]");
    println(f"[{remove_stars("erase*****")}]");
    println(f"[{remove_stars("a*b")}]");
    println(f"[{remove_stars("abc**de***fg")}]");
    println(f"[{remove_stars("kara")}]");
    let mut seed = 2390;
    let third = remove_stars(starred(mut seed, 100000, 3));
    let half = remove_stars(starred(mut seed, 100000, 2));
    println(f"10^5 characters: {letters_checksum(third)} of {third.len()}, {letters_checksum(half)} of {half.len()}");
    let mut check = 0;
    let mut total = 0;
    let mut empty = 0;
    for _ in 0..3000 {
        let len = 1 + next_random(mut seed) % 30;
        let odds = 1 + next_random(mut seed) % 4;
        let t = remove_stars(starred(mut seed, len, odds));
        check = (check * 31 + letters_checksum(t)) % 1000000007;
        total += t.len();
        if t.len() == 0 {
            empty += 1;
        }
    }
    println(f"3000 strings: checksum {check}, {total} letters left, {empty} empty");
}
