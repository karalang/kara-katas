// LeetCode #2390: Removing Stars From a String -- the differential. The
// six arms, against the statement read literally: while a star is left,
// the LAST one is chosen, and it and the closest letter to its left are
// deleted from the string. No stack. 300 random strings of 1 to 30
// characters, which the literal reading answers; then 30 of up to 2000;
// then 30 made of runs, letters and then stars, where whole runs vanish.
// Every case is drawn before any arm answers.
//
// P1  up to 30 characters, the answer is the literal reading's
// P2  the answer's length is the letters less the stars
// P3  the answer is the input's letters with some left out, in order
// P4  any prefix answered first, then the rest after it: the same answer
// P5  every letter shifted one along the alphabet: the answer shifted
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn remove_literally(s: String) -> String {
    let mut b = s.bytes().to_vec();
    loop {
        let mut star = b.len();
        for i in 0..b.len() {
            if b[i] == b'*' {
                star = i;
            }
        }
        if star == b.len() {
            break;
        }
        let mut letter = star - 1;
        while b[letter] == b'*' {
            letter -= 1;
        }
        b.remove(star);
        b.remove(letter);
    }
    String.from_utf8(b).unwrap()
}

// ---- star (stars.kara) ---------------------------------------------------

fn star_remove_stars(s: String) -> String {
    let mut stack: Vec[u8] = Vec.new();
    for b in s.bytes().iter() {
        if b == b'*' {
            stack.pop();
        } else {
            stack.push(b);
        }
    }
    String.from_utf8(stack).unwrap()
}

// ---- back (stars_back.kara) ----------------------------------------------

fn back_remove_stars(s: String) -> String {
    let b = s.bytes();
    let mut owed = 0;
    let mut kept: Vec[u8] = Vec.new();
    let mut i = b.len();
    while i > 0 {
        i -= 1;
        if b[i] == b'*' {
            owed += 1;
        } else if owed > 0 {
            owed -= 1;
        } else {
            kept.push(b[i]);
        }
    }
    kept.reverse();
    String.from_utf8(kept).unwrap()
}

// ---- write (stars_write.kara) --------------------------------------------

fn write_remove_stars(s: String) -> String {
    let mut b = s.bytes().to_vec();
    let mut write = 0;
    for read in 0..b.len() {
        if b[read] == b'*' {
            write -= 1;
        } else {
            b[write] = b[read];
            write += 1;
        }
    }
    b.truncate(write);
    String.from_utf8(b).unwrap()
}

// ---- string (stars_string.kara) ------------------------------------------

fn string_remove_stars(s: String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == '*' {
            out.pop();
        } else {
            out.push(c);
        }
    }
    out
}

// ---- iter (stars_iter.kara) ----------------------------------------------

fn iter_remove_stars(s: String) -> String {
    let stack = s.bytes().iter().fold(Vec.new(), |stack, b| {
        let mut stack = stack;
        if b == b'*' {
            stack.pop();
        } else {
            stack.push(b);
        }
        stack
    });
    String.from_utf8(stack).unwrap()
}

// ---- solution (stars_solution.kara) --------------------------------------

struct Solution {}

impl Solution {
    pub fn remove_stars(s: String) -> String {
        let mut st: Vec[char] = Vec.with_capacity(s.len());
        for c in s.chars() {
            match c {
                '*' => {
                    st.pop();
                },
                _ => st.push(c),
            }
        }
        st.into_iter().collect()
    }
}

fn solution_remove_stars(s: String) -> String {
    Solution.remove_stars(s)
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, s: String) -> String {
    match arm {
        0 => star_remove_stars(s),
        1 => back_remove_stars(s),
        2 => write_remove_stars(s),
        3 => string_remove_stars(s),
        4 => iter_remove_stars(s),
        _ => solution_remove_stars(s),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn letter(seed: mut ref i64) -> u8 {
    b'a' + (next_random(mut seed) % 26) as u8
}

fn shifted(s: String) -> String {
    let b: Vec[u8] = s.bytes().iter().map(|c| if c == b'*' {
        c
    } else {
        b'a' + (c - b'a' + 1) % 26
    }).collect();
    String.from_utf8(b).unwrap()
}

fn main() {
    let names = ["star", "back", "write", "string", "iter", "solution"];
    let mut seed = 2390;
    let mut cases: Vec[String] = Vec.new();
    for c in 0..360 {
        let mut b: Vec[u8] = Vec.new();
        if c < 330 {
            let len = if c < 300 {
                1 + next_random(mut seed) % 30
            } else {
                1 + next_random(mut seed) % 2000
            };
            let odds = 1 + next_random(mut seed) % 4;
            let mut depth = 0;
            for _ in 0..len {
                if depth > 0 and next_random(mut seed) % odds == 0 {
                    b.push(b'*');
                    depth -= 1;
                } else {
                    b.push(letter(mut seed));
                    depth += 1;
                }
            }
        } else {
            let mut depth = 0;
            for _ in 0..1 + next_random(mut seed) % 6 {
                let run = 1 + next_random(mut seed) % 8;
                for _ in 0..run {
                    b.push(letter(mut seed));
                }
                depth += run;
                let stars = next_random(mut seed) % (depth + 1);
                for _ in 0..stars {
                    b.push(b'*');
                }
                depth -= stars;
            }
        }
        cases.push(String.from_utf8(b).unwrap());
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let s = cases[c].clone();
        let b = s.bytes();
        let small = b.len() <= 30;
        let truth = if small {
            remove_literally(s)
        } else {
            String.new()
        };
        if small {
            for v in truth.bytes().iter() {
                check = (check * 31 + (v - b'a' + 1)) % 1000000007;
            }
            check = (check * 31 + 27) % 1000000007;
        }
        let mut stars = 0;
        for v in b.iter() {
            if v == b'*' {
                stars += 1;
            }
        }
        let split = next_random(mut seed) % (b.len() + 1);
        let front = String.from_utf8(b[0..split].to_vec()).unwrap();
        let rest = String.from_utf8(b[split..b.len()].to_vec()).unwrap();
        let got: Vec[String] = (0..6).map(|arm| answer(arm, s)).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let v = value.bytes();
            let mut j = 0;
            for x in b.iter() {
                if j < v.len() and x != b'*' and x == v[j] {
                    j += 1;
                }
            }
            let mut glued = answer(arm, front);
            glued.push_str(rest);
            let verdicts = [not small or value == truth, v.len() == b.len() - 2 * stars, j == v.len(), answer(arm, glued) == value, answer(arm, shifted(s)) == shifted(value), same >= 3];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
