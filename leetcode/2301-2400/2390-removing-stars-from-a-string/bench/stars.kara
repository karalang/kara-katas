// LeetCode #2390: Removing Stars From a String -- the bench, the ★ arm:
// a stack, a letter pushed and a star popping.

fn remove_stars(s: String) -> String {
    let mut stack: Vec[u8] = Vec.new();
    for b in s.bytes().iter() {
        if b == b'*' {
            stack.pop();
        } else {
            stack.push(b);
        }
    }
    String.from_utf8(stack).unwrap()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn starred(seed: mut ref i64, len: i64, odds: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut depth = 0;
    for _ in 0..len {
        if depth > 0 and next_random(mut seed) % odds == 0 {
            out.push(b'*');
            depth -= 1;
        } else {
            out.push(b'a' + (next_random(mut seed) % 26) as u8);
            depth += 1;
        }
    }
    String.from_utf8(out).unwrap()
}

fn main() {
    // 20 strings of 10^5 characters, a star a third of the time; each
    // pass answers them all and folds every letter left, and the length
    let mut seed = 2390;
    let strings: Vec[String] = (0..20).map(|_| starred(mut seed, 100000, 3)).collect();
    let mut check = 0;
    for p in 0..100 {
        for s in strings.iter() {
            let t = remove_stars(s);
            for b in t.bytes().iter() {
                check = (check * 31 + (b - b'a' + 1)) % 1000000007;
            }
            check = (check * 31 + t.len() + p) % 1000000007;
        }
    }
    println(f"100 passes over 20 strings of 10^5 characters: checksum {check}");
}
