// LeetCode #2306: Naming a Company -- the differential. The six arms,
// against the statement read literally: every ordered pair of distinct
// ideas has its first letters swapped, and when neither swapped word is
// an idea the name, the two words with a space between, goes into a
// `Set[String]`; the answer is how many distinct names it holds. 300
// random cases of 2 to 40 ideas, first letters from up to 6 and
// suffixes of up to 2 letters from 3; then 30 whose suffixes are only
// "" and "a"; then 30 of up to 150 ideas over 25 first letters and
// suffixes of up to 3 letters from all 26. Every case is drawn before
// any arm answers.
//
// P1  the answer is the literal reading's
// P2  the answer is even and at most n (n - 1)
// P3  the ideas in reverse order: the same answer
// P4  every first letter moved 7 on in the alphabet, wrapping: the same
//     answer
// P5  one idea more, `z` and a suffix no idea has: 2 n names more
// P6  each arm agrees with at least three of the other five

// ---- names.kara: the ★ arm, suffixes grouped by letter
fn star_names(ideas: Vec[String]) -> i64 {
    let mut groups: Vec[Set[String]] = Vec.new();
    for _ in 0..26 {
        groups.push(Set.new());
    }
    for idea in ideas.iter() {
        let first = (idea.bytes()[0] - b'a') as i64;
        groups[first].insert(idea[1..].to_string());
    }
    let mut names = 0;
    for a in 0..26 {
        for b in a + 1..26 {
            let mut shared = 0;
            for suffix in groups[a].iter() {
                if groups[b].contains(suffix) {
                    shared += 1;
                }
            }
            names += 2 * (groups[a].len() - shared) * (groups[b].len() - shared);
        }
    }
    names
}

// ---- names_naive.kara: every pair
fn naive_names(ideas: Vec[String]) -> i64 {
    let mut all: Set[String] = Set.new();
    for idea in ideas.iter() {
        all.insert(idea.clone());
    }
    let mut names = 0;
    for a in ideas.iter() {
        for b in ideas.iter() {
            let swapped_a = f"{b[0..1]}{a[1..]}";
            let swapped_b = f"{a[0..1]}{b[1..]}";
            if not all.contains(swapped_a) and not all.contains(swapped_b) {
                names += 1;
            }
        }
    }
    names
}

// ---- names_masks.kara: a mask for each suffix
fn masks_names(ideas: Vec[String]) -> i64 {
    let mut masks: Map[String, i64] = Map.new();
    for idea in ideas.iter() {
        let bit = 1 << (idea.bytes()[0] - b'a') as i64;
        let suffix = idea[1..].to_string();
        let mask = masks.get(suffix).unwrap_or(0);
        masks.insert(suffix, mask | bit);
    }
    let mut movable: Vec[Vec[i64]] = Vec.filled(26, Vec.filled(26, 0));
    for mask in masks.values() {
        for a in 0..26 {
            if (mask >> a) & 1 == 1 {
                for b in 0..26 {
                    if (mask >> b) & 1 == 0 {
                        movable[a][b] += 1;
                    }
                }
            }
        }
    }
    let mut names = 0;
    for a in 0..26 {
        for b in 0..26 {
            names += movable[a][b] * movable[b][a];
        }
    }
    names
}

// ---- names_sorted.kara: sorted, with no hashing
fn sorted_names(ideas: Vec[String]) -> i64 {
    let mut pairs: Vec[(String, i64)] = ideas.iter().map(|idea| (idea[1..].to_string(), (idea.bytes()[0] - b'a') as i64)).collect();
    pairs.sort();
    let mut movable: Vec[Vec[i64]] = Vec.filled(26, Vec.filled(26, 0));
    let mut i = 0;
    while i < pairs.len() {
        let mut mask = 0;
        let mut j = i;
        while j < pairs.len() and pairs[j].0 == pairs[i].0 {
            mask |= 1 << pairs[j].1;
            j += 1;
        }
        for a in 0..26 {
            for b in 0..26 {
                if (mask >> a) & 1 == 1 and (mask >> b) & 1 == 0 {
                    movable[a][b] += 1;
                }
            }
        }
        i = j;
    }
    let mut names = 0;
    for a in 0..26 {
        for b in 0..26 {
            names += movable[a][b] * movable[b][a];
        }
    }
    names
}

// ---- names_iter.kara: iterators
fn iter_names(ideas: Vec[String]) -> i64 {
    let groups: Vec[Set[String]] = (0..26)
        .map(|letter| ideas.iter().filter(|idea| (idea.bytes()[0] - b'a') as i64 == letter).map(|idea| idea[1..].to_string()).collect())
        .collect();
    (0..26)
        .flat_map(|a| (0..26).map(|b| (a, b)))
        .filter(|(a, b)| a != b)
        .map(|(a, b)| {
            let shared = groups[a].iter().filter(|s| groups[b].contains(s)).count();
            (groups[a].len() - shared) * (groups[b].len() - shared)
        })
        .sum()
}

// ---- names_solution.kara: LeetCode's Rust template
struct Solution {}

impl Solution {
    pub fn distinct_names(ideas: Vec[String]) -> i64 {
        let mut groups: Vec[Set[String]] = Vec.filled(26, Set.new());
        for idea in ref ideas {
            groups[(idea.bytes()[0] - b'a') as usize].insert(idea[1..].to_string());
        }
        let mut ans = 0;
        for a in 0..26 {
            for b in a + 1..26 {
                let shared = groups[a].intersection(groups[b]).len();
                ans += 2 * (groups[a].len() - shared) * (groups[b].len() - shared);
            }
        }
        ans
    }
}

fn solution_names(ideas: Vec[String]) -> i64 {
    Solution.distinct_names(ideas)
}

// ---- the statement read literally ------------------------------------------

fn literal(ideas: Vec[String]) -> i64 {
    let mut all: Set[String] = Set.new();
    for idea in ideas.iter() {
        all.insert(idea.clone());
    }
    let mut names: Set[String] = Set.new();
    for i in 0..ideas.len() {
        for j in 0..ideas.len() {
            if i != j {
                let a = f"{ideas[j][0..1]}{ideas[i][1..]}";
                let b = f"{ideas[i][0..1]}{ideas[j][1..]}";
                if not all.contains(a) and not all.contains(b) {
                    names.insert(f"{a} {b}");
                }
            }
        }
    }
    names.len()
}

fn answer(arm: i64, ideas: Vec[String]) -> i64 {
    match arm {
        0 => star_names(ideas),
        1 => naive_names(ideas),
        2 => masks_names(ideas),
        3 => sorted_names(ideas),
        4 => iter_names(ideas),
        _ => solution_names(ideas),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn make(seed: mut ref i64, count: i64, heads: i64, tails: i64, longest: i64) -> Vec[String] {
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut seen: Set[String] = Set.new();
    let mut ideas: Vec[String] = Vec.new();
    while ideas.len() < count {
        let mut idea = String.new();
        idea.push(letters[next_random(mut seed) % heads]);
        for _ in 0..next_random(mut seed) % longest {
            idea.push(letters[next_random(mut seed) % tails]);
        }
        if not seen.contains(idea) {
            seen.insert(idea.clone());
            ideas.push(idea);
        }
    }
    ideas
}

fn main() {
    let names = ["star", "naive", "masks", "sorted", "iter", "solution"];
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut seed = 2306;
    let mut cases: Vec[Vec[String]] = Vec.new();
    for c in 0..360 {
        let ideas = if c < 300 {
            let count = next_random(mut seed) % 39 + 2;
            let heads = next_random(mut seed) % 5 + 2;
            make(mut seed, count.min(heads * 13), heads, 3, 3)
        } else if c < 330 {
            let heads = next_random(mut seed) % 5 + 2;
            make(mut seed, next_random(mut seed) % (2 * heads - 1) + 2, heads, 1, 2)
        } else {
            make(mut seed, next_random(mut seed) % 149 + 2, 25, 26, 4)
        };
        cases.push(ideas);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for ideas in cases.iter() {
        let n = ideas.len();
        let truth = literal(ideas);
        check = (check * 31 + truth) % 1000000007;
        let reversed: Vec[String] = ideas.iter().rev().cloned().collect();
        let moved: Vec[String] = ideas
            .iter()
            .map(|idea| f"{letters[((idea.bytes()[0] - b'a') as i64 + 7) % 26]}{idea[1..]}")
            .collect();
        let mut more = ideas.clone();
        more.push("zzzzzz");
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, ideas)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                value % 2 == 0 and value >= 0 and value <= n * (n - 1),
                answer(arm, reversed) == value,
                answer(arm, moved) == value,
                answer(arm, more) == value + 2 * n,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{ideas} arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
