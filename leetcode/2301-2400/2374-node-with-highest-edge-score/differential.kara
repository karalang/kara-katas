// LeetCode #2374: Node With Highest Edge Score -- the differential. The
// six arms, against the statement read literally: each node's score the
// sum of the labels of every node whose edge points at it, found by a scan
// of every edge, and the answer the node that no other node beats, by a
// higher score or the same score at a smaller label, checked against
// every other node. 300 random graphs of 2 to 40 nodes, each edge to any
// other node or, with a chance of 1 in 2, to one of the first three; then
// 30 of up to 600 nodes; then 30 of up to 300 nodes whose edges all go
// to one of three nodes. Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  a node from 0 to n - 1 that some edge points at
// P3  a new node n pointing at the answer: the same answer
// P4  node 0's edge pointed at another node: the same answer
// P5  a new node n pointing at node v: v when its score and n pass the
//     answer's score, or meet it at a smaller label; else the same answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn scores_literally(edges: Vec[i64]) -> Vec[i64] {
    let n = edges.len();
    (0..n).map(|v| (0..n).filter(|i| edges[i] == v).sum()).collect()
}

fn edge_literally(edges: Vec[i64]) -> i64 {
    let n = edges.len();
    let score = scores_literally(edges);
    for v in 0..n {
        let mut beaten = false;
        for u in 0..n {
            if score[u] > score[v] or (score[u] == score[v] and u < v) {
                beaten = true;
            }
        }
        if not beaten {
            return v;
        }
    }
    -1
}

// ---- star (edge.kara) ----------------------------------------------------

fn star_edge_score(edges: Vec[i64]) -> i64 {
    let n = edges.len();
    let mut score: Vec[i64] = Vec.filled(n, 0);
    for i in 0..n {
        score[edges[i]] += i;
    }
    let mut best = 0;
    for v in 1..n {
        if score[v] > score[best] {
            best = v;
        }
    }
    best
}

// ---- sort (edge_sort.kara) -----------------------------------------------

fn sort_edge_score(edges: Vec[i64]) -> i64 {
    let n = edges.len();
    let mut pairs: Vec[(i64, i64)] = (0..n).map(|i| (edges[i], i)).collect();
    pairs.sort();
    let mut best = 0;
    let mut best_score = -1;
    let mut k = 0;
    while k < n {
        let node = pairs[k].0;
        let mut total = 0;
        while k < n and pairs[k].0 == node {
            total += pairs[k].1;
            k += 1;
        }
        if total > best_score {
            best = node;
            best_score = total;
        }
    }
    best
}

// ---- online (edge_online.kara) -------------------------------------------

fn online_edge_score(edges: Vec[i64]) -> i64 {
    let n = edges.len();
    let mut score: Vec[i64] = Vec.filled(n, 0);
    let mut best = 0;
    for i in 0..n {
        let t = edges[i];
        score[t] += i;
        if score[t] > score[best] or (score[t] == score[best] and t < best) {
            best = t;
        }
    }
    best
}

// ---- map (edge_map.kara) -------------------------------------------------

fn map_edge_score(edges: Vec[i64]) -> i64 {
    let mut score: Map[i64, i64] = Map.new();
    for i in 0..edges.len() {
        *score.entry(edges[i]).or_insert(0) += i;
    }
    let mut best = -1;
    let mut best_score = -1;
    for (node, total) in score.iter() {
        if total > best_score or (total == best_score and node < best) {
            best = node;
            best_score = total;
        }
    }
    best
}

// ---- iter (edge_iter.kara) -----------------------------------------------

fn iter_edge_score(edges: Vec[i64]) -> i64 {
    let n = edges.len();
    let score = edges.iter().enumerate().fold(Vec.filled(n, 0), |score: own Vec[i64], (i, t)| {
        let mut score = score;
        score[t] += i;
        score
    });
    (0..n).max_by_key(|v| (score[v], -v)).unwrap()
}

// ---- solution (edge_solution.kara) ---------------------------------------

struct Solution {}

impl Solution {
    pub fn edge_score(edges: Vec[i32]) -> i32 {
        let mut score = Vec.filled(edges.len(), 0);
        for (i, e) in edges.iter().enumerate() {
            score[e as usize] += i;
        }
        let mut best = 0;
        for i in 1..score.len() {
            if score[i] > score[best] {
                best = i;
            }
        }
        best as i32
    }
}

fn solution_edge_score(edges: Vec[i64]) -> i64 {
    let edges: Vec[i32] = edges.iter().map(|e| e as i32).collect();
    Solution.edge_score(edges)
}

// ---- the checks -------------------------------------------------------------

fn answer(arm: i64, edges: Vec[i64]) -> i64 {
    match arm {
        0 => star_edge_score(edges),
        1 => sort_edge_score(edges),
        2 => online_edge_score(edges),
        3 => map_edge_score(edges),
        4 => iter_edge_score(edges),
        _ => solution_edge_score(edges),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "sort", "online", "map", "iter", "solution"];
    let mut seed = 2374;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..360 {
        let n = if c < 300 {
            2 + next_random(mut seed) % 39
        } else if c < 330 {
            2 + next_random(mut seed) % 599
        } else {
            4 + next_random(mut seed) % 297
        };
        let edges: Vec[i64] = (0..n)
            .map(|i| {
                if c >= 345 {
                    if i == 0 {
                        1
                    } else if i == n - 1 {
                        n - 2
                    } else if next_random(mut seed) % 64 == 0 {
                        next_random(mut seed) % i
                    } else {
                        i - 1
                    }
                } else {
                    let mut e = if c >= 330 or next_random(mut seed) % 2 == 0 {
                        next_random(mut seed) % 3 % n
                    } else {
                        next_random(mut seed) % n
                    };
                    if e == i {
                        e = (e + 1) % n;
                    }
                    e
                }
            })
            .collect();
        cases.push(edges);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let edges = cases[c].clone();
        let n = edges.len();
        let truth = edge_literally(edges);
        check = (check * 31 + truth) % 1000000007;
        let score = scores_literally(edges);
        let mut onto = edges.clone();
        onto.push(truth);
        let mut moved = edges.clone();
        moved[0] = if edges[0] == n - 1 { 1 } else { n - 1 };
        let v = (c * 7 + 3) % n;
        let mut extra = edges.clone();
        extra.push(v);
        let passes = score[v] + n > score[truth] or (score[v] + n == score[truth] and v < truth);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, edges)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                value >= 0 and value < n and edges.contains(value),
                answer(arm, onto) == value,
                answer(arm, moved) == value,
                answer(arm, extra) == if passes { v } else { value },
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
