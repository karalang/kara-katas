// LeetCode #2374: Node With Highest Edge Score -- sorted. The pairs
// (target, source) sorted so that the edges into each node stand
// together, each run summed into its node's score, and the best kept as
// the runs go by, so the smaller node keeps a tie. A node no edge points
// at scores 0, and some node scores more, since the labels sum to more
// than 0. O(n log n).

fn edge_score(edges: Vec[i64]) -> i64 {
    let n = edges.len();
    let mut pairs: Vec[(i64, i64)] = (0..n).map(|i| (edges[i], i)).collect();
    pairs.sort();
    let mut best = 0;
    let mut best_score = -1;
    let mut k = 0;
    while k < n {
        let node = pairs[k].0;
        let mut total = 0;
        while k < n and pairs[k].0 == node {
            total += pairs[k].1;
            k += 1;
        }
        if total > best_score {
            best = node;
            best_score = total;
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; two nodes; 10^5 nodes all pointing at node
    // 0, node 0 at node 1; 10^5 nodes each pointing at half its label;
    // 10^5 nodes each pointing at the next, around; then 2000 random
    // graphs of 2 to 40 nodes, each edge to any other node or, with a
    // chance of 1 in 2, to one of the first three
    println(f"{edge_score([1, 0, 0, 0, 0, 7, 7, 5])}");
    println(f"{edge_score([2, 0, 0, 2])}");
    println(f"{edge_score([1, 0])}");
    let n = 100000;
    let star: Vec[i64] = (0..n).map(|i| if i == 0 { 1 } else { 0 }).collect();
    let halves: Vec[i64] = (0..n).map(|i| if i == 0 { 1 } else { i / 2 }).collect();
    let around: Vec[i64] = (0..n).map(|i| (i + 1) % n).collect();
    println(f"{edge_score(star)} {edge_score(halves)} {edge_score(around)}");
    let mut seed = 2374;
    let mut check = 0;
    let mut zero = 0;
    for _ in 0..2000 {
        let n = 2 + next_random(mut seed) % 39;
        let edges: Vec[i64] = (0..n)
            .map(|i| {
                let mut e = if next_random(mut seed) % 2 == 0 { next_random(mut seed) % 3 % n } else { next_random(mut seed) % n };
                if e == i {
                    e = (e + 1) % n;
                }
                e
            })
            .collect();
        let t = edge_score(edges);
        check = (check * 31 + t) % 1000000007;
        if t == 0 {
            zero += 1;
        }
    }
    println(f"2000 graphs: checksum {check}, {zero} with node 0 the answer");
}
