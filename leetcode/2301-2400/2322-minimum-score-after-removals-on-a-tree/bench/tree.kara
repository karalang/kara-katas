// LeetCode #2322: Minimum Score After Removals on a Tree -- the bench,
// the ★ arm. Rooted at 0, two removals are two nodes other than the
// root; one walk gives each subtree's XOR and each node's entry and exit
// times, and the three parts follow from whether one node is the
// other's ancestor. O(n^2).

fn visit(node: i64, parent: i64, adjacent: Vec[Vec[i64]], nums: Vec[i64], xor: mut ref Vec[i64], enter: mut ref Vec[i64], leave: mut ref Vec[i64], clock: mut ref i64) {
    enter[node] = *clock;
    *clock += 1;
    xor[node] = nums[node];
    for next in adjacent[node].iter() {
        if next != parent {
            visit(next, node, adjacent, nums, mut xor, mut enter, mut leave, mut clock);
            xor[node] ^= xor[next];
        }
    }
    leave[node] = *clock;
}

fn minimum_score(nums: Vec[i64], edges: Vec[Vec[i64]]) -> i64 {
    let n = nums.len();
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut xor: Vec[i64] = Vec.filled(n, 0);
    let mut enter: Vec[i64] = Vec.filled(n, 0);
    let mut leave: Vec[i64] = Vec.filled(n, 0);
    let mut clock = 0;
    visit(0, -1, adjacent, nums, mut xor, mut enter, mut leave, mut clock);
    let whole = xor[0];
    let mut best = i64.MAX;
    for a in 1..n {
        for b in (a + 1)..n {
            let (x, y, z) = if enter[a] <= enter[b] and leave[b] <= leave[a] {
                (xor[b], xor[a] ^ xor[b], whole ^ xor[a])
            } else if enter[b] <= enter[a] and leave[a] <= leave[b] {
                (xor[a], xor[b] ^ xor[a], whole ^ xor[b])
            } else {
                (xor[a], xor[b], whole ^ xor[a] ^ xor[b])
            };
            best = best.min(x.max(y).max(z) - x.min(y).min(z));
        }
    }
    best
}

// ---- the bench --------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10 trees of 1000 nodes with values up to 10^8 built once; each pass
    // changes one value of each tree, chosen at random, before scoring it
    let n = 1000;
    let mut seed = 2322;
    let mut values: Vec[Vec[i64]] = Vec.new();
    let mut shapes: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..10 {
        values.push((0..n).map(|_| next_random(mut seed) % 100000000 + 1).collect());
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for i in 1..n {
            edges.push([next_random(mut seed) % i, i].to_vec());
        }
        shapes.push(edges);
    }
    let mut check = 0;
    for _ in 0..30 {
        for k in 0..10 {
            let i = next_random(mut seed) % n;
            values[k][i] = next_random(mut seed) % 100000000 + 1;
            check = (check * 31 + minimum_score(values[k], shapes[k])) % 1000000007;
        }
    }
    println(f"30 passes over 10 trees of 1000 nodes: checksum {check}");
}
