// LeetCode #2385: Amount of Time for Binary Tree to Be Infected -- the
// bench, the ★ arm: one post-order walk returning each subtree's height
// and the start's distance below it.

fn walk(node: Option[TreeNode], start: i64, best: mut ref i64) -> (i64, i64) {
    match node {
        None => (0, -1),
        Some(n) => {
            let (lh, ld) = walk(n.left, start, mut best);
            let (rh, rd) = walk(n.right, start, mut best);
            let height = 1 + lh.max(rh);
            if n.val == start {
                *best = (*best).max(lh.max(rh));
                (height, 0)
            } else if ld >= 0 {
                *best = (*best).max(ld + 1 + rh);
                (height, ld + 1)
            } else if rd >= 0 {
                *best = (*best).max(rd + 1 + lh);
                (height, rd + 1)
            } else {
                (height, -1)
            }
        },
    }
}

fn amount_of_time(root: Option[TreeNode], start: i64) -> i64 {
    let mut best = 0;
    walk(root, start, mut best);
    best
}

// LeetCode's own node: an `i32` value
shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i64) -> TreeNode {
    TreeNode {
        val: v as i32,
        left: None,
        right: None,
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` nodes with the values 1 to `n` in a random order, each after the
// first hung below a random earlier one: from it, a random side is taken
// down until a free one is found
fn random_tree(n: i64, seed: mut ref i64) -> Option[TreeNode] {
    let mut values: Vec[i64] = (1..n + 1).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        values.swap(i, j);
    }
    let nodes: Vec[TreeNode] = values.iter().map(|v| leaf(v)).collect();
    for k in 1..n {
        let mut at = nodes[(next_random(mut seed) * 32768 + next_random(mut seed)) % k];
        loop {
            if next_random(mut seed) % 2 == 0 {
                match at.left {
                    Some(c) => {
                        at = c;
                    },
                    None => {
                        at.left = Some(nodes[k]);
                        break;
                    },
                }
            } else {
                match at.right {
                    Some(c) => {
                        at = c;
                    },
                    None => {
                        at.right = Some(nodes[k]);
                        break;
                    },
                }
            }
        }
    }
    Some(nodes[0])
}

fn main() {
    // 200 random trees of 1000 nodes, each asked from 400 starts, start s
    // of tree t being 1 + (37 s + t) % 1000
    let mut seed = 2385;
    let mut check = 0;
    for t in 0..200 {
        let root = random_tree(1000, mut seed);
        for s in 0..400 {
            check = (check * 31 + amount_of_time(root, 1 + (37 * s + t) % 1000)) % 1000000007;
        }
    }
    println(f"200 trees of 1000, 400 starts each: checksum {check}");
}
