// LeetCode #2385: Amount of Time for Binary Tree to Be Infected -- the
// differential. The six arms, against the statement read literally: the
// nodes listed with their parents, and minute by minute every node not
// yet infected checked for an infected parent or an infected child, until
// all are. No heights, no search. 300 random trees of 1 to 12 nodes,
// which the literal reading answers; then 30 of up to 300; then 30 of up
// to 300 nearly a chain, each node hung below one of the last two. Every
// case is drawn before any arm answers, from a random start.
//
// P1  up to 12 nodes, the answer is the literal reading's
// P2  at most the nodes less one, and at least the start's depth
// P3  the tree mirrored: the same answer
// P4  every value v made n + 1 - v, the start too: the same answer
// P5  a new root above the old one: the larger of the answer and the
//     start's depth plus one
// P6  each arm agrees with at least three of the other five

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v as i32, left: None, right: None }
}

// ---- the statement read literally ------------------------------------------

fn listed(node: Option[TreeNode], parent: i64, nodes: mut ref Vec[(i64, i64)]) {
    if let Some(n) = node {
        nodes.push((n.val as i64, parent));
        listed(n.left, n.val, mut nodes);
        listed(n.right, n.val, mut nodes);
    }
}

fn minutes_literally(root: Option[TreeNode], start: i64) -> i64 {
    let mut nodes: Vec[(i64, i64)] = Vec.new();
    listed(root, 0, mut nodes);
    let n = nodes.len();
    let mut infected: Vec[bool] = nodes.iter().map(|(v, _)| v == start).collect();
    let mut count = 1;
    let mut minutes = 0;
    while count < n {
        let mut next = infected.clone();
        for u in 0..n {
            if infected[u] {
                continue;
            }
            let (value, parent) = nodes[u];
            for w in 0..n {
                let (other, above) = nodes[w];
                if infected[w] and (other == parent or above == value) {
                    next[u] = true;
                }
            }
        }
        count = next.iter().filter(|b| b).count();
        infected = next;
        minutes += 1;
    }
    minutes
}

// ---- star (infect.kara) --------------------------------------------------

fn star_walk(node: Option[TreeNode], start: i64, best: mut ref i64) -> (i64, i64) {
    match node {
        None => (0, -1),
        Some(n) => {
            let (lh, ld) = star_walk(n.left, start, mut best);
            let (rh, rd) = star_walk(n.right, start, mut best);
            let height = 1 + lh.max(rh);
            if n.val == start {
                *best = (*best).max(lh.max(rh));
                (height, 0)
            } else if ld >= 0 {
                *best = (*best).max(ld + 1 + rh);
                (height, ld + 1)
            } else if rd >= 0 {
                *best = (*best).max(rd + 1 + lh);
                (height, rd + 1)
            } else {
                (height, -1)
            }
        },
    }
}

fn star_amount_of_time(root: Option[TreeNode], start: i64) -> i64 {
    let mut best = 0;
    star_walk(root, start, mut best);
    best
}

// ---- graph (infect_graph.kara) -------------------------------------------

fn graph_link(node: Option[TreeNode], parent: i64, graph: mut ref Map[i64, Vec[i64]]) {
    if let Some(n) = node {
        let v = n.val as i64;
        graph[v] = Vec.new();
        if parent > 0 {
            graph[v].push(parent);
            graph[parent].push(v);
        }
        graph_link(n.left, v, mut graph);
        graph_link(n.right, v, mut graph);
    }
}

fn graph_amount_of_time(root: Option[TreeNode], start: i64) -> i64 {
    let mut graph: Map[i64, Vec[i64]] = Map.new();
    graph_link(root, 0, mut graph);
    let mut seen: Set[i64] = Set.new();
    seen.insert(start);
    let mut frontier: Vec[i64] = [start].to_vec();
    let mut minutes = -1;
    while not frontier.is_empty() {
        minutes += 1;
        let mut next: Vec[i64] = Vec.new();
        for v in frontier.iter() {
            for w in graph[v].iter() {
                if not seen.contains(w) {
                    seen.insert(w);
                    next.push(w);
                }
            }
        }
        frontier = next;
    }
    minutes
}

// ---- parents (infect_parents.kara) ---------------------------------------

fn parents_record(node: Option[TreeNode], parent: Option[TreeNode], start: i64, parents: mut ref Map[i64, TreeNode], found: mut ref Option[TreeNode]) {
    if let Some(n) = node {
        if let Some(p) = parent {
            parents[n.val as i64] = p;
        }
        if n.val == start {
            *found = Some(n);
        }
        parents_record(n.left, Some(n), start, mut parents, mut found);
        parents_record(n.right, Some(n), start, mut parents, mut found);
    }
}

fn parents_farthest(node: TreeNode, came_from: i64, parents: Map[i64, TreeNode]) -> i64 {
    let mut deepest = 0;
    let v = node.val as i64;
    let mut next: Vec[TreeNode] = Vec.new();
    if let Some(l) = node.left {
        next.push(l);
    }
    if let Some(r) = node.right {
        next.push(r);
    }
    if let Some(p) = parents.get(v) {
        next.push(p);
    }
    for t in next.iter() {
        if t.val != came_from {
            deepest = deepest.max(1 + parents_farthest(t, v, parents));
        }
    }
    deepest
}

fn parents_amount_of_time(root: Option[TreeNode], start: i64) -> i64 {
    let mut parents: Map[i64, TreeNode] = Map.new();
    let mut found: Option[TreeNode] = None;
    parents_record(root, None, start, mut parents, mut found);
    parents_farthest(found.unwrap(), 0, parents)
}

// ---- stack (infect_stack.kara) -------------------------------------------

fn stack_amount_of_time(root: Option[TreeNode], start: i64) -> i64 {
    let mut order: Vec[TreeNode] = Vec.new();
    let mut parent: Vec[i64] = Vec.new();
    let mut stack: Vec[(TreeNode, i64)] = Vec.new();
    if let Some(r) = root {
        stack.push((r, -1));
    }
    while let Some((node, up)) = stack.pop() {
        let at = order.len();
        order.push(node);
        parent.push(up);
        if let Some(l) = node.left {
            stack.push((l, at));
        }
        if let Some(r) = node.right {
            stack.push((r, at));
        }
    }
    let n = order.len();
    // the tallest child's height, and the start's distance below each
    // node with the height of the child it is not under
    let mut tallest: Vec[i64] = Vec.filled(n, 0);
    let mut heights: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    let mut below: Vec[i64] = Vec.filled(n, -1);
    let mut below_child: Vec[i64] = Vec.filled(n, -1);
    let mut best = 0;
    for i in (0..n).rev() {
        let height = 1 + tallest[i];
        let mut distance = -1;
        if order[i].val == start {
            best = best.max(tallest[i]);
            distance = 0;
        } else if below[i] >= 0 {
            let mut other = 0;
            for k in 0..heights[i].len() {
                if k != below_child[i] {
                    other = other.max(heights[i][k]);
                }
            }
            best = best.max(below[i] + 1 + other);
            distance = below[i] + 1;
        }
        let p = parent[i];
        if p >= 0 {
            if distance >= 0 {
                below[p] = distance;
                below_child[p] = heights[p].len();
            }
            heights[p].push(height);
            tallest[p] = tallest[p].max(height);
        }
    }
    best
}

// ---- iter (infect_iter.kara) ---------------------------------------------

fn iter_edges(node: Option[TreeNode]) -> Vec[(i64, i64)] {
    match node {
        None => Vec.new(),
        Some(n) => {
            let v = n.val as i64;
            [n.left, n.right].iter().flat_map(|c| {
                let mut here: Vec[(i64, i64)] = match c {
                    Some(t) => [(v, t.val as i64), (t.val as i64, v)].to_vec(),
                    None => Vec.new(),
                };
                here.extend(iter_edges(c));
                here.into_iter()
            }).collect()
        },
    }
}

fn iter_amount_of_time(root: Option[TreeNode], start: i64) -> i64 {
    let graph: Map[i64, Vec[i64]] = iter_edges(root).iter().fold(Map.new(), |g: own Map[i64, Vec[i64]], (a, b)| {
        let mut g = g;
        let mut list = g.get(a).cloned().unwrap_or(Vec.new());
        list.push(b);
        g[a] = list;
        g
    });
    let mut seen: Set[i64] = [start].iter().collect();
    let mut frontier: Vec[i64] = [start].to_vec();
    let mut minutes = 0;
    loop {
        let next: Vec[i64] = frontier.iter().flat_map(|v| graph.get(v).cloned().unwrap_or(Vec.new()).into_iter()).filter(|w| seen.insert(w)).collect();
        if next.is_empty() {
            return minutes;
        }
        minutes += 1;
        frontier = next;
    }
}

// ---- solution (infect_solution.kara) -------------------------------------

struct Solution {}

fn solution_build(node: Option[TreeNode], parent: i32, graph: mut ref Map[i32, Vec[i32]]) {
    if let Some(n) = node {
        graph.entry(n.val).or_insert(Vec.new());
        if parent != -1 {
            graph.entry(n.val).or_insert(Vec.new()).push(parent);
            graph.entry(parent).or_insert(Vec.new()).push(n.val);
        }
        solution_build(n.left, n.val, mut graph);
        solution_build(n.right, n.val, mut graph);
    }
}

impl Solution {
    pub fn amount_of_time(root: Option[TreeNode], start: i32) -> i32 {
        let mut graph: Map[i32, Vec[i32]] = Map.new();
        solution_build(root, -1, mut graph);
        let mut seen = Set.new();
        seen.insert(start);
        let mut queue = VecDeque.new();
        queue.push_back(start);
        let mut minutes = -1;
        while not queue.is_empty() {
            minutes += 1;
            for _ in 0..queue.len() {
                let v = queue.pop_front().unwrap();
                for w in ref graph[v] {
                    if seen.insert(w) {
                        queue.push_back(w);
                    }
                }
            }
        }
        minutes
    }
}

fn solution_amount_of_time(root: Option[TreeNode], start: i64) -> i64 {
    Solution.amount_of_time(root, start as i32)
}
// ---- the differential -----------------------------------------------------

fn answer(arm: i64, root: Option[TreeNode], start: i64) -> i64 {
    match arm {
        0 => star_amount_of_time(root, start),
        1 => graph_amount_of_time(root, start),
        2 => parents_amount_of_time(root, start),
        3 => stack_amount_of_time(root, start),
        4 => iter_amount_of_time(root, start),
        _ => solution_amount_of_time(root, start),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` nodes with the values 1 to `n` in a random order, each after the
// first hung below a random earlier one, or one of the last two when
// `chain`, by a random side taken down until a free one is found
fn grow(n: i64, chain: bool, seed: mut ref i64) -> TreeNode {
    let mut values: Vec[i64] = (1..n + 1).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        values.swap(i, j);
    }
    let nodes: Vec[TreeNode] = values.iter().map(|v| leaf(v)).collect();
    for k in 1..n {
        let back = if chain { 1 + next_random(mut seed) % 2.min(k) } else { 1 + next_random(mut seed) % k };
        let mut at = nodes[k - back];
        loop {
            if next_random(mut seed) % 2 == 0 {
                match at.left {
                    Some(c) => at = c,
                    None => {
                        at.left = Some(nodes[k]);
                        break;
                    }
                }
            } else {
                match at.right {
                    Some(c) => at = c,
                    None => {
                        at.right = Some(nodes[k]);
                        break;
                    }
                }
            }
        }
    }
    nodes[0]
}

fn mirror(node: Option[TreeNode]) -> Option[TreeNode] {
    match node {
        None => None,
        Some(n) => Some(TreeNode { val: n.val, left: mirror(n.right), right: mirror(n.left) }),
    }
}

fn relabel(node: Option[TreeNode], n: i64) -> Option[TreeNode] {
    match node {
        None => None,
        Some(t) => Some(TreeNode { val: (n + 1 - t.val) as i32, left: relabel(t.left, n), right: relabel(t.right, n) }),
    }
}

fn depth(node: Option[TreeNode], start: i64, at: i64) -> i64 {
    match node {
        None => -1,
        Some(t) => {
            if t.val == start {
                return at;
            }
            let left = depth(t.left, start, at + 1);
            if left >= 0 { left } else { depth(t.right, start, at + 1) }
        }
    }
}

fn main() {
    let names = ["star", "graph", "parents", "stack", "iter", "solution"];
    let mut seed = 2385;
    let mut cases: Vec[(TreeNode, i64, i64)] = Vec.new();
    for c in 0..360 {
        let n = if c < 300 { 1 + next_random(mut seed) % 12 } else { 1 + next_random(mut seed) % 300 };
        let tree = grow(n, c >= 330, mut seed);
        cases.push((tree, n, 1 + next_random(mut seed) % n));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (tree, n, start) = cases[c];
        let root = Some(tree);
        let small = n <= 12;
        let truth = if small { minutes_literally(root, start) } else { 0 };
        if small {
            check = (check * 31 + truth) % 1000000007;
        }
        let deep = depth(root, start, 0);
        let mirrored = mirror(root);
        let relabelled = relabel(root, n);
        let raised = Some(TreeNode { val: (n + 1) as i32, left: root, right: None });
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, root, start)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == truth,
                value <= n - 1 and value >= deep,
                answer(arm, mirrored, start) == value,
                answer(arm, relabelled, n + 1 - start) == value,
                answer(arm, raised, start) == value.max(deep + 1),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
