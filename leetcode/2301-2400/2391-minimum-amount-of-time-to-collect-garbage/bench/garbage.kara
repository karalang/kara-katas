// LeetCode #2391: Minimum Amount of Time to Collect Garbage -- the bench,
// the ★ arm: the units counted once, each truck driven to the last house
// holding its kind by the travel's prefix sums.

fn garbage_collection(garbage: Vec[String], travel: Vec[i64]) -> i64 {
    let mut minutes = 0;
    let mut last = [0, 0, 0];
    for i in 0..garbage.len() {
        for b in garbage[i].bytes().iter() {
            minutes += 1;
            let kind = if b == b'M' {
                0
            } else if b == b'P' {
                1
            } else {
                2
            };
            last[kind] = i;
        }
    }
    let mut prefix: Vec[i64] = [0];
    for t in travel.iter() {
        prefix.push(prefix[prefix.len() - 1] + t);
    }
    for kind in 0..3 {
        minutes += prefix[last[kind]];
    }
    minutes
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 50 streets of 2000 houses of up to 10 units, travel up to 100; each
    // pass answers them all and folds every answer
    let mut seed = 2391;
    let mut streets: Vec[Vec[String]] = Vec.new();
    let mut roads: Vec[Vec[i64]] = Vec.new();
    for _ in 0..50 {
        streets.push((0..2000).map(|_| {
            let len = 1 + next_random(mut seed) % 10;
            let b: Vec[u8] = (0..len).map(|_| b"MPG"[next_random(mut seed) % 3]).collect();
            String.from_utf8(b).unwrap()
        }).collect());
        roads.push((1..2000).map(|_| 1 + next_random(mut seed) % 100).collect());
    }
    let mut check = 0;
    for p in 0..500 {
        for s in 0..50 {
            check = (check * 31 + garbage_collection(streets[s], roads[s]) + p) % 1000000007;
        }
    }
    println(f"500 passes over 50 streets of 2000 houses: checksum {check}");
}
