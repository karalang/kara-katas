// LeetCode #2331: Evaluate Boolean Binary Tree -- the differential. The
// six arms, against the statement read literally: the tree written out
// as a fully bracketed formula of `T`, `F`, `|` and `&`, and every
// innermost bracket, a pair of truths and an operator, rewritten to its
// truth by text replacement until one letter is left. 300 random full
// trees of depth up to 6; then 30 combs of depth up to 60, each node's
// other child a leaf; then 30 random trees of depth up to 10. Every case
// is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the tree under an AND with a true leaf, and under an OR with a
//     false leaf: the same answer both times
// P3  every node's children swapped: the same answer
// P4  every leaf flipped and every OR and AND swapped: the answer
//     flipped
// P5  the tree under an OR with a true leaf: true; under an AND with a
//     false leaf: false
// P6  each arm agrees with at least three of the other five

// LeetCode's TreeNode: an `i32` value and two children, with its `new`.
shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

impl TreeNode {
    fn new(val: i32) -> TreeNode {
        TreeNode { val: val, left: None, right: None }
    }
}

fn leaf(value: i64) -> Option[TreeNode] {
    Some(TreeNode.new(value as i32))
}

fn join(op: i64, left: Option[TreeNode], right: Option[TreeNode]) -> Option[TreeNode] {
    let node = TreeNode.new(op as i32);
    node.left = left;
    node.right = right;
    Some(node)
}

// ---- star (evaluate.kara) ------------------------------------------------

fn star_evaluate_tree(root: Option[TreeNode]) -> bool {
    let Some(node) = root else {
        return false;
    };
    match node.val {
        0 => false,
        1 => true,
        2 => star_evaluate_tree(node.left) or star_evaluate_tree(node.right),
        _ => star_evaluate_tree(node.left) and star_evaluate_tree(node.right),
    }
}

// ---- minmax (evaluate_minmax.kara) ---------------------------------------

fn minmax_value(node: TreeNode) -> i64 {
    let (Some(left), Some(right)) = (node.left, node.right) else {
        return node.val;
    };
    let (a, b) = (minmax_value(left), minmax_value(right));
    if node.val == 2 { max(a, b) } else { min(a, b) }
}

fn minmax_evaluate_tree(root: Option[TreeNode]) -> bool {
    match root {
        Some(node) => minmax_value(node) == 1,
        None => false,
    }
}

// ---- stack (evaluate_stack.kara) -----------------------------------------

fn stack_evaluate_tree(root: Option[TreeNode]) -> bool {
    let Some(top) = root else {
        return false;
    };
    let mut work: Vec[(TreeNode, bool)] = [(top, false)].to_vec();
    let mut results: Vec[bool] = Vec.new();
    while let Some((node, closing)) = work.pop() {
        if node.val < 2 {
            results.push(node.val == 1);
        } else if closing {
            let right = results.pop().unwrap();
            let left = results.pop().unwrap();
            results.push(if node.val == 2 { left or right } else { left and right });
        } else {
            work.push((node, true));
            if let Some(right) = node.right {
                work.push((right, false));
            }
            if let Some(left) = node.left {
                work.push((left, false));
            }
        }
    }
    results.pop().unwrap()
}

// ---- levels (evaluate_levels.kara) ---------------------------------------

fn levels_evaluate_tree(root: Option[TreeNode]) -> bool {
    let Some(top) = root else {
        return false;
    };
    let mut nodes: Vec[TreeNode] = [top].to_vec();
    let mut children: Vec[(i64, i64)] = Vec.new();
    let mut i = 0;
    while i < nodes.len() {
        let node = nodes[i].clone();
        match (node.left, node.right) {
            (Some(left), Some(right)) => {
                children.push((nodes.len(), nodes.len() + 1));
                nodes.push(left);
                nodes.push(right);
            }
            _ => children.push((-1, -1)),
        }
        i += 1;
    }
    let mut truth: Vec[bool] = Vec.filled(nodes.len(), false);
    for k in (0..nodes.len()).rev() {
        let (l, r) = children[k];
        truth[k] = match nodes[k].val {
            0 => false,
            1 => true,
            2 => truth[l] or truth[r],
            _ => truth[l] and truth[r],
        };
    }
    truth[0]
}

// ---- iter (evaluate_iter.kara) -------------------------------------------

fn iter_evaluate_tree(root: Option[TreeNode]) -> bool {
    let Some(node) = root else {
        return false;
    };
    let children: Vec[TreeNode] = [node.left, node.right].into_iter().filter_map(|child| child).collect();
    match node.val {
        0 => false,
        1 => true,
        2 => children.iter().map(|child| iter_evaluate_tree(Some(child))).any(|t| t),
        _ => children.iter().map(|child| iter_evaluate_tree(Some(child))).all(|t| t),
    }
}

// ---- solution (evaluate_solution.kara) -----------------------------------

impl Solution {
    pub fn evaluate_tree(root: Option[TreeNode]) -> bool {
        let node = root.unwrap();
        match node.val {
            0 => false,
            1 => true,
            2 => Solution.evaluate_tree(node.left.clone()) or Solution.evaluate_tree(node.right.clone()),
            _ => Solution.evaluate_tree(node.left.clone()) and Solution.evaluate_tree(node.right.clone()),
        }
    }
}

struct Solution {}

fn solution_evaluate_tree(root: Option[TreeNode]) -> bool {
    Solution.evaluate_tree(root)
}

// ---- the statement read literally ------------------------------------------

fn render(root: Option[TreeNode]) -> String {
    let Some(node) = root else {
        return "";
    };
    match node.val {
        0 => "F",
        1 => "T",
        2 => f"({render(node.left)}|{render(node.right)})",
        _ => f"({render(node.left)}&{render(node.right)})",
    }
}

fn literal(root: Option[TreeNode]) -> bool {
    let rules = [
        ("(T|T)", "T"), ("(T|F)", "T"), ("(F|T)", "T"), ("(F|F)", "F"),
        ("(T&T)", "T"), ("(T&F)", "F"), ("(F&T)", "F"), ("(F&F)", "F"),
    ];
    let mut formula = render(root);
    while formula.len() > 1 {
        for (from, to) in rules {
            formula = formula.replace(from, to);
        }
    }
    formula == "T"
}

fn answer(arm: i64, root: Option[TreeNode]) -> bool {
    match arm {
        0 => star_evaluate_tree(root),
        1 => minmax_evaluate_tree(root),
        2 => stack_evaluate_tree(root),
        3 => levels_evaluate_tree(root),
        4 => iter_evaluate_tree(root),
        _ => solution_evaluate_tree(root),
    }
}

// a fresh copy of the tree, each node's children swapped when `swap`,
// and every leaf flipped and OR and AND exchanged when `dual`
fn copy(root: Option[TreeNode], swap: bool, dual: bool) -> Option[TreeNode] {
    let Some(node) = root else {
        return None;
    };
    let value = node.val as i64;
    if value < 2 {
        return leaf(if dual { 1 - value } else { value });
    }
    let op = if dual { 5 - value } else { value };
    let left = copy(node.left, swap, dual);
    let right = copy(node.right, swap, dual);
    if swap { join(op, right, left) } else { join(op, left, right) }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a full binary tree: a leaf once `depth` runs out or one time in
// `stop`, otherwise an OR or an AND over two smaller trees; with `comb`
// one of the two is always a leaf
fn random_tree(seed: mut ref i64, depth: i64, stop: i64, comb: bool) -> Option[TreeNode] {
    if depth == 0 or next_random(mut seed) % stop == 0 {
        return leaf(next_random(mut seed) % 2);
    }
    let op = next_random(mut seed) % 2 + 2;
    let deep = random_tree(mut seed, depth - 1, stop, comb);
    let other = if comb { leaf(next_random(mut seed) % 2) } else { random_tree(mut seed, depth - 1, stop, comb) };
    if next_random(mut seed) % 2 == 0 { join(op, deep, other) } else { join(op, other, deep) }
}

fn main() {
    let names = ["star", "minmax", "stack", "levels", "iter", "solution"];
    let mut seed = 2331;
    let mut cases: Vec[Option[TreeNode]] = Vec.new();
    for c in 0..360 {
        if c < 300 {
            let depth = next_random(mut seed) % 7;
            cases.push(random_tree(mut seed, depth, 4, false));
        } else if c < 330 {
            let depth = next_random(mut seed) % 61;
            cases.push(random_tree(mut seed, depth, 1000, true));
        } else {
            let depth = next_random(mut seed) % 11;
            cases.push(random_tree(mut seed, depth, 5, false));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, root) in cases.iter().enumerate() {
        let truth = literal(root);
        check = (check * 3 + if truth { 1 } else { 2 }) % 1000000007;
        let got: Vec[bool] = (0..6).map(|arm| answer(arm, root)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, join(3, copy(root, false, false), leaf(1))) == value and answer(arm, join(2, leaf(0), copy(root, false, false))) == value,
                answer(arm, copy(root, true, false)) == value,
                answer(arm, copy(root, false, true)) == not value,
                answer(arm, join(2, copy(root, false, false), leaf(1))) and not answer(arm, join(3, leaf(0), copy(root, false, false))),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
