// LeetCode #2319: Check if Matrix Is X-Matrix -- LeetCode's Rust template
// as a Rust user fills it in, carried by `karac fix`: `i32` cells, a
// `usize` side, and nested loops with an early `return false`.

struct Solution {}

impl Solution {
    pub fn check_x_matrix(grid: Vec[Vec[i32]]) -> bool {
        let n = grid.len();
        for i in 0..n {
            for j in 0..n {
                if i == j or i + j == n - 1 {
                    if grid[i][j] == 0 {
                        return false;
                    }
                } else if grid[i][j] != 0 {
                    return false;
                }
            }
        }
        true
    }
}

fn check_x_matrix(grid: Vec[Vec[i64]]) -> bool {
    let rows: Vec[Vec[i32]] = grid.iter().map(|row| row.iter().map(|v| v as i32).collect()).collect();
    Solution.check_x_matrix(rows)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// an `n` by `n` X of values 1 to 10^5, then one cell in `slips` of the
// rest given the wrong kind of value: zero on a diagonal, a value off it
fn grid(seed: mut ref i64, n: i64, slips: i64) -> Vec[Vec[i64]] {
    let mut g: Vec[Vec[i64]] = Vec.new();
    for i in 0..n {
        let mut row: Vec[i64] = Vec.new();
        for j in 0..n {
            let on = i == j or i + j == n - 1;
            let slip = next_random(mut seed) % slips == 0;
            let value = next_random(mut seed) % 100000 + 1;
            row.push(if on != slip { value } else { 0 });
        }
        g.push(row);
    }
    g
}

fn main() {
    // LeetCode's two examples; then the smallest X, its centre zero, a
    // stray value beside the centre, and an X of 100 by 100 with and
    // without one stray value
    println(check_x_matrix([[2, 0, 0, 1].to_vec(), [0, 3, 1, 0].to_vec(), [0, 5, 2, 0].to_vec(), [4, 0, 0, 2].to_vec()].to_vec()));
    println(check_x_matrix([[5, 7, 0].to_vec(), [0, 3, 1].to_vec(), [0, 5, 0].to_vec()].to_vec()));
    println(check_x_matrix([[1, 0, 1].to_vec(), [0, 1, 0].to_vec(), [1, 0, 1].to_vec()].to_vec()));
    println(check_x_matrix([[1, 0, 1].to_vec(), [0, 0, 0].to_vec(), [1, 0, 1].to_vec()].to_vec()));
    println(check_x_matrix([[1, 0, 1].to_vec(), [0, 1, 1].to_vec(), [1, 0, 1].to_vec()].to_vec()));
    let mut seed = 2319;
    let mut big = grid(mut seed, 100, 1000000);
    println(check_x_matrix(big));
    big[37][50] = 9;
    println(check_x_matrix(big));
    // 2000 random grids of 3 to 8 by as many, each cell wrong one time
    // in 20 to 200
    let mut check = 0;
    let mut xs = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 6 + 3;
        let slips = next_random(mut seed) % 181 + 20;
        let is_x = check_x_matrix(grid(mut seed, n, slips));
        check = (check * 31 + if is_x { 2 } else { 1 }) % 1000000007;
        if is_x {
            xs += 1;
        }
    }
    println(f"2000 grids: checksum {check}, {xs} X-matrices");
}
