// LeetCode #2344: Minimum Deletions to Make Array Divisible -- iterators:
// the gcd by `fold`, the least value dividing it by `filter` and `min`,
// and the values below it by `filter` and `count`, all through `map` on
// the `Option`.

fn gcd(a: i64, b: i64) -> i64 {
    let mut (a, b) = (a, b);
    while b != 0 {
        a, b = b, a % b;
    }
    a
}

fn min_operations(nums: Vec[i64], nums_divide: Vec[i64]) -> i64 {
    let g = nums_divide.iter().fold(0, |g, x| gcd(g, x));
    nums.iter()
        .filter(|x| g % x == 0)
        .min()
        .map(|least| nums.iter().filter(|x| x < least).count())
        .unwrap_or(-1)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then 1 dividing anything, no value
    // dividing, 10^9 dividing itself after three deletions, and 2000
    // values against the multiples of 180
    println(f"{min_operations([2, 3, 2, 4, 3].to_vec(), [9, 6, 9, 3, 15].to_vec())}");
    println(f"{min_operations([4, 3, 6].to_vec(), [8, 2, 6, 10].to_vec())}");
    println(f"{min_operations([1].to_vec(), [1000000000].to_vec())}");
    println(f"{min_operations([7, 7, 7].to_vec(), [6].to_vec())}");
    println(f"{min_operations([1000000000, 999999999, 3, 7].to_vec(), [1000000000].to_vec())}");
    let nums: Vec[i64] = (0..2000).map(|i| (i * 7919) % 100000 + 11).collect();
    let nums_divide: Vec[i64] = (1..200).map(|x| x * 4 * 9 * 5).collect();
    println(f"{min_operations(nums, nums_divide)}");
    // 2000 random cases of 1 to 12 values up to 2 to 31, against 1 to 6
    // multiples of a base from 1 to 12
    let mut seed = 2344;
    let mut check = 0;
    let mut total = 0;
    let mut possible = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 12;
        let m = 1 + next_random(mut seed) % 6;
        let spread = 2 + next_random(mut seed) % 30;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(1 + next_random(mut seed) % spread);
        }
        let base = 1 + next_random(mut seed) % 12;
        let mut nums_divide: Vec[i64] = Vec.new();
        for _ in 0..m {
            nums_divide.push(base * (1 + next_random(mut seed) % 10));
        }
        let answer = min_operations(nums, nums_divide);
        check = (check * 31 + answer + 1) % 1000000007;
        total += answer;
        if answer >= 0 {
            possible += 1;
        }
    }
    println(f"2000 cases: checksum {check}, sum {total}, possible {possible}");
}
