// LeetCode #2344: Minimum Deletions to Make Array Divisible -- the bench,
// the ★ arm: the gcd of numsDivide, then nums sorted and scanned for the
// first value that divides it.

fn gcd(a: i64, b: i64) -> i64 {
    let mut (a, b) = (a, b);
    while b != 0 {
        a, b = b, a % b;
    }
    a
}

fn min_operations(nums: Vec[i64], nums_divide: Vec[i64]) -> i64 {
    let mut g = 0;
    for x in nums_divide {
        g = gcd(g, x);
    }
    let mut sorted = nums.clone();
    sorted.sort();
    for i in 0..sorted.len() {
        if g % sorted[i] == 0 {
            return i;
        }
    }
    -1
}

fn scrambled(index: i64) -> i64 {
    index * 2654435761 % 2147483647
}

fn main() {
    let mut cases: Vec[(Vec[i64], Vec[i64])] = Vec.new();
    for a in 0..10 {
        let nums: Vec[i64] = (0..100000).map(|i| scrambled(a * 100000 + i) % 1000000 + 1).collect();
        let base = nums[a * 7919 % 100000];
        let nums_divide: Vec[i64] = (0..10000).map(|i| base * (scrambled(a * 10000 + i + 7) % 1000 + 1)).collect();
        cases.push((nums, nums_divide));
    }
    let mut check = 0;
    for p in 0..20 {
        for (nums, nums_divide) in cases.iter() {
            check = (check * 31 + min_operations(nums, nums_divide) + p) % 1000000007;
        }
    }
    println(f"20 passes over 10 cases of 10^5 values against 10^4: checksum {check}");
}
