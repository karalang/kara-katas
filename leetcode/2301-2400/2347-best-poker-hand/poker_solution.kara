// LeetCode #2347: Best Poker Hand -- LeetCode's Rust template as a Rust
// user fills it in, carried by `karac fix`: a flush by `all` with a `|&s|`
// pattern, the ranks counted in a `[0; 14]` array through `r as usize`,
// and the largest count matched against the range pattern `3..`.

impl Solution {
    pub fn best_hand(ranks: Vec[i32], suits: Vec[char]) -> String {
        if suits.iter().all(|s| s == suits[0]) {
            return "Flush";
        }
        let mut cnt = [0; 14];
        for r in ref ranks {
            cnt[r as usize] += 1;
        }
        let m = *cnt.iter().max().unwrap();
        match m {
            3.. => "Three of a Kind",
            2 => String.from("Pair"),
            _ => "High Card",
        }
    }
}

struct Solution {}

fn best_hand(ranks: Vec[i64], suits: Vec[char]) -> String {
    let ranks: Vec[i32] = ranks.iter().map(|x| x as i32).collect();
    Solution.best_hand(ranks, suits)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn hand(ranks: Vec[i64], suits: String) -> String {
    best_hand(ranks, suits.chars().collect())
}

fn main() {
    // LeetCode's three examples; then a high card, a full house and two
    // pairs
    println(hand([13, 2, 3, 1, 9].to_vec(), "aaaaa"));
    println(hand([4, 4, 2, 4, 4].to_vec(), "daabc"));
    println(hand([10, 10, 2, 12, 9].to_vec(), "abcad"));
    println(hand([1, 5, 9, 12, 13].to_vec(), "abcda"));
    println(hand([7, 7, 7, 3, 3].to_vec(), "abcab"));
    println(hand([2, 2, 3, 3, 13].to_vec(), "abacd"));
    // 2000 random hands of five different cards, their suits drawn from
    // the first one to four letters and their ranks from the first five to
    // thirteen
    let names = ["Flush", "Three of a Kind", "Pair", "High Card"];
    let mut seed = 2347;
    let mut check = 0;
    let mut counts = [0, 0, 0, 0];
    for _ in 0..2000 {
        let suit_spread = 1 + next_random(mut seed) % 4;
        let rank_spread = 5 + next_random(mut seed) % 9;
        let mut ranks: Vec[i64] = Vec.new();
        let mut suits: Vec[char] = Vec.new();
        while ranks.len() < 5 {
            let r = 1 + next_random(mut seed) % rank_spread;
            let s = (97 + next_random(mut seed) % suit_spread) as u8 as char;
            let mut seen = false;
            for i in 0..ranks.len() {
                if ranks[i] == r and suits[i] == s {
                    seen = true;
                }
            }
            if not seen {
                ranks.push(r);
                suits.push(s);
            }
        }
        let answer = best_hand(ranks, suits);
        let mut k = 0;
        while names[k] != answer {
            k += 1;
        }
        check = (check * 31 + k + 1) % 1000000007;
        counts[k] += 1;
    }
    println(f"2000 hands: checksum {check}, flush {counts[0]}, three {counts[1]}, pair {counts[2]}, high card {counts[3]}");
}
