// LeetCode #2347: Best Poker Hand -- the bench, the ★ arm: a flush when
// every suit equals the first; otherwise the most cards of one rank,
// counted in a table of 14, names the hand.

fn best_hand(ranks: Vec[i64], suits: Vec[char]) -> String {
    let mut flush = true;
    for s in suits.iter() {
        if s != suits[0] {
            flush = false;
        }
    }
    if flush {
        return "Flush";
    }
    let mut count: Vec[i64] = Vec.filled(14, 0);
    let mut most = 0;
    for r in ranks {
        count[r] += 1;
        most = most.max(count[r]);
    }
    if most >= 3 {
        "Three of a Kind"
    } else if most == 2 {
        "Pair"
    } else {
        "High Card"
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // five different cards of 52, any card already in the hand drawn
    // again
    let mut seed = 2347;
    let mut hands: Vec[(Vec[i64], Vec[char])] = Vec.new();
    for _ in 0..100000 {
        let mut cards: Vec[i64] = Vec.new();
        while cards.len() < 5 {
            let card = next_random(mut seed) % 52;
            if not cards.contains(card) {
                cards.push(card);
            }
        }
        let ranks: Vec[i64] = cards.iter().map(|c| c % 13 + 1).collect();
        let suits: Vec[char] = cards.iter().map(|c| (97 + c / 13) as u8 as char).collect();
        hands.push((ranks, suits));
    }
    let mut check = 0;
    for p in 0..30 {
        for (ranks, suits) in hands.iter() {
            check = (check * 31 + best_hand(ranks, suits).len() + p) % 1000000007;
        }
    }
    println(f"30 passes over 10^5 hands: checksum {check}");
}
