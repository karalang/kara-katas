// LeetCode #2347: Best Poker Hand -- the differential. The six arms,
// against the statement read literally: a flush when all five suits are
// the same; otherwise three of a kind when some three cards share a rank,
// tried over every three places; otherwise a pair when some two do, over
// every two places; otherwise a high card. No table and no sorting. 300
// random hands of five different cards, their suits drawn from the first
// one to four letters and their ranks from the first five to thirteen;
// then 30 of one suit; then 30 of two ranks. Every hand is drawn before
// any arm answers.
//
// P1  the answer is the literal reading's
// P2  one of the four names, and "Flush" exactly when no suit differs
//     from the first
// P3  the cards reversed: the same answer
// P4  the second card's rank made the first card's, where their suits
//     differ: anything but "High Card"
// P5  the ranks made 1 to 5 and the suits kept: "Flush" when no suit
//     differs from the first, and otherwise "High Card"
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn hand_literally(ranks: Vec[i64], suits: Vec[char]) -> String {
    if suits[0] == suits[1] and suits[1] == suits[2] and suits[2] == suits[3] and suits[3] == suits[4] {
        return "Flush";
    }
    for i in 0..5 {
        for j in i + 1..5 {
            for k in j + 1..5 {
                if ranks[i] == ranks[j] and ranks[j] == ranks[k] {
                    return "Three of a Kind";
                }
            }
        }
    }
    for i in 0..5 {
        for j in i + 1..5 {
            if ranks[i] == ranks[j] {
                return "Pair";
            }
        }
    }
    "High Card"
}

// ---- star (poker.kara) ---------------------------------------------------

fn star_best_hand(ranks: Vec[i64], suits: Vec[char]) -> String {
    let mut flush = true;
    for s in suits.iter() {
        if s != suits[0] {
            flush = false;
        }
    }
    if flush {
        return "Flush";
    }
    let mut count: Vec[i64] = Vec.filled(14, 0);
    let mut most = 0;
    for r in ranks {
        count[r] += 1;
        most = most.max(count[r]);
    }
    if most >= 3 {
        "Three of a Kind"
    } else if most == 2 {
        "Pair"
    } else {
        "High Card"
    }
}

// ---- sorted (poker_sorted.kara) ------------------------------------------

fn sorted_best_hand(ranks: Vec[i64], suits: Vec[char]) -> String {
    let mut s = suits.clone();
    s.sort();
    if s[0] == s[s.len() - 1] {
        return "Flush";
    }
    let mut r = ranks.clone();
    r.sort();
    let mut longest = 1;
    let mut run = 1;
    for i in 1..r.len() {
        if r[i] == r[i - 1] {
            run += 1;
        } else {
            run = 1;
        }
        longest = longest.max(run);
    }
    match longest {
        1 => "High Card",
        2 => "Pair",
        _ => "Three of a Kind",
    }
}

// ---- map (poker_map.kara) ------------------------------------------------

fn map_best_hand(ranks: Vec[i64], suits: Vec[char]) -> String {
    let kinds: Set[char] = suits.iter().collect();
    if kinds.len() == 1 {
        return "Flush";
    }
    let mut count: Map[i64, i64] = Map.new();
    for r in ranks {
        count[r] = count.get(r).unwrap_or(0) + 1;
    }
    let most = count.values().max().unwrap();
    if most >= 3 {
        "Three of a Kind"
    } else if most >= 2 {
        "Pair"
    } else {
        "High Card"
    }
}

// ---- naive (poker_naive.kara) --------------------------------------------

fn naive_best_hand(ranks: Vec[i64], suits: Vec[char]) -> String {
    let mut flush = true;
    for i in 0..suits.len() {
        for j in i + 1..suits.len() {
            if suits[i] != suits[j] {
                flush = false;
            }
        }
    }
    if flush {
        return "Flush";
    }
    let mut most = 0;
    for i in 0..ranks.len() {
        let mut same = 0;
        for j in 0..ranks.len() {
            if ranks[j] == ranks[i] {
                same += 1;
            }
        }
        if same > most {
            most = same;
        }
    }
    if most >= 3 {
        return "Three of a Kind";
    }
    if most == 2 {
        return "Pair";
    }
    "High Card"
}

// ---- iter (poker_iter.kara) ----------------------------------------------

fn iter_best_hand(ranks: Vec[i64], suits: Vec[char]) -> String {
    if suits.iter().all(|s| s == suits[0]) {
        return "Flush";
    }
    let most = ranks.iter().map(|r| ranks.iter().filter(|x| x == r).count()).max().unwrap();
    match most {
        1 => "High Card",
        2 => "Pair",
        _ => "Three of a Kind",
    }
}

// ---- solution (poker_solution.kara) --------------------------------------

impl Solution {
    pub fn best_hand(ranks: Vec[i32], suits: Vec[char]) -> String {
        if suits.iter().all(|s| s == suits[0]) {
            return "Flush";
        }
        let mut cnt = [0; 14];
        for r in ref ranks {
            cnt[r as usize] += 1;
        }
        let m = *cnt.iter().max().unwrap();
        match m {
            3.. => "Three of a Kind",
            2 => String.from("Pair"),
            _ => "High Card",
        }
    }
}

struct Solution {}

fn solution_best_hand(ranks: Vec[i64], suits: Vec[char]) -> String {
    let ranks: Vec[i32] = ranks.iter().map(|x| x as i32).collect();
    Solution.best_hand(ranks, suits)
}

// ---- the checks -------------------------------------------------------------

fn answer(arm: i64, ranks: Vec[i64], suits: Vec[char]) -> String {
    match arm {
        0 => star_best_hand(ranks, suits),
        1 => sorted_best_hand(ranks, suits),
        2 => map_best_hand(ranks, suits),
        3 => naive_best_hand(ranks, suits),
        4 => iter_best_hand(ranks, suits),
        _ => solution_best_hand(ranks, suits),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "sorted", "map", "naive", "iter", "solution"];
    let hands = ["Flush", "Three of a Kind", "Pair", "High Card"];
    let mut seed = 2347;
    let mut cases: Vec[(Vec[i64], Vec[char])] = Vec.new();
    for c in 0..360 {
        let (suit_spread, rank_spread) = if c < 300 {
            (1 + next_random(mut seed) % 4, 5 + next_random(mut seed) % 9)
        } else if c < 330 {
            (1, 13)
        } else {
            (4, 2)
        };
        let mut ranks: Vec[i64] = Vec.new();
        let mut suits: Vec[char] = Vec.new();
        while ranks.len() < 5 {
            let r = 1 + next_random(mut seed) % rank_spread;
            let s = (97 + next_random(mut seed) % suit_spread) as u8 as char;
            let mut seen = false;
            for i in 0..ranks.len() {
                if ranks[i] == r and suits[i] == s {
                    seen = true;
                }
            }
            if not seen {
                ranks.push(r);
                suits.push(s);
            }
        }
        cases.push((ranks, suits));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (ranks, suits) = cases[c].clone();
        let truth = hand_literally(ranks, suits);
        let mut t = 0;
        while hands[t] != truth {
            t += 1;
        }
        check = (check * 31 + t + 1) % 1000000007;
        let one_suit = suits.iter().all(|s| s == suits[0]);
        let reversed_ranks: Vec[i64] = ranks.iter().rev().collect();
        let reversed_suits: Vec[char] = suits.iter().rev().collect();
        let mut paired = ranks.clone();
        paired[1] = ranks[0];
        let can_pair = suits[0] != suits[1];
        let spread: Vec[i64] = (1..6).collect();
        let plain = if one_suit { "Flush" } else { "High Card" };
        let got: Vec[String] = (0..6).map(|arm| answer(arm, ranks, suits)).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let named = hands.iter().any(|h| h == value);
            let verdicts = [
                value == truth,
                named and (value == "Flush") == one_suit,
                answer(arm, reversed_ranks, reversed_suits) == value,
                not can_pair or answer(arm, paired, suits) != "High Card",
                answer(arm, spread, suits) == plain,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
