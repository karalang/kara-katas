// LeetCode #2364: Count Number of Bad Pairs -- the bench, the ★ arm: each
// place's key nums[j] - j counted in a map as the places go by, the
// places before j with the same key its good pairs, and the bad pairs all
// n (n - 1) / 2 less the good ones.

fn count_bad_pairs(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut seen: Map[i64, i64] = Map.new();
    let mut good = 0;
    for j in 0..n {
        let key = nums[j] - j;
        let before = seen.get(key).unwrap_or(0);
        good += before;
        seen[key] = before + 1;
    }
    n * (n - 1) / 2 - good
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // array a: 10^5 values, each the place plus one of 4^a offsets (at
    // most 10^5) below 999 * 10^6, so the keys run from one to tens of
    // thousands
    let mut seed = 2364;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for a in 0..10 {
        let kinds = 1 << (2 * a);
        let offsets: Vec[i64] = (0..kinds.min(100000)).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 999000000).collect();
        let nums: Vec[i64] = (0..100000).map(|i| 1 + i + offsets[(next_random(mut seed) * 32768 + next_random(mut seed)) % offsets.len()]).collect();
        arrays.push(nums);
    }
    let mut check = 0;
    for p in 0..20 {
        for nums in arrays.iter() {
            check = (check * 31 + count_bad_pairs(nums) % 1000000007 + p) % 1000000007;
        }
    }
    println(f"20 passes over 10 arrays of 10^5 values: checksum {check}");
}
