// LeetCode #2364: Count Number of Bad Pairs -- divide and conquer, as
// merge sort: the keys nums[i] - i of each half sorted by recursion, the
// good pairs within each half counted there, and those that cross the
// middle counted while the two sorted halves are merged, each run of a
// key on the left times its run on the right. O(n log n).

fn good_pairs(keys: mut ref Vec[i64], lo: i64, hi: i64) -> i64 {
    if hi - lo < 2 {
        return 0;
    }
    let mid = (lo + hi) / 2;
    let mut good = good_pairs(mut keys, lo, mid) + good_pairs(mut keys, mid, hi);
    let mut merged: Vec[i64] = Vec.new();
    let mut i = lo;
    let mut j = mid;
    while i < mid or j < hi {
        if j == hi or (i < mid and keys[i] < keys[j]) {
            merged.push(keys[i]);
            i += 1;
        } else if i == mid or keys[j] < keys[i] {
            merged.push(keys[j]);
            j += 1;
        } else {
            let key = keys[i];
            let mut left = 0;
            while i < mid and keys[i] == key {
                merged.push(key);
                left += 1;
                i += 1;
            }
            let mut right = 0;
            while j < hi and keys[j] == key {
                merged.push(key);
                right += 1;
                j += 1;
            }
            good += left * right;
        }
    }
    for k in 0..merged.len() {
        keys[lo + k] = merged[k];
    }
    good
}

fn count_bad_pairs(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut keys: Vec[i64] = (0..n).map(|i| nums[i] - i).collect();
    n * (n - 1) / 2 - good_pairs(mut keys, 0, n)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one value; 10^5 places in a run rising by
    // one, every pair good; 10^5 equal values, every pair bad; 10^5 values
    // in four interleaved keys; then 2000 random arrays of 1 to 40
    // values, each the place plus a small offset or a random value up to
    // 10^9
    println(f"{count_bad_pairs([4, 1, 3, 3])}");
    println(f"{count_bad_pairs([1, 2, 3, 4, 5])}");
    println(f"{count_bad_pairs([7])}");
    let rising: Vec[i64] = (0..100000).map(|i| i + 1000).collect();
    println(f"{count_bad_pairs(rising)}");
    let flat: Vec[i64] = (0..100000).map(|_| 1000000000).collect();
    println(f"{count_bad_pairs(flat)}");
    let runs: Vec[i64] = (0..100000).map(|i| i + (i % 4) * 7).collect();
    println(f"{count_bad_pairs(runs)}");
    let mut seed = 2364;
    let mut check = 0;
    let mut none_bad = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 40;
        let spread = 1 + next_random(mut seed) % 6;
        let mut nums: Vec[i64] = Vec.new();
        for i in 0..n {
            nums.push(if next_random(mut seed) % 8 == 0 { 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 } else { 1 + i + next_random(mut seed) % spread });
        }
        let bad = count_bad_pairs(nums);
        check = (check * 31 + bad) % 1000000007;
        if bad == 0 {
            none_bad += 1;
        }
    }
    println(f"2000 arrays: checksum {check}, {none_bad} with no bad pair");
}
