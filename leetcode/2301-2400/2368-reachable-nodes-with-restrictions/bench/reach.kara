// LeetCode #2368: Reachable Nodes With Restrictions -- the bench, the ★
// arm: adjacency lists, the restricted nodes marked, and a breadth-first
// search from node 0 that never enters a marked node.

fn reachable_nodes(n: i64, edges: Vec[(i64, i64)], restricted: Vec[i64]) -> i64 {
    let mut next: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for (a, b) in edges.iter() {
        next[a].push(b);
        next[b].push(a);
    }
    let mut seen: Vec[bool] = Vec.filled(n, false);
    for r in restricted.iter() {
        seen[r] = true;
    }
    seen[0] = true;
    let mut queue: Vec[i64] = [0].to_vec();
    let mut head = 0;
    while head < queue.len() {
        let u = queue[head];
        head += 1;
        for v in next[u].iter() {
            if not seen[v] {
                seen[v] = true;
                queue.push(v);
            }
        }
    }
    queue.len()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // tree a: 10^5 nodes, node i joined to one of the 4^a nodes before it,
    // and each node but 0 restricted with a chance of 1 in 2^(a + 4)
    let n = 100000;
    let mut seed = 2368;
    let mut trees: Vec[(Vec[(i64, i64)], Vec[i64])] = Vec.new();
    let mut width = 1;
    for a in 0..10 {
        let edges: Vec[(i64, i64)] = (1..n).map(|i| (i - 1 - next_random(mut seed) % width.min(i), i)).collect();
        let restricted: Vec[i64] = (1..n).filter(|_| next_random(mut seed) % (16 << a) == 0).collect();
        trees.push((edges, restricted));
        width *= 4;
    }
    let mut check = 0;
    for p in 0..20 {
        for (edges, restricted) in trees.iter() {
            check = (check * 31 + reachable_nodes(n, edges, restricted) + p) % 1000000007;
        }
    }
    println(f"20 passes over 10 trees of 10^5 nodes: checksum {check}");
}
