// LeetCode #2368: Reachable Nodes With Restrictions -- LeetCode's Rust
// template, as Rust writes it, carried by karac fix. Adjacency lists of
// usize, the restricted nodes marked, and a breadth-first search through
// a VecDeque.

struct Solution {}

impl Solution {
    pub fn reachable_nodes(n: i32, edges: Vec[Vec[i32]], restricted: Vec[i32]) -> i32 {
        let n = n as i64;
        let mut adj: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
        for e in ref edges {
            let (a, b) = (e[0] as i64, e[1] as i64);
            adj[a].push(b);
            adj[b].push(a);
        }
        let mut seen = Vec.filled(n, false);
        for r in ref restricted {
            seen[r] = true;
        }
        seen[0] = true;
        let mut queue = VecDeque.new();
        queue.push_back(0);
        let mut count = 0;
        while let Some(u) = queue.pop_front() {
            count += 1;
            for v in ref adj[u] {
                if not seen[v] {
                    seen[v] = true;
                    queue.push_back(v);
                }
            }
        }
        count
    }
}

fn reachable_nodes(n: i64, edges: Vec[(i64, i64)], restricted: Vec[i64]) -> i64 {
    let edges: Vec[Vec[i32]] = edges.iter().map(|(a, b)| [a as i32, b as i32].to_vec()).collect();
    let restricted: Vec[i32] = restricted.iter().map(|r| r as i32).collect();
    Solution.reachable_nodes(n as i32, edges, restricted)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one node; a path of 10^5 nodes, open and
    // cut at its middle; a star of 10^5 nodes with every odd leaf
    // restricted; then 2000 random trees of 2 to 40 nodes, each node
    // joined to an earlier one, with up to n - 1 restricted nodes
    println(f"{reachable_nodes(7, [(0, 1), (1, 2), (3, 1), (4, 0), (0, 5), (5, 6)], [4, 5])}");
    println(f"{reachable_nodes(7, [(0, 1), (0, 2), (0, 5), (0, 4), (3, 2), (6, 5)], [4, 2, 1])}");
    println(f"{reachable_nodes(1, [], [])}");
    let n = 100000;
    let path: Vec[(i64, i64)] = (1..n).map(|i| (i - 1, i)).collect();
    println(f"{reachable_nodes(n, path, [])} {reachable_nodes(n, path, [n / 2])}");
    let star: Vec[(i64, i64)] = (1..n).map(|i| (i, 0)).collect();
    let odd: Vec[i64] = (1..n).filter(|i| i % 2 == 1).collect();
    println(f"{reachable_nodes(n, star, odd)}");
    let mut seed = 2368;
    let mut check = 0;
    let mut alone = 0;
    for _ in 0..2000 {
        let n = 2 + next_random(mut seed) % 39;
        let edges: Vec[(i64, i64)] = (1..n).map(|i| (next_random(mut seed) % i, i)).collect();
        let k = next_random(mut seed) % n;
        let restricted: Vec[i64] = (0..k).map(|_| 1 + next_random(mut seed) % (n - 1)).collect();
        let mut unique = restricted.clone();
        unique.sort();
        unique.dedup();
        let t = reachable_nodes(n, edges, unique);
        check = (check * 31 + t) % 1000000007;
        if t == 1 {
            alone += 1;
        }
    }
    println(f"2000 trees: checksum {check}, {alone} with node 0 alone");
}
