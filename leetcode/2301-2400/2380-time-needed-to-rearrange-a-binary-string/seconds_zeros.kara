// LeetCode #2380: Time Needed to Rearrange a Binary String -- the 0s
// from the right. Each second moves a 0 left past a 1 as surely as it
// moves the 1 right, so a 0 with o 1s after it needs at least o seconds,
// and one more than the 0 after it, which it cannot overtake; the first
// such 0 from the left finishes last. O(n).

fn seconds_to_remove_occurrences(s: String) -> i64 {
    let d = s.bytes();
    let mut ones = 0;
    let mut seconds = 0;
    for i in (0..d.len()).rev() {
        if d[i] == b'1' {
            ones += 1;
        } else if ones > 0 {
            seconds = (seconds + 1).max(ones);
        }
    }
    seconds
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one 0; 500 0s then 500 1s; 01 500 times;
    // 1s then 0s, 500 each; then 2000 random strings of 1 to 60 digits,
    // 1 with a chance of 0 to 10 in 10, with a checksum and how many take
    // no time
    println(f"{seconds_to_remove_occurrences("0110101")} {seconds_to_remove_occurrences("11100")}");
    println(f"{seconds_to_remove_occurrences("0")}");
    let ramp = String.from_utf8((0..1000).map(|i| if i < 500 { b'0' } else { b'1' }).collect()).unwrap();
    let pairs = String.from_utf8((0..1000).map(|i| if i % 2 == 0 { b'0' } else { b'1' }).collect()).unwrap();
    let sorted = String.from_utf8((0..1000).map(|i| if i < 500 { b'1' } else { b'0' }).collect()).unwrap();
    println(f"{seconds_to_remove_occurrences(ramp)} {seconds_to_remove_occurrences(pairs)} {seconds_to_remove_occurrences(sorted)}");
    let mut seed = 2380;
    let mut check = 0;
    let mut none = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 60;
        let chance = next_random(mut seed) % 11;
        let digits: Vec[u8] = (0..n).map(|_| if next_random(mut seed) % 10 < chance { b'1' } else { b'0' }).collect();
        let t = seconds_to_remove_occurrences(String.from_utf8(digits).unwrap());
        check = (check * 31 + t) % 1000000007;
        if t == 0 {
            none += 1;
        }
    }
    println(f"2000 strings: checksum {check}, {none} take no time");
}
