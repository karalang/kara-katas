// LeetCode #2353: Design a Food Rating System -- the bench, the ★ arm: lazy
// heaps, a map from each food to its rating and its cuisine, and for each
// cuisine a min-first `PriorityQueue` of (-rating, food) holding every key
// a food was ever given; a query pops the tops that are no longer true.

struct FoodRatings {
    rating: Map[String, i64],
    cuisine_of: Map[String, String],
    heaps: Map[String, PriorityQueue[(i64, String)]],
}

impl FoodRatings {
    fn new(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64]) -> FoodRatings {
        let mut table = FoodRatings { rating: Map.new(), cuisine_of: Map.new(), heaps: Map.new() };
        for i in 0..foods.len() {
            table.rating[foods[i].clone()] = ratings[i];
            table.cuisine_of[foods[i].clone()] = cuisines[i].clone();
            table.heaps.entry(cuisines[i].clone()).or_insert(PriorityQueue.new()).push((-ratings[i], foods[i].clone()));
        }
        table
    }

    fn change_rating(mut ref self, food: String, new_rating: i64) {
        self.rating[food.clone()] = new_rating;
        let cuisine = self.cuisine_of[food.clone()].clone();
        self.heaps[cuisine].push((-new_rating, food.clone()));
    }

    fn highest_rated(mut ref self, cuisine: String) -> String {
        loop {
            let (negated, food) = self.heaps[cuisine.clone()].peek().unwrap();
            if self.rating[food.clone()] == -negated {
                return food.clone();
            }
            self.heaps[cuisine.clone()].pop();
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Four letters naming `v`, below 26^4.
fn four_letters(v: i64) -> String {
    let letters = [v / 17576, v / 676 % 26, v / 26 % 26, v % 26];
    letters.iter().map(|x| (97 + x) as u8 as char).collect()
}

fn main() {
    // 10^4 foods of four letters over 100 cuisines, rated up to 10^8, then
    // 10^5 calls, two changes to every query, built once; each pass runs
    // them through a fresh system and folds every answer's letters and
    // the pass
    let mut seed = 2353;
    let n = 10000;
    let foods: Vec[String] = (0..n).map(|i| four_letters(i * 7919 % 456976)).collect();
    let cuisines: Vec[String] = (0..n).map(|_| f"c{next_random(mut seed) % 100}").collect();
    let ratings: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % 100000000).collect();
    let mut calls: Vec[(i64, String, i64)] = Vec.new();
    for i in 0..100000 {
        let f = next_random(mut seed) % n;
        if i % 3 == 2 {
            calls.push((1, cuisines[f].clone(), 0));
        } else {
            calls.push((0, foods[f].clone(), 1 + next_random(mut seed) % 100000000));
        }
    }
    let mut check = 0;
    for p in 0..100 {
        let mut table = FoodRatings.new(foods, cuisines, ratings);
        for (kind, name, rating) in calls.iter() {
            if kind == 0 {
                table.change_rating(name, rating);
            } else {
                for b in table.highest_rated(name).bytes().iter() {
                    check = (check * 31 + b) % 1000000007;
                }
                check = (check * 31 + p) % 1000000007;
            }
        }
    }
    println(f"100 passes over 10^4 foods and 10^5 calls: checksum {check}");
}
