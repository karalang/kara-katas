// LeetCode #2353: Design a Food Rating System -- sorted sets: a map from
// each food to its cuisine and rating, and for each cuisine a `SortedSet`
// of (-rating, food). A change takes the food's old pair out and puts the
// new one in; a query reads the set's least. O(log n) per call.

struct FoodRatings {
    info: Map[String, (String, i64)],
    ranked: Map[String, SortedSet[(i64, String)]],
}

impl FoodRatings {
    fn new(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64]) -> FoodRatings {
        let mut table = FoodRatings { info: Map.new(), ranked: Map.new() };
        for i in 0..foods.len() {
            table.info[foods[i].clone()] = (cuisines[i].clone(), ratings[i]);
            if not table.ranked.contains_key(cuisines[i]) {
                table.ranked[cuisines[i].clone()] = SortedSet.new();
            }
            table.ranked[cuisines[i].clone()].insert((-ratings[i], foods[i].clone()));
        }
        table
    }

    fn change_rating(mut ref self, food: String, new_rating: i64) {
        let (cuisine, old) = self.info[food.clone()].clone();
        self.ranked[cuisine.clone()].remove((-old, food.clone()));
        self.ranked[cuisine.clone()].insert((-new_rating, food.clone()));
        self.info[food.clone()] = (cuisine, new_rating);
    }

    fn highest_rated(self, cuisine: String) -> String {
        self.ranked[cuisine].min().unwrap().1.clone()
    }
}

fn run(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64], calls: Vec[(i64, String, i64)]) -> Vec[String] {
    let mut table = FoodRatings.new(foods, cuisines, ratings);
    let mut answers: Vec[String] = Vec.new();
    for (kind, name, rating) in calls.iter() {
        if kind == 0 {
            table.change_rating(name, rating);
        } else {
            answers.push(table.highest_rated(name));
        }
    }
    answers
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn tally(answers: Vec[String], check: i64) -> i64 {
    let mut check = check;
    for a in answers.iter() {
        for c in a.chars() {
            check = (check * 31 + c as i64) % 1000000007;
        }
        check = (check * 31 + 1) % 1000000007;
    }
    check
}

fn three_letters(v: i64) -> String {
    let letters = [v / 676, v / 26 % 26, v % 26];
    letters.iter().map(|x| (97 + x) as u8 as char).collect()
}

fn call(kind: i64, name: own String, rating: i64) -> (i64, String, i64) {
    (kind, name, rating)
}

fn main() {
    // LeetCode's example; three foods tied, the least name first; one food
    // raised past another and lowered back
    let answers = run(
        ["kimchi", "miso", "sushi", "moussaka", "ramen", "bulgogi"].to_vec(),
        ["korean", "japanese", "japanese", "greek", "japanese", "korean"].to_vec(),
        [9, 12, 8, 15, 14, 7].to_vec(),
        [call(1, "korean", 0), call(1, "japanese", 0), call(0, "sushi", 16), call(1, "japanese", 0), call(0, "ramen", 16), call(1, "japanese", 0)].to_vec(),
    );
    println(answers.join(" "));
    let answers = run(
        ["b", "ab", "a"].to_vec(),
        ["x", "x", "x"].to_vec(),
        [5, 5, 5].to_vec(),
        [call(1, "x", 0), call(0, "a", 4), call(1, "x", 0), call(0, "ab", 4), call(1, "x", 0)].to_vec(),
    );
    println(answers.join(" "));
    let answers = run(
        ["pie", "tart"].to_vec(),
        ["sweet", "sweet"].to_vec(),
        [100000000, 1].to_vec(),
        [call(1, "sweet", 0), call(0, "tart", 100000000), call(1, "sweet", 0), call(0, "pie", 1), call(1, "sweet", 0), call(0, "pie", 100000000), call(1, "sweet", 0)].to_vec(),
    );
    println(answers.join(" "));
    // 500 foods over 20 cuisines, then 2 * 10^4 calls, two changes to every
    // query
    let foods: Vec[String] = (0..500).map(|i| three_letters(i * 7919 % 1000)).collect();
    let cuisines: Vec[String] = (0..500).map(|i| f"c{(97 + i % 20) as u8 as char}").collect();
    let ratings: Vec[i64] = (0..500).map(|i| i * 37 % 100 + 1).collect();
    let mut calls: Vec[(i64, String, i64)] = Vec.new();
    for i in 0..20000 {
        if i % 3 == 2 {
            calls.push((1, f"c{(97 + i % 20) as u8 as char}", 0));
        } else {
            calls.push((0, foods[i * 13 % 500].clone(), i * 7 % 100 + 1));
        }
    }
    let answers = run(foods, cuisines, ratings, calls);
    let letters: i64 = answers.iter().map(|a| a.len()).sum();
    println(f"2 * 10^4 calls: checksum {tally(answers, 0)}, letters {letters}");
    // 2000 random scripts: 1 to 8 foods of 1 to 3 letters from a to c over
    // cuisines x, y and z, rated 1 to 4, then 1 to 40 calls, three changes
    // to every two queries
    let mut seed = 2353;
    let mut check = 0;
    let mut letters = 0;
    let mut firsts = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 8;
        let mut foods: Vec[String] = Vec.new();
        while foods.len() < n {
            let length = 1 + next_random(mut seed) % 3;
            let name: String = (0..length).map(|_| (97 + next_random(mut seed) % 3) as u8 as char).collect();
            if not foods.contains(name) {
                foods.push(name);
            }
        }
        let cuisines: Vec[String] = (0..n).map(|_| f"{(120 + next_random(mut seed) % 3) as u8 as char}").collect();
        let ratings: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % 4).collect();
        let mut calls: Vec[(i64, String, i64)] = Vec.new();
        let count = 1 + next_random(mut seed) % 40;
        for _ in 0..count {
            if next_random(mut seed) % 5 < 3 {
                let food = foods[next_random(mut seed) % n].clone();
                calls.push((0, food, 1 + next_random(mut seed) % 4));
            } else {
                calls.push((1, cuisines[next_random(mut seed) % n].clone(), 0));
            }
        }
        let first = foods[0].clone();
        let answers = run(foods, cuisines, ratings, calls);
        check = tally(answers, check);
        letters += answers.iter().map(|a| a.len()).sum();
        firsts += answers.iter().filter(|a| a == first).count();
    }
    println(f"2000 scripts: checksum {check}, letters {letters}, the first food {firsts}");
}
