// LeetCode #2353: Design a Food Rating System -- the differential. The six
// arms, against the statement read literally: no table is kept at all,
// only the calls so far. A query takes each food of the cuisine, reads its
// rating back as that of the latest change that names it or else its first
// one, and keeps the highest, the least name among equals. 300 random
// scripts of 1 to 8 foods of 1 to 3 letters from a to c over cuisines x, y
// and z, rated 1 to 4, then 1 to 20 calls, three changes to every two
// queries; then 30 of up to 60 foods of 1 to 6 letters rated up to 10^8
// and 300 calls; then 30 of up to 30 foods rated 1 or 2 and 300 calls.
// Every script is drawn before any arm answers.
//
// P1  up to 20 calls, the answers are the literal reading's
// P2  one answer to each query, each a food of the cuisine asked for
// P3  every rating r made 2 r + 5, at the start and in the changes: the
//     same answers
// P4  every food's name given a leading q: every answer given it too
// P5  every query made twice in a row: each answer twice
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn answers_literally(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64], calls: Vec[(i64, String, i64)]) -> Vec[String] {
    let mut answers: Vec[String] = Vec.new();
    for c in 0..calls.len() {
        if calls[c].0 == 0 {
            continue;
        }
        let mut best = -1;
        let mut best_rating = 0;
        for f in 0..foods.len() {
            if cuisines[f] != calls[c].1 {
                continue;
            }
            let mut rating = ratings[f];
            for d in 0..c {
                if calls[d].0 == 0 and calls[d].1 == foods[f] {
                    rating = calls[d].2;
                }
            }
            if best < 0 or rating > best_rating or (rating == best_rating and foods[f] < foods[best]) {
                best = f;
                best_rating = rating;
            }
        }
        answers.push(foods[best].clone());
    }
    answers
}

// ---- star (ratings.kara) -------------------------------------------------

struct StarFoodRatings {
    rating: Map[String, i64],
    cuisine_of: Map[String, String],
    heaps: Map[String, PriorityQueue[(i64, String)]],
}

impl StarFoodRatings {
    fn new(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64]) -> StarFoodRatings {
        let mut table = StarFoodRatings { rating: Map.new(), cuisine_of: Map.new(), heaps: Map.new() };
        for i in 0..foods.len() {
            table.rating[foods[i].clone()] = ratings[i];
            table.cuisine_of[foods[i].clone()] = cuisines[i].clone();
            table.heaps.entry(cuisines[i].clone()).or_insert(PriorityQueue.new()).push((-ratings[i], foods[i].clone()));
        }
        table
    }

    fn change_rating(mut ref self, food: String, new_rating: i64) {
        self.rating[food.clone()] = new_rating;
        let cuisine = self.cuisine_of[food.clone()].clone();
        self.heaps[cuisine].push((-new_rating, food.clone()));
    }

    fn highest_rated(mut ref self, cuisine: String) -> String {
        loop {
            let (negated, food) = self.heaps[cuisine.clone()].peek().unwrap();
            if self.rating[food.clone()] == -negated {
                return food.clone();
            }
            self.heaps[cuisine.clone()].pop();
        }
    }
}

fn star_run(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64], calls: Vec[(i64, String, i64)]) -> Vec[String] {
    let mut table = StarFoodRatings.new(foods, cuisines, ratings);
    let mut answers: Vec[String] = Vec.new();
    for (kind, name, rating) in calls.iter() {
        if kind == 0 {
            table.change_rating(name, rating);
        } else {
            answers.push(table.highest_rated(name));
        }
    }
    answers
}

// ---- set (ratings_set.kara) ----------------------------------------------

struct SetFoodRatings {
    info: Map[String, (String, i64)],
    ranked: Map[String, SortedSet[(i64, String)]],
}

impl SetFoodRatings {
    fn new(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64]) -> SetFoodRatings {
        let mut table = SetFoodRatings { info: Map.new(), ranked: Map.new() };
        for i in 0..foods.len() {
            table.info[foods[i].clone()] = (cuisines[i].clone(), ratings[i]);
            if not table.ranked.contains_key(cuisines[i]) {
                table.ranked[cuisines[i].clone()] = SortedSet.new();
            }
            table.ranked[cuisines[i].clone()].insert((-ratings[i], foods[i].clone()));
        }
        table
    }

    fn change_rating(mut ref self, food: String, new_rating: i64) {
        let (cuisine, old) = self.info[food.clone()].clone();
        self.ranked[cuisine.clone()].remove((-old, food.clone()));
        self.ranked[cuisine.clone()].insert((-new_rating, food.clone()));
        self.info[food.clone()] = (cuisine, new_rating);
    }

    fn highest_rated(self, cuisine: String) -> String {
        self.ranked[cuisine].min().unwrap().1.clone()
    }
}

fn set_run(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64], calls: Vec[(i64, String, i64)]) -> Vec[String] {
    let mut table = SetFoodRatings.new(foods, cuisines, ratings);
    let mut answers: Vec[String] = Vec.new();
    for (kind, name, rating) in calls.iter() {
        if kind == 0 {
            table.change_rating(name, rating);
        } else {
            answers.push(table.highest_rated(name));
        }
    }
    answers
}

// ---- naive (ratings_naive.kara) ------------------------------------------

struct NaiveFoodRatings {
    foods: Vec[String],
    cuisines: Vec[String],
    ratings: Vec[i64],
    place: Map[String, i64],
}

impl NaiveFoodRatings {
    fn new(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64]) -> NaiveFoodRatings {
        let mut place: Map[String, i64] = Map.new();
        for i in 0..foods.len() {
            place[foods[i].clone()] = i;
        }
        NaiveFoodRatings { foods: foods.clone(), cuisines: cuisines.clone(), ratings: ratings.clone(), place }
    }

    fn change_rating(mut ref self, food: String, new_rating: i64) {
        let i = self.place[food];
        self.ratings[i] = new_rating;
    }

    fn highest_rated(self, cuisine: String) -> String {
        let mut best = -1;
        for i in 0..self.foods.len() {
            if self.cuisines[i] == cuisine {
                if best < 0 or self.ratings[i] > self.ratings[best] or (self.ratings[i] == self.ratings[best] and self.foods[i] < self.foods[best]) {
                    best = i;
                }
            }
        }
        self.foods[best].clone()
    }
}

fn naive_run(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64], calls: Vec[(i64, String, i64)]) -> Vec[String] {
    let mut table = NaiveFoodRatings.new(foods, cuisines, ratings);
    let mut answers: Vec[String] = Vec.new();
    for (kind, name, rating) in calls.iter() {
        if kind == 0 {
            table.change_rating(name, rating);
        } else {
            answers.push(table.highest_rated(name));
        }
    }
    answers
}

// ---- buckets (ratings_buckets.kara) --------------------------------------

struct BucketsFoodRatings {
    info: Map[String, (String, i64)],
    buckets: Map[String, SortedMap[i64, SortedSet[String]]],
}

impl BucketsFoodRatings {
    fn new(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64]) -> BucketsFoodRatings {
        let mut table = BucketsFoodRatings { info: Map.new(), buckets: Map.new() };
        for i in 0..foods.len() {
            table.info[foods[i].clone()] = (cuisines[i].clone(), ratings[i]);
            table.put(cuisines[i], ratings[i], foods[i]);
        }
        table
    }

    fn put(mut ref self, cuisine: String, rating: i64, food: String) {
        let by_rating = self.buckets.entry(cuisine.clone()).or_insert(SortedMap.new());
        by_rating.entry(rating).or_insert(SortedSet.new()).insert(food.clone());
    }

    fn change_rating(mut ref self, food: String, new_rating: i64) {
        let (cuisine, old) = self.info[food.clone()].clone();
        let by_rating = self.buckets.entry(cuisine.clone()).or_insert(SortedMap.new());
        by_rating.entry(old).or_insert(SortedSet.new()).remove(food.clone());
        if by_rating[old].is_empty() {
            by_rating.remove(old);
        }
        self.put(cuisine, new_rating, food);
        self.info[food.clone()] = (cuisine, new_rating);
    }

    fn highest_rated(self, cuisine: String) -> String {
        let (_, names) = self.buckets[cuisine].last().unwrap();
        names.min().unwrap().clone()
    }
}

fn buckets_run(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64], calls: Vec[(i64, String, i64)]) -> Vec[String] {
    let mut table = BucketsFoodRatings.new(foods, cuisines, ratings);
    let mut answers: Vec[String] = Vec.new();
    for (kind, name, rating) in calls.iter() {
        if kind == 0 {
            table.change_rating(name, rating);
        } else {
            answers.push(table.highest_rated(name));
        }
    }
    answers
}

// ---- iter (ratings_iter.kara) --------------------------------------------

struct IterFoodRatings {
    info: Map[String, (String, i64)],
}

impl IterFoodRatings {
    fn new(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64]) -> IterFoodRatings {
        let info: Map[String, (String, i64)] = (0..foods.len())
            .map(|i| (foods[i].clone(), (cuisines[i].clone(), ratings[i])))
            .collect();
        IterFoodRatings { info }
    }

    fn change_rating(mut ref self, food: String, new_rating: i64) {
        let cuisine = self.info[food.clone()].0.clone();
        self.info[food.clone()] = (cuisine, new_rating);
    }

    fn highest_rated(self, cuisine: String) -> String {
        self.info
            .iter()
            .filter(|(_, (c, _))| c == cuisine)
            .min_by_key(|(food, (_, rating))| (-rating, food.clone()))
            .map(|(food, _)| food.clone())
            .unwrap()
    }
}

fn iter_run(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64], calls: Vec[(i64, String, i64)]) -> Vec[String] {
    let mut table = IterFoodRatings.new(foods, cuisines, ratings);
    let mut answers: Vec[String] = Vec.new();
    for (kind, name, rating) in calls.iter() {
        if kind == 0 {
            table.change_rating(name, rating);
        } else {
            answers.push(table.highest_rated(name));
        }
    }
    answers
}

// ---- solution (ratings_solution.kara) ------------------------------------

struct SolutionFoodRatings {
    info: Map[String, (String, i32)],
    ranked: Map[String, SortedSet[(i32, String)]],
}

impl SolutionFoodRatings {
    fn new(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i32]) -> Self {
        let mut info = Map.new();
        let mut ranked: Map[String, SortedSet[(i32, String)]] = Map.new();
        for i in 0..foods.len() {
            info.insert(foods[i].clone(), (cuisines[i].clone(), ratings[i]));
            ranked.entry(cuisines[i].clone()).or_insert(SortedSet.new()).insert((-ratings[i], foods[i].clone()));
        }
        SolutionFoodRatings { info, ranked }
    }

    fn change_rating(mut ref self, food: String, new_rating: i32) {
        let (cuisine, old) = self.info.get_mut(food).unwrap();
        let set = self.ranked.get_mut(cuisine).unwrap();
        set.remove((-old, food.clone()));
        set.insert((-new_rating, food.clone()));
        old = new_rating;
    }

    fn highest_rated(self, cuisine: String) -> String {
        self.ranked[cuisine].iter().next().unwrap().1.clone()
    }
}

fn solution_run(foods: Vec[String], cuisines: Vec[String], ratings: Vec[i64], calls: Vec[(i64, String, i64)]) -> Vec[String] {
    let ratings: Vec[i32] = ratings.iter().map(|x| x as i32).collect();
    let mut table = SolutionFoodRatings.new(foods, cuisines, ratings);
    let mut answers: Vec[String] = Vec.new();
    for (kind, name, rating) in calls.iter() {
        if kind == 0 {
            table.change_rating(name, rating as i32);
        } else {
            answers.push(table.highest_rated(name));
        }
    }
    answers
}

// ---- the checks -------------------------------------------------------------

fn answer(arm: i64, script: (Vec[String], Vec[String], Vec[i64], Vec[(i64, String, i64)])) -> Vec[String] {
    let (foods, cuisines, ratings, calls) = script.clone();
    match arm {
        0 => star_run(foods, cuisines, ratings, calls),
        1 => set_run(foods, cuisines, ratings, calls),
        2 => naive_run(foods, cuisines, ratings, calls),
        3 => buckets_run(foods, cuisines, ratings, calls),
        4 => iter_run(foods, cuisines, ratings, calls),
        _ => solution_run(foods, cuisines, ratings, calls),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn tally(answers: Vec[String], check: i64) -> i64 {
    let mut check = check;
    for a in answers.iter() {
        for c in a.chars() {
            check = (check * 31 + c as i64) % 1000000007;
        }
        check = (check * 31 + 1) % 1000000007;
    }
    check
}

fn main() {
    let names = ["star", "set", "naive", "buckets", "iter", "solution"];
    let mut seed = 2353;
    let mut cases: Vec[(Vec[String], Vec[String], Vec[i64], Vec[(i64, String, i64)])] = Vec.new();
    for c in 0..360 {
        let (most_foods, most_letters, alphabet, top, most_calls) = if c < 300 {
            (8, 3, 3, 4, 20)
        } else if c < 330 {
            (60, 6, 26, 100000000, 300)
        } else {
            (30, 3, 3, 2, 300)
        };
        let n = 1 + next_random(mut seed) % most_foods;
        let mut foods: Vec[String] = Vec.new();
        while foods.len() < n {
            let length = 1 + next_random(mut seed) % most_letters;
            let name: String = (0..length).map(|_| (97 + next_random(mut seed) % alphabet) as u8 as char).collect();
            if not foods.contains(name) {
                foods.push(name);
            }
        }
        let cuisines: Vec[String] = (0..n).map(|_| f"{(120 + next_random(mut seed) % 3) as u8 as char}").collect();
        let ratings: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % top).collect();
        let mut calls: Vec[(i64, String, i64)] = Vec.new();
        let count = 1 + next_random(mut seed) % most_calls;
        for _ in 0..count {
            if next_random(mut seed) % 5 < 3 {
                let food = foods[next_random(mut seed) % n].clone();
                calls.push((0, food, 1 + next_random(mut seed) % top));
            } else {
                calls.push((1, cuisines[next_random(mut seed) % n].clone(), 0));
            }
        }
        cases.push((foods, cuisines, ratings, calls));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (foods, cuisines, ratings, calls) = cases[c].clone();
        let small = calls.len() <= 20;
        let truth = if small { answers_literally(foods, cuisines, ratings, calls) } else { Vec.new() };
        if small {
            check = tally(truth, check);
        }
        let queries: Vec[String] = calls.iter().filter(|call| call.0 == 1).map(|call| call.1.clone()).collect();
        let raised = (foods.clone(), cuisines.clone(), ratings.iter().map(|r| 2 * r + 5).collect(), calls.iter().map(|(k, name, r)| (k, name.clone(), if k == 0 { 2 * r + 5 } else { r })).collect());
        let named = (foods.iter().map(|f| f"q{f}").collect(), cuisines.clone(), ratings.clone(), calls.iter().map(|(k, name, r)| (k, if k == 0 { f"q{name}" } else { name.clone() }, r)).collect());
        let mut twice: Vec[(i64, String, i64)] = Vec.new();
        for call in calls.iter() {
            twice.push(call.clone());
            if call.0 == 1 {
                twice.push(call.clone());
            }
        }
        let doubled = (foods.clone(), cuisines.clone(), ratings.clone(), twice);
        let got: Vec[Vec[String]] = (0..6).map(|arm| answer(arm, cases[c])).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let mut fits = value.len() == queries.len();
            if fits {
                for q in 0..value.len() {
                    let mut found = false;
                    for f in 0..foods.len() {
                        if foods[f] == value[q] and cuisines[f] == queries[q] {
                            found = true;
                        }
                    }
                    if not found {
                        fits = false;
                    }
                }
            }
            let prefixed: Vec[String] = value.iter().map(|a| f"q{a}").collect();
            let repeated: Vec[String] = value.iter().flat_map(|a| [a.clone(), a.clone()].into_iter()).collect();
            let verdicts = [
                not small or value == truth,
                fits,
                answer(arm, raised) == value,
                answer(arm, named) == prefixed,
                answer(arm, doubled) == repeated,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value.join(" ")}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
