// LeetCode #2351: First Letter to Appear Twice -- a bit mask: bit i of one
// `i64` set once letter i has appeared, tested and set with shifts. O(n).

fn repeated_character(s: String) -> char {
    let mut mask = 0;
    for c in s.chars() {
        let bit = 1 << (c as i64 - 'a' as i64);
        if mask & bit != 0 {
            return c;
        }
        mask |= bit;
    }
    ' '
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then two letters, the alphabet then its
    // first letter, the alphabet backwards then m, and 100 letters
    println(f"{repeated_character("abccbaacz")}");
    println(f"{repeated_character("abcdd")}");
    println(f"{repeated_character("aa")}");
    println(f"{repeated_character("abcdefghijklmnopqrstuvwxyza")}");
    println(f"{repeated_character("zyxwvutsrqponmlkjihgfedcbam")}");
    let hundred: String = (0..100).map(|i| (97 + i * 7 % 26) as u8 as char).collect();
    println(f"{repeated_character(hundred)}");
    // 2000 random strings of 2 to 30 letters from the first 2 to 26 of the
    // alphabet; one with no letter twice gets a copy of one of its letters
    let mut seed = 2351;
    let mut check = 0;
    let mut counts: Vec[i64] = Vec.filled(26, 0);
    for _ in 0..2000 {
        let n = 2 + next_random(mut seed) % 29;
        let alphabet = 2 + next_random(mut seed) % 25;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % alphabet) as u8 as char);
        }
        let distinct: Set[char] = s.chars().collect();
        if distinct.len() == s.len() {
            let c = s.chars().nth(next_random(mut seed) % s.len()).unwrap();
            s.push(c);
        }
        let c = repeated_character(s);
        check = (check * 31 + c as i64) % 1000000007;
        counts[c as i64 - 97] += 1;
    }
    println(f"2000 strings: checksum {check}, a {counts[0]}, b {counts[1]}, z {counts[25]}");
}
