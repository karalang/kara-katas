// LeetCode #2351: First Letter to Appear Twice -- the bench, the ★ arm: a
// table of 26 marks, one per letter, the first letter already marked is
// the answer.

fn repeated_character(s: String) -> char {
    let mut seen: Vec[bool] = Vec.filled(26, false);
    for c in s.chars() {
        let i = c as i64 - 'a' as i64;
        if seen[i] {
            return c;
        }
        seen[i] = true;
    }
    ' '
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // string t is the first 2 to 26 letters of the alphabet shuffled, then
    // one of them again
    let mut seed = 2351;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..100000 {
        let k = 2 + next_random(mut seed) % 25;
        let mut letters: Vec[char] = (0..k).map(|i| (97 + i) as u8 as char).collect();
        for i in (1..k).rev() {
            let j = next_random(mut seed) % (i + 1);
            letters.swap(i, j);
        }
        letters.push(letters[next_random(mut seed) % k]);
        strings.push(letters.iter().collect());
    }
    let mut check = 0;
    for p in 0..50 {
        for s in strings.iter() {
            check = (check * 31 + repeated_character(s) as i64 + p) % 1000000007;
        }
    }
    println(f"50 passes over 10^5 strings: checksum {check}");
}
