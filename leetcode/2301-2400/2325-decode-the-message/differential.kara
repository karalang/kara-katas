// LeetCode #2325: Decode the Message -- the differential. The six arms,
// against the statement read literally: the first appearance of each
// letter in the key, found by checking the key before it, makes the
// substitution table, kept as a list of pairs of the key's letter and
// the alphabet's; each letter of the message is looked up in the list,
// and a space stays a space. 300 random keys and messages as in the
// harness; then 30 keys where most letters come round again and spaces
// are common; then 30 with the alphabet in order and messages of 200.
// Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the answer is as long as the message, with spaces where it has
//     them and letters everywhere else
// P3  the key with its spaces taken out: the same answer
// P4  the key followed by a space and the key again: the same answer
// P5  every letter of the key and the message moved 7 on in the
//     alphabet, wrapping: the same answer
// P6  each arm agrees with at least three of the other five

// ---- decode.kara
fn star_decode_message(key: String, message: String) -> String {
    let mut table = [0u8; 26];
    let mut next = b'a';
    for b in key.bytes() {
        if b != b' ' and table[b - b'a'] == 0 {
            table[b - b'a'] = next;
            next += 1;
        }
    }
    let mut decoded = String.new();
    for b in message.bytes() {
        decoded.push(if b == b' ' { ' ' } else { table[b - b'a'] as char });
    }
    decoded
}

// ---- decode_naive.kara
fn naive_decode_message(key: String, message: String) -> String {
    let k: Vec[char] = key.chars().collect();
    let mut decoded = String.new();
    for c in message.chars() {
        if c == ' ' {
            decoded.push(' ');
            continue;
        }
        let mut distinct = 0;
        for i in 0..k.len() {
            if k[i] == ' ' {
                continue;
            }
            let mut first = true;
            for j in 0..i {
                if k[j] == k[i] {
                    first = false;
                }
            }
            if k[i] == c {
                break;
            }
            if first {
                distinct += 1;
            }
        }
        decoded.push((b'a' + distinct as u8) as char);
    }
    decoded
}

// ---- decode_map.kara
fn map_decode_message(key: String, message: String) -> String {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut table: Map[char, char] = Map.new();
    for c in key.chars() {
        if c != ' ' and not table.contains_key(c) {
            let next = alphabet[table.len()];
            table.insert(c, next);
        }
    }
    let mut decoded = String.new();
    for c in message.chars() {
        decoded.push(match table.get(c) {
            Some(d) => d,
            None => ' ',
        });
    }
    decoded
}

// ---- decode_order.kara
fn order_decode_message(key: String, message: String) -> String {
    let mut order = String.new();
    for c in key.chars() {
        if c != ' ' and not order.contains(c.to_string()) {
            order.push(c);
        }
    }
    let mut decoded = String.new();
    for c in message.chars() {
        if c == ' ' {
            decoded.push(' ');
        } else {
            let place = order.find(c.to_string()).unwrap();
            decoded.push((b'a' + place as u8) as char);
        }
    }
    decoded
}

// ---- decode_iter.kara
fn iter_decode_message(key: String, message: String) -> String {
    let order: Vec[char] = key.chars().filter(|c| c != ' ').fold(Vec.new(), |seen, c| {
        let mut seen = seen;
        if not seen.contains(c) {
            seen.push(c);
        }
        seen
    });
    message
        .chars()
        .map(|c| match order.iter().position(|o| o == c) {
            Some(i) => (b'a' + i as u8) as char,
            None => ' ',
        })
        .collect()
}

// ---- decode_solution.kara
struct Solution {}

impl Solution {
    pub fn decode_message(key: String, message: String) -> String {
        let mut map: Map[char, char] = Map.new();
        let mut next = b'a';
        for c in key.chars() {
            if c != ' ' and not map.contains_key(c) {
                map.insert(c, next as char);
                next += 1;
            }
        }
        message.chars().map(|c| if c == ' ' { ' ' } else { map[c] }).collect()
    }
}

fn solution_decode_message(key: Str, message: Str) -> String {
    Solution.decode_message(key.to_string(), message.to_string())
}

// ---- the statement read literally ------------------------------------------

fn literal(key: String, message: String) -> String {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let k: Vec[char] = key.chars().collect();
    let mut table: Vec[(char, char)] = Vec.new();
    for i in 0..k.len() {
        if k[i] == ' ' {
            continue;
        }
        let mut first = true;
        for j in 0..i {
            if k[j] == k[i] {
                first = false;
            }
        }
        if first {
            let regular = alphabet[table.len()];
            table.push((k[i], regular));
        }
    }
    let mut decoded = String.new();
    for c in message.chars() {
        let mut out = ' ';
        for (from, to) in table.iter() {
            if from == c {
                out = to;
            }
        }
        decoded.push(out);
    }
    decoded
}

fn answer(arm: i64, key: String, message: String) -> String {
    match arm {
        0 => star_decode_message(key, message),
        1 => naive_decode_message(key, message),
        2 => map_decode_message(key, message),
        3 => order_decode_message(key, message),
        4 => iter_decode_message(key, message),
        _ => solution_decode_message(key, message),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the 26 letters in a random order, or in order, each followed, one
// time in `often`, by a space and as often by a letter already placed
fn random_key(seed: mut ref i64, shuffle: bool, often: i64) -> String {
    let mut letters: Vec[u8] = (0..26).map(|i| b'a' + i as u8).collect();
    if shuffle {
        for i in (1..26).rev() {
            let j = next_random(mut seed) % (i + 1);
            letters.swap(i, j);
        }
    }
    let mut key = String.new();
    for i in 0..26 {
        key.push(letters[i] as char);
        let roll = next_random(mut seed) % often;
        if roll == 0 {
            key.push(' ');
        } else if roll == 1 {
            key.push(letters[next_random(mut seed) % (i + 1)] as char);
        }
    }
    key
}

fn random_message(seed: mut ref i64, length: i64) -> String {
    let mut message = String.new();
    for _ in 0..length {
        let roll = next_random(mut seed) % 27;
        message.push(if roll == 26 { ' ' } else { (b'a' + roll as u8) as char });
    }
    message
}

fn shifted(text: String) -> String {
    text.chars().map(|c| if c == ' ' { ' ' } else { (b'a' + ((c as u32 as u8 - b'a' + 7) % 26)) as char }).collect()
}

fn main() {
    let names = ["star", "naive", "map", "order", "iter", "solution"];
    let mut seed = 2325;
    let mut cases: Vec[(String, String)] = Vec.new();
    for c in 0..360 {
        let key = if c < 300 {
            random_key(mut seed, true, 6)
        } else if c < 330 {
            random_key(mut seed, true, 2)
        } else {
            random_key(mut seed, false, 6)
        };
        let length = if c < 330 { next_random(mut seed) % 100 + 1 } else { 200 };
        let message = random_message(mut seed, length);
        cases.push((key, message));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (key, message) in cases.iter() {
        let truth = literal(key, message);
        for b in truth.bytes() {
            check = (check * 31 + b) % 1000000007;
        }
        let bare: String = key.chars().filter(|c| c != ' ').collect();
        let twice = f"{key} {key}";
        let moved_key = shifted(key);
        let moved_message = shifted(message);
        let got: Vec[String] = (0..6).map(|arm| answer(arm, key, message)).collect();
        let m: Vec[char] = message.chars().collect();
        for arm in 0..6 {
            let value = ref got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let v: Vec[char] = value.chars().collect();
            let mut shape = v.len() == m.len();
            if shape {
                for i in 0..m.len() {
                    if (m[i] == ' ') != (v[i] == ' ') or (v[i] != ' ' and (v[i] < 'a' or v[i] > 'z')) {
                        shape = false;
                    }
                }
            }
            let verdicts = [
                value == truth,
                shape,
                answer(arm, bare, message) == value,
                answer(arm, twice, message) == value,
                answer(arm, moved_key, moved_message) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"key {key}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
