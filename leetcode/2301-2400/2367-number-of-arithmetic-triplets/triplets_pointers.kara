// LeetCode #2367: Number of Arithmetic Triplets -- three pointers. The
// values rise strictly, so as x moves on, the places of x + diff and
// x + 2 diff only move on too: two pointers walk up behind it. O(n).

fn arithmetic_triplets(nums: Vec[i64], diff: i64) -> i64 {
    let n = nums.len();
    let mut j = 0;
    let mut k = 0;
    let mut count = 0;
    for i in 0..n {
        while j < n and nums[j] < nums[i] + diff {
            j += 1;
        }
        while k < n and nums[k] < nums[i] + 2 * diff {
            k += 1;
        }
        if j < n and k < n and nums[j] == nums[i] + diff and nums[k] == nums[i] + 2 * diff {
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; three values; every value from 0 to 199
    // with a diff of 1 and of 50; then 3000 random sets of 3 to 40 values
    // from 0 to 0 to 200, with a diff of 1 to 50
    println(f"{arithmetic_triplets([0, 1, 4, 6, 7, 10], 3)}");
    println(f"{arithmetic_triplets([4, 5, 6, 7, 8, 9], 2)}");
    println(f"{arithmetic_triplets([1, 3, 5], 2)}");
    let all: Vec[i64] = (0..200).collect();
    println(f"{arithmetic_triplets(all, 1)} {arithmetic_triplets(all, 50)}");
    let mut seed = 2367;
    let mut check = 0;
    let mut none = 0;
    for _ in 0..3000 {
        let top = 3 + next_random(mut seed) % 198;
        let n = 3 + next_random(mut seed) % (top - 2).min(38);
        let mut taken: Vec[bool] = Vec.filled(top + 1, false);
        let mut count = 0;
        while count < n {
            let v = next_random(mut seed) % (top + 1);
            if not taken[v] {
                taken[v] = true;
                count += 1;
            }
        }
        let nums: Vec[i64] = (0..top + 1).filter(|v| taken[v]).collect();
        let diff = 1 + next_random(mut seed) % 50;
        let t = arithmetic_triplets(nums, diff);
        check = (check * 31 + t) % 1000000007;
        if t == 0 {
            none += 1;
        }
    }
    println(f"3000 sets: checksum {check}, {none} with no triplet");
}
