// LeetCode #2355: Maximum Number of Books You Can Take -- jumps: the same
// recurrence as the stack, the capping shelf j found through a table of
// each shelf's own cap. From i - 1, a shelf that does not cap i cannot be
// passed by anything between it and its own cap, so the search jumps
// straight to that cap. O(n) amortized, with no stack.

fn maximum_books(books: Vec[i64]) -> i64 {
    let n = books.len();
    let mut cap: Vec[i64] = Vec.filled(n, -1);
    let mut best: Vec[i64] = Vec.filled(n, 0);
    let mut answer = 0;
    for i in 0..n {
        let mut j = i - 1;
        while j >= 0 and books[j] - j >= books[i] - i {
            j = cap[j];
        }
        cap[i] = j;
        let length = if j >= 0 { i - j } else { (i + 1).min(books[i]) };
        best[i] = length * books[i] - length * (length - 1) / 2;
        if j >= 0 {
            best[i] += best[j];
        }
        answer = answer.max(best[i]);
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; one empty shelf; 2000 shelves rising by
    // one, and falling; 10^5 shelves of up to 10^5 books every 50th and up
    // to 200 between
    println(f"{maximum_books([8, 5, 2, 7, 9])}");
    println(f"{maximum_books([7, 0, 3, 4, 5])}");
    println(f"{maximum_books([8, 2, 3, 7, 3, 4, 0, 1, 4, 3])}");
    println(f"{maximum_books([0])}");
    println(f"{maximum_books((1..2001).collect())}");
    println(f"{maximum_books((1..2001).rev().collect())}");
    let mut seed = 2355;
    let mut big: Vec[i64] = Vec.new();
    for i in 0..100000 {
        let r = next_random(mut seed);
        big.push(if i % 50 == 0 { r * 3 % 100001 } else { r % 201 });
    }
    println(f"{maximum_books(big)}");
    // 2000 random arrays of 1 to 30 shelves of 0 to 1 up to 0 to 40 books
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 30;
        let top = 2 + next_random(mut seed) % 40;
        let books: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top).collect();
        let m = maximum_books(books);
        check = (check * 31 + m) % 1000000007;
        total += m;
    }
    println(f"2000 arrays: checksum {check}, books {total}");
}
