// LeetCode #2355: Maximum Number of Books You Can Take -- the
// differential. The six arms, against the statement read literally: every
// range of shelves from l to r, all of shelf r taken and each shelf to its
// left the lesser of what it holds and one fewer than the shelf after it;
// a range whose leftmost take would fall below 0 is not allowed. No caps,
// no recurrence. 300 random arrays of 1 to 30 shelves of 0 to 1 up to 0
// to 40 books; then 30 of up to 400 shelves of up to 10^5; then 30 of up
// to 300 shelves rising by 0 to 2 with random dips. Every case is drawn
// before any arm answers.
//
// P1  up to 30 shelves, the answer is the literal reading's
// P2  from the most books on one shelf to all the books
// P3  an empty shelf put before the first and after the last: the same
//     answer
// P4  the shelves given twice over with an empty shelf between: the same
//     answer
// P5  every shelf given one more book: from the answer to the answer plus
//     the number of shelves
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn books_literally(books: Vec[i64]) -> i64 {
    let mut answer = 0;
    for l in 0..books.len() {
        for r in l..books.len() {
            let mut takes: Vec[i64] = Vec.filled(books.len(), 0);
            takes[r] = books[r];
            let mut k = r;
            while k > l {
                k -= 1;
                takes[k] = books[k].min(takes[k + 1] - 1);
            }
            if takes[l] >= 0 {
                let mut total = 0;
                for k in l..r + 1 {
                    total += takes[k];
                }
                answer = answer.max(total);
            }
        }
    }
    answer
}

// ---- star (books.kara) ---------------------------------------------------

fn star_maximum_books(books: Vec[i64]) -> i64 {
    let n = books.len();
    let mut best: Vec[i64] = Vec.filled(n, 0);
    let mut stack: Vec[i64] = Vec.new();
    let mut answer = 0;
    for i in 0..n {
        while let Some(top) = stack.last() {
            if books[top] - top >= books[i] - i {
                stack.pop();
            } else {
                break;
            }
        }
        best[i] = match stack.last() {
            Some(j) => {
                let length = i - j;
                length * books[i] - length * (length - 1) / 2 + best[j]
            }
            None => {
                let length = (i + 1).min(books[i]);
                length * books[i] - length * (length - 1) / 2
            }
        };
        stack.push(i);
        answer = answer.max(best[i]);
    }
    answer
}

// ---- naive (books_naive.kara) --------------------------------------------

fn naive_maximum_books(books: Vec[i64]) -> i64 {
    let mut answer = 0;
    for r in 0..books.len() {
        let mut take = books[r];
        let mut total = take;
        let mut i = r;
        while i > 0 and take > 1 {
            i -= 1;
            take = books[i].min(take - 1);
            total += take;
        }
        answer = answer.max(total);
    }
    answer
}

// ---- scan (books_scan.kara) ----------------------------------------------

fn scan_maximum_books(books: Vec[i64]) -> i64 {
    let n = books.len();
    let mut best: Vec[i64] = Vec.filled(n, 0);
    let mut answer = 0;
    for i in 0..n {
        let mut j = i - 1;
        while j >= 0 and i - j < books[i] and books[j] - j >= books[i] - i {
            j -= 1;
        }
        let capped = j >= 0 and i - j < books[i];
        let length = if capped { i - j } else { (i + 1).min(books[i]) };
        best[i] = length * books[i] - length * (length - 1) / 2;
        if capped {
            best[i] += best[j];
        }
        answer = answer.max(best[i]);
    }
    answer
}

// ---- jumps (books_jumps.kara) --------------------------------------------

fn jumps_maximum_books(books: Vec[i64]) -> i64 {
    let n = books.len();
    let mut cap: Vec[i64] = Vec.filled(n, -1);
    let mut best: Vec[i64] = Vec.filled(n, 0);
    let mut answer = 0;
    for i in 0..n {
        let mut j = i - 1;
        while j >= 0 and books[j] - j >= books[i] - i {
            j = cap[j];
        }
        cap[i] = j;
        let length = if j >= 0 { i - j } else { (i + 1).min(books[i]) };
        best[i] = length * books[i] - length * (length - 1) / 2;
        if j >= 0 {
            best[i] += best[j];
        }
        answer = answer.max(best[i]);
    }
    answer
}

// ---- iter (books_iter.kara) ----------------------------------------------

fn iter_maximum_books(books: Vec[i64]) -> i64 {
    (0..books.len())
        .map(|r| {
            let left: i64 = books[..r]
                .iter()
                .rev()
                .scan(books[r], |take, b| {
                    let next = b.min(take - 1);
                    Some((next, next))
                })
                .take_while(|take| take > 0)
                .sum();
            books[r] + left
        })
        .max()
        .unwrap_or(0)
}

// ---- solution (books_solution.kara) --------------------------------------

struct Solution {}

impl Solution {
    pub fn maximum_books(books: Vec[i32]) -> i64 {
        let n = books.len();
        let mut best = Vec.filled(n, 0);
        let mut stack: Vec[i64] = Vec.new();
        let mut answer = 0;
        for i in 0..n {
            while let Some(top) = stack.last().cloned() {
                if books[top] - top >= books[i] - i {
                    stack.pop();
                } else {
                    break;
                }
            }
            let b = books[i] as i64;
            best[i] = if let Some(j) = stack.last().cloned() {
                let length = i - j;
                length * b - length * (length - 1) / 2 + best[j]
            } else {
                let length = ((i + 1)).min(b);
                length * b - length * (length - 1) / 2
            };
            stack.push(i);
            answer = answer.max(best[i]);
        }
        answer
    }
}

fn solution_maximum_books(books: Vec[i64]) -> i64 {
    let books: Vec[i32] = books.iter().map(|x| x as i32).collect();
    Solution.maximum_books(books)
}

// ---- the checks -------------------------------------------------------------

fn answer(arm: i64, books: Vec[i64]) -> i64 {
    match arm {
        0 => star_maximum_books(books),
        1 => naive_maximum_books(books),
        2 => scan_maximum_books(books),
        3 => jumps_maximum_books(books),
        4 => iter_maximum_books(books),
        _ => solution_maximum_books(books),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "naive", "scan", "jumps", "iter", "solution"];
    let mut seed = 2355;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..360 {
        let mut books: Vec[i64] = Vec.new();
        if c < 300 {
            let n = 1 + next_random(mut seed) % 30;
            let top = 2 + next_random(mut seed) % 40;
            for _ in 0..n {
                books.push(next_random(mut seed) % top);
            }
        } else if c < 330 {
            let n = 1 + next_random(mut seed) % 400;
            for _ in 0..n {
                books.push(next_random(mut seed) * 3 % 100001);
            }
        } else {
            let n = 1 + next_random(mut seed) % 300;
            let mut level = 0;
            for _ in 0..n {
                if next_random(mut seed) % 10 == 0 {
                    level = next_random(mut seed) % (level + 1);
                } else {
                    level += next_random(mut seed) % 3;
                }
                books.push(level);
            }
        }
        cases.push(books);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let books = cases[c].clone();
        let n = books.len();
        let small = n <= 30;
        let truth = if small { books_literally(books) } else { -1 };
        if small {
            check = (check * 31 + truth + 1) % 1000000007;
        }
        let most = books.iter().max().unwrap();
        let all: i64 = books.iter().sum();
        let mut padded: Vec[i64] = [0].to_vec();
        padded.extend(books.iter());
        padded.push(0);
        let mut twice = books.clone();
        twice.push(0);
        twice.extend(books.iter());
        let more: Vec[i64] = books.iter().map(|b| b + 1).collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, books)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let raised = answer(arm, more);
            let verdicts = [
                not small or value == truth,
                value >= most and value <= all,
                answer(arm, padded) == value,
                answer(arm, twice) == value,
                raised >= value and raised <= value + n,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
