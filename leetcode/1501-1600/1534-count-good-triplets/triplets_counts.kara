// LeetCode #1534: Count Good Triplets -- the middle j walked left to
// right with a running count of the values seen before it. For each
// k > j that meets `b`, the i that fit both `a` around arr[j] and `c`
// around arr[k] are the earlier values in the overlap of the two windows,
// read off prefix sums of that count. O(n^2 + n * top) for values up to
// `top`.

fn count_good_triplets(arr: Vec[i64], a: i64, b: i64, c: i64) -> i64 {
    let n = arr.len();
    let top = arr.iter().max().unwrap();
    // seen[v]: how many of arr[0..j] are v
    let mut seen = Vec.filled(top + 1, 0);
    let mut count = 0;
    for j in 0..n {
        // at_most[v + 1]: how many of arr[0..j] are at most v
        let mut at_most = Vec.filled(top + 2, 0);
        for v in 0..=top {
            at_most[v + 1] = at_most[v] + seen[v];
        }
        for k in j + 1..n {
            if (arr[j] - arr[k]).abs() > b {
                continue;
            }
            let low = (arr[j] - a).max(arr[k] - c).max(0);
            let high = (arr[j] + a).min(arr[k] + c).min(top);
            if low <= high {
                count += at_most[high + 1] - at_most[low];
            }
        }
        seen[arr[j]] += 1;
    }
    count
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` arrays of 3 to `most` values from 0 to `top`, with a, b and c
// each from 0 to `top`
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (most - 2) + 3;
        let mut arr = Vec.new();
        for _ in 0..n {
            arr.push(next_random(mut seed) % (top + 1));
        }
        let a = next_random(mut seed) % (top + 1);
        let b = next_random(mut seed) % (top + 1);
        let c = next_random(mut seed) % (top + 1);
        check = mix(check, count_good_triplets(arr, a, b, c));
    }
    println(f"{count} arrays of 3 to {most} values up to {top}: checksum {check}");
}

fn main() {
    let examples: Vec[(Vec[i64], i64, i64, i64)] = [
        ([3, 0, 1, 1, 9, 7], 7, 2, 3),
        ([1, 1, 2, 2, 3], 0, 0, 1),
        ([0, 1000, 0], 1000, 1000, 0),
        ([5, 5, 5], 0, 0, 0),
    ];
    for (arr, a, b, c) in examples.iter() {
        println(f"{arr}, a = {a}, b = {b}, c = {c} -> {count_good_triplets(arr.clone(), a, b, c)}");
    }
    let same = Vec.filled(100, 7);
    println(f"100 sevens, a = b = c = 0 -> {count_good_triplets(same, 0, 0, 0)}");
    let rising: Vec[i64] = (0..100).map(|i| i * 10).collect();
    println(f"0 to 990 by 10, a = b = 10, c = 20 -> {count_good_triplets(rising, 10, 10, 20)}");
    let mut seed = 1534;
    batch(3000, 12, 10, mut seed);
    batch(300, 100, 1000, mut seed);
}
