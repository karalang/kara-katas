// LeetCode #1572: Matrix Diagonal Sum -- the differential.
//
// Four arms against the statement read literally, on 3000 square matrices
// of 1 to 7 rows of values from 1 to 9, with six properties. Every random
// choice is drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the matrix transposed leaves the answer
// P3  the rows in reverse order leave the answer
// P4  every value doubled doubles the answer
// P5  every value raised by 1 adds one for each diagonal cell, 2n - n % 2
// P6  each arm agrees with at least two of the other three

// ---- diagonal.kara: the ★ arm: two cells a row, the centre taken off once

fn star_arm(mat: Vec[Vec[i64]]) -> i64 {
    let n = mat.len();
    let mut total = 0;
    for i in 0..n {
        total += mat[i][i] + mat[i][n - 1 - i];
    }
    if n % 2 == 1 {
        total -= mat[n / 2][n / 2];
    }
    total
}

// ---- diagonal_fold.kara: each row folded to its diagonal cells

fn fold_arm(mat: Vec[Vec[i64]]) -> i64 {
    let n = mat.len();
    mat.iter().enumerate().map(|(i, row)| {
        let j = n - 1 - i;
        if i == j { row[i] } else { row[i] + row[j] }
    }).sum()
}

// ---- diagonal_cells.kara: every cell visited, the diagonal ones added

fn cells_arm(mat: Vec[Vec[i64]]) -> i64 {
    let n = mat.len();
    let mut total = 0;
    for (i, row) in mat.iter().enumerate() {
        for (j, x) in row.iter().enumerate() {
            if i == j or i + j == n - 1 {
                total += x;
            }
        }
    }
    total
}

// ---- diagonal_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn diagonal_sum(mat: Vec[Vec[i32]]) -> i32 {
        let n = mat.len();
        let mut sum: i32 = 0;
        for i in 0..n {
            sum += mat[i][i];
            if i != n - 1 - i {
                sum += mat[i][n - 1 - i];
            }
        }
        sum
    }
}

fn solution_arm(mat: Vec[Vec[i64]]) -> i64 {
    let mat: Vec[Vec[i32]] = mat.iter().map(|row| row.iter().map(|x| x as i32).collect()).collect();
    Solution.diagonal_sum(mat)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, mat: Vec[Vec[i64]]) -> i64 {
    match a {
        0 => star_arm(mat),
        1 => fold_arm(mat),
        2 => cells_arm(mat),
        _ => solution_arm(mat),
    }
}

fn arm_name(a: i64) -> String {
    ["diagonal", "fold", "cells", "solution"][a].to_string()
}

// ---- the statement read literally: the cells of the primary diagonal and
// of the secondary diagonal gathered as one set of positions, so a cell on
// both is in it once, and their values added

fn literal(mat: Vec[Vec[i64]]) -> i64 {
    let n = mat.len();
    let mut cells: SortedSet[(i64, i64)] = SortedSet.new();
    for i in 0..n {
        cells.insert((i, i));
        cells.insert((i, n - 1 - i));
    }
    cells.iter().map(|(i, j)| mat[i][j]).sum()
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15720;
    let mut cases: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 7 + 1;
        let mat: Vec[Vec[i64]] = (0..n).map(|_| (0..n).map(|_| next_random(mut seed) % 9 + 1).collect()).collect();
        cases.push(mat);
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for (p, mat) in cases.iter().enumerate() {
        let n = mat.len();
        let truth = literal(mat);
        let transposed: Vec[Vec[i64]] = (0..n).map(|j| (0..n).map(|i| mat[i][j]).collect()).collect();
        let upside_down: Vec[Vec[i64]] = mat.iter().rev().cloned().collect();
        let doubled: Vec[Vec[i64]] = mat.iter().map(|row| row.iter().map(|v| 2 * v).collect()).collect();
        let raised: Vec[Vec[i64]] = mat.iter().map(|row| row.iter().map(|v| v + 1).collect()).collect();
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, mat);
            answers.push(answer);
            check = (check * 31 + answer + 1) % 1000000007;
            let failed = [
                answer != truth,
                arm(a, transposed) != answer,
                arm(a, upside_down) != answer,
                arm(a, doubled) != 2 * answer,
                arm(a, raised) != answer + 2 * n - n % 2,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
