// LeetCode #1561: Maximum Number of Coins You Can Get -- the ★ arm: Bob
// can be handed the n smallest piles, and of the 2n left, sorted, you take
// every other one from the bottom, each pile under one Alice takes.

fn max_coins(piles: Vec[i64]) -> i64 {
    let mut sorted = piles.clone();
    sorted.sort();
    let n = sorted.len() / 3;
    sorted[n..].iter().step_by(2).sum()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` lists of 3 to 3 `most` piles of 1 to `top` coins
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut piles = Vec.new();
        for _ in 0..3 * n {
            piles.push(next_random(mut seed) % top + 1);
        }
        let coins = max_coins(piles);
        total += coins;
        check = mix(check, coins);
    }
    println(f"{count} lists of up to {3 * most} piles of up to {top}: {total} coins, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[i64]] = [
        [2, 4, 1, 2, 7, 8],
        [2, 4, 5],
        [9, 8, 7, 6, 5, 1, 2, 3, 4],
        [1, 1, 1],
        [5, 5, 5, 5, 5, 5],
        [1, 2, 3, 4, 5, 6],
        [10000, 10000, 10000],
        [1, 10000, 1, 10000, 1, 10000],
    ];
    for piles in examples.iter() {
        println(f"{piles} -> {max_coins(piles.clone())}");
    }
    let mut seed = 1561;
    batch(3000, 3, 10, mut seed);
    batch(300, 1000, 10000, mut seed);
    batch(30, 33333, 10000, mut seed);
}
