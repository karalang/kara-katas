// LeetCode #1552: Magnetic Force Between Two Balls -- the binary search
// with its check as a `fold` over the sorted positions, the state the
// count of balls placed and the last ball's position, and the search as a
// bit-by-bit climb: from the highest power of two down, a bit is kept
// when the gap with it still fits.

fn max_distance(position: Vec[i64], m: i64) -> i64 {
    let mut sorted = position.clone();
    sorted.sort();
    let fits = |gap: i64| {
        let (placed, _) = sorted.iter().skip(1).fold((1, sorted[0]), |(placed, last), p| {
            if p - last >= gap { (placed + 1, p) } else { (placed, last) }
        });
        placed >= m
    };
    let mut best = 0;
    let mut bit = 1 << 30;
    while bit > 0 {
        if fits(best + bit) {
            best += bit;
        }
        bit /= 2;
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` baskets of 2 to `most` distinct positions from 1 to `widest`,
// in a random order, each with 2 to all of them balls
fn batch(count: i64, most: i64, widest: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most - 1) + 2;
        let n = n.min(widest);
        let m = next_random(mut seed) % (n - 1) + 2;
        let mut taken: Set[i64] = Set.new();
        let mut position = Vec.new();
        while position.len() < n {
            let p = (next_random(mut seed) * 32768 + next_random(mut seed)) % widest + 1;
            if taken.insert(p) {
                position.push(p);
            }
        }
        check = mix(check, max_distance(position, m));
    }
    println(f"{count} baskets of up to {most} positions up to {widest}: checksum {check}");
}

fn main() {
    let examples: Vec[(Vec[i64], i64)] = [
        ([1, 2, 3, 4, 7], 3),
        ([5, 4, 3, 2, 1, 1000000000], 2),
        ([1, 2], 2),
        ([1, 2, 3, 4, 5], 5),
        ([1, 100, 101, 200], 3),
        ([10, 1, 7, 4], 4),
        ([1, 1000000000, 500000000, 2], 3),
    ];
    for (position, m) in examples.iter() {
        println(f"{position}, m = {m} -> {max_distance(position.clone(), m)}");
    }
    let spread: Vec[i64] = (0..100000).map(|i| i * 10000 + 1).collect();
    println(f"100000 positions 10000 apart, m = 1000 -> {max_distance(spread, 1000)}");
    let mut seed = 1552;
    batch(3000, 12, 30, mut seed);
    batch(300, 1000, 1000000000, mut seed);
    batch(30, 100000, 1000000000, mut seed);
}
