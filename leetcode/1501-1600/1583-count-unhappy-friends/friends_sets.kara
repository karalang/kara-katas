// LeetCode #1583: Count Unhappy Friends -- the sets arm: each friend's set of
// the friends it lists before its partner, by `take_while` into a `Set`.
// Friend `x` is unhappy when some `u` in its set has `x` in its own.
// O(n^2) expected

fn unhappy_friends(n: i64, preferences: Vec[Vec[i64]], pairs: Vec[Vec[i64]]) -> i64 {
    let mut partner = Vec.filled(n, 0);
    for p in pairs.iter() {
        partner[p[0]] = p[1];
        partner[p[1]] = p[0];
    }
    let rather: Vec[Set[i64]] = (0..n).map(|x| preferences[x].iter().take_while(|f| f != partner[x]).collect()).collect();
    (0..n).filter(|x| rather[x].iter().any(|u| rather[u].contains(x))).count()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// 0..n in a random order
fn shuffled(n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut v: Vec[i64] = (0..n).collect();
    for i in (1..n).rev() {
        v.swap(i, next_random(mut seed) % (i + 1));
    }
    v
}

// `count` problems of 2 to 2 * `most` friends: each list the others in a
// random order, and the friends paired off in a random order
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = 2 * (next_random(mut seed) % most + 1);
        let mut preferences: Vec[Vec[i64]] = Vec.new();
        for x in 0..n {
            let order = shuffled(n, mut seed);
            preferences.push(order.iter().filter(|f| f != x).collect());
        }
        let line = shuffled(n, mut seed);
        let pairs: Vec[Vec[i64]] = (0..n / 2).map(|k| [line[2 * k], line[2 * k + 1]]).collect();
        let unhappy = unhappy_friends(n, preferences, pairs);
        total += unhappy;
        check = mix(check, unhappy);
    }
    println(f"{count} problems of up to {2 * most} friends: unhappy {total}, checksum {check}");
}

fn main() {
    let examples: Vec[(i64, Vec[Vec[i64]], Vec[Vec[i64]])] = [
        (4, [[1, 2, 3], [3, 2, 0], [3, 1, 0], [1, 2, 0]], [[0, 1], [2, 3]]),
        (2, [[1], [0]], [[1, 0]]),
        (4, [[1, 3, 2], [2, 3, 0], [1, 3, 0], [0, 2, 1]], [[1, 3], [0, 2]]),
        (4, [[1, 2, 3], [0, 2, 3], [3, 0, 1], [2, 0, 1]], [[0, 1], [2, 3]]),
        (6, [[1, 4, 3, 2, 5], [0, 5, 4, 3, 2], [3, 0, 1, 5, 4], [2, 1, 4, 0, 5], [2, 1, 0, 3, 5], [3, 4, 2, 0, 1]], [[3, 1], [2, 0], [5, 4]]),
    ];
    for (n, preferences, pairs) in examples.iter() {
        println(f"{n} {preferences} {pairs} -> {unhappy_friends(n, preferences, pairs)}");
    }
    let mut seed = 1583;
    batch(3000, 3, mut seed);
    batch(300, 30, mut seed);
    batch(3, 250, mut seed);
}
