// LeetCode #1583 bench: the ★ arm (a table of ranks) on 40 problems of 500
// friends, every list and pairing drawn first.

fn unhappy_friends(n: i64, preferences: Vec[Vec[i64]], pairs: Vec[Vec[i64]]) -> i64 {
    let mut rank: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(n, 0));
    for x in 0..n {
        for (r, f) in preferences[x].iter().enumerate() {
            rank[x][f] = r;
        }
    }
    let mut partner = Vec.filled(n, 0);
    for p in pairs.iter() {
        partner[p[0]] = p[1];
        partner[p[1]] = p[0];
    }
    let mut unhappy = 0;
    for x in 0..n {
        let y = partner[x];
        for u in preferences[x].iter().take(rank[x][y]) {
            if rank[u][x] < rank[u][partner[u]] {
                unhappy += 1;
                break;
            }
        }
    }
    unhappy
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn shuffled(n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut v: Vec[i64] = (0..n).collect();
    for i in (1..n).rev() {
        v.swap(i, next_random(mut seed) % (i + 1));
    }
    v
}

fn main() {
    let n = 500;
    let mut seed = 1583;
    let mut problems: Vec[(Vec[Vec[i64]], Vec[Vec[i64]])] = Vec.new();
    for _ in 0..40 {
        let mut preferences: Vec[Vec[i64]] = Vec.new();
        for x in 0..n {
            let order = shuffled(n, mut seed);
            preferences.push(order.iter().filter(|f| f != x).collect());
        }
        let line = shuffled(n, mut seed);
        let pairs: Vec[Vec[i64]] = (0..n / 2).map(|k| [line[2 * k], line[2 * k + 1]]).collect();
        problems.push((preferences, pairs));
    }
    let mut check = 0;
    let mut total = 0;
    for (preferences, pairs) in problems.iter() {
        let unhappy = unhappy_friends(n, preferences, pairs);
        total += unhappy;
        check = mix(check, unhappy);
    }
    println(f"40 problems of 500 friends: unhappy {total}, checksum {check}");
}
