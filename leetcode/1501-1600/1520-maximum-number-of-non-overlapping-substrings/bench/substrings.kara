// LeetCode #1520: Maximum Number of Non-Overlapping Substrings -- the
// bench: the ★ arm over 200000 random strings of 1 to 64 letters over 5,
// built once and answered 3 times.

fn max_num_of_substrings(s: String) -> Vec[String] {
    let bytes: Vec[u8] = s.bytes().iter().collect();
    let n = bytes.len();
    let mut first: Vec[i64] = Vec.filled(26, n);
    let mut last: Vec[i64] = Vec.filled(26, -1);
    for i in 0..n {
        let c = (bytes[i] - 97) as i64;
        first[c] = first[c].min(i);
        last[c] = i;
    }
    let mut spans: Vec[(i64, i64)] = Vec.new();
    let mut right = -1;
    for i in 0..n {
        let c = (bytes[i] - 97) as i64;
        if i != first[c] {
            continue;
        }
        let mut end = last[c];
        let mut ok = true;
        let mut j = i;
        while j <= end {
            let d = (bytes[j] - 97) as i64;
            if first[d] < i {
                ok = false;
                break;
            }
            end = end.max(last[d]);
            j += 1;
        }
        if not ok {
            continue;
        }
        if i > right {
            spans.push((i, end));
        } else {
            let k = spans.len() - 1;
            spans[k] = (i, end);
        }
        right = end;
    }
    spans.iter().map(|(a, b)| s[a..b + 1].to_string()).collect()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let count = 200000;
    let mut seed = 1520;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..count {
        let n = next_random(mut seed) % 64 + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % 5) as u8 as char);
        }
        strings.push(s);
    }
    let mut check = 0;
    let mut pieces = 0;
    for _ in 0..3 {
        for s in strings.iter() {
            for piece in max_num_of_substrings(s).iter() {
                pieces += 1;
                check = mix(check, piece.len());
                check = mix(check, piece.bytes()[0]);
            }
        }
    }
    println(f"3 passes over 200000 strings of up to 64 letters: {pieces} substrings, checksum {check}");
}
