// LeetCode #1520: Maximum Number of Non-Overlapping Substrings --
// LeetCode's Rust template, written as Rust writes it and carried to Kāra
// by `karac fix`: the ★ arm over `as_bytes()`, `usize` indices and
// `[usize; 26]`.

struct Solution {}

impl Solution {
    pub fn max_num_of_substrings(s: String) -> Vec[String] {
        let b = s.bytes();
        let n = b.len();
        let mut first = [n; 26];
        let mut last = [0; 26];
        for (i, c) in b.iter().enumerate() {
            let c = (c - b'a') as i64;
            first[c] = first[c].min(i);
            last[c] = i;
        }
        let mut ans: Vec[String] = Vec.new();
        let mut right: i64 = -1;
        for i in 0..n {
            let c = (b[i] - b'a') as i64;
            if i != first[c] {
                continue;
            }
            let mut end = last[c];
            let mut ok = true;
            let mut j = i;
            while j <= end {
                let d = (b[j] - b'a') as i64;
                if first[d] < i {
                    ok = false;
                    break;
                }
                end = end.max(last[d]);
                j += 1;
            }
            if not ok {
                continue;
            }
            let piece = s[i..=end].to_string();
            if i > right {
                ans.push(piece);
            } else {
                ans[ans.len() - 1] = piece;
            }
            right = end;
        }
        ans
    }
}

fn max_num_of_substrings(s: String) -> Vec[String] {
    Solution.max_num_of_substrings(s)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// The answer is unique as a set; sorted, it prints the same from every arm.
fn show(s: String) -> String {
    let mut parts = max_num_of_substrings(s);
    parts.sort();
    f"[{parts.join(",")}]"
}

fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % letters) as u8 as char);
        }
        for b in show(s).bytes() {
            check = mix(check, b);
        }
    }
    check
}

fn main() {
    println(f"example 1, adefaddaccc -> {show("adefaddaccc")}");
    println(f"example 2, abbaccd -> {show("abbaccd")}");
    println(f"one letter, zzz -> {show("zzz")}");
    println(f"nested, abacbdcd -> {show("abacbdcd")}");
    let mut seed = 1520;
    println(f"3000 strings of 1 to 12 over 4 letters: checksum {batch(3000, 12, 4, mut seed)}");
    println(f"30 strings of 1 to 30000 over 26 letters: checksum {batch(30, 30000, 26, mut seed)}");
}
