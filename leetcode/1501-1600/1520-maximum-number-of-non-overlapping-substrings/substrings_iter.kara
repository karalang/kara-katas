// LeetCode #1520: Maximum Number of Non-Overlapping Substrings -- the ★
// arm with iterator adapters: each letter's first and last occurrence by
// `position` and `rposition`, the valid spans by `filter_map` over the
// first occurrences, and the walk that adds or replaces by `fold`.

fn grow(bytes: Vec[u8], first: Vec[i64], last: Vec[i64], start: i64) -> Option[(i64, i64)] {
    let mut end = last[(bytes[start] - 97) as i64];
    let mut j = start;
    while j <= end {
        let d = (bytes[j] - 97) as i64;
        if first[d] < start {
            return None;
        }
        end = end.max(last[d]);
        j += 1;
    }
    Some((start, end))
}

fn max_num_of_substrings(s: String) -> Vec[String] {
    let bytes: Vec[u8] = s.bytes().iter().collect();
    let n = bytes.len();
    let first: Vec[i64] = (0..26).map(|c| bytes.iter().position(|b| *b == (97 + c) as u8).unwrap_or(n)).collect();
    let last: Vec[i64] = (0..26).map(|c| bytes.iter().rposition(|b| *b == (97 + c) as u8).unwrap_or(-1)).collect();
    let spans: Vec[(i64, i64)] = (0..n)
        .filter(|i| first[(bytes[i] - 97) as i64] == i)
        .filter_map(|i| grow(bytes, first, last, i))
        .fold(Vec.new(), |taken: own Vec[(i64, i64)], (a, b)| {
            let mut taken = taken;
            match taken.last() {
                Some((_, right)) if a <= right => {
                    let k = taken.len() - 1;
                    taken[k] = (a, b);
                }
                _ => taken.push((a, b)),
            }
            taken
        });
    spans.iter().map(|(a, b)| s[a..b + 1].to_string()).collect()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// The answer is unique as a set; sorted, it prints the same from every arm.
fn show(s: String) -> String {
    let mut parts = max_num_of_substrings(s);
    parts.sort();
    f"[{parts.join(",")}]"
}

fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % letters) as u8 as char);
        }
        for b in show(s).bytes() {
            check = mix(check, b);
        }
    }
    check
}

fn main() {
    println(f"example 1, adefaddaccc -> {show("adefaddaccc")}");
    println(f"example 2, abbaccd -> {show("abbaccd")}");
    println(f"one letter, zzz -> {show("zzz")}");
    println(f"nested, abacbdcd -> {show("abacbdcd")}");
    let mut seed = 1520;
    println(f"3000 strings of 1 to 12 over 4 letters: checksum {batch(3000, 12, 4, mut seed)}");
    println(f"30 strings of 1 to 30000 over 26 letters: checksum {batch(30, 30000, 26, mut seed)}");
}
