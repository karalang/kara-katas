// LeetCode #1520: Maximum Number of Non-Overlapping Substrings -- each
// letter's span is closed over the 26 letters rather than grown along the
// string: a letter's span takes in the span of every letter that occurs
// inside it, repeated until no span changes. A span is valid when its
// closure still starts at its own letter's first occurrence. The valid
// spans are then taken by the ★ arm's walk in order of start. O(26 n).

struct Reach {
    lo: i64,
    hi: i64,
}

fn max_num_of_substrings(s: String) -> Vec[String] {
    let bytes: Vec[u8] = s.bytes().iter().collect();
    let n = bytes.len();
    let mut first: Vec[i64] = Vec.filled(26, n);
    let mut last: Vec[i64] = Vec.filled(26, -1);
    for i in 0..n {
        let c = (bytes[i] - 97) as i64;
        if first[c] == n {
            first[c] = i;
        }
        last[c] = i;
    }
    // inside[c][d]: letter d occurs within letter c's own span
    let mut inside: Vec[Vec[bool]] = Vec.filled(26, Vec.filled(26, false));
    for c in 0..26 {
        if last[c] < 0 {
            continue;
        }
        for i in first[c]..last[c] + 1 {
            inside[c][(bytes[i] - 97) as i64] = true;
        }
    }
    let mut spans: Vec[Reach] = Vec.new();
    for c in 0..26 {
        spans.push(Reach { lo: first[c], hi: last[c] });
    }
    let mut changed = true;
    while changed {
        changed = false;
        for c in 0..26 {
            if last[c] < 0 {
                continue;
            }
            for d in 0..26 {
                if not inside[c][d] {
                    continue;
                }
                if spans[d].lo < spans[c].lo or spans[d].hi > spans[c].hi {
                    spans[c].lo = spans[c].lo.min(spans[d].lo);
                    spans[c].hi = spans[c].hi.max(spans[d].hi);
                    for e in 0..26 {
                        if inside[d][e] and not inside[c][e] {
                            inside[c][e] = true;
                        }
                    }
                    changed = true;
                }
            }
        }
    }
    let mut taken: Vec[(i64, i64)] = Vec.new();
    let mut right = -1;
    for i in 0..n {
        let c = (bytes[i] - 97) as i64;
        if i != first[c] or spans[c].lo != i {
            continue;
        }
        if i > right {
            taken.push((i, spans[c].hi));
        } else {
            let k = taken.len() - 1;
            taken[k] = (i, spans[c].hi);
        }
        right = spans[c].hi;
    }
    taken.iter().map(|(a, b)| s[a..b + 1].to_string()).collect()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// The answer is unique as a set; sorted, it prints the same from every arm.
fn show(s: String) -> String {
    let mut parts = max_num_of_substrings(s);
    parts.sort();
    f"[{parts.join(",")}]"
}

fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % letters) as u8 as char);
        }
        for b in show(s).bytes() {
            check = mix(check, b);
        }
    }
    check
}

fn main() {
    println(f"example 1, adefaddaccc -> {show("adefaddaccc")}");
    println(f"example 2, abbaccd -> {show("abbaccd")}");
    println(f"one letter, zzz -> {show("zzz")}");
    println(f"nested, abacbdcd -> {show("abacbdcd")}");
    let mut seed = 1520;
    println(f"3000 strings of 1 to 12 over 4 letters: checksum {batch(3000, 12, 4, mut seed)}");
    println(f"30 strings of 1 to 30000 over 26 letters: checksum {batch(30, 30000, 26, mut seed)}");
}
