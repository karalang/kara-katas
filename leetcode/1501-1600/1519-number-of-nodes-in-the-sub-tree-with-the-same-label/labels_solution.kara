// LeetCode #1519: Number of Nodes in the Sub-Tree With the Same Label --
// LeetCode's Rust template, written as Rust writes it and carried to Kāra
// by `karac fix`: the ★ arm's walk over `Vec<Vec<i32>>` and `[i32; 26]`.
// Kept as `karac fix` left it, which does not check: see README, "Rust
// template". Five hand edits make it check and agree.

struct Solution {}

fn dfs(u: i64, p: i64, adj: ref Vec[Vec[i64]], labels: Slice[u8], ans: mut ref Vec[i32]) -> Array[i32, 26] {
    let mut cnt = [0; 26];
    for v in ref adj[u] {
        if v != p {
            let sub = dfs(v, u, adj, labels, mut ans);
            for c in 0..26 {
                cnt[c] += sub[c];
            }
        }
    }
    let c = (labels[u] - b'a') as i64;
    cnt[c] += 1;
    ans[u] = cnt[c];
    cnt
}

impl Solution {
    pub fn count_sub_trees(n: i32, edges: Vec[Vec[i32]], labels: String) -> Vec[i32] {
        let n = n as i64;
        let mut adj = Vec.filled(n, Vec.new());
        for e in ref edges {
            adj[e[0] as usize].push(e[1] as usize);
            adj[e[1] as usize].push(e[0] as usize);
        }
        let labels = labels.bytes();
        let mut ans = Vec.filled(n, 0);
        dfs(0, usize.MAX, adj, labels, mut ans);
        ans
    }
}

fn count_sub_trees(n: i64, edges: Vec[(i64, i64)], labels: String) -> Vec[i64] {
    let rows: Vec[Vec[i32]] = edges.iter().map(|(a, b)| [a as i32, b as i32]).collect();
    Solution.count_sub_trees(n as i32, rows, labels).iter().map(|x| x as i64).collect()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn show(answer: Vec[i64]) -> String {
    let parts: Vec[String] = answer.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

// `count` trees of 1 to `most` nodes, node i under a random earlier node,
// each edge written either way round and the edges shuffled; labels from
// the first `letters` letters.
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut edges: Vec[(i64, i64)] = Vec.new();
        for i in 1..n {
            let parent = (next_random(mut seed) * 32768 + next_random(mut seed)) % i;
            if next_random(mut seed) % 2 == 0 {
                edges.push((parent, i));
            } else {
                edges.push((i, parent));
            }
        }
        for i in (1..edges.len()).rev() {
            edges.swap(i, next_random(mut seed) % (i + 1));
        }
        let mut labels = String.new();
        for _ in 0..n {
            labels.push((97 + next_random(mut seed) % letters) as u8 as char);
        }
        for x in count_sub_trees(n, edges, labels).iter() {
            check = mix(check, *x);
        }
    }
    check
}

fn main() {
    println(f"example 1 -> {show(count_sub_trees(7, [(0, 1), (0, 2), (1, 4), (1, 5), (2, 3), (2, 6)], "abaedcd"))}");
    println(f"example 2 -> {show(count_sub_trees(4, [(0, 1), (1, 2), (0, 3)], "bbbb"))}");
    println(f"example 3 -> {show(count_sub_trees(5, [(0, 1), (0, 2), (1, 3), (0, 4)], "aabab"))}");
    println(f"one node -> {show(count_sub_trees(1, [], "z"))}");
    let mut seed = 1519;
    println(f"2000 trees of 1 to 12 nodes over 3 letters: checksum {batch(2000, 12, 3, mut seed)}");
    println(f"20 trees of 1 to 20000 nodes over 26 letters: checksum {batch(20, 20000, 26, mut seed)}");
}
