// LeetCode #1544: Make The String Great -- the stack kept in the string's
// own bytes: `kept` letters at the front form it, each byte either cancels
// the last kept one (they differ by 32, the gap between the cases in
// ASCII) or is written after it. O(n), no second buffer.

fn make_good(s: String) -> String {
    let mut b: Vec[u8] = s.bytes().iter().collect();
    let mut kept = 0;
    for i in 0..b.len() {
        if kept > 0 and (b[kept - 1] as i64 - b[i] as i64).abs() == 32 {
            kept -= 1;
        } else {
            b[kept] = b[i];
            kept += 1;
        }
    }
    b.truncate(kept);
    String.from_utf8(b).unwrap()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// one of the first `letters` letters, upper or lower case
fn letter(letters: i64, seed: mut ref i64) -> char {
    let base = if next_random(mut seed) % 2 == 0 { b'a' } else { b'A' };
    (base + (next_random(mut seed) % letters) as u8) as char
}

// `count` strings of 1 to `most` letters over the first 1 to `letters`,
// both cases
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut empty = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let used = next_random(mut seed) % letters + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push(letter(used, mut seed));
        }
        let great = make_good(s);
        if great.is_empty() {
            empty += 1;
        }
        check = mix(check, great.len());
        for b in great.bytes().iter() {
            check = mix(check, b);
        }
    }
    println(f"{count} strings of up to {most} letters: {empty} empty, checksum {check}");
}

fn main() {
    let examples = ["leEeetcode", "abBAcC", "s", "aA", "Aa", "aa", "abBA", "aBbAcCdD", "AbBa", "xyzZYX", "abcCBAd"];
    for s in examples.iter() {
        println(f"\"{s}\" -> \"{make_good(s.to_string())}\"");
    }
    let mut seed = 1544;
    batch(3000, 12, 3, mut seed);
    batch(300, 100, 2, mut seed);
    batch(300, 100, 26, mut seed);
}
