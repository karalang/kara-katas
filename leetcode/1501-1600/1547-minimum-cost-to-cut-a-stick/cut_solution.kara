// LeetCode #1547: Minimum Cost to Cut a Stick -- LeetCode's Rust template
// as karac fix left it: the ★ arm over `i32` points and `usize` places.

struct Solution {}

impl Solution {
    pub fn min_cost(n: i32, cuts: Vec[i32]) -> i32 {
        let mut points = cuts.clone();
        points.push(0);
        points.push(n);
        points.sort();
        let m = points.len();
        let mut cost = Vec.filled(m, Vec.filled(m, 0i32));
        for gap in 2..m {
            for i in 0..m - gap {
                let j = i + gap;
                let mut best = i32.MAX;
                for k in i + 1..j {
                    best = best.min(cost[i][k] + cost[k][j]);
                }
                cost[i][j] = best + points[j] - points[i];
            }
        }
        cost[0][m - 1]
    }
}

fn min_cost(n: i64, cuts: Vec[i64]) -> i64 {
    let cuts: Vec[i32] = cuts.iter().map(|c| c as i32).collect();
    Solution.min_cost(n as i32, cuts)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` sticks of 2 to `longest`, each with 1 to `most` distinct cuts
// in a random order
fn batch(count: i64, longest: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % (longest - 1) + 2;
        let want = (next_random(mut seed) % most + 1).min(n - 1);
        let mut taken: Set[i64] = Set.new();
        let mut cuts = Vec.new();
        while cuts.len() < want {
            let c = (next_random(mut seed) * 32768 + next_random(mut seed)) % (n - 1) + 1;
            if taken.insert(c) {
                cuts.push(c);
            }
        }
        check = mix(check, min_cost(n, cuts));
    }
    println(f"{count} sticks of up to {longest} with up to {most} cuts: checksum {check}");
}

fn main() {
    let examples: Vec[(i64, Vec[i64])] = [
        (7, [1, 3, 4, 5]),
        (9, [5, 6, 1, 4, 2]),
        (2, [1]),
        (10, [5]),
        (10, [1, 9]),
        (1000000, [1, 999999, 500000]),
    ];
    for (n, cuts) in examples.iter() {
        println(f"n = {n}, cuts {cuts} -> {min_cost(n, cuts.clone())}");
    }
    let every: Vec[i64] = (1..101).collect();
    println(f"n = 101, every cut -> {min_cost(101, every)}");
    let mut seed = 1547;
    batch(3000, 30, 6, mut seed);
    batch(300, 1000000, 40, mut seed);
    batch(3, 1000000, 100, mut seed);
}
