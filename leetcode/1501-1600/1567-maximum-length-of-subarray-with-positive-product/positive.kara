// LeetCode #1567: Maximum Length of Subarray With Positive Product -- the ★
// arm: the longest run ending here with a positive product and with a
// negative one, each from the two before it: a positive value lengthens
// both, a negative one swaps them, a zero ends both. O(n)

fn get_max_len(nums: Vec[i64]) -> i64 {
    let mut positive = 0;
    let mut negative = 0;
    let mut best = 0;
    for x in nums.iter() {
        if x > 0 {
            positive += 1;
            negative = if negative > 0 { negative + 1 } else { 0 };
        } else if x < 0 {
            let was_positive = positive;
            positive = if negative > 0 { negative + 1 } else { 0 };
            negative = was_positive + 1;
        } else {
            positive = 0;
            negative = 0;
        }
        best = best.max(positive);
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` arrays of 1 to `most` values, each value 0 one time in `zeros`,
// otherwise of 1 to `top` with a sign negative one time in three
fn batch(count: i64, most: i64, zeros: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut nums = Vec.new();
        for _ in 0..n {
            let size = (next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1;
            let kind = next_random(mut seed);
            nums.push(if kind % zeros == 0 { 0 } else if kind % 3 == 0 { -size } else { size });
        }
        let length = get_max_len(nums);
        total += length;
        check = mix(check, length);
    }
    println(f"{count} arrays of up to {most} values: lengths sum {total}, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[i64]] = [
        [1, -2, -3, 4],
        [0, 1, -2, -3, -4],
        [-1, -2, -3, 0, 1],
        [-1],
        [0],
        [5],
        [-1, 2],
        [2, -1, 3, 4, 0, 5, 6, -7, 8],
        [-1000000000, -1000000000, -1000000000, -1000000000],
    ];
    for nums in examples.iter() {
        println(f"{nums} -> {get_max_len(nums.clone())}");
    }
    let mut seed = 1567;
    batch(3000, 10, 5, 5, mut seed);
    batch(300, 1000, 50, 1000, mut seed);
    batch(30, 100000, 1000, 1000000000, mut seed);
}
