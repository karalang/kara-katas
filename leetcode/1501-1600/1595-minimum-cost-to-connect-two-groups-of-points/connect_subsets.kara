// LeetCode #1595: Minimum Cost to Connect Two Groups of Points -- every
// subset, exactly.
//
// No cheapest-edge closing step: each first point in turn takes a
// nonempty set of edges, and the set of second points joined so far is
// the state. In an optimal answer a first point's edges reach at most one
// second point already joined (its own edge) and otherwise only points
// not yet joined, so a step adds a subset of the points still alone, and
// perhaps the cheapest edge back into the joined ones. The cost of every
// subset of a row is built from a smaller one by its lowest bit. The
// answer is the state with every point joined. O(n1 3^n2).

fn connect_two_groups(cost: Vec[Vec[i32]]) -> i32 {
    let second = cost[0].len();
    let full = (1 << second) - 1;
    let unreached = i32.MAX;
    let mut best: Vec[i32] = Vec.filled(full + 1, unreached);
    best[0] = 0;
    for row in cost.iter() {
        let mut subset_cost: Vec[i32] = Vec.filled(full + 1, 0);
        for s in 1..full + 1 {
            let low = s & -s;
            subset_cost[s] = subset_cost[s ^ low] + row[low.trailing_zeros()];
        }
        let mut next: Vec[i32] = Vec.filled(full + 1, unreached);
        for joined in 0..full + 1 {
            if best[joined] == unreached {
                continue;
            }
            let back = (0..second).filter(|j| joined >> j & 1 == 1).map(|j| row[j]).min();
            let alone = full ^ joined;
            let mut s = alone;
            loop {
                let reached = joined | s;
                if s != 0 {
                    next[reached] = next[reached].min(best[joined] + subset_cost[s]);
                }
                if let Some(b) = back {
                    next[reached] = next[reached].min(best[joined] + subset_cost[s] + b);
                }
                if s == 0 {
                    break;
                }
                s = (s - 1) & alone;
            }
        }
        best = next;
    }
    best[full]
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let first = next_random(mut seed) % most + 1;
        let second = next_random(mut seed) % first + 1;
        let cost: Vec[Vec[i32]] = (0..first).map(|_| (0..second).map(|_| (next_random(mut seed) % 101) as i32).collect()).collect();
        let answer = connect_two_groups(cost);
        total += answer;
        check = mix(check, answer);
    }
    println(f"{count} problems of up to {most} by {most}: total {total}, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[Vec[i32]]] = [
        [[15, 96], [36, 2]],
        [[1, 3, 5], [4, 1, 1], [1, 5, 3]],
        [[2, 5, 1], [3, 4, 7], [8, 1, 2], [6, 2, 4], [3, 8, 8]],
        [[7]],
        [[0, 100], [100, 0], [50, 50]],
        Vec.filled(12, Vec.filled(12, 1)),
        Vec.filled(12, [5]),
    ];
    for cost in examples.iter() {
        let shown = if cost.len() > 5 { f"[[{cost[0][0]}; {cost[0].len()}]; {cost.len()}]" } else { f"{cost}" };
        println(f"{shown} -> {connect_two_groups(cost)}");
    }
    let mut seed = 1595;
    batch(3000, 4, mut seed);
    batch(300, 8, mut seed);
    batch(10, 12, mut seed);
}
