// LeetCode #1595: Minimum Cost to Connect Two Groups of Points -- the
// bench: the ★ arm on 200 problems of 12 points against 12, costs from 0
// to 100, all drawn first.
//
// The ★ arm: one edge per first point over a mask of the second group's
// points joined, then each point still alone takes its cheapest edge.

fn connect_two_groups(cost: Vec[Vec[i32]]) -> i32 {
    let first = cost.len();
    let second = cost[0].len();
    let full = 1 << second;
    let cheapest: Vec[i32] = (0..second).map(|j| (0..first).map(|i| cost[i][j]).min().unwrap()).collect();
    let mut best = Vec.filled(full, i32.MAX);
    best[0] = 0;
    for i in 0..first {
        let mut next = Vec.filled(full, i32.MAX);
        for mask in 0..full {
            if best[mask] == i32.MAX {
                continue;
            }
            for j in 0..second {
                let joined = mask | 1 << j;
                next[joined] = next[joined].min(best[mask] + cost[i][j]);
            }
        }
        best = next;
    }
    let mut answer = i32.MAX;
    for mask in 0..full {
        if best[mask] == i32.MAX {
            continue;
        }
        let mut total = best[mask];
        for j in 0..second {
            if mask >> j & 1 == 0 {
                total += cheapest[j];
            }
        }
        answer = answer.min(total);
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1595;
    let mut problems: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..200 {
        let cost: Vec[Vec[i32]] = (0..12).map(|_| (0..12).map(|_| (next_random(mut seed) % 101) as i32).collect()).collect();
        problems.push(cost);
    }
    let mut check = 0;
    let mut total = 0;
    for cost in problems.iter() {
        let answer = connect_two_groups(cost);
        total += answer;
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"200 problems of 12 by 12: total {total}, checksum {check}");
}
