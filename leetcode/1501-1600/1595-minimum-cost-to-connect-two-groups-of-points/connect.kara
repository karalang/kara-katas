// LeetCode #1595: Minimum Cost to Connect Two Groups of Points -- the ★ arm.
//
// The first group in order, with the set of the second group's points
// already joined as a mask: each first point takes one edge, to any
// second point, and at the end every second point still alone takes its
// cheapest edge. A first point never needs a second edge of its own:
// that edge serves only the second point, which its cheapest edge serves
// as well. O(n1 n2 2^n2).

fn connect_two_groups(cost: Vec[Vec[i32]]) -> i32 {
    let first = cost.len();
    let second = cost[0].len();
    let full = 1 << second;
    let cheapest: Vec[i32] = (0..second).map(|j| (0..first).map(|i| cost[i][j]).min().unwrap()).collect();
    let mut best = Vec.filled(full, i32.MAX);
    best[0] = 0;
    for i in 0..first {
        let mut next = Vec.filled(full, i32.MAX);
        for mask in 0..full {
            if best[mask] == i32.MAX {
                continue;
            }
            for j in 0..second {
                let joined = mask | 1 << j;
                next[joined] = next[joined].min(best[mask] + cost[i][j]);
            }
        }
        best = next;
    }
    let mut answer = i32.MAX;
    for mask in 0..full {
        if best[mask] == i32.MAX {
            continue;
        }
        let mut total = best[mask];
        for j in 0..second {
            if mask >> j & 1 == 0 {
                total += cheapest[j];
            }
        }
        answer = answer.min(total);
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let first = next_random(mut seed) % most + 1;
        let second = next_random(mut seed) % first + 1;
        let cost: Vec[Vec[i32]] = (0..first).map(|_| (0..second).map(|_| (next_random(mut seed) % 101) as i32).collect()).collect();
        let answer = connect_two_groups(cost);
        total += answer;
        check = mix(check, answer);
    }
    println(f"{count} problems of up to {most} by {most}: total {total}, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[Vec[i32]]] = [
        [[15, 96], [36, 2]],
        [[1, 3, 5], [4, 1, 1], [1, 5, 3]],
        [[2, 5, 1], [3, 4, 7], [8, 1, 2], [6, 2, 4], [3, 8, 8]],
        [[7]],
        [[0, 100], [100, 0], [50, 50]],
        Vec.filled(12, Vec.filled(12, 1)),
        Vec.filled(12, [5]),
    ];
    for cost in examples.iter() {
        let shown = if cost.len() > 5 { f"[[{cost[0][0]}; {cost[0].len()}]; {cost.len()}]" } else { f"{cost}" };
        println(f"{shown} -> {connect_two_groups(cost)}");
    }
    let mut seed = 1595;
    batch(3000, 4, mut seed);
    batch(300, 8, mut seed);
    batch(10, 12, mut seed);
}
