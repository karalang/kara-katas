// LeetCode #1595: Minimum Cost to Connect Two Groups of Points -- a Rust
// solution as LeetCode's Rust users write it (`impl Solution`, a
// `vec![vec![i32::MAX; 1 << n]; m + 1]` table over `usize` masks, the
// column minima in a `Vec<i32>`), carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn connect_two_groups(cost: Vec[Vec[i32]]) -> i32 {
        let m = cost.len();
        let n = cost[0].len();
        let mut min_col = Vec.filled(n, i32.MAX);
        for j in 0..n {
            for i in 0..m {
                min_col[j] = min_col[j].min(cost[i][j]);
            }
        }
        let full = 1 << n;
        let mut dp = Vec.filled(m + 1, Vec.filled(full, i32.MAX));
        dp[0][0] = 0;
        for i in 0..m {
            for mask in 0..full {
                if dp[i][mask] == i32.MAX {
                    continue;
                }
                for j in 0..n {
                    let next = mask | (1 << j);
                    dp[i + 1][next] = dp[i + 1][next].min(dp[i][mask] + cost[i][j]);
                }
            }
        }
        let mut ans = i32.MAX;
        for mask in 0..full {
            if dp[m][mask] == i32.MAX {
                continue;
            }
            let mut extra: i32 = 0;
            for j in 0..n {
                if mask & (1 << j) == 0 {
                    extra += min_col[j];
                }
            }
            ans = ans.min(dp[m][mask] + extra);
        }
        ans
    }
}

fn connect_two_groups(cost: Vec[Vec[i32]]) -> i32 {
    Solution.connect_two_groups(cost)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let first = next_random(mut seed) % most + 1;
        let second = next_random(mut seed) % first + 1;
        let cost: Vec[Vec[i32]] = (0..first).map(|_| (0..second).map(|_| (next_random(mut seed) % 101) as i32).collect()).collect();
        let answer = connect_two_groups(cost);
        total += answer;
        check = mix(check, answer);
    }
    println(f"{count} problems of up to {most} by {most}: total {total}, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[Vec[i32]]] = [
        [[15, 96], [36, 2]],
        [[1, 3, 5], [4, 1, 1], [1, 5, 3]],
        [[2, 5, 1], [3, 4, 7], [8, 1, 2], [6, 2, 4], [3, 8, 8]],
        [[7]],
        [[0, 100], [100, 0], [50, 50]],
        Vec.filled(12, Vec.filled(12, 1)),
        Vec.filled(12, [5]),
    ];
    for cost in examples.iter() {
        let shown = if cost.len() > 5 { f"[[{cost[0][0]}; {cost[0].len()}]; {cost.len()}]" } else { f"{cost}" };
        println(f"{shown} -> {connect_two_groups(cost)}");
    }
    let mut seed = 1595;
    batch(3000, 4, mut seed);
    batch(300, 8, mut seed);
    batch(10, 12, mut seed);
}
