// LeetCode #1551: Minimum Operations to Make Array Equal -- LeetCode's Rust
// template as karac fix left it: the ★ arm's sum as an iterator over `i32`.

struct Solution {}

impl Solution {
    pub fn min_operations(n: i32) -> i32 {
        (0..n / 2).map(|i| n - 2 * i - 1).sum()
    }
}

fn min_operations(n: i64) -> i64 {
    Solution.min_operations(n as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    for n in [3, 6, 1, 2, 4, 5, 9999, 10000] {
        println(f"n = {n} -> {min_operations(n)}");
    }
    let mut check = 0;
    let mut total = 0;
    for n in 1..=10000 {
        let answer = min_operations(n);
        total += answer;
        check = mix(check, answer);
    }
    println(f"n from 1 to 10000: total {total}, checksum {check}");
}
