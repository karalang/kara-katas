// LeetCode #1551: Minimum Operations to Make Array Equal -- the closed
// form: the lower half's distances are n - 1, n - 3, .., down to 1 or 2,
// which add up to n * n / 4 rounded down. O(1)

fn min_operations(n: i64) -> i64 {
    n * n / 4
}

// ---- the harness: the same in every arm --------------------------------

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    for n in [3, 6, 1, 2, 4, 5, 9999, 10000] {
        println(f"n = {n} -> {min_operations(n)}");
    }
    let mut check = 0;
    let mut total = 0;
    for n in 1..=10000 {
        let answer = min_operations(n);
        total += answer;
        check = mix(check, answer);
    }
    println(f"n from 1 to 10000: total {total}, checksum {check}");
}
