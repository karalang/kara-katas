// LeetCode #1551: Minimum Operations to Make Array Equal -- the array built
// as the statement gives it, its mean taken, and every value's distance
// from the mean added up and halved: each operation closes two units of
// distance, one on each side. O(n)

fn min_operations(n: i64) -> i64 {
    let arr: Vec[i64] = (0..n).map(|i| 2 * i + 1).collect();
    let mean = arr.iter().sum() / n;
    arr.iter().map(|a| (a - mean).abs()).sum() / 2
}

// ---- the harness: the same in every arm --------------------------------

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    for n in [3, 6, 1, 2, 4, 5, 9999, 10000] {
        println(f"n = {n} -> {min_operations(n)}");
    }
    let mut check = 0;
    let mut total = 0;
    for n in 1..=10000 {
        let answer = min_operations(n);
        total += answer;
        check = mix(check, answer);
    }
    println(f"n from 1 to 10000: total {total}, checksum {check}");
}
