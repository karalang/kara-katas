// LeetCode #1551: Minimum Operations to Make Array Equal -- the ★ arm: the
// values 1, 3, .., 2n - 1 average n, and every operation moves one unit
// from a value above it to one below, so the answer is how far the lower
// half sits below n, added up place by place. O(n)

fn min_operations(n: i64) -> i64 {
    let mut operations = 0;
    for i in 0..n / 2 {
        operations += n - (2 * i + 1);
    }
    operations
}

// ---- the harness: the same in every arm --------------------------------

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    for n in [3, 6, 1, 2, 4, 5, 9999, 10000] {
        println(f"n = {n} -> {min_operations(n)}");
    }
    let mut check = 0;
    let mut total = 0;
    for n in 1..=10000 {
        let answer = min_operations(n);
        total += answer;
        check = mix(check, answer);
    }
    println(f"n from 1 to 10000: total {total}, checksum {check}");
}
