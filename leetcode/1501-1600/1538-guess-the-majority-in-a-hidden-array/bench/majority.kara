// LeetCode #1538: Guess the Majority in a Hidden Array -- bench: the ★
// arm (every bit compared with bit 0, n queries) over 100 readers of 5 to
// 50000 bits, built once, each asked 20 times.

fn guess_majority(reader: ArrayReader) -> i64 {
    let n = reader.length();
    let q0123 = reader.query(0, 1, 2, 3);
    let q1234 = reader.query(1, 2, 3, 4);
    // same[i]: bit i is bit 0's
    let mut same = Vec.filled(n, true);
    same[1] = reader.query(0, 2, 3, 4) == q1234;
    same[2] = reader.query(0, 1, 3, 4) == q1234;
    same[3] = reader.query(0, 1, 2, 4) == q1234;
    same[4] = q1234 == q0123;
    for i in 5..n {
        same[i] = reader.query(1, 2, 3, i) == q0123;
    }
    let mut with_zero = 0;
    let mut other = -1;
    for i in 0..n {
        if same[i] {
            with_zero += 1;
        } else {
            other = i;
        }
    }
    if with_zero * 2 > n {
        0
    } else if with_zero * 2 < n {
        other
    } else {
        -1
    }
}

// The judge's side, with LeetCode's `i32` API: the hidden bits and a count
// of the queries. `shared` because the API queries through a plain borrow
// of the reader, as LeetCode's `&self` does, and counting is the judge's
// business.
pub shared struct ArrayReader {
    nums: Vec[i64],
    mut calls: i64,
}

impl ArrayReader {
    // 4 if the four bits at a < b < c < d are equal, 2 if three are, 0 if
    // two are 0 and two are 1
    pub fn query(self, a: i32, b: i32, c: i32, d: i32) -> i32 {
        self.calls += 1;
        let ones = self.nums[a] + self.nums[b] + self.nums[c] + self.nums[d];
        if ones == 0 or ones == 4 {
            4
        } else if ones == 2 {
            0
        } else {
            2
        }
    }

    pub fn length(self) -> i32 {
        self.nums.len() as i32
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1538;
    let mut readers: Vec[ArrayReader] = Vec.new();
    for _ in 0..100 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 49996 + 5;
        let chance = next_random(mut seed) % 101;
        let mut nums = Vec.new();
        for _ in 0..n {
            nums.push(if next_random(mut seed) % 100 < chance { 1 } else { 0 });
        }
        readers.push(ArrayReader { nums, calls: 0 });
    }
    let mut check = 0;
    for _ in 0..20 {
        for reader in readers.iter() {
            check = mix(check, guess_majority(reader));
        }
    }
    let mut calls = 0;
    for reader in readers.iter() {
        calls += reader.calls;
    }
    println(f"20 passes over 100 readers of up to 50000 bits: checksum {check}, {calls} calls");
}
