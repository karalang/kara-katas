// LeetCode #1538: Guess the Majority in a Hidden Array -- the
// differential.
//
// Four arms against the statement read literally, on 3000 arrays of 5 to
// 40 bits, each with its own chance of a 1, with six properties. Every
// random choice is drawn before any arm answers. An arm's answer is judged
// as the bit it points at (-1 for a tie it calls, -2 for a wrong answer).
//
// P1  the judged answer is the statement read literally
// P2  the arm asks at most n + 1 queries (the problem allows 2n)
// P3  every bit flipped flips the judged answer, and keeps a tie
// P4  the bits reversed keep the judged answer
// P5  one more of the winning bit (a 1 after a tie) makes that bit win
// P6  each arm agrees with at least two of the other three

// ---- majority.kara: the ★ arm: every bit compared with bit 0

fn star_arm(reader: ArrayReader) -> i64 {
    let n = reader.length();
    let q0123 = reader.query(0, 1, 2, 3);
    let q1234 = reader.query(1, 2, 3, 4);
    // same[i]: bit i is bit 0's
    let mut same = Vec.filled(n, true);
    same[1] = reader.query(0, 2, 3, 4) == q1234;
    same[2] = reader.query(0, 1, 3, 4) == q1234;
    same[3] = reader.query(0, 1, 2, 4) == q1234;
    same[4] = q1234 == q0123;
    for i in 5..n {
        same[i] = reader.query(1, 2, 3, i) == q0123;
    }
    let mut with_zero = 0;
    let mut other = -1;
    for i in 0..n {
        if same[i] {
            with_zero += 1;
        } else {
            other = i;
        }
    }
    if with_zero * 2 > n {
        0
    } else if with_zero * 2 < n {
        other
    } else {
        -1
    }
}

// ---- majority_last.kara: every bit compared with the last

fn last_arm(reader: ArrayReader) -> i64 {
    let n = reader.length();
    let (a, b, c, last) = (n - 4, n - 3, n - 2, n - 1);
    let t = reader.query(a, b, c, last);
    // same[i]: bit i is the last bit
    let mut same = Vec.filled(n, true);
    for i in 0..a {
        same[i] = reader.query(i, a, b, c) == t;
    }
    let u = reader.query(n - 5, a, b, c);
    same[a] = reader.query(n - 5, b, c, last) == u;
    same[b] = reader.query(n - 5, a, c, last) == u;
    same[c] = reader.query(n - 5, a, b, last) == u;
    let with_last = same.iter().filter(|s| *s).count();
    if with_last * 2 > n {
        last
    } else if with_last * 2 < n {
        same.iter().position(|s| not *s).unwrap()
    } else {
        -1
    }
}

// ---- majority_iter.kara: the ★ arm with iterators

fn iter_arm(reader: ArrayReader) -> i64 {
    let n = reader.length();
    let q0123 = reader.query(0, 1, 2, 3);
    let q1234 = reader.query(1, 2, 3, 4);
    let first = [
        true,
        reader.query(0, 2, 3, 4) == q1234,
        reader.query(0, 1, 3, 4) == q1234,
        reader.query(0, 1, 2, 4) == q1234,
        q1234 == q0123,
    ];
    let same: Vec[bool] = first
        .iter()
        .cloned()
        .chain((5..n).map(|i| reader.query(1, 2, 3, i) == q0123))
        .collect();
    let with_zero = same.iter().filter(|s| *s).count();
    if with_zero * 2 > n {
        0
    } else if with_zero * 2 < n {
        same.iter().position(|s| not *s).unwrap()
    } else {
        -1
    }
}

// ---- majority_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn guess_majority(reader: ArrayReader) -> i32 {
        let n = reader.length();
        let q0123 = reader.query(0, 1, 2, 3);
        let q1234 = reader.query(1, 2, 3, 4);
        let mut same = Vec.filled(n, true);
        same[1] = reader.query(0, 2, 3, 4) == q1234;
        same[2] = reader.query(0, 1, 3, 4) == q1234;
        same[3] = reader.query(0, 1, 2, 4) == q1234;
        same[4] = q1234 == q0123;
        for i in 5..n {
            same[i] = reader.query(1, 2, 3, i) == q0123;
        }
        let count = same.iter().filter(|s| s).count() as i32;
        if count * 2 > n {
            0
        } else if count * 2 < n {
            same.iter().position(|s| not s).unwrap() as i32
        } else {
            -1
        }
    }
}

fn solution_arm(reader: ArrayReader) -> i64 {
    Solution.guess_majority(reader)
}

// ---- the harness ----------------------------------------------------------

// The judge's side, with LeetCode's `i32` API: the hidden bits and a count
// of the queries. `shared` because the API queries through a plain borrow
// of the reader, as LeetCode's `&self` does, and counting is the judge's
// business.
pub shared struct ArrayReader {
    nums: Vec[i64],
    mut calls: i64,
}

impl ArrayReader {
    // 4 if the four bits at a < b < c < d are equal, 2 if three are, 0 if
    // two are 0 and two are 1
    pub fn query(self, a: i32, b: i32, c: i32, d: i32) -> i32 {
        self.calls += 1;
        let ones = self.nums[a] + self.nums[b] + self.nums[c] + self.nums[d];
        if ones == 0 or ones == 4 {
            4
        } else if ones == 2 {
            0
        } else {
            2
        }
    }

    pub fn length(self) -> i32 {
        self.nums.len() as i32
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(which: i64, reader: ArrayReader) -> i64 {
    if which == 0 {
        star_arm(reader)
    } else if which == 1 {
        last_arm(reader)
    } else if which == 2 {
        iter_arm(reader)
    } else {
        solution_arm(reader)
    }
}

fn arm_name(which: i64) -> String {
    ["star", "last", "iter", "solution"][which].to_string()
}

// the more frequent bit the arm's answer points at, -1 for a tie it calls,
// -2 for an answer that is wrong either way; and the queries it made
fn verdict(which: i64, nums: Vec[i64]) -> (i64, i64) {
    let reader = ArrayReader { nums: nums.clone(), calls: 0 };
    let answer = arm(which, reader);
    let ones: i64 = nums.iter().sum();
    let zeros = nums.len() - ones;
    let majority = if ones > zeros { 1 } else if zeros > ones { 0 } else { -1 };
    let said = if answer == -1 {
        if majority == -1 { -1 } else { -2 }
    } else if answer < 0 or answer >= nums.len() or nums[answer] != majority {
        -2
    } else {
        majority
    };
    (said, reader.calls)
}

// ---- the statement read literally: the bits counted outright, the more
// frequent one, or -1 when there are as many of each

fn literal(nums: Vec[i64]) -> i64 {
    let mut ones = 0;
    let mut zeros = 0;
    for b in nums.iter() {
        if b == 1 {
            ones += 1;
        } else {
            zeros += 1;
        }
    }
    if ones > zeros { 1 } else if zeros > ones { 0 } else { -1 }
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15380;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 36 + 5;
        let chance = next_random(mut seed) % 101;
        let mut nums = Vec.new();
        for _ in 0..n {
            nums.push(if next_random(mut seed) % 100 < chance { 1 } else { 0 });
        }
        cases.push(nums);
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for p in 0..problems {
        let nums = cases[p].clone();
        let n = nums.len();
        let truth = literal(nums.clone());
        let flipped: Vec[i64] = nums.iter().map(|b| 1 - b).collect();
        let mut reversed = nums.clone();
        reversed.reverse();
        let tipping = if truth == -1 { 1 } else { truth };
        let mut tipped = nums.clone();
        tipped.push(tipping);
        let mut answers = Vec.new();
        for a in 0..arms {
            let (said, calls) = verdict(a, nums.clone());
            answers.push(said);
            check = (check * 31 + said + calls + 3) % 1000000007;
            let flipped_said = verdict(a, flipped.clone()).0;
            let failed = [
                said != truth,
                calls > n + 1,
                flipped_said != (if said == -1 { -1 } else { 1 - said }),
                verdict(a, reversed.clone()).0 != said,
                verdict(a, tipped.clone()).0 != tipping,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
