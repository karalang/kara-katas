// LeetCode #1536: Minimum Swaps to Arrange a Binary Grid -- bench: the ★
// arm over 50 random 200 x 200 grids, built once and answered 50 times.

fn min_swaps(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut zeros: Vec[i64] = Vec.new();
    for row in grid.iter() {
        let mut count = 0;
        while count < n and row[n - 1 - count] == 0 {
            count += 1;
        }
        zeros.push(count);
    }
    let mut swaps = 0;
    for i in 0..n {
        let need = n - 1 - i;
        let mut j = i;
        while j < n and zeros[j] < need {
            j += 1;
        }
        if j == n {
            return -1;
        }
        while j > i {
            zeros.swap(j, j - 1);
            j -= 1;
            swaps += 1;
        }
    }
    swaps
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// an n x n grid whose row i ends in zeros[i] zeros, with random bits
// before its last 1. Half the grids take zeros from a shuffle of 0 to
// n - 1, each maybe one more, so most of them can be arranged; the other
// half draw each row's count from 0 to n.
fn grid(n: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut zeros: Vec[i64] = (0..n).collect();
    if next_random(mut seed) % 2 == 0 {
        for i in (1..n).rev() {
            let j = next_random(mut seed) % (i + 1);
            zeros.swap(i, j);
        }
        for i in 0..n {
            zeros[i] = (zeros[i] + next_random(mut seed) % 2).min(n);
        }
    } else {
        for i in 0..n {
            zeros[i] = next_random(mut seed) % (n + 1);
        }
    }
    let mut rows = Vec.new();
    for i in 0..n {
        let mut row = Vec.filled(n, 0);
        if zeros[i] < n {
            row[n - 1 - zeros[i]] = 1;
            for c in 0..n - 1 - zeros[i] {
                row[c] = next_random(mut seed) % 2;
            }
        }
        rows.push(row);
    }
    rows
}

fn main() {
    let mut seed = 1536;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..50 {
        grids.push(grid(200, mut seed));
    }
    let mut check = 0;
    for _ in 0..50 {
        for g in grids.iter() {
            check = mix(check, min_swaps(g) + 1);
        }
    }
    println(f"50 passes over 50 grids of 200 rows: checksum {check}");
}
