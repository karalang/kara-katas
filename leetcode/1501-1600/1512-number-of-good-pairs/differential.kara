// LeetCode #1512: Number of Good Pairs -- the differential.
//
// Four arms against the statement read literally, on 3000 arrays, with six
// properties.
//
// P1  the answer is the statement read literally: every pair i < j with
//     nums[i] == nums[j] counted
// P2  the numbers in another order leave the answer
// P3  every number mapped one to one (x to 101 - x) leaves the answer
// P4  one more copy of a number adds as many pairs as it had copies
// P5  the array written twice over has 4 a + c pairs, c the array's
//     length (each copy pairs with its own twin, and each pair four ways)
// P6  each arm agrees with at least two of the other three

// ---- pairs.kara: the ★ arm: earlier copies counted in a table
fn star_arm(nums: Vec[i64]) -> i64 {
    let mut seen: Vec[i64] = Vec.filled(101, 0);
    let mut pairs = 0;
    for x in nums.iter() {
        pairs += seen[x];
        seen[x] += 1;
    }
    pairs
}

// ---- pairs_map.kara: the same walk with a Map
fn map_arm(nums: Vec[i64]) -> i64 {
    let mut seen: Map[i64, i64] = Map.new();
    let mut pairs = 0;
    for x in nums.iter() {
        let before = seen.get(x).unwrap_or(0);
        pairs += before;
        seen.insert(x, before + 1);
    }
    pairs
}

// ---- pairs_sort.kara: runs of a sorted copy
fn sort_arm(nums: Vec[i64]) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut pairs = 0;
    let mut start = 0;
    for i in 1..sorted.len() + 1 {
        if i == sorted.len() or sorted[i] != sorted[start] {
            let run = i - start;
            pairs += run * (run - 1) / 2;
            start = i;
        }
    }
    pairs
}

// ---- pairs_iter.kara: fold into a Map, sum each count's pairs
fn iter_arm(nums: Vec[i64]) -> i64 {
    let counts: Map[i64, i64] = nums.iter().fold(Map.new(), |acc, x| {
        let mut m = acc;
        let c = m.get(x).unwrap_or(0);
        m.insert(x, c + 1);
        m
    });
    counts.values().map(|c| c * (c - 1) / 2).sum()
}

// ---- the statement read literally ----------------------------------------

fn literal(nums: Vec[i64]) -> i64 {
    let mut pairs = 0;
    for i in 0..nums.len() {
        for j in i + 1..nums.len() {
            if nums[i] == nums[j] {
                pairs += 1;
            }
        }
    }
    pairs
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn arm(k: i64, nums: Vec[i64]) -> i64 {
    if k == 0 {
        star_arm(nums)
    } else if k == 1 {
        map_arm(nums)
    } else if k == 2 {
        sort_arm(nums)
    } else {
        iter_arm(nums)
    }
}

fn arm_name(k: i64) -> String {
    ["star", "map", "sort", "iter"][k].to_string()
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15120;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first
        let n = next_random(mut seed) % 12 + 1;
        let top = next_random(mut seed) % 6 + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % top + 1);
        }
        let mut shuffled = nums.clone();
        for i in (1..n).rev() {
            shuffled.swap(i, next_random(mut seed) % (i + 1));
        }
        let mapped: Vec[i64] = nums.iter().map(|x| 101 - x).collect();
        let picked = nums[next_random(mut seed) % n];
        let copies = nums.iter().filter(|x| *x == picked).count();
        let mut grown = nums.clone();
        grown.insert(next_random(mut seed) % (n + 1), picked);
        let mut twice = nums.clone();
        twice.extend(nums.iter());

        let truth = literal(nums);
        let mut answers: Vec[i64] = Vec.new();
        for k in 0..arms {
            let answer = arm(k, nums);
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            if arm(k, shuffled) != answer {
                fails[2] += 1;
            }
            if arm(k, mapped) != answer {
                fails[3] += 1;
            }
            if arm(k, grown) != answer + copies {
                fails[4] += 1;
            }
            if arm(k, twice) != 4 * answer + n {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(k)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for k in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != k and answers[other] == answers[k] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, answers[0]);
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
