// LeetCode #1512: Number of Good Pairs -- the ★ arm: walking left to
// right, each number pairs with every earlier copy of itself, so add how
// many copies have been seen, then count it. Values are at most 100, so
// the counts sit in a table. O(n).

fn num_identical_pairs(nums: Vec[i64]) -> i64 {
    let mut seen: Vec[i64] = Vec.filled(101, 0);
    let mut pairs = 0;
    for x in nums.iter() {
        pairs += seen[x];
        seen[x] += 1;
    }
    pairs
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` arrays of 1 to `most` numbers from 1 to `top`.
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % top + 1);
        }
        check = mix(check, num_identical_pairs(nums));
    }
    check
}

fn main() {
    println(f"[1, 2, 3, 1, 1, 3] -> {num_identical_pairs([1, 2, 3, 1, 1, 3])}");
    println(f"[1, 1, 1, 1] -> {num_identical_pairs([1, 1, 1, 1])}");
    println(f"[1, 2, 3] -> {num_identical_pairs([1, 2, 3])}");
    println(f"[7] -> {num_identical_pairs([7])}");
    let same: Vec[i64] = Vec.filled(100, 100);
    println(f"100 copies of 100 -> {num_identical_pairs(same)}");
    let mut seed = 1512;
    println(f"3000 arrays of 1 to 100 numbers up to 10: checksum {batch(3000, 100, 10, mut seed)}");
    println(f"300 arrays of 1 to 100 numbers up to 100: checksum {batch(300, 100, 100, mut seed)}");
    println(f"3 arrays of 1 to 100000 numbers up to 100: checksum {batch(3, 100000, 100, mut seed)}");
}
