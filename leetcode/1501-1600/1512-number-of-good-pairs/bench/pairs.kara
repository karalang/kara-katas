// LeetCode #1512: Number of Good Pairs -- the bench: 50 arrays of 200000
// numbers from 1 to 100 built once, then each counted four times by the
// ★ arm: each number pairs with every earlier copy, counted in a table.

fn num_identical_pairs(nums: Vec[i64]) -> i64 {
    let mut seen: Vec[i64] = Vec.filled(101, 0);
    let mut pairs = 0;
    for x in nums.iter() {
        pairs += seen[x];
        seen[x] += 1;
    }
    pairs
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1512;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..50 {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..200000 {
            nums.push(next_random(mut seed) % 100 + 1);
        }
        arrays.push(nums);
    }
    let mut check = 0;
    for _ in 0..4 {
        for nums in arrays.iter() {
            check = (check * 31 + num_identical_pairs(nums) + 1) % 1000000007;
        }
    }
    println(f"200 counts over 50 arrays of 200000 numbers: checksum {check}");
}
