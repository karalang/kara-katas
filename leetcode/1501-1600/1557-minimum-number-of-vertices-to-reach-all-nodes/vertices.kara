// LeetCode #1557: Minimum Number of Vertices to Reach All Nodes -- the ★
// arm: a node with an edge into it is reached from wherever that edge
// starts, and in an acyclic graph following edges backwards always ends at
// a node with none, so the nodes with no edge in are exactly the ones
// every answer needs and all an answer needs. Each edge marks its end in a
// `Vec[bool]`; the unmarked nodes are the answer. O(n + e)

fn find_smallest_set_of_vertices(n: i64, edges: Vec[(i64, i64)]) -> Vec[i64] {
    let mut reached = Vec.filled(n, false);
    for (_, to) in edges.iter() {
        reached[to] = true;
    }
    let mut sources = Vec.new();
    for v in 0..n {
        if not reached[v] {
            sources.push(v);
        }
    }
    sources
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// any order is accepted, so every answer is read sorted
fn answer(n: i64, edges: Vec[(i64, i64)]) -> Vec[i64] {
    let mut found = find_smallest_set_of_vertices(n, edges);
    found.sort();
    found
}

// `count` acyclic graphs of 2 to `most` nodes, each edge from earlier to
// later in a random order of the nodes, 1 to `wide` times n edges drawn
fn batch(count: i64, most: i64, wide: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most - 1) + 2;
        let mut order: Vec[i64] = (0..n).collect();
        for i in (1..n).rev() {
            let j = next_random(mut seed) % (i + 1);
            order.swap(i, j);
        }
        let draws = next_random(mut seed) % (wide * n) + 1;
        let mut taken: Set[(i64, i64)] = Set.new();
        let mut edges = Vec.new();
        for _ in 0..draws {
            let a = next_random(mut seed) % n;
            let b = next_random(mut seed) % n;
            if a < b and taken.insert((a, b)) {
                edges.push((order[a], order[b]));
            }
        }
        if edges.is_empty() {
            edges.push((order[0], order[1]));
        }
        let found = answer(n, edges);
        total += found.len();
        for v in found.iter() {
            check = mix(check, v);
        }
        check = mix(check, -1);
    }
    println(f"{count} graphs of up to {most} nodes: {total} sources, checksum {check}");
}

fn main() {
    let examples: Vec[(i64, Vec[(i64, i64)])] = [
        (6, [(0, 1), (0, 2), (2, 5), (3, 4), (4, 2)]),
        (5, [(0, 1), (2, 1), (3, 1), (1, 4), (2, 4)]),
        (2, [(1, 0)]),
        (3, [(0, 1), (1, 2)]),
        (4, [(0, 3), (1, 3), (2, 3)]),
        (4, [(3, 0), (3, 1), (3, 2)]),
        (5, [(0, 1), (2, 3)]),
    ];
    for (n, edges) in examples.iter() {
        println(f"n = {n}, edges {edges} -> {answer(n, edges.clone())}");
    }
    let mut seed = 1557;
    batch(3000, 8, 2, mut seed);
    batch(300, 1000, 3, mut seed);
    batch(30, 100000, 1, mut seed);
}
