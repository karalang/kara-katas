// LeetCode #1593: Split a String Into the Max Number of Unique Substrings
// -- the bench: the ★ arm on 20000 strings of 16 letters from a to c,
// all drawn first.
//
// The ★ arm: backtracking over a `Set` of the pieces used, a branch
// stopped when one piece per letter left cannot beat the best.

fn split_from(s: Str, at: i64, used: mut ref Set[String], best: mut ref i64) {
    if at == s.len() {
        *best = (*best).max(used.len());
        return;
    }
    if used.len() + (s.len() - at) <= *best {
        return;
    }
    for end in at + 1..s.len() + 1 {
        let piece = s[at..end].to_string();
        if not used.contains(piece) {
            used.insert(piece.clone());
            split_from(s, end, mut used, mut best);
            used.remove(piece);
        }
    }
}

fn max_unique_split(s: String) -> i32 {
    let mut used: Set[String] = Set.new();
    let mut best = 0;
    split_from(s, 0, mut used, mut best);
    best as i32
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1593;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..20000 {
        let b: Vec[u8] = (0..16).map(|_| b'a' + (next_random(mut seed) % 3) as u8).collect();
        strings.push(String.from_utf8(b).unwrap());
    }
    let mut check = 0;
    let mut total = 0;
    for s in strings.iter() {
        let answer = max_unique_split(s);
        total += answer;
        check = mix(check, answer);
    }
    println(f"20000 strings of 16 letters: total {total}, checksum {check}");
}
