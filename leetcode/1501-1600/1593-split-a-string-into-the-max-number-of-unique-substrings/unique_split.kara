// LeetCode #1593: Split a String Into the Max Number of Unique Substrings
// -- the ★ arm.
//
// Backtracking: from each place, every next piece not already used is
// put in a `Set` and the rest split the same way; a branch stops early
// when even one piece per letter left cannot beat the best. O(2^n n).

fn split_from(s: Str, at: i64, used: mut ref Set[String], best: mut ref i64) {
    if at == s.len() {
        *best = (*best).max(used.len());
        return;
    }
    if used.len() + (s.len() - at) <= *best {
        return;
    }
    for end in at + 1..s.len() + 1 {
        let piece = s[at..end].to_string();
        if not used.contains(piece) {
            used.insert(piece.clone());
            split_from(s, end, mut used, mut best);
            used.remove(piece);
        }
    }
}

fn max_unique_split(s: String) -> i32 {
    let mut used: Set[String] = Set.new();
    let mut best = 0;
    split_from(s, 0, mut used, mut best);
    best as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn batch(count: i64, least: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = least + next_random(mut seed) % (most - least + 1);
        let b: Vec[u8] = (0..n).map(|_| b'a' + (next_random(mut seed) % letters) as u8).collect();
        let answer = max_unique_split(String.from_utf8(b).unwrap());
        total += answer;
        check = mix(check, answer);
    }
    println(f"{count} strings of {least} to {most} letters from {letters}: total {total}, checksum {check}");
}

fn main() {
    let examples = ["ababccc", "aba", "aa", "a", "abcdefghijklmnop", "aaaaaaaaaaaaaaaa", "abab", "wwwzfvedwfvhsww"];
    for s in examples.iter() {
        println(f"\"{s}\" -> {max_unique_split(s.to_string())}");
    }
    let mut seed = 1593;
    batch(3000, 1, 8, 2, mut seed);
    batch(300, 1, 12, 3, mut seed);
    batch(30, 16, 16, 2, mut seed);
}
