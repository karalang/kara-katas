// LeetCode #1593: Split a String Into the Max Number of Unique Substrings
// -- a Rust solution as LeetCode's Rust users write it (`impl Solution`,
// a recursive `fn dfs` with `&str`, `&mut HashSet<String>` and
// `&mut i32`, the bound `seen.len() + rest <= best`), carried to Kāra by
// `karac fix`.

struct Solution {}

fn dfs(s: Str, start: i64, seen: mut ref Set[String], best: mut ref i32) {
    if start == s.len() {
        *best = (*best).max(seen.len() as i32);
        return;
    }
    if seen.len() + (s.len() - start) <= *best {
        return;
    }
    for end in start + 1..=s.len() {
        let sub = s[start..end];
        if not seen.contains(sub) {
            seen.insert(sub.to_string());
            dfs(s, end, mut seen, mut best);
            seen.remove(sub);
        }
    }
}

impl Solution {
    pub fn max_unique_split(s: String) -> i32 {
        let mut seen = Set.new();
        let mut best: i32 = 0;
        dfs(s, 0, mut seen, mut best);
        best
    }
}

fn max_unique_split(s: String) -> i32 {
    Solution.max_unique_split(s)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn batch(count: i64, least: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = least + next_random(mut seed) % (most - least + 1);
        let b: Vec[u8] = (0..n).map(|_| b'a' + (next_random(mut seed) % letters) as u8).collect();
        let answer = max_unique_split(String.from_utf8(b).unwrap());
        total += answer;
        check = mix(check, answer);
    }
    println(f"{count} strings of {least} to {most} letters from {letters}: total {total}, checksum {check}");
}

fn main() {
    let examples = ["ababccc", "aba", "aa", "a", "abcdefghijklmnop", "aaaaaaaaaaaaaaaa", "abab", "wwwzfvedwfvhsww"];
    for s in examples.iter() {
        println(f"\"{s}\" -> {max_unique_split(s.to_string())}");
    }
    let mut seed = 1593;
    batch(3000, 1, 8, 2, mut seed);
    batch(300, 1, 12, 3, mut seed);
    batch(30, 16, 16, 2, mut seed);
}
