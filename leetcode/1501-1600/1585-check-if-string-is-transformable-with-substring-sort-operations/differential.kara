// LeetCode #1585: Check If String Is Transformable With Substring Sort
// Operations -- the differential.
//
// Four arms against the statement read literally, on 3000 problems of 1
// to 6 digits from 0 to 2, `t` drawn from `s` by up to two random sorts,
// half the time a random swap and a quarter of the time one digit
// redrawn, with six properties. Every random choice is drawn before any
// arm answers.
//
// P1  the answer is the statement read literally
// P2  each digit d made 9 - d and both strings reversed leave the answer
// P3  a 9 added at the end of both leaves the answer
// P4  a 0 added at the front of both leaves the answer
// P5  every digit raised by 5 leaves the answer
// P6  each arm agrees with at least two of the other three

// ---- sortable.kara: the ★ arm: first unused copies in a VecDeque per digit

fn star_arm(s: String, t: String) -> bool {
    let mut at: Vec[VecDeque[i64]] = Vec.filled(10, VecDeque.new());
    for (i, c) in s.bytes().iter().enumerate() {
        at[(c - b'0')].push_back(i);
    }
    for c in t.bytes().iter() {
        let d = (c - b'0') as i64;
        let p = match at[d].pop_front() {
            Some(p) => p,
            None => return false,
        };
        for e in 0..d {
            if let Some(q) = at[e].front() {
                if q < p {
                    return false;
                }
            }
        }
    }
    true
}

// ---- sortable_counts.kara: the smaller digits in front of each copy, by running counts

fn counts_arm(s: String, t: String) -> bool {
    let mut seen = [0; 10];
    let mut before: Vec[Vec[Vec[i64]]] = Vec.filled(10, Vec.new());
    for c in s.chars() {
        let d = c.to_digit(10).unwrap() as i64;
        before[d].push(seen.to_vec());
        seen[d] += 1;
    }
    let mut seen_t = [0; 10];
    let mut used = [0; 10];
    for c in t.chars() {
        let d = c.to_digit(10).unwrap() as i64;
        if used[d] == before[d].len() {
            return false;
        }
        let in_s = ref before[d][used[d]];
        for e in 0..d {
            if seen_t[e] < in_s[e] {
                return false;
            }
        }
        used[d] += 1;
        seen_t[d] += 1;
    }
    true
}

// ---- sortable_pairs.kara: every pair of digits, each reduced string compared

// for each `hi` in `s` in turn, how many `lo` come before it
fn pairs_lows_before(s: String, lo: char, hi: char) -> Vec[i64] {
    let mut lows = 0;
    let mut out = Vec.new();
    for c in s.chars() {
        if c == lo {
            lows += 1;
        } else if c == hi {
            out.push(lows);
        }
    }
    out
}

fn pairs_arm(s: String, t: String) -> bool {
    let mut count_s: Map[char, i64] = Map.new();
    let mut count_t: Map[char, i64] = Map.new();
    for c in s.chars() {
        *count_s.entry(c).or_insert(0) += 1;
    }
    for c in t.chars() {
        *count_t.entry(c).or_insert(0) += 1;
    }
    if count_s != count_t {
        return false;
    }
    let digits: Vec[char] = "0123456789".chars().collect();
    for i in 0..10 {
        for j in i + 1..10 {
            let a = pairs_lows_before(s, digits[i], digits[j]);
            let b = pairs_lows_before(t, digits[i], digits[j]);
            if not a.iter().zip(b.iter()).all(|(x, y)| x <= y) {
                return false;
            }
        }
    }
    true
}

// ---- sortable_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn is_transformable(s: String, t: String) -> bool {
        let mut pos: Vec[Vec[i64]] = Vec.filled(10, Vec.new());
        for (i, b) in s.bytes().iter().enumerate() {
            pos[(b - b'0')].push(i);
        }
        let mut idx = [0; 10];
        for b in t.bytes() {
            let d = (b - b'0') as i64;
            if idx[d] >= pos[d].len() {
                return false;
            }
            let p = pos[d][idx[d]];
            for e in 0..d {
                if idx[e] < pos[e].len() and pos[e][idx[e]] < p {
                    return false;
                }
            }
            idx[d] += 1;
        }
        true
    }
}

fn solution_arm(s: String, t: String) -> bool {
    Solution.is_transformable(s, t)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, s: String, t: String) -> i64 {
    let ok = match a {
        0 => star_arm(s, t),
        1 => counts_arm(s, t),
        2 => pairs_arm(s, t),
        _ => solution_arm(s, t),
    };
    if ok { 1 } else { 0 }
}

fn arm_name(a: i64) -> String {
    ["sortable", "counts", "pairs", "solution"][a].to_string()
}

// ---- the statement read literally: every string reached from `s` by
// sorting any substring, any number of times, found by a breadth-first
// search, and `t` looked for among them

fn literal(s: String, t: String) -> i64 {
    let mut seen: Set[String] = Set.new();
    let mut queue: VecDeque[String] = VecDeque.new();
    seen.insert(s.clone());
    queue.push_back(s.clone());
    while let Some(u) = queue.pop_front() {
        let n = u.len();
        for i in 0..n {
            for j in i + 1..n + 1 {
                let mut b = u.bytes().to_vec();
                b[i..j].sort();
                let v = String.from_utf8(b).unwrap();
                if seen.insert(v.clone()) {
                    queue.push_back(v);
                }
            }
        }
    }
    if seen.contains(t) { 1 } else { 0 }
}

fn changed(s: String, f: Fn(u8) -> u8) -> String {
    String.from_utf8(s.bytes().iter().map(|c| f(c)).collect()).unwrap()
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15850;
    let mut cases: Vec[(String, String)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 6 + 1;
        let s: Vec[u8] = (0..n).map(|_| b'0' + (next_random(mut seed) % 3) as u8).collect();
        let mut t = s.clone();
        for _ in 0..next_random(mut seed) % 3 {
            let a = next_random(mut seed) % n;
            let b = next_random(mut seed) % n;
            t[a.min(b)..a.max(b) + 1].sort();
        }
        if next_random(mut seed) % 2 == 0 {
            let a = next_random(mut seed) % n;
            let b = next_random(mut seed) % n;
            t.swap(a, b);
        }
        if next_random(mut seed) % 4 == 0 {
            let a = next_random(mut seed) % n;
            t[a] = b'0' + (next_random(mut seed) % 3) as u8;
        }
        cases.push((String.from_utf8(s).unwrap(), String.from_utf8(t).unwrap()));
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for (p, (s, t)) in cases.iter().enumerate() {
        let truth = literal(s, t);
        let s_flip: String = changed(s, |c| b'9' - c + b'0').chars().rev().collect();
        let t_flip: String = changed(t, |c| b'9' - c + b'0').chars().rev().collect();
        let s_nine = f"{s}9";
        let t_nine = f"{t}9";
        let s_zero = f"0{s}";
        let t_zero = f"0{t}";
        let s_up = changed(s, |c| c + 5);
        let t_up = changed(t, |c| c + 5);
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, s, t);
            answers.push(answer);
            check = (check * 31 + answer + 1) % 1000000007;
            let failed = [
                answer != truth,
                arm(a, s_flip, t_flip) != answer,
                arm(a, s_nine, t_nine) != answer,
                arm(a, s_zero, t_zero) != answer,
                arm(a, s_up, t_up) != answer,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
