// LeetCode #1585: Check If String Is Transformable With Substring Sort
// Operations -- the ★ arm: a sort only ever moves a digit left past larger
// ones. So `t` is read left to right, each digit matched to the first
// unused copy of it in `s` (a `VecDeque` of positions per digit), and the
// match fails when a smaller digit's first unused copy lies before it,
// since nothing can move that copy past it. O(10 n)

fn is_transformable(s: String, t: String) -> bool {
    let mut at: Vec[VecDeque[i64]] = Vec.filled(10, VecDeque.new());
    for (i, c) in s.bytes().iter().enumerate() {
        at[(c - b'0')].push_back(i);
    }
    for c in t.bytes().iter() {
        let d = (c - b'0') as i64;
        let p = match at[d].pop_front() {
            Some(p) => p,
            None => return false,
        };
        for e in 0..d {
            if let Some(q) = at[e].front() {
                if q < p {
                    return false;
                }
            }
        }
    }
    true
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// a string of `n` digits below `digits`, then `t` made from it by up to
// `sorts` sorts of random substrings, and half the time two random places
// swapped as well
fn draw(n: i64, digits: i64, sorts: i64, seed: mut ref i64) -> (String, String) {
    let s: Vec[u8] = (0..n).map(|_| b'0' + (next_random(mut seed) % digits) as u8).collect();
    let mut t = s.clone();
    for _ in 0..next_random(mut seed) % (sorts + 1) {
        let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        t[a.min(b)..a.max(b) + 1].sort();
    }
    if next_random(mut seed) % 2 == 0 {
        let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        t.swap(a, b);
    }
    (String.from_utf8(s).unwrap(), String.from_utf8(t).unwrap())
}

fn batch(count: i64, most: i64, digits: i64, sorts: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut yes = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let (s, t) = draw(n, digits, sorts, mut seed);
        let ok = is_transformable(s, t);
        if ok {
            yes += 1;
        }
        check = mix(check, if ok { 1 } else { 0 });
    }
    println(f"{count} problems of up to {most} digits: {yes} transformable, checksum {check}");
}

fn main() {
    let examples: Vec[(String, String)] = [
        ("84532", "34852"),
        ("34521", "23415"),
        ("12345", "12435"),
        ("1", "2"),
        ("7", "7"),
        ("98765", "56789"),
        ("10", "01"),
        ("221", "212"),
    ];
    for (s, t) in examples.iter() {
        println(f"{s} {t} -> {is_transformable(s, t)}");
    }
    let mut seed = 1585;
    batch(3000, 8, 3, 3, mut seed);
    batch(300, 1000, 10, 20, mut seed);
    batch(10, 100000, 10, 100, mut seed);
}
