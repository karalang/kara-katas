// LeetCode #1585 bench: the ★ arm (first unused copies in a VecDeque per
// digit) on 40 problems of 100000 digits, each `t` made from `s` by 2000
// sorts of short substrings, every problem drawn first.

fn is_transformable(s: String, t: String) -> bool {
    let mut at: Vec[VecDeque[i64]] = Vec.filled(10, VecDeque.new());
    for (i, c) in s.bytes().iter().enumerate() {
        at[(c - b'0')].push_back(i);
    }
    for c in t.bytes().iter() {
        let d = (c - b'0') as i64;
        let p = match at[d].pop_front() {
            Some(p) => p,
            None => return false,
        };
        for e in 0..d {
            if let Some(q) = at[e].front() {
                if q < p {
                    return false;
                }
            }
        }
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let n = 100000;
    let mut seed = 1585;
    let mut problems: Vec[(String, String)] = Vec.new();
    for k in 0..40 {
        let mut s: Vec[u8] = Vec.new();
        for _ in 0..n {
            s.push(b'0' + (next_random(mut seed) % 10) as u8);
        }
        let mut t = s.clone();
        for _ in 0..2000 {
            let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % (n - 50);
            let b = a + next_random(mut seed) % 50 + 1;
            t[a..b].sort();
        }
        if k % 2 == 1 {
            let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
            let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
            t.swap(a, b);
        }
        problems.push((String.from_utf8(s).unwrap(), String.from_utf8(t).unwrap()));
    }
    let mut check = 0;
    let mut yes = 0;
    for (s, t) in problems.iter() {
        let ok = is_transformable(s, t);
        if ok {
            yes += 1;
        }
        check = mix(check, if ok { 1 } else { 0 });
    }
    println(f"40 problems of 100000 digits: {yes} transformable, checksum {check}");
}
