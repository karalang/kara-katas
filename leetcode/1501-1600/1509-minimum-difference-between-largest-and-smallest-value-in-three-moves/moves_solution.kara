// LeetCode #1509: Minimum Difference Between Largest and Smallest Value in
// Three Moves -- LeetCode's Rust template, written as Rust writes it and
// carried to Kāra by `karac fix`: the ★ arm in i32, the gaps widened to
// i64.

struct Solution {}

impl Solution {
    pub fn min_difference(mut nums: Vec[i32]) -> i32 {
        let n = nums.len();
        if n <= 4 {
            return 0;
        }
        nums.sort_unstable();
        (0..4).map(|i| nums[n - 4 + i] as i64 - nums[i] as i64).min().unwrap() as i32
    }
}

fn min_difference(nums: Vec[i64]) -> i64 {
    let narrow: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.min_difference(narrow) as i64
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x % 1000000007 + 1) % 1000000007
}

// `count` arrays of 1 to `most` numbers from -`span` to `span`.
fn batch(count: i64, most: i64, span: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            let wide = next_random(mut seed) * 32768 + next_random(mut seed);
            nums.push(wide % (2 * span + 1) - span);
        }
        check = mix(check, min_difference(nums));
    }
    check
}

fn main() {
    println(f"[5, 3, 2, 4] -> {min_difference([5, 3, 2, 4])}");
    println(f"[1, 5, 0, 10, 14] -> {min_difference([1, 5, 0, 10, 14])}");
    println(f"[3, 100, 20] -> {min_difference([3, 100, 20])}");
    println(f"[6, 6, 0, 1, 1, 4, 6] -> {min_difference([6, 6, 0, 1, 1, 4, 6])}");
    println(f"[1, 5, 6, 14, 15] -> {min_difference([1, 5, 6, 14, 15])}");
    println(f"[-1000000000, 0, 0, 0, 1000000000] -> {min_difference([-1000000000, 0, 0, 0, 1000000000])}");
    let mut seed = 1509;
    println(f"3000 arrays of 1 to 10 numbers within 50: checksum {batch(3000, 10, 50, mut seed)}");
    println(f"300 arrays of 1 to 1000 numbers within 10^9: checksum {batch(300, 1000, 1000000000, mut seed)}");
    println(f"3 arrays of 1 to 100000 numbers within 10^9: checksum {batch(3, 100000, 1000000000, mut seed)}");
}
