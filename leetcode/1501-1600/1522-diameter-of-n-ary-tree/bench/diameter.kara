// LeetCode #1522: Diameter of N-Ary Tree -- bench: the ★ arm over 1000
// random trees of 1 to 2000 nodes, built once and answered 20 times.

shared struct Node {
    val: i64,
    children: Vec[Node],
}

// the height of `node`; `best` takes the longest path turning at it
fn height(node: Node, best: mut ref i64) -> i64 {
    let mut first = 0;
    let mut second = 0;
    for child in node.children.iter() {
        let h = height(child, mut best) + 1;
        if h > first {
            second = first;
            first = h;
        } else if h > second {
            second = h;
        }
    }
    *best = (*best).max(first + second);
    first
}

fn diameter(root: Node) -> i64 {
    let mut best = 0;
    height(root, mut best);
    best
}
fn build(vals: Vec[i64], kids: Vec[Vec[i64]]) -> Node {
    let n = vals.len();
    let mut made: Vec[Option[Node]] = Vec.filled(n, None);
    for i in (0..n).rev() {
        let children: Vec[Node] = kids[i].iter().map(|c| made[*c].clone().unwrap()).collect();
        made[i] = Some(Node { val: vals[i], children });
    }
    made[0].clone().unwrap()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let count = 1000;
    let mut seed = 1522;
    let mut trees: Vec[Node] = Vec.new();
    for _ in 0..count {
        let n = next_random(mut seed) % 2000 + 1;
        let window = next_random(mut seed) % 64 + 1;
        let mut vals: Vec[i64] = Vec.new();
        let mut kids: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
        for i in 0..n {
            vals.push(next_random(mut seed) % 1000);
            if i > 0 {
                kids[i - 1 - next_random(mut seed) % i.min(window)].push(i);
            }
        }
        trees.push(build(vals, kids));
    }
    let mut check = 0;
    let mut total = 0;
    for _ in 0..20 {
        for tree in trees.iter() {
            let d = diameter(tree);
            total += d;
            check = mix(check, d);
        }
    }
    println(f"20 passes over 1000 trees of up to 2000 nodes: diameters sum to {total}, checksum {check}");
}
