// LeetCode #1522: Diameter of N-Ary Tree -- the ★ arm with iterator
// adapters: the children's heights by `map`, folded into the top two by
// `fold`.

shared struct Node {
    val: i64,
    children: Vec[Node],
}

// the height of `node`; `best` takes the longest path turning at it
fn height(node: Node, best: mut ref i64) -> i64 {
    let (first, second) = node.children.iter()
        .map(|child| height(child, mut best) + 1)
        .fold((0, 0), |(first, second), h| {
            if h > first {
                (h, first)
            } else {
                (first, second.max(h))
            }
        });
    *best = (*best).max(first + second);
    first
}

fn diameter(root: Node) -> i64 {
    let mut best = 0;
    height(root, mut best);
    best
}

// ---- the harness: the same in every arm --------------------------------

// A tree from LeetCode's level-order form: the root, a None, then each
// node's children followed by a None, in level order. Nodes are built
// leaves first, since a node holds its children.
fn from_level_order(tokens: Vec[Option[i64]]) -> Node {
    let mut vals: Vec[i64] = [tokens[0].unwrap_or(0)];
    let mut kids: Vec[Vec[i64]] = [Vec.new()];
    let mut parent = 0;
    for t in tokens.iter().skip(2) {
        match t {
            Some(v) => {
                kids[parent].push(vals.len());
                vals.push(v);
                kids.push(Vec.new());
            }
            None => {
                parent += 1;
            }
        }
    }
    build(vals, kids)
}

fn build(vals: Vec[i64], kids: Vec[Vec[i64]]) -> Node {
    let n = vals.len();
    let mut made: Vec[Option[Node]] = Vec.filled(n, None);
    for i in (0..n).rev() {
        let children: Vec[Node] = kids[i].iter().map(|c| made[*c].clone().unwrap()).collect();
        made[i] = Some(Node { val: vals[i], children });
    }
    made[0].clone().unwrap()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// 1 to `most` nodes, each after the first the child of one of the
// `window` nodes before it, so a small window makes a deep tree.
fn random_tree(most: i64, window: i64, seed: mut ref i64) -> Node {
    let n = next_random(mut seed) % most + 1;
    let mut vals: Vec[i64] = Vec.new();
    let mut kids: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for i in 0..n {
        vals.push(next_random(mut seed) % 1000);
        if i > 0 {
            kids[i - 1 - next_random(mut seed) % i.min(window)].push(i);
        }
    }
    build(vals, kids)
}

fn batch(count: i64, most: i64, window: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        check = mix(check, diameter(random_tree(most, window, mut seed)));
    }
    println(f"{count} trees of 1 to {most} nodes, parents within {window}: checksum {check}");
}

fn main() {
    let examples: Vec[Vec[Option[i64]]] = [
        [Some(1), None, Some(3), Some(2), Some(4), None, Some(5), Some(6)],
        [Some(1), None, Some(2), None, Some(3), Some(4), None, Some(5), None, Some(6)],
        [Some(1), None, Some(2), Some(3), Some(4), Some(5), None, None, Some(6), Some(7), None, Some(8), None, Some(9), Some(10), None, None, Some(11), None, Some(12), None, Some(13), None, None, Some(14)],
        [Some(7)],
    ];
    for k in 0..examples.len() {
        println(f"example {k + 1} -> diameter {diameter(from_level_order(examples[k].clone()))}");
    }
    let mut seed = 1522;
    batch(3000, 10, 10, mut seed);
    batch(300, 300, 300, mut seed);
    batch(300, 300, 3, mut seed);
    batch(3, 10000, 30, mut seed);
}
