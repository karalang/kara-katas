// LeetCode #1540: Can Convert String in K Moves -- the places in order, each
// taking the next move left for its shift: the first place that needs d
// takes move d, the next d + 26, and so on, refused as soon as one passes
// k. O(n).

fn can_convert_string(s: String, t: String, k: i64) -> bool {
    if s.len() != t.len() {
        return false;
    }
    let mut next = Vec.filled(26, 0);
    for d in 0..26 {
        next[d] = d;
    }
    for (a, b) in s.bytes().iter().zip(t.bytes().iter()) {
        let d = (b as i64 - a as i64 + 26) % 26;
        if d > 0 {
            if next[d] > k {
                return false;
            }
            next[d] += 26;
        }
    }
    true
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `n` letters drawn from the first `letters` of the alphabet
fn word(n: i64, letters: i64, seed: mut ref i64) -> String {
    let mut w = String.new();
    for _ in 0..n {
        w.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    w
}

// `count` pairs of 1 to `most` letters over the first 1 to `letters`, one
// in ten of different lengths, each with k from 0 to `top`
fn batch(count: i64, most: i64, letters: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut yes = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let m = if next_random(mut seed) % 10 == 0 { next_random(mut seed) % most + 1 } else { n };
        let used = next_random(mut seed) % letters + 1;
        let s = word(n, used, mut seed);
        let t = word(m, used, mut seed);
        let k = (next_random(mut seed) * 32768 + next_random(mut seed)) % (top + 1);
        let answer = can_convert_string(s, t, k);
        if answer {
            yes += 1;
        }
        check = mix(check, if answer { 1 } else { 0 });
    }
    println(f"{count} pairs of up to {most} letters, k up to {top}: {yes} true, checksum {check}");
}

fn main() {
    let examples: Vec[(String, String, i64)] = [
        ("input", "ouput", 9),
        ("abc", "bcd", 10),
        ("aab", "bbb", 27),
        ("a", "a", 0),
        ("a", "b", 0),
        ("ab", "a", 100),
        ("az", "ba", 1),
        ("az", "ba", 26),
        ("aaa", "zzz", 77),
        ("aaa", "zzz", 76),
    ];
    for (s, t, k) in examples.iter() {
        println(f"{s} -> {t}, k = {k}: {can_convert_string(s.clone(), t.clone(), k)}");
    }
    let s = "a".repeat(100000);
    let t = "b".repeat(100000);
    println(f"100000 a -> b, k = 2599975: {can_convert_string(s.clone(), t.clone(), 2599975)}");
    println(f"100000 a -> b, k = 2599974: {can_convert_string(s, t, 2599974)}");
    let mut seed = 1540;
    batch(3000, 12, 26, 80, mut seed);
    batch(300, 1000, 26, 2000, mut seed);
    batch(30, 100000, 26, 1000000000, mut seed);
}
