// LeetCode #1586: Binary Search Tree Iterator II -- every value up front.
//
// The constructor walks the whole tree in order, by recursion, into one
// list; the iterator is then a place in that list. O(n) to build, O(1) a
// call.

struct BstIterator {
    values: Vec[i32],
    at: i64,
}

fn in_order(node: Option[TreeNode], out: mut ref Vec[i32]) {
    if let Some(n) = node {
        in_order(n.left, mut out);
        out.push(n.val);
        in_order(n.right, mut out);
    }
}

impl BstIterator {
    fn new(root: Option[TreeNode]) -> BstIterator {
        let mut values = Vec.new();
        in_order(root, mut values);
        BstIterator { values: values, at: -1 }
    }

    fn has_next(self) -> bool {
        self.at + 1 < self.values.len()
    }

    fn next(mut ref self) -> i32 {
        self.at += 1;
        self.values[self.at]
    }

    fn has_prev(self) -> bool {
        self.at > 0
    }

    fn prev(mut ref self) -> i32 {
        self.at -= 1;
        self.values[self.at]
    }
}

// ---- the harness: the same in every arm --------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

// `v` put in the tree below `root` as a binary search tree puts it, unless
// it is there already; true when it was added
fn insert(root: TreeNode, v: i32) -> bool {
    let mut node = root;
    loop {
        if v == node.val {
            return false;
        }
        let child = if v < node.val { node.left } else { node.right };
        match child {
            Some(c) => node = c,
            None => {
                let leaf = TreeNode { val: v, left: None, right: None };
                if v < node.val {
                    node.left = Some(leaf);
                } else {
                    node.right = Some(leaf);
                }
                return true;
            }
        }
    }
}

// the tree made by inserting `values` in order, and how many it holds
fn build(values: Slice[i32]) -> (Option[TreeNode], i64) {
    if values.is_empty() {
        return (None, 0);
    }
    let root = TreeNode { val: values[0], left: None, right: None };
    let mut n = 1;
    for v in values[1..].iter() {
        if insert(root, *v) {
            n += 1;
        }
    }
    (Some(root), n)
}

// the calls: 0 hasNext, 1 next, 2 hasPrev, 3 prev; each answer as a number,
// a bool as 0 or 1
fn drive(root: Option[TreeNode], calls: Slice[i64]) -> Vec[i64] {
    let mut it = BstIterator.new(root);
    let mut out = Vec.new();
    for c in calls.iter() {
        let answer = match *c {
            0 => if it.has_next() { 1 } else { 0 },
            1 => it.next() as i64,
            2 => if it.has_prev() { 1 } else { 0 },
            _ => it.prev() as i64,
        };
        out.push(answer);
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` calls for a tree of `n` values, each one valid where it is made:
// a next only while one is left, a prev only after the second value
fn draw_calls(n: i64, count: i64, seed: mut ref i64) -> Vec[i64] {
    let mut at = -1;
    let mut calls = Vec.new();
    for _ in 0..count {
        let r = next_random(mut seed) % 6;
        let call = if r >= 2 and r <= 4 and at + 1 < n {
            at += 1;
            1
        } else if r == 5 and at > 0 {
            at -= 1;
            3
        } else {
            r % 2 * 2
        };
        calls.push(call);
    }
    calls
}

fn batch(count: i64, most: i64, below: i64, calls: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut nodes = 0;
    let mut made = 0;
    for _ in 0..count {
        let size = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let values: Vec[i32] = (0..size).map(|_| ((next_random(mut seed) * 32768 + next_random(mut seed)) % below) as i32).collect();
        let (root, n) = build(values);
        let todo = draw_calls(n, calls, mut seed);
        for answer in drive(root, todo).iter() {
            check = mix(check, *answer);
        }
        nodes += n;
        made += calls;
    }
    println(f"{count} trees of up to {most} values: {nodes} nodes, {made} calls, checksum {check}");
}

fn shown(calls: Slice[i64], answers: Slice[i64]) -> String {
    let mut parts = ["null"];
    for (c, a) in calls.iter().zip(answers.iter()) {
        parts.push(if *c % 2 == 1 { f"{a}" } else if *a == 1 { "true" } else { "false" });
    }
    f"[{parts.join(",")}]"
}

fn main() {
    // LeetCode's example, [7,3,15,null,null,9,20], then one value, a
    // chain to the right, a chain to the left, and a full tree of seven
    let examples: Vec[(Vec[i32], Vec[i64])] = [
        ([7, 3, 15, 9, 20], [1, 1, 3, 1, 0, 1, 1, 1, 0, 2, 3, 3]),
        ([1], [0, 2, 1, 0, 2]),
        ([1, 2, 3, 4, 5], [1, 1, 1, 1, 1, 0, 3, 3, 3, 3, 2, 0]),
        ([5, 4, 3, 2, 1], [1, 1, 3, 1, 1, 1, 1, 0, 2, 3]),
        ([4, 2, 6, 1, 3, 5, 7], [1, 1, 1, 1, 3, 3, 1, 1, 1, 1, 1, 0, 3, 3, 3, 3, 3, 2]),
    ];
    for (values, calls) in examples.iter() {
        let (root, _) = build(values);
        println(shown(calls, drive(root, calls)));
    }
    let mut seed = 1586;
    batch(3000, 8, 20, 20, mut seed);
    batch(300, 1000, 1000000, 2000, mut seed);
    batch(3, 100000, 1000001, 100000, mut seed);
}
