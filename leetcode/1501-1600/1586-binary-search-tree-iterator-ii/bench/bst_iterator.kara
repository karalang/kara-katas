// LeetCode #1586: Binary Search Tree Iterator II -- the bench: the ★ arm
// on 20 trees of 100000 random values, each driven by 300000 calls, all
// drawn first.
//
// The ★ arm: the in-order walk made lazily, with a stack holding the
// left spine still to visit, and every value it has given kept in a list
// with the iterator's place in it.

struct BstIterator {
    spine: Vec[TreeNode],
    seen: Vec[i32],
    at: i64,
}

impl BstIterator {
    fn new(root: Option[TreeNode]) -> BstIterator {
        let mut it = BstIterator { spine: Vec.new(), seen: Vec.new(), at: -1 };
        it.push_left(root);
        it
    }

    fn push_left(mut ref self, node: Option[TreeNode]) {
        let mut node = node;
        while let Some(n) = node {
            self.spine.push(n);
            node = n.left;
        }
    }

    fn has_next(self) -> bool {
        self.at + 1 < self.seen.len() or not self.spine.is_empty()
    }

    fn next(mut ref self) -> i32 {
        self.at += 1;
        if self.at == self.seen.len() {
            let n = self.spine.pop().unwrap();
            self.seen.push(n.val);
            self.push_left(n.right);
        }
        self.seen[self.at]
    }

    fn has_prev(self) -> bool {
        self.at > 0
    }

    fn prev(mut ref self) -> i32 {
        self.at -= 1;
        self.seen[self.at]
    }
}

// ---- the harness: the same in every arm --------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

// `v` put in the tree below `root` as a binary search tree puts it, unless
// it is there already; true when it was added
fn insert(root: TreeNode, v: i32) -> bool {
    let mut node = root;
    loop {
        if v == node.val {
            return false;
        }
        let child = if v < node.val { node.left } else { node.right };
        match child {
            Some(c) => node = c,
            None => {
                let leaf = TreeNode { val: v, left: None, right: None };
                if v < node.val {
                    node.left = Some(leaf);
                } else {
                    node.right = Some(leaf);
                }
                return true;
            }
        }
    }
}

// the tree made by inserting `values` in order, and how many it holds
fn build(values: Slice[i32]) -> (Option[TreeNode], i64) {
    if values.is_empty() {
        return (None, 0);
    }
    let root = TreeNode { val: values[0], left: None, right: None };
    let mut n = 1;
    for v in values[1..].iter() {
        if insert(root, *v) {
            n += 1;
        }
    }
    (Some(root), n)
}

// the calls: 0 hasNext, 1 next, 2 hasPrev, 3 prev; each answer as a number,
// a bool as 0 or 1
fn drive(root: Option[TreeNode], calls: Slice[i64]) -> Vec[i64] {
    let mut it = BstIterator.new(root);
    let mut out = Vec.new();
    for c in calls.iter() {
        let answer = match *c {
            0 => if it.has_next() { 1 } else { 0 },
            1 => it.next() as i64,
            2 => if it.has_prev() { 1 } else { 0 },
            _ => it.prev() as i64,
        };
        out.push(answer);
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` calls for a tree of `n` values, each one valid where it is made:
// a next only while one is left, a prev only after the second value
fn draw_calls(n: i64, count: i64, seed: mut ref i64) -> Vec[i64] {
    let mut at = -1;
    let mut calls = Vec.new();
    for _ in 0..count {
        let r = next_random(mut seed) % 6;
        let call = if r >= 2 and r <= 4 and at + 1 < n {
            at += 1;
            1
        } else if r == 5 and at > 0 {
            at -= 1;
            3
        } else {
            r % 2 * 2
        };
        calls.push(call);
    }
    calls
}

fn main() {
    let mut seed = 1586;
    let mut problems: Vec[(Option[TreeNode], Vec[i64])] = Vec.new();
    let mut nodes = 0;
    for _ in 0..20 {
        let values: Vec[i32] = (0..100000).map(|_| ((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000) as i32).collect();
        let (root, n) = build(values);
        nodes += n;
        problems.push((root, draw_calls(n, 300000, mut seed)));
    }
    let mut check = 0;
    for (root, calls) in problems.iter() {
        for answer in drive(root, calls).iter() {
            check = mix(check, *answer);
        }
    }
    println(f"20 trees of 100000 values: {nodes} nodes, 6000000 calls, checksum {check}");
}
