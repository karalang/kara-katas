// LeetCode #1577: Number of Ways Where Square of Number Is Equal to
// Product of Two Numbers -- LeetCode's Rust template as karac fix left it:
// each array's values counted in a `HashMap`, and for each square every
// distinct value a of the other paired with x^2 / a, counted once a pair.

struct Solution {}

fn count(a: Vec[i32], b: Vec[i32]) -> i64 {
    let mut freq: Map[i64, i64] = Map.new();
    for y in b {
        *freq.entry(y).or_insert(0) += 1;
    }
    let mut res = 0;
    for x in a {
        let t = x as i64 * x as i64;
        for (p, cp) in freq.iter() {
            if t % p != 0 {
                continue;
            }
            let q = t / p;
            if p == q {
                res += cp * (cp - 1) / 2;
            } else if p < q {
                if let Some(cq) = freq.get(q).cloned() {
                    res += cp * cq;
                }
            }
        }
    }
    res
}

impl Solution {
    pub fn num_triplets(nums1: Vec[i32], nums2: Vec[i32]) -> i32 {
        (count(nums1, nums2) + count(nums2, nums1)) as i32
    }
}

fn num_triplets(nums1: Vec[i64], nums2: Vec[i64]) -> i64 {
    let a: Vec[i32] = nums1.iter().map(|x| x as i32).collect();
    let b: Vec[i32] = nums2.iter().map(|x| x as i32).collect();
    Solution.num_triplets(a, b)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` pairs of arrays of 1 to `most` values, each a power of 2 or 3
// times a small factor below `top`, so that squares and products meet
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let mut pair: Vec[Vec[i64]] = Vec.new();
        for _ in 0..2 {
            let n = next_random(mut seed) % most + 1;
            let nums: Vec[i64] = (0..n).map(|_| {
                let mut v = next_random(mut seed) % top + 1;
                for _ in 0..next_random(mut seed) % 4 {
                    v *= 2 + next_random(mut seed) % 2;
                }
                v.min(100000)
            }).collect();
            pair.push(nums);
        }
        let ways = num_triplets(pair[0], pair[1]);
        total += ways;
        check = mix(check, ways);
    }
    println(f"{count} pairs of up to {most} values: triplets total {total}, checksum {check}");
}

fn main() {
    let examples: Vec[(Vec[i64], Vec[i64])] = [
        ([7, 4], [5, 2, 8, 9]),
        ([1, 1], [1, 1, 1]),
        ([7, 7, 8, 3], [1, 2, 9, 7]),
        ([4, 7, 9, 11, 23], [3, 5, 1024, 12, 18]),
        ([1], [1]),
        ([100000], [100000, 100000]),
    ];
    for (a, b) in examples.iter() {
        println(f"{a}, {b} -> {num_triplets(a, b)}");
    }
    let mut seed = 1577;
    batch(3000, 6, 4, mut seed);
    batch(300, 100, 20, mut seed);
    batch(10, 1000, 100, mut seed);
}
