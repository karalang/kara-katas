// LeetCode #1577: Number of Ways Where Square of Number Is Equal to
// Product of Two Numbers -- the other array sorted once, then for each x
// two pointers close in from both ends on the pairs whose product is x^2,
// a run of equal values on each side counted as a block. O(m log m + n *
// m)

fn ways(squares: Vec[i64], products: Vec[i64]) -> i64 {
    let mut sorted = products.clone();
    sorted.sort();
    let mut total = 0;
    for x in squares.iter() {
        let target = x * x;
        let mut lo = 0;
        let mut hi = sorted.len() - 1;
        while lo < hi {
            let product = sorted[lo] * sorted[hi];
            if product < target {
                lo += 1;
            } else if product > target {
                hi -= 1;
            } else if sorted[lo] == sorted[hi] {
                let run = hi - lo + 1;
                total += run * (run - 1) / 2;
                break;
            } else {
                let mut left = 1;
                while sorted[lo + left] == sorted[lo] {
                    left += 1;
                }
                let mut right = 1;
                while sorted[hi - right] == sorted[hi] {
                    right += 1;
                }
                total += left * right;
                lo += left;
                hi -= right;
            }
        }
    }
    total
}

fn num_triplets(nums1: Vec[i64], nums2: Vec[i64]) -> i64 {
    ways(nums1, nums2) + ways(nums2, nums1)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` pairs of arrays of 1 to `most` values, each a power of 2 or 3
// times a small factor below `top`, so that squares and products meet
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let mut pair: Vec[Vec[i64]] = Vec.new();
        for _ in 0..2 {
            let n = next_random(mut seed) % most + 1;
            let nums: Vec[i64] = (0..n).map(|_| {
                let mut v = next_random(mut seed) % top + 1;
                for _ in 0..next_random(mut seed) % 4 {
                    v *= 2 + next_random(mut seed) % 2;
                }
                v.min(100000)
            }).collect();
            pair.push(nums);
        }
        let ways = num_triplets(pair[0], pair[1]);
        total += ways;
        check = mix(check, ways);
    }
    println(f"{count} pairs of up to {most} values: triplets total {total}, checksum {check}");
}

fn main() {
    let examples: Vec[(Vec[i64], Vec[i64])] = [
        ([7, 4], [5, 2, 8, 9]),
        ([1, 1], [1, 1, 1]),
        ([7, 7, 8, 3], [1, 2, 9, 7]),
        ([4, 7, 9, 11, 23], [3, 5, 1024, 12, 18]),
        ([1], [1]),
        ([100000], [100000, 100000]),
    ];
    for (a, b) in examples.iter() {
        println(f"{a}, {b} -> {num_triplets(a, b)}");
    }
    let mut seed = 1577;
    batch(3000, 6, 4, mut seed);
    batch(300, 100, 20, mut seed);
    batch(10, 1000, 100, mut seed);
}
