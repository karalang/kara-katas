// LeetCode #1577: Number of Ways Where Square of Number Is Equal to
// Product of Two Numbers -- bench: the ★ arm (a walk with a Map of the
// values seen) over 10 pairs of arrays of 1000 values, each a power of 2
// or 3 times a factor below 100, drawn first.

fn ways(squares: Vec[i64], products: Vec[i64]) -> i64 {
    let mut total = 0;
    for x in squares.iter() {
        let target = x * x;
        let mut seen: Map[i64, i64] = Map.new();
        for y in products.iter() {
            if target % y == 0 {
                total += seen.get(target / y).cloned().unwrap_or(0);
            }
            *seen.entry(y).or_insert(0) += 1;
        }
    }
    total
}

fn num_triplets(nums1: Vec[i64], nums2: Vec[i64]) -> i64 {
    ways(nums1, nums2) + ways(nums2, nums1)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1577;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..20 {
        let nums: Vec[i64] = (0..1000).map(|_| {
            let mut v = next_random(mut seed) % 100 + 1;
            for _ in 0..next_random(mut seed) % 4 {
                v *= 2 + next_random(mut seed) % 2;
            }
            v.min(100000)
        }).collect();
        arrays.push(nums);
    }
    let mut check = 0;
    let mut total = 0;
    for p in 0..10 {
        let ways = num_triplets(arrays[2 * p], arrays[2 * p + 1]);
        total += ways;
        check = mix(check, ways);
    }
    println(f"10 pairs of arrays of 1000 values: triplets total {total}, checksum {check}");
}
