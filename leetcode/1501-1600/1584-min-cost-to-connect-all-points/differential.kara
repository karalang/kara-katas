// LeetCode #1584: Min Cost to Connect All Points -- the differential.
//
// Four arms against the statement read literally, on 3000 problems of 1
// to 5 distinct points with coordinates from -4 to 4, with six
// properties. Every random choice is drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the points in reverse order leave the answer
// P3  every point turned a quarter (x, y to -y, x) leaves the answer
// P4  every point scaled by 3 and moved triples the answer
// P5  a point one step right of the rightmost point adds 1 to the answer
// P6  each arm agrees with at least two of the other three

// ---- points.kara: the ★ arm: Prim's algorithm with no edge list

fn star_arm(points: Vec[Vec[i64]]) -> i64 {
    let n = points.len();
    let mut nearest = Vec.filled(n, i64.MAX);
    let mut inside = Vec.filled(n, false);
    nearest[0] = 0;
    let mut cost = 0;
    for _ in 0..n {
        let mut next = -1;
        for i in 0..n {
            if not inside[i] and (next < 0 or nearest[i] < nearest[next]) {
                next = i;
            }
        }
        inside[next] = true;
        cost += nearest[next];
        for i in 0..n {
            if not inside[i] {
                let d = (points[i][0] - points[next][0]).abs() + (points[i][1] - points[next][1]).abs();
                nearest[i] = nearest[i].min(d);
            }
        }
    }
    cost
}

// ---- points_kruskal.kara: every edge sorted, joined by a disjoint-set forest

fn kruskal_root(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn kruskal_arm(points: Vec[Vec[i64]]) -> i64 {
    let n = points.len();
    let mut edges: Vec[(i64, i64, i64)] = Vec.new();
    for i in 0..n {
        for j in i + 1..n {
            let d = (points[i][0] - points[j][0]).abs() + (points[i][1] - points[j][1]).abs();
            edges.push((d, i, j));
        }
    }
    edges.sort();
    let mut parent: Vec[i64] = (0..n).collect();
    let mut cost = 0;
    let mut joined = 1;
    for (d, i, j) in edges.iter() {
        if joined == n {
            break;
        }
        let a = kruskal_root(mut parent, i);
        let b = kruskal_root(mut parent, j);
        if a != b {
            parent[a] = b;
            cost += d;
            joined += 1;
        }
    }
    cost
}

// ---- points_heap.kara: lazy Prim over a PriorityQueue

fn heap_arm(points: Vec[Vec[i64]]) -> i64 {
    let n = points.len();
    let mut inside = Vec.filled(n, false);
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    queue.push((0, 0));
    let mut cost = 0;
    let mut count = 0;
    while count < n {
        let (d, p) = queue.pop().unwrap();
        if inside[p] {
            continue;
        }
        inside[p] = true;
        cost += d;
        count += 1;
        let (x, y) = (points[p][0], points[p][1]);
        for q in 0..n {
            if not inside[q] {
                queue.push(((points[q][0] - x).abs() + (points[q][1] - y).abs(), q));
            }
        }
    }
    cost
}

// ---- points_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn min_cost_connect_points(points: Vec[Vec[i32]]) -> i32 {
        let n = points.len();
        let mut dist = Vec.filled(n, i32.MAX);
        let mut visited = Vec.filled(n, false);
        dist[0] = 0;
        let mut res: i32 = 0;
        for _ in 0..n {
            let mut u = i64.MAX;
            for i in 0..n {
                if not visited[i] and (u == i64.MAX or dist[i] < dist[u]) {
                    u = i;
                }
            }
            visited[u] = true;
            res += dist[u];
            for v in 0..n {
                if not visited[v] {
                    let d = (points[u][0] - points[v][0]).abs() + (points[u][1] - points[v][1]).abs();
                    if d < dist[v] {
                        dist[v] = d;
                    }
                }
            }
        }
        res
    }
}

fn solution_arm(points: Vec[Vec[i64]]) -> i64 {
    let p: Vec[Vec[i32]] = points.iter().map(|r| r.iter().map(|x| x as i32).collect()).collect();
    Solution.min_cost_connect_points(p)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, points: Vec[Vec[i64]]) -> i64 {
    match a {
        0 => star_arm(points),
        1 => kruskal_arm(points),
        2 => heap_arm(points),
        _ => solution_arm(points),
    }
}

fn arm_name(a: i64) -> String {
    ["points", "kruskal", "heap", "solution"][a].to_string()
}

// ---- the statement read literally: every set of n - 1 edges tried, the
// cheapest whose edges join every point to point 0

fn joins_all(n: i64, chosen: Vec[(i64, i64)]) -> bool {
    let mut seen = Vec.filled(n, false);
    seen[0] = true;
    let mut grew = true;
    while grew {
        grew = false;
        for (i, j) in chosen.iter() {
            if seen[i] != seen[j] {
                seen[i] = true;
                seen[j] = true;
                grew = true;
            }
        }
    }
    seen.iter().all(|s| s)
}

fn literal(points: Vec[Vec[i64]]) -> i64 {
    let n = points.len();
    let mut edges: Vec[(i64, i64)] = Vec.new();
    for i in 0..n {
        for j in i + 1..n {
            edges.push((i, j));
        }
    }
    let m = edges.len();
    let mut best = i64.MAX;
    for mask in 0..(1 << m) {
        if (0..m).filter(|e| mask >> e & 1 == 1).count() != n - 1 {
            continue;
        }
        let chosen: Vec[(i64, i64)] = (0..m).filter(|e| mask >> e & 1 == 1).map(|e| edges[e]).collect();
        if joins_all(n, chosen) {
            let cost = chosen.iter().map(|(i, j)| (points[i][0] - points[j][0]).abs() + (points[i][1] - points[j][1]).abs()).sum();
            best = best.min(cost);
        }
    }
    if n == 1 { 0 } else { best }
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15840;
    let mut cases: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 5 + 1;
        let mut points: Vec[Vec[i64]] = Vec.new();
        while points.len() < n {
            let p = [next_random(mut seed) % 9 - 4, next_random(mut seed) % 9 - 4];
            if not points.contains(p) {
                points.push(p);
            }
        }
        cases.push(points);
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for (p, points) in cases.iter().enumerate() {
        let truth = literal(points);
        let back: Vec[Vec[i64]] = points.iter().rev().cloned().collect();
        let turned: Vec[Vec[i64]] = points.iter().map(|q| [-q[1], q[0]]).collect();
        let tripled: Vec[Vec[i64]] = points.iter().map(|q| [3 * q[0] + 7, 3 * q[1] - 5]).collect();
        let mut doubled_up = points.clone();
        let far = points.iter().map(|q| q[0]).max().unwrap() + 1;
        let row = points.iter().filter(|q| q[0] == far - 1).map(|q| q[1]).next().unwrap();
        doubled_up.push([far, row]);
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, points);
            answers.push(answer);
            check = (check * 31 + answer + 1) % 1000000007;
            let failed = [
                answer != truth,
                arm(a, back) != answer,
                arm(a, turned) != answer,
                arm(a, tripled) != 3 * answer,
                arm(a, doubled_up) != answer + 1,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
