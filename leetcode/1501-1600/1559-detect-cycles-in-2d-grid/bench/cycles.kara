// LeetCode #1559: Detect Cycles in 2D Grid -- bench: the ★ arm (a search
// on a stack, each cell with the cell it came from) over 20 comb grids of
// 500 by 500 with no cycle, half with two cells made `a` to join two teeth
// in one, built once, each asked 5 times.

fn contains_cycle(grid: Vec[Vec[char]]) -> bool {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut seen = Vec.filled(rows * cols, false);
    for start in 0..rows * cols {
        if seen[start] {
            continue;
        }
        seen[start] = true;
        let mut stack = [(start, -1)];
        while let Some((cell, from)) = stack.pop() {
            let (r, c) = (cell / cols, cell % cols);
            for (dr, dc) in [(0, 1), (1, 0), (0, -1), (-1, 0)] {
                let (nr, nc) = (r + dr, c + dc);
                if nr < 0 or nr >= rows or nc < 0 or nc >= cols or grid[nr][nc] != grid[r][c] {
                    continue;
                }
                let next = nr * cols + nc;
                if next == from {
                    continue;
                }
                if seen[next] {
                    return true;
                }
                seen[next] = true;
                stack.push((next, cell));
            }
        }
    }
    false
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// row 0 and every even column are `a`, a comb with no cycle; the odd
// columns below row 0 are random letters from `b`, cut apart by the comb's
// teeth, so a piece of them is a straight run with no cycle either
fn comb(size: i64, seed: mut ref i64) -> Vec[Vec[char]] {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut grid = Vec.new();
    for r in 0..size {
        let mut row = Vec.new();
        for c in 0..size {
            if r == 0 or c % 2 == 0 {
                row.push('a');
            } else {
                row.push(alphabet[next_random(mut seed) % 25 + 1]);
            }
        }
        grid.push(row);
    }
    grid
}

fn main() {
    let size = 500;
    let mut seed = 1559;
    let mut grids: Vec[Vec[Vec[char]]] = Vec.new();
    for g in 0..20 {
        let mut grid = comb(size, mut seed);
        // two cells of `a` join two teeth across an odd column: a cycle
        if g % 2 == 1 {
            let r = next_random(mut seed) % (size - 2) + 1;
            let c = next_random(mut seed) % (size / 2 - 1) * 2 + 1;
            grid[r][c] = 'a';
            grid[r + 1][c] = 'a';
        }
        grids.push(grid);
    }
    let mut check = 0;
    let mut found = 0;
    for pass in 0..5 {
        for g in 0..grids.len() {
            let cycle = contains_cycle(grids[g]);
            if cycle {
                found += 1;
            }
            check = mix(check, if cycle { pass * 20 + g } else { -1 });
        }
    }
    println(f"5 passes over 20 grids of 500 by 500: {found} with a cycle, checksum {check}");
}
