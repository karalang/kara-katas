// LeetCode #1559: Detect Cycles in 2D Grid -- LeetCode's Rust template as
// karac fix left it: a recursive search from every unvisited cell, each
// call told the cell it came from.

struct Solution {}

impl Solution {
    pub fn contains_cycle(grid: Vec[Vec[char]]) -> bool {
        let m = grid.len();
        let n = grid[0].len();
        let mut visited = Vec.filled(m, Vec.filled(n, false));
        for i in 0..m {
            for j in 0..n {
                if not visited[i][j] and Solution.dfs(grid, mut visited, i, j, i64.MAX, i64.MAX) {
                    return true;
                }
            }
        }
        false
    }

    fn dfs(grid: Vec[Vec[char]], visited: mut ref Vec[Vec[bool]], i: i64, j: i64, pi: i64, pj: i64) -> bool {
        visited[i][j] = true;
        let dirs = [(0i32, 1i32), (1, 0), (0, -1), (-1, 0)];
        for (di, dj) in dirs.iter() {
            let ni = i as i32 + di;
            let nj = j as i32 + dj;
            if ni < 0 or nj < 0 or ni >= grid.len() as i32 or nj >= grid[0].len() as i32 {
                continue;
            }
            let (ni, nj) = (ni as i64, nj as i64);
            if grid[ni][nj] != grid[i][j] or (ni == pi and nj == pj) {
                continue;
            }
            if visited[ni][nj] {
                return true;
            }
            if Solution.dfs(grid, mut visited, ni, nj, i, j) {
                return true;
            }
        }
        false
    }
}

fn contains_cycle(grid: Vec[Vec[char]]) -> bool {
    Solution.contains_cycle(grid)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn parse(rows: Vec[Str]) -> Vec[Vec[char]] {
    rows.iter().map(|row| row.chars().collect()).collect()
}

// `count` grids of 1 to `most` rows and columns, each over its own first
// 1 to `letters` letters
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut check = 0;
    let mut found = 0;
    for _ in 0..count {
        let rows = next_random(mut seed) % most + 1;
        let cols = next_random(mut seed) % most + 1;
        let own = next_random(mut seed) % letters + 1;
        let mut grid = Vec.new();
        for _ in 0..rows {
            let mut row = Vec.new();
            for _ in 0..cols {
                row.push(alphabet[next_random(mut seed) % own]);
            }
            grid.push(row);
        }
        let cycle = contains_cycle(grid);
        if cycle {
            found += 1;
        }
        check = mix(check, if cycle { rows * cols } else { 0 });
    }
    println(f"{count} grids of up to {most} by {most} over up to {letters} letters: {found} with a cycle, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[Str]] = [
        ["aaaa", "abba", "abba", "aaaa"],
        ["ccca", "cdcc", "ccec", "fccc"],
        ["abb", "bzb", "bba"],
        ["aa", "aa"],
        ["a"],
        ["ab", "ba"],
        ["aaa", "aba", "aaa"],
        ["aaa", "aba", "aab"],
        ["aaaa"],
    ];
    for rows in examples.iter() {
        println(f"[{rows.join(", ")}] -> {contains_cycle(parse(rows.clone()))}");
    }
    let mut seed = 1559;
    batch(3000, 6, 3, mut seed);
    batch(300, 60, 26, mut seed);
    batch(30, 200, 26, mut seed);
}
