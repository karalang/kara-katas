// LeetCode #1559: Detect Cycles in 2D Grid -- counting: a connected piece
// is a tree exactly when it has one edge fewer than cells, so each piece
// of one letter is flooded from a `VecDeque`, its cells and its
// same-letter neighbour pairs counted, and a piece with as many edges as
// cells holds a cycle.

fn contains_cycle(grid: Vec[Vec[char]]) -> bool {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut piece = Vec.filled(rows * cols, false);
    for start in 0..rows * cols {
        if piece[start] {
            continue;
        }
        piece[start] = true;
        let mut queue = VecDeque.new();
        queue.push_back(start);
        let mut cells = 0;
        let mut ends = 0;
        while let Some(cell) = queue.pop_front() {
            cells += 1;
            let (r, c) = (cell / cols, cell % cols);
            for (dr, dc) in [(0, 1), (1, 0), (0, -1), (-1, 0)] {
                let (nr, nc) = (r + dr, c + dc);
                if nr >= 0 and nr < rows and nc >= 0 and nc < cols and grid[nr][nc] == grid[r][c] {
                    ends += 1;
                    let next = nr * cols + nc;
                    if not piece[next] {
                        piece[next] = true;
                        queue.push_back(next);
                    }
                }
            }
        }
        // every edge was counted from both of its ends
        if ends / 2 >= cells {
            return true;
        }
    }
    false
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn parse(rows: Vec[Str]) -> Vec[Vec[char]] {
    rows.iter().map(|row| row.chars().collect()).collect()
}

// `count` grids of 1 to `most` rows and columns, each over its own first
// 1 to `letters` letters
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut check = 0;
    let mut found = 0;
    for _ in 0..count {
        let rows = next_random(mut seed) % most + 1;
        let cols = next_random(mut seed) % most + 1;
        let own = next_random(mut seed) % letters + 1;
        let mut grid = Vec.new();
        for _ in 0..rows {
            let mut row = Vec.new();
            for _ in 0..cols {
                row.push(alphabet[next_random(mut seed) % own]);
            }
            grid.push(row);
        }
        let cycle = contains_cycle(grid);
        if cycle {
            found += 1;
        }
        check = mix(check, if cycle { rows * cols } else { 0 });
    }
    println(f"{count} grids of up to {most} by {most} over up to {letters} letters: {found} with a cycle, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[Str]] = [
        ["aaaa", "abba", "abba", "aaaa"],
        ["ccca", "cdcc", "ccec", "fccc"],
        ["abb", "bzb", "bba"],
        ["aa", "aa"],
        ["a"],
        ["ab", "ba"],
        ["aaa", "aba", "aaa"],
        ["aaa", "aba", "aab"],
        ["aaaa"],
    ];
    for rows in examples.iter() {
        println(f"[{rows.join(", ")}] -> {contains_cycle(parse(rows.clone()))}");
    }
    let mut seed = 1559;
    batch(3000, 6, 3, mut seed);
    batch(300, 60, 26, mut seed);
    batch(30, 200, 26, mut seed);
}
