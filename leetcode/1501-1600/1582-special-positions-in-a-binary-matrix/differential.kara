// LeetCode #1582: Special Positions in a Binary Matrix -- the
// differential.
//
// Four arms against the statement read literally, on 3000 matrices of 1
// to 5 rows and columns, each cell 1 with a chance of one in 1 to 4, with
// six properties. Every random choice is drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the matrix transposed leaves the answer
// P3  the rows in reverse order leave the answer
// P4  each row reversed leaves the answer
// P5  a row of zeros added leaves the answer
// P6  each arm agrees with at least two of the other three

// ---- special.kara: the ★ arm: row and column sums by iterators

fn star_arm(mat: Vec[Vec[i64]]) -> i64 {
    let n = mat[0].len();
    let rows: Vec[i64] = mat.iter().map(|row| row.iter().sum()).collect();
    let cols: Vec[i64] = (0..n).map(|j| mat.iter().map(|row| row[j]).sum()).collect();
    mat.iter().enumerate().map(|(i, row)| {
        (0..n).filter(|j| row[j] == 1 and rows[i] == 1 and cols[j] == 1).count()
    }).sum()
}

// ---- special_rows.kara: a row with one 1 names the column to check

fn rows_arm(mat: Vec[Vec[i64]]) -> i64 {
    let mut count = 0;
    for (i, row) in mat.iter().enumerate() {
        if row.iter().filter(|x| x == 1).count() != 1 {
            continue;
        }
        let j = row.iter().position(|x| x == 1).unwrap();
        let alone = mat.iter().enumerate().all(|(k, other)| k == i or other[j] == 0);
        if alone {
            count += 1;
        }
    }
    count
}

// ---- special_owners.kara: one pass giving each column the row of its only 1

const OWNERS_NOBODY: i64 = -1;
const OWNERS_MANY: i64 = -2;

fn owners_arm(mat: Vec[Vec[i64]]) -> i64 {
    let n = mat[0].len();
    let mut owner = Vec.filled(n, OWNERS_NOBODY);
    let mut ones: Vec[i64] = Vec.new();
    for (i, row) in mat.iter().enumerate() {
        let mut here = 0;
        for j in 0..n {
            if row[j] == 1 {
                here += 1;
                owner[j] = if owner[j] == OWNERS_NOBODY { i } else { OWNERS_MANY };
            }
        }
        ones.push(here);
    }
    owner.iter().filter(|o| o >= 0 and ones[o] == 1).count()
}

// ---- special_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn num_special(mat: Vec[Vec[i32]]) -> i32 {
        let m = mat.len();
        let n = mat[0].len();
        let mut rows = Vec.filled(m, 0);
        let mut cols = Vec.filled(n, 0);
        for i in 0..m {
            for j in 0..n {
                if mat[i][j] == 1 {
                    rows[i] += 1;
                    cols[j] += 1;
                }
            }
        }
        let mut ans = 0;
        for i in 0..m {
            for j in 0..n {
                if mat[i][j] == 1 and rows[i] == 1 and cols[j] == 1 {
                    ans += 1;
                }
            }
        }
        ans
    }
}

fn solution_arm(mat: Vec[Vec[i64]]) -> i64 {
    let m: Vec[Vec[i32]] = mat.iter().map(|r| r.iter().map(|x| x as i32).collect()).collect();
    Solution.num_special(m)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, mat: Vec[Vec[i64]]) -> i64 {
    match a {
        0 => star_arm(mat),
        1 => rows_arm(mat),
        2 => owners_arm(mat),
        _ => solution_arm(mat),
    }
}

fn arm_name(a: i64) -> String {
    ["special", "rows", "owners", "solution"][a].to_string()
}

// ---- the statement read literally: each 1 checked against every other
// cell of its row and of its column

fn literal(mat: Vec[Vec[i64]]) -> i64 {
    let m = mat.len();
    let n = mat[0].len();
    let mut count = 0;
    for i in 0..m {
        for j in 0..n {
            if mat[i][j] != 1 {
                continue;
            }
            let mut alone = true;
            for k in 0..m {
                if k != i and mat[k][j] != 0 {
                    alone = false;
                }
            }
            for k in 0..n {
                if k != j and mat[i][k] != 0 {
                    alone = false;
                }
            }
            if alone {
                count += 1;
            }
        }
    }
    count
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15820;
    let mut cases: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..problems {
        let m = next_random(mut seed) % 5 + 1;
        let n = next_random(mut seed) % 5 + 1;
        let odds = next_random(mut seed) % 4 + 1;
        let mat: Vec[Vec[i64]] = (0..m).map(|_| (0..n).map(|_| if next_random(mut seed) % odds == 0 { 1 } else { 0 }).collect()).collect();
        cases.push(mat);
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for (p, mat) in cases.iter().enumerate() {
        let truth = literal(mat);
        let m = mat.len();
        let n = mat[0].len();
        let turned: Vec[Vec[i64]] = (0..n).map(|j| (0..m).map(|i| mat[i][j]).collect()).collect();
        let upside: Vec[Vec[i64]] = mat.iter().rev().cloned().collect();
        let mirrored: Vec[Vec[i64]] = mat.iter().map(|row| row.iter().rev().cloned().collect()).collect();
        let mut taller = mat.clone();
        taller.push(Vec.filled(n, 0));
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, mat);
            answers.push(answer);
            check = (check * 31 + answer + 1) % 1000000007;
            let failed = [
                answer != truth,
                arm(a, turned) != answer,
                arm(a, upside) != answer,
                arm(a, mirrored) != answer,
                arm(a, taller) != answer,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
