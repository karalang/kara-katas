// LeetCode #1526: Minimum Number of Increments on Subarrays to Form a
// Target Array -- LeetCode's Rust template, written as Rust writes it and
// carried to Kāra by `karac fix`: the ★ arm over `windows(2)`.

struct Solution {}

impl Solution {
    pub fn min_number_operations(target: Vec[i32]) -> i32 {
        let mut ans = target[0];
        for w in target.windows(2) {
            if w[1] > w[0] {
                ans += w[1] - w[0];
            }
        }
        ans
    }
}

fn min_number_operations(target: Vec[i64]) -> i64 {
    Solution.min_number_operations(target.iter().map(|x| *x as i32).collect()) as i64
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` arrays of 1 to `most` numbers from 1 to `top`
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut target: Vec[i64] = Vec.new();
        for _ in 0..n {
            target.push((next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1);
        }
        check = mix(check, min_number_operations(target));
    }
    println(f"{count} arrays of 1 to {most} numbers up to {top}: checksum {check}");
}

fn main() {
    println(f"example 1, [1,2,3,2,1] -> {min_number_operations([1, 2, 3, 2, 1])}");
    println(f"example 2, [3,1,1,2] -> {min_number_operations([3, 1, 1, 2])}");
    println(f"example 3, [3,1,5,4,2] -> {min_number_operations([3, 1, 5, 4, 2])}");
    println(f"100000 alternating 1 and 40000 -> {min_number_operations((0..100000).map(|i| if i % 2 == 0 { 1 } else { 40000 }).collect())}");
    let mut seed = 1526;
    batch(3000, 12, 5, mut seed);
    batch(300, 1000, 1000, mut seed);
    batch(30, 100000, 10000, mut seed);
}
