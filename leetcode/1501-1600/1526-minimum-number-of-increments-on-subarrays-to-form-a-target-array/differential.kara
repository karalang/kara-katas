// LeetCode #1526: Minimum Number of Increments on Subarrays to Form a
// Target Array -- the differential.
//
// Five arms against the statement read literally, on 3000 arrays of 1 to
// 6 numbers from 1 to 4, with six properties.
//
// P1  the answer is the statement read literally: a breadth-first search
//     from all zeros, each step one increment on a run of places
// P2  the array reversed leaves the answer
// P3  every number raised by a random 1 to 5 raises the answer by it
// P4  the answer is at least the largest number and at most the sum
// P5  every number doubled doubles the answer
// P6  each arm agrees with at least two of the other four

// ---- increments.kara: the ★ arm: the first number and every rise

fn star_arm(target: Vec[i64]) -> i64 {
    let mut total = target[0];
    for i in 1..target.len() {
        if target[i] > target[i - 1] {
            total += target[i] - target[i - 1];
        }
    }
    total
}

// ---- increments_falls.kara: the last number and every fall

fn falls_arm(target: Vec[i64]) -> i64 {
    let n = target.len();
    let mut total = target[n - 1];
    for i in 0..n - 1 {
        total += (target[i] - target[i + 1]).max(0);
    }
    total
}

// ---- increments_stack.kara: open heights on a stack

fn stack_arm(target: Vec[i64]) -> i64 {
    let mut open: Vec[i64] = Vec.new();
    let mut total = 0;
    for t in target.iter() {
        // heights above `t` close; if any did, `t` itself stays open
        let mut fell = false;
        while open.len() > 0 and open[open.len() - 1] > t {
            open.pop();
            fell = true;
        }
        let top = if open.len() > 0 { open[open.len() - 1] } else { 0 };
        if not fell and t > top {
            total += t - top;
        }
        if t > top {
            open.push(t);
        }
    }
    total
}

// ---- increments_iter.kara: the ★ arm with iterator adapters

fn iter_arm(target: Vec[i64]) -> i64 {
    target[0] + target.iter()
        .zip(target.iter().skip(1))
        .map(|(a, b)| (b - a).max(0))
        .sum()
}

// ---- increments_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn min_number_operations(target: Vec[i32]) -> i32 {
        let mut ans = target[0];
        for w in target.windows(2) {
            if w[1] > w[0] {
                ans += w[1] - w[0];
            }
        }
        ans
    }
}

fn solution_arm(target: Vec[i64]) -> i64 {
    Solution.min_number_operations(target.iter().map(|x| *x as i32).collect()) as i64
}

// ---- the statement read literally -----------------------------------------

// Fewest increments, found by search: from all zeros, each step adds 1 to
// one run of places still below the target, breadth first, until the
// target is reached. A state is the array itself, packed in base 5.
fn literal(target: Vec[i64]) -> i64 {
    let n = target.len();
    let mut goal = 0;
    for t in target.iter() {
        goal = goal * 5 + t;
    }
    let mut steps: Map[i64, i64] = Map.new();
    let mut queue: VecDeque[Vec[i64]] = VecDeque.new();
    steps.insert(0, 0);
    queue.push_back(Vec.filled(n, 0));
    while let Some(cur) = queue.pop_front() {
        let mut key = 0;
        for x in cur.iter() {
            key = key * 5 + x;
        }
        let here = steps[key];
        if key == goal {
            return here;
        }
        for i in 0..n {
            let mut next = cur.clone();
            let mut j = i;
            while j < n and next[j] < target[j] {
                next[j] += 1;
                let mut k = 0;
                for x in next.iter() {
                    k = k * 5 + x;
                }
                if not steps.contains_key(k) {
                    steps.insert(k, here + 1);
                    queue.push_back(next.clone());
                }
                j += 1;
            }
        }
    }
    -1
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn arm(k: i64, target: Vec[i64]) -> i64 {
    if k == 0 {
        star_arm(target)
    } else if k == 1 {
        falls_arm(target)
    } else if k == 2 {
        stack_arm(target)
    } else if k == 3 {
        iter_arm(target)
    } else {
        solution_arm(target)
    }
}

fn arm_name(k: i64) -> String {
    ["star", "falls", "stack", "iter", "solution"][k].to_string()
}

fn main() {
    let arms = 5;
    let problems = 3000;
    let mut seed = 15260;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first
        let n = next_random(mut seed) % 6 + 1;
        let mut target: Vec[i64] = Vec.new();
        for _ in 0..n {
            target.push(next_random(mut seed) % 4 + 1);
        }
        let lift = next_random(mut seed) % 5 + 1;
        let back: Vec[i64] = target.iter().rev().collect();
        let lifted: Vec[i64] = target.iter().map(|t| t + lift).collect();
        let doubled: Vec[i64] = target.iter().map(|t| t * 2).collect();
        let highest = target.iter().max().unwrap();
        let total = target.iter().sum();
        let truth = literal(target);
        let mut answers: Vec[i64] = Vec.new();
        for k in 0..arms {
            let answer = arm(k, target);
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            if arm(k, back) != answer {
                fails[2] += 1;
            }
            if arm(k, lifted) != answer + lift {
                fails[3] += 1;
            }
            if answer < highest or answer > total {
                fails[4] += 1;
            }
            if arm(k, doubled) != answer * 2 {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(k)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for k in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != k and answers[other] == answers[k] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, truth);
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
