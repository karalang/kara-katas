// LeetCode #1545: Find Kth Bit in Nth Binary String -- the ★ arm: the
// recursion the definition gives. S_n is S_{n-1}, a "1", then S_{n-1}
// inverted and reversed, 2^n - 1 bits in all. The middle place 2^(n-1) is
// the "1"; a place before it is the same place in S_{n-1}; a place after
// it mirrors place 2^n - k of S_{n-1}, inverted. O(n).

fn find_kth_bit(n: i64, k: i64) -> char {
    if n == 1 {
        return '0';
    }
    let middle = 1 << (n - 1);
    if k == middle {
        '1'
    } else if k < middle {
        find_kth_bit(n - 1, k)
    } else if find_kth_bit(n - 1, (1 << n) - k) == '0' {
        '1'
    } else {
        '0'
    }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let examples = [(3, 1), (4, 11), (1, 1), (2, 3), (2, 2), (20, 524288), (20, 1048575), (20, 1)];
    for (n, k) in examples.iter() {
        println(f"n = {n}, k = {k} -> {find_kth_bit(n, k)}");
    }
    let mut s4 = String.new();
    for k in 1..16 {
        s4.push(find_kth_bit(4, k));
    }
    println(f"S4 = {s4}");
    let mut ones = 0;
    let mut check = 0;
    for k in 1..65536 {
        let bit = find_kth_bit(16, k);
        if bit == '1' {
            ones += 1;
        }
        check = mix(check, if bit == '1' { 1 } else { 0 });
    }
    println(f"every k of S16: {ones} ones, checksum {check}");
    let mut seed = 1545;
    ones = 0;
    check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 20 + 1;
        let k = (next_random(mut seed) * 32768 + next_random(mut seed)) % ((1 << n) - 1) + 1;
        let bit = find_kth_bit(n, k);
        if bit == '1' {
            ones += 1;
        }
        check = mix(check, n * 2 + if bit == '1' { 1 } else { 0 });
    }
    println(f"3000 random n and k: {ones} ones, checksum {check}");
}
