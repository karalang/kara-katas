// LeetCode #1545: Find Kth Bit in Nth Binary String -- bench: the ★ arm
// (the definition's recursion) asked for every place of S_20, two passes.

fn find_kth_bit(n: i64, k: i64) -> char {
    if n == 1 {
        return '0';
    }
    let middle = 1 << (n - 1);
    if k == middle {
        '1'
    } else if k < middle {
        find_kth_bit(n - 1, k)
    } else if find_kth_bit(n - 1, (1 << n) - k) == '0' {
        '1'
    } else {
        '0'
    }
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut check = 0;
    let mut ones = 0;
    for _ in 0..2 {
        for k in 1..1048576 {
            let bit = if find_kth_bit(20, k) == '1' { 1 } else { 0 };
            ones += bit;
            check = mix(check, bit);
        }
    }
    println(f"2 passes over every place of S_20: {ones} ones, checksum {check}");
}
