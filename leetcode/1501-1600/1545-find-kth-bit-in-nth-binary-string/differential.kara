// LeetCode #1545: Find Kth Bit in Nth Binary String -- the differential.
//
// Four arms against the statement read literally, on 3000 choices of n
// from 1 to 10 and k from 1 to 2^n - 1, with six properties. Every random
// choice is drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer is a 0 or a 1, and S_n's middle place is a 1
// P3  the same place in S_{n+1} holds the same bit
// P4  the place mirrored through the middle, 2^n - k, holds the other bit
// P5  the same place in S_20 holds the same bit
// P6  each arm agrees with at least two of the other three

// ---- kth_bit.kara: the ★ arm: the definition's recursion

fn star_arm(n: i64, k: i64) -> char {
    if n == 1 {
        return '0';
    }
    let middle = 1 << (n - 1);
    if k == middle {
        '1'
    } else if k < middle {
        star_arm(n - 1, k)
    } else if star_arm(n - 1, (1 << n) - k) == '0' {
        '1'
    } else {
        '0'
    }
}

// ---- kth_bit_loop.kara: the recursion as a loop with a flip flag

fn loop_arm(n: i64, k: i64) -> char {
    let mut k = k;
    let mut level = n;
    let mut flipped = false;
    while level > 1 {
        let middle = 1 << (level - 1);
        if k == middle {
            return if flipped { '0' } else { '1' };
        }
        if k > middle {
            k = (1 << level) - k;
            flipped = not flipped;
        }
        level -= 1;
    }
    if flipped { '1' } else { '0' }
}

// ---- kth_bit_closed.kara: the closed form from k's lowest set bit

fn bits_arm(n: i64, k: i64) -> char {
    let low = k & -k;
    let odd = k / low;
    if (odd % 4 == 3) != (low > 1) { '1' } else { '0' }
}

// ---- kth_bit_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn find_kth_bit(n: i32, k: i32) -> char {
        if n == 1 {
            return '0';
        }
        let middle = 1 << (n - 1);
        if k == middle {
            '1'
        } else if k < middle {
            Solution.find_kth_bit(n - 1, k)
        } else if Solution.find_kth_bit(n - 1, (1 << n) - k) == '0' {
            '1'
        } else {
            '0'
        }
    }
}

fn solution_arm(n: i64, k: i64) -> char {
    Solution.find_kth_bit(n as i32, k as i32)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, n: i64, k: i64) -> char {
    match a {
        0 => star_arm(n, k),
        1 => loop_arm(n, k),
        2 => bits_arm(n, k),
        _ => solution_arm(n, k),
    }
}

fn arm_name(a: i64) -> String {
    ["kth_bit", "loop", "closed", "solution"][a].to_string()
}

// ---- the statement read literally: S_1 = "0", S_i = S_{i-1} + "1" +
// reverse(invert(S_{i-1})), built out, and its k-th character read

fn literal(n: i64, k: i64) -> char {
    let mut s = "0";
    for _ in 1..n {
        let inverted: String = s.chars().map(|c| if c == '0' { '1' } else { '0' }).collect();
        let reversed: String = inverted.chars().rev().collect();
        s = s + "1" + reversed;
    }
    s.chars().nth(k - 1).unwrap()
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15450;
    let mut cases: Vec[(i64, i64)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 10 + 1;
        let k = next_random(mut seed) % ((1 << n) - 1) + 1;
        cases.push((n, k));
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for p in 0..problems {
        let (n, k) = cases[p];
        let truth = literal(n, k);
        let middle = 1 << (n - 1);
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, n, k);
            answers.push(answer);
            check = (check * 31 + if answer == '1' { 2 } else { 1 }) % 1000000007;
            let failed = [
                answer != truth,
                (answer != '0' and answer != '1') or (n > 1 and arm(a, n, middle) != '1'),
                arm(a, n + 1, k) != answer,
                k != middle and arm(a, n, (1 << n) - k) == answer,
                arm(a, 20, k) != answer,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
