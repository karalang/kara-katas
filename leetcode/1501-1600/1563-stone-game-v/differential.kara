// LeetCode #1563: Stone Game V -- the differential.
//
// Four arms against the statement read literally, on 3000 rows of 1 to 7
// stones of 1 to at most 10, with six properties. Every random choice is
// drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer is 0 exactly when there is one stone, and less than the
//     row's sum
// P3  the row reversed leaves the answer
// P4  every stone doubled doubles the answer
// P5  a stone worth the whole row put after it scores at least the row's
//     sum more
// P6  each arm agrees with at least two of the other three

// ---- stones.kara: the ★ arm: every stretch, shortest first, every split

fn star_arm(row: Vec[i64]) -> i64 {
    let n = row.len();
    let mut prefix = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + row[i];
    }
    let mut best = Vec.filled(n, Vec.filled(n, 0));
    for length in 2..=n {
        for i in 0..=n - length {
            let j = i + length - 1;
            let mut most = 0;
            for k in i..j {
                let left = prefix[k + 1] - prefix[i];
                let right = prefix[j + 1] - prefix[k + 1];
                if left < right {
                    most = most.max(left + best[i][k]);
                } else if left > right {
                    most = most.max(right + best[k + 1][j]);
                } else {
                    most = most.max(left + best[i][k].max(best[k + 1][j]));
                }
            }
            best[i][j] = most;
        }
    }
    best[0][n - 1]
}

// ---- stones_memo.kara: the game searched from the whole row, a Map of stretches

fn best_of(row: Vec[i64], prefix: Vec[i64], i: i64, j: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if i == j {
        return 0;
    }
    if let Some(known) = memo.get((i, j)) {
        return *known;
    }
    let mut most = 0;
    for k in i..j {
        let left = prefix[k + 1] - prefix[i];
        let right = prefix[j + 1] - prefix[k + 1];
        if left <= right {
            most = most.max(left + best_of(row, prefix, i, k, mut memo));
        }
        if left >= right {
            most = most.max(right + best_of(row, prefix, k + 1, j, mut memo));
        }
    }
    memo.insert((i, j), most);
    most
}

fn memo_arm(row: Vec[i64]) -> i64 {
    let mut prefix = [0];
    for v in row.iter() {
        prefix.push(prefix[prefix.len() - 1] + v);
    }
    let mut memo: Map[(i64, i64), i64] = Map.new();
    best_of(row, prefix, 0, row.len() - 1, mut memo)
}

// ---- stones_quadratic.kara: O(n^2) with a moving split point

fn quadratic_arm(row: Vec[i64]) -> i64 {
    let n = row.len();
    let mut prefix = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + row[i];
    }
    let sum = |a: i64, b: i64| prefix[b + 1] - prefix[a];
    let mut best = Vec.filled(n, Vec.filled(n, 0));
    let mut left = Vec.filled(n, Vec.filled(n, 0));
    let mut right = Vec.filled(n, Vec.filled(n, 0));
    for i in (0..n).rev() {
        left[i][i] = row[i];
        right[i][i] = row[i];
        let mut mid = i;
        for j in i + 1..n {
            // the first split point whose left side is at least half
            while 2 * sum(i, mid) < sum(i, j) {
                mid += 1;
            }
            let mut most = 0;
            if mid > i {
                most = most.max(left[i][mid - 1]);
            }
            if mid < j {
                most = most.max(right[mid + 1][j]);
            }
            if 2 * sum(i, mid) == sum(i, j) {
                most = most.max(left[i][mid]);
            }
            best[i][j] = most;
            left[i][j] = left[i][j - 1].max(sum(i, j) + most);
            right[i][j] = right[i + 1][j].max(sum(i, j) + most);
        }
    }
    best[0][n - 1]
}

// ---- stones_solution.kara: LeetCode's Rust template as karac fix and one hand edit left it

struct Solution {}

impl Solution {
    pub fn stone_game_v(stone_value: Vec[i32]) -> i32 {
        let n = stone_value.len();
        let mut pre = Vec.filled(n + 1, 0i32);
        for i in 0..n {
            pre[i + 1] = pre[i] + stone_value[i];
        }
        let mut dp = Vec.filled(n, Vec.filled(n, 0i32));
        for len in 2..=n {
            for i in 0..=n - len {
                let j = i + len - 1;
                for k in i..j {
                    let l = pre[k + 1] - pre[i];
                    let r = pre[j + 1] - pre[k + 1];
                    if l < r {
                        dp[i][j] = dp[i][j].max(l + dp[i][k]);
                    } else if l > r {
                        dp[i][j] = dp[i][j].max(r + dp[k + 1][j]);
                    } else {
                        dp[i][j] = dp[i][j].max(l + dp[i][k].max(dp[k + 1][j]));
                    }
                }
            }
        }
        dp[0][n - 1]
    }
}

fn solution_arm(row: Vec[i64]) -> i64 {
    let row: Vec[i32] = row.iter().map(|v| v as i32).collect();
    Solution.stone_game_v(row)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, row: Vec[i64]) -> i64 {
    match a {
        0 => star_arm(row),
        1 => memo_arm(row),
        2 => quadratic_arm(row),
        _ => solution_arm(row),
    }
}

fn arm_name(a: i64) -> String {
    ["stones", "memo", "quadratic", "solution"][a].to_string()
}

// ---- the statement read literally: every round played every way, with no
// table: Alice tries each split, Bob throws away the side worth more (when
// the two are worth the same, Alice picks the side thrown away), Alice
// scores the side left and plays on with it, until one stone is left

fn literal(row: Vec[i64]) -> i64 {
    if row.len() == 1 {
        return 0;
    }
    let mut best = 0;
    for k in 1..row.len() {
        let left: Vec[i64] = row[..k].to_vec();
        let right: Vec[i64] = row[k..].to_vec();
        let (l, r): (i64, i64) = (left.iter().sum(), right.iter().sum());
        if l <= r {
            best = best.max(l + literal(left.clone()));
        }
        if r <= l {
            best = best.max(r + literal(right.clone()));
        }
    }
    best
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15630;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 7 + 1;
        let top = next_random(mut seed) % 10 + 1;
        let row: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        cases.push(row);
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for p in 0..problems {
        let row = cases[p].clone();
        let truth = literal(row.clone());
        let total: i64 = row.iter().sum();
        let reversed: Vec[i64] = row.iter().rev().cloned().collect();
        let doubled: Vec[i64] = row.iter().map(|v| 2 * v).collect();
        let mut longer = row.clone();
        longer.push(total);
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, row.clone());
            answers.push(answer);
            check = (check * 31 + answer + 1) % 1000000007;
            let failed = [
                answer != truth,
                (answer == 0) != (row.len() == 1) or answer >= total,
                arm(a, reversed.clone()) != answer,
                arm(a, doubled.clone()) != 2 * answer,
                arm(a, longer.clone()) < total + answer,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
