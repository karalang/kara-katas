// LeetCode #1516: Move Sub-Tree of N-Ary Tree -- the ★ arm: find each
// node's parent by a walk from the root, ask whether q lies in p's
// subtree, and splice. Each walk is O(n).

shared struct Node {
    val: i64,
    mut children: Vec[Node],
}

// The node holding `val` as a child, if any.
fn parent_of(node: Node, val: i64) -> Option[Node] {
    for child in node.children.iter() {
        if child.val == val {
            return Some(node.clone());
        }
        let found = parent_of(child, val);
        if found.is_some() {
            return found;
        }
    }
    None
}

fn contains(node: Node, val: i64) -> bool {
    if node.val == val {
        return true;
    }
    for child in node.children.iter() {
        if contains(child, val) {
            return true;
        }
    }
    false
}

fn move_sub_tree(root: Node, p: Node, q: Node) -> Node {
    for child in q.children.iter() {
        if child.val == p.val {
            return root;
        }
    }
    let p_parent = parent_of(root, p.val);
    if contains(p, q.val) {
        // q leaves its parent and takes p's place; p goes under q
        let q_parent = parent_of(root, q.val).unwrap();
        q_parent.children.retain(|c| c.val != q.val);
        q.children.push(p.clone());
        match p_parent {
            None => return q,
            Some(parent) => {
                let i = parent.children.iter().position(|c| c.val == p.val).unwrap();
                parent.children[i] = q.clone();
            }
        }
    } else {
        let parent = p_parent.unwrap();
        parent.children.retain(|c| c.val != p.val);
        q.children.push(p.clone());
    }
    root
}

// ---- the harness: the same in every arm --------------------------------

fn show(node: Node) -> String {
    if node.children.is_empty() {
        return f"{node.val}";
    }
    let parts: Vec[String] = node.children.iter().map(|c| show(c)).collect();
    f"{node.val}({parts.join(" ")})"
}

// The tree whose node i holds vals[i] under node parents[i] (parents[0] is
// unused: node 0 is the root), children in index order.
fn build(vals: Vec[i64], parents: Vec[i64]) -> Vec[Node] {
    let nodes: Vec[Node] = vals.iter().map(|v| Node { val: v, children: Vec.new() }).collect();
    for i in 1..vals.len() {
        nodes[parents[i]].children.push(nodes[i].clone());
    }
    nodes
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// LeetCode's example tree: 1 over 2 and 3, 2 over 4 and 5, 3 over 6, 4
// over 7 and 8.
fn example(p: i64, q: i64) -> String {
    let nodes = build([1, 2, 3, 4, 5, 6, 7, 8], [0, 0, 0, 1, 1, 2, 3, 3]);
    show(move_sub_tree(nodes[0].clone(), nodes[p - 1].clone(), nodes[q - 1].clone()))
}

fn batch(count: i64, most: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (most - 1) + 2;
        let mut vals: Vec[i64] = Vec.new();
        while vals.len() < n {
            let v = next_random(mut seed) % 1000 + 1;
            if not vals.contains(v) {
                vals.push(v);
            }
        }
        let mut parents: Vec[i64] = [0];
        for i in 1..n {
            parents.push(next_random(mut seed) % i);
        }
        let p = next_random(mut seed) % n;
        let q = (p + 1 + next_random(mut seed) % (n - 1)) % n;
        let nodes = build(vals, parents);
        let root = move_sub_tree(nodes[0].clone(), nodes[p].clone(), nodes[q].clone());
        for b in show(root).bytes() {
            check = mix(check, b);
        }
    }
    check
}

fn main() {
    println(f"example 1, 4 under 1 -> {example(4, 1)}");
    println(f"example 2, 7 under 4 -> {example(7, 4)}");
    println(f"example 3, 3 under 8 -> {example(3, 8)}");
    println(f"2 under its own 7 -> {example(2, 7)}");
    println(f"the root under 8 -> {example(1, 8)}");
    println(f"5 under 2, its parent -> {example(5, 2)}");
    let mut seed = 1516;
    println(f"3000 trees of 2 to 12 nodes: checksum {batch(3000, 12, mut seed)}");
    println(f"300 trees of 2 to 300 nodes: checksum {batch(300, 300, mut seed)}");
}
