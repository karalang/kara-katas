// LeetCode #1592: Rearrange Spaces Between Words -- the bench: the ★ arm
// on 200 texts of 100000 characters, all drawn first.
//
// The ★ arm: the words by `split_whitespace`, the spaces counted, each
// gap given the spaces divided by the gaps and the rest put at the end.

fn reorder_spaces(text: String) -> String {
    let words: Vec[Str] = text.split_whitespace().collect();
    let spaces = text.bytes().iter().filter(|c| *c == b' ').count();
    let gaps = words.len() - 1;
    if gaps == 0 {
        return f"{words[0]}{" ".repeat(spaces)}";
    }
    let between = " ".repeat(spaces / gaps);
    f"{words.join(between)}{" ".repeat(spaces % gaps)}"
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `n` characters, each a space a third of the time and otherwise a
// letter from a to c, with at least one letter somewhere
fn draw(n: i64, seed: mut ref i64) -> String {
    let mut b: Vec[u8] = (0..n).map(|_| {
        let r = next_random(mut seed) % 6;
        if r < 2 { b' ' } else { b'a' + (r - 2) as u8 % 3 }
    }).collect();
    let at = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
    b[at] = b'a';
    String.from_utf8(b).unwrap()
}

fn main() {
    let mut seed = 1592;
    let texts: Vec[String] = (0..200).map(|_| draw(100000, mut seed)).collect();
    let mut check = 0;
    let mut trailing = 0;
    for text in texts.iter() {
        let answer = reorder_spaces(text);
        trailing += answer.len() - answer.trim_end().len();
        for c in answer.bytes().iter() {
            check = mix(check, *c);
        }
    }
    println(f"200 texts of 100000 characters: {trailing} trailing spaces, checksum {check}");
}
