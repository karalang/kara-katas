// LeetCode #1592: Rearrange Spaces Between Words -- split on one space.
//
// `split(" ")` gives an empty piece for every space beyond the first in a
// run; the pieces left are the words, and the spaces are the text's
// length less theirs. The answer built by `push_str`. O(n).

fn reorder_spaces(text: String) -> String {
    let words: Vec[Str] = text.split(" ").filter(|w| not w.is_empty()).collect();
    let letters: i64 = words.iter().map(|w| w.len()).sum();
    let spaces = text.len() - letters;
    let gaps = words.len() - 1;
    let mut out = String.new();
    for (k, w) in words.iter().enumerate() {
        if k > 0 {
            for _ in 0..spaces / gaps {
                out.push_str(" ");
            }
        }
        out.push_str(w);
    }
    while out.len() < text.len() {
        out.push_str(" ");
    }
    out
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `n` characters, each a space a third of the time and otherwise a
// letter from a to c, with at least one letter somewhere
fn draw(n: i64, seed: mut ref i64) -> String {
    let mut b: Vec[u8] = (0..n).map(|_| {
        let r = next_random(mut seed) % 6;
        if r < 2 { b' ' } else { b'a' + (r - 2) as u8 % 3 }
    }).collect();
    let at = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
    b[at] = b'a';
    String.from_utf8(b).unwrap()
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut trailing = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let answer = reorder_spaces(draw(n, mut seed));
        if answer.ends_with(" ") {
            trailing += 1;
        }
        for c in answer.bytes().iter() {
            check = mix(check, *c);
        }
    }
    println(f"{count} texts of up to {most} characters: {trailing} end in a space, checksum {check}");
}

fn main() {
    let examples = ["  this   is  a sentence ", " practice   makes   perfect", "hello", "  hello  ", "a b", "a  b c", " a", "x y z  "];
    for text in examples.iter() {
        println(f"\"{text}\" -> \"{reorder_spaces(text.to_string())}\"");
    }
    let mut seed = 1592;
    batch(3000, 10, mut seed);
    batch(300, 100, mut seed);
    batch(10, 100000, mut seed);
}
