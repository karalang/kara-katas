// LeetCode #1523: Count Odd Numbers in an Interval Range -- LeetCode's
// Rust template, written as Rust writes it and carried to Kāra by
// `karac fix`: the interval's length, halved, and one more when the
// length is odd and starts on an odd number.

struct Solution {}

impl Solution {
    pub fn count_odds(low: i32, high: i32) -> i32 {
        let n = high - low + 1;
        if n % 2 == 1 and (low & 1) == 1 {
            n / 2 + 1
        } else {
            n / 2
        }
    }
}

fn count_odds(low: i64, high: i64) -> i64 {
    Solution.count_odds(low as i32, high as i32) as i64
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` intervals with both ends in 0..=most, the smaller first
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most + 1);
        let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most + 1);
        check = mix(check, count_odds(a.min(b), a.max(b)));
    }
    println(f"{count} intervals within 0 to {most}: checksum {check}");
}

fn main() {
    let examples: Vec[(i64, i64)] = [(3, 7), (8, 10), (0, 0), (5, 5), (0, 1000000000), (999999999, 1000000000)];
    for (low, high) in examples.iter() {
        println(f"{low} to {high} -> {count_odds(low, high)}");
    }
    let mut seed = 1523;
    batch(3000, 20, mut seed);
    batch(3000, 1000000000, mut seed);
}
