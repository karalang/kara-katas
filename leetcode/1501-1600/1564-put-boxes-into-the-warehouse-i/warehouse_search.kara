// LeetCode #1564: Put Boxes Into the Warehouse I -- a binary search on the
// count: if k boxes fit, the k smallest do, and so does any smaller count.
// The k smallest fit when, put in the first k rooms tallest first (the
// tallest by the door, the smallest in room k - 1), each fits its room's
// usable height, which never grows going in; `partition_point` over the
// counts 1 to min(n, m) finds how many pass.

fn fits(sorted: Vec[i64], usable: Vec[i64], k: i64) -> bool {
    // the k smallest boxes, tallest first, against rooms 0 to k - 1
    (0..k).all(|i| sorted[k - 1 - i] <= usable[i])
}

fn max_boxes_in_warehouse(boxes: Vec[i64], warehouse: Vec[i64]) -> i64 {
    let mut usable = warehouse.clone();
    for i in 1..usable.len() {
        usable[i] = usable[i].min(usable[i - 1]);
    }
    let mut sorted = boxes.clone();
    sorted.sort();
    let most = sorted.len().min(usable.len());
    let counts: Vec[i64] = (1..=most).collect();
    counts.partition_point(|k| fits(sorted, usable, k))
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` problems of 1 to `most` boxes of 1 to `top` and 1 to `most`
// rooms in the upper half of that, so the rooms narrow slowly
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let m = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut boxes = Vec.new();
        for _ in 0..n {
            boxes.push((next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1);
        }
        let mut warehouse = Vec.new();
        for _ in 0..m {
            warehouse.push(top - (next_random(mut seed) * 32768 + next_random(mut seed)) % ((top + 1) / 2));
        }
        let placed = max_boxes_in_warehouse(boxes, warehouse);
        total += placed;
        check = mix(check, placed);
    }
    println(f"{count} problems of up to {most} boxes and rooms of up to {top}: {total} boxes, checksum {check}");
}

fn main() {
    let examples: Vec[(Vec[i64], Vec[i64])] = [
        ([4, 3, 4, 1], [5, 3, 3, 4, 1]),
        ([1, 2, 2, 3, 4], [3, 4, 1, 2]),
        ([1, 2, 3], [1, 2, 3, 4]),
        ([5], [4]),
        ([4], [4]),
        ([1, 1, 1], [9]),
        ([3, 2, 1], [1, 9, 9]),
        ([2, 2, 2], [9, 9, 1]),
    ];
    for (boxes, warehouse) in examples.iter() {
        println(f"boxes {boxes}, warehouse {warehouse} -> {max_boxes_in_warehouse(boxes.clone(), warehouse.clone())}");
    }
    let mut seed = 1564;
    batch(3000, 6, 10, mut seed);
    batch(300, 1000, 1000, mut seed);
    batch(30, 100000, 1000000000, mut seed);
}
