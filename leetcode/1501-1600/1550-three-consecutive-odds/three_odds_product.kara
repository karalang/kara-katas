// LeetCode #1550: Three Consecutive Odds -- a product is odd exactly when
// every factor is, so the answer is whether some three neighbours have an
// odd product: `any` over the places where a window of three ends. The
// values are at most 1000, so the product stays below 10^9. O(n)

fn three_consecutive_odds(arr: Vec[i64]) -> bool {
    (2..arr.len()).any(|i| arr[i - 2] * arr[i - 1] * arr[i] % 2 == 1)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` arrays of 1 to `longest` values from 1 to 1000, each with its
// own chance of an odd value
fn batch(count: i64, longest: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut yes = 0;
    for _ in 0..count {
        let length = next_random(mut seed) % longest + 1;
        let odds = next_random(mut seed) % 101;
        let mut arr = Vec.new();
        for _ in 0..length {
            let odd = next_random(mut seed) % 100 < odds;
            let half = next_random(mut seed) % 500;
            arr.push(if odd { 2 * half + 1 } else { 2 * half + 2 });
        }
        let answer = three_consecutive_odds(arr);
        if answer {
            yes += 1;
        }
        check = mix(check, if answer { 1 } else { 0 });
    }
    println(f"{count} arrays of up to {longest} values: {yes} true, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[i64]] = [
        [2, 6, 4, 1],
        [1, 2, 34, 3, 4, 5, 7, 23, 12],
        [1, 3, 5],
        [1, 3],
        [1],
        [2, 1, 1, 2, 1, 1, 1],
        [1, 1, 2, 1, 1, 2, 1, 1],
        [999, 1000, 999, 999, 999],
    ];
    for arr in examples.iter() {
        println(f"{arr} -> {three_consecutive_odds(arr.clone())}");
    }
    let mut alternating = Vec.new();
    for i in 0..1000 {
        alternating.push(i + 1);
    }
    println(f"1 to 1000 -> {three_consecutive_odds(alternating)}");
    let mut seed = 1550;
    batch(3000, 12, mut seed);
    batch(300, 100, mut seed);
    batch(300, 1000, mut seed);
}
