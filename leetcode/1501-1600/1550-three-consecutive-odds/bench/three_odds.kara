// LeetCode #1550: Three Consecutive Odds -- bench: the ★ arm (the run of
// odd values) over 1000 arrays of 1 to 1000 values, each with its own
// chance of an odd value, built once, each asked 2000 times with one value
// raised by one before every ask, so no ask repeats the last.

fn three_consecutive_odds(arr: Vec[i64]) -> bool {
    let mut run = 0;
    for x in arr.iter() {
        if x % 2 == 1 {
            run += 1;
            if run == 3 {
                return true;
            }
        } else {
            run = 0;
        }
    }
    false
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1550;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..1000 {
        let length = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000 + 1;
        let odds = next_random(mut seed) % 101;
        let mut arr = Vec.new();
        for _ in 0..length {
            let odd = next_random(mut seed) % 100 < odds;
            let half = next_random(mut seed) % 500;
            arr.push(if odd { 2 * half + 1 } else { 2 * half + 2 });
        }
        arrays.push(arr);
    }
    let mut yes = 0;
    let mut check = 0;
    for pass in 0..2000 {
        for g in 0..arrays.len() {
            let at = (pass * 7 + g) % arrays[g].len();
            arrays[g][at] += 1;
            if three_consecutive_odds(arrays[g]) {
                yes += 1;
                check = (check * 31 + pass + g + 1) % 1000000007;
            }
        }
    }
    println(f"2000 passes over 1000 arrays of up to 1000 values: {yes} true, checksum {check}");
}
