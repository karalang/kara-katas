// LeetCode #1531: String Compression II -- the ★ arm: best[i][j], the
// shortest encoding of the suffix from i with j deletions left. Place i
// is either deleted, or kept as the start of a run: the run walks right,
// keeping the letters equal to s[i] and deleting the others while the
// deletions last, and every place it could stop is tried. O(n^2 k).

// the length of a run's encoding: the letter, then its count if over 1
fn run_length(count: i64) -> i64 {
    if count == 1 {
        1
    } else if count < 10 {
        2
    } else if count < 100 {
        3
    } else {
        4
    }
}

fn get_length_of_optimal_compression(s: String, k: i64) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut best: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(k + 1, 0));
    for i in (0..n).rev() {
        for j in 0..k + 1 {
            let mut shortest = n + 1;
            if j > 0 {
                shortest = best[i + 1][j - 1];
            }
            let mut same = 0;
            let mut other = 0;
            for end in i..n {
                if b[end] == b[i] {
                    same += 1;
                } else {
                    other += 1;
                }
                if other > j {
                    break;
                }
                shortest = shortest.min(run_length(same) + best[end + 1][j - other]);
            }
            best[i][j] = shortest;
        }
    }
    best[0][k]
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 1 to `most` letters, each over its own first 1 to
// `letters` letters, and k from 0 to the length
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let over = next_random(mut seed) % letters + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % over) as u8 as char);
        }
        let k = next_random(mut seed) % (n + 1);
        check = mix(check, get_length_of_optimal_compression(s, k));
    }
    println(f"{count} strings of 1 to {most} letters over up to {letters}: checksum {check}");
}

fn main() {
    let examples: Vec[(String, i64)] = [
        ("aaabcccd", 2),
        ("aabbaa", 2),
        ("aaaaaaaaaaa", 0),
        ("abcdefghijklmnopqrstuvwxyz", 25),
        ("a", 1),
        ("aaaaaaaaaab", 1),
    ];
    for (s, k) in examples.iter() {
        println(f"{s}, k = {k} -> {get_length_of_optimal_compression(s.clone(), k)}");
    }
    let hundred: String = (0..100).map(|_| 'a').collect();
    println(f"100 a's, k = 0 -> {get_length_of_optimal_compression(hundred, 0)}");
    let mut seed = 1531;
    batch(3000, 12, 3, mut seed);
    batch(300, 100, 4, mut seed);
}
