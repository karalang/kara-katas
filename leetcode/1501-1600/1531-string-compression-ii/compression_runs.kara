// LeetCode #1531: String Compression II -- left to right, the state is
// what the kept text ends with: its last letter, how long that letter's
// run is, and how many deletions are spent. Each letter is deleted or
// kept; kept, it either grows the run (the encoding grows only when the
// count gains a digit, at 1, 9 and 99) or starts a new one. A map per step
// holds the shortest encoding of each state. O(n^2 k) states at most.

// how much longer a run's encoding gets when its count goes up from `run`
fn growth(run: i64) -> i64 {
    if run == 1 or run == 9 or run == 99 {
        1
    } else {
        0
    }
}

fn get_length_of_optimal_compression(s: String, k: i64) -> i64 {
    // (last letter, run length, deletions spent) -> shortest encoding;
    // letter 0 is the empty text
    let mut states: Map[(i64, i64, i64), i64] = Map.new();
    states.insert((0, 0, 0), 0);
    for c in s.bytes().iter() {
        let letter = c as i64;
        let mut next: Map[(i64, i64, i64), i64] = Map.new();
        for ((last, run, spent), length) in states.iter() {
            let mut keep = |key: (i64, i64, i64), value: i64| {
                match next.get(key) {
                    Some(old) if old <= value => {}
                    _ => {
                        next.insert(key, value);
                    }
                }
            };
            if spent < k {
                keep((last, run, spent + 1), length);
            }
            if letter == last {
                keep((last, run + 1, spent), length + growth(run));
            } else {
                keep((letter, 1, spent), length + 1);
            }
        }
        states = next;
    }
    states.values().min().unwrap()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 1 to `most` letters, each over its own first 1 to
// `letters` letters, and k from 0 to the length
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let over = next_random(mut seed) % letters + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % over) as u8 as char);
        }
        let k = next_random(mut seed) % (n + 1);
        check = mix(check, get_length_of_optimal_compression(s, k));
    }
    println(f"{count} strings of 1 to {most} letters over up to {letters}: checksum {check}");
}

fn main() {
    let examples: Vec[(String, i64)] = [
        ("aaabcccd", 2),
        ("aabbaa", 2),
        ("aaaaaaaaaaa", 0),
        ("abcdefghijklmnopqrstuvwxyz", 25),
        ("a", 1),
        ("aaaaaaaaaab", 1),
    ];
    for (s, k) in examples.iter() {
        println(f"{s}, k = {k} -> {get_length_of_optimal_compression(s.clone(), k)}");
    }
    let hundred: String = (0..100).map(|_| 'a').collect();
    println(f"100 a's, k = 0 -> {get_length_of_optimal_compression(hundred, 0)}");
    let mut seed = 1531;
    batch(3000, 12, 3, mut seed);
    batch(300, 100, 4, mut seed);
}
