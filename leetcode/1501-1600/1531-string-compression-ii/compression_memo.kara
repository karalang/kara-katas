// LeetCode #1531: String Compression II -- the ★ arm's recurrence asked
// top down: shortest(i, j) recurses on the suffix after the place it
// deletes or the run it keeps, and each answer is kept in a table so it is
// worked out once. O(n^2 k).

fn run_length(count: i64) -> i64 {
    if count == 1 {
        1
    } else if count < 10 {
        2
    } else if count < 100 {
        3
    } else {
        4
    }
}

// the shortest encoding of b[i..] with `j` deletions left; -1 is unknown
fn shortest(b: Slice[u8], i: i64, j: i64, memo: mut ref Vec[Vec[i64]]) -> i64 {
    if b.len() - i <= j {
        return 0;
    }
    if memo[i][j] >= 0 {
        return memo[i][j];
    }
    let mut best = b.len() + 1;
    if j > 0 {
        best = shortest(b, i + 1, j - 1, mut memo);
    }
    let mut same = 0;
    let mut other = 0;
    for end in i..b.len() {
        if b[end] == b[i] {
            same += 1;
        } else {
            other += 1;
            if other > j {
                break;
            }
        }
        best = best.min(run_length(same) + shortest(b, end + 1, j - other, mut memo));
    }
    memo[i][j] = best;
    best
}

fn get_length_of_optimal_compression(s: String, k: i64) -> i64 {
    let b = s.bytes();
    let mut memo: Vec[Vec[i64]] = Vec.filled(b.len() + 1, Vec.filled(k + 1, -1));
    shortest(b, 0, k, mut memo)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 1 to `most` letters, each over its own first 1 to
// `letters` letters, and k from 0 to the length
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let over = next_random(mut seed) % letters + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % over) as u8 as char);
        }
        let k = next_random(mut seed) % (n + 1);
        check = mix(check, get_length_of_optimal_compression(s, k));
    }
    println(f"{count} strings of 1 to {most} letters over up to {letters}: checksum {check}");
}

fn main() {
    let examples: Vec[(String, i64)] = [
        ("aaabcccd", 2),
        ("aabbaa", 2),
        ("aaaaaaaaaaa", 0),
        ("abcdefghijklmnopqrstuvwxyz", 25),
        ("a", 1),
        ("aaaaaaaaaab", 1),
    ];
    for (s, k) in examples.iter() {
        println(f"{s}, k = {k} -> {get_length_of_optimal_compression(s.clone(), k)}");
    }
    let hundred: String = (0..100).map(|_| 'a').collect();
    println(f"100 a's, k = 0 -> {get_length_of_optimal_compression(hundred, 0)}");
    let mut seed = 1531;
    batch(3000, 12, 3, mut seed);
    batch(300, 100, 4, mut seed);
}
