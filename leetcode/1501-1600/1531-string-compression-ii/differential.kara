// LeetCode #1531: String Compression II -- the differential.
//
// Four arms against the statement read literally, on 3000 strings of 1
// to 10 letters over up to 3 and k from 0 to the length, with six
// properties.
//
// P1  the answer is the statement read literally: every set of at most k
//     places deleted, the rest run-length encoded, the shortest kept
// P2  the string reversed has the same answer
// P3  one more deletion never lengthens the answer, and k at the length
//     gives 0
// P4  the answer is at least 0 when k is the length and at least 1
//     otherwise, at most the encoding with nothing deleted, and that
//     encoding exactly at k = 0
// P5  the letters renamed (a to b, b to c, c to a) leave the answer
// P6  each arm agrees with at least one of the other three

// ---- compression.kara: the ★ arm: suffixes bottom up

// the length of a run's encoding: the letter, then its count if over 1
fn run_length(count: i64) -> i64 {
    if count == 1 {
        1
    } else if count < 10 {
        2
    } else if count < 100 {
        3
    } else {
        4
    }
}

fn star_arm(s: String, k: i64) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut best: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(k + 1, 0));
    for i in (0..n).rev() {
        for j in 0..k + 1 {
            let mut shortest = n + 1;
            if j > 0 {
                shortest = best[i + 1][j - 1];
            }
            let mut same = 0;
            let mut other = 0;
            for end in i..n {
                if b[end] == b[i] {
                    same += 1;
                } else {
                    other += 1;
                }
                if other > j {
                    break;
                }
                shortest = shortest.min(run_length(same) + best[end + 1][j - other]);
            }
            best[i][j] = shortest;
        }
    }
    best[0][k]
}

// ---- compression_memo.kara: the same recurrence top down, memoized

// the shortest encoding of b[i..] with `j` deletions left; -1 is unknown
fn memo_shortest(b: Slice[u8], i: i64, j: i64, memo: mut ref Vec[Vec[i64]]) -> i64 {
    if b.len() - i <= j {
        return 0;
    }
    if memo[i][j] >= 0 {
        return memo[i][j];
    }
    let mut best = b.len() + 1;
    if j > 0 {
        best = memo_shortest(b, i + 1, j - 1, mut memo);
    }
    let mut same = 0;
    let mut other = 0;
    for end in i..b.len() {
        if b[end] == b[i] {
            same += 1;
        } else {
            other += 1;
            if other > j {
                break;
            }
        }
        best = best.min(run_length(same) + memo_shortest(b, end + 1, j - other, mut memo));
    }
    memo[i][j] = best;
    best
}

fn memo_arm(s: String, k: i64) -> i64 {
    let b = s.bytes();
    let mut memo: Vec[Vec[i64]] = Vec.filled(b.len() + 1, Vec.filled(k + 1, -1));
    memo_shortest(b, 0, k, mut memo)
}

// ---- compression_runs.kara: left to right over (last letter, run, deletions) states

// how much longer a run's encoding gets when its count goes up from `run`
fn growth(run: i64) -> i64 {
    if run == 1 or run == 9 or run == 99 {
        1
    } else {
        0
    }
}

fn runs_arm(s: String, k: i64) -> i64 {
    // (last letter, run length, deletions spent) -> shortest encoding;
    // letter 0 is the empty text
    let mut states: Map[(i64, i64, i64), i64] = Map.new();
    states.insert((0, 0, 0), 0);
    for c in s.bytes().iter() {
        let letter = c as i64;
        let mut next: Map[(i64, i64, i64), i64] = Map.new();
        for ((last, run, spent), length) in states.iter() {
            let mut keep = |key: (i64, i64, i64), value: i64| {
                match next.get(key) {
                    Some(old) if old <= value => {}
                    _ => {
                        next.insert(key, value);
                    }
                }
            };
            if spent < k {
                keep((last, run, spent + 1), length);
            }
            if letter == last {
                keep((last, run + 1, spent), length + growth(run));
            } else {
                keep((letter, 1, spent), length + 1);
            }
        }
        states = next;
    }
    states.values().min().unwrap()
}

// ---- compression_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn get_length_of_optimal_compression(s: String, k: i32) -> i32 {
        let s = s.bytes();
        let n = s.len();
        let k = k as i64;
        let mut dp = Vec.filled(n + 1, Vec.filled(k + 1, 0i32));
        for i in (0..n).rev() {
            for j in 0..=k {
                let mut best = i32.MAX;
                if j > 0 {
                    best = dp[i + 1][j - 1];
                }
                let mut (same, diff) = (0, 0);
                for m in i..n {
                    if s[m] == s[i] {
                        same += 1;
                    } else {
                        diff += 1;
                        if diff > j {
                            break;
                        }
                    }
                    let len: i32 = if same == 1 {
                        1
                    } else if same < 10 {
                        2
                    } else if same < 100 {
                        3
                    } else {
                        4
                    };
                    best = best.min(len + dp[m + 1][j - diff]);
                }
                dp[i][j] = best;
            }
        }
        dp[0][k]
    }
}

fn solution_arm(s: String, k: i64) -> i64 {
    Solution.get_length_of_optimal_compression(s, k as i32)
}

// ---- the statement read literally -----------------------------------------

// the run-length encoding's length: each run is its letter, then its count
// when the count is over 1
fn encoded_length(b: Vec[u8]) -> i64 {
    let mut length = 0;
    let mut i = 0;
    while i < b.len() {
        let mut j = i;
        while j < b.len() and b[j] == b[i] {
            j += 1;
        }
        length += 1;
        if j - i > 1 {
            length += f"{j - i}".len();
        }
        i = j;
    }
    length
}

// "Delete at most k characters from s such that the run-length encoded
// version of s has minimum length": every subset of places, as a bit mask,
// with at most k deleted.
fn literal(s: String, k: i64) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut best = n + 1;
    for mask in 0..(1 << n) {
        if mask.count_ones() > k {
            continue;
        }
        let mut kept: Vec[u8] = Vec.new();
        for i in 0..n {
            if (mask >> i) & 1 == 0 {
                kept.push(b[i]);
            }
        }
        best = best.min(encoded_length(kept));
    }
    best
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn arm(k: i64, s: String, deletions: i64) -> i64 {
    if k == 0 {
        star_arm(s, deletions)
    } else if k == 1 {
        memo_arm(s, deletions)
    } else if k == 2 {
        runs_arm(s, deletions)
    } else {
        solution_arm(s, deletions)
    }
}

fn arm_name(k: i64) -> String {
    ["star", "memo", "runs", "solution"][k].to_string()
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15310;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first
        let n = next_random(mut seed) % 10 + 1;
        let over = next_random(mut seed) % 3 + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % over) as u8 as char);
        }
        let k = next_random(mut seed) % (n + 1);
        let back: String = s.chars().rev().collect();
        let renamed: String = s.chars().map(|c| if c == 'c' { 'a' } else { (c as u32 as u8 + 1) as char }).collect();
        let whole = encoded_length(s.bytes().to_vec());
        let truth = literal(s.clone(), k);
        let mut answers: Vec[i64] = Vec.new();
        for a in 0..arms {
            let answer = arm(a, s.clone(), k);
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            if arm(a, back.clone(), k) != answer {
                fails[2] += 1;
            }
            if (k < n and arm(a, s.clone(), k + 1) > answer) or arm(a, s.clone(), n) != 0 {
                fails[3] += 1;
            }
            let least = if k == n { 0 } else { 1 };
            if answer < least or answer > whole or arm(a, s.clone(), 0) != whole {
                fails[4] += 1;
            }
            if arm(a, renamed.clone(), k) != answer {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 1 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, truth);
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
