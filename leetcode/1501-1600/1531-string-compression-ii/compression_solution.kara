// LeetCode #1531: String Compression II -- LeetCode's Rust template as
// karac fix left it: the ★ arm, a `dp` table over suffixes counting in
// `i32`.

struct Solution {}

impl Solution {
    pub fn get_length_of_optimal_compression(s: String, k: i32) -> i32 {
        let s = s.bytes();
        let n = s.len();
        let k = k as i64;
        let mut dp = Vec.filled(n + 1, Vec.filled(k + 1, 0i32));
        for i in (0..n).rev() {
            for j in 0..=k {
                let mut best = i32.MAX;
                if j > 0 {
                    best = dp[i + 1][j - 1];
                }
                let mut (same, diff) = (0, 0);
                for m in i..n {
                    if s[m] == s[i] {
                        same += 1;
                    } else {
                        diff += 1;
                        if diff > j {
                            break;
                        }
                    }
                    let len: i32 = if same == 1 {
                        1
                    } else if same < 10 {
                        2
                    } else if same < 100 {
                        3
                    } else {
                        4
                    };
                    best = best.min(len + dp[m + 1][j - diff]);
                }
                dp[i][j] = best;
            }
        }
        dp[0][k]
    }
}

fn get_length_of_optimal_compression(s: String, k: i64) -> i64 {
    Solution.get_length_of_optimal_compression(s, k as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 1 to `most` letters, each over its own first 1 to
// `letters` letters, and k from 0 to the length
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let over = next_random(mut seed) % letters + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % over) as u8 as char);
        }
        let k = next_random(mut seed) % (n + 1);
        check = mix(check, get_length_of_optimal_compression(s, k));
    }
    println(f"{count} strings of 1 to {most} letters over up to {letters}: checksum {check}");
}

fn main() {
    let examples: Vec[(String, i64)] = [
        ("aaabcccd", 2),
        ("aabbaa", 2),
        ("aaaaaaaaaaa", 0),
        ("abcdefghijklmnopqrstuvwxyz", 25),
        ("a", 1),
        ("aaaaaaaaaab", 1),
    ];
    for (s, k) in examples.iter() {
        println(f"{s}, k = {k} -> {get_length_of_optimal_compression(s.clone(), k)}");
    }
    let hundred: String = (0..100).map(|_| 'a').collect();
    println(f"100 a's, k = 0 -> {get_length_of_optimal_compression(hundred, 0)}");
    let mut seed = 1531;
    batch(3000, 12, 3, mut seed);
    batch(300, 100, 4, mut seed);
}
