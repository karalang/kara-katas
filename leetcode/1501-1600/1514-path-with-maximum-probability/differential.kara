// LeetCode #1514: Path with Maximum Probability -- the differential.
//
// Five arms against the statement read literally, on 2000 graphs, with six
// properties.
//
// P1  the answer is the statement read literally: every simple path from
//     start to end walked, the largest product kept
// P2  start and end swapped leave the answer to within 10^-12 (the
//     product is then taken the other way round, and rounds differently)
// P3  the edges listed backwards leave the answer
// P4  a new edge from start to end with chance q makes the answer the
//     larger of the two
// P5  every chance set to 1 makes the answer 1 when it was above 0, and 0
//     when it was 0
// P6  each arm agrees with at least three of the other four

// ---- chance.kara: the ★ arm: Dijkstra on a largest-first queue
fn star_arm(n: i64, edges: Vec[(i64, i64)], succ_prob: Vec[f64], start: i64, end: i64) -> f64 {
    let mut adjacent: Vec[Vec[(i64, f64)]] = Vec.filled(n, Vec.new());
    for i in 0..edges.len() {
        let (a, b) = edges[i];
        adjacent[a].push((b, succ_prob[i]));
        adjacent[b].push((a, succ_prob[i]));
    }
    let mut best: Vec[f64] = Vec.filled(n, 0.0);
    best[start] = 1.0;
    let mut queue: PriorityQueue[(F64, i64)] = PriorityQueue.max_first();
    queue.push((F64.from(1.0), start));
    while let Some((chance, node)) = queue.pop() {
        if node == end {
            return chance.value;
        }
        if chance.value < best[node] {
            continue;
        }
        for (next, p) in adjacent[node].iter() {
            let through = chance.value * p;
            if through > best[next] {
                best[next] = through;
                queue.push((F64.from(through), next));
            }
        }
    }
    0.0
}

// ---- chance_bellman.kara: Bellman-Ford
fn bellman_arm(n: i64, edges: Vec[(i64, i64)], succ_prob: Vec[f64], start: i64, end: i64) -> f64 {
    let mut best: Vec[f64] = Vec.filled(n, 0.0);
    best[start] = 1.0;
    let mut changed = true;
    while changed {
        changed = false;
        for i in 0..edges.len() {
            let (a, b) = edges[i];
            let p = succ_prob[i];
            if best[a] * p > best[b] {
                best[b] = best[a] * p;
                changed = true;
            }
            if best[b] * p > best[a] {
                best[a] = best[b] * p;
                changed = true;
            }
        }
    }
    best[end]
}

// ---- chance_spfa.kara: a work queue
fn spfa_arm(n: i64, edges: Vec[(i64, i64)], succ_prob: Vec[f64], start: i64, end: i64) -> f64 {
    let mut adjacent: Vec[Vec[(i64, f64)]] = Vec.filled(n, Vec.new());
    for i in 0..edges.len() {
        let (a, b) = edges[i];
        adjacent[a].push((b, succ_prob[i]));
        adjacent[b].push((a, succ_prob[i]));
    }
    let mut best: Vec[f64] = Vec.filled(n, 0.0);
    best[start] = 1.0;
    let mut waiting: Vec[bool] = Vec.filled(n, false);
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(start);
    waiting[start] = true;
    while let Some(node) = queue.pop_front() {
        waiting[node] = false;
        for (next, p) in adjacent[node].iter() {
            let through = best[node] * p;
            if through > best[next] {
                best[next] = through;
                if not waiting[next] {
                    waiting[next] = true;
                    queue.push_back(next);
                }
            }
        }
    }
    best[end]
}

// ---- chance_dense.kara: Dijkstra by scan
fn dense_arm(n: i64, edges: Vec[(i64, i64)], succ_prob: Vec[f64], start: i64, end: i64) -> f64 {
    let mut adjacent: Vec[Vec[(i64, f64)]] = Vec.filled(n, Vec.new());
    for i in 0..edges.len() {
        let (a, b) = edges[i];
        adjacent[a].push((b, succ_prob[i]));
        adjacent[b].push((a, succ_prob[i]));
    }
    let mut best: Vec[f64] = Vec.filled(n, 0.0);
    best[start] = 1.0;
    let mut settled: Vec[bool] = Vec.filled(n, false);
    loop {
        let mut pick = -1;
        for v in 0..n {
            if not settled[v] and best[v] > 0.0 and (pick < 0 or best[v] > best[pick]) {
                pick = v;
            }
        }
        if pick < 0 or pick == end {
            break;
        }
        settled[pick] = true;
        for (next, p) in adjacent[pick].iter() {
            if best[pick] * p > best[next] {
                best[next] = best[pick] * p;
            }
        }
    }
    best[end]
}

// ---- chance_solution.kara: LeetCode's Rust template through karac fix
struct Solution {}

impl Solution {
    pub fn max_probability(n: i32, edges: Vec[Vec[i32]], succ_prob: Vec[f64], start_node: i32, end_node: i32) -> f64 {
        let mut best = Vec.filled(n, 0.0);
        best[start_node as usize] = 1.0;
        loop {
            let mut changed = false;
            for (i, e) in edges.iter().enumerate() {
                let (a, b) = (e[0] as usize, e[1] as usize);
                let p = succ_prob[i];
                if best[a] * p > best[b] {
                    best[b] = best[a] * p;
                    changed = true;
                }
                if best[b] * p > best[a] {
                    best[a] = best[b] * p;
                    changed = true;
                }
            }
            if not changed {
                break;
            }
        }
        best[end_node as usize]
    }
}

fn solution_arm(n: i64, edges: Vec[(i64, i64)], succ_prob: Vec[f64], start: i64, end: i64) -> f64 {
    let pairs: Vec[Vec[i32]] = edges.iter().map(|(a, b)| [a as i32, b as i32]).collect();
    Solution.max_probability(n as i32, pairs, succ_prob.clone(), start as i32, end as i32)
}

// ---- the statement read literally ----------------------------------------

// Walks every simple path on from `node`, carrying its chance so far.
fn walk(node: i64, chance: f64, end: i64, edges: Vec[(i64, i64)], succ_prob: Vec[f64], on_path: mut ref Vec[bool]) -> f64 {
    if node == end {
        return chance;
    }
    let mut best = 0.0;
    for i in 0..edges.len() {
        let (a, b) = edges[i];
        let next = if a == node { b } else if b == node { a } else { -1 };
        if next >= 0 and not on_path[next] {
            on_path[next] = true;
            let got = walk(next, chance * succ_prob[i], end, edges, succ_prob, mut on_path);
            on_path[next] = false;
            if got > best {
                best = got;
            }
        }
    }
    best
}

fn literal(n: i64, edges: Vec[(i64, i64)], succ_prob: Vec[f64], start: i64, end: i64) -> f64 {
    let mut on_path: Vec[bool] = Vec.filled(n, false);
    on_path[start] = true;
    walk(start, 1.0, end, edges, succ_prob, mut on_path)
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn fixed(p: f64) -> i64 {
    (p * 100000.0 + 0.5).floor() as i64
}

fn arm(k: i64, n: i64, edges: Vec[(i64, i64)], succ_prob: Vec[f64], start: i64, end: i64) -> f64 {
    if k == 0 {
        star_arm(n, edges, succ_prob, start, end)
    } else if k == 1 {
        bellman_arm(n, edges, succ_prob, start, end)
    } else if k == 2 {
        spfa_arm(n, edges, succ_prob, start, end)
    } else if k == 3 {
        dense_arm(n, edges, succ_prob, start, end)
    } else {
        solution_arm(n, edges, succ_prob, start, end)
    }
}

fn arm_name(k: i64) -> String {
    ["star", "bellman", "spfa", "dense", "solution"][k].to_string()
}

fn main() {
    let arms = 5;
    let problems = 2000;
    let mut seed = 15140;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first
        let n = next_random(mut seed) % 6 + 2;
        let m = next_random(mut seed) % (2 * n) + 1;
        let mut edges: Vec[(i64, i64)] = Vec.new();
        let mut probs: Vec[f64] = Vec.new();
        for _ in 0..m {
            let a = next_random(mut seed) % n;
            let b = (a + 1 + next_random(mut seed) % (n - 1)) % n;
            edges.push((a, b));
            probs.push((next_random(mut seed) % 100 + 1) as f64 / 100.0);
        }
        let start = next_random(mut seed) % n;
        let end = (start + 1 + next_random(mut seed) % (n - 1)) % n;
        let q = (next_random(mut seed) % 100 + 1) as f64 / 100.0;
        let backwards_edges: Vec[(i64, i64)] = edges.iter().rev().collect();
        let backwards_probs: Vec[f64] = probs.iter().rev().collect();
        let mut more_edges = edges.clone();
        more_edges.push((start, end));
        let mut more_probs = probs.clone();
        more_probs.push(q);
        let certain: Vec[f64] = Vec.filled(m, 1.0);

        let truth = literal(n, edges, probs, start, end);
        let mut answers: Vec[f64] = Vec.new();
        for k in 0..arms {
            let answer = arm(k, n, edges, probs, start, end);
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            if (arm(k, n, edges, probs, end, start) - answer).abs() > 1e-12 {
                fails[2] += 1;
            }
            if arm(k, n, backwards_edges, backwards_probs, start, end) != answer {
                fails[3] += 1;
            }
            if arm(k, n, more_edges, more_probs, start, end) != answer.max(q) {
                fails[4] += 1;
            }
            let all_or_none = if answer > 0.0 { 1.0 } else { 0.0 };
            if arm(k, n, edges, certain, start, end) != all_or_none {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(k)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for k in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != k and answers[other] == answers[k] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 3 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, fixed(answers[0]));
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
