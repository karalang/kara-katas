// LeetCode #1514: Path with Maximum Probability -- a work queue (SPFA): a
// node whose chance rose goes back on a `VecDeque` to relax its edges,
// unless it is already waiting there.

fn max_probability(n: i64, edges: Vec[(i64, i64)], succ_prob: Vec[f64], start: i64, end: i64) -> f64 {
    let mut adjacent: Vec[Vec[(i64, f64)]] = Vec.filled(n, Vec.new());
    for i in 0..edges.len() {
        let (a, b) = edges[i];
        adjacent[a].push((b, succ_prob[i]));
        adjacent[b].push((a, succ_prob[i]));
    }
    let mut best: Vec[f64] = Vec.filled(n, 0.0);
    best[start] = 1.0;
    let mut waiting: Vec[bool] = Vec.filled(n, false);
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(start);
    waiting[start] = true;
    while let Some(node) = queue.pop_front() {
        waiting[node] = false;
        for (next, p) in adjacent[node].iter() {
            let through = best[node] * p;
            if through > best[next] {
                best[next] = through;
                if not waiting[next] {
                    waiting[next] = true;
                    queue.push_back(next);
                }
            }
        }
    }
    best[end]
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// The probability in hundred-thousandths, rounded half up.
fn fixed(p: f64) -> i64 {
    (p * 100000.0 + 0.5).floor() as i64
}

// `count` graphs of 2 to `most` nodes and up to `spread` edges per node,
// each edge's chance a whole number of hundredths from 0.80 to 1.
fn batch(count: i64, most: i64, spread: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (most - 1) + 2;
        let m = next_random(mut seed) % (spread * n) + 1;
        let mut edges: Vec[(i64, i64)] = Vec.new();
        let mut probs: Vec[f64] = Vec.new();
        for _ in 0..m {
            let a = next_random(mut seed) % n;
            let b = (a + 1 + next_random(mut seed) % (n - 1)) % n;
            edges.push((a, b));
            probs.push((next_random(mut seed) % 21 + 80) as f64 / 100.0);
        }
        let start = next_random(mut seed) % n;
        let end = (start + 1 + next_random(mut seed) % (n - 1)) % n;
        check = mix(check, fixed(max_probability(n, edges, probs, start, end)));
    }
    check
}

fn main() {
    let edges: Vec[(i64, i64)] = [(0, 1), (1, 2), (0, 2)];
    println(f"example 1 -> {max_probability(3, edges, [0.5, 0.5, 0.2], 0, 2):.5}");
    println(f"example 2 -> {max_probability(3, edges, [0.5, 0.5, 0.3], 0, 2):.5}");
    println(f"example 3 -> {max_probability(3, [(0, 1)], [0.5], 0, 2):.5}");
    let chain: Vec[(i64, i64)] = (0..9).map(|i| (i, i + 1)).collect();
    println(f"a chain of ten at 0.9 -> {max_probability(10, chain, Vec.filled(9, 0.9), 0, 9):.5}");
    let mut seed = 1514;
    println(f"2000 graphs of 2 to 8 nodes: checksum {batch(2000, 8, 2, mut seed)}");
    println(f"200 graphs of 2 to 200 nodes: checksum {batch(200, 200, 2, mut seed)}");
    println(f"3 graphs of 2 to 10000 nodes: checksum {batch(3, 10000, 2, mut seed)}");
}
