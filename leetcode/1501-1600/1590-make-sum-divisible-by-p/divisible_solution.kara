// LeetCode #1590: Make Sum Divisible by P -- a Rust solution as
// LeetCode's Rust users write it (`impl Solution`, a `HashMap<i64, i32>`
// of prefix remainders, `rem_euclid`, `if let Some(&i)`), carried to Kāra
// by `karac fix`.

struct Solution {}

impl Solution {
    pub fn min_subarray(nums: Vec[i32], p: i32) -> i32 {
        let p = p as i64;
        let total: i64 = nums.iter().map(|x| x as i64).sum();
        let need = total % p;
        if need == 0 {
            return 0;
        }
        let n = nums.len() as i32;
        let mut seen: Map[i64, i32] = Map.new();
        seen.insert(0, -1);
        let mut cur = 0;
        let mut ans = n;
        for (i, x) in nums.iter().enumerate() {
            cur = (cur + x as i64) % p;
            let target = (cur - need).rem_euclid(p);
            if let Some(j) = seen.get(target).cloned() {
                ans = ans.min(i as i32 - j);
            }
            seen.insert(cur, i as i32);
        }
        if ans == n { -1 } else { ans }
    }
}

fn min_subarray(nums: Vec[i32], p: i32) -> i32 {
    Solution.min_subarray(nums, p)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn batch(count: i64, most: i64, top: i64, most_p: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut none = 0;
    for _ in 0..count {
        let n = wide(mut seed) % most + 1;
        let nums: Vec[i32] = (0..n).map(|_| (wide(mut seed) % top + 1) as i32).collect();
        let p = (wide(mut seed) % most_p + 1) as i32;
        let answer = min_subarray(nums, p);
        if answer == -1 {
            none += 1;
        }
        check = mix(check, answer);
    }
    println(f"{count} problems of up to {most} values, p up to {most_p}: {none} impossible, checksum {check}");
}

fn main() {
    let examples: Vec[(Vec[i32], i32)] = [
        ([3, 1, 4, 2], 6),
        ([6, 3, 5, 2], 9),
        ([1, 2, 3], 3),
        ([1, 2, 3], 7),
        ([1000000000, 1000000000, 1000000000], 3),
        ([4, 4, 2], 7),
        ([5], 5),
        ([5], 3),
    ];
    for (nums, p) in examples.iter() {
        println(f"{nums} {p} -> {min_subarray(nums, p)}");
    }
    let mut seed = 1590;
    batch(3000, 8, 9, 12, mut seed);
    batch(300, 1000, 1000000000, 1000, mut seed);
    batch(10, 100000, 1000000000, 100000, mut seed);
}
