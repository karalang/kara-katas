// LeetCode #1590: Make Sum Divisible by P -- the bench: the ★ arm on 40
// problems of 100000 values up to 10^9, p up to 10^5, all drawn first.
//
// The ★ arm: the latest prefix with each remainder kept in a `Map`, and
// each end j matched with the latest prefix of remainder prefix(j) - need.

fn min_subarray(nums: Vec[i32], p: i32) -> i32 {
    let p = p as i64;
    let need = nums.iter().map(|v| *v as i64).sum() % p;
    if need == 0 {
        return 0;
    }
    let mut last: Map[i64, i64] = Map.new();
    last.insert(0, -1);
    let mut prefix = 0;
    let mut best = nums.len();
    for (j, v) in nums.iter().enumerate() {
        prefix = (prefix + *v) % p;
        if let Some(i) = last.get((prefix - need + p) % p) {
            best = best.min(j - *i);
        }
        last.insert(prefix, j);
    }
    if best == nums.len() { -1 } else { best as i32 }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 1590;
    let mut problems: Vec[(Vec[i32], i32)] = Vec.new();
    for _ in 0..40 {
        let nums: Vec[i32] = (0..100000).map(|_| (wide(mut seed) % 1000000000 + 1) as i32).collect();
        let p = (wide(mut seed) % 100000 + 1) as i32;
        problems.push((nums, p));
    }
    let mut check = 0;
    let mut total = 0;
    for (nums, p) in problems.iter() {
        let answer = min_subarray(nums, p);
        total += answer;
        check = mix(check, answer);
    }
    println(f"40 problems of 100000 values: lengths {total}, checksum {check}");
}
