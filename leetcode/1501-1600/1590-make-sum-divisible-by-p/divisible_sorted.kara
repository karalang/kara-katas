// LeetCode #1590: Make Sum Divisible by P -- sorted prefixes.
//
// No hash map: every prefix sum's remainder paired with its place, the
// pairs sorted, and for each end j a binary search for the last prefix
// before j with remainder prefix(j) - need. O(n log n).

fn min_subarray(nums: Vec[i32], p: i32) -> i32 {
    let p = p as i64;
    let n = nums.len();
    let mut prefix = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = (prefix[i] + nums[i]) % p;
    }
    let need = prefix[n];
    if need == 0 {
        return 0;
    }
    let mut pairs: Vec[(i64, i64)] = (0..n + 1).map(|i| (prefix[i], i)).collect();
    pairs.sort();
    let mut best = n;
    for j in 1..n + 1 {
        let want = (prefix[j] - need + p) % p;
        // the first pair at or past (want, j): the one before it is the
        // last prefix before j with that remainder, if any
        let mut lo = 0;
        let mut hi = pairs.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if pairs[mid] < (want, j) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo > 0 and pairs[lo - 1].0 == want {
            best = best.min(j - pairs[lo - 1].1);
        }
    }
    if best == n { -1 } else { best as i32 }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn batch(count: i64, most: i64, top: i64, most_p: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut none = 0;
    for _ in 0..count {
        let n = wide(mut seed) % most + 1;
        let nums: Vec[i32] = (0..n).map(|_| (wide(mut seed) % top + 1) as i32).collect();
        let p = (wide(mut seed) % most_p + 1) as i32;
        let answer = min_subarray(nums, p);
        if answer == -1 {
            none += 1;
        }
        check = mix(check, answer);
    }
    println(f"{count} problems of up to {most} values, p up to {most_p}: {none} impossible, checksum {check}");
}

fn main() {
    let examples: Vec[(Vec[i32], i32)] = [
        ([3, 1, 4, 2], 6),
        ([6, 3, 5, 2], 9),
        ([1, 2, 3], 3),
        ([1, 2, 3], 7),
        ([1000000000, 1000000000, 1000000000], 3),
        ([4, 4, 2], 7),
        ([5], 5),
        ([5], 3),
    ];
    for (nums, p) in examples.iter() {
        println(f"{nums} {p} -> {min_subarray(nums, p)}");
    }
    let mut seed = 1590;
    batch(3000, 8, 9, 12, mut seed);
    batch(300, 1000, 1000000000, 1000, mut seed);
    batch(10, 100000, 1000000000, 100000, mut seed);
}
