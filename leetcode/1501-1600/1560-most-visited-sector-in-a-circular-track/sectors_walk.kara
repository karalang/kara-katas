// LeetCode #1560: Most Visited Sector in a Circular Track -- the run
// walked sector by sector: a count per sector in a `Vec`, the start
// counted once, each leg from `windows(2)` stepped round until it arrives,
// and the sectors with the largest count kept.

fn most_visited(n: i64, rounds: Vec[i64]) -> Vec[i64] {
    let mut visits = Vec.filled(n + 1, 0);
    visits[rounds[0]] += 1;
    for leg in rounds.windows(2).into_iter() {
        let mut at = leg[0];
        while at != leg[1] {
            at = at % n + 1;
            visits[at] += 1;
        }
    }
    let most = visits.iter().max().unwrap();
    (1..=n).filter(|s| visits[s] == most).collect()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` tracks of 2 to `most` sectors, each run of 1 to `legs` legs, every
// leg ending at a sector other than the one it starts at
fn batch(count: i64, most: i64, legs: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (most - 1) + 2;
        let m = next_random(mut seed) % legs + 1;
        let mut rounds = [next_random(mut seed) % n + 1];
        for _ in 0..m {
            let at = rounds[rounds.len() - 1];
            rounds.push((at - 1 + next_random(mut seed) % (n - 1) + 1) % n + 1);
        }
        let sectors = most_visited(n, rounds);
        total += sectors.len();
        for s in sectors.iter() {
            check = mix(check, s);
        }
        check = mix(check, -1);
    }
    println(f"{count} tracks of up to {most} sectors and {legs} legs: {total} sectors, checksum {check}");
}

fn main() {
    let examples: Vec[(i64, Vec[i64])] = [
        (4, [1, 3, 1, 2]),
        (2, [2, 1, 2, 1, 2, 1, 2, 1, 2]),
        (7, [1, 3, 5, 7]),
        (2, [1, 2]),
        (5, [3, 1]),
        (5, [5, 1]),
        (3, [2, 3, 1, 2]),
        (10, [7, 2, 9, 6]),
    ];
    for (n, rounds) in examples.iter() {
        println(f"n = {n}, rounds {rounds} -> {most_visited(n, rounds.clone())}");
    }
    let mut seed = 1560;
    batch(3000, 8, 8, mut seed);
    batch(300, 100, 100, mut seed);
    batch(30, 1000, 100, mut seed);
}
