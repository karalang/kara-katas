// LeetCode #1554: Strings Differ by One Character -- the blotted patterns
// hashed rather than built: each word's polynomial hash, with place `j`'s
// letter taken back out, is the hash of the word with that place blotted.
// Words that share a blotted hash at the same place are checked letter by
// letter, so a collision cannot answer wrongly. A `Map` from (place, hash)
// to the words seen there. O(n m) expected.

fn differ_by_one(dict: Vec[String]) -> bool {
    let modulus = 1000000007;
    let base = 31;
    let words: Vec[Vec[i64]] = dict.iter().map(|w| w.bytes().iter().map(|b| b as i64 - 96).collect()).collect();
    let m = words[0].len();
    let mut power = Vec.filled(m, 1);
    for j in (0..m - 1).rev() {
        power[j] = power[j + 1] * base % modulus;
    }
    let mut seen: Map[(i64, i64), Vec[i64]] = Map.new();
    for w in 0..words.len() {
        let mut whole = 0;
        for j in 0..m {
            whole = (whole + words[w][j] * power[j]) % modulus;
        }
        for j in 0..m {
            let blotted = (whole - words[w][j] * power[j] % modulus + modulus) % modulus;
            let others = seen.entry((j, blotted)).or_insert(Vec.new());
            for o in others.iter() {
                let mut differ = 0;
                for k in 0..m {
                    if words[o][k] != words[w][k] {
                        differ += 1;
                    }
                }
                if differ == 1 {
                    return true;
                }
            }
            others.push(w);
        }
    }
    false
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` lists of 1 to `most` distinct words of one length from 1 to
// `longest`, over each list's own first 1 to `letters` letters
fn batch(count: i64, most: i64, longest: i64, letters: i64, seed: mut ref i64) {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut check = 0;
    let mut yes = 0;
    for _ in 0..count {
        let want = next_random(mut seed) % most + 1;
        let length = next_random(mut seed) % longest + 1;
        let own = next_random(mut seed) % letters + 1;
        let mut room = 1;
        for _ in 0..length {
            room = (room * own).min(want);
        }
        let mut taken: Set[String] = Set.new();
        let mut dict = Vec.new();
        while dict.len() < want.min(room) {
            let word: String = (0..length).map(|_| alphabet[next_random(mut seed) % own]).collect();
            if taken.insert(word.clone()) {
                dict.push(word);
            }
        }
        let answer = differ_by_one(dict);
        if answer {
            yes += 1;
        }
        check = mix(check, if answer { 1 } else { 0 });
    }
    println(f"{count} lists of up to {most} words of up to {longest} letters: {yes} true, checksum {check}");
}

fn words(list: Vec[Str]) -> Vec[String] {
    list.iter().map(|w| w.to_string()).collect()
}

fn main() {
    let examples: Vec[Vec[String]] = [
        words(["abcd", "acbd", "aacd"]),
        words(["ab", "cd", "yz"]),
        words(["abcd", "cccc", "abyd", "abab"]),
        words(["a"]),
        words(["a", "b"]),
        words(["ab", "ba"]),
        words(["abc", "xbz", "xyc", "ayz"]),
        words(["aaaa", "aaab", "zzzz"]),
    ];
    for dict in examples.iter() {
        println(f"{dict} -> {differ_by_one(dict.clone())}");
    }
    let mut seed = 1554;
    batch(3000, 8, 5, 3, mut seed);
    batch(300, 1000, 20, 4, mut seed);
    batch(30, 10000, 10, 26, mut seed);
}
