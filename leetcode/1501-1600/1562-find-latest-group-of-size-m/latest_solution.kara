// LeetCode #1562: Find Latest Group of Size M -- LeetCode's Rust template
// as karac fix left it: the ★ arm over `i32`, the lengths at the group
// ends in a `Vec<i32>` indexed by `usize`.

struct Solution {}

impl Solution {
    pub fn find_latest_step(arr: Vec[i32], m: i32) -> i32 {
        let n = arr.len();
        let mut len = Vec.filled(n + 2, 0i32);
        let mut count = 0;
        let mut ans = -1;
        for (i, x) in arr.iter().enumerate() {
            let x = x as usize;
            let l = len[x - 1];
            let r = len[x + 1];
            let total = l + r + 1;
            if l == m {
                count -= 1;
            }
            if r == m {
                count -= 1;
            }
            if total == m {
                count += 1;
            }
            len[x - l as usize] = total;
            len[x + r as usize] = total;
            if count > 0 {
                ans = i as i32 + 1;
            }
        }
        ans
    }
}

fn find_latest_step(arr: Vec[i64], m: i64) -> i64 {
    let arr: Vec[i32] = arr.iter().map(|a| a as i32).collect();
    Solution.find_latest_step(arr, m as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` orders of 1 to `most` positions, each with an `m` from 1 to 8
// half the time and from 1 to n the other half
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut found = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut arr: Vec[i64] = (1..=n).collect();
        for i in (1..n).rev() {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            arr.swap(i, j);
        }
        let m = if next_random(mut seed) % 2 == 0 {
            next_random(mut seed) % n.min(8) + 1
        } else {
            next_random(mut seed) % n + 1
        };
        let step = find_latest_step(arr, m);
        if step >= 0 {
            found += 1;
        }
        check = mix(check, step);
    }
    println(f"{count} orders of up to {most} positions: {found} with a group, checksum {check}");
}

fn main() {
    let examples: Vec[(Vec[i64], i64)] = [
        ([3, 5, 1, 2, 4], 1),
        ([3, 1, 5, 4, 2], 2),
        ([1], 1),
        ([2, 1], 2),
        ([2, 1], 1),
        ([1, 2, 3, 4], 2),
        ([4, 3, 2, 1], 1),
        ([1, 3, 5, 2, 4], 1),
        ([2, 4, 6, 1, 3, 5], 3),
    ];
    for (arr, m) in examples.iter() {
        println(f"{arr}, m = {m} -> {find_latest_step(arr.clone(), m)}");
    }
    let mut seed = 1562;
    batch(3000, 8, mut seed);
    batch(300, 1000, mut seed);
    batch(30, 100000, mut seed);
}
