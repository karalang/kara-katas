// LeetCode #1579: Remove Max Number of Edges to Keep Graph Fully Traversable
// -- the ★ arm: two disjoint-set forests, one for Alice and one for Bob,
// each a struct with path halving and union by size. The type 3 edges go
// into both first; then each type 1 edge into Alice's and type 2 into
// Bob's. An edge is kept when it joins two parts of a forest it goes into;
// the answer is the rest, or -1 when either forest is left in more than
// one part. O(m α(n))

struct Dsu {
    parent: Vec[i64],
    size: Vec[i64],
    parts: i64,
}

impl Dsu {
    fn new(n: i64) -> Dsu {
        Dsu { parent: (0..n + 1).collect(), size: Vec.filled(n + 1, 1), parts: n }
    }

    fn find(mut ref self, x: i64) -> i64 {
        let mut x = x;
        while self.parent[x] != x {
            self.parent[x] = self.parent[self.parent[x]];
            x = self.parent[x];
        }
        x
    }

    // joins the parts of `a` and `b`; false when they were one already
    fn join(mut ref self, a: i64, b: i64) -> bool {
        let ra = self.find(a);
        let rb = self.find(b);
        if ra == rb {
            return false;
        }
        let (big, small) = if self.size[ra] < self.size[rb] { (rb, ra) } else { (ra, rb) };
        self.parent[small] = big;
        self.size[big] += self.size[small];
        self.parts -= 1;
        true
    }
}

fn max_num_edges_to_remove(n: i64, edges: Vec[Vec[i64]]) -> i64 {
    let mut alice = Dsu.new(n);
    let mut bob = Dsu.new(n);
    let mut kept = 0;
    for e in edges.iter() {
        if e[0] == 3 {
            let a = alice.join(e[1], e[2]);
            let b = bob.join(e[1], e[2]);
            if a or b {
                kept += 1;
            }
        }
    }
    for e in edges.iter() {
        if e[0] == 1 and alice.join(e[1], e[2]) {
            kept += 1;
        }
        if e[0] == 2 and bob.join(e[1], e[2]) {
            kept += 1;
        }
    }
    if alice.parts != 1 or bob.parts != 1 {
        return -1;
    }
    edges.len() - kept
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` graphs of 2 to `most` + 1 nodes: from each node but the last, 1
// to `draws` edges to a node at most `reach` further on, half of them type
// 3 and a quarter each type 1 and 2 (a repeated edge dropped), then the
// edges shuffled
fn batch(count: i64, most: i64, draws: i64, reach: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    let mut stuck = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 2;
        let mut seen: Set[i64] = Set.new();
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for u in 1..n {
            for _ in 0..next_random(mut seed) % draws + 1 {
                let kind = (next_random(mut seed) % 4).min(2) + 1;
                let v = (u + 1 + next_random(mut seed) % reach).min(n);
                if seen.insert((kind * (n + 1) + u) * (n + 1) + v) {
                    edges.push([kind, u, v]);
                }
            }
        }
        for i in (1..edges.len()).rev() {
            edges.swap(i, (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1));
        }
        let removed = max_num_edges_to_remove(n, edges);
        if removed < 0 {
            stuck += 1;
        } else {
            total += removed;
        }
        check = mix(check, removed + 1);
    }
    println(f"{count} graphs of up to {most + 1} nodes: {stuck} not traversable, edges removed {total}, checksum {check}");
}

fn main() {
    let examples: Vec[(i64, Vec[Vec[i64]])] = [
        (4, [[3, 1, 2], [3, 2, 3], [1, 1, 3], [1, 2, 4], [1, 1, 2], [2, 3, 4]]),
        (4, [[3, 1, 2], [3, 2, 3], [1, 1, 4], [2, 1, 4]]),
        (4, [[3, 2, 3], [1, 1, 2], [2, 3, 4]]),
        (2, [[1, 1, 2], [2, 1, 2], [3, 1, 2]]),
        (3, [[3, 1, 2], [3, 2, 3], [3, 1, 3], [1, 1, 3], [2, 1, 2]]),
        (3, [[1, 1, 2], [1, 2, 3], [2, 1, 3]]),
    ];
    for (n, edges) in examples.iter() {
        println(f"{n} {edges} -> {max_num_edges_to_remove(n, edges)}");
    }
    let mut seed = 1579;
    batch(3000, 5, 3, 2, mut seed);
    batch(300, 300, 8, 8, mut seed);
    batch(10, 10000, 14, 12, mut seed);
}
