// LeetCode #1579: Remove Max Number of Edges to Keep Graph Fully Traversable
// -- the parts arm: no union-find. A graph on n nodes in c parts needs
// n - c edges to span it, so the type 3 edges in c3 parts give n - c3 that
// both share, and each of Alice and Bob needs (n - 1) - (n - c3) = c3 - 1
// more of their own. The parts are counted by a walk with a stack over
// adjacency lists of the edges of the types asked for. When Alice's or
// Bob's graph is in more than one part the answer is -1; else it is
// m - (n - c3) - 2 (c3 - 1). O(n + m)

// how many parts the nodes 1..n fall into over the edges of type `kind`
// or 3
fn parts(n: i64, edges: Vec[Vec[i64]], kind: i64) -> i64 {
    let mut next: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        if e[0] == kind or e[0] == 3 {
            next[e[1]].push(e[2]);
            next[e[2]].push(e[1]);
        }
    }
    let mut seen = Vec.filled(n + 1, false);
    let mut count = 0;
    for start in 1..n + 1 {
        if seen[start] {
            continue;
        }
        count += 1;
        seen[start] = true;
        let mut stack = [start];
        while let Some(x) = stack.pop() {
            for y in next[x].iter() {
                if not seen[y] {
                    seen[y] = true;
                    stack.push(y);
                }
            }
        }
    }
    count
}

fn max_num_edges_to_remove(n: i64, edges: Vec[Vec[i64]]) -> i64 {
    if parts(n, edges, 1) != 1 or parts(n, edges, 2) != 1 {
        return -1;
    }
    let shared = parts(n, edges, 3);
    edges.len() - (n - shared) - 2 * (shared - 1)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` graphs of 2 to `most` + 1 nodes: from each node but the last, 1
// to `draws` edges to a node at most `reach` further on, half of them type
// 3 and a quarter each type 1 and 2 (a repeated edge dropped), then the
// edges shuffled
fn batch(count: i64, most: i64, draws: i64, reach: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    let mut stuck = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 2;
        let mut seen: Set[i64] = Set.new();
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for u in 1..n {
            for _ in 0..next_random(mut seed) % draws + 1 {
                let kind = (next_random(mut seed) % 4).min(2) + 1;
                let v = (u + 1 + next_random(mut seed) % reach).min(n);
                if seen.insert((kind * (n + 1) + u) * (n + 1) + v) {
                    edges.push([kind, u, v]);
                }
            }
        }
        for i in (1..edges.len()).rev() {
            edges.swap(i, (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1));
        }
        let removed = max_num_edges_to_remove(n, edges);
        if removed < 0 {
            stuck += 1;
        } else {
            total += removed;
        }
        check = mix(check, removed + 1);
    }
    println(f"{count} graphs of up to {most + 1} nodes: {stuck} not traversable, edges removed {total}, checksum {check}");
}

fn main() {
    let examples: Vec[(i64, Vec[Vec[i64]])] = [
        (4, [[3, 1, 2], [3, 2, 3], [1, 1, 3], [1, 2, 4], [1, 1, 2], [2, 3, 4]]),
        (4, [[3, 1, 2], [3, 2, 3], [1, 1, 4], [2, 1, 4]]),
        (4, [[3, 2, 3], [1, 1, 2], [2, 3, 4]]),
        (2, [[1, 1, 2], [2, 1, 2], [3, 1, 2]]),
        (3, [[3, 1, 2], [3, 2, 3], [3, 1, 3], [1, 1, 3], [2, 1, 2]]),
        (3, [[1, 1, 2], [1, 2, 3], [2, 1, 3]]),
    ];
    for (n, edges) in examples.iter() {
        println(f"{n} {edges} -> {max_num_edges_to_remove(n, edges)}");
    }
    let mut seed = 1579;
    batch(3000, 5, 3, 2, mut seed);
    batch(300, 300, 8, 8, mut seed);
    batch(10, 10000, 14, 12, mut seed);
}
