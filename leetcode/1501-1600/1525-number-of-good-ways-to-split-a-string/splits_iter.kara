// LeetCode #1525: Number of Good Ways to Split a String -- the ★ arm with
// iterator adapters: `scan` carries the letters seen so far as a bit set
// and yields its size, once from the left and once from the right; `zip`
// pairs each prefix with the suffix after it and `filter` and `count`
// take the agreeing ones.

fn distinct_runs(letters: Vec[i64]) -> Vec[i64] {
    letters.iter()
        .scan(0, |seen, c| {
            let next = seen | (1 << c);
            Some((next, next.count_ones()))
        })
        .collect()
}

fn num_splits(s: String) -> i64 {
    let letters: Vec[i64] = s.bytes().iter().map(|x| (x - 97) as i64).collect();
    let left = distinct_runs(letters.clone());
    let mut right = distinct_runs(letters.iter().rev().collect());
    right.reverse();
    left.iter()
        .zip(right.iter().skip(1))
        .filter(|(l, r)| l == r)
        .count()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 1 to `most` letters drawn from the first `letters`
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % letters) as u8 as char);
        }
        check = mix(check, num_splits(s));
    }
    println(f"{count} strings of 1 to {most} letters over {letters}: checksum {check}");
}

fn main() {
    let examples: Vec[String] = ["aacaba", "abcd", "aaaaa", "acbadbaada", "a"];
    for s in examples.iter() {
        println(f"{s} -> {num_splits(s.clone())}");
    }
    let mut seed = 1525;
    batch(3000, 12, 4, mut seed);
    batch(300, 300, 26, mut seed);
    batch(30, 100000, 26, mut seed);
}
