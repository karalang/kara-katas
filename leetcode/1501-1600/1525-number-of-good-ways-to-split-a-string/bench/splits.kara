// LeetCode #1525: Number of Good Ways to Split a String -- bench: the ★
// arm over 200 random strings of 1 to 100000 letters, built once and
// answered 10 times.

fn num_splits(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut left: Vec[i64] = Vec.filled(n, 0);
    let mut seen: Vec[bool] = Vec.filled(26, false);
    let mut distinct = 0;
    for i in 0..n {
        let c = (b[i] - 97) as i64;
        if not seen[c] {
            seen[c] = true;
            distinct += 1;
        }
        left[i] = distinct;
    }
    let mut right: Vec[i64] = Vec.filled(n, 0);
    seen = Vec.filled(26, false);
    distinct = 0;
    for i in (0..n).rev() {
        let c = (b[i] - 97) as i64;
        if not seen[c] {
            seen[c] = true;
            distinct += 1;
        }
        right[i] = distinct;
    }
    let mut good = 0;
    for i in 1..n {
        if left[i - 1] == right[i] {
            good += 1;
        }
    }
    good
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1525;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..200 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1;
        let letters = next_random(mut seed) % 26 + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % letters) as u8 as char);
        }
        strings.push(s);
    }
    let mut check = 0;
    let mut total = 0;
    for _ in 0..10 {
        for s in strings.iter() {
            let good = num_splits(s.clone());
            total += good;
            check = mix(check, good);
        }
    }
    println(f"10 passes over 200 strings of up to 100000 letters: {total} good splits, checksum {check}");
}
