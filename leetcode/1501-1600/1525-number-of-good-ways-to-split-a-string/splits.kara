// LeetCode #1525: Number of Good Ways to Split a String -- the ★ arm:
// the count of distinct letters in every prefix, walking from the left,
// and in every suffix, walking from the right; a split is good where the
// prefix ending before it and the suffix starting at it agree. O(n).

fn num_splits(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut left: Vec[i64] = Vec.filled(n, 0);
    let mut seen: Vec[bool] = Vec.filled(26, false);
    let mut distinct = 0;
    for i in 0..n {
        let c = (b[i] - 97) as i64;
        if not seen[c] {
            seen[c] = true;
            distinct += 1;
        }
        left[i] = distinct;
    }
    let mut right: Vec[i64] = Vec.filled(n, 0);
    seen = Vec.filled(26, false);
    distinct = 0;
    for i in (0..n).rev() {
        let c = (b[i] - 97) as i64;
        if not seen[c] {
            seen[c] = true;
            distinct += 1;
        }
        right[i] = distinct;
    }
    let mut good = 0;
    for i in 1..n {
        if left[i - 1] == right[i] {
            good += 1;
        }
    }
    good
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 1 to `most` letters drawn from the first `letters`
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % letters) as u8 as char);
        }
        check = mix(check, num_splits(s));
    }
    println(f"{count} strings of 1 to {most} letters over {letters}: checksum {check}");
}

fn main() {
    let examples: Vec[String] = ["aacaba", "abcd", "aaaaa", "acbadbaada", "a"];
    for s in examples.iter() {
        println(f"{s} -> {num_splits(s.clone())}");
    }
    let mut seed = 1525;
    batch(3000, 12, 4, mut seed);
    batch(300, 300, 26, mut seed);
    batch(30, 100000, 26, mut seed);
}
