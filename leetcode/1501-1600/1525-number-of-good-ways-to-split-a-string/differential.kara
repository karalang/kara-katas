// LeetCode #1525: Number of Good Ways to Split a String -- the
// differential.
//
// Five arms against the statement read literally, on 3000 strings of 1
// to 10 letters over 3, with six properties.
//
// P1  the answer is the statement read literally: every split's halves
//     cut out and their distinct letters counted
// P2  the string reversed leaves the answer
// P3  the letters renamed (a to b, b to c, c to a) leave the answer
// P4  the answer is at least 0 and at most the number of splits
// P5  every letter doubled leaves every old split good, so the answer
//     does not fall
// P6  each arm agrees with at least two of the other four

// ---- splits.kara: the ★ arm: distinct letters in every prefix and suffix

fn star_arm(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut left: Vec[i64] = Vec.filled(n, 0);
    let mut seen: Vec[bool] = Vec.filled(26, false);
    let mut distinct = 0;
    for i in 0..n {
        let c = (b[i] - 97) as i64;
        if not seen[c] {
            seen[c] = true;
            distinct += 1;
        }
        left[i] = distinct;
    }
    let mut right: Vec[i64] = Vec.filled(n, 0);
    seen = Vec.filled(26, false);
    distinct = 0;
    for i in (0..n).rev() {
        let c = (b[i] - 97) as i64;
        if not seen[c] {
            seen[c] = true;
            distinct += 1;
        }
        right[i] = distinct;
    }
    let mut good = 0;
    for i in 1..n {
        if left[i - 1] == right[i] {
            good += 1;
        }
    }
    good
}

// ---- splits_counts.kara: two count tables, one walk

fn counts_arm(s: String) -> i64 {
    let b = s.bytes();
    let mut left: Vec[i64] = Vec.filled(26, 0);
    let mut right: Vec[i64] = Vec.filled(26, 0);
    let mut on_right = 0;
    for x in b.iter() {
        let c = (x - 97) as i64;
        if right[c] == 0 {
            on_right += 1;
        }
        right[c] += 1;
    }
    let mut on_left = 0;
    let mut good = 0;
    for i in 0..b.len() - 1 {
        let c = (b[i] - 97) as i64;
        if left[c] == 0 {
            on_left += 1;
        }
        left[c] += 1;
        right[c] -= 1;
        if right[c] == 0 {
            on_right -= 1;
        }
        if on_left == on_right {
            good += 1;
        }
    }
    good
}

// ---- splits_ends.kara: each letter's first and last place

fn ends_arm(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut first: Vec[i64] = Vec.filled(26, -1);
    let mut last: Vec[i64] = Vec.filled(26, -1);
    for i in 0..n {
        let c = (b[i] - 97) as i64;
        if first[c] < 0 {
            first[c] = i;
        }
        last[c] = i;
    }
    // starts[k]: letters whose first place is k; ends[k]: last place is k
    let mut starts: Vec[i64] = Vec.filled(n, 0);
    let mut ends: Vec[i64] = Vec.filled(n, 0);
    let mut on_right = 0;
    for c in 0..26 {
        if first[c] >= 0 {
            starts[first[c]] += 1;
            ends[last[c]] += 1;
            on_right += 1;
        }
    }
    let mut on_left = 0;
    let mut good = 0;
    for k in 1..n {
        on_left += starts[k - 1];
        on_right -= ends[k - 1];
        if on_left == on_right {
            good += 1;
        }
    }
    good
}

// ---- splits_iter.kara: the ★ arm with iterator adapters

fn iter_distinct_runs(letters: Vec[i64]) -> Vec[i64] {
    letters.iter()
        .scan(0, |seen, c| {
            let next = seen | (1 << c);
            Some((next, next.count_ones()))
        })
        .collect()
}

fn iter_arm(s: String) -> i64 {
    let letters: Vec[i64] = s.bytes().iter().map(|x| (x - 97) as i64).collect();
    let left = iter_distinct_runs(letters.clone());
    let mut right = iter_distinct_runs(letters.iter().rev().collect());
    right.reverse();
    left.iter()
        .zip(right.iter().skip(1))
        .filter(|(l, r)| l == r)
        .count()
}

// ---- splits_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn num_splits(s: String) -> i32 {
        let b = s.bytes();
        let mut left = [0usize; 26];
        let mut right = [0usize; 26];
        for c in b {
            right[(c - b'a') as usize] += 1;
        }
        let mut on_left = 0;
        let mut on_right = right.iter().filter(|x| x > 0).count();
        let mut ans = 0;
        for c in b[..b.len() - 1] {
            let i = (c - b'a') as usize;
            if left[i] == 0 {
                on_left += 1;
            }
            left[i] += 1;
            right[i] -= 1;
            if right[i] == 0 {
                on_right -= 1;
            }
            if on_left == on_right {
                ans += 1;
            }
        }
        ans
    }
}

fn solution_arm(s: String) -> i64 {
    Solution.num_splits(s)
}

// ---- the statement read literally -----------------------------------------

// every split, both halves cut out and their distinct letters counted with
// a set each
fn literal(s: String) -> i64 {
    let n = s.len();
    let mut good = 0;
    for k in 1..n {
        let left: Set[char] = s[0..k].chars().collect();
        let right: Set[char] = s[k..n].chars().collect();
        if left.len() == right.len() {
            good += 1;
        }
    }
    good
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn arm(k: i64, s: String) -> i64 {
    if k == 0 {
        star_arm(s)
    } else if k == 1 {
        counts_arm(s)
    } else if k == 2 {
        ends_arm(s)
    } else if k == 3 {
        iter_arm(s)
    } else {
        solution_arm(s)
    }
}

fn arm_name(k: i64) -> String {
    ["star", "counts", "ends", "iter", "solution"][k].to_string()
}

// each letter moved one place round the first three
fn renamed(s: String) -> String {
    s.chars().map(|c| (97 + (c as u32 - 97 + 1) % 3) as u8 as char).collect()
}

fn main() {
    let arms = 5;
    let problems = 3000;
    let mut seed = 15250;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first
        let n = next_random(mut seed) % 10 + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % 3) as u8 as char);
        }
        let back: String = s.chars().rev().collect();
        let doubled: String = s.chars().flat_map(|c| [c, c].into_iter()).collect();
        let truth = literal(s);
        let mut answers: Vec[i64] = Vec.new();
        for k in 0..arms {
            let answer = arm(k, s);
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            if arm(k, back) != answer {
                fails[2] += 1;
            }
            if arm(k, renamed(s)) != answer {
                fails[3] += 1;
            }
            if answer < 0 or answer > n - 1 {
                fails[4] += 1;
            }
            // each letter doubled: the old splits stay, and a split inside
            // a doubled letter matches the split before that letter or
            // the one after it, so the count is at least the old one
            if arm(k, doubled) < answer {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(k)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for k in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != k and answers[other] == answers[k] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, truth);
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
