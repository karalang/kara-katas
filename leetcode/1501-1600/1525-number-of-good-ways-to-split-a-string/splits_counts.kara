// LeetCode #1525: Number of Good Ways to Split a String -- one walk with
// two count tables: every letter starts on the right; moving a letter
// left adds a distinct letter on the left the first time it is seen
// there and removes one on the right the last time. O(n).

fn num_splits(s: String) -> i64 {
    let b = s.bytes();
    let mut left: Vec[i64] = Vec.filled(26, 0);
    let mut right: Vec[i64] = Vec.filled(26, 0);
    let mut on_right = 0;
    for x in b.iter() {
        let c = (x - 97) as i64;
        if right[c] == 0 {
            on_right += 1;
        }
        right[c] += 1;
    }
    let mut on_left = 0;
    let mut good = 0;
    for i in 0..b.len() - 1 {
        let c = (b[i] - 97) as i64;
        if left[c] == 0 {
            on_left += 1;
        }
        left[c] += 1;
        right[c] -= 1;
        if right[c] == 0 {
            on_right -= 1;
        }
        if on_left == on_right {
            good += 1;
        }
    }
    good
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 1 to `most` letters drawn from the first `letters`
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % letters) as u8 as char);
        }
        check = mix(check, num_splits(s));
    }
    println(f"{count} strings of 1 to {most} letters over {letters}: checksum {check}");
}

fn main() {
    let examples: Vec[String] = ["aacaba", "abcd", "aaaaa", "acbadbaada", "a"];
    for s in examples.iter() {
        println(f"{s} -> {num_splits(s.clone())}");
    }
    let mut seed = 1525;
    batch(3000, 12, 4, mut seed);
    batch(300, 300, 26, mut seed);
    batch(30, 100000, 26, mut seed);
}
