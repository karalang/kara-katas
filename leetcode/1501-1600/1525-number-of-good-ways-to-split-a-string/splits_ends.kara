// LeetCode #1525: Number of Good Ways to Split a String -- by each
// letter's first and last place: a split before place k has on its left
// every letter first seen before k, and on its right every letter last
// seen at k or after. Each letter adds 1 to the left count from just past
// its first place on, and 1 to the right count up to its last place; two
// running sums over those marks give both counts. O(n + 26).

fn num_splits(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut first: Vec[i64] = Vec.filled(26, -1);
    let mut last: Vec[i64] = Vec.filled(26, -1);
    for i in 0..n {
        let c = (b[i] - 97) as i64;
        if first[c] < 0 {
            first[c] = i;
        }
        last[c] = i;
    }
    // starts[k]: letters whose first place is k; ends[k]: last place is k
    let mut starts: Vec[i64] = Vec.filled(n, 0);
    let mut ends: Vec[i64] = Vec.filled(n, 0);
    let mut on_right = 0;
    for c in 0..26 {
        if first[c] >= 0 {
            starts[first[c]] += 1;
            ends[last[c]] += 1;
            on_right += 1;
        }
    }
    let mut on_left = 0;
    let mut good = 0;
    for k in 1..n {
        on_left += starts[k - 1];
        on_right -= ends[k - 1];
        if on_left == on_right {
            good += 1;
        }
    }
    good
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 1 to `most` letters drawn from the first `letters`
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((97 + next_random(mut seed) % letters) as u8 as char);
        }
        check = mix(check, num_splits(s));
    }
    println(f"{count} strings of 1 to {most} letters over {letters}: checksum {check}");
}

fn main() {
    let examples: Vec[String] = ["aacaba", "abcd", "aaaaa", "acbadbaada", "a"];
    for s in examples.iter() {
        println(f"{s} -> {num_splits(s.clone())}");
    }
    let mut seed = 1525;
    batch(3000, 12, 4, mut seed);
    batch(300, 300, 26, mut seed);
    batch(30, 100000, 26, mut seed);
}
