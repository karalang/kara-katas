// LeetCode #1528: Shuffle String -- LeetCode's Rust template as karac fix
// left it: the ★ arm, a `vec![0u8; n]` buffer indexed by `usize`.

struct Solution {}

impl Solution {
    pub fn restore_string(s: String, indices: Vec[i32]) -> String {
        let mut res = Vec.filled(s.len(), 0u8);
        for (c, i) in s.bytes().iter().zip(indices.iter()) {
            res[i as usize] = c;
        }
        String.from_utf8(res).unwrap()
    }
}

fn restore_string(s: String, indices: Vec[i64]) -> String {
    Solution.restore_string(s, indices.iter().map(|x| *x as i32).collect())
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// 1 to `most` letters from the first `letters`, and a shuffled 0..n
fn random_case(most: i64, letters: i64, seed: mut ref i64) -> (String, Vec[i64]) {
    let n = next_random(mut seed) % most + 1;
    let mut s = String.new();
    for _ in 0..n {
        s.push((97 + next_random(mut seed) % letters) as u8 as char);
    }
    let mut indices: Vec[i64] = (0..n).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        indices.swap(i, j);
    }
    (s, indices)
}

fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let (s, indices) = random_case(most, letters, mut seed);
        for b in restore_string(s, indices).bytes().iter() {
            check = mix(check, *b as i64 - 96);
        }
    }
    println(f"{count} strings of 1 to {most} letters over {letters}: checksum {check}");
}

fn main() {
    let examples: Vec[(String, Vec[i64])] = [
        ("codeleet", [4, 5, 6, 7, 0, 2, 1, 3]),
        ("abc", [0, 1, 2]),
        ("aiohn", [3, 1, 4, 2, 0]),
        ("z", [0]),
        ("abcdefghij", [9, 8, 7, 6, 5, 4, 3, 2, 1, 0]),
    ];
    for (s, indices) in examples.iter() {
        println(f"{s}, {indices} -> {restore_string(s.clone(), indices.clone())}");
    }
    let mut seed = 1528;
    batch(3000, 8, 3, mut seed);
    batch(3000, 100, 26, mut seed);
}
