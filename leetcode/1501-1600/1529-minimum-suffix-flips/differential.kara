// LeetCode #1529: Minimum Suffix Flips -- the differential.
//
// Five arms against the statement read literally, on 3000 strings of 1 to
// 10 bits, with six properties.
//
// P1  the answer is the statement read literally: a breadth-first search
//     from all zeros, each step one suffix flip
// P2  every bit flipped moves the answer by one: up when the string
//     starts with 0, down when it starts with 1
// P3  every bit doubled leaves the answer
// P4  the answer is at most the length, and 0 exactly when there is no 1
// P5  the string twice over answers twice, less one for a leading 1, plus
//     one where its last bit and first bit differ
// P6  each arm agrees with at least two of the other four

// ---- flips.kara: the ★ arm: the changes from a leading 0

fn star_arm(target: String) -> i64 {
    let mut flips = 0;
    let mut prev = b'0';
    for c in target.bytes().iter() {
        if c != prev {
            flips += 1;
            prev = c;
        }
    }
    flips
}

// ---- flips_parity.kara: the flips simulated by their parity

fn parity_arm(target: String) -> i64 {
    let mut flips = 0;
    for c in target.bytes().iter() {
        let bit = if c == b'1' { 1 } else { 0 };
        if flips % 2 != bit {
            flips += 1;
        }
    }
    flips
}

// ---- flips_runs.kara: runs of equal bits

fn runs_arm(target: String) -> i64 {
    let b = target.bytes();
    let mut runs = 0;
    let mut i = 0;
    while i < b.len() {
        let mut j = i;
        while j < b.len() and b[j] == b[i] {
            j += 1;
        }
        runs += 1;
        i = j;
    }
    if b[0] == b'0' {
        runs - 1
    } else {
        runs
    }
}

// ---- flips_iter.kara: the ★ arm with iterator adapters

fn iter_arm(target: String) -> i64 {
    let b = target.bytes();
    once(b'0')
        .chain(b.iter().cloned())
        .zip(b.iter())
        .filter(|(a, c)| a != c)
        .count()
}

// ---- flips_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn min_flips(target: String) -> i32 {
        let mut ans = 0;
        let mut cur = b'0';
        for c in target.bytes() {
            if c != cur {
                ans += 1;
                cur = c;
            }
        }
        ans
    }
}

fn solution_arm(target: String) -> i64 {
    Solution.min_flips(target)
}

// ---- the statement read literally -----------------------------------------

// Fewest flips, found by search: from all zeros, each step picks a place
// and flips every bit from there to the end, breadth first, until the
// target is reached. A state is the bits as a number, the first bit high.
fn literal(target: String) -> i64 {
    let n = target.len();
    let mut goal = 0;
    for c in target.chars() {
        goal = goal * 2 + if c == '1' { 1 } else { 0 };
    }
    let mut steps: Map[i64, i64] = Map.new();
    let mut queue: VecDeque[i64] = VecDeque.new();
    steps.insert(0, 0);
    queue.push_back(0);
    while let Some(cur) = queue.pop_front() {
        let here = steps[cur];
        if cur == goal {
            return here;
        }
        for i in 0..n {
            // place i is bit n - 1 - i; the suffix from it is the low n - i bits
            let next = cur ^ ((1 << (n - i)) - 1);
            if not steps.contains_key(next) {
                steps.insert(next, here + 1);
                queue.push_back(next);
            }
        }
    }
    -1
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn arm(k: i64, target: String) -> i64 {
    if k == 0 {
        star_arm(target)
    } else if k == 1 {
        parity_arm(target)
    } else if k == 2 {
        runs_arm(target)
    } else if k == 3 {
        iter_arm(target)
    } else {
        solution_arm(target)
    }
}

fn arm_name(k: i64) -> String {
    ["star", "parity", "runs", "iter", "solution"][k].to_string()
}

fn main() {
    let arms = 5;
    let problems = 3000;
    let mut seed = 15290;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first
        let n = next_random(mut seed) % 10 + 1;
        let ones = next_random(mut seed) % 9 + 1;
        let mut target = String.new();
        for _ in 0..n {
            target.push(if next_random(mut seed) % 10 < ones { '1' } else { '0' });
        }
        let flipped: String = target.chars().map(|c| if c == '1' { '0' } else { '1' }).collect();
        let doubled: String = target.chars().flat_map(|c| [c, c].into_iter()).collect();
        let twice = f"{target}{target}";
        let first = target.char_at(0).unwrap();
        let last = target.char_at(n - 1).unwrap();
        let has_one = target.contains("1");
        let truth = literal(target.clone());
        let mut answers: Vec[i64] = Vec.new();
        for k in 0..arms {
            let answer = arm(k, target.clone());
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            let moved = if first == '0' { answer + 1 } else { answer - 1 };
            if arm(k, flipped.clone()) != moved {
                fails[2] += 1;
            }
            if arm(k, doubled.clone()) != answer {
                fails[3] += 1;
            }
            if answer < 0 or answer > n or (answer == 0) == has_one {
                fails[4] += 1;
            }
            let mut expect = 2 * answer;
            if first == '1' {
                expect -= 1;
            }
            if first != last {
                expect += 1;
            }
            if arm(k, twice.clone()) != expect {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(k)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for k in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != k and answers[other] == answers[k] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, truth);
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
