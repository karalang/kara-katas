// LeetCode #1598: Crawler Log Folder -- the bench: the ★ arm on 2000
// logs of 5000 operations, all drawn first.
//
// The ★ arm: only the depth matters, read by matching each log.

fn min_operations(logs: Vec[String]) -> i32 {
    let mut depth: i32 = 0;
    for log in logs.iter() {
        match log.as_str() {
            "../" => depth = (depth - 1).max(0),
            "./" => {}
            _ => depth += 1,
        }
    }
    depth
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1598;
    let mut all: Vec[Vec[String]] = Vec.new();
    for _ in 0..2000 {
        let logs: Vec[String] = (0..5000).map(|_| {
            let r = next_random(mut seed) % 8;
            if r < 2 { "../" } else if r < 4 { "./" } else { f"d{r - 3}/" }
        }).collect();
        all.push(logs);
    }
    let mut check = 0;
    let mut total = 0;
    for logs in all.iter() {
        let answer = min_operations(logs);
        total += answer;
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"2000 logs of 5000 operations: total {total}, checksum {check}");
}
