// LeetCode #1524: Number of Sub-arrays With Odd Sum -- the ★ arm: a
// sub-array's sum is odd when the prefix sums at its two ends differ in
// parity. Walking the prefixes, each one pairs with every earlier one of
// the other parity; the empty prefix counts as even. O(n).

fn num_of_subarrays(arr: Vec[i64]) -> i64 {
    let modulus = 1000000007;
    let mut odd = 0;
    let mut even = 1;
    let mut sum = 0;
    let mut answer = 0;
    for x in arr.iter() {
        sum += x;
        if sum % 2 == 1 {
            answer = (answer + even) % modulus;
            odd += 1;
        } else {
            answer = (answer + odd) % modulus;
            even += 1;
        }
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` arrays of 1 to `most` numbers from 1 to 100
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            arr.push(next_random(mut seed) % 100 + 1);
        }
        check = mix(check, num_of_subarrays(arr));
    }
    println(f"{count} arrays of 1 to {most} numbers: checksum {check}");
}

fn main() {
    println(f"example 1, [1,3,5] -> {num_of_subarrays([1, 3, 5])}");
    println(f"example 2, [2,4,6] -> {num_of_subarrays([2, 4, 6])}");
    println(f"example 3, [1,2,3,4,5,6,7] -> {num_of_subarrays([1, 2, 3, 4, 5, 6, 7])}");
    println(f"100000 ones -> {num_of_subarrays(Vec.filled(100000, 1))}");
    let mut seed = 1524;
    batch(3000, 12, mut seed);
    batch(30, 100000, mut seed);
}
