// LeetCode #1575: Count All Possible Routes -- LeetCode's Rust template as
// karac fix left it: a recursive `dfs` over `usize` cities with a memo
// table of `-1`s, over `i32` values.

struct Solution {}

const MOD: i64 = 1_000_000_007;

fn dfs(locations: Vec[i32], city: i64, fuel: i32, finish: i64, memo: mut ref Vec[Vec[i64]]) -> i64 {
    if memo[city][fuel] != -1 {
        return memo[city][fuel];
    }
    let mut ans = if city == finish { 1 } else { 0 };
    for next in 0..locations.len() {
        let cost = (locations[city] - locations[next]).abs();
        if next != city and cost <= fuel {
            ans = (ans + dfs(locations, next, fuel - cost, finish, mut memo)) % MOD;
        }
    }
    memo[city][fuel] = ans;
    ans
}

impl Solution {
    pub fn count_routes(locations: Vec[i32], start: i32, finish: i32, fuel: i32) -> i32 {
        let n = locations.len();
        let mut memo = Vec.filled(n, Vec.filled(fuel as i64 + 1, -1));
        dfs(locations, start, fuel, finish, mut memo) as i32
    }
}

fn count_routes(locations: Vec[i64], start: i64, finish: i64, fuel: i64) -> i64 {
    let locations: Vec[i32] = locations.iter().map(|x| x as i32).collect();
    Solution.count_routes(locations, start as i32, finish as i32, fuel as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` problems of 2 to `most` distinct locations below `spread`, a
// start, a finish and a fuel of 1 to `tank`
fn batch(count: i64, most: i64, spread: i64, tank: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (most - 1) + 2;
        let mut taken: Set[i64] = Set.new();
        let mut locations: Vec[i64] = Vec.new();
        while locations.len() < n {
            let x = (next_random(mut seed) * 32768 + next_random(mut seed)) % spread;
            if taken.insert(x) {
                locations.push(x);
            }
        }
        let start = next_random(mut seed) % n;
        let finish = next_random(mut seed) % n;
        let fuel = next_random(mut seed) % tank + 1;
        let routes = count_routes(locations, start, finish, fuel);
        total += routes;
        check = mix(check, routes);
    }
    println(f"{count} problems of up to {most} locations: routes total {total}, checksum {check}");
}

fn main() {
    let examples: Vec[(Vec[i64], i64, i64, i64)] = [
        ([2, 3, 6, 8, 4], 1, 3, 5),
        ([4, 3, 1], 1, 0, 6),
        ([5, 2, 1], 0, 2, 3),
        ([1, 2], 0, 0, 1),
        ([1, 2], 0, 0, 2),
        ([1, 2, 3], 1, 1, 200),
    ];
    for (locations, start, finish, fuel) in examples.iter() {
        println(f"{locations}, start {start}, finish {finish}, fuel {fuel} -> {count_routes(locations, start, finish, fuel)}");
    }
    let mut seed = 1575;
    batch(3000, 5, 10, 8, mut seed);
    batch(300, 20, 100, 60, mut seed);
    batch(10, 100, 1000000000, 200, mut seed);
    batch(10, 100, 200, 200, mut seed);
}
