// LeetCode #1548: The Most Similar Path in a Graph -- shortest paths over
// the layered graph: a state is a place in the target and a city, a step
// goes to a neighbour at the next place and costs that city's mismatch.
// Dijkstra from every city at place 0 by a `PriorityQueue`, smallest first;
// the first state popped at the last place ends a best path, and a `Map`
// of where each state was reached from walks it back. O(T m log(T n)).

fn most_similar(n: i64, roads: Vec[(i64, i64)], names: Vec[String], target: Vec[String]) -> Vec[i64] {
    let mut next_to: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for (a, b) in roads.iter() {
        next_to[a].push(b);
        next_to[b].push(a);
    }
    let last = target.len() - 1;
    let miss = |t: i64, v: i64| if names[v] == target[t] { 0 } else { 1 };
    let mut queue = PriorityQueue.new();
    let mut reached: Map[(i64, i64), i64] = Map.new();
    let mut parent: Map[(i64, i64), i64] = Map.new();
    let mut done: Set[(i64, i64)] = Set.new();
    for v in 0..n {
        reached.insert((0, v), miss(0, v));
        queue.push((miss(0, v), 0, v));
    }
    let mut end = 0;
    while let Some((cost, t, v)) = queue.pop() {
        if not done.insert((t, v)) {
            continue;
        }
        if t == last {
            end = v;
            break;
        }
        for u in next_to[v].iter() {
            let through = cost + miss(t + 1, u);
            let better = match reached.get((t + 1, u)) {
                Some(known) => through < known,
                None => true,
            };
            if better {
                reached.insert((t + 1, u), through);
                parent.insert((t + 1, u), v);
                queue.push((through, t + 1, u));
            }
        }
    }
    let mut path = [end].to_vec();
    for t in (1..=last).rev() {
        path.push(parent[(t, path[path.len() - 1])]);
    }
    path.reverse();
    path
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// the name numbered `i`: three capitals, `i` in base 26 from "AAA"
fn name_of(i: i64) -> String {
    let letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let mut name = String.new();
    for place in [676, 26, 1] {
        name.push(letters.chars().nth(i / place % 26).unwrap());
    }
    name
}

// how far a path is from the target: -1 when it is not a path of the
// target's length along the roads, its distance otherwise
fn judge(n: i64, roads: Vec[(i64, i64)], names: Vec[String], target: Vec[String], path: Vec[i64]) -> i64 {
    if path.len() != target.len() {
        return -1;
    }
    let mut joined = Vec.filled(n, Vec.filled(n, false));
    for (a, b) in roads.iter() {
        joined[a][b] = true;
        joined[b][a] = true;
    }
    let mut distance = 0;
    for t in 0..path.len() {
        let v = path[t];
        if v < 0 or v >= n or (t > 0 and not joined[path[t - 1]][v]) {
            return -1;
        }
        if names[v] != target[t] {
            distance += 1;
        }
    }
    distance
}

// `count` connected graphs of 2 to `most` cities, named from the first 1
// to `pool` names, with a target of 1 to `longest` names from the same
// pool and one past it
fn batch(count: i64, most: i64, pool: i64, longest: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut wrong = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (most - 1) + 2;
        let own = next_random(mut seed) % pool + 1;
        let names: Vec[String] = (0..n).map(|_| name_of(next_random(mut seed) % own)).collect();
        let mut roads = Vec.new();
        let mut taken: Set[(i64, i64)] = Set.new();
        for v in 1..n {
            let u = next_random(mut seed) % v;
            roads.push((v, u));
            taken.insert((u, v));
        }
        let extra = next_random(mut seed) % n;
        for _ in 0..extra {
            let a = next_random(mut seed) % n;
            let b = next_random(mut seed) % n;
            if a != b and taken.insert((a.min(b), a.max(b))) {
                roads.push((a, b));
            }
        }
        let length = next_random(mut seed) % longest + 1;
        let target: Vec[String] = (0..length).map(|_| name_of(next_random(mut seed) % (own + 1))).collect();
        let path = most_similar(n, roads.clone(), names.clone(), target.clone());
        let distance = judge(n, roads, names, target, path);
        if distance < 0 {
            wrong += 1;
        }
        check = mix(check, distance);
    }
    println(f"{count} graphs of up to {most} cities, targets up to {longest}: checksum {check}, {wrong} not paths");
}

fn example(n: i64, roads: Vec[(i64, i64)], names: Vec[String], target: Vec[String]) {
    let path = most_similar(n, roads.clone(), names.clone(), target.clone());
    let distance = judge(n, roads, names, target.clone(), path);
    println(f"{n} cities, target of {target.len()} -> distance {distance}");
}

fn main() {
    let ex1: Vec[String] = ["ATL", "PEK", "LAX", "DXB", "HND"].iter().map(|s| s.to_string()).collect();
    let t1: Vec[String] = ["ATL", "DXB", "HND", "LAX"].iter().map(|s| s.to_string()).collect();
    example(5, [(0, 2), (0, 3), (1, 2), (1, 3), (1, 4), (2, 4)], ex1, t1);
    let ex2: Vec[String] = ["ATL", "PEK", "LAX", "DXB"].iter().map(|s| s.to_string()).collect();
    let t2: Vec[String] = ["ABC", "DEF", "GHI", "JKL", "MNO", "PQR", "STU", "VWX"].iter().map(|s| s.to_string()).collect();
    example(4, [(1, 0), (2, 0), (3, 0), (2, 1), (3, 1), (3, 2)], ex2, t2);
    let ex3: Vec[String] = ["ATL", "PEK", "LAX", "ATL", "DXB", "HND"].iter().map(|s| s.to_string()).collect();
    let t3: Vec[String] = ["ATL", "DXB", "HND", "DXB", "ATL", "LAX", "PEK"].iter().map(|s| s.to_string()).collect();
    example(6, [(0, 1), (1, 2), (2, 3), (3, 4), (4, 5)], ex3, t3);
    // two cities, a target that alternates against them
    let ab: Vec[String] = ["AAA", "BBB"].iter().map(|s| s.to_string()).collect();
    let ba: Vec[String] = ["BBB", "AAA", "BBB", "AAA", "AAA"].iter().map(|s| s.to_string()).collect();
    example(2, [(0, 1)], ab, ba);
    // a line of 100 cities named in order, the target its names backwards
    let line: Vec[String] = (0..100).map(|i| name_of(i)).collect();
    let back: Vec[String] = (0..100).rev().map(|i| name_of(i)).collect();
    let line_roads: Vec[(i64, i64)] = (1..100).map(|i| (i - 1, i)).collect();
    example(100, line_roads, line, back);
    // a star: the target wants two leaves in a row, which never meet
    let star: Vec[String] = (0..10).map(|i| name_of(i)).collect();
    let star_roads: Vec[(i64, i64)] = (1..10).map(|i| (0, i)).collect();
    let leaves: Vec[String] = [1, 2, 3, 4, 5, 6].iter().map(|i| name_of(i)).collect();
    example(10, star_roads, star, leaves);
    let mut seed = 1548;
    batch(3000, 6, 4, 8, mut seed);
    batch(300, 30, 26, 30, mut seed);
    batch(30, 100, 676, 100, mut seed);
}
