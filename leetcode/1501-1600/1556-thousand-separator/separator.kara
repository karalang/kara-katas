// LeetCode #1556: Thousand Separator -- the ★ arm: the digits of `n`
// walked left to right, a dot put before each digit whose distance from
// the end is a positive multiple of three. O(d) for d digits.

fn thousand_separator(n: i64) -> String {
    let digits = n.to_string();
    let length = digits.len();
    let mut out = String.new();
    for (i, c) in digits.chars().enumerate() {
        if i > 0 and (length - i) % 3 == 0 {
            out.push('.');
        }
        out.push(c);
    }
    out
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix_text(check: i64, text: String) -> i64 {
    let mut check = check;
    for b in text.bytes() {
        check = (check * 31 + b + 1) % 1000000007;
    }
    (check * 31 + 7) % 1000000007
}

// `count` numbers below 2^31, each with its own count of 1 to 10 digits
fn batch(count: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut dots = 0;
    for _ in 0..count {
        let digits = next_random(mut seed) % 10 + 1;
        let mut top = 1;
        for _ in 0..digits {
            top *= 10;
        }
        let wide = (next_random(mut seed) * 32768 + next_random(mut seed)) * 32768 + next_random(mut seed);
        let n = (wide % top).min(2147483647);
        let text = thousand_separator(n);
        dots += text.chars().filter(|c| c == '.').count();
        check = mix_text(check, text);
    }
    println(f"{count} numbers: {dots} dots, checksum {check}");
}

fn main() {
    for n in [987, 1234, 123456789, 0, 1000, 999999, 1000000, 100, 10000, 2147483647] {
        println(f"{n} -> \"{thousand_separator(n)}\"");
    }
    let mut seed = 1556;
    batch(30000, mut seed);
}
