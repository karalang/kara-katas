// LeetCode #1580: Put Boxes Into the Warehouse II -- the differential.
//
// Four arms against the statement read literally, on 3000 problems of 1
// to 6 boxes and 1 to 6 rooms with heights from 1 to 6, with six
// properties. Every random choice is drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the warehouse reversed leaves the answer
// P3  the boxes in reverse order leave the answer
// P4  every height doubled leaves the answer
// P5  a box taller than every room added leaves the answer
// P6  each arm agrees with at least two of the other three

// ---- warehouse.kara: the ★ arm: usable heights sorted and matched smallest first

fn star_arm(boxes: Vec[i64], warehouse: Vec[i64]) -> i64 {
    let m = warehouse.len();
    let mut from_left = warehouse.clone();
    for i in 1..m {
        from_left[i] = from_left[i].min(from_left[i - 1]);
    }
    let mut usable = warehouse.clone();
    for i in (0..m - 1).rev() {
        usable[i] = usable[i].min(usable[i + 1]);
    }
    for i in 0..m {
        usable[i] = usable[i].max(from_left[i]);
    }
    usable.sort();
    let mut sorted = boxes.clone();
    sorted.sort();
    let mut placed = 0;
    for room in usable.iter() {
        if placed < sorted.len() and sorted[placed] <= room {
            placed += 1;
        }
    }
    placed
}

// ---- warehouse_multiset.kara: the tallest box that fits, found by floor in a SortedMap

fn multiset_arm(boxes: Vec[i64], warehouse: Vec[i64]) -> i64 {
    let m = warehouse.len();
    let mut lowest = i64.MAX;
    let mut from_left: Vec[i64] = Vec.new();
    for h in warehouse.iter() {
        lowest = lowest.min(h);
        from_left.push(lowest);
    }
    let mut usable: Vec[i64] = Vec.filled(m, 0);
    lowest = i64.MAX;
    for i in (0..m).rev() {
        lowest = lowest.min(warehouse[i]);
        usable[i] = lowest.max(from_left[i]);
    }
    usable.sort_by(|a, b| b.cmp(a));
    let mut left: SortedMap[i64, i64] = SortedMap.new();
    for b in boxes.iter() {
        *left.entry(b).or_insert(0) += 1;
    }
    let mut placed = 0;
    for room in usable.iter() {
        let fit = match left.floor(room) {
            Some((h, _)) => h,
            None => break,
        };
        placed += 1;
        if left[fit] == 1 {
            left.remove(fit);
        } else {
            left[fit] -= 1;
        }
    }
    placed
}

// ---- warehouse_search.kara: a binary search on how many of the smallest boxes fit

fn search_usable(warehouse: Vec[i64]) -> Vec[i64] {
    let m = warehouse.len();
    let mut from_right: Vec[i64] = warehouse.clone();
    for i in (0..m - 1).rev() {
        from_right[i] = from_right[i].min(from_right[i + 1]);
    }
    let mut lowest = i64.MAX;
    let mut usable: Vec[i64] = warehouse.iter().enumerate().map(|(i, h)| {
        lowest = lowest.min(h);
        lowest.max(from_right[i])
    }).collect();
    usable.sort();
    usable
}

// the k smallest of `boxes` fit the k highest of `rooms` (both sorted)
fn search_fits(boxes: Vec[i64], rooms: Vec[i64], k: i64) -> bool {
    let start = rooms.len() - k;
    (0..k).all(|i| boxes[i] <= rooms[start + i])
}

fn search_arm(boxes: Vec[i64], warehouse: Vec[i64]) -> i64 {
    let rooms = search_usable(warehouse);
    let mut sorted = boxes.clone();
    sorted.sort();
    let mut lo = 0;
    let mut hi = sorted.len().min(rooms.len());
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if search_fits(sorted, rooms, mid) {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

// ---- warehouse_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn max_boxes_in_warehouse(boxes: own Vec[i32], warehouse: Vec[i32]) -> i32 {
        let mut boxes = boxes;
        boxes.sort_by(|a, b| b.cmp(a));
        let mut (l, r) = (0i32, warehouse.len() as i32 - 1);
        let mut ans = 0;
        for b in boxes.iter() {
            if l > r {
                break;
            }
            if b <= warehouse[l as usize] {
                l += 1;
                ans += 1;
            } else if b <= warehouse[r as usize] {
                r -= 1;
                ans += 1;
            }
        }
        ans
    }
}

fn solution_arm(boxes: Vec[i64], warehouse: Vec[i64]) -> i64 {
    let b: Vec[i32] = boxes.iter().map(|x| x as i32).collect();
    let w: Vec[i32] = warehouse.iter().map(|x| x as i32).collect();
    Solution.max_boxes_in_warehouse(b, w)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, boxes: Vec[i64], warehouse: Vec[i64]) -> i64 {
    match a {
        0 => star_arm(boxes, warehouse),
        1 => multiset_arm(boxes, warehouse),
        2 => search_arm(boxes, warehouse),
        _ => solution_arm(boxes, warehouse),
    }
}

fn arm_name(a: i64) -> String {
    ["warehouse", "multiset", "search", "solution"][a].to_string()
}

// ---- the statement read literally: the boxes pushed in one at a time in
// every order, each from either side, each going on until the next room is
// lower than it or holds a box; the most boxes any sequence leaves inside

// the room a box of height `h` pushed in from the left (or the right)
// stops in, or -1 when the first room already stops it
fn stops_in(warehouse: Vec[i64], full: i64, h: i64, from_left: bool) -> i64 {
    let m = warehouse.len();
    let mut at = -1;
    for step in 0..m {
        let room = if from_left { step } else { m - 1 - step };
        if full >> room & 1 == 1 or warehouse[room] < h {
            break;
        }
        at = room;
    }
    at
}

fn most_placed(boxes: Vec[i64], warehouse: Vec[i64], used: i64, full: i64, memo: mut ref Vec[i64]) -> i64 {
    let key = used * 64 + full;
    if memo[key] >= 0 {
        return memo[key];
    }
    let mut best = 0;
    for i in 0..boxes.len() {
        if used >> i & 1 == 0 {
            for side in [true, false] {
                let room = stops_in(warehouse, full, boxes[i], side);
                if room >= 0 {
                    best = best.max(1 + most_placed(boxes, warehouse, used | 1 << i, full | 1 << room, mut memo));
                }
            }
        }
    }
    memo[key] = best;
    best
}

fn literal(boxes: Vec[i64], warehouse: Vec[i64]) -> i64 {
    let mut memo = Vec.filled(64 * 64, -1);
    most_placed(boxes, warehouse, 0, 0, mut memo)
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15800;
    let mut cases: Vec[(Vec[i64], Vec[i64])] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 6 + 1;
        let m = next_random(mut seed) % 6 + 1;
        let boxes: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 6 + 1).collect();
        let warehouse: Vec[i64] = (0..m).map(|_| next_random(mut seed) % 6 + 1).collect();
        cases.push((boxes, warehouse));
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for (p, (boxes, warehouse)) in cases.iter().enumerate() {
        let truth = literal(boxes, warehouse);
        let back: Vec[i64] = warehouse.iter().rev().cloned().collect();
        let boxes_back: Vec[i64] = boxes.iter().rev().cloned().collect();
        let boxes_doubled: Vec[i64] = boxes.iter().map(|h| 2 * h).collect();
        let doubled: Vec[i64] = warehouse.iter().map(|h| 2 * h).collect();
        let mut more = boxes.clone();
        more.push(warehouse.iter().max().unwrap() + 1);
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, boxes, warehouse);
            answers.push(answer);
            check = (check * 31 + answer + 1) % 1000000007;
            let failed = [
                answer != truth,
                arm(a, boxes, back) != answer,
                arm(a, boxes_back, warehouse) != answer,
                arm(a, boxes_doubled, doubled) != answer,
                arm(a, more, warehouse) != answer,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
