// LeetCode #1541: Minimum Insertions to Balance a Parentheses String -- the
// string read in tokens: a '(' opens; a ')' takes the next ')' with it when
// there is one and an inserted ')' when not, and the pair closes an open
// '(' or, with none open, an inserted one. Each '(' left open wants two.
// O(n).

fn min_insertions(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut open = 0;
    let mut inserted = 0;
    let mut i = 0;
    while i < n {
        if b[i] == b'(' {
            open += 1;
            i += 1;
            continue;
        }
        if i + 1 < n and b[i + 1] == b')' {
            i += 2;
        } else {
            inserted += 1;
            i += 1;
        }
        if open > 0 {
            open -= 1;
        } else {
            inserted += 1;
        }
    }
    inserted + 2 * open
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 1 to `most` parentheses, each with its own chance of
// a '('
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let chance = next_random(mut seed) % 101;
        let mut s = String.new();
        for _ in 0..n {
            s.push(if next_random(mut seed) % 100 < chance { '(' } else { ')' });
        }
        check = mix(check, min_insertions(s));
    }
    println(f"{count} strings of up to {most} parentheses: checksum {check}");
}

fn main() {
    let examples = ["(()))", "())", "))())(", "((((((", ")))))))", "(", ")", "()", "())())", ")()", "(()))(()))))"];
    for s in examples.iter() {
        println(f"{s} -> {min_insertions(s.to_string())}");
    }
    println(f"100000 '(' -> {min_insertions("(".repeat(100000))}");
    println(f"100000 ')' -> {min_insertions(")".repeat(100000))}");
    println(f"33333 '())' -> {min_insertions("())".repeat(33333))}");
    let mut seed = 1541;
    batch(3000, 12, mut seed);
    batch(300, 1000, mut seed);
    batch(30, 100000, mut seed);
}
