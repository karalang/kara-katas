// LeetCode #1589: Maximum Sum Obtained of Any Permutation -- the bench:
// the ★ arm on 20 problems of 100000 values and 100000 requests, all
// drawn first.
//
// The ★ arm: how often each place is asked for, by a difference array
// and its running sum; the counts and the values both sorted and
// multiplied in pairs.

fn max_sum_range_query(nums: Vec[i32], requests: Vec[Vec[i32]]) -> i32 {
    let n = nums.len();
    let mut asked = Vec.filled(n + 1, 0);
    for r in requests.iter() {
        asked[r[0]] += 1;
        asked[r[1] + 1] -= 1;
    }
    for i in 1..n {
        asked[i] += asked[i - 1];
    }
    asked.truncate(n);
    asked.sort();
    let mut values = nums.clone();
    values.sort();
    let mut total = 0;
    for (count, v) in asked.iter().zip(values.iter()) {
        total = (total + *count * *v) % 1000000007;
    }
    total as i32
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 1589;
    let mut problems: Vec[(Vec[i32], Vec[Vec[i32]])] = Vec.new();
    let n = 100000;
    for _ in 0..20 {
        let nums: Vec[i32] = (0..n).map(|_| (wide(mut seed) % 100001) as i32).collect();
        let mut requests: Vec[Vec[i32]] = Vec.new();
        for _ in 0..100000 {
            let a = wide(mut seed) % n;
            let b = wide(mut seed) % n;
            requests.push([a.min(b) as i32, a.max(b) as i32]);
        }
        problems.push((nums, requests));
    }
    let mut check = 0;
    for (nums, requests) in problems.iter() {
        check = mix(check, max_sum_range_query(nums, requests));
    }
    println(f"20 problems of 100000 values and 100000 requests: checksum {check}");
}
