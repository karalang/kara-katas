// LeetCode #1518: Water Bottles -- the ★ arm: drink every full bottle,
// trade the empties in whole lots, keep the remainder, until fewer empties
// than one trade are left. O(log n) rounds.

fn num_water_bottles(num_bottles: i64, num_exchange: i64) -> i64 {
    let mut drunk = 0;
    let mut full = num_bottles;
    let mut empty = 0;
    while full > 0 {
        drunk += full;
        empty += full;
        full = empty / num_exchange;
        empty %= num_exchange;
    }
    drunk
}

fn main() {
    let mut check = 0;
    for i in 0..20000000 {
        let bottles = i * 7919 % 1000000000 + 1;
        let exchange = i % 99 + 2;
        check = (check * 31 + num_water_bottles(bottles, exchange) + 1) % 1000000007;
    }
    println(f"20000000 questions up to 10^9 bottles and 2 to 100 for 1: checksum {check}");
}
