// LeetCode #1518: Water Bottles -- the differential.
//
// Four arms against the statement read literally, on 3000 problems of 1
// to 300 bottles and 2 to 30 empties a trade, with six properties.
//
// P1  the answer is the statement read literally: one bottle at a time,
//     drunk, and a trade as soon as k empties are in hand
// P2  one more bottle gives at least one more drink
// P3  a dearer trade (k + 1) never gives more
// P4  n <= answer <= 2 n - 1
// P5  with n >= k, the answer is k plus the answer for n - k + 1 (drink k,
//     trade them for one more full bottle)
// P6  each arm agrees with at least two of the other three
//
// The Rust-template arm is not here: it does not check (B-2026-11-08-18).

// ---- bottles.kara: the ★ arm: whole lots a round
fn star_arm(num_bottles: i64, num_exchange: i64) -> i64 {
    let mut drunk = 0;
    let mut full = num_bottles;
    let mut empty = 0;
    while full > 0 {
        drunk += full;
        empty += full;
        full = empty / num_exchange;
        empty %= num_exchange;
    }
    drunk
}

// ---- bottles_one.kara: one trade at a time
fn one_arm(num_bottles: i64, num_exchange: i64) -> i64 {
    let mut drunk = num_bottles;
    let mut empty = num_bottles;
    while empty >= num_exchange {
        empty -= num_exchange - 1;
        drunk += 1;
    }
    drunk
}

// ---- bottles_formula.kara: the closed form
fn formula_arm(num_bottles: i64, num_exchange: i64) -> i64 {
    num_bottles + (num_bottles - 1) / (num_exchange - 1)
}

// ---- bottles_rec.kara: recursion on (full, empty)
fn drink(full: i64, empty: i64, k: i64) -> i64 {
    if full == 0 {
        return 0;
    }
    let empties = empty + full;
    full + drink(empties / k, empties % k, k)
}

fn rec_arm(num_bottles: i64, num_exchange: i64) -> i64 {
    drink(num_bottles, 0, num_exchange)
}

// ---- the statement read literally ----------------------------------------

fn literal(n: i64, k: i64) -> i64 {
    let mut full = n;
    let mut empty = 0;
    let mut drunk = 0;
    while full > 0 {
        full -= 1;
        drunk += 1;
        empty += 1;
        if empty == k {
            empty = 0;
            full += 1;
        }
    }
    drunk
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn arm(a: i64, n: i64, k: i64) -> i64 {
    if a == 0 {
        star_arm(n, k)
    } else if a == 1 {
        one_arm(n, k)
    } else if a == 2 {
        formula_arm(n, k)
    } else {
        rec_arm(n, k)
    }
}

fn arm_name(a: i64) -> String {
    ["star", "one", "formula", "rec"][a].to_string()
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15180;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        let n = next_random(mut seed) % 300 + 1;
        let k = next_random(mut seed) % 29 + 2;
        let truth = literal(n, k);
        let mut answers: Vec[i64] = Vec.new();
        for a in 0..arms {
            let answer = arm(a, n, k);
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            if arm(a, n + 1, k) < answer + 1 {
                fails[2] += 1;
            }
            if arm(a, n, k + 1) > answer {
                fails[3] += 1;
            }
            if answer < n or answer > 2 * n - 1 {
                fails[4] += 1;
            }
            if n >= k and answer != k + arm(a, n - k + 1, k) {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, answers[0]);
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
