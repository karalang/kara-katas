// LeetCode #1518: Water Bottles -- LeetCode's Rust template, written as
// Rust writes it and carried to Kāra by `karac fix`: the ★ arm's rounds
// over `i32`.

struct Solution {}

impl Solution {
    pub fn num_water_bottles(num_bottles: i32, num_exchange: i32) -> i32 {
        let mut (drunk, full, empty) = (0, num_bottles, 0);
        while full > 0 {
            drunk += full;
            empty += full;
            full = empty / num_exchange;
            empty %= num_exchange;
        }
        drunk
    }
}

fn num_water_bottles(num_bottles: i64, num_exchange: i64) -> i64 {
    Solution.num_water_bottles(num_bottles as i32, num_exchange as i32) as i64
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    println(f"example 1, 9 bottles, 3 for 1 -> {num_water_bottles(9, 3)}");
    println(f"example 2, 15 bottles, 4 for 1 -> {num_water_bottles(15, 4)}");
    println(f"one bottle, 2 for 1 -> {num_water_bottles(1, 2)}");
    println(f"100 bottles, 2 for 1 -> {num_water_bottles(100, 2)}");
    let mut check = 0;
    for bottles in 1..101 {
        for exchange in 2..101 {
            check = mix(check, num_water_bottles(bottles, exchange));
        }
    }
    println(f"every pair, 1 to 100 bottles and 2 to 100 for 1: checksum {check}");
    let mut seed = 1518;
    let mut big = 0;
    for _ in 0..1000 {
        let bottles = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000 + 1;
        let exchange = next_random(mut seed) % 20 + 2;
        big = mix(big, num_water_bottles(bottles, exchange));
    }
    println(f"1000 pairs up to 1000000 bottles and 2 to 21 for 1: checksum {big}");
}
