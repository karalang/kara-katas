// LeetCode #1553: Minimum Number of Days to Eat N Oranges -- LeetCode's
// Rust template as karac fix left it: the ★ arm over `i32` piles, the memo
// passed down to an associated helper.

struct Solution {}

impl Solution {
    pub fn min_days(n: i32) -> i32 {
        let mut memo: Map[i32, i32] = Map.new();
        Solution.dfs(n, mut memo)
    }

    fn dfs(n: i32, memo: mut ref Map[i32, i32]) -> i32 {
        if n <= 1 {
            return n;
        }
        if let Some(v) = memo.get(n).cloned() {
            return v;
        }
        let res = 1 + (n % 2 + Solution.dfs(n / 2, mut memo)).min(n % 3 + Solution.dfs(n / 3, mut memo));
        memo.insert(n, res);
        res
    }
}

fn min_days(n: i64) -> i64 {
    Solution.min_days(n as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` piles of 1 to `most` oranges
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let wide = (next_random(mut seed) * 32768 + next_random(mut seed)) * 32768 + next_random(mut seed);
        let n = wide % most + 1;
        let days = min_days(n);
        total += days;
        check = mix(check, days);
    }
    println(f"{count} piles of up to {most}: {total} days, checksum {check}");
}

fn main() {
    for n in [10, 6, 1, 2, 3, 4, 56, 820592, 1000000000, 2000000000] {
        println(f"n = {n} -> {min_days(n)}");
    }
    let mut seed = 1553;
    batch(3000, 1000, mut seed);
    batch(300, 1000000, mut seed);
    batch(100, 2000000000, mut seed);
}
