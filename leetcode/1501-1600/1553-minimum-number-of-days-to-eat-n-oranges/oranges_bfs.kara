// LeetCode #1553: Minimum Number of Days to Eat N Oranges -- the statement
// as a graph, searched breadth first: a pile is a state, each day one of
// up to three moves (one eaten, half eaten, two thirds eaten), and the
// first day the queue reaches 0 is the answer. A `Set` keeps every pile
// seen so it is queued once.

fn min_days(n: i64) -> i64 {
    let mut seen: Set[i64] = Set.new();
    let mut queue = VecDeque.new();
    queue.push_back((n, 0));
    seen.insert(n);
    while let Some((pile, day)) = queue.pop_front() {
        if pile == 0 {
            return day;
        }
        let mut next = [pile - 1].to_vec();
        if pile % 2 == 0 {
            next.push(pile / 2);
        }
        if pile % 3 == 0 {
            next.push(pile / 3);
        }
        for p in next.iter() {
            if seen.insert(p) {
                queue.push_back((p, day + 1));
            }
        }
    }
    0
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` piles of 1 to `most` oranges
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let wide = (next_random(mut seed) * 32768 + next_random(mut seed)) * 32768 + next_random(mut seed);
        let n = wide % most + 1;
        let days = min_days(n);
        total += days;
        check = mix(check, days);
    }
    println(f"{count} piles of up to {most}: {total} days, checksum {check}");
}

fn main() {
    for n in [10, 6, 1, 2, 3, 4, 56, 820592, 1000000000, 2000000000] {
        println(f"n = {n} -> {min_days(n)}");
    }
    let mut seed = 1553;
    batch(3000, 1000, mut seed);
    batch(300, 1000000, mut seed);
    batch(100, 2000000000, mut seed);
}
