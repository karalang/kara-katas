// LeetCode #1521: Find a Value of a Mysterious Function Closest to Target
// -- LeetCode's Rust template, written as Rust writes it and carried to
// Kāra by `karac fix`: the ★ arm's distinct ANDs ending at each place.

struct Solution {}

impl Solution {
    pub fn closest_to_target(arr: Vec[i32], target: i32) -> i32 {
        let mut ans = i32.MAX;
        let mut ends: Vec[i32] = Vec.new();
        for x in arr.iter() {
            let mut next: Vec[i32] = [x];
            for v in ends.iter() {
                let w = v & x;
                if *next.last().unwrap() != w {
                    next.push(w);
                }
            }
            for v in next.iter() {
                ans = ans.min((v - target).abs());
            }
            ends = next;
        }
        ans
    }
}

fn closest_to_target(arr: Vec[i64], target: i64) -> i64 {
    Solution.closest_to_target(arr.iter().map(|x| *x as i32).collect(), target as i32) as i64
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` arrays of 1 to `most` numbers: each number is a random one of
// up to 20 bits with a few bits cleared, so runs of ANDs fall slowly; the
// target is near some number in the array or anywhere up to 10^7.
fn batch(count: i64, most: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let base = next_random(mut seed) % 1000000 + 1;
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            let x = if next_random(mut seed) % 2 == 0 {
                base & (next_random(mut seed) * 32768 + next_random(mut seed))
            } else {
                next_random(mut seed) * 32 % 1000000
            };
            arr.push(x.max(1));
        }
        let target = if next_random(mut seed) % 2 == 0 {
            arr[next_random(mut seed) % n] + next_random(mut seed) % 7 - 3
        } else {
            (next_random(mut seed) * 32768 + next_random(mut seed)) % 10000001
        };
        check = mix(check, closest_to_target(arr, target.max(0)));
    }
    check
}

fn main() {
    println(f"example 1, [9,12,3,7,15] to 5 -> {closest_to_target([9, 12, 3, 7, 15], 5)}");
    println(f"example 2, [1000000,1000000,1000000] to 1 -> {closest_to_target([1000000, 1000000, 1000000], 1)}");
    println(f"example 3, [1,2,4,8,16] to 0 -> {closest_to_target([1, 2, 4, 8, 16], 0)}");
    println(f"one number, [7] to 10000000 -> {closest_to_target([7], 10000000)}");
    let mut seed = 1521;
    println(f"3000 arrays of 1 to 12 numbers: checksum {batch(3000, 12, mut seed)}");
    println(f"20 arrays of 1 to 20000 numbers: checksum {batch(20, 20000, mut seed)}");
}
