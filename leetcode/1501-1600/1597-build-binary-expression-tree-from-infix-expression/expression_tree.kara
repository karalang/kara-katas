// LeetCode #1597: Build Binary Expression Tree From Infix Expression --
// the ★ arm.
//
// Two stacks, as the shunting-yard reads an expression: digits become
// leaves on a stack of trees, and an operator first joins every operator
// waiting on its stack of the same or higher precedence (so equal ones
// group from the left) with the two trees below it; `(` waits until its
// `)` joins everything above it. O(n).

fn precedence(op: char) -> i64 {
    match op {
        '+' | '-' => 1,
        '*' | '/' => 2,
        _ => 0,
    }
}

fn join(ops: mut ref Vec[char], trees: mut ref Vec[Node]) {
    let op = ops.pop().unwrap();
    let right = trees.pop().unwrap();
    let left = trees.pop().unwrap();
    trees.push(Node { val: op, left: Some(left), right: Some(right) });
}

fn exp_tree(s: String) -> Option[Node] {
    let mut ops: Vec[char] = Vec.new();
    let mut trees: Vec[Node] = Vec.new();
    for c in s.chars() {
        if c.is_ascii_digit() {
            trees.push(Node.new(c));
        } else if c == '(' {
            ops.push(c);
        } else if c == ')' {
            while ops.last() != Some('(') {
                join(mut ops, mut trees);
            }
            ops.pop();
        } else {
            while ops.last().is_some_and(|top| precedence(*top) >= precedence(c)) {
                join(mut ops, mut trees);
            }
            ops.push(c);
        }
    }
    while not ops.is_empty() {
        join(mut ops, mut trees);
    }
    trees.pop()
}

// ---- the harness: the same in every arm --------------------------------

// LeetCode's node: an operator or a digit, and two children.
shared struct Node {
    mut val: char,
    mut left: Option[Node],
    mut right: Option[Node],
}

impl Node {
    fn new(val: char) -> Node {
        Node { val: val, left: None, right: None }
    }
}

// The tree as LeetCode prints it: level by level, `null` for a missing
// child, trailing `null`s dropped.
fn serialize(root: Option[Node]) -> String {
    let mut queue: Vec[Option[Node]] = [root];
    let mut out: Vec[String] = Vec.new();
    let mut at = 0;
    while at < queue.len() {
        match queue[at].clone() {
            Some(n) => {
                out.push(n.val.to_string());
                queue.push(n.left.clone());
                queue.push(n.right.clone());
            }
            None => out.push("null"),
        }
        at += 1;
    }
    while out.last() == Some("null") {
        out.pop();
    }
    f"[{out.join(",")}]"
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A random expression of up to `operands` digits, a quarter of its parts
// in parentheses.
fn expression(operands: i64, seed: mut ref i64) -> String {
    if operands <= 1 or next_random(mut seed) % 4 == 0 {
        return f"{next_random(mut seed) % 10}";
    }
    let left = next_random(mut seed) % (operands - 1) + 1;
    let op = ["+", "-", "*", "/"][next_random(mut seed) % 4].clone();
    let body = f"{expression(left, mut seed)}{op}{expression(operands - left, mut seed)}";
    if next_random(mut seed) % 4 == 0 { f"({body})" } else { body }
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut nodes = 0;
    for _ in 0..count {
        let s = expression(next_random(mut seed) % most + 1, mut seed);
        let shown = serialize(exp_tree(s));
        for c in shown.chars() {
            check = (check * 31 + c as i64 + 1) % 1000000007;
        }
        nodes += shown.chars().filter(|c| c.is_ascii_digit() or c == '+' or c == '-' or c == '*' or c == '/').count();
    }
    println(f"{count} expressions of up to {most} digits: {nodes} nodes, checksum {check}");
}

fn main() {
    let examples = ["3*4-2*5", "2-3/(5*2)+1", "1+2+3+4+5", "1", "(((7)))", "9-(8-(7-6))", "1*2+3*4/5-6"];
    for s in examples.iter() {
        println(f"\"{s}\" -> {serialize(exp_tree(s.to_string()))}");
    }
    let mut seed = 1597;
    batch(3000, 4, mut seed);
    batch(300, 12, mut seed);
    batch(30, 25, mut seed);
}
