// LeetCode #1546: Maximum Number of Non-Overlapping Subarrays With Sum
// Equals Target -- bench: the ★ arm (greedy, a Set of prefix sums cleared
// at each cut) over 100 arrays of 1 to 100000 values in -10..10, each with
// a target in -20..20, built once, each asked 5 times.

fn max_non_overlapping(nums: Vec[i64], target: i64) -> i64 {
    let mut seen: Set[i64] = Set.new();
    seen.insert(0);
    let mut sum = 0;
    let mut count = 0;
    for x in nums.iter() {
        sum += x;
        if seen.contains(sum - target) {
            count += 1;
            seen.clear();
            seen.insert(0);
            sum = 0;
        } else {
            seen.insert(sum);
        }
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1546;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for _ in 0..100 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1;
        let mut nums = Vec.new();
        for _ in 0..n {
            nums.push(next_random(mut seed) % 21 - 10);
        }
        let target = next_random(mut seed) % 41 - 20;
        cases.push((nums, target));
    }
    let mut check = 0;
    let mut total = 0;
    for _ in 0..5 {
        for (nums, target) in cases.iter() {
            let answer = max_non_overlapping(nums, target);
            total += answer;
            check = mix(check, answer);
        }
    }
    println(f"5 passes over 100 arrays of up to 100000 values: {total} subarrays, checksum {check}");
}
