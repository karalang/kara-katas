// LeetCode #1533: Find the Index of the Large Integer -- bench: the ★
// arm (ternary search) over 100 readers of 2 to 100000 values, built once,
// each searched 20000 times.

fn get_index(reader: ArrayReader) -> i64 {
    let mut lo: i32 = 0;
    let mut hi = reader.length() - 1;
    while lo < hi {
        let third = (hi - lo + 1) / 3;
        if third == 0 {
            // two values left: compare them directly
            return if reader.compare_sub(lo, lo, hi, hi) > 0 { lo } else { hi };
        }
        let second = lo + third;
        match reader.compare_sub(lo, second - 1, second, second + third - 1) {
            1 => hi = second - 1,
            -1 => {
                lo = second;
                hi = second + third - 1;
            }
            _ => lo = second + third,
        }
    }
    lo
}

// The judge's side, with LeetCode's `i32` API: the array, its prefix sums
// so a comparison is O(1), and a count of the calls. `shared` because the API compares through a
// plain borrow of the reader, as LeetCode's `&self` does, and counting is
// the judge's business.
pub shared struct ArrayReader {
    sums: Vec[i64],
    mut calls: i64,
}

impl ArrayReader {
    fn from(values: Vec[i64]) -> ArrayReader {
        let mut sums = Vec.filled(values.len() + 1, 0);
        for i in 0..values.len() {
            sums[i + 1] = sums[i] + values[i];
        }
        ArrayReader { sums, calls: 0 }
    }

    // 1, 0 or -1 as the sum of arr[l..=r] is above, equal to or below the
    // sum of arr[x..=y]
    pub fn compare_sub(self, l: i32, r: i32, x: i32, y: i32) -> i32 {
        self.calls += 1;
        let left = self.sums[r + 1] - self.sums[l];
        let right = self.sums[y + 1] - self.sums[x];
        if left > right {
            1
        } else if left < right {
            -1
        } else {
            0
        }
    }

    pub fn length(self) -> i32 {
        (self.sums.len() - 1) as i32
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1533;
    let mut readers: Vec[ArrayReader] = Vec.new();
    for _ in 0..100 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 99999 + 2;
        let base = next_random(mut seed) % 99 + 1;
        let large = base + next_random(mut seed) % (100 - base) + 1;
        let at = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        let mut values = Vec.filled(n, base);
        values[at] = large;
        readers.push(ArrayReader.from(values));
    }
    let mut check = 0;
    for _ in 0..20000 {
        for reader in readers.iter() {
            check = mix(check, get_index(reader));
        }
    }
    let mut calls = 0;
    for reader in readers.iter() {
        calls += reader.calls;
    }
    println(f"20000 passes over 100 readers of up to 100000 values: checksum {check}, {calls} calls");
}
