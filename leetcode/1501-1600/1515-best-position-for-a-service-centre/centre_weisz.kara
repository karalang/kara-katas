// LeetCode #1515: Best Position for a Service Centre -- Weiszfeld's
// iteration: the next point is the customers' mean weighted by one over
// each one's distance, until it stops moving (a customer met exactly
// counts at distance 10^-12). When the best point is a customer the
// iteration only creeps toward it, so each customer's own sum is tried
// too.

fn get_min_dist_sum(positions: Vec[(i64, i64)]) -> f64 {
    let n = positions.len() as f64;
    let mut x = positions.iter().map(|(px, _)| px as f64).sum() / n;
    let mut y = positions.iter().map(|(_, py)| py as f64).sum() / n;
    for _ in 0..20000 {
        let mut sx = 0.0;
        let mut sy = 0.0;
        let mut weight = 0.0;
        for (px, py) in positions.iter() {
            let d = ((px as f64 - x) * (px as f64 - x) + (py as f64 - y) * (py as f64 - y)).sqrt().max(0.000000000001);
            sx += px as f64 / d;
            sy += py as f64 / d;
            weight += 1.0 / d;
        }
        let nx = sx / weight;
        let ny = sy / weight;
        let still = (nx - x).abs() < 0.000000000001 and (ny - y).abs() < 0.000000000001;
        x = nx;
        y = ny;
        if still {
            break;
        }
    }
    let mut best = total_from(positions, x, y);
    for (px, py) in positions.iter() {
        best = best.min(total_from(positions, px as f64, py as f64));
    }
    best
}

fn total_from(positions: Vec[(i64, i64)], x: f64, y: f64) -> f64 {
    positions.iter().map(|(px, py)| ((px as f64 - x) * (px as f64 - x) + (py as f64 - y) * (py as f64 - y)).sqrt()).sum()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` sets of 1 to `most` customers on the grid 0..=`side`; the
// checksum takes each answer in hundredths, which every arm reaches.
fn batch(count: i64, most: i64, side: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut positions: Vec[(i64, i64)] = Vec.new();
        for _ in 0..n {
            let x = next_random(mut seed) % (side + 1);
            let y = next_random(mut seed) % (side + 1);
            positions.push((x, y));
        }
        let answer = get_min_dist_sum(positions);
        check = mix(check, (answer * 100.0 + 0.5).floor() as i64);
    }
    check
}

fn main() {
    println(f"example 1 -> {get_min_dist_sum([(0, 1), (1, 0), (1, 2), (2, 1)]):.5}");
    println(f"example 2 -> {get_min_dist_sum([(1, 1), (3, 3)]):.5}");
    println(f"one customer -> {get_min_dist_sum([(5, 7)]):.5}");
    println(f"a triangle -> {get_min_dist_sum([(0, 0), (100, 0), (50, 87)]):.5}");
    let mut seed = 1515;
    println(f"300 sets of 1 to 8 customers on 0..10: checksum {batch(300, 8, 10, mut seed)}");
    println(f"30 sets of 1 to 50 customers on 0..100: checksum {batch(30, 50, 100, mut seed)}");
}
