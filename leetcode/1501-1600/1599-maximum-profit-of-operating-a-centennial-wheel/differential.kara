// LeetCode #1599: Maximum Profit of Operating a Centennial Wheel
// -- the differential.
//
// Four arms against the statement read literally, on 3000 days of 1 to
// 5 arrivals of 0 to 10 customers, costs from 1 to 12, with six
// properties. Every random choice is drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  both costs doubled leave the answer
// P3  a last arrival of no one leaves the answer
// P4  a higher boarding cost never turns a profit into -1
// P5  a running cost of four boardings or more answers -1
// P6  each arm agrees with at least two of the other three

// ---- wheel.kara: the ★ arm: rotation by rotation

fn star_arm(customers: Vec[i32], boarding_cost: i32, running_cost: i32) -> i32 {
    let mut waiting = 0;
    let mut profit = 0;
    let mut best = 0;
    let mut answer = -1;
    let mut rotations = 0;
    while rotations < customers.len() or waiting > 0 {
        if rotations < customers.len() {
            waiting += customers[rotations];
        }
        let board = waiting.min(4);
        waiting -= board;
        profit += board * boarding_cost - running_cost;
        rotations += 1;
        if profit > best {
            best = profit;
            answer = rotations as i32;
        }
    }
    answer
}

// ---- wheel_tail.kara: the tail in closed form

fn tail_arm(customers: Vec[i32], boarding_cost: i32, running_cost: i32) -> i32 {
    let mut waiting: i64 = 0;
    let mut profit: i64 = 0;
    let mut best: i64 = 0;
    let mut answer: i64 = -1;
    for (i, arriving) in customers.iter().enumerate() {
        waiting += arriving;
        let board = waiting.min(4);
        waiting -= board;
        profit += board * boarding_cost - running_cost;
        if profit > best {
            best = profit;
            answer = i + 1;
        }
    }
    let full = waiting / 4;
    let rest = waiting % 4;
    let per_full = 4 * boarding_cost - running_cost;
    profit += full * per_full;
    if per_full > 0 and full > 0 and profit > best {
        best = profit;
        answer = customers.len() + full;
    }
    if rest > 0 {
        profit += rest * boarding_cost - running_cost;
        if profit > best {
            answer = customers.len() + full + 1;
        }
    }
    answer as i32
}

// ---- wheel_profits.kara: every profit by scan, then the best

fn profits_arm(customers: Vec[i32], boarding_cost: i32, running_cost: i32) -> i32 {
    let total: i64 = customers.iter().map(|c| c as i64).sum();
    let rotations = customers.len().max((total + 3) / 4 + customers.len());
    let profits: Vec[i64] = (0..rotations).scan((0, 0), |state, r| {
        let (waiting, profit) = state;
        let queued = waiting + if r < customers.len() {
            customers[r] as i64
        } else {
            0
        };
        let board = queued.min(4);
        let state = (queued - board, profit + board * boarding_cost - running_cost);
        Some((state, state.1))
    }).collect();
    let (best_at, best) = profits.iter().enumerate().fold((0, i64.MIN), |(at, high), (i, p)| {
        if *p > high { (i, *p) } else { (at, high) }
    });
    if best > 0 { (best_at + 1) as i32 } else { -1 }
}

// ---- wheel_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn min_operations_max_profit(customers: Vec[i32], boarding_cost: i32, running_cost: i32) -> i32 {
        let n = customers.len();
        let mut (wait, profit, best, ans) = (0, 0, 0, -1);
        let mut i = 0;
        loop {
            if i >= n and wait == 0 {
                break;
            }
            if i < n {
                wait += customers[i];
            }
            let b = wait.min(4);
            wait -= b;
            profit += b * boarding_cost - running_cost;
            i += 1;
            if profit > best {
                best = profit;
                ans = i as i32;
            }
        }
        ans
    }
}

fn solution_arm(customers: Vec[i32], boarding_cost: i32, running_cost: i32) -> i32 {
    SolutionArm.min_operations_max_profit(customers, boarding_cost, running_cost)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, customers: Vec[i32], boarding: i32, running: i32) -> i32 {
    match a {
        0 => star_arm(customers, boarding, running),
        1 => tail_arm(customers, boarding, running),
        2 => profits_arm(customers, boarding, running),
        _ => solution_arm(customers, boarding, running),
    }
}

fn arm_name(a: i64) -> String {
    ["wheel", "tail", "profits", "solution"][a].to_string()
}

// ---- the statement read literally: for each number of rotations k the
// wheel could be stopped after, the day run from the start for exactly k
// rotations (each group joining the queue before its rotation, up to four
// boarding at each), its profit the fares less k running costs; the
// fewest rotations of the highest profit, or -1 when no k makes one

fn profit_after(customers: Vec[i32], boarding: i32, running: i32, k: i64) -> i64 {
    let mut queue = 0;
    let mut boarded = 0;
    for r in 0..k {
        if r < customers.len() {
            queue += customers[r];
        }
        let up = queue.min(4);
        queue -= up;
        boarded += up;
    }
    boarded * boarding - k * running
}

fn literal(customers: Vec[i32], boarding: i32, running: i32) -> i32 {
    let total: i64 = customers.iter().map(|c| c as i64).sum();
    let longest = customers.len() + total / 4 + 2;
    let mut best: i64 = 0;
    let mut answer = -1;
    for k in 1..longest + 1 {
        let p = profit_after(customers, boarding, running, k);
        if p > best {
            best = p;
            answer = k;
        }
    }
    answer as i32
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15990;
    let mut cases: Vec[(Vec[i32], i32, i32)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 5 + 1;
        let customers: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 11) as i32).collect();
        let boarding = (next_random(mut seed) % 12 + 1) as i32;
        let running = (next_random(mut seed) % 12 + 1) as i32;
        cases.push((customers, boarding, running));
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for (p, case) in cases.iter().enumerate() {
        let (customers, boarding, running) = case;
        let truth = literal(customers, *boarding, *running);
        let mut longer = customers.clone();
        longer.push(0);
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, customers, *boarding, *running);
            answers.push(answer);
            check = (check * 31 + answer + 1) % 1000000007;
            let failed = [
                answer != truth,
                arm(a, customers, *boarding * 2, *running * 2) != answer,
                arm(a, longer, *boarding, *running) != answer,
                answer != -1 and arm(a, customers, *boarding + 1, *running) == -1,
                arm(a, customers, *boarding, *boarding * 4 + *running % 3) != -1,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
