// LeetCode #1599: Maximum Profit of Operating a Centennial Wheel -- the
// bench: the ★ arm on 300 days of 100000 arrivals, all drawn first.
//
// The ★ arm: the wheel run rotation by rotation.

fn min_operations_max_profit(customers: Vec[i32], boarding_cost: i32, running_cost: i32) -> i32 {
    let mut waiting = 0;
    let mut profit = 0;
    let mut best = 0;
    let mut answer = -1;
    let mut rotations = 0;
    while rotations < customers.len() or waiting > 0 {
        if rotations < customers.len() {
            waiting += customers[rotations];
        }
        let board = waiting.min(4);
        waiting -= board;
        profit += board * boarding_cost - running_cost;
        rotations += 1;
        if profit > best {
            best = profit;
            answer = rotations as i32;
        }
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1599;
    let mut days: Vec[(Vec[i32], i32, i32)] = Vec.new();
    for _ in 0..300 {
        let customers: Vec[i32] = (0..100000).map(|_| (next_random(mut seed) % 9) as i32).collect();
        let boarding = (next_random(mut seed) % 100 + 1) as i32;
        let running = (next_random(mut seed) % 100 + 1) as i32;
        days.push((customers, boarding, running));
    }
    let mut check = 0;
    for (customers, boarding, running) in days.iter() {
        let answer = min_operations_max_profit(customers, boarding, running);
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"300 days of 100000 arrivals: checksum {check}");
}
