// LeetCode #1599: Maximum Profit of Operating a Centennial Wheel -- a
// Rust solution as LeetCode's Rust users write it (`impl Solution`, an
// index `i` over the arrivals and a `loop` that breaks when no one is
// left, `i32` counts throughout), carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn min_operations_max_profit(customers: Vec[i32], boarding_cost: i32, running_cost: i32) -> i32 {
        let n = customers.len();
        let mut (wait, profit, best, ans) = (0, 0, 0, -1);
        let mut i = 0;
        loop {
            if i >= n and wait == 0 {
                break;
            }
            if i < n {
                wait += customers[i];
            }
            let b = wait.min(4);
            wait -= b;
            profit += b * boarding_cost - running_cost;
            i += 1;
            if profit > best {
                best = profit;
                ans = i as i32;
            }
        }
        ans
    }
}

fn min_operations_max_profit(customers: Vec[i32], boarding_cost: i32, running_cost: i32) -> i32 {
    Solution.min_operations_max_profit(customers, boarding_cost, running_cost)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut never = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let customers: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 51) as i32).collect();
        let boarding = (next_random(mut seed) % 100 + 1) as i32;
        let running = (next_random(mut seed) % 100 + 1) as i32;
        let answer = min_operations_max_profit(customers, boarding, running);
        if answer == -1 {
            never += 1;
        }
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"{count} days of up to {most} arrivals: {never} never in profit, checksum {check}");
}

fn main() {
    let examples: Vec[(Vec[i32], i32, i32)] = [
        ([8, 3], 5, 6),
        ([10, 9, 6], 6, 4),
        ([3, 4, 0, 5, 1], 1, 92),
        ([0, 0, 0], 5, 1),
        ([4], 1, 4),
        ([50, 50, 50], 100, 1),
        ([0, 0, 13], 10, 39),
    ];
    for (customers, boarding, running) in examples.iter() {
        println(f"{customers}, {boarding}, {running} -> {min_operations_max_profit(customers, boarding, running)}");
    }
    let mut seed = 1599;
    batch(3000, 6, mut seed);
    batch(300, 100, mut seed);
    batch(3, 100000, mut seed);
}
