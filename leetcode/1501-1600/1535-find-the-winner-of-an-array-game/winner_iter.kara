// LeetCode #1535: Find the Winner of an Array Game -- the ★ arm as a
// `try_fold` over the values after the first: the state is the front and
// its streak, and a streak reaching k breaks out with the winner as the
// `Err`. Finishing the fold leaves the largest value at the front.

fn get_winner(arr: Vec[i64], k: i64) -> i64 {
    let walk = arr.iter().skip(1).try_fold((arr[0], 0), |(front, streak), v| {
        let (front, streak) = if v > front { (v, 1) } else { (front, streak + 1) };
        if streak == k { Err(front) } else { Ok((front, streak)) }
    });
    match walk {
        Ok((front, _)) => front,
        Err(winner) => winner,
    }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn draw(seed: mut ref i64, below: i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % below
}

// `count` arrays of 2 to `most` distinct values (multiples of 3 shuffled),
// each with k from 1 to `reach`
fn batch(count: i64, most: i64, reach: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = draw(mut seed, most - 1) + 2;
        let mut arr: Vec[i64] = (1..=n).map(|v| v * 3).collect();
        for i in (1..n).rev() {
            let j = draw(mut seed, i + 1);
            arr.swap(i, j);
        }
        let k = draw(mut seed, reach) + 1;
        check = mix(check, get_winner(arr, k));
    }
    println(f"{count} arrays of 2 to {most} values, k up to {reach}: checksum {check}");
}

fn main() {
    let examples: Vec[(Vec[i64], i64)] = [
        ([2, 1, 3, 5, 4, 6, 7], 2),
        ([3, 2, 1], 10),
        ([1, 9, 8, 2, 3, 7, 6, 4, 5], 7),
        ([1, 11, 22, 33, 44, 55, 66, 77, 88, 99], 1000000000),
        ([5, 1], 1),
        ([1, 5], 1),
        ([4, 3, 2, 1, 5], 3),
    ];
    for (arr, k) in examples.iter() {
        println(f"{arr}, k = {k} -> {get_winner(arr.clone(), k)}");
    }
    let rising: Vec[i64] = (1..=100000).collect();
    println(f"1 to 100000, k = 1 -> {get_winner(rising.clone(), 1)}, k = 99999 -> {get_winner(rising, 99999)}");
    let mut seed = 1535;
    batch(3000, 12, 15, mut seed);
    batch(300, 1000, 2000, mut seed);
    batch(3, 100000, 1000000000, mut seed);
}
