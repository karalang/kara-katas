// LeetCode #1588: Sum of All Odd Length Subarrays -- prefix sums.
//
// The running sums of the array, so that each subarray's sum is one
// subtraction; every odd length tried from every start. O(n^2).

fn sum_odd_length_subarrays(arr: Vec[i32]) -> i32 {
    let n = arr.len();
    let mut prefix = Vec.filled(n + 1, 0i32);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + arr[i];
    }
    let mut total: i32 = 0;
    let mut len = 1;
    while len <= n {
        for start in 0..n - len + 1 {
            total += prefix[start + len] - prefix[start];
        }
        len += 2;
    }
    total
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn batch(count: i64, least: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = least + next_random(mut seed) % (most - least + 1);
        let arr: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % top + 1) as i32).collect();
        let answer = sum_odd_length_subarrays(arr) as i64;
        total += answer;
        check = mix(check, answer);
    }
    println(f"{count} arrays of {least} to {most} values up to {top}: total {total}, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[i32]] = [[1, 4, 2, 5, 3], [1, 2], [10, 11, 12], [7], [1, 1, 1, 1], Vec.filled(100, 1000)];
    for arr in examples.iter() {
        let shown = if arr.len() > 10 { f"[{arr[0]}; {arr.len()}]" } else { f"{arr}" };
        println(f"{shown} -> {sum_odd_length_subarrays(arr)}");
    }
    let mut seed = 1588;
    batch(3000, 1, 10, 10, mut seed);
    batch(300, 1, 100, 1000, mut seed);
    batch(30, 100, 100, 1000, mut seed);
}
