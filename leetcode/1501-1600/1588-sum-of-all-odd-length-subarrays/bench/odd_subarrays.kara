// LeetCode #1588: Sum of All Odd Length Subarrays -- the bench: the ★ arm
// on 200000 arrays of 1 to 100 values up to 1000, all drawn first.
//
// The ★ arm: each value counted once for every odd-length subarray
// holding it, (i + 1) (n - i) + 1 over 2 of them, rounded down.

fn sum_odd_length_subarrays(arr: Vec[i32]) -> i32 {
    let n = arr.len();
    let mut total: i32 = 0;
    for (i, v) in arr.iter().enumerate() {
        let through = (i + 1) * (n - i);
        total += ((through + 1) / 2) as i32 * *v;
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1588;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    for _ in 0..200000 {
        let n = next_random(mut seed) % 100 + 1;
        let arr: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 1000 + 1) as i32).collect();
        arrays.push(arr);
    }
    let mut check = 0;
    let mut total = 0;
    for arr in arrays.iter() {
        let answer = sum_odd_length_subarrays(arr) as i64;
        total += answer;
        check = mix(check, answer);
    }
    println(f"200000 arrays of 1 to 100 values: total {total}, checksum {check}");
}
