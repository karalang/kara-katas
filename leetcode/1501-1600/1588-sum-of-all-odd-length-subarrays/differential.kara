// LeetCode #1588: Sum of All Odd Length Subarrays -- the differential.
//
// Four arms against the statement read literally, on 3000 arrays of 1 to
// 12 values from 1 to 9, with six properties. Every random choice is
// drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the array reversed leaves the answer
// P3  every value doubled doubles the answer
// P4  every value raised by 1 adds the answer for n ones
// P5  the answer for two arrays added place by place is the sum of theirs
// P6  each arm agrees with at least two of the other three

// ---- odd_subarrays.kara: the ★ arm: each value times its count of odd subarrays

fn star_arm(arr: Vec[i32]) -> i32 {
    let n = arr.len();
    let mut total: i32 = 0;
    for (i, v) in arr.iter().enumerate() {
        let through = (i + 1) * (n - i);
        total += ((through + 1) / 2) as i32 * *v;
    }
    total
}

// ---- odd_subarrays_prefix.kara: prefix sums, every odd length from every start

fn prefix_arm(arr: Vec[i32]) -> i32 {
    let n = arr.len();
    let mut prefix = Vec.filled(n + 1, 0i32);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + arr[i];
    }
    let mut total: i32 = 0;
    let mut len = 1;
    while len <= n {
        for start in 0..n - len + 1 {
            total += prefix[start + len] - prefix[start];
        }
        len += 2;
    }
    total
}

// ---- odd_subarrays_windows.kara: every window of every odd length, by an iterator chain

fn windows_arm(arr: Vec[i32]) -> i32 {
    (1..arr.len() + 1).step_by(2).map(|len| arr.windows(len).into_iter().map(|w| w.iter().sum()).sum()).sum()
}

// ---- odd_subarrays_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn sum_odd_length_subarrays(arr: Vec[i32]) -> i32 {
        let n = arr.len();
        let mut ans: i32 = 0;
        for i in 0..n {
            let mut sum: i32 = 0;
            for j in i..n {
                sum += arr[j];
                if (j - i) % 2 == 0 {
                    ans += sum;
                }
            }
        }
        ans
    }
}

fn solution_arm(arr: Vec[i32]) -> i32 {
    Solution.sum_odd_length_subarrays(arr)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, arr: Vec[i32]) -> i32 {
    match a {
        0 => star_arm(arr),
        1 => prefix_arm(arr),
        2 => windows_arm(arr),
        _ => solution_arm(arr),
    }
}

fn arm_name(a: i64) -> String {
    ["odd_subarrays", "prefix", "windows", "solution"][a].to_string()
}

// ---- the statement read literally: every subarray, its length tested,
// its values added one by one

fn literal(arr: Vec[i32]) -> i32 {
    let n = arr.len();
    let mut total: i32 = 0;
    for start in 0..n {
        for end in start..n {
            if (end - start + 1) % 2 == 1 {
                for k in start..end + 1 {
                    total += arr[k];
                }
            }
        }
    }
    total
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15880;
    let mut cases: Vec[(Vec[i32], Vec[i32])] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 12 + 1;
        let arr: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 9 + 1) as i32).collect();
        let other: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 9 + 1) as i32).collect();
        cases.push((arr, other));
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for (p, (arr, other)) in cases.iter().enumerate() {
        let truth = literal(arr);
        let reversed: Vec[i32] = arr.iter().rev().map(|v| *v).collect();
        let doubled: Vec[i32] = arr.iter().map(|v| *v * 2).collect();
        let raised: Vec[i32] = arr.iter().map(|v| *v + 1).collect();
        let ones = Vec.filled(arr.len(), 1);
        let added: Vec[i32] = arr.iter().zip(other.iter()).map(|(x, y)| *x + *y).collect();
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, arr);
            answers.push(answer);
            check = (check * 31 + answer + 1) % 1000000007;
            let failed = [
                answer != truth,
                arm(a, reversed) != answer,
                arm(a, doubled) != answer * 2,
                arm(a, raised) != answer + arm(a, ones),
                arm(a, added) != answer + arm(a, other),
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
