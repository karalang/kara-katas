// LeetCode #1591: Strange Printer II -- the bench: the ★ arm on 4000
// grids of 60 by 60, each printed by the 60 colours in a random order as
// random rectangles, every other one then given one cell redrawn, all
// drawn first.
//
// The ★ arm: any other colour inside a colour's bounding rectangle was
// printed after it; the grid can be printed exactly when those orders
// have no cycle, found by Kahn's algorithm.

fn is_printable(target_grid: Vec[Vec[i32]]) -> bool {
    let rows = target_grid.len();
    let cols = target_grid[0].len();
    // each colour's bounding rectangle: top, bottom, left, right
    let mut top = Vec.filled(61, rows);
    let mut bottom = Vec.filled(61, -1);
    let mut left = Vec.filled(61, cols);
    let mut right = Vec.filled(61, -1);
    for r in 0..rows {
        for c in 0..cols {
            let k = target_grid[r][c];
            top[k] = top[k].min(r);
            bottom[k] = bottom[k].max(r);
            left[k] = left[k].min(c);
            right[k] = right[k].max(c);
        }
    }
    let mut after = Vec.filled(61, Vec.filled(61, false));
    let mut before = Vec.filled(61, 0);
    for k in 1..61 {
        for r in top[k]..bottom[k] + 1 {
            for c in left[k]..right[k] + 1 {
                let other = target_grid[r][c];
                if other != k and not after[k][other] {
                    after[k][other] = true;
                    before[other] += 1;
                }
            }
        }
    }
    let mut ready: Vec[i64] = (1..61).filter(|k| before[k] == 0).collect();
    let mut taken = 0;
    while let Some(k) = ready.pop() {
        taken += 1;
        for other in 1..61 {
            if after[k][other] {
                before[other] -= 1;
                if before[other] == 0 {
                    ready.push(other);
                }
            }
        }
    }
    taken == 60
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1591;
    let mut grids: Vec[Vec[Vec[i32]]] = Vec.new();
    for g in 0..4000 {
        let mut order: Vec[i32] = (1..61).map(|k| k as i32).collect();
        for i in (1..60).rev() {
            order.swap(i, next_random(mut seed) % (i + 1));
        }
        let mut grid = Vec.filled(60, Vec.filled(60, order[0]));
        for k in order[1..].iter() {
            let r1 = next_random(mut seed) % 60;
            let r2 = next_random(mut seed) % 60;
            let c1 = next_random(mut seed) % 60;
            let c2 = next_random(mut seed) % 60;
            for r in r1.min(r2)..r1.max(r2) + 1 {
                for c in c1.min(c2)..c1.max(c2) + 1 {
                    grid[r][c] = *k;
                }
            }
        }
        if g % 2 == 1 {
            let r = next_random(mut seed) % 60;
            let c = next_random(mut seed) % 60;
            grid[r][c] = (next_random(mut seed) % 60 + 1) as i32;
        }
        grids.push(grid);
    }
    let mut check = 0;
    let mut yes = 0;
    for grid in grids.iter() {
        let ok = is_printable(grid);
        if ok {
            yes += 1;
        }
        check = mix(check, if ok { 1 } else { 0 });
    }
    println(f"4000 grids of 60 by 60: {yes} printable, checksum {check}");
}
