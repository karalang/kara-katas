// LeetCode #1513: Number of Substrings With Only 1s -- LeetCode's Rust
// template, written as Rust writes it and carried to Kāra by `karac fix`:
// the ★ arm over the bytes.

struct Solution {}

impl Solution {
    pub fn num_sub(s: String) -> i32 {
        let mut ans: i64 = 0;
        let mut run: i64 = 0;
        for b in s.bytes() {
            if b == b'1' {
                run += 1;
                ans += run;
            } else {
                run = 0;
            }
        }
        (ans % 1_000_000_007) as i32
    }
}

fn num_sub(s: String) -> i64 {
    Solution.num_sub(s.clone())
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 1 to `most` bits, each with its own share of ones.
fn batch(count: i64, most: i64, seed: mut ref i64) -> i64 {
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let tenths = next_random(mut seed) % 11;
        let mut s = String.new();
        for _ in 0..n {
            s.push(if next_random(mut seed) % 10 < tenths { '1' } else { '0' });
        }
        check = mix(check, num_sub(s));
    }
    check
}

fn main() {
    for s in ["0110111", "101", "111111", "000", "1"] {
        println(f"\"{s}\" -> {num_sub(s)}");
    }
    let ones = "1".repeat(100000);
    println(f"100000 ones -> {num_sub(ones)}");
    let mut seed = 1513;
    println(f"3000 strings of 1 to 12 bits: checksum {batch(3000, 12, mut seed)}");
    println(f"300 strings of 1 to 1000 bits: checksum {batch(300, 1000, mut seed)}");
    println(f"3 strings of 1 to 100000 bits: checksum {batch(3, 100000, mut seed)}");
}
