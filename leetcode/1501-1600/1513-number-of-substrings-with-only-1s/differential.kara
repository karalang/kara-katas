// LeetCode #1513: Number of Substrings With Only 1s -- the differential.
//
// Five arms against the statement read literally, on 3000 strings, with
// six properties.
//
// P1  the answer is the statement read literally: every substring looked
//     at, the ones made only of '1' counted
// P2  the string reversed leaves the answer
// P3  a '0' added at the end leaves the answer
// P4  a '1' added at the end adds the last run's length plus one
// P5  the string, a '0', and the string again has twice the answer
// P6  each arm agrees with at least three of the other four

const MOD: i64 = 1000000007;

// ---- ones.kara: the ★ arm: the run's length added at every '1'
fn star_arm(s: String) -> i64 {
    let mut run = 0;
    let mut total = 0;
    for c in s.chars() {
        if c == '1' {
            run += 1;
            total += run;
        } else {
            run = 0;
        }
    }
    total % MOD
}

// ---- ones_runs.kara: split at the '0's
fn runs_arm(s: String) -> i64 {
    let mut total = 0;
    for piece in s.split("0") {
        let r = piece.len();
        total += r * (r + 1) / 2;
    }
    total % MOD
}

// ---- ones_bytes.kara: two indices over the bytes
fn bytes_arm(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut total = 0;
    let mut start = 0;
    while start < n {
        if b[start] != 49 {
            start += 1;
            continue;
        }
        let mut end = start;
        while end < n and b[end] == 49 {
            end += 1;
        }
        let r = end - start;
        total = (total + r * (r + 1) / 2) % MOD;
        start = end;
    }
    total
}

// ---- ones_iter.kara: scan, sum
fn iter_arm(s: String) -> i64 {
    let total: i64 = s.chars().scan(0, |run, c| {
        let next = if c == '1' { run + 1 } else { 0 };
        Some((next, next))
    }).sum();
    total % MOD
}

// ---- ones_solution.kara: LeetCode's Rust template through karac fix
struct Solution {}

impl Solution {
    pub fn num_sub(s: String) -> i32 {
        let mut ans: i64 = 0;
        let mut run: i64 = 0;
        for b in s.bytes() {
            if b == b'1' {
                run += 1;
                ans += run;
            } else {
                run = 0;
            }
        }
        (ans % 1_000_000_007) as i32
    }
}

fn solution_arm(s: String) -> i64 {
    Solution.num_sub(s.clone())
}

// ---- the statement read literally ----------------------------------------

fn literal(s: String) -> i64 {
    let b = s.bytes();
    let mut count = 0;
    for i in 0..b.len() {
        for j in i..b.len() {
            let mut only_ones = true;
            for k in i..j + 1 {
                if b[k] != 49 {
                    only_ones = false;
                }
            }
            if only_ones {
                count += 1;
            }
        }
    }
    count % MOD
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn arm(k: i64, s: String) -> i64 {
    if k == 0 {
        star_arm(s)
    } else if k == 1 {
        runs_arm(s)
    } else if k == 2 {
        bytes_arm(s)
    } else if k == 3 {
        iter_arm(s)
    } else {
        solution_arm(s)
    }
}

fn arm_name(k: i64) -> String {
    ["star", "runs", "bytes", "iter", "solution"][k].to_string()
}

fn main() {
    let arms = 5;
    let problems = 3000;
    let mut seed = 15130;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first
        let n = next_random(mut seed) % 12 + 1;
        let tenths = next_random(mut seed) % 11;
        let mut s = String.new();
        for _ in 0..n {
            s.push(if next_random(mut seed) % 10 < tenths { '1' } else { '0' });
        }
        let reversed: String = s.chars().rev().collect();
        let with_zero = f"{s}0";
        let with_one = f"{s}1";
        let doubled = f"{s}0{s}";
        let mut tail = 0;
        for c in s.chars() {
            tail = if c == '1' { tail + 1 } else { 0 };
        }

        let truth = literal(s.clone());
        let mut answers: Vec[i64] = Vec.new();
        for k in 0..arms {
            let answer = arm(k, s.clone());
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            if arm(k, reversed.clone()) != answer {
                fails[2] += 1;
            }
            if arm(k, with_zero.clone()) != answer {
                fails[3] += 1;
            }
            if arm(k, with_one.clone()) != answer + tail + 1 {
                fails[4] += 1;
            }
            if arm(k, doubled.clone()) != 2 * answer {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(k)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for k in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != k and answers[other] == answers[k] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 3 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, answers[0]);
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
