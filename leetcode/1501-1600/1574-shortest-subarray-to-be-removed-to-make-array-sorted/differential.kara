// LeetCode #1574: Shortest Subarray to be Removed to Make Array Sorted --
// the differential.
//
// Four arms against the statement read literally, on 3000 arrays of 1 to
// 10 values from 0 to 5, with six properties. Every random choice is
// drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer is at most n - 1, and 0 exactly when the array is sorted
// P3  every value doubled leaves the answer
// P4  the array reversed and each value v made 5 - v leaves the answer
// P5  a value at least the largest put at the end leaves the answer
// P6  each arm agrees with at least two of the other three

// ---- shortest.kara: the ★ arm: a sorted prefix joined to a sorted suffix by two pointers

fn star_arm(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut left = 0;
    while left + 1 < n and arr[left] <= arr[left + 1] {
        left += 1;
    }
    if left == n - 1 {
        return 0;
    }
    let mut right = n - 1;
    while right > 0 and arr[right - 1] <= arr[right] {
        right -= 1;
    }
    let mut best = (n - left - 1).min(right);
    let mut j = right;
    for i in 0..left + 1 {
        while j < n and arr[j] < arr[i] {
            j += 1;
        }
        best = best.min(j - i - 1);
    }
    best
}

// ---- shortest_search.kara: the suffix joined by binary search

fn search_arm(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut left = 0;
    while left + 1 < n and arr[left] <= arr[left + 1] {
        left += 1;
    }
    if left == n - 1 {
        return 0;
    }
    let mut right = n - 1;
    while right > 0 and arr[right - 1] <= arr[right] {
        right -= 1;
    }
    let suffix = arr[right..];
    let mut best = (n - left - 1).min(right);
    for i in 0..left + 1 {
        let j = right + suffix.partition_point(|x| x < arr[i]);
        best = best.min(j - i - 1);
    }
    best
}

// ---- shortest_window.kara: a binary search on the removed length

fn window_arm(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    // sorted_to[i]: arr[0..i] is sorted; sorted_from[i]: arr[i..] is sorted
    let mut sorted_to = Vec.filled(n + 1, true);
    for i in 2..n + 1 {
        sorted_to[i] = sorted_to[i - 1] and arr[i - 2] <= arr[i - 1];
    }
    let mut sorted_from = Vec.filled(n + 1, true);
    for i in (0..n - 1).rev() {
        sorted_from[i] = sorted_from[i + 1] and arr[i] <= arr[i + 1];
    }
    let fits = |len: i64| {
        (0..n - len + 1).any(|i| {
            let j = i + len;
            sorted_to[i] and sorted_from[j] and (i == 0 or j == n or arr[i - 1] <= arr[j])
        })
    };
    let mut lo = 0;
    let mut hi = n - 1;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if fits(mid) {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

// ---- shortest_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn find_length_of_shortest_subarray(arr: Vec[i32]) -> i32 {
        let n = arr.len();
        let mut r = n - 1;
        while r > 0 and arr[r - 1] <= arr[r] {
            r -= 1;
        }
        if r == 0 {
            return 0;
        }
        let mut ans = r;
        let mut l = 0;
        while l < r and (l == 0 or arr[l - 1] <= arr[l]) {
            while r < n and arr[r] < arr[l] {
                r += 1;
            }
            ans = ans.min(r - l - 1);
            l += 1;
        }
        ans as i32
    }
}

fn solution_arm(arr: Vec[i64]) -> i64 {
    let arr: Vec[i32] = arr.iter().map(|x| x as i32).collect();
    Solution.find_length_of_shortest_subarray(arr)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, arr: Vec[i64]) -> i64 {
    match a {
        0 => star_arm(arr),
        1 => search_arm(arr),
        2 => window_arm(arr),
        _ => solution_arm(arr),
    }
}

fn arm_name(a: i64) -> String {
    ["shortest", "search", "window", "solution"][a].to_string()
}

fn is_sorted(v: Vec[i64]) -> bool {
    v.windows(2).into_iter().all(|w| w[0] <= w[1])
}

// ---- the statement read literally: every subarray removed in turn, the
// empty one included, and the shortest whose removal leaves the rest sorted

fn literal(arr: Vec[i64]) -> i64 {
    let n = arr.len();
    let mut best = n;
    for i in 0..n + 1 {
        for j in i..n + 1 {
            let mut rest = arr[..i].to_vec();
            rest.extend(arr[j..].iter().cloned());
            if is_sorted(rest) {
                best = best.min(j - i);
            }
        }
    }
    best
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15740;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 10 + 1;
        let arr: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 6).collect();
        cases.push(arr);
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for (p, arr) in cases.iter().enumerate() {
        let n = arr.len();
        let truth = literal(arr);
        let sorted = is_sorted(arr);
        let doubled: Vec[i64] = arr.iter().map(|v| 2 * v).collect();
        let mirrored: Vec[i64] = arr.iter().rev().map(|v| 5 - v).collect();
        let mut capped = arr.clone();
        capped.push(5);
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, arr);
            answers.push(answer);
            check = (check * 31 + answer + 1) % 1000000007;
            let failed = [
                answer != truth,
                answer > n - 1 or (answer == 0) != sorted,
                arm(a, doubled) != answer,
                arm(a, mirrored) != answer,
                arm(a, capped) != answer,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
