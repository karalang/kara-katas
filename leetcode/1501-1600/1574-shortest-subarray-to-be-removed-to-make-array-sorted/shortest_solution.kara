// LeetCode #1574: Shortest Subarray to be Removed to Make Array Sorted --
// LeetCode's Rust template as karac fix left it: the sorted prefix and
// suffix by two `while` loops over `usize`, then the two pointers, over
// `i32` values.

struct Solution {}

impl Solution {
    pub fn find_length_of_shortest_subarray(arr: Vec[i32]) -> i32 {
        let n = arr.len();
        let mut r = n - 1;
        while r > 0 and arr[r - 1] <= arr[r] {
            r -= 1;
        }
        if r == 0 {
            return 0;
        }
        let mut ans = r;
        let mut l = 0;
        while l < r and (l == 0 or arr[l - 1] <= arr[l]) {
            while r < n and arr[r] < arr[l] {
                r += 1;
            }
            ans = ans.min(r - l - 1);
            l += 1;
        }
        ans as i32
    }
}

fn shortest(arr: Vec[i64]) -> i64 {
    let arr: Vec[i32] = arr.iter().map(|x| x as i32).collect();
    Solution.find_length_of_shortest_subarray(arr)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` arrays of 1 to `most` values, each a rising run with its own odds
// of a fall at each step, values from 0 to `top` - 1
fn batch(count: i64, most: i64, falls: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let odds = next_random(mut seed) % falls + 1;
        let mut arr: Vec[i64] = Vec.new();
        let mut v = (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
        for _ in 0..n {
            if next_random(mut seed) % odds == 0 {
                v = (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
            } else {
                v = (v + next_random(mut seed) % 3).min(top - 1);
            }
            arr.push(v);
        }
        let length = shortest(arr);
        total += length;
        check = mix(check, length);
    }
    println(f"{count} arrays of up to {most} values: lengths total {total}, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[i64]] = [
        [1, 2, 3, 10, 4, 2, 3, 5],
        [5, 4, 3, 2, 1],
        [1, 2, 3],
        [1],
        [2, 2, 2, 1, 1, 1],
        [1, 2, 3, 3, 10, 1, 3, 3, 5],
        [6, 3, 10, 11, 15, 20, 13, 3, 18, 12],
    ];
    for arr in examples.iter() {
        println(f"{arr} -> {shortest(arr)}");
    }
    let mut seed = 1574;
    batch(3000, 10, 4, 6, mut seed);
    batch(300, 1000, 200, 1000000000, mut seed);
    batch(30, 100000, 20000, 1000000000, mut seed);
}
