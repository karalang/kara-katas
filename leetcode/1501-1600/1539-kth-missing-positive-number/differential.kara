// LeetCode #1539: Kth Missing Positive Number -- the differential.
//
// Five arms against the statement read literally, on 3000 strictly
// increasing arrays of 1 to 10 values, steps of 1 to 4, with k from 1 to
// 20, with six properties. Every random choice is drawn before any arm
// answers.
//
// P1  the answer is the statement read literally
// P2  the answer is not in arr, and lies from k to k + n
// P3  k + 1 gives a larger answer
// P4  one more value, above the answer and every value, leaves the answer
// P5  1 put in front and every value raised by one moves the answer up by
//     one
// P6  each arm agrees with at least two of the other four

// ---- kth.kara: the ★ arm: binary search on the count of missing numbers

fn star_arm(arr: Vec[i64], k: i64) -> i64 {
    let mut lo = 0;
    let mut hi = arr.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if arr[mid] - mid - 1 < k {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo + k
}

// ---- kth_scan.kara: the values walked, each one at or below k pushing it up

fn scan_arm(arr: Vec[i64], k: i64) -> i64 {
    let mut kth = k;
    for x in arr.iter() {
        if x <= kth {
            kth += 1;
        } else {
            break;
        }
    }
    kth
}

// ---- kth_walk.kara: the positive numbers counted up with a pointer into arr

fn walk_arm(arr: Vec[i64], k: i64) -> i64 {
    let mut i = 0;
    let mut missing = 0;
    let mut x = 0;
    loop {
        x += 1;
        if i < arr.len() and arr[i] == x {
            i += 1;
        } else {
            missing += 1;
            if missing == k {
                return x;
            }
        }
    }
}

// ---- kth_set.kara: a Set and an iterator filter, the k-th taken with nth

fn set_arm(arr: Vec[i64], k: i64) -> i64 {
    let present: Set[i64] = arr.iter().cloned().collect();
    (1..).filter(|x| not present.contains(x)).nth(k - 1).unwrap()
}

// ---- kth_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn find_kth_positive(arr: Vec[i32], k: i32) -> i32 {
        let mut (lo, hi) = (0, arr.len());
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if arr[mid] - mid as i32 - 1 < k {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo as i32 + k
    }
}

fn solution_arm(arr: Vec[i64], k: i64) -> i64 {
    let arr: Vec[i32] = arr.iter().map(|x| x as i32).collect();
    Solution.find_kth_positive(arr, k as i32)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, arr: Vec[i64], k: i64) -> i64 {
    match a {
        0 => star_arm(arr, k),
        1 => scan_arm(arr, k),
        2 => walk_arm(arr, k),
        3 => set_arm(arr, k),
        _ => solution_arm(arr, k),
    }
}

fn arm_name(a: i64) -> String {
    ["kth", "scan", "walk", "set", "solution"][a].to_string()
}

// ---- the statement read literally: the positive numbers from 1, each one
// arr does not contain counted, until the k-th

fn literal(arr: Vec[i64], k: i64) -> i64 {
    let mut missing = 0;
    let mut x = 0;
    while missing < k {
        x += 1;
        if not arr.contains(x) {
            missing += 1;
        }
    }
    x
}

fn main() {
    let arms = 5;
    let problems = 3000;
    let mut seed = 15390;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 10 + 1;
        let gap = next_random(mut seed) % 4 + 1;
        let mut arr = Vec.new();
        let mut value = 0;
        for _ in 0..n {
            value += next_random(mut seed) % gap + 1;
            arr.push(value);
        }
        let k = next_random(mut seed) % 20 + 1;
        cases.push((arr, k));
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for p in 0..problems {
        let (arr, k) = cases[p].clone();
        let truth = literal(arr.clone(), k);
        let n = arr.len();
        let mut shifted: Vec[i64] = [1];
        shifted.extend(arr.iter().map(|x| x + 1));
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, arr.clone(), k);
            answers.push(answer);
            check = (check * 31 + answer + 1) % 1000000007;
            let mut beyond = arr.clone();
            beyond.push(answer.max(arr[n - 1]) + 1);
            let failed = [
                answer != truth,
                arr.contains(answer) or answer < k or answer > k + n,
                arm(a, arr.clone(), k + 1) <= answer,
                arm(a, beyond, k) != answer,
                arm(a, shifted.clone(), k) != answer + 1,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
