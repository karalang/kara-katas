// LeetCode #1594: Maximum Non Negative Product in a Matrix -- by sign.
//
// Each cell keeps three facts about the paths reaching it: the largest
// positive product, the negative product of largest size, and whether a
// path through a zero gets there, as an enum per sign. The largest of
// these is the answer's candidate; sizes are never negative. O(mn).

struct Reach {
    pos: Option[i64],
    neg: Option[i64],
    zero: bool,
}

fn better(a: Option[i64], b: Option[i64]) -> Option[i64] {
    match (a, b) {
        (Some(x), Some(y)) => Some(x.max(y)),
        (Some(x), None) => Some(x),
        (None, y) => y,
    }
}

fn step(from: Reach, v: i64) -> Reach {
    if v == 0 {
        return Reach { pos: None, neg: None, zero: true };
    }
    let size = v.abs();
    let pos = from.pos.map(|p| p * size);
    let neg = from.neg.map(|n| n * size);
    if v > 0 {
        Reach { pos: pos, neg: neg, zero: from.zero }
    } else {
        Reach { pos: neg, neg: pos, zero: from.zero }
    }
}

fn max_product_path(grid: Vec[Vec[i32]]) -> i32 {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut reach: Vec[Vec[Reach]] = Vec.new();
    for r in 0..rows {
        let mut row: Vec[Reach] = Vec.new();
        for c in 0..cols {
            let v = grid[r][c] as i64;
            let here = if r == 0 and c == 0 {
                step(Reach { pos: Some(1), neg: None, zero: false }, v)
            } else {
                let mut merged = Reach { pos: None, neg: None, zero: false };
                if r > 0 {
                    let s = step(reach[r - 1][c], v);
                    merged = Reach { pos: better(merged.pos, s.pos), neg: better(merged.neg, s.neg), zero: merged.zero or s.zero };
                }
                if c > 0 {
                    let s = step(row[c - 1], v);
                    merged = Reach { pos: better(merged.pos, s.pos), neg: better(merged.neg, s.neg), zero: merged.zero or s.zero };
                }
                merged
            };
            row.push(here);
        }
        reach.push(row);
    }
    let end = ref reach[rows - 1][cols - 1];
    match end.pos {
        Some(p) => (p % 1000000007) as i32,
        None => if end.zero { 0 } else { -1 },
    }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut negative = 0;
    for _ in 0..count {
        let rows = next_random(mut seed) % most + 1;
        let cols = next_random(mut seed) % most + 1;
        let grid: Vec[Vec[i32]] = (0..rows).map(|_| (0..cols).map(|_| (next_random(mut seed) % 9 - 4) as i32).collect()).collect();
        let answer = max_product_path(grid);
        if answer == -1 {
            negative += 1;
        }
        check = mix(check, answer);
    }
    println(f"{count} grids of up to {most} by {most}: {negative} only negative, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[Vec[i32]]] = [
        [[-1, -2, -3], [-2, -3, -3], [-3, -3, -2]],
        [[1, -2, 1], [1, -2, 1], [3, -4, 1]],
        [[1, 3], [0, -4]],
        [[-4]],
        [[0]],
        Vec.filled(15, Vec.filled(15, 4)),
        Vec.filled(15, Vec.filled(15, -4)),
    ];
    for grid in examples.iter() {
        let shown = if grid.len() > 4 { f"[[{grid[0][0]}; 15]; 15]" } else { f"{grid}" };
        println(f"{shown} -> {max_product_path(grid)}");
    }
    let mut seed = 1594;
    batch(3000, 4, mut seed);
    batch(300, 15, mut seed);
}
