// LeetCode #1594: Maximum Non Negative Product in a Matrix -- a Rust
// solution as LeetCode's Rust users write it (`impl Solution`, two
// `vec![vec![0i64; n]; m]` tables, the first row and column filled
// first, `max`/`min` over four products), carried to Kāra by
// `karac fix`.

struct Solution {}

impl Solution {
    pub fn max_product_path(grid: Vec[Vec[i32]]) -> i32 {
        let m = grid.len();
        let n = grid[0].len();
        let mut mx = Vec.filled(m, Vec.filled(n, 0));
        let mut mn = Vec.filled(m, Vec.filled(n, 0));
        mx[0][0] = grid[0][0] as i64;
        mn[0][0] = grid[0][0] as i64;
        for i in 1..m {
            mx[i][0] = mx[i - 1][0] * grid[i][0];
            mn[i][0] = mx[i][0];
        }
        for j in 1..n {
            mx[0][j] = mx[0][j - 1] * grid[0][j];
            mn[0][j] = mx[0][j];
        }
        for i in 1..m {
            for j in 1..n {
                let v = grid[i][j] as i64;
                let a = mx[i - 1][j] * v;
                let b = mn[i - 1][j] * v;
                let c = mx[i][j - 1] * v;
                let d = mn[i][j - 1] * v;
                mx[i][j] = a.max(b).max(c).max(d);
                mn[i][j] = a.min(b).min(c).min(d);
            }
        }
        let res = mx[m - 1][n - 1];
        if res < 0 {
            -1
        } else {
            (res % 1_000_000_007) as i32
        }
    }
}

fn max_product_path(grid: Vec[Vec[i32]]) -> i32 {
    Solution.max_product_path(grid)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut negative = 0;
    for _ in 0..count {
        let rows = next_random(mut seed) % most + 1;
        let cols = next_random(mut seed) % most + 1;
        let grid: Vec[Vec[i32]] = (0..rows).map(|_| (0..cols).map(|_| (next_random(mut seed) % 9 - 4) as i32).collect()).collect();
        let answer = max_product_path(grid);
        if answer == -1 {
            negative += 1;
        }
        check = mix(check, answer);
    }
    println(f"{count} grids of up to {most} by {most}: {negative} only negative, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[Vec[i32]]] = [
        [[-1, -2, -3], [-2, -3, -3], [-3, -3, -2]],
        [[1, -2, 1], [1, -2, 1], [3, -4, 1]],
        [[1, 3], [0, -4]],
        [[-4]],
        [[0]],
        Vec.filled(15, Vec.filled(15, 4)),
        Vec.filled(15, Vec.filled(15, -4)),
    ];
    for grid in examples.iter() {
        let shown = if grid.len() > 4 { f"[[{grid[0][0]}; 15]; 15]" } else { f"{grid}" };
        println(f"{shown} -> {max_product_path(grid)}");
    }
    let mut seed = 1594;
    batch(3000, 4, mut seed);
    batch(300, 15, mut seed);
}
