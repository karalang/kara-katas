// LeetCode #1594: Maximum Non Negative Product in a Matrix -- the bench:
// the ★ arm on 40000 grids of 15 by 15 cells from -4 to 4, all drawn
// first.
//
// The ★ arm: the largest and the smallest product of a path reaching
// each cell, in two tables of i64.

fn max_product_path(grid: Vec[Vec[i32]]) -> i32 {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut hi = Vec.filled(rows, Vec.filled(cols, 0));
    let mut lo = Vec.filled(rows, Vec.filled(cols, 0));
    for r in 0..rows {
        for c in 0..cols {
            let v = grid[r][c] as i64;
            if r == 0 and c == 0 {
                hi[r][c] = v;
                lo[r][c] = v;
                continue;
            }
            let mut best = i64.MIN;
            let mut worst = i64.MAX;
            if r > 0 {
                best = best.max(hi[r - 1][c] * v).max(lo[r - 1][c] * v);
                worst = worst.min(hi[r - 1][c] * v).min(lo[r - 1][c] * v);
            }
            if c > 0 {
                best = best.max(hi[r][c - 1] * v).max(lo[r][c - 1] * v);
                worst = worst.min(hi[r][c - 1] * v).min(lo[r][c - 1] * v);
            }
            hi[r][c] = best;
            lo[r][c] = worst;
        }
    }
    let top = hi[rows - 1][cols - 1];
    if top < 0 { -1 } else { (top % 1000000007) as i32 }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1594;
    let mut grids: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..40000 {
        let grid: Vec[Vec[i32]] = (0..15).map(|_| (0..15).map(|_| (next_random(mut seed) % 9 - 4) as i32).collect()).collect();
        grids.push(grid);
    }
    let mut check = 0;
    let mut negative = 0;
    for grid in grids.iter() {
        let answer = max_product_path(grid);
        if answer == -1 {
            negative += 1;
        }
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"40000 grids of 15 by 15: {negative} only negative, checksum {check}");
}
