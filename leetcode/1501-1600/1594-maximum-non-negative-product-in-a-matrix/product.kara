// LeetCode #1594: Maximum Non Negative Product in a Matrix -- the ★ arm.
//
// A path that moves only right and down: at each cell the largest and the
// smallest product of a path reaching it, since a negative cell turns the
// smallest into the largest. Products stay below 4^29 and fit in i64;
// the modulus is taken only at the end. O(mn).

fn max_product_path(grid: Vec[Vec[i32]]) -> i32 {
    let rows = grid.len();
    let cols = grid[0].len();
    let mut hi = Vec.filled(rows, Vec.filled(cols, 0));
    let mut lo = Vec.filled(rows, Vec.filled(cols, 0));
    for r in 0..rows {
        for c in 0..cols {
            let v = grid[r][c] as i64;
            if r == 0 and c == 0 {
                hi[r][c] = v;
                lo[r][c] = v;
                continue;
            }
            let mut best = i64.MIN;
            let mut worst = i64.MAX;
            if r > 0 {
                best = best.max(hi[r - 1][c] * v).max(lo[r - 1][c] * v);
                worst = worst.min(hi[r - 1][c] * v).min(lo[r - 1][c] * v);
            }
            if c > 0 {
                best = best.max(hi[r][c - 1] * v).max(lo[r][c - 1] * v);
                worst = worst.min(hi[r][c - 1] * v).min(lo[r][c - 1] * v);
            }
            hi[r][c] = best;
            lo[r][c] = worst;
        }
    }
    let top = hi[rows - 1][cols - 1];
    if top < 0 { -1 } else { (top % 1000000007) as i32 }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut negative = 0;
    for _ in 0..count {
        let rows = next_random(mut seed) % most + 1;
        let cols = next_random(mut seed) % most + 1;
        let grid: Vec[Vec[i32]] = (0..rows).map(|_| (0..cols).map(|_| (next_random(mut seed) % 9 - 4) as i32).collect()).collect();
        let answer = max_product_path(grid);
        if answer == -1 {
            negative += 1;
        }
        check = mix(check, answer);
    }
    println(f"{count} grids of up to {most} by {most}: {negative} only negative, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[Vec[i32]]] = [
        [[-1, -2, -3], [-2, -3, -3], [-3, -3, -2]],
        [[1, -2, 1], [1, -2, 1], [3, -4, 1]],
        [[1, 3], [0, -4]],
        [[-4]],
        [[0]],
        Vec.filled(15, Vec.filled(15, 4)),
        Vec.filled(15, Vec.filled(15, -4)),
    ];
    for grid in examples.iter() {
        let shown = if grid.len() > 4 { f"[[{grid[0][0]}; 15]; 15]" } else { f"{grid}" };
        println(f"{shown} -> {max_product_path(grid)}");
    }
    let mut seed = 1594;
    batch(3000, 4, mut seed);
    batch(300, 15, mut seed);
}
