// LeetCode #1594: Maximum Non Negative Product in a Matrix -- from the
// end, remembered.
//
// The largest and smallest product from each cell to the bottom right
// corner, by recursion that remembers each cell's pair in a
// `Map[(i64, i64), (i64, i64)]`. O(mn).

fn from_cell(grid: Vec[Vec[i32]], r: i64, c: i64, memo: mut ref Map[(i64, i64), (i64, i64)]) -> (i64, i64) {
    if let Some(pair) = memo.get((r, c)) {
        return *pair;
    }
    let v = grid[r][c] as i64;
    let rows = grid.len();
    let cols = grid[0].len();
    let pair = if r == rows - 1 and c == cols - 1 {
        (v, v)
    } else {
        let mut ends: Vec[i64] = Vec.new();
        if r + 1 < rows {
            let (a, b) = from_cell(grid, r + 1, c, mut memo);
            ends.push(a);
            ends.push(b);
        }
        if c + 1 < cols {
            let (a, b) = from_cell(grid, r, c + 1, mut memo);
            ends.push(a);
            ends.push(b);
        }
        let products: Vec[i64] = ends.iter().map(|e| *e * v).collect();
        (*products.iter().max().unwrap(), *products.iter().min().unwrap())
    };
    memo.insert((r, c), pair);
    pair
}

fn max_product_path(grid: Vec[Vec[i32]]) -> i32 {
    let mut memo = Map.new();
    let (top, _) = from_cell(grid, 0, 0, mut memo);
    if top < 0 { -1 } else { (top % 1000000007) as i32 }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut negative = 0;
    for _ in 0..count {
        let rows = next_random(mut seed) % most + 1;
        let cols = next_random(mut seed) % most + 1;
        let grid: Vec[Vec[i32]] = (0..rows).map(|_| (0..cols).map(|_| (next_random(mut seed) % 9 - 4) as i32).collect()).collect();
        let answer = max_product_path(grid);
        if answer == -1 {
            negative += 1;
        }
        check = mix(check, answer);
    }
    println(f"{count} grids of up to {most} by {most}: {negative} only negative, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[Vec[i32]]] = [
        [[-1, -2, -3], [-2, -3, -3], [-3, -3, -2]],
        [[1, -2, 1], [1, -2, 1], [3, -4, 1]],
        [[1, 3], [0, -4]],
        [[-4]],
        [[0]],
        Vec.filled(15, Vec.filled(15, 4)),
        Vec.filled(15, Vec.filled(15, -4)),
    ];
    for grid in examples.iter() {
        let shown = if grid.len() > 4 { f"[[{grid[0][0]}; 15]; 15]" } else { f"{grid}" };
        println(f"{shown} -> {max_product_path(grid)}");
    }
    let mut seed = 1594;
    batch(3000, 4, mut seed);
    batch(300, 15, mut seed);
}
