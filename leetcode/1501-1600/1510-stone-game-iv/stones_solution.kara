// LeetCode #1510: Stone Game IV -- LeetCode's Rust template, written as
// Rust writes it and carried to Kāra by `karac fix`: the ★ arm over a
// `usize` table.

struct Solution {}

impl Solution {
    pub fn winner_square_game(n: i32) -> bool {
        let n = n as usize;
        let mut dp = Vec.filled(n + 1, false);
        for i in 1..=n {
            let mut k = 1;
            while k * k <= i {
                if not dp[i - k * k] {
                    dp[i] = true;
                    break;
                }
                k += 1;
            }
        }
        dp[n]
    }
}

fn winner_square_game(n: i64) -> bool {
    Solution.winner_square_game(n as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    for n in [1, 2, 4, 7, 17, 8, 100000].iter() {
        println(f"n = {n} -> {winner_square_game(*n)}");
    }
    let mut wins = 0;
    let mut check = 0;
    for n in 1..601 {
        let w = winner_square_game(n);
        if w {
            wins += 1;
        }
        check = mix(check, if w { n } else { 0 });
    }
    println(f"n from 1 to 600: Alice wins {wins}, checksum {check}");
    let mut seed = 1510;
    check = 0;
    for _ in 0..3 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1;
        check = mix(check, if winner_square_game(n) { n } else { 0 });
    }
    println(f"3 random n up to 100000: checksum {check}");
}
