// LeetCode #1510: Stone Game IV -- the ★ arm: a pile wins for the player
// to move when some square taken leaves a pile that loses; filled from the
// empty pile, which loses, upward. O(n sqrt n).

fn winner_square_game(n: i64) -> bool {
    let mut wins: Vec[bool] = Vec.filled(n + 1, false);
    for pile in 1..n + 1 {
        let mut k = 1;
        while k * k <= pile {
            if not wins[pile - k * k] {
                wins[pile] = true;
                break;
            }
            k += 1;
        }
    }
    wins[n]
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    for n in [1, 2, 4, 7, 17, 8, 100000].iter() {
        println(f"n = {n} -> {winner_square_game(*n)}");
    }
    let mut wins = 0;
    let mut check = 0;
    for n in 1..601 {
        let w = winner_square_game(n);
        if w {
            wins += 1;
        }
        check = mix(check, if w { n } else { 0 });
    }
    println(f"n from 1 to 600: Alice wins {wins}, checksum {check}");
    let mut seed = 1510;
    check = 0;
    for _ in 0..3 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1;
        check = mix(check, if winner_square_game(n) { n } else { 0 });
    }
    println(f"3 random n up to 100000: checksum {check}");
}
