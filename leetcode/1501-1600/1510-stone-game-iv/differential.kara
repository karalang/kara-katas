// LeetCode #1510: Stone Game IV -- the differential.
//
// Three arms against the statement read literally, on 2000 piles, with six
// properties.
//
// P1  the answer is the statement read literally: the game played out,
//     every move tried, on piles of up to 24 stones
// P2  a pile that is a square wins: take it all
// P3  a pile that loses makes every pile a square above it win
// P4  a pile that wins has a move to a pile that loses
// P5  a pile that loses has no move to a pile that loses
// P6  each arm agrees with at least one of the other two

// ---- stones.kara: the ★ arm: pulled from the piles below
fn star_arm(n: i64) -> bool {
    let mut wins: Vec[bool] = Vec.filled(n + 1, false);
    for pile in 1..n + 1 {
        let mut k = 1;
        while k * k <= pile {
            if not wins[pile - k * k] {
                wins[pile] = true;
                break;
            }
            k += 1;
        }
    }
    wins[n]
}

// ---- stones_push.kara: pushed forward from each losing pile
fn push_arm(n: i64) -> bool {
    let mut wins: Vec[bool] = Vec.filled(n + 1, false);
    for pile in 0..n {
        if wins[pile] {
            continue;
        }
        let mut k = 1;
        while pile + k * k <= n {
            wins[pile + k * k] = true;
            k += 1;
        }
    }
    wins[n]
}

// ---- stones_iter.kara: take_while and any
fn iter_arm(n: i64) -> bool {
    let mut wins: Vec[bool] = Vec.new();
    for pile in 0..n + 1 {
        let win = (1..).map(|k| k * k).take_while(|s| s <= pile).any(|s| not wins[pile - s]);
        wins.push(win);
    }
    wins[n]
}

// ---- the statement read literally ----------------------------------------

// The player to move wins if some move leaves the other player a pile on
// which the player to move loses; with no stones there is no move.
fn literal(n: i64) -> bool {
    let mut k = 1;
    while k * k <= n {
        if not literal(n - k * k) {
            return true;
        }
        k += 1;
    }
    false
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn arm(k: i64, n: i64) -> bool {
    if k == 0 {
        star_arm(n)
    } else if k == 1 {
        push_arm(n)
    } else {
        iter_arm(n)
    }
}

fn arm_name(k: i64) -> String {
    ["star", "push", "iter"][k].to_string()
}

fn main() {
    let arms = 3;
    let problems = 2000;
    let mut seed = 15100;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first
        let n = next_random(mut seed) % 24 + 1;
        let root = next_random(mut seed) % 9 + 1;
        let up = next_random(mut seed) % 5 + 1;

        let truth = literal(n);
        let mut answers: Vec[bool] = Vec.new();
        for k in 0..arms {
            let answer = arm(k, n);
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            if not arm(k, root * root) {
                fails[2] += 1;
            }
            if not answer and not arm(k, n + up * up) {
                fails[3] += 1;
            }
            let mut to_losing = false;
            let mut s = 1;
            while s * s <= n {
                if not arm(k, n - s * s) {
                    to_losing = true;
                }
                s += 1;
            }
            if answer and not to_losing {
                fails[4] += 1;
            }
            if not answer and to_losing {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(k)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for k in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != k and answers[other] == answers[k] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 1 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, if answers[0] { n } else { 0 });
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
