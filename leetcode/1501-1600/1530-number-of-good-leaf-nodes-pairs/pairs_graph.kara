// LeetCode #1530: Number of Good Leaf Nodes Pairs -- the tree as an
// undirected graph: nodes numbered in a walk, each joined to its parent
// and children. From every leaf a breadth-first search out to the
// distance counts the other leaves it reaches; each pair is found from
// both ends, so the total is halved. O(L n).

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

// numbers the nodes under `node` in walk order, joining each to `parent`
fn number(node: Option[TreeNode], parent: i64, adj: mut ref Vec[Vec[i64]], leaf: mut ref Vec[bool]) {
    if let Some(n) = node {
        let me = adj.len();
        adj.push(Vec.new());
        leaf.push(n.left.is_none() and n.right.is_none());
        if parent >= 0 {
            adj[parent].push(me);
            adj[me].push(parent);
        }
        number(n.left, me, mut adj, mut leaf);
        number(n.right, me, mut adj, mut leaf);
    }
}

fn count_pairs(root: TreeNode, distance: i64) -> i64 {
    let mut adj: Vec[Vec[i64]] = Vec.new();
    let mut leaf: Vec[bool] = Vec.new();
    number(Some(root), -1, mut adj, mut leaf);
    let n = adj.len();
    let mut found = 0;
    let mut seen: Vec[i64] = Vec.filled(n, -1);
    for start in 0..n {
        if not leaf[start] {
            continue;
        }
        let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
        queue.push_back((start, 0));
        seen[start] = start;
        while let Some((at, d)) = queue.pop_front() {
            if at != start and leaf[at] {
                found += 1;
            }
            if d == distance {
                continue;
            }
            for next in adj[at].iter() {
                if seen[next] != start {
                    seen[next] = start;
                    queue.push_back((next, d + 1));
                }
            }
        }
    }
    found / 2
}

// ---- the harness: the same in every arm --------------------------------

// A node and the subtrees under it, from a table of child places (-1 for
// none), built leaves first since a node holds its children.
fn make(at: i64, vals: Vec[i64], left: Vec[i64], right: Vec[i64]) -> Option[TreeNode] {
    if at < 0 {
        return None;
    }
    Some(TreeNode {
        val: vals[at],
        left: make(left[at], vals, left, right),
        right: make(right[at], vals, left, right),
    })
}

// A tree from LeetCode's level order, 0 standing for null: each node
// present takes the next two tokens as its children.
fn from_level_order(tokens: Vec[i64]) -> TreeNode {
    let mut vals: Vec[i64] = Vec.new();
    let mut place: Vec[i64] = Vec.new();
    for t in tokens.iter() {
        place.push(if t == 0 { -1 } else { vals.len() });
        if t != 0 {
            vals.push(t);
        }
    }
    let mut left: Vec[i64] = Vec.filled(vals.len(), -1);
    let mut right: Vec[i64] = Vec.filled(vals.len(), -1);
    let mut next = 1;
    for i in 0..tokens.len() {
        if place[i] >= 0 {
            if next < tokens.len() {
                left[place[i]] = place[next];
            }
            if next + 1 < tokens.len() {
                right[place[i]] = place[next + 1];
            }
            next += 2;
        }
    }
    make(0, vals, left, right).unwrap()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// 1 to `most` nodes: each new one walks down from a random node, a random
// way at each step, to the first free place.
fn random_tree(most: i64, seed: mut ref i64) -> TreeNode {
    let n = next_random(mut seed) % most + 1;
    let mut vals: Vec[i64] = Vec.new();
    let mut left: Vec[i64] = Vec.new();
    let mut right: Vec[i64] = Vec.new();
    for i in 0..n {
        vals.push(next_random(mut seed) % 100 + 1);
        left.push(-1);
        right.push(-1);
        if i > 0 {
            let mut at = next_random(mut seed) % i;
            loop {
                if next_random(mut seed) % 2 == 0 {
                    if left[at] < 0 {
                        left[at] = i;
                        break;
                    }
                    at = left[at];
                } else {
                    if right[at] < 0 {
                        right[at] = i;
                        break;
                    }
                    at = right[at];
                }
            }
        }
    }
    make(0, vals, left, right).unwrap()
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let root = random_tree(most, mut seed);
        let distance = next_random(mut seed) % 10 + 1;
        check = mix(check, count_pairs(root, distance));
    }
    println(f"{count} trees of 1 to {most} nodes, distance 1 to 10: checksum {check}");
}

fn main() {
    let examples: Vec[(Vec[i64], i64)] = [
        ([1, 2, 3, 0, 4], 3),
        ([1, 2, 3, 4, 5, 6, 7], 3),
        ([7, 1, 4, 6, 0, 5, 3, 0, 0, 0, 0, 0, 2], 3),
        ([100], 1),
        ([1, 1, 1], 2),
        ([1, 1, 1], 1),
    ];
    for (tokens, distance) in examples.iter() {
        let text: Vec[String] = tokens.iter().map(|t| if t == 0 { "null" } else { f"{t}" }).collect();
        println(f"[{text.join(",")}], distance {distance} -> {count_pairs(from_level_order(tokens.clone()), distance)}");
    }
    let mut seed = 1530;
    batch(3000, 12, mut seed);
    batch(300, 1024, mut seed);
}
