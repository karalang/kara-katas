// LeetCode #1530: Number of Good Leaf Nodes Pairs -- the differential.
//
// Four arms against the statement read literally, on 3000 trees of 1 to
// 10 nodes and distances from 1 to 10, with six properties.
//
// P1  the answer is the statement read literally: every shortest path in
//     the tree as a graph, by Floyd-Warshall, and the leaf pairs within
//     the distance counted
// P2  the tree mirrored has the same answer
// P3  the answer does not fall as the distance grows by one, and at
//     twice the node count every pair of leaves is good
// P4  the answer is at least 0, at most the pairs of leaves, and 0 at
//     distance 1
// P5  a new root over the tree and one more leaf adds the tree's leaves
//     within distance - 2 edges of its root
// P6  each arm agrees with at least two of the other three

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

// ---- pairs.kara: the ★ arm: leaf counts by depth, pairs across each node

// counts[i]: the leaves i edges below `node`, for i < distance
fn star_leaves_below(node: Option[TreeNode], distance: i64, pairs: mut ref i64) -> Vec[i64] {
    let mut counts: Vec[i64] = Vec.filled(distance, 0);
    if let Some(n) = node {
        if n.left.is_none() and n.right.is_none() {
            counts[0] = 1;
        } else {
            let l = star_leaves_below(n.left, distance, mut pairs);
            let r = star_leaves_below(n.right, distance, mut pairs);
            // a leaf i below the left child and one j below the right are
            // i + 1 + j + 1 edges apart
            for i in 0..distance {
                for j in 0..distance - i - 1 {
                    *pairs += l[i] * r[j];
                }
            }
            for i in 0..distance - 1 {
                counts[i + 1] = l[i] + r[i];
            }
        }
    }
    counts
}

fn star_arm(root: TreeNode, distance: i64) -> i64 {
    let mut pairs = 0;
    star_leaves_below(Some(root), distance, mut pairs);
    pairs
}

// ---- pairs_paths.kara: each leaf's path, every pair measured

fn leaf_paths(node: Option[TreeNode], path: mut ref Vec[i64], out: mut ref Vec[Vec[i64]]) {
    if let Some(n) = node {
        if n.left.is_none() and n.right.is_none() {
            out.push(path.clone());
            return;
        }
        path.push(0);
        leaf_paths(n.left, mut path, mut out);
        path.pop();
        path.push(1);
        leaf_paths(n.right, mut path, mut out);
        path.pop();
    }
}

fn paths_arm(root: TreeNode, distance: i64) -> i64 {
    let mut leaves: Vec[Vec[i64]] = Vec.new();
    let mut path: Vec[i64] = Vec.new();
    leaf_paths(Some(root), mut path, mut leaves);
    let mut pairs = 0;
    for a in 0..leaves.len() {
        for b in a + 1..leaves.len() {
            let mut common = 0;
            while common < leaves[a].len() and common < leaves[b].len() and leaves[a][common] == leaves[b][common] {
                common += 1;
            }
            if leaves[a].len() + leaves[b].len() - 2 * common <= distance {
                pairs += 1;
            }
        }
    }
    pairs
}

// ---- pairs_graph.kara: a breadth-first search from every leaf

// numbers the nodes under `node` in walk order, joining each to `parent`
fn number_nodes(node: Option[TreeNode], parent: i64, adj: mut ref Vec[Vec[i64]], leaf: mut ref Vec[bool]) {
    if let Some(n) = node {
        let me = adj.len();
        adj.push(Vec.new());
        leaf.push(n.left.is_none() and n.right.is_none());
        if parent >= 0 {
            adj[parent].push(me);
            adj[me].push(parent);
        }
        number_nodes(n.left, me, mut adj, mut leaf);
        number_nodes(n.right, me, mut adj, mut leaf);
    }
}

fn graph_arm(root: TreeNode, distance: i64) -> i64 {
    let mut adj: Vec[Vec[i64]] = Vec.new();
    let mut leaf: Vec[bool] = Vec.new();
    number_nodes(Some(root), -1, mut adj, mut leaf);
    let n = adj.len();
    let mut found = 0;
    let mut seen: Vec[i64] = Vec.filled(n, -1);
    for start in 0..n {
        if not leaf[start] {
            continue;
        }
        let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
        queue.push_back((start, 0));
        seen[start] = start;
        while let Some((at, d)) = queue.pop_front() {
            if at != start and leaf[at] {
                found += 1;
            }
            if d == distance {
                continue;
            }
            for next in adj[at].iter() {
                if seen[next] != start {
                    seen[next] = start;
                    queue.push_back((next, d + 1));
                }
            }
        }
    }
    found / 2
}

// ---- pairs_iter.kara: the ★ arm with iterator adapters

fn iter_leaves_below(node: Option[TreeNode], distance: i64, pairs: mut ref i64) -> Vec[i64] {
    match node {
        None => Vec.filled(distance, 0),
        Some(n) => {
            if n.left.is_none() and n.right.is_none() {
                once(1).chain(repeat(0).take(distance - 1)).collect()
            } else {
                let l = iter_leaves_below(n.left, distance, mut pairs);
                let r = iter_leaves_below(n.right, distance, mut pairs);
                *pairs += l.iter()
                    .enumerate()
                    .map(|(i, a)| a * r.iter().take((distance - i - 1).max(0)).sum())
                    .sum();
                once(0).chain(l.iter().zip(r.iter()).map(|(a, b)| a + b)).take(distance).collect()
            }
        }
    }
}

fn iter_arm(root: TreeNode, distance: i64) -> i64 {
    let mut pairs = 0;
    iter_leaves_below(Some(root), distance, mut pairs);
    pairs
}

// ---- the statement read literally -----------------------------------------

// the tree as edges between numbered nodes, and which nodes are leaves
fn edges(node: Option[TreeNode], parent: i64, links: mut ref Vec[(i64, i64)], leaf: mut ref Vec[bool]) {
    if let Some(n) = node {
        let me = leaf.len();
        leaf.push(n.left.is_none() and n.right.is_none());
        if parent >= 0 {
            links.push((parent, me));
        }
        edges(n.left, me, mut links, mut leaf);
        edges(n.right, me, mut links, mut leaf);
    }
}

// "A pair of two different leaf nodes is good if the length of the
// shortest path between them is less than or equal to distance": every
// shortest path by Floyd-Warshall, then every pair of leaves asked.
fn literal(root: TreeNode, distance: i64) -> i64 {
    let mut links: Vec[(i64, i64)] = Vec.new();
    let mut leaf: Vec[bool] = Vec.new();
    edges(Some(root), -1, mut links, mut leaf);
    let n = leaf.len();
    let far = n + 1;
    let mut dist: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(n, far));
    for i in 0..n {
        dist[i][i] = 0;
    }
    for (a, b) in links.iter() {
        dist[a][b] = 1;
        dist[b][a] = 1;
    }
    for k in 0..n {
        for i in 0..n {
            for j in 0..n {
                if dist[i][k] + dist[k][j] < dist[i][j] {
                    dist[i][j] = dist[i][k] + dist[k][j];
                }
            }
        }
    }
    let mut good = 0;
    for i in 0..n {
        for j in i + 1..n {
            if leaf[i] and leaf[j] and dist[i][j] <= distance {
                good += 1;
            }
        }
    }
    good
}

// ---- the differential -----------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn make(at: i64, vals: Vec[i64], left: Vec[i64], right: Vec[i64]) -> Option[TreeNode] {
    if at < 0 {
        return None;
    }
    Some(TreeNode {
        val: vals[at],
        left: make(left[at], vals, left, right),
        right: make(right[at], vals, left, right),
    })
}

fn mirrored(node: Option[TreeNode]) -> Option[TreeNode] {
    match node {
        Some(n) => Some(TreeNode { val: n.val, left: mirrored(n.right), right: mirrored(n.left) }),
        None => None,
    }
}

// the depth of every leaf under `node`, which is `depth` edges down
fn leaf_depths(node: Option[TreeNode], depth: i64, out: mut ref Vec[i64]) {
    if let Some(n) = node {
        if n.left.is_none() and n.right.is_none() {
            out.push(depth);
        }
        leaf_depths(n.left, depth + 1, mut out);
        leaf_depths(n.right, depth + 1, mut out);
    }
}

fn arm(k: i64, root: TreeNode, distance: i64) -> i64 {
    if k == 0 {
        star_arm(root, distance)
    } else if k == 1 {
        paths_arm(root, distance)
    } else if k == 2 {
        graph_arm(root, distance)
    } else {
        iter_arm(root, distance)
    }
}

fn arm_name(k: i64) -> String {
    ["star", "paths", "graph", "iter"][k].to_string()
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15300;
    let mut check = 0;
    let mut checks = 0;
    let mut by_property: Vec[i64] = Vec.filled(7, 0);
    let mut shown = 0;
    for p in 0..problems {
        // everything random is drawn first
        let n = next_random(mut seed) % 10 + 1;
        let mut vals: Vec[i64] = Vec.new();
        let mut left: Vec[i64] = Vec.new();
        let mut right: Vec[i64] = Vec.new();
        for i in 0..n {
            vals.push(next_random(mut seed) % 100 + 1);
            left.push(-1);
            right.push(-1);
            if i > 0 {
                let mut at = next_random(mut seed) % i;
                loop {
                    if next_random(mut seed) % 2 == 0 {
                        if left[at] < 0 {
                            left[at] = i;
                            break;
                        }
                        at = left[at];
                    } else {
                        if right[at] < 0 {
                            right[at] = i;
                            break;
                        }
                        at = right[at];
                    }
                }
            }
        }
        let distance = next_random(mut seed) % 10 + 1;
        let root = make(0, vals, left, right).unwrap();
        let mirror = mirrored(Some(root)).unwrap();
        let mut depths: Vec[i64] = Vec.new();
        leaf_depths(Some(root), 0, mut depths);
        let leaves = depths.len();
        let near = depths.iter().filter(|d| d <= distance - 2).count();
        let lifted = TreeNode {
            val: 1,
            left: Some(root),
            right: Some(TreeNode { val: 1, left: None, right: None }),
        };
        let truth = literal(root, distance);
        let mut answers: Vec[i64] = Vec.new();
        for k in 0..arms {
            let answer = arm(k, root, distance);
            let mut fails: Vec[i64] = Vec.filled(7, 0);
            if answer != truth {
                fails[1] += 1;
            }
            if arm(k, mirror, distance) != answer {
                fails[2] += 1;
            }
            if arm(k, root, distance + 1) < answer or arm(k, root, 2 * n) != leaves * (leaves - 1) / 2 {
                fails[3] += 1;
            }
            if answer < 0 or answer > leaves * (leaves - 1) / 2 or arm(k, root, 1) != 0 {
                fails[4] += 1;
            }
            if arm(k, lifted, distance) != answer + near {
                fails[5] += 1;
            }
            answers.push(answer);
            for q in 1..6 {
                checks += 1;
                if fails[q] > 0 {
                    by_property[q] += 1;
                    if shown < 10 {
                        println(f"problem {p}, {arm_name(k)}: P{q}");
                        shown += 1;
                    }
                }
            }
        }
        for k in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != k and answers[other] == answers[k] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                by_property[6] += 1;
                if shown < 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                    shown += 1;
                }
            }
        }
        check = mix(check, truth);
    }
    let failures = by_property.iter().sum();
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
    if failures > 0 {
        for q in 1..7 {
            if by_property[q] > 0 {
                println(f"P{q}: {by_property[q]}");
            }
        }
    }
}
