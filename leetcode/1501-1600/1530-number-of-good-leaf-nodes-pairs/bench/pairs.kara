// LeetCode #1530: Number of Good Leaf Nodes Pairs -- bench: the ★ arm
// over 1000 random trees of 1 to 1024 nodes, built once and answered 10
// times, each with its own distance from 1 to 10.

shared struct TreeNode {
    mut val: i64,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

// counts[i]: the leaves i edges below `node`, for i < distance
fn leaves_below(node: Option[TreeNode], distance: i64, pairs: mut ref i64) -> Vec[i64] {
    let mut counts: Vec[i64] = Vec.filled(distance, 0);
    if let Some(n) = node {
        if n.left.is_none() and n.right.is_none() {
            counts[0] = 1;
        } else {
            let l = leaves_below(n.left, distance, mut pairs);
            let r = leaves_below(n.right, distance, mut pairs);
            // a leaf i below the left child and one j below the right are
            // i + 1 + j + 1 edges apart
            for i in 0..distance {
                for j in 0..distance - i - 1 {
                    *pairs += l[i] * r[j];
                }
            }
            for i in 0..distance - 1 {
                counts[i + 1] = l[i] + r[i];
            }
        }
    }
    counts
}

fn count_pairs(root: TreeNode, distance: i64) -> i64 {
    let mut pairs = 0;
    leaves_below(Some(root), distance, mut pairs);
    pairs
}

fn make(at: i64, vals: Vec[i64], left: Vec[i64], right: Vec[i64]) -> Option[TreeNode] {
    if at < 0 {
        return None;
    }
    Some(TreeNode {
        val: vals[at],
        left: make(left[at], vals, left, right),
        right: make(right[at], vals, left, right),
    })
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn random_tree(most: i64, seed: mut ref i64) -> TreeNode {
    let n = next_random(mut seed) % most + 1;
    let mut vals: Vec[i64] = Vec.new();
    let mut left: Vec[i64] = Vec.new();
    let mut right: Vec[i64] = Vec.new();
    for i in 0..n {
        vals.push(next_random(mut seed) % 100 + 1);
        left.push(-1);
        right.push(-1);
        if i > 0 {
            let mut at = next_random(mut seed) % i;
            loop {
                if next_random(mut seed) % 2 == 0 {
                    if left[at] < 0 {
                        left[at] = i;
                        break;
                    }
                    at = left[at];
                } else {
                    if right[at] < 0 {
                        right[at] = i;
                        break;
                    }
                    at = right[at];
                }
            }
        }
    }
    make(0, vals, left, right).unwrap()
}

fn main() {
    let mut seed = 1530;
    let mut trees: Vec[(TreeNode, i64)] = Vec.new();
    for _ in 0..1000 {
        let root = random_tree(1024, mut seed);
        trees.push((root, next_random(mut seed) % 10 + 1));
    }
    let mut check = 0;
    for _ in 0..10 {
        for (root, distance) in trees.iter() {
            check = mix(check, count_pairs(root, distance));
        }
    }
    println(f"10 passes over 1000 trees of up to 1024 nodes: checksum {check}");
}
