// LeetCode #1573: Number of Ways to Split a String -- one pass over the
// cut points: the first cut is good where the ones so far are t/3, and a
// second cut where they are 2t/3 pairs with every good first cut before
// it. No special case for a string of zeros, where t/3 and 2t/3 are both 0.
// O(n)

fn num_ways(s: String) -> i64 {
    let m = 1000000007;
    let bits: Vec[char] = s.chars().collect();
    let t = bits.iter().filter(|c| c == '1').count();
    if t % 3 != 0 {
        return 0;
    }
    let k = t / 3;
    let mut seen = 0;
    let mut firsts = 0;
    let mut ways = 0;
    for i in 0..bits.len() - 1 {
        if bits[i] == '1' {
            seen += 1;
        }
        if seen == 2 * k {
            ways = (ways + firsts) % m;
        }
        if seen == k {
            firsts += 1;
        }
    }
    ways
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 3 to `most` characters, each with its own odds of a
// '1', from 1 in 1 to 1 in `sparse`
fn batch(count: i64, most: i64, sparse: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most - 2) + 3;
        let odds = next_random(mut seed) % sparse + 1;
        let s: String = (0..n).map(|_| if next_random(mut seed) % odds == 0 { '1' } else { '0' }).collect();
        let ways = num_ways(s);
        total += ways;
        check = mix(check, ways);
    }
    println(f"{count} strings of up to {most} characters: ways total {total}, checksum {check}");
}

fn main() {
    let examples = ["10101", "1001", "0000", "100100010100110", "111", "000", "1101010", "1001001"];
    for s in examples.iter() {
        println(f"{s} -> {num_ways(s)}");
    }
    let mut seed = 1573;
    batch(3000, 12, 3, mut seed);
    batch(300, 1000, 10, mut seed);
    batch(30, 100000, 100, mut seed);
    let zeros: String = (0..100000).map(|_| '0').collect();
    println(f"100000 zeros -> {num_ways(zeros)}");
}
