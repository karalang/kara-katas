// LeetCode #1573: Number of Ways to Split a String -- the differential.
//
// Four arms against the statement read literally, on 3000 strings of 3 to
// 12 characters, each with its own odds of a '1', with six properties.
// Every random choice is drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the string reversed leaves the answer
// P3  every '1' written twice leaves the answer
// P4  the answer is at most (n - 1)(n - 2) / 2, exactly that when there is no '1'
// P5  a '0' put in front leaves the answer when there is a '1', and gives
//     n(n - 1) / 2 when there is none
// P6  each arm agrees with at least two of the other three

// ---- split.kara: the ★ arm: the two gaps between the ones multiplied

fn star_arm(s: String) -> i64 {
    let m = 1000000007;
    let ones: Vec[i64] = s.chars().enumerate().filter(|(_, c)| c == '1').map(|(i, _)| i).collect();
    let n = s.len();
    let t = ones.len();
    if t == 0 {
        return (n - 1) * (n - 2) / 2 % m;
    }
    if t % 3 != 0 {
        return 0;
    }
    let k = t / 3;
    (ones[k] - ones[k - 1]) * (ones[2 * k] - ones[2 * k - 1]) % m
}

// ---- split_cuts.kara: one pass over the cut points

fn cuts_arm(s: String) -> i64 {
    let m = 1000000007;
    let bits: Vec[char] = s.chars().collect();
    let t = bits.iter().filter(|c| c == '1').count();
    if t % 3 != 0 {
        return 0;
    }
    let k = t / 3;
    let mut seen = 0;
    let mut firsts = 0;
    let mut ways = 0;
    for i in 0..bits.len() - 1 {
        if bits[i] == '1' {
            seen += 1;
        }
        if seen == 2 * k {
            ways = (ways + firsts) % m;
        }
        if seen == k {
            firsts += 1;
        }
    }
    ways
}

// ---- split_runs.kara: the runs of zeros between the ones

fn runs_arm(s: String) -> i64 {
    let m = 1000000007;
    let runs: Vec[String] = s.split("1").map(|r| r.to_string()).collect();
    let t = runs.len() - 1;
    let n = s.len();
    if t == 0 {
        return (n - 1) * (n - 2) / 2 % m;
    }
    if t % 3 != 0 {
        return 0;
    }
    let k = t / 3;
    (runs[k].len() + 1) * (runs[2 * k].len() + 1) % m
}

// ---- split_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn num_ways(s: String) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let b = s.bytes();
        let n = b.len();
        let total = b.iter().filter(|c| c == b'1').count();
        if total == 0 {
            return ((n - 1) * (n - 2) / 2 % MOD) as i32;
        }
        if total % 3 != 0 {
            return 0;
        }
        let k = total / 3;
        let mut (first, second) = (0, 0);
        let mut ones = 0;
        for c in b {
            if c == b'1' {
                ones += 1;
            } else if ones == k {
                first += 1;
            } else if ones == 2 * k {
                second += 1;
            }
        }
        ((first + 1) * (second + 1) % MOD) as i32
    }
}

fn solution_arm(s: String) -> i64 {
    Solution.num_ways(s)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, s: String) -> i64 {
    match a {
        0 => star_arm(s),
        1 => cuts_arm(s),
        2 => runs_arm(s),
        _ => solution_arm(s),
    }
}

fn arm_name(a: i64) -> String {
    ["split", "cuts", "runs", "solution"][a].to_string()
}

// ---- the statement read literally: every pair of cuts tried, the three
// non-empty parts counted for ones, the pairs that leave them equal counted

fn literal(s: String) -> i64 {
    let bits: Vec[char] = s.chars().collect();
    let n = bits.len();
    let ones = |from: i64, to: i64| bits[from..to].iter().filter(|c| c == '1').count();
    let mut ways = 0;
    for i in 1..n - 1 {
        for j in i + 1..n {
            let (a, b, c) = (ones(0, i), ones(i, j), ones(j, n));
            if a == b and b == c {
                ways += 1;
            }
        }
    }
    ways
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 15730;
    let mut cases: Vec[String] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 10 + 3;
        let odds = next_random(mut seed) % 3 + 1;
        let s: String = (0..n).map(|_| if next_random(mut seed) % odds == 0 { '1' } else { '0' }).collect();
        cases.push(s);
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for (p, s) in cases.iter().enumerate() {
        let n = s.len();
        let truth = literal(s);
        let has_one = s.contains("1");
        let reversed: String = s.chars().rev().collect();
        let doubled = s.replace("1", "11");
        let padded = f"0{s}";
        let most = (n - 1) * (n - 2) / 2;
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, s);
            answers.push(answer);
            check = (check * 31 + answer + 1) % 1000000007;
            let failed = [
                answer != truth,
                arm(a, reversed) != answer,
                arm(a, doubled) != answer,
                answer > most or (not has_one and answer != most),
                arm(a, padded) != (if has_one { answer } else { n * (n - 1) / 2 }),
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
