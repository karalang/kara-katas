// LeetCode #1573: Number of Ways to Split a String -- the ★ arm: with t
// ones in all, each part holds t / 3. The first cut can fall anywhere in
// the run of zeros after the (t/3)-th one, and the second anywhere in the
// run after the (2t/3)-th, so the answer is the product of the two gaps.
// With no ones, every pair of the n - 1 cut points works. O(n)

fn num_ways(s: String) -> i64 {
    let m = 1000000007;
    let ones: Vec[i64] = s.chars().enumerate().filter(|(_, c)| c == '1').map(|(i, _)| i).collect();
    let n = s.len();
    let t = ones.len();
    if t == 0 {
        return (n - 1) * (n - 2) / 2 % m;
    }
    if t % 3 != 0 {
        return 0;
    }
    let k = t / 3;
    (ones[k] - ones[k - 1]) * (ones[2 * k] - ones[2 * k - 1]) % m
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 3 to `most` characters, each with its own odds of a
// '1', from 1 in 1 to 1 in `sparse`
fn batch(count: i64, most: i64, sparse: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most - 2) + 3;
        let odds = next_random(mut seed) % sparse + 1;
        let s: String = (0..n).map(|_| if next_random(mut seed) % odds == 0 { '1' } else { '0' }).collect();
        let ways = num_ways(s);
        total += ways;
        check = mix(check, ways);
    }
    println(f"{count} strings of up to {most} characters: ways total {total}, checksum {check}");
}

fn main() {
    let examples = ["10101", "1001", "0000", "100100010100110", "111", "000", "1101010", "1001001"];
    for s in examples.iter() {
        println(f"{s} -> {num_ways(s)}");
    }
    let mut seed = 1573;
    batch(3000, 12, 3, mut seed);
    batch(300, 1000, 10, mut seed);
    batch(30, 100000, 100, mut seed);
    let zeros: String = (0..100000).map(|_| '0').collect();
    println(f"100000 zeros -> {num_ways(zeros)}");
}
