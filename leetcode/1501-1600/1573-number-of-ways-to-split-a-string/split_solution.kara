// LeetCode #1573: Number of Ways to Split a String -- LeetCode's Rust
// template as karac fix left it: the ones counted over the bytes, then the
// zeros after the (t/3)-th and the (2t/3)-th one counted by a second pass,
// over `i64` and returned as `i32`.

struct Solution {}

impl Solution {
    pub fn num_ways(s: String) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let b = s.bytes();
        let n = b.len();
        let total = b.iter().filter(|c| c == b'1').count();
        if total == 0 {
            return ((n - 1) * (n - 2) / 2 % MOD) as i32;
        }
        if total % 3 != 0 {
            return 0;
        }
        let k = total / 3;
        let mut (first, second) = (0, 0);
        let mut ones = 0;
        for c in b {
            if c == b'1' {
                ones += 1;
            } else if ones == k {
                first += 1;
            } else if ones == 2 * k {
                second += 1;
            }
        }
        ((first + 1) * (second + 1) % MOD) as i32
    }
}

fn num_ways(s: String) -> i64 {
    Solution.num_ways(s)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 3 to `most` characters, each with its own odds of a
// '1', from 1 in 1 to 1 in `sparse`
fn batch(count: i64, most: i64, sparse: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most - 2) + 3;
        let odds = next_random(mut seed) % sparse + 1;
        let s: String = (0..n).map(|_| if next_random(mut seed) % odds == 0 { '1' } else { '0' }).collect();
        let ways = num_ways(s);
        total += ways;
        check = mix(check, ways);
    }
    println(f"{count} strings of up to {most} characters: ways total {total}, checksum {check}");
}

fn main() {
    let examples = ["10101", "1001", "0000", "100100010100110", "111", "000", "1101010", "1001001"];
    for s in examples.iter() {
        println(f"{s} -> {num_ways(s)}");
    }
    let mut seed = 1573;
    batch(3000, 12, 3, mut seed);
    batch(300, 1000, 10, mut seed);
    batch(30, 100000, 100, mut seed);
    let zeros: String = (0..100000).map(|_| '0').collect();
    println(f"100000 zeros -> {num_ways(zeros)}");
}
