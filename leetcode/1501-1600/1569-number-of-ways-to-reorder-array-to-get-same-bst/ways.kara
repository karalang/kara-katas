// LeetCode #1569: Number of Ways to Reorder Array to Get Same BST -- the ★
// arm: the first value is the root, and an order gives the same tree
// exactly when it starts with the root and interleaves an order of the
// left subtree's values that gives the same left subtree with one that
// gives the same right one. So the count is the number of ways to
// interleave the two, a binomial from Pascal's triangle, times each side's
// own count, found by recursion on the values filtered to each side.
// O(n^2)

const MOD: i64 = 1000000007;

fn ways(nums: Vec[i64], choose: Vec[Vec[i64]]) -> i64 {
    if nums.len() <= 2 {
        return 1;
    }
    let root = nums[0];
    let left: Vec[i64] = nums.iter().skip(1).filter(|x| x < root).cloned().collect();
    let right: Vec[i64] = nums.iter().skip(1).filter(|x| x > root).cloned().collect();
    choose[nums.len() - 1][left.len()] * ways(left, choose) % MOD * ways(right, choose) % MOD
}

fn num_of_ways(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut choose: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(n + 1, 0));
    for i in 0..=n {
        choose[i][0] = 1;
        for j in 1..=i {
            choose[i][j] = (choose[i - 1][j - 1] + choose[i - 1][j]) % MOD;
        }
    }
    (ways(nums, choose) - 1 + MOD) % MOD
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` permutations of 1 to n, n from 1 to `most`, shuffled by
// Fisher-Yates
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut none = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut nums: Vec[i64] = (1..=n).collect();
        for i in (1..n).rev() {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            nums.swap(i, j);
        }
        let ways = num_of_ways(nums);
        if ways == 0 {
            none += 1;
        }
        check = mix(check, ways);
    }
    println(f"{count} permutations of up to {most} values: {none} with no other order, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[i64]] = [
        [2, 1, 3],
        [3, 4, 5, 1, 2],
        [1, 2, 3],
        [1],
        [3, 1, 2, 5, 4],
        [4, 2, 6, 1, 3, 5, 7],
        [5, 1, 2, 3, 4, 6, 7, 8, 9],
        [10, 5, 15, 3, 7, 12, 18, 1, 4, 6, 8, 11, 13, 17, 19, 2, 9, 14, 16, 20],
    ];
    for nums in examples.iter() {
        println(f"{nums} -> {num_of_ways(nums.clone())}");
    }
    let wide: Vec[i64] = (0..1000).map(|i| if i % 2 == 0 { 500 - i / 2 } else { 501 + i / 2 }).collect();
    println(f"500, 501, 499, 502, .. -> {num_of_ways(wide)}");
    let mut seed = 1569;
    batch(3000, 8, mut seed);
    batch(300, 100, mut seed);
    batch(30, 1000, mut seed);
}
