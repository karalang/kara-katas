// LeetCode #1569: Number of Ways to Reorder Array to Get Same BST -- the
// tree built: each value inserted into an arena of nodes by walking down
// from the root, every subtree's size summed child into parent in reverse
// insertion order, and the count the product over the nodes of the ways to
// interleave its two subtrees, each binomial from factorials and their
// inverses by Fermat. O(n h) for a tree of height h

const MOD: i64 = 1000000007;

struct Node {
    left: Option[i64],
    right: Option[i64],
    parent: i64,
}

fn power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut base = base % MOD;
    let mut exp = exp;
    while exp > 0 {
        if exp % 2 == 1 {
            result = result * base % MOD;
        }
        base = base * base % MOD;
        exp /= 2;
    }
    result
}

fn num_of_ways(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut nodes: Vec[Node] = [Node { left: None, right: None, parent: -1 }];
    for i in 1..n {
        let mut at = 0;
        loop {
            let next = if nums[i] < nums[at] { nodes[at].left } else { nodes[at].right };
            match next {
                Some(child) => at = child,
                None => break,
            }
        }
        if nums[i] < nums[at] {
            nodes[at].left = Some(i);
        } else {
            nodes[at].right = Some(i);
        }
        nodes.push(Node { left: None, right: None, parent: at });
    }
    let mut size: Vec[i64] = Vec.filled(n, 1);
    for i in (1..n).rev() {
        size[nodes[i].parent] += size[i];
    }
    let mut factorial: Vec[i64] = Vec.filled(n + 1, 1);
    for i in 1..=n {
        factorial[i] = factorial[i - 1] * i % MOD;
    }
    let inverse: Vec[i64] = factorial.iter().map(|f| power(f, MOD - 2)).collect();
    let mut ways = 1;
    for i in 0..n {
        let left = match nodes[i].left {
            Some(l) => size[l],
            None => 0,
        };
        let below = size[i] - 1;
        ways = ways * factorial[below] % MOD * inverse[left] % MOD * inverse[below - left] % MOD;
    }
    (ways - 1 + MOD) % MOD
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` permutations of 1 to n, n from 1 to `most`, shuffled by
// Fisher-Yates
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut none = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut nums: Vec[i64] = (1..=n).collect();
        for i in (1..n).rev() {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            nums.swap(i, j);
        }
        let ways = num_of_ways(nums);
        if ways == 0 {
            none += 1;
        }
        check = mix(check, ways);
    }
    println(f"{count} permutations of up to {most} values: {none} with no other order, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[i64]] = [
        [2, 1, 3],
        [3, 4, 5, 1, 2],
        [1, 2, 3],
        [1],
        [3, 1, 2, 5, 4],
        [4, 2, 6, 1, 3, 5, 7],
        [5, 1, 2, 3, 4, 6, 7, 8, 9],
        [10, 5, 15, 3, 7, 12, 18, 1, 4, 6, 8, 11, 13, 17, 19, 2, 9, 14, 16, 20],
    ];
    for nums in examples.iter() {
        println(f"{nums} -> {num_of_ways(nums.clone())}");
    }
    let wide: Vec[i64] = (0..1000).map(|i| if i % 2 == 0 { 500 - i / 2 } else { 501 + i / 2 }).collect();
    println(f"500, 501, 499, 502, .. -> {num_of_ways(wide)}");
    let mut seed = 1569;
    batch(3000, 8, mut seed);
    batch(300, 100, mut seed);
    batch(30, 1000, mut seed);
}
