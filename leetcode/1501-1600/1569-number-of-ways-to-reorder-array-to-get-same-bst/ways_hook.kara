// LeetCode #1569: Number of Ways to Reorder Array to Get Same BST -- the
// hook length formula for trees: the orders that give a tree are its
// orderings with every node before its subtree, n! over the product of the
// subtree sizes. The tree is never built: a value's parent is whichever
// of its neighbours among the values before it, the next smaller or the
// next larger in a `SortedMap`, came later. O(n log n)

const MOD: i64 = 1000000007;

fn power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut base = base % MOD;
    let mut exp = exp;
    while exp > 0 {
        if exp % 2 == 1 {
            result = result * base % MOD;
        }
        base = base * base % MOD;
        exp /= 2;
    }
    result
}

fn num_of_ways(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut seen: SortedMap[i64, i64] = SortedMap.new();
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    for (i, x) in nums.iter().enumerate() {
        let below = seen.range(i64.MIN, x).next_back().map(|(_, at)| at);
        let above = seen.range_inclusive(x + 1, i64.MAX).next().map(|(_, at)| at);
        parent[i] = match (below, above) {
            (Some(a), Some(b)) => a.max(b),
            (Some(a), None) => a,
            (None, Some(b)) => b,
            (None, None) => -1,
        };
        seen.insert(x, i);
    }
    let mut size: Vec[i64] = Vec.filled(n, 1);
    for i in (1..n).rev() {
        size[parent[i]] += size[i];
    }
    let mut ways = 1;
    for i in 1..=n {
        ways = ways * i % MOD;
    }
    for s in size.iter() {
        ways = ways * power(s, MOD - 2) % MOD;
    }
    (ways - 1 + MOD) % MOD
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` permutations of 1 to n, n from 1 to `most`, shuffled by
// Fisher-Yates
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut none = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut nums: Vec[i64] = (1..=n).collect();
        for i in (1..n).rev() {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            nums.swap(i, j);
        }
        let ways = num_of_ways(nums);
        if ways == 0 {
            none += 1;
        }
        check = mix(check, ways);
    }
    println(f"{count} permutations of up to {most} values: {none} with no other order, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[i64]] = [
        [2, 1, 3],
        [3, 4, 5, 1, 2],
        [1, 2, 3],
        [1],
        [3, 1, 2, 5, 4],
        [4, 2, 6, 1, 3, 5, 7],
        [5, 1, 2, 3, 4, 6, 7, 8, 9],
        [10, 5, 15, 3, 7, 12, 18, 1, 4, 6, 8, 11, 13, 17, 19, 2, 9, 14, 16, 20],
    ];
    for nums in examples.iter() {
        println(f"{nums} -> {num_of_ways(nums.clone())}");
    }
    let wide: Vec[i64] = (0..1000).map(|i| if i % 2 == 0 { 500 - i / 2 } else { 501 + i / 2 }).collect();
    println(f"500, 501, 499, 502, .. -> {num_of_ways(wide)}");
    let mut seed = 1569;
    batch(3000, 8, mut seed);
    batch(300, 100, mut seed);
    batch(30, 1000, mut seed);
}
