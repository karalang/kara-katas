// LeetCode #1558: Minimum Numbers of Function Calls to Make Target Array --
// the calls run backwards from the target: an odd value can only have
// come from an increment, so every odd value is decremented, one call
// each; then, while anything is left, everything is halved in one call.
// O(n log max)

fn min_operations(nums: Vec[i64]) -> i64 {
    let mut values = nums.clone();
    let mut calls = 0;
    loop {
        for i in 0..values.len() {
            if values[i] % 2 == 1 {
                values[i] -= 1;
                calls += 1;
            }
        }
        if values.iter().all(|v| v == 0) {
            return calls;
        }
        for i in 0..values.len() {
            values[i] /= 2;
        }
        calls += 1;
    }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` arrays of 1 to `longest` values from 0 to `most`
fn batch(count: i64, longest: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let length = (next_random(mut seed) * 32768 + next_random(mut seed)) % longest + 1;
        let mut nums = Vec.new();
        for _ in 0..length {
            let wide = (next_random(mut seed) * 32768 + next_random(mut seed)) * 32768 + next_random(mut seed);
            nums.push(wide % (most + 1));
        }
        let calls = min_operations(nums);
        total += calls;
        check = mix(check, calls);
    }
    println(f"{count} arrays of up to {longest} values up to {most}: {total} calls, checksum {check}");
}

fn main() {
    let examples: Vec[Vec[i64]] = [
        [1, 5],
        [2, 2],
        [4, 2, 5],
        [3, 2, 2, 4],
        [2, 4, 8, 16],
        [0],
        [0, 0, 1],
        [1000000000],
        [1000000000, 999999999, 1],
    ];
    for nums in examples.iter() {
        println(f"{nums} -> {min_operations(nums.clone())}");
    }
    let mut seed = 1558;
    batch(3000, 8, 30, mut seed);
    batch(300, 1000, 1000000000, mut seed);
    batch(30, 100000, 1000000000, mut seed);
}
