// LeetCode 275 — counting buckets, which never look at the order.
//
// O(n) time and O(n) space, and — the reason it earns a place here — it USES NO
// SORTEDNESS AT ALL. The other two solvers are built on the array being
// non-decreasing: one binary-searches a predicate that is only monotone because
// of it, the other stops at the first failure because of it. If that assumption
// were ever violated — a generator bug, a caller that forgot — both would agree
// on a wrong answer and the harness would report nothing.
//
// This one would not. It is #274's algorithm, which was written for UNSORTED
// input, and it is here as the third MECHANISM rather than a third
// implementation: 270 established that two solvers sharing a decision procedure
// agree perfectly while both are wrong, and 272 measured it — breaking both
// structural solvers there scored exactly what breaking either alone scored.
//
// THE BUCKET CAP IS THE WHOLE TRICK. A paper with 10,000 citations is no more
// useful than one with `n`, because the h-index can never exceed the number of
// papers. So every count is clamped to `n` and the histogram needs only `n + 1`
// slots regardless of how large the citations are. Without the clamp this
// allocates proportional to the largest citation count, which the constraints
// put at 1,000.
//
// THEN SWEEP DOWNWARD, accumulating. After processing bucket `h`, `total` is
// the number of papers with AT LEAST `h` citations, so the first `h` where
// `total >= h` is the answer — and it is the largest such `h` because the sweep
// starts at `n`.

fn h_index(citations: ref Vec[i64]) -> i64 {
    let n = citations.len();
    let mut buckets: Vec[i64] = Vec.new();
    let mut b = 0i64;
    while b <= n {
        buckets.push(0i64);
        b = b + 1i64;
    }
    let mut i = 0i64;
    while i < n {
        let mut c = citations[i];
        if c > n { c = n; }              // more citations than papers helps no further
        buckets[c] = buckets[c] + 1i64;
        i = i + 1i64;
    }
    let mut total = 0i64;
    let mut h = n;
    while h >= 0i64 {
        total = total + buckets[h];      // papers with AT LEAST h citations
        if total >= h {
            return h;
        }
        h = h - 1i64;
    }
    return 0i64;
}

fn show(xs: ref Vec[i64]) -> String {
    let mut s = "[";
    let mut i = 0i64;
    while i < xs.len() {
        if i > 0i64 { s = s + ","; }
        s = s + f"{xs[i]}";
        i = i + 1i64;
    }
    return s + "]";
}

fn main() {
    let cases: Vec[Vec[i64]] = [
        [0i64, 1i64, 3i64, 5i64, 6i64],
        [1i64, 2i64, 100i64],
        [0i64],
        [100i64],
        [0i64, 0i64, 0i64],
        [5i64, 5i64, 5i64],
        [0i64, 0i64, 4i64, 4i64],
        [1i64, 1i64, 1i64, 1i64, 1i64],
        [0i64, 1i64, 2i64, 3i64, 4i64],
    ];
    let mut i = 0i64;
    while i < cases.len() {
        println(f"{show(cases[i])} -> {h_index(cases[i])}");
        i = i + 1i64;
    }
}
