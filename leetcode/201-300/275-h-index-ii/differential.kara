// LeetCode 275 — differential harness.
//
// Three solvers over EVERY non-decreasing sequence of length 0..7 with values
// 0..7, plus 3,000 randomized sorted arrays up to length 800: the ★ binary
// search on the index, the backward linear scan, and the counting buckets.
//
// THE SMALL CASES ARE EXHAUSTIVE, NOT SAMPLED. The input space here is small
// enough to enumerate outright — every combination with repetition of 0..7 taken
// 0..7 at a time, 6,435 arrays — and an exhaustive oracle is categorically
// better than a random one for an off-by-one, because an off-by-one lives at
// exactly one input and a sampler can miss it forever. The random arm exists for
// SCALE (a binary search over 4 elements exercises two iterations), not for
// coverage of the boundary.
//
// THE THIRD SOLVER USES NO SORTEDNESS. Both of the others are built on the array
// being non-decreasing — one binary-searches a predicate that is monotone only
// because of it, the other stops at the first failure because of it — so if that
// assumption were ever violated they would agree on a wrong answer. The bucket
// solver is #274's algorithm, written for unsorted input, and it is the one that
// would notice. 270 established the pattern and 272 measured it: breaking two
// solvers that share a decision procedure scores exactly what breaking either
// alone scores, because they agree with each other.
//
// AND A FOURTH CHECK THAT COMPUTES NOTHING. Agreement cannot catch a mistake all
// three make, so every answer is also checked against the DEFINITION directly:
// `h` is the h-index iff at least `h` papers have `>= h` citations AND fewer
// than `h + 1` papers have `>= h + 1`. Two counting loops, no search, no
// sortedness, no shared arithmetic with any solver — it does not compute an
// answer, it only refutes one. That is the shape 273's shape-oracle had and it
// is the only check here that survives all three solvers being wrong together.

fn h_binary(citations: ref Vec[i64]) -> i64 {
    let n = citations.len();
    let mut lo = 0i64;
    let mut hi = n;
    while lo < hi {
        let mid = lo + (hi - lo) / 2i64;
        if citations[mid] >= n - mid { hi = mid; } else { lo = mid + 1i64; }
    }
    return n - lo;
}

fn h_scan(citations: ref Vec[i64]) -> i64 {
    let n = citations.len();
    let mut h = 0i64;
    let mut i = n - 1i64;
    while i >= 0i64 {
        if citations[i] >= h + 1i64 { h = h + 1i64; } else { i = -1i64; }
        i = i - 1i64;
    }
    return h;
}

fn h_bucket(citations: ref Vec[i64]) -> i64 {
    let n = citations.len();
    let mut buckets: Vec[i64] = Vec.new();
    let mut b = 0i64;
    while b <= n { buckets.push(0i64); b = b + 1i64; }
    let mut i = 0i64;
    while i < n {
        let mut c = citations[i];
        if c > n { c = n; }
        buckets[c] = buckets[c] + 1i64;
        i = i + 1i64;
    }
    let mut total = 0i64;
    let mut h = n;
    while h >= 0i64 {
        total = total + buckets[h];
        if total >= h { return h; }
        h = h - 1i64;
    }
    return 0i64;
}

// The DEFINITION, counted directly. Refutes an answer; never produces one.
fn h_is_valid(citations: ref Vec[i64], h: i64) -> bool {
    let n = citations.len();
    if h < 0i64 or h > n { return false; }
    let mut at_least_h = 0i64;
    let mut at_least_h1 = 0i64;
    let mut i = 0i64;
    while i < n {
        if citations[i] >= h { at_least_h = at_least_h + 1i64; }
        if citations[i] >= h + 1i64 { at_least_h1 = at_least_h1 + 1i64; }
        i = i + 1i64;
    }
    if at_least_h < h { return false; }          // h itself is not achievable
    if at_least_h1 >= h + 1i64 { return false; } // h + 1 was, so h is not maximal
    return true;
}

fn main() {
    let max_len = 7i64;
    let max_val = 7i64;
    let random_cases = 3000i64;

    let mut cases = 0i64;
    let mut exhaustive = 0i64;
    let mut mismatches = 0i64;
    let mut invalid = 0i64;
    let mut h_zero = 0i64;
    let mut h_full = 0i64;
    let mut over_n = 0i64;          // arrays containing a citation count above n
    let mut digest = 0i64;

    // ---- exhaustive: every non-decreasing sequence ------------------------
    let mut k = 0i64;
    while k <= max_len {
        let mut row: Vec[i64] = Vec.new();
        let mut z = 0i64;
        while z < k { row.push(0i64); z = z + 1i64; }
        let mut more = true;
        while more {
            let a = h_binary(row);
            let b = h_scan(row);
            let c = h_bucket(row);
            if a != b or a != c { mismatches = mismatches + 1i64; }
            if h_is_valid(row, a) == false { invalid = invalid + 1i64; }
            if a == 0i64 { h_zero = h_zero + 1i64; }
            if a == k and k > 0i64 { h_full = h_full + 1i64; }
            let mut q = 0i64;
            let mut saw_over = false;
            while q < k { if row[q] > k { saw_over = true; } q = q + 1i64; }
            if saw_over { over_n = over_n + 1i64; }
            digest = (digest * 131i64 + a + k) % 1000000007i64;
            cases = cases + 1i64;
            exhaustive = exhaustive + 1i64;

            // odometer over combinations WITH repetition: find the rightmost
            // digit below the ceiling, bump it, and flatten everything right of
            // it to the same value — which is what keeps the sequence
            // non-decreasing without generating and rejecting.
            if k == 0i64 {
                more = false;
            } else {
                let mut i = k - 1i64;
                while i >= 0i64 and row[i] == max_val { i = i - 1i64; }
                if i < 0i64 {
                    more = false;
                } else {
                    row[i] = row[i] + 1i64;
                    let mut j = i + 1i64;
                    while j < k { row[j] = row[i]; j = j + 1i64; }
                }
            }
        }
        k = k + 1i64;
    }

    // ---- random, for SCALE ------------------------------------------------
    let mut seed = 275275i64;
    let mut r = 0i64;
    while r < random_cases {
        seed = (seed * 1103515245i64 + 12345i64) & 2147483647i64;
        let n = 1i64 + (seed / 256i64) % 800i64;
        // Draw then sort by construction: a non-decreasing walk with random
        // steps, which reaches every sorted shape without needing a sort.
        seed = (seed * 1103515245i64 + 12345i64) & 2147483647i64;
        let step_cap = 1i64 + (seed / 256i64) % 5i64;
        let mut arr: Vec[i64] = Vec.new();
        let mut cur = 0i64;
        let mut i = 0i64;
        while i < n {
            seed = (seed * 1103515245i64 + 12345i64) & 2147483647i64;
            cur = cur + (seed / 256i64) % step_cap;
            arr.push(cur);
            i = i + 1i64;
        }
        let a = h_binary(arr);
        let b = h_scan(arr);
        let c = h_bucket(arr);
        if a != b or a != c { mismatches = mismatches + 1i64; }
        if h_is_valid(arr, a) == false { invalid = invalid + 1i64; }
        if a == 0i64 { h_zero = h_zero + 1i64; }
        if a == n { h_full = h_full + 1i64; }
        if arr[n - 1i64] > n { over_n = over_n + 1i64; }
        digest = (digest * 131i64 + a + n) % 1000000007i64;
        cases = cases + 1i64;
        r = r + 1i64;
    }

    println(f"cases {cases}");
    println(f"of which EXHAUSTIVE (every sorted array, len 0..{max_len}, vals 0..{max_val}) {exhaustive}");
    println(f"answers at the floor (h = 0) {h_zero}");
    println(f"answers at the ceiling (h = n) {h_full}");
    println(f"arrays with a citation count above n (the bucket clamp) {over_n}");
    println(f"answers refuted by the DEFINITION {invalid}");
    println(f"digest {digest}");
    println(f"mismatches {mismatches}");
}
