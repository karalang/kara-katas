// LeetCode 278 — the DFS formulation.
//
// Same graph, same two pre-conditions (one edge per adjacent pair, and the
// prefix rule). What differs is the sort: instead of repeatedly taking a
// zero-in-degree letter, this walks the graph depth-first and emits each letter
// AFTER all of its successors, producing a reverse postorder. Cycles are caught
// with three colours — white unvisited, GREY on the current stack, black
// finished — and meeting a grey letter means a back edge, so the answer is "".
//
// IT DOES NOT PRODUCE THE SAME STRING AS THE ★ SOLVER, and that is the point of
// keeping it. Kahn's with a smallest-first tie-break yields the
// LEXICOGRAPHICALLY SMALLEST valid order; DFS reverse postorder yields *a* valid
// order, and no choice of visit order makes it the lex-smallest one in general —
// that greedy property belongs to the repeated-minimum formulation and cannot be
// recovered by ordering DFS roots.
//
// So this solver cannot be checked by string comparison, and pretending
// otherwise would mean either weakening the ★ solver to match it or asserting
// something false. It is checked by a VALIDATOR instead: whatever it emits must
// contain every present letter exactly once and must satisfy every pairwise
// constraint the words impose. Different solvers, different oracles — see
// differential.kara, where the choice is forced by the problem rather than
// chosen for variety.

fn alien_order(words: ref Vec[String]) -> String {
    // present[c] — letter c occurs somewhere in the input
    let mut present: Vec[bool] = Vec.new();
    let mut indeg: Vec[i64] = Vec.new();
    let mut z = 0i64;
    while z < 26i64 {
        present.push(false);
        indeg.push(0i64);
        z = z + 1i64;
    }
    // adj[a*26+b] — a precedes b (deduplicated: a repeated pair must not
    // inflate the in-degree, or the count never reaches zero)
    let mut adj: Vec[bool] = Vec.new();
    let mut y = 0i64;
    while y < 676i64 {
        adj.push(false);
        y = y + 1i64;
    }

    let mut w = 0i64;
    while w < words.len() {
        let b = words[w].bytes();
        let mut i = 0i64;
        while i < b.len() {
            present[(b[i] as i64) - 97i64] = true;
            i = i + 1i64;
        }
        w = w + 1i64;
    }

    let mut p = 0i64;
    while p + 1i64 < words.len() {
        let a = words[p].bytes();
        let c = words[p + 1i64].bytes();
        let mut k = 0i64;
        let mut found = false;
        let mut shorter = a.len();
        if c.len() < shorter { shorter = c.len(); }
        while k < shorter {
            if a[k] != c[k] {
                let u = (a[k] as i64) - 97i64;
                let v = (c[k] as i64) - 97i64;
                if not adj[u * 26i64 + v] {
                    adj[u * 26i64 + v] = true;
                    indeg[v] = indeg[v] + 1i64;
                }
                found = true;
                k = shorter;          // exactly one edge per adjacent pair
            } else {
                k = k + 1i64;
            }
        }
        // No differing character within the common prefix: legal only if the
        // earlier word is the shorter one.
        if not found and a.len() > c.len() {
            return "";
        }
        p = p + 1i64;
    }

    // Reverse postorder DFS with three colours. colour: 0 white, 1 grey, 2 black.
    let mut colour: Vec[i64] = Vec.new();
    let mut q = 0i64;
    while q < 26i64 {
        colour.push(0i64);
        q = q + 1i64;
    }
    let mut rev: Vec[i64] = Vec.new();
    let mut root = 0i64;
    while root < 26i64 {
        if present[root] and colour[root] == 0i64 {
            // explicit stack of (letter, next-successor-to-try)
            let mut st: Vec[i64] = Vec.new();
            let mut ix: Vec[i64] = Vec.new();
            st.push(root);
            ix.push(0i64);
            colour[root] = 1i64;
            while st.len() > 0i64 {
                let top = st[st.len() - 1i64];
                let mut t = ix[ix.len() - 1i64];
                let mut advanced = false;
                while t < 26i64 and not advanced {
                    if adj[top * 26i64 + t] {
                        if colour[t] == 1i64 {
                            return "";            // back edge -> cycle
                        }
                        if colour[t] == 0i64 {
                            ix[ix.len() - 1i64] = t + 1i64;
                            colour[t] = 1i64;
                            st.push(t);
                            ix.push(0i64);
                            advanced = true;
                        }
                    }
                    if not advanced { t = t + 1i64; }
                }
                if not advanced {
                    colour[top] = 2i64;
                    rev.push(top);
                    st.pop();
                    ix.pop();
                } else {
                    // the successor's frame is on top now; nothing to do
                }
            }
        }
        root = root + 1i64;
    }

    let mut out: String = "";
    let mut e = rev.len() - 1i64;
    while e >= 0i64 {
        out = out + byte_to_str(rev[e] + 97i64);
        e = e - 1i64;
    }
    return out;
}

fn byte_to_str(b: i64) -> String {
    let alphabet: String = "abcdefghijklmnopqrstuvwxyz";
    return alphabet.substring(b - 97i64, b - 96i64);
}

fn main() {
    let c1: Vec[String] = ["wrt", "wrf", "er", "ett", "rftt"];
    let c2: Vec[String] = ["z", "x"];
    let c3: Vec[String] = ["z", "x", "z"];               // cycle -> ""
    let c4: Vec[String] = ["abc", "ab"];                 // prefix rule -> ""
    let c5: Vec[String] = ["ab", "abc"];                 // legal prefix
    let c6: Vec[String] = ["zy", "zx"];
    let c7: Vec[String] = ["ac", "ab", "zc", "zb"];
    let c8: Vec[String] = ["a"];

    println(f"[wrt wrf er ett rftt] -> {alien_order(c1)}");
    println(f"[z x]                 -> {alien_order(c2)}");
    println(f"[z x z]               -> {alien_order(c3)}");
    println(f"[abc ab]              -> {alien_order(c4)}");
    println(f"[ab abc]              -> {alien_order(c5)}");
    println(f"[zy zx]               -> {alien_order(c6)}");
    println(f"[ac ab zc zb]         -> {alien_order(c7)}");
    println(f"[a]                   -> {alien_order(c8)}");
}
