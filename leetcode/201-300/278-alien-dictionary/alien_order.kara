// LeetCode 269/278 — Alien Dictionary.
//
// Words from an alien language, given in that language's lexicographic order.
// Recover the order of its letters. Return "" if the input is inconsistent.
//
// THE ★ MECHANISM: KAHN'S TOPOLOGICAL SORT over letter-precedence edges.
//
// Two things have to happen before any sorting, and the second is the one that
// gets skipped:
//
//   1. EDGES. Each ADJACENT pair of words contributes at most ONE edge — the
//      first position where they differ. `wxqkj` before `wxjki` says `q < j`
//      and says nothing else: everything after the first difference is
//      unconstrained, because lexicographic order already stopped caring.
//      Taking more than one edge per pair is the classic over-read.
//
//   2. THE PREFIX RULE. If one word is a proper prefix of the previous one —
//      `["abc", "ab"]` — the input is INVALID, and no edge is involved. A
//      shorter word must come first in any ordering, so a dictionary listing
//      them the other way cannot be sorted by any alphabet. This case produces
//      no constraint at all, which is exactly why a solver that only looks for
//      differing characters sails past it and returns a confident wrong answer.
//
// Then Kahn: repeatedly take a letter with in-degree zero, append it, and
// decrement its successors. If letters remain when no zero-in-degree letter is
// available, there is a cycle and the answer is "".
//
// THE ANSWER IS USUALLY NOT UNIQUE — unconstrained letters may appear in any
// relative order — so this solver commits to the LEXICOGRAPHICALLY SMALLEST
// valid ordering by always taking the smallest available letter. That is not
// what the problem demands (any valid order is accepted) but it is what makes
// the answer comparable between solvers, and the differential leans on it.
// Where a canonical form is not available, the harness validates instead of
// comparing — see differential.kara.
//
// EVERY LETTER THAT APPEARS MUST BE IN THE OUTPUT, including letters with no
// constraints at all. A solver that only emits letters it saw in an edge drops
// the isolated ones.

fn alien_order(words: ref Vec[String]) -> String {
    // present[c] — letter c occurs somewhere in the input
    let mut present: Vec[bool] = Vec.new();
    let mut indeg: Vec[i64] = Vec.new();
    let mut z = 0i64;
    while z < 26i64 {
        present.push(false);
        indeg.push(0i64);
        z = z + 1i64;
    }
    // adj[a*26+b] — a precedes b (deduplicated: a repeated pair must not
    // inflate the in-degree, or the count never reaches zero)
    let mut adj: Vec[bool] = Vec.new();
    let mut y = 0i64;
    while y < 676i64 {
        adj.push(false);
        y = y + 1i64;
    }

    let mut w = 0i64;
    while w < words.len() {
        let b = words[w].bytes();
        let mut i = 0i64;
        while i < b.len() {
            present[(b[i] as i64) - 97i64] = true;
            i = i + 1i64;
        }
        w = w + 1i64;
    }

    let mut p = 0i64;
    while p + 1i64 < words.len() {
        let a = words[p].bytes();
        let c = words[p + 1i64].bytes();
        let mut k = 0i64;
        let mut found = false;
        let mut shorter = a.len();
        if c.len() < shorter { shorter = c.len(); }
        while k < shorter {
            if a[k] != c[k] {
                let u = (a[k] as i64) - 97i64;
                let v = (c[k] as i64) - 97i64;
                if not adj[u * 26i64 + v] {
                    adj[u * 26i64 + v] = true;
                    indeg[v] = indeg[v] + 1i64;
                }
                found = true;
                k = shorter;          // exactly one edge per adjacent pair
            } else {
                k = k + 1i64;
            }
        }
        // No differing character within the common prefix: legal only if the
        // earlier word is the shorter one.
        if not found and a.len() > c.len() {
            return "";
        }
        p = p + 1i64;
    }

    let mut out: String = "";
    let mut done: Vec[bool] = Vec.new();
    let mut d = 0i64;
    while d < 26i64 {
        done.push(false);
        d = d + 1i64;
    }
    let mut remaining = 0i64;
    let mut r = 0i64;
    while r < 26i64 {
        if present[r] { remaining = remaining + 1i64; }
        r = r + 1i64;
    }

    while remaining > 0i64 {
        // smallest available letter — the canonical tie-break
        let mut pick = -1i64;
        let mut s = 0i64;
        while s < 26i64 {
            if present[s] and not done[s] and indeg[s] == 0i64 and pick < 0i64 {
                pick = s;
            }
            s = s + 1i64;
        }
        if pick < 0i64 {
            return "";                // cycle
        }
        done[pick] = true;
        out = out + byte_to_str(pick + 97i64);
        let mut t = 0i64;
        while t < 26i64 {
            if adj[pick * 26i64 + t] {
                indeg[t] = indeg[t] - 1i64;
            }
            t = t + 1i64;
        }
        remaining = remaining - 1i64;
    }
    return out;
}

fn byte_to_str(b: i64) -> String {
    let alphabet: String = "abcdefghijklmnopqrstuvwxyz";
    return alphabet.substring(b - 97i64, b - 96i64);
}

fn main() {
    let c1: Vec[String] = ["wrt", "wrf", "er", "ett", "rftt"];
    let c2: Vec[String] = ["z", "x"];
    let c3: Vec[String] = ["z", "x", "z"];               // cycle -> ""
    let c4: Vec[String] = ["abc", "ab"];                 // prefix rule -> ""
    let c5: Vec[String] = ["ab", "abc"];                 // legal prefix
    let c6: Vec[String] = ["zy", "zx"];
    let c7: Vec[String] = ["ac", "ab", "zc", "zb"];
    let c8: Vec[String] = ["a"];

    println(f"[wrt wrf er ett rftt] -> {alien_order(c1)}");
    println(f"[z x]                 -> {alien_order(c2)}");
    println(f"[z x z]               -> {alien_order(c3)}");
    println(f"[abc ab]              -> {alien_order(c4)}");
    println(f"[ab abc]              -> {alien_order(c5)}");
    println(f"[zy zx]               -> {alien_order(c6)}");
    println(f"[ac ab zc zb]         -> {alien_order(c7)}");
    println(f"[a]                   -> {alien_order(c8)}");
}
