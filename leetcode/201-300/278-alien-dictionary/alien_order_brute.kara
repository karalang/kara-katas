// LeetCode 278 — the definition, asked directly.
//
// An answer is a permutation of the present letters under which every adjacent
// pair of input words is correctly ordered. So: generate permutations in
// lexicographic order and return the first that satisfies the whole word list.
// If none does, the answer is "".
//
// O(k! * total input length) — hopeless past eight or so distinct letters, which
// is why the differential draws its alphabets small. It earns the cost by being
// the only solver that never builds a graph.
//
// WHICH IS EXACTLY WHY IT IS HERE. Both other solvers derive edges the same way
// and share both pre-conditions — one edge per adjacent pair, and the prefix
// rule. A misreading of EITHER is invisible between them: drop the prefix rule
// in both and they agree, confidently, on an ordering for input no ordering can
// satisfy. This one never extracts a constraint at all. It checks candidate
// orders against the WORDS, so the prefix case needs no special handling — a
// longer word before its own prefix simply fails every permutation, and "" falls
// out.
//
// It also returns the lexicographically smallest valid order by construction,
// which is the same canonical form the ★ solver commits to. That makes the two
// directly comparable as STRINGS, not merely both-valid — the strongest check
// the harness has, and the reason the ★ solver bothers with a tie-break at all.

fn words_ordered_under(words: ref Vec[String], rank: ref Vec[i64]) -> bool {
    let mut p = 0i64;
    while p + 1i64 < words.len() {
        let a = words[p].bytes();
        let c = words[p + 1i64].bytes();
        let mut k = 0i64;
        let mut shorter = a.len();
        if c.len() < shorter { shorter = c.len(); }
        let mut decided = false;
        let mut ok = true;
        while k < shorter and not decided {
            if a[k] != c[k] {
                decided = true;
                if rank[(a[k] as i64) - 97i64] > rank[(c[k] as i64) - 97i64] {
                    ok = false;
                }
            }
            k = k + 1i64;
        }
        if not decided and a.len() > c.len() {
            ok = false;                 // a longer word before its own prefix
        }
        if not ok { return false; }
        p = p + 1i64;
    }
    return true;
}

fn alien_order(words: ref Vec[String]) -> String {
    let mut present: Vec[bool] = Vec.new();
    let mut z = 0i64;
    while z < 26i64 { present.push(false); z = z + 1i64; }
    let mut w = 0i64;
    while w < words.len() {
        let b = words[w].bytes();
        let mut i = 0i64;
        while i < b.len() {
            present[(b[i] as i64) - 97i64] = true;
            i = i + 1i64;
        }
        w = w + 1i64;
    }
    let mut letters: Vec[i64] = Vec.new();
    let mut c = 0i64;
    while c < 26i64 {
        if present[c] { letters.push(c); }
        c = c + 1i64;
    }

    // permutations of `letters` in lexicographic order, by repeated next-permutation
    let mut perm: Vec[i64] = Vec.new();
    let mut i2 = 0i64;
    while i2 < letters.len() { perm.push(letters[i2]); i2 = i2 + 1i64; }

    let mut more = true;
    while more {
        let mut rank: Vec[i64] = Vec.new();
        let mut r = 0i64;
        while r < 26i64 { rank.push(0i64); r = r + 1i64; }
        let mut j = 0i64;
        while j < perm.len() { rank[perm[j]] = j; j = j + 1i64; }
        if words_ordered_under(words, rank) {
            let mut out: String = "";
            let mut e = 0i64;
            while e < perm.len() {
                out = out + byte_to_str(perm[e] + 97i64);
                e = e + 1i64;
            }
            return out;
        }
        // next permutation
        let mut p2 = perm.len() - 2i64;
        while p2 >= 0i64 and perm[p2] >= perm[p2 + 1i64] { p2 = p2 - 1i64; }
        if p2 < 0i64 {
            more = false;
        } else {
            let mut s2 = perm.len() - 1i64;
            while perm[s2] <= perm[p2] { s2 = s2 - 1i64; }
            let tmp = perm[p2];
            perm[p2] = perm[s2];
            perm[s2] = tmp;
            let mut lo = p2 + 1i64;
            let mut hi = perm.len() - 1i64;
            while lo < hi {
                let t2 = perm[lo];
                perm[lo] = perm[hi];
                perm[hi] = t2;
                lo = lo + 1i64;
                hi = hi - 1i64;
            }
        }
    }
    return "";
}

fn byte_to_str(b: i64) -> String {
    let alphabet: String = "abcdefghijklmnopqrstuvwxyz";
    return alphabet.substring(b - 97i64, b - 96i64);
}

fn main() {
    let c1: Vec[String] = ["wrt", "wrf", "er", "ett", "rftt"];
    let c2: Vec[String] = ["z", "x"];
    let c3: Vec[String] = ["z", "x", "z"];               // cycle -> ""
    let c4: Vec[String] = ["abc", "ab"];                 // prefix rule -> ""
    let c5: Vec[String] = ["ab", "abc"];                 // legal prefix
    let c6: Vec[String] = ["zy", "zx"];
    let c7: Vec[String] = ["ac", "ab", "zc", "zb"];
    let c8: Vec[String] = ["a"];

    println(f"[wrt wrf er ett rftt] -> {alien_order(c1)}");
    println(f"[z x]                 -> {alien_order(c2)}");
    println(f"[z x z]               -> {alien_order(c3)}");
    println(f"[abc ab]              -> {alien_order(c4)}");
    println(f"[ab abc]              -> {alien_order(c5)}");
    println(f"[zy zx]               -> {alien_order(c6)}");
    println(f"[ac ab zc zb]         -> {alien_order(c7)}");
    println(f"[a]                   -> {alien_order(c8)}");
}
