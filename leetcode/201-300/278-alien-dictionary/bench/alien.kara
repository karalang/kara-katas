// LeetCode 278 bench kernel — edge extraction at scale.
//
// THE TOPOLOGICAL SORT IS NOT THE WORKLOAD. It runs over 26 letters: O(26²)
// however many words you feed it, which is a rounding error. All the time is in
// PHASE 1 — walking adjacent word pairs to find each first difference — and that
// is O(total input length), so the workload is a big dictionary, not a big
// alphabet.
//
// THE WORDS ARE GENERATED AND THEN SORTED UNDER A PLANTED ALPHABET, so the input
// is a genuine dictionary rather than a list that fails on its second pair. An
// unsorted list would make every lane return "" after a handful of comparisons
// and measure nothing. Sorting is done once, outside the timed comparison, by
// construction: words are emitted in planted-alphabet order directly.
//
// LONG SHARED PREFIXES ARE THE POINT. Each word shares a prefix with its
// neighbour, so finding the first difference actually costs something. Draw
// words independently at random and almost every adjacent pair differs at
// position 0, the scan exits immediately, and the bench measures loop overhead
// instead of the comparison it is supposed to.
//
// PARALLEL LANE. Edge extraction over pairs is not a recognized reduction shape
// — it ORs into a shared 676-entry matrix — so the fan-out is over independent
// DICTIONARIES, the same instance split kata 277 uses. Each of the 48 dictionary
// instances is solved end to end by one branch.

fn solve(words: ref Vec[String]) -> String {
    let mut present: Vec[bool] = Vec.new();
    let mut indeg: Vec[i64] = Vec.new();
    let mut z = 0i64;
    while z < 26i64 { present.push(false); indeg.push(0i64); z = z + 1i64; }
    let mut adj: Vec[bool] = Vec.new();
    let mut y = 0i64;
    while y < 676i64 { adj.push(false); y = y + 1i64; }

    let mut w = 0i64;
    while w < words.len() {
        let b = words[w].bytes();
        let mut i = 0i64;
        while i < b.len() { present[(b[i] as i64) - 97i64] = true; i = i + 1i64; }
        w = w + 1i64;
    }
    let mut p = 0i64;
    while p + 1i64 < words.len() {
        let a = words[p].bytes();
        let c = words[p + 1i64].bytes();
        let mut k = 0i64;
        let mut found = false;
        let mut shorter = a.len();
        if c.len() < shorter { shorter = c.len(); }
        while k < shorter {
            if a[k] != c[k] {
                let u = (a[k] as i64) - 97i64;
                let v = (c[k] as i64) - 97i64;
                if not adj[u * 26i64 + v] {
                    adj[u * 26i64 + v] = true;
                    indeg[v] = indeg[v] + 1i64;
                }
                found = true;
                k = shorter;
            } else {
                k = k + 1i64;
            }
        }
        if not found and a.len() > c.len() { return ""; }
        p = p + 1i64;
    }

    let mut out: String = "";
    let mut done: Vec[bool] = Vec.new();
    let mut d = 0i64;
    while d < 26i64 { done.push(false); d = d + 1i64; }
    let mut remaining = 0i64;
    let mut r = 0i64;
    while r < 26i64 { if present[r] { remaining = remaining + 1i64; } r = r + 1i64; }
    while remaining > 0i64 {
        let mut pick = -1i64;
        let mut s = 0i64;
        while s < 26i64 {
            if present[s] and not done[s] and indeg[s] == 0i64 and pick < 0i64 { pick = s; }
            s = s + 1i64;
        }
        if pick < 0i64 { return ""; }
        done[pick] = true;
        out = out + letter(pick);
        let mut t = 0i64;
        while t < 26i64 {
            if adj[pick * 26i64 + t] { indeg[t] = indeg[t] - 1i64; }
            t = t + 1i64;
        }
        remaining = remaining - 1i64;
    }
    return out;
}

fn letter(i: i64) -> String {
    let alphabet: String = "abcdefghijklmnopqrstuvwxyz";
    return alphabet.substring(i, i + 1i64);
}

// A dictionary of `count` words over the first `alpha` letters of a REVERSED
// alphabet, emitted already in that alphabet's order: the words are the
// base-`alpha` numerals of 0..count, most-significant digit first, mapped so
// that digit 0 is the alphabet's first letter. Consecutive numerals share long
// prefixes, which is what makes the first-difference scan cost anything.
fn make_dict(count: i64, alpha: i64, width: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut n = 0i64;
    while n < count {
        let mut s: String = "";
        let mut rem = n;
        let mut pos = 0i64;
        let mut digits: Vec[i64] = Vec.new();
        while pos < width {
            digits.push(rem % alpha);
            rem = rem / alpha;
            pos = pos + 1i64;
        }
        let mut q = width - 1i64;
        while q >= 0i64 {
            s = s + letter((alpha - 1i64) - digits[q]);
            q = q - 1i64;
        }
        out.push(s);
        n = n + 1i64;
    }
    return out;
}

fn main() {
    let instances = 48i64;
    let words = 250000i64;
    let alpha = 6i64;
    let width = 8i64;

    // BUILD ONCE, PUNCH 48 TIMES. Constructing the dictionary is string work,
    // not the algorithm; leaving it inside the loop would have the bench measure
    // allocation alongside the scan it is supposed to time.
    let dict = make_dict(words, alpha, width);

    let mut parts: Vec[i64] = Vec.new();
    #[par_order_free]
    for i in 0i64..instances {
        let ans = solve(dict);
        parts.push((i * 1000003i64 + ans.len()) % 1000000007i64);
    }

    let mut sink = 0i64;
    let mut k = 0i64;
    while k < parts.len() {
        sink = (sink + parts[k]) % 1000000007i64;
        k = k + 1i64;
    }
    println(sink);
}
