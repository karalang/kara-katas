// LeetCode 279 — differential harness.
//
// Three solvers by three unrelated routes: an O(n√n) bottom-up DP, a BFS
// shortest path over the same graph, and a closed form from Lagrange's
// four-square theorem plus Legendre's three-square theorem.
//
// THE DP AND THE BFS ARE NOT INDEPENDENT ENOUGH. They search in opposite
// directions, but over the SAME edge relation `k -> k - j²`. A misunderstanding
// of that relation — an off-by-one in `j*j <= i`, a missing `j = 1` start — is
// shared by both, and they would agree on the wrong answer. This is the pattern
// katas 276, 277 and 278 each measured: solvers from one derivation cross-check
// arithmetic, not understanding.
//
// THE CLOSED FORM NEVER BUILDS THE GRAPH. It reads the answer off arithmetic
// properties of `n` alone — is it a square, is it `4^a(8b+7)`, is it a sum of
// two squares. A DP bug and a number-theory bug have no mechanism by which to
// coincide, which is exactly what an oracle has to provide.
//
// AND THE CHECK RUNS BOTH WAYS. The closed form is the only solver here that is
// not obviously correct by inspection — it is correct by CITATION, resting on
// two theorems this repo has not proved. So the searches validate the theory
// exactly as much as the theory validates the searches: over every n in the
// range, Lagrange and Legendre are confirmed by exhaustive construction. That
// is a fair trade and worth stating, because "it agrees with the textbook" is
// not the same claim as "the textbook agrees with 20000 enumerated cases".
//
// EXHAUSTIVE, NOT SAMPLED. Every n from 1 to 1200, which covers each residue
// class mod 8 and every 4^a stripping depth the range admits. The range is bounded
// by the BFS, which rebuilds an O(n) `seen` array per query and so makes the
// sweep O(limit^2) — 2500 took 13 minutes under `--interp` against 0.045 s
// compiled, which is too slow to re-verify casually, so the range is set by what
// the SLOWEST surface can carry. The DP and closed form would happily run to
// millions. The
// answers is reported because it is a second, coarser check: the four counts
// must sum to the range, and the 4s must be exactly the Legendre numbers —
// counted independently below.

fn dp_least(n: i64, table: mut ref Vec[i64]) -> i64 {
    // `table` is grown once across the whole sweep rather than rebuilt per n:
    // the DP is prefix-closed, so entry i is valid forever once written.
    while table.len() <= n {
        let i = table.len();
        let mut best = i;
        let mut j = 1i64;
        while j * j <= i {
            let cand = table[i - j * j] + 1i64;
            if cand < best { best = cand; }
            j = j + 1i64;
        }
        table.push(best);
    }
    return table[n];
}

fn bfs_least(n: i64) -> i64 {
    if n <= 0i64 { return 0i64; }
    let mut seen: Vec[bool] = Vec.new();
    let mut z = 0i64;
    while z <= n { seen.push(false); z = z + 1i64; }
    let mut frontier: Vec[i64] = Vec.new();
    frontier.push(n);
    seen[n] = true;
    let mut level = 0i64;
    while frontier.len() > 0i64 {
        level = level + 1i64;
        let mut next: Vec[i64] = Vec.new();
        let mut f = 0i64;
        while f < frontier.len() {
            let cur = frontier[f];
            let mut j = 1i64;
            while j * j <= cur {
                let nxt = cur - j * j;
                if nxt == 0i64 { return level; }
                if not seen[nxt] { seen[nxt] = true; next.push(nxt); }
                j = j + 1i64;
            }
            f = f + 1i64;
        }
        frontier = next;
    }
    return 0i64;
}

fn is_square(n: i64) -> bool {
    if n < 0i64 { return false; }
    let mut r = 0i64;
    while r * r < n { r = r + 1i64; }
    return r * r == n;
}

fn theory_least(n: i64) -> i64 {
    if n <= 0i64 { return 0i64; }
    if is_square(n) { return 1i64; }
    let mut m = n;
    while m % 4i64 == 0i64 { m = m / 4i64; }
    if m % 8i64 == 7i64 { return 4i64; }
    let mut i = 1i64;
    while i * i <= n {
        if is_square(n - i * i) { return 2i64; }
        i = i + 1i64;
    }
    return 3i64;
}

// Independent count of the Legendre numbers in [1, limit] — computed straight
// from the form `4^a(8b+7)` rather than from any solver's answer, so it can be
// compared against "how many times did a solver say 4".
fn count_legendre(limit: i64) -> i64 {
    let mut c = 0i64;
    let mut n = 1i64;
    while n <= limit {
        let mut m = n;
        while m % 4i64 == 0i64 { m = m / 4i64; }
        if m % 8i64 == 7i64 { c = c + 1i64; }
        n = n + 1i64;
    }
    return c;
}

fn main() {
    let limit = 1200i64;

    let mut table: Vec[i64] = Vec.new();
    table.push(0i64);

    let mut ones = 0i64;
    let mut twos = 0i64;
    let mut threes = 0i64;
    let mut fours = 0i64;
    let mut dp_vs_bfs = 0i64;
    let mut dp_vs_theory = 0i64;
    let mut over_four = 0i64;
    let mut digest = 0i64;

    let mut n = 1i64;
    while n <= limit {
        let a = dp_least(n, mut table);
        let b = bfs_least(n);
        let c = theory_least(n);
        if a != b { dp_vs_bfs = dp_vs_bfs + 1i64; }
        if a != c { dp_vs_theory = dp_vs_theory + 1i64; }
        if a > 4i64 { over_four = over_four + 1i64; }   // Lagrange, checked
        if a == 1i64 { ones = ones + 1i64; }
        if a == 2i64 { twos = twos + 1i64; }
        if a == 3i64 { threes = threes + 1i64; }
        if a == 4i64 { fours = fours + 1i64; }
        digest = (digest * 131i64 + a) % 1000000007i64;
        n = n + 1i64;
    }

    let legendre = count_legendre(limit);

    println(f"n from 1 to {limit}");
    println(f"answers: 1 -> {ones}, 2 -> {twos}, 3 -> {threes}, 4 -> {fours}");
    println(f"Lagrange violations (an answer above 4) {over_four}");
    println(f"Legendre numbers counted independently {legendre}");
    println(f"...and answers of 4 {fours} — these must be equal");
    println(f"digest {digest}");
    println(f"DP vs BFS {dp_vs_bfs}");
    println(f"DP vs closed form {dp_vs_theory}");
}
