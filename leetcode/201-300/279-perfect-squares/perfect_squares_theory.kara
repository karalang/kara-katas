// LeetCode 279 — the closed form. No search at all.
//
// TWO THEOREMS DECIDE THIS PROBLEM COMPLETELY, and between them the answer is
// never more than 4 and never needs a table:
//
//   LAGRANGE (1770): every natural number is the sum of four squares. So the
//   answer is 1, 2, 3, or 4 — always.
//
//   LEGENDRE: `n` needs FOUR squares exactly when `n = 4^a · (8b + 7)`. That is
//   an `O(log n)` test: strip factors of 4, then check the remainder mod 8.
//
// Everything else follows by elimination:
//
//   1  if n is itself a perfect square
//   4  if n = 4^a(8b + 7)                     (Legendre)
//   2  if n = i² + j² for some i, j           (one O(√n) scan)
//   3  otherwise                              (nothing else is left)
//
// O(√n) time, O(1) space, and the only loop is the two-square check.
//
// WHY THIS IS THE ORACLE. The DP and the BFS are both searches over the same
// graph — different directions, but the same edge relation `k -> k - j²`. A
// misunderstanding of that relation is shared by both and invisible between
// them. This solver never builds the graph: it derives the answer from
// arithmetic facts about `n` alone. A DP bug and a number-theory bug have no
// mechanism by which to agree, which is exactly what an oracle has to provide.
//
// It is also the only one of the three that is not obviously correct by
// inspection — it is correct by CITATION. That is a real trade and worth naming:
// the differential is what converts two centuries of number theory into
// something this repo has actually checked, over every n it enumerates.

fn is_square(n: i64) -> bool {
    if n < 0i64 { return false; }
    let mut r = 0i64;
    while r * r < n { r = r + 1i64; }
    return r * r == n;
}

fn least_squares(n: i64) -> i64 {
    if n <= 0i64 { return 0i64; }
    if is_square(n) { return 1i64; }

    // Legendre: strip factors of 4, then test 8b+7.
    let mut m = n;
    while m % 4i64 == 0i64 { m = m / 4i64; }
    if m % 8i64 == 7i64 { return 4i64; }

    // Two squares?
    let mut i = 1i64;
    while i * i <= n {
        if is_square(n - i * i) { return 2i64; }
        i = i + 1i64;
    }
    return 3i64;
}

fn main() {
    let cases: Vec[i64] = [1i64, 2i64, 3i64, 4i64, 12i64, 13i64, 43i64, 48i64,
                           99i64, 100i64, 9999i64];
    let mut i = 0i64;
    while i < cases.len() {
        let n = cases[i];
        println(f"n={n} -> {least_squares(n)}");
        i = i + 1i64;
    }
}
