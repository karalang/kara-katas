// Benchmark harness for LeetCode #268 — Missing Number.
//
// Build-once + punch (BENCHMARKS.md): four 1,000,000-element arrays are built
// once, each drawn from [0, n] with a different value omitted, then punched in
// rotation. The XOR fold is order-independent, so the arrays are filled in a
// scrambled order (stride-coprime walk) purely so the read pattern is not a
// straight `arr[i] == i` identity that invites a peephole.

fn missing_number(nums: ref Vec[i64]) -> i64 {
    let n = nums.len();
    let mut acc = n;
    let mut i = 0i64;
    while i < n {
        acc = acc ^ i ^ nums[i];
        i = i + 1i64;
    }
    return acc;
}

fn main() {
    let np = 4i64;
    let n = 1000000i64;
    let iters = 850i64;

    let mut arrays: Vec[Vec[i64]] = Vec.new();
    let mut p = 0i64;
    while p < np {
        // The omitted value, spread across the range so each array differs.
        let missing = 200000i64 * p + 137i64;

        let mut arr: Vec[i64] = Vec.new();
        let mut z = 0i64;
        while z < n {
            arr.push(0i64);
            z = z + 1i64;
        }
        // Values 0..=n minus `missing`, written at stride-coprime positions.
        let mut t = 0i64;
        let mut v = 0i64;
        while t < n {
            if v == missing {
                v = v + 1i64;
            }
            let idx = (t * 499979i64) % n;
            arr[idx] = v;
            v = v + 1i64;
            t = t + 1i64;
        }
        arrays.push(arr);
        p = p + 1i64;
    }

    let mut sink = 0i64;
    let mut it = 0i64;
    while it < iters {
        let idx = (it * 3i64) % np;
        sink = (sink * 31i64 + missing_number(arrays[idx])) % 1000000007i64;
        it = it + 1i64;
    }
    println(f"{sink}");
}
