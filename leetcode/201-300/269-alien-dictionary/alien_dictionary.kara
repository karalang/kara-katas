// LeetCode 269 — Alien Dictionary. (Premium.)
//
// A list of words is sorted according to an unknown alphabet. Recover an order
// of the letters consistent with that sorting, or "" if none exists.
//
// The input is not a graph — it is a sorted list, and the whole first half of
// the problem is turning one into the other. Two rules do it, and each is a
// place to go wrong:
//
//   1. ONLY THE FIRST DIFFERING CHARACTER between adjacent words says anything.
//      From ["wrt", "wrf"] the sort tells us t < f. It says NOTHING about the
//      later positions, and nothing at all about non-adjacent pairs — those are
//      implied by transitivity and adding them as edges is redundant at best.
//
//   2. A WORD MAY NOT BE FOLLOWED BY ITS OWN PREFIX. ["abc", "ab"] cannot be
//      sorted under any alphabet: no letter comparison is ever reached, and a
//      shorter word sorts first when one is a prefix of the other. This yields
//      no edge, so a solver that only ever adds edges silently accepts it and
//      returns a plausible order for an impossible input. It is the single most
//      missed case in this problem.
//
// With the graph built, Kahn's algorithm peels letters with no unfulfilled
// predecessor. If letters remain when the queue empties, the constraints hold a
// cycle and no order exists.
//
// AMONG READY LETTERS THIS FILE ALWAYS TAKES THE SMALLEST. The problem accepts
// any valid order, but "any" is not a testable answer — it makes two correct
// implementations disagree and makes a differential meaningless. Taking the
// smallest ready letter yields the lexicographically least valid order, which
// is unique, so every file here and every mirror must produce it exactly.

fn alien_order(words: ref Vec[String]) -> String {
    // Present letters, adjacency and in-degree over the 26 lowercase slots.
    let mut present: Vec[bool] = Vec.new();
    let mut indeg: Vec[i64] = Vec.new();
    let mut adj: Vec[Vec[bool]] = Vec.new();
    let mut i = 0i64;
    while i < 26i64 {
        present.push(false);
        indeg.push(0i64);
        let mut row: Vec[bool] = Vec.new();
        let mut j = 0i64;
        while j < 26i64 {
            row.push(false);
            j = j + 1i64;
        }
        adj.push(row);
        i = i + 1i64;
    }

    // Every letter that occurs must appear in the answer, constrained or not.
    let mut w = 0i64;
    while w < words.len() {
        for b in words[w].bytes() {
            present[b as i64 - 97i64] = true;
        }
        w = w + 1i64;
    }

    // One edge per adjacent pair, from the first position where they differ.
    let mut p = 0i64;
    while p + 1i64 < words.len() {
        let mut a: Vec[i64] = Vec.new();
        for b in words[p].bytes() { a.push(b as i64 - 97i64); }
        let mut c: Vec[i64] = Vec.new();
        for b in words[p + 1i64].bytes() { c.push(b as i64 - 97i64); }

        let mut k = 0i64;
        let mut found = false;
        let mut lim = a.len();
        if c.len() < lim { lim = c.len(); }
        while k < lim {
            if a[k] != c[k] {
                // Record the edge once; a duplicate would inflate the in-degree
                // and strand the successor forever.
                if not adj[a[k]][c[k]] {
                    adj[a[k]][c[k]] = true;
                    indeg[c[k]] = indeg[c[k]] + 1i64;
                }
                found = true;
                k = lim;
            } else {
                k = k + 1i64;
            }
        }
        // Rule 2: no differing position, and the first word is longer.
        if not found and a.len() > c.len() {
            return "";
        }
        p = p + 1i64;
    }

    // Kahn, always taking the smallest ready letter.
    let mut done: Vec[bool] = Vec.new();
    let mut d = 0i64;
    let mut remaining = 0i64;
    while d < 26i64 {
        done.push(false);
        if present[d] { remaining = remaining + 1i64; }
        d = d + 1i64;
    }

    let mut out = "";
    let mut placed = 0i64;
    while placed < remaining {
        let mut pick = -1i64;
        let mut s = 0i64;
        while s < 26i64 {
            if present[s] and not done[s] and indeg[s] == 0i64 {
                pick = s;
                s = 26i64;
            } else {
                s = s + 1i64;
            }
        }
        if pick < 0i64 {
            return "";          // a cycle: nothing is ready but letters remain
        }
        done[pick] = true;
        out = out + f"{(pick + 97i64) as u8 as char}";
        placed = placed + 1i64;
        let mut t = 0i64;
        while t < 26i64 {
            if adj[pick][t] {
                indeg[t] = indeg[t] - 1i64;
            }
            t = t + 1i64;
        }
    }
    return out;
}

fn report(label: ref String, words: ref Vec[String]) {
    let r = alien_order(words);
    println(f"{label} -> \"{r}\"");
}

fn main() {
    let mut a: Vec[String] = Vec.new();
    a.push("wrt"); a.push("wrf"); a.push("er"); a.push("ett"); a.push("rftt");
    report("[wrt,wrf,er,ett,rftt]", a);          // wertf

    let mut b: Vec[String] = Vec.new();
    b.push("z"); b.push("x");
    report("[z,x]", b);                          // zx

    // ★ the prefix violation — no edge is produced, so an add-edges-only
    // solver returns a plausible order for an unsortable input
    let mut c: Vec[String] = Vec.new();
    c.push("abc"); c.push("ab");
    report("[abc,ab]", c);                       // ""

    // the legal direction of the same shape
    let mut d: Vec[String] = Vec.new();
    d.push("ab"); d.push("abc");
    report("[ab,abc]", d);                       // abc

    // a two-cycle
    let mut e: Vec[String] = Vec.new();
    e.push("z"); e.push("x"); e.push("z");
    report("[z,x,z]", e);                        // ""

    // unconstrained letters still have to appear
    let mut f: Vec[String] = Vec.new();
    f.push("ab"); f.push("adc");
    report("[ab,adc]", f);                       // abcd — b<d, c unconstrained

    let mut g: Vec[String] = Vec.new();
    g.push("zy"); g.push("zx");
    report("[zy,zx]", g);                        // yxz

    let mut h: Vec[String] = Vec.new();
    h.push("aaa");
    report("[aaa]", h);                          // a

    let mut i: Vec[String] = Vec.new();
    report("[]", i);                             // ""
}
