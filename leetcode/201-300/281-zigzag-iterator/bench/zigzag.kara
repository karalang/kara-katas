// LeetCode 281 bench kernel — the cursor iterator, drained repeatedly.
//
// K MATTERS MORE THAN N HERE, which is what makes this worth benching at all.
// Both iterators are O(1) amortized per element, but the ★ cursor version's
// `settle` scans forward past exhausted lists — bounded by k, but only O(1) when
// few lists are dead. As lists drop out at different rounds that scan lengthens,
// so the interesting axis is MANY LISTS OF UNEQUAL LENGTH, not one long list.
//
// So: k = 64 lists whose lengths vary widely, drained end to end, repeated. Late
// in each drain most lists are exhausted and `settle` walks past them, which is
// exactly the cost the queue formulation exists to avoid — and the reason the
// two are worth comparing rather than just timing one.
//
// BUILD ONCE, PUNCH MANY TIMES: the lists are constructed once and each round
// re-drains them. Draining does not mutate the lists — only the iterator's own
// cursors — so no refresh is needed, which is the opposite of kata 280 where the
// reorder was in place and the refresh was load-bearing.
//
// THE SINK IS POSITION-WEIGHTED over the drained sequence. Interleaving is an
// ordering problem, so a sum would be invariant under every reordering bug.
//
// NO STRUCT HERE, unlike the kata's solvers. A struct field is OWNED, so a
// `Zigzag` holding the lists would have to take them by value and every round
// would copy 64 lists before iterating — the bench would measure copying. The
// state is three locals over a borrowed `ref Vec[Vec[i64]]` instead, which is
// the same algorithm with the ownership arranged for repetition rather than for
// the API the problem describes.

fn drain_sink(lists: ref Vec[Vec[i64]]) -> i64 {
    let k = lists.len();
    let mut cursor: Vec[i64] = Vec.new();
    let mut remaining = 0i64;
    let mut i = 0i64;
    while i < k {
        cursor.push(0i64);
        remaining = remaining + lists[i].len();
        i = i + 1i64;
    }

    let mut turn = 0i64;
    let mut tried = 0i64;
    while tried < k and cursor[turn] >= lists[turn].len() {
        turn = (turn + 1i64) % k;
        tried = tried + 1i64;
    }

    let mut h = 0i64;
    let mut pos = 1i64;
    while remaining > 0i64 {
        let t = turn;
        let v = lists[t][cursor[t]];
        cursor[t] = cursor[t] + 1i64;
        remaining = remaining - 1i64;
        h = (h * 31i64 + v * pos) % 1000000007i64;
        pos = pos + 1i64;
        // advance to the next list that still has elements, bounded by k
        turn = (t + 1i64) % k;
        let mut scan = 0i64;
        while scan < k and cursor[turn] >= lists[turn].len() {
            turn = (turn + 1i64) % k;
            scan = scan + 1i64;
        }
    }
    return h;
}

fn main() {
    let k = 64i64;
    let rounds = 2200i64;

    let mut lists: Vec[Vec[i64]] = Vec.new();
    let mut seed = 20260819i64;
    let mut i = 0i64;
    while i < k {
        // lengths spread over three orders of magnitude, so lists die at very
        // different rounds and `settle` has real work to do late in the drain
        seed = (seed * 1103515245i64 + 12345i64) % 2147483648i64;
        let len = 1i64 + (seed / 7i64) % 2000i64;
        let mut v: Vec[i64] = Vec.new();
        let mut j = 0i64;
        while j < len {
            seed = (seed * 1103515245i64 + 12345i64) % 2147483648i64;
            v.push(seed % 100003i64);
            j = j + 1i64;
        }
        lists.push(v);
        i = i + 1i64;
    }

    let mut sink = 0i64;
    let mut r = 0i64;
    while r < rounds {
        sink = (sink + drain_sink(lists)) % 1000000007i64;
        r = r + 1i64;
    }
    println(sink);
}
