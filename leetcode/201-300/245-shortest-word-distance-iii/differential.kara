fn lcg(state: i64) -> i64 {
    (state * 1103515245i64 + 12345i64) & 2147483647i64
}

fn unified(words: ref Vec[String], w1: ref String, w2: ref String) -> i64 {
    let n = words.len();
    let same = w1 == w2;
    let mut best = n;
    let mut prev = -1i64;
    let mut i = 0i64;
    while i < n {
        if words[i] == w1 or words[i] == w2 {
            if prev >= 0i64 and (same or words[prev] != words[i]) {
                best = min(best, i - prev);
            }
            prev = i;
        }
        i = i + 1i64;
    }
    return best;
}

fn split_alg(words: ref Vec[String], w1: ref String, w2: ref String) -> i64 {
    let n = words.len();
    let mut best = n;
    if w1 == w2 {
        let mut prev = -1i64;
        let mut i = 0i64;
        while i < n {
            if words[i] == w1 {
                if prev >= 0i64 {
                    best = min(best, i - prev);
                }
                prev = i;
            }
            i = i + 1i64;
        }
        return best;
    }
    let mut l1 = -1i64;
    let mut l2 = -1i64;
    let mut i = 0i64;
    while i < n {
        if words[i] == w1 {
            l1 = i;
            if l2 >= 0i64 { best = min(best, l1 - l2); }
        } else if words[i] == w2 {
            l2 = i;
            if l1 >= 0i64 { best = min(best, l2 - l1); }
        }
        i = i + 1i64;
    }
    return best;
}

fn positions_of(words: ref Vec[String], word: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let n = words.len();
    let mut i = 0i64;
    while i < n {
        if words[i] == word { out.push(i); }
        i = i + 1i64;
    }
    return out;
}

fn lists_alg(words: ref Vec[String], w1: ref String, w2: ref String) -> i64 {
    let n = words.len();
    let mut best = n;
    let p1 = positions_of(words, w1);
    if w1 == w2 {
        let mut a = 1i64;
        while a < p1.len() {
            best = min(best, p1[a] - p1[a - 1i64]);
            a = a + 1i64;
        }
        return best;
    }
    let p2 = positions_of(words, w2);
    let mut a = 0i64;
    let mut b = 0i64;
    while a < p1.len() and b < p2.len() {
        best = min(best, (p1[a] - p2[b]).abs());
        if p1[a] < p2[b] { a = a + 1i64; } else { b = b + 1i64; }
    }
    return best;
}

fn main() {
    let mut alpha: Vec[String] = Vec.new();
    alpha.push("a"); alpha.push("b"); alpha.push("c");

    let mut acc = 0i64;
    let mut s = 1i64;
    let mut mismatches = 0i64;
    let mut case = 0i64;
    while case < 4000i64 {
        s = lcg(s);
        let n = 1i64 + (s / 65536i64) % 9i64;
        let mut words: Vec[String] = Vec.new();
        let mut j = 0i64;
        while j < n {
            s = lcg(s);
            words.push(alpha[(s / 65536i64) % 3i64].clone());
            j = j + 1i64;
        }
        s = lcg(s);
        let w1 = alpha[(s / 65536i64) % 3i64];
        s = lcg(s);
        let w2 = alpha[(s / 65536i64) % 3i64];

        let u = unified(words, w1, w2);
        let sp = split_alg(words, w1, w2);
        let li = lists_alg(words, w1, w2);
        if u != sp or u != li {
            mismatches = mismatches + 1i64;
        }
        acc = (acc * 131i64 + u) % 1000000007i64;
        case = case + 1i64;
    }
    println(f"algorithms disagree on {mismatches} of 4000 cases");
    println(f"{acc}");
}
