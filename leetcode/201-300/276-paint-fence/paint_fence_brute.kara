// LeetCode 276 — enumerate every painting and count the legal ones.
//
// O(k^n) — hopeless past a dozen posts, and that is fine. It exists because it
// is the DEFINITION rather than a consequence of it: no recurrence, no states,
// no base cases to seed. It walks all `k^n` assignments and rejects the ones
// with three equal in a row, which is exactly what the problem says.
//
// WHY THAT MATTERS MORE THAN ITS COST. Both other solvers are the same
// derivation at different stages — the two-state form and the same recurrence
// with a variable eliminated. They share the `total[2] = k * k` fact and the
// "start at 3" convention, so a misunderstanding of the RULE (rather than an
// off-by-one in the loop) would be invisible to a comparison between them: they
// would agree, confidently, on the wrong count. 272 measured that exact failure
// and 275 showed a definitional check catching what three agreeing solvers
// could not.
//
// This is that check, and it is a solver rather than a validator because the
// answer here is a single number: there is nothing to validate the SHAPE of,
// only a count to recompute a different way.
//
// THE ODOMETER carries the colours as digits base `k` and increments with carry
// — the same shape as 275's combinations-with-repetition enumerator, minus the
// non-decreasing constraint, since here every assignment is a distinct painting.

fn num_ways(n: i64, k: i64) -> i64 {
    if n == 0i64 { return 0i64; }
    let mut colours: Vec[i64] = Vec.new();
    let mut z = 0i64;
    while z < n {
        colours.push(0i64);
        z = z + 1i64;
    }
    let mut count = 0i64;
    let mut more = true;
    while more {
        let mut ok = true;
        let mut i = 2i64;
        while i < n {
            if colours[i] == colours[i - 1i64] and colours[i - 1i64] == colours[i - 2i64] {
                ok = false;
            }
            i = i + 1i64;
        }
        if ok { count = count + 1i64; }

        // odometer: rightmost digit below k-1 gets bumped, everything right of
        // it rolls to zero
        let mut p = n - 1i64;
        while p >= 0i64 and colours[p] == k - 1i64 {
            colours[p] = 0i64;
            p = p - 1i64;
        }
        if p < 0i64 {
            more = false;
        } else {
            colours[p] = colours[p] + 1i64;
        }
    }
    return count;
}

fn main() {
    let cases: Vec[Vec[i64]] = [
        [1i64, 1i64], [1i64, 5i64], [2i64, 2i64], [3i64, 2i64], [7i64, 2i64],
        [2i64, 4i64], [3i64, 4i64], [4i64, 3i64], [10i64, 3i64], [20i64, 2i64],
    ];
    let mut i = 0i64;
    while i < cases.len() {
        let n = cases[i][0i64];
        let k = cases[i][1i64];
        println(f"n={n} k={k} -> {num_ways(n, k)}");
        i = i + 1i64;
    }
}
