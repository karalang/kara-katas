// Differential for LeetCode 289 — the three solvers must agree on every board.
//
// The three disagree in representation, not in rules: the ★ file packs two
// generations into one i64, the copy file keeps a second board, and the
// infinite file stores only live cells in a Set with no rectangle at all. A
// board where they diverge is a bug in whichever one is wrong, and running them
// against each other is the only way to find out which.
//
// WHY RANDOM BOARDS AND NOT JUST THE FAMOUS PATTERNS. Blinkers and gliders are
// sparse and well-behaved: every cell has few live neighbours and the
// interesting counts (2 and 3) show up in isolation. A dense random board
// drives the OTHER arms — counts of 4 through 8, which must all kill — and
// packs live cells against the border, which is where an in-place encoding
// leaks if `& 1` is ever forgotten. Three densities are swept for that reason:
// sparse boards exercise birth, dense boards exercise overpopulation.
//
// THE INVARIANTS ARE CHECKED TOO, because agreement alone would be satisfied
// by three identically-wrong solvers. A blinker must have period 2, a block
// must never change, and an empty board must stay empty — properties that hold
// for Conway's rules independent of any implementation here.

fn next_rand(state: i64) -> i64 {
    return (state * 1103515245i64 + 12345i64) & 2147483647i64;
}

fn live_neighbours(board: ref Vec[Vec[i64]], r: i64, c: i64) -> i64 {
    let rows = board.len();
    let cols = board[0].len();
    let mut n = 0i64;
    let mut dr = -1i64;
    while dr <= 1i64 {
        let mut dc = -1i64;
        while dc <= 1i64 {
            if not (dr == 0i64 and dc == 0i64) {
                let rr = r + dr;
                let cc = c + dc;
                if rr >= 0i64 and rr < rows and cc >= 0i64 and cc < cols {
                    n = n + (board[rr][cc] & 1i64);
                }
            }
            dc = dc + 1i64;
        }
        dr = dr + 1i64;
    }
    return n;
}

// --- arm 1: in-place two-bit encoding ---
fn step_inplace(board: mut ref Vec[Vec[i64]]) {
    let rows = board.len();
    let cols = board[0].len();
    let mut r = 0i64;
    while r < rows {
        let mut c = 0i64;
        while c < cols {
            let n = live_neighbours(board, r, c);
            let alive = (board[r][c] & 1i64) == 1i64;
            let lives = if alive { n == 2i64 or n == 3i64 } else { n == 3i64 };
            if lives { board[r][c] = board[r][c] | 2i64; }
            c = c + 1i64;
        }
        r = r + 1i64;
    }
    r = 0i64;
    while r < rows {
        let mut c = 0i64;
        while c < cols {
            board[r][c] = board[r][c] >> 1i64;
            c = c + 1i64;
        }
        r = r + 1i64;
    }
}

// --- arm 2: second board ---
fn step_copy(board: mut ref Vec[Vec[i64]]) {
    let rows = board.len();
    let cols = board[0].len();
    let mut next: Vec[Vec[i64]] = Vec.new();
    let mut r = 0i64;
    while r < rows {
        let mut row: Vec[i64] = Vec.new();
        let mut c = 0i64;
        while c < cols {
            let n = live_neighbours(board, r, c);
            let alive = board[r][c] == 1i64;
            let lives = if alive { n == 2i64 or n == 3i64 } else { n == 3i64 };
            if lives { row.push(1i64); } else { row.push(0i64); }
            c = c + 1i64;
        }
        next.push(row);
        r = r + 1i64;
    }
    r = 0i64;
    while r < rows {
        let mut c = 0i64;
        while c < cols {
            board[r][c] = next[r][c];
            c = c + 1i64;
        }
        r = r + 1i64;
    }
}

// --- arm 3: live-cell set, no rectangle ---
fn pack(r: i64, c: i64) -> i64 {
    return (r + 1000000i64) * 4000000i64 + (c + 1000000i64);
}
fn unpack_row(k: i64) -> i64 { return (k / 4000000i64) - 1000000i64; }
fn unpack_col(k: i64) -> i64 { return (k % 4000000i64) - 1000000i64; }

fn step_set(live: ref Set[i64]) -> Set[i64] {
    let mut tally: Map[i64, i64] = Map.new();
    for k in live {
        let r = unpack_row(k);
        let c = unpack_col(k);
        let mut dr = -1i64;
        while dr <= 1i64 {
            let mut dc = -1i64;
            while dc <= 1i64 {
                if not (dr == 0i64 and dc == 0i64) {
                    let nk = pack(r + dr, c + dc);
                    match tally.get(nk) {
                        None => { let _ = tally.insert(nk, 1i64); }
                        Some(v) => { let _ = tally.insert(nk, v + 1i64); }
                    }
                }
                dc = dc + 1i64;
            }
            dr = dr + 1i64;
        }
    }
    let mut next: Set[i64] = Set.new();
    for (k, n) in tally {
        if n == 3i64 or (n == 2i64 and live.contains(k)) {
            let _ = next.insert(k);
        }
    }
    return next;
}

fn to_set(board: ref Vec[Vec[i64]]) -> Set[i64] {
    let mut live: Set[i64] = Set.new();
    let rows = board.len();
    let mut r = 0i64;
    while r < rows {
        let cols = board[r].len();
        let mut c = 0i64;
        while c < cols {
            if board[r][c] == 1i64 { let _ = live.insert(pack(r, c)); }
            c = c + 1i64;
        }
        r = r + 1i64;
    }
    return live;
}

// COMPARING A BOUNDED ARM WITH AN UNBOUNDED ONE NEEDS A LIGHT CONE, and getting
// this wrong is the first thing this differential taught me. Windowing the set
// arm to the original rectangle and comparing looks obviously right and reports
// 570 mismatches out of 1800 — every one of them at step 2 or later, none at
// step 1. That is not a bug in any arm. The grid arms treat out-of-bounds as
// permanently dead; the set arm lets a cell escape the rectangle at step 1, and
// from OUTSIDE it legitimately feeds a birth back INSIDE at step 2. The two
// models genuinely differ, and the interior is only common ground for one step.
//
// The fix is to give the grid arm room. Clipping error propagates inward at one
// cell per generation, so padding the board with `steps + 1` dead cells on every
// side keeps the artificial border out of the original window for the whole run.
// Inside that window the bounded and unbounded models must then agree exactly,
// and any difference IS a bug.
fn pad_board(board: ref Vec[Vec[i64]], pad: i64) -> Vec[Vec[i64]] {
    let rows = board.len();
    let cols = board[0].len();
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut r = 0i64;
    while r < rows + 2i64 * pad {
        let mut row: Vec[i64] = Vec.new();
        let mut c = 0i64;
        while c < cols + 2i64 * pad {
            let sr = r - pad;
            let sc = c - pad;
            if sr >= 0i64 and sr < rows and sc >= 0i64 and sc < cols {
                row.push(board[sr][sc]);
            } else {
                row.push(0i64);
            }
            c = c + 1i64;
        }
        out.push(row);
        r = r + 1i64;
    }
    return out;
}

// Compare the set arm against a PADDED grid, over the original window only.
fn set_matches_padded(live: ref Set[i64], padded: ref Vec[Vec[i64]], pad: i64,
                      rows: i64, cols: i64) -> bool {
    let mut r = 0i64;
    while r < rows {
        let mut c = 0i64;
        while c < cols {
            let in_set = live.contains(pack(r, c));
            let in_grid = padded[r + pad][c + pad] == 1i64;
            if in_set != in_grid { return false; }
            c = c + 1i64;
        }
        r = r + 1i64;
    }
    return true;
}

fn grids_equal(a: ref Vec[Vec[i64]], b: ref Vec[Vec[i64]]) -> bool {
    let rows = a.len();
    let mut r = 0i64;
    while r < rows {
        let cols = a[r].len();
        let mut c = 0i64;
        while c < cols {
            if a[r][c] != b[r][c] { return false; }
            c = c + 1i64;
        }
        r = r + 1i64;
    }
    return true;
}

fn make_board(rows: i64, cols: i64, density: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut b: Vec[Vec[i64]] = Vec.new();
    let mut r = 0i64;
    while r < rows {
        let mut row: Vec[i64] = Vec.new();
        let mut c = 0i64;
        while c < cols {
            seed = next_rand(seed);
            let roll = (seed / 65536i64) % 100i64;
            if roll < density { row.push(1i64); } else { row.push(0i64); }
            c = c + 1i64;
        }
        b.push(row);
        r = r + 1i64;
    }
    return b;
}

fn main() {
    let mut seed = 987654321i64;
    let mut cases = 0i64;
    let mut mismatches = 0i64;
    let mut inplace_vs_copy = 0i64;
    let mut set_vs_grid = 0i64;

    // Three densities x several shapes x several step counts. Sparse boards
    // drive birth; dense boards drive the overpopulation arms.
    let densities: Vec[i64] = [15, 40, 70];
    let mut di = 0i64;
    while di < densities.len() {
        let density = densities[di];
        let mut rows = 3i64;
        while rows <= 7i64 {
            let mut cols = 3i64;
            while cols <= 7i64 {
                let mut trial = 0i64;
                while trial < 8i64 {
                    let base = make_board(rows, cols, density, mut seed);

                    let mut steps = 1i64;
                    while steps <= 3i64 {
                        let mut a = base.clone();
                        let mut b = base.clone();
                        let mut live = to_set(base);
                        // Padded twin: far enough that the border cannot reach
                        // the original window within `steps` generations.
                        let pad = steps + 1i64;
                        let mut p = pad_board(base, pad);

                        let mut k = 0i64;
                        while k < steps {
                            step_inplace(mut a);
                            step_copy(mut b);
                            step_inplace(mut p);
                            live = step_set(live);
                            k = k + 1i64;
                        }

                        cases = cases + 1i64;
                        if not grids_equal(a, b) {
                            mismatches = mismatches + 1i64;
                            inplace_vs_copy = inplace_vs_copy + 1i64;
                        }
                        if not set_matches_padded(live, p, pad, rows, cols) {
                            mismatches = mismatches + 1i64;
                            set_vs_grid = set_vs_grid + 1i64;
                        }
                        steps = steps + 1i64;
                    }
                    trial = trial + 1i64;
                }
                cols = cols + 1i64;
            }
            rows = rows + 1i64;
        }
        di = di + 1i64;
    }

    println(f"cases {cases}");
    println(f"mismatches {mismatches}");
    println(f"  in-place vs copy {inplace_vs_copy}");
    println(f"  set vs grid      {set_vs_grid}");

    // Invariants — agreement alone would be satisfied by three identical bugs.
    let mut inv_fail = 0i64;

    // A blinker has period 2.
    let blinker: Vec[Vec[i64]] = [[0, 0, 0], [1, 1, 1], [0, 0, 0]];
    let mut osc = blinker.clone();
    step_inplace(mut osc);
    if grids_equal(osc, blinker) { inv_fail = inv_fail + 1i64; }  // must DIFFER at 1
    step_inplace(mut osc);
    if not grids_equal(osc, blinker) { inv_fail = inv_fail + 1i64; }  // must RETURN at 2

    // A block never changes.
    let block: Vec[Vec[i64]] = [[1, 1], [1, 1]];
    let mut still = block.clone();
    let mut s = 0i64;
    while s < 5i64 {
        step_inplace(mut still);
        if not grids_equal(still, block) { inv_fail = inv_fail + 1i64; }
        s = s + 1i64;
    }

    // An empty board stays empty.
    let empty: Vec[Vec[i64]] = [[0, 0, 0], [0, 0, 0], [0, 0, 0]];
    let mut e = empty.clone();
    step_inplace(mut e);
    if not grids_equal(e, empty) { inv_fail = inv_fail + 1i64; }

    println(f"invariant failures {inv_fail}");
}
