// Randomized differential for LeetCode 248 — see differential.py for the
// design. Two answers per case that share no code path:
//
//   A. the kata algorithm — generate every strobogrammatic number of each
//      length in range, keep those inside the bounds (never parses a number);
//   B. brute force — walk every integer in [low, high] and re-derive the
//      property with the #246 two-pointer predicate (never generates one).
//
// Ranges are narrow (width <= 500) so B stays cheap while A still has to get
// lengths, boundaries and the leading-zero rule right. Prints a rolling hash
// of all 3000 counts; must match differential.py exactly, and must be
// identical across run/interp, run, build, and KARAC_AUTO_PAR=0 build.

fn lcg(state: i64) -> i64 {
    (state * 1103515245i64 + 12345i64) & 2147483647i64
}

fn build(k: i64, n: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if k == 0i64 {
        out.push("");
        return out;
    }
    if k == 1i64 {
        out.push("0");
        out.push("1");
        out.push("8");
        return out;
    }

    let mut pair_a: Vec[String] = Vec.new();
    let mut pair_b: Vec[String] = Vec.new();
    pair_a.push("0"); pair_b.push("0");
    pair_a.push("1"); pair_b.push("1");
    pair_a.push("6"); pair_b.push("9");
    pair_a.push("8"); pair_b.push("8");
    pair_a.push("9"); pair_b.push("6");

    let inner = build(k - 2i64, n);
    let mut i = 0i64;
    while i < inner.len() {
        let mut p = 0i64;
        while p < 5i64 {
            if pair_a[p] == "0" and k == n {
                p = p + 1i64;
            } else {
                let mut s: String = pair_a[p];
                s.push_str(inner[i]);
                s.push_str(pair_b[p]);
                out.push(s);
                p = p + 1i64;
            }
        }
        i = i + 1i64;
    }
    return out;
}

fn cmp_digits(a: ref String, b: ref String) -> i64 {
    let xs = a.bytes();
    let ys = b.bytes();
    if xs.len() != ys.len() {
        if xs.len() < ys.len() { return -1i64; }
        return 1i64;
    }
    let mut i = 0i64;
    while i < xs.len() {
        if xs[i] != ys[i] {
            if xs[i] < ys[i] { return -1i64; }
            return 1i64;
        }
        i = i + 1i64;
    }
    return 0i64;
}

fn count_gen(low: ref String, high: ref String) -> i64 {
    let lo_len = low.bytes().len();
    let hi_len = high.bytes().len();
    if lo_len > hi_len {
        return 0i64;
    }
    if lo_len == hi_len and cmp_digits(low, high) > 0i64 {
        return 0i64;
    }
    let mut total = 0i64;
    let mut len = lo_len;
    while len <= hi_len {
        let cands = build(len, len);
        let mut i = 0i64;
        while i < cands.len() {
            let s = cands[i];
            let mut keep = true;
            if len == lo_len and cmp_digits(s, low) < 0i64 {
                keep = false;
            }
            if len == hi_len and cmp_digits(s, high) > 0i64 {
                keep = false;
            }
            if keep {
                total = total + 1i64;
            }
            i = i + 1i64;
        }
        len = len + 1i64;
    }
    return total;
}

fn rotate_byte(b: u8) -> u8 {
    if b == 48u8 { return 48u8; }
    if b == 49u8 { return 49u8; }
    if b == 56u8 { return 56u8; }
    if b == 54u8 { return 57u8; }
    if b == 57u8 { return 54u8; }
    return 0u8;
}

fn is_strobo(num: ref String) -> bool {
    let bs = num.bytes();
    let mut lo = 0i64;
    let mut hi = bs.len() - 1i64;
    while lo <= hi {
        let r = rotate_byte(bs[lo]);
        if r == 0u8 or r != bs[hi] {
            return false;
        }
        lo = lo + 1i64;
        hi = hi - 1i64;
    }
    return true;
}

fn count_brute(lo_v: i64, hi_v: i64) -> i64 {
    let mut n = 0i64;
    let mut v = lo_v;
    while v <= hi_v {
        let s = f"{v}";
        if is_strobo(s) {
            n = n + 1i64;
        }
        v = v + 1i64;
    }
    return n;
}

fn main() {
    let mut state = 1i64;
    let mut acc = 0i64;
    let mut cases = 0i64;
    let mut mismatch = 0i64;

    let mut t = 0i64;
    while t < 3000i64 {
        state = lcg(state);
        let lo_hi = state / 65536i64;
        state = lcg(state);
        let lo_v = (lo_hi * 32768i64 + state / 65536i64) % 100000i64;
        state = lcg(state);
        let width = (state / 65536i64) % 501i64;
        let hi_v = lo_v + width;

        let low = f"{lo_v}";
        let high = f"{hi_v}";

        let g = count_gen(low, high);
        let b = count_brute(lo_v, hi_v);
        if g != b {
            if mismatch < 5i64 {
                println(f"MISMATCH low={low} high={high} gen={g} brute={b}");
            }
            mismatch = mismatch + 1i64;
        }
        acc = (acc * 131i64 + g) % 1000000007i64;
        cases = cases + 1i64;
        t = t + 1i64;
    }
    println(f"cases={cases} mismatch={mismatch} hash={acc}");
}
