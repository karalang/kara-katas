// Benchmark harness for LeetCode #246 — Strobogrammatic Number, ROW-VIEW form.
//
// This is the SECOND canonical spelling of the same benchmark, kept alongside
// `strobogrammatic.kara` rather than replacing it. The two differ in exactly one
// thing: how a row of the flat corpus reaches the checker.
//
//   strobogrammatic.kara   fn is_strobogrammatic(corpus: ref Vec[u8], base: i64, len: i64)
//                          ... corpus[base + lo] ... corpus[base + hi]
//   this file              fn is_strobogrammatic(row: Slice[u8], len: i64)
//                          ... row[lo] ... row[hi]        called with corpus[i*len .. i*len+len]
//
// WHY BOTH EXIST. The base+index form is what surfaces kara B-2026-08-05-21: it
// computes `base + lo` every iteration, and Kāra checks that add for integer
// overflow, which lands on the loop-carried critical path and costs 1.23x vs C.
// That form is the bug-finding surface and must NOT be deleted or "fixed" here.
//
// The row-view form is what C (`corpus + i*LEN`) and Rust (a row slice) actually
// do, so it is the honest parity spelling — and it reaches full C parity today:
// 15 instructions, no bounds check, no overflow check, 35.07 ms against C's
// 35.16 ms. Same corpus, same LCG, same sink (325454619) as every other lane.
//
// Not a workaround: no gap is being routed around, because the form that shows
// the gap is still in the tree next to this one. This file is evidence that the
// gap is a missing elision rather than a language limit.
//

fn lcg(state: i64) -> i64 {
    (state * 1103515245i64 + 12345i64) & 2147483647i64
}

// Byte-indexed, not `chars().collect()`. Kāra refuses `s[i]` outright — the
// diagnostic says "s[i] would hide an O(n) scan — Strings are UTF-8 encoded and
// characters are variable-width", and names both alternatives with their
// complexity: `char_at(i)` is O(n), `bytes()[i]` is O(1). The input here is
// ASCII digits, so `bytes()` is both correct and the honest parity choice: it
// is exactly what the C mirror does (index the bytes in place) and what Go and
// Rust do naturally (`num[i]`, `num.as_bytes()[i]`). Materialising a character
// vector per call would have made the Kāra lane do strictly more work than C
// and reported the difference as codegen quality.
//
// ASCII digit bytes: '0'=48 '1'=49 '6'=54 '8'=56 '9'=57. Zero means "does not
// survive rotation" — no digit maps to byte 0, so it is a safe sentinel here
// and avoids an Option in the hot loop (the KATA file keeps the Option[char]
// form; this is the benchmark's shape, stated rather than smuggled).
fn rotate_byte(b: u8) -> u8 {
    if b == 48u8 { return 48u8; }
    if b == 49u8 { return 49u8; }
    if b == 56u8 { return 56u8; }
    if b == 54u8 { return 57u8; }
    if b == 57u8 { return 54u8; }
    return 0u8;
}

// Offset into the flat corpus, exactly as the C mirror takes `corpus + i*LEN`.
fn is_strobogrammatic(row: Slice[u8], len: i64) -> bool {
    let mut lo = 0i64;
    let mut hi = len - 1i64;
    while lo <= hi {
        let r = rotate_byte(row[lo]);
        if r == 0u8 or r != row[hi] {
            return false;
        }
        lo = lo + 1i64;
        hi = hi - 1i64;
    }
    return true;
}

fn main() {
    let n = 20000i64;
    let len = 32i64;
    let passes = 100i64;

    let mut pair_a: Vec[u8] = Vec.new();
    let mut pair_b: Vec[u8] = Vec.new();
    pair_a.push(48u8); pair_b.push(48u8);
    pair_a.push(49u8); pair_b.push(49u8);
    pair_a.push(56u8); pair_b.push(56u8);
    pair_a.push(54u8); pair_b.push(57u8);
    pair_a.push(57u8); pair_b.push(54u8);

    let mut all: Vec[u8] = Vec.new();
    all.push(48u8); all.push(49u8); all.push(50u8); all.push(51u8); all.push(52u8);
    all.push(53u8); all.push(54u8); all.push(55u8); all.push(56u8); all.push(57u8);

    // One flat buffer, like every other lane.
    let mut corpus: Vec[u8] = Vec.filled(n * len, 48u8);

    let mut state = 1i64;
    let mut k = 0i64;
    while k < n {
        let base = k * len;
        let mut lo = 0i64;
        let mut hi = len - 1i64;
        while lo < hi {
            state = lcg(state);
            let p = (state / 65536i64) % 5i64;
            corpus[base + lo] = pair_a[p];
            corpus[base + hi] = pair_b[p];
            lo = lo + 1i64;
            hi = hi - 1i64;
        }
        state = lcg(state);
        if (state / 65536i64) % 8i64 == 0i64 {
            state = lcg(state);
            let pos = (state / 65536i64) % len;
            state = lcg(state);
            corpus[base + pos] = all[(state / 65536i64) % 10i64];
        }
        k = k + 1i64;
    }

    let mut acc = 0i64;
    let mut p = 0i64;
    while p < passes {
        let mut i = 0i64;
        while i < n {
            if is_strobogrammatic(corpus[i * len .. i * len + len], len) {
                acc = (acc * 131i64 + 1i64) % 1000000007i64;
            } else {
                acc = (acc * 131i64 + 0i64) % 1000000007i64;
            }
            i = i + 1i64;
        }
        p = p + 1i64;
    }
    println(f"{acc}");
}
