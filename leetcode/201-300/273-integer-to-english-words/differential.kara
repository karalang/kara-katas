// LeetCode 273 — differential harness.
//
// Three solvers over every integer 0..10,000, every power of ten and its
// neighbours, 20,000 uniform draws across 0 .. 2^31 - 1, and 20,000 numbers
// built to CONTAIN ZERO GROUPS: the ★ three-digit chunker
// (recursive, peels groups off the right, prepends), the positional walk (no
// grouping arithmetic at all, one lookahead for the teens, collects words and
// joins once) and the precomputed table (all 1,000 groups built bottom-up, then
// assembled by descending magnitude, appending).
//
// TWO LEXICON TRANSCRIPTIONS, ON PURPOSE. The chunker and the positional walk
// spell the twenty-eight words as an `if`-chain and SHARE it here, so they
// cannot cross-check a typo in it. The table solver holds the same words as
// array literals — a second, independent transcription — and that is what makes
// a lexicon typo a reported disagreement rather than three solvers politely
// agreeing on "Fourty". 269 is the reason this is spelled out: factoring one
// derivation into a single shared function took two injected bugs from detected
// to invisible.
//
// AND A FOURTH CHECK THAT COMPUTES NOTHING. Agreement between solvers cannot
// catch a mistake all three make — and all three are joining words with spaces,
// which is the same job done three ways. So every produced string is also run
// through a SHAPE oracle: split it on a single space and require that no token
// is empty and every token is in the vocabulary. An empty token is exactly a
// leading space, a trailing space or a doubled space, so one condition covers
// all three, and it holds no opinion about which number was being spelled.

fn small_name(n: i64) -> String {
    if n == 1i64 { return "One"; }
    if n == 2i64 { return "Two"; }
    if n == 3i64 { return "Three"; }
    if n == 4i64 { return "Four"; }
    if n == 5i64 { return "Five"; }
    if n == 6i64 { return "Six"; }
    if n == 7i64 { return "Seven"; }
    if n == 8i64 { return "Eight"; }
    if n == 9i64 { return "Nine"; }
    if n == 10i64 { return "Ten"; }
    if n == 11i64 { return "Eleven"; }
    if n == 12i64 { return "Twelve"; }
    if n == 13i64 { return "Thirteen"; }
    if n == 14i64 { return "Fourteen"; }
    if n == 15i64 { return "Fifteen"; }
    if n == 16i64 { return "Sixteen"; }
    if n == 17i64 { return "Seventeen"; }
    if n == 18i64 { return "Eighteen"; }
    if n == 19i64 { return "Nineteen"; }
    return "";
}

fn tens_name(t: i64) -> String {
    if t == 2i64 { return "Twenty"; }
    if t == 3i64 { return "Thirty"; }
    if t == 4i64 { return "Forty"; }
    if t == 5i64 { return "Fifty"; }
    if t == 6i64 { return "Sixty"; }
    if t == 7i64 { return "Seventy"; }
    if t == 8i64 { return "Eighty"; }
    if t == 9i64 { return "Ninety"; }
    return "";
}

fn scale_name(s: i64) -> String {
    if s == 1i64 { return "Thousand"; }
    if s == 2i64 { return "Million"; }
    if s == 3i64 { return "Billion"; }
    return "";
}

// ---- solver A: the ★ three-digit chunker -------------------------------------

fn group_name(n: i64) -> String {
    if n == 0i64 { return ""; }
    if n < 20i64 { return small_name(n); }
    if n < 100i64 {
        let t = tens_name(n / 10i64);
        let r = n % 10i64;
        if r == 0i64 { return t; }
        return t + " " + small_name(r);
    }
    let h = small_name(n / 100i64) + " Hundred";
    let r = group_name(n % 100i64);
    if r == "" { return h; }
    return h + " " + r;
}

fn chunker(n: i64) -> String {
    if n == 0i64 { return "Zero"; }
    let mut out = "";
    let mut rem = n;
    let mut scale = 0i64;
    while rem > 0i64 {
        let part = rem % 1000i64;
        if part > 0i64 {
            let mut piece = group_name(part);
            if scale > 0i64 { piece = piece + " " + scale_name(scale); }
            if out == "" { out = piece; } else { out = piece + " " + out; }
        }
        rem = rem / 1000i64;
        scale = scale + 1i64;
    }
    return out;
}

// ---- solver B: the positional walk -------------------------------------------

fn positional(n: i64) -> String {
    if n == 0i64 { return "Zero"; }
    let text = f"{n}";
    let digits = text.bytes();
    let len = digits.len();
    let mut words: Vec[String] = Vec.new();
    let mut group_nonempty = false;
    let mut i = 0i64;
    while i < len {
        let p = len - 1i64 - i;
        let place = p % 3i64;
        let scale = p / 3i64;
        let d = digits[i] as i64 - 48i64;
        let mut group_done = place == 0i64;
        if place == 2i64 {
            if d > 0i64 {
                words.push(small_name(d));
                words.push("Hundred");
                group_nonempty = true;
            }
        }
        if place == 1i64 {
            if d == 1i64 {
                let u = digits[i + 1i64] as i64 - 48i64;
                words.push(small_name(10i64 + u));
                group_nonempty = true;
                i = i + 1i64;
                group_done = true;
            } else {
                if d >= 2i64 {
                    words.push(tens_name(d));
                    group_nonempty = true;
                }
            }
        }
        if place == 0i64 {
            if d > 0i64 {
                words.push(small_name(d));
                group_nonempty = true;
            }
        }
        if group_done {
            if group_nonempty and scale > 0i64 { words.push(scale_name(scale)); }
            group_nonempty = false;
        }
        i = i + 1i64;
    }
    let mut out = "";
    let mut w = 0i64;
    while w < words.len() {
        if out != "" { out = out + " "; }
        out = out + words[w];
        w = w + 1i64;
    }
    return out;
}

// ---- solver C: the precomputed table (its own lexicon transcription) ---------

fn units_table() -> Vec[String] {
    return ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight",
            "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen",
            "Sixteen", "Seventeen", "Eighteen", "Nineteen"];
}

fn tens_table() -> Vec[String] {
    return ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy",
            "Eighty", "Ninety"];
}

fn scale_table() -> Vec[String] {
    return ["", "Thousand", "Million", "Billion"];
}

fn build_groups() -> Vec[String] {
    let u = units_table();
    let t = tens_table();
    let mut g: Vec[String] = Vec.new();
    let mut i = 0i64;
    while i < 20i64 { g.push(u[i]); i = i + 1i64; }
    let mut d = 2i64;
    while d < 10i64 {
        let mut r = 0i64;
        while r < 10i64 {
            if r == 0i64 { g.push(t[d]); } else { g.push(t[d] + " " + u[r]); }
            r = r + 1i64;
        }
        d = d + 1i64;
    }
    let mut h = 1i64;
    while h < 10i64 {
        let mut r = 0i64;
        while r < 100i64 {
            if r == 0i64 { g.push(u[h] + " Hundred"); }
            else { g.push(u[h] + " Hundred " + g[r]); }
            r = r + 1i64;
        }
        h = h + 1i64;
    }
    return g;
}

fn tabled(n: i64, g: ref Vec[String], s: ref Vec[String]) -> String {
    if n == 0i64 { return "Zero"; }
    let mut out = "";
    let mut rem = n;
    let mut div = 1000000000i64;
    let mut scale = 3i64;
    while div >= 1i64 {
        let part = rem / div;
        if part > 0i64 {
            if out != "" { out = out + " "; }
            out = out + g[part];
            if scale > 0i64 { out = out + " " + s[scale]; }
        }
        rem = rem % div;
        div = div / 1000i64;
        scale = scale - 1i64;
    }
    return out;
}

// ---- the shape oracle --------------------------------------------------------

fn vocabulary() -> Set[String] {
    let mut v: Set[String] = Set.new();
    let u = units_table();
    let mut i = 1i64;
    while i < u.len() { v.insert(u[i]); i = i + 1i64; }
    let t = tens_table();
    i = 2i64;
    while i < t.len() { v.insert(t[i]); i = i + 1i64; }
    v.insert("Hundred");
    v.insert("Thousand");
    v.insert("Million");
    v.insert("Billion");
    v.insert("Zero");
    return v;
}

// 0 = well-formed. An EMPTY token is a leading space, a trailing space or a
// doubled space, so the one condition covers all three shapes of join bug.
fn shape_ok(s: String, v: ref Set[String]) -> bool {
    if s == "" { return false; }
    let toks = s.split(" ");
    let mut i = 0i64;
    while i < toks.len() {
        if toks[i] == "" { return false; }
        if v.contains(toks[i]) == false { return false; }
        i = i + 1i64;
    }
    return true;
}

fn has_zero_group(n: i64) -> bool {
    // A zero group BELOW a nonzero one — the case that must emit nothing.
    let mut rem = n;
    let mut seen_nonzero_above = false;
    let mut groups: Vec[i64] = Vec.new();
    while rem > 0i64 { groups.push(rem % 1000i64); rem = rem / 1000i64; }
    let mut i = groups.len() - 1i64;
    while i >= 0i64 {
        if groups[i] == 0i64 and seen_nonzero_above { return true; }
        if groups[i] > 0i64 { seen_nonzero_above = true; }
        i = i - 1i64;
    }
    return false;
}

fn main() {
    let g = build_groups();
    let s = scale_table();
    let v = vocabulary();

    let mut probes: Vec[i64] = Vec.new();
    // exhaustive over the small range — every teen, every tens/units pair, and
    // every hundreds carry appears here many times over
    let mut n = 0i64;
    while n <= 10000i64 { probes.push(n); n = n + 1i64; }
    // every power of ten and its immediate neighbours: the zero-group cases
    let mut pw = 1i64;
    while pw <= 1000000000i64 {
        probes.push(pw - 1i64);
        probes.push(pw);
        probes.push(pw + 1i64);
        pw = pw * 10i64;
    }
    // and the whole range, sampled
    let mut seed = 273273i64;
    let mut r = 0i64;
    while r < 20000i64 {
        seed = (seed * 1103515245i64 + 12345i64) & 2147483647i64;
        probes.push(seed);
        r = r + 1i64;
    }
    // CONSTRUCTED ZERO GROUPS. A uniform draw over 0 .. 2^31 - 1 almost never
    // produces one — each group is zero with probability 1/1000, so 20,000 draws
    // yielded 91 — and the zero group is the whole reason `group_name` returns
    // the empty string. So build them: four groups, each independently zeroed a
    // third of the time. Same discipline as 270's constructed midpoints.
    r = 0i64;
    while r < 20000i64 {
        let mut x = 0i64;
        let mut mag = 1i64;
        let mut gi = 0i64;
        while gi < 4i64 {
            seed = (seed * 1103515245i64 + 12345i64) & 2147483647i64;
            let mut part = (seed / 256i64) % 1000i64;
            seed = (seed * 1103515245i64 + 12345i64) & 2147483647i64;
            if (seed / 256i64) % 3i64 == 0i64 { part = 0i64; }
            if gi == 3i64 { part = part % 3i64; }
            x = x + part * mag;
            mag = mag * 1000i64;
            gi = gi + 1i64;
        }
        probes.push(x);
        r = r + 1i64;
    }
    probes.push(2147483647i64);

    let mut mismatches = 0i64;
    let mut shape_bad = 0i64;
    let mut zero_group = 0i64;
    let mut teens = 0i64;
    let mut longest = 0i64;
    let mut digest = 0i64;

    let mut i = 0i64;
    while i < probes.len() {
        let x = probes[i];
        let a = chunker(x);
        let b = positional(x);
        let c = tabled(x, g, s);
        if a != b or a != c { mismatches = mismatches + 1i64; }
        if shape_ok(a, v) == false { shape_bad = shape_bad + 1i64; }
        if has_zero_group(x) { zero_group = zero_group + 1i64; }
        let m = x % 100i64;
        if m >= 10i64 and m <= 19i64 { teens = teens + 1i64; }
        if a.len() > longest { longest = a.len(); }
        let bytes = a.bytes();
        let mut q = 0i64;
        while q < bytes.len() {
            digest = (digest * 131i64 + bytes[q] as i64) % 1000000007i64;
            q = q + 1i64;
        }
        i = i + 1i64;
    }

    println(f"cases {probes.len()}");
    println(f"numbers with a ZERO GROUP below a nonzero one {zero_group}");
    println(f"numbers ending in a teen {teens}");
    println(f"longest spelling, bytes {longest}");
    println(f"shape violations {shape_bad}");
    println(f"digest {digest}");
    println(f"mismatches {mismatches}");
}
