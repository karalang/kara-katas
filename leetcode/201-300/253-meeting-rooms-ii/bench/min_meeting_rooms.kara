// Benchmark workload for LeetCode #253 — Meeting Rooms II.
//
// Build-once + punch. 150,000 intervals are generated and shuffled once; each
// round sorts a fresh copy by start and runs the min-heap room count to
// completion.
//
// Two choices keep this measuring the algorithm:
//
//   * Meetings OVERLAP heavily — starts are drawn from a window that advances
//     slowly relative to the durations, so the heap holds tens of entries rather
//     than one or two. A packed non-overlapping set would keep the heap at size
//     1 and measure only the sort.
//   * The set is SHUFFLED once and each round sorts a fresh copy of that order,
//     so no round after the first hits an already-sorted fast path.
//
// The heap sift depends on values the previous sift moved, so the maintenance is
// loop-carried and does not vectorize. Sink folds the peak room count per round.

fn heap_push(heap: mut ref Vec[i64], v: i64) {
    heap.push(v);
    let mut i = heap.len() - 1i64;
    while i > 0i64 {
        let parent = (i - 1i64) / 2i64;
        if heap[i] < heap[parent] {
            let tmp = heap[i];
            heap[i] = heap[parent];
            heap[parent] = tmp;
            i = parent;
        } else {
            break;
        }
    }
}

fn heap_pop(heap: mut ref Vec[i64]) {
    let n = heap.len();
    if n == 0i64 {
        return;
    }
    let last = match heap.pop() {
        Some(v) => v,
        None => 0i64,
    };
    if n == 1i64 {
        return;
    }
    heap[0i64] = last;
    let m = heap.len();
    let mut i = 0i64;
    while true {
        let l = 2i64 * i + 1i64;
        let r = 2i64 * i + 2i64;
        let mut smallest = i;
        if l < m and heap[l] < heap[smallest] {
            smallest = l;
        }
        if r < m and heap[r] < heap[smallest] {
            smallest = r;
        }
        if smallest == i {
            break;
        }
        let tmp = heap[i];
        heap[i] = heap[smallest];
        heap[smallest] = tmp;
        i = smallest;
    }
}

fn min_meeting_rooms(intervals: Slice[(i64, i64)]) -> i64 {
    let mut s: Vec[(i64, i64)] = Vec.from_slice(intervals);
    s.sort_by(|a, b| a.0.cmp(b.0));

    let mut heap: Vec[i64] = Vec.new();
    let mut rooms = 0i64;
    let mut i = 0i64;
    while i < s.len() {
        // Free every room whose meeting has already ended. `<=`: a meeting
        // ending exactly now releases its room for this one.
        while heap.len() > 0i64 and heap[0i64] <= s[i].0 {
            heap_pop(mut heap);
        }
        heap_push(mut heap, s[i].1);
        if heap.len() > rooms {
            rooms = heap.len();
        }
        i = i + 1i64;
    }
    return rooms;
}

fn main() {
    let n = 150000i64;
    let rounds = 25i64;

    // ---- build once: heavily overlapping, then shuffled ------------------
    let mut base: Vec[(i64, i64)] = Vec.new();
    let mut state = 253253i64;
    let mut i = 0i64;
    while i < n {
        state = (state * 1103515245i64 + 12345i64) & 2147483647i64;
        // Start advances ~1 per meeting; durations reach ~60, so roughly 30
        // meetings are live at any instant and the heap stays deep.
        let jitter = (state / 65536i64) % 8i64;
        state = (state * 1103515245i64 + 12345i64) & 2147483647i64;
        let dur = (state / 65536i64) % 60i64 + 1i64;
        let s = i + jitter;
        base.push((s, s + dur));
        i = i + 1i64;
    }
    let mut k = base.len() - 1i64;
    while k > 0i64 {
        state = (state * 1103515245i64 + 12345i64) & 2147483647i64;
        let wd0 = state / 65536i64;
        state = (state * 1103515245i64 + 12345i64) & 2147483647i64;
        let swap = (wd0 * 32768i64 + state / 65536i64) % (k + 1i64);
        let tmp = base[k];
        base[k] = base[swap];
        base[swap] = tmp;
        k = k - 1i64;
    }

    // ---- punch -----------------------------------------------------------
    let mut sink = 0i64;
    let mut r = 0i64;
    while r < rounds {
        let mut s: Vec[(i64, i64)] = Vec.new();
        let mut c = 0i64;
        while c < n {
            s.push(base[c]);
            c = c + 1i64;
        }
        s.sort_by(|a, b| a.0.cmp(b.0));

        let mut heap: Vec[i64] = Vec.new();
        let mut rooms = 0i64;
        let mut j = 0i64;
        while j < n {
            while heap.len() > 0i64 and heap[0i64] <= s[j].0 {
                heap_pop(mut heap);
            }
            heap_push(mut heap, s[j].1);
            if heap.len() > rooms {
                rooms = heap.len();
            }
            j = j + 1i64;
        }
        sink = (sink * 31i64 + rooms) % 1000000007i64;
        r = r + 1i64;
    }
    println(sink);
}
