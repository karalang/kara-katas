// Benchmark workload for LeetCode #263 — Ugly Number.
//
// A pure-arithmetic lane: nothing is built once, nothing is allocated in the
// punch loop, and the working set is a handful of registers. It is the opposite
// end of the corpus from #261's random dependent load.
//
// WHY THE gcd FORM AND NOT THE ★ TRIAL DIVISION. The ★ solver divides by the
// literals 2, 3 and 5, which every backend here strength-reduces to a
// multiply-high and a shift — no division instruction is emitted at all. That is
// already the subject of #258, and re-measuring it would add nothing.
//
// Euclid's algorithm cannot be strength-reduced: `x % y` has a VARIABLE divisor,
// so it lowers to a real hardware divide, and the loop is a serial dependency
// chain of them. That makes this the corpus's variable-divisor division lane,
// and a direct complement to #258 — where the natural explanation for Go's 28%
// gap (that Go emits real division where LLVM strength-reduces) was refuted by
// disassembly showing zero DIVQ anywhere. Here there is nothing BUT division.
//
// The operands are deliberately wide. Values are drawn across the full positive
// i64 range rather than the i32 range the problem's constraints allow, because
// 64-bit division cost depends on operand magnitude on several of these
// microarchitectures, and a lane that only ever divided small numbers would be
// measuring the easy case.
//
// Ugly numbers are vanishingly rare among random draws (~11,000 below 2⁶³), so
// a purely random sweep would only ever measure the first-rejection path. Every
// 512th value is therefore replaced by a constructed ugly number, which peels
// all the way down and exercises the repeat-until-gcd-is-1 loop.

fn gcd(a: i64, b: i64) -> i64 {
    let mut x = a;
    let mut y = b;
    while y != 0i64 {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
}

fn is_ugly(n: i64) -> bool {
    if n <= 0i64 {
        return false;
    }
    let mut m = n;
    let mut g = gcd(m, 30i64);
    while g > 1i64 {
        m = m / g;
        g = gcd(m, 30i64);
    }
    return m == 1i64;
}

fn main() {
    let n = 10000000i64;
    let limit = i64.MAX;

    // A small ring of genuinely ugly numbers, built once. Each is a product of
    // 2s, 3s and 5s grown as far as i64 allows, so peeling one is a long loop.
    let mut ring: Vec[i64] = Vec.new();
    let mut rs = 7717i64;
    let mut k = 0i64;
    while k < 64i64 {
        let mut v = 1i64;
        let mut steps = 0i64;
        while steps < 40i64 {
            rs = (rs * 1103515245i64 + 12345i64) & 2147483647i64;
            let pick = (rs / 65536i64) % 3i64;
            let mut f = 2i64;
            if pick == 1i64 { f = 3i64; }
            if pick == 2i64 { f = 5i64; }
            if v <= limit / f {
                v = v * f;
            } else {
                steps = 40i64;
            }
            steps = steps + 1i64;
        }
        ring.push(v);
        k = k + 1i64;
    }

    // ---- punch -----------------------------------------------------------
    let mut state = 263263i64;
    let mut uglies = 0i64;
    let mut digest = 0i64;
    let mut i = 0i64;
    while i < n {
        // Two 31-bit draws combined into a wide positive i64.
        state = (state * 1103515245i64 + 12345i64) & 2147483647i64;
        let hi = state;
        state = (state * 1103515245i64 + 12345i64) & 2147483647i64;
        let mut probe = hi * 2147483648i64 + state;
        if i % 512i64 == 0i64 {
            probe = ring[(i / 512i64) % 64i64];
        }
        // Fold EVERY verdict, not only the trues. Ugly numbers are so rare
        // among random draws that a trues-only sink would be determined
        // entirely by the ring, leaving the random path unchecked — a mirror
        // could get it wrong and still match.
        let mut bit = 0i64;
        if is_ugly(probe) {
            uglies = uglies + 1i64;
            bit = 1i64;
        }
        digest = (digest * 131i64 + bit * 7i64 + probe % 1000003i64) % 1000000007i64;
        i = i + 1i64;
    }

    println(uglies);
    println(digest);
}
