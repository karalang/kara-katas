// Benchmark workload for LeetCode #252 — Meeting Rooms.
//
// Build-once + punch. One packed, ATTENDABLE set of 120,000 intervals is built
// and shuffled once; each round copies it, sorts by start, and runs the adjacent
// overlap scan to completion.
//
// Two choices make this measure the algorithm rather than an early exit:
//
//   * The set is ATTENDABLE. A clashing set returns at the first conflict, so a
//     benchmark over one would measure how quickly a clash appears — i.e. the
//     generator — not the scan. Only the attendable case walks all n.
//   * The set is SHUFFLED once, and each round sorts a fresh copy of the
//     shuffled order. Sorting an already-sorted array takes a different path in
//     every implementation here, and re-sorting the output of the previous round
//     would measure that path from round 2 onward.
//
// The sort is the load-bearing step (O(n log n) against the scan's O(n)), so
// this lane is largely a cross-language comparison of sorting 120k pairs by a
// key — with a data-dependent scan on top that cannot be vectorized away.

fn main() {
    let n = 120000i64;
    let rounds = 40i64;

    // ---- build once: packed, attendable, then shuffled -------------------
    let mut base: Vec[(i64, i64)] = Vec.new();
    let mut state = 252252i64;
    let mut cursor = 0i64;
    let mut i = 0i64;
    while i < n {
        state = (state * 1103515245i64 + 12345i64) & 2147483647i64;
        let dur = (state / 65536i64) % 7i64 + 1i64;
        state = (state * 1103515245i64 + 12345i64) & 2147483647i64;
        let gap = (state / 65536i64) % 3i64;
        base.push((cursor, cursor + dur));
        cursor = cursor + dur + gap;
        i = i + 1i64;
    }
    let mut k = base.len() - 1i64;
    while k > 0i64 {
        state = (state * 1103515245i64 + 12345i64) & 2147483647i64;
        let swap = (state / 65536i64) % (k + 1i64);
        let tmp = base[k];
        base[k] = base[swap];
        base[swap] = tmp;
        k = k - 1i64;
    }

    // ---- punch -----------------------------------------------------------
    let mut sink = 0i64;
    let mut r = 0i64;
    while r < rounds {
        let mut s: Vec[(i64, i64)] = Vec.new();
        let mut c = 0i64;
        while c < n {
            s.push(base[c]);
            c = c + 1i64;
        }
        s.sort_by(|a, b| a.0.cmp(b.0));

        let mut ok = true;
        let mut j = 1i64;
        while j < n {
            if s[j].0 < s[j - 1i64].1 {
                ok = false;
            }
            j = j + 1i64;
        }
        // Fold the verdict AND the sorted span, so a wrong sort is caught.
        if ok {
            sink = (sink * 31i64 + 1i64) % 1000000007i64;
        } else {
            sink = (sink * 31i64) % 1000000007i64;
        }
        sink = (sink * 131i64 + s[n - 1i64].1 - s[0i64].0) % 1000000007i64;
        r = r + 1i64;
    }
    println(sink);
}
