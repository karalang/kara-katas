// LeetCode #2847: Smallest Number With Given Digit Product -- by the
// exponents of 2, 3, 5 and 7: every pair of 3s is a 9 and every three
// 2s an 8, each 5 and each 7 its own digit, and what is left, at most
// one 3 and two 2s, becomes the fewest and smallest digits by a table;
// the digits then counted out smallest first.

fn smallest_number(n: i64) -> String {
    if n == 1 {
        return "1".to_string();
    }
    let mut rest = n;
    let mut power: SortedMap[i64, i64] = SortedMap.new();
    for p in [2, 3, 5, 7] {
        let mut e = 0;
        while rest % p == 0 {
            rest /= p;
            e += 1;
        }
        power.insert(p, e);
    }
    if rest != 1 {
        return "-1".to_string();
    }
    let mut count = [0; 10];
    count[9] = power[3] / 2;
    count[8] = power[2] / 3;
    count[5] = power[5];
    count[7] = power[7];
    // a 3 and up to two 2s: nothing, 2, 4; 3, 6, or 2 and 6
    match (power[3] % 2, power[2] % 3) {
        (0, 0) => {}
        (0, 1) => count[2] += 1,
        (0, 2) => count[4] += 1,
        (1, 0) => count[3] += 1,
        (1, 1) => count[6] += 1,
        _ => {
            count[2] += 1;
            count[6] += 1;
        }
    }
    let mut out = String.new();
    for d in 2..10 {
        for _ in 0..count[d] {
            out.push_str(f"{d}");
        }
    }
    out
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; 1; 10^18, LeetCode's most; the largest
    // power of 2 and of 3 in range; and a prime above 9
    println(f"{smallest_number(105)} {smallest_number(7)} {smallest_number(44)} {smallest_number(1)}");
    println(f"{smallest_number(1000000000000000000)}");
    println(f"{smallest_number(1 << 59)} {smallest_number(450283905890997363)} {smallest_number(1000000007)}");
    // 3000 random products of up to 12 of 2, 3, 5 and 7, a fifth of them
    // then times 11 or 13; then 300 of up to 40, as many as stay within
    // 10^18
    let mut seed = 2847;
    let mut check = 0;
    let mut none = 0;
    for c in 0..3300 {
        let mut n = 1;
        let factors = next_random(mut seed) % if c < 3000 { 13 } else { 41 };
        for _ in 0..factors {
            let p = [2, 3, 5, 7][next_random(mut seed) % 4];
            if n <= 1000000000000000000 / p {
                n *= p;
            }
        }
        if c < 3000 and next_random(mut seed) % 5 == 0 {
            n *= [11, 13][next_random(mut seed) % 2];
        }
        let s = smallest_number(n);
        if s == "-1" {
            none += 1;
        }
        for b in s.bytes() {
            check = (check * 31 + b) % 1000000007;
        }
        if c == 2999 {
            println(f"3000 short products: {none} with none, checksum {check}");
            none = 0;
            check = 0;
        }
    }
    println(f"300 long products: {none} with none, checksum {check}");
}
