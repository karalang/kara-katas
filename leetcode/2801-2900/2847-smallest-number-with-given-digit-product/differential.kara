// LeetCode #2847: Smallest Number With Given Digit Product -- the
// differential. The five arms, against the statement read literally:
// every number from 1 to 99999 in order, each digit product's first
// number kept in a `Map`, so a product made by some number of up to 5
// digits has its smallest one; for any other the answer must be -1 or
// longer than 5 digits. 2000 random products of up to 4 digits from 2
// to 9, a sixth of them times 11 or 13, then 50 products of 2, 3, 5 and
// 7 up to 10^17, all drawn before any arm answers.
//
// P1  the answer is the literal reading's, or past its reach
// P2  the answer's digits multiply to n
// P3  n times 7: the same digits with a 7 sorted in (7 for n = 1), or -1 again
// P4  n times 11: -1
// P5  the answer's digits run smallest first, with no 0, and no 1 but for n = 1
// P6  each arm agrees with at least three of the other four

fn literal_table() -> Map[i64, i64] {
    let mut first: Map[i64, i64] = Map.new();
    for x in 1..100000 {
        let product: i64 = f"{x}".chars().map(|c| (c as i64) - ('0' as i64)).product();
        if product > 0 and not first.contains_key(product) {
            first.insert(product, x);
        }
    }
    first
}


// ---- star (product.kara) --------------------------------------------

fn star_smallest_number(n: i64) -> String {
    if n == 1 {
        return "1".to_string();
    }
    let mut rest = n;
    let mut digits: Vec[char] = Vec.new();
    for d in (2..10).rev() {
        while rest % d == 0 {
            digits.push(char.from_digit(d as u32, 10).unwrap());
            rest /= d;
        }
    }
    if rest != 1 {
        return "-1".to_string();
    }
    digits.iter().rev().collect()
}


// ---- primes (product_primes.kara) -----------------------------------

fn primes_smallest_number(n: i64) -> String {
    if n == 1 {
        return "1".to_string();
    }
    let mut rest = n;
    let mut power: SortedMap[i64, i64] = SortedMap.new();
    for p in [2, 3, 5, 7] {
        let mut e = 0;
        while rest % p == 0 {
            rest /= p;
            e += 1;
        }
        power.insert(p, e);
    }
    if rest != 1 {
        return "-1".to_string();
    }
    let mut count = [0; 10];
    count[9] = power[3] / 2;
    count[8] = power[2] / 3;
    count[5] = power[5];
    count[7] = power[7];
    // a 3 and up to two 2s: nothing, 2, 4; 3, 6, or 2 and 6
    match (power[3] % 2, power[2] % 3) {
        (0, 0) => {}
        (0, 1) => count[2] += 1,
        (0, 2) => count[4] += 1,
        (1, 0) => count[3] += 1,
        (1, 1) => count[6] += 1,
        _ => {
            count[2] += 1;
            count[6] += 1;
        }
    }
    let mut out = String.new();
    for d in 2..10 {
        for _ in 0..count[d] {
            out.push_str(f"{d}");
        }
    }
    out
}


// ---- memo (product_memo.kara) ---------------------------------------

fn memo_best(m: i64, memo: mut ref Map[i64, Option[String]]) -> Option[String] {
    if m == 1 {
        return Some(String.new());
    }
    if let Some(known) = memo.get(m) {
        return known.clone();
    }
    let mut winner: Option[String] = None;
    for d in 2..10 {
        if m % d == 0 {
            if let Some(rest) = memo_best(m / d, mut memo) {
                let mut digits: Vec[char] = rest.chars().collect();
                digits.push(char.from_digit(d as u32, 10).unwrap());
                digits.sort();
                let candidate: String = digits.iter().collect();
                let better = match winner {
                    None => true,
                    Some(ref w) => candidate.len() < w.len() or (candidate.len() == w.len() and candidate < w),
                };
                if better {
                    winner = Some(candidate);
                }
            }
        }
    }
    memo.insert(m, winner.clone());
    winner
}

fn memo_smallest_number(n: i64) -> String {
    if n == 1 {
        return "1".to_string();
    }
    let mut memo: Map[i64, Option[String]] = Map.new();
    memo_best(n, mut memo) ?? "-1".to_string()
}


// ---- peel (product_peel.kara) ---------------------------------------

fn peel_peel(n: i64) -> Option[String] {
    if n == 1 {
        return Some(String.new());
    }
    let d = (2..10).rev().find(|d| n % d == 0)?;
    let front = peel_peel(n / d)?;
    Some(f"{front}{d}")
}

fn peel_smallest_number(n: i64) -> String {
    if n == 1 { "1".to_string() } else { peel_peel(n) ?? "-1".to_string() }
}


// ---- solution (product_solution.kara) -------------------------------

struct Solution {}

impl Solution {
    pub fn smallest_number(n: i64) -> String {
        let mut n = n;
        if n == 1 {
            return "1".to_string();
        }
        let mut s = String.new();
        for d in (2..=9).rev() {
            while n % d == 0 {
                s.push((b'0' + d as u8) as char);
                n /= d;
            }
        }
        if n != 1 {
            return "-1".to_string();
        }
        s.chars().rev().collect()
    }
}

fn solution_smallest_number(n: i64) -> String {
    Solution.smallest_number(n)
}


// ---- the check ---------------------------------------------------------

fn answer(arm: i64, n: i64) -> String {
    match arm {
        0 => star_smallest_number(n),
        1 => primes_smallest_number(n),
        2 => memo_smallest_number(n),
        3 => peel_smallest_number(n),
        _ => solution_smallest_number(n),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn digit_product(s: Str) -> i64 {
    s.chars().map(|c| (c as i64) - ('0' as i64)).product()
}

fn with_seven(s: Str) -> String {
    let mut digits: Vec[char] = s.chars().collect();
    digits.push('7');
    digits.sort();
    digits.iter().collect()
}

fn main() {
    let names = ["star", "primes", "memo", "peel", "solution"];
    let table = literal_table();
    let mut seed = 2847;
    let mut cases: Vec[i64] = Vec.new();
    for c in 0..2050 {
        let mut n = 1;
        if c < 2000 {
            for _ in 0..next_random(mut seed) % 5 {
                n *= next_random(mut seed) % 8 + 2;
            }
            if next_random(mut seed) % 6 == 0 {
                n *= [11, 13][next_random(mut seed) % 2];
            }
        } else {
            for _ in 0..next_random(mut seed) % 50 {
                let p = [2, 3, 5, 7][next_random(mut seed) % 4];
                if n <= 100000000000000000 / p {
                    n *= p;
                }
            }
        }
        cases.push(n);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, n) in cases.iter().enumerate() {
        let got: Vec[String] = (0..5).map(|arm| answer(arm, n)).collect();
        for b in got[0].bytes() {
            check = (check * 31 + b) % 1000000007;
        }
        for arm in 0..5 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let none = value == "-1";
            let literal = match table.get(n) {
                Some(x) => value == f"{x}",
                None => none or value.len() > 5,
            };
            let sevens = answer(arm, 7 * n);
            let bytes = value.bytes();
            let ordered = (1..bytes.len()).all(|i| bytes[i - 1] <= bytes[i]);
            let verdicts = [
                literal,
                none or digit_product(value) == n,
                if none { sevens == "-1" } else if n == 1 { sevens == "7" } else { sevens == with_seven(value) },
                answer(arm, 11 * n) == "-1",
                none or (ordered and not value.contains("0") and (n == 1 or not value.contains("1"))),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} n={n}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
