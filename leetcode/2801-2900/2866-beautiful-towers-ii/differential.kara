// LeetCode #2866: Beautiful Towers II -- the differential. The five arms,
// against the statement read literally: every way to give each tower a
// height from 1 to its most, kept when the heights rise to a peak and
// then fall, the largest sum taken. 2000 random arrays of 1 to 6 towers
// of most 1 to 4, then 50 of up to 20000, every other one up to 10^9 and
// one in four sorted, all drawn before any arm answers; the literal
// reading is asked only of the first 2000.
//
// P1  up to 6 towers, the answer is the literal reading's
// P2  the towers reversed: the same answer
// P3  every most doubled: twice the answer
// P4  a tower of most 1 added at the end: one more
// P5  from max + (n - 1) * min to the sum, and the sum exactly when the
//     mosts already make a mountain
// P6  each arm agrees with at least three of the other four

fn mountain(heights: Vec[i64]) -> bool {
    let mut fallen = false;
    for i in 1..heights.len() {
        if heights[i] < heights[i - 1] {
            fallen = true;
        } else if heights[i] > heights[i - 1] and fallen {
            return false;
        }
    }
    true
}

fn search(most: Vec[i64], heights: mut ref Vec[i64]) -> i64 {
    if heights.len() == most.len() {
        return if mountain(heights) { heights.iter().sum() } else { 0 };
    }
    let mut best = 0;
    for h in 1..most[heights.len()] + 1 {
        heights.push(h);
        best = best.max(search(most, mut heights));
        heights.pop();
    }
    best
}

fn literal(most: Vec[i64]) -> i64 {
    let mut heights: Vec[i64] = Vec.new();
    search(most, mut heights)
}


// ---- star (towers.kara) ---------------------------------------------

fn star_maximum_sum_of_heights(max_heights: Vec[i64]) -> i64 {
    let n = max_heights.len();
    let mut left: Vec[i64] = Vec.filled(n, 0);
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..n {
        while not stack.is_empty() and max_heights[stack[stack.len() - 1]] > max_heights[i] {
            stack.pop();
        }
        left[i] = match stack.last() {
            Some(j) => left[*j] + (i - *j) * max_heights[i],
            None => (i + 1) * max_heights[i],
        };
        stack.push(i);
    }
    stack.clear();
    let mut best = 0;
    let mut right: Vec[i64] = Vec.filled(n, 0);
    for i in (0..n).rev() {
        while not stack.is_empty() and max_heights[stack[stack.len() - 1]] > max_heights[i] {
            stack.pop();
        }
        right[i] = match stack.last() {
            Some(j) => right[*j] + (*j - i) * max_heights[i],
            None => (n - i) * max_heights[i],
        };
        stack.push(i);
        best = best.max(left[i] + right[i] - max_heights[i]);
    }
    best
}


// ---- jumps (towers_jumps.kara) --------------------------------------

fn jumps_sides(heights: Vec[i64]) -> Vec[i64] {
    let n = heights.len();
    let mut found: Vec[i64] = Vec.filled(n, -1);
    let mut side: Vec[i64] = Vec.filled(n, 0);
    for i in 0..n {
        let mut j = i - 1;
        while j >= 0 and heights[j] > heights[i] {
            j = found[j];
        }
        found[i] = j;
        side[i] = (i - j) * heights[i] + if j >= 0 { side[j] } else { 0 };
    }
    side
}

fn jumps_maximum_sum_of_heights(max_heights: Vec[i64]) -> i64 {
    let n = max_heights.len();
    let left = jumps_sides(max_heights);
    let mut reversed = max_heights.clone();
    reversed.reverse();
    let right = jumps_sides(reversed);
    (0..n).map(|i| left[i] + right[n - 1 - i] - max_heights[i]).max().unwrap()
}


// ---- runs (towers_runs.kara) ----------------------------------------

fn runs_sides(heights: Vec[i64]) -> Vec[i64] {
    let mut runs: Vec[(i64, i64)] = Vec.new();
    let mut sum = 0;
    let mut out: Vec[i64] = Vec.new();
    for h in heights.iter() {
        let mut count = 1;
        while let Some((top, many)) = runs.last().cloned() {
            if top <= h {
                break;
            }
            runs.pop();
            sum -= top * many;
            count += many;
        }
        runs.push((h, count));
        sum += h * count;
        out.push(sum);
    }
    out
}

fn runs_maximum_sum_of_heights(max_heights: Vec[i64]) -> i64 {
    let n = max_heights.len();
    let left = runs_sides(max_heights);
    let right = runs_sides(max_heights.iter().rev().cloned().collect());
    (0..n).map(|i| left[i] + right[n - 1 - i] - max_heights[i]).max().unwrap()
}


// ---- split (towers_split.kara) --------------------------------------

fn split_lowest(table: Vec[Vec[i64]], heights: Vec[i64], lo: i64, hi: i64) -> i64 {
    let mut k = 0;
    while 2 << k <= hi - lo + 1 {
        k += 1;
    }
    let a = table[k][lo];
    let b = table[k][hi - (1 << k) + 1];
    if heights[b] < heights[a] { b } else { a }
}

fn split_maximum_sum_of_heights(max_heights: Vec[i64]) -> i64 {
    let n = max_heights.len();
    let mut table: Vec[Vec[i64]] = Vec.new();
    table.push((0..n).collect());
    let mut k = 0;
    while 2 << k <= n {
        let last = ref table[k];
        let half = 1 << k;
        let next: Vec[i64] = (0..n - 2 * half + 1)
            .map(|i| if max_heights[last[i + half]] < max_heights[last[i]] { last[i + half] } else { last[i] })
            .collect();
        table.push(next);
        k += 1;
    }
    // each range's lowest tower, with its range and its two children's
    let mut order: Vec[(i64, i64, i64, i64, i64)] = Vec.new();
    let mut pending: Vec[(i64, i64)] = [(0, n - 1)].to_vec();
    while let Some((lo, hi)) = pending.pop() {
        let m = split_lowest(table, max_heights, lo, hi);
        let left = if lo < m { split_lowest(table, max_heights, lo, m - 1) } else { -1 };
        let right = if m < hi { split_lowest(table, max_heights, m + 1, hi) } else { -1 };
        order.push((m, lo, hi, left, right));
        if left >= 0 {
            pending.push((lo, m - 1));
        }
        if right >= 0 {
            pending.push((m + 1, hi));
        }
    }
    let mut best: Vec[i64] = Vec.filled(n, 0);
    for (m, lo, hi, left, right) in order.iter().rev() {
        let low = max_heights[m];
        let from_left = if left >= 0 { best[left] } else { 0 };
        let from_right = if right >= 0 { best[right] } else { 0 };
        best[m] = (from_left + low * (hi - m + 1)).max(from_right + low * (m - lo + 1));
    }
    best[order[0].0]
}


// ---- solution (towers_solution.kara) --------------------------------

struct Solution {}

impl Solution {
    pub fn maximum_sum_of_heights(max_heights: Vec[i32]) -> i64 {
        let n = max_heights.len();
        let mut left = Vec.filled(n, 0);
        let mut right = Vec.filled(n, 0);
        let mut st: Vec[i64] = Vec.new();
        for i in 0..n {
            let x = max_heights[i] as i64;
            while not st.is_empty() and max_heights[*st.last().unwrap()] > x {
                st.pop();
            }
            left[i] = if let Some(j) = st.last().cloned() {
                left[j] + x * (i - j)
            } else {
                x * (i + 1)
            };
            st.push(i);
        }
        st.clear();
        for i in (0..n).rev() {
            let x = max_heights[i] as i64;
            while not st.is_empty() and max_heights[*st.last().unwrap()] > x {
                st.pop();
            }
            right[i] = if let Some(j) = st.last().cloned() {
                right[j] + x * (j - i)
            } else {
                x * (n - i)
            };
            st.push(i);
        }
        (0..n).map(|i| left[i] + right[i] - max_heights[i]).max().unwrap()
    }
}

fn solution_maximum_sum_of_heights(max_heights: Vec[i64]) -> i64 {
    Solution.maximum_sum_of_heights(max_heights.iter().map(|x| x as i32).collect())
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, heights: Vec[i64]) -> i64 {
    match arm {
        0 => star_maximum_sum_of_heights(heights),
        1 => jumps_maximum_sum_of_heights(heights),
        2 => runs_maximum_sum_of_heights(heights),
        3 => split_maximum_sum_of_heights(heights),
        _ => solution_maximum_sum_of_heights(heights),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "jumps", "runs", "split", "solution"];
    let mut seed = 2866;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 6 + 1 } else { wide(mut seed) % 20000 + 1 };
        let top = if small { 4 } else if c % 2 == 0 { 1000000000 } else { 30 };
        let mut most: Vec[i64] = (0..n).map(|_| wide(mut seed) % top + 1).collect();
        if not small and c % 4 == 1 {
            most.sort();
        }
        cases.push(most);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, most) in cases.iter().enumerate() {
        let n = most.len();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, most)).collect();
        let want = if c < 2000 { literal(most) } else { got[0] };
        total += want;
        check = (check * 31 + want) % 1000000007;
        let reversed: Vec[i64] = most.iter().rev().cloned().collect();
        let doubled: Vec[i64] = most.iter().map(|h| 2 * h).collect();
        let mut extended = most.clone();
        extended.push(1);
        let high = most.iter().max().unwrap();
        let low = most.iter().min().unwrap();
        let sum: i64 = most.iter().sum();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                c >= 2000 or value == want,
                answer(arm, reversed) == value,
                answer(arm, doubled) == 2 * value,
                answer(arm, extended) == value + 1,
                value >= high + (n - 1) * low and value <= sum and (value == sum) == mountain(most),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {most}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, sums total {total}: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
