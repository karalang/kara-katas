// LeetCode #2833: Furthest Point From Origin -- the differential. The
// five arms, against the statement read literally: every way of taking
// the blanks left or right, by a bit mask, each walked from 0, and the
// furthest end. 2000 random strings of 1 to 12 moves, then 50 of up to
// 50, the blank drawn 0 to 5 times in 6. Every case is drawn before any
// arm answers; the literal reading is asked only of the first 2000.
//
// P1  up to 12 moves, the answer is the literal reading's
// P2  the moves reversed: the same answer
// P3  every L made R and every R made L: the same answer
// P4  one blank added at the end: one further
// P5  "LR" added at the end: the same answer
// P6  each arm agrees with at least three of the other four

fn literal(moves: Str) -> i64 {
    let cs: Vec[char] = moves.chars().collect();
    let blanks = cs.iter().filter(|c| c == '_').count();
    let mut best = 0;
    for mask in 0..(1 << blanks) {
        let mut at = 0;
        let mut b = 0;
        for c in cs.iter() {
            if c == 'L' {
                at -= 1;
            } else if c == 'R' {
                at += 1;
            } else {
                at += if (mask >> b) & 1 == 1 { 1 } else { -1 };
                b += 1;
            }
        }
        best = best.max(at.abs());
    }
    best
}


// ---- star (furthest.kara) -------------------------------------------

fn star_furthest_distance_from_origin(moves: Str) -> i64 {
    let left = moves.chars().filter(|c| c == 'L').count();
    let right = moves.chars().filter(|c| c == 'R').count();
    (left - right).abs() + moves.len() - left - right
}


// ---- walk (furthest_walk.kara) --------------------------------------

fn walk_walk(moves: Str, blank: char) -> i64 {
    let mut at = 0;
    for c in moves.chars() {
        let step = if c == '_' { blank } else { c };
        at += if step == 'L' { -1 } else { 1 };
    }
    at.abs()
}

fn walk_furthest_distance_from_origin(moves: Str) -> i64 {
    walk_walk(moves, 'L').max(walk_walk(moves, 'R'))
}


// ---- fold (furthest_fold.kara) --------------------------------------

fn fold_furthest_distance_from_origin(moves: Str) -> i64 {
    let (at, free) = moves.bytes().iter().fold((0, 0), |(at, free), b| match b {
        b'L' => (at - 1, free),
        b'R' => (at + 1, free),
        _ => (at, free + 1),
    });
    at.abs() + free
}


// ---- reach (furthest_reach.kara) ------------------------------------

fn reach_furthest_distance_from_origin(moves: Str) -> i64 {
    let n = moves.len();
    let mut reach: Vec[bool] = Vec.filled(2 * n + 1, false);
    reach[n] = true;
    for c in moves.chars() {
        let mut next: Vec[bool] = Vec.filled(2 * n + 1, false);
        for p in 0..2 * n + 1 {
            if reach[p] {
                if c != 'R' {
                    next[p - 1] = true;
                }
                if c != 'L' {
                    next[p + 1] = true;
                }
            }
        }
        reach = next;
    }
    (0..2 * n + 1).filter(|p| reach[p]).map(|p| (p - n).abs()).max().unwrap()
}


// ---- solution (furthest_solution.kara) ------------------------------

struct Solution {}

impl Solution {
    pub fn furthest_distance_from_origin(moves: String) -> i32 {
        let mut (l, r, u) = (0i32, 0i32, 0i32);
        for c in moves.chars() {
            match c {
                'L' => l += 1,
                'R' => r += 1,
                _ => u += 1,
            }
        }
        (l - r).abs() + u
    }
}

fn solution_furthest_distance_from_origin(moves: Str) -> i64 {
    Solution.furthest_distance_from_origin(moves.to_string())
}


// ---- the check ---------------------------------------------------------

fn answer(arm: i64, moves: Str) -> i64 {
    match arm {
        0 => star_furthest_distance_from_origin(moves),
        1 => walk_furthest_distance_from_origin(moves),
        2 => fold_furthest_distance_from_origin(moves),
        3 => reach_furthest_distance_from_origin(moves),
        _ => solution_furthest_distance_from_origin(moves),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn moves_of(n: i64, blank: i64, seed: mut ref i64) -> String {
    let codes: Vec[u8] = (0..n)
        .map(|_| {
            let r = next_random(mut seed) % 6;
            if r < blank { b'_' } else if r % 2 == 0 { b'L' } else { b'R' }
        })
        .collect();
    String.from_utf8(codes).unwrap()
}

fn main() {
    let names = ["star", "walk", "fold", "reach", "solution"];
    let mut seed = 2833;
    let mut cases: Vec[String] = Vec.new();
    for c in 0..2050 {
        let n = if c < 2000 { next_random(mut seed) % 12 + 1 } else { next_random(mut seed) % 50 + 1 };
        let blank = next_random(mut seed) % 6;
        cases.push(moves_of(n, blank, mut seed));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, moves) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(moves) } else { 0 };
        check = (check * 31 + want + 1) % 1000000007;
        let reversed: String = moves.chars().rev().collect();
        let swapped: String = moves.chars().map(|ch| if ch == 'L' { 'R' } else if ch == 'R' { 'L' } else { ch }).collect();
        let blank_more = moves.to_string() + "_";
        let pair_more = moves.to_string() + "LR";
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, moves)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == want,
                answer(arm, reversed) == value,
                answer(arm, swapped) == value,
                answer(arm, blank_more) == value + 1,
                answer(arm, pair_more) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {moves}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
