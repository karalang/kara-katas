// LeetCode #2833: Furthest Point From Origin -- two walks: one with every
// blank taken as a step left, one with every blank a step right, and the
// furthest of the two ends from 0.

fn walk(moves: Str, blank: char) -> i64 {
    let mut at = 0;
    for c in moves.chars() {
        let step = if c == '_' { blank } else { c };
        at += if step == 'L' { -1 } else { 1 };
    }
    at.abs()
}

fn furthest_distance_from_origin(moves: Str) -> i64 {
    walk(moves, 'L').max(walk(moves, 'R'))
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n moves, each 'L', 'R' or '_', the blank drawn one time in `blank`
fn moves_of(n: i64, blank: i64, seed: mut ref i64) -> String {
    let codes: Vec[u8] = (0..n)
        .map(|_| {
            let r = next_random(mut seed) % 6;
            if r < blank { b'_' } else if r % 2 == 0 { b'L' } else { b'R' }
        })
        .collect();
    String.from_utf8(codes).unwrap()
}

fn main() {
    // LeetCode's three examples; one move of each kind; and the same
    // move 50 times, LeetCode's most
    println(f"{furthest_distance_from_origin("L_RL__R")}");
    println(f"{furthest_distance_from_origin("_R__LL_")}");
    println(f"{furthest_distance_from_origin("_______")}");
    println(f"{furthest_distance_from_origin("L")} {furthest_distance_from_origin("R")} {furthest_distance_from_origin("_")}");
    println(f"{furthest_distance_from_origin("LR".repeat(25))} {furthest_distance_from_origin("L".repeat(50))}");
    // 20000 random move strings of 1 to 50 moves, the blank drawn 0 to 5
    // times in 6
    let mut seed = 2833;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..20000 {
        let n = next_random(mut seed) % 50 + 1;
        let blank = next_random(mut seed) % 6;
        let d = furthest_distance_from_origin(moves_of(n, blank, mut seed));
        total += d;
        check = (check * 31 + d) % 1000000007;
    }
    println(f"20000 random strings: distances total {total}, checksum {check}");
}
