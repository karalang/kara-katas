// LeetCode #2873: Maximum Value of an Ordered Triplet I -- the
// differential. The five arms, against the statement read literally:
// every i < j < k tried, the largest (nums[i] - nums[j]) * nums[k] kept,
// 0 when every one is negative. 2000 random arrays of 3 to 8 values from
// 1 to 9, then 50 of 3 to 100 values up to 10^6, all drawn before any
// arm answers; the literal reading is asked only of the first 2000.
//
// P1  up to 8 values, the answer is the literal reading's
// P2  every value doubled: four times the answer
// P3  a 1 put in front: the same answer
// P4  the values sorted rising: 0
// P5  from 0 to the largest value squared, and at least
//     (nums[0] - nums[1]) * nums[n - 1]
// P6  each arm agrees with at least three of the other four

fn literal(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut best = 0;
    for i in 0..n {
        for j in i + 1..n {
            for k in j + 1..n {
                best = best.max((nums[i] - nums[j]) * nums[k]);
            }
        }
    }
    best
}


// ---- star (triplet.kara) --------------------------------------------

fn star_maximum_triplet_value(nums: Vec[i64]) -> i64 {
    let mut best = 0;
    let mut top = 0;
    let mut gap = 0;
    for v in nums.iter() {
        best = best.max(gap * v);
        gap = gap.max(top - v);
        top = top.max(v);
    }
    best
}


// ---- brute (triplet_brute.kara) -------------------------------------

fn brute_maximum_triplet_value(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut best = 0;
    for i in 0..n {
        for j in i + 1..n {
            for k in j + 1..n {
                best = best.max((nums[i] - nums[j]) * nums[k]);
            }
        }
    }
    best
}


// ---- sides (triplet_sides.kara) -------------------------------------

fn sides_maximum_triplet_value(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut left: Vec[i64] = Vec.filled(n, 0);
    let mut right: Vec[i64] = Vec.filled(n, 0);
    for i in 1..n {
        left[i] = left[i - 1].max(nums[i - 1]);
    }
    for i in (0..n - 1).rev() {
        right[i] = right[i + 1].max(nums[i + 1]);
    }
    (1..n - 1).map(|j| (left[j] - nums[j]) * right[j]).max().unwrap().max(0)
}


// ---- fold (triplet_fold.kara) ---------------------------------------

fn fold_maximum_triplet_value(nums: Vec[i64]) -> i64 {
    let (best, _, _) = nums.iter().fold((0, 0, 0), |(best, top, gap), v| (best.max(gap * v), top.max(v), gap.max(top - v)));
    best
}


// ---- solution (triplet_solution.kara) -------------------------------

struct Solution {}

impl Solution {
    pub fn maximum_triplet_value(nums: Vec[i32]) -> i64 {
        let n = nums.len();
        let mut ans: i64 = 0;
        for i in 0..n {
            for j in i + 1..n {
                for k in j + 1..n {
                    ans = ans.max((nums[i] - nums[j]) as i64 * nums[k] as i64);
                }
            }
        }
        ans
    }
}

fn solution_maximum_triplet_value(nums: Vec[i64]) -> i64 {
    Solution.maximum_triplet_value(nums.iter().map(|x| x as i32).collect())
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_maximum_triplet_value(nums),
        1 => brute_maximum_triplet_value(nums),
        2 => sides_maximum_triplet_value(nums),
        3 => fold_maximum_triplet_value(nums),
        _ => solution_maximum_triplet_value(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "brute", "sides", "fold", "solution"];
    let mut seed = 2873;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 6 + 3 } else { next_random(mut seed) % 98 + 3 };
        let nums: Vec[i64] = (0..n).map(|_| if small { next_random(mut seed) % 9 + 1 } else { wide(mut seed) % 1000000 + 1 }).collect();
        cases.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, nums) in cases.iter().enumerate() {
        let n = nums.len();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        let want = if c < 2000 { literal(nums) } else { got[0] };
        total += want;
        check = (check * 31 + want % 1000000007) % 1000000007;
        let doubled: Vec[i64] = nums.iter().map(|v| v * 2).collect();
        let mut fronted: Vec[i64] = [1].to_vec();
        fronted.extend(nums.iter().cloned());
        let mut rising = nums.clone();
        rising.sort();
        let top = nums.iter().max().unwrap();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                c >= 2000 or value == want,
                answer(arm, doubled) == 4 * value,
                answer(arm, fronted) == value,
                answer(arm, rising) == 0,
                value >= 0 and value <= top * top and value >= (nums[0] - nums[1]) * nums[n - 1],
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} n {n}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, values total {total}: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
