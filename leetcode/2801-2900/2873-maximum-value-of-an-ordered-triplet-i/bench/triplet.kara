// LeetCode #2873: Maximum Value of an Ordered Triplet I -- the bench: the
// ★ arm over 100000 arrays of 100 values, LeetCode's most, each from 1
// to 10^6, all drawn first, then each answered 30 times.

fn maximum_triplet_value(nums: Vec[i64]) -> i64 {
    let mut best = 0;
    let mut top = 0;
    let mut gap = 0;
    for v in nums.iter() {
        best = best.max(gap * v);
        gap = gap.max(top - v);
        top = top.max(v);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 100000;
    let rounds = 30;
    let n = 100;
    let mut seed = 2873;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let nums: Vec[i64] = (0..n).map(|_| wide(mut seed) % 1000000 + 1).collect();
        arrays.push(nums);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in arrays.iter() {
            let best = maximum_triplet_value(nums);
            total += best;
            check = (check * 31 + best % 1000000007 + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {n}, {rounds} rounds: values total {total}, checksum {check}");
}
