// LeetCode #2839: Check if Strings Can be Made Equal With Operations I --
// the differential. The five arms, against the statement read
// literally: every string s1 reaches by swaps two apart, found by a
// search to a fixed point over a `Set`, and whether s2 is among them.
// 2000 pairs of words over a, b and c, then 50 over all 26 letters: a
// third of the second words random, a third the first with random
// swaps made, and a third that with one letter changed too. Every case
// is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  s1 and s2 the other way round: the same answer
// P3  s1 against itself: true
// P4  every letter of both moved on one, z to a: the same answer
// P5  both words reversed: the same answer
// P6  each arm agrees with at least three of the other four

fn literal(s1: Str, s2: Str) -> bool {
    let mut seen: Set[String] = Set.new();
    let mut todo: Vec[String] = [s1.to_string()];
    seen.insert(s1.to_string());
    while let Some(s) = todo.pop() {
        for i in 0..2 {
            let mut cs: Vec[char] = s.chars().collect();
            cs.swap(i, i + 2);
            let t: String = cs.iter().collect();
            if seen.insert(t.clone()) {
                todo.push(t);
            }
        }
    }
    seen.contains(s2)
}


// ---- star (equal.kara) ----------------------------------------------

fn star_can_be_equal(s1: Str, s2: Str) -> bool {
    let a: Vec[char] = s1.chars().collect();
    let b: Vec[char] = s2.chars().collect();
    let pair = |x: char, y: char, p: char, q: char| (x == p and y == q) or (x == q and y == p);
    pair(a[0], a[2], b[0], b[2]) and pair(a[1], a[3], b[1], b[3])
}


// ---- reach (equal_reach.kara) ---------------------------------------

fn reach_can_be_equal(s1: Str, s2: Str) -> bool {
    let goal: Vec[u8] = s2.bytes().to_vec();
    for mask in 0..4 {
        let mut b: Vec[u8] = s1.bytes().to_vec();
        if mask & 1 == 1 {
            b.swap(0, 2);
        }
        if mask & 2 == 2 {
            b.swap(1, 3);
        }
        if b == goal {
            return true;
        }
    }
    false
}


// ---- count (equal_count.kara) ---------------------------------------

fn count_can_be_equal(s1: Str, s2: Str) -> bool {
    let mut count: Vec[i64] = Vec.filled(52, 0);
    for (i, c) in s1.bytes().iter().enumerate() {
        count[i % 2 * 26 + (c - b'a')] += 1;
    }
    for (i, c) in s2.bytes().iter().enumerate() {
        count[i % 2 * 26 + (c - b'a')] -= 1;
    }
    count.iter().all(|n| n == 0)
}


// ---- sorted (equal_sorted.kara) -------------------------------------

fn sorted_key(s: Str) -> (String, String) {
    let cs: Vec[char] = s.chars().collect();
    let mut even: Vec[char] = cs.iter().step_by(2).collect();
    let mut odd: Vec[char] = cs.iter().skip(1).step_by(2).collect();
    even.sort();
    odd.sort();
    (even.iter().collect(), odd.iter().collect())
}

fn sorted_can_be_equal(s1: Str, s2: Str) -> bool {
    sorted_key(s1) == sorted_key(s2)
}


// ---- solution (equal_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn can_be_equal(s1: String, s2: String) -> bool {
        let (a, b) = (s1.bytes(), s2.bytes());
        let ok = |i: usize, j: usize| {
            (a[i] == b[i] and a[j] == b[j]) or (a[i] == b[j] and a[j] == b[i])
        };
        ok(0, 2) and ok(1, 3)
    }
}

fn solution_can_be_equal(s1: Str, s2: Str) -> bool {
    Solution.can_be_equal(s1.to_string(), s2.to_string())
}


// ---- the check ---------------------------------------------------------

fn answer(arm: i64, s1: Str, s2: Str) -> bool {
    match arm {
        0 => star_can_be_equal(s1, s2),
        1 => reach_can_be_equal(s1, s2),
        2 => count_can_be_equal(s1, s2),
        3 => sorted_can_be_equal(s1, s2),
        _ => solution_can_be_equal(s1, s2),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn word(w: i64, letters: i64) -> String {
    let codes: Vec[u8] = (0..4).map(|i| (97 + w / letters.pow(i as u32) % letters) as u8).collect();
    String.from_utf8(codes).unwrap()
}

fn shifted(s: Str) -> String {
    s.bytes().iter().map(|b| ((b - b'a' + 1) % 26 + b'a') as char).collect()
}

fn main() {
    let names = ["star", "reach", "count", "sorted", "solution"];
    let mut seed = 2839;
    let mut cases: Vec[(String, String)] = Vec.new();
    for c in 0..2050 {
        let letters = if c < 2000 { 3 } else { 26 };
        let s1 = word(next_random(mut seed) * 32768 + next_random(mut seed), letters);
        // a third random, a third s1 with random swaps made, and a third
        // that with one letter changed too
        let kind = c % 3;
        let s2 = if kind == 0 {
            word(next_random(mut seed) * 32768 + next_random(mut seed), letters)
        } else {
            let mut cs: Vec[u8] = s1.bytes().to_vec();
            for i in 0..2 {
                if next_random(mut seed) % 2 == 1 {
                    cs.swap(i, i + 2);
                }
            }
            if kind == 2 {
                cs[next_random(mut seed) % 4] = (97 + next_random(mut seed) % letters) as u8;
            }
            String.from_utf8(cs).unwrap()
        };
        cases.push((s1, s2));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut yes = 0;
    for (c, (s1, s2)) in cases.iter().enumerate() {
        let want = literal(s1, s2);
        if want {
            yes += 1;
        }
        check = (check * 31 + if want { 2 } else { 1 }) % 1000000007;
        let r1: String = s1.chars().rev().collect();
        let r2: String = s2.chars().rev().collect();
        let got: Vec[bool] = (0..5).map(|arm| answer(arm, s1, s2)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == want,
                answer(arm, s2, s1) == value,
                answer(arm, s1, s1),
                answer(arm, shifted(s1), shifted(s2)) == value,
                answer(arm, r1, r2) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {s1} {s2}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, {yes} true: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
