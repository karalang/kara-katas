// LeetCode #2839: Check if Strings Can be Made Equal With Operations I --
// each string's even letters and odd letters pulled out by `step_by`
// and sorted into a key; the strings match when the keys do.

fn key(s: Str) -> (String, String) {
    let cs: Vec[char] = s.chars().collect();
    let mut even: Vec[char] = cs.iter().step_by(2).collect();
    let mut odd: Vec[char] = cs.iter().skip(1).step_by(2).collect();
    even.sort();
    odd.sort();
    (even.iter().collect(), odd.iter().collect())
}

fn can_be_equal(s1: Str, s2: Str) -> bool {
    key(s1) == key(s2)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the four-letter word numbered w in base `letters`
fn word(w: i64, letters: i64) -> String {
    let codes: Vec[u8] = (0..4).map(|i| (97 + w / letters.pow(i as u32) % letters) as u8).collect();
    String.from_utf8(codes).unwrap()
}

fn main() {
    // LeetCode's two examples; a word against itself
    println(f"{can_be_equal("abcd", "cdab")} {can_be_equal("abcd", "dacb")} {can_be_equal("zzzz", "zzzz")}");
    // every pair of words over a, b and c: 81 x 81
    let mut yes = 0;
    let mut check = 0;
    for a in 0..81 {
        for b in 0..81 {
            let same = can_be_equal(word(a, 3), word(b, 3));
            if same {
                yes += 1;
            }
            check = (check * 31 + if same { 2 } else { 1 }) % 1000000007;
        }
    }
    println(f"6561 pairs over abc: {yes} true, checksum {check}");
    // 20000 random pairs over all 26 letters, half of them the first
    // word with its even or odd places swapped
    let mut seed = 2839;
    yes = 0;
    check = 0;
    for _ in 0..20000 {
        let s1 = word(next_random(mut seed) * 32768 + next_random(mut seed), 26);
        let s2 = if next_random(mut seed) % 2 == 0 {
            let mut cs: Vec[char] = s1.chars().collect();
            let k = next_random(mut seed) % 2;
            cs.swap(k, k + 2);
            cs.iter().collect()
        } else {
            word(next_random(mut seed) * 32768 + next_random(mut seed), 26)
        };
        let same = can_be_equal(s1, s2);
        if same {
            yes += 1;
        }
        check = (check * 31 + if same { 2 } else { 1 }) % 1000000007;
    }
    println(f"20000 random pairs: {yes} true, checksum {check}");
}
