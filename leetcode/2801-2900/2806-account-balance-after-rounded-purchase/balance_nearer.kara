// LeetCode #2806: Account Balance After Rounded Purchase -- the nearer of
// two: the multiples of 10 just below and just above, the closer kept,
// the one above on a tie, by `min_by_key` on the distance and then the
// multiple turned negative.

fn account_balance_after_purchase(purchase_amount: i64) -> i64 {
    let below = purchase_amount / 10 * 10;
    let rounded_src = [below, below + 10];
    let rounded = rounded_src.iter().min_by_key(|m| ((m - purchase_amount).abs(), -m)).unwrap();
    100 - rounded
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; nothing spent; everything; the two ends
    // that round up
    for p in [9, 15, 0, 100, 5, 95] {
        println(f"{account_balance_after_purchase(p)}");
    }
    // every amount from 0 to 100, LeetCode's whole range, in turn; then
    // 3000 drawn at random
    let mut sum = 0;
    let mut check = 0;
    for p in 0..=100 {
        let b = account_balance_after_purchase(p);
        sum += b;
        check = (check * 31 + b) % 1000000007;
    }
    println(f"0 to 100: balances sum to {sum}, checksum {check}");
    let mut seed = 2806;
    sum = 0;
    check = 0;
    for _ in 0..3000 {
        let b = account_balance_after_purchase(next_random(mut seed) % 101);
        sum += b;
        check = (check * 31 + b) % 1000000007;
    }
    println(f"3000 random amounts: balances sum to {sum}, checksum {check}");
}
