// LeetCode #2806: Account Balance After Rounded Purchase -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac
// fix`: the remainder by 10 matched against the range `0..=4`, the
// amount rounded down or up, and the balance taken from 100.

struct Solution {}

impl Solution {
    pub fn account_balance_after_purchase(purchase_amount: i32) -> i32 {
        let rounded = match purchase_amount % 10 {
            0..=4 => purchase_amount / 10 * 10,
            _ => (purchase_amount / 10 + 1) * 10,
        };
        100 - rounded
    }
}

fn account_balance_after_purchase(purchase_amount: i64) -> i64 {
    Solution.account_balance_after_purchase(purchase_amount as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; nothing spent; everything; the two ends
    // that round up
    for p in [9, 15, 0, 100, 5, 95] {
        println(f"{account_balance_after_purchase(p)}");
    }
    // every amount from 0 to 100, LeetCode's whole range, in turn; then
    // 3000 drawn at random
    let mut sum = 0;
    let mut check = 0;
    for p in 0..=100 {
        let b = account_balance_after_purchase(p);
        sum += b;
        check = (check * 31 + b) % 1000000007;
    }
    println(f"0 to 100: balances sum to {sum}, checksum {check}");
    let mut seed = 2806;
    sum = 0;
    check = 0;
    for _ in 0..3000 {
        let b = account_balance_after_purchase(next_random(mut seed) % 101);
        sum += b;
        check = (check * 31 + b) % 1000000007;
    }
    println(f"3000 random amounts: balances sum to {sum}, checksum {check}");
}
