// LeetCode #2806: Account Balance After Rounded Purchase -- the bench:
// the ★ arm over 10^6 amounts from 0 to 100, LeetCode's whole range, all
// drawn first, then each answered 100 times, every answer folded into a
// running checksum so that no two answers are independent.

fn account_balance_after_purchase(purchase_amount: i64) -> i64 {
    100 - (purchase_amount + 5) / 10 * 10
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 1000000;
    let rounds = 100;
    let mut seed = 2806;
    let amounts: Vec[i64] = (0..count).map(|_| next_random(mut seed) % 101).collect();
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for p in amounts.iter() {
            let b = account_balance_after_purchase(p);
            total += b;
            check = (check * 31 + b + r) % 1000000007;
        }
    }
    println(f"{count} amounts, {rounds} rounds: balances sum to {total}, checksum {check}");
}
