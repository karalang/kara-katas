
// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn word(seed: mut ref i64) -> String {
    let n = next_random(mut seed) % 10 + 1;
    let codes: Vec[u8] = (0..n).map(|_| (97 + next_random(mut seed) % 3) as u8).collect();
    String.from_utf8(codes).unwrap()
}

fn main() {
    // LeetCode's three examples; one word; s one letter long; and 100
    // words whose acronym is s
    println(f"{is_acronym(["alice", "bob", "charlie"], "abc")}");
    println(f"{is_acronym(["an", "apple"], "a")}");
    println(f"{is_acronym(["never", "gonna", "give", "up", "on", "you"], "ngguoy")}");
    println(f"{is_acronym(["z"], "z")}");
    println(f"{is_acronym(["ab", "ba"], "abba")}");
    let hundred: Vec[String] = (0..100).map(|i| f"{(97 + i % 26) as u8 as char}x").collect();
    let initials: String = (0..100).map(|i| (97 + i % 26) as u8 as char).collect();
    println(f"{is_acronym(hundred, initials)}");
    // 5000 random cases of 1 to 100 words of 1 to 10 letters from 'a' to
    // 'c', s their acronym, then one letter changed, one cut (but never
    // the last) or one added at random, or left alone
    let mut seed = 2828;
    let mut yes = 0;
    let mut check = 0;
    for _ in 0..5000 {
        let count = next_random(mut seed) % 100 + 1;
        let words: Vec[String] = (0..count).map(|_| word(mut seed)).collect();
        let mut s: Vec[u8] = words.iter().map(|w| w.bytes()[0]).collect();
        let at = next_random(mut seed) % s.len();
        match next_random(mut seed) % 4 {
            0 => s[at] = (97 + next_random(mut seed) % 3) as u8,
            1 if s.len() > 1 => {
                s.remove(at);
            }
            2 => s.insert(at, b'a'),
            _ => {}
        }
        let a = is_acronym(words, String.from_utf8(s).unwrap());
        if a {
            yes += 1;
        }
        check = (check * 31 + if a { 1 } else { 0 } + count) % 1000000007;
    }
    println(f"5000 cases: {yes} true, checksum {check}");
}
