// LeetCode #2828: Check if a String Is an Acronym of Words -- the bench:
// the ★ arm over 20000 cases of 100 words of up to 10 letters,
// LeetCode's most, s their acronym, one case in four with a letter
// redrawn, all drawn first, then each answered 100 times.

fn is_acronym(words: Vec[String], s: Str) -> bool {
    words.len() == s.len() and words.iter().zip(s.bytes().iter()).all(|(w, c)| w.bytes()[0] == c)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn word(seed: mut ref i64) -> String {
    let n = next_random(mut seed) % 10 + 1;
    let codes: Vec[u8] = (0..n).map(|_| (97 + next_random(mut seed) % 3) as u8).collect();
    String.from_utf8(codes).unwrap()
}

fn main() {
    let count = 20000;
    let rounds = 100;
    let mut seed = 2828;
    let mut cases: Vec[(Vec[String], String)] = Vec.new();
    for _ in 0..count {
        let words: Vec[String] = (0..100).map(|_| word(mut seed)).collect();
        let mut s: Vec[u8] = words.iter().map(|w| w.bytes()[0]).collect();
        if next_random(mut seed) % 4 == 0 {
            let at = next_random(mut seed) % 100;
            s[at] = (97 + next_random(mut seed) % 3) as u8;
        }
        cases.push((words, String.from_utf8(s).unwrap()));
    }
    let mut yes = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (words, s) in cases.iter() {
            let a = is_acronym(words, s);
            if a {
                yes += 1;
            }
            check = (check * 31 + if a { 1 } else { 0 } + r) % 1000000007;
        }
    }
    println(f"{count} cases of 100 words, {rounds} rounds: {yes} true, checksum {check}");
}
