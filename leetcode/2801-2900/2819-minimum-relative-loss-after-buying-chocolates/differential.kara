// LeetCode #2819: Minimum Relative Loss After Buying Chocolates -- the
// differential. The five arms, against the statement read literally:
// every choice of exactly m chocolates, each one's price split as Bob
// pays min(p, k) and Alice the rest, and the least of Bob's total less
// Alice's. 2000 random shops of 1 to 10 prices up to 30 with 3 queries;
// then 50 of up to 600 prices up to 10^9 with 20 queries. Every case is
// drawn before any arm answers; the literal reading is asked only of the
// first 2000.
//
// P1  up to 10 prices, every answer is the literal reading's
// P2  m = n: the losses of every chocolate summed
// P3  the prices reversed: the same answers
// P4  the queries reversed: the answers reversed
// P5  for 2 <= m < n, one chocolate more adds at least what the last one
//     did: the losses are taken in rising order
// P6  each arm agrees with at least three of the other four


// ---- the statement read literally ------------------------------------------

fn literal(prices: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let n = prices.len();
    let mut out: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let (k, m) = (q[0], q[1]);
        let mut best = i64.MAX;
        for mask in 0..(1 << n) {
            let chosen: Vec[i64] = (0..n).filter(|i| (mask >> i) & 1 == 1).map(|i| prices[i]).collect();
            if chosen.len() != m {
                continue;
            }
            let bob: i64 = chosen.iter().map(|p| p.min(k)).sum();
            let alice: i64 = chosen.iter().map(|p| (p - k).max(0)).sum();
            best = best.min(bob - alice);
        }
        out.push(best);
    }
    out
}


// ---- star (loss.kara) -----------------------------------------------

fn star_minimum_relative_losses(prices: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let mut sorted = prices.clone();
    sorted.sort();
    let n = sorted.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + sorted[i];
    }
    let mut out: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let (k, m) = (q[0], q[1]);
        let mut lo = 0;
        let mut hi = m;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if sorted[mid] + sorted[n - m + mid] < 2 * k {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        let dear = prefix[n] - prefix[n - m + lo];
        out.push(prefix[lo] + 2 * k * (m - lo) - dear);
    }
    out
}


// ---- ends (loss_ends.kara) ------------------------------------------

fn ends_loss_of(p: i64, k: i64) -> i64 {
    if p <= k { p } else { 2 * k - p }
}

fn ends_minimum_relative_losses(prices: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let mut sorted = prices.clone();
    sorted.sort();
    queries
        .iter()
        .map(|q| {
            let (k, m) = (q[0], q[1]);
            let mut i = 0;
            let mut j = sorted.len() - 1;
            let mut total = 0;
            for _ in 0..m {
                let (a, b) = (ends_loss_of(sorted[i], k), ends_loss_of(sorted[j], k));
                if a <= b {
                    total += a;
                    i += 1;
                } else {
                    total += b;
                    j -= 1;
                }
            }
            total
        })
        .collect()
}


// ---- splits (loss_splits.kara) --------------------------------------

struct Shop {
    sorted: Vec[i64],
    prefix: Vec[i64],
}

impl Shop {
    // the losses of sorted[a..b] at k, cut at the first price above k
    fn range_loss(self, a: i64, b: i64, k: i64, cut: i64) -> i64 {
        let mid = cut.max(a).min(b);
        let low = self.prefix[mid] - self.prefix[a];
        let high = self.prefix[b] - self.prefix[mid];
        low + 2 * k * (b - mid) - high
    }
}

fn splits_minimum_relative_losses(prices: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let mut sorted = prices.clone();
    sorted.sort();
    let n = sorted.len();
    let mut prefix: Vec[i64] = [0];
    for p in sorted.iter() {
        prefix.push(prefix[prefix.len() - 1] + p);
    }
    let shop = Shop { sorted, prefix };
    let mut out: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let (k, m) = (q[0], q[1]);
        let cut = shop.sorted.partition_point(|p| p <= k);
        let best = (0..=m)
            .map(|l| shop.range_loss(0, l, k, cut) + shop.range_loss(n - m + l, n, k, cut))
            .min()
            .unwrap();
        out.push(best);
    }
    out
}


// ---- each (loss_each.kara) ------------------------------------------

fn each_minimum_relative_losses(prices: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let (k, m) = (q[0], q[1]);
        let mut losses: Vec[i64] = prices.iter().map(|p| if p <= k { p } else { 2 * k - p }).collect();
        losses.sort();
        out.push(losses[..m].iter().sum());
    }
    out
}


// ---- solution (loss_solution.kara) ----------------------------------

struct Solution {}

impl Solution {
    pub fn minimum_relative_losses(prices: own Vec[i32], queries: Vec[Vec[i32]]) -> Vec[i64] {
        let mut prices = prices;
        prices.sort();
        let n = prices.len();
        let mut s = Vec.filled(n + 1, 0);
        for i in 0..n {
            s[i + 1] = s[i] + prices[i];
        }
        let mut ans = Vec.with_capacity(queries.len());
        for q in queries {
            let k = q[0] as i64;
            let m = q[1] as i64;
            let mut (l, r) = (0, m);
            while l < r {
                let mid = (l + r) / 2;
                let right = n - m + mid;
                if prices[mid] < 2 * k - prices[right] {
                    l = mid + 1;
                } else {
                    r = mid;
                }
            }
            ans.push(s[l] + 2 * k * (m - l) - (s[n] - s[n - m + l]));
        }
        ans
    }
}

fn solution_minimum_relative_losses(prices: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let prices: Vec[i32] = prices.iter().map(|p| p as i32).collect();
    let queries: Vec[Vec[i32]] = queries.iter().map(|q| q.iter().map(|v| v as i32).collect()).collect();
    Solution.minimum_relative_losses(prices, queries)
}


// ---- the checks ------------------------------------------------------------

fn answer(arm: i64, prices: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    match arm {
        0 => star_minimum_relative_losses(prices, queries),
        1 => ends_minimum_relative_losses(prices, queries),
        2 => splits_minimum_relative_losses(prices, queries),
        3 => each_minimum_relative_losses(prices, queries),
        _ => solution_minimum_relative_losses(prices, queries),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "ends", "splits", "each", "solution"];
    let mut seed = 2819;
    let mut cases: Vec[(Vec[i64], Vec[Vec[i64]])] = Vec.new();
    for c in 0..2050 {
        if c < 2000 {
            let n = next_random(mut seed) % 10 + 1;
            let prices: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 30 + 1).collect();
            let queries: Vec[Vec[i64]] = (0..3).map(|_| [next_random(mut seed) % 30 + 1, next_random(mut seed) % n + 1]).collect();
            cases.push((prices, queries));
        } else {
            let n = next_random(mut seed) % 600 + 1;
            let prices: Vec[i64] = (0..n).map(|_| wide(mut seed) % 1000000000 + 1).collect();
            let queries: Vec[Vec[i64]] = (0..20).map(|_| [wide(mut seed) % 1000000000 + 1, next_random(mut seed) % n + 1]).collect();
            cases.push((prices, queries));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (prices, queries)) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(prices, queries) } else { Vec.new() };
        for w in want.iter() {
            check = ((check * 31 + w) % 1000000007 + 1000000007) % 1000000007;
        }
        let n = prices.len();
        let reversed: Vec[i64] = prices.iter().rev().collect();
        let backwards: Vec[Vec[i64]] = queries.iter().rev().map(|q| q.clone()).collect();
        let whole: Vec[Vec[i64]] = queries.iter().map(|q| [q[0], n]).collect();
        let sums: Vec[i64] = queries.iter().map(|q| prices.iter().map(|p| if p <= q[0] { p } else { 2 * q[0] - p }).sum()).collect();
        let got: Vec[Vec[i64]] = (0..5).map(|arm| answer(arm, prices, queries)).collect();
        for arm in 0..5 {
            let value = ref got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let mut flipped = answer(arm, prices, backwards);
            flipped.reverse();
            let mut convex = true;
            for q in queries.iter() {
                let (k, m) = (q[0], q[1]);
                if m >= 2 and m < n {
                    let three = answer(arm, prices, [[k, m - 1], [k, m], [k, m + 1]]);
                    convex = convex and three[2] - three[1] >= three[1] - three[0];
                }
            }
            let verdicts = [
                not small or value == want,
                answer(arm, prices, whole) == sums,
                answer(arm, reversed, queries) == value,
                flipped == value,
                convex,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {prices} queries {queries}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
