// LeetCode #2819: Minimum Relative Loss After Buying Chocolates -- the
// bench: the ★ arm over 10 shops of 10^5 prices up to 10^9, LeetCode's
// most, each with 10^5 queries, all drawn first, then each answered 3
// times.

fn minimum_relative_losses(prices: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let mut sorted = prices.clone();
    sorted.sort();
    let n = sorted.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + sorted[i];
    }
    let mut out: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let (k, m) = (q[0], q[1]);
        let mut lo = 0;
        let mut hi = m;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if sorted[mid] + sorted[n - m + mid] < 2 * k {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        let dear = prefix[n] - prefix[n - m + lo];
        out.push(prefix[lo] + 2 * k * (m - lo) - dear);
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 10;
    let rounds = 3;
    let n = 100000;
    let mut seed = 2819;
    let mut shops: Vec[(Vec[i64], Vec[Vec[i64]])] = Vec.new();
    for _ in 0..count {
        let prices: Vec[i64] = (0..n).map(|_| wide(mut seed) % 1000000000 + 1).collect();
        let queries: Vec[Vec[i64]] = (0..n).map(|_| [wide(mut seed) % 1000000000 + 1, wide(mut seed) % n + 1]).collect();
        shops.push((prices, queries));
    }
    let mut negative = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (prices, queries) in shops.iter() {
            for a in minimum_relative_losses(prices, queries).iter() {
                if a < 0 {
                    negative += 1;
                }
                check = ((check * 31 + a + r) % 1000000007 + 1000000007) % 1000000007;
            }
        }
    }
    println(f"{count} shops of {n}, {rounds} rounds: {negative} losses below 0, checksum {check}");
}
