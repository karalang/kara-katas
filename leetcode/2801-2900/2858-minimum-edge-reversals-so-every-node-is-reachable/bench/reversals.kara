// LeetCode #2858: Minimum Edge Reversals So Every Node Is Reachable --
// the bench: the ★ arm over 20 random trees of 10^5 nodes, LeetCode's
// most, every other one deep, labels shuffled and each edge pointing
// either way, all drawn first, then each answered 5 times.

fn min_edge_reversals(n: i64, edges: Vec[Vec[i64]]) -> Vec[i64] {
    let mut adj: Vec[Vec[(i64, i64)]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adj[e[0]].push((e[1], 0));
        adj[e[1]].push((e[0], 1));
    }
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    let mut cost: Vec[i64] = Vec.filled(n, 0);
    let mut order: Vec[i64] = Vec.new();
    let mut stack = [0].to_vec();
    parent[0] = 0;
    let mut root = 0;
    while let Some(u) = stack.pop() {
        order.push(u);
        for (v, w) in adj[u].iter() {
            if parent[v] == -1 {
                parent[v] = u;
                cost[v] = w;
                root += w;
                stack.push(v);
            }
        }
    }
    let mut answer: Vec[i64] = Vec.filled(n, 0);
    answer[0] = root;
    for u in order.iter().skip(1) {
        answer[u] = answer[parent[u]] + if cost[u] == 0 { 1 } else { -1 };
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn tree(n: i64, deep: bool, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut label: Vec[i64] = (0..n).collect();
    for i in (1..n).rev() {
        let j = wide(mut seed) % (i + 1);
        label.swap(i, j);
    }
    let mut edges: Vec[Vec[i64]] = Vec.new();
    for i in 1..n {
        let p = if deep { i - 1 - next_random(mut seed) % i.min(3) } else { wide(mut seed) % i };
        if next_random(mut seed) % 2 == 0 {
            edges.push([label[p], label[i]].to_vec());
        } else {
            edges.push([label[i], label[p]].to_vec());
        }
    }
    edges
}

fn main() {
    let count = 20;
    let rounds = 5;
    let n = 100000;
    let mut seed = 2858;
    let trees: Vec[Vec[Vec[i64]]] = (0..count).map(|c| tree(n, c % 2 == 1, mut seed)).collect();
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for edges in trees.iter() {
            let answer = min_edge_reversals(n, edges);
            for a in answer.iter() {
                total += a;
                check = (check * 31 + a + r) % 1000000007;
            }
        }
    }
    println(f"{count} trees of {n}, {rounds} rounds: answers sum to {total}, checksum {check}");
}
