// LeetCode #2824: Count Pairs Whose Sum is Less than Target -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac
// fix`: the `i32` numbers rebound `mut` and sorted by `sort_unstable`,
// two `usize` pointers in a tuple, and the count `j - i` cast to `i32`.

struct Solution {}

impl Solution {
    pub fn count_pairs(nums: own Vec[i32], target: i32) -> i32 {
        let mut nums = nums;
        nums.sort();
        let mut (i, j) = (0, nums.len() - 1);
        let mut ans: i32 = 0;
        while i < j {
            if nums[i] + nums[j] < target {
                ans += (j - i) as i32;
                i += 1;
            } else {
                j -= 1;
            }
        }
        ans
    }
}

fn count_pairs(nums: Vec[i64], target: i64) -> i64 {
    Solution.count_pairs(nums.iter().map(|v| v as i32).collect(), target as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one number; 50 numbers all -50 under 50,
    // every pair; and all 50 under -50, no pair
    println(f"{count_pairs([-1, 1, 2, 3, 1], 2)}");
    println(f"{count_pairs([-6, 2, 5, -2, -7, -1, 3], -2)}");
    println(f"{count_pairs([5], 50)}");
    println(f"{count_pairs(Vec.filled(50, -50), 50)}");
    println(f"{count_pairs(Vec.filled(50, 50), -50)}");
    // 5000 random arrays of 1 to 50 numbers from -50 to 50, the target
    // from -50 to 50
    let mut seed = 2824;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..5000 {
        let n = next_random(mut seed) % 50 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 101 - 50).collect();
        let target = next_random(mut seed) % 101 - 50;
        let a = count_pairs(nums, target);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"5000 arrays: {total} pairs, checksum {check}");
}
