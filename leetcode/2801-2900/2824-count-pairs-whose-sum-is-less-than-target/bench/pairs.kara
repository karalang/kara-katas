// LeetCode #2824: Count Pairs Whose Sum is Less than Target -- the
// bench: the ★ arm over 200000 arrays of 50 numbers from -50 to 50,
// LeetCode's most, all drawn first, then each answered 5 times.

fn count_pairs(nums: Vec[i64], target: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut i = 0;
    let mut j = sorted.len() - 1;
    let mut count = 0;
    while i < j {
        if sorted[i] + sorted[j] < target {
            count += j - i;
            i += 1;
        } else {
            j -= 1;
        }
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 200000;
    let rounds = 5;
    let mut seed = 2824;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for _ in 0..count {
        let nums: Vec[i64] = (0..50).map(|_| next_random(mut seed) % 101 - 50).collect();
        cases.push((nums, next_random(mut seed) % 101 - 50));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, target) in cases.iter() {
            let a = count_pairs(nums, target);
            total += a;
            check = (check * 31 + a + r) % 1000000007;
        }
    }
    println(f"{count} arrays of 50, {rounds} rounds: {total} pairs, checksum {check}");
}
