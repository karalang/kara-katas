// LeetCode #2859: Sum of Values at Indices With K Set Bits -- the
// differential. The five arms, against the statement read literally:
// each index written out in binary as text by `f"{i:b}"`, its '1'
// characters counted, and the values whose index has k of them added.
// 2000 random arrays of 1 to 40 values up to 20 with k up to 6, then 50
// of up to 1000 values up to 10^5 with k up to 10, all drawn before any
// arm answers.
//
// P1  the answer is the literal reading's
// P2  every value doubled: twice the answer
// P3  the answers for k from 0 to 10 add up to the whole array
// P4  the array padded with zeros to twice its length: the same answer
// P5  every value at an index without k set bits made 0: the same answer
// P6  each arm agrees with at least three of the other four

fn literal(nums: Vec[i64], k: i64) -> i64 {
    let mut sum = 0;
    for i in 0..nums.len() {
        let ones = f"{i:b}".chars().filter(|c| c == '1').count();
        if ones == k {
            sum += nums[i];
        }
    }
    sum
}


// ---- star (bits.kara) -----------------------------------------------

fn star_sum_indices_with_k_set_bits(nums: Vec[i64], k: i64) -> i64 {
    nums.iter().enumerate().filter(|(i, _)| i.count_ones() == k).map(|(_, x)| x).sum()
}


// ---- clear (bits_clear.kara) ----------------------------------------

fn clear_set_bits(i: i64) -> i64 {
    let mut rest = i;
    let mut count = 0;
    while rest > 0 {
        rest &= rest - 1;
        count += 1;
    }
    count
}

fn clear_sum_indices_with_k_set_bits(nums: Vec[i64], k: i64) -> i64 {
    let mut sum = 0;
    for i in 0..nums.len() {
        if clear_set_bits(i) == k {
            sum += nums[i];
        }
    }
    sum
}


// ---- table (bits_table.kara) ----------------------------------------

fn table_sum_indices_with_k_set_bits(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut bits: Vec[i64] = Vec.filled(n, 0);
    for i in 1..n {
        bits[i] = bits[i >> 1] + (i & 1);
    }
    (0..n).filter(|i| bits[i] == k).map(|i| nums[i]).sum()
}


// ---- gosper (bits_gosper.kara) --------------------------------------

fn gosper_sum_indices_with_k_set_bits(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    if k == 0 {
        return nums[0];
    }
    let mut sum = 0;
    let mut i = (1 << k) - 1;
    while i < n {
        sum += nums[i];
        let c = i & -i;
        let r = i + c;
        i = (((r ^ i) >> 2) / c) | r;
    }
    sum
}


// ---- solution (bits_solution.kara) ----------------------------------

struct Solution {}

impl Solution {
    pub fn sum_indices_with_k_set_bits(nums: Vec[i32], k: i32) -> i32 {
        nums.iter()
            .enumerate()
            .filter(|(i, _)| i.count_ones() as i32 == k)
            .map(|(_, x)| x)
            .sum()
    }
}

fn solution_sum_indices_with_k_set_bits(nums: Vec[i64], k: i64) -> i64 {
    Solution.sum_indices_with_k_set_bits(nums.iter().map(|x| x as i32).collect(), k as i32)
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_sum_indices_with_k_set_bits(nums, k),
        1 => clear_sum_indices_with_k_set_bits(nums, k),
        2 => table_sum_indices_with_k_set_bits(nums, k),
        3 => gosper_sum_indices_with_k_set_bits(nums, k),
        _ => solution_sum_indices_with_k_set_bits(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "clear", "table", "gosper", "solution"];
    let mut seed = 2859;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 40 + 1 } else { next_random(mut seed) % 1000 + 1 };
        let top = if small { 20 } else { 100000 };
        let k = if small { next_random(mut seed) % 7 } else { next_random(mut seed) % 11 };
        let nums: Vec[i64] = (0..n).map(|_| wide(mut seed) % top + 1).collect();
        cases.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, (nums, k)) in cases.iter().enumerate() {
        let n = nums.len();
        let want = literal(nums, k);
        total += want;
        check = (check * 31 + want) % 1000000007;
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums, k)).collect();
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let whole: i64 = nums.iter().sum();
        let padded: Vec[i64] = (0..2 * n).map(|i| if i < n { nums[i] } else { 0 }).collect();
        let masked: Vec[i64] = (0..n).map(|i| if i.count_ones() == k { nums[i] } else { 0 }).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let every: i64 = (0..11).map(|j| answer(arm, nums, j)).sum();
            let verdicts = [
                value == want,
                answer(arm, doubled, k) == 2 * value,
                every == whole,
                answer(arm, padded, k) == value,
                answer(arm, masked, k) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} k {k} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, sums total {total}: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
