// LeetCode #2845: Count of Interesting Subarrays -- ★: a subarray's
// count of places with nums[i] % modulo == k is a difference of two
// prefix counts, so it is interesting when the earlier prefix is the
// later one less k, mod modulo. A `Map` from each prefix count mod
// modulo to how often it has come up, read before each new prefix is
// added.

fn count_interesting_subarrays(nums: Vec[i64], modulo: i64, k: i64) -> i64 {
    let mut seen: Map[i64, i64] = Map.new();
    seen.insert(0, 1);
    let mut prefix = 0;
    let mut count = 0;
    for x in nums.iter() {
        if x % modulo == k {
            prefix = (prefix + 1) % modulo;
        }
        let want = (prefix - k + modulo) % modulo;
        count += seen.get(want) ?? 0;
        *seen.entry(prefix).or_insert(0) += 1;
    }
    count
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one number; and 4000 numbers with modulo
    // 1, every subarray interesting, then with a modulo of 10^9 that no
    // count reaches
    println(f"{count_interesting_subarrays([3, 2, 4], 2, 1)} {count_interesting_subarrays([3, 1, 9, 6], 3, 0)}");
    println(f"{count_interesting_subarrays([5], 5, 0)} {count_interesting_subarrays([5], 2, 1)}");
    let many: Vec[i64] = (0..4000).map(|i| i % 1000 + 1).collect();
    println(f"{count_interesting_subarrays(many, 1, 0)} {count_interesting_subarrays(many, 1000000000, 999999999)}");
    // 3000 random arrays of 1 to 10 numbers up to 10, modulo up to 5;
    // then 50 of up to 1000 numbers up to 10^9, modulo up to 10 or up to
    // 10^9
    let mut seed = 2845;
    let mut check = 0;
    let mut total = 0;
    for c in 0..3050 {
        let short = c < 3000;
        let n = if short { next_random(mut seed) % 10 + 1 } else { next_random(mut seed) % 1000 + 1 };
        let top = if short { 10 } else { 1000000000 };
        let nums: Vec[i64] = (0..n).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1).collect();
        let modulo = if short or c % 2 == 0 { next_random(mut seed) % if short { 5 } else { 10 } + 1 } else { (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1 };
        let k = (next_random(mut seed) * 32768 + next_random(mut seed)) % modulo;
        let got = count_interesting_subarrays(nums, modulo, k);
        total += got;
        check = (check * 31 + got) % 1000000007;
        if c == 2999 {
            println(f"3000 short arrays: {total} subarrays, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"50 long arrays: {total} subarrays, checksum {check}");
}
