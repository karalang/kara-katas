// LeetCode #2857: Count Pairs of Points With Distance k -- the
// differential. The five arms, against the statement read literally:
// every pair i < j, its distance (x1 XOR x2) + (y1 XOR y2) taken and
// compared with k. 2000 random cases of 2 to 12 points in a 16 x 16
// square with k up to 15, then 50 of up to 300 points with k up to
// 100, every other one in a 64 x 64 square and the rest up to 10^6,
// all drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the points in reverse order: the same answer
// P3  every x XORed with one mask and every y with another: the same answer
// P4  x and y swapped in every point: the same answer
// P5  the points given twice: four times the answer, and n more for k = 0
// P6  each arm agrees with at least three of the other four

fn literal(coordinates: Vec[Vec[i64]], k: i64) -> i64 {
    let n = coordinates.len();
    let mut pairs = 0;
    for i in 0..n {
        for j in i + 1..n {
            let (p, q) = (ref coordinates[i], ref coordinates[j]);
            if (p[0] ^ q[0]) + (p[1] ^ q[1]) == k {
                pairs += 1;
            }
        }
    }
    pairs
}


// ---- star (pairs.kara) ----------------------------------------------

fn star_count_pairs(coordinates: Vec[Vec[i64]], k: i64) -> i64 {
    let mut seen: Map[(i64, i64), i64] = Map.new();
    let mut pairs = 0;
    for p in coordinates.iter() {
        let (x, y) = (p[0], p[1]);
        for a in 0..=k {
            pairs += seen.get((x ^ a, y ^ (k - a))).unwrap_or(0);
        }
        *seen.entry((x, y)).or_insert(0) += 1;
    }
    pairs
}


// ---- sorted (pairs_sorted.kara) -------------------------------------

fn sorted_count_pairs(coordinates: Vec[Vec[i64]], k: i64) -> i64 {
    let pack = |x: i64, y: i64| x * 2097152 + y;
    let mut keys: Vec[i64] = coordinates.iter().map(|p| pack(p[0], p[1])).collect();
    keys.sort();
    let mut ordered = 0;
    for p in coordinates.iter() {
        for a in 0..=k {
            let want = pack(p[0] ^ a, p[1] ^ (k - a));
            let lo = keys.partition_point(|key| key < want);
            let hi = keys.partition_point(|key| key <= want);
            ordered += hi - lo;
        }
    }
    if k == 0 {
        ordered -= coordinates.len();
    }
    ordered / 2
}


// ---- counts (pairs_counts.kara) -------------------------------------

fn counts_count_pairs(coordinates: Vec[Vec[i64]], k: i64) -> i64 {
    let mut counts: SortedMap[(i64, i64), i64] = SortedMap.new();
    for p in coordinates.iter() {
        *counts.entry((p[0], p[1])).or_insert(0) += 1;
    }
    let mut ordered = 0;
    for ((x, y), c) in counts.iter() {
        for a in 0..=k {
            let q = (x ^ a, y ^ (k - a));
            if q == (x, y) {
                ordered += c * (c - 1);
            } else if let Some(d) = counts.get(q) {
                ordered += c * d;
            }
        }
    }
    ordered / 2
}


// ---- rows (pairs_rows.kara) -----------------------------------------

fn rows_count_pairs(coordinates: Vec[Vec[i64]], k: i64) -> i64 {
    let mut rows: Map[i64, Map[i64, i64]] = Map.new();
    let mut pairs = 0;
    for p in coordinates.iter() {
        let (x, y) = (p[0], p[1]);
        for a in 0..=k {
            if let Some(row) = rows.get(x ^ a) {
                pairs += row.get(y ^ (k - a)).unwrap_or(0);
            }
        }
        *rows.entry(x).or_insert(Map.new()).entry(y).or_insert(0) += 1;
    }
    pairs
}


// ---- solution (pairs_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn count_pairs(coordinates: Vec[Vec[i32]], k: i32) -> i32 {
        let mut cnt: Map[(i32, i32), i32] = Map.new();
        let mut ans: i32 = 0;
        for c in coordinates.iter() {
            let (x2, y2) = (c[0], c[1]);
            for i in 0..=k {
                let x1 = i ^ x2;
                let y1 = (k - i) ^ y2;
                ans += cnt.get((x1, y1)).unwrap_or(0);
            }
            *cnt.entry((x2, y2)).or_insert(0) += 1;
        }
        ans
    }
}

fn solution_count_pairs(coordinates: Vec[Vec[i64]], k: i64) -> i64 {
    let c: Vec[Vec[i32]] = coordinates.iter().map(|p| p.iter().map(|v| v as i32).collect()).collect();
    Solution.count_pairs(c, k as i32)
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, coordinates: Vec[Vec[i64]], k: i64) -> i64 {
    match arm {
        0 => star_count_pairs(coordinates, k),
        1 => sorted_count_pairs(coordinates, k),
        2 => counts_count_pairs(coordinates, k),
        3 => rows_count_pairs(coordinates, k),
        _ => solution_count_pairs(coordinates, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "sorted", "counts", "rows", "solution"];
    let mut seed = 2857;
    let mut cases: Vec[(Vec[Vec[i64]], i64)] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 11 + 2 } else { next_random(mut seed) % 299 + 2 };
        let top = if small { 16 } else if c % 2 == 0 { 64 } else { 1000001 };
        let k = if small { next_random(mut seed) % 16 } else { next_random(mut seed) % 101 };
        let mut points: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            let x = wide(mut seed) % top;
            let y = wide(mut seed) % top;
            points.push([x, y].to_vec());
        }
        cases.push((points, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, (points, k)) in cases.iter().enumerate() {
        let n = points.len();
        let want = literal(points, k);
        total += want;
        check = (check * 31 + want) % 1000000007;
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, points, k)).collect();
        let reversed: Vec[Vec[i64]] = points.iter().rev().cloned().collect();
        let (mx, my) = (next_random(mut seed) % 1024, next_random(mut seed) % 1024);
        let masked: Vec[Vec[i64]] = points.iter().map(|p| [p[0] ^ mx, p[1] ^ my].to_vec()).collect();
        let swapped: Vec[Vec[i64]] = points.iter().map(|p| [p[1], p[0]].to_vec()).collect();
        let twice: Vec[Vec[i64]] = points.iter().chain(points.iter()).cloned().collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == want,
                answer(arm, reversed, k) == value,
                answer(arm, masked, k) == value,
                answer(arm, swapped, k) == value,
                answer(arm, twice, k) == 4 * value + if k == 0 { n } else { 0 },
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} k {k} {points}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, {total} pairs: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
