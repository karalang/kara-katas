// LeetCode #2898: Maximum Linear Stock Score -- as a chain, day by day:
// the best linear selection ending on day i is its price plus the best
// ending on the last day before it with the same prices[i] - i, kept in
// a `SortedMap` from that key to the chain's score so far.

fn max_score(prices: Vec[i64]) -> i64 {
    let mut chains: SortedMap[i64, i64] = SortedMap.new();
    let mut best = 0;
    for i in 0..prices.len() {
        let key = prices[i] - i;
        let score = prices[i] + chains.get(key).unwrap_or(0);
        chains.insert(key, score);
        best = best.max(score);
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; 10^5 prices, LeetCode's most: all 10^9,
    // rising by one from 10^9 - 10^5 + 1, and falling by one from 10^9
    println(f"{max_score([1, 5, 3, 7, 8])} {max_score([5, 6, 7, 8, 9])}");
    let n = 100000;
    let rising: Vec[i64] = (0..n).map(|i| 1000000000 - n + 1 + i).collect();
    let falling: Vec[i64] = (0..n).map(|i| 1000000000 - i).collect();
    println(f"{max_score(Vec.filled(n, 1000000000))} {max_score(rising)} {max_score(falling)}");
    // 3000 random arrays of 1 to 8 prices from 1 to 10; then 100 of 1000
    // to 10^5 prices up to 10^9, every other one a few steps off a rise
    // by one
    let mut seed = 2898;
    let mut total = 0;
    let mut check = 0;
    for c in 0..3100 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 8 + 1 } else { wide(mut seed) % 99001 + 1000 };
        let prices: Vec[i64] = (0..n).map(|i| if small { next_random(mut seed) % 10 + 1 } else if c % 2 == 1 { 1000000 + i - next_random(mut seed) % 50 } else { wide(mut seed) % 1000000000 + 1 }).collect();
        let best = max_score(prices);
        total += best;
        check = (check * 31 + best) % 1000000007;
        if c == 2999 {
            println(f"3000 small arrays: scores total {total}, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"100 large arrays: scores total {total}, checksum {check}");
}
