// LeetCode #2898: Maximum Linear Stock Score -- the differential. The
// five arms, against the statement read literally: every nonempty set of
// days tried as a bit mask, kept when each chosen day's price rises from
// the one before by exactly the days between them, and the largest sum
// of prices kept. 2000 random arrays of 1 to 8 prices from 1 to 10, then
// 50 of up to 3000 prices, every other one a few steps off a rise by one
// and the rest up to 10^9, all drawn before any arm answers; the literal
// reading is asked only of the first 2000.
//
// P1  up to 8 prices, the answer is the literal reading's
// P2  from the largest price to the sum of all of them
// P3  a day added after the last at one more: from the answer to the
//     answer plus that price
// P4  the first day cut: from the answer less that day's price to the
//     answer
// P5  the array written again after itself, each price raised by n:
//     from twice the answer to twice the answer plus n * n
// P6  each arm agrees with at least three of the other four

fn literal(prices: Vec[i64]) -> i64 {
    let n = prices.len();
    let mut best = 0;
    for mask in 1..(1 << n) {
        let mut last = -1;
        let mut sum = 0;
        let mut linear = true;
        for i in 0..n {
            if (mask >> i) & 1 == 1 {
                if last >= 0 and prices[i] - prices[last] != i - last {
                    linear = false;
                }
                last = i;
                sum += prices[i];
            }
        }
        if linear {
            best = best.max(sum);
        }
    }
    best
}


// ---- star (stock.kara) ----------------------------------------------

fn star_max_score(prices: Vec[i64]) -> i64 {
    let mut sums: Map[i64, i64] = Map.new();
    for (i, p) in prices.iter().enumerate() {
        *sums.entry(p - i).or_insert(0) += p;
    }
    sums.values().max().unwrap()
}


// ---- index (stock_index.kara) ---------------------------------------

fn index_max_score(prices: Vec[i64]) -> i64 {
    let mut sums: Map[i64, i64] = Map.new();
    for i in 0..prices.len() {
        let key = prices[i] - i;
        sums[key] = sums.get(key).unwrap_or(0) + prices[i];
    }
    let mut best = 0;
    for (_, sum) in sums.iter() {
        best = best.max(sum);
    }
    best
}


// ---- sorted (stock_sorted.kara) -------------------------------------

fn sorted_max_score(prices: Vec[i64]) -> i64 {
    let mut pairs: Vec[(i64, i64)] = prices.iter().enumerate().map(|(i, p)| (p - i, p)).collect();
    pairs.sort();
    let mut best = 0;
    let mut run = 0;
    for j in 0..pairs.len() {
        if j > 0 and pairs[j].0 != pairs[j - 1].0 {
            run = 0;
        }
        run += pairs[j].1;
        best = best.max(run);
    }
    best
}


// ---- chain (stock_chain.kara) ---------------------------------------

fn chain_max_score(prices: Vec[i64]) -> i64 {
    let mut chains: SortedMap[i64, i64] = SortedMap.new();
    let mut best = 0;
    for i in 0..prices.len() {
        let key = prices[i] - i;
        let score = prices[i] + chains.get(key).unwrap_or(0);
        chains.insert(key, score);
        best = best.max(score);
    }
    best
}


// ---- solution (stock_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn max_score(prices: Vec[i32]) -> i64 {
        let mut map: Map[i32, i64] = Map.new();
        for (i, p) in prices.iter().enumerate() {
            *map.entry(p - i as i32).or_insert(0) += p as i64;
        }
        *map.values().max().unwrap()
    }
}

fn solution_max_score(prices: Vec[i64]) -> i64 {
    Solution.max_score(prices.iter().map(|x| x as i32).collect())
}


// ---- the check ---------------------------------------------------------

fn answer(arm: i64, prices: Vec[i64]) -> i64 {
    match arm {
        0 => star_max_score(prices),
        1 => index_max_score(prices),
        2 => sorted_max_score(prices),
        3 => chain_max_score(prices),
        _ => solution_max_score(prices),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "index", "sorted", "chain", "solution"];
    let mut seed = 2898;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 8 + 1 } else { wide(mut seed) % 3000 + 1 };
        let prices: Vec[i64] = (0..n).map(|i| if small { next_random(mut seed) % 10 + 1 } else if c % 2 == 1 { 1000000 + i - next_random(mut seed) % 50 } else { wide(mut seed) % 1000000000 + 1 }).collect();
        cases.push(prices);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, prices) in cases.iter().enumerate() {
        let n = prices.len();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, prices)).collect();
        let want = if c < 2000 { literal(prices) } else { got[0] };
        total += want;
        check = (check * 31 + want) % 1000000007;
        let largest = prices.iter().max().unwrap();
        let all: i64 = prices.iter().sum();
        let added_price = prices[n - 1] + 1;
        let mut added = prices.clone();
        added.push(added_price);
        let cut: Vec[i64] = prices.iter().skip(1).cloned().collect();
        let mut again = prices.clone();
        again.extend(prices.iter().map(|p| p + n));
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let with_added = answer(arm, added);
            let without_first = if n > 1 { answer(arm, cut) } else { 0 };
            let doubled = answer(arm, again);
            let verdicts = [
                c >= 2000 or value == want,
                value >= largest and value <= all,
                with_added >= value and with_added <= value + added_price,
                n == 1 or (without_first >= value - prices[0] and without_first <= value),
                doubled >= 2 * value and doubled <= 2 * value + n * n,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} n {n}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let failed = by_property.iter().sum();
    println(f"{cases.len()} cases, scores total {total}: checksum {check}, {checks} checks over 5 arms: {failed} failures");
    if failed > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
