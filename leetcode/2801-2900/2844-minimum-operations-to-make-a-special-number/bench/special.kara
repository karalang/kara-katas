// LeetCode #2844: Minimum Operations to Make a Special Number -- the
// bench: the ★ arm over 10^5 numbers of 1 to 100 digits, LeetCode's
// most, all drawn first, then each answered 300 times.

fn minimum_operations(num: Str) -> i64 {
    let digits = num.bytes();
    let n = digits.len();
    let mut zero = false;
    let mut five = false;
    for i in (0..n).rev() {
        let d = digits[i];
        if (zero and (d == b'0' or d == b'5')) or (five and (d == b'2' or d == b'7')) {
            return n - i - 2;
        }
        if d == b'0' {
            zero = true;
        }
        if d == b'5' {
            five = true;
        }
    }
    if zero { n - 1 } else { n }
}
fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100000;
    let rounds = 300;
    let mut seed = 2844;
    let mut numbers: Vec[String] = Vec.new();
    for _ in 0..count {
        let n = next_random(mut seed) % 100 + 1;
        let mut digits: Vec[u8] = Vec.new();
        for i in 0..n {
            let low = if i == 0 and n > 1 { 1 } else { 0 };
            digits.push((48 + low + next_random(mut seed) % (10 - low)) as u8);
        }
        numbers.push(String.from_utf8(digits).unwrap());
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for num in numbers.iter() {
            let ops = minimum_operations(num);
            total += ops;
            check = (check * 31 + ops + r) % 1000000007;
        }
    }
    println(f"{count} numbers, {rounds} rounds: {total} operations, checksum {check}");
}
