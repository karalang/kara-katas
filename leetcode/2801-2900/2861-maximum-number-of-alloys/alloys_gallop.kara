// LeetCode #2861: Maximum Number of Alloys -- a galloping search per
// machine: the step doubles from 1 while x plus the step stays within
// the budget, and halves once it does not, so x climbs to the largest
// count in O(log x) probes without a fixed upper bound; the probe adds
// the shortfalls with an early stop once the budget is passed.

fn affordable(n: i64, budget: i64, machine: Vec[i64], stock: Vec[i64], cost: Vec[i64], x: i64) -> bool {
    let mut spent = 0;
    for j in 0..n {
        let short = machine[j] * x - stock[j];
        if short > 0 {
            spent += short * cost[j];
            if spent > budget {
                return false;
            }
        }
    }
    true
}

fn max_number_of_alloys(n: i64, k: i64, budget: i64, composition: Vec[Vec[i64]], stock: Vec[i64], cost: Vec[i64]) -> i64 {
    let mut best = 0;
    for machine in composition.iter() {
        let mut x = 0;
        let mut step = 1;
        while affordable(n, budget, machine, stock, cost, x + step) {
            x += step;
            step *= 2;
        }
        while step > 1 {
            step /= 2;
            if affordable(n, budget, machine, stock, cost, x + step) {
                x += step;
            }
        }
        best = best.max(x);
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn grid(rows: i64, cols: i64, low: i64, top: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    (0..rows).map(|_| (0..cols).map(|_| low + wide(mut seed) % (top - low + 1)).collect()).collect()
}

fn main() {
    // LeetCode's three examples; and LeetCode's full size: 100 metals of
    // 10^8 in stock, one of each per alloy at 1 a unit, 10^8 to spend
    let comp = [[1, 1, 1].to_vec(), [1, 1, 10].to_vec()].to_vec();
    let a = max_number_of_alloys(3, 2, 15, comp, [0, 0, 0].to_vec(), [1, 2, 3].to_vec());
    let b = max_number_of_alloys(3, 2, 15, comp, [0, 0, 100].to_vec(), [1, 2, 3].to_vec());
    let c = max_number_of_alloys(2, 3, 10, [[2, 1].to_vec(), [1, 2].to_vec(), [1, 1].to_vec()].to_vec(), [1, 1].to_vec(), [5, 5].to_vec());
    let ones: Vec[Vec[i64]] = Vec.filled(100, Vec.filled(100, 1));
    let most = max_number_of_alloys(100, 100, 100000000, ones, Vec.filled(100, 100000000), Vec.filled(100, 1));
    println(f"{a} {b} {c} {most}");
    // 3000 random cases of 1 to 4 metals and 1 to 3 machines, small
    // amounts; then 30 of up to 100 of each at LeetCode's full ranges
    let mut seed = 2861;
    let mut total = 0;
    let mut check = 0;
    for c in 0..3030 {
        let small = c < 3000;
        let (n, k) = if small { (next_random(mut seed) % 4 + 1, next_random(mut seed) % 3 + 1) } else { (next_random(mut seed) % 100 + 1, next_random(mut seed) % 100 + 1) };
        let (most_comp, most_stock, most_cost, most_budget) = if small { (5, 20, 5, 50) } else { (100, 100000000, 100, 100000000) };
        let composition = grid(k, n, 1, most_comp, mut seed);
        let stock = grid(1, n, 0, most_stock, mut seed)[0].clone();
        let cost = grid(1, n, 1, most_cost, mut seed)[0].clone();
        let budget = wide(mut seed) % (most_budget + 1);
        let alloys = max_number_of_alloys(n, k, budget, composition, stock, cost);
        total += alloys;
        check = (check * 31 + alloys) % 1000000007;
        if c == 2999 {
            println(f"3000 small cases: {total} alloys, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"30 large cases: {total} alloys, checksum {check}");
}
