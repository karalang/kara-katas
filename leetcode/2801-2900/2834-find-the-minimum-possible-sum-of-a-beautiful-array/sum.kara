// LeetCode #2834: Find the Minimum Possible Sum of a Beautiful Array --
// ★: the closed form. Of each pair x and target - x only the smaller can
// be taken, so 1 to min(n, target / 2) first, and the rest from target
// up; two arithmetic series, reduced modulo 10^9 + 7 at the end.

const MOD: i64 = 1000000007;

fn minimum_possible_sum(n: i64, target: i64) -> i64 {
    let low = n.min(target / 2);
    let high = n - low;
    let first = low * (low + 1) / 2;
    let rest = high * (2 * target + high - 1) / 2;
    (first + rest) % MOD
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's three examples; a target too small to bar anything; and
    // n and target at LeetCode's most, 10^9
    println(f"{minimum_possible_sum(2, 3)} {minimum_possible_sum(3, 3)} {minimum_possible_sum(1, 1)}");
    println(f"{minimum_possible_sum(5, 2)} {minimum_possible_sum(4, 100)}");
    println(f"{minimum_possible_sum(1000000000, 1000000000)} {minimum_possible_sum(1000000000, 1)}");
    println(f"{minimum_possible_sum(1, 1000000000)} {minimum_possible_sum(999999999, 1000000000)}");
    // every n and target from 1 to 60; then 20000 random pairs up to 10^9
    let mut check = 0;
    for n in 1..=60 {
        for target in 1..=60 {
            check = (check * 31 + minimum_possible_sum(n, target)) % 1000000007;
        }
    }
    println(f"3600 small pairs: checksum {check}");
    let mut seed = 2834;
    check = 0;
    for _ in 0..20000 {
        let n = wide(mut seed) % 1000000000 + 1;
        let target = wide(mut seed) % 1000000000 + 1;
        check = (check * 31 + minimum_possible_sum(n, target)) % 1000000007;
    }
    println(f"20000 random pairs: checksum {check}");
}
