// LeetCode #2832: Maximal Range That Each Element Is Maximum in It --
// one pass: a falling stack; a number popped by a greater one has found
// its right end, and its left end is the number below it on the stack;
// what is left at the end runs to the array's end.

fn maximum_length_of_ranges(nums: Vec[i64]) -> Vec[i64] {
    let n = nums.len();
    let mut ans: Vec[i64] = Vec.filled(n, 0);
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..=n {
        while not stack.is_empty() and (i == n or nums[stack[stack.len() - 1]] < nums[i]) {
            let top = stack.pop().unwrap();
            let left = if stack.is_empty() { -1 } else { stack[stack.len() - 1] };
            ans[top] = i - left - 1;
        }
        stack.push(i);
    }
    ans
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn digest(xs: Vec[i64]) -> i64 {
    xs.iter().fold(0, |h, x| (h * 131 + x) % 1000000007)
}

// n distinct numbers from 1 to 10^5: the i-th in its own stride of
// 10^5 / n, picked at random there, and then all shuffled
fn distinct(n: i64, seed: mut ref i64) -> Vec[i64] {
    let step = 100000 / n;
    let mut nums: Vec[i64] = (0..n).map(|i| i * step + next_random(mut seed) % step + 1).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        nums.swap(i, j);
    }
    nums
}

fn main() {
    // LeetCode's two examples; one number; falling; and 10^5 numbers,
    // LeetCode's most, 1 to 10^5 shuffled
    println(f"{maximum_length_of_ranges([1, 5, 4, 3, 6])}");
    println(f"{maximum_length_of_ranges([1, 2, 3, 4, 5])}");
    println(f"{maximum_length_of_ranges([7])}");
    println(f"{maximum_length_of_ranges([9, 7, 5, 3, 1])}");
    let mut seed = 2832;
    let out = maximum_length_of_ranges(distinct(100000, mut seed));
    println(f"{out.len()} {out.iter().sum()} {digest(out)}");
    // 3000 random arrays of 1 to 12 numbers; then 50 of up to 3000
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 12 + 1;
        check = (check * 31 + digest(maximum_length_of_ranges(distinct(n, mut seed)))) % 1000000007;
    }
    println(f"3000 short arrays: checksum {check}");
    check = 0;
    for _ in 0..50 {
        let n = next_random(mut seed) % 3000 + 1;
        check = (check * 31 + digest(maximum_length_of_ranges(distinct(n, mut seed)))) % 1000000007;
    }
    println(f"50 long arrays: checksum {check}");
}
