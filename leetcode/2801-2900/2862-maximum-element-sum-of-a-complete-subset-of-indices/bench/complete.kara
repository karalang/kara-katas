// LeetCode #2862: Maximum Element-Sum of a Complete Subset of Indices --
// the bench: the ★ arm over 200 arrays of 10^4 values up to 10^9,
// LeetCode's most, all drawn first, then each answered 50 times.

fn maximum_sum(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut best = 0;
    for k in 1..=n {
        let mut sum = 0;
        let mut j = 1;
        while k * j * j <= n {
            sum += nums[k * j * j - 1];
            j += 1;
        }
        best = best.max(sum);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 200;
    let rounds = 50;
    let n = 10000;
    let mut seed = 2862;
    let arrays: Vec[Vec[i64]] = (0..count).map(|_| (0..n).map(|_| wide(mut seed) % 1000000000 + 1).collect()).collect();
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in arrays.iter() {
            let best = maximum_sum(nums);
            total += best;
            check = (check * 31 + best % 1000000007 + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {n}, {rounds} rounds: best sums total {total}, checksum {check}");
}
