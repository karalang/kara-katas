// LeetCode #2862: Maximum Element-Sum of a Complete Subset of Indices --
// ★: two indices multiply to a square exactly when they share their
// square-free part k, so the complete sets are the indices k·1², k·2²,
// k·3², ... for each k; every k from 1 to n is walked up its squares
// and the best sum kept.

fn maximum_sum(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut best = 0;
    for k in 1..=n {
        let mut sum = 0;
        let mut j = 1;
        while k * j * j <= n {
            sum += nums[k * j * j - 1];
            j += 1;
        }
        best = best.max(sum);
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; 10^4 values of 10^9, LeetCode's most; and
    // 10^4 values each its own index
    println(f"{maximum_sum([8, 7, 3, 5, 7, 2, 4, 9].to_vec())} {maximum_sum([8, 10, 3, 8, 1, 13, 7, 9, 4].to_vec())}");
    let n = 10000;
    println(f"{maximum_sum(Vec.filled(n, 1000000000))} {maximum_sum((1..=n).collect())}");
    // 3000 random arrays of 1 to 30 values up to 20; then 30 of 1000 to
    // 10^4 values up to 10^9
    let mut seed = 2862;
    let mut total = 0;
    let mut check = 0;
    for c in 0..3030 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 30 + 1 } else { wide(mut seed) % 9001 + 1000 };
        let top = if small { 20 } else { 1000000000 };
        let nums: Vec[i64] = (0..n).map(|_| wide(mut seed) % top + 1).collect();
        let best = maximum_sum(nums);
        total += best;
        check = (check * 31 + best) % 1000000007;
        if c == 2999 {
            println(f"3000 short arrays: best sums total {total}, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"30 long arrays: best sums total {total}, checksum {check}");
}
