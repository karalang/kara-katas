// LeetCode #2862: Maximum Element-Sum of a Complete Subset of Indices --
// each index's square-free part found by factoring with a sieve of
// smallest prime factors: a prime that divides an odd number of times
// stays in. The values are added up by part in a `Map`, and the best
// part's sum is the answer.

fn maximum_sum(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut least: Vec[i64] = (0..=n).collect();
    let mut p = 2;
    while p * p <= n {
        if least[p] == p {
            let mut q = p * p;
            while q <= n {
                if least[q] == q {
                    least[q] = p;
                }
                q += p;
            }
        }
        p += 1;
    }
    let mut by_part: Map[i64, i64] = Map.new();
    for i in 1..=n {
        let mut rest = i;
        let mut part = 1;
        while rest > 1 {
            let p = least[rest];
            let mut times = 0;
            while rest % p == 0 {
                rest /= p;
                times += 1;
            }
            if times % 2 == 1 {
                part *= p;
            }
        }
        *by_part.entry(part).or_insert(0) += nums[i - 1];
    }
    by_part.values().max().unwrap()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; 10^4 values of 10^9, LeetCode's most; and
    // 10^4 values each its own index
    println(f"{maximum_sum([8, 7, 3, 5, 7, 2, 4, 9].to_vec())} {maximum_sum([8, 10, 3, 8, 1, 13, 7, 9, 4].to_vec())}");
    let n = 10000;
    println(f"{maximum_sum(Vec.filled(n, 1000000000))} {maximum_sum((1..=n).collect())}");
    // 3000 random arrays of 1 to 30 values up to 20; then 30 of 1000 to
    // 10^4 values up to 10^9
    let mut seed = 2862;
    let mut total = 0;
    let mut check = 0;
    for c in 0..3030 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 30 + 1 } else { wide(mut seed) % 9001 + 1000 };
        let top = if small { 20 } else { 1000000000 };
        let nums: Vec[i64] = (0..n).map(|_| wide(mut seed) % top + 1).collect();
        let best = maximum_sum(nums);
        total += best;
        check = (check * 31 + best) % 1000000007;
        if c == 2999 {
            println(f"3000 short arrays: best sums total {total}, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"30 long arrays: best sums total {total}, checksum {check}");
}
