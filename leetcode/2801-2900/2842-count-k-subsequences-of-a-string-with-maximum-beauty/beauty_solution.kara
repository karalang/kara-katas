// LeetCode #2842: Count K-Subsequences of a String With Maximum Beauty
// -- a Rust solution as LeetCode's Rust users write it, carried to Kāra
// by `karac fix`: a `[0i64; 26]` of counts, the nonzero ones filtered
// out with `|&&c|` and sorted by `sort_unstable_by(|a, b| b.cmp(a))`,
// and the binomial over the tie by a running product and a modular
// inverse from a `pow` by squaring, the answer as `i32`.

const MOD: i64 = 1_000_000_007;

struct Solution {}

impl Solution {
    fn pow(b: i64, e: i64) -> i64 {
        let mut b = b;
        let mut e = e;
        let mut r = 1;
        b %= MOD;
        while e > 0 {
            if e & 1 == 1 {
                r = r * b % MOD;
            }
            b = b * b % MOD;
            e >>= 1;
        }
        r
    }

    pub fn count_k_subsequences_with_max_beauty(s: String, k: i32) -> i32 {
        let mut cnt = [0; 26];
        for b in s.bytes() {
            cnt[b - b'a'] += 1;
        }
        let mut f: Vec[i64] = cnt.iter().filter(|c| c > 0).cloned().collect();
        let k = k as i64;
        if k > f.len() {
            return 0;
        }
        f.sort_by(|a, b| b.cmp(a));
        let t = f[k - 1];
        let mut ans = 1;
        let mut need = 0;
        for x in ref f {
            if x > t {
                ans = ans * x % MOD;
            } else if x == t {
                need += 1;
            }
        }
        let r = k - f.iter().filter(|x| x > t).count();
        let mut c = 1;
        for i in 0..r {
            c = c * (need - i) % MOD;
            c = c * Solution.pow(i + 1, MOD - 2) % MOD;
        }
        ans = ans * c % MOD * Solution.pow(t, r) % MOD;
        ans as i32
    }
}

fn count_k_subsequences_with_max_beauty(s: Str, k: i64) -> i64 {
    Solution.count_k_subsequences_with_max_beauty(s.to_string(), k as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn letters(n: i64, kinds: i64, seed: mut ref i64) -> String {
    let codes: Vec[u8] = (0..n).map(|_| (97 + next_random(mut seed) % kinds) as u8).collect();
    String.from_utf8(codes).unwrap()
}

fn main() {
    // LeetCode's two examples; k above the distinct letters; one letter;
    // and 2 x 10^5 letters, LeetCode's most, over all 26, with k = 26
    // and k = 13
    let best = |s: Str, k: i64| count_k_subsequences_with_max_beauty(s, k);
    println(f"{best("bcca", 2)} {best("abbcd", 4)} {best("aabb", 3)} {best("z", 1)}");
    let mut seed = 2842;
    let long = letters(200000, 26, mut seed);
    println(f"{best(long, 26)} {best(long, 13)}");
    // 3000 random strings of 1 to 10 letters over a to e, k up to 6;
    // then 100 of up to 20000 letters over the first 3 to 26, k up to 26
    let mut check = 0;
    let mut zero = 0;
    for c in 0..3100 {
        let short = c < 3000;
        let n = if short { next_random(mut seed) % 10 + 1 } else { next_random(mut seed) % 20000 + 1 };
        let kinds = if short { 5 } else { next_random(mut seed) % 24 + 3 };
        let s = letters(n, kinds, mut seed);
        let k = if short { next_random(mut seed) % 6 + 1 } else { next_random(mut seed) % 26 + 1 };
        let ways = best(s, k);
        if ways == 0 {
            zero += 1;
        }
        check = (check * 31 + ways) % 1000000007;
        if c == 2999 {
            println(f"3000 short strings: {zero} with none, checksum {check}");
            check = 0;
            zero = 0;
        }
    }
    println(f"100 long strings: {zero} with none, checksum {check}");
}
