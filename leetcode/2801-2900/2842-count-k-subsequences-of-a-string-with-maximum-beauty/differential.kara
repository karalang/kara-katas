// LeetCode #2842: Count K-Subsequences of a String With Maximum Beauty
// -- the differential. The five arms, against the statement read
// literally: every choice of k places in s by a bitmask, kept when its
// letters are all different, its beauty the sum of their counts in s,
// and the choices of the most beauty counted. 2000 random strings of 1
// to 10 letters over a to e with k up to 6, then 50 of up to 2000 over
// the first 3 to 26 letters with k up to 26, all drawn before any arm
// answers; the literal reading is asked only of the first 2000.
//
// P1  up to 10 letters, the answer is the literal reading's
// P2  the string reversed: the same answer
// P3  every letter moved on one, z to a: the same answer
// P4  the string written twice: the answer times 2^k
// P5  k = 1: the most common letter's count times the letters that have it
// P6  each arm agrees with at least three of the other four

fn literal(s: Str, k: i64) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut count: Vec[i64] = Vec.filled(26, 0);
    for c in b.iter() {
        count[c - b'a'] += 1;
    }
    let mut best = -1;
    let mut ways = 0;
    for mask in 0..(1 << n) {
        if mask.count_ones() != k {
            continue;
        }
        let mut seen: Vec[bool] = Vec.filled(26, false);
        let mut beauty = 0;
        let mut fresh = true;
        for i in 0..n {
            if mask >> i & 1 == 1 {
                let c = b[i] - b'a';
                if seen[c] {
                    fresh = false;
                }
                seen[c] = true;
                beauty += count[c];
            }
        }
        if not fresh {
            continue;
        }
        if beauty > best {
            best = beauty;
            ways = 1;
        } else if beauty == best {
            ways += 1;
        }
    }
    ways
}


// ---- star (beauty.kara) ---------------------------------------------

const STAR_MOD: i64 = 1000000007;

fn star_power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut b = base % STAR_MOD;
    let mut e = exp;
    while e > 0 {
        if e % 2 == 1 {
            result = result * b % STAR_MOD;
        }
        b = b * b % STAR_MOD;
        e /= 2;
    }
    result
}

fn star_choose(n: i64, r: i64) -> i64 {
    let mut top = 1;
    let mut bottom = 1;
    for i in 0..r {
        top = top * (n - i) % STAR_MOD;
        bottom = bottom * (i + 1) % STAR_MOD;
    }
    top * star_power(bottom, STAR_MOD - 2) % STAR_MOD
}

fn star_count_k_subsequences_with_max_beauty(s: Str, k: i64) -> i64 {
    let mut count: Vec[i64] = Vec.filled(26, 0);
    for b in s.bytes() {
        count[b - b'a'] += 1;
    }
    let mut freq: Vec[i64] = count.iter().filter(|c| c > 0).collect();
    if k > freq.len() {
        return 0;
    }
    freq.sort_by(|a, b| b.cmp(a));
    let last = freq[k - 1];
    let above = freq.iter().filter(|f| f > last).count();
    let tied = freq.iter().filter(|f| f == last).count();
    let mut ways = star_choose(tied, k - above) * star_power(last, k - above) % STAR_MOD;
    for f in freq[..above].iter() {
        ways = ways * f % STAR_MOD;
    }
    ways
}


// ---- knapsack (beauty_knapsack.kara) --------------------------------

fn knapsack_count_k_subsequences_with_max_beauty(s: Str, k: i64) -> i64 {
    let modulus = 1000000007;
    let mut count = [0; 26];
    for c in s.chars() {
        count[(c as i64) - ('a' as i64)] += 1;
    }
    // -1 marks a size no set of the letters so far can reach
    let mut best: Vec[i64] = Vec.filled(k + 1, -1);
    let mut ways: Vec[i64] = Vec.filled(k + 1, 0);
    best[0] = 0;
    ways[0] = 1;
    for f in count {
        if f == 0 {
            continue;
        }
        for j in (1..k + 1).rev() {
            if best[j - 1] < 0 {
                continue;
            }
            let with = best[j - 1] + f;
            let reach = ways[j - 1] * f % modulus;
            if with > best[j] {
                best[j] = with;
                ways[j] = reach;
            } else if with == best[j] {
                ways[j] = (ways[j] + reach) % modulus;
            }
        }
    }
    ways[k]
}


// ---- heap (beauty_heap.kara) ----------------------------------------

fn heap_count_k_subsequences_with_max_beauty(s: Str, k: i64) -> i64 {
    let modulus = 1000000007;
    let mut count: Vec[i64] = Vec.filled(26, 0);
    for b in s.bytes() {
        count[b - b'a'] += 1;
    }
    let mut heap: PriorityQueue[i64] = PriorityQueue.max_first();
    for c in count.iter() {
        if c > 0 {
            heap.push(c);
        }
    }
    if k > heap.len() {
        return 0;
    }
    let mut pascal: Vec[Vec[i64]] = Vec.new();
    for n in 0..27 {
        let mut row: Vec[i64] = Vec.filled(n + 1, 1);
        for r in 1..n {
            row[r] = (pascal[n - 1][r - 1] + pascal[n - 1][r]) % modulus;
        }
        pascal.push(row);
    }
    let mut left = k;
    let mut ways = 1;
    while left > 0 {
        let f = heap.pop().unwrap();
        let mut tied = 1;
        while heap.peek().cloned() == Some(f) {
            heap.pop();
            tied += 1;
        }
        let take = tied.min(left);
        ways = ways * pascal[tied][take] % modulus;
        for _ in 0..take {
            ways = ways * f % modulus;
        }
        left -= take;
    }
    ways
}


// ---- grouped (beauty_grouped.kara) ----------------------------------

fn grouped_count_k_subsequences_with_max_beauty(s: Str, k: i64) -> i64 {
    let modulus = 1000000007;
    let mut count: Map[char, i64] = Map.new();
    for c in s.chars() {
        *count.entry(c).or_insert(0) += 1;
    }
    if k > count.len() {
        return 0;
    }
    let mut groups: SortedMap[i64, i64] = SortedMap.new();
    for (_, f) in count.iter() {
        *groups.entry(f).or_insert(0) += 1;
    }
    let mut left = k;
    let mut ways = 1;
    for (f, letters) in groups.iter().rev() {
        if left == 0 {
            break;
        }
        let take = letters.min(left);
        let mut pick = 1;
        for i in 0..take {
            pick = pick * (letters - i) / (i + 1);
        }
        ways = ways * pick % modulus;
        for _ in 0..take {
            ways = ways * f % modulus;
        }
        left -= take;
    }
    ways
}


// ---- solution (beauty_solution.kara) --------------------------------

const SOLUTION_MOD: i64 = 1_000_000_007;

struct Solution {}

impl Solution {
    fn pow(b: i64, e: i64) -> i64 {
        let mut b = b;
        let mut e = e;
        let mut r = 1;
        b %= SOLUTION_MOD;
        while e > 0 {
            if e & 1 == 1 {
                r = r * b % SOLUTION_MOD;
            }
            b = b * b % SOLUTION_MOD;
            e >>= 1;
        }
        r
    }

    pub fn count_k_subsequences_with_max_beauty(s: String, k: i32) -> i32 {
        let mut cnt = [0; 26];
        for b in s.bytes() {
            cnt[b - b'a'] += 1;
        }
        let mut f: Vec[i64] = cnt.iter().filter(|c| c > 0).cloned().collect();
        let k = k as i64;
        if k > f.len() {
            return 0;
        }
        f.sort_by(|a, b| b.cmp(a));
        let t = f[k - 1];
        let mut ans = 1;
        let mut need = 0;
        for x in ref f {
            if x > t {
                ans = ans * x % SOLUTION_MOD;
            } else if x == t {
                need += 1;
            }
        }
        let r = k - f.iter().filter(|x| x > t).count();
        let mut c = 1;
        for i in 0..r {
            c = c * (need - i) % SOLUTION_MOD;
            c = c * Solution.pow(i + 1, SOLUTION_MOD - 2) % SOLUTION_MOD;
        }
        ans = ans * c % SOLUTION_MOD * Solution.pow(t, r) % SOLUTION_MOD;
        ans as i32
    }
}

fn solution_count_k_subsequences_with_max_beauty(s: Str, k: i64) -> i64 {
    Solution.count_k_subsequences_with_max_beauty(s.to_string(), k as i32)
}


// ---- the check ---------------------------------------------------------

fn answer(arm: i64, s: Str, k: i64) -> i64 {
    match arm {
        0 => star_count_k_subsequences_with_max_beauty(s, k),
        1 => knapsack_count_k_subsequences_with_max_beauty(s, k),
        2 => heap_count_k_subsequences_with_max_beauty(s, k),
        3 => grouped_count_k_subsequences_with_max_beauty(s, k),
        _ => solution_count_k_subsequences_with_max_beauty(s, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn letters(n: i64, kinds: i64, seed: mut ref i64) -> String {
    let codes: Vec[u8] = (0..n).map(|_| (97 + next_random(mut seed) % kinds) as u8).collect();
    String.from_utf8(codes).unwrap()
}

fn shifted(s: Str) -> String {
    s.bytes().iter().map(|b| ((b - b'a' + 1) % 26 + b'a') as char).collect()
}

fn main() {
    let names = ["star", "knapsack", "heap", "grouped", "solution"];
    let mut seed = 2842;
    let mut cases: Vec[(String, i64)] = Vec.new();
    for c in 0..2050 {
        let short = c < 2000;
        let n = if short { next_random(mut seed) % 10 + 1 } else { next_random(mut seed) % 2000 + 1 };
        let kinds = if short { 5 } else { next_random(mut seed) % 24 + 3 };
        let s = letters(n, kinds, mut seed);
        let k = if short { next_random(mut seed) % 6 + 1 } else { next_random(mut seed) % 26 + 1 };
        cases.push((s, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (s, k)) in cases.iter().enumerate() {
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, s, k)).collect();
        let want = if c < 2000 { literal(s, k) } else { got[0] };
        check = (check * 31 + want) % 1000000007;
        let back: String = s.chars().rev().collect();
        let twice = f"{s}{s}";
        let mut count: Vec[i64] = Vec.filled(26, 0);
        for b in s.bytes() {
            count[b - b'a'] += 1;
        }
        let most = count.iter().max().unwrap();
        let with_most = count.iter().filter(|f| f == most).count();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                c >= 2000 or value == want,
                answer(arm, back, k) == value,
                answer(arm, shifted(s), k) == value,
                answer(arm, twice, k) == value * (1 << k) % 1000000007,
                answer(arm, s, 1) == most * with_most,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {s} k={k}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
