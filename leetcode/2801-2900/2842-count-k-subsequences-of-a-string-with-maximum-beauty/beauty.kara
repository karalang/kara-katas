// LeetCode #2842: Count K-Subsequences of a String With Maximum Beauty
// -- ★: the letters' counts sorted, most first. The best k take the k
// largest; every letter counted above the k-th must be in, and the rest
// are chosen among the letters tied with it, C(tied, wanted) ways, each
// letter in a choice taken at any of its places. The binomial by
// factorials and an inverse from Fermat's little theorem.

const MOD: i64 = 1000000007;

fn power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut b = base % MOD;
    let mut e = exp;
    while e > 0 {
        if e % 2 == 1 {
            result = result * b % MOD;
        }
        b = b * b % MOD;
        e /= 2;
    }
    result
}

fn choose(n: i64, r: i64) -> i64 {
    let mut top = 1;
    let mut bottom = 1;
    for i in 0..r {
        top = top * (n - i) % MOD;
        bottom = bottom * (i + 1) % MOD;
    }
    top * power(bottom, MOD - 2) % MOD
}

fn count_k_subsequences_with_max_beauty(s: Str, k: i64) -> i64 {
    let mut count: Vec[i64] = Vec.filled(26, 0);
    for b in s.bytes() {
        count[b - b'a'] += 1;
    }
    let mut freq: Vec[i64] = count.iter().filter(|c| c > 0).collect();
    if k > freq.len() {
        return 0;
    }
    freq.sort_by(|a, b| b.cmp(a));
    let last = freq[k - 1];
    let above = freq.iter().filter(|f| f > last).count();
    let tied = freq.iter().filter(|f| f == last).count();
    let mut ways = choose(tied, k - above) * power(last, k - above) % MOD;
    for f in freq[..above].iter() {
        ways = ways * f % MOD;
    }
    ways
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn letters(n: i64, kinds: i64, seed: mut ref i64) -> String {
    let codes: Vec[u8] = (0..n).map(|_| (97 + next_random(mut seed) % kinds) as u8).collect();
    String.from_utf8(codes).unwrap()
}

fn main() {
    // LeetCode's two examples; k above the distinct letters; one letter;
    // and 2 x 10^5 letters, LeetCode's most, over all 26, with k = 26
    // and k = 13
    let best = |s: Str, k: i64| count_k_subsequences_with_max_beauty(s, k);
    println(f"{best("bcca", 2)} {best("abbcd", 4)} {best("aabb", 3)} {best("z", 1)}");
    let mut seed = 2842;
    let long = letters(200000, 26, mut seed);
    println(f"{best(long, 26)} {best(long, 13)}");
    // 3000 random strings of 1 to 10 letters over a to e, k up to 6;
    // then 100 of up to 20000 letters over the first 3 to 26, k up to 26
    let mut check = 0;
    let mut zero = 0;
    for c in 0..3100 {
        let short = c < 3000;
        let n = if short { next_random(mut seed) % 10 + 1 } else { next_random(mut seed) % 20000 + 1 };
        let kinds = if short { 5 } else { next_random(mut seed) % 24 + 3 };
        let s = letters(n, kinds, mut seed);
        let k = if short { next_random(mut seed) % 6 + 1 } else { next_random(mut seed) % 26 + 1 };
        let ways = best(s, k);
        if ways == 0 {
            zero += 1;
        }
        check = (check * 31 + ways) % 1000000007;
        if c == 2999 {
            println(f"3000 short strings: {zero} with none, checksum {check}");
            check = 0;
            zero = 0;
        }
    }
    println(f"100 long strings: {zero} with none, checksum {check}");
}
