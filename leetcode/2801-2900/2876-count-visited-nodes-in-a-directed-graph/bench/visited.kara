// LeetCode #2876: Count Visited Nodes in a Directed Graph -- the bench:
// the ★ arm over 20 graphs of 10^5 nodes, LeetCode's most, every other
// one with each edge a step of 1 to 5 forward and the rest anywhere,
// all drawn first, then each answered 20 times.

fn count_visited_nodes(edges: Vec[i64]) -> Vec[i64] {
    let n = edges.len();
    let mut incoming: Vec[i64] = Vec.filled(n, 0);
    for e in edges.iter() {
        incoming[e] += 1;
    }
    let mut peeled: Vec[i64] = (0..n).filter(|u| incoming[u] == 0).collect();
    let mut head = 0;
    while head < peeled.len() {
        let w = edges[peeled[head]];
        head += 1;
        incoming[w] -= 1;
        if incoming[w] == 0 {
            peeled.push(w);
        }
    }
    let mut answer: Vec[i64] = Vec.filled(n, 0);
    for start in 0..n {
        if incoming[start] > 0 and answer[start] == 0 {
            let mut cycle: Vec[i64] = [start].to_vec();
            let mut u = edges[start];
            while u != start {
                cycle.push(u);
                u = edges[u];
            }
            for v in cycle.iter() {
                answer[v] = cycle.len();
            }
        }
    }
    for u in peeled.iter().rev() {
        answer[u] = answer[edges[u]] + 1;
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 20;
    let rounds = 20;
    let n = 100000;
    let mut seed = 2876;
    let mut graphs: Vec[Vec[i64]] = Vec.new();
    for c in 0..count {
        let edges: Vec[i64] = (0..n).map(|i| if c % 2 == 1 { (i + next_random(mut seed) % 5 + 1) % n } else { (i + wide(mut seed) % (n - 1) + 1) % n }).collect();
        graphs.push(edges);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for edges in graphs.iter() {
            let counts = count_visited_nodes(edges);
            total += counts.iter().sum();
            check = (check * 31 + counts[r] + counts[n - 1 - r]) % 1000000007;
        }
    }
    println(f"{count} graphs of {n}, {rounds} rounds: visits total {total}, checksum {check}");
}
