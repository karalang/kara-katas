// LeetCode #2876: Count Visited Nodes in a Directed Graph -- ★: every
// node has one edge out, so each part of the graph is a cycle with
// trees hanging into it. Nodes with nothing coming in are peeled off,
// Kahn's way, until only the cycles are left; a node on a cycle visits
// its cycle's length, and a peeled node, taken in the reverse of the
// peeling order, one more than the node its edge leads to.

fn count_visited_nodes(edges: Vec[i64]) -> Vec[i64] {
    let n = edges.len();
    let mut incoming: Vec[i64] = Vec.filled(n, 0);
    for e in edges.iter() {
        incoming[e] += 1;
    }
    let mut peeled: Vec[i64] = (0..n).filter(|u| incoming[u] == 0).collect();
    let mut head = 0;
    while head < peeled.len() {
        let w = edges[peeled[head]];
        head += 1;
        incoming[w] -= 1;
        if incoming[w] == 0 {
            peeled.push(w);
        }
    }
    let mut answer: Vec[i64] = Vec.filled(n, 0);
    for start in 0..n {
        if incoming[start] > 0 and answer[start] == 0 {
            let mut cycle: Vec[i64] = [start].to_vec();
            let mut u = edges[start];
            while u != start {
                cycle.push(u);
                u = edges[u];
            }
            for v in cycle.iter() {
                answer[v] = cycle.len();
            }
        }
    }
    for u in peeled.iter().rev() {
        answer[u] = answer[edges[u]] + 1;
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; 10^5 nodes, LeetCode's most, as one cycle,
    // and as a path into a cycle of two at its end
    println(f"{count_visited_nodes([1, 2, 0, 0].to_vec())} {count_visited_nodes([1, 2, 3, 4, 0].to_vec())}");
    let n = 100000;
    let ring: Vec[i64] = count_visited_nodes((0..n).map(|i| (i + 1) % n).collect());
    let path: Vec[i64] = count_visited_nodes((0..n).map(|i| if i == n - 1 { n - 2 } else { i + 1 }).collect());
    println(f"{ring.iter().sum()} {path.iter().sum()} {path[0]} {path[n - 1]}");
    // 3000 random graphs of 2 to 8 nodes; then 100 of 1000 to 10^5,
    // every other one with each edge a step of 1 to 5 forward
    let mut seed = 2876;
    let mut total = 0;
    let mut check = 0;
    for c in 0..3100 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 7 + 2 } else { wide(mut seed) % 99001 + 1000 };
        let edges: Vec[i64] = (0..n).map(|i| if not small and c % 2 == 1 { (i + next_random(mut seed) % 5 + 1) % n } else { (i + wide(mut seed) % (n - 1) + 1) % n }).collect();
        for v in count_visited_nodes(edges).iter() {
            total += v;
            check = (check * 31 + v) % 1000000007;
        }
        if c == 2999 {
            println(f"3000 small graphs: visits total {total}, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"100 large graphs: visits total {total}, checksum {check}");
}
