// LeetCode #2876: Count Visited Nodes in a Directed Graph -- the
// differential. The five arms, against the statement read literally:
// from every node the edges followed, the nodes met kept, until one
// comes round again, and the count of them taken. 2000 random graphs of
// 2 to 10 nodes, then 50 of up to 3000, every other one with each edge
// a step of 1 to 5 forward, all drawn before any arm answers; the
// literal reading is asked only of the first 2000.
//
// P1  up to 10 nodes, the answer is the literal reading's
// P2  every label v made n - 1 - v: the answers in reverse
// P3  a new node with its edge into node 0: the same answers, and one
//     more than node 0's for it
// P4  each count from 2 to n, and its edge's count or one more
// P5  the counts that equal their edge's are the cycles': as many
//     nodes hold such a count L as a multiple of L
// P6  each arm agrees with at least three of the other four

fn literal(edges: Vec[i64]) -> Vec[i64] {
    let n = edges.len();
    let mut counts: Vec[i64] = Vec.new();
    for start in 0..n {
        let mut met: Vec[bool] = Vec.filled(n, false);
        let mut u = start;
        let mut count = 0;
        while not met[u] {
            met[u] = true;
            count += 1;
            u = edges[u];
        }
        counts.push(count);
    }
    counts
}


// ---- star (visited.kara) --------------------------------------------

fn star_count_visited_nodes(edges: Vec[i64]) -> Vec[i64] {
    let n = edges.len();
    let mut incoming: Vec[i64] = Vec.filled(n, 0);
    for e in edges.iter() {
        incoming[e] += 1;
    }
    let mut peeled: Vec[i64] = (0..n).filter(|u| incoming[u] == 0).collect();
    let mut head = 0;
    while head < peeled.len() {
        let w = edges[peeled[head]];
        head += 1;
        incoming[w] -= 1;
        if incoming[w] == 0 {
            peeled.push(w);
        }
    }
    let mut answer: Vec[i64] = Vec.filled(n, 0);
    for start in 0..n {
        if incoming[start] > 0 and answer[start] == 0 {
            let mut cycle: Vec[i64] = [start].to_vec();
            let mut u = edges[start];
            while u != start {
                cycle.push(u);
                u = edges[u];
            }
            for v in cycle.iter() {
                answer[v] = cycle.len();
            }
        }
    }
    for u in peeled.iter().rev() {
        answer[u] = answer[edges[u]] + 1;
    }
    answer
}


// ---- walk (visited_walk.kara) ---------------------------------------

fn walk_count_visited_nodes(edges: Vec[i64]) -> Vec[i64] {
    let n = edges.len();
    let mut answer: Vec[i64] = Vec.filled(n, 0);
    let mut place: Vec[i64] = Vec.filled(n, -1);
    for start in 0..n {
        if answer[start] > 0 {
            continue;
        }
        let mut walk: Vec[i64] = Vec.new();
        let mut u = start;
        while answer[u] == 0 and place[u] < 0 {
            place[u] = walk.len();
            walk.push(u);
            u = edges[u];
        }
        let mut end = walk.len();
        if answer[u] == 0 {
            let first = place[u];
            for i in first..end {
                answer[walk[i]] = end - first;
            }
            end = first;
        }
        for i in (0..end).rev() {
            answer[walk[i]] = answer[edges[walk[i]]] + 1;
        }
        for v in walk.iter() {
            place[v] = -1;
        }
    }
    answer
}


// ---- memo (visited_memo.kara) ---------------------------------------

fn memo_visit(u: i64, depth: i64, edges: Vec[i64], seen: mut ref Vec[i64], answer: mut ref Vec[i64]) -> i64 {
    if answer[u] > 0 {
        return -1;
    }
    if seen[u] >= 0 {
        answer[u] = depth - seen[u];
        return u;
    }
    seen[u] = depth;
    let top = memo_visit(edges[u], depth + 1, edges, mut seen, mut answer);
    if top >= 0 {
        if top == u {
            return -1;
        }
        answer[u] = answer[top];
        return top;
    }
    answer[u] = answer[edges[u]] + 1;
    -1
}

fn memo_count_visited_nodes(edges: Vec[i64]) -> Vec[i64] {
    let n = edges.len();
    let mut seen: Vec[i64] = Vec.filled(n, -1);
    let mut answer: Vec[i64] = Vec.filled(n, 0);
    for u in 0..n {
        memo_visit(u, 0, edges, mut seen, mut answer);
    }
    answer
}


// ---- reverse (visited_reverse.kara) ---------------------------------

fn reverse_count_visited_nodes(edges: Vec[i64]) -> Vec[i64] {
    let n = edges.len();
    let mut colour: Vec[i64] = Vec.filled(n, 0);
    let mut answer: Vec[i64] = Vec.filled(n, 0);
    let mut queue: Vec[i64] = Vec.new();
    for start in 0..n {
        let mut u = start;
        while colour[u] == 0 {
            colour[u] = 1;
            u = edges[u];
        }
        if colour[u] == 1 {
            let mut length = 1;
            let mut v = edges[u];
            while v != u {
                length += 1;
                v = edges[v];
            }
            for _ in 0..length {
                answer[v] = length;
                queue.push(v);
                v = edges[v];
            }
        }
        let mut w = start;
        while colour[w] == 1 {
            colour[w] = 2;
            w = edges[w];
        }
    }
    let mut into: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for (u, e) in edges.iter().enumerate() {
        into[e].push(u);
    }
    let mut head = 0;
    while head < queue.len() {
        let w = queue[head];
        head += 1;
        for u in into[w].iter() {
            if answer[u] == 0 {
                answer[u] = answer[w] + 1;
                queue.push(u);
            }
        }
    }
    answer
}


// ---- solution (visited_solution.kara) -------------------------------

struct Solution {}

impl Solution {
    pub fn count_visited_nodes(edges: Vec[i32]) -> Vec[i32] {
        let n = edges.len();
        let mut indeg = Vec.filled(n, 0);
        for e in ref edges {
            indeg[e] += 1;
        }
        let mut q = VecDeque.new();
        for i in 0..n {
            if indeg[i] == 0 {
                q.push_back(i);
            }
        }
        let mut order: Vec[i64] = Vec.new();
        while let Some(u) = q.pop_front() {
            order.push(u);
            let v = edges[u] as i64;
            indeg[v] -= 1;
            if indeg[v] == 0 {
                q.push_back(v);
            }
        }
        let mut ans = Vec.filled(n, 0);
        for i in 0..n {
            if indeg[i] > 0 and ans[i] == 0 {
                let mut len = 1;
                let mut j = edges[i] as i64;
                while j != i {
                    len += 1;
                    j = edges[j];
                }
                let mut j = i;
                for _ in 0..len {
                    ans[j] = len;
                    j = edges[j];
                }
            }
        }
        for u in order.iter().rev() {
            ans[u] = ans[edges[u]] + 1;
        }
        ans
    }
}

fn solution_count_visited_nodes(edges: Vec[i64]) -> Vec[i64] {
    Solution.count_visited_nodes(edges.iter().map(|x| x as i32).collect()).iter().map(|x| x as i64).collect()
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, edges: Vec[i64]) -> Vec[i64] {
    match arm {
        0 => star_count_visited_nodes(edges),
        1 => walk_count_visited_nodes(edges),
        2 => memo_count_visited_nodes(edges),
        3 => reverse_count_visited_nodes(edges),
        _ => solution_count_visited_nodes(edges),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "walk", "memo", "reverse", "solution"];
    let mut seed = 2876;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 9 + 2 } else { wide(mut seed) % 3000 + 2 };
        let edges: Vec[i64] = (0..n).map(|i| if not small and c % 2 == 1 { (i + next_random(mut seed) % 5 + 1) % n } else { (i + wide(mut seed) % (n - 1) + 1) % n }).collect();
        cases.push(edges);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, edges) in cases.iter().enumerate() {
        let n = edges.len();
        let got: Vec[Vec[i64]] = (0..5).map(|arm| answer(arm, edges)).collect();
        let want = if c < 2000 { literal(edges) } else { got[0].clone() };
        for v in want.iter() {
            total += v;
            check = (check * 31 + v) % 1000000007;
        }
        let flipped: Vec[i64] = edges.iter().rev().map(|e| n - 1 - e).collect();
        let mut grown = edges.clone();
        grown.push(0);
        for arm in 0..5 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let reversed: Vec[i64] = value.iter().rev().cloned().collect();
            let mut more = value.clone();
            more.push(value[0] + 1);
            let steps = (0..n).all(|u| value[u] >= 2 and value[u] <= n and (value[u] == value[edges[u]] or value[u] == value[edges[u]] + 1));
            let mut on_cycle: Vec[i64] = Vec.filled(n + 1, 0);
            for u in 0..n {
                if value[u] == value[edges[u]] and value[u] <= n {
                    on_cycle[value[u]] += 1;
                }
            }
            let cycles = (1..n + 1).all(|l| on_cycle[l] % l == 0);
            let verdicts = [
                c >= 2000 or value == want,
                answer(arm, flipped) == reversed,
                answer(arm, grown) == more,
                steps,
                cycles,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} n {n}, arm {names[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, visits total {total}: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
