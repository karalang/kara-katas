// LeetCode #2876: Count Visited Nodes in a Directed Graph -- a Rust
// solution as LeetCode's Rust users write it: in-degrees peeled with a
// `VecDeque`, each cycle measured and filled, then the peeled nodes
// filled from a `Vec<usize>` order walked backwards, `as usize` at every
// index.

struct Solution {}

impl Solution {
    pub fn count_visited_nodes(edges: Vec[i32]) -> Vec[i32] {
        let n = edges.len();
        let mut indeg = Vec.filled(n, 0);
        for e in ref edges {
            indeg[e] += 1;
        }
        let mut q = VecDeque.new();
        for i in 0..n {
            if indeg[i] == 0 {
                q.push_back(i);
            }
        }
        let mut order: Vec[i64] = Vec.new();
        while let Some(u) = q.pop_front() {
            order.push(u);
            let v = edges[u] as i64;
            indeg[v] -= 1;
            if indeg[v] == 0 {
                q.push_back(v);
            }
        }
        let mut ans = Vec.filled(n, 0);
        for i in 0..n {
            if indeg[i] > 0 and ans[i] == 0 {
                let mut len = 1;
                let mut j = edges[i] as i64;
                while j != i {
                    len += 1;
                    j = edges[j];
                }
                let mut j = i;
                for _ in 0..len {
                    ans[j] = len;
                    j = edges[j];
                }
            }
        }
        for u in order.iter().rev() {
            ans[u] = ans[edges[u]] + 1;
        }
        ans
    }
}

fn count_visited_nodes(edges: Vec[i64]) -> Vec[i64] {
    Solution.count_visited_nodes(edges.iter().map(|x| x as i32).collect()).iter().map(|x| x as i64).collect()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; 10^5 nodes, LeetCode's most, as one cycle,
    // and as a path into a cycle of two at its end
    println(f"{count_visited_nodes([1, 2, 0, 0].to_vec())} {count_visited_nodes([1, 2, 3, 4, 0].to_vec())}");
    let n = 100000;
    let ring: Vec[i64] = count_visited_nodes((0..n).map(|i| (i + 1) % n).collect());
    let path: Vec[i64] = count_visited_nodes((0..n).map(|i| if i == n - 1 { n - 2 } else { i + 1 }).collect());
    println(f"{ring.iter().sum()} {path.iter().sum()} {path[0]} {path[n - 1]}");
    // 3000 random graphs of 2 to 8 nodes; then 100 of 1000 to 10^5,
    // every other one with each edge a step of 1 to 5 forward
    let mut seed = 2876;
    let mut total = 0;
    let mut check = 0;
    for c in 0..3100 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 7 + 2 } else { wide(mut seed) % 99001 + 1000 };
        let edges: Vec[i64] = (0..n).map(|i| if not small and c % 2 == 1 { (i + next_random(mut seed) % 5 + 1) % n } else { (i + wide(mut seed) % (n - 1) + 1) % n }).collect();
        for v in count_visited_nodes(edges).iter() {
            total += v;
            check = (check * 31 + v) % 1000000007;
        }
        if c == 2999 {
            println(f"3000 small graphs: visits total {total}, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"100 large graphs: visits total {total}, checksum {check}");
}
