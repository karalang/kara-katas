// LeetCode #2868: The Wording Game -- the bench: the ★ arm over 20
// deals of 10^5 words, LeetCode's most, of 1 to 8 letters, every other
// one from a to e only, all drawn first, then each played 20 times.

fn table(words: Vec[String]) -> Vec[i64] {
    let mut top: Vec[i64] = Vec.filled(26, -1);
    for (i, w) in words.iter().enumerate() {
        top[w.bytes()[0] - b'a'] = i;
    }
    top
}

fn can_alice_win(a: Vec[String], b: Vec[String]) -> bool {
    let mut last = a[0].clone();
    let tops = [table(a), table(b)];
    let hands = [a, b];
    let mut turn = 1;
    loop {
        let c = (last.bytes()[0] - b'a') as i64;
        let same = tops[turn][c];
        if same >= 0 and hands[turn][same] > last {
            last = hands[turn][same].clone();
        } else if c < 25 and tops[turn][c + 1] >= 0 {
            last = hands[turn][tops[turn][c + 1]].clone();
        } else {
            return turn == 1;
        }
        turn = 1 - turn;
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn deal(seed: mut ref i64, n: i64, letters: i64, longest: i64) -> (Vec[String], Vec[String]) {
    let mut words: Vec[String] = Vec.new();
    for _ in 0..n {
        let len = next_random(mut seed) % longest + 1;
        let word: String = (0..len).map(|_| (b'a' + (next_random(mut seed) % letters) as u8) as char).collect();
        words.push(word);
    }
    words.sort();
    words.dedup();
    let mut a: Vec[String] = Vec.new();
    let mut b: Vec[String] = Vec.new();
    let first = next_random(mut seed) % words.len();
    for (i, w) in words.iter().enumerate() {
        if i == first or (next_random(mut seed) % 2 == 0 and i != (first + 1) % words.len()) {
            a.push(w.clone());
        } else {
            b.push(w.clone());
        }
    }
    (a, b)
}

fn main() {
    let count = 20;
    let rounds = 20;
    let n = 100000;
    let mut seed = 2868;
    let mut deals: Vec[(Vec[String], Vec[String])] = Vec.new();
    for c in 0..count {
        deals.push(deal(mut seed, n, if c % 2 == 0 { 26 } else { 5 }, 8));
    }
    let mut wins = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (a, b) in deals.iter() {
            let win = can_alice_win(a, b);
            if win {
                wins += 1;
            }
            check = (check * 2 + r + if win { 1 } else { 0 }) % 1000000007;
        }
    }
    println(f"{count} deals of {n} words, {rounds} rounds: Alice wins {wins}, checksum {check}");
}
