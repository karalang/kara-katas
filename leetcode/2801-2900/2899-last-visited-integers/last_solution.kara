// LeetCode #2899: Last Visited Integers -- a Rust solution as LeetCode's
// Rust users write it: `seen` as a `Vec<i32>` pushed at the end, the run
// counted in a `usize`, the k-th read as `seen[seen.len() - k]`.

struct Solution {}

impl Solution {
    pub fn last_visited_integers(nums: Vec[i32]) -> Vec[i32] {
        let mut seen: Vec[i32] = Vec.new();
        let mut ans = Vec.new();
        let mut k: i64 = 0;
        for x in nums.iter() {
            if x == -1 {
                k += 1;
                if k <= seen.len() {
                    ans.push(seen[seen.len() - k]);
                } else {
                    ans.push(-1);
                }
            } else {
                seen.push(x);
                k = 0;
            }
        }
        ans
    }
}

fn last_visited_integers(nums: Vec[i64]) -> Vec[i64] {
    Solution.last_visited_integers(nums.iter().map(|x| x as i32).collect())
        .into_iter()
        .map(|x| x as i64)
        .collect()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn digest(ans: Vec[i64], total: mut ref i64, check: mut ref i64) {
    *check = (*check * 31 + ans.len()) % 1000000007;
    for v in ans.iter() {
        *total += v;
        *check = (*check * 31 + v + 2) % 1000000007;
    }
}

fn main() {
    // LeetCode's two examples; 100 entries, LeetCode's most: all -1, 50
    // integers then 50 -1s, and integers and -1s in turn
    println(f"{last_visited_integers([1, 2, -1, -1, -1])} {last_visited_integers([1, -1, 2, -1, -1])}");
    let all: Vec[i64] = Vec.filled(100, -1);
    let half: Vec[i64] = (0..100).map(|i| if i < 50 { i + 1 } else { -1 }).collect();
    let turns: Vec[i64] = (0..100).map(|i| if i % 2 == 0 { i + 1 } else { -1 }).collect();
    for nums in [all, half, turns] {
        let ans = last_visited_integers(nums);
        println(f"{ans.len()} answers: first {ans[0]}, last {ans[ans.len() - 1]}");
    }
    // 3000 random arrays of 1 to 10 entries, each -1 one time in two and
    // otherwise 1 to 5; then 1000 of 100 entries, -1 one time in three
    // and otherwise 1 to 100
    let mut seed = 2899;
    let mut total = 0;
    let mut check = 0;
    for c in 0..4000 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 10 + 1 } else { 100 };
        let nums: Vec[i64] = (0..n).map(|_| if small { if next_random(mut seed) % 2 == 0 { -1 } else { next_random(mut seed) % 5 + 1 } } else if next_random(mut seed) % 3 == 0 { -1 } else { next_random(mut seed) % 100 + 1 }).collect();
        digest(last_visited_integers(nums), mut total, mut check);
        if c == 2999 {
            println(f"3000 small arrays: answers total {total}, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"1000 arrays of 100: answers total {total}, checksum {check}");
}
