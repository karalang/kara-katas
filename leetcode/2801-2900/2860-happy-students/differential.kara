// LeetCode #2860: Happy Students -- the differential. The five arms,
// against the statement read literally: for classes of up to 10, every
// group of students tried as a bit mask, each student checked happy,
// chosen with more chosen than their value or left out with fewer, and
// the groups where everyone is counted. 2000 random classes of 1 to 10,
// then 50 of up to 300, all drawn before any arm answers; the literal
// reading is asked only of the first 2000.
//
// P1  up to 10 students, the answer is the literal reading's
// P2  the students in reverse order: the same answer
// P3  each student v made two, 2v and 2v + 1: the same answer
// P4  the whole class chosen always works: from 1 to n + 1
// P5  the values sorted: the same answer
// P6  each arm agrees with at least three of the other four

fn literal(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut ways = 0;
    for mask in 0..1 << n {
        let chosen = mask.count_ones();
        let happy = (0..n).all(|i| if mask >> i & 1 == 1 { chosen > nums[i] } else { chosen < nums[i] });
        if happy {
            ways += 1;
        }
    }
    ways
}


// ---- star (happy.kara) ----------------------------------------------

fn star_count_ways(nums: Vec[i64]) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    let mut ways = 0;
    for k in 0..=n {
        let chosen_ok = k == 0 or sorted[k - 1] < k;
        let left_ok = k == n or sorted[k] > k;
        if chosen_ok and left_ok {
            ways += 1;
        }
    }
    ways
}


// ---- counts (happy_counts.kara) -------------------------------------

fn counts_count_ways(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut count: Vec[i64] = Vec.filled(n + 1, 0);
    for x in nums.iter() {
        count[x] += 1;
    }
    let mut below = 0;
    let mut ways = 0;
    for k in 0..=n {
        if below == k and count[k] == 0 {
            ways += 1;
        }
        below += count[k];
    }
    ways
}


// ---- search (happy_search.kara) -------------------------------------

fn search_count_ways(nums: Vec[i64]) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    (0..=n).filter(|k| sorted.partition_point(|x| x < k) == k and sorted.partition_point(|x| x <= k) == k).count()
}


// ---- sizes (happy_sizes.kara) ---------------------------------------

fn sizes_count_ways(nums: Vec[i64]) -> i64 {
    let mut counts: SortedMap[i64, i64] = SortedMap.new();
    for x in nums.iter() {
        *counts.entry(x).or_insert(0) += 1;
    }
    let values: Vec[(i64, i64)] = counts.iter().collect();
    let mut ways = if values[0].0 > 0 { 1 } else { 0 };
    let mut at_most = 0;
    for i in 0..values.len() {
        let (v, c) = values[i];
        at_most += c;
        let next = if i + 1 < values.len() { values[i + 1].0 } else { i64.MAX };
        if v < at_most and at_most < next {
            ways += 1;
        }
    }
    ways
}


// ---- solution (happy_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn count_ways(nums: own Vec[i32]) -> i32 {
        let mut nums = nums;
        nums.sort();
        let n = nums.len();
        let mut ans = (nums[0] > 0) as i32;
        for k in 1..=n {
            if nums[k - 1] < k as i32 and (k == n or nums[k] > k as i32) {
                ans += 1;
            }
        }
        ans
    }
}

fn solution_count_ways(nums: Vec[i64]) -> i64 {
    Solution.count_ways(nums.iter().map(|x| x as i32).collect())
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_count_ways(nums),
        1 => counts_count_ways(nums),
        2 => search_count_ways(nums),
        3 => sizes_count_ways(nums),
        _ => solution_count_ways(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn class(n: i64, seed: mut ref i64) -> Vec[i64] {
    if next_random(mut seed) % 2 == 0 {
        return (0..n).map(|_| wide(mut seed) % n).collect();
    }
    let g = wide(mut seed) % (n + 1);
    let mut nums: Vec[i64] = (0..n).map(|i| if i < g { wide(mut seed) % g.max(1) } else { g + 1 + wide(mut seed) % (n - g).max(1) }).collect();
    for x in nums.iter_mut() {
        *x = (*x).min(n - 1);
    }
    if next_random(mut seed) % 4 == 0 {
        nums[wide(mut seed) % n] = g.min(n - 1);
    }
    for i in (1..n).rev() {
        let j = wide(mut seed) % (i + 1);
        nums.swap(i, j);
    }
    nums
}

fn main() {
    let names = ["star", "counts", "search", "sizes", "solution"];
    let mut seed = 2860;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        let n = if c < 2000 { next_random(mut seed) % 10 + 1 } else { next_random(mut seed) % 300 + 1 };
        cases.push(class(n, mut seed));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, nums) in cases.iter().enumerate() {
        let n = nums.len();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        let want = if c < 2000 { literal(nums) } else { got[0] };
        total += want;
        check = (check * 31 + want) % 1000000007;
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let paired: Vec[i64] = nums.iter().flat_map(|v| [2 * v, 2 * v + 1].into_iter()).collect();
        let mut sorted = nums.clone();
        sorted.sort();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                c >= 2000 or value == want,
                answer(arm, reversed) == value,
                answer(arm, paired) == value,
                value >= 1 and value <= n + 1,
                answer(arm, sorted) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, {total} ways: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
