// LeetCode #2900: Longest Unequal Adjacent Groups Subsequence I -- the
// differential. The five arms, against the statement read literally:
// every nonempty set of indices tried as a bit mask, kept when no two
// neighbours in it share a group, and the longest kept, the earliest
// indices among equals, as every arm picks. 2000 random cases of 1 to 8
// words with random groups, then 50 of up to 3000 words in runs of a
// group up to 5 long, all drawn before any arm answers; the literal
// reading is asked only of the first 2000.
//
// P1  up to 8 words, the answer is the literal reading's
// P2  the answer is a subsequence of the words, no two neighbours in it
//     of one group
// P3  one word for each run of a group
// P4  the groups flipped: the same answer
// P5  a word added at the end in the last word's group: the same
//     answer; in the other group: that word added to it
// P6  each arm agrees with at least three of the other four

fn literal(words: Vec[String], groups: Vec[i64]) -> Vec[String] {
    let n = words.len();
    let mut best: Vec[i64] = Vec.new();
    for mask in 1..(1 << n) {
        let chosen: Vec[i64] = (0..n).filter(|i| (mask >> i) & 1 == 1).collect();
        let mut unequal = true;
        for j in 1..chosen.len() {
            if groups[chosen[j]] == groups[chosen[j - 1]] {
                unequal = false;
            }
        }
        if unequal and (chosen.len() > best.len() or (chosen.len() == best.len() and chosen < best)) {
            best = chosen;
        }
    }
    best.iter().map(|i| words[i].clone()).collect()
}


// ---- star (words.kara) ----------------------------------------------

fn star_get_longest_subsequence(words: Vec[String], groups: Vec[i64]) -> Vec[String] {
    let mut chosen: Vec[String] = Vec.new();
    for i in 0..words.len() {
        if i == 0 or groups[i] != groups[i - 1] {
            chosen.push(words[i].clone());
        }
    }
    chosen
}


// ---- filter (words_filter.kara) -------------------------------------

fn filter_get_longest_subsequence(words: Vec[String], groups: Vec[i64]) -> Vec[String] {
    (0..words.len()).filter(|i| i == 0 or groups[i] != groups[i - 1]).map(|i| words[i].clone()).collect()
}


// ---- runs (words_runs.kara) -----------------------------------------

fn runs_get_longest_subsequence(words: Vec[String], groups: Vec[i64]) -> Vec[String] {
    let mut chosen: Vec[String] = Vec.new();
    let mut last: Option[i64] = None;
    for (word, group) in words.iter().zip(groups.iter()) {
        if last != Some(group) {
            chosen.push(word.clone());
            last = Some(group);
        }
    }
    chosen
}


// ---- dp (words_dp.kara) ---------------------------------------------

fn dp_get_longest_subsequence(words: Vec[String], groups: Vec[i64]) -> Vec[String] {
    let n = words.len();
    let mut longest: Vec[i64] = Vec.filled(n, 1);
    for i in (0..n).rev() {
        for j in i + 1..n {
            if groups[j] != groups[i] {
                longest[i] = longest[i].max(longest[j] + 1);
            }
        }
    }
    let best = longest.iter().max().unwrap();
    let mut chosen: Vec[String] = Vec.new();
    let mut need = best;
    let mut at = 0;
    while longest[at] != need {
        at += 1;
    }
    chosen.push(words[at].clone());
    need -= 1;
    while need > 0 {
        let mut next = at + 1;
        while groups[next] == groups[at] or longest[next] != need {
            next += 1;
        }
        at = next;
        chosen.push(words[at].clone());
        need -= 1;
    }
    chosen
}


// ---- solution (words_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn get_longest_subsequence(words: Vec[String], groups: Vec[i32]) -> Vec[String] {
        let mut ans = [words[0].clone()];
        for i in 1..groups.len() {
            if groups[i] != groups[i - 1] {
                ans.push(words[i].clone());
            }
        }
        ans
    }
}

fn solution_get_longest_subsequence(words: Vec[String], groups: Vec[i64]) -> Vec[String] {
    Solution.get_longest_subsequence(words, groups.iter().map(|g| g as i32).collect())
}


// ---- the check ---------------------------------------------------------

fn answer(arm: i64, words: Vec[String], groups: Vec[i64]) -> Vec[String] {
    match arm {
        0 => star_get_longest_subsequence(words, groups),
        1 => filter_get_longest_subsequence(words, groups),
        2 => runs_get_longest_subsequence(words, groups),
        3 => dp_get_longest_subsequence(words, groups),
        _ => solution_get_longest_subsequence(words, groups),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn draw_words(n: i64, seed: mut ref i64) -> Vec[String] {
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut words: Vec[String] = Vec.new();
    for i in 0..n {
        let mut word = String.new();
        word.push(letters[next_random(mut seed) % 26]);
        let mut rest = i;
        loop {
            word.push(letters[rest % 26]);
            rest /= 26;
            if rest == 0 {
                break;
            }
        }
        words.push(word);
    }
    words
}

fn main() {
    let names = ["star", "filter", "runs", "dp", "solution"];
    let mut seed = 2900;
    let mut cases: Vec[(Vec[String], Vec[i64])] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 8 + 1 } else { next_random(mut seed) % 3000 + 1 };
        let words = draw_words(n, mut seed);
        let mut groups: Vec[i64] = Vec.new();
        let mut group = next_random(mut seed) % 2;
        while groups.len() < n {
            let run = if small { 1 } else { next_random(mut seed) % 5 + 1 };
            for _ in 0..run {
                if groups.len() < n {
                    groups.push(if small { next_random(mut seed) % 2 } else { group });
                }
            }
            group = 1 - group;
        }
        cases.push((words, groups));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, (words, groups)) in cases.iter().enumerate() {
        let n = words.len();
        let got: Vec[Vec[String]] = (0..5).map(|arm| answer(arm, words, groups)).collect();
        let want = if c < 2000 { literal(words, groups) } else { got[0].clone() };
        total += want.len();
        check = (check * 31 + want.len()) % 1000000007;
        for word in want.iter() {
            for b in word.bytes().iter() {
                check = (check * 31 + b as i64) % 1000000007;
            }
            check = (check * 31 + 1) % 1000000007;
        }
        let runs = 1 + (1..n).filter(|i| groups[i] != groups[i - 1]).count();
        let at: Map[String, i64] = (0..n).map(|i| (words[i].clone(), i)).collect();
        let flipped: Vec[i64] = groups.iter().map(|g| 1 - g).collect();
        let mut more_words = words.clone();
        more_words.push("zzzz");
        let mut same_group = groups.clone();
        same_group.push(groups[n - 1]);
        let mut other_group = groups.clone();
        other_group.push(1 - groups[n - 1]);
        for arm in 0..5 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let mut ordered = true;
            for j in 0..value.len() {
                match at.get(value[j]) {
                    Some(i) => {
                        if j > 0 {
                            match at.get(value[j - 1]) {
                                Some(before) => {
                                    if before >= i or groups[before] == groups[i] {
                                        ordered = false;
                                    }
                                }
                                None => ordered = false,
                            }
                        }
                    }
                    None => ordered = false,
                }
            }
            let mut grown = value.clone();
            grown.push("zzzz");
            let verdicts = [
                c >= 2000 or value == want,
                ordered,
                value.len() == runs,
                answer(arm, words, flipped) == value,
                answer(arm, more_words, same_group) == value and answer(arm, more_words, other_group) == grown,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} n {n}, arm {names[arm]}: P{q + 1} fails, gave {value.len()} words");
                    }
                }
            }
        }
    }
    let failed = by_property.iter().sum();
    println(f"{cases.len()} cases, {total} words chosen: checksum {check}, {checks} checks over 5 arms: {failed} failures");
    if failed > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
