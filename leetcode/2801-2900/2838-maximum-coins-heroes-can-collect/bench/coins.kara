// LeetCode #2838: Maximum Coins Heroes Can Collect -- the bench: the ★
// arm over 10 battles of 10^5 heroes and 10^5 monsters, LeetCode's
// most, powers and coins up to 10^9, all drawn first, then each
// answered 5 times.

fn maximum_coins(heroes: Vec[i64], monsters: Vec[i64], coins: Vec[i64]) -> Vec[i64] {
    let mut pairs: Vec[(i64, i64)] = monsters.iter().zip(coins.iter()).collect();
    pairs.sort();
    let mut prefix: Vec[i64] = [0];
    for (_, c) in pairs.iter() {
        prefix.push(prefix[prefix.len() - 1] + c);
    }
    heroes.iter().map(|h| prefix[pairs.partition_point(|(p, _)| p <= h)]).collect()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 10;
    let rounds = 5;
    let n = 100000;
    let mut seed = 2838;
    let mut battles: Vec[(Vec[i64], Vec[i64], Vec[i64])] = Vec.new();
    for _ in 0..count {
        let heroes: Vec[i64] = (0..n).map(|_| wide(mut seed) % 1000000000 + 1).collect();
        let monsters: Vec[i64] = (0..n).map(|_| wide(mut seed) % 1000000000 + 1).collect();
        let coins: Vec[i64] = (0..n).map(|_| wide(mut seed) % 1000000000 + 1).collect();
        battles.push((heroes, monsters, coins));
    }
    let mut check = 0;
    for r in 0..rounds {
        for (heroes, monsters, coins) in battles.iter() {
            for x in maximum_coins(heroes, monsters, coins).iter() {
                check = (check * 31 + x % 1000000007 + r) % 1000000007;
            }
        }
    }
    println(f"{count} battles of {n}, {rounds} rounds: checksum {check}");
}
