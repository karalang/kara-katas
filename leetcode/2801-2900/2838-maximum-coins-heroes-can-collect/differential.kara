// LeetCode #2838: Maximum Coins Heroes Can Collect -- the differential.
// The five arms, against the statement read literally: each hero meets
// every monster in turn and takes the coins of each one it beats, power
// at least the monster's. 2000 random battles of 1 to 6 heroes and
// monsters with powers up to 8, then 50 of up to 800 each with powers
// and coins up to 10^9. Every case is drawn before any arm answers; the
// literal reading is asked of every case.
//
// P1  the answer is the literal reading's
// P2  the heroes reversed: the answer reversed
// P3  the monsters and their coins reversed together: the same answer
// P4  every power doubled: the same answer
// P5  a monster of power 1 with 7 coins added: every answer 7 more
// P6  each arm agrees with at least three of the other four

fn literal(heroes: Vec[i64], monsters: Vec[i64], coins: Vec[i64]) -> Vec[i64] {
    heroes
        .iter()
        .map(|h| (0..monsters.len()).filter(|j| h >= monsters[j]).map(|j| coins[j]).sum())
        .collect()
}


// ---- star (coins.kara) ----------------------------------------------

fn star_maximum_coins(heroes: Vec[i64], monsters: Vec[i64], coins: Vec[i64]) -> Vec[i64] {
    let mut pairs: Vec[(i64, i64)] = monsters.iter().zip(coins.iter()).collect();
    pairs.sort();
    let mut prefix: Vec[i64] = [0];
    for (_, c) in pairs.iter() {
        prefix.push(prefix[prefix.len() - 1] + c);
    }
    heroes.iter().map(|h| prefix[pairs.partition_point(|(p, _)| p <= h)]).collect()
}


// ---- sweep (coins_sweep.kara) ---------------------------------------

fn sweep_maximum_coins(heroes: Vec[i64], monsters: Vec[i64], coins: Vec[i64]) -> Vec[i64] {
    let mut by_hero: Vec[i64] = (0..heroes.len()).collect();
    by_hero.sort_by_key(|i| heroes[i]);
    let mut by_monster: Vec[i64] = (0..monsters.len()).collect();
    by_monster.sort_by_key(|j| monsters[j]);
    let mut ans: Vec[i64] = Vec.filled(heroes.len(), 0);
    let mut sum = 0;
    let mut next = 0;
    for i in by_hero.iter() {
        while next < by_monster.len() and monsters[by_monster[next]] <= heroes[i] {
            sum += coins[by_monster[next]];
            next += 1;
        }
        ans[i] = sum;
    }
    ans
}


// ---- floor (coins_floor.kara) ---------------------------------------

fn floor_maximum_coins(heroes: Vec[i64], monsters: Vec[i64], coins: Vec[i64]) -> Vec[i64] {
    let mut at: SortedMap[i64, i64] = SortedMap.new();
    for j in 0..monsters.len() {
        *at.entry(monsters[j]).or_insert(0) += coins[j];
    }
    let mut upto: SortedMap[i64, i64] = SortedMap.new();
    let mut running = 0;
    for (power, c) in at.iter() {
        running += c;
        upto.insert(power, running);
    }
    heroes
        .iter()
        .map(|h| match upto.floor(h) {
            Some((_, total)) => total,
            None => 0,
        })
        .collect()
}


// ---- each (coins_each.kara) -----------------------------------------

fn each_maximum_coins(heroes: Vec[i64], monsters: Vec[i64], coins: Vec[i64]) -> Vec[i64] {
    let mut ans = Vec.new();
    for h in heroes.iter() {
        let mut sum = 0;
        for j in 0..monsters.len() {
            if monsters[j] <= h {
                sum += coins[j];
            }
        }
        ans.push(sum);
    }
    ans
}


// ---- solution (coins_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn maximum_coins(heroes: Vec[i32], monsters: Vec[i32], coins: Vec[i32]) -> Vec[i64] {
        let m = monsters.len();
        let mut idx: Vec[i64] = (0..m).collect();
        idx.sort_by_key(|i| monsters[i]);
        let mut pre = Vec.filled(m + 1, 0);
        for (k, i) in idx.iter().enumerate() {
            pre[k + 1] = pre[k] + coins[i];
        }
        heroes
            .iter()
            .map(|h| {
                let cnt = idx.partition_point(|i| monsters[i] <= h);
                pre[cnt]
            })
            .collect()
    }
}

fn solution_maximum_coins(heroes: Vec[i64], monsters: Vec[i64], coins: Vec[i64]) -> Vec[i64] {
    let to32 = |v: ref Vec[i64]| v.iter().map(|x| x as i32).collect();
    Solution.maximum_coins(to32(heroes), to32(monsters), to32(coins))
}


// ---- the check ---------------------------------------------------------

fn answer(arm: i64, heroes: Vec[i64], monsters: Vec[i64], coins: Vec[i64]) -> Vec[i64] {
    match arm {
        0 => star_maximum_coins(heroes, monsters, coins),
        1 => sweep_maximum_coins(heroes, monsters, coins),
        2 => floor_maximum_coins(heroes, monsters, coins),
        3 => each_maximum_coins(heroes, monsters, coins),
        _ => solution_maximum_coins(heroes, monsters, coins),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn digest(xs: Vec[i64]) -> i64 {
    xs.iter().fold(0, |h, x| (h * 131 + x) % 1000000007)
}

fn main() {
    let names = ["star", "sweep", "floor", "each", "solution"];
    let mut seed = 2838;
    let mut cases: Vec[(Vec[i64], Vec[i64], Vec[i64])] = Vec.new();
    for c in 0..2050 {
        let (top, size, most) = if c < 2000 { (8, 6, 10) } else { (1000000000, 800, 1000000000) };
        let n = next_random(mut seed) % size + 1;
        let m = next_random(mut seed) % size + 1;
        let heroes: Vec[i64] = (0..n).map(|_| wide(mut seed) % top + 1).collect();
        let monsters: Vec[i64] = (0..m).map(|_| wide(mut seed) % top + 1).collect();
        let coins: Vec[i64] = (0..m).map(|_| wide(mut seed) % most + 1).collect();
        cases.push((heroes, monsters, coins));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (heroes, monsters, coins)) in cases.iter().enumerate() {
        let want = literal(heroes, monsters, coins);
        check = (check * 31 + digest(want) + 1) % 1000000007;
        let heroes_back: Vec[i64] = heroes.iter().rev().collect();
        let monsters_back: Vec[i64] = monsters.iter().rev().collect();
        let coins_back: Vec[i64] = coins.iter().rev().collect();
        let heroes_twice: Vec[i64] = heroes.iter().map(|h| 2 * h).collect();
        let monsters_twice: Vec[i64] = monsters.iter().map(|p| 2 * p).collect();
        let mut monsters_more = monsters.clone();
        monsters_more.push(1);
        let mut coins_more = coins.clone();
        coins_more.push(7);
        let got: Vec[Vec[i64]] = (0..5).map(|arm| answer(arm, heroes, monsters, coins)).collect();
        for arm in 0..5 {
            let value = ref got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let back: Vec[i64] = answer(arm, heroes_back, monsters, coins).iter().rev().collect();
            let plus: Vec[i64] = value.iter().map(|v| v + 7).collect();
            let verdicts = [
                value == want,
                back == value,
                answer(arm, heroes, monsters_back, coins_back) == value,
                answer(arm, heroes_twice, monsters_twice, coins) == value,
                answer(arm, heroes, monsters_more, coins_more) == plus,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} heroes {heroes} monsters {monsters} coins {coins}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
