// LeetCode #2875: Minimum Size Subarray in Infinite Array -- the
// differential. The five arms, against the statement read literally:
// from every start in nums, the infinite array walked a value at a time
// until its sum reaches target, the shortest walk that hits target
// exactly kept. 2000 random arrays of 1 to 6 values from 1 to 5 with
// target 1 to 60, then 50 of up to 3000 values, every other one from 1
// to 10 and the rest up to 10^5, target up to 10^7, all drawn before any
// arm answers; the literal reading is asked only of the first 2000.
//
// P1  target up to 60, the answer is the literal reading's
// P2  target raised by one copy's sum: n more, or -1 still
// P3  the first value moved to the end: the same answer
// P4  nums reversed: the same answer
// P5  -1, or from 1 to target, and at least target over the largest value
// P6  each arm agrees with at least three of the other four

fn literal(nums: Vec[i64], target: i64) -> i64 {
    let n = nums.len();
    let mut best = -1;
    for start in 0..n {
        let mut sum = 0;
        let mut length = 0;
        while sum < target {
            sum += nums[(start + length) % n];
            length += 1;
        }
        if sum == target and (best < 0 or length < best) {
            best = length;
        }
    }
    best
}


// ---- star (infinite.kara) -------------------------------------------

fn star_min_size_subarray(nums: Vec[i64], target: i64) -> i64 {
    let n = nums.len();
    let total: i64 = nums.iter().sum();
    let whole = target / total * n;
    let rest = target % total;
    if rest == 0 {
        return whole;
    }
    let mut best = -1;
    let mut sum = 0;
    let mut left = 0;
    for right in 0..2 * n {
        sum += nums[right % n];
        while sum > rest {
            sum -= nums[left % n];
            left += 1;
        }
        if sum == rest and (best < 0 or right - left + 1 < best) {
            best = right - left + 1;
        }
    }
    if best < 0 { -1 } else { whole + best }
}


// ---- map (infinite_map.kara) ----------------------------------------

fn map_min_size_subarray(nums: Vec[i64], target: i64) -> i64 {
    let n = nums.len();
    let total: i64 = nums.iter().sum();
    let whole = target / total * n;
    let rest = target % total;
    if rest == 0 {
        return whole;
    }
    let mut ends: Map[i64, i64] = Map.new();
    ends.insert(0, -1);
    let mut prefix = 0;
    let mut best = -1;
    for i in 0..2 * n {
        prefix += nums[i % n];
        if let Some(start) = ends.get(prefix - rest) {
            if best < 0 or i - start < best {
                best = i - start;
            }
        }
        ends.insert(prefix, i);
    }
    if best < 0 { -1 } else { whole + best }
}


// ---- two (infinite_two.kara) ----------------------------------------

fn two_windows(nums: Vec[i64], goal: i64) -> (i64, i64) {
    let mut shortest = -1;
    let mut longest = -1;
    let mut sum = 0;
    let mut left = 0;
    for right in 0..nums.len() {
        sum += nums[right];
        while sum > goal {
            sum -= nums[left];
            left += 1;
        }
        if sum == goal {
            let length = right - left + 1;
            if shortest < 0 or length < shortest {
                shortest = length;
            }
            longest = longest.max(length);
        }
    }
    (shortest, longest)
}

fn two_min_size_subarray(nums: Vec[i64], target: i64) -> i64 {
    let n = nums.len();
    let total: i64 = nums.iter().sum();
    let whole = target / total * n;
    let rest = target % total;
    if rest == 0 {
        return whole;
    }
    let (inside, _) = two_windows(nums, rest);
    let (_, left_out) = two_windows(nums, total - rest);
    let wrapped = if left_out < 0 { -1 } else { n - left_out };
    let best = if inside < 0 { wrapped } else if wrapped < 0 { inside } else { inside.min(wrapped) };
    if best < 0 { -1 } else { whole + best }
}


// ---- search (infinite_search.kara) ----------------------------------

fn search_min_size_subarray(nums: Vec[i64], target: i64) -> i64 {
    let n = nums.len();
    let total: i64 = nums.iter().sum();
    let whole = target / total * n;
    let rest = target % total;
    if rest == 0 {
        return whole;
    }
    let mut prefix: Vec[i64] = [0].to_vec();
    for i in 0..2 * n {
        prefix.push(prefix[i] + nums[i % n]);
    }
    let found = (0..n).filter_map(|start| prefix.binary_search(prefix[start] + rest).map(|end| end - start)).min();
    match found {
        Some(length) => whole + length,
        None => -1,
    }
}


// ---- solution (infinite_solution.kara) ------------------------------

struct Solution {}

impl Solution {
    pub fn min_size_subarray(nums: Vec[i32], target: i32) -> i32 {
        let n = nums.len();
        let total: i64 = nums.iter().map(|x| x as i64).sum();
        let k = target / total;
        let rem = target % total;
        if rem == 0 {
            return (k * n) as i32;
        }
        let mut ans = i64.MAX;
        let mut sum: i64 = 0;
        let mut l = 0;
        for r in 0..2 * n {
            sum += nums[r % n];
            while sum > rem {
                sum -= nums[l % n];
                l += 1;
            }
            if sum == rem {
                ans = ans.min(r - l + 1);
            }
        }
        if ans == i64.MAX { -1 } else { (k * n + ans) as i32 }
    }
}

fn solution_min_size_subarray(nums: Vec[i64], target: i64) -> i64 {
    Solution.min_size_subarray(nums.iter().map(|x| x as i32).collect(), target as i32)
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, nums: Vec[i64], target: i64) -> i64 {
    match arm {
        0 => star_min_size_subarray(nums, target),
        1 => map_min_size_subarray(nums, target),
        2 => two_min_size_subarray(nums, target),
        3 => search_min_size_subarray(nums, target),
        _ => solution_min_size_subarray(nums, target),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "map", "two", "search", "solution"];
    let mut seed = 2875;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 6 + 1 } else { wide(mut seed) % 3000 + 1 };
        let top = if small { 5 } else if c % 2 == 1 { 10 } else { 100000 };
        let nums: Vec[i64] = (0..n).map(|_| wide(mut seed) % top + 1).collect();
        let target = if small { next_random(mut seed) % 60 + 1 } else { wide(mut seed) % 10000000 + 1 };
        cases.push((nums, target));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, (nums, target)) in cases.iter().enumerate() {
        let n = nums.len();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums, target)).collect();
        let want = if c < 2000 { literal(nums, target) } else { got[0] };
        total += want;
        check = (check * 31 + want + 1) % 1000000007;
        let sum: i64 = nums.iter().sum();
        let mut rotated: Vec[i64] = nums.iter().skip(1).cloned().collect();
        rotated.push(nums[0]);
        let reversed: Vec[i64] = nums.iter().rev().cloned().collect();
        let top = nums.iter().max().unwrap();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let more = answer(arm, nums, target + sum);
            let verdicts = [
                c >= 2000 or value == want,
                if value < 0 { more < 0 } else { more == value + n },
                answer(arm, rotated, target) == value,
                answer(arm, reversed, target) == value,
                value == -1 or (value >= 1 and value <= target and value * top >= target),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} n {n} target {target}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, lengths total {total}: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
