// LeetCode #2818: Apply Operations to Maximize Score -- a Rust solution
// as LeetCode's Rust users write it, carried to Kāra by `karac fix`: a
// sieve of `omega` counts, one stack of `usize` indices filling `left`
// and `right` as `i32`, the indices sorted by `sort_by` on `nums[b].cmp`,
// and a `pow` by squaring under `const MOD: i64`, the values `i32`.

struct Solution {}

impl Solution {
    pub fn maximum_score(nums: Vec[i32], k: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let n = nums.len();
        let mx = *nums.iter().max().unwrap() as i64;
        let mut omega = Vec.filled(mx + 1, 0);
        for i in 2..=mx {
            if omega[i] == 0 {
                let mut j = i;
                while j <= mx {
                    omega[j] += 1;
                    j += i;
                }
            }
        }
        let mut left = Vec.filled(n, -1i32);
        let mut right = Vec.filled(n, n as i32);
        let mut st: Vec[i64] = Vec.new();
        for i in 0..n {
            while let Some(t) = st.last().cloned() {
                if omega[nums[t]] < omega[nums[i]] {
                    right[t] = i as i32;
                    st.pop();
                } else {
                    break;
                }
            }
            if let Some(t) = st.last().cloned() {
                left[i] = t as i32;
            }
            st.push(i);
        }
        let mut idx: Vec[i64] = (0..n).collect();
        idx.sort_by(|a, b| nums[b].cmp(nums[a]));
        let mut k = k as i64;
        let mut ans: i64 = 1;
        for i in idx {
            if k == 0 {
                break;
            }
            let cnt = ((i - left[i]) * (right[i] - i)).min(k);
            ans = ans * Solution.pow(nums[i], cnt, MOD) % MOD;
            k -= cnt;
        }
        ans as i32
    }

    fn pow(b: i64, e: i64, m: i64) -> i64 {
        let mut b = b;
        let mut e = e;
        let mut r = 1;
        b %= m;
        while e > 0 {
            if e & 1 == 1 {
                r = r * b % m;
            }
            b = b * b % m;
            e >>= 1;
        }
        r
    }
}

fn maximum_score(nums: Vec[i64], k: i64) -> i64 {
    Solution.maximum_score(nums.iter().map(|v| v as i32).collect(), k as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; one number; k every subarray; 2000 primes
    // in a cycle of six, every score 1, k every subarray; and 2000 numbers
    // of falling score
    println(f"{maximum_score([8, 3, 9, 3, 8], 2)}");
    println(f"{maximum_score([19, 12, 14, 6, 10, 18], 3)}");
    println(f"{maximum_score([1], 1)}");
    println(f"{maximum_score([2, 30, 6, 7], 10)}");
    println(f"{maximum_score((0..2000).map(|i| [2, 3, 5, 7, 11, 13][i % 6]).collect(), 2001000)}");
    println(f"{maximum_score((0..2000).map(|i| [30030, 2310, 210, 30, 6, 2][i * 6 / 2000]).collect(), 1999000)}");
    // 3000 random arrays of 1 to 10 numbers up to 100 with k up to the
    // count of subarrays; then 50 of up to 2000 numbers up to 10^5 with
    // k up to 10^9
    let mut seed = 2818;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 10 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 100 + 1).collect();
        let k = next_random(mut seed) % (n * (n + 1) / 2) + 1;
        check = (check * 31 + maximum_score(nums, k)) % 1000000007;
    }
    println(f"3000 small arrays: checksum {check}");
    check = 0;
    for _ in 0..50 {
        let n = next_random(mut seed) % 2000 + 1;
        let nums: Vec[i64] = (0..n).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1).collect();
        let k = wide(mut seed) % (n * (n + 1) / 2).min(1000000000) + 1;
        check = (check * 31 + maximum_score(nums, k)) % 1000000007;
    }
    println(f"50 large arrays: checksum {check}");
}
