// LeetCode #2816: Double a Number Represented as a Linked List -- the
// bench: the ★ arm over 200 numbers of 10^4 digits, LeetCode's most, all
// drawn first, then each built as a list and doubled 20 times, the list
// read back after each.

shared struct ListNode {
    mut val: i64,
    mut next: Option[ListNode],
}

fn double_it(head: Option[ListNode]) -> Option[ListNode] {
    let Some(first) = head else {
        return None;
    };
    let start = if first.val > 4 { ListNode { val: 0, next: Some(first) } } else { first };
    let mut cur = Some(start);
    while let Some(node) = cur {
        node.val = node.val * 2 % 10;
        if let Some(after) = node.next {
            if after.val > 4 {
                node.val += 1;
            }
        }
        cur = node.next;
    }
    Some(start)
}

fn build(values: Vec[i64]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for v in values.iter().rev() {
        head = Some(ListNode { val: v, next: head });
    }
    head
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 200;
    let rounds = 20;
    let n = 10000;
    let mut seed = 2816;
    let mut numbers: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let mut digits: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 10).collect();
        if digits[0] == 0 {
            digits[0] = next_random(mut seed) % 9 + 1;
        }
        numbers.push(digits);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for digits in numbers.iter() {
            let mut cur = double_it(build(digits));
            let mut h = r;
            while let Some(node) = cur {
                total += node.val;
                h = (h * 131 + node.val) % 1000000007;
                cur = node.next;
            }
            check = (check * 31 + h) % 1000000007;
        }
    }
    println(f"{count} numbers of {n} digits, {rounds} rounds: digits sum to {total}, checksum {check}");
}
