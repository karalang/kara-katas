// LeetCode #2864: Maximum Odd Binary Number -- the characters sorted
// largest first, which puts every one before every zero, then the last
// one of them moved to the end with `remove` and `push`.

fn maximum_odd_binary_number(s: Str) -> String {
    let mut bits: Vec[char] = s.chars().collect();
    bits.sort_by(|a, b| b.cmp(a));
    let last_one = bits.iter().rposition(|c| c == '1').unwrap();
    let one = bits.remove(last_one);
    bits.push(one);
    bits.iter().collect()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn fold(s: String, check: i64) -> i64 {
    s.bytes().iter().fold(check, |h, b| (h * 31 + b as i64) % 1000000007)
}

fn main() {
    // LeetCode's two examples; a lone one; then 100 bits, LeetCode's
    // most, all ones and one one at the front
    println(f"{maximum_odd_binary_number("010")} {maximum_odd_binary_number("0101")} {maximum_odd_binary_number("1")}");
    let ones: String = (0..100).map(|_| '1').collect();
    let front: String = (0..100).map(|i| if i == 0 { '1' } else { '0' }).collect();
    println(f"{maximum_odd_binary_number(ones) == ones} {maximum_odd_binary_number(front).ends_with("01")}");
    // 3000 random strings of 1 to 8 bits, then 3000 of up to 100, each
    // with at least one one
    let mut seed = 2864;
    let mut check = 0;
    let mut ones_total = 0;
    for c in 0..6000 {
        let n = if c < 3000 { next_random(mut seed) % 8 + 1 } else { next_random(mut seed) % 100 + 1 };
        let mut bits: Vec[char] = (0..n).map(|_| if next_random(mut seed) % 3 == 0 { '1' } else { '0' }).collect();
        bits[next_random(mut seed) % n] = '1';
        let s: String = bits.iter().collect();
        let best = maximum_odd_binary_number(s);
        ones_total += best.chars().filter(|c| c == '1').count();
        check = fold(best, check);
        if c == 2999 {
            println(f"3000 short strings: {ones_total} ones, checksum {check}");
            ones_total = 0;
            check = 0;
        }
    }
    println(f"3000 long strings: {ones_total} ones, checksum {check}");
}
