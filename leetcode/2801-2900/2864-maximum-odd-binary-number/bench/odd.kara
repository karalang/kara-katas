// LeetCode #2864: Maximum Odd Binary Number -- the bench: the ★ arm over
// 10000 strings of 100 bits, LeetCode's most, about a third of them
// ones and at least one, all drawn first, then each answered 50 times,
// every answer folded into the checksum byte by byte.

fn maximum_odd_binary_number(s: Str) -> String {
    let ones = s.chars().filter(|c| c == '1').count();
    let zeros = s.len() - ones;
    "1".repeat(ones - 1) + "0".repeat(zeros) + "1"
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 10000;
    let rounds = 50;
    let n = 100;
    let mut seed = 2864;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..count {
        let mut bits: Vec[char] = (0..n).map(|_| if next_random(mut seed) % 3 == 0 { '1' } else { '0' }).collect();
        bits[next_random(mut seed) % n] = '1';
        strings.push(bits.iter().collect());
    }
    let mut ones_total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for s in strings.iter() {
            let best = maximum_odd_binary_number(s);
            ones_total += best.chars().filter(|c| c == '1').count();
            check = best.bytes().iter().fold((check + r) % 1000000007, |h, b| (h * 31 + b as i64) % 1000000007);
        }
    }
    println(f"{count} strings of {n}, {rounds} rounds: {ones_total} ones, checksum {check}");
}
