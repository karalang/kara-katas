// LeetCode #2811: Check if it is Possible to Split Array -- the
// differential. The five arms, against the statement read literally: a
// part of one number is done, and a longer part is split when some cut
// leaves two parts, each one number or summing to at least m, that are
// themselves split, every cut tried by recursion on copied parts; no
// table, no prefix sums and no neighbours. 2000 random arrays of 1 to 7
// numbers up to 6 with m up to 12; then 50 of up to 100 numbers up to
// 100 with m up to 200. Every case is drawn before any arm answers; the
// literal reading is asked only of the first 2000.
//
// P1  up to 7 numbers, the answer is the literal reading's
// P2  two numbers or fewer: true
// P3  m one less: still true when it was true
// P4  the numbers reversed: the same answer
// P5  m 1: true; m past the whole sum: true just for two numbers or fewer
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(part: Vec[i64], m: i64) -> bool {
    if part.len() == 1 {
        return true;
    }
    for k in 1..part.len() {
        let left: Vec[i64] = part[0..k].to_vec();
        let right: Vec[i64] = part[k..part.len()].to_vec();
        let fits = |p: Vec[i64]| p.len() == 1 or p.iter().sum() >= m;
        if fits(left) and fits(right) and literal(left, m) and literal(right, m) {
            return true;
        }
    }
    false
}


// ---- star (split.kara) ----------------------------------------------

fn star_can_split_array(nums: Vec[i64], m: i64) -> bool {
    nums.len() <= 2 or nums.windows(2).into_iter().any(|w| w[0] + w[1] >= m)
}


// ---- table (split_table.kara) ---------------------------------------

fn table_can_split_array(nums: Vec[i64], m: i64) -> bool {
    let n = nums.len();
    let mut prefix: Vec[i64] = [0];
    for v in nums.iter() {
        prefix.push(prefix[prefix.len() - 1] + v);
    }
    let good = |i: i64, j: i64| i == j or prefix[j + 1] - prefix[i] >= m;
    let mut ok: Vec[Vec[bool]] = Vec.filled(n, Vec.filled(n, false));
    for i in 0..n {
        ok[i][i] = true;
    }
    for length in 2..=n {
        for i in 0..=n - length {
            let j = i + length - 1;
            ok[i][j] = (i..j).any(|k| good(i, k) and good(k + 1, j) and ok[i][k] and ok[k + 1][j]);
        }
    }
    ok[0][n - 1]
}


// ---- peel (split_peel.kara) -----------------------------------------

fn peel_peels(nums: Vec[i64], prefix: Vec[i64], i: i64, j: i64, m: i64, memo: mut ref Map[(i64, i64), bool]) -> bool {
    if j - i <= 1 {
        return true;
    }
    if let Some(known) = memo.get((i, j)) {
        return known;
    }
    let left_rest = prefix[j + 1] - prefix[i + 1];
    let right_rest = prefix[j] - prefix[i];
    let answer = (left_rest >= m and peel_peels(nums, prefix, i + 1, j, m, mut memo))
        or (right_rest >= m and peel_peels(nums, prefix, i, j - 1, m, mut memo));
    memo.insert((i, j), answer);
    answer
}

fn peel_can_split_array(nums: Vec[i64], m: i64) -> bool {
    let mut prefix: Vec[i64] = Vec.filled(nums.len() + 1, 0);
    for i in 0..nums.len() {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    let mut memo: Map[(i64, i64), bool] = Map.new();
    peel_peels(nums, prefix, 0, nums.len() - 1, m, mut memo)
}


// ---- scan (split_scan.kara) -----------------------------------------

fn scan_can_split_array(nums: Vec[i64], m: i64) -> bool {
    if nums.len() <= 2 {
        return true;
    }
    let mut best = 0;
    let mut i = 1;
    while i < nums.len() {
        let pair = nums[i - 1] + nums[i];
        if pair > best {
            best = pair;
        }
        i += 1;
    }
    best >= m
}


// ---- solution (split_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn can_split_array(nums: Vec[i32], m: i32) -> bool {
        nums.len() <= 2 or nums.windows(2).into_iter().any(|w| w[0] + w[1] >= m)
    }
}

fn solution_can_split_array(nums: own Vec[i64], m: i64) -> bool {
    Solution.can_split_array(nums.into_iter().map(|v| v as i32).collect(), m as i32)
}


fn answer(arm: i64, nums: Vec[i64], m: i64) -> bool {
    match arm {
        0 => star_can_split_array(nums, m),
        1 => table_can_split_array(nums, m),
        2 => peel_can_split_array(nums, m),
        3 => scan_can_split_array(nums, m),
        _ => solution_can_split_array(nums.clone(), m),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "table", "peel", "scan", "solution"];
    let mut seed = 2811;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for c in 0..2050 {
        let (most, top, far) = if c < 2000 { (7, 6, 12) } else { (100, 100, 200) };
        let n = next_random(mut seed) % most + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        cases.push((nums, next_random(mut seed) % far + 1));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (nums, m)) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = small and literal(nums, m);
        check = (check * 31 + if want { 2 } else { 1 }) % 1000000007;
        let n = nums.len();
        let total: i64 = nums.iter().sum();
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let got: Vec[bool] = (0..5).map(|arm| answer(arm, nums, m)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == want,
                n > 2 or value,
                not value or m == 1 or answer(arm, nums, m - 1),
                answer(arm, reversed, m) == value,
                answer(arm, nums, 1) and answer(arm, nums, total + 1) == (n <= 2),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums} m = {m}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
