// LeetCode #2811: Check if it is Possible to Split Array -- the bench:
// the ★ arm over 100000 arrays of 100 numbers, LeetCode's most, up to
// 100, with m from 150 to 200 so that most scans run long, all drawn
// first, then each answered 10 times.

fn can_split_array(nums: Vec[i64], m: i64) -> bool {
    nums.len() <= 2 or nums.windows(2).into_iter().any(|w| w[0] + w[1] >= m)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100000;
    let rounds = 10;
    let mut seed = 2811;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for _ in 0..count {
        let nums: Vec[i64] = (0..100).map(|_| next_random(mut seed) % 100 + 1).collect();
        cases.push((nums, 150 + next_random(mut seed) % 51));
    }
    let mut yes = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, m) in cases.iter() {
            let a = if can_split_array(nums, m) { 1 } else { 0 };
            yes += a;
            check = (check * 31 + a + r) % 1000000007;
        }
    }
    println(f"{count} arrays of 100, {rounds} rounds: {yes} can split, checksum {check}");
}
