// LeetCode #2811: Check if it is Possible to Split Array -- peeling, by
// recursion with a memo: a part splits when it is one number, or when a
// single number can come off one of its ends leaving a rest that sums to
// at least m, or is one number, and itself splits; a `Map` keyed by the
// part's ends remembers each answer.

fn peels(nums: Vec[i64], prefix: Vec[i64], i: i64, j: i64, m: i64, memo: mut ref Map[(i64, i64), bool]) -> bool {
    if j - i <= 1 {
        return true;
    }
    if let Some(known) = memo.get((i, j)) {
        return known;
    }
    let left_rest = prefix[j + 1] - prefix[i + 1];
    let right_rest = prefix[j] - prefix[i];
    let answer = (left_rest >= m and peels(nums, prefix, i + 1, j, m, mut memo))
        or (right_rest >= m and peels(nums, prefix, i, j - 1, m, mut memo));
    memo.insert((i, j), answer);
    answer
}

fn can_split_array(nums: Vec[i64], m: i64) -> bool {
    let mut prefix: Vec[i64] = Vec.filled(nums.len() + 1, 0);
    for i in 0..nums.len() {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    let mut memo: Map[(i64, i64), bool] = Map.new();
    peels(nums, prefix, 0, nums.len() - 1, m, mut memo)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; two numbers that never need a sum; 100
    // numbers, LeetCode's most, at 100 with m at its largest, 200, and
    // one less than any two make
    println(f"{can_split_array([2, 2, 1], 4)}");
    println(f"{can_split_array([2, 1, 3], 5)}");
    println(f"{can_split_array([2, 3, 3, 2, 3], 6)}");
    println(f"{can_split_array([1, 1], 200)}");
    println(f"{can_split_array(Vec.filled(100, 100), 200)}");
    println(f"{can_split_array(Vec.filled(100, 99), 199)}");
    // 3000 random arrays of 1 to 7 numbers up to 6 with m up to 12; then
    // 50 of up to 100 numbers up to 100 with m up to 200
    let mut seed = 2811;
    let mut yes = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 7 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 6 + 1).collect();
        let a = can_split_array(nums, next_random(mut seed) % 12 + 1);
        yes += if a { 1 } else { 0 };
        check = (check * 2 + if a { 1 } else { 0 }) % 1000000007;
    }
    println(f"3000 small arrays: {yes} can split, checksum {check}");
    yes = 0;
    check = 0;
    for _ in 0..50 {
        let n = next_random(mut seed) % 100 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 100 + 1).collect();
        let a = can_split_array(nums, next_random(mut seed) % 200 + 1);
        yes += if a { 1 } else { 0 };
        check = (check * 2 + if a { 1 } else { 0 }) % 1000000007;
    }
    println(f"50 large arrays: {yes} can split, checksum {check}");
}
