// LeetCode #2850: Minimum Moves to Spread Stones Over Grid -- a
// min-cost flow: a source feeds each cell its spare stones, every such
// cell reaches every empty one at the cost of their distance, and each
// empty cell drains one stone to the sink; shortest augmenting paths by
// Bellman-Ford over a network struct of paired edges, the one sent and
// the one that can take it back.

struct Edge {
    to: i64,
    cap: i64,
    cost: i64,
}

struct Network {
    edges: Vec[Edge],
    out: Vec[Vec[i64]],
}

impl Network {
    fn new(n: i64) -> Network {
        Network { edges: Vec.new(), out: Vec.filled(n, Vec.new()) }
    }

    fn link(mut ref self, a: i64, b: i64, cap: i64, cost: i64) {
        self.out[a].push(self.edges.len());
        self.edges.push(Edge { to: b, cap: cap, cost: cost });
        self.out[b].push(self.edges.len());
        self.edges.push(Edge { to: a, cap: 0, cost: -cost });
    }

    fn cheapest(mut ref self, source: i64, sink: i64) -> i64 {
        let n = self.out.len();
        let mut total = 0;
        loop {
            let mut dist: Vec[i64] = Vec.filled(n, i64.MAX);
            let mut via: Vec[i64] = Vec.filled(n, -1);
            dist[source] = 0;
            let mut changed = true;
            while changed {
                changed = false;
                for u in 0..n {
                    if dist[u] == i64.MAX {
                        continue;
                    }
                    for e in self.out[u].iter() {
                        let v = self.edges[e].to;
                        if self.edges[e].cap > 0 and dist[u] + self.edges[e].cost < dist[v] {
                            dist[v] = dist[u] + self.edges[e].cost;
                            via[v] = e;
                            changed = true;
                        }
                    }
                }
            }
            if dist[sink] == i64.MAX {
                return total;
            }
            let mut v = sink;
            while v != source {
                let e = via[v];
                self.edges[e].cap -= 1;
                self.edges[e ^ 1].cap += 1;
                v = self.edges[e ^ 1].to;
            }
            total += dist[sink];
        }
    }
}

fn minimum_moves(grid: Vec[Vec[i64]]) -> i64 {
    // nodes: 0 the source, 1 to 9 the cells, 10 the sink
    let mut net = Network.new(11);
    for a in 0..9 {
        let have = grid[a / 3][a % 3];
        if have > 1 {
            net.link(0, a + 1, have - 1, 0);
            for b in 0..9 {
                if grid[b / 3][b % 3] == 0 {
                    net.link(a + 1, b + 1, 9, (a / 3 - b / 3).abs() + (a % 3 - b % 3).abs());
                }
            }
        } else if have == 0 {
            net.link(a + 1, 10, 1, 0);
        }
    }
    net.cheapest(0, 10)
}

// ---- the harness: the same in every arm --------------------------------

fn every(cell: i64, left: i64, counts: mut ref Vec[i64], out: mut ref Vec[Vec[Vec[i64]]]) {
    if cell == 8 {
        counts[8] = left;
        let grid: Vec[Vec[i64]] = (0..3).map(|r| (0..3).map(|c| counts[r * 3 + c]).collect()).collect();
        out.push(grid);
        return;
    }
    for k in 0..left + 1 {
        counts[cell] = k;
        every(cell + 1, left - k, mut counts, mut out);
    }
}

fn main() {
    // LeetCode's two examples; a grid already spread, and all nine
    // stones in a corner and in the middle
    println(f"{minimum_moves([[1, 1, 0], [1, 1, 1], [1, 2, 1]])} {minimum_moves([[1, 3, 0], [1, 0, 0], [1, 0, 3]])}");
    println(f"{minimum_moves([[1, 1, 1], [1, 1, 1], [1, 1, 1]])} {minimum_moves([[9, 0, 0], [0, 0, 0], [0, 0, 0]])} {minimum_moves([[0, 0, 0], [0, 9, 0], [0, 0, 0]])}");
    // every grid of nine stones, in order of the cells' counts
    let mut counts: Vec[i64] = Vec.filled(9, 0);
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    every(0, 9, mut counts, mut grids);
    let mut total = 0;
    let mut most = 0;
    let mut check = 0;
    for grid in grids.iter() {
        let moves = minimum_moves(grid);
        total += moves;
        most = most.max(moves);
        check = (check * 31 + moves) % 1000000007;
    }
    println(f"{grids.len()} grids: {total} moves in all, at most {most}, checksum {check}");
}
