// LeetCode #2850: Minimum Moves to Spread Stones Over Grid -- dynamic
// programming over subsets: best[mask] is the cheapest way to give the
// empty cells in mask to the first popcount(mask) spare stones, each
// mask extended by one more empty cell for the next stone.

fn far(a: (i64, i64), b: (i64, i64)) -> i64 {
    (a.0 - b.0).abs() + (a.1 - b.1).abs()
}

fn minimum_moves(grid: Vec[Vec[i64]]) -> i64 {
    let mut from: Vec[(i64, i64)] = Vec.new();
    let mut to: Vec[(i64, i64)] = Vec.new();
    for r in 0..3 {
        for c in 0..3 {
            if grid[r][c] == 0 {
                to.push((r, c));
            }
            for _ in 1..grid[r][c] {
                from.push((r, c));
            }
        }
    }
    let m = to.len();
    let full = 1 << m;
    let mut best: Vec[i64] = Vec.filled(full, i64.MAX);
    best[0] = 0;
    for mask in 0..full {
        let k = mask.count_ones();
        if best[mask] == i64.MAX or k == m {
            continue;
        }
        for j in 0..m {
            if mask & (1 << j) == 0 {
                let next = mask | (1 << j);
                best[next] = best[next].min(best[mask] + far(from[k], to[j]));
            }
        }
    }
    best[full - 1]
}

// ---- the harness: the same in every arm --------------------------------

fn every(cell: i64, left: i64, counts: mut ref Vec[i64], out: mut ref Vec[Vec[Vec[i64]]]) {
    if cell == 8 {
        counts[8] = left;
        let grid: Vec[Vec[i64]] = (0..3).map(|r| (0..3).map(|c| counts[r * 3 + c]).collect()).collect();
        out.push(grid);
        return;
    }
    for k in 0..left + 1 {
        counts[cell] = k;
        every(cell + 1, left - k, mut counts, mut out);
    }
}

fn main() {
    // LeetCode's two examples; a grid already spread, and all nine
    // stones in a corner and in the middle
    println(f"{minimum_moves([[1, 1, 0], [1, 1, 1], [1, 2, 1]])} {minimum_moves([[1, 3, 0], [1, 0, 0], [1, 0, 3]])}");
    println(f"{minimum_moves([[1, 1, 1], [1, 1, 1], [1, 1, 1]])} {minimum_moves([[9, 0, 0], [0, 0, 0], [0, 0, 0]])} {minimum_moves([[0, 0, 0], [0, 9, 0], [0, 0, 0]])}");
    // every grid of nine stones, in order of the cells' counts
    let mut counts: Vec[i64] = Vec.filled(9, 0);
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    every(0, 9, mut counts, mut grids);
    let mut total = 0;
    let mut most = 0;
    let mut check = 0;
    for grid in grids.iter() {
        let moves = minimum_moves(grid);
        total += moves;
        most = most.max(moves);
        check = (check * 31 + moves) % 1000000007;
    }
    println(f"{grids.len()} grids: {total} moves in all, at most {most}, checksum {check}");
}
