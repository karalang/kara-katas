// LeetCode #2852: Sum of Remoteness of All Cells -- each region flooded
// depth first by recursion, the visit returning its cells' count and
// sum as a pair; a grid of up to 300 x 300 makes a region of 90000
// cells, so the recursion runs that deep.

fn flood(grid: Vec[Vec[i64]], seen: mut ref Vec[Vec[bool]], r: i64, c: i64) -> (i64, i64) {
    let n = grid.len();
    if r < 0 or r >= n or c < 0 or c >= n or grid[r][c] < 0 or seen[r][c] {
        return (0, 0);
    }
    seen[r][c] = true;
    let mut size = 1;
    let mut sum = grid[r][c];
    for (dr, dc) in [(0, 1), (1, 0), (0, -1), (-1, 0)].iter() {
        let (k, s) = flood(grid, mut seen, r + dr, c + dc);
        size += k;
        sum += s;
    }
    (size, sum)
}

fn sum_remoteness(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let total: i64 = grid.iter().map(|row| row.iter().filter(|v| v > 0).sum()).sum();
    let mut seen: Vec[Vec[bool]] = Vec.filled(n, Vec.filled(n, false));
    let mut answer = 0;
    for i in 0..n {
        for j in 0..n {
            let (size, sum) = flood(grid, mut seen, i, j);
            answer += size * (total - sum);
        }
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's three examples
    println(f"{sum_remoteness([[-1, 1, -1], [5, -1, 4], [-1, 3, -1]])} {sum_remoteness([[-1, 3, 4], [-1, -1, -1], [3, -1, -1]])} {sum_remoteness([[1]])}");
    // 300 x 300, LeetCode's most: every cell open with 10^6, one
    // region; every other cell blocked, each open one alone; and every
    // cell blocked
    let open: Vec[Vec[i64]] = (0..300).map(|_| Vec.filled(300, 1000000)).collect();
    let checker: Vec[Vec[i64]] = (0..300).map(|i| (0..300).map(|j| if (i + j) % 2 == 0 { 1000000 } else { -1 }).collect()).collect();
    let shut: Vec[Vec[i64]] = (0..300).map(|_| Vec.filled(300, -1)).collect();
    println(f"{sum_remoteness(open)} {sum_remoteness(checker)} {sum_remoteness(shut)}");
    // 3000 random grids of 1 to 6, values up to 9, a cell blocked one
    // time in 3; then 20 of up to 300, values up to 10^6, blocked from 1
    // time in 10 to 6 in 10
    let mut seed = 2852;
    let mut check = 0;
    for c in 0..3020 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 6 + 1 } else { next_random(mut seed) % 300 + 1 };
        let blocked = if small { 3 } else { next_random(mut seed) % 6 + 1 };
        let grid: Vec[Vec[i64]] = (0..n)
            .map(|_| {
                (0..n)
                    .map(|_| {
                        if small {
                            if next_random(mut seed) % 3 == 0 { -1 } else { next_random(mut seed) % 9 + 1 }
                        } else if next_random(mut seed) % 10 < blocked {
                            -1
                        } else {
                            wide(mut seed) % 1000000 + 1
                        }
                    })
                    .collect()
            })
            .collect();
        check = (check * 31 + sum_remoteness(grid)) % 1000000007;
        if c == 2999 {
            println(f"3000 small grids: checksum {check}");
            check = 0;
        }
    }
    println(f"20 large grids: checksum {check}");
}
