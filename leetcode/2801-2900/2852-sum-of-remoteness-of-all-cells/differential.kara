// LeetCode #2852: Sum of Remoteness of All Cells -- the differential.
// The five arms, against the statement read literally: from every open
// cell, the cells it reaches found by a search of its own, and the
// values of the open cells it does not reach added to the total. 2000
// random grids of 1 to 6, values up to 9, a cell blocked one time in 3,
// then 50 of up to 120, values up to 10^6, blocked from 1 time in 10 to
// 6 in 10, all drawn before any arm answers; the literal reading is
// asked only of the first 2000.
//
// P1  up to 6 x 6, the answer is the literal reading's
// P2  the grid transposed: the same answer
// P3  the grid turned a quarter: the same answer
// P4  every value doubled: the answer doubled
// P5  a blocked row and column added: the same answer
// P6  each arm agrees with at least three of the other four

fn literal(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut answer = 0;
    for i in 0..n {
        for j in 0..n {
            if grid[i][j] < 0 {
                continue;
            }
            let mut reached: Set[(i64, i64)] = Set.new();
            reached.insert((i, j));
            let mut todo = [(i, j)].to_vec();
            while let Some((r, c)) = todo.pop() {
                for (nr, nc) in [(r + 1, c), (r - 1, c), (r, c + 1), (r, c - 1)].iter() {
                    if nr >= 0 and nr < n and nc >= 0 and nc < n and grid[nr][nc] > 0 and not reached.contains((nr, nc)) {
                        reached.insert((nr, nc));
                        todo.push((nr, nc));
                    }
                }
            }
            for r in 0..n {
                for c in 0..n {
                    if grid[r][c] > 0 and not reached.contains((r, c)) {
                        answer += grid[r][c];
                    }
                }
            }
        }
    }
    answer
}


// ---- star (remote.kara) ---------------------------------------------

fn star_sum_remoteness(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut total = 0;
    for row in grid.iter() {
        for v in row.iter() {
            if v > 0 {
                total += v;
            }
        }
    }
    let mut seen: Vec[Vec[bool]] = Vec.filled(n, Vec.filled(n, false));
    let mut answer = 0;
    for i in 0..n {
        for j in 0..n {
            if grid[i][j] < 0 or seen[i][j] {
                continue;
            }
            seen[i][j] = true;
            let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
            queue.push_back((i, j));
            let mut size = 0;
            let mut sum = 0;
            while let Some((r, c)) = queue.pop_front() {
                size += 1;
                sum += grid[r][c];
                for (dr, dc) in [(0, 1), (1, 0), (0, -1), (-1, 0)].iter() {
                    let (nr, nc) = (r + dr, c + dc);
                    if nr >= 0 and nr < n and nc >= 0 and nc < n and grid[nr][nc] > 0 and not seen[nr][nc] {
                        seen[nr][nc] = true;
                        queue.push_back((nr, nc));
                    }
                }
            }
            answer += size * (total - sum);
        }
    }
    answer
}


// ---- union (remote_union.kara) --------------------------------------

struct Regions {
    parent: Vec[i64],
    size: Vec[i64],
}

impl Regions {
    fn new(n: i64) -> Regions {
        Regions { parent: (0..n).collect(), size: Vec.filled(n, 1) }
    }

    fn find(mut ref self, x: i64) -> i64 {
        let mut x = x;
        while self.parent[x] != x {
            self.parent[x] = self.parent[self.parent[x]];
            x = self.parent[x];
        }
        x
    }

    fn join(mut ref self, a: i64, b: i64) {
        let mut (ra, rb) = (self.find(a), self.find(b));
        if ra == rb {
            return;
        }
        if self.size[ra] < self.size[rb] {
            let t = ra;
            ra = rb;
            rb = t;
        }
        self.parent[rb] = ra;
        self.size[ra] += self.size[rb];
    }
}

fn union_sum_remoteness(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut regions = Regions.new(n * n);
    for i in 0..n {
        for j in 0..n {
            if grid[i][j] < 0 {
                continue;
            }
            if j + 1 < n and grid[i][j + 1] > 0 {
                regions.join(i * n + j, i * n + j + 1);
            }
            if i + 1 < n and grid[i + 1][j] > 0 {
                regions.join(i * n + j, (i + 1) * n + j);
            }
        }
    }
    let mut sums: Vec[i64] = Vec.filled(n * n, 0);
    let mut total = 0;
    for i in 0..n {
        for j in 0..n {
            if grid[i][j] > 0 {
                let root = regions.find(i * n + j);
                sums[root] += grid[i][j];
                total += grid[i][j];
            }
        }
    }
    let mut answer = 0;
    for i in 0..n {
        for j in 0..n {
            let cell = i * n + j;
            if grid[i][j] > 0 and regions.find(cell) == cell {
                answer += regions.size[cell] * (total - sums[cell]);
            }
        }
    }
    answer
}


// ---- dfs (remote_dfs.kara) ------------------------------------------

fn dfs_flood(grid: Vec[Vec[i64]], seen: mut ref Vec[Vec[bool]], r: i64, c: i64) -> (i64, i64) {
    let n = grid.len();
    if r < 0 or r >= n or c < 0 or c >= n or grid[r][c] < 0 or seen[r][c] {
        return (0, 0);
    }
    seen[r][c] = true;
    let mut size = 1;
    let mut sum = grid[r][c];
    for (dr, dc) in [(0, 1), (1, 0), (0, -1), (-1, 0)].iter() {
        let (k, s) = dfs_flood(grid, mut seen, r + dr, c + dc);
        size += k;
        sum += s;
    }
    (size, sum)
}

fn dfs_sum_remoteness(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let total: i64 = grid.iter().map(|row| row.iter().filter(|v| v > 0).sum()).sum();
    let mut seen: Vec[Vec[bool]] = Vec.filled(n, Vec.filled(n, false));
    let mut answer = 0;
    for i in 0..n {
        for j in 0..n {
            let (size, sum) = dfs_flood(grid, mut seen, i, j);
            answer += size * (total - sum);
        }
    }
    answer
}


// ---- set (remote_set.kara) ------------------------------------------

fn set_sum_remoteness(grid: Vec[Vec[i64]]) -> i64 {
    let n = grid.len();
    let mut left: SortedSet[(i64, i64)] = SortedSet.new();
    let mut total = 0;
    for i in 0..n {
        for j in 0..n {
            if grid[i][j] > 0 {
                left.insert((i, j));
                total += grid[i][j];
            }
        }
    }
    let mut answer = 0;
    while let Some(start) = left.pop_first() {
        let mut stack = [start].to_vec();
        let mut size = 0;
        let mut sum = 0;
        while let Some((r, c)) = stack.pop() {
            size += 1;
            sum += grid[r][c];
            for next in [(r, c + 1), (r + 1, c), (r, c - 1), (r - 1, c)].iter() {
                if left.remove(next) {
                    stack.push(next);
                }
            }
        }
        answer += size * (total - sum);
    }
    answer
}


// ---- solution (remote_solution.kara) --------------------------------

struct Solution {}

impl Solution {
    pub fn sum_remoteness(grid: Vec[Vec[i32]]) -> i64 {
        let n = grid.len();
        let mut total: i64 = 0;
        for row in ref grid {
            for v in row {
                if v > 0 {
                    total += v;
                }
            }
        }
        let mut seen = Vec.filled(n, Vec.filled(n, false));
        let dirs = [(0, 1), (1, 0), (0, -1), (-1, 0)];
        let mut ans: i64 = 0;
        for i in 0..n {
            for j in 0..n {
                if grid[i][j] == -1 or seen[i][j] {
                    continue;
                }
                seen[i][j] = true;
                let mut q = VecDeque.new();
                q.push_back((i, j));
                let mut (cnt, sum) = (0, 0);
                while let Some((r, c)) = q.pop_front() {
                    cnt += 1;
                    sum += grid[r][c];
                    for (dr, dc) in dirs.iter() {
                        let nr = r as i32 + dr;
                        let nc = c as i32 + dc;
                        if nr < 0 or nc < 0 or nr >= n as i32 or nc >= n as i32 {
                            continue;
                        }
                        if grid[nr][nc] != -1 and not seen[nr][nc] {
                            seen[nr][nc] = true;
                            q.push_back((nr, nc));
                        }
                    }
                }
                ans += cnt * (total - sum);
            }
        }
        ans
    }
}

fn solution_sum_remoteness(grid: Vec[Vec[i64]]) -> i64 {
    let g: Vec[Vec[i32]] = grid.iter().map(|r| r.iter().map(|x| x as i32).collect()).collect();
    Solution.sum_remoteness(g)
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, grid: Vec[Vec[i64]]) -> i64 {
    match arm {
        0 => star_sum_remoteness(grid),
        1 => union_sum_remoteness(grid),
        2 => dfs_sum_remoteness(grid),
        3 => set_sum_remoteness(grid),
        _ => solution_sum_remoteness(grid),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "union", "dfs", "set", "solution"];
    let mut seed = 2852;
    let mut cases: Vec[Vec[Vec[i64]]] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 6 + 1 } else { next_random(mut seed) % 120 + 1 };
        let blocked = if small { 3 } else { next_random(mut seed) % 6 + 1 };
        let grid: Vec[Vec[i64]] = (0..n)
            .map(|_| {
                (0..n)
                    .map(|_| {
                        if small {
                            if next_random(mut seed) % 3 == 0 { -1 } else { next_random(mut seed) % 9 + 1 }
                        } else if next_random(mut seed) % 10 < blocked {
                            -1
                        } else {
                            wide(mut seed) % 1000000 + 1
                        }
                    })
                    .collect()
            })
            .collect();
        cases.push(grid);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, grid) in cases.iter().enumerate() {
        let n = grid.len();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, grid)).collect();
        let want = if c < 2000 { literal(grid) } else { got[0] };
        check = (check * 31 + want) % 1000000007;
        let transposed: Vec[Vec[i64]] = (0..n).map(|r| (0..n).map(|k| grid[k][r]).collect()).collect();
        let turned: Vec[Vec[i64]] = (0..n).map(|r| (0..n).map(|k| grid[n - 1 - k][r]).collect()).collect();
        let doubled: Vec[Vec[i64]] = grid.iter().map(|row| row.iter().map(|v| if v > 0 { 2 * v } else { v }).collect()).collect();
        let mut walled: Vec[Vec[i64]] = grid.iter().map(|row| row.iter().chain([-1].iter()).collect()).collect();
        walled.push(Vec.filled(n + 1, -1));
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                c >= 2000 or value == want,
                answer(arm, transposed) == value,
                answer(arm, turned) == value,
                answer(arm, doubled) == 2 * value,
                answer(arm, walled) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {grid}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
