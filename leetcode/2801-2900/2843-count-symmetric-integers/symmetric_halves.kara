// LeetCode #2843: Count Symmetric Integers -- built from halves rather
// than tested: for each length 2 and 4, the second halves grouped by
// digit sum in a `SortedMap` of sorted lists, and for each first half
// the second halves that keep the number inside the range counted by
// `partition_point` in its sum's list.

fn digit_sum(x: i64) -> i64 {
    if x == 0 { 0 } else { x % 10 + digit_sum(x / 10) }
}

fn count_symmetric_integers(low: i64, high: i64) -> i64 {
    let mut count = 0;
    for n in 1..3 {
        let base = 10.pow(n as u32);
        let mut by_sum: SortedMap[i64, Vec[i64]] = SortedMap.new();
        for tail in 0..base {
            by_sum.entry(digit_sum(tail)).or_insert(Vec.new()).push(tail);
        }
        for head in base / 10..base {
            let tails = ref by_sum[digit_sum(head)];
            // the number is head * base + tail, so the tails it can take
            // run from low - head * base to high - head * base
            let from = low - head * base;
            let to = high - head * base;
            count += tails.partition_point(|t| t <= to) - tails.partition_point(|t| t < from);
        }
    }
    count
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one number of each kind; and the whole
    // range LeetCode allows, 1 to 10^4
    println(f"{count_symmetric_integers(1, 100)} {count_symmetric_integers(1200, 1230)}");
    println(f"{count_symmetric_integers(11, 11)} {count_symmetric_integers(12, 12)} {count_symmetric_integers(10000, 10000)} {count_symmetric_integers(1001, 1001)}");
    println(f"{count_symmetric_integers(1, 10000)}");
    // 3000 random ranges inside 1 to 10^4, then 3000 of at most 100
    // numbers
    let mut seed = 2843;
    let mut check = 0;
    let mut total = 0;
    for c in 0..6000 {
        let a = next_random(mut seed) % 10000 + 1;
        let b = if c < 3000 { next_random(mut seed) % 10000 + 1 } else { (a + next_random(mut seed) % 100).min(10000) };
        let got = count_symmetric_integers(a.min(b), a.max(b));
        total += got;
        check = (check * 31 + got) % 1000000007;
        if c == 2999 or c == 5999 {
            println(f"3000 ranges: {total} in all, checksum {check}");
            total = 0;
            check = 0;
        }
    }
}
