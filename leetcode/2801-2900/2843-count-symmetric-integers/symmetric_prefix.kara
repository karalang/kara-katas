// LeetCode #2843: Count Symmetric Integers -- a prefix count over the
// whole range LeetCode allows: up_to[x] is how many symmetric numbers
// there are from 1 to x, built in one pass, and the answer a difference
// of two entries. Every number's digits come from a table of digit
// sums: a two-digit half's sum is `sums[half]`.

fn count_symmetric_integers(low: i64, high: i64) -> i64 {
    let top = 10000;
    let sums: Vec[i64] = (0..100).map(|h| h / 10 + h % 10).collect();
    let mut up_to: Vec[i64] = Vec.filled(top + 1, 0);
    for x in 1..top + 1 {
        let even = (10 <= x and x < 100) or (1000 <= x and x < 10000);
        let hit = if not even {
            false
        } else if x < 100 {
            x / 10 == x % 10
        } else {
            sums[x / 100] == sums[x % 100]
        };
        up_to[x] = up_to[x - 1] + if hit { 1 } else { 0 };
    }
    up_to[high] - up_to[low - 1]
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one number of each kind; and the whole
    // range LeetCode allows, 1 to 10^4
    println(f"{count_symmetric_integers(1, 100)} {count_symmetric_integers(1200, 1230)}");
    println(f"{count_symmetric_integers(11, 11)} {count_symmetric_integers(12, 12)} {count_symmetric_integers(10000, 10000)} {count_symmetric_integers(1001, 1001)}");
    println(f"{count_symmetric_integers(1, 10000)}");
    // 3000 random ranges inside 1 to 10^4, then 3000 of at most 100
    // numbers
    let mut seed = 2843;
    let mut check = 0;
    let mut total = 0;
    for c in 0..6000 {
        let a = next_random(mut seed) % 10000 + 1;
        let b = if c < 3000 { next_random(mut seed) % 10000 + 1 } else { (a + next_random(mut seed) % 100).min(10000) };
        let got = count_symmetric_integers(a.min(b), a.max(b));
        total += got;
        check = (check * 31 + got) % 1000000007;
        if c == 2999 or c == 5999 {
            println(f"3000 ranges: {total} in all, checksum {check}");
            total = 0;
            check = 0;
        }
    }
}
