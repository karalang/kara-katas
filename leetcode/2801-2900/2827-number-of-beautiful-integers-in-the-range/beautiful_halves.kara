// LeetCode #2827: Number of Beautiful Integers in the Range -- halves: a
// balanced number has an even count of digits 2h, so it is a high half
// H of h digits and a low half L of h digits, leading zeros allowed; a
// table of the low halves by balance and remainder pairs with every high
// half whose balance and remainder cancel them. A count up to a bound
// takes every even length below it whole, and at its own length every
// high half below the bound's, then the bound's own high half against
// each low half up to the bound's, one by one.

fn balance_of(v: i64, digits: i64) -> i64 {
    let mut rest = v;
    let mut balance = 0;
    for _ in 0..digits {
        balance += if rest % 10 % 2 == 0 { 1 } else { -1 };
        rest /= 10;
    }
    balance
}

// low halves of h digits by (balance + h) * k + remainder
fn low_table(h: i64, k: i64) -> Vec[i64] {
    let mut table: Vec[i64] = Vec.filled((2 * h + 1) * k, 0);
    let top = 10.pow(h as u32);
    for low in 0..top {
        table[(balance_of(low, h) + h) * k + low % k] += 1;
    }
    table
}

// balanced numbers of 2h digits whose high half is in `from..until`
fn with_high(from: i64, until: i64, h: i64, k: i64, lows: Vec[i64]) -> i64 {
    let shift = 10.pow(h as u32) % k;
    let mut total = 0;
    for high in from..until {
        let need = -balance_of(high, h);
        let rem = (k - high % k * shift % k) % k;
        if need >= -h and need <= h {
            total += lows[(need + h) * k + rem];
        }
    }
    total
}

fn count_upto(x: i64, k: i64) -> i64 {
    if x <= 0 {
        return 0;
    }
    let n = x.to_string().len();
    let mut total = 0;
    let mut h = 1;
    while 2 * h <= n {
        let lows = low_table(h, k);
        let base = 10.pow(h as u32);
        if 2 * h < n {
            total += with_high(base / 10, base, h, k, lows);
        } else {
            let (top, bottom) = (x / base, x % base);
            total += with_high(base / 10, top, h, k, lows);
            let (need, shift) = (-balance_of(top, h), top % k * (base % k) % k);
            for low in 0..=bottom {
                if balance_of(low, h) == need and (shift + low) % k == 0 {
                    total += 1;
                }
            }
        }
        h += 1;
    }
    total
}

fn number_of_beautiful_integers(low: i64, high: i64, k: i64) -> i64 {
    count_upto(high, k) - count_upto(low - 1, k)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's three examples; the whole range for k = 1, 7 and 20;
    // one balanced number alone; and a range of one even-length band
    println(f"{number_of_beautiful_integers(10, 20, 3)}");
    println(f"{number_of_beautiful_integers(1, 10, 1)}");
    println(f"{number_of_beautiful_integers(5, 5, 2)}");
    println(f"{number_of_beautiful_integers(1, 1000000000, 1)}");
    println(f"{number_of_beautiful_integers(1, 1000000000, 7)}");
    println(f"{number_of_beautiful_integers(1, 1000000000, 20)}");
    println(f"{number_of_beautiful_integers(1234, 1234, 2)}");
    println(f"{number_of_beautiful_integers(100000, 999999, 3)}");
    // 300 random ranges up to 10^9 with k from 1 to 20; then 300 ranges
    // of up to 1000 numbers
    let mut seed = 2827;
    let mut check = 0;
    for _ in 0..300 {
        let a = wide(mut seed) % 1000000000 + 1;
        let b = wide(mut seed) % 1000000000 + 1;
        let k = next_random(mut seed) % 20 + 1;
        check = (check * 31 + number_of_beautiful_integers(a.min(b), a.max(b), k)) % 1000000007;
    }
    println(f"300 wide ranges: checksum {check}");
    check = 0;
    for _ in 0..300 {
        let a = wide(mut seed) % 1000000000 + 1;
        let b = (a + next_random(mut seed) % 1000).min(1000000000);
        let k = next_random(mut seed) % 20 + 1;
        check = (check * 31 + number_of_beautiful_integers(a, b, k)) % 1000000007;
    }
    println(f"300 narrow ranges: checksum {check}");
}
