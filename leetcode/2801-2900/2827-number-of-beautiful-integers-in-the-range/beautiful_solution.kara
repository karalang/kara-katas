// LeetCode #2827: Number of Beautiful Integers in the Range -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac
// fix`: a digit DP over `n.to_string().bytes()`, `is_limit` and
// `is_lead` flags, the balance offset by the length as a `usize`, and a
// `vec![vec![vec![-1i32; k]; 2 * len + 1]; len]` memo passed `&mut`.

struct Solution {}

impl Solution {
    pub fn number_of_beautiful_integers(low: i32, high: i32, k: i32) -> i32 {
        Solution.count(high, k) - Solution.count(low - 1, k)
    }

    fn count(n: i32, k: i32) -> i32 {
        if n <= 0 {
            return 0;
        }
        let s: Vec[u8] = n.to_string().bytes().iter().collect();
        let len = s.len();
        let mut memo = Vec.filled(len, Vec.filled(2 * len + 1, Vec.filled(k, -1i32)));
        Solution.dfs(0, len, 0, true, true, s, k, mut memo)
    }

    fn dfs(i: i64, diff: i64, rem: i32, is_limit: bool, is_lead: bool, s: Slice[u8], k: i32, memo: mut ref Vec[Vec[Vec[i32]]]) -> i32 {
        if i == s.len() {
            return if not is_lead and rem == 0 and diff == s.len() { 1 } else { 0 };
        }
        if not is_limit and not is_lead and memo[i][diff][rem] >= 0 {
            return memo[i][diff][rem];
        }
        let mut res: i32 = 0;
        if is_lead {
            res += Solution.dfs(i + 1, diff, rem, false, true, s, k, mut memo);
        }
        let lo = if is_lead { 1 } else { 0 };
        let hi = if is_limit { (s[i] - b'0') as i32 } else { 9 };
        for d in lo..=hi {
            let nd = if d % 2 == 0 { diff + 1 } else { diff - 1 };
            res += Solution.dfs(i + 1, nd, (rem * 10 + d) % k, is_limit and d == hi, false, s, k, mut memo);
        }
        if not is_limit and not is_lead {
            memo[i][diff][rem] = res;
        }
        res
    }
}

fn number_of_beautiful_integers(low: i64, high: i64, k: i64) -> i64 {
    Solution.number_of_beautiful_integers(low as i32, high as i32, k as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's three examples; the whole range for k = 1, 7 and 20;
    // one balanced number alone; and a range of one even-length band
    println(f"{number_of_beautiful_integers(10, 20, 3)}");
    println(f"{number_of_beautiful_integers(1, 10, 1)}");
    println(f"{number_of_beautiful_integers(5, 5, 2)}");
    println(f"{number_of_beautiful_integers(1, 1000000000, 1)}");
    println(f"{number_of_beautiful_integers(1, 1000000000, 7)}");
    println(f"{number_of_beautiful_integers(1, 1000000000, 20)}");
    println(f"{number_of_beautiful_integers(1234, 1234, 2)}");
    println(f"{number_of_beautiful_integers(100000, 999999, 3)}");
    // 300 random ranges up to 10^9 with k from 1 to 20; then 300 ranges
    // of up to 1000 numbers
    let mut seed = 2827;
    let mut check = 0;
    for _ in 0..300 {
        let a = wide(mut seed) % 1000000000 + 1;
        let b = wide(mut seed) % 1000000000 + 1;
        let k = next_random(mut seed) % 20 + 1;
        check = (check * 31 + number_of_beautiful_integers(a.min(b), a.max(b), k)) % 1000000007;
    }
    println(f"300 wide ranges: checksum {check}");
    check = 0;
    for _ in 0..300 {
        let a = wide(mut seed) % 1000000000 + 1;
        let b = (a + next_random(mut seed) % 1000).min(1000000000);
        let k = next_random(mut seed) % 20 + 1;
        check = (check * 31 + number_of_beautiful_integers(a, b, k)) % 1000000007;
    }
    println(f"300 narrow ranges: checksum {check}");
}
