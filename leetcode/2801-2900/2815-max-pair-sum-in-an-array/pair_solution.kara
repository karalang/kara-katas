// LeetCode #2815: Max Pair Sum in an Array -- a Rust solution as
// LeetCode's Rust users write it, carried to Kāra by `karac fix`: a
// `[i32; 10]` of the best number per largest digit, the digit read by
// `to_string().chars().max()` and `to_digit(10)`.

struct Solution {}

impl Solution {
    pub fn max_sum(nums: Vec[i32]) -> i32 {
        let mut best = [0i32; 10];
        let mut ans: i32 = -1;
        for x in nums.iter() {
            let d = x.to_string().chars().max().unwrap().to_digit(10).unwrap() as usize;
            if best[d] > 0 {
                ans = ans.max(best[d] + x);
            }
            best[d] = best[d].max(x);
        }
        ans
    }
}

fn max_sum(nums: Vec[i64]) -> i64 {
    Solution.max_sum(nums.iter().map(|v| v as i32).collect())
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; two numbers whose largest digits differ;
    // two of the largest with the same; 1 to 100, LeetCode's most
    println(f"{max_sum([51, 71, 17, 24, 42])}");
    println(f"{max_sum([1, 2, 3, 4])}");
    println(f"{max_sum([10000, 9999])}");
    println(f"{max_sum([9999, 9999])}");
    println(f"{max_sum((1..=100).collect())}");
    // 3000 random arrays of 2 to 8 numbers up to 100; then 50 of 2 to 100
    // numbers up to 10^4
    let mut seed = 2815;
    let mut none = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 7 + 2;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 100 + 1).collect();
        let a = max_sum(nums);
        none += if a == -1 { 1 } else { 0 };
        check = (check * 31 + a + 2) % 1000000007;
    }
    println(f"3000 small arrays: {none} without a pair, checksum {check}");
    none = 0;
    check = 0;
    for _ in 0..50 {
        let n = next_random(mut seed) % 99 + 2;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 10000 + 1).collect();
        let a = max_sum(nums);
        none += if a == -1 { 1 } else { 0 };
        check = (check * 31 + a + 2) % 1000000007;
    }
    println(f"50 large arrays: {none} without a pair, checksum {check}");
}
