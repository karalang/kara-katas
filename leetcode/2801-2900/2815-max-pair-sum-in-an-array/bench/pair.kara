// LeetCode #2815: Max Pair Sum in an Array -- the bench: the ★ arm over
// 20000 arrays of 100 numbers, LeetCode's most, up to 10^4, all drawn
// first, then each answered 10 times.

fn largest_digit(x: i64) -> i64 {
    let mut rest = x;
    let mut top = 0;
    while rest > 0 {
        top = top.max(rest % 10);
        rest /= 10;
    }
    top
}

fn max_sum(nums: Vec[i64]) -> i64 {
    let mut best = [0; 10];
    let mut answer = -1;
    for x in nums.iter() {
        let d = largest_digit(x);
        if best[d] > 0 {
            answer = answer.max(best[d] + x);
        }
        best[d] = best[d].max(x);
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 20000;
    let rounds = 10;
    let mut seed = 2815;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        arrays.push((0..100).map(|_| next_random(mut seed) % 10000 + 1).collect());
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in arrays.iter() {
            let a = max_sum(nums);
            total += a;
            check = (check * 31 + a + 2 + r) % 1000000007;
        }
    }
    println(f"{count} arrays of 100, {rounds} rounds: sums total {total}, checksum {check}");
}
