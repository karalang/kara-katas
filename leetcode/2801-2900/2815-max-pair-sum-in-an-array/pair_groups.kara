// LeetCode #2815: Max Pair Sum in an Array -- by groups: the numbers
// gathered into a `Map` from their largest digit, the digit read as the
// greatest `char` of the number written out; each group of two or more
// sorted, and its two largest summed.

fn max_sum(nums: Vec[i64]) -> i64 {
    let mut groups: Map[char, Vec[i64]] = Map.new();
    for x in nums.iter() {
        let top = f"{x}".chars().max().unwrap();
        groups.entry(top).or_insert(Vec.new()).push(x);
    }
    let mut answer = -1;
    for (_, group) in groups.iter_mut() {
        if group.len() >= 2 {
            group.sort();
            answer = answer.max(group[group.len() - 1] + group[group.len() - 2]);
        }
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; two numbers whose largest digits differ;
    // two of the largest with the same; 1 to 100, LeetCode's most
    println(f"{max_sum([51, 71, 17, 24, 42])}");
    println(f"{max_sum([1, 2, 3, 4])}");
    println(f"{max_sum([10000, 9999])}");
    println(f"{max_sum([9999, 9999])}");
    println(f"{max_sum((1..=100).collect())}");
    // 3000 random arrays of 2 to 8 numbers up to 100; then 50 of 2 to 100
    // numbers up to 10^4
    let mut seed = 2815;
    let mut none = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 7 + 2;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 100 + 1).collect();
        let a = max_sum(nums);
        none += if a == -1 { 1 } else { 0 };
        check = (check * 31 + a + 2) % 1000000007;
    }
    println(f"3000 small arrays: {none} without a pair, checksum {check}");
    none = 0;
    check = 0;
    for _ in 0..50 {
        let n = next_random(mut seed) % 99 + 2;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 10000 + 1).collect();
        let a = max_sum(nums);
        none += if a == -1 { 1 } else { 0 };
        check = (check * 31 + a + 2) % 1000000007;
    }
    println(f"50 large arrays: {none} without a pair, checksum {check}");
}
