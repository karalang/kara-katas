// LeetCode #2815: Max Pair Sum in an Array -- the differential. The five
// arms, against the statement read literally: every pair i < j, each
// number's largest digit read from the number written out as the
// greatest of its digit characters, and the best sum over the pairs
// whose largest digits are equal, or -1; no table and no sort. 2000
// random arrays of 2 to 8 numbers up to 100; then 50 of 2 to 100 numbers
// up to 10^4. Every case is drawn before any arm answers; the literal
// reading is asked only of the first 2000.
//
// P1  up to 8 numbers, the answer is the literal reading's
// P2  -1, or the sum of two numbers of the array, at most its two largest
// P3  the numbers reversed: the same answer
// P4  the array written twice over: twice its largest number
// P5  every number times 10: the answer times 10, or still -1
// P6  each arm agrees with at least three of the other four


// ---- star (pair.kara) -----------------------------------------------

fn star_largest_digit(x: i64) -> i64 {
    let mut rest = x;
    let mut top = 0;
    while rest > 0 {
        top = top.max(rest % 10);
        rest /= 10;
    }
    top
}

fn star_max_sum(nums: Vec[i64]) -> i64 {
    let mut best = [0; 10];
    let mut answer = -1;
    for x in nums.iter() {
        let d = star_largest_digit(x);
        if best[d] > 0 {
            answer = answer.max(best[d] + x);
        }
        best[d] = best[d].max(x);
    }
    answer
}


// ---- pairs (pair_pairs.kara) ----------------------------------------

fn pairs_max_sum(nums: Vec[i64]) -> i64 {
    let digits: Vec[i64] = nums.iter().map(|x| {
        let mut rest = x;
        let mut top = 0;
        while rest > 0 {
            top = top.max(rest % 10);
            rest /= 10;
        }
        top
    }).collect();
    let mut answer = -1;
    for i in 0..nums.len() {
        for j in i + 1..nums.len() {
            if digits[i] == digits[j] {
                answer = answer.max(nums[i] + nums[j]);
            }
        }
    }
    answer
}


// ---- groups (pair_groups.kara) --------------------------------------

fn groups_max_sum(nums: Vec[i64]) -> i64 {
    let mut groups: Map[char, Vec[i64]] = Map.new();
    for x in nums.iter() {
        let top = f"{x}".chars().max().unwrap();
        groups.entry(top).or_insert(Vec.new()).push(x);
    }
    let mut answer = -1;
    for (_, group) in groups.iter_mut() {
        if group.len() >= 2 {
            group.sort();
            answer = answer.max(group[group.len() - 1] + group[group.len() - 2]);
        }
    }
    answer
}


// ---- sorted (pair_sorted.kara) --------------------------------------

fn sorted_largest_digit(x: i64) -> i64 {
    if x < 10 { x } else { sorted_largest_digit(x / 10).max(x % 10) }
}

fn sorted_max_sum(nums: Vec[i64]) -> i64 {
    let mut order = nums.clone();
    order.sort();
    order.reverse();
    let mut first: Vec[Option[i64]] = Vec.filled(10, None);
    let mut paired: Vec[bool] = Vec.filled(10, false);
    let mut answer = -1;
    for x in order.iter() {
        let d = sorted_largest_digit(x);
        if paired[d] {
            continue;
        }
        match first[d] {
            None => first[d] = Some(x),
            Some(y) => {
                answer = answer.max(x + y);
                paired[d] = true;
            }
        }
    }
    answer
}


// ---- solution (pair_solution.kara) ----------------------------------

struct Solution {}

impl Solution {
    pub fn max_sum(nums: Vec[i32]) -> i32 {
        let mut best = [0i32; 10];
        let mut ans: i32 = -1;
        for x in nums.iter() {
            let d = x.to_string().chars().max().unwrap().to_digit(10).unwrap() as usize;
            if best[d] > 0 {
                ans = ans.max(best[d] + x);
            }
            best[d] = best[d].max(x);
        }
        ans
    }
}

fn solution_max_sum(nums: Vec[i64]) -> i64 {
    Solution.max_sum(nums.iter().map(|v| v as i32).collect())
}



// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64]) -> i64 {
    let top = |x: i64| f"{x}".chars().max().unwrap();
    let mut answer = -1;
    for i in 0..nums.len() {
        for j in i + 1..nums.len() {
            if top(nums[i]) == top(nums[j]) {
                answer = answer.max(nums[i] + nums[j]);
            }
        }
    }
    answer
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_max_sum(nums),
        1 => pairs_max_sum(nums),
        2 => groups_max_sum(nums),
        3 => sorted_max_sum(nums),
        _ => solution_max_sum(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "pairs", "groups", "sorted", "solution"];
    let mut seed = 2815;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        let (extra, top) = if c < 2000 { (7, 100) } else { (99, 10000) };
        let n = next_random(mut seed) % extra + 2;
        cases.push((0..n).map(|_| next_random(mut seed) % top + 1).collect());
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nums) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(nums) } else { 0 };
        check = (check * 31 + want + 2) % 1000000007;
        let mut sorted = nums.clone();
        sorted.sort();
        let n = nums.len();
        let ceiling = sorted[n - 1] + sorted[n - 2];
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let twice: Vec[i64] = nums.iter().chain(nums.iter()).collect();
        let tenfold: Vec[i64] = nums.iter().map(|x| x * 10).collect();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let is_sum = (0..n).any(|i| (i + 1..n).any(|j| nums[i] + nums[j] == value));
            let tens = answer(arm, tenfold);
            let verdicts = [
                not small or value == want,
                value == -1 or (is_sum and value <= ceiling),
                answer(arm, reversed) == value,
                answer(arm, twice) == 2 * sorted[n - 1],
                if value == -1 { tens == -1 } else { tens == 10 * value },
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
