// LeetCode #2872: Maximum Number of K-Divisible Components -- the bench:
// the ★ arm over 30 trees of 3 * 10^4 nodes, LeetCode's most, values up
// to 10^9 and k from 2 to 10, every other one deep, all drawn first,
// then each answered 20 times.

fn max_k_divisible_components(n: i64, edges: Vec[Vec[i64]], values: Vec[i64], k: i64) -> i64 {
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    let mut order: Vec[i64] = [0].to_vec();
    let mut head = 0;
    while head < order.len() {
        let u = order[head];
        head += 1;
        for w in adjacent[u].iter() {
            if w != parent[u] {
                parent[w] = u;
                order.push(w);
            }
        }
    }
    let mut rest: Vec[i64] = values.iter().map(|v| v % k).collect();
    let mut parts = 0;
    for u in order.iter().rev() {
        if rest[u] == 0 {
            parts += 1;
        } else if parent[u] >= 0 {
            rest[parent[u]] = (rest[parent[u]] + rest[u]) % k;
        }
    }
    parts
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 30;
    let rounds = 20;
    let n = 30000;
    let mut seed = 2872;
    let mut cases: Vec[(Vec[Vec[i64]], Vec[i64], i64)] = Vec.new();
    for c in 0..count {
        let k = next_random(mut seed) % 9 + 2;
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for v in 1..n {
            let reach = if c % 2 == 1 { v.min(5) } else { v };
            edges.push([v - 1 - wide(mut seed) % reach, v].to_vec());
        }
        let mut values: Vec[i64] = (0..n).map(|_| wide(mut seed) % 1000000001).collect();
        let sum: i64 = values.iter().sum();
        values[0] += (k - sum % k) % k;
        cases.push((edges, values, k));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (edges, values, k) in cases.iter() {
            let parts = max_k_divisible_components(n, edges, values, k);
            total += parts;
            check = (check * 31 + parts + r) % 1000000007;
        }
    }
    println(f"{count} trees of {n}, {rounds} rounds: {total} components, checksum {check}");
}
