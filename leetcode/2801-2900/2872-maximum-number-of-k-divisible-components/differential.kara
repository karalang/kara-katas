// LeetCode #2872: Maximum Number of K-Divisible Components -- the
// differential. The five arms, against the statement read literally:
// every set of edges to cut tried, as a bit mask, the parts left found
// by flood fill, and the most parts kept whose sums all divide by k.
// 2000 random trees of 1 to 10 nodes, values 0 to 9, k 1 to 5, then 50
// of up to 3000, values up to 10^9, every other one with k up to 10 and
// deep, the first value raised so the sum divides by k, all drawn
// before any arm answers; the literal reading is asked only of the
// first 2000.
//
// P1  up to 10 nodes, the answer is the literal reading's
// P2  up to 10 nodes, every value times k: n
// P3  a leaf of value 0 added to node 0: one more
// P4  every label v made n - 1 - v: the same answer
// P5  from 1 to n, and n with k made 1
// P6  each arm agrees with at least three of the other four

fn literal(n: i64, edges: Vec[Vec[i64]], values: Vec[i64], k: i64) -> i64 {
    let mut most = 0;
    for cut in 0..(1 << edges.len()) {
        let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
        for (i, e) in edges.iter().enumerate() {
            if (cut >> i) & 1 == 0 {
                adjacent[e[0]].push(e[1]);
                adjacent[e[1]].push(e[0]);
            }
        }
        let mut seen: Vec[bool] = Vec.filled(n, false);
        let mut parts = 0;
        let mut all_divide = true;
        for start in 0..n {
            if seen[start] {
                continue;
            }
            parts += 1;
            seen[start] = true;
            let mut stack: Vec[i64] = [start].to_vec();
            let mut sum = 0;
            while let Some(u) = stack.pop() {
                sum += values[u];
                for w in adjacent[u].iter() {
                    if not seen[w] {
                        seen[w] = true;
                        stack.push(w);
                    }
                }
            }
            if sum % k != 0 {
                all_divide = false;
            }
        }
        if all_divide {
            most = most.max(parts);
        }
    }
    most
}


// ---- star (components.kara) -----------------------------------------

fn star_max_k_divisible_components(n: i64, edges: Vec[Vec[i64]], values: Vec[i64], k: i64) -> i64 {
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    let mut order: Vec[i64] = [0].to_vec();
    let mut head = 0;
    while head < order.len() {
        let u = order[head];
        head += 1;
        for w in adjacent[u].iter() {
            if w != parent[u] {
                parent[w] = u;
                order.push(w);
            }
        }
    }
    let mut rest: Vec[i64] = values.iter().map(|v| v % k).collect();
    let mut parts = 0;
    for u in order.iter().rev() {
        if rest[u] == 0 {
            parts += 1;
        } else if parent[u] >= 0 {
            rest[parent[u]] = (rest[parent[u]] + rest[u]) % k;
        }
    }
    parts
}


// ---- dfs (components_dfs.kara) --------------------------------------

fn dfs_below(u: i64, from: i64, adjacent: Vec[Vec[i64]], values: Vec[i64], k: i64, parts: mut ref i64) -> i64 {
    let mut sum = values[u] % k;
    for w in adjacent[u].iter() {
        if w != from {
            sum = (sum + dfs_below(w, u, adjacent, values, k, mut parts)) % k;
        }
    }
    if sum == 0 {
        *parts += 1;
    }
    sum
}

fn dfs_max_k_divisible_components(n: i64, edges: Vec[Vec[i64]], values: Vec[i64], k: i64) -> i64 {
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut parts = 0;
    dfs_below(0, -1, adjacent, values, k, mut parts);
    parts
}


// ---- leaves (components_leaves.kara) --------------------------------

fn leaves_max_k_divisible_components(n: i64, edges: Vec[Vec[i64]], values: Vec[i64], k: i64) -> i64 {
    let mut degree: Vec[i64] = Vec.filled(n, 0);
    let mut others: Vec[i64] = Vec.filled(n, 0);
    for e in edges.iter() {
        degree[e[0]] += 1;
        degree[e[1]] += 1;
        others[e[0]] ^= e[1];
        others[e[1]] ^= e[0];
    }
    let mut rest: Vec[i64] = values.iter().map(|v| v % k).collect();
    let mut leaves: Vec[i64] = (0..n).filter(|u| degree[u] == 1).collect();
    let mut parts = 0;
    let mut left = n;
    while let Some(u) = leaves.pop() {
        if left == 1 {
            break;
        }
        left -= 1;
        let w = others[u];
        if rest[u] == 0 {
            parts += 1;
        } else {
            rest[w] = (rest[w] + rest[u]) % k;
        }
        others[w] ^= u;
        degree[w] -= 1;
        if degree[w] == 1 {
            leaves.push(w);
        }
    }
    parts + 1
}


// ---- tour (components_tour.kara) ------------------------------------

fn tour_max_k_divisible_components(n: i64, edges: Vec[Vec[i64]], values: Vec[i64], k: i64) -> i64 {
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut first: Vec[i64] = Vec.filled(n, 0);
    let mut size: Vec[i64] = Vec.filled(n, 1);
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    let mut tour: Vec[i64] = Vec.new();
    let mut stack: Vec[i64] = [0].to_vec();
    while let Some(u) = stack.pop() {
        first[u] = tour.len();
        tour.push(u);
        for w in adjacent[u].iter() {
            if w != parent[u] {
                parent[w] = u;
                stack.push(w);
            }
        }
    }
    for u in tour.iter().rev() {
        if parent[u] >= 0 {
            size[parent[u]] += size[u];
        }
    }
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for (i, u) in tour.iter().enumerate() {
        prefix[i + 1] = (prefix[i] + values[u]) % k;
    }
    (0..n).filter(|u| (prefix[first[u] + size[u]] - prefix[first[u]]) % k == 0).count()
}


// ---- solution (components_solution.kara) ----------------------------

fn solution_dfs(u: i64, p: i64, g: ref Vec[Vec[i64]], values: ref Vec[i32], k: i64, ans: mut ref i32) -> i64 {
    let mut s = values[u] as i64;
    for v in ref g[u] {
        if v != p {
            s += solution_dfs(v, u, g, values, k, mut ans);
        }
    }
    if s % k == 0 {
        *ans += 1;
    }
    s % k
}

struct Solution {}

impl Solution {
    pub fn max_k_divisible_components(n: i32, edges: Vec[Vec[i32]], values: Vec[i32], k: i32) -> i32 {
        let n = n as i64;
        let mut g = Vec.filled(n, Vec.new());
        for e in ref edges {
            let (a, b) = (e[0] as i64, e[1] as i64);
            g[a].push(b);
            g[b].push(a);
        }
        let mut ans = 0;
        solution_dfs(0, i64.MAX, g, values, k, mut ans);
        ans
    }
}

fn solution_max_k_divisible_components(n: i64, edges: Vec[Vec[i64]], values: Vec[i64], k: i64) -> i64 {
    let edges: Vec[Vec[i32]] = edges.iter().map(|e| e.iter().map(|x| x as i32).collect()).collect();
    Solution.max_k_divisible_components(n as i32, edges, values.iter().map(|x| x as i32).collect(), k as i32)
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, n: i64, edges: Vec[Vec[i64]], values: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_max_k_divisible_components(n, edges, values, k),
        1 => dfs_max_k_divisible_components(n, edges, values, k),
        2 => leaves_max_k_divisible_components(n, edges, values, k),
        3 => tour_max_k_divisible_components(n, edges, values, k),
        _ => solution_max_k_divisible_components(n, edges, values, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "dfs", "leaves", "tour", "solution"];
    let mut seed = 2872;
    let mut cases: Vec[(i64, Vec[Vec[i64]], Vec[i64], i64)] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 10 + 1 } else { wide(mut seed) % 3000 + 1 };
        let k = if small { next_random(mut seed) % 5 + 1 } else if c % 2 == 1 { next_random(mut seed) % 9 + 2 } else { wide(mut seed) % 1000000000 + 1 };
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for v in 1..n {
            let reach = if not small and c % 2 == 1 { v.min(5) } else { v };
            edges.push([v - 1 - wide(mut seed) % reach, v].to_vec());
        }
        let mut values: Vec[i64] = (0..n).map(|_| if small { next_random(mut seed) % 10 } else { wide(mut seed) % 1000000001 }).collect();
        let sum: i64 = values.iter().sum();
        values[0] += (k - sum % k) % k;
        cases.push((n, edges, values, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, (n, edges, values, k)) in cases.iter().enumerate() {
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, n, edges, values, k)).collect();
        let want = if c < 2000 { literal(n, edges, values, k) } else { got[0] };
        total += want;
        check = (check * 31 + want) % 1000000007;
        let scaled: Vec[i64] = values.iter().map(|v| v * k).collect();
        let mut grown = edges.clone();
        grown.push([0, n].to_vec());
        let mut zeroed = values.clone();
        zeroed.push(0);
        let flipped: Vec[Vec[i64]] = edges.iter().map(|e| [n - 1 - e[0], n - 1 - e[1]].to_vec()).collect();
        let flipped_values: Vec[i64] = values.iter().rev().cloned().collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                c >= 2000 or value == want,
                c >= 2000 or answer(arm, n, edges, scaled, k) == n,
                answer(arm, n + 1, grown, zeroed, k) == value + 1,
                answer(arm, n, flipped, flipped_values, k) == value,
                value >= 1 and value <= n and answer(arm, n, edges, values, 1) == n,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} n {n} k {k}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, {total} components: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
