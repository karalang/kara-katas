// LeetCode #2872: Maximum Number of K-Divisible Components -- leaves
// peeled off, with no root: each node keeps its degree and the XOR of
// its neighbours' labels, so a leaf's one neighbour left is that XOR. A
// leaf whose sum divides by k is a component; otherwise its sum goes to
// the neighbour. The last node standing closes the last component.

fn max_k_divisible_components(n: i64, edges: Vec[Vec[i64]], values: Vec[i64], k: i64) -> i64 {
    let mut degree: Vec[i64] = Vec.filled(n, 0);
    let mut others: Vec[i64] = Vec.filled(n, 0);
    for e in edges.iter() {
        degree[e[0]] += 1;
        degree[e[1]] += 1;
        others[e[0]] ^= e[1];
        others[e[1]] ^= e[0];
    }
    let mut rest: Vec[i64] = values.iter().map(|v| v % k).collect();
    let mut leaves: Vec[i64] = (0..n).filter(|u| degree[u] == 1).collect();
    let mut parts = 0;
    let mut left = n;
    while let Some(u) = leaves.pop() {
        if left == 1 {
            break;
        }
        left -= 1;
        let w = others[u];
        if rest[u] == 0 {
            parts += 1;
        } else {
            rest[w] = (rest[w] + rest[u]) % k;
        }
        others[w] ^= u;
        degree[w] -= 1;
        if degree[w] == 1 {
            leaves.push(w);
        }
    }
    parts + 1
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; 3 * 10^4 nodes, LeetCode's most, as a path
    // of values k and a star of zeros
    println(f"{max_k_divisible_components(5, [[0, 2], [1, 2], [1, 3], [2, 4]].to_vec(), [1, 8, 1, 4, 4].to_vec(), 6)} {max_k_divisible_components(7, [[0, 1], [0, 2], [1, 3], [1, 4], [2, 5], [2, 6]].to_vec(), [3, 0, 6, 1, 5, 2, 1].to_vec(), 3)}");
    let n = 30000;
    let path: Vec[Vec[i64]] = (1..n).map(|i| [i - 1, i].to_vec()).collect();
    let star: Vec[Vec[i64]] = (1..n).map(|i| [0, i].to_vec()).collect();
    println(f"{max_k_divisible_components(n, path, Vec.filled(n, 7), 7)} {max_k_divisible_components(n, star, Vec.filled(n, 0), 1000000000)}");
    // 3000 random trees of 1 to 10 nodes, values 0 to 9, k 1 to 5; then 30
    // of 10^3 to 3 * 10^4, values up to 10^9, every other one with k up to
    // 10 and deep, each node's parent among the five before it; the first
    // value raised so the sum divides by k
    let mut seed = 2872;
    let mut total = 0;
    let mut check = 0;
    for c in 0..3030 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 10 + 1 } else { wide(mut seed) % 29001 + 1000 };
        let k = if small { next_random(mut seed) % 5 + 1 } else if c % 2 == 1 { next_random(mut seed) % 9 + 2 } else { wide(mut seed) % 1000000000 + 1 };
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for v in 1..n {
            let reach = if not small and c % 2 == 1 { v.min(5) } else { v };
            edges.push([v - 1 - wide(mut seed) % reach, v].to_vec());
        }
        let mut values: Vec[i64] = (0..n).map(|_| if small { next_random(mut seed) % 10 } else { wide(mut seed) % 1000000001 }).collect();
        let sum: i64 = values.iter().sum();
        values[0] += (k - sum % k) % k;
        let parts = max_k_divisible_components(n, edges, values, k);
        total += parts;
        check = (check * 31 + parts) % 1000000007;
        if c == 2999 {
            println(f"3000 small trees: {total} components, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"30 large trees: {total} components, checksum {check}");
}
