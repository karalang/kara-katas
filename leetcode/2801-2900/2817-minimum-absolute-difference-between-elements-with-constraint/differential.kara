// LeetCode #2817: Minimum Absolute Difference Between Elements With
// Constraint -- the differential. The five arms, against the statement
// read literally: every pair of indices i and j, in both orders, whose
// distance |i - j| is at least x, and the least |nums[i] - nums[j]| among
// them; no window and no set. 2000 random arrays of 1 to 10 numbers up
// to 20 with x below the count; then 50 of up to 600 numbers up to 10^9.
// Every case is drawn before any arm answers; the literal reading is
// asked only of the first 2000.
//
// P1  up to 10 numbers, the answer is the literal reading's
// P2  the difference of some pair at least x apart, and at least 0
// P3  the numbers reversed: the same answer
// P4  every number v as 10^9 + 1 - v, turned within the range: the
//     same answer
// P5  x one less: no larger; x = 0: 0
// P6  each arm agrees with at least three of the other four


// ---- star (window.kara) ---------------------------------------------

fn star_min_absolute_difference(nums: Vec[i64], x: i64) -> i64 {
    let mut behind: SortedSet[i64] = SortedSet.new();
    let mut best = i64.MAX;
    for i in x..nums.len() {
        behind.insert(nums[i - x]);
        let v = nums[i];
        if let Some(up) = behind.range(v, i64.MAX).next() {
            best = best.min(up - v);
        }
        if let Some(down) = behind.range_inclusive(i64.MIN, v).next_back() {
            best = best.min(v - down);
        }
        if best == 0 {
            break;
        }
    }
    best
}


// ---- map (window_map.kara) ------------------------------------------

fn map_min_absolute_difference(nums: Vec[i64], x: i64) -> i64 {
    let mut behind: SortedMap[i64, i64] = SortedMap.new();
    let mut best = i64.MAX;
    for i in x..nums.len() {
        *behind.entry(nums[i - x]).or_insert(0) += 1;
        let v = nums[i];
        if let Some((up, _)) = behind.ceiling(v) {
            best = best.min(up - v);
        }
        if let Some((down, _)) = behind.floor(v) {
            best = best.min(v - down);
        }
    }
    best
}


// ---- sorted (window_sorted.kara) ------------------------------------

fn sorted_min_absolute_difference(nums: Vec[i64], x: i64) -> i64 {
    let mut behind: Vec[i64] = Vec.new();
    let mut best = i64.MAX;
    for i in x..nums.len() {
        let w = nums[i - x];
        let at = behind.partition_point(|b| b < w);
        behind.insert(at, w);
        let v = nums[i];
        let k = behind.partition_point(|b| b < v);
        if k < behind.len() {
            best = best.min(behind[k] - v);
        }
        if k > 0 {
            best = best.min(v - behind[k - 1]);
        }
    }
    best
}


// ---- pairs (window_pairs.kara) --------------------------------------

fn pairs_min_absolute_difference(nums: Vec[i64], x: i64) -> i64 {
    let n = nums.len();
    let mut best = i64.MAX;
    for i in 0..n {
        for j in i + x..n {
            best = best.min((nums[i] - nums[j]).abs());
            if best == 0 {
                return 0;
            }
        }
    }
    best
}


// ---- solution (window_solution.kara) --------------------------------

struct Solution {}

impl Solution {
    pub fn min_absolute_difference(nums: Vec[i32], x: i32) -> i32 {
        let x = x as i64;
        let mut set = SortedSet.new();
        let mut ans = i32.MAX;
        for i in x..nums.len() {
            set.insert(nums[i - x]);
            let v = nums[i];
            if let Some(hi) = set.range_inclusive(v, i32.MAX).next().cloned() {
                ans = ans.min(hi - v);
            }
            if let Some(lo) = set.range_inclusive(i32.MIN, v).next_back().cloned() {
                ans = ans.min(v - lo);
            }
        }
        ans
    }
}

fn solution_min_absolute_difference(nums: Vec[i64], x: i64) -> i64 {
    Solution.min_absolute_difference(nums.iter().map(|v| v as i32).collect(), x as i32)
}



// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64], x: i64) -> i64 {
    let n = nums.len();
    let mut best = i64.MAX;
    for i in 0..n {
        for j in 0..n {
            if (i - j).abs() >= x {
                best = best.min((nums[i] - nums[j]).abs());
            }
        }
    }
    best
}

fn answer(arm: i64, nums: Vec[i64], x: i64) -> i64 {
    match arm {
        0 => star_min_absolute_difference(nums, x),
        1 => map_min_absolute_difference(nums, x),
        2 => sorted_min_absolute_difference(nums, x),
        3 => pairs_min_absolute_difference(nums, x),
        _ => solution_min_absolute_difference(nums, x),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "map", "sorted", "pairs", "solution"];
    let mut seed = 2817;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for c in 0..2050 {
        if c < 2000 {
            let n = next_random(mut seed) % 10 + 1;
            let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 20 + 1).collect();
            cases.push((nums, next_random(mut seed) % n));
        } else {
            let n = next_random(mut seed) % 600 + 1;
            let nums: Vec[i64] = (0..n).map(|_| wide(mut seed) % 1000000000 + 1).collect();
            cases.push((nums, next_random(mut seed) % n));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (nums, x)) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(nums, x) } else { 0 };
        check = (check * 31 + want + 2) % 1000000007;
        let n = nums.len();
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let turned: Vec[i64] = nums.iter().map(|v| 1000000001 - v).collect();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums, x)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let witnessed = (0..n).any(|i| (i + x..n).any(|j| (nums[i] - nums[j]).abs() == value));
            let looser = if x > 0 { answer(arm, nums, x - 1) <= value } else { value == 0 };
            let verdicts = [
                not small or value == want,
                value >= 0 and witnessed,
                answer(arm, reversed, x) == value,
                answer(arm, turned, x) == value,
                looser,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums} x {x}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
