// LeetCode #2817: Minimum Absolute Difference Between Elements With
// Constraint -- the bench: the ★ arm over 10 arrays of 10^5 distinct
// numbers up to 10^9, LeetCode's most, shuffled, x from 0 to 10^5 - 1,
// all drawn first, then each answered 3 times. The numbers are distinct
// so no answer stops early at 0.

fn min_absolute_difference(nums: Vec[i64], x: i64) -> i64 {
    let mut behind: SortedSet[i64] = SortedSet.new();
    let mut best = i64.MAX;
    for i in x..nums.len() {
        behind.insert(nums[i - x]);
        let v = nums[i];
        if let Some(up) = behind.range(v, i64.MAX).next() {
            best = best.min(up - v);
        }
        if let Some(down) = behind.range_inclusive(i64.MIN, v).next_back() {
            best = best.min(v - down);
        }
        if best == 0 {
            break;
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 10;
    let rounds = 3;
    let n = 100000;
    let mut seed = 2817;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for _ in 0..count {
        let mut nums: Vec[i64] = (0..n).map(|i| i * 10000 + wide(mut seed) % 10000 + 1).collect();
        for i in (1..n).rev() {
            let j = wide(mut seed) % (i + 1);
            nums.swap(i, j);
        }
        cases.push((nums, wide(mut seed) % n));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, x) in cases.iter() {
            let a = min_absolute_difference(nums, x);
            total += a;
            check = (check * 31 + a + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {n}, {rounds} rounds: differences sum to {total}, checksum {check}");
}
