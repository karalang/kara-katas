// LeetCode #2897: Apply Operations on Array to Maximize Sum of Squares
// -- a Rust solution as LeetCode's Rust users write it: `let mut cnt =
// [0; 31]` filled bit by bit, then k values assembled from it, `x * x %
// MOD` in `i64`, `const MOD: i64` inside the function.

struct Solution {}

impl Solution {
    pub fn max_sum(nums: Vec[i32], k: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let mut cnt = [0; 31];
        for x in ref nums {
            for i in 0..31 {
                if (x >> i) & 1 == 1 {
                    cnt[i] += 1;
                }
            }
        }
        let mut ans: i64 = 0;
        for _ in 0..k {
            let mut x: i64 = 0;
            for i in 0..31 {
                if cnt[i] > 0 {
                    cnt[i] -= 1;
                    x |= 1 << i;
                }
            }
            ans = (ans + x * x % MOD) % MOD;
        }
        ans as i32
    }
}

fn max_sum(nums: Vec[i64], k: i64) -> i64 {
    Solution.max_sum(nums.iter().map(|x| x as i32).collect(), k as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; 10^5 values, LeetCode's most: all 10^9
    // with k 10^5, the powers of two in turn with k 1 and k 30, and 1 to
    // 10^5 with k 10^5
    println(f"{max_sum([2, 6, 5, 8], 2)} {max_sum([4, 5, 4, 7], 3)}");
    let n = 100000;
    let powers: Vec[i64] = (0..n).map(|i| 1 << (i % 30)).collect();
    println(f"{max_sum(Vec.filled(n, 1000000000), n)} {max_sum(powers, 1)} {max_sum(powers, 30)} {max_sum((1..n + 1).collect(), n)}");
    // 3000 random arrays of 1 to 8 values from 1 to 15, k from 1 to n;
    // then 100 of 1000 to 10^5 values up to 10^9, every other one with
    // only a few bits set in each
    let mut seed = 2897;
    let mut total = 0;
    let mut check = 0;
    for c in 0..3100 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 8 + 1 } else { wide(mut seed) % 99001 + 1000 };
        let nums: Vec[i64] = (0..n).map(|_| if small { next_random(mut seed) % 15 + 1 } else if c % 2 == 1 { (1 << (next_random(mut seed) % 30)) | (1 << (next_random(mut seed) % 30)) } else { wide(mut seed) % 1000000000 + 1 }).collect();
        let k = wide(mut seed) % n + 1;
        let best = max_sum(nums, k);
        total += best;
        check = (check * 31 + best) % 1000000007;
        if c == 2999 {
            println(f"3000 small arrays: sums total {total}, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"100 large arrays: sums total {total}, checksum {check}");
}
