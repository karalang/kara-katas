// LeetCode #2813: Maximum Elegance of a K-Length Subsequence -- the
// differential. The five arms, against the statement read literally:
// every choice of k of the items, as a bit mask, scored as its total
// profit plus the square of how many categories it holds, counted with a
// `Set`; no sort, no swap and no heads. 2000 random cases of 1 to 8
// items with profits up to 10 and categories up to the count; then 50
// of up to 1000 items with profits up to 10^9. Every case is drawn
// before any arm answers; the literal reading is asked only of the first
// 2000.
//
// P1  up to 8 items, the answer is the literal reading's
// P2  at least the k dearest profits plus 1, at most them plus k squared
// P3  the items in reverse: the same answer
// P4  every profit 1000 more: the answer 1000 k more
// P5  k the whole count: every profit plus the categories squared
// P6  each arm agrees with at least three of the other four


// ---- star (elegance.kara) -------------------------------------------

fn star_find_maximum_elegance(items: Vec[Vec[i64]], k: i64) -> i64 {
    let mut order = items.clone();
    order.sort_by(|a, b| b[0].cmp(a[0]));
    let mut seen: Set[i64] = Set.new();
    let mut repeats: Vec[i64] = Vec.new();
    let mut total = 0;
    for item in order[0..k].iter() {
        total += item[0];
        if not seen.insert(item[1]) {
            repeats.push(item[0]);
        }
    }
    let mut best = total + seen.len() * seen.len();
    for item in order[k..order.len()].iter() {
        if repeats.is_empty() {
            break;
        }
        if seen.insert(item[1]) {
            total += item[0] - repeats.pop().unwrap();
            best = best.max(total + seen.len() * seen.len());
        }
    }
    best
}


// ---- heap (elegance_heap.kara) --------------------------------------

fn heap_find_maximum_elegance(items: Vec[Vec[i64]], k: i64) -> i64 {
    let n = items.len();
    let mut order = items.clone();
    order.sort_by_key(|item| -item[0]);
    let mut taken: Vec[bool] = Vec.filled(n + 1, false);
    let mut distinct = 0;
    let mut repeats: PriorityQueue[i64] = PriorityQueue.new();
    let mut total = 0;
    for i in 0..k {
        total += order[i][0];
        if taken[order[i][1]] {
            repeats.push(order[i][0]);
        } else {
            taken[order[i][1]] = true;
            distinct += 1;
        }
    }
    let mut best = total + distinct * distinct;
    for i in k..n {
        if taken[order[i][1]] {
            continue;
        }
        if let Some(cheapest) = repeats.pop() {
            taken[order[i][1]] = true;
            distinct += 1;
            total += order[i][0] - cheapest;
            best = best.max(total + distinct * distinct);
        } else {
            break;
        }
    }
    best
}


// ---- counts (elegance_counts.kara) ----------------------------------

fn counts_find_maximum_elegance(items: Vec[Vec[i64]], k: i64) -> i64 {
    let mut best_of: Map[i64, i64] = Map.new();
    for item in items.iter() {
        let held = best_of.entry(item[1]).or_insert(0);
        if item[0] > *held {
            *held = item[0];
        }
    }
    let mut heads: Vec[i64] = best_of.values().collect();
    let mut tails: Vec[i64] = Vec.new();
    let mut used: Set[i64] = Set.new();
    for item in items.iter() {
        if item[0] == best_of[item[1]] and used.insert(item[1]) {
            continue;
        }
        tails.push(item[0]);
    }
    heads.sort();
    heads.reverse();
    tails.sort();
    tails.reverse();
    let mut head_sum: Vec[i64] = [0];
    for h in heads.iter() {
        head_sum.push(head_sum[head_sum.len() - 1] + h);
    }
    let mut tail_sum: Vec[i64] = [0];
    for t in tails.iter() {
        tail_sum.push(tail_sum[tail_sum.len() - 1] + t);
    }
    let mut best = 0;
    for d in 1..=k.min(heads.len()) {
        if k - d <= tails.len() {
            best = best.max(head_sum[d] + tail_sum[k - d] + d * d);
        }
    }
    best
}


// ---- prefix (elegance_prefix.kara) ----------------------------------

fn prefix_find_maximum_elegance(items: Vec[Vec[i64]], k: i64) -> i64 {
    let mut order: Vec[(i64, i64)] = items.iter().map(|item| (item[0], item[1])).collect();
    order.sort();
    order.reverse();
    let mut seen: Set[i64] = Set.new();
    let mut repeats: Vec[i64] = Vec.new();
    let mut base = 0;
    for i in 0..k {
        let (profit, category) = order[i];
        base += profit;
        if seen.contains(category) {
            repeats.push(profit);
        } else {
            seen.insert(category);
        }
    }
    let mut newcomers: Vec[i64] = Vec.new();
    for i in k..order.len() {
        let (profit, category) = order[i];
        if not seen.contains(category) {
            seen.insert(category);
            newcomers.push(profit);
        }
    }
    let distinct = k - repeats.len();
    let mut best = base + distinct * distinct;
    let mut total = base;
    let swaps = repeats.len().min(newcomers.len());
    for j in 0..swaps {
        total += newcomers[j] - repeats[repeats.len() - 1 - j];
        let d = distinct + j + 1;
        best = best.max(total + d * d);
    }
    best
}


// ---- solution (elegance_solution.kara) ------------------------------

struct Solution {}

impl Solution {
    pub fn find_maximum_elegance(items: own Vec[Vec[i32]], k: i32) -> i64 {
        let mut items = items;
        items.sort_by(|a, b| b[0].cmp(a[0]));
        let k = k as i64;
        let mut seen = Set.new();
        let mut dup: Vec[i64] = Vec.new();
        let mut total: i64 = 0;
        for i in 0..k {
            total += items[i][0];
            if not seen.insert(items[i][1]) {
                dup.push(items[i][0]);
            }
        }
        let mut ans = total + (seen.len() * seen.len());
        for i in k..items.len() {
            if dup.is_empty() {
                break;
            }
            if seen.insert(items[i][1]) {
                total += items[i][0] - dup.pop().unwrap();
                ans = ans.max(total + (seen.len() * seen.len()));
            }
        }
        ans
    }
}

fn solution_find_maximum_elegance(items: Vec[Vec[i64]], k: i64) -> i64 {
    let items: Vec[Vec[i32]] = items.iter().map(|it| it.iter().map(|v| v as i32).collect()).collect();
    Solution.find_maximum_elegance(items, k as i32)
}



// ---- the statement read literally ------------------------------------------

fn literal(items: Vec[Vec[i64]], k: i64) -> i64 {
    let n = items.len();
    let mut best = 0;
    for mask in 0..(1 << n) {
        let chosen: Vec[i64] = (0..n).filter(|i| (mask >> i) & 1 == 1).collect();
        if chosen.len() != k {
            continue;
        }
        let profit: i64 = chosen.iter().map(|i| items[i][0]).sum();
        let kinds: Set[i64] = chosen.iter().map(|i| items[i][1]).collect();
        best = best.max(profit + kinds.len() * kinds.len());
    }
    best
}

fn answer(arm: i64, items: Vec[Vec[i64]], k: i64) -> i64 {
    match arm {
        0 => star_find_maximum_elegance(items, k),
        1 => heap_find_maximum_elegance(items, k),
        2 => counts_find_maximum_elegance(items, k),
        3 => prefix_find_maximum_elegance(items, k),
        _ => solution_find_maximum_elegance(items, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn random_items(n: i64, top: i64, kinds: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut items: Vec[Vec[i64]] = Vec.new();
    for _ in 0..n {
        let profit = wide(mut seed) % top + 1;
        let category = wide(mut seed) % kinds + 1;
        items.push([profit, category]);
    }
    items
}

fn main() {
    let names = ["star", "heap", "counts", "prefix", "solution"];
    let mut seed = 2813;
    let mut cases: Vec[(Vec[Vec[i64]], i64)] = Vec.new();
    for c in 0..2050 {
        if c < 2000 {
            let n = next_random(mut seed) % 8 + 1;
            let items = random_items(n, 10, n, mut seed);
            cases.push((items, next_random(mut seed) % n + 1));
        } else {
            let n = wide(mut seed) % 1000 + 1;
            let items = random_items(n, 1000000000, n, mut seed);
            cases.push((items, wide(mut seed) % n + 1));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (items, k)) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(items, k) } else { 0 };
        check = (check * 31 + want % 1000000007 + 2) % 1000000007;
        let n = items.len();
        let mut profits: Vec[i64] = items.iter().map(|item| item[0]).collect();
        profits.sort();
        let dearest: i64 = profits[n - k..n].iter().sum();
        let everything: i64 = profits.iter().sum();
        let kinds: Set[i64] = items.iter().map(|item| item[1]).collect();
        let reversed: Vec[Vec[i64]] = items.iter().rev().cloned().collect();
        let raised: Vec[Vec[i64]] = items.iter().map(|item| [item[0] + 1000, item[1]]).collect();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, items, k)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == want,
                value >= dearest + 1 and value <= dearest + k * k,
                answer(arm, reversed, k) == value,
                answer(arm, raised, k) == value + 1000 * k,
                answer(arm, items, n) == everything + kinds.len() * kinds.len(),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {items} k {k}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
