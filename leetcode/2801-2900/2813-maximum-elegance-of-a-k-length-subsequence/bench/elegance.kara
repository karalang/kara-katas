// LeetCode #2813: Maximum Elegance of a K-Length Subsequence -- the
// bench: the ★ arm over 10 cases of 10^5 items, LeetCode's most, profits
// up to 10^9 and categories up to 30000, k from 1 to 10^5, all drawn
// first, then each answered 5 times.

fn find_maximum_elegance(items: Vec[Vec[i64]], k: i64) -> i64 {
    let mut order = items.clone();
    order.sort_by(|a, b| b[0].cmp(a[0]));
    let mut seen: Set[i64] = Set.new();
    let mut repeats: Vec[i64] = Vec.new();
    let mut total = 0;
    for item in order[0..k].iter() {
        total += item[0];
        if not seen.insert(item[1]) {
            repeats.push(item[0]);
        }
    }
    let mut best = total + seen.len() * seen.len();
    for item in order[k..order.len()].iter() {
        if repeats.is_empty() {
            break;
        }
        if seen.insert(item[1]) {
            total += item[0] - repeats.pop().unwrap();
            best = best.max(total + seen.len() * seen.len());
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 10;
    let rounds = 5;
    let n = 100000;
    let mut seed = 2813;
    let mut cases: Vec[(Vec[Vec[i64]], i64)] = Vec.new();
    for _ in 0..count {
        let mut items: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            let profit = wide(mut seed) % 1000000000 + 1;
            let category = wide(mut seed) % 30000 + 1;
            items.push([profit, category]);
        }
        cases.push((items, wide(mut seed) % n + 1));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (items, k) in cases.iter() {
            let a = find_maximum_elegance(items, k);
            total += a;
            check = (check * 31 + a % 1000000007 + r) % 1000000007;
        }
    }
    println(f"{count} cases of {n}, {rounds} rounds: elegance sums to {total}, checksum {check}");
}
