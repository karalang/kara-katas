// LeetCode #2895: Minimum Processing Time -- the differential. The five
// arms, against the statement read literally: every way to hand each
// task to a core, four to a processor, searched, and the earliest time
// all are done kept. 2000 random cases of 1 or 2 processors, times 0 to
// 9 and tasks 1 to 9, then 50 of up to 750 processors, times and tasks
// up to 10^9, all drawn before any arm answers; the literal reading is
// asked only of the first 2000.
//
// P1  up to 2 processors, the answer is the literal reading's
// P2  every time and every task one more: two more
// P3  both lists reversed: the same answer
// P4  from the latest processor plus the shortest task, and the first
//     plus the longest, to the latest plus the longest
// P5  a processor free at 0 with four tasks of 1 added: no later
// P6  each arm agrees with at least three of the other four

fn assign(t: i64, processor_time: Vec[i64], tasks: Vec[i64], room: mut ref Vec[i64], finish: i64) -> i64 {
    if t == tasks.len() {
        return finish;
    }
    let mut best = -1;
    for p in 0..processor_time.len() {
        if room[p] > 0 {
            room[p] -= 1;
            let done = assign(t + 1, processor_time, tasks, mut room, finish.max(processor_time[p] + tasks[t]));
            room[p] += 1;
            if best < 0 or done < best {
                best = done;
            }
        }
    }
    best
}

fn literal(processor_time: Vec[i64], tasks: Vec[i64]) -> i64 {
    let mut room: Vec[i64] = Vec.filled(processor_time.len(), 4);
    assign(0, processor_time, tasks, mut room, 0)
}


// ---- star (processing.kara) -----------------------------------------

fn star_min_processing_time(processor_time: Vec[i64], tasks: Vec[i64]) -> i64 {
    let mut free = processor_time.clone();
    free.sort();
    let mut longest = tasks.clone();
    longest.sort();
    longest.reverse();
    let mut finish = 0;
    for (i, p) in free.iter().enumerate() {
        finish = finish.max(p + longest[4 * i]);
    }
    finish
}


// ---- queue (processing_queue.kara) ----------------------------------

fn queue_min_processing_time(processor_time: Vec[i64], tasks: Vec[i64]) -> i64 {
    let mut cores: PriorityQueue[i64] = PriorityQueue.new();
    for p in processor_time.iter() {
        for _ in 0..4 {
            cores.push(p);
        }
    }
    let mut longest = tasks.clone();
    longest.sort();
    let mut finish = 0;
    for t in longest.iter().rev() {
        let free = cores.pop().unwrap();
        finish = finish.max(free + t);
    }
    finish
}


// ---- search (processing_search.kara) --------------------------------

fn search_fits(free: Vec[i64], shortest: Vec[i64], deadline: i64) -> bool {
    let n = free.len();
    (0..n).all(|i| free[n - 1 - i] + shortest[4 * i + 3] <= deadline)
}

fn search_min_processing_time(processor_time: Vec[i64], tasks: Vec[i64]) -> i64 {
    let mut free = processor_time.clone();
    free.sort();
    let mut shortest = tasks.clone();
    shortest.sort();
    let mut low = 0;
    let mut high = free[free.len() - 1] + shortest[shortest.len() - 1];
    while low < high {
        let middle = (low + high) / 2;
        if search_fits(free, shortest, middle) {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    low
}


// ---- chunks (processing_chunks.kara) --------------------------------

fn chunks_min_processing_time(processor_time: Vec[i64], tasks: Vec[i64]) -> i64 {
    let mut free = processor_time.clone();
    free.sort();
    let mut shortest = tasks.clone();
    shortest.sort();
    free.iter().rev().zip(shortest.chunks(4).iter()).map(|(p, four)| p + four[3]).max().unwrap()
}


// ---- solution (processing_solution.kara) ----------------------------

struct Solution {}

impl Solution {
    pub fn min_processing_time(processor_time: own Vec[i32], tasks: own Vec[i32]) -> i32 {
        let mut processor_time = processor_time;
        let mut tasks = tasks;
        processor_time.sort();
        tasks.sort_by(|a, b| b.cmp(a));
        let mut ans: i32 = 0;
        for (i, p) in processor_time.iter().enumerate() {
            ans = ans.max(p + tasks[i * 4]);
        }
        ans
    }
}

fn solution_min_processing_time(processor_time: Vec[i64], tasks: Vec[i64]) -> i64 {
    Solution.min_processing_time(processor_time.iter().map(|x| x as i32).collect(), tasks.iter().map(|x| x as i32).collect())
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, processor_time: Vec[i64], tasks: Vec[i64]) -> i64 {
    match arm {
        0 => star_min_processing_time(processor_time, tasks),
        1 => queue_min_processing_time(processor_time, tasks),
        2 => search_min_processing_time(processor_time, tasks),
        3 => chunks_min_processing_time(processor_time, tasks),
        _ => solution_min_processing_time(processor_time, tasks),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "queue", "search", "chunks", "solution"];
    let mut seed = 2895;
    let mut cases: Vec[(Vec[i64], Vec[i64])] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 2 + 1 } else { wide(mut seed) % 750 + 1 };
        let processors: Vec[i64] = (0..n).map(|_| if small { next_random(mut seed) % 10 } else { wide(mut seed) % 1000000000 }).collect();
        let tasks: Vec[i64] = (0..4 * n).map(|_| if small { next_random(mut seed) % 9 + 1 } else { wide(mut seed) % 1000000000 + 1 }).collect();
        cases.push((processors, tasks));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, (processors, tasks)) in cases.iter().enumerate() {
        let n = processors.len();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, processors, tasks)).collect();
        let want = if c < 2000 { literal(processors, tasks) } else { got[0] };
        total += want;
        check = (check * 31 + want) % 1000000007;
        let later: Vec[i64] = processors.iter().map(|p| p + 1).collect();
        let longer: Vec[i64] = tasks.iter().map(|t| t + 1).collect();
        let processors_back: Vec[i64] = processors.iter().rev().cloned().collect();
        let tasks_back: Vec[i64] = tasks.iter().rev().cloned().collect();
        let mut more_processors = processors.clone();
        more_processors.push(0);
        let mut more_tasks = tasks.clone();
        more_tasks.extend([1, 1, 1, 1].iter().cloned());
        let first = processors.iter().min().unwrap();
        let last = processors.iter().max().unwrap();
        let shortest = tasks.iter().min().unwrap();
        let longest = tasks.iter().max().unwrap();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                c >= 2000 or value == want,
                answer(arm, later, longer) == value + 2,
                answer(arm, processors_back, tasks_back) == value,
                value >= last + shortest and value >= first + longest and value <= last + longest,
                answer(arm, more_processors, more_tasks) <= value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} n {n}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, times total {total}: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
