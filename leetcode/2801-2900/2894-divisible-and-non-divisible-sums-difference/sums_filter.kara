// LeetCode #2894: Divisible and Non-divisible Sums Difference -- two
// iterator chains: the non-multiples by `filter`, the multiples by
// `step_by(m)` from m.

fn difference_of_sums(n: i64, m: i64) -> i64 {
    let num1: i64 = (1..n + 1).filter(|i| i % m != 0).sum();
    let num2: i64 = (m..n + 1).step_by(m).sum();
    num1 - num2
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's three examples; 1000 and 1000, LeetCode's most; then
    // every n and m from 1 to 200
    println(f"{difference_of_sums(10, 3)} {difference_of_sums(5, 6)} {difference_of_sums(5, 1)} {difference_of_sums(1000, 1000)}");
    let mut total = 0;
    let mut check = 0;
    for n in 1..201 {
        for m in 1..201 {
            let d = difference_of_sums(n, m);
            total += d;
            check = ((check * 31 + d) % 1000000007 + 1000000007) % 1000000007;
        }
    }
    println(f"40000 pairs: differences total {total}, checksum {check}");
}
