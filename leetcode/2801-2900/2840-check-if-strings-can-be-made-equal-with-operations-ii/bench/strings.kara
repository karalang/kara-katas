// LeetCode #2840: Check if Strings Can be Made Equal With Operations II
// -- the bench: the ★ arm over 200 pairs of 10^5 letters, the second
// the first shuffled within its parities and, for half of them, one
// letter changed, all drawn first, then each answered 20 times.

fn check_strings(s1: Str, s2: Str) -> bool {
    let mut count: Vec[i64] = Vec.filled(52, 0);
    for (i, (a, b)) in s1.bytes().iter().zip(s2.bytes().iter()).enumerate() {
        let side = i % 2 * 26;
        count[side + (a - b'a')] += 1;
        count[side + (b - b'a')] -= 1;
    }
    count.iter().all(|n| n == 0)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 200;
    let n = 100000;
    let rounds = 20;
    let mut seed = 2840;
    let mut pairs: Vec[(String, String)] = Vec.new();
    for c in 0..count {
        let a: Vec[u8] = (0..n).map(|_| (97 + next_random(mut seed) % 26) as u8).collect();
        let mut b = a.clone();
        for i in (2..n).rev() {
            let j = i % 2 + 2 * (next_random(mut seed) % (i / 2 + 1));
            if j <= i {
                b.swap(i, j);
            }
        }
        if c % 2 == 1 {
            b[next_random(mut seed) % n] = (97 + next_random(mut seed) % 26) as u8;
        }
        pairs.push((String.from_utf8(a).unwrap(), String.from_utf8(b).unwrap()));
    }
    let mut yes = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (s1, s2) in pairs.iter() {
            let same = check_strings(s1, s2);
            if same {
                yes += 1;
            }
            check = (check * 31 + if same { 2 } else { 1 } + r) % 1000000007;
        }
    }
    println(f"{count} pairs of {n}, {rounds} rounds: {yes} true, checksum {check}");
}
