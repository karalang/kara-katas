// LeetCode #2835: Minimum Operations to Form Subsequence With Target Sum
// -- the bench: the ★ arm over 2000 arrays of 1000 powers, LeetCode's
// most, from 2^16 to 2^30, so a target below 2^31 has low bits to split
// for, all drawn first, then each answered 200 times.

fn min_operations(nums: Vec[i64], target: i64) -> i64 {
    if nums.iter().sum() < target {
        return -1;
    }
    let mut count: Vec[i64] = Vec.filled(32, 0);
    for x in nums.iter() {
        count[x.trailing_zeros()] += 1;
    }
    let mut ops = 0;
    for i in 0..31 {
        if (target >> i) & 1 == 1 {
            if count[i] > 0 {
                count[i] -= 1;
            } else {
                let mut j = i + 1;
                while count[j] == 0 {
                    j += 1;
                }
                ops += j - i;
                count[j] -= 1;
                for k in i..j {
                    count[k] += 1;
                }
            }
        }
        count[i + 1] += count[i] / 2;
    }
    ops
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 2000;
    let rounds = 200;
    let n = 1000;
    let mut seed = 2835;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for _ in 0..count {
        let nums: Vec[i64] = (0..n).map(|_| 1 << (next_random(mut seed) % 15 + 16)).collect();
        let target = (next_random(mut seed) * 32768 + next_random(mut seed)) % 2147483647 + 1;
        cases.push((nums, target));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, target) in cases.iter() {
            let ops = min_operations(nums, target);
            total += ops;
            check = (check * 31 + ops + 1 + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {n}, {rounds} rounds: operations total {total}, checksum {check}");
}
