// LeetCode #2829: Determine the Minimum Sum of a k-avoiding Array --
// closed form: the greedy takes 1 up to m = min(n, k / 2), the smaller
// of each pair, then k and on for the n - m left; two arithmetic series.

fn series(from: i64, count: i64) -> i64 {
    count * (2 * from + count - 1) / 2
}

fn minimum_sum(n: i64, k: i64) -> i64 {
    let m = n.min(k / 2);
    series(1, m) + series(k, n - m)
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; n = 1; k = 1, which avoids nothing; and
    // n and k both 50
    println(f"{minimum_sum(5, 4)}");
    println(f"{minimum_sum(2, 6)}");
    println(f"{minimum_sum(1, 50)}");
    println(f"{minimum_sum(50, 1)}");
    println(f"{minimum_sum(50, 50)}");
    // every n and k from 1 to 50
    let mut total = 0;
    let mut check = 0;
    for n in 1..=50 {
        for k in 1..=50 {
            let a = minimum_sum(n, k);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
    }
    println(f"2500 pairs: sums total {total}, checksum {check}");
}
