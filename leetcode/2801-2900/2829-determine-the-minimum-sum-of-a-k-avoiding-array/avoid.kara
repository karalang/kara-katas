// LeetCode #2829: Determine the Minimum Sum of a k-avoiding Array -- ★:
// the numbers walked up from 1, each taken unless its partner k - v was
// taken before it, marked in a `Vec[bool]`; the smaller of each pair
// always comes first, so the greedy keeps the least sum.

fn minimum_sum(n: i64, k: i64) -> i64 {
    let mut taken: Vec[bool] = Vec.filled(n + k + 1, false);
    let mut count = 0;
    let mut sum = 0;
    let mut v = 1;
    while count < n {
        if v >= k or not taken[k - v] {
            taken[v] = true;
            count += 1;
            sum += v;
        }
        v += 1;
    }
    sum
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; n = 1; k = 1, which avoids nothing; and
    // n and k both 50
    println(f"{minimum_sum(5, 4)}");
    println(f"{minimum_sum(2, 6)}");
    println(f"{minimum_sum(1, 50)}");
    println(f"{minimum_sum(50, 1)}");
    println(f"{minimum_sum(50, 50)}");
    // every n and k from 1 to 50
    let mut total = 0;
    let mut check = 0;
    for n in 1..=50 {
        for k in 1..=50 {
            let a = minimum_sum(n, k);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
    }
    println(f"2500 pairs: sums total {total}, checksum {check}");
}
