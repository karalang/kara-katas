// LeetCode #2829: Determine the Minimum Sum of a k-avoiding Array -- the
// bench: the ★ arm over every n and k from 1 to 50, LeetCode's whole
// range, each pair answered 2000 times.

fn minimum_sum(n: i64, k: i64) -> i64 {
    let mut taken: Vec[bool] = Vec.filled(n + k + 1, false);
    let mut count = 0;
    let mut sum = 0;
    let mut v = 1;
    while count < n {
        if v >= k or not taken[k - v] {
            taken[v] = true;
            count += 1;
            sum += v;
        }
        v += 1;
    }
    sum
}

fn main() {
    let rounds = 2000;
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for n in 1..=50 {
            for k in 1..=50 {
                let a = minimum_sum(n, k);
                total += a;
                check = (check * 31 + a + r) % 1000000007;
            }
        }
    }
    println(f"2500 pairs, {rounds} rounds: sums total {total}, checksum {check}");
}
