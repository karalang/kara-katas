// LeetCode #2829: Determine the Minimum Sum of a k-avoiding Array -- a
// Rust solution as LeetCode's Rust users write it, carried to Kāra by
// `karac fix`: a `HashSet<i32>` of the numbers taken, `i` counting up
// in a `while`, `contains(&(k - i))`, and the set summed by
// `iter().sum()`.

struct Solution {}

impl Solution {
    pub fn minimum_sum(n: i32, k: i32) -> i32 {
        let mut set = Set.new();
        let mut i: i32 = 1;
        while set.len() < n {
            if not set.contains(k - i) {
                set.insert(i);
            }
            i += 1;
        }
        set.iter().sum()
    }
}

fn minimum_sum(n: i64, k: i64) -> i64 {
    Solution.minimum_sum(n as i32, k as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; n = 1; k = 1, which avoids nothing; and
    // n and k both 50
    println(f"{minimum_sum(5, 4)}");
    println(f"{minimum_sum(2, 6)}");
    println(f"{minimum_sum(1, 50)}");
    println(f"{minimum_sum(50, 1)}");
    println(f"{minimum_sum(50, 50)}");
    // every n and k from 1 to 50
    let mut total = 0;
    let mut check = 0;
    for n in 1..=50 {
        for k in 1..=50 {
            let a = minimum_sum(n, k);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
    }
    println(f"2500 pairs: sums total {total}, checksum {check}");
}
