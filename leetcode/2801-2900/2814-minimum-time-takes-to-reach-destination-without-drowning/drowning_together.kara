// LeetCode #2814: Minimum Time Takes to Reach Destination Without
// Drowning -- the flood and the walk a second at a time, together: two
// frontiers of cells, the water's grown first each second, then the
// walker's onto neighbours that are neither stone, nor wet now, nor seen
// before, until the destination is among them or the walker has nowhere
// new to go.

fn minimum_seconds(land: Vec[Vec[String]]) -> i64 {
    let (n, m) = (land.len(), land[0].len());
    let mut wet: Vec[Vec[bool]] = Vec.filled(n, Vec.filled(m, false));
    let mut seen: Vec[Vec[bool]] = Vec.filled(n, Vec.filled(m, false));
    let mut water: Vec[(i64, i64)] = Vec.new();
    let mut walker: Vec[(i64, i64)] = Vec.new();
    for r in 0..n {
        for c in 0..m {
            if land[r][c] == "*" {
                wet[r][c] = true;
                water.push((r, c));
            } else if land[r][c] == "S" {
                seen[r][c] = true;
                walker.push((r, c));
            }
        }
    }
    let steps = [(0, 1), (1, 0), (0, -1), (-1, 0)];
    let mut second = 0;
    while not walker.is_empty() {
        second += 1;
        let mut next_water: Vec[(i64, i64)] = Vec.new();
        for (r, c) in water.iter() {
            for (dr, dc) in steps.iter() {
                let (nr, nc) = (r + dr, c + dc);
                if nr >= 0 and nr < n and nc >= 0 and nc < m and not wet[nr][nc]
                    and (land[nr][nc] == "." or land[nr][nc] == "S")
                {
                    wet[nr][nc] = true;
                    next_water.push((nr, nc));
                }
            }
        }
        water = next_water;
        let mut next_walker: Vec[(i64, i64)] = Vec.new();
        for (r, c) in walker.iter() {
            for (dr, dc) in steps.iter() {
                let (nr, nc) = (r + dr, c + dc);
                if nr >= 0 and nr < n and nc >= 0 and nc < m and not seen[nr][nc] and not wet[nr][nc]
                    and land[nr][nc] != "X"
                {
                    if land[nr][nc] == "D" {
                        return second;
                    }
                    seen[nr][nc] = true;
                    next_walker.push((nr, nc));
                }
            }
        }
        walker = next_walker;
    }
    -1
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// an n by m land, about one cell in five stone and `flooded` in a
// thousand flooded, with "S" and "D" on two different cells
fn random_land(n: i64, m: i64, flooded: i64, seed: mut ref i64) -> Vec[Vec[String]] {
    let mut land: Vec[Vec[String]] = Vec.new();
    for _ in 0..n {
        let mut row: Vec[String] = Vec.new();
        for _ in 0..m {
            let roll = next_random(mut seed) % 1000;
            row.push(if roll < 200 { "X" } else if roll < 200 + flooded { "*" } else { "." });
        }
        land.push(row);
    }
    let start = next_random(mut seed) % (n * m);
    let mut end = next_random(mut seed) % (n * m - 1);
    if end >= start {
        end += 1;
    }
    land[start / m][start % m] = "S";
    land[end / m][end % m] = "D";
    land
}

fn main() {
    // LeetCode's three examples; 100 by 100 of open land, corner to
    // corner; the same with a flood beside the start
    println(f"{minimum_seconds([["D", ".", "*"], [".", ".", "."], [".", "S", "."]])}");
    println(f"{minimum_seconds([["D", "X", "*"], [".", ".", "."], [".", ".", "S"]])}");
    println(f"{minimum_seconds([["D", ".", ".", ".", "*", "."], [".", "X", ".", "X", ".", "."], [".", ".", ".", ".", "S", "."]])}");
    let mut open: Vec[Vec[String]] = Vec.filled(100, Vec.filled(100, "."));
    open[0][0] = "S";
    open[99][99] = "D";
    println(f"{minimum_seconds(open)}");
    open[0][2] = "*";
    println(f"{minimum_seconds(open)}");
    // 3000 random lands of 2 to 5 by 2 to 5, one cell in eight flooded;
    // then 50 of up to 60 by 60, one in 500
    let mut seed = 2814;
    let mut reached = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 4 + 2;
        let m = next_random(mut seed) % 4 + 2;
        let a = minimum_seconds(random_land(n, m, 125, mut seed));
        reached += if a >= 0 { 1 } else { 0 };
        check = (check * 31 + a + 2) % 1000000007;
    }
    println(f"3000 small lands: {reached} reached, checksum {check}");
    reached = 0;
    check = 0;
    for _ in 0..50 {
        let n = next_random(mut seed) % 59 + 2;
        let m = next_random(mut seed) % 59 + 2;
        let a = minimum_seconds(random_land(n, m, 2, mut seed));
        reached += if a >= 0 { 1 } else { 0 };
        check = (check * 31 + a + 2) % 1000000007;
    }
    println(f"50 large lands: {reached} reached, checksum {check}");
}
