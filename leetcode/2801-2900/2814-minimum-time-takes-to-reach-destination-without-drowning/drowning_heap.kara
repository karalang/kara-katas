// LeetCode #2814: Minimum Time Takes to Reach Destination Without
// Drowning -- on flat cells: the land read once into a `Vec` of kinds
// indexed by r * m + c, the flood's seconds by a breadth-first search over
// those indices, and the walk by Dijkstra's search, a `PriorityQueue` of
// (seconds, cell) handing out the soonest cell first.

fn minimum_seconds(land: Vec[Vec[String]]) -> i64 {
    let (n, m) = (land.len(), land[0].len());
    let kinds: Vec[char] = land.iter().flat_map(|row| row.iter().map(|s| s.chars().next().unwrap())).collect();
    let neighbours = |cell: i64| {
        let (r, c) = (cell / m, cell % m);
        let mut out: Vec[i64] = Vec.new();
        if r > 0 {
            out.push(cell - m);
        }
        if r + 1 < n {
            out.push(cell + m);
        }
        if c > 0 {
            out.push(cell - 1);
        }
        if c + 1 < m {
            out.push(cell + 1);
        }
        out
    };
    let mut flood: Vec[i64] = Vec.filled(n * m, i64.MAX);
    let mut queue: VecDeque[i64] = VecDeque.new();
    for cell in 0..n * m {
        if kinds[cell] == '*' {
            flood[cell] = 0;
            queue.push_back(cell);
        }
    }
    while let Some(cell) = queue.pop_front() {
        for next in neighbours(cell) {
            if flood[next] == i64.MAX and (kinds[next] == '.' or kinds[next] == 'S') {
                flood[next] = flood[cell] + 1;
                queue.push_back(next);
            }
        }
    }
    let start = kinds.iter().position(|k| k == 'S').unwrap();
    let mut best: Vec[i64] = Vec.filled(n * m, i64.MAX);
    let mut heap: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    best[start] = 0;
    heap.push((0, start));
    while let Some((seconds, cell)) = heap.pop() {
        if seconds > best[cell] {
            continue;
        }
        if kinds[cell] == 'D' {
            return seconds;
        }
        for next in neighbours(cell) {
            if kinds[next] != 'X' and flood[next] > seconds + 1 and seconds + 1 < best[next] {
                best[next] = seconds + 1;
                heap.push((seconds + 1, next));
            }
        }
    }
    -1
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// an n by m land, about one cell in five stone and `flooded` in a
// thousand flooded, with "S" and "D" on two different cells
fn random_land(n: i64, m: i64, flooded: i64, seed: mut ref i64) -> Vec[Vec[String]] {
    let mut land: Vec[Vec[String]] = Vec.new();
    for _ in 0..n {
        let mut row: Vec[String] = Vec.new();
        for _ in 0..m {
            let roll = next_random(mut seed) % 1000;
            row.push(if roll < 200 { "X" } else if roll < 200 + flooded { "*" } else { "." });
        }
        land.push(row);
    }
    let start = next_random(mut seed) % (n * m);
    let mut end = next_random(mut seed) % (n * m - 1);
    if end >= start {
        end += 1;
    }
    land[start / m][start % m] = "S";
    land[end / m][end % m] = "D";
    land
}

fn main() {
    // LeetCode's three examples; 100 by 100 of open land, corner to
    // corner; the same with a flood beside the start
    println(f"{minimum_seconds([["D", ".", "*"], [".", ".", "."], [".", "S", "."]])}");
    println(f"{minimum_seconds([["D", "X", "*"], [".", ".", "."], [".", ".", "S"]])}");
    println(f"{minimum_seconds([["D", ".", ".", ".", "*", "."], [".", "X", ".", "X", ".", "."], [".", ".", ".", ".", "S", "."]])}");
    let mut open: Vec[Vec[String]] = Vec.filled(100, Vec.filled(100, "."));
    open[0][0] = "S";
    open[99][99] = "D";
    println(f"{minimum_seconds(open)}");
    open[0][2] = "*";
    println(f"{minimum_seconds(open)}");
    // 3000 random lands of 2 to 5 by 2 to 5, one cell in eight flooded;
    // then 50 of up to 60 by 60, one in 500
    let mut seed = 2814;
    let mut reached = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 4 + 2;
        let m = next_random(mut seed) % 4 + 2;
        let a = minimum_seconds(random_land(n, m, 125, mut seed));
        reached += if a >= 0 { 1 } else { 0 };
        check = (check * 31 + a + 2) % 1000000007;
    }
    println(f"3000 small lands: {reached} reached, checksum {check}");
    reached = 0;
    check = 0;
    for _ in 0..50 {
        let n = next_random(mut seed) % 59 + 2;
        let m = next_random(mut seed) % 59 + 2;
        let a = minimum_seconds(random_land(n, m, 2, mut seed));
        reached += if a >= 0 { 1 } else { 0 };
        check = (check * 31 + a + 2) % 1000000007;
    }
    println(f"50 large lands: {reached} reached, checksum {check}");
}
