// LeetCode #2851: String Transformation -- every rotation of s made in
// turn with `rotate_right` on a `Vec[u8]` and compared with t whole,
// O(n^2) for the harness's sizes; the ways to land on each shift by the
// closed form, its two powers by `pow_mod`-style squaring over u64 and
// the division by n through Fermat's little theorem.

fn power(base: u64, exp: u64, m: u64) -> u64 {
    if exp == 0 {
        return 1;
    }
    let half = power(base, exp / 2, m);
    let sq = half * half % m;
    if exp % 2 == 1 { sq * (base % m) % m } else { sq }
}

fn number_of_ways(s: Str, t: Str, k: i64) -> i64 {
    let m: u64 = 1000000007;
    let n = s.len();
    let target: Vec[u8] = t.bytes().iter().collect();
    let mut turn: Vec[u8] = s.bytes().iter().collect();
    let mut hits: Vec[i64] = Vec.new();
    for r in 0..n {
        if turn == target {
            hits.push(r);
        }
        turn.rotate_right(1);
    }
    let size = n as u64;
    let all = power(size - 1, k as u64, m);
    let inverse = power(size, m - 2, m);
    let even = k % 2 == 0;
    let zero_ways = if even { (all + size - 1) % m } else { (all + m - (size - 1)) % m } * inverse % m;
    let other_ways = if even { (all + m - 1) % m } else { (all + 1) % m } * inverse % m;
    let total = hits.iter().fold(0, |acc, r| (acc + if r == 0 { zero_ways } else { other_ways }) % m);
    total as i64
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn rotated(s: Str, r: i64) -> String {
    let n = s.len();
    f"{s.substring(n - r, n)}{s.substring(0, n - r)}"
}

fn main() {
    // LeetCode's two examples; two letters swapped 10^15 times, LeetCode's
    // most, an even count, and one more; 2000 of one letter, any rotation
    // a match, 10^15 times
    println(f"{number_of_ways("abcd", "cdab", 2)} {number_of_ways("ababab", "ababab", 1)}");
    println(f"{number_of_ways("ab", "ab", 1000000000000000)} {number_of_ways("ab", "ba", 1000000000000001)} {number_of_ways("ab", "ba", 1000000000000000)}");
    let same = "a".repeat(2000);
    println(f"{number_of_ways(same, same, 1000000000000000)}");
    // 3000 random pairs of 2 to 6 letters over a and b with k up to 20,
    // then 60 of up to 2000 letters, each a block of up to 8 repeated, t
    // a rotation of s two times in three, k up to 10^15
    let mut seed = 2851;
    let mut check = 0;
    let mut matched = 0;
    for c in 0..3060 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 5 + 2 } else { next_random(mut seed) % 1999 + 2 };
        let block = if small { n } else { next_random(mut seed) % 8 + 1 };
        let letters = if small { 2 } else { next_random(mut seed) % 3 + 1 };
        let unit: String = (0..block).map(|_| (b'a' + (next_random(mut seed) % letters) as u8) as char).collect();
        let s: String = (0..n).map(|i| unit.bytes()[i % block] as char).collect();
        let t = if small {
            (0..n).map(|_| (b'a' + (next_random(mut seed) % 2) as u8) as char).collect()
        } else if next_random(mut seed) % 3 < 2 {
            rotated(s, next_random(mut seed) % n)
        } else {
            (0..n).map(|_| (b'a' + (next_random(mut seed) % letters) as u8) as char).collect()
        };
        let k = if small { next_random(mut seed) % 20 + 1 } else { (next_random(mut seed) * 30000 + next_random(mut seed)) * 1000 + 1 };
        let ways = number_of_ways(s, t, k);
        if ways > 0 {
            matched += 1;
        }
        check = (check * 31 + ways) % 1000000007;
        if c == 2999 {
            println(f"3000 short pairs: {matched} with a way, checksum {check}");
            matched = 0;
            check = 0;
        }
    }
    println(f"60 long pairs: {matched} with a way, checksum {check}");
}
