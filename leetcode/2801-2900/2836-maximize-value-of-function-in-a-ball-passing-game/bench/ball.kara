// LeetCode #2836: Maximize Value of Function in a Ball Passing Game --
// the bench: the ★ arm over 10 games of 10^5 players with k up to
// 10^10, LeetCode's most, all drawn first, then each answered 3 times.

fn get_max_function_value(receiver: Vec[i64], k: i64) -> i64 {
    let n = receiver.len();
    let levels = 34;
    let mut jump: Vec[Vec[i64]] = [receiver.clone()];
    let mut gain: Vec[Vec[i64]] = [receiver.clone()];
    for j in 1..levels {
        let next: Vec[i64] = (0..n).map(|i| jump[j - 1][jump[j - 1][i]]).collect();
        let sum: Vec[i64] = (0..n).map(|i| gain[j - 1][i] + gain[j - 1][jump[j - 1][i]]).collect();
        jump.push(next);
        gain.push(sum);
    }
    let mut best = 0;
    for start in 0..n {
        let mut at = start;
        let mut total = start;
        for j in 0..levels {
            if (k >> j) & 1 == 1 {
                total += gain[j][at];
                at = jump[j][at];
            }
        }
        best = best.max(total);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 10;
    let rounds = 3;
    let n = 100000;
    let mut seed = 2836;
    let mut games: Vec[(Vec[i64], i64)] = Vec.new();
    for _ in 0..count {
        let receiver: Vec[i64] = (0..n).map(|_| wide(mut seed) % n).collect();
        let k = (wide(mut seed) * 10 + next_random(mut seed)) % 10000000000 + 1;
        games.push((receiver, k));
    }
    let mut check = 0;
    for r in 0..rounds {
        for (receiver, k) in games.iter() {
            let best = get_max_function_value(receiver, k);
            check = (check * 31 + best % 1000000007 + r) % 1000000007;
        }
    }
    println(f"{count} games of {n}, {rounds} rounds: checksum {check}");
}
