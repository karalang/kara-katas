// LeetCode #2836: Maximize Value of Function in a Ball Passing Game -- a
// Rust solution as LeetCode's Rust users write it, carried to Kāra by
// `karac fix`: `vec![vec![(0usize, 0i64); n]; 35]` for the lifted jumps
// and sums, `k: i64` walked by its bits, and `.max()` over every start.

struct Solution {}

impl Solution {
    pub fn get_max_function_value(receiver: Vec[i32], k: i64) -> i64 {
        let n = receiver.len();
        let mut f = Vec.filled(35, Vec.filled(n, (0, 0)));
        for i in 0..n {
            f[0][i] = (receiver[i] as i64, receiver[i] as i64);
        }
        for j in 1..35 {
            for i in 0..n {
                let (mid, s1) = f[j - 1][i];
                let (to, s2) = f[j - 1][mid];
                f[j][i] = (to, s1 + s2);
            }
        }
        let mut ans = 0;
        for i in 0..n {
            let mut cur = i;
            let mut sum = i;
            for j in 0..35 {
                if (k >> j) & 1 == 1 {
                    let (to, s) = f[j][cur];
                    sum += s;
                    cur = to;
                }
            }
            ans = ans.max(sum);
        }
        ans
    }
}

fn get_max_function_value(receiver: Vec[i64], k: i64) -> i64 {
    Solution.get_max_function_value(receiver.iter().map(|v| v as i32).collect(), k)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; one player; and 10^5 players, LeetCode's
    // most, each keeping the ball, with k = 10^10, LeetCode's most
    println(f"{get_max_function_value([2, 0, 1], 4)} {get_max_function_value([1, 1, 1, 2, 3], 3)}");
    println(f"{get_max_function_value([0], 10000000000)}");
    println(f"{get_max_function_value((0..100000).collect(), 10000000000)}");
    // 3000 random games of 1 to 8 players with k up to 20; then 100 of up
    // to 2000 players with k up to 10^10
    let mut seed = 2836;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 8 + 1;
        let receiver: Vec[i64] = (0..n).map(|_| next_random(mut seed) % n).collect();
        let k = next_random(mut seed) % 20 + 1;
        check = (check * 31 + get_max_function_value(receiver, k)) % 1000000007;
    }
    println(f"3000 small games: checksum {check}");
    check = 0;
    for _ in 0..100 {
        let n = next_random(mut seed) % 2000 + 1;
        let receiver: Vec[i64] = (0..n).map(|_| next_random(mut seed) % n).collect();
        let k = (wide(mut seed) * 10 + next_random(mut seed)) % 10000000000 + 1;
        check = (check * 31 + get_max_function_value(receiver, k)) % 1000000007;
    }
    println(f"100 large games: checksum {check}");
}
