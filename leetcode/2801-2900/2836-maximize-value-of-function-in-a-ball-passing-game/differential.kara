// LeetCode #2836: Maximize Value of Function in a Ball Passing Game --
// the differential. The five arms, against the statement read
// literally: from every start, the ball passed k times one pass at a
// time, the ids of the start and every receiver added, and the most.
// 2000 random games of 1 to 8 players with k up to 20, then 50 of up to
// 1500 players with k up to 10^10. Every case is drawn before any arm
// answers; the literal reading is asked only of the first 2000.
//
// P1  k up to 20, the answer is the literal reading's
// P2  k one larger: no smaller
// P3  every player keeping the ball: (n - 1)(k + 1)
// P4  a player n added who passes to player 0: no smaller, and at least n
// P5  from n - 1 to (n - 1)(k + 1)
// P6  each arm agrees with at least three of the other four

fn literal(receiver: Vec[i64], k: i64) -> i64 {
    let mut best = 0;
    for start in 0..receiver.len() {
        let mut at = start;
        let mut total = start;
        for _ in 0..k {
            at = receiver[at];
            total += at;
        }
        best = best.max(total);
    }
    best
}


// ---- star (ball.kara) -----------------------------------------------

fn star_get_max_function_value(receiver: Vec[i64], k: i64) -> i64 {
    let n = receiver.len();
    let levels = 34;
    let mut jump: Vec[Vec[i64]] = [receiver.clone()];
    let mut gain: Vec[Vec[i64]] = [receiver.clone()];
    for j in 1..levels {
        let next: Vec[i64] = (0..n).map(|i| jump[j - 1][jump[j - 1][i]]).collect();
        let sum: Vec[i64] = (0..n).map(|i| gain[j - 1][i] + gain[j - 1][jump[j - 1][i]]).collect();
        jump.push(next);
        gain.push(sum);
    }
    let mut best = 0;
    for start in 0..n {
        let mut at = start;
        let mut total = start;
        for j in 0..levels {
            if (k >> j) & 1 == 1 {
                total += gain[j][at];
                at = jump[j][at];
            }
        }
        best = best.max(total);
    }
    best
}


// ---- pairs (ball_pairs.kara) ----------------------------------------

fn pairs_get_max_function_value(receiver: Vec[i64], k: i64) -> i64 {
    let n = receiver.len();
    let mut step: Vec[(i64, i64)] = receiver.iter().map(|r| (r, r)).collect();
    let mut state: Vec[(i64, i64)] = (0..n).map(|i| (i, i)).collect();
    let mut rest = k;
    while rest > 0 {
        if rest % 2 == 1 {
            state = state.iter().map(|(at, total)| (step[at].0, total + step[at].1)).collect();
        }
        step = step.iter().map(|(to, sum)| (step[to].0, sum + step[to].1)).collect();
        rest /= 2;
    }
    state.iter().map(|(_, total)| total).max().unwrap()
}


// ---- cycle (ball_cycle.kara) ----------------------------------------

fn cycle_get_max_function_value(receiver: Vec[i64], k: i64) -> i64 {
    let n = receiver.len();
    let mut seen_at: Vec[i64] = Vec.filled(n, -1);
    let mut best = 0;
    for start in 0..n {
        // prefix[s]: start plus the first s receivers
        let mut prefix: Vec[i64] = [start];
        let mut path: Vec[i64] = [start];
        seen_at[start] = 0;
        let mut at = start;
        let mut s = 0;
        let mut total = -1;
        while s < k {
            at = receiver[at];
            s += 1;
            prefix.push(prefix[prefix.len() - 1] + at);
            if seen_at[at] >= 0 {
                let first = seen_at[at];
                let lap = s - first;
                let lap_sum = prefix[s] - prefix[first];
                let laps = (k - s) / lap;
                let tail = (k - s) % lap;
                total = prefix[s] + laps * lap_sum + prefix[first + tail] - prefix[first];
                break;
            }
            seen_at[at] = s;
            path.push(at);
        }
        if total < 0 {
            total = prefix[k];
        }
        for p in path.iter() {
            seen_at[p] = -1;
        }
        best = best.max(total);
    }
    best
}


// ---- tree (ball_tree.kara) ------------------------------------------

struct Cycles {
    on: Vec[i64],       // which cycle a player is on, -1 if none
    pos: Vec[i64],      // a cycle player's place on it
    len: Vec[i64],      // each cycle's length
    sums: Vec[Vec[i64]], // each cycle's ids written twice, as prefix sums
}

impl Cycles {
    // the ids of the next `passes` receivers after the ball is at cycle
    // player c
    fn ahead(self, c: i64, passes: i64) -> i64 {
        let id = self.on[c];
        let l = self.len[id];
        let p = ref self.sums[id];
        let lap = p[l];
        let from = self.pos[c] + 1;
        passes / l * lap + p[from + passes % l] - p[from]
    }
}

fn tree_find_cycles(receiver: Vec[i64]) -> Cycles {
    let n = receiver.len();
    let mut state: Vec[i64] = Vec.filled(n, 0);
    let mut cycles = Cycles { on: Vec.filled(n, -1), pos: Vec.filled(n, 0), len: Vec.new(), sums: Vec.new() };
    for start in 0..n {
        let mut walk: Vec[i64] = Vec.new();
        let mut at = start;
        while state[at] == 0 {
            state[at] = 1;
            walk.push(at);
            at = receiver[at];
        }
        if state[at] == 1 {
            let begin = walk.iter().position(|w| w == at).unwrap();
            let ring: Vec[i64] = walk[begin..].to_vec();
            let id = cycles.len.len();
            let mut sums: Vec[i64] = [0];
            for t in 0..2 * ring.len() {
                sums.push(sums[t] + ring[t % ring.len()]);
            }
            for (i, c) in ring.iter().enumerate() {
                cycles.on[c] = id;
                cycles.pos[c] = i;
            }
            cycles.len.push(ring.len());
            cycles.sums.push(sums);
        }
        for w in walk.iter() {
            state[w] = 2;
        }
    }
    cycles
}

fn tree_get_max_function_value(receiver: Vec[i64], k: i64) -> i64 {
    let n = receiver.len();
    let cycles = tree_find_cycles(receiver);
    let mut children: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for v in 0..n {
        if cycles.on[v] < 0 {
            children[receiver[v]].push(v);
        }
    }
    let mut best = 0;
    let mut path: Vec[i64] = Vec.filled(n, 0);
    let mut sum_to: Vec[i64] = Vec.filled(n, 0); // sum_to[d]: ids of path[0..=d]
    for root in 0..n {
        if cycles.on[root] < 0 {
            continue;
        }
        best = best.max(root + cycles.ahead(root, k));
        let mut stack: Vec[(i64, i64)] = children[root].iter().map(|c| (c, 1)).collect();
        path[0] = root;
        sum_to[0] = root;
        while let Some((v, d)) = stack.pop() {
            path[d] = v;
            sum_to[d] = sum_to[d - 1] + v;
            // the receivers are path[d - 1], .., path[0], then the cycle
            let value = if k < d {
                v + sum_to[d - 1] - sum_to[d - 1 - k]
            } else {
                v + sum_to[d - 1] + cycles.ahead(root, k - d)
            };
            best = best.max(value);
            for c in children[v].iter() {
                stack.push((c, d + 1));
            }
        }
    }
    best
}


// ---- solution (ball_solution.kara) ----------------------------------

struct Solution {}

impl Solution {
    pub fn get_max_function_value(receiver: Vec[i32], k: i64) -> i64 {
        let n = receiver.len();
        let mut f = Vec.filled(35, Vec.filled(n, (0, 0)));
        for i in 0..n {
            f[0][i] = (receiver[i] as i64, receiver[i] as i64);
        }
        for j in 1..35 {
            for i in 0..n {
                let (mid, s1) = f[j - 1][i];
                let (to, s2) = f[j - 1][mid];
                f[j][i] = (to, s1 + s2);
            }
        }
        let mut ans = 0;
        for i in 0..n {
            let mut cur = i;
            let mut sum = i;
            for j in 0..35 {
                if (k >> j) & 1 == 1 {
                    let (to, s) = f[j][cur];
                    sum += s;
                    cur = to;
                }
            }
            ans = ans.max(sum);
        }
        ans
    }
}

fn solution_get_max_function_value(receiver: Vec[i64], k: i64) -> i64 {
    Solution.get_max_function_value(receiver.iter().map(|v| v as i32).collect(), k)
}


// ---- the check ---------------------------------------------------------

fn answer(arm: i64, receiver: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_get_max_function_value(receiver, k),
        1 => pairs_get_max_function_value(receiver, k),
        2 => cycle_get_max_function_value(receiver, k),
        3 => tree_get_max_function_value(receiver, k),
        _ => solution_get_max_function_value(receiver, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "pairs", "cycle", "tree", "solution"];
    let mut seed = 2836;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for c in 0..2050 {
        if c < 2000 {
            let n = next_random(mut seed) % 8 + 1;
            let receiver: Vec[i64] = (0..n).map(|_| next_random(mut seed) % n).collect();
            cases.push((receiver, next_random(mut seed) % 20 + 1));
        } else {
            let n = next_random(mut seed) % 1500 + 1;
            let receiver: Vec[i64] = (0..n).map(|_| next_random(mut seed) % n).collect();
            cases.push((receiver, (wide(mut seed) * 10 + next_random(mut seed)) % 10000000000 + 1));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (receiver, k)) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(receiver, k) } else { 0 };
        check = (check * 31 + want + 1) % 1000000007;
        let n = receiver.len();
        let kept: Vec[i64] = (0..n).collect();
        let mut grown = receiver.clone();
        grown.push(0);
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, receiver, k)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let more = answer(arm, grown, k);
            let verdicts = [
                not small or value == want,
                answer(arm, receiver, k + 1) >= value,
                answer(arm, kept, k) == (n - 1) * (k + 1),
                more >= value and more >= n,
                value >= n - 1 and value <= (n - 1) * (k + 1),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {receiver} k {k}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
