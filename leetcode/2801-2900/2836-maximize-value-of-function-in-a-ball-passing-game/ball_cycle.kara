// LeetCode #2836: Maximize Value of Function in a Ball Passing Game --
// walking each start until a player comes round again: the step each
// player was first reached at says where the cycle begins and how long
// it is, so the rest of the k passes are whole laps of its sum and a
// short walk; O(n) a start, for the harness's sizes.

fn get_max_function_value(receiver: Vec[i64], k: i64) -> i64 {
    let n = receiver.len();
    let mut seen_at: Vec[i64] = Vec.filled(n, -1);
    let mut best = 0;
    for start in 0..n {
        // prefix[s]: start plus the first s receivers
        let mut prefix: Vec[i64] = [start];
        let mut path: Vec[i64] = [start];
        seen_at[start] = 0;
        let mut at = start;
        let mut s = 0;
        let mut total = -1;
        while s < k {
            at = receiver[at];
            s += 1;
            prefix.push(prefix[prefix.len() - 1] + at);
            if seen_at[at] >= 0 {
                let first = seen_at[at];
                let lap = s - first;
                let lap_sum = prefix[s] - prefix[first];
                let laps = (k - s) / lap;
                let tail = (k - s) % lap;
                total = prefix[s] + laps * lap_sum + prefix[first + tail] - prefix[first];
                break;
            }
            seen_at[at] = s;
            path.push(at);
        }
        if total < 0 {
            total = prefix[k];
        }
        for p in path.iter() {
            seen_at[p] = -1;
        }
        best = best.max(total);
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; one player; and 10^5 players, LeetCode's
    // most, each keeping the ball, with k = 10^10, LeetCode's most
    println(f"{get_max_function_value([2, 0, 1], 4)} {get_max_function_value([1, 1, 1, 2, 3], 3)}");
    println(f"{get_max_function_value([0], 10000000000)}");
    println(f"{get_max_function_value((0..100000).collect(), 10000000000)}");
    // 3000 random games of 1 to 8 players with k up to 20; then 100 of up
    // to 2000 players with k up to 10^10
    let mut seed = 2836;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 8 + 1;
        let receiver: Vec[i64] = (0..n).map(|_| next_random(mut seed) % n).collect();
        let k = next_random(mut seed) % 20 + 1;
        check = (check * 31 + get_max_function_value(receiver, k)) % 1000000007;
    }
    println(f"3000 small games: checksum {check}");
    check = 0;
    for _ in 0..100 {
        let n = next_random(mut seed) % 2000 + 1;
        let receiver: Vec[i64] = (0..n).map(|_| next_random(mut seed) % n).collect();
        let k = (wide(mut seed) * 10 + next_random(mut seed)) % 10000000000 + 1;
        check = (check * 31 + get_max_function_value(receiver, k)) % 1000000007;
    }
    println(f"100 large games: checksum {check}");
}
