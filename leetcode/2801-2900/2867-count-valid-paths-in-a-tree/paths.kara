// LeetCode #2867: Count Valid Paths in a Tree -- ★: with the primes
// taken out, the other nodes fall into components, joined by a
// disjoint-set union over the edges between two non-primes. A valid
// path has its one prime p and the rest in at most two of the
// components around p: so for each p, its neighbours' components'
// sizes are walked, each adding its size (paths ending at p) and its
// size times all the sizes before it (paths through p).

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut root = x;
    while parent[root] != root {
        root = parent[root];
    }
    let mut at = x;
    while parent[at] != root {
        let next = parent[at];
        parent[at] = root;
        at = next;
    }
    root
}

fn count_paths(n: i64, edges: Vec[Vec[i64]]) -> i64 {
    let mut prime: Vec[bool] = Vec.filled(n + 1, true);
    prime[0] = false;
    prime[1] = false;
    let mut i = 2;
    while i * i <= n {
        if prime[i] {
            let mut j = i * i;
            while j <= n {
                prime[j] = false;
                j += i;
            }
        }
        i += 1;
    }
    let mut parent: Vec[i64] = (0..n + 1).collect();
    let mut size: Vec[i64] = Vec.filled(n + 1, 1);
    let mut around: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        let (a, b) = (e[0], e[1]);
        if prime[a] or prime[b] {
            around[a].push(b);
            around[b].push(a);
        } else {
            let (ra, rb) = (find(mut parent, a), find(mut parent, b));
            if ra != rb {
                parent[ra] = rb;
                size[rb] += size[ra];
            }
        }
    }
    let mut count = 0;
    for p in 2..n + 1 {
        if prime[p] {
            let mut before = 0;
            for v in around[p].iter() {
                if not prime[v] {
                    let s = size[find(mut parent, v)];
                    count += s + s * before;
                    before += s;
                }
            }
        }
    }
    count
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; 10^5 nodes, LeetCode's most, as a path
    // and as a star around node 2
    println(f"{count_paths(5, [[1, 2], [1, 3], [2, 4], [2, 5]].to_vec())} {count_paths(6, [[1, 2], [1, 3], [2, 4], [3, 5], [3, 6]].to_vec())}");
    let n = 100000;
    let path: Vec[Vec[i64]] = (1..n).map(|i| [i, i + 1].to_vec()).collect();
    let star: Vec[Vec[i64]] = (1..n + 1).filter(|i| i != 2).map(|i| [2, i].to_vec()).collect();
    println(f"{count_paths(n, path)} {count_paths(n, star)}");
    // 3000 random trees of 1 to 10 nodes; then 30 of 10^4 to 10^5, every
    // other one deep, each node's parent among the five before it
    let mut seed = 2867;
    let mut total = 0;
    let mut check = 0;
    for c in 0..3030 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 10 + 1 } else { wide(mut seed) % 90001 + 10000 };
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for v in 2..n + 1 {
            let reach = if not small and c % 2 == 1 { (v - 1).min(5) } else { v - 1 };
            let parent = v - 1 - wide(mut seed) % reach;
            edges.push([parent, v].to_vec());
        }
        let paths = count_paths(n, edges);
        total += paths;
        check = (check * 31 + paths) % 1000000007;
        if c == 2999 {
            println(f"3000 small trees: {total} paths, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"30 large trees: {total} paths, checksum {check}");
}
