// LeetCode #2867: Count Valid Paths in a Tree -- the non-primes' sizes
// by a disjoint-set union, then every edge from a prime to a non-prime
// as a pair (prime, size of the non-prime's component), the pairs
// sorted, and each prime's run of them walked: a size adds itself and
// itself times the run's sizes before it.

fn root(parent: Vec[i64], x: i64) -> i64 {
    let mut r = x;
    while parent[r] != r {
        r = parent[r];
    }
    r
}

fn count_paths(n: i64, edges: Vec[Vec[i64]]) -> i64 {
    let mut prime: Vec[bool] = Vec.filled(n + 1, true);
    prime[0] = false;
    prime[1] = false;
    let mut i = 2;
    while i * i <= n {
        if prime[i] {
            let mut j = i * i;
            while j <= n {
                prime[j] = false;
                j += i;
            }
        }
        i += 1;
    }
    let mut parent: Vec[i64] = (0..n + 1).collect();
    let mut size: Vec[i64] = Vec.filled(n + 1, 1);
    for e in edges.iter() {
        if not prime[e[0]] and not prime[e[1]] {
            let mut (a, b) = (root(parent, e[0]), root(parent, e[1]));
            if size[a] > size[b] {
                let t = a;
                a = b;
                b = t;
            }
            parent[a] = b;
            size[b] += size[a];
        }
    }
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for e in edges.iter() {
        if prime[e[0]] and not prime[e[1]] {
            pairs.push((e[0], size[root(parent, e[1])]));
        } else if prime[e[1]] and not prime[e[0]] {
            pairs.push((e[1], size[root(parent, e[0])]));
        }
    }
    pairs.sort();
    let mut count = 0;
    let mut i = 0;
    while i < pairs.len() {
        let mut before = 0;
        let mut j = i;
        while j < pairs.len() and pairs[j].0 == pairs[i].0 {
            let s = pairs[j].1;
            count += s + s * before;
            before += s;
            j += 1;
        }
        i = j;
    }
    count
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; 10^5 nodes, LeetCode's most, as a path
    // and as a star around node 2
    println(f"{count_paths(5, [[1, 2], [1, 3], [2, 4], [2, 5]].to_vec())} {count_paths(6, [[1, 2], [1, 3], [2, 4], [3, 5], [3, 6]].to_vec())}");
    let n = 100000;
    let path: Vec[Vec[i64]] = (1..n).map(|i| [i, i + 1].to_vec()).collect();
    let star: Vec[Vec[i64]] = (1..n + 1).filter(|i| i != 2).map(|i| [2, i].to_vec()).collect();
    println(f"{count_paths(n, path)} {count_paths(n, star)}");
    // 3000 random trees of 1 to 10 nodes; then 30 of 10^4 to 10^5, every
    // other one deep, each node's parent among the five before it
    let mut seed = 2867;
    let mut total = 0;
    let mut check = 0;
    for c in 0..3030 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 10 + 1 } else { wide(mut seed) % 90001 + 10000 };
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for v in 2..n + 1 {
            let reach = if not small and c % 2 == 1 { (v - 1).min(5) } else { v - 1 };
            let parent = v - 1 - wide(mut seed) % reach;
            edges.push([parent, v].to_vec());
        }
        let paths = count_paths(n, edges);
        total += paths;
        check = (check * 31 + paths) % 1000000007;
        if c == 2999 {
            println(f"3000 small trees: {total} paths, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"30 large trees: {total} paths, checksum {check}");
}
