// LeetCode #2867: Count Valid Paths in a Tree -- the differential. The
// five arms, against the statement read literally: every pair a < b,
// the path between them found by walking up from b to a breadth-first
// search's root at a, its primes counted, kept when there is one.
// 2000 random trees of 1 to 12 nodes, then 50 of up to 3000, every
// other one deep, all drawn before any arm answers; the literal reading
// is asked only of the first 2000.
//
// P1  up to 12 nodes, the answer is the literal reading's
// P2  every edge written the other way round and the list reversed:
//     the same answer
// P3  from the number of edges joining a prime to a non-prime to
//     n(n - 1) / 2
// P4  labels 1 and 4 swapped, two non-primes: the same answer
// P5  labels 2 and 3 swapped, two primes: the same answer
// P6  each arm agrees with at least three of the other four

fn is_prime(v: i64) -> bool {
    v >= 2 and (2..v).all(|d| v % d != 0)
}

fn literal(n: i64, edges: Vec[Vec[i64]]) -> i64 {
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut count = 0;
    for a in 1..n + 1 {
        let mut from: Vec[i64] = Vec.filled(n + 1, 0);
        from[a] = a;
        let mut queue: Vec[i64] = [a].to_vec();
        let mut head = 0;
        while head < queue.len() {
            let u = queue[head];
            head += 1;
            for w in adjacent[u].iter() {
                if from[w] == 0 {
                    from[w] = u;
                    queue.push(w);
                }
            }
        }
        for b in a + 1..n + 1 {
            let mut primes = if is_prime(a) { 1 } else { 0 };
            let mut at = b;
            while at != a {
                if is_prime(at) {
                    primes += 1;
                }
                at = from[at];
            }
            if primes == 1 {
                count += 1;
            }
        }
    }
    count
}

fn swapped(edges: Vec[Vec[i64]], x: i64, y: i64) -> Vec[Vec[i64]] {
    edges.iter().map(|e| e.iter().map(|v| if v == x { y } else if v == y { x } else { v }).collect()).collect()
}


// ---- star (paths.kara) ----------------------------------------------

fn star_find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut root = x;
    while parent[root] != root {
        root = parent[root];
    }
    let mut at = x;
    while parent[at] != root {
        let next = parent[at];
        parent[at] = root;
        at = next;
    }
    root
}

fn star_count_paths(n: i64, edges: Vec[Vec[i64]]) -> i64 {
    let mut prime: Vec[bool] = Vec.filled(n + 1, true);
    prime[0] = false;
    prime[1] = false;
    let mut i = 2;
    while i * i <= n {
        if prime[i] {
            let mut j = i * i;
            while j <= n {
                prime[j] = false;
                j += i;
            }
        }
        i += 1;
    }
    let mut parent: Vec[i64] = (0..n + 1).collect();
    let mut size: Vec[i64] = Vec.filled(n + 1, 1);
    let mut around: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        let (a, b) = (e[0], e[1]);
        if prime[a] or prime[b] {
            around[a].push(b);
            around[b].push(a);
        } else {
            let (ra, rb) = (star_find(mut parent, a), star_find(mut parent, b));
            if ra != rb {
                parent[ra] = rb;
                size[rb] += size[ra];
            }
        }
    }
    let mut count = 0;
    for p in 2..n + 1 {
        if prime[p] {
            let mut before = 0;
            for v in around[p].iter() {
                if not prime[v] {
                    let s = size[star_find(mut parent, v)];
                    count += s + s * before;
                    before += s;
                }
            }
        }
    }
    count
}


// ---- flood (paths_flood.kara) ---------------------------------------

fn flood_count_paths(n: i64, edges: Vec[Vec[i64]]) -> i64 {
    let mut prime: Vec[bool] = Vec.filled(n + 1, true);
    prime[0] = false;
    prime[1] = false;
    let mut i = 2;
    while i * i <= n {
        if prime[i] {
            let mut j = i * i;
            while j <= n {
                prime[j] = false;
                j += i;
            }
        }
        i += 1;
    }
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut label: Vec[i64] = Vec.filled(n + 1, -1);
    let mut sizes: Vec[i64] = Vec.new();
    for start in 1..n + 1 {
        if prime[start] or label[start] >= 0 {
            continue;
        }
        let id = sizes.len();
        label[start] = id;
        let mut queue: Vec[i64] = [start].to_vec();
        let mut head = 0;
        while head < queue.len() {
            let u = queue[head];
            head += 1;
            for w in adjacent[u].iter() {
                if not prime[w] and label[w] < 0 {
                    label[w] = id;
                    queue.push(w);
                }
            }
        }
        sizes.push(queue.len());
    }
    let mut count = 0;
    for p in 2..n + 1 {
        if prime[p] {
            let mut sum = 0;
            let mut squares = 0;
            for v in adjacent[p].iter() {
                if not prime[v] {
                    let s = sizes[label[v]];
                    sum += s;
                    squares += s * s;
                }
            }
            count += sum + (sum * sum - squares) / 2;
        }
    }
    count
}


// ---- dp (paths_dp.kara) ---------------------------------------------

fn dp_count_paths(n: i64, edges: Vec[Vec[i64]]) -> i64 {
    let mut prime: Vec[bool] = Vec.filled(n + 1, true);
    prime[0] = false;
    prime[1] = false;
    let mut i = 2;
    while i * i <= n {
        if prime[i] {
            let mut j = i * i;
            while j <= n {
                prime[j] = false;
                j += i;
            }
        }
        i += 1;
    }
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut parent: Vec[i64] = Vec.filled(n + 1, 0);
    let mut order: Vec[i64] = [1].to_vec();
    let mut head = 0;
    while head < order.len() {
        let u = order[head];
        head += 1;
        for w in adjacent[u].iter() {
            if w != parent[u] {
                parent[w] = u;
                order.push(w);
            }
        }
    }
    let mut none: Vec[i64] = Vec.filled(n + 1, 0);
    let mut one: Vec[i64] = Vec.filled(n + 1, 0);
    let mut count = 0;
    for u in order.iter().rev() {
        let mut gathered_none = if prime[u] { 0 } else { 1 };
        let mut gathered_one = if prime[u] { 1 } else { 0 };
        for w in adjacent[u].iter() {
            if w == parent[u] {
                continue;
            }
            count += gathered_none * one[w] + gathered_one * none[w];
            if prime[u] {
                gathered_one += none[w];
            } else {
                gathered_none += none[w];
                gathered_one += one[w];
            }
        }
        none[u] = gathered_none;
        one[u] = gathered_one;
    }
    count
}


// ---- sorted (paths_sorted.kara) -------------------------------------

fn sorted_root(parent: Vec[i64], x: i64) -> i64 {
    let mut r = x;
    while parent[r] != r {
        r = parent[r];
    }
    r
}

fn sorted_count_paths(n: i64, edges: Vec[Vec[i64]]) -> i64 {
    let mut prime: Vec[bool] = Vec.filled(n + 1, true);
    prime[0] = false;
    prime[1] = false;
    let mut i = 2;
    while i * i <= n {
        if prime[i] {
            let mut j = i * i;
            while j <= n {
                prime[j] = false;
                j += i;
            }
        }
        i += 1;
    }
    let mut parent: Vec[i64] = (0..n + 1).collect();
    let mut size: Vec[i64] = Vec.filled(n + 1, 1);
    for e in edges.iter() {
        if not prime[e[0]] and not prime[e[1]] {
            let mut (a, b) = (sorted_root(parent, e[0]), sorted_root(parent, e[1]));
            if size[a] > size[b] {
                let t = a;
                a = b;
                b = t;
            }
            parent[a] = b;
            size[b] += size[a];
        }
    }
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for e in edges.iter() {
        if prime[e[0]] and not prime[e[1]] {
            pairs.push((e[0], size[sorted_root(parent, e[1])]));
        } else if prime[e[1]] and not prime[e[0]] {
            pairs.push((e[1], size[sorted_root(parent, e[0])]));
        }
    }
    pairs.sort();
    let mut count = 0;
    let mut i = 0;
    while i < pairs.len() {
        let mut before = 0;
        let mut j = i;
        while j < pairs.len() and pairs[j].0 == pairs[i].0 {
            let s = pairs[j].1;
            count += s + s * before;
            before += s;
            j += 1;
        }
        i = j;
    }
    count
}


// ---- solution (paths_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn count_paths(n: i32, edges: Vec[Vec[i32]]) -> i64 {
        let n = n as i64;
        let mut is_prime = Vec.filled(n + 1, true);
        is_prime[0] = false;
        is_prime[1] = false;
        for i in 2..=n {
            if is_prime[i] {
                let mut j = i * i;
                while j <= n {
                    is_prime[j] = false;
                    j += i;
                }
            }
        }
        let mut g = Vec.filled(n + 1, Vec.new());
        for e in ref edges {
            let (a, b) = (e[0] as i64, e[1] as i64);
            g[a].push(b);
            g[b].push(a);
        }
        let mut size = Vec.filled(n + 1, 0);
        let mut ans = 0;
        for p in 2..=n {
            if not is_prime[p] {
                continue;
            }
            let mut sum = 0;
            for v in ref g[p] {
                if is_prime[v] {
                    continue;
                }
                if size[v] == 0 {
                    let mut comp = [v];
                    let mut stack = [v];
                    size[v] = -1;
                    while let Some(u) = stack.pop() {
                        for w in ref g[u] {
                            if not is_prime[w] and size[w] == 0 {
                                size[w] = -1;
                                comp.push(w);
                                stack.push(w);
                            }
                        }
                    }
                    let s = comp.len();
                    for u in ref comp {
                        size[u] = s;
                    }
                }
                ans += size[v] * sum + size[v];
                sum += size[v];
            }
        }
        ans
    }
}

fn solution_count_paths(n: i64, edges: Vec[Vec[i64]]) -> i64 {
    Solution.count_paths(n as i32, edges.iter().map(|e| e.iter().map(|x| x as i32).collect()).collect())
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, n: i64, edges: Vec[Vec[i64]]) -> i64 {
    match arm {
        0 => star_count_paths(n, edges),
        1 => flood_count_paths(n, edges),
        2 => dp_count_paths(n, edges),
        3 => sorted_count_paths(n, edges),
        _ => solution_count_paths(n, edges),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "flood", "dp", "sorted", "solution"];
    let mut seed = 2867;
    let mut cases: Vec[Vec[Vec[i64]]] = Vec.new();
    let mut sizes: Vec[i64] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 12 + 1 } else { wide(mut seed) % 3000 + 1 };
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for v in 2..n + 1 {
            let reach = if not small and c % 2 == 1 { (v - 1).min(5) } else { v - 1 };
            let parent = v - 1 - wide(mut seed) % reach;
            if next_random(mut seed) % 2 == 0 {
                edges.push([parent, v].to_vec());
            } else {
                edges.push([v, parent].to_vec());
            }
        }
        // shuffled, so the edges come in no order
        for i in (1..edges.len()).rev() {
            edges.swap(i, wide(mut seed) % (i + 1));
        }
        cases.push(edges);
        sizes.push(n);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, edges) in cases.iter().enumerate() {
        let n = sizes[c];
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, n, edges)).collect();
        let want = if c < 2000 { literal(n, edges) } else { got[0] };
        total += want;
        check = (check * 31 + want) % 1000000007;
        let turned: Vec[Vec[i64]] = edges.iter().rev().map(|e| [e[1], e[0]].to_vec()).collect();
        let joining = edges.iter().filter(|e| is_prime(e[0]) != is_prime(e[1])).count();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                c >= 2000 or value == want,
                answer(arm, n, turned) == value,
                value >= joining and value <= n * (n - 1) / 2,
                n < 4 or answer(arm, n, swapped(edges, 1, 4)) == value,
                n < 3 or answer(arm, n, swapped(edges, 2, 3)) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} n {n} {edges}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, {total} paths: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
