// LeetCode #2867: Count Valid Paths in a Tree -- the bench: the ★ arm
// over 10 trees of 10^5 nodes, LeetCode's most, every other one deep,
// each node's parent among the five before it, all drawn first, then
// each answered 10 times.

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut root = x;
    while parent[root] != root {
        root = parent[root];
    }
    let mut at = x;
    while parent[at] != root {
        let next = parent[at];
        parent[at] = root;
        at = next;
    }
    root
}

fn count_paths(n: i64, edges: Vec[Vec[i64]]) -> i64 {
    let mut prime: Vec[bool] = Vec.filled(n + 1, true);
    prime[0] = false;
    prime[1] = false;
    let mut i = 2;
    while i * i <= n {
        if prime[i] {
            let mut j = i * i;
            while j <= n {
                prime[j] = false;
                j += i;
            }
        }
        i += 1;
    }
    let mut parent: Vec[i64] = (0..n + 1).collect();
    let mut size: Vec[i64] = Vec.filled(n + 1, 1);
    let mut around: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        let (a, b) = (e[0], e[1]);
        if prime[a] or prime[b] {
            around[a].push(b);
            around[b].push(a);
        } else {
            let (ra, rb) = (find(mut parent, a), find(mut parent, b));
            if ra != rb {
                parent[ra] = rb;
                size[rb] += size[ra];
            }
        }
    }
    let mut count = 0;
    for p in 2..n + 1 {
        if prime[p] {
            let mut before = 0;
            for v in around[p].iter() {
                if not prime[v] {
                    let s = size[find(mut parent, v)];
                    count += s + s * before;
                    before += s;
                }
            }
        }
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 10;
    let rounds = 10;
    let n = 100000;
    let mut seed = 2867;
    let mut trees: Vec[Vec[Vec[i64]]] = Vec.new();
    for c in 0..count {
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for v in 2..n + 1 {
            let reach = if c % 2 == 1 { (v - 1).min(5) } else { v - 1 };
            edges.push([v - 1 - wide(mut seed) % reach, v].to_vec());
        }
        trees.push(edges);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for edges in trees.iter() {
            let paths = count_paths(n, edges);
            total += paths;
            check = (check * 31 + paths % 1000000007 + r) % 1000000007;
        }
    }
    println(f"{count} trees of {n}, {rounds} rounds: {total} paths, checksum {check}");
}
