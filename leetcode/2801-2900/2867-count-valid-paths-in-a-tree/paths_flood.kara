// LeetCode #2867: Count Valid Paths in a Tree -- the components of the
// non-primes labelled by breadth-first flood fill from each unlabelled
// non-prime, with a queue; then for each prime p, with S the sum of its
// neighbours' component sizes and Q the sum of their squares, the paths
// are S ending at p plus (S^2 - Q) / 2 through it. In a tree, no two
// neighbours of p share a component.

fn count_paths(n: i64, edges: Vec[Vec[i64]]) -> i64 {
    let mut prime: Vec[bool] = Vec.filled(n + 1, true);
    prime[0] = false;
    prime[1] = false;
    let mut i = 2;
    while i * i <= n {
        if prime[i] {
            let mut j = i * i;
            while j <= n {
                prime[j] = false;
                j += i;
            }
        }
        i += 1;
    }
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut label: Vec[i64] = Vec.filled(n + 1, -1);
    let mut sizes: Vec[i64] = Vec.new();
    for start in 1..n + 1 {
        if prime[start] or label[start] >= 0 {
            continue;
        }
        let id = sizes.len();
        label[start] = id;
        let mut queue: Vec[i64] = [start].to_vec();
        let mut head = 0;
        while head < queue.len() {
            let u = queue[head];
            head += 1;
            for w in adjacent[u].iter() {
                if not prime[w] and label[w] < 0 {
                    label[w] = id;
                    queue.push(w);
                }
            }
        }
        sizes.push(queue.len());
    }
    let mut count = 0;
    for p in 2..n + 1 {
        if prime[p] {
            let mut sum = 0;
            let mut squares = 0;
            for v in adjacent[p].iter() {
                if not prime[v] {
                    let s = sizes[label[v]];
                    sum += s;
                    squares += s * s;
                }
            }
            count += sum + (sum * sum - squares) / 2;
        }
    }
    count
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; 10^5 nodes, LeetCode's most, as a path
    // and as a star around node 2
    println(f"{count_paths(5, [[1, 2], [1, 3], [2, 4], [2, 5]].to_vec())} {count_paths(6, [[1, 2], [1, 3], [2, 4], [3, 5], [3, 6]].to_vec())}");
    let n = 100000;
    let path: Vec[Vec[i64]] = (1..n).map(|i| [i, i + 1].to_vec()).collect();
    let star: Vec[Vec[i64]] = (1..n + 1).filter(|i| i != 2).map(|i| [2, i].to_vec()).collect();
    println(f"{count_paths(n, path)} {count_paths(n, star)}");
    // 3000 random trees of 1 to 10 nodes; then 30 of 10^4 to 10^5, every
    // other one deep, each node's parent among the five before it
    let mut seed = 2867;
    let mut total = 0;
    let mut check = 0;
    for c in 0..3030 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 10 + 1 } else { wide(mut seed) % 90001 + 10000 };
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for v in 2..n + 1 {
            let reach = if not small and c % 2 == 1 { (v - 1).min(5) } else { v - 1 };
            let parent = v - 1 - wide(mut seed) % reach;
            edges.push([parent, v].to_vec());
        }
        let paths = count_paths(n, edges);
        total += paths;
        check = (check * 31 + paths) % 1000000007;
        if c == 2999 {
            println(f"3000 small trees: {total} paths, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"30 large trees: {total} paths, checksum {check}");
}
