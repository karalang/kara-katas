// LeetCode #2892: Minimizing Array After Replacing Pairs With Their
// Product -- the differential. The five arms, against the statement
// read literally: every neighbouring pair whose product is at most k
// tried as the next replacement, a search over the arrays that can be
// left, each seen once, kept in a `Map[String, i64]` by its values
// written out, to the shortest. 2000 random arrays of 1 to 7 values
// from 0 to 6, one in five allowed 0s, k 1 to 40, then 50 of up to 3000
// values, half 1 and the rest up to 1000, k up to 10^9, one in ten with
// a 0, all drawn before any arm answers; the literal reading is asked
// only of the first 2000.
//
// P1  up to 7 values, the answer is the literal reading's
// P2  the array reversed: the same answer
// P3  the array twice over: from the answer to twice it
// P4  k doubled: no more than the answer
// P5  from 1 to n; 1 when a 0 is held, n when no neighbours' product
//     is at most k
// P6  each arm agrees with at least three of the other four

fn shortest(nums: Vec[i64], k: i64, memo: mut ref Map[String, i64]) -> i64 {
    let key = f"{nums}";
    if let Some(known) = memo.get(key) {
        return known;
    }
    let n = nums.len();
    let mut best = n;
    for i in 0..n - 1 {
        if nums[i] * nums[i + 1] <= k {
            let mut rest = nums.clone();
            rest[i] = nums[i] * nums[i + 1];
            rest.remove(i + 1);
            best = best.min(shortest(rest, k, mut memo));
        }
    }
    memo.insert(key, best);
    best
}

fn literal(nums: Vec[i64], k: i64) -> i64 {
    let mut memo: Map[String, i64] = Map.new();
    shortest(nums, k, mut memo)
}


// ---- star (product.kara) --------------------------------------------

fn star_min_array_length(nums: Vec[i64], k: i64) -> i64 {
    if nums.contains(0) {
        return 1;
    }
    let mut runs = 1;
    let mut product = nums[0];
    for x in nums.iter().skip(1) {
        if product * x <= k {
            product *= x;
        } else {
            runs += 1;
            product = x;
        }
    }
    runs
}


// ---- window (product_window.kara) -----------------------------------

fn window_min_array_length(nums: Vec[i64], k: i64) -> i64 {
    if nums.contains(0) {
        return 1;
    }
    let n = nums.len();
    let mut fewest: Vec[i64] = Vec.filled(n + 1, 0);
    let mut start = 0;
    let mut product = 1;
    for i in 0..n {
        product *= nums[i];
        while start < i and product > k {
            product /= nums[start];
            start += 1;
        }
        fewest[i + 1] = fewest[start] + 1;
    }
    fewest[n]
}


// ---- fold (product_fold.kara) ---------------------------------------

fn fold_min_array_length(nums: Vec[i64], k: i64) -> i64 {
    if nums.iter().any(|x| x == 0) {
        return 1;
    }
    let (runs, _) = nums.iter().fold((0, k + 1), |(runs, product), x| if product * x <= k { (runs, product * x) } else { (runs + 1, x) });
    runs
}


// ---- stack (product_stack.kara) -------------------------------------

fn stack_min_array_length(nums: Vec[i64], k: i64) -> i64 {
    let mut stack: Vec[i64] = Vec.new();
    for x in nums.iter() {
        stack.push(x);
        while stack.len() >= 2 and stack[stack.len() - 1] * stack[stack.len() - 2] <= k {
            let top = stack.pop().unwrap();
            let under = stack.pop().unwrap();
            stack.push(top * under);
        }
    }
    stack.len()
}


// ---- solution (product_solution.kara) -------------------------------

struct Solution {}

impl Solution {
    pub fn min_array_length(nums: Vec[i32], k: i32) -> i32 {
        if nums.contains(0) {
            return 1;
        }
        let k = k as i64;
        let mut ans = 1;
        let mut cur = nums[0] as i64;
        for x in nums[1..] {
            let x = x as i64;
            if cur * x <= k {
                cur *= x;
            } else {
                ans += 1;
                cur = x;
            }
        }
        ans
    }
}

fn solution_min_array_length(nums: Vec[i64], k: i64) -> i64 {
    Solution.min_array_length(nums.iter().map(|x| x as i32).collect(), k as i32)
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_min_array_length(nums, k),
        1 => window_min_array_length(nums, k),
        2 => fold_min_array_length(nums, k),
        3 => stack_min_array_length(nums, k),
        _ => solution_min_array_length(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "window", "fold", "stack", "solution"];
    let mut seed = 2892;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 7 + 1 } else { wide(mut seed) % 3000 + 1 };
        let zeros = if small { c % 5 == 0 } else { c % 10 == 0 };
        let mut nums: Vec[i64] = (0..n).map(|_| if small { next_random(mut seed) % (if zeros { 7 } else { 6 }) + (if zeros { 0 } else { 1 }) } else if next_random(mut seed) % 2 == 0 { 1 } else { next_random(mut seed) % 1000 + 1 }).collect();
        if zeros and not small {
            let at = wide(mut seed) % n;
            nums[at] = 0;
        }
        let k = if small { next_random(mut seed) % 40 + 1 } else { wide(mut seed) % 1000000000 + 1 };
        cases.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, (nums, k)) in cases.iter().enumerate() {
        let n = nums.len();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums, k)).collect();
        let want = if c < 2000 { literal(nums, k) } else { got[0] };
        total += want;
        check = (check * 31 + want) % 1000000007;
        let reversed: Vec[i64] = nums.iter().rev().cloned().collect();
        let mut twice = nums.clone();
        twice.extend(nums.iter().cloned());
        let has_zero = nums.contains(0);
        let apart = (0..n - 1).all(|i| nums[i] * nums[i + 1] > k);
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let doubled = answer(arm, twice, k);
            let verdicts = [
                c >= 2000 or value == want,
                answer(arm, reversed, k) == value,
                doubled >= value and doubled <= 2 * value,
                answer(arm, nums, 2 * k) <= value,
                value >= 1 and value <= n and (not has_zero or value == 1) and (has_zero or not apart or value == n),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} n {n} k {k}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, lengths total {total}: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
