// LeetCode #2865: Beautiful Towers I -- divide at the lowest tower: in
// any mountain over lo..hi, the side of the lowest tower m away from the
// peak can be no taller than h[m] all the way out, and h[m] is the
// least there, so it is h[m] at every place; the best is then the best
// mountain over the other side plus h[m] times the rest, by recursion.

fn best(heights: Vec[i64], lo: i64, hi: i64) -> i64 {
    if lo > hi {
        return 0;
    }
    let mut m = lo;
    for i in lo + 1..hi + 1 {
        if heights[i] < heights[m] {
            m = i;
        }
    }
    let low = heights[m];
    let peak_left = best(heights, lo, m - 1) + low * (hi - m + 1);
    let peak_right = best(heights, m + 1, hi) + low * (m - lo + 1);
    peak_left.max(peak_right)
}

fn maximum_sum_of_heights(max_heights: Vec[i64]) -> i64 {
    best(max_heights, 0, max_heights.len() - 1)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's three examples; 10^3 towers, LeetCode's most, all 10^9,
    // rising, and a valley
    println(f"{maximum_sum_of_heights([5, 3, 4, 1, 1].to_vec())} {maximum_sum_of_heights([6, 5, 3, 9, 2, 7].to_vec())} {maximum_sum_of_heights([3, 2, 5, 5, 2, 3].to_vec())}");
    let n = 1000;
    println(f"{maximum_sum_of_heights(Vec.filled(n, 1000000000))} {maximum_sum_of_heights((1..n + 1).collect())} {maximum_sum_of_heights((0..n).map(|i| (i - 500).abs() + 1).collect())}");
    // 3000 random arrays of 1 to 8 heights from 1 to 6; then 30 of 100 to
    // 10^3, every other one up to 10^9 and the rest up to 50
    let mut seed = 2865;
    let mut total = 0;
    let mut check = 0;
    for c in 0..3030 {
        let small = c < 3000;
        let n = if small { next_random(mut seed) % 8 + 1 } else { next_random(mut seed) % 901 + 100 };
        let top = if small { 6 } else if c % 2 == 0 { 1000000000 } else { 50 };
        let heights: Vec[i64] = (0..n).map(|_| wide(mut seed) % top + 1).collect();
        let best = maximum_sum_of_heights(heights);
        total += best;
        check = (check * 31 + best) % 1000000007;
        if c == 2999 {
            println(f"3000 short arrays: sums total {total}, checksum {check}");
            total = 0;
            check = 0;
        }
    }
    println(f"30 long arrays: sums total {total}, checksum {check}");
}
