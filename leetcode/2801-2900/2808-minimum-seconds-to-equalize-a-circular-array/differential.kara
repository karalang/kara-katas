// LeetCode #2808: Minimum Seconds to Equalize a Circular Array -- the
// differential. The five arms, against the statement read literally: for
// each value, the places that can hold it after each second, every place
// taking its own or a neighbour's of the second before, round the
// circle, until every place can; the least such second over the values,
// and no gaps. 2000 random arrays of 1 to 12 numbers from 1 to 4; then
// 50 of up to 10^4 numbers up to 10^9, from 10 values or from 10^9.
// Every case is drawn before any arm answers; the literal reading is
// asked only of the first 2000.
//
// P1  up to 12 numbers, the seconds are the literal reading's
// P2  0 just when every number is the same
// P3  the circle turned by a third: the same seconds
// P4  the numbers reversed: the same seconds
// P5  the numbers written twice over: the same, and no more than n / 2
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut best = n;
    for v in nums.iter() {
        let mut can: Vec[bool] = nums.iter().map(|x| x == v).collect();
        let mut seconds = 0;
        while can.iter().any(|c| not c) {
            can = (0..n).map(|i| can[i] or can[(i + n - 1) % n] or can[(i + 1) % n]).collect();
            seconds += 1;
        }
        if seconds < best {
            best = seconds;
        }
    }
    best
}


// ---- star (seconds.kara) --------------------------------------------

fn star_minimum_seconds(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut places: Map[i64, Vec[i64]] = Map.new();
    for (i, v) in nums.iter().enumerate() {
        places.entry(v).or_insert(Vec.new()).push(i);
    }
    let mut best = n;
    for (_, at) in places.iter() {
        let mut widest = at[0] + n - at[at.len() - 1];
        for k in 1..at.len() {
            widest = widest.max(at[k] - at[k - 1]);
        }
        best = best.min(widest / 2);
    }
    best
}


// ---- sorted (seconds_sorted.kara) -----------------------------------

fn sorted_minimum_seconds(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut pairs: Vec[(i64, i64)] = nums.iter().enumerate().map(|(i, v)| (v, i)).collect();
    pairs.sort();
    let mut best = n;
    let mut start = 0;
    while start < n {
        let mut end = start;
        let mut widest = 0;
        while end + 1 < n and pairs[end + 1].0 == pairs[start].0 {
            widest = widest.max(pairs[end + 1].1 - pairs[end].1);
            end += 1;
        }
        widest = widest.max(pairs[start].1 + n - pairs[end].1);
        best = best.min(widest / 2);
        start = end + 1;
    }
    best
}


// ---- last (seconds_last.kara) ---------------------------------------

struct Seen {
    first: i64,
    last: i64,
    widest: i64,
}

fn last_minimum_seconds(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut seen: Map[i64, Seen] = Map.new();
    for (i, v) in nums.iter().enumerate() {
        match seen.get_mut(v) {
            Some(s) => {
                s.widest = s.widest.max(i - s.last);
                s.last = i;
            }
            None => {
                seen.insert(v, Seen { first: i, last: i, widest: 0 });
            }
        }
    }
    seen.values().map(|s| s.widest.max(s.first + n - s.last) / 2).min().unwrap()
}


// ---- twice (seconds_twice.kara) -------------------------------------

fn twice_minimum_seconds(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut last: Map[i64, i64] = Map.new();
    let mut widest: Map[i64, i64] = Map.new();
    for i in 0..2 * n {
        let v = nums[i % n];
        if let Some(before) = last.get(v) {
            let gap = i - before;
            let w = widest.entry(v).or_insert(0);
            if gap > *w {
                *w = gap;
            }
        }
        last.insert(v, i);
    }
    let mut best = n;
    for (_, w) in widest.iter() {
        if w / 2 < best {
            best = w / 2;
        }
    }
    best
}


// ---- solution (seconds_solution.kara) -------------------------------

struct Solution {}

impl Solution {
    pub fn minimum_seconds(nums: Vec[i32]) -> i32 {
        let n = nums.len();
        let mut pos: Map[i32, Vec[i64]] = Map.new();
        for (i, x) in nums.iter().enumerate() {
            pos.entry(x).or_insert(Vec.new()).push(i);
        }
        let mut ans = i64.MAX;
        for v in pos.values() {
            let mut gap = v[0] + n - v[v.len() - 1];
            for w in v.windows(2) {
                gap = gap.max(w[1] - w[0]);
            }
            ans = ans.min(gap / 2);
        }
        ans as i32
    }
}

fn solution_minimum_seconds(nums: Vec[i64]) -> i64 {
    Solution.minimum_seconds(nums.iter().map(|x| x as i32).collect())
}


fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_minimum_seconds(nums),
        1 => sorted_minimum_seconds(nums),
        2 => last_minimum_seconds(nums),
        3 => twice_minimum_seconds(nums),
        _ => solution_minimum_seconds(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "sorted", "last", "twice", "solution"];
    let mut seed = 2808;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        if c < 2000 {
            let n = next_random(mut seed) % 12 + 1;
            cases.push((0..n).map(|_| next_random(mut seed) % 4 + 1).collect());
        } else {
            let n = wide(mut seed) % 10000 + 1;
            let top = if c % 2 == 0 { 10 } else { 1000000000 };
            cases.push((0..n).map(|_| wide(mut seed) % top + 1).collect());
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nums) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(nums) } else { 0 };
        check = (check * 31 + want + 1) % 1000000007;
        let n = nums.len();
        let all_same = nums.iter().all(|v| v == nums[0]);
        let turned: Vec[i64] = (0..n).map(|i| nums[(i + n / 3) % n]).collect();
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let twice: Vec[i64] = nums.iter().chain(nums.iter()).collect();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == want,
                (value == 0) == all_same,
                answer(arm, turned) == value,
                answer(arm, reversed) == value,
                answer(arm, twice) == value and value >= 0 and value <= n / 2,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
