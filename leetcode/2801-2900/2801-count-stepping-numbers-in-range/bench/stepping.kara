// LeetCode #2801: Count Stepping Numbers in Range -- the bench: the ★ arm
// over 400 ranges of 100-digit bounds, LeetCode's longest, made mostly
// of steps, all drawn first, then each answered 20 times.

const MOD: i64 = 1000000007;

fn walk(digits: Vec[i64], pos: i64, last: i64, tight: bool, started: bool, memo: mut ref Vec[Vec[i64]]) -> i64 {
    if pos == digits.len() {
        return if started { 1 } else { 0 };
    }
    let free = started and not tight;
    if free and memo[pos][last] >= 0 {
        return memo[pos][last];
    }
    let top = if tight { digits[pos] } else { 9 };
    let mut ways = 0;
    for d in 0..=top {
        let next_tight = tight and d == top;
        if not started {
            ways += walk(digits, pos + 1, d, next_tight, d > 0, mut memo);
        } else if (d - last).abs() == 1 {
            ways += walk(digits, pos + 1, d, next_tight, true, mut memo);
        }
    }
    ways %= MOD;
    if free {
        memo[pos][last] = ways;
    }
    ways
}

fn count_up_to(s: String) -> i64 {
    let digits: Vec[i64] = s.bytes().iter().map(|b| b as i64 - 48).collect();
    let mut memo: Vec[Vec[i64]] = Vec.filled(digits.len(), Vec.filled(10, -1));
    walk(digits, 0, 0, true, false, mut memo)
}

fn steps(s: String) -> bool {
    let b = s.bytes();
    (1..b.len()).all(|i| (b[i] as i64 - b[i - 1] as i64).abs() == 1)
}

fn count_stepping_numbers(low: String, high: String) -> i64 {
    let own = if steps(low) { 1 } else { 0 };
    ((count_up_to(high) - count_up_to(low) + own) % MOD + MOD) % MOD
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn number(m: i64, seed: mut ref i64) -> String {
    let digits = "0123456789";
    let mut d = next_random(mut seed) % 9 + 1;
    let mut s = digits[d..d + 1].to_string();
    for _ in 1..m {
        let r = next_random(mut seed) % 10;
        d = if r < 8 {
            if r % 2 == 0 and d > 0 or d == 9 { d - 1 } else { d + 1 }
        } else {
            r
        };
        s.push_str(digits[d..d + 1]);
    }
    s
}

fn main() {
    let count = 400;
    let rounds = 20;
    let mut seed = 2801;
    let mut cases: Vec[(String, String)] = Vec.new();
    for _ in 0..count {
        let a = number(100, mut seed);
        let b = number(100, mut seed);
        cases.push(if a <= b { (a, b) } else { (b, a) });
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (low, high) in cases.iter() {
            let a = count_stepping_numbers(low, high);
            total += a;
            check = (check * 31 + a + r) % 1000000007;
        }
    }
    println(f"{count} ranges of 100 digits, {rounds} rounds: counts sum to {total}, checksum {check}");
}
