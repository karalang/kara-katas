// LeetCode #2801: Count Stepping Numbers in Range -- by a table: ways[l][d]
// the stepping strings of l digits that start with d, built from l - 1;
// the count to a bound is every stepping number of fewer digits, then,
// along the bound's digits while they still step, every smaller digit
// that steps from the one before, each finished freely; the range is the
// count to high less the count to low - 1, low decreased in its digits.

const MOD: i64 = 1000000007;

fn table(n: i64) -> Vec[Vec[i64]] {
    let mut ways: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(10, 0));
    for d in 0..10 {
        ways[1][d] = 1;
    }
    for l in 2..=n {
        for d in 0..10 {
            let down = if d > 0 { ways[l - 1][d - 1] } else { 0 };
            let up = if d < 9 { ways[l - 1][d + 1] } else { 0 };
            ways[l][d] = (down + up) % MOD;
        }
    }
    ways
}

fn count_up_to(s: String, ways: Vec[Vec[i64]]) -> i64 {
    let digits: Vec[i64] = s.bytes().iter().map(|b| b as i64 - 48).collect();
    let n = digits.len();
    if n == 1 and digits[0] == 0 {
        return 0;
    }
    let mut total = 0;
    for l in 1..n {
        for d in 1..10 {
            total = (total + ways[l][d]) % MOD;
        }
    }
    for d in 1..digits[0] {
        total = (total + ways[n][d]) % MOD;
    }
    for i in 1..n {
        let prev = digits[i - 1];
        for d in 0..digits[i] {
            if (d - prev).abs() == 1 {
                total = (total + ways[n - i][d]) % MOD;
            }
        }
        if (digits[i] - prev).abs() != 1 {
            return total;
        }
    }
    (total + 1) % MOD
}

// the number one less, written without a leading zero
fn decrease(s: String) -> String {
    let mut digits: Vec[u8] = s.bytes().to_vec();
    let mut i = digits.len() - 1;
    while digits[i] == b'0' {
        digits[i] = b'9';
        i -= 1;
    }
    digits[i] -= 1;
    if digits[0] == b'0' and digits.len() > 1 {
        digits.remove(0);
    }
    String.from_utf8(digits).unwrap()
}

fn count_stepping_numbers(low: String, high: String) -> i64 {
    let ways = table(high.len());
    (count_up_to(high, ways) - count_up_to(decrease(low), ways) + MOD) % MOD
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a number of m digits, its first not 0, mostly stepping when `near`
fn number(m: i64, near: bool, seed: mut ref i64) -> String {
    let digits = "0123456789";
    let mut d = next_random(mut seed) % 9 + 1;
    let mut s = digits[d..d + 1].to_string();
    for _ in 1..m {
        let r = next_random(mut seed) % 10;
        d = if near and r < 8 {
            if r % 2 == 0 and d > 0 or d == 9 { d - 1 } else { d + 1 }
        } else {
            r
        };
        s.push_str(digits[d..d + 1]);
    }
    s
}

// the lesser of two numbers written out first
fn ordered(a: String, b: String) -> (String, String) {
    if a.len() < b.len() or (a.len() == b.len() and a <= b) {
        (a.clone(), b.clone())
    } else {
        (b.clone(), a.clone())
    }
}

fn main() {
    // LeetCode's two examples; 1 to 10^100 - 1, LeetCode's widest; a
    // range of one stepping number of 100 digits; the 100-digit numbers
    println(f"{count_stepping_numbers("1", "11")}");
    println(f"{count_stepping_numbers("90", "101")}");
    println(f"{count_stepping_numbers("1", "9".repeat(100))}");
    let one = "10".repeat(50);
    println(f"{count_stepping_numbers(one, one)}");
    let top = f"1{"0".repeat(99)}";
    println(f"{count_stepping_numbers(top, "9".repeat(100))}");
    // 3000 random ranges within 1 to 10^4; then 50 of up to 100 digits,
    // every other one made mostly of steps
    let mut seed = 2801;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let a = next_random(mut seed) % 10000 + 1;
        let b = next_random(mut seed) % 10000 + 1;
        let (low, high) = ordered(f"{a}", f"{b}");
        let ans = count_stepping_numbers(low, high);
        sum += ans;
        check = (check * 31 + ans) % 1000000007;
    }
    println(f"3000 ranges up to 10^4: counts sum to {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for t in 0..50 {
        let near = t % 2 == 0;
        let a = number(next_random(mut seed) % 100 + 1, near, mut seed);
        let b = number(next_random(mut seed) % 100 + 1, near, mut seed);
        let (low, high) = ordered(a, b);
        let ans = count_stepping_numbers(low, high);
        sum += ans;
        check = (check * 31 + ans) % 1000000007;
    }
    println(f"50 ranges of up to 100 digits: counts sum to {sum}, checksum {check}");
}
