// LeetCode #2807: Insert Greatest Common Divisors in Linked List -- the
// differential. The five arms, against the statement read literally: the
// values in order, and between each two the largest number from the
// smaller of them down that divides both; no Euclid and no list. 2000
// random lists of 1 to 12 values up to 30; then 50 of up to 5000 values
// up to 1000, every other one of multiples of 12. Every case is drawn
// before any arm answers; the literal reading is asked only of the first
// 2000. The four own arms share the `shared` list; the solution keeps
// LeetCode's plain one, here `BoxNode`, with `i32` values.
//
// P1  up to 12 values, the list is the literal reading's
// P2  2n - 1 values, the given ones at the even places in order
// P3  each inserted value from 1 to the lesser neighbour, dividing both
// P4  every value doubled: every value of the answer doubled
// P5  the values reversed: the answer reversed
// P6  each arm agrees with at least three of the other four

shared struct ListNode {
    val: i64,
    mut next: Option[ListNode],
}

// ---- the statement read literally ------------------------------------------

fn literal(values: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for i in 0..values.len() {
        out.push(values[i]);
        if i + 1 < values.len() {
            let (a, b) = (values[i], values[i + 1]);
            let mut d = if a < b { a } else { b };
            while a % d != 0 or b % d != 0 {
                d -= 1;
            }
            out.push(d);
        }
    }
    out
}


// ---- star (gcd.kara) ------------------------------------------------

fn star_gcd(a: i64, b: i64) -> i64 {
    let mut (a, b) = (a, b);
    while b != 0 {
        a, b = b, a % b;
    }
    a
}

fn star_insert_greatest_common_divisors(head: Option[ListNode]) -> Option[ListNode] {
    let mut cur = head;
    while let Some(node) = cur {
        let Some(after) = node.next else {
            break;
        };
        node.next = Some(ListNode { val: star_gcd(node.val, after.val), next: Some(after) });
        cur = Some(after);
    }
    head
}


// ---- rec (gcd_rec.kara) ---------------------------------------------

fn rec_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { rec_gcd(b, a % b) }
}

fn rec_insert_greatest_common_divisors(head: Option[ListNode]) -> Option[ListNode] {
    let node = head?;
    if let Some(after) = rec_insert_greatest_common_divisors(node.next) {
        node.next = Some(ListNode { val: rec_gcd(node.val, after.val), next: Some(after) });
    }
    Some(node)
}


// ---- values (gcd_values.kara) ---------------------------------------

fn values_gcd(a: i64, b: i64) -> i64 {
    let mut (a, b) = (a, b);
    while b != 0 {
        a, b = b, a % b;
    }
    a
}

fn values_insert_greatest_common_divisors(head: Option[ListNode]) -> Option[ListNode] {
    let mut values: Vec[i64] = Vec.new();
    let mut cur = head;
    while let Some(node) = cur {
        values.push(node.val);
        cur = node.next;
    }
    let mut out: Vec[i64] = Vec.new();
    for pair in values.windows(2) {
        out.push(pair[0]);
        out.push(values_gcd(pair[0], pair[1]));
    }
    out.push(values[values.len() - 1]);
    let mut list: Option[ListNode] = None;
    for v in out.iter().rev() {
        list = Some(ListNode { val: v, next: list });
    }
    list
}


// ---- binary (gcd_binary.kara) ---------------------------------------

fn binary_gcd(a: i64, b: i64) -> i64 {
    let mut (x, y) = (a, b);
    let mut twos = 0;
    while (x | y) & 1 == 0 {
        x >>= 1;
        y >>= 1;
        twos += 1;
    }
    while x & 1 == 0 {
        x >>= 1;
    }
    while y != 0 {
        while y & 1 == 0 {
            y >>= 1;
        }
        if x > y {
            x, y = y, x;
        }
        y -= x;
    }
    x << twos
}

fn binary_insert_greatest_common_divisors(head: Option[ListNode]) -> Option[ListNode] {
    let Some(first) = head else {
        return None;
    };
    let mut node = first;
    loop {
        match node.next {
            None => break,
            Some(after) => {
                node.next = Some(ListNode { val: binary_gcd(node.val, after.val), next: Some(after) });
                node = after;
            }
        }
    }
    Some(first)
}


// ---- solution (gcd_solution.kara) -----------------------------------

// LeetCode's singly-linked list, renamed `BoxNode` here.
#[derive(PartialEq, Eq, Clone, Debug)]
pub struct BoxNode {
    pub val: i32,
    pub next: Option[BoxNode],
}

impl BoxNode {
    #[inline]
    fn new(val: i32) -> Self {
        BoxNode { next: None, val }
    }
}

fn solution_gcd(a: i32, b: i32) -> i32 {
    if b == 0 { a } else { solution_gcd(b, a % b) }
}

struct Solution {}

impl Solution {
    pub fn insert_greatest_common_divisors(head: own Option[BoxNode]) -> Option[BoxNode] {
        let mut head = head;
        let mut cur = head.as_mut();
        while let Some(node) = cur {
            match node.next.take() {
                Some(next) => {
                    let mut mid = BoxNode.new(solution_gcd(node.val, next.val));
                    mid.next = Some(next);
                    node.next = Some(mid);
                    cur = node.next.as_mut().unwrap().next.as_mut();
                }
                None => break,
            }
        }
        head
    }
}

fn solution_insert_greatest_common_divisors(head: own Option[BoxNode]) -> Option[BoxNode] {
    Solution.insert_greatest_common_divisors(head)
}


fn build(values: Vec[i64]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for v in values.iter().rev() {
        head = Some(ListNode { val: v, next: head });
    }
    head
}

fn values_of(head: Option[ListNode]) -> Vec[i64] {
    let mut out = Vec.new();
    let mut cur = head;
    while let Some(node) = cur {
        out.push(node.val);
        cur = node.next;
    }
    out
}

fn solution_build(values: Vec[i64]) -> Option[BoxNode] {
    let mut head: Option[BoxNode] = None;
    for v in values.iter().rev() {
        head = Some(BoxNode { val: v as i32, next: head });
    }
    head
}

fn solution_values_of(head: Option[BoxNode]) -> Vec[i64] {
    let mut out = Vec.new();
    let mut cur = ref head;
    while let Some(node) = cur {
        out.push(node.val as i64);
        cur = ref node.next;
    }
    out
}

fn answer(arm: i64, values: Vec[i64]) -> Vec[i64] {
    match arm {
        0 => values_of(star_insert_greatest_common_divisors(build(values))),
        1 => values_of(rec_insert_greatest_common_divisors(build(values))),
        2 => values_of(values_insert_greatest_common_divisors(build(values))),
        3 => values_of(binary_insert_greatest_common_divisors(build(values))),
        _ => solution_values_of(solution_insert_greatest_common_divisors(solution_build(values))),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn digest(xs: Vec[i64]) -> i64 {
    xs.iter().fold(0, |h, x| (h * 131 + x) % 1000000007)
}

fn main() {
    let names = ["star", "rec", "values", "binary", "solution"];
    let mut seed = 2807;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        if c < 2000 {
            let n = next_random(mut seed) % 12 + 1;
            cases.push((0..n).map(|_| next_random(mut seed) % 30 + 1).collect());
        } else {
            let n = next_random(mut seed) % 5000 + 1;
            let step = if c % 2 == 0 { 12 } else { 1 };
            cases.push((0..n).map(|_| (next_random(mut seed) % (1000 / step) + 1) * step).collect());
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, values) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(values) } else { Vec.new() };
        check = (check * 31 + digest(want) + 1) % 1000000007;
        let n = values.len();
        let doubled: Vec[i64] = values.iter().map(|v| 2 * v).collect();
        let reversed: Vec[i64] = values.iter().rev().collect();
        let got: Vec[Vec[i64]] = (0..5).map(|arm| answer(arm, values)).collect();
        for arm in 0..5 {
            let out = got[arm].clone();
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == out {
                    same += 1;
                }
            }
            let shaped = out.len() == 2 * n - 1 and (0..n).all(|i| out[2 * i] == values[i]);
            let divides = shaped and (0..n - 1).all(|i| {
                let (a, g, b) = (out[2 * i], out[2 * i + 1], out[2 * i + 2]);
                g >= 1 and g <= a and g <= b and a % g == 0 and b % g == 0
            });
            let twice: Vec[i64] = out.iter().map(|v| 2 * v).collect();
            let back: Vec[i64] = out.iter().rev().collect();
            let verdicts = [
                not small or out == want,
                shaped,
                divides,
                answer(arm, doubled) == twice,
                answer(arm, reversed) == back,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {values}, arm {names[arm]}: P{q + 1} fails, gave {out}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
