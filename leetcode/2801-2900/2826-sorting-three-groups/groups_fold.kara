// LeetCode #2826: Sorting Three Groups -- removals folded: a tuple of the
// fewest removals so far for an array ending in a 1, in at most a 2, and
// in at most a 3, carried through `fold`; a number costs one removal in
// every state it cannot end.

fn minimum_operations(nums: Vec[i64]) -> i64 {
    let (_, _, three) = nums.iter().fold((0, 0, 0), |(one, two, three), x| {
        let one2 = one + if x == 1 { 0 } else { 1 };
        let two2 = one2.min(two + if x == 2 { 0 } else { 1 });
        let three2 = two2.min(three + if x == 3 { 0 } else { 1 });
        (one2, two2, three2)
    });
    three
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; one number; 100 numbers falling 3, 2, 1
    // in runs of 34, 33 and 33; and 100 rising
    println(f"{minimum_operations([2, 1, 3, 2, 1])}");
    println(f"{minimum_operations([1, 3, 2, 1, 3, 3])}");
    println(f"{minimum_operations([2, 2, 2, 2, 3, 3])}");
    println(f"{minimum_operations([3])}");
    println(f"{minimum_operations((0..100).map(|i| 3 - i * 3 / 100).collect())}");
    println(f"{minimum_operations((0..100).map(|i| 1 + i * 3 / 100).collect())}");
    // 5000 random arrays of 1 to 100 numbers from 1 to 3
    let mut seed = 2826;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..5000 {
        let n = next_random(mut seed) % 100 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 3 + 1).collect();
        let a = minimum_operations(nums);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"5000 arrays: {total} removals, checksum {check}");
}
