// LeetCode #2826: Sorting Three Groups -- the bench: the ★ arm over
// 200000 arrays of 100 numbers from 1 to 3, LeetCode's most, all drawn
// first, then each answered 5 times.

fn minimum_operations(nums: Vec[i64]) -> i64 {
    let mut best = [0, 0, 0];
    for x in nums.iter() {
        let v = x - 1;
        best[v] += 1;
        for w in v + 1..3 {
            best[w] = best[w].max(best[v]);
        }
    }
    nums.len() - best[2]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 200000;
    let rounds = 5;
    let mut seed = 2826;
    let cases: Vec[Vec[i64]] = (0..count).map(|_| (0..100).map(|_| next_random(mut seed) % 3 + 1).collect()).collect();
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in cases.iter() {
            let a = minimum_operations(nums);
            total += a;
            check = (check * 31 + a + r) % 1000000007;
        }
    }
    println(f"{count} arrays of 100, {rounds} rounds: {total} removals, checksum {check}");
}
