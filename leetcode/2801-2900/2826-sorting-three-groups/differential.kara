// LeetCode #2826: Sorting Three Groups -- the differential. The five
// arms, against the statement read literally: every set of numbers
// removed, by a bit mask, kept when what is left is non-decreasing, and
// the fewest removed. 2000 random arrays of 1 to 12 numbers from 1 to 3;
// then 50 of up to 500. Every case is drawn before any arm answers; the
// literal reading is asked only of the first 2000.
//
// P1  up to 12 numbers, the answer is the literal reading's
// P2  every v as 4 - v and the order reversed: the same answer
// P3  a 3 put at the end: the same answer
// P4  a 1 put at the front: the same answer
// P5  the numbers kept are at least the count of the commonest value,
//     and at most all of them
// P6  each arm agrees with at least three of the other four


// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut fewest = n;
    for mask in 0..(1 << n) {
        let kept: Vec[i64] = (0..n).filter(|i| (mask >> i) & 1 == 0).map(|i| nums[i]).collect();
        if kept.windows(2).into_iter().all(|w| w[0] <= w[1]) {
            fewest = fewest.min(n - kept.len());
        }
    }
    fewest
}


// ---- star (groups.kara) ---------------------------------------------

fn star_minimum_operations(nums: Vec[i64]) -> i64 {
    let mut best = [0, 0, 0];
    for x in nums.iter() {
        let v = x - 1;
        best[v] += 1;
        for w in v + 1..3 {
            best[w] = best[w].max(best[v]);
        }
    }
    nums.len() - best[2]
}


// ---- tails (groups_tails.kara) --------------------------------------

fn tails_minimum_operations(nums: Vec[i64]) -> i64 {
    let mut tails: Vec[i64] = Vec.new();
    for x in nums.iter() {
        let at = tails.partition_point(|t| t <= x);
        if at == tails.len() {
            tails.push(x);
        } else {
            tails[at] = x;
        }
    }
    nums.len() - tails.len()
}


// ---- cuts (groups_cuts.kara) ----------------------------------------

fn cuts_minimum_operations(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut counts: Vec[Array[i64, 3]] = Vec.filled(n + 1, [0, 0, 0]);
    for i in 0..n {
        counts[i + 1] = counts[i];
        counts[i + 1][nums[i] - 1] += 1;
    }
    let total = counts[n];
    let mut fewest = n;
    for i in 0..=n {
        for j in i..=n {
            let ones = counts[i][0];
            let twos = counts[j][1] - counts[i][1];
            let threes = total[2] - counts[j][2];
            fewest = fewest.min(n - ones - twos - threes);
        }
    }
    fewest
}


// ---- fold (groups_fold.kara) ----------------------------------------

fn fold_minimum_operations(nums: Vec[i64]) -> i64 {
    let (_, _, three) = nums.iter().fold((0, 0, 0), |(one, two, three), x| {
        let one2 = one + if x == 1 { 0 } else { 1 };
        let two2 = one2.min(two + if x == 2 { 0 } else { 1 });
        let three2 = two2.min(three + if x == 3 { 0 } else { 1 });
        (one2, two2, three2)
    });
    three
}


// ---- solution (groups_solution.kara) --------------------------------

struct Solution {}

impl Solution {
    pub fn minimum_operations(nums: Vec[i32]) -> i32 {
        let mut f = [0; 3];
        for x in nums.iter() {
            let mut g = [0; 3];
            for j in 0..3 {
                let best = *f[..=j].iter().min().unwrap();
                g[j] = best + if x as usize == j + 1 { 0 } else { 1 };
            }
            f = g;
        }
        *f.iter().min().unwrap()
    }
}

fn solution_minimum_operations(nums: Vec[i64]) -> i64 {
    Solution.minimum_operations(nums.iter().map(|v| v as i32).collect())
}


// ---- the checks ------------------------------------------------------------

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_minimum_operations(nums),
        1 => tails_minimum_operations(nums),
        2 => cuts_minimum_operations(nums),
        3 => fold_minimum_operations(nums),
        _ => solution_minimum_operations(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "tails", "cuts", "fold", "solution"];
    let mut seed = 2826;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        let n = if c < 2000 { next_random(mut seed) % 12 + 1 } else { next_random(mut seed) % 500 + 1 };
        cases.push((0..n).map(|_| next_random(mut seed) % 3 + 1).collect());
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nums) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(nums) } else { 0 };
        check = (check * 31 + want + 1) % 1000000007;
        let n = nums.len();
        let mirrored: Vec[i64] = nums.iter().rev().map(|v| 4 - v).collect();
        let mut ended = nums.clone();
        ended.push(3);
        let mut started = [1];
        started.extend(nums.iter());
        let commonest = (1..=3).map(|v| nums.iter().filter(|x| x == v).count()).max().unwrap();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == want,
                answer(arm, mirrored) == value,
                answer(arm, ended) == value,
                answer(arm, started) == value,
                n - value >= commonest and value >= 0,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
