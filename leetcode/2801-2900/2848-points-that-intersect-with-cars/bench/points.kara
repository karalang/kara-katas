// LeetCode #2848: Points That Intersect With Cars -- the bench: the ★
// arm over 10^4 random parkings of 1 to 100 cars on a road of 100,
// LeetCode's most, all drawn first, then each answered 50 times.

fn number_of_points(nums: Vec[Vec[i64]]) -> i64 {
    let mut covered = [false; 101];
    for car in nums.iter() {
        for x in car[0]..car[1] + 1 {
            covered[x] = true;
        }
    }
    covered.iter().filter(|c| c).count()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 10000;
    let rounds = 50;
    let mut seed = 2848;
    let mut parkings: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..count {
        let cars = next_random(mut seed) % 100 + 1;
        let nums: Vec[Vec[i64]] = (0..cars)
            .map(|_| {
                let start = next_random(mut seed) % 100 + 1;
                let length = next_random(mut seed) % (next_random(mut seed) % 100 + 1);
                [start, (start + length).min(100)]
            })
            .collect();
        parkings.push(nums);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in parkings.iter() {
            let points = number_of_points(nums);
            total += points;
            check = (check * 31 + points + r) % 1000000007;
        }
    }
    println(f"{count} parkings, {rounds} rounds: {total} points, checksum {check}");
}
