// LeetCode #2848: Points That Intersect With Cars -- the differential.
// The five arms, against the statement read literally: every integer
// point from 1 to 100 asked whether any car's start is at or before it
// and its end at or after it. 2000 random parkings of 1 to 6 cars
// within 1 to 20, then 50 of 1 to 100 cars within 1 to 100, all drawn
// before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the cars in the other order: the same answer
// P3  the road mirrored, x made 101 - x: the same answer
// P4  the first car parked twice: the same answer
// P5  a car over the whole road added: 100
// P6  each arm agrees with at least three of the other four

fn literal(nums: Vec[Vec[i64]]) -> i64 {
    (1..101).filter(|x| nums.iter().any(|car| car[0] <= x and x <= car[1])).count()
}


// ---- star (points.kara) ---------------------------------------------

fn star_number_of_points(nums: Vec[Vec[i64]]) -> i64 {
    let mut covered = [false; 101];
    for car in nums.iter() {
        for x in car[0]..car[1] + 1 {
            covered[x] = true;
        }
    }
    covered.iter().filter(|c| c).count()
}


// ---- merge (points_merge.kara) --------------------------------------

fn merge_number_of_points(nums: Vec[Vec[i64]]) -> i64 {
    let mut cars: Vec[(i64, i64)] = nums.iter().map(|c| (c[0], c[1])).collect();
    cars.sort_by_key(|c| c.0);
    let mut total = 0;
    let mut (lo, hi) = cars[0];
    for (start, end) in cars[1..].iter() {
        if start > hi + 1 {
            total += hi - lo + 1;
            lo = start;
            hi = end;
        } else {
            hi = hi.max(end);
        }
    }
    total + hi - lo + 1
}


// ---- sweep (points_sweep.kara) --------------------------------------

fn sweep_number_of_points(nums: Vec[Vec[i64]]) -> i64 {
    let mut change: Vec[i64] = Vec.filled(102, 0);
    for car in nums.iter() {
        change[car[0]] += 1;
        change[car[1] + 1] -= 1;
    }
    change
        .iter()
        .scan(0, |cars, d| { let cars = cars + d; Some((cars, cars)) })
        .filter(|cars| cars > 0)
        .count()
}


// ---- set (points_set.kara) ------------------------------------------

fn set_number_of_points(nums: Vec[Vec[i64]]) -> i64 {
    let points: Set[i64] = nums.iter().flat_map(|car| car[0]..car[1] + 1).collect();
    points.len()
}


// ---- solution (points_solution.kara) --------------------------------

struct Solution {}

impl Solution {
    pub fn number_of_points(nums: Vec[Vec[i32]]) -> i32 {
        let mut seen = [false; 102];
        for v in nums.iter() {
            for x in v[0] as usize..=v[1] as usize {
                seen[x] = true;
            }
        }
        seen.iter().filter(|b| b).count() as i32
    }
}

fn solution_number_of_points(nums: Vec[Vec[i64]]) -> i64 {
    let v: Vec[Vec[i32]] = nums.iter().map(|c| c.iter().map(|x| x as i32).collect()).collect();
    Solution.number_of_points(v)
}


// ---- the check ---------------------------------------------------------

fn answer(arm: i64, nums: Vec[Vec[i64]]) -> i64 {
    match arm {
        0 => star_number_of_points(nums),
        1 => merge_number_of_points(nums),
        2 => sweep_number_of_points(nums),
        3 => set_number_of_points(nums),
        _ => solution_number_of_points(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "merge", "sweep", "set", "solution"];
    let mut seed = 2848;
    let mut cases: Vec[Vec[Vec[i64]]] = Vec.new();
    for c in 0..2050 {
        let short = c < 2000;
        let cars = if short { next_random(mut seed) % 6 + 1 } else { next_random(mut seed) % 100 + 1 };
        let road = if short { 20 } else { 100 };
        let nums: Vec[Vec[i64]] = (0..cars)
            .map(|_| {
                let start = next_random(mut seed) % road + 1;
                let length = next_random(mut seed) % (next_random(mut seed) % road + 1);
                [start, (start + length).min(road)]
            })
            .collect();
        cases.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nums) in cases.iter().enumerate() {
        let want = literal(nums);
        check = (check * 31 + want) % 1000000007;
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        let back: Vec[Vec[i64]] = nums.iter().rev().cloned().collect();
        let mirrored: Vec[Vec[i64]] = nums.iter().map(|car| [101 - car[1], 101 - car[0]]).collect();
        let mut twice = nums.clone();
        twice.push(nums[0].clone());
        let mut whole = nums.clone();
        whole.push([1, 100]);
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == want,
                answer(arm, back) == value,
                answer(arm, mirrored) == value,
                answer(arm, twice) == value,
                answer(arm, whole) == 100,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
