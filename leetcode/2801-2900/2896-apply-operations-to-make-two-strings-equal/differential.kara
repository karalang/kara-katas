// LeetCode #2896: Apply Operations to Make Two Strings Equal -- the
// differential. The five arms, against the statement read literally:
// s1 as a bit mask, every operation an edge, x for any two places and 1
// for two neighbours, and the cheapest way to s2 found by Dijkstra's
// search with a `PriorityQueue`, -1 when s2 is never reached. 2000
// random pairs of 1 to 7 characters with x 1 to 5, then 50 of up to 500,
// x up to 500, every other one with s2 a few flips from s1, all drawn
// before any arm answers; the literal reading is asked only of the
// first 2000.
//
// P1  up to 7 characters, the answer is the literal reading's
// P2  s1 and s2 swapped: the same answer
// P3  both reversed: the same answer
// P4  x doubled: -1 still, or from the answer to twice it
// P5  -1 exactly when an odd number of places differ, else from half
//     that number to x times it; and s1 against itself costs 0
// P6  each arm agrees with at least three of the other four

fn literal(s1: String, s2: String, x: i64) -> i64 {
    let n = s1.len();
    let start = s1.chars().fold(0, |m, c| m * 2 + (if c == '1' { 1 } else { 0 }));
    let goal = s2.chars().fold(0, |m, c| m * 2 + (if c == '1' { 1 } else { 0 }));
    let mut cost: Vec[i64] = Vec.filled(1 << n, -1);
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    cost[start] = 0;
    queue.push((0, start));
    while let Some((d, u)) = queue.pop() {
        if d > cost[u] {
            continue;
        }
        if u == goal {
            return d;
        }
        for i in 0..n {
            for j in i + 1..n {
                let step = if j == i + 1 { x.min(1) } else { x };
                let v = u ^ (1 << i) ^ (1 << j);
                if cost[v] < 0 or d + step < cost[v] {
                    cost[v] = d + step;
                    queue.push((d + step, v));
                }
            }
        }
    }
    -1
}


// ---- star (flips.kara) ----------------------------------------------

fn star_min_operations(s1: String, s2: String, x: i64) -> i64 {
    let a: Vec[char] = s1.chars().collect();
    let b: Vec[char] = s2.chars().collect();
    let places: Vec[i64] = (0..a.len()).filter(|i| a[i] != b[i]).collect();
    let m = places.len();
    if m % 2 == 1 {
        return -1;
    }
    let mut doubled: Vec[i64] = Vec.filled(m + 1, 0);
    for i in 1..m + 1 {
        doubled[i] = doubled[i - 1] + x;
        if i >= 2 {
            doubled[i] = doubled[i].min(doubled[i - 2] + 2 * (places[i - 1] - places[i - 2]));
        }
    }
    doubled[m] / 2
}


// ---- memo (flips_memo.kara) -----------------------------------------

fn memo_best_from(i: i64, places: Vec[i64], x: i64, memo: mut ref Vec[i64]) -> i64 {
    if i >= places.len() {
        return 0;
    }
    if memo[i] >= 0 {
        return memo[i];
    }
    let mut best = x + memo_best_from(i + 1, places, x, mut memo);
    if i + 1 < places.len() {
        best = best.min(2 * (places[i + 1] - places[i]) + memo_best_from(i + 2, places, x, mut memo));
    }
    memo[i] = best;
    best
}

fn memo_min_operations(s1: String, s2: String, x: i64) -> i64 {
    let places: Vec[i64] = s1.bytes().iter().zip(s2.bytes().iter()).enumerate().filter(|(_, (p, q))| p != q).map(|(i, _)| i).collect();
    if places.len() % 2 == 1 {
        return -1;
    }
    let mut memo: Vec[i64] = Vec.filled(places.len(), -1);
    memo_best_from(0, places, x, mut memo) / 2
}


// ---- states (flips_states.kara) -------------------------------------

fn states_min_operations(s1: String, s2: String, x: i64) -> i64 {
    let a = s1.bytes();
    let b = s2.bytes();
    let n = a.len();
    let unreachable = i64.MAX / 4;
    // best[carry * 2 + waiting]
    let mut best = [0, unreachable, unreachable, unreachable];
    for i in 0..n {
        let mut next = [unreachable, unreachable, unreachable, unreachable];
        for carry in 0..2 {
            for waiting in 0..2 {
                let cost = best[carry * 2 + waiting];
                if cost >= unreachable {
                    continue;
                }
                let different = (if a[i] != b[i] { 1 } else { 0 }) ^ carry;
                if different == 0 {
                    next[waiting] = next[waiting].min(cost);
                } else {
                    if i + 1 < n {
                        next[2 + waiting] = next[2 + waiting].min(cost + 2);
                    }
                    next[1 - waiting] = next[1 - waiting].min(cost + x);
                }
            }
        }
        best = next;
    }
    if best[0] >= unreachable { -1 } else { best[0] / 2 }
}


// ---- rolling (flips_rolling.kara) -----------------------------------

fn rolling_min_operations(s1: String, s2: String, x: i64) -> i64 {
    let mut before = 0;
    let mut now = 0;
    let mut last = -1;
    let mut count = 0;
    for (i, (p, q)) in s1.chars().zip(s2.chars()).enumerate() {
        if p == q {
            continue;
        }
        let mut next = now + x;
        if count > 0 {
            next = next.min(before + 2 * (i - last));
        }
        before = now;
        now = next;
        last = i;
        count += 1;
    }
    if count % 2 == 1 { -1 } else { now / 2 }
}


// ---- solution (flips_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn min_operations(s1: String, s2: String, x: i32) -> i32 {
        let a = s1.bytes();
        let b = s2.bytes();
        let p: Vec[i64] = (0..a.len()).filter(|i| a[i] != b[i]).collect();
        if p.len() % 2 == 1 {
            return -1;
        }
        if p.is_empty() {
            return 0;
        }
        let mut f = Vec.filled(p.len() + 1, 0i32);
        f[1] = x;
        for i in 1..p.len() {
            f[i + 1] = (f[i] + x).min(f[i - 1] + (p[i] - p[i - 1]) as i32 * 2);
        }
        f[p.len()] / 2
    }
}

fn solution_min_operations(s1: String, s2: String, x: i64) -> i64 {
    Solution.min_operations(s1, s2, x as i32)
}

// ---- the check ---------------------------------------------------------

fn answer(arm: i64, s1: String, s2: String, x: i64) -> i64 {
    match arm {
        0 => star_min_operations(s1, s2, x),
        1 => memo_min_operations(s1, s2, x),
        2 => states_min_operations(s1, s2, x),
        3 => rolling_min_operations(s1, s2, x),
        _ => solution_min_operations(s1, s2, x),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn bits(n: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(if next_random(mut seed) % 2 == 0 { '0' } else { '1' });
    }
    s
}

fn main() {
    let names = ["star", "memo", "states", "rolling", "solution"];
    let mut seed = 2896;
    let mut cases: Vec[(String, String, i64)] = Vec.new();
    for c in 0..2050 {
        let small = c < 2000;
        let n = if small { next_random(mut seed) % 7 + 1 } else { next_random(mut seed) % 500 + 1 };
        let x = if small { next_random(mut seed) % 5 + 1 } else { next_random(mut seed) % 500 + 1 };
        let s1 = bits(n, mut seed);
        let s2 = if small or c % 2 == 0 {
            bits(n, mut seed)
        } else {
            let mut chars: Vec[char] = s1.chars().collect();
            for _ in 0..next_random(mut seed) % 20 {
                let at = next_random(mut seed) % n;
                chars[at] = if chars[at] == '0' { '1' } else { '0' };
            }
            chars.iter().collect()
        };
        cases.push((s1, s2, x));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut total = 0;
    for (c, (s1, s2, x)) in cases.iter().enumerate() {
        let n = s1.len();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, s1, s2, x)).collect();
        let want = if c < 2000 { literal(s1, s2, x) } else { got[0] };
        total += want;
        check = (check * 31 + want + 1) % 1000000007;
        let back1: String = s1.chars().rev().collect();
        let back2: String = s2.chars().rev().collect();
        let differ = s1.chars().zip(s2.chars()).filter(|(p, q)| p != q).count();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let dearer = answer(arm, s1, s2, 2 * x);
            let verdicts = [
                c >= 2000 or value == want,
                answer(arm, s2, s1, x) == value,
                answer(arm, back1, back2, x) == value,
                if value < 0 { dearer < 0 } else { dearer >= value and dearer <= 2 * value },
                (value == -1) == (differ % 2 == 1) and (value == -1 or (value >= differ / 2 and value <= differ * x)) and answer(arm, s1, s1, x) == 0,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} n {n} x {x}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases, costs total {total}: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
