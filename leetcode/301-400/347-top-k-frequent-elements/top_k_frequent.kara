// LeetCode 347 — Top K Frequent Elements.
//
// Tally into a Map, walk `keys()` to recover the distinct values, then order
// them by count descending (ties broken by value ascending, so the answer is
// deterministic — LeetCode itself accepts any order) and take the first k.
//
// The `for v in counts.keys()` walk is the point of interest: with scalar key
// and value halves it lowers to an inline bucket walk with no runtime iterator
// call. See top_k_frequent_words.kara for the String-keyed sibling, which
// takes a different path through codegen.

fn top_k_frequent(nums: ref Vec[i64], k: i64) -> Vec[i64] {
    let mut counts: Map[i64, i64] = Map.new();
    let mut i = 0i64;
    while i < nums.len() {
        let v = nums[i];
        let n = match counts.get(v) { Some(c) => c, None => 0i64 };
        let _ = counts.insert(v, n + 1i64);
        i = i + 1i64;
    }

    let mut vals: Vec[i64] = Vec.new();
    for v in counts.keys() {
        vals.push(v);
    }

    // Insertion sort by (count desc, value asc).
    let mut a = 1i64;
    while a < vals.len() {
        let cur = vals[a];
        let cur_c = match counts.get(cur) { Some(c) => c, None => 0i64 };
        let mut b = a - 1i64;
        while b >= 0i64 {
            let prev = vals[b];
            let prev_c = match counts.get(prev) { Some(c) => c, None => 0i64 };
            let mut shift = false;
            if prev_c < cur_c { shift = true; }
            if prev_c == cur_c {
                if prev > cur { shift = true; }
            }
            if not shift { break; }
            vals[b + 1i64] = prev;
            b = b - 1i64;
        }
        vals[b + 1i64] = cur;
        a = a + 1i64;
    }

    let mut limit = k;
    if vals.len() < limit { limit = vals.len(); }
    let mut out: Vec[i64] = Vec.new();
    let mut t = 0i64;
    while t < limit {
        out.push(vals[t]);
        t = t + 1i64;
    }
    out
}

fn show(nums: ref Vec[i64], k: i64) {
    let got = top_k_frequent(nums, k);
    let mut s = String.new();
    let mut i = 0i64;
    while i < got.len() {
        if i > 0i64 { s = s + ","; }
        s = s + f"{got[i]}";
        i = i + 1i64;
    }
    println(f"k={k} -> [{s}]");
}

fn main() {
    let mut a: Vec[i64] = Vec.new();
    a.push(1i64); a.push(1i64); a.push(1i64); a.push(2i64); a.push(2i64); a.push(3i64);
    show(a, 2i64);

    let mut b: Vec[i64] = Vec.new();
    b.push(1i64);
    show(b, 1i64);

    // Negative values, and a count tie broken by value ascending.
    let mut c: Vec[i64] = Vec.new();
    c.push(4i64); c.push(1i64); c.push(-1i64); c.push(2i64);
    c.push(-1i64); c.push(2i64); c.push(3i64);
    show(c, 2i64);

    // All counts equal — pure value-ascending tie-break.
    let mut d: Vec[i64] = Vec.new();
    d.push(5i64); d.push(5i64); d.push(4i64); d.push(4i64); d.push(3i64); d.push(3i64);
    show(d, 3i64);

    // k larger than the number of distinct values.
    let mut e: Vec[i64] = Vec.new();
    e.push(7i64); e.push(7i64); e.push(8i64);
    show(e, 5i64);
}
