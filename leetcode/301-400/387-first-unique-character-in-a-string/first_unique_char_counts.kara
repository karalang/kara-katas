// LeetCode 387 — fixed-alphabet variant.
//
// The constraint says `s` is lowercase English letters only, so a 26-slot
// count array replaces the Map: no hashing, no allocation beyond one Vec.
// Kept alongside the Map version because each is a distinct codegen surface —
// this one exercises indexed Vec accumulate + a bounds-checked scan, the other
// exercises map insert / get / keys().

fn first_uniq_char(s: ref String) -> i64 {
    let bs = s.bytes();
    let mut counts: Vec[i64] = Vec.new();
    let mut k = 0i64;
    while k < 26i64 { counts.push(0i64); k = k + 1i64; }

    let mut i = 0i64;
    while i < bs.len() {
        let idx = (bs[i] - b'a') as i64;
        counts[idx] = counts[idx] + 1i64;
        i = i + 1i64;
    }

    let mut j = 0i64;
    while j < bs.len() {
        let idx = (bs[j] - b'a') as i64;
        if counts[idx] == 1i64 { return j; }
        j = j + 1i64;
    }
    -1i64
}

fn unique_count(s: ref String) -> i64 {
    let bs = s.bytes();
    let mut counts: Vec[i64] = Vec.new();
    let mut k = 0i64;
    while k < 26i64 { counts.push(0i64); k = k + 1i64; }
    let mut i = 0i64;
    while i < bs.len() {
        let idx = (bs[i] - b'a') as i64;
        counts[idx] = counts[idx] + 1i64;
        i = i + 1i64;
    }
    let mut uniq = 0i64;
    let mut c = 0i64;
    while c < 26i64 {
        if counts[c] == 1i64 { uniq = uniq + 1i64; }
        c = c + 1i64;
    }
    uniq
}

fn report(s: ref String) {
    println(f"{s} -> {first_uniq_char(s)} (uniq={unique_count(s)})");
}

fn main() {
    report("leetcode");
    report("loveleetcode");
    report("aabb");
    report("z");
    report("");
    report("abcabcd");
}
