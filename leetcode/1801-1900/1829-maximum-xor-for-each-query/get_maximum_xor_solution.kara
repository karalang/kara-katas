// LeetCode #1829: Maximum XOR for Each Query -- a Rust solution as LeetCode's
// Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn get_maximum_xor(nums: Vec[i32], maximum_bit: i32) -> Vec[i32] {
        let mask: i32 = (1 << maximum_bit) - 1;
        let mut x = nums.iter().fold(0i32, |acc, n| acc ^ n);
        let mut ans: Vec[i32] = Vec.with_capacity(nums.len());
        for n in nums.iter().rev() {
            ans.push(x ^ mask);
            x ^= n;
        }
        ans
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{Solution.get_maximum_xor([0, 1, 1, 3], 2)} {Solution.get_maximum_xor([2, 3, 4, 7], 3)} {Solution.get_maximum_xor([0, 1, 2, 2, 5, 7], 3)}");
    // the edges: one zero on one bit; one number with every bit set; equal
    // numbers, whose XOR comes and goes; the most bits
    println(f"{Solution.get_maximum_xor([0], 1)} {Solution.get_maximum_xor([7], 3)} {Solution.get_maximum_xor([5, 5, 5, 5], 3)} {Solution.get_maximum_xor([0, 1, 1048575], 20)}");
    // the constraints' most: 10^5 sorted numbers below 2^20, the answers
    // summed, with the first and the last
    let mut seed = 1829;
    let mut big: Vec[i32] = (0..100000).map(|_| ((next_random(mut seed) * 32768 + next_random(mut seed)) % 1048576) as i32).collect();
    big.sort();
    let answer = Solution.get_maximum_xor(big, 20);
    let total: i64 = answer.iter().map(|k| k as i64).sum();
    println(f"the most: {total} {answer[0]} {answer[99999]}");
    // 3000 random cases of 1 to 10 sorted numbers below 2^b, b from 1 to 5
    let mut check = 0;
    for _ in 0..3000 {
        let bits = 1 + next_random(mut seed) % 5;
        let n = 1 + next_random(mut seed) % 10;
        let mut nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % (1 << bits)) as i32).collect();
        nums.sort();
        for k in Solution.get_maximum_xor(nums, bits as i32).iter() {
            check = (check * 31 + *k) % 1000000007;
        }
    }
    println(f"3000 random cases: checksum {check}");
}
