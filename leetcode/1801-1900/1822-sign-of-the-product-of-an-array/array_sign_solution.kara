// LeetCode #1822: Sign of the Product of an Array -- a Rust solution as
// LeetCode's Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn array_sign(nums: Vec[i32]) -> i32 {
        nums.iter().map(|x| x.signum()).product()
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{Solution.array_sign([-1, -2, -3, -4, 3, 2, 1])} {Solution.array_sign([1, 5, 0, 2, -3])} {Solution.array_sign([-1, 1, -1, 1, -1])}");
    // the edges: one number of each sign; the values at their ends; a zero
    // at the very end of the negatives
    println(f"{Solution.array_sign([7])} {Solution.array_sign([-7])} {Solution.array_sign([0])} {Solution.array_sign([-100, 100])} {Solution.array_sign([-100, -100, -100])} {Solution.array_sign([-1, -1, -1, 0])}");
    // the constraints' most: 1000 numbers of -100, whose product no integer
    // holds, and 999 of them with a 1
    let n = 1000;
    let all: Vec[i32] = Vec.filled(n, -100);
    let mut odd: Vec[i32] = Vec.filled(n - 1, -100);
    odd.push(1);
    println(f"the most: {Solution.array_sign(all)} {Solution.array_sign(odd)}");
    // 3000 random cases of 1 to 12 numbers from -100 to 100, one in 30 of
    // them made a zero
    let mut seed = 1822;
    let mut check = 0;
    let mut tally: Vec[i64] = Vec.filled(3, 0);
    for _ in 0..3000 {
        let len = 1 + next_random(mut seed) % 12;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..len {
            let x = next_random(mut seed) % 201 - 100;
            nums.push(if next_random(mut seed) % 30 == 0 { 0 } else { x as i32 });
        }
        let sign = Solution.array_sign(nums) as i64;
        tally[sign + 1] += 1;
        check = (check * 3 + sign + 1) % 1000000007;
    }
    println(f"3000 random cases: {tally[0]} negative, {tally[1]} zero, {tally[2]} positive, checksum {check}");
}
