// LeetCode #1822: Sign of the Product of an Array -- the signs multiplied
// in place of the numbers: `signum` folded over the list by `*`, which stays
// in -1, 0 and 1.
// O(n)

fn array_sign(nums: Vec[i64]) -> i64 {
    nums.iter().fold(1, |sign, x| sign * x.signum())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{array_sign([-1, -2, -3, -4, 3, 2, 1])} {array_sign([1, 5, 0, 2, -3])} {array_sign([-1, 1, -1, 1, -1])}");
    // the edges: one number of each sign; the values at their ends; a zero
    // at the very end of the negatives
    println(f"{array_sign([7])} {array_sign([-7])} {array_sign([0])} {array_sign([-100, 100])} {array_sign([-100, -100, -100])} {array_sign([-1, -1, -1, 0])}");
    // the constraints' most: 1000 numbers of -100, whose product no integer
    // holds, and 999 of them with a 1
    let n = 1000;
    let all: Vec[i64] = Vec.filled(n, -100);
    let mut odd: Vec[i64] = Vec.filled(n - 1, -100);
    odd.push(1);
    println(f"the most: {array_sign(all)} {array_sign(odd)}");
    // 3000 random cases of 1 to 12 numbers from -100 to 100, one in 30 of
    // them made a zero
    let mut seed = 1822;
    let mut check = 0;
    let mut tally: Vec[i64] = Vec.filled(3, 0);
    for _ in 0..3000 {
        let len = 1 + next_random(mut seed) % 12;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..len {
            let x = next_random(mut seed) % 201 - 100;
            nums.push(if next_random(mut seed) % 30 == 0 { 0 } else { x });
        }
        let sign = array_sign(nums);
        tally[sign + 1] += 1;
        check = (check * 3 + sign + 1) % 1000000007;
    }
    println(f"3000 random cases: {tally[0]} negative, {tally[1]} zero, {tally[2]} positive, checksum {check}");
}
