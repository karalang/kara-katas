// LeetCode #1833: Maximum Ice Cream Bars -- the ★ arm, by counting sort as
// the problem asks: how many bars cost each price, counted up to the
// dearest, and the prices walked from the cheapest, buying at each as many
// of its bars as the coins left will pay for.
// O(n + M), M the dearest price

fn max_ice_cream(costs: Vec[i64], coins: i64) -> i64 {
    let dearest = costs.iter().max().unwrap();
    let mut count: Vec[i64] = Vec.filled(dearest + 1, 0);
    for c in costs.iter() {
        count[c] += 1;
    }
    let mut left = coins;
    let mut bars = 0;
    for price in 1..dearest + 1 {
        if price > left {
            break;
        }
        let bought = count[price].min(left / price);
        bars += bought;
        left -= bought * price;
    }
    bars
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{max_ice_cream([1, 3, 2, 4, 1], 7)} {max_ice_cream([10, 6, 8, 7, 7, 8], 5)} {max_ice_cream([1, 6, 3, 1, 2, 5], 20)}");
    // the edges: one bar the coins just pay for; one they do not; bars of
    // one price, coins for some of them; coins for every bar with one to
    // spare; the dearest price, once
    println(f"{max_ice_cream([5], 5)} {max_ice_cream([6], 5)} {max_ice_cream([3, 3, 3, 3], 10)} {max_ice_cream([2, 9, 4], 16)} {max_ice_cream([100000], 100000000)}");
    // the constraints' most: 10^5 bars of 1 to 10^5 coins, with 10^8
    // coins, and with 1000
    let mut seed = 1833;
    let costs: Vec[i64] = (0..100000).map(|_| 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000).collect();
    println(f"the most: {max_ice_cream(costs, 100000000)} {max_ice_cream(costs, 1000)}");
    // 3000 random cases of 1 to 10 bars of 1 to 20 coins, with 1 to 60
    // coins
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 10;
        let costs: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % 20).collect();
        let coins = 1 + next_random(mut seed) % 60;
        check = (check * 31 + max_ice_cream(costs, coins)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
