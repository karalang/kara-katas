// LeetCode #1833: Maximum Ice Cream Bars -- a Rust solution as LeetCode's Rust
// users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn max_ice_cream(costs: own Vec[i32], coins: i32) -> i32 {
        let mut costs = costs;
        let mut coins = coins;
        costs.sort();
        let mut count = 0;
        for c in costs {
            if c > coins {
                break;
            }
            coins -= c;
            count += 1;
        }
        count
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{Solution.max_ice_cream([1, 3, 2, 4, 1], 7)} {Solution.max_ice_cream([10, 6, 8, 7, 7, 8], 5)} {Solution.max_ice_cream([1, 6, 3, 1, 2, 5], 20)}");
    // the edges: one bar the coins just pay for; one they do not; bars of
    // one price, coins for some of them; coins for every bar with one to
    // spare; the dearest price, once
    println(f"{Solution.max_ice_cream([5], 5)} {Solution.max_ice_cream([6], 5)} {Solution.max_ice_cream([3, 3, 3, 3], 10)} {Solution.max_ice_cream([2, 9, 4], 16)} {Solution.max_ice_cream([100000], 100000000)}");
    // the constraints' most: 10^5 bars of 1 to 10^5 coins, with 10^8
    // coins, and with 1000
    let mut seed = 1833;
    let costs: Vec[i32] = (0..100000).map(|_| (1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000) as i32).collect();
    println(f"the most: {Solution.max_ice_cream(costs.clone(), 100000000)} {Solution.max_ice_cream(costs, 1000)}");
    // 3000 random cases of 1 to 10 bars of 1 to 20 coins, with 1 to 60
    // coins
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 10;
        let costs: Vec[i32] = (0..n).map(|_| (1 + next_random(mut seed) % 20) as i32).collect();
        let coins = (1 + next_random(mut seed) % 60) as i32;
        check = (check * 31 + Solution.max_ice_cream(costs, coins)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
