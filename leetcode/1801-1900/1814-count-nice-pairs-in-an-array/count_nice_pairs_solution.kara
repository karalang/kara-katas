// LeetCode #1814: Count Nice Pairs in an Array -- a Rust solution as
// LeetCode's Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn count_nice_pairs(nums: Vec[i32]) -> i32 {
        let mut map: Map[i32, i64] = Map.new();
        let mut ans: i64 = 0;
        for n in nums {
            let r = i32.parse(String.from_iter(n.to_string().chars().rev())).unwrap();
            let e = map.entry(n - r).or_insert(0);
            ans += *e;
            *e += 1;
        }
        (ans % 1_000_000_007) as i32
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{Solution.count_nice_pairs([42, 11, 1, 97])} {Solution.count_nice_pairs([13, 10, 35, 24, 76])}");
    // the edges: one number; two zeros; a number and its reverse with a
    // trailing zero; palindromes only; the largest numbers; five numbers of
    // one difference and one of its negative
    println(f"{Solution.count_nice_pairs([5])} {Solution.count_nice_pairs([0, 0])} {Solution.count_nice_pairs([10, 1])} {Solution.count_nice_pairs([121, 7, 44, 9009, 0])} {Solution.count_nice_pairs([1000000000, 999999999, 1])} {Solution.count_nice_pairs([21, 12, 32, 43, 54, 65])}");
    // the constraints' most: 10^5 equal numbers, and 10^5 numbers counting up
    let same: Vec[i32] = Vec.filled(100000, 123);
    let up: Vec[i32] = (0..100000).map(|k| (k * 9973) as i32).collect();
    println(f"the most: {Solution.count_nice_pairs(same)} {Solution.count_nice_pairs(up)}");
    // 3000 random arrays of 1 to 40 numbers, small or up to 10^9
    let mut seed = 1814;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 40;
        let big = next_random(mut seed) % 2 == 0;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            if big {
                nums.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001) as i32);
            } else {
                nums.push((next_random(mut seed) % 200) as i32);
            }
        }
        check = (check * 31 + Solution.count_nice_pairs(nums)) % 1000000007;
    }
    println(f"3000 random arrays: checksum {check}");
}
