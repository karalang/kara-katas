// LeetCode #1802: Maximum Value at a Given Index in a Bounded Array -- the
// ★ arm: a binary search on the value at `index`, the least sum that value
// needs being a slope down to 1 on each side and then ones, worked out in
// closed form. O(log maxSum)

// the least sum of `k` numbers next to a number `v`, each one less than
// the one before it and none below 1
fn side(v: i64, k: i64) -> i64 {
    if k <= v - 1 {
        (v - 1 + v - k) * k / 2
    } else {
        (v - 1) * v / 2 + (k - (v - 1))
    }
}

fn max_value(n: i32, index: i32, max_sum: i32) -> i32 {
    let (n, index, max_sum) = (n as i64, index as i64, max_sum as i64);
    let mut lo = 1;
    let mut hi = max_sum;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if mid + side(mid, index) + side(mid, n - 1 - index) <= max_sum {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{max_value(4, 2, 6)} {max_value(6, 1, 10)}");
    // the edges: one place; every place a 1; one to spare; the index at
    // either end; a pyramid that fits just
    println(f"{max_value(1, 0, 7)} {max_value(5, 2, 5)} {max_value(5, 2, 6)} {max_value(5, 0, 15)} {max_value(5, 4, 15)} {max_value(5, 2, 9)}");
    // the constraints' most: one place and 10^9; 10^9 places and 10^9; the
    // middle of 10^5 places and 10^9
    println(f"the most: {max_value(1, 0, 1000000000)} {max_value(1000000000, 0, 1000000000)} {max_value(100000, 50000, 1000000000)}");
    // 3000 random cases of 1 to 30 places, any index and a sum of up to
    // 400
    let mut seed = 1802;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 30;
        let index = next_random(mut seed) % n;
        let max_sum = n + next_random(mut seed) % 400;
        check = (check * 31 + max_value(n as i32, index as i32, max_sum as i32)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
