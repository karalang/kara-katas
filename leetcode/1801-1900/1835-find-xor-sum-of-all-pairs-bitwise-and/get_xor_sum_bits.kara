// LeetCode #1835: Find XOR Sum of All Pairs Bitwise AND -- bit by bit: a
// bit is set in `a & b` for each of the pairs whose two numbers both have
// it, and set in the XOR sum when that count of pairs, the product of the
// counts in each list, is odd.
// O(30 (n + m))

fn get_xor_sum(arr1: Vec[i64], arr2: Vec[i64]) -> i64 {
    let mut sum = 0;
    for bit in 0..30 {
        let left = arr1.iter().filter(|a| a >> bit & 1 == 1).count();
        let right = arr2.iter().filter(|b| b >> bit & 1 == 1).count();
        if left * right % 2 == 1 {
            sum |= 1 << bit;
        }
    }
    sum
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{get_xor_sum([1, 2, 3], [6, 5])} {get_xor_sum([12], [4])}");
    // the edges: one number in each; a zero; the largest numbers; a list
    // whose numbers cancel; lists with no bit in common; one list twice
    println(f"{get_xor_sum([7], [5])} {get_xor_sum([0], [1000000000])} {get_xor_sum([1000000000, 999999999], [1000000000])} {get_xor_sum([9, 9], [1, 2, 3])} {get_xor_sum([1, 4, 16], [2, 8, 32])} {get_xor_sum([3, 5, 6, 10], [3, 5, 6, 10])}");
    // the constraints' most: two lists of 10^5 numbers from 0 to 10^9, and
    // one of 10^5 against one of one
    let mut seed = 1835;
    let first: Vec[i64] = (0..100000).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001).collect();
    let second: Vec[i64] = (0..100000).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001).collect();
    println(f"the most: {get_xor_sum(first, second)} {get_xor_sum(first, [1000000000])}");
    // 3000 random cases of 1 to 8 numbers from 0 to 63 in each list
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 8;
        let arr1: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 64).collect();
        let m = 1 + next_random(mut seed) % 8;
        let arr2: Vec[i64] = (0..m).map(|_| next_random(mut seed) % 64).collect();
        check = (check * 31 + get_xor_sum(arr1, arr2)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
