// LeetCode #1835: Find XOR Sum of All Pairs Bitwise AND --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- get_xor_sum.kara ----
fn a0_get_xor_sum(arr1: Vec[i64], arr2: Vec[i64]) -> i64 {
    let mut left = 0;
    for a in arr1.iter() {
        left ^= a;
    }
    let mut right = 0;
    for b in arr2.iter() {
        right ^= b;
    }
    left & right
}

// ---- get_xor_sum_rows.kara ----
fn a1_get_xor_sum(arr1: Vec[i64], arr2: Vec[i64]) -> i64 {
    let mut right = 0;
    for b in arr2.iter() {
        right ^= b;
    }
    let mut sum = 0;
    for a in arr1.iter() {
        sum ^= a & right;
    }
    sum
}

// ---- get_xor_sum_bits.kara ----
fn a2_get_xor_sum(arr1: Vec[i64], arr2: Vec[i64]) -> i64 {
    let mut sum = 0;
    for bit in 0..30 {
        let left = arr1.iter().filter(|a| a >> bit & 1 == 1).count();
        let right = arr2.iter().filter(|b| b >> bit & 1 == 1).count();
        if left * right % 2 == 1 {
            sum |= 1 << bit;
        }
    }
    sum
}

// ---- get_xor_sum_fold.kara ----
fn a3_get_xor_sum(arr1: Vec[i64], arr2: Vec[i64]) -> i64 {
    arr1.iter().fold(0, |x, a| x ^ a) & arr2.iter().fold(0, |x, b| x ^ b)
}

// ---- get_xor_sum_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn get_xor_sum(arr1: Vec[i32], arr2: Vec[i32]) -> i32 {
        let x1 = arr1.iter().fold(0i32, |acc, x| acc ^ x);
        let x2 = arr2.iter().fold(0i32, |acc, x| acc ^ x);
        x1 & x2
    }
}
// ---- the differential -------------------------------------------------------

// the statement read literally: `arr1[i] & arr2[j]` for every pair, all of
// them XORed together
fn literal(arr1: Slice[i64], arr2: Slice[i64]) -> i64 {
    let mut sum = 0;
    for a in arr1.iter() {
        for b in arr2.iter() {
            sum ^= a & b;
        }
    }
    sum
}

fn arm(i: i64, arr1: Slice[i64], arr2: Slice[i64]) -> i64 {
    match i {
        0 => a0_get_xor_sum(arr1.to_vec(), arr2.to_vec()),
        1 => a1_get_xor_sum(arr1.to_vec(), arr2.to_vec()),
        2 => a2_get_xor_sum(arr1.to_vec(), arr2.to_vec()),
        3 => a3_get_xor_sum(arr1.to_vec(), arr2.to_vec()),
        _ => {
            let left: Vec[i32] = arr1.iter().map(|a| a as i32).collect();
            let right: Vec[i32] = arr2.iter().map(|b| b as i32).collect();
            A4Solution.get_xor_sum(left, right)
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, arr1: Slice[i64], arr2: Slice[i64]) {
    t.cases += 1;
    let star = arm(0, arr1, arr2);
    t.check = (t.check * 31 + star) % 1000000007;
    let want = literal(arr1, arr2);
    let either = arr1.iter().fold(0, |x, a| x | a) & arr2.iter().fold(0, |x, b| x | b);
    let mut twice = arr1.to_vec();
    twice.push(arr2[0]);
    twice.push(arr2[0]);
    let left_doubled: Vec[i64] = arr1.iter().map(|a| a * 2).collect();
    let right_doubled: Vec[i64] = arr2.iter().map(|b| b * 2).collect();
    for i in 0..5 {
        let what = f"arm {i} on {arr1} and {arr2}";
        let got = arm(i, arr1, arr2);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: a bit of the sum is in some number of each list
        expect(mut t, 2, got >= 0 and got & either == got, f"P2 {what}");
        // P3: the lists swapped give the same sum
        expect(mut t, 3, arm(i, arr2, arr1) == got, f"P3 {what}");
        // P4: a number put in `arr1` twice changes nothing
        expect(mut t, 4, arm(i, twice[..], arr2) == got, f"P4 {what}");
        // P5: every number doubled doubles the sum
        expect(mut t, 5, arm(i, left_doubled[..], right_doubled[..]) == got * 2, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 random cases of 1 to 10 numbers from 0 to 255 in each list
    let mut seed = 1835;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 10;
        let arr1: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 256).collect();
        let m = 1 + next_random(mut seed) % 10;
        let arr2: Vec[i64] = (0..m).map(|_| next_random(mut seed) % 256).collect();
        check_case(mut t, arr1[..], arr2[..]);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
