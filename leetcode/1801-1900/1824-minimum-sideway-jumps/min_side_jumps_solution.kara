// LeetCode #1824: Minimum Sideway Jumps -- a Rust solution as LeetCode's
// Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn min_side_jumps(obstacles: Vec[i32]) -> i32 {
        let mut dp = [1, 0, 1];
        for o in obstacles.iter().skip(1) {
            if o > 0 {
                dp[(o - 1) as usize] = i32.MAX / 2;
            }
            let m = *dp.iter().min().unwrap();
            for j in 0..3 {
                if j as i32 != o - 1 {
                    dp[j] = dp[j].min(m + 1);
                }
            }
        }
        *dp.iter().min().unwrap()
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{Solution.min_side_jumps([0, 1, 2, 3, 0])} {Solution.min_side_jumps([0, 1, 1, 3, 3, 0])} {Solution.min_side_jumps([0, 2, 1, 0, 3, 0])}");
    // the edges: a road of one step; the frog's lane blocked at once and to
    // the end; obstacles that send it from lane to lane; a road with none
    println(f"{Solution.min_side_jumps([0, 0])} {Solution.min_side_jumps([0, 2, 2, 2, 0])} {Solution.min_side_jumps([0, 2, 1, 3, 2, 1, 3, 0])} {Solution.min_side_jumps([0, 0, 0, 0])}");
    // the constraints' most: a road of 5 * 10^5 steps with an obstacle in
    // every lane in turn, and one with none
    let n = 500000;
    let mut turns: Vec[i32] = Vec.filled(n + 1, 0);
    for i in 1..n {
        turns[i] = (1 + i % 3) as i32;
    }
    let clear: Vec[i32] = Vec.filled(n + 1, 0);
    println(f"the most: {Solution.min_side_jumps(turns)} {Solution.min_side_jumps(clear)}");
    // 3000 random roads of 1 to 20 steps, an obstacle at half the points
    // in a lane drawn at random
    let mut seed = 1824;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 20;
        let mut road: Vec[i32] = Vec.filled(n + 1, 0);
        for i in 1..n {
            if next_random(mut seed) % 2 == 0 {
                road[i] = (1 + next_random(mut seed) % 3) as i32;
            }
        }
        check = (check * 31 + Solution.min_side_jumps(road)) % 1000000007;
    }
    println(f"3000 random roads: checksum {check}");
}
