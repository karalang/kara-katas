// LeetCode #1824: Minimum Sideway Jumps --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- min_side_jumps.kara ----
fn a0_min_side_jumps(obstacles: Vec[i64]) -> i64 {
    let never = obstacles.len() + 1;
    let mut jumps = [1, 0, 1];
    for i in 1..obstacles.len() {
        if obstacles[i] > 0 {
            jumps[obstacles[i] - 1] = never;
        }
        let best = jumps.iter().min().unwrap() + 1;
        for lane in 0..3 {
            if obstacles[i] != lane + 1 {
                jumps[lane] = jumps[lane].min(best);
            }
        }
    }
    jumps.iter().min().unwrap()
}

// ---- min_side_jumps_greedy.kara ----
fn a1_min_side_jumps(obstacles: Vec[i64]) -> i64 {
    let n = obstacles.len();
    // ahead[lane][i] is the first point at or past i with an obstacle in
    // the lane, or n when there is none
    let mut ahead: Vec[Vec[i64]] = Vec.new();
    for lane in 1..4 {
        let mut next = Vec.filled(n + 1, n);
        for i in (0..n).rev() {
            next[i] = if obstacles[i] == lane { i } else { next[i + 1] };
        }
        ahead.push(next);
    }
    let mut lane = 2;
    let mut jumps = 0;
    for i in 0..n - 1 {
        if obstacles[i + 1] == lane {
            let mut pick = lane;
            for other in 1..4 {
                if other != lane and obstacles[i] != other and (pick == lane or ahead[other - 1][i] > ahead[pick - 1][i]) {
                    pick = other;
                }
            }
            lane = pick;
            jumps += 1;
        }
    }
    jumps
}

// ---- min_side_jumps_bfs.kara ----
fn a2_min_side_jumps(obstacles: Vec[i64]) -> i64 {
    let n = obstacles.len();
    let never = n + 1;
    let mut best: Vec[i64] = Vec.filled(3 * n, never);
    let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
    best[1] = 0;
    queue.push_back((0, 1));
    while let Some((i, lane)) = queue.pop_front() {
        let here = best[3 * i + lane];
        if i == n - 1 {
            return here;
        }
        if obstacles[i + 1] != lane + 1 and best[3 * (i + 1) + lane] > here {
            best[3 * (i + 1) + lane] = here;
            queue.push_front((i + 1, lane));
        }
        for other in 0..3 {
            if other != lane and obstacles[i] != other + 1 and best[3 * i + other] > here + 1 {
                best[3 * i + other] = here + 1;
                queue.push_back((i, other));
            }
        }
    }
    never
}

// ---- min_side_jumps_table.kara ----
fn a3_min_side_jumps(obstacles: Vec[i64]) -> i64 {
    let n = obstacles.len();
    let never = n + 1;
    let mut table: Vec[Array[i64, 3]] = Vec.filled(n, [never, never, never]);
    table[0] = [1, 0, 1];
    for i in 1..n {
        for lane in 0..3 {
            if obstacles[i] != lane + 1 {
                table[i][lane] = table[i - 1][lane];
            }
        }
        let best = table[i][0].min(table[i][1]).min(table[i][2]);
        for lane in 0..3 {
            if obstacles[i] != lane + 1 {
                table[i][lane] = table[i][lane].min(best + 1);
            }
        }
    }
    table[n - 1][0].min(table[n - 1][1]).min(table[n - 1][2])
}

// ---- min_side_jumps_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn min_side_jumps(obstacles: Vec[i32]) -> i32 {
        let mut dp = [1, 0, 1];
        for o in obstacles.iter().skip(1) {
            if o > 0 {
                dp[(o - 1) as usize] = i32.MAX / 2;
            }
            let m = *dp.iter().min().unwrap();
            for j in 0..3 {
                if j as i32 != o - 1 {
                    dp[j] = dp[j].min(m + 1);
                }
            }
        }
        *dp.iter().min().unwrap()
    }
}
// ---- the differential -------------------------------------------------------

// the statement read literally: the places the frog can stand with no
// jump, then with one more jump at a time, each set run forward as far as
// the lane is clear, until one of them stands at the end of the road
fn literal(obstacles: Slice[i64]) -> i64 {
    let n = obstacles.len();
    let mut here: Set[(i64, i64)] = Set.new();
    here.insert((0, 2));
    let mut jumps = 0;
    loop {
        // run every place forward while the point ahead is clear in its lane
        let mut ran: Set[(i64, i64)] = Set.new();
        for (point, lane) in here.iter() {
            let mut p = point;
            ran.insert((p, lane));
            while p + 1 < n and obstacles[p + 1] != lane {
                p += 1;
                ran.insert((p, lane));
            }
        }
        if ran.iter().any(|(p, _)| p == n - 1) {
            return jumps;
        }
        // one side jump from every place, to a lane clear at that point
        let mut next: Set[(i64, i64)] = Set.new();
        for (point, lane) in ran.iter() {
            next.insert((point, lane));
            for other in 1..4 {
                if other != lane and obstacles[point] != other {
                    next.insert((point, other));
                }
            }
        }
        here = next;
        jumps += 1;
    }
}

fn arm(i: i64, obstacles: Slice[i64]) -> i64 {
    match i {
        0 => a0_min_side_jumps(obstacles.to_vec()),
        1 => a1_min_side_jumps(obstacles.to_vec()),
        2 => a2_min_side_jumps(obstacles.to_vec()),
        3 => a3_min_side_jumps(obstacles.to_vec()),
        _ => {
            let narrow: Vec[i32] = obstacles.iter().map(|x| x as i32).collect();
            A4Solution.min_side_jumps(narrow)
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, obstacles: Slice[i64]) {
    t.cases += 1;
    let star = arm(0, obstacles);
    t.check = (t.check * 31 + star) % 1000000007;
    let want = literal(obstacles);
    let blocked = obstacles.iter().filter(|x| x > 0).count();
    let mirrored: Vec[i64] = obstacles.iter().map(|x| if x == 0 { 0 } else { 4 - x }).collect();
    let middle_clear: Vec[i64] = obstacles.iter().map(|x| if x == 2 { 0 } else { x }).collect();
    let mut twice: Vec[i64] = Vec.new();
    for x in obstacles.iter() {
        twice.push(x);
        twice.push(x);
    }
    for i in 0..5 {
        let what = f"arm {i} on {obstacles}";
        let got = arm(i, obstacles);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: no more jumps than obstacles, each passed with one at most
        expect(mut t, 2, got >= 0 and got <= blocked, f"P2 {what}");
        // P3: lanes 1 and 3 swapped give the same answer, the frog starting
        // between them
        expect(mut t, 3, arm(i, mirrored[..]) == got, f"P3 {what}");
        // P4: with nothing in lane 2 the frog never jumps
        expect(mut t, 4, arm(i, middle_clear[..]) == 0, f"P4 {what}");
        // P5: every point given twice gives the same answer
        expect(mut t, 5, arm(i, twice[..]) == got, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 random roads of 1 to 15 steps, an obstacle at half the points in
    // a lane drawn at random
    let mut seed = 1824;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 15;
        let mut road: Vec[i64] = Vec.filled(n + 1, 0);
        for i in 1..n {
            if next_random(mut seed) % 2 == 0 {
                road[i] = 1 + next_random(mut seed) % 3;
            }
        }
        check_case(mut t, road[..]);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
