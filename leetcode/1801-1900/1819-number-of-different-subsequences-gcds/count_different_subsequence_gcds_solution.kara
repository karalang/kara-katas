// LeetCode #1819: Number of Different Subsequences GCDs -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac fix`

fn gcd(a: i32, b: i32) -> i32 {
    if b == 0 { a } else { gcd(b, a % b) }
}

struct Solution {}

impl Solution {
    pub fn count_different_subsequence_gc_ds(nums: Vec[i32]) -> i32 {
        let max = *nums.iter().max().unwrap() as i64;
        let mut seen = Vec.filled(max + 1, false);
        for x in ref nums {
            seen[x] = true;
        }
        let mut ans = 0;
        for i in 1..=max {
            let mut g = 0;
            let mut j = i;
            while j <= max {
                if seen[j] {
                    g = gcd(g, j as i32);
                    if g == i as i32 {
                        break;
                    }
                }
                j += i;
            }
            if g == i as i32 {
                ans += 1;
            }
        }
        ans
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{Solution.count_different_subsequence_gc_ds([6, 10, 3])} {Solution.count_different_subsequence_gc_ds([5, 15, 40, 5, 6])}");
    // the edges: one number; one number many times; a number and its
    // multiples; two coprime numbers, whose pair has gcd 1; the largest
    // value alone
    println(f"{Solution.count_different_subsequence_gc_ds([1])} {Solution.count_different_subsequence_gc_ds([7, 7, 7])} {Solution.count_different_subsequence_gc_ds([4, 8, 16])} {Solution.count_different_subsequence_gc_ds([9, 10])} {Solution.count_different_subsequence_gc_ds([200000])}");
    // the constraints' most: 10^5 numbers, 1 to 10^5, so every number is a
    // gcd, and 10^5 even numbers up to 2 * 10^5
    let n = 100000;
    let all: Vec[i32] = (1..n + 1).map(|x| x as i32).collect();
    let evens: Vec[i32] = (1..n + 1).map(|x| (2 * x) as i32).collect();
    println(f"the most: {Solution.count_different_subsequence_gc_ds(all)} {Solution.count_different_subsequence_gc_ds(evens)}");
    // 3000 random cases of 1 to 8 numbers from 1 to 60
    let mut seed = 1819;
    let mut check = 0;
    for _ in 0..3000 {
        let len = 1 + next_random(mut seed) % 8;
        let nums: Vec[i32] = (0..len).map(|_| (1 + next_random(mut seed) % 60) as i32).collect();
        check = (check * 31 + Solution.count_different_subsequence_gc_ds(nums)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
