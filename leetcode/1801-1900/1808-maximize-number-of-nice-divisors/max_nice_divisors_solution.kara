// LeetCode #1808: Maximize Number of Nice Divisors -- a Rust solution as
// LeetCode's Rust users write it, carried to Kāra by `karac fix`

const MOD: i64 = 1_000_000_007;

fn pow(a: i64, b: i64) -> i64 {
    let mut a = a;
    let mut b = b;
    let mut r = 1;
    a %= MOD;
    while b > 0 {
        if b & 1 == 1 {
            r = r * a % MOD;
        }
        a = a * a % MOD;
        b >>= 1;
    }
    r
}

struct Solution {}

impl Solution {
    pub fn max_nice_divisors(prime_factors: i32) -> i32 {
        let n = prime_factors as i64;
        if n <= 3 {
            return prime_factors;
        }
        match n % 3 {
            0 => pow(3, n / 3) as i32,
            1 => (pow(3, n / 3 - 1) * 4 % MOD) as i32,
            _ => (pow(3, n / 3) * 2 % MOD) as i32,
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{Solution.max_nice_divisors(5)} {Solution.max_nice_divisors(8)}");
    // the edges: 1 to 7, each remainder modulo 3 and the parts too small
    // to split; the constraints' most
    let small: Vec[String] = (1..8).map(|n| Solution.max_nice_divisors(n as i32).to_string()).collect();
    println(f"{small.join(" ")} {Solution.max_nice_divisors(1000000000)} {Solution.max_nice_divisors(999999999)} {Solution.max_nice_divisors(999999998)}");
    // 1 to 2000 in turn, and 3000 at random to 10^9
    let mut check = 0;
    for n in 1..2001 {
        check = (check * 31 + Solution.max_nice_divisors(n as i32)) % 1000000007;
    }
    println(f"1 to 2000: checksum {check}");
    let mut seed = 1808;
    check = 0;
    for _ in 0..3000 {
        let n = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000;
        check = (check * 31 + Solution.max_nice_divisors(n as i32)) % 1000000007;
    }
    println(f"3000 at random to 10^9: checksum {check}");
}
