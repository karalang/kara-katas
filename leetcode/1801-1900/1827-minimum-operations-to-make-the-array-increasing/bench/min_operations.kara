// LeetCode #1827: Minimum Operations to Make the Array Increasing -- the bench
// in Kāra: the ★ arm over 10000 calls on runs of 2500 to 4999 numbers cut from
// one list of 10^4 numbers from 1 to 10^4, built once, each run's start and
// length drawn from the checksum so far.

fn min_operations(nums: Vec[i64]) -> i64 {
    let mut operations = 0;
    let mut last = 0;
    for x in nums.iter() {
        if x <= last {
            last += 1;
            operations += last - x;
        } else {
            last = x;
        }
    }
    operations
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1827;
    let base: Vec[i64] = (0..10000).map(|_| 1 + next_random(mut seed) % 10000).collect();
    let mut check = 0;
    for call in 0..10000 {
        let start = (check + call) % 5000;
        let len = 2500 + (check * 7 + call) % 2500;
        let run = base[start..start + len].to_vec();
        check = (check * 31 + min_operations(run)) % 1000000007;
    }
    println(f"10000 calls: checksum {check}");
}
