// LeetCode #1827: Minimum Operations to Make the Array Increasing -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn min_operations(nums: Vec[i32]) -> i32 {
        let mut prev: i32 = 0;
        let mut ans: i32 = 0;
        for x in nums.iter() {
            if x <= prev {
                ans += prev + 1 - x;
                prev += 1;
            } else {
                prev = x;
            }
        }
        ans
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{Solution.min_operations([1, 1, 1])} {Solution.min_operations([1, 5, 2, 4, 1])} {Solution.min_operations([8])}");
    // the edges: two equal numbers; already increasing; strictly
    // decreasing; a large number early lifting all after it; the largest
    // value then the smallest
    println(f"{Solution.min_operations([3, 3])} {Solution.min_operations([1, 2, 3, 4])} {Solution.min_operations([5, 4, 3, 2, 1])} {Solution.min_operations([1, 9, 1, 1, 10])} {Solution.min_operations([10000, 1])}");
    // the constraints' most: 5000 numbers all 1, all 10^4, and falling
    // from 10^4
    let ones: Vec[i32] = Vec.filled(5000, 1);
    let tops: Vec[i32] = Vec.filled(5000, 10000);
    let falling: Vec[i32] = (0..5000).map(|i| (10000 - i) as i32).collect();
    println(f"the most: {Solution.min_operations(ones)} {Solution.min_operations(tops)} {Solution.min_operations(falling)}");
    // 3000 random cases of 1 to 12 numbers from 1 to 20
    let mut seed = 1827;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 12;
        let nums: Vec[i32] = (0..n).map(|_| (1 + next_random(mut seed) % 20) as i32).collect();
        check = (check * 31 + Solution.min_operations(nums)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
