// LeetCode #1827: Minimum Operations to Make the Array Increasing -- with
// no walk carrying the last number: the number at place i is raised to i
// plus the largest of nums[j] - j over the places j up to it, as each
// number before it, raised, pushes it one more per place between. The
// count is what those targets add.
// O(n)

fn min_operations(nums: Vec[i64]) -> i64 {
    let mut lift = i64.MIN;
    let mut operations = 0;
    for (i, x) in nums.iter().enumerate() {
        lift = lift.max(x - i);
        operations += i + lift - x;
    }
    operations
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{min_operations([1, 1, 1])} {min_operations([1, 5, 2, 4, 1])} {min_operations([8])}");
    // the edges: two equal numbers; already increasing; strictly
    // decreasing; a large number early lifting all after it; the largest
    // value then the smallest
    println(f"{min_operations([3, 3])} {min_operations([1, 2, 3, 4])} {min_operations([5, 4, 3, 2, 1])} {min_operations([1, 9, 1, 1, 10])} {min_operations([10000, 1])}");
    // the constraints' most: 5000 numbers all 1, all 10^4, and falling
    // from 10^4
    let ones: Vec[i64] = Vec.filled(5000, 1);
    let tops: Vec[i64] = Vec.filled(5000, 10000);
    let falling: Vec[i64] = (0..5000).map(|i| 10000 - i).collect();
    println(f"the most: {min_operations(ones)} {min_operations(tops)} {min_operations(falling)}");
    // 3000 random cases of 1 to 12 numbers from 1 to 20
    let mut seed = 1827;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 12;
        let nums: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % 20).collect();
        check = (check * 31 + min_operations(nums)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
