// LeetCode #1825: Finding MK Average --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- finding_mk_average.kara ----
struct A0Bag {
    counts: SortedMap[i64, i64],
    size: i64,
    sum: i64,
}

impl A0Bag {
    fn new() -> A0Bag {
        A0Bag { counts: SortedMap.new(), size: 0, sum: 0 }
    }

    fn add(mut ref self, x: i64) {
        self.counts[x] = self.counts.get(x).cloned().unwrap_or(0) + 1;
        self.size += 1;
        self.sum += x;
    }

    fn remove(mut ref self, x: i64) {
        let left = self.counts[x] - 1;
        if left == 0 {
            self.counts.remove(x);
        } else {
            self.counts[x] = left;
        }
        self.size -= 1;
        self.sum -= x;
    }

    fn holds(self, x: i64) -> bool {
        self.counts.contains_key(x)
    }

    fn least(self) -> i64 {
        *self.counts.first().unwrap().0
    }

    fn most(self) -> i64 {
        *self.counts.last().unwrap().0
    }
}

struct A0MkAverage {
    m: i64,
    k: i64,
    window: VecDeque[i64],
    low: A0Bag,
    mid: A0Bag,
    high: A0Bag,
}

impl A0MkAverage {
    fn new(m: i64, k: i64) -> A0MkAverage {
        A0MkAverage { m, k, window: VecDeque.new(), low: A0Bag.new(), mid: A0Bag.new(), high: A0Bag.new() }
    }

    fn add_element(mut ref self, num: i64) {
        self.window.push_back(num);
        let n = self.window.len();
        if n < self.m {
            return;
        }
        if n == self.m {
            // the window has just filled: the bags are made from it sorted
            let mut sorted: Vec[i64] = self.window.iter().collect();
            sorted.sort();
            for i in 0..n {
                if i < self.k {
                    self.low.add(sorted[i]);
                } else if i >= n - self.k {
                    self.high.add(sorted[i]);
                } else {
                    self.mid.add(sorted[i]);
                }
            }
            return;
        }
        let old = self.window.pop_front().unwrap();
        if self.low.holds(old) {
            self.low.remove(old);
        } else if self.high.holds(old) {
            self.high.remove(old);
        } else {
            self.mid.remove(old);
        }
        if self.low.size > 0 and num <= self.low.most() {
            self.low.add(num);
        } else if self.high.size > 0 and num >= self.high.least() {
            self.high.add(num);
        } else {
            self.mid.add(num);
        }
        while self.low.size > self.k {
            let x = self.low.most();
            self.low.remove(x);
            self.mid.add(x);
        }
        while self.high.size > self.k {
            let x = self.high.least();
            self.high.remove(x);
            self.mid.add(x);
        }
        while self.low.size < self.k {
            let x = self.mid.least();
            self.mid.remove(x);
            self.low.add(x);
        }
        while self.high.size < self.k {
            let x = self.mid.most();
            self.mid.remove(x);
            self.high.add(x);
        }
    }

    fn calculate_mk_average(self) -> i64 {
        if self.window.len() < self.m {
            return -1;
        }
        self.mid.sum / (self.m - 2 * self.k)
    }
}

// ---- finding_mk_average_fenwick.kara ----
const A1_TOP: i64 = 100000;

struct A1MkAverage {
    m: i64,
    k: i64,
    window: VecDeque[i64],
    count: Vec[i64],
    total: Vec[i64],
}

impl A1MkAverage {
    fn new(m: i64, k: i64) -> A1MkAverage {
        A1MkAverage { m, k, window: VecDeque.new(), count: Vec.filled(A1_TOP + 1, 0), total: Vec.filled(A1_TOP + 1, 0) }
    }

    fn change(mut ref self, x: i64, by: i64) {
        let mut i = x;
        while i <= A1_TOP {
            self.count[i] += by;
            self.total[i] += by * x;
            i += i & -i;
        }
    }

    // the sum of the t smallest numbers of the window
    fn smallest(self, t: i64) -> i64 {
        let mut at = 0;
        let mut left = t;
        let mut sum = 0;
        let mut step = 1 << 16;
        while step > 0 {
            if at + step <= A1_TOP and self.count[at + step] <= left {
                at += step;
                left -= self.count[at];
                sum += self.total[at];
            }
            step /= 2;
        }
        sum + left * (at + 1)
    }

    fn add_element(mut ref self, num: i64) {
        self.window.push_back(num);
        self.change(num, 1);
        if self.window.len() > self.m {
            let old = self.window.pop_front().unwrap();
            self.change(old, -1);
        }
    }

    fn calculate_mk_average(self) -> i64 {
        if self.window.len() < self.m {
            return -1;
        }
        (self.smallest(self.m - self.k) - self.smallest(self.k)) / (self.m - 2 * self.k)
    }
}

// ---- finding_mk_average_segment.kara ----
const A2_LEAVES: i64 = 131072;

struct A2MkAverage {
    m: i64,
    k: i64,
    window: VecDeque[i64],
    count: Vec[i64],
    total: Vec[i64],
}

impl A2MkAverage {
    fn new(m: i64, k: i64) -> A2MkAverage {
        A2MkAverage { m, k, window: VecDeque.new(), count: Vec.filled(2 * A2_LEAVES, 0), total: Vec.filled(2 * A2_LEAVES, 0) }
    }

    fn change(mut ref self, x: i64, by: i64) {
        let mut node = A2_LEAVES + x;
        while node >= 1 {
            self.count[node] += by;
            self.total[node] += by * x;
            node /= 2;
        }
    }

    // the sum of the t smallest numbers of the window
    fn smallest(self, t: i64) -> i64 {
        let mut node = 1;
        let mut left = t;
        let mut sum = 0;
        while node < A2_LEAVES {
            let child = 2 * node;
            if self.count[child] >= left {
                node = child;
            } else {
                left -= self.count[child];
                sum += self.total[child];
                node = child + 1;
            }
        }
        sum + left * (node - A2_LEAVES)
    }

    fn add_element(mut ref self, num: i64) {
        self.window.push_back(num);
        self.change(num, 1);
        if self.window.len() > self.m {
            let old = self.window.pop_front().unwrap();
            self.change(old, -1);
        }
    }

    fn calculate_mk_average(self) -> i64 {
        if self.window.len() < self.m {
            return -1;
        }
        (self.smallest(self.m - self.k) - self.smallest(self.k)) / (self.m - 2 * self.k)
    }
}

// ---- finding_mk_average_sort.kara ----
struct A3MkAverage {
    m: i64,
    k: i64,
    window: VecDeque[i64],
}

impl A3MkAverage {
    fn new(m: i64, k: i64) -> A3MkAverage {
        A3MkAverage { m, k, window: VecDeque.new() }
    }

    fn add_element(mut ref self, num: i64) {
        self.window.push_back(num);
        if self.window.len() > self.m {
            self.window.pop_front();
        }
    }

    fn calculate_mk_average(self) -> i64 {
        if self.window.len() < self.m {
            return -1;
        }
        let mut sorted: Vec[i64] = self.window.iter().collect();
        sorted.sort();
        let kept: i64 = sorted[self.k..self.m - self.k].iter().sum();
        kept / (self.m - 2 * self.k)
    }
}

// ---- finding_mk_average_solution.kara ----
const A4_N: i64 = 100001;

struct A4MkAverage {
    m: i64,
    k: i64,
    q: VecDeque[i32],
    cnt: Vec[i64],
    sum: Vec[i64],
}

impl A4MkAverage {
    fn new(m: i32, k: i32) -> Self {
        A4MkAverage {
            m: m,
            k: k,
            q: VecDeque.new(),
            cnt: Vec.filled(A4_N + 1, 0),
            sum: Vec.filled(A4_N + 1, 0),
        }
    }

    fn update(mut ref self, x: i64, c: i64) {
        let mut i = x;
        while i <= A4_N {
            self.cnt[i] += c;
            self.sum[i] += c * x;
            i += i & i.wrapping_neg();
        }
    }

    fn smallest(self, t: i64) -> i64 {
        let mut pos = 0;
        let mut left = t;
        let mut acc = 0;
        let mut step = 1 << 17;
        while step > 0 {
            if pos + step <= A4_N and self.cnt[pos + step] <= left {
                pos += step;
                left -= self.cnt[pos];
                acc += self.sum[pos];
            }
            step >>= 1;
        }
        acc + left * (pos + 1)
    }

    fn add_element(mut ref self, num: i32) {
        self.q.push_back(num);
        self.update(num, 1);
        if self.q.len() > self.m {
            let old = self.q.pop_front().unwrap();
            self.update(old, -1);
        }
    }

    fn calculate_mk_average(self) -> i32 {
        if self.q.len() < self.m {
            return -1;
        }
        ((self.smallest(self.m - self.k) - self.smallest(self.k)) / (self.m - 2 * self.k)) as i32
    }
}
// ---- the differential -------------------------------------------------------

// each arm's MKAverage, driven the one way
trait Window {
    fn put(mut ref self, num: i64);
    fn average(self) -> i64;
}

impl Window for A0MkAverage {
    fn put(mut ref self, num: i64) { self.add_element(num); }
    fn average(self) -> i64 { self.calculate_mk_average() }
}

impl Window for A1MkAverage {
    fn put(mut ref self, num: i64) { self.add_element(num); }
    fn average(self) -> i64 { self.calculate_mk_average() }
}

impl Window for A2MkAverage {
    fn put(mut ref self, num: i64) { self.add_element(num); }
    fn average(self) -> i64 { self.calculate_mk_average() }
}

impl Window for A3MkAverage {
    fn put(mut ref self, num: i64) { self.add_element(num); }
    fn average(self) -> i64 { self.calculate_mk_average() }
}

impl Window for A4MkAverage {
    fn put(mut ref self, num: i64) { self.add_element(num as i32); }
    fn average(self) -> i64 { self.calculate_mk_average() }
}

// a number adds it, and -1 asks for the average, which is gathered
fn drive[W: Window](w: mut ref W, ops: Slice[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for op in ops.iter() {
        if op < 0 {
            out.push(w.average());
        } else {
            w.put(op);
        }
    }
    out
}

fn arm(i: i64, m: i64, k: i64, ops: Slice[i64]) -> Vec[i64] {
    match i {
        0 => {
            let mut w = A0MkAverage.new(m, k);
            drive(mut w, ops)
        }
        1 => {
            let mut w = A1MkAverage.new(m, k);
            drive(mut w, ops)
        }
        2 => {
            let mut w = A2MkAverage.new(m, k);
            drive(mut w, ops)
        }
        3 => {
            let mut w = A3MkAverage.new(m, k);
            drive(mut w, ops)
        }
        _ => {
            let mut w = A4MkAverage.new(m as i32, k as i32);
            drive(mut w, ops)
        }
    }
}

// the statement read literally: every number kept as it comes; asked, the
// average is -1 while fewer than m have come, and otherwise the last m are
// copied and sorted, the k smallest and the k largest taken off, and the
// rest averaged, rounded down
fn literal(m: i64, k: i64, ops: Slice[i64]) -> Vec[i64] {
    let mut stream: Vec[i64] = Vec.new();
    let mut out: Vec[i64] = Vec.new();
    for op in ops.iter() {
        if op >= 0 {
            stream.push(op);
        } else if stream.len() < m {
            out.push(-1);
        } else {
            let mut last: Vec[i64] = stream[stream.len() - m..].to_vec();
            last.sort();
            let kept = last[k..m - k];
            let total: i64 = kept.iter().sum();
            out.push(total / (m - 2 * k));
        }
    }
    out
}

// the least and largest of the last m numbers at each ask, or None while
// fewer than m have come
fn spans(m: i64, ops: Slice[i64]) -> Vec[Option[(i64, i64)]] {
    let mut stream: Vec[i64] = Vec.new();
    let mut out: Vec[Option[(i64, i64)]] = Vec.new();
    for op in ops.iter() {
        if op >= 0 {
            stream.push(op);
        } else if stream.len() < m {
            out.push(None);
        } else {
            let last = stream[stream.len() - m..];
            out.push(Some((last.iter().min().unwrap(), last.iter().max().unwrap())));
        }
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

const SHIFT: i64 = 1000;
const MIRROR: i64 = 100001;

fn check_case(t: mut ref Tally, m: i64, k: i64, ops: Slice[i64]) {
    t.cases += 1;
    let star = arm(0, m, k, ops);
    for x in star.iter() {
        t.check = (t.check * 31 + x + 2) % 1000000007;
    }
    let want = literal(m, k, ops);
    let bounds = spans(m, ops);
    let shifted: Vec[i64] = ops.iter().map(|x| if x < 0 { x } else { x + SHIFT }).collect();
    let mirrored: Vec[i64] = ops.iter().map(|x| if x < 0 { x } else { MIRROR - x }).collect();
    let mut twice: Vec[i64] = Vec.new();
    for x in ops.iter() {
        twice.push(x);
        if x < 0 {
            twice.push(x);
        }
    }
    for i in 0..5 {
        let what = f"arm {i} on m {m} k {k} {ops}";
        let got = arm(i, m, k, ops);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: -1 exactly while fewer than m numbers have come, and otherwise
        // between the least and the largest of the last m
        let mut inside = got.len() == bounds.len();
        for j in 0..got.len().min(bounds.len()) {
            inside = inside and match bounds[j] {
                None => got[j] == -1,
                Some((lo, hi)) => got[j] >= lo and got[j] <= hi,
            };
        }
        expect(mut t, 2, inside, f"P2 {what}");
        // P3: every number raised by SHIFT raises every average by SHIFT
        let up = arm(i, m, k, shifted[..]);
        let mut raised = up.len() == got.len();
        for j in 0..up.len().min(got.len()) {
            raised = raised and up[j] == if got[j] < 0 { -1 } else { got[j] + SHIFT };
        }
        expect(mut t, 3, raised, f"P3 {what}");
        // P4: every number x made MIRROR - x swaps the k smallest with the k
        // largest, so an average and its mirror sum to MIRROR, or one less
        // where the average was rounded down
        let down = arm(i, m, k, mirrored[..]);
        let mut paired = down.len() == got.len();
        for j in 0..down.len().min(got.len()) {
            paired = paired and if got[j] < 0 { down[j] == -1 } else { got[j] + down[j] == MIRROR or got[j] + down[j] == MIRROR - 1 };
        }
        expect(mut t, 4, paired, f"P4 {what}");
        // P5: every average asked for twice in a row is given twice
        let again = arm(i, m, k, twice[..]);
        let mut doubled: Vec[i64] = Vec.new();
        for x in got.iter() {
            doubled.push(x);
            doubled.push(x);
        }
        expect(mut t, 5, again == doubled, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 random runs of 1 to 40 operations on windows of 3 to 10 numbers
    // from 1 to 20, about a third of them asking for the average
    let mut seed = 1825;
    for _ in 0..2000 {
        let m = 3 + next_random(mut seed) % 8;
        let k = 1 + next_random(mut seed) % ((m - 1) / 2);
        let len = 1 + next_random(mut seed) % 40;
        let ops: Vec[i64] = (0..len).map(|_| if next_random(mut seed) % 3 == 0 { -1 } else { 1 + next_random(mut seed) % 20 }).collect();
        check_case(mut t, m, k, ops[..]);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
