// LeetCode #1845: Seat Reservation Manager --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- seat_manager.kara ----
struct A0SeatManager {
    free: PriorityQueue[i64],
}

impl A0SeatManager {
    fn new(n: i64) -> A0SeatManager {
        A0SeatManager { free: (1..n + 1).collect() }
    }

    fn reserve(mut ref self) -> i64 {
        self.free.pop().unwrap()
    }

    fn unreserve(mut ref self, seat_number: i64) {
        self.free.push(seat_number);
    }
}

// ---- seat_manager_lazy.kara ----
struct A1SeatManager {
    next: i64,
    returned: PriorityQueue[i64],
}

impl A1SeatManager {
    fn new(n: i64) -> A1SeatManager {
        A1SeatManager { next: 1, returned: PriorityQueue.new() }
    }

    fn reserve(mut ref self) -> i64 {
        match self.returned.pop() {
            Some(seat) => seat,
            None => {
                self.next += 1;
                self.next - 1
            }
        }
    }

    fn unreserve(mut ref self, seat_number: i64) {
        self.returned.push(seat_number);
    }
}

// ---- seat_manager_set.kara ----
struct A2SeatManager {
    free: SortedSet[i64],
}

impl A2SeatManager {
    fn new(n: i64) -> A2SeatManager {
        A2SeatManager { free: (1..n + 1).collect() }
    }

    fn reserve(mut ref self) -> i64 {
        let seat = *self.free.min().unwrap();
        self.free.remove(seat);
        seat
    }

    fn unreserve(mut ref self, seat_number: i64) {
        self.free.insert(seat_number);
    }
}

// ---- seat_manager_tree.kara ----
struct A3SeatManager {
    size: i64,
    free: Vec[i64],
}

impl A3SeatManager {
    fn new(n: i64) -> A3SeatManager {
        let mut size = 1;
        while size < n {
            size *= 2;
        }
        let mut free: Vec[i64] = Vec.filled(2 * size, 0);
        for seat in 0..n {
            free[size + seat] = 1;
        }
        for node in (1..size).rev() {
            free[node] = free[2 * node] + free[2 * node + 1];
        }
        A3SeatManager { size: size, free: free }
    }

    fn set(mut ref self, seat: i64, count: i64) {
        let mut node = self.size + seat - 1;
        self.free[node] = count;
        while node > 1 {
            node /= 2;
            self.free[node] = self.free[2 * node] + self.free[2 * node + 1];
        }
    }

    fn reserve(mut ref self) -> i64 {
        let mut node = 1;
        while node < self.size {
            node = if self.free[2 * node] > 0 { 2 * node } else { 2 * node + 1 };
        }
        let seat = node - self.size + 1;
        self.set(seat, 0);
        seat
    }

    fn unreserve(mut ref self, seat_number: i64) {
        self.set(seat_number, 1);
    }
}

// ---- seat_manager_solution.kara ----
import std.cmp.Reverse;

struct A4SeatManager {
    heap: PriorityQueue[Reverse[i32]],
}

impl A4SeatManager {
    fn new(n: i32) -> Self {
        A4SeatManager { heap: PriorityQueue.max_first_from((1..=n).map(|x| Reverse { value: x }).collect()) }
    }

    fn reserve(mut ref self) -> i32 {
        self.heap.pop().unwrap().value
    }

    fn unreserve(mut ref self, seat_number: i32) {
        self.heap.push(Reverse { value: seat_number });
    }
}
// ---- the differential -------------------------------------------------------

// each arm's manager behind one face, so one driver runs them all
trait Seats {
    fn take(mut ref self) -> i64;
    fn give(mut ref self, seat: i64);
}

impl Seats for A0SeatManager {
    fn take(mut ref self) -> i64 {
        self.reserve()
    }

    fn give(mut ref self, seat: i64) {
        self.unreserve(seat);
    }
}

impl Seats for A1SeatManager {
    fn take(mut ref self) -> i64 {
        self.reserve()
    }

    fn give(mut ref self, seat: i64) {
        self.unreserve(seat);
    }
}

impl Seats for A2SeatManager {
    fn take(mut ref self) -> i64 {
        self.reserve()
    }

    fn give(mut ref self, seat: i64) {
        self.unreserve(seat);
    }
}

impl Seats for A3SeatManager {
    fn take(mut ref self) -> i64 {
        self.reserve()
    }

    fn give(mut ref self, seat: i64) {
        self.unreserve(seat);
    }
}

impl Seats for A4SeatManager {
    fn take(mut ref self) -> i64 {
        self.reserve()
    }

    fn give(mut ref self, seat: i64) {
        self.unreserve(seat as i32);
    }
}

// runs `ops` on `seats`: a 0 reserves, and the seat is gathered; a seat
// number gives that seat back
fn drive[S: Seats](seats: mut ref S, ops: Slice[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for op in ops.iter() {
        if op == 0 {
            out.push(seats.take());
        } else {
            seats.give(op);
        }
    }
    out
}

fn arm(i: i64, n: i64, ops: Slice[i64]) -> Vec[i64] {
    match i {
        0 => {
            let mut s = A0SeatManager.new(n);
            drive(mut s, ops)
        }
        1 => {
            let mut s = A1SeatManager.new(n);
            drive(mut s, ops)
        }
        2 => {
            let mut s = A2SeatManager.new(n);
            drive(mut s, ops)
        }
        3 => {
            let mut s = A3SeatManager.new(n);
            drive(mut s, ops)
        }
        _ => {
            let mut s = A4SeatManager.new(n as i32);
            drive(mut s, ops)
        }
    }
}

// the statement read literally: every seat marked reserved or not, a
// reservation the smallest-numbered seat not reserved, and a return its
// seat marked unreserved
fn literal(n: i64, ops: Slice[i64]) -> Vec[i64] {
    let mut reserved: Vec[bool] = Vec.filled(n + 1, false);
    let mut out: Vec[i64] = Vec.new();
    for op in ops.iter() {
        if op == 0 {
            let mut seat = 1;
            while reserved[seat] {
                seat += 1;
            }
            reserved[seat] = true;
            out.push(seat);
        } else {
            reserved[op] = false;
        }
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `len` calls on `n` seats as LeetCode allows them, drawn on the literal
// reading: a reservation while a seat is free, when none is held or by a
// draw, and otherwise a held seat drawn at random given back
fn draw(seed: mut ref i64, n: i64, len: i64) -> Vec[i64] {
    let mut held: Vec[i64] = Vec.new();
    let mut ops: Vec[i64] = Vec.new();
    for _ in 0..len {
        if held.len() < n and (held.is_empty() or next_random(mut seed) % 5 < 3) {
            ops.push(0);
            let seats = literal(n, ops[..]);
            held.push(seats[seats.len() - 1]);
        } else {
            let at = next_random(mut seed) % held.len();
            ops.push(held.swap_remove(at));
        }
    }
    ops
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, n: i64, ops: Slice[i64]) {
    t.cases += 1;
    let star = arm(0, n, ops);
    for x in star.iter() {
        t.check = (t.check * 31 + x) % 1000000007;
    }
    let want = literal(n, ops);
    let held_at_end = ops.iter().filter(|op| op == 0).count() - ops.iter().filter(|op| op > 0).count();
    let mut again = ops.to_vec();
    if held_at_end < n {
        let after = literal(n, ops).len();
        again.push(0);
        let next = literal(n, again[..])[after];
        again.push(next);
        again.push(0);
    }
    for i in 0..5 {
        let what = f"arm {i} on {n} seats, {ops}";
        let got = arm(i, n, ops);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: each seat from 1 to `n`, none handed out while it is held
        let mut holding: Vec[bool] = Vec.filled(n + 2, false);
        let mut ok = got.len() == ops.iter().filter(|op| op == 0).count();
        let mut at = 0;
        for op in ops.iter() {
            if not ok {
                break;
            }
            if op == 0 {
                let seat = got[at];
                at += 1;
                ok = seat >= 1 and seat <= n and not holding[seat];
                if ok {
                    holding[seat] = true;
                }
            } else {
                holding[op] = false;
            }
        }
        expect(mut t, 2, ok, f"P2 {what}");
        // P3: five seats more change nothing, as the lowest free seat is
        // never past the seats held
        expect(mut t, 3, arm(i, n + 5, ops) == got, f"P3 {what}");
        // P4: a seat reserved, given back and reserved again is the same
        // seat
        let twice = arm(i, n, again[..]);
        expect(mut t, 4, held_at_end == n or (twice.len() >= 2 and twice[twice.len() - 1] == twice[twice.len() - 2]), f"P4 {what}");
        // P5: each reservation at most one past the seats held before it
        let mut held = 0;
        let mut within = true;
        let mut k = 0;
        for op in ops.iter() {
            if op == 0 {
                if k < got.len() and got[k] > held + 1 {
                    within = false;
                }
                k += 1;
                held += 1;
            } else {
                held -= 1;
            }
        }
        expect(mut t, 5, within, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 random runs of 1 to 40 calls on 1 to 12 seats
    let mut seed = 1845;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 12;
        let len = 1 + next_random(mut seed) % 40;
        let ops = draw(mut seed, n, len);
        check_case(mut t, n, ops[..]);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
