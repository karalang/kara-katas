// LeetCode #1846: Maximum Element After Decreasing and Rearranging -- the
// ★ arm's walk with the numbers in a `PriorityQueue`, which pops the
// smallest first, so they come out in order without a sort.
// O(n log n)

fn maximum_element_after_decrementing_and_rearranging(arr: own Vec[i64]) -> i64 {
    let mut queue: PriorityQueue[i64] = arr.into_iter().collect();
    let mut top = 0;
    while let Some(x) = queue.pop() {
        top = (top + 1).min(x);
    }
    top
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{maximum_element_after_decrementing_and_rearranging([2, 2, 1, 2, 1])} {maximum_element_after_decrementing_and_rearranging([100, 1, 1000])} {maximum_element_after_decrementing_and_rearranging([1, 2, 3, 4, 5])}");
    // the edges: one number, a 1 and the most; every number the same; the
    // numbers in falling order; a gap the rest climb over; one number
    // held down by a 1 it must follow
    println(f"{maximum_element_after_decrementing_and_rearranging([1])} {maximum_element_after_decrementing_and_rearranging([1000000000])} {maximum_element_after_decrementing_and_rearranging([5, 5, 5, 5, 5])} {maximum_element_after_decrementing_and_rearranging([5, 4, 3, 2, 1])} {maximum_element_after_decrementing_and_rearranging([1, 1, 9, 9, 9])} {maximum_element_after_decrementing_and_rearranging([1, 1, 1, 100])}");
    // the constraints' most: 10^5 numbers all 10^9, and 10^5 drawn from 1
    // to 10^9 and from 1 to 50000
    let all: Vec[i64] = Vec.filled(100000, 1000000000);
    let mut seed = 1846;
    let mut wide: Vec[i64] = Vec.new();
    let mut narrow: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        wide.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000);
        narrow.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 50000);
    }
    println(f"the most: {maximum_element_after_decrementing_and_rearranging(all)} {maximum_element_after_decrementing_and_rearranging(wide)} {maximum_element_after_decrementing_and_rearranging(narrow)}");
    // 3000 random lists of 1 to 20 numbers from 1 to 25
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 20;
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            arr.push(1 + next_random(mut seed) % 25);
        }
        check = (check * 31 + maximum_element_after_decrementing_and_rearranging(arr)) % 1000000007;
    }
    println(f"3000 random lists: checksum {check}");
}
