// LeetCode #1830: Minimum Number of Operations to Make String Sorted -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac fix`

const MOD: i64 = 1_000_000_007;

fn pow_mod(b: i64, e: i64) -> i64 {
    let mut b = b;
    let mut e = e;
    let mut r = 1;
    b %= MOD;
    while e > 0 {
        if e & 1 == 1 {
            r = r * b % MOD;
        }
        b = b * b % MOD;
        e >>= 1;
    }
    r
}

struct Solution {}

impl Solution {
    pub fn make_string_sorted(s: String) -> i32 {
        let n = s.len();
        let mut fact = Vec.filled(n + 1, 1);
        let mut inv = Vec.filled(n + 1, 1);
        for i in 1..=n {
            fact[i] = fact[i - 1] * i % MOD;
        }
        inv[n] = pow_mod(fact[n], MOD - 2);
        for i in (0..n).rev() {
            inv[i] = inv[i + 1] * (i + 1) % MOD;
        }
        let bytes = s.bytes();
        let mut cnt = [0usize; 26];
        let mut ans = 0;
        for i in (0..n).rev() {
            let c = (bytes[i] - b'a') as usize;
            cnt[c] += 1;
            let smaller: usize = cnt[..c].iter().sum();
            let mut ways = fact[n - i - 1] * smaller as i64 % MOD;
            for k in cnt.iter() {
                ways = ways * inv[k] % MOD;
            }
            ans = (ans + ways) % MOD;
        }
        ans as i32
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's four examples
    println(f"{Solution.make_string_sorted("cba")} {Solution.make_string_sorted("aabaa")} {Solution.make_string_sorted("cdbea")} {Solution.make_string_sorted("leetcodeleetcodeleetcode")}");
    // the edges: one letter; a string already sorted; one letter many
    // times; the last permutation of a b c d, 4! - 1 steps from the first;
    // z then a, one step
    println(f"{Solution.make_string_sorted("q")} {Solution.make_string_sorted("abcz")} {Solution.make_string_sorted("mmmm")} {Solution.make_string_sorted("dcba")} {Solution.make_string_sorted("za")}");
    // the constraints' most: 3000 letters, the alphabet backwards over and
    // over, and random letters
    let mut seed = 1830;
    let backwards: String = (0..3000).map(|i| (b'z' - (i % 26) as u8) as char).collect();
    let random: String = (0..3000).map(|_| (b'a' + (next_random(mut seed) % 26) as u8) as char).collect();
    println(f"the most: {Solution.make_string_sorted(backwards)} {Solution.make_string_sorted(random)}");
    // 3000 random strings of 1 to 12 letters from a to e
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 12;
        let s: String = (0..n).map(|_| (b'a' + (next_random(mut seed) % 5) as u8) as char).collect();
        check = (check * 31 + Solution.make_string_sorted(s)) % 1000000007;
    }
    println(f"3000 random strings: checksum {check}");
}
