// LeetCode #1830: Minimum Number of Operations to Make String Sorted -- the
// ★ arm: each operation steps the string back to the permutation of its
// letters just before it, so the count is the string's rank among those
// permutations. Walking from the right, a place adds the permutations of
// its suffix that start with a smaller letter: (m - 1)! times the smaller
// letters of the suffix, over the factorials of its letter counts, with
// the factorials and their inverses mod 10^9 + 7 in tables.
// O(26 n)

const MOD: i64 = 1000000007;

fn power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut b = base % MOD;
    let mut e = exp;
    while e > 0 {
        if e % 2 == 1 {
            result = result * b % MOD;
        }
        b = b * b % MOD;
        e /= 2;
    }
    result
}

fn make_string_sorted(s: String) -> i64 {
    let letters = s.bytes();
    let n = letters.len();
    let mut fact: Vec[i64] = Vec.filled(n + 1, 1);
    for i in 1..n + 1 {
        fact[i] = fact[i - 1] * i % MOD;
    }
    let mut inverse: Vec[i64] = Vec.filled(n + 1, 1);
    inverse[n] = power(fact[n], MOD - 2);
    for i in (0..n).rev() {
        inverse[i] = inverse[i + 1] * (i + 1) % MOD;
    }
    let mut count = [0; 26];
    let mut operations = 0;
    for i in (0..n).rev() {
        let c = (letters[i] - b'a') as i64;
        count[c] += 1;
        let smaller: i64 = count[..c].iter().sum();
        let mut ways = fact[n - 1 - i] * smaller % MOD;
        for k in count.iter() {
            ways = ways * inverse[k] % MOD;
        }
        operations = (operations + ways) % MOD;
    }
    operations
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's four examples
    println(f"{make_string_sorted("cba")} {make_string_sorted("aabaa")} {make_string_sorted("cdbea")} {make_string_sorted("leetcodeleetcodeleetcode")}");
    // the edges: one letter; a string already sorted; one letter many
    // times; the last permutation of a b c d, 4! - 1 steps from the first;
    // z then a, one step
    println(f"{make_string_sorted("q")} {make_string_sorted("abcz")} {make_string_sorted("mmmm")} {make_string_sorted("dcba")} {make_string_sorted("za")}");
    // the constraints' most: 3000 letters, the alphabet backwards over and
    // over, and random letters
    let mut seed = 1830;
    let backwards: String = (0..3000).map(|i| (b'z' - (i % 26) as u8) as char).collect();
    let random: String = (0..3000).map(|_| (b'a' + (next_random(mut seed) % 26) as u8) as char).collect();
    println(f"the most: {make_string_sorted(backwards)} {make_string_sorted(random)}");
    // 3000 random strings of 1 to 12 letters from a to e
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 12;
        let s: String = (0..n).map(|_| (b'a' + (next_random(mut seed) % 5) as u8) as char).collect();
        check = (check * 31 + make_string_sorted(s)) % 1000000007;
    }
    println(f"3000 random strings: checksum {check}");
}
