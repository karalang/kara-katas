// LeetCode #1812: Determine Color of a Chessboard Square -- the bytes'
// own parities: `a` is 97 and `1` is 49, both odd, so a square is white
// exactly when the low bits of its two bytes differ.
// O(1)

fn square_is_white(coordinates: String) -> bool {
    let bytes = coordinates.bytes();
    ((bytes[0] ^ bytes[1]) & 1) == 1
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples
    println(f"{square_is_white("a1".to_string())} {square_is_white("h3".to_string())} {square_is_white("c7".to_string())}");
    // the edges: the other three corners, and b1 beside a1
    println(f"{square_is_white("a8".to_string())} {square_is_white("h1".to_string())} {square_is_white("h8".to_string())} {square_is_white("b1".to_string())}");
    // every square, rank 8 at the top, W for white and B for black, and
    // the count of white squares
    let mut whites = 0;
    for rank in (1..9).rev() {
        let mut row = String.new();
        for file in "abcdefgh".chars() {
            let name = f"{file}{rank}";
            if square_is_white(name) {
                row.push('W');
                whites += 1;
            } else {
                row.push('B');
            }
        }
        println(row);
    }
    println(f"{whites} white squares");
}
