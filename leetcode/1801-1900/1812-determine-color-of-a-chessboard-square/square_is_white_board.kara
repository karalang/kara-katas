// LeetCode #1812: Determine Color of a Chessboard Square -- the board
// itself: an 8 by 8 `Vec[Vec[bool]]` filled square by square, each white
// square the opposite colour of the one before it in its rank, each rank
// starting opposite to the rank below, and the square looked up by name.
// O(1), 64 squares built per call

fn square_is_white(coordinates: String) -> bool {
    let mut board: Vec[Vec[bool]] = Vec.new();
    let mut first = false;
    for _ in 0..8 {
        let mut rank: Vec[bool] = Vec.new();
        let mut white = first;
        for _ in 0..8 {
            rank.push(white);
            white = not white;
        }
        board.push(rank);
        first = not first;
    }
    let chars: Vec[char] = coordinates.chars().collect();
    let file = "abcdefgh".find(chars[0].to_string()).unwrap();
    let rank = chars[1].to_digit(10).unwrap() as i64 - 1;
    board[rank][file]
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples
    println(f"{square_is_white("a1".to_string())} {square_is_white("h3".to_string())} {square_is_white("c7".to_string())}");
    // the edges: the other three corners, and b1 beside a1
    println(f"{square_is_white("a8".to_string())} {square_is_white("h1".to_string())} {square_is_white("h8".to_string())} {square_is_white("b1".to_string())}");
    // every square, rank 8 at the top, W for white and B for black, and
    // the count of white squares
    let mut whites = 0;
    for rank in (1..9).rev() {
        let mut row = String.new();
        for file in "abcdefgh".chars() {
            let name = f"{file}{rank}";
            if square_is_white(name) {
                row.push('W');
                whites += 1;
            } else {
                row.push('B');
            }
        }
        println(row);
    }
    println(f"{whites} white squares");
}
