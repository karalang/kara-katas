// LeetCode #1812: Determine Color of a Chessboard Square -- a Rust solution
// as LeetCode's Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn square_is_white(coordinates: String) -> bool {
        let c = coordinates.bytes();
        (c[0] - b'a' + c[1] - b'1') % 2 == 1
    }
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples
    println(f"{Solution.square_is_white("a1".to_string())} {Solution.square_is_white("h3".to_string())} {Solution.square_is_white("c7".to_string())}");
    // the edges: the other three corners, and b1 beside a1
    println(f"{Solution.square_is_white("a8".to_string())} {Solution.square_is_white("h1".to_string())} {Solution.square_is_white("h8".to_string())} {Solution.square_is_white("b1".to_string())}");
    // every square, rank 8 at the top, W for white and B for black, and
    // the count of white squares
    let mut whites = 0;
    for rank in (1..9).rev() {
        let mut row = String.new();
        for file in "abcdefgh".chars() {
            let name = f"{file}{rank}";
            if Solution.square_is_white(name) {
                row.push('W');
                whites += 1;
            } else {
                row.push('B');
            }
        }
        println(row);
    }
    println(f"{whites} white squares");
}
