// LeetCode #1806: Minimum Number of Operations to Reinitialize a
// Permutation -- the ★ arm: the operation applied as the statement writes
// it, a new `arr` from `perm` each time, until `perm` is back where it
// started.
// O(n * answer), at most O(n^2)

fn reinitialize_permutation(n: i32) -> i32 {
    let size = n as i64;
    let start: Vec[i64] = (0..size).collect();
    let mut perm = start.clone();
    let mut ops = 0;
    loop {
        let mut arr: Vec[i64] = Vec.filled(size, 0);
        for i in 0..size {
            arr[i] = if i % 2 == 0 { perm[i / 2] } else { perm[size / 2 + (i - 1) / 2] };
        }
        perm = arr;
        ops += 1;
        if perm == start {
            return ops;
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples
    println(f"{reinitialize_permutation(2)} {reinitialize_permutation(4)} {reinitialize_permutation(6)}");
    // the edges: n = 2^k + 2, where the answer is smallest for its size;
    // n - 1 prime with 2 a primitive root, where it is n - 2; the
    // constraints' most
    println(f"{reinitialize_permutation(66)} {reinitialize_permutation(514)} {reinitialize_permutation(12)} {reinitialize_permutation(14)} {reinitialize_permutation(1000)}");
    // every even n from 2 to 1000
    let mut check = 0;
    let mut total = 0;
    let mut most = 0;
    for half in 1..501 {
        let ops = reinitialize_permutation((2 * half) as i32);
        check = (check * 31 + ops) % 1000000007;
        total += ops;
        most = most.max(ops);
    }
    println(f"every even n to 1000: checksum {check}, total {total}, most {most}");
}
