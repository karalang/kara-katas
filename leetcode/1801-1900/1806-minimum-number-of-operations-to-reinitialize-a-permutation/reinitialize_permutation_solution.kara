// LeetCode #1806: Minimum Number of Operations to Reinitialize a
// Permutation -- a Rust solution as LeetCode's Rust users write it, carried
// to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn reinitialize_permutation(n: i32) -> i32 {
        let n = n as i64;
        let mut perm: Vec[i64] = (0..n).collect();
        let target = perm.clone();
        let mut ans = 0;
        loop {
            let mut arr = Vec.filled(n, 0);
            for i in 0..n {
                arr[i] = if i % 2 == 0 { perm[i / 2] } else { perm[n / 2 + (i - 1) / 2] };
            }
            perm = arr;
            ans += 1;
            if perm == target {
                return ans;
            }
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples
    println(f"{Solution.reinitialize_permutation(2)} {Solution.reinitialize_permutation(4)} {Solution.reinitialize_permutation(6)}");
    // the edges: n = 2^k + 2, where the answer is smallest for its size;
    // n - 1 prime with 2 a primitive root, where it is n - 2; the
    // constraints' most
    println(f"{Solution.reinitialize_permutation(66)} {Solution.reinitialize_permutation(514)} {Solution.reinitialize_permutation(12)} {Solution.reinitialize_permutation(14)} {Solution.reinitialize_permutation(1000)}");
    // every even n from 2 to 1000
    let mut check = 0;
    let mut total = 0;
    let mut most = 0;
    for half in 1..501 {
        let ops = Solution.reinitialize_permutation((2 * half) as i32);
        check = (check * 31 + ops) % 1000000007;
        total += ops;
        most = most.max(ops);
    }
    println(f"every even n to 1000: checksum {check}, total {total}, most {most}");
}
