// LeetCode #1801: Number of Orders in the Backlog --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- get_number_of_backlog_orders.kara ----
fn a0_get_number_of_backlog_orders(orders: Vec[Vec[i32]]) -> i32 {
    let mut buys: PriorityQueue[(i32, i64)] = PriorityQueue.max_first();
    let mut sells: PriorityQueue[(i32, i64)] = PriorityQueue.new();
    for order in orders.iter() {
        let price = order[0];
        let mut amount = order[1] as i64;
        if order[2] == 0 {
            while amount > 0 {
                match sells.peek() {
                    Some((p, _)) if p <= price => {}
                    _ => break,
                }
                let (p, a) = sells.pop().unwrap();
                if a > amount {
                    sells.push((p, a - amount));
                    amount = 0;
                } else {
                    amount -= a;
                }
            }
            if amount > 0 {
                buys.push((price, amount));
            }
        } else {
            while amount > 0 {
                match buys.peek() {
                    Some((p, _)) if p >= price => {}
                    _ => break,
                }
                let (p, a) = buys.pop().unwrap();
                if a > amount {
                    buys.push((p, a - amount));
                    amount = 0;
                } else {
                    amount -= a;
                }
            }
            if amount > 0 {
                sells.push((price, amount));
            }
        }
    }
    let total: i64 = buys.iter().map(|(_, a)| a).sum() + sells.iter().map(|(_, a)| a).sum();
    (total % 1000000007) as i32
}

// ---- get_number_of_backlog_orders_sorted.kara ----
fn a1_get_number_of_backlog_orders(orders: Vec[Vec[i32]]) -> i32 {
    let mut buys: SortedMap[i32, i64] = SortedMap.new();
    let mut sells: SortedMap[i32, i64] = SortedMap.new();
    for order in orders.iter() {
        let price = order[0];
        let mut amount = order[1] as i64;
        let (book, other) = if order[2] == 0 { (mut ref buys, mut ref sells) } else { (mut ref sells, mut ref buys) };
        while amount > 0 {
            let best = if order[2] == 0 { other.first() } else { other.last() };
            let Some((p, a)) = best else { break };
            let (p, a) = (*p, *a);
            if (order[2] == 0 and p > price) or (order[2] == 1 and p < price) {
                break;
            }
            if a > amount {
                other[p] = a - amount;
                amount = 0;
            } else {
                other.remove(p);
                amount -= a;
            }
        }
        if amount > 0 {
            let rest = book.get(price).cloned().unwrap_or(0);
            book[price] = rest + amount;
        }
    }
    let total: i64 = buys.values().sum() + sells.values().sum();
    (total % 1000000007) as i32
}

// ---- get_number_of_backlog_orders_negate.kara ----
fn a2_get_number_of_backlog_orders(orders: Vec[Vec[i32]]) -> i32 {
    let mut buys: PriorityQueue[(i64, i64)] = PriorityQueue.max_first();
    let mut sells: PriorityQueue[(i64, i64)] = PriorityQueue.max_first();
    for order in orders.iter() {
        let price = order[0] as i64;
        let mut amount = order[1] as i64;
        let buying = order[2] == 0;
        // the other side, and the key its best must reach
        let (book, other, key, reach) = if buying {
            (mut ref buys, mut ref sells, price, -price)
        } else {
            (mut ref sells, mut ref buys, -price, price)
        };
        while amount > 0 and other.peek().is_some_and(|(k, _)| k >= reach) {
            let (k, a) = other.pop().unwrap();
            if a > amount {
                other.push((k, a - amount));
                amount = 0;
            } else {
                amount -= a;
            }
        }
        if amount > 0 {
            book.push((key, amount));
        }
    }
    let mut total: i64 = 0;
    for (_, a) in buys.iter().chain(sells.iter()) {
        total += a;
    }
    (total % 1000000007) as i32
}

// ---- get_number_of_backlog_orders_sortedvec.kara ----
fn a3_get_number_of_backlog_orders(orders: Vec[Vec[i32]]) -> i32 {
    let mut buys: Vec[(i32, i64)] = Vec.new();
    let mut sells: Vec[(i32, i64)] = Vec.new();
    for order in orders.iter() {
        let price = order[0];
        let mut amount = order[1] as i64;
        if order[2] == 0 {
            while amount > 0 and sells.len() > 0 and sells[sells.len() - 1].0 <= price {
                let last = sells.len() - 1;
                if sells[last].1 > amount {
                    sells[last].1 -= amount;
                    amount = 0;
                } else {
                    amount -= sells[last].1;
                    sells.pop();
                }
            }
            if amount > 0 {
                let at = buys.partition_point(|(p, _)| p < price);
                buys.insert(at, (price, amount));
            }
        } else {
            while amount > 0 and buys.len() > 0 and buys[buys.len() - 1].0 >= price {
                let last = buys.len() - 1;
                if buys[last].1 > amount {
                    buys[last].1 -= amount;
                    amount = 0;
                } else {
                    amount -= buys[last].1;
                    buys.pop();
                }
            }
            if amount > 0 {
                let at = sells.partition_point(|(p, _)| p > price);
                sells.insert(at, (price, amount));
            }
        }
    }
    let total: i64 = buys.iter().map(|(_, a)| a).sum() + sells.iter().map(|(_, a)| a).sum();
    (total % 1000000007) as i32
}

// ---- get_number_of_backlog_orders_solution.kara ----
import std.cmp.Reverse;

struct A4Solution {}

impl A4Solution {
    pub fn get_number_of_backlog_orders(orders: Vec[Vec[i32]]) -> i32 {
        let mut buy: PriorityQueue[(i32, i32)] = PriorityQueue.max_first();
        let mut sell: PriorityQueue[Reverse[(i32, i32)]] = PriorityQueue.max_first();
        for o in orders {
            let mut (price, amount, t) = (o[0], o[1], o[2]);
            if t == 0 {
                while amount > 0 and not sell.is_empty() and sell.peek().unwrap().value .0 <= price {
                    let Reverse { value: (p, a) } = sell.pop().unwrap();
                    if a > amount {
                        sell.push(Reverse { value: (p, a - amount) });
                        amount = 0;
                    } else {
                        amount -= a;
                    }
                }
                if amount > 0 {
                    buy.push((price, amount));
                }
            } else {
                while amount > 0 and not buy.is_empty() and buy.peek().unwrap().0 >= price {
                    let (p, a) = buy.pop().unwrap();
                    if a > amount {
                        buy.push((p, a - amount));
                        amount = 0;
                    } else {
                        amount -= a;
                    }
                }
                if amount > 0 {
                    sell.push(Reverse { value: (price, amount) });
                }
            }
        }
        let mut total: i64 = 0;
        for (_, a) in buy {
            total += a;
        }
        for Reverse { value: (_, a) } in sell {
            total += a;
        }
        (total % 1_000_000_007) as i32
    }
}

fn a4_get_number_of_backlog_orders(orders: Vec[Vec[i32]]) -> i32 {
    A4Solution.get_number_of_backlog_orders(orders)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: an order of amount a is a orders, placed
// one at a time; a buy looks at the sell with the smallest price in the
// backlog, and when that price is no larger than its own the two are
// executed and the sell removed, else the buy joins the backlog; a sell
// looks at the buy with the largest price the same way
fn literal(orders: Vec[Vec[i32]]) -> i32 {
    let mut buys: Vec[i32] = Vec.new();
    let mut sells: Vec[i32] = Vec.new();
    for order in orders.iter() {
        for _ in 0..order[1] {
            let price = order[0];
            if order[2] == 0 {
                let mut at = -1;
                for k in 0..sells.len() {
                    if at < 0 or sells[k] < sells[at] {
                        at = k;
                    }
                }
                if at >= 0 and sells[at] <= price {
                    sells.remove(at);
                } else {
                    buys.push(price);
                }
            } else {
                let mut at = -1;
                for k in 0..buys.len() {
                    if at < 0 or buys[k] > buys[at] {
                        at = k;
                    }
                }
                if at >= 0 and buys[at] >= price {
                    buys.remove(at);
                } else {
                    sells.push(price);
                }
            }
        }
    }
    ((buys.len() + sells.len()) % 1000000007) as i32
}

fn arm(i: i64, orders: Vec[Vec[i32]]) -> i32 {
    match i {
        0 => a0_get_number_of_backlog_orders(orders),
        1 => a1_get_number_of_backlog_orders(orders),
        2 => a2_get_number_of_backlog_orders(orders),
        3 => a3_get_number_of_backlog_orders(orders),
        _ => a4_get_number_of_backlog_orders(orders),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, orders: Vec[Vec[i32]]) {
    t.cases += 1;
    let star = arm(0, orders);
    t.check = (t.check * 31 + star) % 1000000007;
    let buys: i64 = orders.iter().filter(|o| o[2] == 0).map(|o| o[1] as i64).sum();
    let sells: i64 = orders.iter().filter(|o| o[2] == 1).map(|o| o[1] as i64).sum();
    let small = buys + sells <= 400;
    let top = orders.iter().map(|o| o[0]).max().unwrap();
    // every order of more than one split in two, the same price and type
    let mut split: Vec[Vec[i32]] = Vec.new();
    for o in orders.iter() {
        if o[1] > 1 {
            split.push([o[0], o[1] / 2, o[2]].to_vec());
            split.push([o[0], o[1] - o[1] / 2, o[2]].to_vec());
        } else {
            split.push(o.clone());
        }
    }
    let spread: Vec[Vec[i32]] = orders.iter().map(|o| [2 * o[0] - 1, o[1], o[2]].to_vec()).collect();
    let flipped: Vec[Vec[i32]] = orders.iter().map(|o| [1000000001 - o[0], o[1], 1 - o[2]].to_vec()).collect();
    for i in 0..5 {
        let what = f"arm {i} on {orders}";
        let got = arm(i, orders);
        // P1: the statement read literally, while there are at most 400
        // orders in all
        if small {
            expect(mut t, 1, got == literal(orders), f"P1 {what}");
        }
        // P2: every order of more than one split in two, the same price
        // and type, gives the same answer
        expect(mut t, 2, arm(i, split) == got, f"P2 {what}");
        // P3: every price p made 2p - 1 keeps every comparison, so gives
        // the same answer, while the prices are at most 5 * 10^8
        if top <= 500000000 {
            expect(mut t, 3, arm(i, spread) == got, f"P3 {what}");
        }
        // P4: every buy made a sell and every sell a buy, each price p
        // made 10^9 + 1 - p, gives the same answer
        expect(mut t, 4, arm(i, flipped) == got, f"P4 {what}");
        // P5: each match takes one buy and one sell, so the answer is no
        // less than the larger side's excess, no more than every order,
        // and has the parity of every order, while that is below the
        // modulus
        if buys + sells < 1000000007 {
            let g = got as i64;
            let ok = g >= (buys - sells).abs() and g <= buys + sells and (buys + sells - g) % 2 == 0;
            expect(mut t, 5, ok, f"P5 {what}");
        }
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn orders_of(rows: Vec[(i32, i32, i32)]) -> Vec[Vec[i32]] {
    rows.iter().map(|(p, a, t)| [p, a, t].to_vec()).collect()
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples, the edges, 2000 orders of prices and amounts of
    // up to 10^9, and 1991 random cases of 1 to 14 orders of prices of 1
    // to 10 and amounts of 1 to 10. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[Vec[Vec[i32]]] = Vec.new();
    cases.push(orders_of([(10, 5, 0), (15, 2, 1), (25, 1, 1), (30, 4, 0)].to_vec()));
    cases.push(orders_of([(7, 1000000000, 1), (15, 3, 0), (5, 999999995, 0), (5, 1, 1)].to_vec()));
    cases.push(orders_of([(5, 3, 1)].to_vec()));
    cases.push(orders_of([(4, 2, 0), (6, 3, 1)].to_vec()));
    cases.push(orders_of([(6, 3, 1), (6, 3, 0)].to_vec()));
    cases.push(orders_of([(5, 4, 1), (5, 1, 0)].to_vec()));
    cases.push(orders_of([(1, 1, 1), (2, 2, 1), (3, 3, 1), (9, 10, 0)].to_vec()));
    cases.push(orders_of([(1, 1000000000, 0), (2, 1000000000, 0)].to_vec()));
    let mut seed = 18011;
    cases.push((0..2000).map(|_| {
        let p = (1 + next_random(mut seed) % 1000000000) as i32;
        let a = (1 + next_random(mut seed) % 1000000000) as i32;
        let k = (next_random(mut seed) % 2) as i32;
        [p, a, k].to_vec()
    }).collect());
    for _ in 0..1991 {
        let n = 1 + next_random(mut seed) % 14;
        cases.push((0..n).map(|_| {
            let p = (1 + next_random(mut seed) % 10) as i32;
            let a = (1 + next_random(mut seed) % 10) as i32;
            let k = (next_random(mut seed) % 2) as i32;
            [p, a, k].to_vec()
        }).collect());
    }
    for j in 0..cases.len() {
        check_case(mut t, cases[j].clone());
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
