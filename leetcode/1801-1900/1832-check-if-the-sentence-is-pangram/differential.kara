// LeetCode #1832: Check if the Sentence Is Pangram --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- check_if_pangram.kara ----
fn a0_check_if_pangram(sentence: String) -> bool {
    let mut seen = 0;
    for b in sentence.bytes().iter() {
        seen |= 1 << (b - b'a');
    }
    seen == (1 << 26) - 1
}

// ---- check_if_pangram_set.kara ----
fn a1_check_if_pangram(sentence: String) -> bool {
    let letters: Set[char] = sentence.chars().collect();
    letters.len() == 26
}

// ---- check_if_pangram_all.kara ----
fn a2_check_if_pangram(sentence: String) -> bool {
    "abcdefghijklmnopqrstuvwxyz".chars().all(|c| sentence.contains(c.to_string()))
}

// ---- check_if_pangram_count.kara ----
fn a3_check_if_pangram(sentence: String) -> bool {
    let mut count = [0; 26];
    for b in sentence.bytes().iter() {
        count[b - b'a'] += 1;
    }
    count.iter().all(|c| c > 0)
}

// ---- check_if_pangram_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn check_if_pangram(sentence: String) -> bool {
        Set[char].from_iter(sentence.chars()).len() == 26
    }
}
// ---- the differential -------------------------------------------------------

// the statement read literally: each letter of the alphabet in turn, the
// sentence walked to find it, and a pangram when every one is found
fn literal(sentence: Str) -> bool {
    let letters = sentence.bytes();
    for c in b'a'..b'z' + 1 {
        let mut found = false;
        for b in letters.iter() {
            if b == c {
                found = true;
            }
        }
        if not found {
            return false;
        }
    }
    true
}

fn arm(i: i64, sentence: Str) -> bool {
    match i {
        0 => a0_check_if_pangram(sentence.to_string()),
        1 => a1_check_if_pangram(sentence.to_string()),
        2 => a2_check_if_pangram(sentence.to_string()),
        3 => a3_check_if_pangram(sentence.to_string()),
        _ => A4Solution.check_if_pangram(sentence.to_string()),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, sentence: Str) {
    t.cases += 1;
    let star = arm(0, sentence);
    t.check = (t.check * 31 + if star { 2 } else { 1 }) % 1000000007;
    let want = literal(sentence);
    let letters = sentence.bytes();
    let reversed: String = letters.iter().rev().map(|b| b as char).collect();
    let completed = f"{sentence}abcdefghijklmnopqrstuvwxyz";
    let first = letters[0];
    let without: String = letters.iter().filter(|b| b != first).map(|b| b as char).collect();
    for i in 0..5 {
        let what = f"arm {i} on {sentence}";
        let got = arm(i, sentence);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: fewer than 26 letters are never a pangram
        expect(mut t, 2, letters.len() >= 26 or not got, f"P2 {what}");
        // P3: the sentence backwards gives the same answer
        expect(mut t, 3, arm(i, reversed) == got, f"P3 {what}");
        // P4: the alphabet put after it makes any sentence a pangram
        expect(mut t, 4, arm(i, completed), f"P4 {what}");
        // P5: with every copy of its first letter taken out it is none
        expect(mut t, 5, without.len() == 0 or not arm(i, without), f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 random sentences of 1 to 100 letters from the first 24 to 26
    // of the alphabet
    let mut seed = 1832;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 100;
        let span = 24 + next_random(mut seed) % 3;
        let s: String = (0..n).map(|_| (b'a' + (next_random(mut seed) % span) as u8) as char).collect();
        check_case(mut t, s);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
