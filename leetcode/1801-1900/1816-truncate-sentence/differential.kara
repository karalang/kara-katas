// LeetCode #1816: Truncate Sentence --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- truncate_sentence.kara ----
fn a0_truncate_sentence(s: String, k: i64) -> String {
    let words: Vec[Str] = s.split(" ").take(k).collect();
    words.join(" ")
}

// ---- truncate_sentence_scan.kara ----
fn a1_truncate_sentence(s: String, k: i64) -> String {
    let mut out = String.new();
    let mut spaces = 0;
    for c in s.chars() {
        if c == ' ' {
            spaces += 1;
            if spaces == k {
                break;
            }
        }
        out.push(c);
    }
    out
}

// ---- truncate_sentence_find.kara ----
fn a2_truncate_sentence(s: own String, k: i64) -> String {
    let mut end = 0;
    for _ in 0..k {
        match s[end..].find(" ") {
            Some(at) => end += at + 1,
            None => return s,
        }
    }
    s[..end - 1].to_string()
}

// ---- truncate_sentence_words.kara ----
fn a3_truncate_sentence(s: String, k: i64) -> String {
    let words: Vec[Str] = s.split_whitespace().collect();
    words[..k].join(" ")
}

// ---- truncate_sentence_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn truncate_sentence(s: String, k: i32) -> String {
        Vec[Str].from_iter(s.split(" ").take(k)).join(" ")
    }
}
// ---- the differential -------------------------------------------------------

// the statement read literally: a word is a run of letters between
// spaces, and the chars are kept, one at a time, until the k-th word has
// ended
fn literal(s: Str, k: i64) -> String {
    let mut out = String.new();
    let mut words = 0;
    let mut in_word = false;
    for c in s.chars() {
        if c == ' ' {
            if in_word and words == k {
                break;
            }
            in_word = false;
        } else if not in_word {
            in_word = true;
            words += 1;
        }
        out.push(c);
    }
    out
}

fn arm(i: i64, s: Str, k: i64) -> String {
    match i {
        0 => a0_truncate_sentence(s.to_string(), k),
        1 => a1_truncate_sentence(s.to_string(), k),
        2 => a2_truncate_sentence(s.to_string(), k),
        3 => a3_truncate_sentence(s.to_string(), k),
        _ => A4Solution.truncate_sentence(s.to_string(), k as i32),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, s: Str, k: i64) {
    t.cases += 1;
    let n = s.split(" ").count();
    let star = arm(0, s, k);
    for c in star.chars() {
        t.check = (t.check * 31 + c as i64) % 1000000007;
    }
    let want = literal(s, k);
    for i in 0..5 {
        let what = f"arm {i} on '{s}' and {k}";
        let got = arm(i, s, k);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: the answer is the start of the sentence
        expect(mut t, 2, s.starts_with(got.as_str()), f"P2 {what}");
        // P3: the answer has k words
        expect(mut t, 3, got.split(" ").count() == k, f"P3 {what}");
        // P4: truncating again to k changes nothing, and truncating to
        // every word keeps the sentence
        expect(mut t, 4, arm(i, got.as_str(), k) == got and arm(i, s, n) == s, f"P4 {what}");
        // P5: the answer for k is the start of the answer for k + 1
        let next = if k < n { arm(i, s, k + 1) } else { got.clone() };
        expect(mut t, 5, next.starts_with(got.as_str()), f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 random sentences of 1 to 12 words of 1 to 5 letters, each with a
    // k from 1 to its words
    let mut seed = 1816;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 12;
        let mut words: Vec[String] = Vec.new();
        for _ in 0..n {
            let m = 1 + next_random(mut seed) % 5;
            let mut word = String.new();
            for _ in 0..m {
                let base = if next_random(mut seed) % 2 == 0 { 65 } else { 97 };
                word.push(char.try_from((base + next_random(mut seed) % 26) as u32).ok().unwrap());
            }
            words.push(word);
        }
        let k = 1 + next_random(mut seed) % n;
        check_case(mut t, words.join(" ").as_str(), k);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
