// LeetCode #1816: Truncate Sentence -- one walk of the chars, counting the
// spaces met: the k-th space ends the k-th word, so the chars before it are
// the answer, and a sentence of k words or fewer is kept whole.
// O(n)

fn truncate_sentence(s: String, k: i64) -> String {
    let mut out = String.new();
    let mut spaces = 0;
    for c in s.chars() {
        if c == ' ' {
            spaces += 1;
            if spaces == k {
                break;
            }
        }
        out.push(c);
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(truncate_sentence("Hello how are you Contestant".to_string(), 4));
    println(truncate_sentence("What is the solution to this problem".to_string(), 4));
    println(truncate_sentence("chopper is not a tanuki".to_string(), 5));
    // the edges: one word; every word kept; letters of both cases
    println(f"[{truncate_sentence("a".to_string(), 1)}] [{truncate_sentence("ab cd".to_string(), 2)}] [{truncate_sentence("Aa bB Cc".to_string(), 1)}]");
    // the constraints' most: 500 characters of 250 one-letter words
    let longest = Vec.filled(250, "x").join(" ");
    println(f"the most: {longest.len()} {truncate_sentence(longest, 125).len()} {truncate_sentence(longest, 250).len()}");
    // 3000 random sentences of 1 to 12 words of 1 to 5 letters
    let mut seed = 1816;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 12;
        let mut words: Vec[String] = Vec.new();
        for _ in 0..n {
            let m = 1 + next_random(mut seed) % 5;
            let mut word = String.new();
            for _ in 0..m {
                let base = if next_random(mut seed) % 2 == 0 { 65 } else { 97 };
                word.push(char.try_from((base + next_random(mut seed) % 26) as u32).ok().unwrap());
            }
            words.push(word);
        }
        let k = 1 + next_random(mut seed) % n;
        let cut = truncate_sentence(words.join(" "), k);
        total += cut.len();
        for c in cut.chars() {
            check = (check * 31 + c as i64) % 1000000007;
        }
    }
    println(f"3000 random sentences: {total} characters kept, checksum {check}");
}
