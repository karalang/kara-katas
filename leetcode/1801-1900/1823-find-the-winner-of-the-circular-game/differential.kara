// LeetCode #1823: Find the Winner of the Circular Game --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- find_the_winner.kara ----
fn a0_find_the_winner(n: i64, k: i64) -> i64 {
    let mut winner = 0;
    for i in 2..n + 1 {
        winner = (winner + k) % i;
    }
    winner + 1
}

// ---- find_the_winner_simulate.kara ----
fn a1_find_the_winner(n: i64, k: i64) -> i64 {
    let mut friends: Vec[i64] = (1..n + 1).collect();
    let mut at = 0;
    while friends.len() > 1 {
        at = (at + k - 1) % friends.len();
        friends.remove(at);
    }
    friends[0]
}

// ---- find_the_winner_queue.kara ----
fn a2_find_the_winner(n: i64, k: i64) -> i64 {
    let mut circle: VecDeque[i64] = VecDeque.new();
    for friend in 1..n + 1 {
        circle.push_back(friend);
    }
    while circle.len() > 1 {
        for _ in 0..k - 1 {
            let friend = circle.pop_front().unwrap();
            circle.push_back(friend);
        }
        circle.pop_front();
    }
    circle.pop_front().unwrap()
}

// ---- find_the_winner_recursive.kara ----
fn a3_place(n: i64, k: i64) -> i64 {
    if n == 1 {
        return 0;
    }
    (a3_place(n - 1, k) + k) % n
}

fn a3_find_the_winner(n: i64, k: i64) -> i64 {
    a3_place(n, k) + 1
}

// ---- find_the_winner_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn find_the_winner(n: i32, k: i32) -> i32 {
        let mut friends: Vec[i32] = (1..=n).collect();
        let mut idx = 0;
        while friends.len() > 1 {
            idx = (idx + k - 1) % friends.len();
            friends.remove(idx);
        }
        friends[0]
    }
}
// ---- the differential -------------------------------------------------------

// the statement read literally: the friends 1 to n in a circle, each
// marked in or out; from the starting friend, k friends still in are
// counted clockwise, the starting one among them, the last counted leaves,
// and the friend clockwise of it starts the next count
fn literal(n: i64, k: i64) -> i64 {
    let mut out = Vec.filled(n + 1, false);
    let mut start = 1;
    for _ in 0..n - 1 {
        let mut at = start;
        let mut counted = 0;
        loop {
            if not out[at] {
                counted += 1;
                if counted == k {
                    break;
                }
            }
            at = at % n + 1;
        }
        out[at] = true;
        start = at % n + 1;
    }
    (1..n + 1).find(|f| not out[f]).unwrap()
}

fn arm(i: i64, n: i64, k: i64) -> i64 {
    match i {
        0 => a0_find_the_winner(n, k),
        1 => a1_find_the_winner(n, k),
        2 => a2_find_the_winner(n, k),
        3 => a3_find_the_winner(n, k),
        _ => A4Solution.find_the_winner(n as i32, k as i32),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, n: i64, k: i64) {
    t.cases += 1;
    let star = arm(0, n, k);
    t.check = (t.check * 41 + star) % 1000000007;
    let want = literal(n, k);
    for i in 0..5 {
        let what = f"arm {i} on {n} friends counting {k}";
        let got = arm(i, n, k);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: the winner is one of the friends
        expect(mut t, 2, got >= 1 and got <= n, f"P2 {what}");
        // P3: the winner among n is k places on from the winner among
        // n - 1, counted from the one who leaves first
        let step = n == 1 or k > n - 1 or got == (arm(i, n - 1, k) + k - 1) % n + 1;
        expect(mut t, 3, step, f"P3 {what}");
        // P4: counting 1, the last friend is left
        expect(mut t, 4, arm(i, n, 1) == n, f"P4 {what}");
        // P5: counting 2, the winner among 2m is 2w - 1 and among 2m + 1
        // is 2w + 1, w the winner among m
        let half = n < 4 or arm(i, n, 2) == 2 * arm(i, n / 2, 2) + if n % 2 == 0 { -1 } else { 1 };
        expect(mut t, 5, half, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 random circles of 1 to 30 friends, each with a count from 1 to
    // its size
    let mut seed = 1823;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 30;
        let k = 1 + next_random(mut seed) % n;
        check_case(mut t, n, k);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
