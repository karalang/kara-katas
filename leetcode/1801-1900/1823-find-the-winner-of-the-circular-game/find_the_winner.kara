// LeetCode #1823: Find the Winner of the Circular Game -- the ★ arm:
// Josephus's recurrence, with no circle kept. Once the k-th friend leaves,
// the game goes on as a circle of one fewer, started k places on, so the
// winner's place among i friends is k on from its place among i - 1.
// O(n)

fn find_the_winner(n: i64, k: i64) -> i64 {
    let mut winner = 0;
    for i in 2..n + 1 {
        winner = (winner + k) % i;
    }
    winner + 1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{find_the_winner(5, 2)} {find_the_winner(6, 5)}");
    // the edges: one friend; a count of 1, so the last friend is left; two
    // friends; a count that goes round the whole circle
    println(f"{find_the_winner(1, 1)} {find_the_winner(7, 1)} {find_the_winner(2, 2)} {find_the_winner(7, 7)}");
    // the constraints' most: 500 friends, counting 500, 1 and 2
    println(f"the most: {find_the_winner(500, 500)} {find_the_winner(500, 1)} {find_the_winner(500, 2)}");
    // 3000 random circles of 1 to 40 friends, each with a count from 1 to
    // its size
    let mut seed = 1823;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 40;
        let k = 1 + next_random(mut seed) % n;
        check = (check * 41 + find_the_winner(n, k)) % 1000000007;
    }
    println(f"3000 random circles: checksum {check}");
}
