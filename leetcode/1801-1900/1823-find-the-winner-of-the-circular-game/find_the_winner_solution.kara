// LeetCode #1823: Find the Winner of the Circular Game -- a Rust solution
// as LeetCode's Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn find_the_winner(n: i32, k: i32) -> i32 {
        let mut friends: Vec[i32] = (1..=n).collect();
        let mut idx = 0;
        while friends.len() > 1 {
            idx = (idx + k - 1) % friends.len();
            friends.remove(idx);
        }
        friends[0]
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{Solution.find_the_winner(5, 2)} {Solution.find_the_winner(6, 5)}");
    // the edges: one friend; a count of 1, so the last friend is left; two
    // friends; a count that goes round the whole circle
    println(f"{Solution.find_the_winner(1, 1)} {Solution.find_the_winner(7, 1)} {Solution.find_the_winner(2, 2)} {Solution.find_the_winner(7, 7)}");
    // the constraints' most: 500 friends, counting 500, 1 and 2
    println(f"the most: {Solution.find_the_winner(500, 500)} {Solution.find_the_winner(500, 1)} {Solution.find_the_winner(500, 2)}");
    // 3000 random circles of 1 to 40 friends, each with a count from 1 to
    // its size
    let mut seed = 1823;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 40;
        let k = 1 + next_random(mut seed) % n;
        check = (check * 41 + Solution.find_the_winner(n as i32, k as i32)) % 1000000007;
    }
    println(f"3000 random circles: checksum {check}");
}
