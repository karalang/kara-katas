// LeetCode #1837: Sum of Digits in Base K -- a Rust solution as LeetCode's
// Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn sum_base(n: i32, k: i32) -> i32 {
        let mut n = n;
        let mut sum: i32 = 0;
        while n > 0 {
            sum += n % k;
            n /= k;
        }
        sum
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{Solution.sum_base(34, 6)} {Solution.sum_base(10, 10)}");
    // the edges: the least `n`; `n` equal to `k`, one less, and a power of
    // it; 100 in base 2 and base 10; 99 in base 10
    println(f"{Solution.sum_base(1, 2)} {Solution.sum_base(7, 7)} {Solution.sum_base(6, 7)} {Solution.sum_base(81, 3)} {Solution.sum_base(100, 2)} {Solution.sum_base(100, 10)} {Solution.sum_base(99, 10)}");
    // the constraints whole: every `n` from 1 to 100 in every base from 2
    // to 10, and the most of the sums
    let mut every = 0;
    let mut most = 0;
    for n in 1..101 {
        for k in 2..11 {
            let s = Solution.sum_base(n as i32, k as i32) as i64;
            every = (every * 31 + s) % 1000000007;
            most = most.max(s);
        }
    }
    println(f"every case: checksum {every}, the most {most}");
    // 3000 random cases of `n` from 1 to 100 in a base from 2 to 10
    let mut seed = 1837;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 100;
        let k = 2 + next_random(mut seed) % 9;
        check = (check * 31 + Solution.sum_base(n as i32, k as i32)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
