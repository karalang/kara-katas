// LeetCode #1837: Sum of Digits in Base K --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- sum_base.kara ----
fn a0_sum_base(n: i64, k: i64) -> i64 {
    let mut left = n;
    let mut sum = 0;
    while left > 0 {
        sum += left % k;
        left /= k;
    }
    sum
}

// ---- sum_base_recursive.kara ----
fn a1_sum_base(n: i64, k: i64) -> i64 {
    if n == 0 {
        0
    } else {
        n % k + a1_sum_base(n / k, k)
    }
}

// ---- sum_base_place.kara ----
fn a2_sum_base(n: i64, k: i64) -> i64 {
    let mut place = 1;
    while place * k <= n {
        place *= k;
    }
    let mut sum = 0;
    while place > 0 {
        sum += n / place % k;
        place /= k;
    }
    sum
}

// ---- sum_base_digits.kara ----
fn a3_sum_base(n: i64, k: i64) -> i64 {
    let mut written = String.new();
    let mut left = n;
    while left > 0 {
        written.push_str(f"{left % k}");
        left /= k;
    }
    written.chars().map(|c| c.to_digit(10).unwrap()).sum()
}

// ---- sum_base_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn sum_base(n: i32, k: i32) -> i32 {
        let mut n = n;
        let mut sum: i32 = 0;
        while n > 0 {
            sum += n % k;
            n /= k;
        }
        sum
    }
}
// ---- the differential -------------------------------------------------------

// the statement read literally: `n` written in base `k` by counting up to
// it from 0 in base `k`, a digit at a time with a carry, and the digits of
// what is written summed as base 10 numbers
fn literal(n: i64, k: i64) -> i64 {
    let mut digits: Vec[i64] = [0].to_vec();
    for _ in 0..n {
        let mut at = 0;
        loop {
            if at == digits.len() {
                digits.push(0);
            }
            digits[at] += 1;
            if digits[at] < k {
                break;
            }
            digits[at] = 0;
            at += 1;
        }
    }
    digits.iter().sum()
}

fn arm(i: i64, n: i64, k: i64) -> i64 {
    match i {
        0 => a0_sum_base(n, k),
        1 => a1_sum_base(n, k),
        2 => a2_sum_base(n, k),
        3 => a3_sum_base(n, k),
        _ => A4Solution.sum_base(n as i32, k as i32),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, n: i64, k: i64) {
    t.cases += 1;
    let star = arm(0, n, k);
    t.check = (t.check * 31 + star) % 1000000007;
    let want = literal(n, k);
    let mut place = 1;
    while place <= n {
        place *= k;
    }
    let decimal: i64 = f"{n}".chars().map(|c| c.to_digit(10).unwrap()).sum();
    for i in 0..5 {
        let what = f"arm {i} on {n} in base {k}";
        let got = arm(i, n, k);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: from 1 to `n`, and `n` less the sum a multiple of `k - 1`
        expect(mut t, 2, got >= 1 and got <= n and (n - got) % (k - 1) == 0, f"P2 {what}");
        // P3: `n * k`, its digits with a 0 after them, gives the same sum
        expect(mut t, 3, arm(i, n * k, k) == got, f"P3 {what}");
        // P4: a 1 put before the digits adds 1
        expect(mut t, 4, arm(i, n + place, k) == got + 1, f"P4 {what}");
        // P5: in base 10, the sum of the decimal digits
        expect(mut t, 5, arm(i, n, 10) == decimal, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 random cases of `n` from 1 to 100 in a base from 2 to 10
    let mut seed = 1837;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 100;
        let k = 2 + next_random(mut seed) % 9;
        check_case(mut t, n, k);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
