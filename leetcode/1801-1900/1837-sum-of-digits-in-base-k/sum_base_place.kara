// LeetCode #1837: Sum of Digits in Base K -- the digits read from the
// first: the largest power of `k` at most `n` found, and the digit at each
// place, `n / place % k`, from it down to 1.
// O(log_k n)

fn sum_base(n: i64, k: i64) -> i64 {
    let mut place = 1;
    while place * k <= n {
        place *= k;
    }
    let mut sum = 0;
    while place > 0 {
        sum += n / place % k;
        place /= k;
    }
    sum
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{sum_base(34, 6)} {sum_base(10, 10)}");
    // the edges: the least `n`; `n` equal to `k`, one less, and a power of
    // it; 100 in base 2 and base 10; 99 in base 10
    println(f"{sum_base(1, 2)} {sum_base(7, 7)} {sum_base(6, 7)} {sum_base(81, 3)} {sum_base(100, 2)} {sum_base(100, 10)} {sum_base(99, 10)}");
    // the constraints whole: every `n` from 1 to 100 in every base from 2
    // to 10, and the most of the sums
    let mut every = 0;
    let mut most = 0;
    for n in 1..101 {
        for k in 2..11 {
            let s = sum_base(n, k);
            every = (every * 31 + s) % 1000000007;
            most = most.max(s);
        }
    }
    println(f"every case: checksum {every}, the most {most}");
    // 3000 random cases of `n` from 1 to 100 in a base from 2 to 10
    let mut seed = 1837;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 100;
        let k = 2 + next_random(mut seed) % 9;
        check = (check * 31 + sum_base(n, k)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
