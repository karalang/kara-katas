// LeetCode #1817: Finding the Users Active Minutes -- a Rust solution as
// LeetCode's Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn finding_users_active_minutes(logs: Vec[Vec[i32]], k: i32) -> Vec[i32] {
        let mut map: Map[i32, Set[i32]] = Map.new();
        for log in logs {
            map.entry(log[0]).or_insert(Set.new()).insert(log[1]);
        }
        let mut ans = Vec.filled(k, 0);
        for set in map.values() {
            ans[set.len() - 1] += 1;
        }
        ans
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{Solution.finding_users_active_minutes([[0, 5], [1, 2], [0, 2], [0, 5], [1, 3]], 5)} {Solution.finding_users_active_minutes([[1, 1], [2, 2], [2, 3]], 4)}");
    // the edges: one log; one user many times in one minute; ids and
    // minutes at their largest; a k past every user's minutes
    println(f"{Solution.finding_users_active_minutes([[7, 7]], 1)} {Solution.finding_users_active_minutes([[3, 9], [3, 9], [3, 9]], 2)} {Solution.finding_users_active_minutes([[1000000000, 100000], [0, 1], [1000000000, 1]], 3)} {Solution.finding_users_active_minutes([[1, 1], [1, 2], [2, 1]], 6)}");
    // the constraints' most: 10^4 logs, one user over 10^4 minutes, and
    // 10^4 users with a minute each
    let one: Vec[Vec[i32]] = (0..10000).map(|m| [5, m as i32]).collect();
    let many: Vec[Vec[i32]] = (0..10000).map(|u| [u as i32, 1]).collect();
    let a = Solution.finding_users_active_minutes(one, 10000);
    let b = Solution.finding_users_active_minutes(many, 3);
    println(f"the most: {a[9999]} {a.iter().sum()} {b}");
    // 3000 random cases of 1 to 40 logs over 1 to 6 users and 1 to 9 minutes
    let mut seed = 1817;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 40;
        let users = 1 + next_random(mut seed) % 6;
        let span = 1 + next_random(mut seed) % 9;
        let mut logs: Vec[Vec[i32]] = Vec.new();
        for _ in 0..n {
            let user = next_random(mut seed) % users;
            logs.push([user as i32, (next_random(mut seed) % span) as i32]);
        }
        let k = (span + next_random(mut seed) % 3) as i32;
        for x in Solution.finding_users_active_minutes(logs, k) {
            check = (check * 31 + x) % 1000000007;
        }
    }
    println(f"3000 random cases: checksum {check}");
}
