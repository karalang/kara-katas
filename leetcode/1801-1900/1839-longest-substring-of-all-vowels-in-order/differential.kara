// LeetCode #1839: Longest Substring Of All Vowels in Order --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- longest_beautiful_substring.kara ----
fn a0_longest_beautiful_substring(word: String) -> i64 {
    let letters = word.bytes();
    let mut best = 0;
    let mut length = 1;
    let mut vowels = 1;
    for i in 1..letters.len() {
        if letters[i] < letters[i - 1] {
            length = 1;
            vowels = 1;
        } else {
            length += 1;
            if letters[i] > letters[i - 1] {
                vowels += 1;
            }
        }
        if vowels == 5 {
            best = best.max(length);
        }
    }
    best
}

// ---- longest_beautiful_substring_runs.kara ----
fn a1_longest_beautiful_substring(word: String) -> i64 {
    let mut runs: Vec[(char, i64)] = Vec.new();
    for c in word.chars() {
        match runs.last() {
            Some((letter, _)) if letter == c => {
                let at = runs.len() - 1;
                runs[at].1 += 1;
            }
            _ => runs.push((c, 1)),
        }
    }
    let order = ['a', 'e', 'i', 'o', 'u'];
    let mut best = 0;
    for start in 0..runs.len() {
        if start + 5 <= runs.len() and (0..5).all(|j| runs[start + j].0 == order[j]) {
            best = best.max((0..5).map(|j| runs[start + j].1).sum());
        }
    }
    best
}

// ---- longest_beautiful_substring_states.kara ----
fn a2_longest_beautiful_substring(word: String) -> i64 {
    let order: Vec[char] = "aeiou".chars().collect();
    let mut best = 0;
    // `reached` is -1 when no run has started
    let mut reached = -1;
    let mut length = 0;
    for c in word.chars() {
        if reached >= 0 and c == order[reached] {
            length += 1;
        } else if reached >= 0 and reached < 4 and c == order[reached + 1] {
            reached += 1;
            length += 1;
        } else if c == 'a' {
            reached = 0;
            length = 1;
        } else {
            reached = -1;
            length = 0;
        }
        if reached == 4 {
            best = best.max(length);
        }
    }
    best
}

// ---- longest_beautiful_substring_scan.kara ----
fn a3_longest_beautiful_substring(word: String) -> i64 {
    let letters = word.bytes();
    let n = letters.len();
    let mut best = 0;
    let mut start = 0;
    while start < n {
        if letters[start] != b'a' {
            start += 1;
            continue;
        }
        let mut end = start + 1;
        while end < n and letters[end] >= letters[end - 1] {
            end += 1;
        }
        let mut seen = letters[start..end].to_vec();
        seen.dedup();
        if seen.len() == 5 {
            best = best.max(end - start);
        }
        start = end;
    }
    best
}

// ---- longest_beautiful_substring_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn longest_beautiful_substring(word: String) -> i32 {
        let w = word.bytes();
        let mut ans: i32 = 0;
        let mut len: i32 = 1;
        let mut cnt = 1;
        for i in 1..w.len() {
            if w[i] >= w[i - 1] {
                len += 1;
                if w[i] > w[i - 1] {
                    cnt += 1;
                }
            } else {
                len = 1;
                cnt = 1;
            }
            if cnt == 5 {
                ans = ans.max(len);
            }
        }
        ans
    }
}
// ---- the differential -------------------------------------------------------

// the statement read literally: every substring, kept when it has each of
// the five vowels and its letters are in alphabetical order, and the
// longest kept
fn literal(word: String) -> i64 {
    let letters: Vec[char] = word.chars().collect();
    let n = letters.len();
    let mut best = 0;
    for i in 0..n {
        for j in i + 1..n + 1 {
            let part = letters[i..j].to_vec();
            let mut in_order = true;
            for at in 1..part.len() {
                if part[at] < part[at - 1] {
                    in_order = false;
                }
            }
            let every = "aeiou".chars().all(|v| part.contains(v));
            if in_order and every {
                best = best.max(j - i);
            }
        }
    }
    best
}

fn arm(i: i64, word: String) -> i64 {
    match i {
        0 => a0_longest_beautiful_substring(word),
        1 => a1_longest_beautiful_substring(word),
        2 => a2_longest_beautiful_substring(word),
        3 => a3_longest_beautiful_substring(word),
        _ => A4Solution.longest_beautiful_substring(word),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` vowels drawn at random, each the one before it again, the next
// vowel, an `a`, or any vowel
fn word(seed: mut ref i64, n: i64) -> String {
    let vowels = ['a', 'e', 'i', 'o', 'u'];
    let mut out = String.new();
    let mut at = 0;
    for _ in 0..n {
        let roll = next_random(mut seed) % 10;
        if roll < 4 {
            // the same vowel again
        } else if roll < 8 {
            at = (at + 1).min(4);
        } else if roll < 9 {
            at = 0;
        } else {
            at = next_random(mut seed) % 5;
        }
        out.push(vowels[at]);
    }
    out
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, w: String) {
    t.cases += 1;
    let star = arm(0, w);
    t.check = (t.check * 31 + star) % 1000000007;
    let want = literal(w);
    let mut doubled = String.new();
    for c in w.chars() {
        doubled.push(c);
        doubled.push(c);
    }
    let after_u: String = f"u{w}";
    let then_all: String = f"{w}aeiou";
    for i in 0..5 {
        let what = f"arm {i} on {w}";
        let got = arm(i, w);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: none, or from 5 to the whole word
        expect(mut t, 2, got == 0 or (got >= 5 and got <= w.len()), f"P2 {what}");
        // P3: every letter written twice doubles the length
        expect(mut t, 3, arm(i, doubled) == got * 2, f"P3 {what}");
        // P4: a `u` put before the word changes nothing
        expect(mut t, 4, arm(i, after_u) == got, f"P4 {what}");
        // P5: "aeiou" put after the word gives at least 5, and no less
        let more = arm(i, then_all);
        expect(mut t, 5, more >= 5 and more >= got, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 random words of 1 to 25 vowels
    let mut seed = 1839;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 25;
        let w = word(mut seed, n);
        check_case(mut t, w);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
