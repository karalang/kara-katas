// LeetCode #1838: Frequency of the Most Frequent Element -- the ★ arm's
// window over the values in place of a sorted list: how many of each value
// there are, counted up to the largest, and a window of values, the target
// its last, that gives up whole numbers from its smallest value while
// raising them passes `k`, a part of a value when only some fit.
// O(n + M), M the largest number

fn max_frequency(nums: Vec[i64], k: i64) -> i64 {
    let top = nums.iter().max().unwrap();
    let mut count: Vec[i64] = Vec.filled(top + 1, 0);
    for x in nums.iter() {
        count[x] += 1;
    }
    let mut best = 0;
    // the smallest value in the window, and how many of it are still in it
    let mut low = nums.iter().min().unwrap();
    let mut low_left = count[low];
    let mut size = 0;
    let mut sum = 0;
    for value in 0..top + 1 {
        if count[value] == 0 {
            continue;
        }
        size += count[value];
        sum += value * count[value];
        while value * size - sum > k {
            // the numbers of value `low` cost `value - low` each to raise:
            // drop as many as must go, or all of them
            let each = value - low;
            let over = value * size - sum - k;
            let drop = low_left.min((over + each - 1) / each);
            size -= drop;
            sum -= low * drop;
            low_left -= drop;
            if low_left == 0 {
                low += 1;
                while count[low] == 0 {
                    low += 1;
                }
                low_left = count[low];
            }
        }
        best = best.max(size);
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{max_frequency([1, 2, 4], 5)} {max_frequency([1, 4, 8, 13], 5)} {max_frequency([3, 9, 6], 2)}");
    // the edges: one number; every number the same; a `k` that raises
    // nothing, and one that raises every number; a `k` that raises a
    // number only part of the way
    println(f"{max_frequency([7], 1)} {max_frequency([5, 5, 5], 1)} {max_frequency([1, 3, 5], 1)} {max_frequency([1, 50000, 100000], 199999)} {max_frequency([1, 1, 10, 10], 8)}");
    // the constraints' most: 10^5 numbers from 1 to 10^5 with `k` of 10^5,
    // and with `k` of 1
    let mut seed = 1838;
    let nums: Vec[i64] = (0..100000).map(|_| 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000).collect();
    println(f"the most: {max_frequency(nums, 100000)} {max_frequency(nums, 1)}");
    // 3000 random cases of 1 to 10 numbers from 1 to 20, with `k` from 1 to
    // 30
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 10;
        let case: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % 20).collect();
        let k = 1 + next_random(mut seed) % 30;
        check = (check * 31 + max_frequency(case, k)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
