// LeetCode #1838: Frequency of the Most Frequent Element -- a Rust solution
// as LeetCode's Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn max_frequency(nums: own Vec[i32], k: i32) -> i32 {
        let mut nums = nums;
        nums.sort();
        let mut (l, sum, ans) = (0, 0, 0);
        for r in 0..nums.len() {
            sum += nums[r];
            while nums[r] * (r - l + 1) - sum > k {
                sum -= nums[l];
                l += 1;
            }
            ans = ans.max(r - l + 1);
        }
        ans as i32
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{Solution.max_frequency([1, 2, 4], 5)} {Solution.max_frequency([1, 4, 8, 13], 5)} {Solution.max_frequency([3, 9, 6], 2)}");
    // the edges: one number; every number the same; a `k` that raises
    // nothing, and one that raises every number; a `k` that raises a
    // number only part of the way
    println(f"{Solution.max_frequency([7], 1)} {Solution.max_frequency([5, 5, 5], 1)} {Solution.max_frequency([1, 3, 5], 1)} {Solution.max_frequency([1, 50000, 100000], 199999)} {Solution.max_frequency([1, 1, 10, 10], 8)}");
    // the constraints' most: 10^5 numbers from 1 to 10^5 with `k` of 10^5,
    // and with `k` of 1
    let mut seed = 1838;
    let nums: Vec[i32] = (0..100000).map(|_| (1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000) as i32).collect();
    println(f"the most: {Solution.max_frequency(nums.clone(), 100000)} {Solution.max_frequency(nums, 1)}");
    // 3000 random cases of 1 to 10 numbers from 1 to 20, with `k` from 1 to
    // 30
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 10;
        let case: Vec[i32] = (0..n).map(|_| (1 + next_random(mut seed) % 20) as i32).collect();
        let k = (1 + next_random(mut seed) % 30) as i32;
        check = (check * 31 + Solution.max_frequency(case, k)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
