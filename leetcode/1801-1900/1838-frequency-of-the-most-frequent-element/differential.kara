// LeetCode #1838: Frequency of the Most Frequent Element --
// differential test of the five arms against the statement read literally,
// with five more properties.

// ---- max_frequency.kara ----
fn a0_max_frequency(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut best = 0;
    let mut first = 0;
    let mut sum = 0;
    for last in 0..sorted.len() {
        sum += sorted[last];
        while sorted[last] * (last - first + 1) - sum > k {
            sum -= sorted[first];
            first += 1;
        }
        best = best.max(last - first + 1);
    }
    best
}

// ---- max_frequency_search.kara ----
fn a1_max_frequency(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + sorted[i];
    }
    let mut best = 0;
    for last in 0..n {
        let mut lo = 0;
        let mut hi = last;
        while lo < hi {
            let mid = (lo + hi) / 2;
            let cost = sorted[last] * (last - mid + 1) - (prefix[last + 1] - prefix[mid]);
            if cost <= k {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        best = best.max(last - lo + 1);
    }
    best
}

// ---- max_frequency_grow.kara ----
fn a2_max_frequency(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut first = 0;
    let mut sum = 0;
    for last in 0..sorted.len() {
        sum += sorted[last];
        if sorted[last] * (last - first + 1) - sum > k {
            sum -= sorted[first];
            first += 1;
        }
    }
    sorted.len() - first
}

// ---- max_frequency_count.kara ----
fn a3_max_frequency(nums: Vec[i64], k: i64) -> i64 {
    let top = nums.iter().max().unwrap();
    let mut count: Vec[i64] = Vec.filled(top + 1, 0);
    for x in nums.iter() {
        count[x] += 1;
    }
    let mut best = 0;
    // the smallest value in the window, and how many of it are still in it
    let mut low = nums.iter().min().unwrap();
    let mut low_left = count[low];
    let mut size = 0;
    let mut sum = 0;
    for value in 0..top + 1 {
        if count[value] == 0 {
            continue;
        }
        size += count[value];
        sum += value * count[value];
        while value * size - sum > k {
            // the numbers of value `low` cost `value - low` each to raise:
            // drop as many as must go, or all of them
            let each = value - low;
            let over = value * size - sum - k;
            let drop = low_left.min((over + each - 1) / each);
            size -= drop;
            sum -= low * drop;
            low_left -= drop;
            if low_left == 0 {
                low += 1;
                while count[low] == 0 {
                    low += 1;
                }
                low_left = count[low];
            }
        }
        best = best.max(size);
    }
    best
}

// ---- max_frequency_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn max_frequency(nums: own Vec[i32], k: i32) -> i32 {
        let mut nums = nums;
        nums.sort();
        let mut (l, sum, ans) = (0, 0, 0);
        for r in 0..nums.len() {
            sum += nums[r];
            while nums[r] * (r - l + 1) - sum > k {
                sum -= nums[l];
                l += 1;
            }
            ans = ans.max(r - l + 1);
        }
        ans as i32
    }
}
// ---- the differential -------------------------------------------------------

// the statement read literally: every set of the numbers that could be
// raised to one value, the value its largest, as raising past it only
// costs more; the largest set whose raising costs at most `k`
fn literal(nums: Slice[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut best = 0;
    for mask in 1..1 << n {
        let mut top = 0;
        let mut size = 0;
        for i in 0..n {
            if mask & (1 << i) != 0 {
                top = top.max(nums[i]);
                size += 1;
            }
        }
        let mut cost = 0;
        for i in 0..n {
            if mask & (1 << i) != 0 {
                cost += top - nums[i];
            }
        }
        if cost <= k and size > best {
            best = size;
        }
    }
    best
}

fn arm(i: i64, nums: Slice[i64], k: i64) -> i64 {
    match i {
        0 => a0_max_frequency(nums.to_vec(), k),
        1 => a1_max_frequency(nums.to_vec(), k),
        2 => a2_max_frequency(nums.to_vec(), k),
        3 => a3_max_frequency(nums.to_vec(), k),
        _ => {
            let narrow: Vec[i32] = nums.iter().map(|x| x as i32).collect();
            A4Solution.max_frequency(narrow, k as i32)
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, nums: Slice[i64], k: i64) {
    t.cases += 1;
    let star = arm(0, nums, k);
    t.check = (t.check * 31 + star) % 1000000007;
    let want = literal(nums, k);
    let mut already = 0;
    for x in nums.iter() {
        already = already.max(nums.iter().filter(|y| y == x).count());
    }
    let reversed: Vec[i64] = nums.iter().rev().collect();
    let shifted: Vec[i64] = nums.iter().map(|x| x + 7).collect();
    for i in 0..5 {
        let what = f"arm {i} on {nums} with k {k}";
        let got = arm(i, nums, k);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: at most every number, and at least the most of any one value
        // there already
        expect(mut t, 2, got <= nums.len() and got >= already, f"P2 {what}");
        // P3: the numbers in reverse order give the same answer
        expect(mut t, 3, arm(i, reversed[..], k) == got, f"P3 {what}");
        // P4: a larger `k` never gives less
        expect(mut t, 4, arm(i, nums, k + 3) >= got, f"P4 {what}");
        // P5: every number 7 larger gives the same answer
        expect(mut t, 5, arm(i, shifted[..], k) == got, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 random cases of 1 to 10 numbers from 1 to 20, with `k` from 1 to
    // 30
    let mut seed = 1838;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 10;
        let nums: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % 20).collect();
        let k = 1 + next_random(mut seed) % 30;
        check_case(mut t, nums[..], k);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
