// LeetCode #1838: Frequency of the Most Frequent Element -- the numbers
// sorted and summed from the first, and for each number the earliest start
// of a run ending at it that `k` raises to it, found by a binary search on
// the start: the cost only falls as the start moves on.
// O(n log n)

fn max_frequency(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + sorted[i];
    }
    let mut best = 0;
    for last in 0..n {
        let mut lo = 0;
        let mut hi = last;
        while lo < hi {
            let mid = (lo + hi) / 2;
            let cost = sorted[last] * (last - mid + 1) - (prefix[last + 1] - prefix[mid]);
            if cost <= k {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        best = best.max(last - lo + 1);
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{max_frequency([1, 2, 4], 5)} {max_frequency([1, 4, 8, 13], 5)} {max_frequency([3, 9, 6], 2)}");
    // the edges: one number; every number the same; a `k` that raises
    // nothing, and one that raises every number; a `k` that raises a
    // number only part of the way
    println(f"{max_frequency([7], 1)} {max_frequency([5, 5, 5], 1)} {max_frequency([1, 3, 5], 1)} {max_frequency([1, 50000, 100000], 199999)} {max_frequency([1, 1, 10, 10], 8)}");
    // the constraints' most: 10^5 numbers from 1 to 10^5 with `k` of 10^5,
    // and with `k` of 1
    let mut seed = 1838;
    let nums: Vec[i64] = (0..100000).map(|_| 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000).collect();
    println(f"the most: {max_frequency(nums, 100000)} {max_frequency(nums, 1)}");
    // 3000 random cases of 1 to 10 numbers from 1 to 20, with `k` from 1 to
    // 30
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 10;
        let case: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % 20).collect();
        let k = 1 + next_random(mut seed) % 30;
        check = (check * 31 + max_frequency(case, k)) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
