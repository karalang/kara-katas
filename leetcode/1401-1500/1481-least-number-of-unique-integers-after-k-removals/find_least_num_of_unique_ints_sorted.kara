// LeetCode #1481: Least Number of Unique Integers after K Removals -- no
// map: the values sorted, so each value's copies stand together and its
// count is the length of its run; the run lengths sorted in turn and
// spent rarest first

fn find_least_num_of_unique_ints(arr: Vec[i32], k: i32) -> i32 {
    let mut sorted = arr.clone();
    sorted.sort();
    let mut runs: Vec[i64] = Vec.new();
    let mut start = 0;
    for i in 1..=sorted.len() {
        if i == sorted.len() or sorted[i] != sorted[start] {
            runs.push(i - start);
            start = i;
        }
    }
    runs.sort();
    let mut left: i64 = k;
    let mut gone = 0;
    while gone < runs.len() and runs[gone] <= left {
        left -= runs[gone];
        gone += 1;
    }
    (runs.len() - gone) as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 30 bits from two draws, for values up to 10^9
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// n values from 1 to top
fn draw(seed: mut ref i64, n: i64, top: i64) -> Vec[i32] {
    (0..n).map(|_| (1 + wide_random(mut seed) % top) as i32).collect()
}

fn main() {
    // LeetCode's two examples
    println(f"{find_least_num_of_unique_ints([5, 5, 4].to_vec(), 1)} {find_least_num_of_unique_ints([4, 3, 1, 1, 3, 3, 2].to_vec(), 3)}");
    // the edges: no removals; every value removed; one value many times;
    // all values different; a removal that cannot finish a value off
    let e1 = find_least_num_of_unique_ints([1, 2, 2, 3, 3, 3].to_vec(), 0);
    let e2 = find_least_num_of_unique_ints([1, 2, 2, 3, 3, 3].to_vec(), 6);
    let e3 = find_least_num_of_unique_ints(Vec.filled(8, 1000000000), 7);
    let e4 = find_least_num_of_unique_ints([9, 8, 7, 6, 5].to_vec(), 2);
    let e5 = find_least_num_of_unique_ints([1, 1, 2, 2, 2, 3, 3, 3, 3].to_vec(), 4);
    println(f"{e1} {e2} {e3} {e4} {e5}");
    // the constraints' most: 100000 values from 1 to 10^9, all but a few
    // different, and from 1 to 1000, for 0, 1000, 50000 and 100000 removals
    let mut seed = 1481;
    let wide = draw(mut seed, 100000, 1000000000);
    let narrow = draw(mut seed, 100000, 1000);
    let ks = [0, 1000, 50000, 100000];
    let a: Vec[String] = ks.iter().map(|k| f"{find_least_num_of_unique_ints(wide, k)}").collect();
    let b: Vec[String] = ks.iter().map(|k| f"{find_least_num_of_unique_ints(narrow, k)}").collect();
    println(f"100000 values: {a.join(" ")} | {b.join(" ")}");
    // 3000 random arrays of 1 to 60 values from 1 to top, top from 1 to 30,
    // and 0 removals to all of them; each answer folded into a checksum
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 60;
        let top = 1 + next_random(mut seed) % 30;
        let arr = draw(mut seed, n, top);
        let k = (next_random(mut seed) % (n + 1)) as i32;
        check = (check * 31 + find_least_num_of_unique_ints(arr, k)) % 1000000007;
    }
    println(f"3000 random arrays: checksum {check}");
}
