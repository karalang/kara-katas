// LeetCode #1481: Least Number of Unique Integers after K Removals --
// bench. One array of 100000 values from 1 to 30000 made once; then 100
// passes, each punching one value and asking for 0 to 99999 removals,
// both chosen from the checksum so far.

fn find_least_num_of_unique_ints(arr: Vec[i32], k: i32) -> i32 {
    let mut count: Map[i32, i64] = Map.new();
    for x in arr.iter() {
        count[x] = (count.get(x) ?? 0) + 1;
    }
    let mut counts: Vec[i64] = count.values().collect();
    counts.sort();
    let mut left: i64 = k;
    let mut unique = counts.len();
    for c in counts.iter() {
        if c > left {
            break;
        }
        left -= c;
        unique -= 1;
    }
    unique as i32
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1481;
    let mut arr: Vec[i32] = (0..100000).map(|_| (1 + next_random(mut seed) % 30000) as i32).collect();
    let mut check = 0;
    for pass in 0..100 {
        arr[check % 100000] = (1 + (check / 7) % 30000) as i32;
        let k = (check % 100000) as i32;
        check = (check * 31 + find_least_num_of_unique_ints(arr, k) + pass) % 1000000007;
    }
    println(f"100 passes over 100000 values: checksum {check}");
}
