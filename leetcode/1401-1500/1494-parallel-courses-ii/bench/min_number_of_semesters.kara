// LeetCode #1494: Parallel Courses II -- the bench, mirroring the ★ arm: a
// DP over the sets of courses taken. 300 calls on 15 courses, each call's
// relations and k drawn from a generator seeded by the checksum so far.

fn min_number_of_semesters(n: i32, relations: Vec[Vec[i32]], k: i32) -> i32 {
    let n = n as i64;
    let mut pre: Vec[i64] = Vec.filled(n, 0);
    for r in relations.iter() {
        pre[r[1] - 1] |= 1 << (r[0] - 1);
    }
    let full = (1 << n) - 1;
    let mut semesters: Vec[i32] = Vec.filled(full + 1, i32.MAX);
    semesters[0] = 0;
    for taken in 0..full {
        if semesters[taken] == i32.MAX {
            continue;
        }
        let mut open = 0;
        for i in 0..n {
            if taken & (1 << i) == 0 and pre[i] & taken == pre[i] {
                open |= 1 << i;
            }
        }
        let next = semesters[taken] + 1;
        if open.count_ones() <= k {
            semesters[taken | open] = semesters[taken | open].min(next);
            continue;
        }
        let mut pick = open;
        while pick > 0 {
            if pick.count_ones() == k {
                semesters[taken | pick] = semesters[taken | pick].min(next);
            }
            pick = (pick - 1) & open;
        }
    }
    semesters[full]
}


fn main() {
    let mut check = 0;
    for call in 0..300 {
        let mut seed = check + call;
        let mut next = || {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            seed / 65536
        };
        let dense = next() % 8;
        let k = 2 + next() % 4;
        let mut relations: Vec[Vec[i32]] = Vec.new();
        for a in 1..=15 {
            for b in a + 1..=15 {
                if next() % 100 < dense {
                    relations.push([a, b]);
                }
            }
        }
        check = (check * 31 + min_number_of_semesters(15, relations, k as i32)) % 1000000007;
    }
    println(f"300 calls on 15 courses: checksum {check}");
}
