// LeetCode #1494: Parallel Courses II -- a breadth-first search over the
// sets of courses taken, one level a semester: each set's open courses all
// taken when they are no more than k, else every k of them; the level that
// first reaches every course is the answer. O(3^n) at worst

fn min_number_of_semesters(n: i32, relations: Vec[Vec[i32]], k: i32) -> i32 {
    let n = n as i64;
    let mut pre: Vec[i64] = Vec.filled(n, 0);
    for r in relations.iter() {
        pre[r[1] - 1] |= 1 << (r[0] - 1);
    }
    let full = (1 << n) - 1;
    let mut seen: Vec[bool] = Vec.filled(full + 1, false);
    seen[0] = true;
    let mut level: Vec[i64] = [0].to_vec();
    let mut semester = 0;
    while not seen[full] {
        semester += 1;
        let mut next: Vec[i64] = Vec.new();
        for taken in level.iter() {
            let mut open = 0;
            for i in 0..n {
                if taken & (1 << i) == 0 and pre[i] & taken == pre[i] {
                    open |= 1 << i;
                }
            }
            if open.count_ones() <= k {
                if not seen[taken | open] {
                    seen[taken | open] = true;
                    next.push(taken | open);
                }
                continue;
            }
            let mut pick = open;
            while pick > 0 {
                if pick.count_ones() == k and not seen[taken | pick] {
                    seen[taken | pick] = true;
                    next.push(taken | pick);
                }
                pick = (pick - 1) & open;
            }
        }
        level = next;
    }
    semester
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n courses in a random order, each pair joined, the earlier first, with
// chance `dense` in 100
fn random_relations(seed: mut ref i64, n: i64, dense: i64) -> Vec[Vec[i32]] {
    let mut order: Vec[i32] = (1..=n).map(|c| c as i32).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        order.swap(i, j);
    }
    let mut relations: Vec[Vec[i32]] = Vec.new();
    for i in 0..n {
        for j in i + 1..n {
            if next_random(mut seed) % 100 < dense {
                relations.push([order[i], order[j]]);
            }
        }
    }
    relations
}

fn main() {
    // LeetCode's two examples
    let first = min_number_of_semesters(4, [[2, 1], [3, 1], [1, 4]], 2);
    let second = min_number_of_semesters(5, [[2, 1], [3, 1], [4, 1], [1, 5]], 2);
    println(f"{first} {second}");
    // the edges: one course; 15 free courses one at a time and all at
    // once; a chain of 15; one course every other one needs, taken two at
    // a time; and chains of 3, 2, 2 and 2 courses, taken two at a time
    let chain: Vec[Vec[i32]] = (1..15).map(|c| [c as i32, c as i32 + 1].to_vec()).collect();
    let wide: Vec[Vec[i32]] = (2..=7).map(|c| [1, c as i32].to_vec()).collect();
    let deep: Vec[Vec[i32]] = [[1, 2], [2, 3], [4, 5], [6, 7], [8, 9]];
    println(f"{min_number_of_semesters(1, Vec.new(), 1)} {min_number_of_semesters(15, Vec.new(), 1)} {min_number_of_semesters(15, Vec.new(), 15)} {min_number_of_semesters(15, chain, 3)} {min_number_of_semesters(7, wide, 2)} {min_number_of_semesters(9, deep, 2)}");
    // the constraints' most: 15 courses, few, some and many relations,
    // taken 2, 3 and 4 at a time
    let mut seed = 1494;
    let mut most: Vec[i32] = Vec.new();
    for dense in [5, 15, 40] {
        // `2i32` as `karac fix` writes it: a `for` over an array literal
        // settles its literals before the body can fix them (B-2026-11-26-2)
        for k in [2i32, 3, 4] {
            most.push(min_number_of_semesters(15, random_relations(mut seed, 15, dense), k));
        }
    }
    println(f"15 courses: {most}");
    // 1000 random cases of 1 to 11 courses
    let mut check = 0;
    for _ in 0..1000 {
        let n = 1 + next_random(mut seed) % 11;
        let dense = next_random(mut seed) % 50;
        let k = 1 + next_random(mut seed) % n;
        let relations = random_relations(mut seed, n, dense);
        check = (check * 31 + min_number_of_semesters(n as i32, relations, k as i32)) % 1000000007;
    }
    println(f"1000 random cases: checksum {check}");
}
