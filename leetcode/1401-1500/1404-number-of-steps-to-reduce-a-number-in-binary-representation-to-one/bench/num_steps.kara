fn num_steps(s: String) -> i32 {
    // from the last digit up, a carry left by the additions so far: a 1
    // there is odd, so it takes an addition and a halving and leaves a
    // carry; a 0 is halved at once
    let bits: Vec[char] = s.chars().collect();
    let mut steps = 0;
    let mut carry = 0;
    for i in (1..bits.len()).rev() {
        let bit = if bits[i] == '1' { 1 } else { 0 } + carry;
        if bit == 1 {
            steps += 2;
            carry = 1;
        } else {
            steps += 1;
        }
    }
    steps + carry
}

fn main() {
    let mut seed: i64 = 1404;
    let mut pool = String.new();
    for _ in 0..100000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        pool.push(if seed / 65536 % 2 == 0 { '0' } else { '1' });
    }
    let mut check: i64 = 0;
    for r in 0..200000 {
        let at = (check + r * 7919) % 99501;
        let s = "1" + pool[at..at + 499].to_string();
        check = (check * 131 + num_steps(s)) % 1000000007;
    }
    println(f"200000 numbers of 500 digits: checksum {check}");
}
