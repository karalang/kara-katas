// LeetCode #1498: Number of Subsequences That Satisfy the Given Sum
// Condition -- differential test of the five arms against the statement
// read literally, with five more properties.

// ---- num_subseq.kara ----
const A0_MOD: i64 = 1000000007;

fn a0_num_subseq(nums: Vec[i32], target: i32) -> i32 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    let mut pow2: Vec[i64] = Vec.filled(n, 1);
    for i in 1..n {
        pow2[i] = pow2[i - 1] * 2 % A0_MOD;
    }
    let mut count = 0;
    let mut lo = 0;
    let mut hi = n - 1;
    while lo <= hi {
        if sorted[lo] + sorted[hi] <= target {
            count = (count + pow2[hi - lo]) % A0_MOD;
            lo += 1;
        } else {
            hi -= 1;
        }
    }
    count as i32
}

// ---- num_subseq_bsearch.kara ----
const A1_MOD: i64 = 1000000007;

fn a1_num_subseq(nums: Vec[i32], target: i32) -> i32 {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut pow2: Vec[i64] = [1].to_vec();
    for i in 1..sorted.len() {
        pow2.push(pow2[i - 1] * 2 % A1_MOD);
    }
    let mut count = 0;
    for i in 0..sorted.len() {
        if sorted[i] * 2 > target {
            break;
        }
        let end = sorted.partition_point(|x| x <= target - sorted[i]);
        count = (count + pow2[end - 1 - i]) % A1_MOD;
    }
    count as i32
}

// ---- num_subseq_modpow.kara ----
const A2_MOD: i64 = 1000000007;

fn a2_pow2(k: i64) -> i64 {
    let mut result = 1;
    let mut base = 2;
    let mut e = k;
    while e > 0 {
        if e % 2 == 1 {
            result = result * base % A2_MOD;
        }
        base = base * base % A2_MOD;
        e /= 2;
    }
    result
}

fn a2_num_subseq(nums: Vec[i32], target: i32) -> i32 {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut count = 0;
    let mut (lo, hi) = (0, sorted.len() - 1);
    while lo <= hi {
        if sorted[lo] + sorted[hi] <= target {
            count = (count + a2_pow2(hi - lo)) % A2_MOD;
            lo += 1;
        } else {
            hi -= 1;
        }
    }
    count as i32
}

// ---- num_subseq_counting.kara ----
const A3_MOD: i64 = 1000000007;

fn a3_num_subseq(nums: Vec[i32], target: i32) -> i32 {
    let most = nums.iter().max() ?? 0;
    let mut copies: Vec[i64] = Vec.filled(most + 1, 0);
    for x in nums.iter() {
        copies[x] += 1;
    }
    let mut pow2: Vec[i64] = Vec.filled(nums.len() + 1, 1);
    for i in 1..pow2.len() {
        pow2[i] = pow2[i - 1] * 2 % A3_MOD;
    }
    // how many values lie at or below each value
    let mut upto: Vec[i64] = Vec.filled(most + 1, 0);
    let mut below = 0;
    for v in 0..=most {
        below += copies[v];
        upto[v] = below;
    }
    let mut count = 0;
    let mut hi = most as i64;
    let mut seen = 0;
    for lo in 1..=most as i64 {
        if copies[lo] == 0 {
            continue;
        }
        while hi >= lo and lo + hi > target {
            hi -= 1;
        }
        if hi < lo {
            break;
        }
        // each copy of lo as the least: the values after it, up to hi
        for _ in 0..copies[lo] {
            seen += 1;
            count = (count + pow2[upto[hi] - seen]) % A3_MOD;
        }
    }
    count as i32
}

// ---- num_subseq_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn num_subseq(nums: own Vec[i32], target: i32) -> i32 {
        let mut nums = nums;
        const MOD: i64 = 1_000_000_007;
        nums.sort();
        let n = nums.len();
        let mut pow = Vec.filled(n, 1);
        for i in 1..n {
            pow[i] = pow[i - 1] * 2 % MOD;
        }
        let mut (l, r) = (0, n - 1);
        let mut ans = 0;
        while l <= r {
            if nums[l] + nums[r] <= target {
                ans = (ans + pow[r - l]) % MOD;
                l += 1;
            } else {
                if r == 0 {
                    break;
                }
                r -= 1;
            }
        }
        ans as i32
    }
}

fn a4_num_subseq(nums: own Vec[i32], target: i32) -> i32 {
    A4Solution.num_subseq(nums, target)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every non-empty subsequence, one bit of a
// mask for each value, whose least and most sum to at most the target
fn literal(nums: Vec[i32], target: i32) -> i64 {
    let n = nums.len();
    let mut count = 0;
    for mask in 1..(1 << n) {
        let mut least = i32.MAX;
        let mut most = i32.MIN;
        for i in 0..n {
            if mask & (1 << i) != 0 {
                least = least.min(nums[i]);
                most = most.max(nums[i]);
            }
        }
        if least + most <= target {
            count += 1;
        }
    }
    count
}

fn arm(i: i64, nums: Vec[i32], target: i32) -> i64 {
    let got = match i {
        0 => a0_num_subseq(nums, target),
        1 => a1_num_subseq(nums, target),
        2 => a2_num_subseq(nums, target),
        3 => a3_num_subseq(nums, target),
        _ => a4_num_subseq(nums.clone(), target),
    };
    got
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, nums: Vec[i32], target: i32) {
    t.cases += 1;
    let want = literal(nums, target);
    t.check = (t.check * 31 + want) % 1000000007;
    let star = arm(0, nums, target);
    let reversed: Vec[i32] = nums.iter().rev().collect();
    let mut more = nums.clone();
    more.push(target);
    for i in 0..5 {
        let what = f"arm {i} on {nums}, target {target}";
        let got = arm(i, nums, target);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: no more than the non-empty subsequences there are
        expect(mut t, 2, got >= 0 and got < (1 << nums.len()), f"P2 {what}");
        // P3: the values in reverse order count the same
        expect(mut t, 3, arm(i, reversed, target) == got, f"P3 {what}");
        // P4: a larger target counts no fewer
        expect(mut t, 4, arm(i, nums, target + 1) >= got, f"P4 {what}");
        // P5: a value as large as the target, in no subsequence that
        // counts, changes nothing
        expect(mut t, 5, arm(i, more, target) == got, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    // the binding annotated as check advises: an array literal inside a
    // tuple pushed to `cases` leaves the tuple's number at the default
    // `i64` (B-2026-11-26-9)
    let mut cases: Vec[(Vec[i32], i32)] = [
        ([3, 5, 6, 7], 9),
        ([3, 3, 6, 8], 10),
        ([2, 3, 3, 4, 6, 7], 12),
        ([1], 2),
        ([2], 3),
        ([9, 8, 7], 6),
        ([4, 4, 4, 4], 8),
        ([5, 7, 9], 10),
        ([1, 9], 10),
    ];
    let mut seed = 14981;
    // 1991 random arrays of 1 to 12 values from 1 to 30, the target from 1
    // to 60
    for _ in 0..1991 {
        let n = 1 + next_random(mut seed) % 12;
        let nums: Vec[i32] = (0..n).map(|_| (1 + next_random(mut seed) % 30) as i32).collect();
        cases.push((nums, (1 + next_random(mut seed) % 60) as i32));
    }
    for j in 0..cases.len() {
        let (nums, target) = ref cases[j];
        check_case(mut t, nums, target);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
