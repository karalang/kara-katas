// LeetCode #1498: Number of Subsequences That Satisfy the Given Sum
// Condition -- the bench, mirroring the ★ arm: the values sorted, then two
// pointers. One array of 100000 values up to 1000000, and 200 calls, each
// with a target chosen from the checksum so far and first moving one value.
const MOD: i64 = 1000000007;

fn num_subseq(nums: Vec[i32], target: i32) -> i32 {
    let mut sorted = nums.clone();
    sorted.sort();
    let n = sorted.len();
    let mut pow2: Vec[i64] = Vec.filled(n, 1);
    for i in 1..n {
        pow2[i] = pow2[i - 1] * 2 % MOD;
    }
    let mut count = 0;
    let mut lo = 0;
    let mut hi = n - 1;
    while lo <= hi {
        if sorted[lo] + sorted[hi] <= target {
            count = (count + pow2[hi - lo]) % MOD;
            lo += 1;
        } else {
            hi -= 1;
        }
    }
    count as i32
}

fn main() {
    let mut seed = 1498;
    let mut nums: Vec[i32] = Vec.new();
    for _ in 0..100000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        nums.push((1 + seed / 65536 * 31 % 1000000) as i32);
    }
    let mut check = 0;
    for call in 0..200 {
        let at = (check + call * 7919) % 100000;
        nums[at] = (1 + (check + call) % 1000000) as i32;
        let target = 1 + (check * 13 + call) % 1000000;
        check = (check * 31 + num_subseq(nums, target as i32)) % 1000000007;
    }
    println(f"200 calls over 100000 values: checksum {check}");
}
