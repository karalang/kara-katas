// LeetCode #1464: Maximum Product of Two Elements in an Array -- a max-heap
// of the values, popped twice

fn max_product(nums: Vec[i32]) -> i32 {
    let mut heap: PriorityQueue[i32] = PriorityQueue.max_first_from(nums.iter().collect());
    let a = heap.pop().unwrap();
    let b = heap.pop().unwrap();
    (a - 1) * (b - 1)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n values from 1 to top
fn draw(seed: mut ref i64, n: i64, top: i64) -> Vec[i32] {
    (0..n).map(|_| (1 + next_random(mut seed) % top) as i32).collect()
}

fn main() {
    // LeetCode's three examples, and four more: two 1s, two of the most,
    // the largest value once among 1s, and 500 values of 1000
    let e1 = max_product([3, 4, 5, 2].to_vec());
    let e2 = max_product([1, 5, 4, 5].to_vec());
    let e3 = max_product([3, 7].to_vec());
    let e4 = max_product([1, 1].to_vec());
    let e5 = max_product([1000, 1000].to_vec());
    let e6 = max_product([1, 1, 1000, 1, 1].to_vec());
    let e7 = max_product(Vec.filled(500, 1000));
    println(f"{e1} {e2} {e3} {e4} {e5} {e6} {e7}");
    // the constraints' most, 500 values from 1 to 1000
    let mut seed = 1464;
    let most = draw(mut seed, 500, 1000);
    println(f"500 values: {max_product(most)}");
    // 3000 random arrays of 2 to 60 values from 1 to top, top from 2 to
    // 1000
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 2 + next_random(mut seed) % 59;
        let top = 2 + next_random(mut seed) % 999;
        let got = max_product(draw(mut seed, n, top));
        total += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"3000 random arrays: total {total}, checksum {check}");
}
