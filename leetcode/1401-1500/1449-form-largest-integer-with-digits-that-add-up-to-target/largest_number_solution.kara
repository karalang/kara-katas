// LeetCode #1449: Form Largest Integer With Digits That Add up to Target --
// a Rust solution as LeetCode's Rust users write it: `let t = target as
// usize`, `vec![i32::MIN; t + 1]`, each digit's cost through `as usize`,
// and the answer pushed as `(b'1' + d as u8) as char`, carried to Kāra by
// `karac fix`

struct Solution {}

impl Solution {
    pub fn largest_number(cost: Vec[i32], target: i32) -> String {
        let t = target as i64;
        let mut dp = Vec.filled(t + 1, i32.MIN);
        dp[0] = 0;
        for i in 1..=t {
            for d in 0..9 {
                let c = cost[d] as i64;
                if i >= c and dp[i - c] != i32.MIN {
                    dp[i] = dp[i].max(dp[i - c] + 1);
                }
            }
        }
        if dp[t] < 0 {
            return "0".to_string();
        }
        let mut res = String.new();
        let mut i = t;
        for d in (0..9).rev() {
            let c = cost[d] as i64;
            while i >= c and dp[i - c] == dp[i] - 1 {
                res.push((b'1' + d as u8) as char);
                i -= c;
            }
        }
        res
    }
}

fn largest_number(cost: Vec[i32], target: i32) -> String {
    Solution.largest_number(cost, target)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// nine costs from 1 to `top`
fn costs(top: i64, seed: mut ref i64) -> Vec[i32] {
    (0..9).map(|_| (1 + next_random(mut seed) % top) as i32).collect()
}

fn fold(s: String, check: mut ref i64) {
    for b in s.bytes() {
        *check = (*check * 131 + b) % 1000000007;
    }
    *check = (*check * 131 + 32) % 1000000007;
}

fn main() {
    // LeetCode's four examples, and three more: every cost 1, every cost
    // 5000, and only the digit 1 cheap
    let firsts = [
        largest_number([4, 3, 2, 5, 6, 7, 2, 5, 5].to_vec(), 9),
        largest_number([7, 6, 5, 5, 5, 6, 8, 7, 8].to_vec(), 12),
        largest_number([2, 4, 6, 2, 4, 6, 4, 4, 4].to_vec(), 5),
        largest_number([6, 10, 15, 40, 40, 40, 40, 40, 40].to_vec(), 47),
        largest_number([1, 1, 1, 1, 1, 1, 1, 1, 1].to_vec(), 5),
        largest_number([5000, 5000, 5000, 5000, 5000, 5000, 5000, 5000, 5000].to_vec(), 5000),
        largest_number([1, 5000, 5000, 5000, 5000, 5000, 5000, 5000, 5000].to_vec(), 7),
    ];
    println(firsts.join(" "));
    // the constraints' most: a target of 5000 with every cost 1, and with
    // costs drawn from 1 to 50
    let mut seed = 1449;
    let all_one = largest_number([1, 1, 1, 1, 1, 1, 1, 1, 1].to_vec(), 5000);
    let drawn = largest_number(costs(50, mut seed), 5000);
    let mut check: i64 = 0;
    fold(all_one, mut check);
    fold(drawn, mut check);
    println(f"target 5000: {all_one.len()} and {drawn.len()} digits, checksum {check}");
    // 2000 random cases, costs from 1 to 1 to 30, or a third of them 1 to
    // 1 to 5000, and a target from 1 to 200
    let mut total = 0;
    let mut check: i64 = 0;
    for _ in 0..2000 {
        let wide = next_random(mut seed) % 3 == 0;
        let top = if wide { 1 + next_random(mut seed) % 5000 } else { 1 + next_random(mut seed) % 30 };
        let cost = costs(top, mut seed);
        let target = (1 + next_random(mut seed) % 200) as i32;
        let got = largest_number(cost, target);
        total += got.len();
        fold(got, mut check);
    }
    println(f"2000 random cases: {total} digits, checksum {check}");
}
