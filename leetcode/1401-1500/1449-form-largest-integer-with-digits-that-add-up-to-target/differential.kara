// LeetCode #1449: Form Largest Integer With Digits That Add up to Target -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- largest_number.kara ----
fn a0_largest_number(cost: Vec[i32], target: i32) -> String {
    // the most digits each cost from 0 to target buys exactly, -1 when it
    // buys none; then the digits taken from 9 down, each while what is left
    // still buys one digit fewer
    let target = target as i64;
    let mut most: Vec[i64] = Vec.filled(target + 1, -1);
    most[0] = 0;
    for t in 1..=target {
        for c in cost.iter() {
            let c = c as i64;
            if c <= t and most[t - c] >= 0 {
                most[t] = most[t].max(most[t - c] + 1);
            }
        }
    }
    if most[target] < 0 {
        return "0".to_string();
    }
    let mut digits = String.new();
    let mut left = target;
    for d in (0..9).rev() {
        let c = cost[d] as i64;
        while c <= left and most[left - c] == most[left] - 1 {
            digits.push((b'1' + d as u8) as char);
            left -= c;
        }
    }
    digits
}

// ---- largest_number_counts.kara ----
fn a1_largest_number(cost: Vec[i32], target: i32) -> String {
    // for each cost from 0 to target, the best answer it buys exactly, kept
    // as how many of each digit: more digits win, then more of the larger
    // digits
    let target = target as i64;
    let mut best: Vec[Option[Vec[i64]]] = Vec.filled(target + 1, None);
    best[0] = Some(Vec.filled(9, 0));
    for t in 1..=target {
        for d in 0..9 {
            let c = cost[d] as i64;
            if c > t {
                continue;
            }
            let Some(before) = best[t - c].clone() else {
                continue;
            };
            let mut next = before;
            next[d] += 1;
            if a1_better(next, best[t]) {
                best[t] = Some(next);
            }
        }
    }
    let Some(counts) = best[target].clone() else {
        return "0".to_string();
    };
    let mut digits = String.new();
    for d in (0..9).rev() {
        digits.push_str(((b'1' + d as u8) as char).to_string().repeat(counts[d]));
    }
    digits
}

// whether counts `a` make a larger number than `b`, or there is no `b`
fn a1_better(a: Vec[i64], b: Option[Vec[i64]]) -> bool {
    let Some(b) = b else {
        return true;
    };
    let (na, nb): (i64, i64) = (a.iter().sum(), b.iter().sum());
    if na != nb {
        return na > nb;
    }
    for d in (0..9).rev() {
        if a[d] != b[d] {
            return a[d] > b[d];
        }
    }
    false
}

// ---- largest_number_memo.kara ----
fn a2_largest_number(cost: Vec[i32], target: i32) -> String {
    // top down: the most digits a cost buys exactly, by recursion with a
    // memo; then each place takes the largest digit that leaves a cost
    // buying one digit fewer
    let target = target as i64;
    let mut memo: Vec[Option[i64]] = Vec.filled(target + 1, None);
    if a2_most(target, cost, mut memo) < 0 {
        return "0".to_string();
    }
    let mut digits = String.new();
    let mut left = target;
    while left > 0 {
        let want = a2_most(left, cost, mut memo) - 1;
        for d in (0..9).rev() {
            let c = cost[d] as i64;
            if c <= left and a2_most(left - c, cost, mut memo) == want {
                digits.push((b'1' + d as u8) as char);
                left -= c;
                break;
            }
        }
    }
    digits
}

// the most digits `t` buys exactly, -1 when none
fn a2_most(t: i64, cost: Vec[i32], memo: mut ref Vec[Option[i64]]) -> i64 {
    if t == 0 {
        return 0;
    }
    if let Some(known) = memo[t] {
        return known;
    }
    let mut best = -1;
    for c in cost.iter() {
        let c = c as i64;
        if c <= t {
            let m = a2_most(t - c, cost, mut memo);
            if m >= 0 {
                best = best.max(m + 1);
            }
        }
    }
    memo[t] = Some(best);
    best
}

// ---- largest_number_table.kara ----
fn a3_largest_number(cost: Vec[i32], target: i32) -> String {
    // a table by digits: row i the most digits from 1 to i buy for each
    // cost exactly, each digit as often as wanted; then back from row 9,
    // a digit taken while the cost without it buys one fewer, and the row
    // dropped when not
    let target = target as i64;
    let mut table: Vec[Vec[i64]] = Vec.filled(10, Vec.filled(target + 1, -1));
    table[0][0] = 0;
    for i in 1..10 {
        let c = cost[i - 1] as i64;
        for t in 0..=target {
            table[i][t] = table[i - 1][t];
            if c <= t and table[i][t - c] >= 0 {
                table[i][t] = table[i][t].max(table[i][t - c] + 1);
            }
        }
    }
    if table[9][target] < 0 {
        return "0".to_string();
    }
    let mut digits = String.new();
    let mut (i, t) = (9, target);
    while t > 0 {
        let c = cost[i - 1] as i64;
        if c <= t and table[i][t - c] >= 0 and table[i][t - c] + 1 == table[i][t] {
            digits.push((b'0' + i as u8) as char);
            t -= c;
        } else {
            i -= 1;
        }
    }
    digits
}

// ---- largest_number_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_largest_number(cost: Vec[i32], target: i32) -> String {
        let t = target as i64;
        let mut dp = Vec.filled(t + 1, i32.MIN);
        dp[0] = 0;
        for i in 1..=t {
            for d in 0..9 {
                let c = cost[d] as i64;
                if i >= c and dp[i - c] != i32.MIN {
                    dp[i] = dp[i].max(dp[i - c] + 1);
                }
            }
        }
        if dp[t] < 0 {
            return "0".to_string();
        }
        let mut res = String.new();
        let mut i = t;
        for d in (0..9).rev() {
            let c = cost[d] as i64;
            while i >= c and dp[i - c] == dp[i] - 1 {
                res.push((b'1' + d as u8) as char);
                i -= c;
            }
        }
        res
    }
}

fn a4_largest_number(cost: Vec[i32], target: i32) -> String {
    A4Solution.a4_largest_number(cost, target)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// nine costs from 1 to `top`
fn costs(top: i64, seed: mut ref i64) -> Vec[i32] {
    (0..9).map(|_| (1 + next_random(mut seed) % top) as i32).collect()
}

// whether `a` is at least `b` as a number
fn at_least(a: String, b: String) -> bool {
    a.len() > b.len() or (a.len() == b.len() and a >= b)
}

// the statement read literally: every number whose digits cost the target
// exactly, each written with its digits from the largest down, so every
// way to buy them is met once, and the largest of them
fn literal(cost: Vec[i32], target: i64) -> String {
    let mut best: Option[String] = None;
    paint(cost, 8, target, String.new(), mut best);
    best.unwrap_or("0".to_string())
}

fn paint(cost: Vec[i32], top: i64, left: i64, so_far: String, best: mut ref Option[String]) {
    if left == 0 {
        let larger = match best {
            Some(b) => not at_least(b, so_far),
            None => true,
        };
        if larger {
            *best = Some(so_far.clone());
        }
        return;
    }
    for d in (0..=top).rev() {
        let c = cost[d] as i64;
        if c <= left {
            let mut longer = so_far.clone();
            longer.push((b'1' + d as u8) as char);
            paint(cost, d, left - c, longer, mut best);
        }
    }
}

fn arm(i: i64, cost: Vec[i32], target: i64) -> String {
    let cost = cost.clone();
    let target = target as i32;
    match i {
        0 => a0_largest_number(cost, target),
        1 => a1_largest_number(cost, target),
        2 => a2_largest_number(cost, target),
        3 => a3_largest_number(cost, target),
        _ => a4_largest_number(cost, target),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, cost: Vec[i32], target: i64) {
    t.cases += 1;
    let star = arm(0, cost, target);
    for b in star.bytes() {
        t.check = (t.check * 131 + b) % 1000000007;
    }
    t.check = (t.check * 131 + 32) % 1000000007;
    let want = if target <= 12 { Some(literal(cost, target)) } else { None };
    let doubled: Vec[i32] = cost.iter().map(|c| 2 * c).collect();
    let cheapest = cost.iter().min().unwrap() as i64;
    let nine = cost[8] as i64;
    for i in 0..5 {
        let what = f"arm {i} on {cost} for {target}";
        let got = arm(i, cost, target);
        // P1: the statement read literally, while the target is at most 12
        if let Some(ref w) = want {
            expect(mut t, 1, got == w, f"P1 {what}");
        }
        // P2: the digits cost the target exactly, unless the answer is 0
        if got != "0" {
            let spent: i64 = got.bytes().iter().map(|b| cost[b - b'1'] as i64).sum();
            expect(mut t, 2, spent == target, f"P2 {what}");
        }
        // P3: every cost and the target doubled give the same number
        expect(mut t, 3, arm(i, doubled, 2 * target) == got, f"P3 {what}");
        // P4: a target the cost of a 9 more gives at least a 9 in front of
        // the answer
        if got != "0" {
            let more = arm(i, cost, target + nine);
            expect(mut t, 4, at_least(more, f"9{got}"), f"P4 {what}");
        }
        // P5: the digits from 1 to 9, never rising, and no more of them than
        // the target buys of the cheapest
        let digits: Vec[u8] = got.bytes().iter().collect();
        let falling = digits.windows(2).into_iter().all(|w| w[0] >= w[1]);
        let shape = got == "0" or (falling and digits.iter().all(|b| b >= b'1' and b <= b'9') and got.len() <= target / cheapest);
        expect(mut t, 5, shape, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: every cost 1, every cost 5000, and
    // only the digit 1 cheap; and the constraints' most, a target of 5000
    // with every cost 1 and with costs drawn from 1 to 50. Every case is
    // drawn before any arm answers.
    let mut cases: Vec[(Vec[i32], i64)] = [
        ([4, 3, 2, 5, 6, 7, 2, 5, 5].to_vec(), 9),
        ([7, 6, 5, 5, 5, 6, 8, 7, 8].to_vec(), 12),
        ([2, 4, 6, 2, 4, 6, 4, 4, 4].to_vec(), 5),
        ([6, 10, 15, 40, 40, 40, 40, 40, 40].to_vec(), 47),
        ([1, 1, 1, 1, 1, 1, 1, 1, 1].to_vec(), 5),
        ([5000, 5000, 5000, 5000, 5000, 5000, 5000, 5000, 5000].to_vec(), 5000),
        ([1, 5000, 5000, 5000, 5000, 5000, 5000, 5000, 5000].to_vec(), 7),
        ([1, 1, 1, 1, 1, 1, 1, 1, 1].to_vec(), 5000),
    ];
    let mut seed = 14491;
    cases.push((costs(50, mut seed), 5000));
    // 1994 random cases drawn as the harness draws them, and a third of
    // them with a target from 1 to 12, for the literal reading
    for _ in 0..1994 {
        let small = next_random(mut seed) % 3 == 0;
        let wide = next_random(mut seed) % 3 == 0;
        let top = if wide { 1 + next_random(mut seed) % 5000 } else { 1 + next_random(mut seed) % 30 };
        let cost = costs(top, mut seed);
        let target = if small { 1 + next_random(mut seed) % 12 } else { 1 + next_random(mut seed) % 200 };
        cases.push((cost, target));
    }
    for j in 0..cases.len() {
        let (cost, target) = cases[j].clone();
        check_case(mut t, cost, target);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
