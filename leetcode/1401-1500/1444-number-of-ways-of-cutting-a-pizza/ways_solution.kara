// LeetCode #1444: Number of Ways of Cutting a Pizza -- a Rust solution as
// LeetCode's Rust users write it: `const MOD: i64`, the rows as
// `Vec<&[u8]>` through `as_bytes()`, `vec![vec![0; n + 1]; m + 1]` for the
// apples from each cell on and `vec![vec![vec![0i64; n]; m]; k]` for the
// ways, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn ways(pizza: Vec[String], k: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let m = pizza.len();
        let n = pizza[0].len();
        let p: Vec[Slice[u8]] = pizza.iter().map(|s| s.bytes()).collect();
        let mut pre = Vec.filled(m + 1, Vec.filled(n + 1, 0));
        for i in (0..m).rev() {
            for j in (0..n).rev() {
                pre[i][j] = pre[i + 1][j] + pre[i][j + 1] - pre[i + 1][j + 1] + if p[i][j] == b'A' { 1 } else { 0 };
            }
        }
        let k = k as i64;
        let mut dp = Vec.filled(k, Vec.filled(m, Vec.filled(n, 0)));
        for i in 0..m {
            for j in 0..n {
                if pre[i][j] > 0 {
                    dp[0][i][j] = 1;
                }
            }
        }
        for t in 1..k {
            for i in 0..m {
                for j in 0..n {
                    let mut s = 0;
                    for x in i + 1..m {
                        if pre[i][j] - pre[x][j] > 0 {
                            s = (s + dp[t - 1][x][j]) % MOD;
                        }
                    }
                    for y in j + 1..n {
                        if pre[i][j] - pre[i][y] > 0 {
                            s = (s + dp[t - 1][i][y]) % MOD;
                        }
                    }
                    dp[t][i][j] = s;
                }
            }
        }
        dp[k - 1][0][0] as i32
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a pizza of `rows` by `cols`, each cell an apple `rate` times in 100
fn drawn(rows: i64, cols: i64, rate: i64, seed: mut ref i64) -> Vec[String] {
    let mut pizza: Vec[String] = Vec.new();
    for _ in 0..rows {
        let mut line = String.new();
        for _ in 0..cols {
            line.push(if next_random(mut seed) % 100 < rate { 'A' } else { '.' });
        }
        pizza.push(line);
    }
    pizza
}

fn main() {
    // LeetCode's three examples, and five more
    let cases: Vec[(Vec[String], i32)] = [
        (["A..", "AAA", "..."], 3),
        (["A..", "AA.", "..."], 3),
        (["A..", "A..", "..."], 1),
        (["A"], 1),
        (["."], 1),
        (["A.A"], 2),
        (["A", "A", "A"], 3),
        ([".A", "A."], 2),
    ]
        .iter()
        .map(|(pizza, k)| (pizza.iter().map(|line| line.to_string()).collect(), k))
        .collect();
    let firsts: Vec[String] = cases.iter().map(|(pizza, k)| f"{Solution.ways(pizza, k)}").collect();
    println(firsts.join(" "));
    // the constraints' most: 50 by 50 all apples, an apple a tenth of the
    // time, and one apple in the far corner, with k = 10, 10 and 1
    let mut seed = 1444;
    let full = drawn(50, 50, 100, mut seed);
    let sparse = drawn(50, 50, 10, mut seed);
    let mut corner = drawn(50, 50, 0, mut seed);
    corner[49] = f"{".".repeat(49)}A";
    println(f"50 by 50: {Solution.ways(full, 10)} {Solution.ways(sparse, 10)} {Solution.ways(corner, 1)}");
    // 2000 random pizzas of 1 to 8 by 1 to 8, an apple 0 to 100 times in
    // 100, with k from 1 to 10
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for _ in 0..2000 {
        let rows = 1 + next_random(mut seed) % 8;
        let cols = 1 + next_random(mut seed) % 8;
        let rate = next_random(mut seed) % 101;
        let k = (1 + next_random(mut seed) % 10) as i32;
        let got = Solution.ways(drawn(rows, cols, rate, mut seed), k);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random pizzas: {total} in all, checksum {check}");
}
