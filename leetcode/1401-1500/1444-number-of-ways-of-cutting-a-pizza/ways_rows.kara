// whether rows `top` to `bottom` - 1 hold an apple from column `left` on,
// each row's count from a column on read from `in_row`
fn holds(in_row: Slice[Vec[i64]], top: i64, bottom: i64, left: i64, right: i64) -> bool {
    (top..bottom).any(|r| in_row[r][left] > in_row[r][right])
}

fn ways(pizza: Vec[String], k: i32) -> i32 {
    // the apples in each row from each column on, and every cut's part
    // checked row by row, the ways for each count of pieces built from
    // the count before
    let rows = pizza.len();
    let cols = pizza[0].len();
    let mut in_row: Vec[Vec[i64]] = Vec.new();
    for line in pizza.iter() {
        let mut counts: Vec[i64] = Vec.filled(cols + 1, 0);
        let cells: Vec[char] = line.chars().collect();
        for c in (0..cols).rev() {
            counts[c] = counts[c + 1] + if cells[c] == 'A' { 1 } else { 0 };
        }
        in_row.push(counts);
    }
    let mut ways: Vec[Vec[i64]] = Vec.filled(rows, Vec.filled(cols, 0));
    for r in 0..rows {
        for c in 0..cols {
            if holds(in_row, r, rows, c, cols) {
                ways[r][c] = 1;
            }
        }
    }
    for _ in 1..k {
        let mut next: Vec[Vec[i64]] = Vec.filled(rows, Vec.filled(cols, 0));
        for r in 0..rows {
            for c in 0..cols {
                let mut total = 0;
                for cut in r + 1..rows {
                    if holds(in_row, r, cut, c, cols) {
                        total += ways[cut][c];
                    }
                }
                for cut in c + 1..cols {
                    if holds(in_row, r, rows, c, cut) {
                        total += ways[r][cut];
                    }
                }
                next[r][c] = total % 1000000007;
            }
        }
        ways = next;
    }
    ways[0][0] as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a pizza of `rows` by `cols`, each cell an apple `rate` times in 100
fn drawn(rows: i64, cols: i64, rate: i64, seed: mut ref i64) -> Vec[String] {
    let mut pizza: Vec[String] = Vec.new();
    for _ in 0..rows {
        let mut line = String.new();
        for _ in 0..cols {
            line.push(if next_random(mut seed) % 100 < rate { 'A' } else { '.' });
        }
        pizza.push(line);
    }
    pizza
}

fn main() {
    // LeetCode's three examples, and five more
    let cases: Vec[(Vec[String], i32)] = [
        (["A..", "AAA", "..."], 3),
        (["A..", "AA.", "..."], 3),
        (["A..", "A..", "..."], 1),
        (["A"], 1),
        (["."], 1),
        (["A.A"], 2),
        (["A", "A", "A"], 3),
        ([".A", "A."], 2),
    ]
        .iter()
        .map(|(pizza, k)| (pizza.iter().map(|line| line.to_string()).collect(), k))
        .collect();
    let firsts: Vec[String] = cases.iter().map(|(pizza, k)| f"{ways(pizza, k)}").collect();
    println(firsts.join(" "));
    // the constraints' most: 50 by 50 all apples, an apple a tenth of the
    // time, and one apple in the far corner, with k = 10, 10 and 1
    let mut seed = 1444;
    let full = drawn(50, 50, 100, mut seed);
    let sparse = drawn(50, 50, 10, mut seed);
    let mut corner = drawn(50, 50, 0, mut seed);
    corner[49] = f"{".".repeat(49)}A";
    println(f"50 by 50: {ways(full, 10)} {ways(sparse, 10)} {ways(corner, 1)}");
    // 2000 random pizzas of 1 to 8 by 1 to 8, an apple 0 to 100 times in
    // 100, with k from 1 to 10
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for _ in 0..2000 {
        let rows = 1 + next_random(mut seed) % 8;
        let cols = 1 + next_random(mut seed) % 8;
        let rate = next_random(mut seed) % 101;
        let k = (1 + next_random(mut seed) % 10) as i32;
        let got = ways(drawn(rows, cols, rate, mut seed), k);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random pizzas: {total} in all, checksum {check}");
}
