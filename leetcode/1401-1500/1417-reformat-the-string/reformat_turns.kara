fn reformat(s: String) -> String {
    // one pointer into each group, and the turn passed back and forth:
    // whoever has more starts, and a turn with nothing left ends it
    let chars: Vec[char] = s.chars().collect();
    let letters: Vec[i64] = (0..chars.len()).filter(|i| chars[i].is_ascii_alphabetic()).collect();
    let digits: Vec[i64] = (0..chars.len()).filter(|i| chars[i].is_ascii_digit()).collect();
    let mut out = String.new();
    let mut li = 0;
    let mut di = 0;
    let mut letter_turn = letters.len() >= digits.len();
    while out.len() < chars.len() {
        if letter_turn {
            if li == letters.len() {
                return "";
            }
            out.push(chars[letters[li]]);
            li += 1;
        } else {
            if di == digits.len() {
                return "";
            }
            out.push(chars[digits[di]]);
            di += 1;
        }
        letter_turn = not letter_turn;
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n characters, a digit one time in `digits` and a letter otherwise
fn drawn(n: i64, digits: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        let r = next_random(mut seed);
        if r % digits == 0 {
            s.push_str(f"{r / 7 % 10}");
        } else {
            s.push(['a', 'b', 'c', 'x', 'y', 'z'][r / 7 % 6]);
        }
    }
    s
}

fn shown(s: own String) -> String {
    if s.is_empty() { "-".to_string() } else { s }
}

fn main() {
    // LeetCode's three examples, and four more
    let firsts: Vec[String] = ["a0b1c2", "leetcode", "1229857369", "covid2019", "a", "7", "ab12c"]
        .iter()
        .map(|s| shown(reformat(s.to_string())))
        .collect();
    println(firsts.join(" "));
    // the constraints' most: 500 characters, even and uneven
    let mut seed = 1417;
    let even = drawn(500, 2, mut seed);
    let pieces: Vec[String] = (0..250).map(|i| f"{i % 10}q").collect();
    let half = pieces.join("");
    println(f"500 characters: {reformat(even).len()} {reformat(half)[..20]} {reformat(half[1..].to_string()).len()}");
    // 2000 random strings of 1 to 30 characters
    let mut check: i64 = 0;
    let mut empty = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 30;
        let out = reformat(drawn(n, 2 + next_random(mut seed) % 2, mut seed));
        if out.is_empty() {
            empty += 1;
        }
        for b in out.bytes().iter() {
            check = (check * 131 + b as i64) % 1000000007;
        }
        check = (check * 131 + 7) % 1000000007;
    }
    println(f"2000 random strings: {empty} empty, checksum {check}");
}
