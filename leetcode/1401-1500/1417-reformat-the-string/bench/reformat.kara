fn reformat(s: String) -> String {
    // the letters and the digits apart, each in its order, and woven
    // together from the larger group, the letters first on a tie; no
    // weave exists when one group has two or more over the other
    let letters: Vec[char] = s.chars().filter(|c| c.is_ascii_lowercase()).collect();
    let digits: Vec[char] = s.chars().filter(|c| c.is_ascii_digit()).collect();
    if letters.len().abs_diff(digits.len()) > 1 {
        return "";
    }
    let (first, second) = if digits.len() > letters.len() { (digits, letters) } else { (letters, digits) };
    let mut out = String.new();
    for i in 0..first.len() {
        out.push(first[i]);
        if i < second.len() {
            out.push(second[i]);
        }
    }
    out
}

fn main() {
    // a pool of 10^5 pairs, a letter and a digit in a drawn order, and
    // 20000 windows of 250 pairs, each window's start drawn
    let mut seed: i64 = 1417;
    let mut pool = String.new();
    for _ in 0..100000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let r = seed / 65536;
        let letter = ['a', 'b', 'c', 'x', 'y', 'z'][r % 6];
        let digit = f"{r / 6 % 10}";
        if r / 60 % 2 == 0 {
            pool.push(letter);
            pool.push_str(digit);
        } else {
            pool.push_str(digit);
            pool.push(letter);
        }
    }
    let mut check: i64 = 0;
    for _ in 0..20000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let start = 2 * (seed / 65536 % 99750);
        let out = reformat(pool[start..start + 500].to_string());
        let mut sum: i64 = 0;
        for b in out.bytes().iter() {
            sum = (sum * 31 + b as i64) % 1000000007;
        }
        check = (check * 131 + sum) % 1000000007;
    }
    println(f"20000 windows of 500 characters: checksum {check}");
}
