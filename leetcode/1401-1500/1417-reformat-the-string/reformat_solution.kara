struct Solution {}

impl Solution {
    pub fn reformat(s: String) -> String {
        let mut letters: Vec[char] = Vec.new();
        let mut digits: Vec[char] = Vec.new();
        for c in s.chars() {
            if c.is_ascii_digit() {
                digits.push(c);
            } else {
                letters.push(c);
            }
        }
        if (letters.len() as i32 - digits.len() as i32).abs() > 1 {
            return String.new();
        }
        let (a, b) = if letters.len() >= digits.len() { (ref letters, ref digits) } else { (ref digits, ref letters) };
        let mut res = String.with_capacity(s.len());
        for i in 0..a.len() {
            res.push(a[i]);
            if i < b.len() {
                res.push(b[i]);
            }
        }
        res
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n characters, a digit one time in `digits` and a letter otherwise
fn drawn(n: i64, digits: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        let r = next_random(mut seed);
        if r % digits == 0 {
            s.push_str(f"{r / 7 % 10}");
        } else {
            s.push(['a', 'b', 'c', 'x', 'y', 'z'][r / 7 % 6]);
        }
    }
    s
}

fn shown(s: own String) -> String {
    if s.is_empty() { "-".to_string() } else { s }
}

fn main() {
    // LeetCode's three examples, and four more
    let firsts: Vec[String] = ["a0b1c2", "leetcode", "1229857369", "covid2019", "a", "7", "ab12c"]
        .iter()
        .map(|s| shown(Solution.reformat(s.to_string())))
        .collect();
    println(firsts.join(" "));
    // the constraints' most: 500 characters, even and uneven
    let mut seed = 1417;
    let even = drawn(500, 2, mut seed);
    let pieces: Vec[String] = (0..250).map(|i| f"{i % 10}q").collect();
    let half = pieces.join("");
    println(f"500 characters: {Solution.reformat(even).len()} {Solution.reformat(half)[..20]} {Solution.reformat(half[1..].to_string()).len()}");
    // 2000 random strings of 1 to 30 characters
    let mut check: i64 = 0;
    let mut empty = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 30;
        let out = Solution.reformat(drawn(n, 2 + next_random(mut seed) % 2, mut seed));
        if out.is_empty() {
            empty += 1;
        }
        for b in out.bytes().iter() {
            check = (check * 131 + b as i64) % 1000000007;
        }
        check = (check * 131 + 7) % 1000000007;
    }
    println(f"2000 random strings: {empty} empty, checksum {check}");
}
