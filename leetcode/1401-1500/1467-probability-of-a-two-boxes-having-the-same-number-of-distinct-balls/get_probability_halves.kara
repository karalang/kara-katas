// LeetCode #1467: Probability of a Two Boxes Having The Same Number of
// Distinct Balls -- meet in the middle: each half of the colours' splits
// tallied by the first box's count and the difference of colours, and the
// two tallies matched

fn choose(n: i64, k: i64) -> i64 {
    (0..k).fold(1, |c, i| c * (n - i) / (i + 1))
}

// every split of `colours`, tallied by (balls in the first box, colours
// in the first box less colours in the second) with its shuffles
fn tally(colours: Vec[i32]) -> Map[(i64, i64), i64] {
    let mut seen: Map[(i64, i64), i64] = Map.new();
    seen.insert((0, 0), 1);
    for b in colours.iter() {
        let n = b as i64;
        let mut next: Map[(i64, i64), i64] = Map.new();
        for ((c, d), w) in seen.iter() {
            for j in 0..=n {
                let shift = if j == 0 { -1 } else if j == n { 1 } else { 0 };
                *next.entry((c + j, d + shift)).or_insert(0) += w * choose(n, j);
            }
        }
        seen = next;
    }
    seen
}

fn get_probability(balls: Vec[i32]) -> f64 {
    let total: i64 = balls.iter().sum();
    let half = total / 2;
    let mid = balls.len() / 2;
    let left = tally(balls[..mid].to_vec());
    let right = tally(balls[mid..].to_vec());
    // a split of the left half pairs with one of the right half that fills
    // the first box and evens the colours
    let mut good = 0;
    for ((c, d), w) in left.iter() {
        if let Some(v) = right.get((half - c, -d)) {
            good += w * v;
        }
    }
    good as f64 / choose(total, half) as f64
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 1 to 8 colours of 1 to 6 balls each, redrawn until the count is even
fn draw(seed: mut ref i64) -> Vec[i32] {
    loop {
        let k = 1 + next_random(mut seed) % 8;
        let balls: Vec[i32] = (0..k).map(|_| (1 + next_random(mut seed) % 6) as i32).collect();
        if balls.iter().sum() % 2 == 0 {
            return balls;
        }
    }
}

fn main() {
    // LeetCode's three examples, and three more: one colour of two balls,
    // two colours of one ball each, and the constraints' most, 8 colours
    // of 6 balls
    let e1 = get_probability([1, 1].to_vec());
    let e2 = get_probability([2, 1, 1].to_vec());
    let e3 = get_probability([1, 2, 1, 2].to_vec());
    let e4 = get_probability([2].to_vec());
    let e5 = get_probability([3, 1].to_vec());
    let e6 = get_probability(Vec.filled(8, 6));
    println(f"{e1} {e2} {e3} {e4} {e5} {e6}");
    // 300 random sets of balls, their probabilities summed and the
    // millionths folded into a checksum
    let mut seed = 1467;
    let mut total = 0.0;
    let mut check = 0;
    for _ in 0..300 {
        let p = get_probability(draw(mut seed));
        total += p;
        check = (check * 31 + (p * 1000000.0).round() as i64) % 1000000007;
    }
    println(f"300 random sets: sum {total}, checksum {check}");
}
