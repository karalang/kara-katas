fn max_vowels(s: String, k: i32) -> i32 {
    // the first window's vowels, then the letters coming in zipped with the
    // letters going out, each pair's change folded in by `scan`
    let vowel = |c: char| match c { 'a' | 'e' | 'i' | 'o' | 'u' => true, _ => false };
    let k = k as i64;
    let first = s.chars().take(k).filter(|c| vowel(c)).count() as i32;
    let later = s.chars().skip(k).zip(s.chars()).scan(first, |count, (inn, out)| {
        let count = count + (vowel(inn) as i32 - vowel(out) as i32);
        Some((count, count))
    });
    later.fold(first, |best, c| best.max(c))
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters, each a vowel one time in `odds`, else a consonant
fn text(n: i64, odds: i64, seed: mut ref i64) -> String {
    let vowels = "aeiou";
    let others = "bcdfghjklmnpqrstvwxyz";
    let mut s = String.new();
    for _ in 0..n {
        if next_random(mut seed) % odds == 0 {
            s.push(vowels.chars().nth(next_random(mut seed) % 5).unwrap());
        } else {
            s.push(others.chars().nth(next_random(mut seed) % 21).unwrap());
        }
    }
    s
}

fn main() {
    // LeetCode's three examples, and three more: one letter, no vowel, and
    // the window the whole string
    let cases = [("abciiidef", 3), ("aeiou", 2), ("leetcode", 3), ("a", 1), ("rhythm", 4), ("education", 9)];
    for (s, k) in cases {
        println(max_vowels(s.to_string(), k));
    }
    // the constraints' most: 10^5 letters with windows of 1, of 1000 and of
    // the whole string
    let mut seed = 1456;
    let long = text(100000, 3, mut seed);
    println(f"10^5 letters: {max_vowels(long, 1)} {max_vowels(long, 1000)} {max_vowels(long, 100000)}");
    // 2000 random cases of 1 to 60 letters, a vowel one time in 1 to 5, and
    // a window of 1 to the whole string
    let mut total = 0;
    let mut check: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 60;
        let odds = 1 + next_random(mut seed) % 5;
        let k = 1 + next_random(mut seed) % n;
        let got = max_vowels(text(n, odds, mut seed), k as i32);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random cases: {total} vowels, checksum {check}");
}
