// LeetCode #1436: Destination City -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- dest_city.kara ----
fn a0_dest_city(paths: Vec[Vec[String]]) -> String {
    // every city a path leaves from, and the one city a path reaches that
    // no path leaves
    let starts: Set[String] = paths.iter().map(|path| path[0].clone()).collect();
    paths.iter().map(|path| path[1].clone()).find(|city| not starts.contains(city)).unwrap()
}

// ---- dest_city_follow.kara ----
fn a1_dest_city(paths: Vec[Vec[String]]) -> String {
    // each city's next city in a map, and the trip followed from the
    // first path's city until it reaches a city with no next
    let mut next: Map[String, String] = Map.new();
    for path in paths.iter() {
        next.insert(path[0].clone(), path[1].clone());
    }
    let mut city = paths[0][0].clone();
    while let Some(after) = next.get(city) {
        city = after.clone();
    }
    city
}

// ---- dest_city_brute.kara ----
fn a2_dest_city(paths: Vec[Vec[String]]) -> String {
    // each path's end tried against every path's start, the first end no
    // path starts from
    for i in 0..paths.len() {
        let mut leaves = false;
        for j in 0..paths.len() {
            if paths[j][0] == paths[i][1] {
                leaves = true;
                break;
            }
        }
        if not leaves {
            return paths[i][1].clone();
        }
    }
    String.new()
}

// ---- dest_city_sorted.kara ----
fn a3_dest_city(paths: Vec[Vec[String]]) -> String {
    // the cities reached and the cities left, each a `SortedSet`, and the
    // one city reached and never left
    let reached: SortedSet[String] = paths.iter().map(|path| path[1].clone()).collect();
    let left: SortedSet[String] = paths.iter().map(|path| path[0].clone()).collect();
    reached.difference(left).into_iter().next().unwrap().clone()
}

// ---- dest_city_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_dest_city(paths: Vec[Vec[String]]) -> String {
        let starts: Set[ref String] = paths.iter().map(|p| ref p[0]).collect();
        for p in paths.iter() {
            if not starts.contains(p[1]) {
                return p[1].clone();
            }
        }
        String.new()
    }
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a trip through n + 1 different cities, each name 1 to `longest` letters
// of the first `k` of the alphabet, with its n paths in a drawn order
fn trip(n: i64, longest: i64, k: i64, seed: mut ref i64) -> Vec[Vec[String]] {
    let mut cities: Vec[String] = Vec.new();
    while cities.len() < n + 1 {
        let length = 1 + next_random(mut seed) % longest;
        let mut name = String.new();
        for _ in 0..length {
            name.push((b'A' + (next_random(mut seed) % k) as u8) as char);
        }
        if not cities.contains(name) {
            cities.push(name);
        }
    }
    let mut paths: Vec[Vec[String]] = (0..n).map(|i| [cities[i].clone(), cities[i + 1].clone()].to_vec()).collect();
    for i in (1..paths.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        paths.swap(i, j);
    }
    paths
}

// a name folded to a number
fn folded(name: Str) -> i64 {
    name.bytes().iter().fold(0, |h, b| (h * 31 + b) % 1000000007)
}

// the statement read literally: every city named in a path, at either
// end, and the one with no path out of it to another city
fn literal(paths: Vec[Vec[String]]) -> String {
    let mut cities: Vec[String] = Vec.new();
    for path in paths.iter() {
        for city in path.iter() {
            if not cities.contains(city) {
                cities.push(city.clone());
            }
        }
    }
    let mut ends: Vec[String] = Vec.new();
    for city in cities.iter() {
        let mut out = 0;
        for path in paths.iter() {
            if path[0] == city and path[1] != city {
                out += 1;
            }
        }
        if out == 0 {
            ends.push(city.clone());
        }
    }
    if ends.len() == 1 { ends[0].clone() } else { "no one city".to_string() }
}

fn arm(i: i64, paths: Vec[Vec[String]]) -> String {
    let paths = paths.clone();
    match i {
        0 => a0_dest_city(paths),
        1 => a1_dest_city(paths),
        2 => a2_dest_city(paths),
        3 => a3_dest_city(paths),
        _ => A4Solution.a4_dest_city(paths),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, paths: Vec[Vec[String]]) {
    t.cases += 1;
    let star = arm(0, paths);
    t.check = (t.check * 131 + folded(star)) % 1000000007;
    let n = paths.len();
    let want = literal(paths);
    let reversed: Vec[Vec[String]] = paths.iter().rev().cloned().collect();
    let renamed: Vec[Vec[String]] = paths.iter().map(|path| path.iter().map(|c| f"{c}-").collect()).collect();
    for i in 0..5 {
        let what = f"arm {i} on {n} paths";
        let got = arm(i, paths);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: the paths in the other order give the same city
        expect(mut t, 2, arm(i, reversed) == got, f"P2 {what}");
        // P3: a path on from the answer to a new city gives the new city
        let mut longer = paths.clone();
        let beyond = f"{got} and on";
        longer.push([got.clone(), beyond.clone()].to_vec());
        expect(mut t, 3, arm(i, longer) == beyond, f"P3 {what}");
        // P4: some path's end, and no path's start
        let ends = paths.iter().any(|path| path[1] == got);
        let starts = paths.iter().any(|path| path[0] == got);
        expect(mut t, 4, ends and not starts, f"P4 {what}");
        // P5: every name with a dash after it gives the answer with one
        expect(mut t, 5, arm(i, renamed) == f"{got}-", f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: one path, one name the start of
    // another, two names that differ in case, a name with spaces, and the
    // trip given end first; and the constraints' most two ways. Every case
    // is drawn before any arm answers.
    let firsts: Vec[Vec[Vec[String]]] = [
        [["London", "New York"], ["New York", "Lima"], ["Lima", "Sao Paulo"]],
        [["B", "C"], ["D", "B"], ["C", "A"]],
        [["A", "Z"]],
        [["pqrs", "pq"], ["p", "pqrs"]],
        [["a", "b"]],
        [["ab", "a"], ["abc", "ab"]],
        [["a", "A"], ["A", "b"], ["b", "B"]],
        [["Rio de Janeiro", "Rio"], ["de", "Rio de Janeiro"]],
        [["y", "z"], ["x", "y"], ["w", "x"], ["v", "w"]],
    ]
        .iter()
        .map(|paths| paths.iter().map(|path| path.iter().map(|c| c.to_string()).collect()).collect())
        .collect();
    let mut cases: Vec[Vec[Vec[String]]] = firsts;
    let mut seed = 14361;
    cases.push(trip(100, 10, 26, mut seed));
    cases.push(trip(100, 10, 2, mut seed));
    // 1992 random trips of 1 to 100 paths, the names of 1 to 10 letters of
    // the first 2 to 26 of the alphabet
    for _ in 0..1992 {
        let longest = 1 + next_random(mut seed) % 10;
        let k = 2 + next_random(mut seed) % 25;
        // no more paths than there are names for cities
        let mut names = 0;
        let mut power = 1;
        for _ in 0..longest {
            power = (power * k).min(1000);
            names = (names + power).min(1000);
        }
        let n = 1 + next_random(mut seed) % (names - 1).min(100);
        cases.push(trip(n, longest, k, mut seed));
    }
    for j in 0..cases.len() {
        let paths = cases[j].clone();
        check_case(mut t, paths);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
