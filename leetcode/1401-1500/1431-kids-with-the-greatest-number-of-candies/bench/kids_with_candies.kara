fn kids_with_candies(candies: Slice[i32], extra_candies: i32) -> Vec[bool] {
    // the most any kid has, and each kid against it with the extra
    let most = candies.iter().max().unwrap();
    candies.iter().map(|c| c + extra_candies >= most).collect()
}

fn main() {
    // a pool of 10^6 kids of 1 to 100 candies, and 10^6 windows of 100 of
    // them, each window's start and its extra drawn, each answer folded to
    // the sum of the places of the kids that can have the most
    let mut seed: i64 = 1431;
    let mut pool: Vec[i32] = Vec.with_capacity(1000000);
    for _ in 0..1000000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        pool.push((1 + seed / 65536 % 100) as i32);
    }
    let mut check: i64 = 0;
    for _ in 0..1000000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let start = seed / 65536 % 999901;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let extra = (1 + seed / 65536 % 50) as i32;
        // each kid that can have the most counted by its place
        let mut bits: i64 = 0;
        for (j, b) in kids_with_candies(pool[start..start + 100], extra).iter().enumerate() {
            if b {
                bits += j + 1;
            }
        }
        check = (check * 131 + bits) % 1000000007;
    }
    println(f"10^6 windows of 100 kids: checksum {check}");
}
