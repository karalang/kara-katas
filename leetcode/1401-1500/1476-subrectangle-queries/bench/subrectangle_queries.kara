// LeetCode #1476: Subrectangle Queries -- bench. One 100 by 100 grid made
// once; then 5000 passes of 250 updates, each followed by a read, the
// subrectangles and cells drawn from a seeded stream and each new value
// taken from the checksum so far.

struct SubrectangleQueries {
    rect: Vec[Vec[i32]],
}

impl SubrectangleQueries {
    fn new(rectangle: own Vec[Vec[i32]]) -> SubrectangleQueries {
        SubrectangleQueries { rect: rectangle }
    }

    fn update_subrectangle(mut ref self, row1: i32, col1: i32, row2: i32, col2: i32, new_value: i32) {
        for r in row1..=row2 {
            for c in col1..=col2 {
                self.rect[r][c] = new_value;
            }
        }
    }

    fn get_value(self, row: i32, col: i32) -> i32 {
        self.rect[row][col]
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1476;
    let mut rect: Vec[Vec[i32]] = Vec.new();
    for _ in 0..100 {
        rect.push((0..100).map(|_| (1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000) as i32).collect());
    }
    let mut q = SubrectangleQueries.new(rect);
    let mut check = 0;
    for pass in 0..5000 {
        for _ in 0..250 {
            let r1 = next_random(mut seed) % 100;
            let r2 = r1 + next_random(mut seed) % (100 - r1);
            let c1 = next_random(mut seed) % 100;
            let c2 = c1 + next_random(mut seed) % (100 - c1);
            q.update_subrectangle(r1 as i32, c1 as i32, r2 as i32, c2 as i32, (1 + check % 1000000000) as i32);
            let r = next_random(mut seed) % 100;
            let c = next_random(mut seed) % 100;
            check = (check * 31 + q.get_value(r as i32, c as i32) + pass) % 1000000007;
        }
    }
    println(f"5000 passes of 250 updates on 100 by 100: checksum {check}");
}
