// LeetCode #1487: Making File Names Unique -- bench. 50000 names drawn
// once from 3000 base names, a third with a suffix `(k)`; then 20 passes,
// each punching one name and making every folder, both chosen from the
// checksum so far.

fn get_folder_names(names: Vec[String]) -> Vec[String] {
    let mut next: Map[String, i64] = Map.new();
    let mut out: Vec[String] = Vec.new();
    for name in names.iter() {
        match next.get(name) {
            None => {
                next.insert(name.clone(), 1);
                out.push(name.clone());
            }
            Some(from) => {
                let mut k = from;
                while next.contains_key(f"{name}({k})") {
                    k += 1;
                }
                let made = f"{name}({k})";
                next.insert(name.clone(), k + 1);
                next.insert(made.clone(), 1);
                out.push(made);
            }
        }
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn name_of(b: i64, suffix: i64) -> String {
    let base = f"{(b'a' + (b % 26) as u8) as char}{b / 26}";
    if suffix == 0 { base } else { f"{base}({suffix})" }
}

fn main() {
    let mut seed = 1487;
    let mut names: Vec[String] = Vec.new();
    for _ in 0..50000 {
        let b = next_random(mut seed) % 3000;
        let s = next_random(mut seed) % 9;
        names.push(name_of(b, if s < 3 { s + 1 } else { 0 }));
    }
    let mut check = 0;
    for pass in 0..20 {
        names[check % 50000] = name_of(check % 3000, check % 4);
        let folders = get_folder_names(names);
        for f in folders.iter() {
            for b in f.bytes() {
                check = (check * 131 + b) % 1000000007;
            }
        }
        check = (check + pass) % 1000000007;
    }
    println(f"20 passes over 50000 names: checksum {check}");
}
