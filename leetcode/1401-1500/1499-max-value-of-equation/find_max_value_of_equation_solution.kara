// LeetCode #1499: Max Value of Equation -- a Rust solution as LeetCode's
// Rust users write it, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn find_max_value_of_equation(points: Vec[Vec[i32]], k: i32) -> i32 {
        let mut dq: VecDeque[(i32, i32)] = VecDeque.new();
        let mut ans = i32.MIN;
        for p in points.iter() {
            let (x, y) = (p[0], p[1]);
            while let Some((_, xi)) = dq.front().cloned() {
                if x - xi > k {
                    dq.pop_front();
                } else {
                    break;
                }
            }
            if let Some((v, _)) = dq.front().cloned() {
                ans = ans.max(v + x + y);
            }
            while let Some((v, _)) = dq.back().cloned() {
                if v <= y - x {
                    dq.pop_back();
                } else {
                    break;
                }
            }
            dq.push_back((y - x, x));
        }
        ans
    }
}

fn find_max_value_of_equation(points: Vec[Vec[i32]], k: i32) -> i32 {
    Solution.find_max_value_of_equation(points, k)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n points with x rising by 1 to `gap` from `start`, y from -spread to
// spread
fn random_points(seed: mut ref i64, n: i64, start: i64, gap: i64, spread: i64) -> Vec[Vec[i32]] {
    let mut points: Vec[Vec[i32]] = Vec.new();
    let mut x = start;
    for _ in 0..n {
        x += 1 + next_random(mut seed) % gap;
        let y = next_random(mut seed) * 4099 % (2 * spread + 1) - spread;
        points.push([x as i32, y as i32].to_vec());
    }
    points
}

fn main() {
    // LeetCode's two examples
    println(f"{find_max_value_of_equation([[1, 3], [2, 0], [5, 10], [6, -10]], 1)} {find_max_value_of_equation([[0, 0], [3, 0], [9, 2]], 3)}");
    // the edges: two points exactly k apart; the best pair not beside each
    // other; a far point too far to pair; every y negative; the most
    // values
    println(f"{find_max_value_of_equation([[0, 5], [4, 7]], 4)} {find_max_value_of_equation([[0, 10], [1, -50], [2, 10]], 2)} {find_max_value_of_equation([[0, 1], [1, 1], [9, 100]], 2)} {find_max_value_of_equation([[1, -8], [2, -5], [4, -1]], 3)} {find_max_value_of_equation([[-100000000, 100000000], [100000000, 100000000]], 200000000)}");
    // the constraints' most: 100000 points, k small, middling and as wide
    // as the whole span
    let mut seed = 1499;
    let wide = random_points(mut seed, 100000, -100000000, 2000, 100000000);
    println(f"100000 points: {find_max_value_of_equation(wide, 2000)} {find_max_value_of_equation(wide, 1000000)} {find_max_value_of_equation(wide, 200000000)}");
    // 3000 random cases of 2 to 30 points, k from 1 to 25 and never less
    // than the largest rise, so any two neighbours can pair
    let mut check = 0;
    for _ in 0..3000 {
        let n = 2 + next_random(mut seed) % 29;
        let gap = 1 + next_random(mut seed) % 6;
        let k = gap + next_random(mut seed) % 20;
        let points = random_points(mut seed, n, -50, gap, 40);
        check = (check * 31 + find_max_value_of_equation(points, k as i32) + 1000) % 1000000007;
    }
    println(f"3000 random cases: checksum {check}");
}
