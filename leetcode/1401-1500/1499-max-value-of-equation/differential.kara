// LeetCode #1499: Max Value of Equation -- differential test of the five
// arms against the statement read literally, with five more properties.

// ---- find_max_value_of_equation.kara ----
fn a0_find_max_value_of_equation(points: Vec[Vec[i32]], k: i32) -> i32 {
    let mut window: VecDeque[(i32, i32)] = VecDeque.new();
    let mut best = i32.MIN;
    for p in points.iter() {
        let (x, y) = (p[0], p[1]);
        while window.front().is_some_and(|f| x - f.1 > k) {
            window.pop_front();
        }
        if let Some(f) = window.front() {
            best = best.max(f.0 + y + x);
        }
        while window.back().is_some_and(|b| b.0 <= y - x) {
            window.pop_back();
        }
        window.push_back((y - x, x));
    }
    best
}

// ---- find_max_value_of_equation_heap.kara ----
fn a1_find_max_value_of_equation(points: Vec[Vec[i32]], k: i32) -> i32 {
    let mut heap: PriorityQueue[(i32, i32)] = PriorityQueue.max_first();
    let mut best = i32.MIN;
    for p in points.iter() {
        let (x, y) = (p[0], p[1]);
        while heap.peek().is_some_and(|top| x - top.1 > k) {
            heap.pop();
        }
        if let Some(top) = heap.peek() {
            best = best.max(top.0 + y + x);
        }
        heap.push((y - x, x));
    }
    best
}

// ---- find_max_value_of_equation_sparse.kara ----
fn a2_find_max_value_of_equation(points: Vec[Vec[i32]], k: i32) -> i32 {
    let n = points.len();
    let mut table: Vec[Vec[i32]] = [points.iter().map(|p| p[1] - p[0]).collect()].to_vec();
    let mut width = 1;
    while 2 * width <= n {
        let last = ref table[table.len() - 1];
        let next: Vec[i32] = (0..n - 2 * width + 1).map(|i| last[i].max(last[i + width])).collect();
        table.push(next);
        width *= 2;
    }
    let mut best = i32.MIN;
    for j in 1..n {
        let (x, y) = (points[j][0], points[j][1]);
        let from = points.partition_point(|p| x - p[0] > k);
        if from >= j {
            continue;
        }
        // the largest over from..j, two runs of the same power of two
        let level = i64.BITS - (j - from).leading_zeros() - 1;
        let row = ref table[level];
        let most = row[from].max(row[j - (1 << level)]);
        best = best.max(most + y + x);
    }
    best
}

// ---- find_max_value_of_equation_segment.kara ----
fn a3_largest(tree: Vec[i32], size: i64, from: i64, to: i64) -> i32 {
    // the largest over the leaves from..to, walked up from both ends
    let mut best = i32.MIN;
    let mut lo = from + size;
    let mut hi = to + size;
    while lo < hi {
        if lo % 2 == 1 {
            best = best.max(tree[lo]);
            lo += 1;
        }
        if hi % 2 == 1 {
            hi -= 1;
            best = best.max(tree[hi]);
        }
        lo /= 2;
        hi /= 2;
    }
    best
}

fn a3_find_max_value_of_equation(points: Vec[Vec[i32]], k: i32) -> i32 {
    let n = points.len();
    let mut size = 1;
    while size < n {
        size *= 2;
    }
    let mut tree: Vec[i32] = Vec.filled(2 * size, i32.MIN);
    for i in 0..n {
        tree[size + i] = points[i][1] - points[i][0];
    }
    for i in (1..size).rev() {
        tree[i] = tree[2 * i].max(tree[2 * i + 1]);
    }
    let mut best = i32.MIN;
    let mut from = 0;
    for j in 1..n {
        let (x, y) = (points[j][0], points[j][1]);
        while points[j][0] - points[from][0] > k {
            from += 1;
        }
        if from < j {
            best = best.max(a3_largest(tree, size, from, j) + y + x);
        }
    }
    best
}

// ---- find_max_value_of_equation_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn find_max_value_of_equation(points: Vec[Vec[i32]], k: i32) -> i32 {
        let mut dq: VecDeque[(i32, i32)] = VecDeque.new();
        let mut ans = i32.MIN;
        for p in points.iter() {
            let (x, y) = (p[0], p[1]);
            while let Some((_, xi)) = dq.front().cloned() {
                if x - xi > k {
                    dq.pop_front();
                } else {
                    break;
                }
            }
            if let Some((v, _)) = dq.front().cloned() {
                ans = ans.max(v + x + y);
            }
            while let Some((v, _)) = dq.back().cloned() {
                if v <= y - x {
                    dq.pop_back();
                } else {
                    break;
                }
            }
            dq.push_back((y - x, x));
        }
        ans
    }
}

fn a4_find_max_value_of_equation(points: Vec[Vec[i32]], k: i32) -> i32 {
    A4Solution.find_max_value_of_equation(points, k)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_points(seed: mut ref i64, n: i64, start: i64, gap: i64, spread: i64) -> Vec[Vec[i32]] {
    let mut points: Vec[Vec[i32]] = Vec.new();
    let mut x = start;
    for _ in 0..n {
        x += 1 + next_random(mut seed) % gap;
        let y = next_random(mut seed) * 4099 % (2 * spread + 1) - spread;
        points.push([x as i32, y as i32].to_vec());
    }
    points
}

// the statement read literally: every pair i < j no more than k apart,
// and the largest yi + yj + |xi - xj| among them
fn literal(points: Vec[Vec[i32]], k: i32) -> i32 {
    let mut best = i32.MIN;
    for i in 0..points.len() {
        for j in i + 1..points.len() {
            let apart = (points[i][0] - points[j][0]).abs();
            if apart <= k {
                best = best.max(points[i][1] + points[j][1] + apart);
            }
        }
    }
    best
}

fn arm(i: i64, points: Vec[Vec[i32]], k: i32) -> i32 {
    match i {
        0 => a0_find_max_value_of_equation(points, k),
        1 => a1_find_max_value_of_equation(points, k),
        2 => a2_find_max_value_of_equation(points, k),
        3 => a3_find_max_value_of_equation(points, k),
        _ => a4_find_max_value_of_equation(points, k),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, points: Vec[Vec[i32]], k: i32, lift: i32) {
    t.cases += 1;
    let want = literal(points, k);
    t.check = (t.check * 31 + want + 1000) % 1000000007;
    let star = arm(0, points, k);
    let neighbours = (1..points.len()).filter(|j| points[j][0] - points[j - 1][0] <= k).map(|j| points[j - 1][1] + points[j][1] + points[j][0] - points[j - 1][0]).max() ?? i32.MIN;
    let mirrored: Vec[Vec[i32]] = points.iter().rev().map(|p| [-p[0], p[1]].to_vec()).collect();
    let lifted: Vec[Vec[i32]] = points.iter().map(|p| [p[0], p[1] + lift].to_vec()).collect();
    for i in 0..5 {
        let what = f"arm {i} on {points}, k {k}";
        let got = arm(i, points, k);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: no less than any two neighbours within k give
        expect(mut t, 2, got >= neighbours, f"P2 {what}");
        // P3: the points mirrored, x to -x and the order reversed, give the
        // same
        expect(mut t, 3, arm(i, mirrored, k) == got, f"P3 {what}");
        // P4: every y raised by `lift` raises the answer by twice that
        // (in i64, so an arm that found no pair fails here rather than
        // overflowing)
        expect(mut t, 4, arm(i, lifted, k) == got + 2 * lift as i64, f"P4 {what}");
        // P5: a wider k gives no less
        expect(mut t, 5, arm(i, points, k + 1) >= got, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[(Vec[Vec[i32]], i32)] = [
        ([[1, 3], [2, 0], [5, 10], [6, -10]], 1),
        ([[0, 0], [3, 0], [9, 2]], 3),
        ([[0, 5], [4, 7]], 4),
        ([[0, 10], [1, -50], [2, 10]], 2),
        ([[0, 1], [1, 1], [9, 100]], 2),
        ([[1, -8], [2, -5], [4, -1]], 3),
    ];
    let mut seed = 14991;
    // 1994 random cases of 2 to 12 points, x rising by 1 to 6, y from -40
    // to 40, k at least the largest rise
    for _ in 0..1994 {
        let n = 2 + next_random(mut seed) % 11;
        let gap = 1 + next_random(mut seed) % 6;
        let k = gap + next_random(mut seed) % 20;
        cases.push((random_points(mut seed, n, -50, gap, 40), k as i32));
    }
    for j in 0..cases.len() {
        let (points, k) = ref cases[j];
        check_case(mut t, points, k, (next_random(mut seed) % 21 - 10) as i32);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
