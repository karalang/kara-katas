// LeetCode #1466 bench in Kāra: the ★ arm (a breadth-first search out of
// city 0 over the roads taken both ways) on 10 trees of 50000 cities and
// 20 passes.

fn min_reorder(n: i32, connections: Vec[Vec[i32]]) -> i32 {
    // each road is listed at both its ends, marked 1 where it leads away
    // from the end it is listed at; the roads form a tree, so the search
    // out of 0 crosses each once, away from 0, and each crossed in its own
    // direction leads away and must be turned
    let mut roads: Vec[Vec[(i32, i32)]] = Vec.filled(n, Vec.new());
    for c in connections.iter() {
        roads[c[0]].push((c[1], 1));
        roads[c[1]].push((c[0], 0));
    }
    let mut seen = Vec.filled(n, false);
    let mut queue: VecDeque[i32] = VecDeque.new();
    seen[0] = true;
    queue.push_back(0);
    let mut turned: i32 = 0;
    while let Some(city) = queue.pop_front() {
        for (next, away) in roads[city].iter() {
            if not seen[next] {
                seen[next] = true;
                turned += away;
                queue.push_back(next);
            }
        }
    }
    turned
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1466;
    let n = 50000;
    let mut trees: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..10 {
        let mut label: Vec[i32] = (0..n).map(|c| c as i32).collect();
        for i in (1..n).rev() {
            let j = next_random(mut seed) % (i + 1);
            label.swap(i, j);
        }
        let mut roads: Vec[Vec[i32]] = Vec.new();
        for i in 1..n {
            let p = next_random(mut seed) % i;
            if next_random(mut seed) % 2 == 0 {
                roads.push([label[i], label[p]].to_vec());
            } else {
                roads.push([label[p], label[i]].to_vec());
            }
        }
        trees.push(roads);
    }
    let mut check: i64 = 0;
    for pass in 0..20 {
        for t in 0..10 {
            let k = check % (n - 1);
            trees[t][k].swap(0, 1);
            let got = min_reorder(n as i32, trees[t]);
            check = (check * 31 + got + pass) % 1000000007;
        }
    }
    println(f"20 passes over 10 trees of 50000 cities: checksum {check}");
}
