// LeetCode #1466: Reorder Routes to Make All Paths Lead to the City Zero --
// differential test of the five arms against the statement read
// literally, with five more properties.

// ---- min_reorder.kara ----
fn a0_min_reorder(n: i32, connections: Vec[Vec[i32]]) -> i32 {
    // each road is listed at both its ends, marked 1 where it leads away
    // from the end it is listed at; the roads form a tree, so the search
    // out of 0 crosses each once, away from 0, and each crossed in its own
    // direction leads away and must be turned
    let mut roads: Vec[Vec[(i32, i32)]] = Vec.filled(n, Vec.new());
    for c in connections.iter() {
        roads[c[0]].push((c[1], 1));
        roads[c[1]].push((c[0], 0));
    }
    let mut seen = Vec.filled(n, false);
    let mut queue: VecDeque[i32] = VecDeque.new();
    seen[0] = true;
    queue.push_back(0);
    let mut turned: i32 = 0;
    while let Some(city) = queue.pop_front() {
        for (next, away) in roads[city].iter() {
            if not seen[next] {
                seen[next] = true;
                turned += away;
                queue.push_back(next);
            }
        }
    }
    turned
}

// ---- min_reorder_dfs.kara ----
fn a1_turns(roads: Vec[Vec[(i32, bool)]], city: i32, parent: i32) -> i32 {
    let mut count: i32 = 0;
    for (next, away) in roads[city].iter() {
        if next != parent {
            if away {
                count += 1;
            }
            count += a1_turns(roads, next, city);
        }
    }
    count
}

fn a1_min_reorder(n: i32, connections: Vec[Vec[i32]]) -> i32 {
    // the roads form a tree, so a walk out of 0 that never steps back to
    // its parent crosses every road once, away from 0
    let mut roads: Vec[Vec[(i32, bool)]] = Vec.filled(n, Vec.new());
    for c in connections.iter() {
        roads[c[0]].push((c[1], true));
        roads[c[1]].push((c[0], false));
    }
    a1_turns(roads, 0, -1)
}

// ---- min_reorder_stack.kara ----
fn a2_min_reorder(n: i32, connections: Vec[Vec[i32]]) -> i32 {
    // the neighbours of each city, and the roads as given: a step from
    // `city` to `next` along a road given as `city -> next` leads away
    // from 0, so it must be turned
    let mut near: Vec[Vec[i32]] = Vec.filled(n, Vec.new());
    let mut given: Set[(i32, i32)] = Set.new();
    for c in connections.iter() {
        near[c[0]].push(c[1]);
        near[c[1]].push(c[0]);
        given.insert((c[0], c[1]));
    }
    let mut seen = Vec.filled(n, false);
    let mut stack = [0].to_vec();
    seen[0] = true;
    let mut turned: i32 = 0;
    while let Some(city) = stack.pop() {
        for next in near[city].iter() {
            if not seen[next] {
                seen[next] = true;
                if given.contains((city as i32, next)) {
                    turned += 1;
                }
                stack.push(next);
            }
        }
    }
    turned
}

// ---- min_reorder_sweeps.kara ----
fn a3_min_reorder(n: i32, connections: Vec[Vec[i32]]) -> i32 {
    // a road from a city that reaches 0 into one that does not yet must be
    // turned; a road into a city that reaches 0 already leads there. Each
    // sweep settles every road touching the cities settled so far, and the
    // tree is settled within n sweeps
    let mut reaches = Vec.filled(n, false);
    reaches[0] = true;
    let mut done = Vec.filled(connections.len(), false);
    let mut turned: i32 = 0;
    let mut changed = true;
    while changed {
        changed = false;
        for (i, c) in connections.iter().enumerate() {
            if done[i] {
                continue;
            }
            let (from, to) = (c[0], c[1]);
            if reaches[to] {
                reaches[from] = true;
            } else if reaches[from] {
                reaches[to] = true;
                turned += 1;
            } else {
                continue;
            }
            done[i] = true;
            changed = true;
        }
    }
    turned
}

// ---- min_reorder_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_min_reorder(n: i32, connections: Vec[Vec[i32]]) -> i32 {
        let n = n as i64;
        let mut adj: Vec[Vec[(i64, i32)]] = Vec.filled(n, Vec.new());
        for c in connections.iter() {
            let (a, b) = (c[0] as i64, c[1] as i64);
            adj[a].push((b, 1));
            adj[b].push((a, 0));
        }
        let mut visited = Vec.filled(n, false);
        let mut queue = VecDeque.new();
        visited[0] = true;
        queue.push_back(0);
        let mut ans: i32 = 0;
        while let Some(u) = queue.pop_front() {
            for (v, cost) in ref adj[u] {
                if not visited[v] {
                    visited[v] = true;
                    ans += cost;
                    queue.push_back(v);
                }
            }
        }
        ans
    }
}

fn a4_min_reorder(n: i32, connections: Vec[Vec[i32]]) -> i32 {
    A4Solution.a4_min_reorder(n, connections)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a random tree on n cities, each road's direction drawn at random and the
// roads in a random order
fn tree(seed: mut ref i64, n: i64) -> Vec[Vec[i32]] {
    let mut label: Vec[i32] = (0..n).map(|c| c as i32).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        label.swap(i, j);
    }
    let mut roads: Vec[Vec[i32]] = Vec.new();
    for i in 1..n {
        let p = next_random(mut seed) % i;
        if next_random(mut seed) % 2 == 0 {
            roads.push([label[i], label[p]].to_vec());
        } else {
            roads.push([label[p], label[i]].to_vec());
        }
    }
    shuffled(mut seed, roads)
}

// `values` shuffled
fn shuffled(seed: mut ref i64, values: Vec[Vec[i32]]) -> Vec[Vec[i32]] {
    let mut out = values.clone();
    for i in (1..out.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        out.swap(i, j);
    }
    out
}

// does every city reach 0 along `roads`? Searched backwards from 0 along
// the roads into each city reached
fn all_reach(n: i32, roads: Vec[Vec[i32]]) -> bool {
    let mut reached = Vec.filled(n, false);
    reached[0] = true;
    let mut stack = [0].to_vec();
    while let Some(city) = stack.pop() {
        for r in roads.iter() {
            if r[1] == city and not reached[r[0]] {
                reached[r[0]] = true;
                stack.push(r[0]);
            }
        }
    }
    reached.iter().all(|r| r)
}

// the statement read literally: every set of roads to turn, and the
// fewest whose turning lets every city reach 0
fn literal(n: i32, connections: Vec[Vec[i32]]) -> i32 {
    let m = connections.len();
    let mut best: i32 = m as i32 + 1;
    for set in 0..1 << m {
        let roads: Vec[Vec[i32]] = (0..m)
            .map(|i| if (set >> i) & 1 == 1 { [connections[i][1], connections[i][0]].to_vec() } else { connections[i].clone() })
            .collect();
        let turned = (0..m).filter(|i| (set >> i) & 1 == 1).count() as i32;
        if turned < best and all_reach(n, roads) {
            best = turned;
        }
    }
    best
}

fn arm(i: i64, n: i32, connections: Vec[Vec[i32]]) -> i32 {
    match i {
        0 => a0_min_reorder(n, connections),
        1 => a1_min_reorder(n, connections),
        2 => a2_min_reorder(n, connections),
        3 => a3_min_reorder(n, connections),
        _ => a4_min_reorder(n, connections),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, seed: mut ref i64, n: i32, roads: Vec[Vec[i32]]) {
    t.cases += 1;
    let star = arm(0, n, roads);
    t.check = (t.check * 31 + star) % 1000000007;
    let want = if n <= 8 { Some(literal(n, roads)) } else { None };
    let mixed = shuffled(mut seed, roads);
    let back: Vec[Vec[i32]] = roads.iter().map(|r| [r[1], r[0]].to_vec()).collect();
    // the cities but 0 relabelled at random
    let mut label: Vec[i32] = (0..n).collect();
    for i in (2..n as i64).rev() {
        let j = 1 + next_random(mut seed) % i;
        label.swap(i, j);
    }
    let moved: Vec[Vec[i32]] = roads.iter().map(|r| [label[r[0]], label[r[1]]].to_vec()).collect();
    // one city more, joined to a random city by a road toward it and by
    // one away from it
    let k = (next_random(mut seed) % n) as i32;
    let mut toward = roads.clone();
    toward.push([n, k].to_vec());
    let mut away = roads.clone();
    away.push([k, n].to_vec());
    for i in 0..5 {
        let what = f"arm {i} on {n} cities";
        let got = arm(i, n, roads);
        // P1: the statement read literally, while there are at most 8
        // cities
        if let Some(w) = want {
            expect(mut t, 1, got == w, f"P1 {what}");
        }
        // P2: the roads shuffled give the same answer
        expect(mut t, 2, arm(i, n, mixed) == got, f"P2 {what}");
        // P3: every road turned turns the others: n - 1 less the answer
        expect(mut t, 3, arm(i, n, back) == n - 1 - got, f"P3 {what}");
        // P4: the cities but 0 relabelled give the same answer
        expect(mut t, 4, arm(i, n, moved) == got, f"P4 {what}");
        // P5: one city more, by a road toward the tree, gives the same
        // answer, and by a road away from it one more
        expect(mut t, 5, arm(i, n + 1, toward) == got and arm(i, n + 1, away) == got + 1, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: one road away from 0 and one
    // toward it, 5000 cities in a line each way, 5000 roads out of 0, and a
    // random tree of 5000 cities; the sweeps arm takes up to one sweep a
    // city on a shuffled line, so the constraints' most stays in the
    // harness. Every case is drawn before any arm answers.
    let mut cases: Vec[(i32, Vec[Vec[i32]])] = Vec.new();
    // each list of roads is bound under its type before it is pushed: the
    // literals in a `.to_vec()` pushed in a tuple keep `i64`
    // (B-2026-11-26-6), and so does a range behind a `collect` there
    // (B-2026-11-26-9)
    let e1: Vec[Vec[i32]] = [[0, 1].to_vec(), [1, 3].to_vec(), [2, 3].to_vec(), [4, 0].to_vec(), [4, 5].to_vec()].to_vec();
    let e2: Vec[Vec[i32]] = [[1, 0].to_vec(), [1, 2].to_vec(), [3, 2].to_vec(), [3, 4].to_vec()].to_vec();
    let e3: Vec[Vec[i32]] = [[1, 0].to_vec(), [2, 0].to_vec()].to_vec();
    let e4: Vec[Vec[i32]] = [[0, 1].to_vec()].to_vec();
    let e5: Vec[Vec[i32]] = [[1, 0].to_vec()].to_vec();
    let out: Vec[Vec[i32]] = (0i32..4999).map(|c| [c, c + 1].to_vec()).collect();
    let back: Vec[Vec[i32]] = (0i32..4999).map(|c| [c + 1, c].to_vec()).collect();
    let fan: Vec[Vec[i32]] = (1i32..5000).map(|c| [0, c].to_vec()).collect();
    cases.push((6, e1));
    cases.push((5, e2));
    cases.push((3, e3));
    cases.push((2, e4));
    cases.push((2, e5));
    cases.push((5000, out));
    cases.push((5000, back));
    cases.push((5000, fan));
    let mut seed = 14661;
    cases.push((5000, tree(mut seed, 5000)));
    // 1994 random trees: half of 2 to 8 cities, half of 2 to 60
    for c in 0..1994 {
        let most = if c % 2 == 0 { 7 } else { 59 };
        let n = 2 + next_random(mut seed) % most;
        cases.push((n as i32, tree(mut seed, n)));
    }
    for j in 0..cases.len() {
        let (n, roads) = cases[j].clone();
        check_case(mut t, mut seed, n, roads);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
