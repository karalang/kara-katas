// LeetCode #1462 bench: the ★ arm (the closure of the prerequisites by
// Floyd-Warshall) on 400 cases of 100 courses, the constraints' most, each
// pair of courses a prerequisite one time in 20, and 10^4 queries each,
// all drawn once, folding every answer into the checksum.

fn check_if_prerequisite(num_courses: i32, prerequisites: Vec[Vec[i32]], queries: Vec[Vec[i32]]) -> Vec[bool] {
    let n = num_courses as i64;
    // before[u][v]: u must come before v, by the prerequisites directly and
    // then through each course in turn as a step between (Floyd-Warshall)
    let mut before = Vec.filled(n, Vec.filled(n, false));
    for p in prerequisites.iter() {
        before[p[0]][p[1]] = true;
    }
    for k in 0..n {
        for u in 0..n {
            if before[u][k] {
                for v in 0..n {
                    if before[k][v] {
                        before[u][v] = true;
                    }
                }
            }
        }
    }
    queries.iter().map(|q| before[q[0]][q[1]]).collect()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1462;
    let mut cases: Vec[(Vec[Vec[i32]], Vec[Vec[i32]])] = Vec.new();
    for _ in 0..400 {
        let mut order: Vec[i64] = (0..100).collect();
        for i in (1..100).rev() {
            let j = next_random(mut seed) % (i + 1);
            order.swap(i, j);
        }
        let mut pre: Vec[Vec[i32]] = Vec.new();
        for i in 0..100 {
            for j in i + 1..100 {
                if next_random(mut seed) % 20 == 0 {
                    pre.push([order[i] as i32, order[j] as i32].to_vec());
                }
            }
        }
        let mut qs: Vec[Vec[i32]] = Vec.new();
        while qs.len() < 10000 {
            let u = next_random(mut seed) % 100;
            let v = next_random(mut seed) % 100;
            if u != v {
                qs.push([u as i32, v as i32].to_vec());
            }
        }
        cases.push((pre, qs));
    }
    let mut check: i64 = 0;
    for c in 0..400 {
        let (pre, qs) = cases[c].clone();
        for a in check_if_prerequisite(100, pre, qs).iter() {
            check = (check * 3 + if a { 2 } else { 1 }) % 1000000007;
        }
    }
    println(f"400 cases of 100 courses and 10^4 queries: checksum {check}");
}
