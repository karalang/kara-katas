// LeetCode #1457 bench: the ★ arm (a walk down by recursion, the parity
// of the values on the path carried as a bit mask) on 50 trees of 10^4
// nodes, the constraints' most, with values from 1 to 9, built once: half
// with each node hung on a random empty place, half filled level by level
// with gaps; then 50 passes, each setting one node of every tree from the
// checksum so far, so no answer carries over, answering it and folding the
// count plus the pass into the checksum.

fn pseudo_palindromic_paths(root: Option[TreeNode]) -> i32 {
    paths(root, 0)
}

// the pseudo-palindromic paths through `node`, `seen` with bit v set when
// the value v is on the path above it an odd number of times: at a leaf
// the path can be rearranged into a palindrome when at most one bit is set
fn paths(node: Option[TreeNode], seen: i32) -> i32 {
    let Some(n) = node else {
        return 0;
    };
    let seen = seen ^ (1 << n.val);
    if n.left.is_none() and n.right.is_none() {
        return if seen & (seen - 1) == 0 { 1 } else { 0 };
    }
    paths(n.left, seen) + paths(n.right, seen)
}

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n nodes, every one also kept in `nodes` so that a pass can change it
fn build(seed: mut ref i64, n: i64, level_order: bool, nodes: mut ref Vec[TreeNode]) {
    let root = TreeNode { val: (1 + next_random(mut seed) % 9) as i32, left: None, right: None };
    nodes.push(root);
    if level_order {
        let mut level: VecDeque[TreeNode] = VecDeque.new();
        level.push_back(root);
        while nodes.len() < n {
            let at = level.pop_front().unwrap();
            for side in 0..2 {
                if nodes.len() < n and next_random(mut seed) % 4 != 0 {
                    let node = TreeNode { val: (1 + next_random(mut seed) % 9) as i32, left: None, right: None };
                    if side == 0 {
                        at.left = Some(node);
                    } else {
                        at.right = Some(node);
                    }
                    level.push_back(node);
                    nodes.push(node);
                }
            }
            // a node that got no child leaves the walk; keep it going
            if level.len() == 0 {
                level.push_back(at);
            }
        }
    } else {
        let mut places: Vec[(TreeNode, bool)] = [(root, true), (root, false)];
        while nodes.len() < n {
            let k = next_random(mut seed) % places.len();
            let (parent, left) = places.swap_remove(k);
            let node = TreeNode { val: (1 + next_random(mut seed) % 9) as i32, left: None, right: None };
            if left {
                parent.left = Some(node);
            } else {
                parent.right = Some(node);
            }
            places.push((node, true));
            places.push((node, false));
            nodes.push(node);
        }
    }
}

fn main() {
    let n = 10000;
    let mut seed = 1457;
    let mut trees: Vec[Vec[TreeNode]] = Vec.new();
    for t in 0..50 {
        let mut nodes: Vec[TreeNode] = Vec.new();
        build(mut seed, n, t % 2 == 1, mut nodes);
        trees.push(nodes);
    }
    let mut check: i64 = 0;
    for pass in 0..50 {
        for t in 0..50 {
            let nodes = ref trees[t];
            let at = nodes[check % n];
            at.val = (1 + (check / 7) % 9) as i32;
            let found = pseudo_palindromic_paths(Some(nodes[0]));
            check = (check * 31 + found + pass) % 90000007;
        }
    }
    println(f"50 passes over 50 trees of 10^4: checksum {check}");
}
