// LeetCode #1457: Pseudo-Palindromic Paths in a Binary Tree -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- pseudo_palindromic_paths.kara ----
fn a0_pseudo_palindromic_paths(root: Option[TreeNode]) -> i32 {
    a0_paths(root, 0)
}

// the pseudo-palindromic paths through `node`, `seen` with bit v set when
// the value v is on the path above it an odd number of times: at a leaf
// the path can be rearranged into a palindrome when at most one bit is set
fn a0_paths(node: Option[TreeNode], seen: i32) -> i32 {
    let Some(n) = node else {
        return 0;
    };
    let seen = seen ^ (1 << n.val);
    if n.left.is_none() and n.right.is_none() {
        return if seen & (seen - 1) == 0 { 1 } else { 0 };
    }
    a0_paths(n.left, seen) + a0_paths(n.right, seen)
}

// ---- pseudo_palindromic_paths_counts.kara ----
fn a1_pseudo_palindromic_paths(root: Option[TreeNode]) -> i32 {
    let mut counts = [0; 10];
    a1_walk(root, mut counts)
}

// the pseudo-palindromic paths through `node`, `counts[v]` the times the
// value v is on the path above it: each node is counted on the way down and
// taken off on the way back up, and a leaf's path can be rearranged into a
// palindrome when at most one value is there an odd number of times
fn a1_walk(node: Option[TreeNode], counts: mut ref Array[i32, 10]) -> i32 {
    let Some(n) = node else {
        return 0;
    };
    let v = n.val as usize;
    counts[v] += 1;
    let found = if n.left.is_none() and n.right.is_none() {
        let odd = counts.iter().filter(|c| *c % 2 == 1).count();
        if odd <= 1 { 1 } else { 0 }
    } else {
        a1_walk(n.left, mut counts) + a1_walk(n.right, mut counts)
    };
    counts[v] -= 1;
    found
}

// ---- pseudo_palindromic_paths_stack.kara ----
fn a2_pseudo_palindromic_paths(root: Option[TreeNode]) -> i32 {
    let Some(top) = root else {
        return 0;
    };
    // each node waiting on the stack with the parity of the values on the
    // path to it, itself included
    let mut stack: Vec[(TreeNode, i32)] = [(top, 1 << top.val)];
    let mut found = 0;
    while let Some((node, seen)) = stack.pop() {
        match (node.left, node.right) {
            (None, None) => {
                if seen & (seen - 1) == 0 {
                    found += 1;
                }
            }
            (left, right) => {
                if let Some(l) = left {
                    stack.push((l, seen ^ (1 << l.val)));
                }
                if let Some(r) = right {
                    stack.push((r, seen ^ (1 << r.val)));
                }
            }
        }
    }
    found
}

// ---- pseudo_palindromic_paths_queue.kara ----
fn a3_pseudo_palindromic_paths(root: Option[TreeNode]) -> i32 {
    // level by level, each node queued with the parity of the values on the
    // path above it
    let mut queue: VecDeque[(Option[TreeNode], u32)] = VecDeque.new();
    queue.push_back((root, 0));
    let mut found: i32 = 0;
    while let Some((next, above)) = queue.pop_front() {
        let Some(node) = next else {
            continue;
        };
        let seen = above ^ (1u32 << node.val as u32);
        if node.left.is_none() and node.right.is_none() {
            found += (seen.count_ones() <= 1) as i32;
        } else {
            queue.push_back((node.left, seen));
            queue.push_back((node.right, seen));
        }
    }
    found
}

// ---- pseudo_palindromic_paths_solution.kara ----
struct A4Solution {}

fn a4_dfs(node: Option[TreeNode], mask: i32) -> i32 {
    if let Some(n) = node {
        let mask = mask ^ (1 << n.val);
        if n.left.is_none() and n.right.is_none() {
            return if mask & (mask - 1) == 0 { 1 } else { 0 };
        }
        a4_dfs(n.left, mask) + a4_dfs(n.right, mask)
    } else {
        0
    }
}

impl A4Solution {
    pub fn a4_pseudo_palindromic_paths(root: Option[TreeNode]) -> i32 {
        a4_dfs(root, 0)
    }
}

fn a4_pseudo_palindromic_paths(root: Option[TreeNode]) -> i32 {
    A4Solution.a4_pseudo_palindromic_paths(root)
}
// ---- the differential -------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// LeetCode's level-order list, `None` for a missing child
fn from_level(values: Vec[Option[i32]]) -> Option[TreeNode] {
    if values.len() == 0 or values[0].is_none() {
        return None;
    }
    let root = TreeNode { val: values[0].unwrap(), left: None, right: None };
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    queue.push_back(root);
    let mut i = 1;
    while i < values.len() {
        let Some(node) = queue.pop_front() else {
            break;
        };
        if let Some(v) = values[i] {
            let child = TreeNode { val: v, left: None, right: None };
            node.left = Some(child);
            queue.push_back(child);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let child = TreeNode { val: v, left: None, right: None };
                node.right = Some(child);
                queue.push_back(child);
            }
            i += 1;
        }
    }
    Some(root)
}

// n nodes with values from 1 to top, each hung on an empty child place of
// the tree so far chosen at random
fn random_tree(seed: mut ref i64, n: i64, top: i64) -> Option[TreeNode] {
    let root = TreeNode { val: (1 + next_random(mut seed) % top) as i32, left: None, right: None };
    let mut places: Vec[(TreeNode, bool)] = [(root, true), (root, false)];
    for _ in 1..n {
        let k = next_random(mut seed) % places.len();
        let (parent, left) = places.swap_remove(k);
        let node = TreeNode { val: (1 + next_random(mut seed) % top) as i32, left: None, right: None };
        if left {
            parent.left = Some(node);
        } else {
            parent.right = Some(node);
        }
        places.push((node, true));
        places.push((node, false));
    }
    Some(root)
}

// a chain of n nodes, each the left child of the one before, the i-th
// valued i * step % 9 + 1
fn chain(n: i64, step: i64) -> Option[TreeNode] {
    let mut tree: Option[TreeNode] = None;
    for i in (0..n).rev() {
        tree = Some(TreeNode { val: (i * step % 9 + 1) as i32, left: tree, right: None });
    }
    tree
}


// how many leaves
fn leaves(node: Option[TreeNode]) -> i64 {
    match node {
        Some(n) => if n.left.is_none() and n.right.is_none() { 1 } else { leaves(n.left) + leaves(n.right) },
        None => 0,
    }
}

// true when every value is `v`
fn all_of(node: Option[TreeNode], v: i32) -> bool {
    match node {
        Some(n) => n.val == v and all_of(n.left, v) and all_of(n.right, v),
        None => true,
    }
}

// how many nodes
fn size(node: Option[TreeNode]) -> i64 {
    match node {
        Some(n) => 1 + size(n.left) + size(n.right),
        None => 0,
    }
}

// a new tree, each node's children swapped
fn mirrored(node: Option[TreeNode]) -> Option[TreeNode] {
    let Some(n) = node else {
        return None;
    };
    Some(TreeNode { val: n.val, left: mirrored(n.right), right: mirrored(n.left) })
}

// a new tree, each value v renamed v % 9 + 1
fn renamed(node: Option[TreeNode]) -> Option[TreeNode] {
    let Some(n) = node else {
        return None;
    };
    Some(TreeNode { val: n.val % 9 + 1, left: renamed(n.left), right: renamed(n.right) })
}

// a palindrome made of `values`, when there is one: the values sorted,
// each run of equal ones paired off into the first half, and at most one
// left over for the middle
fn palindrome_of(values: Vec[i32]) -> Option[Vec[i32]] {
    let mut sorted = values.clone();
    sorted.sort();
    let mut half: Vec[i32] = Vec.new();
    let mut middle: Vec[i32] = Vec.new();
    let mut i = 0;
    while i < sorted.len() {
        if i + 1 < sorted.len() and sorted[i] == sorted[i + 1] {
            half.push(sorted[i]);
            i += 2;
        } else {
            middle.push(sorted[i]);
            i += 1;
        }
    }
    if middle.len() > 1 {
        return None;
    }
    let mut made = half.clone();
    made.extend(middle);
    for j in (0..half.len()).rev() {
        made.push(half[j]);
    }
    Some(made)
}

// the statement read literally: every path from the root to a leaf, kept
// when some rearrangement of its values reads the same both ways, the
// rearrangement made and both checked
fn literal(root: Option[TreeNode]) -> i64 {
    let mut found = 0;
    let mut paths: Vec[(TreeNode, Vec[i32])] = Vec.new();
    if let Some(r) = root {
        paths.push((r, [r.val].to_vec()));
    }
    while let Some((node, path)) = paths.pop() {
        if node.left.is_none() and node.right.is_none() {
            if let Some(made) = palindrome_of(path) {
                let backwards: Vec[i32] = made.iter().rev().collect();
                let mut a = made.clone();
                a.sort();
                let mut b = path.clone();
                b.sort();
                if backwards == made and a == b {
                    found += 1;
                }
            }
        }
        for child in [node.left, node.right] {
            if let Some(c) = child {
                let mut longer = path.clone();
                longer.push(c.val);
                paths.push((c, longer));
            }
        }
    }
    found
}

fn arm(i: i64, root: Option[TreeNode]) -> i64 {
    match i {
        0 => a0_pseudo_palindromic_paths(root),
        1 => a1_pseudo_palindromic_paths(root),
        2 => a2_pseudo_palindromic_paths(root),
        3 => a3_pseudo_palindromic_paths(root),
        _ => a4_pseudo_palindromic_paths(root),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, root: Option[TreeNode]) {
    t.cases += 1;
    let star = arm(0, root);
    t.check = (t.check * 131 + star) % 1000000007;
    let n = size(root);
    let want = if n <= 300 { Some(literal(root)) } else { None };
    let mirror = mirrored(root);
    let rename = renamed(root);
    let top = TreeNode { val: 9, left: None, right: None };
    let raised = Some(TreeNode { val: 9, left: Some(top), right: None });
    top.right = root;
    let ends = leaves(root);
    let one_value = match root {
        Some(r) => all_of(root, r.val),
        None => true,
    };
    for i in 0..5 {
        let what = f"arm {i} on {n} nodes";
        let got = arm(i, root);
        // P1: the statement read literally, while there are at most 300
        // nodes
        if let Some(w) = want {
            expect(mut t, 1, got == w, f"P1 {what}");
        }
        // P2: each node's children swapped gives the same count
        expect(mut t, 2, arm(i, mirror) == got, f"P2 {what}");
        // P3: the values renamed, v to v % 9 + 1, gives the same count
        expect(mut t, 3, arm(i, rename) == got, f"P3 {what}");
        // P4: two new nodes valued 9 above the root give the same count
        expect(mut t, 4, arm(i, raised) == got, f"P4 {what}");
        // P5: from 0 to the leaves, and every leaf when the tree has one
        // value
        expect(mut t, 5, got >= 0 and got <= ends and (not one_value or got == ends), f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: one node, and two and three nodes
    // with values equal and not; a chain of 10^4 nodes all valued 1 and one
    // cycling through 1 to 9, a full tree of 2^16 - 1 nodes cycling by level
    // and all one value, and the constraints' most. Every case is drawn
    // before any arm answers.
    let mut cases: Vec[Option[TreeNode]] = [
        from_level([Some(2), Some(3), Some(1), Some(3), Some(1), None, Some(1)]),
        from_level([Some(2), Some(1), Some(1), Some(1), Some(3), None, None, None, None, None, Some(1)]),
        from_level([Some(9)]),
        from_level([Some(1)]),
        from_level([Some(1), Some(1)]),
        from_level([Some(1), None, Some(2)]),
        from_level([Some(1), Some(2), Some(2)]),
        from_level([Some(1), Some(1), Some(2)]),
        from_level([Some(5), Some(5), Some(5), Some(5)]),
    ];
    cases.push(chain(10000, 0));
    cases.push(chain(10000, 1));
    let cycling: Vec[Option[i32]] = (0..65535).map(|i| Some((i % 9 + 1) as i32)).collect();
    cases.push(from_level(cycling));
    let same: Vec[Option[i32]] = (0..65535).map(|_| Some(4)).collect();
    cases.push(from_level(same));
    let mut seed = 14571;
    cases.push(random_tree(mut seed, 100000, 9));
    // 1989 random trees of 1 to 300 nodes with values from 1 to top, top
    // from 1 to 9
    for _ in 0..1989 {
        let n = 1 + next_random(mut seed) % 300;
        let top = 1 + next_random(mut seed) % 9;
        cases.push(random_tree(mut seed, n, top));
    }
    for j in 0..cases.len() {
        let root = cases[j];
        check_case(mut t, root);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
