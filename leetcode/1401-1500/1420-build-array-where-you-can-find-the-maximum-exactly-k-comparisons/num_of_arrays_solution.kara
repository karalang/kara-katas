// LeetCode #1420: Build Array Where You Can Find The Maximum Exactly K
// Comparisons -- a Rust solution as LeetCode's Rust users write it: `const
// MOD`, `n`, `m` and `k` as `usize`, a `vec![vec![vec![0i64; k + 1]; m +
// 1]; n + 1]` table, and the new largest summed over every smaller one in
// an inner loop, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn num_of_arrays(n: i32, m: i32, k: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let (n, m, k) = (n as i64, m as i64, k as i64);
        if k == 0 {
            return 0;
        }
        let mut dp = Vec.filled(n + 1, Vec.filled(m + 1, Vec.filled(k + 1, 0)));
        for j in 1..=m {
            dp[1][j][1] = 1;
        }
        for i in 2..=n {
            for j in 1..=m {
                for c in 1..=k {
                    let mut val = dp[i - 1][j][c] * j % MOD;
                    for p in 1..j {
                        val = (val + dp[i - 1][p][c - 1]) % MOD;
                    }
                    dp[i][j][c] = val;
                }
            }
        }
        let mut ans = 0;
        for j in 1..=m {
            ans = (ans + dp[n][j][k]) % MOD;
        }
        ans as i32
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, and five more
    let firsts: Vec[String] = [(2, 3, 1), (5, 2, 3), (9, 1, 1), (1, 1, 1), (1, 5, 0), (3, 3, 3), (4, 2, 2), (50, 100, 25)]
        .iter()
        .map(|(n, m, k)| f"{Solution.num_of_arrays(n, m, k)}")
        .collect();
    println(firsts.join(" "));
    // the constraints' most: n = 50 and m = 100, with k = 1, 2 and 50
    println(f"n = 50, m = 100: {Solution.num_of_arrays(50, 100, 1)} {Solution.num_of_arrays(50, 100, 2)} {Solution.num_of_arrays(50, 100, 50)}");
    // 2000 random cases: n up to 12, m up to 30, k up to n
    let mut seed = 1420;
    let mut check: i64 = 0;
    let mut zero = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 12;
        let m = 1 + next_random(mut seed) % 30;
        let k = next_random(mut seed) % (n + 1);
        let got = Solution.num_of_arrays(n as i32, m as i32, k as i32);
        if got == 0 {
            zero += 1;
        }
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random cases: {zero} with no array, checksum {check}");
}
