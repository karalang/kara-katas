fn num_of_arrays(n: i32, m: i32, k: i32) -> i32 {
    // ways[j][c]: the arrays so far whose largest is j and whose search
    // cost is c. One element more is at most the largest, j ways, or a new
    // largest, which costs one search more: the arrays of cost c - 1 whose
    // largest is below j, summed as j climbs
    let modulus: i64 = 1000000007;
    let m = m as i64;
    let k = k as i64;
    let mut ways: Vec[Vec[i64]] = Vec.filled(m + 1, Vec.filled(k + 1, 0));
    if k >= 1 {
        for j in 1..=m {
            ways[j][1] = 1;
        }
    }
    for _ in 1..n {
        let mut next: Vec[Vec[i64]] = Vec.filled(m + 1, Vec.filled(k + 1, 0));
        for c in 1..=k {
            let mut below: i64 = 0;
            for j in 1..=m {
                next[j][c] = (ways[j][c] * j + below) % modulus;
                below = (below + ways[j][c - 1]) % modulus;
            }
        }
        ways = next;
    }
    let mut total: i64 = 0;
    for j in 1..=m {
        total = (total + ways[j][k]) % modulus;
    }
    total as i32
}

fn main() {
    // 1000 searches at the constraints' most, n = 50 and m = 100, each
    // with k drawn from 0 to 50
    let mut seed: i64 = 1420;
    let mut check: i64 = 0;
    for _ in 0..1000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let k = seed / 65536 % 51;
        check = (check * 131 + num_of_arrays(50, 100, k as i32)) % 1000000007;
    }
    println(f"1000 values of k at n = 50, m = 100: checksum {check}");
}
