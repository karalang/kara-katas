fn count(left: i64, largest: i64, cost: i64, m: i64, memo: mut ref Vec[Vec[Vec[i64]]]) -> i64 {
    // the ways to fill `left` more places after a prefix whose largest is
    // `largest` and which has cost the search `cost` more than allowed
    // short of k: each next element at most the largest, or a new largest
    if cost < 0 {
        return 0;
    }
    if left == 0 {
        return if cost == 0 { 1 } else { 0 };
    }
    if memo[left][largest][cost] >= 0 {
        return memo[left][largest][cost];
    }
    let modulus: i64 = 1000000007;
    let mut ways = largest * count(left - 1, largest, cost, m, mut memo) % modulus;
    for next in largest + 1..=m {
        ways = (ways + count(left - 1, next, cost - 1, m, mut memo)) % modulus;
    }
    memo[left][largest][cost] = ways;
    ways
}

fn num_of_arrays(n: i32, m: i32, k: i32) -> i32 {
    // a recursion on what is left to fill, from an empty prefix whose
    // largest is 0, each answer kept once found
    let mut memo: Vec[Vec[Vec[i64]]] = Vec.filled(n as i64 + 1, Vec.filled(m as i64 + 1, Vec.filled(k as i64 + 1, -1)));
    count(n, 0, k, m, mut memo) as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, and five more
    let firsts: Vec[String] = [(2, 3, 1), (5, 2, 3), (9, 1, 1), (1, 1, 1), (1, 5, 0), (3, 3, 3), (4, 2, 2), (50, 100, 25)]
        .iter()
        .map(|(n, m, k)| f"{num_of_arrays(n, m, k)}")
        .collect();
    println(firsts.join(" "));
    // the constraints' most: n = 50 and m = 100, with k = 1, 2 and 50
    println(f"n = 50, m = 100: {num_of_arrays(50, 100, 1)} {num_of_arrays(50, 100, 2)} {num_of_arrays(50, 100, 50)}");
    // 2000 random cases: n up to 12, m up to 30, k up to n
    let mut seed = 1420;
    let mut check: i64 = 0;
    let mut zero = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 12;
        let m = 1 + next_random(mut seed) % 30;
        let k = next_random(mut seed) % (n + 1);
        let got = num_of_arrays(n as i32, m as i32, k as i32);
        if got == 0 {
            zero += 1;
        }
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random cases: {zero} with no array, checksum {check}");
}
