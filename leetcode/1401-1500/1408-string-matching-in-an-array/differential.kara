// LeetCode #1408: String Matching in an Array -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- string_matching.kara ----
fn a0_string_matching(words: Vec[String]) -> Vec[String] {
    // every word some other word contains
    words.iter().filter(|w| words.iter().any(|other| other != w and other.contains(w))).cloned().collect()
}

// ---- string_matching_sorted.kara ----
fn a1_string_matching(words: Vec[String]) -> Vec[String] {
    // shortest first: only a longer word can hold a word, so each is tried
    // against those after it
    let mut order = words.clone();
    order.sort_by_key(|w| w.len());
    let mut found = Vec.new();
    for i in 0..order.len() {
        for j in i + 1..order.len() {
            if order[j].len() > order[i].len() and order[j].contains(order[i].as_str()) {
                found.push(order[i].clone());
                break;
            }
        }
    }
    found
}

// ---- string_matching_joined.kara ----
fn a2_string_matching(words: Vec[String]) -> Vec[String] {
    // all the words in one text, a space between them: a word is in itself
    // once, so it is in another word when the text holds it twice
    let text = words.join(" ");
    let mut found = Vec.new();
    for w in words.iter() {
        if text.matches(w.as_str()).count() >= 2 {
            found.push(w.clone());
        }
    }
    found
}

// ---- string_matching_trie.kara ----
struct A3Node {
    next: Map[char, i64],
    words: i64,
    last: i64,
}

fn a3_string_matching(words: Vec[String]) -> Vec[String] {
    let mut nodes: Vec[A3Node] = Vec.new();
    nodes.push(A3Node { next: Map.new(), words: 0, last: -1 });
    for (k, w) in words.iter().enumerate() {
        let chars: Vec[char] = w.chars().collect();
        for start in 0..chars.len() {
            let mut at = 0;
            for c in chars[start..].iter() {
                at = match nodes[at].next.get(c) {
                    Some(n) => n,
                    None => {
                        nodes.push(A3Node { next: Map.new(), words: 0, last: -1 });
                        let n = nodes.len() - 1;
                        nodes[at].next.insert(c, n);
                        n
                    }
                };
                // counted once for each word, however many of its
                // suffixes pass
                if nodes[at].last != k {
                    nodes[at].last = k;
                    nodes[at].words += 1;
                }
            }
        }
    }
    let mut found = Vec.new();
    for w in words.iter() {
        let mut at = 0;
        for c in w.chars() {
            at = nodes[at].next.get(c).unwrap();
        }
        if nodes[at].words >= 2 {
            found.push(w.clone());
        }
    }
    found
}

// ---- string_matching_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_string_matching(words: Vec[String]) -> Vec[String] {
        let mut res = Vec.new();
        for (i, w) in words.iter().enumerate() {
            for (j, other) in words.iter().enumerate() {
                if i != j and other.contains(w.as_str()) {
                    res.push(w.clone());
                    break;
                }
            }
        }
        res
    }
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n different words of 1 to len letters from the first `letters` of the
// alphabet
fn drawn(n: i64, len: i64, letters: i64, seed: mut ref i64) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    while words.len() < n {
        let size = 1 + next_random(mut seed) % len;
        let word: String = (0..size).map(|_| (b'a' + (next_random(mut seed) % letters) as u8) as char).collect();
        if not words.contains(word) {
            words.push(word);
        }
    }
    words
}

// the statement read literally: a word that is a substring of another
// word, its letters found one by one at some place in that word
fn literal(words: Vec[String]) -> Vec[String] {
    let mut found: Vec[String] = Vec.new();
    for i in 0..words.len() {
        let w: Vec[char] = words[i].chars().collect();
        let mut inside = false;
        for j in 0..words.len() {
            let other: Vec[char] = words[j].chars().collect();
            if i == j or other.len() < w.len() {
                continue;
            }
            for start in 0..other.len() - w.len() + 1 {
                if (0..w.len()).all(|k| other[start + k] == w[k]) {
                    inside = true;
                }
            }
        }
        if inside {
            found.push(words[i].clone());
        }
    }
    found.sort();
    found
}

fn arm(i: i64, words: Vec[String]) -> Vec[String] {
    let words = words.clone();
    let mut found = match i {
        0 => a0_string_matching(words),
        1 => a1_string_matching(words),
        2 => a2_string_matching(words),
        3 => a3_string_matching(words),
        _ => A4Solution.a4_string_matching(words),
    };
    // any order is allowed
    found.sort();
    found
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, words: Vec[String], extra: own String) {
    t.cases += 1;
    let star = arm(0, words);
    for w in star.iter() {
        for c in w.chars() {
            t.check = (t.check * 131 + c as i64) % 1000000007;
        }
        t.check = (t.check * 131 + 1) % 1000000007;
    }
    t.check = (t.check * 131 + words.len()) % 1000000007;
    let want = literal(words);
    let reversed: Vec[String] = words.iter().rev().cloned().collect();
    // a word holding every word: all of them, with a 'z' none has
    let mut with_all = words.clone();
    with_all.push(words.join("") + "z");
    let mut more = words.clone();
    let adds = not words.contains(extra);
    if adds {
        more.push(extra.clone());
    }
    for i in 0..5 {
        let got = arm(i, words);
        let what = f"arm {i} on {words}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: each one of the words, none twice
        let distinct = (1..got.len()).all(|k| got[k - 1] != got[k]);
        expect(mut t, 2, distinct and got.iter().all(|w| words.contains(w)), f"P2 {what}: {got}");
        // P3: the order the words come in does not matter
        let back = arm(i, reversed);
        expect(mut t, 3, back == got, f"P3 {what}: {back} reversed");
        // P4: with a word that holds them all, every word is found, and
        // that one is not
        let all = arm(i, with_all);
        let mut sorted_words = words.clone();
        sorted_words.sort();
        expect(mut t, 4, all == sorted_words, f"P4 {what}: {all} beside the word holding them all");
        // P5: one more word never loses a word found
        if adds {
            let grown = arm(i, more);
            expect(mut t, 5, got.iter().all(|w| grown.contains(w)), f"P5 {what}: {grown} with {extra} more");
        }
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: one word, a chain each in the
    // next, words in each other both ways round, the constraints' most.
    // Every case is drawn before any arm answers.
    let mut cases: Vec[Vec[String]] = Vec.new();
    cases.push(["mass", "as", "hero", "superhero"].to_vec());
    cases.push(["leetcode", "et", "code"].to_vec());
    cases.push(["blue", "green", "bu"].to_vec());
    cases.push(["a"].to_vec());
    cases.push(["a", "aa", "aaa", "aaaa"].to_vec());
    cases.push(["ab", "ba", "aba", "bab"].to_vec());
    cases.push(["abc", "bca", "cab"].to_vec());
    let mut seed = 14081;
    cases.push(drawn(100, 30, 2, mut seed));
    cases.push(drawn(100, 30, 26, mut seed));
    // 1994 random sets: 1 to 12 words of up to 5 letters from 2 or 3, or
    // 13 to 40 of up to 8 letters from 3
    for i in 0..1994 {
        let set = if i % 3 == 2 {
            drawn(13 + next_random(mut seed) % 28, 8, 3, mut seed)
        } else {
            drawn(1 + next_random(mut seed) % 12, 5, 2 + i % 2, mut seed)
        };
        cases.push(set);
    }
    let extras: Vec[String] = (0..cases.len()).map(|_| drawn(1, 6, 3, mut seed)[0].clone()).collect();
    for (k, words) in cases.iter().enumerate() {
        check_case(mut t, words, extras[k].clone());
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
