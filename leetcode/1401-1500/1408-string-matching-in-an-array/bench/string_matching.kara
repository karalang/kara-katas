fn string_matching(words: Vec[String]) -> Vec[String] {
    // every word some other word contains
    words.iter().filter(|w| words.iter().any(|other| other != w and other.contains(w))).cloned().collect()
}

fn main() {
    // a pool of 10^4 words of 1 to 12 letters from 3, then 2000 windows of
    // 100 words in a row
    let mut seed: i64 = 1408;
    let mut pool: Vec[String] = Vec.new();
    for _ in 0..10000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let size = 1 + seed / 65536 % 12;
        let mut word = String.new();
        for _ in 0..size {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            word.push((b'a' + (seed / 65536 % 3) as u8) as char);
        }
        pool.push(word);
    }
    let mut check: i64 = 0;
    for r in 0..2000 {
        let at = (check + r * 7919) % 9901;
        // the window's words, each kept once
        let mut words: Vec[String] = Vec.new();
        for w in pool[at..at + 100].iter() {
            if not words.contains(w) {
                words.push(w.clone());
            }
        }
        let found = string_matching(words);
        let letters: i64 = found.iter().map(|w| w.len()).sum();
        check = (check * 131 + found.len() * 1000 + letters) % 1000000007;
    }
    println(f"2000 windows of 100 words: checksum {check}");
}
