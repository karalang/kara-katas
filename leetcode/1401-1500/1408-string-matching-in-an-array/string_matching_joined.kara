fn string_matching(words: Vec[String]) -> Vec[String] {
    // all the words in one text, a space between them: a word is in itself
    // once, so it is in another word when the text holds it twice
    let text = words.join(" ");
    let mut found = Vec.new();
    for w in words.iter() {
        if text.matches(w.as_str()).count() >= 2 {
            found.push(w.clone());
        }
    }
    found
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n different words of 1 to len letters from the first `letters` of the
// alphabet
fn drawn(n: i64, len: i64, letters: i64, seed: mut ref i64) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    while words.len() < n {
        let size = 1 + next_random(mut seed) % len;
        let word: String = (0..size).map(|_| (b'a' + (next_random(mut seed) % letters) as u8) as char).collect();
        if not words.contains(word) {
            words.push(word);
        }
    }
    words
}

// the answer in order, since any order is allowed
fn shown(words: Vec[String]) -> String {
    let mut found = string_matching(words);
    found.sort();
    f"[{found.join(",")}]"
}

fn main() {
    // LeetCode's three examples, and three more
    println([
        shown(["mass", "as", "hero", "superhero"].to_vec()),
        shown(["leetcode", "et", "code"].to_vec()),
        shown(["blue", "green", "bu"].to_vec()),
        shown(["a"].to_vec()),
        shown(["a", "aa", "aaa", "aaaa"].to_vec()),
        shown(["ab", "ba", "aba", "bab"].to_vec()),
    ].join(" "));
    // the constraints' most: 100 words of up to 30 letters, from 2 letters
    // and from 26
    let mut seed = 1408;
    let two = string_matching(drawn(100, 30, 2, mut seed));
    let many = string_matching(drawn(100, 30, 26, mut seed));
    println(f"100 words: {two.len()} {many.len()}");
    // 2000 random sets of 1 to 20 words of up to 6 letters from 3
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 20;
        let mut found = string_matching(drawn(n, 6, 3, mut seed));
        found.sort();
        total += found.len();
        for w in found.iter() {
            for c in w.chars() {
                check = (check * 131 + c as i64) % 1000000007;
            }
            check = (check * 131 + 1) % 1000000007;
        }
    }
    println(f"2000 random sets: {total} found, checksum {check}");
}
