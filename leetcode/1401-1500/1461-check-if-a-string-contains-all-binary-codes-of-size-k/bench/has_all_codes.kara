// LeetCode #1461 bench: the ★ arm (the last k digits kept as a number, each
// window marked once) on 20 strings of 5 * 10^5 random digits, the
// constraints' most, drawn once; each asked for k from 11 to 20 after one
// digit is flipped at a place chosen from the checksum so far, so no answer
// carries over, folding the answer into the checksum.

fn has_all_codes(s: Str, k: i64) -> bool {
    let need = 1 << k;
    // the last k digits read as a number, each window marked once
    let mut seen: Vec[bool] = Vec.filled(need, false);
    let mut found = 0;
    let mut window = 0;
    for (i, b) in s.bytes().iter().enumerate() {
        window = ((window << 1) | (b - b'0')) & (need - 1);
        if i + 1 >= k and not seen[window] {
            seen[window] = true;
            found += 1;
            if found == need {
                return true;
            }
        }
    }
    false
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1461;
    let mut texts: Vec[Vec[u8]] = Vec.new();
    for _ in 0..20 {
        let digits: Vec[u8] = (0..500000).map(|_| if next_random(mut seed) % 2 == 0 { b'0' } else { b'1' }).collect();
        texts.push(digits);
    }
    let mut check: i64 = 0;
    for t in 0..20 {
        for k in 11..=20 {
            let at = check % 500000;
            texts[t][at] = if texts[t][at] == b'0' { b'1' } else { b'0' };
            let s = String.from_utf8(texts[t].clone()).unwrap();
            let all = has_all_codes(s, k);
            check = (check * 31 + if all { 1 } else { 0 } + k) % 1000000007;
        }
    }
    println(f"20 strings of 5 * 10^5 digits, k from 11 to 20: checksum {check}");
}
