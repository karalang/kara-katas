// LeetCode #1461: Check If a String Contains All Binary Codes of Size K --
// a Rust solution as LeetCode's Rust users write it: every window
// `&s[i..i + k]` put in a `HashSet<&str>` and the set's size compared with
// `1 << k`, `k` taken as an `i32` and cast to `usize`, carried to Kāra by
// `karac fix`

struct Solution {}

impl Solution {
    pub fn has_all_codes(s: String, k: i32) -> bool {
        let k = k as i64;
        if s.len() < k {
            return false;
        }
        let mut set = Set.new();
        for i in 0..=s.len() - k {
            set.insert(s[i..i + k]);
        }
        set.len() == 1 << k
    }
}

fn has_all_codes(s: Str, k: i64) -> bool {
    Solution.has_all_codes(s.to_string(), k as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n binary digits, a 1 one time in `ones` of 8
fn draw(seed: mut ref i64, n: i64, ones: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(if next_random(mut seed) % 8 < ones { '1' } else { '0' });
    }
    s
}

// the de Bruijn sequence of order k, every code of k digits once, by the
// prefer-ones walk: a 1 added whenever the window it makes is new
fn de_bruijn(k: i64) -> String {
    let mut seen: Vec[bool] = Vec.filled(1 << k, false);
    let mut s = "0".repeat(k);
    seen[0] = true;
    let mut window = 0;
    let full = (1 << k) - 1;
    loop {
        let one = ((window << 1) | 1) & full;
        let zero = (window << 1) & full;
        if not seen[one] {
            window = one;
            s.push('1');
        } else if not seen[zero] {
            window = zero;
            s.push('0');
        } else {
            break;
        }
        seen[window] = true;
    }
    s
}

fn main() {
    // LeetCode's three examples, and four more: k of 1 on "0" and "01",
    // and the de Bruijn sequence of order 20, whole and with its last digit
    // cut off
    let e1 = has_all_codes("00110110", 2);
    let e2 = has_all_codes("0110", 1);
    let e3 = has_all_codes("0110", 2);
    let e4 = has_all_codes("0", 1);
    let e5 = has_all_codes("01", 1);
    let whole = de_bruijn(20);
    let cut = whole[..whole.len() - 1].to_string();
    println(f"{e1} {e2} {e3} {e4} {e5} {has_all_codes(whole, 20)} {has_all_codes(cut, 20)} {whole.len()}");
    // the constraints' most, 5 * 10^5 random digits, for k from 1 to 20
    let mut seed = 1461;
    let long = draw(mut seed, 500000, 4);
    let mut most = 0;
    for k in 1..=20 {
        if has_all_codes(long, k) {
            most = k;
        }
    }
    println(f"5 * 10^5 digits: every code up to k = {most}");
    // 3000 random strings of 1 to 400 digits, k from 1 to 8, the ones
    // from 1 to 7 in 8
    let mut yes = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 400;
        let k = 1 + next_random(mut seed) % 8;
        let ones = 1 + next_random(mut seed) % 7;
        let got = has_all_codes(draw(mut seed, n, ones), k);
        if got {
            yes += 1;
        }
        check = (check * 3 + if got { 1 } else { 0 }) % 1000000007;
    }
    println(f"3000 random strings: {yes} with every code, checksum {check}");
}
