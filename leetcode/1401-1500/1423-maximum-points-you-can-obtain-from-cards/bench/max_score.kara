fn max_score(card_points: Slice[i32], k: i32) -> i32 {
    // the first k cards taken, then one at a time the last of those given
    // back for the next card from the far end, the best total kept
    let n = card_points.len();
    let k = k as i64;
    let mut sum: i32 = card_points[..k].iter().sum();
    let mut best = sum;
    for i in 0..k {
        sum += card_points[n - 1 - i] - card_points[k - 1 - i];
        best = best.max(sum);
    }
    best
}

fn main() {
    // a pool of 10^6 cards of 1 to 10^4 points, and 5 * 10^4 windows of 10^5
    // of them, each window's start and its k drawn
    let mut seed: i64 = 1423;
    let mut pool: Vec[i32] = Vec.with_capacity(1000000);
    for _ in 0..1000000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        pool.push((1 + seed / 65536 % 10000) as i32);
    }
    let mut check: i64 = 0;
    for _ in 0..50000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let start = seed / 65536 % 900001;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let k = (1 + seed / 65536 % 100000) as i32;
        check = (check * 131 + max_score(pool[start..start + 100000], k)) % 1000000007;
    }
    println(f"5 * 10^4 windows of 10^5 cards: checksum {check}");
}
