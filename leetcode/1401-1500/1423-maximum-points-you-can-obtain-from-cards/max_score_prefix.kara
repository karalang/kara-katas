fn max_score(card_points: Vec[i32], k: i32) -> i32 {
    // the sums of every prefix, and for each count i taken from the front
    // the k - i from the back read off the same table
    let n = card_points.len();
    let k = k as i64;
    let mut prefix: Vec[i32] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + card_points[i];
    }
    (0..=k).map(|i| prefix[i] + prefix[n] - prefix[n - (k - i)]).max().unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n cards of 1 to `top` points
fn drawn(n: i64, top: i64, seed: mut ref i64) -> Vec[i32] {
    (0..n).map(|_| (1 + next_random(mut seed) % top) as i32).collect()
}

fn main() {
    // LeetCode's three examples, and three more
    let firsts: Vec[String] = [
        max_score([1, 2, 3, 4, 5, 6, 1].to_vec(), 3),
        max_score([2, 2, 2].to_vec(), 2),
        max_score([9, 7, 7, 9, 7, 7, 9].to_vec(), 7),
        max_score([1, 1000, 1].to_vec(), 1),
        max_score([1, 79, 80, 1, 1, 1, 200, 1].to_vec(), 3),
        max_score([100, 40, 17, 9, 73, 75].to_vec(), 3),
    ].iter().map(|x| f"{x}").collect();
    println(firsts.join(" "));
    // the constraints' most: 10^5 cards of 10^4 points all taken, and 10^5
    // drawn cards with k = 1, 5 * 10^4 and 10^5 - 1
    let mut seed = 1423;
    let most: Vec[i32] = Vec.filled(100000, 10000);
    let cards = drawn(100000, 10000, mut seed);
    println(f"10^5 cards: {max_score(most, 100000)} {max_score(cards, 1)} {max_score(cards, 50000)} {max_score(cards, 99999)}");
    // 2000 random cases of 1 to 60 cards of up to 10, 100 or 10^4 points
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 60;
        let top = [10, 100, 10000][next_random(mut seed) % 3];
        let k = 1 + next_random(mut seed) % n;
        let got = max_score(drawn(n, top, mut seed), k as i32);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random cases: {total} in all, checksum {check}");
}
