// LeetCode #1423: Maximum Points You Can Obtain from Cards -- a Rust
// solution as LeetCode's Rust users write it: the cards not taken are a
// window of n - k in the middle, so the total less the least such window,
// slid with `usize` indices, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn max_score(card_points: Vec[i32], k: i32) -> i32 {
        let n = card_points.len();
        let w = n - k;
        let total: i32 = card_points.iter().sum();
        let mut cur: i32 = card_points[..w].iter().sum();
        let mut min = cur;
        for i in w..n {
            cur += card_points[i] - card_points[i - w];
            min = min.min(cur);
        }
        total - min
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n cards of 1 to `top` points
fn drawn(n: i64, top: i64, seed: mut ref i64) -> Vec[i32] {
    (0..n).map(|_| (1 + next_random(mut seed) % top) as i32).collect()
}

fn main() {
    // LeetCode's three examples, and three more
    let firsts: Vec[String] = [
        Solution.max_score([1, 2, 3, 4, 5, 6, 1].to_vec(), 3),
        Solution.max_score([2, 2, 2].to_vec(), 2),
        Solution.max_score([9, 7, 7, 9, 7, 7, 9].to_vec(), 7),
        Solution.max_score([1, 1000, 1].to_vec(), 1),
        Solution.max_score([1, 79, 80, 1, 1, 1, 200, 1].to_vec(), 3),
        Solution.max_score([100, 40, 17, 9, 73, 75].to_vec(), 3),
    ].iter().map(|x| f"{x}").collect();
    println(firsts.join(" "));
    // the constraints' most: 10^5 cards of 10^4 points all taken, and 10^5
    // drawn cards with k = 1, 5 * 10^4 and 10^5 - 1
    let mut seed = 1423;
    let most: Vec[i32] = Vec.filled(100000, 10000);
    let cards = drawn(100000, 10000, mut seed);
    println(f"10^5 cards: {Solution.max_score(most, 100000)} {Solution.max_score(cards, 1)} {Solution.max_score(cards, 50000)} {Solution.max_score(cards, 99999)}");
    // 2000 random cases of 1 to 60 cards of up to 10, 100 or 10^4 points
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 60;
        let top = [10, 100, 10000][next_random(mut seed) % 3];
        let k = 1 + next_random(mut seed) % n;
        let got = Solution.max_score(drawn(n, top, mut seed), k as i32);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random cases: {total} in all, checksum {check}");
}
