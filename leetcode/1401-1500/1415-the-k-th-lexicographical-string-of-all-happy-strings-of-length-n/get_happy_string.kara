fn get_happy_string(n: i32, k: i32) -> String {
    // there are 3 * 2^(n - 1) happy strings: the first letter is the
    // (k - 1) / 2^(n - 1)-th of `abc`, and each letter after it the lower
    // or the higher of the two that differ from the one before, by the
    // bits of what is left of k - 1, highest first
    let per_first: i32 = 1 << (n - 1);
    if k > 3 * per_first {
        return "";
    }
    let letters = ['a', 'b', 'c'];
    let mut rest = k - 1;
    let mut last = letters[rest / per_first];
    rest %= per_first;
    let mut s = String.new();
    s.push(last);
    let mut bit = per_first / 2;
    while bit > 0 {
        let options: Vec[char] = letters.iter().filter(|c| c != last).collect();
        last = options[if rest >= bit { 1 } else { 0 }];
        if rest >= bit {
            rest -= bit;
        }
        s.push(last);
        bit /= 2;
    }
    s
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn shown(s: own String) -> String {
    if s.is_empty() { "-" } else { s }
}

fn main() {
    // LeetCode's three examples, and four more
    let firsts: Vec[String] = [(1, 3), (1, 4), (3, 9), (2, 7), (1, 1), (2, 6), (4, 24)]
        .iter()
        .map(|(n, k)| shown(get_happy_string(n, k)))
        .collect();
    println(firsts.join(" "));
    // the constraints' most: n = 10 and k = 100, and every k for n = 3
    let all: Vec[String] = (1..=13).map(|k| shown(get_happy_string(3, k))).collect();
    println(f"n = 10: {get_happy_string(10, 100)} {get_happy_string(10, 1)} | n = 3: {all.join(" ")}");
    // 2000 random cases of n from 1 to 10 and k from 1 to 100
    let mut seed = 1415;
    let mut check: i64 = 0;
    let mut empty = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 10;
        let k = 1 + next_random(mut seed) % 100;
        let s = get_happy_string(n as i32, k as i32);
        if s.is_empty() {
            empty += 1;
        }
        for b in s.bytes().iter() {
            check = (check * 131 + b as i64) % 1000000007;
        }
        check = (check * 131 + 7) % 1000000007;
    }
    println(f"2000 random cases: {empty} empty, checksum {check}");
}
