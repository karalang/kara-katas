struct Solution {}

impl Solution {
    pub fn get_happy_string(n: i32, k: i32) -> String {
        let total = 3 * (1 << (n - 1));
        if k > total {
            return String.new();
        }
        let mut k = k - 1;
        let mut res = String.new();
        let mut prev = ' ';
        for i in 0..n {
            let block: i32 = 1 << (n - 1 - i);
            let choices: Vec[char] = ['a', 'b', 'c'].iter().filter(|c| c != prev).cloned().collect();
            let idx = (k / block) as usize;
            k %= block;
            prev = choices[idx];
            res.push(prev);
        }
        res
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn shown(s: own String) -> String {
    if s.is_empty() { "-" } else { s }
}

fn main() {
    // LeetCode's three examples, and four more
    let firsts: Vec[String] = [(1, 3), (1, 4), (3, 9), (2, 7), (1, 1), (2, 6), (4, 24)]
        .iter()
        .map(|(n, k)| shown(Solution.get_happy_string(n, k)))
        .collect();
    println(firsts.join(" "));
    // the constraints' most: n = 10 and k = 100, and every k for n = 3
    let all: Vec[String] = (1..=13).map(|k| shown(Solution.get_happy_string(3, k))).collect();
    println(f"n = 10: {Solution.get_happy_string(10, 100)} {Solution.get_happy_string(10, 1)} | n = 3: {all.join(" ")}");
    // 2000 random cases of n from 1 to 10 and k from 1 to 100
    let mut seed = 1415;
    let mut check: i64 = 0;
    let mut empty = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 10;
        let k = 1 + next_random(mut seed) % 100;
        let s = Solution.get_happy_string(n as i32, k as i32);
        if s.is_empty() {
            empty += 1;
        }
        for b in s.bytes().iter() {
            check = (check * 131 + b as i64) % 1000000007;
        }
        check = (check * 131 + 7) % 1000000007;
    }
    println(f"2000 random cases: {empty} empty, checksum {check}");
}
