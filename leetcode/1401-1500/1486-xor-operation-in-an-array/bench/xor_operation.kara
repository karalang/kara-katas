// LeetCode #1486: XOR Operation in an Array -- bench. 2000000 calls, each
// n from 1 to 1000 and start from 0 to 1000 chosen from the checksum so
// far.

fn xor_operation(n: i32, start: i32) -> i32 {
    let mut x: i32 = 0;
    for i in 0..n {
        x ^= start + 2 * i;
    }
    x
}

fn main() {
    let mut check = 0;
    for q in 0..2000000 {
        let n = (1 + (check + q) % 1000) as i32;
        let start = ((check / 7 + q * 13) % 1001) as i32;
        check = (check * 31 + xor_operation(n, start)) % 1000000007;
    }
    println(f"2000000 calls: checksum {check}");
}
