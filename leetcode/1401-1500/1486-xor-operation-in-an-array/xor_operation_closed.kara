// LeetCode #1486: XOR Operation in an Array -- in O(1): every number shares
// start's low bit, which survives when n is odd; the rest, halved, are
// the consecutive s, s + 1, .., s + n - 1 with s = start / 2, whose XOR is
// that of 0..=s + n - 1 against that of 0..=s - 1, each read from x % 4

// the XOR of 0, 1, .., x, for x from -1 up
fn xor_upto(x: i32) -> i32 {
    match x % 4 {
        0 => x,
        1 => 1,
        2 => x + 1,
        _ => 0,
    }
}

fn xor_operation(n: i32, start: i32) -> i32 {
    let s = start / 2;
    let low = start & n & 1;
    2 * (xor_upto(s + n - 1) ^ xor_upto(s - 1)) | low
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's four examples
    println(f"{xor_operation(5, 0)} {xor_operation(4, 3)} {xor_operation(1, 7)} {xor_operation(10, 5)}");
    // the edges: one number, the least and the most start; the most
    // numbers from the least and the most start; an odd start with an even
    // count, and an even start with an odd one
    let edges = [(1, 0), (1, 1000), (1000, 0), (1000, 1000), (6, 7), (7, 6)];
    let shown: Vec[String] = edges.iter().map(|e| f"{xor_operation(e.0, e.1)}").collect();
    println(shown.join(" "));
    // every n from 1 to 1000 from start 999, and every start from 0 to 1000
    // with n 1000, each answer folded into a checksum
    let mut by_n = 0;
    for n in 1..=1000 {
        by_n = (by_n * 31 + xor_operation(n, 999)) % 1000000007;
    }
    let mut by_start = 0;
    for start in 0..=1000 {
        by_start = (by_start * 31 + xor_operation(1000, start)) % 1000000007;
    }
    println(f"every n: checksum {by_n} | every start: checksum {by_start}");
    // 3000 random (n, start), each answer folded into a checksum
    let mut seed = 1486;
    let mut check = 0;
    for _ in 0..3000 {
        let n = (1 + next_random(mut seed) % 1000) as i32;
        let start = (next_random(mut seed) % 1001) as i32;
        check = (check * 31 + xor_operation(n, start)) % 1000000007;
    }
    println(f"3000 random pairs: checksum {check}");
}
