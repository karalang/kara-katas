// LeetCode #1486: XOR Operation in an Array -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- xor_operation.kara ----
fn a0_xor_operation(n: i32, start: i32) -> i32 {
    let mut x: i32 = 0;
    for i in 0..n {
        x ^= start + 2 * i;
    }
    x
}

// ---- xor_operation_reduce.kara ----
fn a1_xor_operation(n: i32, start: i32) -> i32 {
    (0..n).map(|i| start + 2 * i).reduce(|a, b| a ^ b).unwrap()
}

// ---- xor_operation_closed.kara ----
fn a2_xor_upto(x: i32) -> i32 {
    match x % 4 {
        0 => x,
        1 => 1,
        2 => x + 1,
        _ => 0,
    }
}

fn a2_xor_operation(n: i32, start: i32) -> i32 {
    let s = start / 2;
    let low = start & n & 1;
    2 * (a2_xor_upto(s + n - 1) ^ a2_xor_upto(s - 1)) | low
}

// ---- xor_operation_bits.kara ----
fn a3_xor_operation(n: i32, start: i32) -> i32 {
    let mut x = 0;
    for bit in 0..12 {
        let mut ones = 0;
        for i in 0..n {
            if (start + 2 * i) >> bit & 1 == 1 {
                ones += 1;
            }
        }
        if ones % 2 == 1 {
            x |= 1 << bit;
        }
    }
    x
}

// ---- xor_operation_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn xor_operation(n: i32, start: i32) -> i32 {
        (0..n).fold(0, |acc, i| acc ^ (start + 2 * i))
    }
}

fn a4_xor_operation(n: i32, start: i32) -> i32 {
    A4Solution.xor_operation(n, start)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: the array built, then its XOR
fn literal(n: i32, start: i32) -> i32 {
    let mut nums: Vec[i32] = Vec.new();
    for i in 0..n {
        nums.push(start + 2 * i);
    }
    let mut x = nums[0];
    for j in 1..nums.len() {
        x = x ^ nums[j];
    }
    x
}

fn arm(i: i64, n: i32, start: i32) -> i32 {
    match i {
        0 => a0_xor_operation(n, start),
        1 => a1_xor_operation(n, start),
        2 => a2_xor_operation(n, start),
        3 => a3_xor_operation(n, start),
        _ => a4_xor_operation(n, start),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, n: i32, start: i32) {
    t.cases += 1;
    let star = arm(0, n, start);
    t.check = (t.check * 31 + star) % 1000000007;
    let want = literal(n, start);
    for i in 0..5 {
        let what = f"arm {i} on n {n}, start {start}";
        let got = arm(i, n, start);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: one number more XORs in start + 2n
        expect(mut t, 2, arm(i, n + 1, start) == got ^ (start + 2 * n), f"P2 {what}");
        // P3: the same count from start + 2 differs by start and start + 2n
        expect(mut t, 3, (got ^ arm(i, n, start + 2)) == start ^ (start + 2 * n), f"P3 {what}");
        // P4: one number is itself, and two are their XOR
        expect(mut t, 4, arm(i, 1, start) == start and arm(i, 2, start) == start ^ (start + 2), f"P4 {what}");
        // P5: the low bit is start's, kept when n is odd
        expect(mut t, 5, got & 1 == start & n & 1, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[(i32, i32)] = [(5, 0), (4, 3), (1, 7), (10, 5), (1, 0), (1, 1000), (1000, 0), (1000, 1000), (6, 7), (7, 6)].to_vec();
    let mut seed = 14861;
    // 1990 random pairs: half of n from 1 to 20 and start from 0 to 30,
    // half of n from 1 to 1000 and start from 0 to 1000
    for c in 0..1990 {
        let (most, top) = if c % 2 == 0 { (20, 31) } else { (1000, 1001) };
        let n = (1 + next_random(mut seed) % most) as i32;
        cases.push((n, (next_random(mut seed) % top) as i32));
    }
    for (n, start) in cases.iter() {
        check_case(mut t, n, start);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
