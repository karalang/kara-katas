// LeetCode #1439: Find the Kth Smallest Sum of a Matrix With Sorted Rows -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- kth_smallest.kara ----
fn a0_kth_smallest(mat: Vec[Vec[i32]], k: i32) -> i32 {
    // the k smallest sums of the rows so far, each next row added to every
    // one of them, the new sums sorted and cut back to k: a sum among the
    // k smallest of all the rows comes from one among the k smallest of
    // the rows before
    let mut sums: Vec[i32] = [0].to_vec();
    for row in mat.iter() {
        let mut next: Vec[i32] = Vec.new();
        for s in sums.iter() {
            for x in row.iter() {
                next.push(s + x);
            }
        }
        next.sort();
        next.truncate(k);
        sums = next;
    }
    sums[k - 1]
}

// ---- kth_smallest_heap.kara ----
fn a1_smallest_pairs(a: Vec[i32], b: Vec[i32], k: i64) -> Vec[i32] {
    let mut heap: PriorityQueue[(i32, i64, i64)] = PriorityQueue.new();
    for i in 0..a.len().min(k) {
        heap.push((a[i] + b[0], i, 0));
    }
    let mut out: Vec[i32] = Vec.new();
    while out.len() < k {
        let Some((sum, i, j)) = heap.pop() else {
            break;
        };
        out.push(sum);
        if j + 1 < b.len() {
            heap.push((a[i] + b[j + 1], i, j + 1));
        }
    }
    out
}

fn a1_kth_smallest(mat: Vec[Vec[i32]], k: i32) -> i32 {
    // the rows taken in one at a time, each time the k smallest sums of the
    // sums so far and the next row, by a heap over the two
    let mut sums: Vec[i32] = mat[0].iter().take(k).cloned().collect();
    for row in mat[1..].iter() {
        sums = a1_smallest_pairs(sums, row, k);
    }
    sums[k - 1]
}

// ---- kth_smallest_search.kara ----
fn a2_count_within(mat: Vec[Vec[i32]], r: i64, room: i64, enough: i64) -> i64 {
    if r == mat.len() {
        return 1;
    }
    let mut count = 0;
    for x in mat[r].iter() {
        // each row sorted, so the rest of it is too large as well
        if x - mat[r][0] > room {
            break;
        }
        count += a2_count_within(mat, r + 1, room - (x - mat[r][0]), enough - count);
        if count >= enough {
            return count;
        }
    }
    count
}

fn a2_kth_smallest(mat: Vec[Vec[i32]], k: i32) -> i32 {
    // the answer searched for by halves between the smallest sum and the
    // largest: the least sum with at least k sums at or below it, each
    // count found by a search that stops at k
    let low_sum: i64 = mat.iter().map(|row| row[0]).sum();
    let high_sum: i64 = mat.iter().map(|row| row[row.len() - 1]).sum();
    let mut (low, high) = (low_sum, high_sum);
    while low < high {
        let mid = (low + high) / 2;
        if a2_count_within(mat, 0, mid - low_sum, k) >= k {
            high = mid;
        } else {
            low = mid + 1;
        }
    }
    low as i32
}

// ---- kth_smallest_states.kara ----
fn a3_kth_smallest(mat: Vec[Vec[i32]], k: i32) -> i32 {
    // the sums met in order from the smallest, each a choice of a place in
    // every row: a heap of choices by their sums, each one popped leading
    // on to the choices with one place moved on, a set keeping each choice
    // to one visit
    let mut heap: PriorityQueue[(i32, Vec[i64])] = PriorityQueue.new();
    let mut seen: Set[Vec[i64]] = Set.new();
    let first: Vec[i64] = Vec.filled(mat.len(), 0);
    heap.push((mat.iter().map(|row| row[0]).sum(), first.clone()));
    seen.insert(first);
    for _ in 1..k {
        let (sum, places) = heap.pop().unwrap();
        for r in 0..mat.len() {
            if places[r] + 1 < mat[r].len() {
                let mut moved = places.clone();
                moved[r] += 1;
                if not seen.contains(moved) {
                    seen.insert(moved.clone());
                    heap.push((sum - mat[r][places[r]] + mat[r][moved[r]], moved));
                }
            }
        }
    }
    heap.peek().unwrap().0
}

// ---- kth_smallest_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_kth_smallest(mat: Vec[Vec[i32]], k: i32) -> i32 {
        let k = k as i64;
        let mut cur = [0i32];
        for row in mat.iter() {
            let mut next = Vec.with_capacity(cur.len() * row.len());
            for a in cur.iter() {
                for b in row.iter() {
                    next.push(a + b);
                }
            }
            next.sort();
            next.truncate(k);
            cur = next;
        }
        cur[k - 1]
    }
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// m rows of n numbers of 1 to `top`, each row sorted
fn drawn(m: i64, n: i64, top: i64, seed: mut ref i64) -> Vec[Vec[i32]] {
    let mut mat: Vec[Vec[i32]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i32] = (0..n).map(|_| (1 + next_random(mut seed) % top) as i32).collect();
        row.sort();
        mat.push(row);
    }
    mat
}

// how many sums there are, n to the m, as far as `most`
fn sums_up_to(mat: Vec[Vec[i32]], most: i64) -> i64 {
    let mut count = 1;
    for row in mat.iter() {
        count = (count * row.len()).min(most);
    }
    count
}

// the statement read literally: every array made of one number from
// each row, its sum, all of them sorted, and the k-th
fn literal(mat: Vec[Vec[i32]], k: i32) -> i64 {
    let mut sums: Vec[i64] = [0].to_vec();
    for row in mat.iter() {
        let mut next: Vec[i64] = Vec.new();
        for s in sums.iter() {
            for x in row.iter() {
                next.push(s + x);
            }
        }
        sums = next;
    }
    sums.sort();
    sums[k - 1]
}

fn arm(i: i64, mat: Vec[Vec[i32]], k: i32) -> i64 {
    let mat = mat.clone();
    match i {
        0 => a0_kth_smallest(mat, k),
        1 => a1_kth_smallest(mat, k),
        2 => a2_kth_smallest(mat, k),
        3 => a3_kth_smallest(mat, k),
        _ => A4Solution.a4_kth_smallest(mat, k),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, mat: Vec[Vec[i32]], k: i32) {
    t.cases += 1;
    let star = arm(0, mat, k);
    t.check = (t.check * 131 + star) % 1000000007;
    let m = mat.len();
    let count = sums_up_to(mat, 200);
    let want = if sums_up_to(mat, 50001) <= 50000 { Some(literal(mat, k)) } else { None };
    let reversed: Vec[Vec[i32]] = mat.iter().rev().cloned().collect();
    let mut raised = mat.clone();
    for x in raised[0].iter_mut() {
        *x += 7;
    }
    let mut longer = mat.clone();
    let one: Vec[i32] = [1].to_vec();
    longer.push(one);
    let firsts: i64 = mat.iter().map(|row| row[0]).sum();
    for i in 0..5 {
        let what = f"arm {i} on {m} rows, k = {k}";
        let got = arm(i, mat, k);
        // P1: the statement read literally, while there are at most 50000
        // sums
        if let Some(w) = want {
            expect(mut t, 1, got == w, f"P1 {what}");
        }
        // P2: the rows in the other order give the same sum
        expect(mut t, 2, arm(i, reversed, k) == got, f"P2 {what}");
        // P3: k = 1 gives the first numbers' sum, and k one more never less
        let next = if k < count { arm(i, mat, k + 1) >= got } else { true };
        expect(mut t, 3, arm(i, mat, 1) == firsts and next, f"P3 {what}");
        // P4: every number of the first row 7 more gives 7 more
        expect(mut t, 4, arm(i, raised, k) == got + 7, f"P4 {what}");
        // P5: a row more of one 1 gives 1 more
        expect(mut t, 5, arm(i, longer, k) == got + 1, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: one number, one row, one column,
    // and the largest numbers in every other place; and the constraints'
    // most three ways. Every case is drawn before any arm answers.
    let mut cases: Vec[(Vec[Vec[i32]], i32)] = [
        ([[1, 3, 11], [2, 4, 6]], 5),
        ([[1, 3, 11], [2, 4, 6]], 9),
        ([[1, 10, 10], [1, 4, 5], [2, 3, 6]], 7),
        ([[1, 1, 10], [2, 2, 9]], 7),
        ([[5]], 1),
        ([[1, 2, 3, 4, 5]], 4),
        ([[1], [2], [3]], 1),
        ([[1, 5000], [1, 5000], [1, 5000]], 8),
    ];
    let mut seed = 14391;
    let big = drawn(40, 40, 5000, mut seed);
    cases.push((big.clone(), 1));
    cases.push((big, 200));
    let alike: Vec[Vec[i32]] = Vec.filled(40, Vec.filled(40, 5000));
    cases.push((alike, 200));
    // 1992 random cases of 1 to 6 rows of 1 to 6 numbers up to 10, 100 or
    // 5000, k up to how many sums there are, at most 200
    for _ in 0..1992 {
        let m = 1 + next_random(mut seed) % 6;
        let n = 1 + next_random(mut seed) % 6;
        let top = [10, 100, 5000][next_random(mut seed) % 3];
        let mat = drawn(m, n, top, mut seed);
        let k = (1 + next_random(mut seed) % sums_up_to(mat, 200)) as i32;
        cases.push((mat, k));
    }
    for j in 0..cases.len() {
        let (mat, k) = cases[j].clone();
        check_case(mut t, mat, k);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
