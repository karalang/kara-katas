fn kth_smallest(mat: Vec[Vec[i32]], k: i32) -> i32 {
    // the k smallest sums of the rows so far, each next row added to every
    // one of them, the new sums sorted and cut back to k: a sum among the
    // k smallest of all the rows comes from one among the k smallest of
    // the rows before
    let mut sums: Vec[i32] = [0].to_vec();
    for row in mat.iter() {
        let mut next: Vec[i32] = Vec.new();
        for s in sums.iter() {
            for x in row.iter() {
                next.push(s + x);
            }
        }
        next.sort();
        next.truncate(k);
        sums = next;
    }
    sums[k - 1]
}

fn main() {
    // 300 matrices of 40 rows of 40 sorted numbers up to 5000, each with
    // a k from 1 to 200 drawn, the sums folded to a checksum
    let mut seed: i64 = 1439;
    let mut check: i64 = 0;
    for _ in 0..300 {
        let mut mat: Vec[Vec[i32]] = Vec.new();
        for _ in 0..40 {
            let mut row: Vec[i32] = Vec.new();
            for _ in 0..40 {
                seed = (seed * 1103515245 + 12345) % 2147483648;
                row.push((1 + seed / 65536 % 5000) as i32);
            }
            row.sort();
            mat.push(row);
        }
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let k = (1 + seed / 65536 % 200) as i32;
        check = (check * 131 + kth_smallest(mat, k)) % 1000000007;
    }
    println(f"300 matrices of 40 by 40: checksum {check}");
}
