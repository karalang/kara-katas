// LeetCode #1491: Average Salary Excluding the Minimum and Maximum Salary --
// the bench, mirroring the ★ arm: one pass keeping the sum, the least and
// the most. 100 salaries, each in its own band of 9000 so they stay
// different; 2000000 calls, each first moving one salary within its band.
fn average(salary: Vec[i32]) -> f64 {
    let mut least = salary[0];
    let mut most = salary[0];
    let mut sum = 0;
    for s in salary.iter() {
        least = least.min(s);
        most = most.max(s);
        sum += s;
    }
    (sum - least - most) as f64 / (salary.len() - 2) as f64
}

fn main() {
    let mut salary: Vec[i32] = (0..100).map(|k| (1000 + 9000 * k) as i32).collect();
    let mut check = 0;
    for pass in 0..2000000 {
        let k = pass % 100;
        salary[k] = (1000 + 9000 * k + (check + pass) % 9000) as i32;
        let cents = (average(salary) * 100.0).round() as i64;
        check = (check * 31 + cents) % 1000000007;
    }
    println(f"2000000 calls: checksum {check}");
}
