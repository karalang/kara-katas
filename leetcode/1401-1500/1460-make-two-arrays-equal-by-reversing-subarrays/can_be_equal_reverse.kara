fn can_be_equal(target: Vec[i32], arr: Vec[i32]) -> bool {
    // the reversals made: for each place in turn, the next copy of the
    // value `target` wants there is found in what is left of `arr` and the
    // stretch from the place to it reversed, which brings it in
    let mut arr = arr.clone();
    for i in 0..target.len() {
        let Some(j) = (i..arr.len()).find(|j| arr[j] == target[i]) else {
            return false;
        };
        arr[i..=j].reverse();
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n values from 1 to top
fn draw(seed: mut ref i64, n: i64, top: i64) -> Vec[i32] {
    (0..n).map(|_| (1 + next_random(mut seed) % top) as i32).collect()
}

// `values` shuffled
fn shuffled(seed: mut ref i64, values: Vec[i32]) -> Vec[i32] {
    let mut out = values.clone();
    for i in (1..out.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        out.swap(i, j);
    }
    out
}

fn main() {
    // LeetCode's four examples, and three more: one value against another,
    // 1000 values against themselves reversed, and against themselves with
    // one changed
    let e1 = can_be_equal([1, 2, 3, 4].to_vec(), [2, 4, 1, 3].to_vec());
    let e2 = can_be_equal([7].to_vec(), [7].to_vec());
    let e3 = can_be_equal([3, 7, 9].to_vec(), [3, 7, 11].to_vec());
    let e4 = can_be_equal([1, 1, 1, 1, 1].to_vec(), [1, 1, 1, 1, 1].to_vec());
    let e5 = can_be_equal([1].to_vec(), [2].to_vec());
    let up: Vec[i32] = (1..=1000).collect();
    let down: Vec[i32] = up.iter().rev().collect();
    let mut off = down.clone();
    off[500] = 1;
    println(f"{e1} {e2} {e3} {e4} {e5} {can_be_equal(up, down)} {can_be_equal(up, off)}");
    // the constraints' most, 1000 values from 1 to 1000 against them
    // shuffled
    let mut seed = 1460;
    let a = draw(mut seed, 1000, 1000);
    let b = shuffled(mut seed, a);
    println(f"1000 shuffled: {can_be_equal(a, b)}");
    // 3000 random pairs of 1 to 60 values from 1 to top, top from 1 to 20:
    // a third shuffled, a third shuffled with one value changed, and a third
    // drawn apart
    let mut yes = 0;
    let mut check = 0;
    for c in 0..3000 {
        let n = 1 + next_random(mut seed) % 60;
        let top = 1 + next_random(mut seed) % 20;
        let target = draw(mut seed, n, top);
        let mut arr = if c % 3 == 2 { draw(mut seed, n, top) } else { shuffled(mut seed, target) };
        if c % 3 == 1 {
            let k = next_random(mut seed) % n;
            arr[k] = (1 + next_random(mut seed) % top) as i32;
        }
        let got = can_be_equal(target, arr);
        if got {
            yes += 1;
        }
        check = (check * 3 + if got { 1 } else { 0 }) % 1000000007;
    }
    println(f"3000 random pairs: {yes} equal, checksum {check}");
}
