// LeetCode #1460: Make Two Arrays Equal by Reversing Subarrays -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- can_be_equal.kara ----
fn a0_can_be_equal(target: Vec[i32], arr: Vec[i32]) -> bool {
    // a reversal of two neighbours is a swap, and swaps sort anything, so
    // `arr` can become `target` exactly when the two hold the same values
    let mut a = target.clone();
    let mut b = arr.clone();
    a.sort();
    b.sort();
    a == b
}

// ---- can_be_equal_counts.kara ----
fn a1_can_be_equal(target: Vec[i32], arr: Vec[i32]) -> bool {
    // each value counted up in `target` and down in `arr`: the two hold
    // the same values when every count ends at 0
    let mut counts = [0; 1001];
    for (t, a) in target.iter().zip(arr.iter()) {
        counts[t as usize] += 1;
        counts[a as usize] -= 1;
    }
    counts.iter().all(|c| *c == 0)
}

// ---- can_be_equal_map.kara ----
fn a2_can_be_equal(target: Vec[i32], arr: Vec[i32]) -> bool {
    a2_tally(target) == a2_tally(arr)
}

// how many times each value is in `values`
fn a2_tally(values: Vec[i32]) -> Map[i32, i64] {
    let mut seen: Map[i32, i64] = Map.new();
    for v in values {
        *seen.entry(v).or_insert(0) += 1;
    }
    seen
}

// ---- can_be_equal_reverse.kara ----
fn a3_can_be_equal(target: Vec[i32], arr: Vec[i32]) -> bool {
    // the reversals made: for each place in turn, the next copy of the
    // value `target` wants there is found in what is left of `arr` and the
    // stretch from the place to it reversed, which brings it in
    let mut arr = arr.clone();
    for i in 0..target.len() {
        let Some(j) = (i..arr.len()).find(|j| arr[j] == target[i]) else {
            return false;
        };
        arr[i..=j].reverse();
    }
    true
}

// ---- can_be_equal_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_can_be_equal(target: own Vec[i32], arr: own Vec[i32]) -> bool {
        let mut target = target;
        let mut arr = arr;
        target.sort();
        arr.sort();
        target == arr
    }
}

fn a4_can_be_equal(target: own Vec[i32], arr: own Vec[i32]) -> bool {
    A4Solution.a4_can_be_equal(target, arr)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n values from 1 to top
fn draw(seed: mut ref i64, n: i64, top: i64) -> Vec[i32] {
    (0..n).map(|_| (1 + next_random(mut seed) % top) as i32).collect()
}

// `values` shuffled
fn shuffled(seed: mut ref i64, values: Vec[i32]) -> Vec[i32] {
    let mut out = values.clone();
    for i in (1..out.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        out.swap(i, j);
    }
    out
}

// the statement read literally: every array `arr` can become by a run of
// reversals, found by a breadth-first search over the arrays themselves,
// each step reversing one stretch, and `target` among them
fn literal(target: Vec[i32], arr: Vec[i32]) -> bool {
    let mut seen: Set[Vec[i32]] = Set.new();
    let mut queue: VecDeque[Vec[i32]] = VecDeque.new();
    seen.insert(arr.clone());
    queue.push_back(arr.clone());
    while let Some(now) = queue.pop_front() {
        if now == target {
            return true;
        }
        for i in 0..now.len() {
            for j in i + 1..now.len() {
                let mut next = now.clone();
                let mut lo = i;
                let mut hi = j;
                while lo < hi {
                    next.swap(lo, hi);
                    lo += 1;
                    hi -= 1;
                }
                if seen.insert(next.clone()) {
                    queue.push_back(next);
                }
            }
        }
    }
    false
}

fn arm(i: i64, target: Vec[i32], arr: Vec[i32]) -> bool {
    match i {
        0 => a0_can_be_equal(target, arr),
        1 => a1_can_be_equal(target, arr),
        2 => a2_can_be_equal(target, arr),
        3 => a3_can_be_equal(target, arr),
        _ => a4_can_be_equal(target.clone(), arr.clone()),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, seed: mut ref i64, target: Vec[i32], arr: Vec[i32]) {
    t.cases += 1;
    let star = arm(0, target, arr);
    t.check = (t.check * 3 + if star { 1 } else { 0 }) % 1000000007;
    let n = target.len();
    let want = if n <= 6 { Some(literal(target, arr)) } else { None };
    let back: Vec[i32] = target.iter().rev().collect();
    let mixed = shuffled(mut seed, arr);
    let sums_differ = target.iter().sum() != arr.iter().sum();
    for i in 0..5 {
        let what = f"arm {i} on {n} values";
        let got = arm(i, target, arr);
        // P1: the statement read literally, while there are at most 6
        // values
        if let Some(w) = want {
            expect(mut t, 1, got == w, f"P1 {what}");
        }
        // P2: the two swapped give the same answer
        expect(mut t, 2, arm(i, arr, target) == got, f"P2 {what}");
        // P3: `target` reversed gives the same answer
        expect(mut t, 3, arm(i, back, arr) == got, f"P3 {what}");
        // P4: `arr` shuffled gives the same answer
        expect(mut t, 4, arm(i, target, mixed) == got, f"P4 {what}");
        // P5: each against itself is true, and the two false when their
        // sums differ
        expect(mut t, 5, arm(i, target, target) and arm(i, arr, arr) and (not sums_differ or not got), f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: one value against itself and
    // another, two values swapped, the same values with one more copy of
    // one and one fewer of another, and 1000 values against themselves
    // reversed and with one changed, and the constraints' most. Every case
    // is drawn before any arm answers.
    let mut cases: Vec[(Vec[i32], Vec[i32])] = [
        ([1, 2, 3, 4].to_vec(), [2, 4, 1, 3].to_vec()),
        ([7].to_vec(), [7].to_vec()),
        ([3, 7, 9].to_vec(), [3, 7, 11].to_vec()),
        ([1, 1, 1, 1, 1].to_vec(), [1, 1, 1, 1, 1].to_vec()),
        ([1].to_vec(), [2].to_vec()),
        ([1000, 1].to_vec(), [1, 1000].to_vec()),
        ([1, 1, 2].to_vec(), [1, 2, 2].to_vec()),
        ([1, 2, 2, 3].to_vec(), [3, 2, 1, 1].to_vec()),
    ];
    let up: Vec[i32] = (1..=1000).collect();
    let down: Vec[i32] = up.iter().rev().collect();
    let mut off = down.clone();
    off[500] = 1;
    cases.push((up.clone(), down));
    cases.push((up, off));
    let mut seed = 14601;
    let a = draw(mut seed, 1000, 1000);
    let b = shuffled(mut seed, a);
    cases.push((a, b));
    // 1992 random pairs: half of 1 to 6 values, half of 1 to 60, from 1 to
    // top, top from 1 to 20; a third shuffled, a third shuffled with one
    // value changed, and a third drawn apart
    for c in 0..1992 {
        let most = if c % 2 == 0 { 6 } else { 60 };
        let n = 1 + next_random(mut seed) % most;
        let top = 1 + next_random(mut seed) % 20;
        let target = draw(mut seed, n, top);
        let mut arr = if c % 3 == 2 { draw(mut seed, n, top) } else { shuffled(mut seed, target) };
        if c % 3 == 1 {
            let k = next_random(mut seed) % n;
            arr[k] = (1 + next_random(mut seed) % top) as i32;
        }
        cases.push((target, arr));
    }
    for j in 0..cases.len() {
        let (x, y) = cases[j].clone();
        check_case(mut t, mut seed, x, y);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
