// LeetCode #1448: Count Good Nodes in Binary Tree -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- good_nodes.kara ----
fn a0_good_nodes(root: Option[TreeNode]) -> i32 {
    a0_below(root, i32.MIN)
}

// the good nodes under `node`, `high` the largest value on the path above
// it: the node is good when it is at least as large
fn a0_below(node: Option[TreeNode], high: i32) -> i32 {
    let Some(n) = node else {
        return 0;
    };
    let good: i32 = if n.val >= high { 1 } else { 0 };
    let high = high.max(n.val);
    good + a0_below(n.left, high) + a0_below(n.right, high)
}

// ---- good_nodes_stack.kara ----
fn a1_good_nodes(root: Option[TreeNode]) -> i32 {
    // the walk without recursion: each node on a stack with the largest
    // value on the path above it
    let mut good = 0;
    let mut stack: Vec[(TreeNode, i32)] = Vec.new();
    if let Some(r) = root {
        stack.push((r, r.val));
    }
    while let Some((node, high)) = stack.pop() {
        if node.val >= high {
            good += 1;
        }
        let high = high.max(node.val);
        if let Some(l) = node.left {
            stack.push((l, high));
        }
        if let Some(r) = node.right {
            stack.push((r, high));
        }
    }
    good
}

// ---- good_nodes_queue.kara ----
fn a2_good_nodes(root: Option[TreeNode]) -> i32 {
    // a breadth-first walk from a `VecDeque`, each node queued with the
    // largest value on the path to it, itself included
    let mut good = 0;
    let mut queue: VecDeque[(TreeNode, i32)] = VecDeque.new();
    if let Some(r) = root {
        queue.push_back((r, r.val));
    }
    while let Some((node, high)) = queue.pop_front() {
        if node.val == high {
            good += 1;
        }
        for child in [node.left, node.right] {
            if let Some(c) = child {
                queue.push_back((c, high.max(c.val)));
            }
        }
    }
    good
}

// ---- good_nodes_counts.kara ----
fn a3_good_nodes(root: Option[TreeNode]) -> i32 {
    // the values on the path from the root counted in a `SortedMap`: a node
    // is good when no value on the path above it is larger
    let mut path: SortedMap[i32, i64] = SortedMap.new();
    a3_walk(root, mut path)
}

fn a3_walk(node: Option[TreeNode], path: mut ref SortedMap[i32, i64]) -> i32 {
    let Some(n) = node else {
        return 0;
    };
    let good: i32 = match path.last() {
        Some((top, _)) if top > n.val => 0,
        _ => 1,
    };
    *path.entry(n.val).or_insert(0) += 1;
    let total = good + a3_walk(n.left, mut path) + a3_walk(n.right, mut path);
    path[n.val] -= 1;
    if path[n.val] == 0 {
        path.remove(n.val);
    }
    total
}

// ---- good_nodes_solution.kara ----
struct A4Solution {}

fn a4_dfs(node: Option[TreeNode], max: i32) -> i32 {
    match node {
        Some(n) => {
            let good: i32 = if n.val >= max { 1 } else { 0 };
            let max = max.max(n.val);
            good + a4_dfs(n.left, max) + a4_dfs(n.right, max)
        }
        None => 0,
    }
}

impl A4Solution {
    pub fn a4_good_nodes(root: Option[TreeNode]) -> i32 {
        a4_dfs(root, i32.MIN)
    }
}

fn a4_good_nodes(root: Option[TreeNode]) -> i32 {
    A4Solution.a4_good_nodes(root)
}
// ---- the differential -------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// LeetCode's level-order list, `None` for a missing child
fn from_level(values: Vec[Option[i32]]) -> Option[TreeNode] {
    if values.len() == 0 or values[0].is_none() {
        return None;
    }
    let root = TreeNode { val: values[0].unwrap(), left: None, right: None };
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    queue.push_back(root);
    let mut i = 1;
    while i < values.len() {
        let Some(node) = queue.pop_front() else {
            break;
        };
        if let Some(v) = values[i] {
            let child = TreeNode { val: v, left: None, right: None };
            node.left = Some(child);
            queue.push_back(child);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let child = TreeNode { val: v, left: None, right: None };
                node.right = Some(child);
                queue.push_back(child);
            }
            i += 1;
        }
    }
    Some(root)
}

// n nodes with values from -top to top, each hung on an empty child place
// of the tree so far chosen at random
fn random_tree(seed: mut ref i64, n: i64, top: i64) -> Option[TreeNode] {
    let root = TreeNode { val: (next_random(mut seed) % (2 * top + 1) - top) as i32, left: None, right: None };
    let mut places: Vec[(TreeNode, bool)] = [(root, true), (root, false)];
    for _ in 1..n {
        let k = next_random(mut seed) % places.len();
        let (parent, left) = places.swap_remove(k);
        let node = TreeNode { val: (next_random(mut seed) % (2 * top + 1) - top) as i32, left: None, right: None };
        if left {
            parent.left = Some(node);
        } else {
            parent.right = Some(node);
        }
        places.push((node, true));
        places.push((node, false));
    }
    Some(root)
}

// a chain of n nodes, each the right child of the one before, the values
// rising by 2 from the root, or falling by 2
fn chain(n: i64, rising: bool) -> Option[TreeNode] {
    let mut tree: Option[TreeNode] = None;
    for i in (0..n).rev() {
        let v = (i * 2 % 20001 - 10000) as i32;
        tree = Some(TreeNode { val: if rising { v } else { -v }, left: None, right: tree });
    }
    tree
}

// how many nodes
fn size(node: Option[TreeNode]) -> i64 {
    match node {
        Some(n) => 1 + size(n.left) + size(n.right),
        None => 0,
    }
}

// the smallest value
fn smallest(node: Option[TreeNode]) -> i32 {
    match node {
        Some(n) => n.val.min(smallest(n.left)).min(smallest(n.right)),
        None => i32.MAX,
    }
}

// true when every child is at least its parent
fn rising(node: Option[TreeNode]) -> bool {
    let Some(n) = node else {
        return true;
    };
    let ok_left = n.left.is_none_or(|l| l.val >= n.val);
    let ok_right = n.right.is_none_or(|r| r.val >= n.val);
    ok_left and ok_right and rising(n.left) and rising(n.right)
}

// a new tree, each node's children swapped
fn mirrored(node: Option[TreeNode]) -> Option[TreeNode] {
    let Some(n) = node else {
        return None;
    };
    Some(TreeNode { val: n.val, left: mirrored(n.right), right: mirrored(n.left) })
}

// a new tree, every value `by` more
fn shifted(node: Option[TreeNode], by: i32) -> Option[TreeNode] {
    let Some(n) = node else {
        return None;
    };
    Some(TreeNode { val: n.val + by, left: shifted(n.left, by), right: shifted(n.right, by) })
}

// the statement read literally: every node with the values on the path from
// the root to it, kept when none of them is greater than its own
fn literal(root: Option[TreeNode]) -> i64 {
    let mut good = 0;
    let mut paths: Vec[(TreeNode, Vec[i32])] = Vec.new();
    if let Some(r) = root {
        paths.push((r, [r.val].to_vec()));
    }
    while let Some((node, path)) = paths.pop() {
        if path.iter().all(|v| v <= node.val) {
            good += 1;
        }
        for child in [node.left, node.right] {
            if let Some(c) = child {
                let mut longer = path.clone();
                longer.push(c.val);
                paths.push((c, longer));
            }
        }
    }
    good
}

fn arm(i: i64, root: Option[TreeNode]) -> i64 {
    match i {
        0 => a0_good_nodes(root),
        1 => a1_good_nodes(root),
        2 => a2_good_nodes(root),
        3 => a3_good_nodes(root),
        _ => a4_good_nodes(root),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, root: Option[TreeNode]) {
    t.cases += 1;
    let star = arm(0, root);
    t.check = (t.check * 131 + star) % 1000000007;
    let n = size(root);
    let want = if n <= 300 { Some(literal(root)) } else { None };
    let mirror = mirrored(root);
    let shift = shifted(root, 7);
    let low = smallest(root);
    let raised = Some(TreeNode { val: low, left: root, right: None });
    let all_rise = rising(root);
    for i in 0..5 {
        let what = f"arm {i} on {n} nodes";
        let got = arm(i, root);
        // P1: the statement read literally, while there are at most 300
        // nodes
        if let Some(w) = want {
            expect(mut t, 1, got == w, f"P1 {what}");
        }
        // P2: each node's children swapped gives the same count
        expect(mut t, 2, arm(i, mirror) == got, f"P2 {what}");
        // P3: every value 7 more gives the same count
        expect(mut t, 3, arm(i, shift) == got, f"P3 {what}");
        // P4: a new root above with the smallest value gives one more
        expect(mut t, 4, arm(i, raised) == got + 1, f"P4 {what}");
        // P5: from 1 to n, and n exactly when every child is at least its
        // parent
        expect(mut t, 5, got >= 1 and got <= n and (got == n) == all_rise, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: one node, and two nodes with the
    // child smaller, larger and the same; a rising and a falling chain of
    // 10^4 nodes, a full tree of 2^16 - 1 nodes falling by level and all one
    // value, and the constraints' most. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[Option[TreeNode]] = [
        from_level([Some(3), Some(1), Some(4), Some(3), None, Some(1), Some(5)]),
        from_level([Some(3), Some(3), None, Some(4), Some(2)]),
        from_level([Some(1)]),
        from_level([Some(-5)]),
        from_level([Some(2), Some(1)]),
        from_level([Some(2), None, Some(3)]),
        from_level([Some(2), Some(2)]),
    ];
    cases.push(chain(10000, true));
    cases.push(chain(10000, false));
    let falling: Vec[Option[i32]] = (0..65535).map(|i| Some((10000 - i % 20001) as i32)).collect();
    cases.push(from_level(falling));
    let same: Vec[Option[i32]] = (0..65535).map(|_| Some(-7)).collect();
    cases.push(from_level(same));
    let mut seed = 14481;
    cases.push(random_tree(mut seed, 100000, 10000));
    // 1991 random trees of 1 to 300 nodes with values from -top to top, top
    // from 0 to 100
    for _ in 0..1991 {
        let n = 1 + next_random(mut seed) % 300;
        let top = next_random(mut seed) % 101;
        cases.push(random_tree(mut seed, n, top));
    }
    for j in 0..cases.len() {
        let root = cases[j];
        check_case(mut t, root);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
