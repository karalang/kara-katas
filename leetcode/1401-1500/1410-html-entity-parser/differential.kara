// LeetCode #1410: HTML Entity Parser -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- entity_parser.kara ----
fn a0_entity_parser(text: String) -> String {
    // one walk: at each `&`, the name up to the next `;` within the seven
    // characters the longest entity takes looked up, and the `&` kept as it
    // is when it names none of the six
    let mut out = String.new();
    let mut i = 0;
    while i < text.len() {
        if text[i..].starts_with("&") {
            let window = text[i..(i + 7).min(text.len())];
            if let Some(end) = window.find(";") {
                let symbol = match window[..end + 1] {
                    "&quot;" => "\"",
                    "&apos;" => "'",
                    "&amp;" => "&",
                    "&gt;" => ">",
                    "&lt;" => "<",
                    "&frasl;" => "/",
                    _ => "",
                };
                if symbol != "" {
                    out.push_str(symbol);
                    i += end + 1;
                    continue;
                }
            }
        }
        out.push_str(text[i..i + 1]);
        i += 1;
    }
    out
}

// ---- entity_parser_replace.kara ----
fn a1_entity_parser(text: String) -> String {
    // each entity replaced through the whole text in turn, `&amp;` last, so
    // an `&` it makes cannot start another
    text.replace("&quot;", "\"")
        .replace("&apos;", "'")
        .replace("&gt;", ">")
        .replace("&lt;", "<")
        .replace("&frasl;", "/")
        .replace("&amp;", "&")
}

// ---- entity_parser_map.kara ----
fn a2_entity_parser(text: String) -> String {
    // the six in a `Map`, and at each `&` the four to seven characters
    // after it looked up, the shortest first
    let mut entities: Map[String, String] = Map.new();
    entities.insert("&quot;", "\"");
    entities.insert("&apos;", "'");
    entities.insert("&amp;", "&");
    entities.insert("&gt;", ">");
    entities.insert("&lt;", "<");
    entities.insert("&frasl;", "/");
    let mut out = String.new();
    let mut i = 0;
    while i < text.len() {
        let mut taken = 0;
        if text[i..].starts_with("&") {
            for len in 4..=7 {
                if i + len <= text.len() {
                    if let Some(symbol) = entities.get(text[i..i + len]) {
                        out.push_str(symbol);
                        taken = len;
                        break;
                    }
                }
            }
        }
        if taken == 0 {
            out.push_str(text[i..i + 1]);
            taken = 1;
        }
        i += taken;
    }
    out
}

// ---- entity_parser_split.kara ----
fn a3_entity_parser(text: String) -> String {
    // the text split at each `&`: every piece but the first followed an
    // `&`, and starts with an entity's name and `;` or keeps the `&`
    let names = [("quot;", "\""), ("apos;", "'"), ("amp;", "&"), ("gt;", ">"), ("lt;", "<"), ("frasl;", "/")];
    let mut out = String.new();
    for (k, piece) in text.split("&").enumerate() {
        if k == 0 {
            out.push_str(piece);
            continue;
        }
        let mut done = false;
        for (name, symbol) in names.iter() {
            if not done and piece.starts_with(name) {
                out.push_str(symbol);
                out.push_str(piece[name.len()..]);
                done = true;
            }
        }
        if not done {
            out.push_str("&");
            out.push_str(piece);
        }
    }
    out
}

// ---- entity_parser_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_entity_parser(text: String) -> String {
        let entities = [("&quot;", "\""), ("&apos;", "'"), ("&amp;", "&"), ("&gt;", ">"), ("&lt;", "<"), ("&frasl;", "/")];
        let bytes = text.bytes();
        let mut res = String.with_capacity(text.len());
        let mut i = 0;
        'outer: while i < bytes.len() {
            if bytes[i] == b'&' {
                for (k, v) in entities.iter() {
                    if text[i..].starts_with(k) {
                        res.push_str(v);
                        i += k.len();
                        continue 'outer;
                    }
                }
            }
            res.push(bytes[i] as char);
            i += 1;
        }
        res
    }
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a text of n pieces, each a letter, a space, a `&`, a `;`, or a whole or
// broken entity
fn drawn(n: i64, seed: mut ref i64) -> String {
    let pieces = ["a", "b", " ", "&", ";", "&quot;", "&apos;", "&amp;", "&gt;", "&lt;", "&frasl;", "&amp", "&gt", "&quot", "&ambassador;", "&lt;;", "&&", "amp;", "&frasl"];
    let mut text = String.new();
    for _ in 0..n {
        text.push_str(pieces[next_random(mut seed) % pieces.len()]);
    }
    text
}

// a text of n characters from the entities' own letters, `&` and `;`, so
// that broken and nested entities come often
fn lettered(n: i64, seed: mut ref i64) -> String {
    let letters: Vec[char] = "&&;;aglmpqtuosfr".chars().collect();
    let mut text = String.new();
    for _ in 0..n {
        text.push(letters[next_random(mut seed) % letters.len()]);
    }
    text
}

// the statement read literally: the text read from the left, and wherever
// one of the six entities starts, letter for letter, its character written
// in its place
fn literal(text: String) -> String {
    let names = ["&quot;", "&apos;", "&amp;", "&gt;", "&lt;", "&frasl;"];
    let symbols = ["\"", "'", "&", ">", "<", "/"];
    let t: Vec[char] = text.chars().collect();
    let mut out = String.new();
    let mut i = 0;
    while i < t.len() {
        let mut hit = -1;
        for e in 0..6 {
            let name: Vec[char] = names[e].chars().collect();
            if hit < 0 and i + name.len() <= t.len() {
                let mut all = true;
                for j in 0..name.len() {
                    if t[i + j] != name[j] {
                        all = false;
                    }
                }
                if all {
                    hit = e;
                }
            }
        }
        if hit >= 0 {
            out.push_str(symbols[hit]);
            i += names[hit].len();
        } else {
            out.push(t[i]);
            i += 1;
        }
    }
    out
}

// every `&` written `&amp;`, and, with `all`, the other five characters as
// their entities too
fn escaped(text: String, all: bool) -> String {
    let mut out = String.new();
    for c in text.chars() {
        match c {
            '&' => out.push_str("&amp;"),
            '"' if all => out.push_str("&quot;"),
            '\'' if all => out.push_str("&apos;"),
            '>' if all => out.push_str("&gt;"),
            '<' if all => out.push_str("&lt;"),
            '/' if all => out.push_str("&frasl;"),
            _ => out.push(c),
        }
    }
    out
}

fn arm(i: i64, text: String) -> String {
    let text = text.clone();
    match i {
        0 => a0_entity_parser(text),
        1 => a1_entity_parser(text),
        2 => a2_entity_parser(text),
        3 => a3_entity_parser(text),
        _ => A4Solution.a4_entity_parser(text),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, text: String, other: String) {
    t.cases += 1;
    let star = arm(0, text);
    for b in star.bytes().iter() {
        t.check = (t.check * 131 + b as i64) % 1000000007;
    }
    t.check = (t.check * 131 + text.len()) % 1000000007;
    let want = literal(text);
    let plain = text.replace("&", "");
    let joined = f"{text} {other}";
    for i in 0..5 {
        let what = f"arm {i} on {text}";
        let got = arm(i, text);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: a text with no `&` comes back as it is
        expect(mut t, 2, arm(i, plain) == plain, f"P2 {what}");
        // P3: no entity holds a space, so a text split at one parses as
        // its two halves
        expect(mut t, 3, arm(i, joined) == f"{got} {arm(i, other)}", f"P3 {what} and {other}");
        // P4: every `&` written `&amp;` parses back to the text
        expect(mut t, 4, arm(i, escaped(text, false)) == text, f"P4 {what}");
        // P5: all six characters written as entities parse back too
        expect(mut t, 5, arm(i, escaped(text, true)) == text, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: a lone `&` and `;`, an entity cut
    // at the end, nested and doubled ones, all six back to back, and the
    // constraints' most. Every case is drawn before any arm answers.
    let mut cases: Vec[(String, String)] = Vec.new();
    let fixed = [
        "&amp; is an HTML entity but &ambassador; is not.",
        "and I quote: &quot;...&quot;",
        "&",
        ";",
        "&frasl",
        "&amp;amp;",
        "&&gt;",
        "&quot;&apos;&amp;&gt;&lt;&frasl;",
        "&gt;&lt;&gtt;&lt",
        "x &frasl; y",
    ];
    for f in fixed.iter() {
        cases.push((f.to_string(), "&lt;"));
    }
    let mut seed = 14101;
    let mut nested = String.new();
    for _ in 0..12500 {
        nested.push_str("&amp;gt;");
    }
    cases.push((nested, drawn(5, mut seed)));
    cases.push((lettered(100000, mut seed), lettered(10, mut seed)));
    // 1991 random texts: 1 to 12 pieces two times in three, else 1 to 40
    // of the entities' letters
    for i in 0..1991 {
        if i % 3 == 2 {
            let n = 1 + next_random(mut seed) % 40;
            cases.push((lettered(n, mut seed), lettered(1 + next_random(mut seed) % 8, mut seed)));
        } else {
            let n = 1 + next_random(mut seed) % 12;
            cases.push((drawn(n, mut seed), drawn(1 + next_random(mut seed) % 4, mut seed)));
        }
    }
    for (text, other) in cases.iter() {
        check_case(mut t, text, other);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
