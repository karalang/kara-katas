fn entity_parser(text: String) -> String {
    // one walk: at each `&`, the name up to the next `;` within the seven
    // characters the longest entity takes looked up, and the `&` kept as it
    // is when it names none of the six
    let mut out = String.new();
    let mut i = 0;
    while i < text.len() {
        if text[i..].starts_with("&") {
            let window = text[i..(i + 7).min(text.len())];
            if let Some(end) = window.find(";") {
                let symbol = match window[..end + 1] {
                    "&quot;" => "\"",
                    "&apos;" => "'",
                    "&amp;" => "&",
                    "&gt;" => ">",
                    "&lt;" => "<",
                    "&frasl;" => "/",
                    _ => "",
                };
                if symbol != "" {
                    out.push_str(symbol);
                    i += end + 1;
                    continue;
                }
            }
        }
        out.push_str(text[i..i + 1]);
        i += 1;
    }
    out
}

fn main() {
    // a pool of 3 * 10^5 characters drawn in pieces, letters, `&`, `;`,
    // whole and broken entities, and 300 windows of 10^5 of them parsed,
    // each window's start drawn
    let pieces = ["a", "b", " ", "&", ";", "&quot;", "&apos;", "&amp;", "&gt;", "&lt;", "&frasl;", "&amp", "&gt", "&quot", "&ambassador;", "&lt;;", "&&", "amp;", "&frasl"];
    let mut seed: i64 = 1410;
    let mut pool = String.new();
    while pool.len() < 300000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        pool.push_str(pieces[seed / 65536 % pieces.len()]);
    }
    let mut check: i64 = 0;
    for _ in 0..300 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let start = seed / 65536 % (pool.len() - 100000);
        let out = entity_parser(pool[start..start + 100000].to_string());
        let mut sum: i64 = 0;
        for b in out.bytes().iter() {
            sum += b as i64;
        }
        check = (check * 131 + out.len() + sum) % 1000000007;
    }
    println(f"300 windows of 10^5 characters: checksum {check}");
}
