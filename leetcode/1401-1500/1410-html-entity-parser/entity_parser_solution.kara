struct Solution {}

impl Solution {
    pub fn entity_parser(text: String) -> String {
        let entities = [("&quot;", "\""), ("&apos;", "'"), ("&amp;", "&"), ("&gt;", ">"), ("&lt;", "<"), ("&frasl;", "/")];
        let bytes = text.bytes();
        let mut res = String.with_capacity(text.len());
        let mut i = 0;
        'outer: while i < bytes.len() {
            if bytes[i] == b'&' {
                for (k, v) in entities.iter() {
                    if text[i..].starts_with(k) {
                        res.push_str(v);
                        i += k.len();
                        continue 'outer;
                    }
                }
            }
            res.push(bytes[i] as char);
            i += 1;
        }
        res
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a text of n pieces: a letter, a space, a `&`, a `;`, or a whole or broken
// entity, each drawn
fn drawn(n: i64, seed: mut ref i64) -> String {
    let pieces = ["a", "b", " ", "&", ";", "&quot;", "&apos;", "&amp;", "&gt;", "&lt;", "&frasl;", "&amp", "&gt", "&quot", "&ambassador;", "&lt;;", "&&", "amp;", "&frasl"];
    let mut text = String.new();
    for _ in 0..n {
        text.push_str(pieces[next_random(mut seed) % pieces.len()]);
    }
    text
}

fn checksum(check: i64, s: String) -> i64 {
    let mut c = check;
    for b in s.bytes().iter() {
        c = (c * 131 + b as i64) % 1000000007;
    }
    c
}

fn main() {
    // LeetCode's two examples, and five more
    println(Solution.entity_parser("&amp; is an HTML entity but &ambassador; is not."));
    println(Solution.entity_parser("and I quote: &quot;...&quot;"));
    println([
        Solution.entity_parser("&amp;gt;"),
        Solution.entity_parser("&&gt;"),
        Solution.entity_parser("x &frasl; y &lt;&gt; &apos;z&apos;"),
        Solution.entity_parser("&quot&quot;;"),
        Solution.entity_parser("&"),
    ].join(" | "));
    // the constraints' most: 10^5 characters of `&gt;` after `&amp;`, and drawn
    let mut seed = 1410;
    let mut nested = String.new();
    for _ in 0..12500 {
        nested.push_str("&amp;gt;");
    }
    let big = Solution.entity_parser(drawn(20000, mut seed));
    println(f"10^5 characters, 20000 pieces: {Solution.entity_parser(nested).len()} {big.len()} {checksum(0, big)}");
    // 2000 random texts of 1 to 30 pieces
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 30;
        let out = Solution.entity_parser(drawn(n, mut seed));
        total += out.len();
        check = checksum(check, out);
    }
    println(f"2000 random texts: {total} characters, checksum {check}");
}
