struct Solution {}

impl Solution {
    pub fn find_min_fibonacci_numbers(k: i32) -> i32 {
        let mut fibs = [1, 1];
        while *fibs.last().unwrap() < k {
            let n = fibs.len();
            fibs.push(fibs[n - 1] + fibs[n - 2]);
        }
        let mut k = k;
        let mut ans = 0;
        for f in fibs.iter().rev() {
            if f <= k {
                k -= f;
                ans += 1;
            }
            if k == 0 {
                break;
            }
        }
        ans
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, and k from 1 to 12
    let small: Vec[String] = (1..=12).map(|k| f"{Solution.find_min_fibonacci_numbers(k)}").collect();
    println(f"{Solution.find_min_fibonacci_numbers(7)} {Solution.find_min_fibonacci_numbers(10)} {Solution.find_min_fibonacci_numbers(19)} | {small.join(" ")}");
    // the constraints' most, a Fibonacci number, and one below it
    println(f"k = 10^9: {Solution.find_min_fibonacci_numbers(1000000000)} {Solution.find_min_fibonacci_numbers(701408733)} {Solution.find_min_fibonacci_numbers(701408732)}");
    // 2000 random k, up to 10^3, 10^6 or 10^9
    let mut seed = 1414;
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for i in 0..2000 {
        let top = [1000, 1000000, 1000000000][i % 3];
        let k = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
        let x = Solution.find_min_fibonacci_numbers(k as i32);
        total += x;
        check = (check * 131 + x) % 1000000007;
    }
    println(f"2000 random k: {total} in all, checksum {check}");
}
