fn find_min_fibonacci_numbers(k: i32) -> i32 {
    // the Fibonacci numbers up to k, and the largest that fits taken
    // each time: the greedy sum is a shortest one
    let mut fib: Vec[i32] = [1, 1].to_vec();
    while fib[fib.len() - 1] <= k - fib[fib.len() - 2] {
        fib.push(fib[fib.len() - 1] + fib[fib.len() - 2]);
    }
    let mut left = k;
    let mut count = 0;
    for f in fib.iter().rev() {
        if f <= left {
            left -= f;
            count += 1;
        }
    }
    count
}

fn main() {
    // 3 * 10^6 values of k up to 10^9, each drawn
    let mut seed: i64 = 1414;
    let mut check: i64 = 0;
    for _ in 0..3000000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let k = 1 + seed % 1000000000;
        check = (check * 131 + find_min_fibonacci_numbers(k as i32)) % 1000000007;
    }
    println(f"3 * 10^6 values of k: checksum {check}");
}
