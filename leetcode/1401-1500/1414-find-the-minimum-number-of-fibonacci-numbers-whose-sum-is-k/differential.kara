// LeetCode #1414: Find the Minimum Number of Fibonacci Numbers Whose Sum Is K -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- find_min_fibonacci_numbers.kara ----
fn a0_find_min_fibonacci_numbers(k: i32) -> i32 {
    // the Fibonacci numbers up to k, and the largest that fits taken
    // each time: the greedy sum is a shortest one
    let mut fib: Vec[i32] = [1, 1].to_vec();
    while fib[fib.len() - 1] <= k - fib[fib.len() - 2] {
        fib.push(fib[fib.len() - 1] + fib[fib.len() - 2]);
    }
    let mut left = k;
    let mut count = 0;
    for f in fib.iter().rev() {
        if f <= left {
            left -= f;
            count += 1;
        }
    }
    count
}

// ---- find_min_fibonacci_numbers_recursive.kara ----
fn a1_find_min_fibonacci_numbers(k: i32) -> i32 {
    // nothing left needs none, and otherwise one more than what is left
    // once the largest Fibonacci number within k is taken
    if k == 0 {
        return 0;
    }
    let mut a: i32 = 1;
    let mut b: i32 = 1;
    while b <= k - a {
        let c = a + b;
        a = b;
        b = c;
    }
    1 + a1_find_min_fibonacci_numbers(k - b)
}

// ---- find_min_fibonacci_numbers_search.kara ----
fn a2_find_min_fibonacci_numbers(k: i32) -> i32 {
    // the Fibonacci numbers up to 10^9 once, and the largest within what
    // is left found by `partition_point` each time
    let mut fib: Vec[i64] = [1, 2].to_vec();
    while fib[fib.len() - 1] <= 1000000000 {
        fib.push(fib[fib.len() - 1] + fib[fib.len() - 2]);
    }
    let mut left = k as i64;
    let mut count = 0;
    while left > 0 {
        let at = fib.partition_point(|f| f <= left);
        left -= fib[at - 1];
        count += 1;
    }
    count
}

// ---- find_min_fibonacci_numbers_walk.kara ----
fn a3_find_min_fibonacci_numbers(k: i32) -> i32 {
    // no list: the pair climbs to the largest Fibonacci number within k,
    // then steps back down a pair at a time, each one that fits taken
    let mut a: i32 = 1;
    let mut b: i32 = 1;
    while b <= k - a {
        let c = a + b;
        a = b;
        b = c;
    }
    let mut left = k;
    let mut count = 0;
    while left > 0 {
        if b <= left {
            left -= b;
            count += 1;
        }
        let before = b - a;
        b = a;
        a = before;
    }
    count
}

// ---- find_min_fibonacci_numbers_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_find_min_fibonacci_numbers(k: i32) -> i32 {
        let mut fibs = [1, 1];
        while *fibs.last().unwrap() < k {
            let n = fibs.len();
            fibs.push(fibs[n - 1] + fibs[n - 2]);
        }
        let mut k = k;
        let mut ans = 0;
        for f in fibs.iter().rev() {
            if f <= k {
                k -= f;
                ans += 1;
            }
            if k == 0 {
                break;
            }
        }
        ans
    }
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the Fibonacci numbers up to 2 * 10^9, 1 once
fn fibonacci() -> Vec[i64] {
    let mut fib: Vec[i64] = [1, 2].to_vec();
    while fib[fib.len() - 1] <= 2000000000 {
        fib.push(fib[fib.len() - 1] + fib[fib.len() - 2]);
    }
    fib
}

// the statement read literally: for every sum up to top, the fewest
// Fibonacci numbers, each as often as wanted, that make it, every last
// number tried
fn literal(top: i64, fib: Vec[i64]) -> Vec[i64] {
    let mut fewest: Vec[i64] = Vec.filled(top + 1, top + 1);
    fewest[0] = 0;
    for s in 1..=top {
        for f in fib.iter() {
            if f <= s and fewest[s - f] + 1 < fewest[s] {
                fewest[s] = fewest[s - f] + 1;
            }
        }
    }
    fewest
}

fn arm(i: i64, k: i64) -> i64 {
    let k = k as i32;
    let x = match i {
        0 => a0_find_min_fibonacci_numbers(k),
        1 => a1_find_min_fibonacci_numbers(k),
        2 => a2_find_min_fibonacci_numbers(k),
        3 => a3_find_min_fibonacci_numbers(k),
        _ => A4Solution.a4_find_min_fibonacci_numbers(k),
    };
    x
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, k: i64, split: i64, fib: Vec[i64], fewest: Vec[i64]) {
    t.cases += 1;
    let star = arm(0, k);
    t.check = (t.check * 131 + star) % 1000000007;
    t.check = (t.check * 131 + k % 1000000007) % 1000000007;
    let is_fib = fib.contains(k);
    // the largest Fibonacci number within k, and the one before it
    let mut at = 0;
    while at + 1 < fib.len() and fib[at + 1] <= k {
        at += 1;
    }
    let largest = fib[at];
    for i in 0..5 {
        let what = f"arm {i} at k = {k}";
        let got = arm(i, k);
        // P1: the statement read literally, for the sums it reaches
        if k < fewest.len() {
            expect(mut t, 1, got == fewest[k], f"P1 {what}: literal {fewest[k]}, got {got}");
        }
        // P2: at least one number, and one exactly when k is a Fibonacci
        // number
        expect(mut t, 2, got >= 1 and (got == 1) == is_fib, f"P2 {what}: {got}");
        // P3: a shortest sum can take the largest Fibonacci number within
        // k, and the rest is then shorter by one
        expect(mut t, 3, k == largest or got == 1 + arm(i, k - largest), f"P3 {what}: {got} with {largest} taken");
        // P4: k in two parts takes no fewer than k whole
        if split > 0 and split < k {
            expect(mut t, 4, got <= arm(i, split) + arm(i, k - split), f"P4 {what} split at {split}");
        }
        // P5: one Fibonacci number more adds at most one
        if k + largest <= 1000000000 {
            expect(mut t, 5, arm(i, k + largest) <= got + 1, f"P5 {what} and {largest}");
        }
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    let fib = fibonacci();
    let fewest = literal(3000, fib);
    // every k from 1 to 300, the constraints' most, the Fibonacci numbers
    // near it and their neighbours, and 1695 random k up to 3000, 10^6 or
    // 10^9. Every case is drawn before any arm answers.
    let mut cases: Vec[i64] = (1..=300).collect();
    cases.push(1000000000);
    for f in [433494437, 701408733] {
        cases.push(f - 1);
        cases.push(f);
        cases.push(f + 1);
    }
    cases.push(999999999);
    let mut seed = 14141;
    for i in 0..1695 {
        let top = [3000, 1000000, 1000000000][i % 3];
        cases.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top);
    }
    let mut splits: Vec[i64] = Vec.new();
    for k in cases.iter() {
        splits.push(next_random(mut seed) % k);
    }
    for (k, split) in cases.iter().zip(splits.iter()) {
        check_case(mut t, k, split, fib, fewest);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
