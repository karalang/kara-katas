// LeetCode #1480: Running Sum of 1d Array -- differential test of the
// five arms against the statement read literally, with five more
// properties.

// ---- running_sum.kara ----
fn a0_running_sum(nums: Vec[i32]) -> Vec[i32] {
    let mut sums: Vec[i32] = Vec.new();
    let mut sum: i32 = 0;
    for x in nums.iter() {
        sum += x;
        sums.push(sum);
    }
    sums
}

// ---- running_sum_scan.kara ----
fn a1_running_sum(nums: Vec[i32]) -> Vec[i32] {
    nums.iter()
        .scan(0i32, |sum, x| { let sum = sum + x; Some((sum, sum)) })
        .collect()
}

// ---- running_sum_in_place.kara ----
fn a2_running_sum(nums: own Vec[i32]) -> Vec[i32] {
    let mut nums = nums;
    for i in 1..nums.len() {
        nums[i] += nums[i - 1];
    }
    nums
}

// ---- running_sum_fold.kara ----
fn a3_running_sum(nums: Vec[i32]) -> Vec[i32] {
    nums.iter().fold(Vec.new(), |sums, x| {
        let mut sums = sums;
        let last = sums.last() ?? 0;
        sums.push(last + x);
        sums
    })
}

// ---- running_sum_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn running_sum(nums: own Vec[i32]) -> Vec[i32] {
        let mut nums = nums;
        for i in 1..nums.len() {
            nums[i] += nums[i - 1];
        }
        nums
    }
}

fn a4_running_sum(nums: own Vec[i32]) -> Vec[i32] {
    A4Solution.running_sum(nums)
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 30 bits from two draws, for values up to 10^6 either way
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// n values from -top to top
fn draw(seed: mut ref i64, n: i64, top: i64) -> Vec[i32] {
    (0..n).map(|_| (wide_random(mut seed) % (2 * top + 1) - top) as i32).collect()
}

// the statement read literally: runningSum[i] = sum(nums[0]...nums[i]),
// each one added up afresh
fn literal(nums: Vec[i32]) -> Vec[i32] {
    let mut out: Vec[i32] = Vec.new();
    for i in 0..nums.len() {
        let mut sum: i32 = 0;
        for j in 0..=i {
            sum += nums[j];
        }
        out.push(sum);
    }
    out
}

fn arm(i: i64, nums: Vec[i32]) -> Vec[i32] {
    match i {
        0 => a0_running_sum(nums),
        1 => a1_running_sum(nums),
        2 => a2_running_sum(nums.clone()),
        3 => a3_running_sum(nums),
        _ => a4_running_sum(nums.clone()),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, nums: Vec[i32]) {
    t.cases += 1;
    let n = nums.len();
    let star = arm(0, nums);
    for x in star.iter() {
        t.check = (t.check * 31 + x + 1000000007) % 1000000007;
    }
    let want = literal(nums);
    let negated: Vec[i32] = nums.iter().map(|x| -x).collect();
    let half: Vec[i32] = nums[0..n / 2].to_vec();
    let total: i64 = nums.iter().map(|x| x as i64).sum();
    for i in 0..5 {
        let what = f"arm {i} on {n} values";
        let got = arm(i, nums);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: each sum less the one before it is the value at its place
        let mut p2 = got.len() == n;
        for j in 0..got.len().min(n) {
            let before = if j == 0 { 0 } else { got[j - 1] };
            p2 = p2 and got[j] - before == nums[j];
        }
        expect(mut t, 2, p2, f"P2 {what}");
        // P3: every value negated negates every sum
        let back: Vec[i32] = arm(i, negated).iter().map(|x| -x).collect();
        expect(mut t, 3, back == got, f"P3 {what}");
        // P4: the first half alone has the first half of the sums
        expect(mut t, 4, arm(i, half) == got[0..n / 2].to_vec(), f"P4 {what}");
        // P5: the last sum is the whole array's total
        expect(mut t, 5, got.len() == n and got[n - 1] == total, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[Vec[i32]] = [
        [1, 2, 3, 4].to_vec(),
        [1, 1, 1, 1, 1].to_vec(),
        [3, 1, 2, 10, 1].to_vec(),
        [-7].to_vec(),
        [5, -5, 5, -5, 0].to_vec(),
    ].to_vec();
    cases.push(Vec.filled(1000, 1000000));
    cases.push(Vec.filled(1000, -1000000));
    cases.push((0..1000).map(|i| if i % 2 == 0 { 1000000 } else { -1000000 }).collect());
    let mut seed = 14801;
    // 1992 random arrays: half of 1 to 10 values from -5 to 5, and half of
    // 1 to 200 values from -top to top, top from 0 to 10^6
    for c in 0..1992 {
        if c % 2 == 0 {
            let n = 1 + next_random(mut seed) % 10;
            cases.push(draw(mut seed, n, 5));
        } else {
            let n = 1 + next_random(mut seed) % 200;
            let top = wide_random(mut seed) % 1000001;
            cases.push(draw(mut seed, n, top));
        }
    }
    for j in 0..cases.len() {
        let nums = cases[j].clone();
        check_case(mut t, nums);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
