// LeetCode #1416: Restore The Array -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- number_of_arrays.kara ----
fn a0_number_of_arrays(s: String, k: i32) -> i32 {
    // ways[i] counts the arrays the digits from i on can be read as: each
    // number starting at i that has no leading 0 and is at most k, which
    // is at most 10 digits long, followed by any array of the rest
    let modulus: i64 = 1000000007;
    let digits = s.bytes();
    let n = digits.len();
    let mut ways: Vec[i64] = Vec.filled(n + 1, 0);
    ways[n] = 1;
    for i in (0..n).rev() {
        if digits[i] == b'0' {
            continue;
        }
        let mut number: i64 = 0;
        let mut j = i;
        while j < n {
            number = number * 10 + (digits[j] - b'0');
            if number > k {
                break;
            }
            ways[i] = (ways[i] + ways[j + 1]) % modulus;
            j += 1;
        }
    }
    ways[0] as i32
}

// ---- number_of_arrays_forward.kara ----
fn a1_number_of_arrays(s: String, k: i32) -> i32 {
    // ways[j] counts the arrays the first j digits can be read as, pushed
    // forward: from every i that some array reaches, each number that
    // starts there and fits carries ways[i] on to where it ends
    let modulus: i64 = 1000000007;
    let digits: Vec[i64] = s.chars().map(|c| c.to_digit(10).unwrap() as i64).collect();
    let n = digits.len();
    let mut ways: Vec[i64] = Vec.filled(n + 1, 0);
    ways[0] = 1;
    for i in 0..n {
        if ways[i] == 0 or digits[i] == 0 {
            continue;
        }
        let mut number = 0;
        for j in i..n.min(i + 10) {
            number = number * 10 + digits[j];
            if number > k {
                break;
            }
            ways[j + 1] = (ways[j + 1] + ways[i]) % modulus;
        }
    }
    ways[n] as i32
}

// ---- number_of_arrays_memo.kara ----
fn a2_ways_from(digits: Vec[u8], i: i64, k: i64, memo: mut ref Vec[i64]) -> i64 {
    if i == digits.len() {
        return 1;
    }
    if memo[i] >= 0 {
        return memo[i];
    }
    let mut total = 0;
    if digits[i] != b'0' {
        let mut number = 0;
        for j in i..digits.len() {
            number = number * 10 + (digits[j] - b'0');
            if number > k {
                break;
            }
            total = (total + a2_ways_from(digits, j + 1, k, mut memo)) % 1000000007;
        }
    }
    memo[i] = total;
    total
}

fn a2_number_of_arrays(s: String, k: i32) -> i32 {
    let digits: Vec[u8] = s.bytes().iter().collect();
    let mut memo: Vec[i64] = Vec.filled(digits.len(), -1);
    a2_ways_from(digits, 0, k, mut memo) as i32
}

// ---- number_of_arrays_window.kara ----
fn a3_number_of_arrays(s: String, k: i32) -> i32 {
    // the backward count kept in a ring of the last 11 entries, since a
    // number is at most 10 digits long
    let modulus: i64 = 1000000007;
    let digits = s.bytes();
    let n = digits.len();
    let mut ring: Vec[i64] = Vec.filled(11, 0);
    ring[n % 11] = 1;
    for i in (0..n).rev() {
        let mut total = 0;
        if digits[i] != b'0' {
            let mut number: i64 = 0;
            for j in i..n.min(i + 10) {
                number = number * 10 + (digits[j] - b'0');
                if number > k {
                    break;
                }
                total = (total + ring[(j + 1) % 11]) % modulus;
            }
        }
        ring[i % 11] = total;
    }
    ring[0] as i32
}

// ---- number_of_arrays_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_number_of_arrays(s: String, k: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let s = s.bytes();
        let n = s.len();
        let k = k as i64;
        let mut dp = Vec.filled(n + 1, 0);
        dp[n] = 1;
        for i in (0..n).rev() {
            if s[i] == b'0' {
                continue;
            }
            let mut num: i64 = 0;
            for j in i..n {
                num = num * 10 + (s[j] - b'0');
                if num > k {
                    break;
                }
                dp[i] = (dp[i] + dp[j + 1]) % MOD;
            }
        }
        dp[0] as i32
    }
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n digits, a 0 one time in `zeros`, and never a 0 first
fn drawn(n: i64, zeros: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for i in 0..n {
        let zero = i > 0 and next_random(mut seed) % zeros == 0;
        let d = if zero { 0 } else { 1 + next_random(mut seed) % 9 };
        s.push_str(f"{d}");
    }
    s
}

// the statement read literally: every way to cut the digits into pieces,
// a cut or none after each digit but the last, counted when every piece
// is a number from 1 to k written with no leading 0
fn literal(s: String, k: i64) -> i64 {
    let n = s.len();
    let mut count = 0;
    for cuts in 0..(1 << (n - 1)) {
        let mut start = 0;
        let mut ok = true;
        for end in 1..=n {
            if end == n or (cuts >> (end - 1)) % 2 == 1 {
                let piece = s[start..end];
                if piece.starts_with("0") or piece.len() > 10 or i64.parse(piece).unwrap() > k {
                    ok = false;
                }
                start = end;
            }
        }
        if ok {
            count += 1;
        }
    }
    count
}

fn arm(i: i64, s: String, k: i32) -> i64 {
    let s = s.clone();
    let x = match i {
        0 => a0_number_of_arrays(s, k),
        1 => a1_number_of_arrays(s, k),
        2 => a2_number_of_arrays(s, k),
        3 => a3_number_of_arrays(s, k),
        _ => A4Solution.a4_number_of_arrays(s, k),
    };
    x
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, s: String, k: i32) {
    t.cases += 1;
    let star = arm(0, s, k);
    t.check = (t.check * 131 + star) % 1000000007;
    t.check = (t.check * 131 + s.len() + k) % 1000000007;
    let small = s.len() <= 14;
    let want = if small { literal(s, k) } else { -1 };
    let zeros = f"{s}0000000000";
    let wider = (k as i64 * 10).min(1000000000) as i32;
    let all_fit = s.chars().all(|c| c >= '1' and c as i64 - '0' as i64 <= k);
    for i in 0..5 {
        let what = f"arm {i} on {s}, k = {k}";
        let got = arm(i, s, k);
        // P1: the statement read literally, while the cuts are few
        if small {
            expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        }
        // P2: a count taken modulo 10^9 + 7
        expect(mut t, 2, got >= 0 and got < 1000000007, f"P2 {what}: {got}");
        // P3: ten 0s more at the end need a number of eleven digits, past
        // any k, so no array is left
        expect(mut t, 3, arm(i, zeros, k) == 0, f"P3 {what}: {zeros}");
        // P4: while no count wraps, a larger k allows every array it did
        if small {
            expect(mut t, 4, got <= arm(i, s, wider), f"P4 {what}: {got} against k = {wider}");
        }
        // P5: below 10 every number is one digit, so there is one array
        // when every digit is from 1 to k and none otherwise
        if k < 10 {
            expect(mut t, 5, got == if all_fit { 1 } else { 0 }, f"P5 {what}: {got}");
        }
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: one digit, 0s that need a long
    // number, k exactly a number of s, and the constraints' most. Every
    // case is drawn before any arm answers.
    let mut cases: Vec[(String, i32)] = Vec.new();
    let fixed = [("1000", 10000), ("1000", 10), ("1317", 2000), ("2020", 30), ("1234567890", 90), ("1", 1), ("9", 8), ("1000000000", 1000000000), ("10000000000", 1000000000), ("1234", 1234), ("101", 10)];
    for (s, k) in fixed.iter() {
        cases.push((s.to_string(), k));
    }
    let mut seed = 14161;
    cases.push(("1".repeat(100000), 1000000000));
    cases.push((drawn(100000, 10, mut seed), 1000));
    // 1990 random cases: 1 to 14 digits two times in three, else up to 200,
    // k up to 10, 1000 or 10^9
    for i in 0..1990 {
        let n = 1 + next_random(mut seed) % (if i % 3 == 2 { 200 } else { 14 });
        let s = drawn(n, 2 + next_random(mut seed) % 8, mut seed);
        let top = [10, 1000, 1000000000][i % 3];
        let k = 1 + next_random(mut seed) % top;
        cases.push((s, k as i32));
    }
    for (s, k) in cases.iter() {
        check_case(mut t, s, k);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
