fn number_of_arrays(s: String, k: i32) -> i32 {
    // ways[i] counts the arrays the digits from i on can be read as: each
    // number starting at i that has no leading 0 and is at most k, which
    // is at most 10 digits long, followed by any array of the rest
    let modulus: i64 = 1000000007;
    let digits = s.bytes();
    let n = digits.len();
    let mut ways: Vec[i64] = Vec.filled(n + 1, 0);
    ways[n] = 1;
    for i in (0..n).rev() {
        if digits[i] == b'0' {
            continue;
        }
        let mut number: i64 = 0;
        let mut j = i;
        while j < n {
            number = number * 10 + (digits[j] - b'0');
            if number > k {
                break;
            }
            ways[i] = (ways[i] + ways[j + 1]) % modulus;
            j += 1;
        }
    }
    ways[0] as i32
}

fn main() {
    // a pool of 2 * 10^5 digits, a 0 one time in 10 and never two in a
    // row, and 100 windows of 10^5 of them, each window's start and k
    // drawn
    let mut seed: i64 = 1416;
    let mut pool = String.new();
    let mut last_zero = true;
    for _ in 0..200000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let r = seed / 65536;
        let zero = not last_zero and r % 10 == 0;
        let d = if zero { 0 } else { 1 + r % 9 };
        pool.push_str(f"{d}");
        last_zero = zero;
    }
    let mut check: i64 = 0;
    for _ in 0..100 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let mut start = seed / 65536 % 100000;
        while pool[start..start + 1] == "0" {
            start += 1;
        }
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let k = 1 + seed % 1000000000;
        check = (check * 131 + number_of_arrays(pool[start..start + 100000].to_string(), k as i32)) % 1000000007;
    }
    println(f"100 windows of 10^5 digits: checksum {check}");
}
