// LeetCode #1450: Number of Students Doing Homework at a Given Time -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- busy_student.kara ----
fn a0_busy_student(start_time: Vec[i32], end_time: Vec[i32], query_time: i32) -> i32 {
    // each student's start and end side by side, kept when the query falls
    // between them, and counted
    start_time.iter().zip(end_time.iter()).filter(|(s, e)| s <= query_time and query_time <= e).count() as i32
}

// ---- busy_student_loop.kara ----
fn a1_busy_student(start_time: Vec[i32], end_time: Vec[i32], query_time: i32) -> i32 {
    // every student by place, counted when busy at the query
    let mut busy: i32 = 0;
    for i in 0..start_time.len() {
        if start_time[i] <= query_time and end_time[i] >= query_time {
            busy += 1;
        }
    }
    busy
}

// ---- busy_student_sweep.kara ----
fn a2_busy_student(start_time: Vec[i32], end_time: Vec[i32], query_time: i32) -> i32 {
    // a sweep over the times: one more student busy from each start, one
    // fewer after each end, the running count read at the query
    let mut change: Vec[i32] = Vec.filled(1002, 0);
    for (s, e) in start_time.iter().zip(end_time.iter()) {
        change[s] += 1;
        change[e + 1] -= 1;
    }
    change[..=query_time].iter().sum()
}

// ---- busy_student_sorted.kara ----
fn a3_busy_student(start_time: Vec[i32], end_time: Vec[i32], query_time: i32) -> i32 {
    // the starts and the ends each sorted: those started by the query, less
    // those already ended before it, each found by `partition_point`
    let mut starts = start_time.clone();
    let mut ends = end_time.clone();
    starts.sort();
    ends.sort();
    let started = starts.partition_point(|s| s <= query_time);
    let ended = ends.partition_point(|e| e < query_time);
    (started - ended) as i32
}

// ---- busy_student_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_busy_student(start_time: Vec[i32], end_time: Vec[i32], query_time: i32) -> i32 {
        start_time
            .iter()
            .zip(end_time.iter())
            .filter(|(s, e)| s <= query_time and query_time <= e)
            .count() as i32
    }
}

fn a4_busy_student(start_time: Vec[i32], end_time: Vec[i32], query_time: i32) -> i32 {
    A4Solution.a4_busy_student(start_time, end_time, query_time)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n students, each from a start to an end drawn from 1 to `top`
fn students(n: i64, top: i64, seed: mut ref i64) -> (Vec[i32], Vec[i32]) {
    let mut start_time: Vec[i32] = Vec.new();
    let mut end_time: Vec[i32] = Vec.new();
    for _ in 0..n {
        let a = 1 + next_random(mut seed) % top;
        let b = 1 + next_random(mut seed) % top;
        start_time.push(a.min(b) as i32);
        end_time.push(a.max(b) as i32);
    }
    (start_time, end_time)
}

// the statement read literally: every time each student is doing homework,
// from the start to the end, and the students with the query among them
fn literal(start_time: Vec[i32], end_time: Vec[i32], query_time: i32) -> i64 {
    let mut busy = 0;
    for i in 0..start_time.len() {
        let times: Vec[i32] = (start_time[i]..=end_time[i]).collect();
        if times.contains(query_time) {
            busy += 1;
        }
    }
    busy
}

fn arm(i: i64, start_time: Vec[i32], end_time: Vec[i32], query_time: i32) -> i64 {
    let start_time = start_time.clone();
    let end_time = end_time.clone();
    match i {
        0 => a0_busy_student(start_time, end_time, query_time),
        1 => a1_busy_student(start_time, end_time, query_time),
        2 => a2_busy_student(start_time, end_time, query_time),
        3 => a3_busy_student(start_time, end_time, query_time),
        _ => a4_busy_student(start_time, end_time, query_time),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, start_time: Vec[i32], end_time: Vec[i32], q: i32) {
    t.cases += 1;
    let star = arm(0, start_time, end_time, q);
    t.check = (t.check * 131 + star) % 1000000007;
    let latest = end_time.iter().max().unwrap();
    let want = if latest <= 100 { Some(literal(start_time, end_time, q)) } else { None };
    let rev_start: Vec[i32] = start_time.iter().rev().cloned().collect();
    let rev_end: Vec[i32] = end_time.iter().rev().cloned().collect();
    let mut at_start = start_time.clone();
    let mut at_end = end_time.clone();
    at_start.push(q);
    at_end.push(q);
    let mut before_start = start_time.clone();
    let mut before_end = end_time.clone();
    before_start.push(1);
    before_end.push((q - 1).max(1));
    let starting = start_time.iter().filter(|s| s == q).count();
    let ending = end_time.iter().filter(|e| e == q - 1).count();
    for i in 0..5 {
        let what = f"arm {i} on {start_time.len()} students at {q}";
        let got = arm(i, start_time, end_time, q);
        // P1: the statement read literally, while every end is at most 100
        if let Some(w) = want {
            expect(mut t, 1, got == w, f"P1 {what}");
        }
        // P2: the students in the other order give the same count
        expect(mut t, 2, arm(i, rev_start, rev_end, q) == got, f"P2 {what}");
        // P3: a student more, from the query to the query, gives one more
        expect(mut t, 3, arm(i, at_start, at_end, q) == got + 1, f"P3 {what}");
        // P4: a student more, ending just before the query, changes nothing
        if q > 1 {
            expect(mut t, 4, arm(i, before_start, before_end, q) == got, f"P4 {what}");
        }
        // P5: the count a time before, with those starting at the query and
        // less those who ended the time before
        if q > 1 {
            let earlier = arm(i, start_time, end_time, q - 1);
            expect(mut t, 5, got == earlier + starting - ending, f"P5 {what}");
        }
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: a query just after the one
    // student, one student over every time, a query at a start and at an
    // end; and the constraints' most, 100 students over every time asked at
    // 1000 and at 1, and 100 drawn students asked at 1, 500 and 1000. Every
    // case is drawn before any arm answers.
    let mut cases: Vec[(Vec[i32], Vec[i32], i32)] = [
        ([1, 2, 3].to_vec(), [3, 2, 7].to_vec(), 4),
        ([4].to_vec(), [4].to_vec(), 4),
        ([4].to_vec(), [4].to_vec(), 5),
        ([1].to_vec(), [1000].to_vec(), 500),
        ([1, 5, 9].to_vec(), [5, 9, 13].to_vec(), 5),
        ([1, 5, 9].to_vec(), [5, 9, 13].to_vec(), 9),
        (Vec.filled(100, 1), Vec.filled(100, 1000), 1000),
        (Vec.filled(100, 1), Vec.filled(100, 1000), 1),
    ];
    let mut seed = 14501;
    let (start_time, end_time) = students(100, 1000, mut seed);
    for q in [1i32, 500, 1000] {
        cases.push((start_time.clone(), end_time.clone(), q));
    }
    // 1992 random cases drawn as the harness draws them, and a third of
    // them with times from 1 to 1 to 100, for the literal reading
    for _ in 0..1992 {
        let small = next_random(mut seed) % 3 == 0;
        let n = 1 + next_random(mut seed) % 100;
        let top = if small { 1 + next_random(mut seed) % 100 } else { 1 + next_random(mut seed) % 1000 };
        let (start_time, end_time) = students(n, top, mut seed);
        let q = (1 + next_random(mut seed) % top) as i32;
        cases.push((start_time, end_time, q));
    }
    for j in 0..cases.len() {
        let (start_time, end_time, q) = cases[j].clone();
        check_case(mut t, start_time, end_time, q);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
