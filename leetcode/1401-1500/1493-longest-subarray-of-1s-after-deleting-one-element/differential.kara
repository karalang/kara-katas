// LeetCode #1493: Longest Subarray of 1's After Deleting One Element --
// differential test of the five arms against the statement read
// literally, with five more properties.

// ---- longest_subarray.kara ----
fn a0_longest_subarray(nums: Vec[i32]) -> i32 {
    let mut best = 0;
    let mut zeros = 0;
    let mut left = 0;
    for right in 0..nums.len() {
        if nums[right] == 0 {
            zeros += 1;
        }
        while zeros > 1 {
            if nums[left] == 0 {
                zeros -= 1;
            }
            left += 1;
        }
        best = best.max(right - left);
    }
    best as i32
}

// ---- longest_subarray_runs.kara ----
fn a1_longest_subarray(nums: Vec[i32]) -> i32 {
    let mut before: i32 = 0;
    let mut since: i32 = 0;
    let mut best: i32 = 0;
    let mut saw_zero = false;
    for x in nums.iter() {
        if x == 1 {
            since += 1;
        } else {
            saw_zero = true;
            before = since;
            since = 0;
        }
        best = best.max(before + since);
    }
    if saw_zero { best } else { best - 1 }
}

// ---- longest_subarray_dp.kara ----
fn a2_longest_subarray(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut from_left: Vec[i32] = Vec.filled(n, 0);
    let mut from_right: Vec[i32] = Vec.filled(n, 0);
    for i in 0..n {
        if nums[i] == 1 {
            from_left[i] = if i > 0 { from_left[i - 1] } else { 0 } + 1;
        }
    }
    for i in (0..n).rev() {
        if nums[i] == 1 {
            from_right[i] = if i + 1 < n { from_right[i + 1] } else { 0 } + 1;
        }
    }
    let mut best: i32 = 0;
    for i in 0..n {
        let left = if i > 0 { from_left[i - 1] } else { 0 };
        let right = if i + 1 < n { from_right[i + 1] } else { 0 };
        best = best.max(left + right);
    }
    best
}

// ---- longest_subarray_groups.kara ----
fn a3_longest_subarray(nums: Vec[i32]) -> i32 {
    let runs: Vec[i64] = nums.split(|x| x == 0).into_iter().map(|run| run.len()).collect();
    if runs.len() == 1 {
        return (runs[0] - 1) as i32;
    }
    let mut best = 0;
    for i in 1..runs.len() {
        best = best.max(runs[i - 1] + runs[i]);
    }
    best as i32
}

// ---- longest_subarray_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn longest_subarray(nums: Vec[i32]) -> i32 {
        let mut (left, zeros, ans) = (0, 0, 0);
        for right in 0..nums.len() {
            if nums[right] == 0 {
                zeros += 1;
            }
            while zeros > 1 {
                if nums[left] == 0 {
                    zeros -= 1;
                }
                left += 1;
            }
            ans = ans.max(right - left);
        }
        ans as i32
    }
}

fn a4_longest_subarray(nums: Vec[i32]) -> i32 {
    A4Solution.longest_subarray(nums)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: each element deleted in turn, and the
// longest run of 1s in what is left
fn literal(nums: Vec[i32]) -> i32 {
    let mut best: i32 = 0;
    for d in 0..nums.len() {
        let mut run: i32 = 0;
        for i in 0..nums.len() {
            if i == d {
                continue;
            }
            if nums[i] == 1 {
                run += 1;
                best = best.max(run);
            } else {
                run = 0;
            }
        }
    }
    best
}

fn arm(i: i64, nums: Vec[i32]) -> i32 {
    match i {
        0 => a0_longest_subarray(nums),
        1 => a1_longest_subarray(nums),
        2 => a2_longest_subarray(nums),
        3 => a3_longest_subarray(nums),
        _ => a4_longest_subarray(nums),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, nums: Vec[i32]) {
    t.cases += 1;
    let want = literal(nums);
    t.check = (t.check * 31 + want + 1) % 1000000007;
    let star = arm(0, nums);
    let ones = nums.iter().filter(|x| x == 1).count();
    let has_zero = ones < nums.len();
    let reversed: Vec[i32] = nums.iter().rev().collect();
    let mut led: Vec[i32] = [1];
    led.extend(nums.iter());
    let mut ended = nums.clone();
    ended.push(0);
    for i in 0..5 {
        let what = f"arm {i} on {nums}";
        let got = arm(i, nums);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: no more than the 1s there are, and fewer than the elements
        expect(mut t, 2, got >= 0 and got <= ones and got < nums.len(), f"P2 {what}");
        // P3: the array reversed gives the same
        expect(mut t, 3, arm(i, reversed) == got, f"P3 {what}");
        // P4: a 1 more at the front gives the same or one more
        let led_got = arm(i, led);
        expect(mut t, 4, led_got == got or led_got == got + 1, f"P4 {what}");
        // P5: a 0 more at the end gives the same when there was a 0 already,
        // and every 1 when there was none
        let ended_want = if has_zero { got } else { ones as i32 };
        expect(mut t, 5, arm(i, ended) == ended_want, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[Vec[i32]] = [
        [1, 1, 0, 1].to_vec(),
        [0, 1, 1, 1, 0, 1, 1, 0, 1].to_vec(),
        [1, 1, 1].to_vec(),
        [1].to_vec(),
        [0].to_vec(),
        [0, 0, 0].to_vec(),
        [0, 1, 1, 0].to_vec(),
        [1, 1, 0, 0, 1, 1, 1].to_vec(),
        [1, 0, 1, 1, 0, 1, 1, 1, 1].to_vec(),
        [1, 0].to_vec(),
    ].to_vec();
    let mut seed = 14931;
    // 1990 random arrays of 1 to 14 digits, a 0 from one in five to four
    // in five
    for _ in 0..1990 {
        let n = 1 + next_random(mut seed) % 14;
        let zeros = 1 + next_random(mut seed) % 4;
        cases.push((0..n).map(|_| if next_random(mut seed) % 5 < zeros { 0 } else { 1 }).collect());
    }
    for j in 0..cases.len() {
        check_case(mut t, cases[j]);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
