// LeetCode #1493: Longest Subarray of 1's After Deleting One Element -- the
// bench, mirroring the ★ arm: a sliding window holding at most one 0. One
// array of 100000 digits, nine in ten 1s, and 1000 calls, each first
// flipping one digit chosen from the checksum so far.
fn longest_subarray(nums: Vec[i32]) -> i32 {
    let mut best = 0;
    let mut zeros = 0;
    let mut left = 0;
    for right in 0..nums.len() {
        if nums[right] == 0 {
            zeros += 1;
        }
        while zeros > 1 {
            if nums[left] == 0 {
                zeros -= 1;
            }
            left += 1;
        }
        best = best.max(right - left);
    }
    best as i32
}

fn main() {
    let mut seed = 1493;
    let mut nums: Vec[i32] = Vec.new();
    for _ in 0..100000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        nums.push(if seed / 65536 % 10 == 0 { 0 } else { 1 });
    }
    let mut check = 0;
    for call in 0..1000 {
        let at = (check + call * 7919) % 100000;
        nums[at] = 1 - nums[at];
        check = (check * 31 + longest_subarray(nums) + 1) % 1000000007;
    }
    println(f"1000 calls over 100000 digits: checksum {check}");
}
