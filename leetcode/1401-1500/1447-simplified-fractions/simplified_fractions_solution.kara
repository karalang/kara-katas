// LeetCode #1447: Simplified Fractions -- a Rust solution as LeetCode's Rust
// users write it: two loops, `Self::gcd` on each pair, and `format!` for
// each fraction kept, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn simplified_fractions(n: i32) -> Vec[String] {
        let mut ans = Vec.new();
        for d in 2..=n {
            for m in 1..d {
                if Solution.gcd(m, d) == 1 {
                    ans.push(f"{m}/{d}");
                }
            }
        }
        ans
    }

    fn gcd(a: i32, b: i32) -> i32 {
        if b == 0 { a } else { Solution.gcd(b, a % b) }
    }
}

// ---- test harness ---------------------------------------------------------

// the fractions in order, and how many and a checksum over their letters
fn sorted(fractions: Vec[String]) -> Vec[String] {
    let mut s = fractions.clone();
    s.sort();
    s
}

fn fold(fractions: Vec[String], check: mut ref i64) {
    for f in sorted(fractions).iter() {
        for b in f.bytes() {
            *check = (*check * 131 + b) % 1000000007;
        }
        *check = (*check * 131 + 32) % 1000000007;
    }
}

fn main() {
    // LeetCode's three examples, and n = 1
    let firsts: Vec[String] = (1..=4).map(|n| f"[{sorted(Solution.simplified_fractions(n)).join(", ")}]").collect();
    println(firsts.join(" "));
    // the constraints' most
    let most = Solution.simplified_fractions(100);
    let mut check: i64 = 0;
    fold(most, mut check);
    println(f"n = 100: {most.len()} fractions, checksum {check}");
    // every n from 1 to 100
    let mut total = 0;
    let mut check: i64 = 0;
    for n in 1..=100 {
        let fractions = Solution.simplified_fractions(n);
        total += fractions.len();
        fold(fractions, mut check);
    }
    println(f"every n to 100: {total} fractions, checksum {check}");
}
