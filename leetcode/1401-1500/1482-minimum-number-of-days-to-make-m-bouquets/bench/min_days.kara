// LeetCode #1482: Minimum Number of Days to Make m Bouquets -- bench. One
// garden of 100000 flowers blooming from day 1 to 10^9 made once; then
// 150 passes, each punching one flower's day and asking for m bouquets of
// k flowers, all chosen from the checksum so far.

fn bouquets(bloom_day: Vec[i32], k: i32, day: i32) -> i64 {
    let mut made = 0;
    let mut run = 0;
    for d in bloom_day.iter() {
        if d <= day {
            run += 1;
            if run == k {
                made += 1;
                run = 0;
            }
        } else {
            run = 0;
        }
    }
    made
}

fn min_days(bloom_day: Vec[i32], m: i32, k: i32) -> i32 {
    if (m as i64) * (k as i64) > bloom_day.len() {
        return -1;
    }
    let mut lo = bloom_day.iter().min().unwrap();
    let mut hi = bloom_day.iter().max().unwrap();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if bouquets(bloom_day, k, mid) >= m {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1482;
    let mut bloom: Vec[i32] = (0..100000).map(|_| (1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000) as i32).collect();
    let mut check = 0;
    for pass in 0..150 {
        bloom[check % 100000] = (1 + (check * 7) % 1000000000) as i32;
        let k = 1 + check % 10;
        let m = 1 + (check / 10) % (100000 / k + 100);
        check = (check * 31 + min_days(bloom, m as i32, k as i32) + 1 + pass) % 1000000007;
    }
    println(f"150 passes over 100000 flowers: checksum {check}");
}
