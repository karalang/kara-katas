// LeetCode #1482: Minimum Number of Days to Make m Bouquets -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac
// fix`

struct Solution {}

impl Solution {
    pub fn min_days(bloom_day: Vec[i32], m: i32, k: i32) -> i32 {
        if (m as i64) * (k as i64) > bloom_day.len() {
            return -1;
        }
        let can = |day: i32| {
            let mut (made, run) = (0, 0);
            for d in ref bloom_day {
                if d <= day {
                    run += 1;
                    if run == k {
                        made += 1;
                        run = 0;
                    }
                } else {
                    run = 0;
                }
            }
            made >= m
        };
        let mut (lo, hi) = (*bloom_day.iter().min().unwrap(), *bloom_day.iter().max().unwrap());
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if can(mid) {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        lo
    }
}

fn min_days(bloom_day: Vec[i32], m: i32, k: i32) -> i32 {
    Solution.min_days(bloom_day, m, k)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 30 bits from two draws, for days up to 10^9
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// n days from 1 to top
fn draw(seed: mut ref i64, n: i64, top: i64) -> Vec[i32] {
    (0..n).map(|_| (1 + wide_random(mut seed) % top) as i32).collect()
}

fn main() {
    // LeetCode's three examples
    let l1 = min_days([1, 10, 3, 10, 2].to_vec(), 3, 1);
    let l2 = min_days([1, 10, 3, 10, 2].to_vec(), 3, 2);
    let l3 = min_days([7, 7, 7, 7, 12, 7, 7].to_vec(), 2, 3);
    println(f"{l1} {l2} {l3}");
    // the edges: one flower; every flower needed in one bouquet; a garden
    // one flower short; the latest day at the constraints' most; three
    // bouquets of two around one late flower; one bouquet that must wait
    // for the late flower in its middle
    let e1 = min_days([5].to_vec(), 1, 1);
    let e2 = min_days([3, 1, 4, 1, 5].to_vec(), 1, 5);
    let e3 = min_days([3, 1, 4, 1, 5].to_vec(), 3, 2);
    let e4 = min_days([1000000000, 1000000000].to_vec(), 1, 2);
    let e5 = min_days([1, 1, 9, 1, 1, 2, 2].to_vec(), 3, 2);
    let e6 = min_days([1, 9, 1].to_vec(), 1, 3);
    println(f"{e1} {e2} {e3} {e4} {e5} {e6}");
    // the constraints' most: 100000 days from 1 to 10^9, for (m, k) of
    // (1, 1), (100, 50), (900, 100), (50000, 2) and (100000, 1)
    let mut seed = 1482;
    let garden = draw(mut seed, 100000, 1000000000);
    let asks = [(1, 1), (100, 50), (900, 100), (50000, 2), (100000, 1)];
    let most: Vec[String] = asks.iter().map(|a| f"{min_days(garden, a.0, a.1)}").collect();
    println(f"100000 flowers: {most.join(" ")}");
    // 3000 random gardens of 1 to 60 flowers from 1 to top, top from 1 to
    // 10^9, m from 1 to 10 and k from 1 to 6; each answer folded into a
    // checksum
    let mut check = 0;
    let mut none = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 60;
        let top = 1 + wide_random(mut seed) % 1000000000;
        let garden = draw(mut seed, n, top);
        let m = (1 + next_random(mut seed) % 10) as i32;
        let k = (1 + next_random(mut seed) % 6) as i32;
        let got = min_days(garden, m, k);
        if got == -1 {
            none += 1;
        }
        check = (check * 31 + got + 1) % 1000000007;
    }
    println(f"3000 random gardens: {none} with no way, checksum {check}");
}
