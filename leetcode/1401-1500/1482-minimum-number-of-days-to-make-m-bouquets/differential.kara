// LeetCode #1482: Minimum Number of Days to Make m Bouquets -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- min_days.kara ----
fn a0_bouquets(bloom_day: Vec[i32], k: i32, day: i32) -> i64 {
    let mut made = 0;
    let mut run = 0;
    for d in bloom_day.iter() {
        if d <= day {
            run += 1;
            if run == k {
                made += 1;
                run = 0;
            }
        } else {
            run = 0;
        }
    }
    made
}

fn a0_min_days(bloom_day: Vec[i32], m: i32, k: i32) -> i32 {
    if (m as i64) * (k as i64) > bloom_day.len() {
        return -1;
    }
    let mut lo = bloom_day.iter().min().unwrap();
    let mut hi = bloom_day.iter().max().unwrap();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if a0_bouquets(bloom_day, k, mid) >= m {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

// ---- min_days_candidates.kara ----
fn a1_bouquets(bloom_day: Vec[i32], k: i32, day: i32) -> i64 {
    let mut made = 0;
    let mut run = 0;
    for d in bloom_day.iter() {
        run = if d <= day { run + 1 } else { 0 };
        if run == k {
            made += 1;
            run = 0;
        }
    }
    made
}

fn a1_min_days(bloom_day: Vec[i32], m: i32, k: i32) -> i32 {
    if (m as i64) * (k as i64) > bloom_day.len() {
        return -1;
    }
    let mut days = bloom_day.clone();
    days.sort();
    days.dedup();
    let first = days.partition_point(|d| a1_bouquets(bloom_day, k, d) < m);
    days[first]
}

// ---- min_days_union.kara ----
struct A2Runs {
    parent: Vec[i64],
    size: Vec[i64],
}

impl A2Runs {
    fn find(mut ref self, x: i64) -> i64 {
        let mut root = x;
        while self.parent[root] != root {
            root = self.parent[root];
        }
        let mut at = x;
        while self.parent[at] != root {
            let next = self.parent[at];
            self.parent[at] = root;
            at = next;
        }
        root
    }
}

fn a2_min_days(bloom_day: Vec[i32], m: i32, k: i32) -> i32 {
    let n = bloom_day.len();
    if (m as i64) * (k as i64) > n {
        return -1;
    }
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by_key(|i| bloom_day[i]);
    let mut runs = A2Runs { parent: (0..n).collect(), size: Vec.filled(n, 0) };
    let mut made = 0;
    for i in order.iter() {
        runs.size[i] = 1;
        made += 1 / k;
        for j in [i - 1, i + 1].iter() {
            if j < 0 or j >= n or runs.size[runs.find(j)] == 0 {
                continue;
            }
            let (a, b) = (runs.find(i), runs.find(j));
            made -= runs.size[a] / k + runs.size[b] / k;
            runs.parent[b] = a;
            runs.size[a] += runs.size[b];
            made += runs.size[a] / k;
        }
        if made >= m {
            return bloom_day[i];
        }
    }
    -1
}

// ---- min_days_windows.kara ----
fn a3_min_days(bloom_day: Vec[i32], m: i32, k: i32) -> i32 {
    let n = bloom_day.len();
    if (m as i64) * (k as i64) > n {
        return -1;
    }
    // ready[s]: the day the window starting at s is all in bloom
    let mut ready: Vec[i32] = Vec.new();
    let mut window: VecDeque[i64] = VecDeque.new();
    for i in 0..n {
        while let Some(back) = window.back() {
            if bloom_day[back] > bloom_day[i] {
                break;
            }
            window.pop_back();
        }
        window.push_back(i);
        if window.front().cloned() == Some(i - k) {
            window.pop_front();
        }
        if i + 1 >= k {
            ready.push(bloom_day[window.front().unwrap()]);
        }
    }
    let made = |day: i32| {
        let mut count = 0;
        let mut s = 0;
        while s < ready.len() {
            if ready[s] <= day {
                count += 1;
                s += k;
            } else {
                s += 1;
            }
        }
        count
    };
    let mut lo: i32 = 1;
    let mut hi = ready.iter().max().unwrap();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if made(mid) >= m {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

// ---- min_days_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn min_days(bloom_day: Vec[i32], m: i32, k: i32) -> i32 {
        if (m as i64) * (k as i64) > bloom_day.len() {
            return -1;
        }
        let can = |day: i32| {
            let mut (made, run) = (0, 0);
            for d in ref bloom_day {
                if d <= day {
                    run += 1;
                    if run == k {
                        made += 1;
                        run = 0;
                    }
                } else {
                    run = 0;
                }
            }
            made >= m
        };
        let mut (lo, hi) = (*bloom_day.iter().min().unwrap(), *bloom_day.iter().max().unwrap());
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if can(mid) {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        lo
    }
}

fn a4_min_days(bloom_day: Vec[i32], m: i32, k: i32) -> i32 {
    A4Solution.min_days(bloom_day, m, k)
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 30 bits from two draws, for days up to 10^9
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// n days from 1 to top
fn draw(seed: mut ref i64, n: i64, top: i64) -> Vec[i32] {
    (0..n).map(|_| (1 + wide_random(mut seed) % top) as i32).collect()
}

// whether `left` more bouquets can be made from the flowers from `from`
// on, each of k adjacent flowers all in bloom by `day`: a bouquet starts at
// `from`, or the flower there goes unused
fn can(bloom: Vec[i32], day: i32, k: i64, from: i64, left: i64) -> bool {
    if left == 0 {
        return true;
    }
    if from + k > bloom.len() {
        return false;
    }
    let here = (from..from + k).all(|i| bloom[i] <= day);
    (here and can(bloom, day, k, from + k, left - 1)) or can(bloom, day, k, from + 1, left)
}

// the statement read literally: the first day, of the days some flower
// blooms on, by which m bouquets of k adjacent flowers can be made, or -1
fn literal(bloom: Vec[i32], m: i32, k: i32) -> i32 {
    let mut days = bloom.clone();
    days.sort();
    for d in days.iter() {
        if can(bloom, d, k, 0, m) {
            return d;
        }
    }
    -1
}

fn arm(i: i64, bloom: Vec[i32], m: i32, k: i32) -> i32 {
    match i {
        0 => a0_min_days(bloom, m, k),
        1 => a1_min_days(bloom, m, k),
        2 => a2_min_days(bloom, m, k),
        3 => a3_min_days(bloom, m, k),
        _ => a4_min_days(bloom, m, k),
    }
}

// -1, no way, as the latest of all
fn later_or_same(a: i32, b: i32) -> bool {
    b == -1 or (a != -1 and a <= b)
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, bloom: Vec[i32], m: i32, k: i32) {
    t.cases += 1;
    let n = bloom.len() as i32;
    let star = arm(0, bloom, m, k);
    t.check = (t.check * 31 + star + 1) % 1000000007;
    let want = literal(bloom, m, k);
    let reversed: Vec[i32] = bloom.iter().rev().collect();
    let later: Vec[i32] = bloom.iter().map(|d| d + 5).collect();
    let first = bloom.iter().min().unwrap();
    let last = bloom.iter().max().unwrap();
    for i in 0..5 {
        let what = f"arm {i} on {n} flowers, m {m}, k {k}";
        let got = arm(i, bloom, m, k);
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: the garden reversed has the same answer
        expect(mut t, 2, arm(i, reversed, m, k) == got, f"P2 {what}");
        // P3: every flower 5 days later makes the answer 5 days later
        let shifted = arm(i, later, m, k);
        expect(mut t, 3, if got == -1 { shifted == -1 } else { shifted == got + 5 }, f"P3 {what}");
        // P4: one bouquet of one flower is ready the first day, and bouquets
        // that need every flower the last
        let whole = n % k == 0 and arm(i, bloom, n / k, k) != last;
        expect(mut t, 4, arm(i, bloom, 1, 1) == first and not whole, f"P4 {what}");
        // P5: one bouquet fewer is never later
        expect(mut t, 5, m == 1 or later_or_same(arm(i, bloom, m - 1, k), got), f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[(Vec[i32], i32, i32)] = [
        ([1, 10, 3, 10, 2].to_vec(), 3, 1),
        ([1, 10, 3, 10, 2].to_vec(), 3, 2),
        ([7, 7, 7, 7, 12, 7, 7].to_vec(), 2, 3),
        ([5].to_vec(), 1, 1),
        ([3, 1, 4, 1, 5].to_vec(), 1, 5),
        ([3, 1, 4, 1, 5].to_vec(), 3, 2),
        ([1000000000, 1000000000].to_vec(), 1, 2),
        ([1, 1, 9, 1, 1, 2, 2].to_vec(), 3, 2),
        ([1, 9, 1].to_vec(), 1, 3),
    ].to_vec();
    let mut seed = 14821;
    // 1991 random gardens: half of 1 to 8 flowers from 1 to 5, so days
    // repeat, m from 1 to 4 and k from 1 to 3, and half of 1 to 12 flowers
    // from 1 to top, top from 1 to 10^9, m and k from 1 to 4
    for c in 0..1991 {
        if c % 2 == 0 {
            let n = 1 + next_random(mut seed) % 8;
            let bloom = draw(mut seed, n, 5);
            let m = (1 + next_random(mut seed) % 4) as i32;
            cases.push((bloom, m, (1 + next_random(mut seed) % 3) as i32));
        } else {
            let n = 1 + next_random(mut seed) % 12;
            let top = 1 + wide_random(mut seed) % 1000000000;
            let bloom = draw(mut seed, n, top);
            let m = (1 + next_random(mut seed) % 4) as i32;
            cases.push((bloom, m, (1 + next_random(mut seed) % 4) as i32));
        }
    }
    for j in 0..cases.len() {
        let (bloom, m, k) = cases[j].clone();
        check_case(mut t, bloom, m, k);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
