// the two-kind step as a 2 x 2 matrix, raised to the n - 1-th power by
// squaring
struct Matrix {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
}

const MODULUS: i64 = 1000000007;

fn times(x: Matrix, y: Matrix) -> Matrix {
    Matrix {
        a: (x.a * y.a + x.b * y.c) % MODULUS,
        b: (x.a * y.b + x.b * y.d) % MODULUS,
        c: (x.c * y.a + x.d * y.c) % MODULUS,
        d: (x.c * y.b + x.d * y.d) % MODULUS,
    }
}

fn num_of_ways(n: i32) -> i32 {
    let mut power = Matrix { a: 1, b: 0, c: 0, d: 1 };
    let mut base = Matrix { a: 3, b: 2, c: 2, d: 2 };
    let mut e = n - 1;
    while e > 0 {
        if e % 2 == 1 {
            power = times(power, base);
        }
        base = times(base, base);
        e /= 2;
    }
    // the first row is 6 of each kind
    ((6 * (power.a + power.b + power.c + power.d)) % MODULUS) as i32
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples, and the first ten
    let small: Vec[String] = (1..=10).map(|n| f"{num_of_ways(n)}").collect();
    println(f"{num_of_ways(1)} {num_of_ways(5000)} | {small.join(" ")}");
    // the constraints' most, and its neighbours
    println(f"n = 4998..5000: {num_of_ways(4998)} {num_of_ways(4999)} {num_of_ways(5000)}");
    // every n from 1 to 600, folded
    let mut check: i64 = 0;
    for n in 1..=600 {
        check = (check * 131 + num_of_ways(n)) % 1000000007;
    }
    println(f"n = 1..600: checksum {check}");
}
