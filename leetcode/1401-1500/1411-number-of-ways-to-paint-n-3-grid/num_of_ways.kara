fn num_of_ways(n: i32) -> i32 {
    // every row is one of 6 with two colours, `aba`, or one of 6 with
    // three, `abc`; below an `aba` row can go 3 `aba` and 2 `abc` rows,
    // below an `abc` row 2 of each
    let modulus: i64 = 1000000007;
    let mut two: i64 = 6;
    let mut three: i64 = 6;
    for _ in 1..n {
        let next_two = (3 * two + 2 * three) % modulus;
        let next_three = (2 * two + 2 * three) % modulus;
        two = next_two;
        three = next_three;
    }
    ((two + three) % modulus) as i32
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples, and the first ten
    let small: Vec[String] = (1..=10).map(|n| f"{num_of_ways(n)}").collect();
    println(f"{num_of_ways(1)} {num_of_ways(5000)} | {small.join(" ")}");
    // the constraints' most, and its neighbours
    println(f"n = 4998..5000: {num_of_ways(4998)} {num_of_ways(4999)} {num_of_ways(5000)}");
    // every n from 1 to 600, folded
    let mut check: i64 = 0;
    for n in 1..=600 {
        check = (check * 131 + num_of_ways(n)) % 1000000007;
    }
    println(f"n = 1..600: checksum {check}");
}
