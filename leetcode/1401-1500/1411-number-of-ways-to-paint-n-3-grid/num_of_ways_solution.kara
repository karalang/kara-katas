struct Solution {}

impl Solution {
    pub fn num_of_ways(n: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let mut (a, b) = (6, 6);
        for _ in 1..n {
            let na = (3 * a + 2 * b) % MOD;
            let nb = (2 * a + 2 * b) % MOD;
            a = na;
            b = nb;
        }
        ((a + b) % MOD) as i32
    }
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples, and the first ten
    let small: Vec[String] = (1..=10).map(|n| f"{Solution.num_of_ways(n)}").collect();
    println(f"{Solution.num_of_ways(1)} {Solution.num_of_ways(5000)} | {small.join(" ")}");
    // the constraints' most, and its neighbours
    println(f"n = 4998..5000: {Solution.num_of_ways(4998)} {Solution.num_of_ways(4999)} {Solution.num_of_ways(5000)}");
    // every n from 1 to 600, folded
    let mut check: i64 = 0;
    for n in 1..=600 {
        check = (check * 131 + Solution.num_of_ways(n)) % 1000000007;
    }
    println(f"n = 1..600: checksum {check}");
}
