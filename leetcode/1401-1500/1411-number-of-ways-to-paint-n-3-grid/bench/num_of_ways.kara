fn num_of_ways(n: i32) -> i32 {
    // every row is one of 6 with two colours, `aba`, or one of 6 with
    // three, `abc`; below an `aba` row can go 3 `aba` and 2 `abc` rows,
    // below an `abc` row 2 of each
    let modulus: i64 = 1000000007;
    let mut two: i64 = 6;
    let mut three: i64 = 6;
    for _ in 1..n {
        let next_two = (3 * two + 2 * three) % modulus;
        let next_three = (2 * two + 2 * three) % modulus;
        two = next_two;
        three = next_three;
    }
    ((two + three) % modulus) as i32
}

fn main() {
    // 40000 grids of n rows, each n up to 5000 drawn from the checksum so
    // far
    let mut check: i64 = 0;
    for k in 0..40000 {
        let n = 1 + (check + k) % 5000;
        check = (check * 131 + num_of_ways(n as i32)) % 1000000007;
    }
    println(f"40000 grids of up to 5000 rows: checksum {check}");
}
