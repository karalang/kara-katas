fn num_of_ways(n: i32) -> i32 {
    // the 12 rows with no two neighbours alike, which rows may sit on
    // which, and a count of the ways to end in each row
    let modulus: i64 = 1000000007;
    let mut rows: Vec[(i64, i64, i64)] = Vec.new();
    for a in 0..3 {
        for b in 0..3 {
            for c in 0..3 {
                if a != b and b != c {
                    rows.push((a, b, c));
                }
            }
        }
    }
    let k = rows.len();
    let mut fits: Vec[Vec[bool]] = Vec.new();
    for (a, b, c) in rows.iter() {
        let line: Vec[bool] = rows.iter().map(|(x, y, z)| a != x and b != y and c != z).collect();
        fits.push(line);
    }
    let mut ways: Vec[i64] = Vec.filled(k, 1);
    for _ in 1..n {
        let mut next: Vec[i64] = Vec.filled(k, 0);
        for i in 0..k {
            for j in 0..k {
                if fits[i][j] {
                    next[j] = (next[j] + ways[i]) % modulus;
                }
            }
        }
        ways = next;
    }
    (ways.iter().sum() % modulus) as i32
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples, and the first ten
    let small: Vec[String] = (1..=10).map(|n| f"{num_of_ways(n)}").collect();
    println(f"{num_of_ways(1)} {num_of_ways(5000)} | {small.join(" ")}");
    // the constraints' most, and its neighbours
    println(f"n = 4998..5000: {num_of_ways(4998)} {num_of_ways(4999)} {num_of_ways(5000)}");
    // every n from 1 to 600, folded
    let mut check: i64 = 0;
    for n in 1..=600 {
        check = (check * 131 + num_of_ways(n)) % 1000000007;
    }
    println(f"n = 1..600: checksum {check}");
}
