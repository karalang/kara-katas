fn max_diff(num: i32) -> i32 {
    // the largest from the first digit that is not a 9 made one everywhere,
    // and the smallest from the first digit made a 1, or, when it is a 1
    // already, the first later digit that is neither a 0 nor a 1 made a 0
    let s = num.to_string();
    let high = match s.chars().find(|c| c != '9') {
        Some(c) => s.replace(c.to_string(), "9"),
        None => s.clone(),
    };
    let first = s.chars().next().unwrap();
    let low = if first != '1' {
        s.replace(first.to_string(), "1")
    } else {
        match s.chars().skip(1).find(|c| c != '0' and c != '1') {
            Some(c) => s.replace(c.to_string(), "0"),
            None => s.clone(),
        }
    };
    i32.parse(high).unwrap() - i32.parse(low).unwrap()
}

fn main() {
    // 3 * 10^6 numbers of 1 to 10^8, each drawn from two draws, the answers
    // folded to a checksum
    let mut seed: i64 = 1432;
    let mut check: i64 = 0;
    for _ in 0..3000000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let high = seed / 65536;
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let num = (1 + (high * 32768 + seed / 65536) % 100000000) as i32;
        check = (check * 131 + max_diff(num)) % 1000000007;
    }
    println(f"3 * 10^6 numbers: checksum {check}");
}
