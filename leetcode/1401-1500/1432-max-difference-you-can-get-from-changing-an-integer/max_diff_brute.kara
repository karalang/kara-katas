fn max_diff(num: i32) -> i32 {
    // every choice of x and y, 100 of them, each applied to the digits as
    // text; a result with a leading zero is not a number the statement
    // allows, and the rest give the largest and the smallest
    let s = num.to_string();
    let mut high = i32.MIN;
    let mut low = i32.MAX;
    for x in '0'..='9' {
        for y in '0'..='9' {
            let t: String = s.chars().map(|c| if c == x { y } else { c }).collect();
            if t.starts_with("0") {
                continue;
            }
            let v = i32.parse(t).unwrap();
            high = high.max(v);
            low = low.min(v);
        }
    }
    high - low
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, and five more
    let firsts: Vec[String] = [555, 9, 123456, 10000, 9288, 1, 100000000, 111]
        .iter()
        .map(|n| f"{max_diff(n)}")
        .collect();
    println(firsts.join(" "));
    // the constraints' most: 10^8 and the numbers below it, and every number
    // up to 10^5 summed
    let mut seed = 1432;
    let mut all: i64 = 0;
    for n in 1..=100000 {
        all += max_diff(n);
    }
    println(f"10^8: {max_diff(100000000)} {max_diff(99999999)} {max_diff(12345678)}, 1 to 10^5: {all}");
    // 2000 random numbers of 1 to 8 digits, each drawn from 0 to 2, 0 to
    // 9, or 1 and 9
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for _ in 0..2000 {
        let digits = 1 + next_random(mut seed) % 8;
        let kind = next_random(mut seed) % 3;
        let mut n: i64 = 0;
        for d in 0..digits {
            let digit = match kind {
                0 => next_random(mut seed) % 3,
                1 => next_random(mut seed) % 10,
                _ => [1, 9][next_random(mut seed) % 2],
            };
            n = n * 10 + if d == 0 and digit == 0 { 1 } else { digit };
        }
        let got = max_diff(n as i32);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random numbers: {total} in all, checksum {check}");
}
