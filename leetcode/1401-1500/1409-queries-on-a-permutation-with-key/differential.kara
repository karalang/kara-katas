// LeetCode #1409: Queries on a Permutation With Key -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- process_queries.kara ----
fn a0_process_queries(queries: Vec[i32], m: i32) -> Vec[i32] {
    // the permutation itself: each query found, and the part of P up to it
    // turned one place, which brings it to the front
    let mut p: Vec[i32] = (1..=m).collect();
    let mut answer = Vec.new();
    for q in queries.iter() {
        let at = p.iter().position(|x| x == q).unwrap();
        answer.push(at as i32);
        p[..=at].rotate_right(1);
    }
    answer
}

// ---- process_queries_fenwick.kara ----
struct A1Fenwick {
    tree: Vec[i32],
}

impl A1Fenwick {
    fn a1_add(mut ref self, at: i64, by: i32) {
        let mut i = at;
        while i < self.tree.len() {
            self.tree[i] += by;
            i += i & -i;
        }
    }

    // taken slots from 1 to at
    fn a1_count(self, at: i64) -> i32 {
        let mut i = at;
        let mut sum: i32 = 0;
        while i > 0 {
            sum += self.tree[i];
            i -= i & -i;
        }
        sum
    }
}

fn a1_process_queries(queries: Vec[i32], m: i32) -> Vec[i32] {
    let n = queries.len();
    let mut tree = A1Fenwick { tree: Vec.filled(n + m + 1, 0) };
    let mut slot: Vec[i64] = Vec.filled(m as i64 + 1, 0);
    for x in 1..=m as i64 {
        slot[x] = n + x;
        tree.a1_add(n + x, 1);
    }
    let mut answer = Vec.new();
    for (k, q) in queries.iter().enumerate() {
        let q = q as i64;
        answer.push(tree.a1_count(slot[q] - 1));
        tree.a1_add(slot[q], -1);
        // the k-th query takes slot n - k, before every slot used so far
        slot[q] = n - k;
        tree.a1_add(slot[q], 1);
    }
    answer
}

// ---- process_queries_positions.kara ----
fn a2_process_queries(queries: Vec[i32], m: i32) -> Vec[i32] {
    // where each number is: the one queried goes to 0, and every number
    // that was before it moves one place back
    let mut at: Vec[i32] = (0..=m).map(|x| x - 1).collect();
    let mut answer = Vec.new();
    for q in queries.iter() {
        let was = at[q];
        answer.push(was);
        for x in 1..=m {
            if at[x] < was {
                at[x] += 1;
            }
        }
        at[q] = 0;
    }
    answer
}

// ---- process_queries_deque.kara ----
fn a3_process_queries(queries: Vec[i32], m: i32) -> Vec[i32] {
    // P in a `VecDeque`, each number taken out where it is and put back at
    // the front
    let mut p: VecDeque[i32] = VecDeque.new();
    for x in 1..=m {
        p.push_back(x);
    }
    let mut answer = Vec.new();
    for q in queries.iter() {
        let mut at = 0;
        while p.get(at) != Some(q) {
            at += 1;
        }
        answer.push(at as i32);
        let x = p.remove(at);
        p.push_front(x);
    }
    answer
}

// ---- process_queries_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_process_queries(queries: Vec[i32], m: i32) -> Vec[i32] {
        let mut p: Vec[i32] = (1..=m).collect();
        let mut res = Vec.with_capacity(queries.len());
        for q in queries {
            let idx = p.iter().position(|x| x == q).unwrap();
            res.push(idx as i32);
            p.remove(idx);
            p.insert(0, q);
        }
        res
    }
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n queries from 1 to m
fn drawn(n: i64, m: i64, seed: mut ref i64) -> Vec[i32] {
    (0..n).map(|_| (1 + next_random(mut seed) % m) as i32).collect()
}

// the statement read literally: P starts as 1 to m; each query's place in
// P, counted from 0, is noted, and P becomes the query and then the rest
// of P without it
fn literal(queries: Vec[i32], m: i32) -> Vec[i32] {
    let mut p: Vec[i32] = Vec.new();
    for x in 1..=m {
        p.push(x);
    }
    let mut answer: Vec[i32] = Vec.new();
    for q in queries.iter() {
        let mut at = 0;
        for i in 0..p.len() {
            if p[i] == q {
                at = i;
            }
        }
        answer.push(at as i32);
        let mut next: Vec[i32] = Vec.new();
        next.push(q);
        for x in p.iter() {
            if x != q {
                next.push(x);
            }
        }
        p = next;
    }
    answer
}

fn arm(i: i64, queries: Vec[i32], m: i32) -> Vec[i32] {
    let queries = queries.clone();
    match i {
        0 => a0_process_queries(queries, m),
        1 => a1_process_queries(queries, m),
        2 => a2_process_queries(queries, m),
        3 => a3_process_queries(queries, m),
        _ => A4Solution.a4_process_queries(queries, m),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, queries: Vec[i32], m: i32) {
    t.cases += 1;
    let star = arm(0, queries, m);
    for x in star.iter() {
        t.check = (t.check * 131 + x) % 1000000007;
    }
    t.check = (t.check * 131 + m) % 1000000007;
    let want = literal(queries, m);
    let n = queries.len();
    for i in 0..5 {
        let got = arm(i, queries, m);
        let what = f"arm {i} on {queries}, m = {m}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: one answer for each query, each a place in P
        expect(mut t, 2, got.len() == n and got.iter().all(|x| x >= 0 and x < m), f"P2 {what}: {got}");
        if got.len() != n {
            continue;
        }
        for k in 0..n {
            let q = queries[k];
            let before = queries[..k].to_vec();
            match before.iter().rposition(|x| x == q) {
                // P3: a number never queried sits behind every number that
                // was, in its first order: q - 1 places, and one more for
                // each larger number queried before it
                None => {
                    let mut larger: Vec[i32] = before.iter().filter(|x| x > q).collect();
                    larger.sort();
                    larger.dedup();
                    expect(mut t, 3, got[k] == q - 1 + larger.len() as i32, f"P3 {what}: query {k} at {got[k]}");
                }
                // P4: a number queried before sits behind the numbers
                // queried since, each once; P5: right after itself, at the
                // front
                Some(last) => {
                    let mut since: Vec[i32] = queries[last + 1..k].to_vec();
                    since.sort();
                    since.dedup();
                    expect(mut t, 4, got[k] == since.len() as i32, f"P4 {what}: query {k} at {got[k]}");
                    if last == k - 1 {
                        expect(mut t, 5, got[k] == 0, f"P5 {what}: query {k} at {got[k]}");
                    }
                }
            }
        }
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: m = 1, every number once falling
    // and rising, one number again and again, the constraints' most. Every
    // case is drawn before any arm answers.
    let mut cases: Vec[(Vec[i32], i32)] = Vec.new();
    cases.push(([3i32, 1, 2, 1].to_vec(), 5));
    cases.push(([4i32, 1, 2, 2].to_vec(), 4));
    cases.push(([7i32, 5, 5, 8, 3].to_vec(), 8));
    cases.push(([1i32].to_vec(), 1));
    cases.push(([5i32, 4, 3, 2, 1].to_vec(), 5));
    cases.push(([1i32, 2, 3, 4, 5].to_vec(), 5));
    cases.push(([6i32, 6, 6, 6].to_vec(), 6));
    let mut seed = 14091;
    cases.push((drawn(1000, 1000, mut seed), 1000));
    // 1995 random cases: m up to 12 two times in three, else up to 200,
    // and 1 to m queries
    for i in 0..1995 {
        let m = 1 + next_random(mut seed) % (if i % 3 == 2 { 200 } else { 12 });
        let n = 1 + next_random(mut seed) % m;
        cases.push((drawn(n, m, mut seed), m as i32));
    }
    for (queries, m) in cases.iter() {
        check_case(mut t, queries, m);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
