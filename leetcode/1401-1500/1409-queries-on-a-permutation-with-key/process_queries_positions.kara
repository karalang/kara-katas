fn process_queries(queries: Vec[i32], m: i32) -> Vec[i32] {
    // where each number is: the one queried goes to 0, and every number
    // that was before it moves one place back
    let mut at: Vec[i32] = (0..=m).map(|x| x - 1).collect();
    let mut answer = Vec.new();
    for q in queries.iter() {
        let was = at[q];
        answer.push(was);
        for x in 1..=m {
            if at[x] < was {
                at[x] += 1;
            }
        }
        at[q] = 0;
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n queries from 1 to m
fn drawn(n: i64, m: i64, seed: mut ref i64) -> Vec[i32] {
    (0..n).map(|_| (1 + next_random(mut seed) % m) as i32).collect()
}

fn fold(v: Vec[i32]) -> i64 {
    v.iter().map(|x| x as i64).sum()
}

fn shown(v: Vec[i32]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    // LeetCode's three examples, and two more
    println([
        shown(process_queries([3, 1, 2, 1], 5)),
        shown(process_queries([4, 1, 2, 2], 4)),
        shown(process_queries([7, 5, 5, 8, 3], 8)),
        shown(process_queries([1], 1)),
        shown(process_queries([5, 4, 3, 2, 1], 5)),
    ].join(" "));
    // the constraints' most: m = 10^3 and 10^3 queries, the largest each
    // time, rising, and drawn
    let mut seed = 1409;
    let top: Vec[i32] = (0..1000).map(|_| 1000).collect();
    let rising: Vec[i32] = (1..=1000).map(|q| q as i32).collect();
    let big = process_queries(drawn(1000, 1000, mut seed), 1000);
    println(f"m = 10^3: {fold(process_queries(top, 1000))} {fold(process_queries(rising, 1000))} {fold(big)}");
    // 2000 random cases of m up to 40, 1 to m queries
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for _ in 0..2000 {
        let m = 1 + next_random(mut seed) % 40;
        let n = 1 + next_random(mut seed) % m;
        let answer = process_queries(drawn(n, m, mut seed), m as i32);
        for x in answer.iter() {
            total += x;
            check = (check * 131 + x) % 1000000007;
        }
    }
    println(f"2000 random cases: {total} in all, checksum {check}");
}
