fn count_triplets(arr: Vec[i32]) -> i32 {
    // for each prefix xor met, how many times and the sum of the places it
    // was met at, so each place k adds k - i for every earlier i at once
    let mut seen: Map[i32, (i64, i64)] = Map.new();
    seen.insert(0, (1, 0));
    let mut x: i32 = 0;
    let mut count = 0;
    for (k, a) in arr.iter().enumerate() {
        x ^= a;
        let (times, places) = seen.get(x).unwrap_or((0, 0));
        count += times * k - places;
        seen.insert(x, (times + 1, places + k + 1));
    }
    count as i32
}

fn main() {
    // 2000 arrays of 300 numbers of 1 to 1023, each counted 50 times, the
    // counts folded to a checksum
    let mut seed: i64 = 1442;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    for _ in 0..2000 {
        let mut arr: Vec[i32] = Vec.new();
        for _ in 0..300 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            arr.push((1 + seed / 65536 % 1023) as i32);
        }
        arrays.push(arr);
    }
    let mut check: i64 = 0;
    for _ in 0..50 {
        for arr in arrays.iter() {
            check = (check * 131 + count_triplets(arr)) % 1000000007;
        }
    }
    println(f"10^5 arrays of 300: checksum {check}");
}
