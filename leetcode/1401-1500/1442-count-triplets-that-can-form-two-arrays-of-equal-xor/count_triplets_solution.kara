// LeetCode #1442: Count Triplets That Can Form Two Arrays of Equal XOR -- a
// Rust solution as LeetCode's Rust users write it: `let n = arr.len()`,
// each i's running xor over k, and `res += (k - i) as i32` whenever it is
// 0, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn count_triplets(arr: Vec[i32]) -> i32 {
        let n = arr.len();
        let mut res: i32 = 0;
        for i in 0..n {
            let mut x = 0;
            for k in i..n {
                x ^= arr[k];
                if x == 0 {
                    res += (k - i) as i32;
                }
            }
        }
        res
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n numbers of 1 to `top`, each made of two draws so `top` can be 10^8
fn drawn(n: i64, top: i64, seed: mut ref i64) -> Vec[i32] {
    (0..n).map(|_| (1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top) as i32).collect()
}

fn main() {
    // LeetCode's five examples, and three more
    let cases: Vec[Vec[i32]] = [
        [2, 3, 1, 6, 7].to_vec(),
        [1, 1, 1, 1, 1].to_vec(),
        [2, 3].to_vec(),
        [1, 3, 5, 7, 9].to_vec(),
        [7, 11, 12, 9, 5, 2, 7, 17, 22].to_vec(),
        [1].to_vec(),
        [5, 5].to_vec(),
        [1, 2, 3].to_vec(),
    ];
    let firsts: Vec[String] = cases.iter().map(|arr| f"{Solution.count_triplets(arr)}").collect();
    println(firsts.join(" "));
    // the constraints' most: 300 ones, 300 numbers up to 10^8, and 300
    // numbers of 1 to 4
    let mut seed = 1442;
    let ones: Vec[i32] = Vec.filled(300, 1);
    let large = drawn(300, 100000000, mut seed);
    let small = drawn(300, 4, mut seed);
    println(f"300 numbers: {Solution.count_triplets(ones)} {Solution.count_triplets(large)} {Solution.count_triplets(small)}");
    // 2000 random cases of 1 to 60 numbers up to 1, 3, 15 or 10^8
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 60;
        let top = [1, 3, 15, 100000000][next_random(mut seed) % 4];
        let got = Solution.count_triplets(drawn(n, top, mut seed));
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random cases: {total} triplets, checksum {check}");
}
