struct Solution {}

impl Solution {
    pub fn stone_game_iii(stone_value: Vec[i32]) -> String {
        let n = stone_value.len();
        let mut dp = Vec.filled(n + 1, i32.MIN);
        dp[n] = 0;
        for i in (0..n).rev() {
            let mut take: i32 = 0;
            for k in 0..3 {
                if i + k < n {
                    take += stone_value[i + k];
                    dp[i] = dp[i].max(take - dp[i + k + 1]);
                }
            }
        }
        match dp[0].cmp(0) {
            Ordering.Greater => "Alice".to_string(),
            Ordering.Less => "Bob".to_string(),
            Ordering.Equal => "Tie".to_string(),
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n stone values from lo to hi
fn drawn(n: i64, lo: i64, hi: i64, seed: mut ref i64) -> Vec[i32] {
    (0..n).map(|_| (lo + next_random(mut seed) % (hi - lo + 1)) as i32).collect()
}

fn main() {
    // LeetCode's three examples, and three more
    let shown: Vec[String] = [
        Solution.stone_game_iii([1, 2, 3, 7]),
        Solution.stone_game_iii([1, 2, 3, -9]),
        Solution.stone_game_iii([1, 2, 3, 6]),
        Solution.stone_game_iii([-1]),
        Solution.stone_game_iii([0]),
        Solution.stone_game_iii([-1, -2, -3]),
    ].to_vec();
    println(shown.join(" "));
    // the constraints' most: 5 * 10^4 stones, all 1000, all -1000, and drawn
    let mut seed = 1406;
    let top: Vec[i32] = (0..50000).map(|_| 1000).collect();
    let bottom: Vec[i32] = (0..50000).map(|_| -1000).collect();
    let big = drawn(50000, -1000, 1000, mut seed);
    println(f"5 * 10^4 stones: {Solution.stone_game_iii(top)} {Solution.stone_game_iii(bottom)} {Solution.stone_game_iii(big)}");
    // 3000 random rows of 1 to 40 stones, from -1000 to 1000 or -3 to 3
    let mut wins = [0, 0, 0];
    let mut check: i64 = 0;
    for i in 0..3000 {
        let n = 1 + next_random(mut seed) % 40;
        let lim = if i % 2 == 0 { 1000 } else { 3 };
        let winner = Solution.stone_game_iii(drawn(n, -lim, lim, mut seed));
        let k = if winner == "Alice" { 0 } else if winner == "Bob" { 1 } else { 2 };
        wins[k] += 1;
        check = (check * 131 + k + 1) % 1000000007;
    }
    println(f"3000 random rows: Alice {wins[0]}, Bob {wins[1]}, Tie {wins[2]}, checksum {check}");
}
