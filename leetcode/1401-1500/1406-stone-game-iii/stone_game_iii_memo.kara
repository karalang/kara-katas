// how far ahead the player to move from stone i can end
fn lead(values: Vec[i32], i: i64, memo: mut ref Vec[Option[i32]]) -> i32 {
    if i >= values.len() {
        return 0;
    }
    if let Some(known) = memo[i] {
        return known;
    }
    let mut taken: i32 = 0;
    let mut best = i32.MIN;
    for k in 1..=3 {
        if i + k > values.len() {
            break;
        }
        taken += values[i + k - 1];
        best = best.max(taken - lead(values, i + k, mut memo));
    }
    memo[i] = Some(best);
    best
}

fn stone_game_iii(stone_value: Vec[i32]) -> String {
    let mut memo = Vec.filled(stone_value.len(), None);
    // from the last stone back, so no call goes deeper than three
    for i in (0..stone_value.len()).rev() {
        lead(stone_value, i, mut memo);
    }
    let first = lead(stone_value, 0, mut memo);
    String.from(if first > 0 { "Alice" } else if first < 0 { "Bob" } else { "Tie" })
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n stone values from lo to hi
fn drawn(n: i64, lo: i64, hi: i64, seed: mut ref i64) -> Vec[i32] {
    (0..n).map(|_| (lo + next_random(mut seed) % (hi - lo + 1)) as i32).collect()
}

fn main() {
    // LeetCode's three examples, and three more
    let shown: Vec[String] = [
        stone_game_iii([1, 2, 3, 7]),
        stone_game_iii([1, 2, 3, -9]),
        stone_game_iii([1, 2, 3, 6]),
        stone_game_iii([-1]),
        stone_game_iii([0]),
        stone_game_iii([-1, -2, -3]),
    ].to_vec();
    println(shown.join(" "));
    // the constraints' most: 5 * 10^4 stones, all 1000, all -1000, and drawn
    let mut seed = 1406;
    let top: Vec[i32] = (0..50000).map(|_| 1000).collect();
    let bottom: Vec[i32] = (0..50000).map(|_| -1000).collect();
    let big = drawn(50000, -1000, 1000, mut seed);
    println(f"5 * 10^4 stones: {stone_game_iii(top)} {stone_game_iii(bottom)} {stone_game_iii(big)}");
    // 3000 random rows of 1 to 40 stones, from -1000 to 1000 or -3 to 3
    let mut wins = [0, 0, 0];
    let mut check: i64 = 0;
    for i in 0..3000 {
        let n = 1 + next_random(mut seed) % 40;
        let lim = if i % 2 == 0 { 1000 } else { 3 };
        let winner = stone_game_iii(drawn(n, -lim, lim, mut seed));
        let k = if winner == "Alice" { 0 } else if winner == "Bob" { 1 } else { 2 };
        wins[k] += 1;
        check = (check * 131 + k + 1) % 1000000007;
    }
    println(f"3000 random rows: Alice {wins[0]}, Bob {wins[1]}, Tie {wins[2]}, checksum {check}");
}
