fn stone_game_iii(stone_value: Vec[i32]) -> String {
    // `best[i]` is how far ahead the player to move from stone i can end,
    // taking 1, 2 or 3 stones and leaving the rest to the other
    let n = stone_value.len();
    let mut best: Vec[i32] = Vec.filled(n + 1, 0);
    for i in (0..n).rev() {
        let mut taken: i32 = 0;
        best[i] = i32.MIN;
        for k in 1..=3 {
            if i + k > n {
                break;
            }
            taken += stone_value[i + k - 1];
            best[i] = best[i].max(taken - best[i + k]);
        }
    }
    if best[0] > 0 {
        String.from("Alice")
    } else if best[0] < 0 {
        String.from("Bob")
    } else {
        String.from("Tie")
    }
}

fn main() {
    let mut seed: i64 = 1406;
    let mut pool: Vec[i32] = Vec.new();
    for _ in 0..100000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        pool.push((seed / 65536 % 41 - 20) as i32);
    }
    let mut check: i64 = 0;
    for r in 0..1000 {
        let at = (check + r * 7919) % 50001;
        let row = pool[at..at + 50000].to_vec();
        let winner = stone_game_iii(row);
        let code = if winner == "Alice" { 1 } else if winner == "Bob" { 2 } else { 3 };
        check = (check * 131 + code) % 1000000007;
    }
    println(f"1000 rows of 5 * 10^4 stones: checksum {check}");
}
