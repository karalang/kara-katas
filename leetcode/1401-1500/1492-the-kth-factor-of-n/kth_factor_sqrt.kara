// LeetCode #1492: The kth Factor of n -- the factors up to the square root
// found in order; each one i past them pairs with n / i, so the kth from
// the top half is read off the small ones backwards. O(sqrt n)

fn kth_factor(n: i32, k: i32) -> i32 {
    let mut small: Vec[i32] = Vec.new();
    let mut i: i32 = 1;
    while i * i <= n {
        if n % i == 0 {
            small.push(i);
        }
        i += 1;
    }
    let s = small.len() as i32;
    // a square's root is its own pair, so counted once
    let root = if small[s - 1] * small[s - 1] == n { 1 } else { 0 };
    let total = 2 * s - root;
    if k > total {
        return -1;
    }
    if k <= s {
        return small[k - 1];
    }
    n / small[total - k]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{kth_factor(12, 3)} {kth_factor(7, 2)} {kth_factor(4, 4)}");
    // the edges: n = 1; the last factor of 1000 and one past it; a prime;
    // a square's middle factor; 720's thirty factors, the last and one more
    println(f"{kth_factor(1, 1)} {kth_factor(1000, 16)} {kth_factor(1000, 17)} {kth_factor(997, 2)} {kth_factor(900, 14)} {kth_factor(720, 30)} {kth_factor(720, 31)}");
    // every n up to 200 with every k up to n, folded in order
    let mut check = 0;
    let mut found = 0;
    for n in 1..=200 {
        for k in 1..=n {
            let f = kth_factor(n, k);
            if f > 0 {
                found += 1;
            }
            check = (check * 31 + f + 2) % 1000000007;
        }
    }
    println(f"n up to 200: {found} factors found, checksum {check}");
    // 20000 random pairs up to the constraints' most, 1000
    let mut seed = 1492;
    let mut check = 0;
    for _ in 0..20000 {
        let n = 1 + next_random(mut seed) % 1000;
        let k = 1 + next_random(mut seed) % n.min(40);
        check = (check * 31 + kth_factor(n as i32, k as i32) + 2) % 1000000007;
    }
    println(f"20000 random pairs: checksum {check}");
}
