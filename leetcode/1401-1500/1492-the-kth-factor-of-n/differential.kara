// LeetCode #1492: The kth Factor of n -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- kth_factor.kara ----
fn a0_kth_factor(n: i32, k: i32) -> i32 {
    let mut left = k;
    for i in 1..=n {
        if n % i == 0 {
            left -= 1;
            if left == 0 {
                return i;
            }
        }
    }
    -1
}

// ---- kth_factor_sqrt.kara ----
fn a1_kth_factor(n: i32, k: i32) -> i32 {
    let mut small: Vec[i32] = Vec.new();
    let mut i: i32 = 1;
    while i * i <= n {
        if n % i == 0 {
            small.push(i);
        }
        i += 1;
    }
    let s = small.len() as i32;
    // a square's root is its own pair, so counted once
    let root = if small[s - 1] * small[s - 1] == n { 1 } else { 0 };
    let total = 2 * s - root;
    if k > total {
        return -1;
    }
    if k <= s {
        return small[k - 1];
    }
    n / small[total - k]
}

// ---- kth_factor_filter.kara ----
fn a2_kth_factor(n: i32, k: i32) -> i32 {
    (1..=n).filter(|i| n % i == 0).nth(k - 1) ?? -1
}

// ---- kth_factor_recursive.kara ----
fn a3_kth_from(n: i32, i: i32, left: i32) -> i32 {
    if i > n {
        return -1;
    }
    if n % i == 0 {
        if left == 1 {
            return i;
        }
        return a3_kth_from(n, i + 1, left - 1);
    }
    a3_kth_from(n, i + 1, left)
}

fn a3_kth_factor(n: i32, k: i32) -> i32 {
    a3_kth_from(n, 1, k)
}

// ---- kth_factor_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn kth_factor(n: i32, k: i32) -> i32 {
        let mut k = k;
        for i in 1..=n {
            if n % i == 0 {
                k -= 1;
                if k == 0 {
                    return i;
                }
            }
        }
        -1
    }
}

fn a4_kth_factor(n: i32, k: i32) -> i32 {
    A4Solution.kth_factor(n, k)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read another way: n's prime factors, every product of
// them built, the products sorted; the kth of them, or -1
fn factors(n: i32) -> Vec[i32] {
    let mut all: Vec[i32] = [1].to_vec();
    let mut rest = n;
    let mut p: i32 = 2;
    while rest > 1 {
        if rest % p == 0 {
            let mut times = 0;
            while rest % p == 0 {
                rest /= p;
                times += 1;
            }
            let mut more: Vec[i32] = Vec.new();
            for f in all.iter() {
                let mut power: i32 = 1;
                for _ in 0..=times {
                    more.push(f * power);
                    power *= p;
                }
            }
            all = more;
        }
        p += 1;
    }
    all.sort();
    all
}

fn arm(i: i64, n: i32, k: i32) -> i32 {
    match i {
        0 => a0_kth_factor(n, k),
        1 => a1_kth_factor(n, k),
        2 => a2_kth_factor(n, k),
        3 => a3_kth_factor(n, k),
        _ => a4_kth_factor(n, k),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, n: i32, k: i32) {
    t.cases += 1;
    let all = factors(n);
    let d = all.len() as i32;
    let want = if k <= d { all[k - 1] } else { -1 };
    t.check = (t.check * 31 + want + 2) % 1000000007;
    let star = arm(0, n, k);
    for i in 0..5 {
        let what = f"arm {i} on n = {n}, k = {k}";
        let got = arm(i, n, k);
        // P1: the statement read another way
        expect(mut t, 1, got == want, f"P1 {what}");
        // P2: a factor of n, or -1 exactly when n has fewer than k
        expect(mut t, 2, if k <= d { got > 0 and n % got == 0 } else { got == -1 }, f"P2 {what}");
        // P3: the next factor is larger, or there is none
        let next = arm(i, n, k + 1);
        expect(mut t, 3, next == -1 or next > got, f"P3 {what}");
        // P4: it pairs with the factor as far from the other end
        expect(mut t, 4, k > d or got * arm(i, n, d - k + 1) == n, f"P4 {what}");
        // P5: 2n has n's factors and more, so its kth is no larger
        let twice = arm(i, 2 * n, k);
        expect(mut t, 5, got == -1 or (twice > 0 and twice <= got), f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges. Every case is drawn before any arm
    // answers.
    let mut cases: Vec[(i32, i32)] = [(12, 3), (7, 2), (4, 4), (1, 1), (1, 2), (500, 12), (499, 2), (400, 8), (360, 24), (360, 25)].to_vec();
    let mut seed = 14921;
    // 1990 random pairs, n to 500 so 2n stays near the constraints, k to
    // two past n's factor count
    for _ in 0..1990 {
        let n = (1 + next_random(mut seed) % 500) as i32;
        let d = factors(n).len();
        let k = (1 + next_random(mut seed) % (d + 2)) as i32;
        cases.push((n, k));
    }
    for (n, k) in cases.iter() {
        check_case(mut t, n, k);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
