// LeetCode #1446: Consecutive Characters -- differential
// test of the five arms against the statement read literally, with five
// more properties.

// ---- max_power.kara ----
fn a0_max_power(s: String) -> i32 {
    // the length of the run the letter so far ends, and the longest run
    let mut best: i32 = 0;
    let mut run: i32 = 0;
    let mut last = ' ';
    for ch in s.chars() {
        if ch == last {
            run += 1;
        } else {
            run = 1;
            last = ch;
        }
        best = best.max(run);
    }
    best
}

// ---- max_power_starts.kara ----
fn a1_max_power(s: String) -> i32 {
    // the places where a run starts, with the end, and the widest gap
    // between two next to each other through `windows(2)`
    let bytes = s.bytes();
    let n = bytes.len();
    let mut starts: Vec[i64] = (0..n).filter(|i| i == 0 or bytes[i] != bytes[i - 1]).collect();
    starts.push(n);
    starts.windows(2).into_iter().map(|w| w[1] - w[0]).max().unwrap() as i32
}

// ---- max_power_brute.kara ----
fn a2_max_power(s: String) -> i32 {
    // every start, the run from it carried on while the letter holds
    let letters: Vec[char] = s.chars().collect();
    let mut best = 0;
    for i in 0..letters.len() {
        let mut j = i;
        while j < letters.len() and letters[j] == letters[i] {
            j += 1;
        }
        best = best.max(j - i);
    }
    best as i32
}

// ---- max_power_fold.kara ----
fn a3_max_power(s: String) -> i32 {
    // one `fold` over the letters, the last letter, its run and the
    // longest run carried as a tuple
    let (_, _, best) = s.chars().fold((' ', 0i32, 0i32), |(last, run, best), ch| {
        let run = if ch == last { run + 1 } else { 1 };
        (ch, run, best.max(run))
    });
    best
}

// ---- max_power_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_max_power(s: String) -> i32 {
        let s = s.bytes();
        let mut ans: i32 = 1;
        let mut cnt: i32 = 1;
        for i in 1..s.len() {
            if s[i] == s[i - 1] {
                cnt += 1;
                ans = ans.max(cnt);
            } else {
                cnt = 1;
            }
        }
        ans
    }
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters drawn from the first `k` of the alphabet
fn drawn(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'a' + (next_random(mut seed) % k) as u8) as char);
    }
    s
}

// the statement read literally: every substring, kept when it holds one
// letter only, and the longest of those
fn literal(s: String) -> i64 {
    let letters: Vec[char] = s.chars().collect();
    let mut best = 0;
    for i in 0..letters.len() {
        for j in i + 1..letters.len() + 1 {
            if letters[i..j].iter().all(|c| c == letters[i]) {
                best = best.max(j - i);
            }
        }
    }
    best
}

fn arm(i: i64, s: String) -> i64 {
    let s = s.clone();
    let got = match i {
        0 => a0_max_power(s),
        1 => a1_max_power(s),
        2 => a2_max_power(s),
        3 => a3_max_power(s),
        _ => A4Solution.a4_max_power(s),
    };
    got
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, s: String) {
    t.cases += 1;
    let star = arm(0, s);
    t.check = (t.check * 131 + star) % 1000000007;
    let n = s.len();
    let want = if n <= 60 { Some(literal(s)) } else { None };
    let reversed: String = s.chars().rev().collect();
    let renamed: String = s.chars().map(|c| (b'a' + (c as u32 as u8 - b'a' + 1) % 26) as char).collect();
    let mut doubled = String.new();
    for c in s.chars() {
        doubled.push(c);
        doubled.push(c);
    }
    let first = s.chars().next().unwrap();
    let one_letter = s.chars().all(|c| c == first);
    for i in 0..5 {
        let what = f"arm {i} on {s}";
        let got = arm(i, s);
        // P1: the statement read literally, while there are at most 60
        // letters
        if let Some(w) = want {
            expect(mut t, 1, got == w, f"P1 {what}");
        }
        // P2: the letters in the other order give the same power
        expect(mut t, 2, arm(i, reversed) == got, f"P2 {what}");
        // P3: every letter renamed to the next, z to a, gives the same
        expect(mut t, 3, arm(i, renamed) == got, f"P3 {what}");
        // P4: every letter written twice gives twice the power
        expect(mut t, 4, arm(i, doubled) == 2 * got, f"P4 {what}");
        // P5: from 1 to the length, and the length exactly when the string
        // is one letter only
        let bounded = got >= 1 and got <= n and (got == n) == one_letter;
        expect(mut t, 5, bounded, f"P5 {what}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and the edges: one letter, one run, two letters,
    // two runs, and a run inside; and the constraints' most three ways.
    // Every case is drawn before any arm answers.
    let mut cases: Vec[String] = ["leetcode", "abbcccddddeeeeedcba", "a", "zzzzz", "ab", "aabbb", "abba"].iter().map(|s| s.to_string()).collect();
    let mut seed = 14461;
    cases.push("a".repeat(500));
    cases.push("ab".repeat(250));
    cases.push(drawn(500, 2, mut seed));
    // 1993 random strings of 1 to 60 letters of the first 1 to 26 of the
    // alphabet, and a third of them of the first 1 to 3
    for _ in 0..1993 {
        let few = next_random(mut seed) % 3 == 0;
        let n = 1 + next_random(mut seed) % 60;
        let k = if few { 1 + next_random(mut seed) % 3 } else { 1 + next_random(mut seed) % 26 };
        cases.push(drawn(n, k, mut seed));
    }
    for j in 0..cases.len() {
        let s = cases[j].clone();
        check_case(mut t, s);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
