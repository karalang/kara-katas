// LeetCode #2411: Smallest Subarrays With Maximum Bitwise OR -- LeetCode's
// Rust template, as Rust writes it, carried by karac fix: a `[0usize; 32]`
// of each bit's last index, the starts by `(0..n).rev()`, each length by
// `last[b] as i32 - i as i32 + 1`.

impl Solution {
    pub fn smallest_subarrays(nums: Vec[i32]) -> Vec[i32] {
        let n = nums.len();
        let mut last = [0; 32];
        let mut ans = Vec.filled(n, 1i32);
        for i in (0..n).rev() {
            for b in 0..32 {
                if nums[i] >> b & 1 == 1 {
                    last[b] = i;
                }
                ans[i] = ans[i].max(last[b] as i32 - i as i32 + 1);
            }
        }
        ans
    }
}

struct Solution {}

fn smallest_subarrays(nums: Vec[i64]) -> Vec[i64] {
    let values: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.smallest_subarrays(values).iter().map(|a| a as i64).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` values below `top`, each with probability 1 / `zeros` a 0.
fn values(seed: mut ref i64, n: i64, top: i64, zeros: i64) -> Vec[i64] {
    (0..n).map(|_| {
        let v = (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
        if next_random(mut seed) % zeros == 0 {
            0
        } else {
            v
        }
    }).collect()
}

fn show(answer: Vec[i64]) -> String {
    let parts: Vec[String] = answer.iter().map(|a| f"{a}").collect();
    parts.join(",")
}

// A checksum of the lengths and their total.
fn digest(answer: Vec[i64]) -> String {
    let mut check = 0;
    for a in answer.iter() {
        check = (check * 31 + a) % 1000000007;
    }
    f"checksum {check}, total {answer.iter().sum()}"
}

fn main() {
    // LeetCode's two examples; one 0; all zeros; one bit apiece
    println(show(smallest_subarrays([1, 0, 2, 1, 3].to_vec())));
    println(show(smallest_subarrays([1, 2].to_vec())));
    println(show(smallest_subarrays([0].to_vec())));
    println(show(smallest_subarrays([0, 0, 0].to_vec())));
    println(show(smallest_subarrays([1, 2, 4, 8, 16, 0, 1].to_vec())));
    // 10^5 values up to 10^9, and 10^5 of a few low bits with many zeros
    let mut seed = 2411;
    println(digest(smallest_subarrays(values(mut seed, 100000, 1000000001, 50))));
    println(digest(smallest_subarrays(values(mut seed, 100000, 16, 3))));
    // 2000 random arrays of up to 30 values below 1 to 64; a checksum of
    // every answer
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 30;
        let top = 1 + next_random(mut seed) % 64;
        for a in smallest_subarrays(values(mut seed, n, top, 4)).iter() {
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
    }
    println(f"2000 random: checksum {check}, total {total}");
}
