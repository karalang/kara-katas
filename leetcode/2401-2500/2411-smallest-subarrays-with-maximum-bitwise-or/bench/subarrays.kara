// LeetCode #2411: Smallest Subarrays With Maximum Bitwise OR -- the bench,
// the ★ arm: walking from the right, the nearest index holding each of the
// 30 bits, the subarray from i reaching the farthest of them.

fn smallest_subarrays(nums: Vec[i64]) -> Vec[i64] {
    let n = nums.len();
    let mut nearest: Vec[i64] = Vec.filled(30, -1);
    let mut answer: Vec[i64] = Vec.filled(n, 1);
    let mut i = n - 1;
    while i >= 0 {
        let mut reach = i;
        for bit in 0..30 {
            if nums[i] >> bit & 1 == 1 {
                nearest[bit] = i;
            }
            reach = reach.max(nearest[bit]);
        }
        answer[i] = reach - i + 1;
        i -= 1;
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 5 arrays of 10^5 values, array i below 2^(6 i + 6); each pass answers
    // them all and folds every length, plus the pass
    let mut seed = 2411;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for i in 0..5 {
        let nums: Vec[i64] = (0..100000).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % (1 << (6 * i + 6))).collect();
        arrays.push(nums);
    }
    let mut check = 0;
    for p in 0..10 {
        for nums in arrays.iter() {
            for a in smallest_subarrays(nums).iter() {
                check = (check * 31 + a + p) % 1000000007;
            }
        }
    }
    println(f"10 passes over 5 arrays of 10^5 values: checksum {check}");
}
