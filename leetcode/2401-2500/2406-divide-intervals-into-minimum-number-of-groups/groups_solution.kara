// LeetCode #2406: Divide Intervals Into Minimum Number of Groups --
// LeetCode's Rust template, as Rust writes it, carried by karac fix: the
// intervals sorted in place, then a `BinaryHeap` of `Reverse` right ends,
// the smallest popped when the next interval starts after it.

struct Solution {}

impl Solution {
    pub fn min_groups(intervals: own Vec[Vec[i32]]) -> i32 {
        let mut intervals = intervals;
        intervals.sort();
        let mut pq = PriorityQueue.new();
        for iv in intervals {
            if let Some(e) = pq.peek().cloned() {
                if e < iv[0] {
                    pq.pop();
                }
            }
            pq.push(iv[1]);
        }
        pq.len() as i32
    }
}

fn min_groups(intervals: Vec[(i64, i64)]) -> i64 {
    let rows: Vec[Vec[i32]] = intervals.iter().map(|iv| [iv.0 as i32, iv.1 as i32].to_vec()).collect();
    Solution.min_groups(rows)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` intervals starting at 1 to `span`, each covering 1 to `longest`
// points.
fn intervals(seed: mut ref i64, count: i64, span: i64, longest: i64) -> Vec[(i64, i64)] {
    (0..count).map(|_| {
        let left = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % span;
        (left, left + (next_random(mut seed) * 32768 + next_random(mut seed)) % longest)
    }).collect()
}

fn main() {
    // LeetCode's two examples; one interval; two sharing an end point; ten
    // copies of one
    println(f"{min_groups([(5, 10), (6, 8), (1, 5), (2, 3), (1, 10)].to_vec())}");
    println(f"{min_groups([(1, 3), (5, 6), (8, 10), (11, 13)].to_vec())}");
    println(f"{min_groups([(1000000, 1000000)].to_vec())}");
    println(f"{min_groups([(1, 2), (2, 3)].to_vec())}");
    let same: Vec[(i64, i64)] = (0..10).map(|_| (4, 7)).collect();
    println(f"{min_groups(same)}");
    // 10^5 intervals up to 10^6, short and then long
    let mut seed = 2406;
    println(f"{min_groups(intervals(mut seed, 100000, 999900, 100))}");
    println(f"{min_groups(intervals(mut seed, 100000, 900000, 100000))}");
    // 2000 random cases of up to 30 intervals within 1 to 60; a checksum of
    // the answers and their total
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let count = 1 + next_random(mut seed) % 30;
        let a = min_groups(intervals(mut seed, count, 40, 1 + next_random(mut seed) % 20));
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"2000 random: checksum {check}, total {total}");
}
