// LeetCode #2406: Divide Intervals Into Minimum Number of Groups -- the
// bench, the ★ arm: the intervals sorted by left end, and a
// `PriorityQueue` of each group's last right end, the smallest first.

fn min_groups(intervals: Vec[(i64, i64)]) -> i64 {
    let mut order = intervals.clone();
    order.sort();
    let mut ends: PriorityQueue[i64] = PriorityQueue.new();
    for (left, right) in order.iter() {
        if ends.len() > 0 and ends.peek().unwrap() < left {
            ends.pop();
        }
        ends.push(right);
    }
    ends.len()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10 sets of 10^5 intervals starting below 9 * 10^5, set i covering up
    // to 1 + 1000 i points; each pass answers them all and folds every
    // answer, plus the pass
    let mut seed = 2406;
    let mut sets: Vec[Vec[(i64, i64)]] = Vec.new();
    for i in 0..10 {
        let iv: Vec[(i64, i64)] = (0..100000).map(|_| {
            let left = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 900000;
            (left, left + (next_random(mut seed) * 32768 + next_random(mut seed)) % (1 + 1000 * i))
        }).collect();
        sets.push(iv);
    }
    let mut check = 0;
    for p in 0..5 {
        for iv in sets.iter() {
            check = (check * 31 + min_groups(iv) + p) % 1000000007;
        }
    }
    println(f"5 passes over 10 sets of 10^5 intervals: checksum {check}");
}
