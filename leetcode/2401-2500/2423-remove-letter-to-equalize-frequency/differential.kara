// LeetCode #2423: Remove Letter To Equalize Frequency -- the differential.
// The six arms against the statement read literally: each index removed
// in turn, and for every letter of the word left, its count found by a
// walk of that whole word; good when every count matches the first. No
// count array kept. 360 cases: 300 random words of 2 to 12 letters from
// the first 1 to 4; then 30 of up to 100 letters from all 26; then 30
// built one letter from equal, a few letters each held the same number
// of times, then one added or taken away, shuffled. Every case is drawn
// before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the letters sorted: the same answer
// P3  every letter renamed to the next, z to a: the same answer
// P4  the word reversed: the same answer
// P5  a letter the word lacks added once, when one is: true whenever
//     every letter of the word is held the same number of times
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn equal_literally(word: String) -> bool {
    let bytes = word.bytes();
    for skip in 0..bytes.len() {
        let left: Vec[u8] = (0..bytes.len()).filter(|i| i != skip).map(|i| bytes[i]).collect();
        let mut first = -1;
        let mut equal = true;
        for c in left.iter() {
            let mut times = 0;
            for d in left.iter() {
                if d == c {
                    times += 1;
                }
            }
            if first < 0 {
                first = times;
            } else if times != first {
                equal = false;
            }
        }
        if equal {
            return true;
        }
    }
    false
}

// ---- star (equalize.kara) ------------------------------------------------

fn star_equal_frequency(word: String) -> bool {
    let mut count: Array[i64, 26] = [0; 26];
    for b in word.bytes().iter() {
        count[b - b'a'] += 1;
    }
    for c in 0..26 {
        if count[c] == 0 {
            continue;
        }
        count[c] -= 1;
        let mut want = 0;
        let mut equal = true;
        for k in 0..26 {
            if count[k] > 0 {
                if want == 0 {
                    want = count[k];
                } else if count[k] != want {
                    equal = false;
                }
            }
        }
        count[c] += 1;
        if equal {
            return true;
        }
    }
    false
}

// ---- naive (equalize_naive.kara) -----------------------------------------

fn naive_equal_frequency(word: String) -> bool {
    let bytes = word.bytes();
    for skip in 0..bytes.len() {
        let mut count: Map[u8, i64] = Map.new();
        for i in 0..bytes.len() {
            if i != skip {
                count[bytes[i]] = count.get(bytes[i]).unwrap_or(0) + 1;
            }
        }
        let counts: Vec[i64] = count.values().collect();
        if counts.iter().all(|c| c == counts[0]) {
            return true;
        }
    }
    false
}

// ---- cases (equalize_cases.kara) -----------------------------------------

fn cases_equal_frequency(word: String) -> bool {
    let mut count: Vec[i64] = Vec.filled(26, 0);
    for b in word.bytes().iter() {
        count[b - b'a'] += 1;
    }
    let mut held: Vec[i64] = count.iter().filter(|c| c > 0).collect();
    held.sort();
    let k = held.len();
    let lo = held[0];
    let hi = held[k - 1];
    if k == 1 or hi == 1 {
        return true;
    }
    // one letter once, the rest all hi
    if lo == 1 and held[1] == hi {
        return true;
    }
    // one letter at hi, the rest all hi - 1
    hi == lo + 1 and held[k - 2] == lo
}

// ---- map (equalize_map.kara) ---------------------------------------------

fn map_equal_frequency(word: String) -> bool {
    let mut count: Map[char, i64] = Map.new();
    for c in word.chars() {
        count[c] = count.get(c).unwrap_or(0) + 1;
    }
    let mut holders: Map[i64, i64] = Map.new();
    for (_, n) in count.iter() {
        holders[n] = holders.get(n).unwrap_or(0) + 1;
    }
    for (_, n) in count.iter() {
        let mut after = holders.clone();
        after[n] -= 1;
        if after[n] == 0 {
            after.remove(n);
        }
        if n > 1 {
            after[n - 1] = after.get(n - 1).unwrap_or(0) + 1;
        }
        if after.len() == 1 {
            return true;
        }
    }
    false
}

// ---- iter (equalize_iter.kara) -------------------------------------------

fn iter_equal_frequency(word: String) -> bool {
    let count: Vec[i64] = word.bytes().iter().fold(Vec.filled(26, 0), |acc, b| {
        let mut acc = acc;
        acc[b - b'a'] += 1;
        acc
    });
    (0..26).filter(|c| count[c] > 0).any(|c| {
        let left: Vec[i64] = (0..26).map(|k| if k == c { count[k] - 1 } else { count[k] }).filter(|n| n > 0).collect();
        left.iter().all(|n| n == left[0])
    })
}

// ---- solution (equalize_solution.kara) -----------------------------------

impl Solution {
    pub fn equal_frequency(word: String) -> bool {
        let mut cnt = [0; 26];
        for c in word.chars() {
            cnt[(c as u32 as u8 - b'a') as usize] += 1;
        }
        for i in 0..26 {
            if cnt[i] == 0 {
                continue;
            }
            cnt[i] -= 1;
            let set: Set[i32] = cnt.iter().filter(|x| x > 0).cloned().collect();
            if set.len() <= 1 {
                return true;
            }
            cnt[i] += 1;
        }
        false
    }
}

struct Solution {}

fn solution_equal_frequency(word: String) -> bool {
    Solution.equal_frequency(word)
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, word: Slice[u8]) -> bool {
    let word = String.from_utf8(word.to_vec()).unwrap();
    match arm {
        0 => star_equal_frequency(word),
        1 => naive_equal_frequency(word),
        2 => cases_equal_frequency(word),
        3 => map_equal_frequency(word),
        4 => iter_equal_frequency(word),
        _ => solution_equal_frequency(word),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arms = ["star", "naive", "cases", "map", "iter", "solution"];
    let mut seed = 2423;
    let mut cases: Vec[Vec[u8]] = Vec.new();
    for t in 0..360 {
        let mut bytes: Vec[u8] = Vec.new();
        if t < 330 {
            let (n, kinds) = if t < 300 {
                (2 + next_random(mut seed) % 11, 1 + next_random(mut seed) % 4)
            } else {
                (2 + next_random(mut seed) % 99, 26)
            };
            for _ in 0..n {
                bytes.push(b'a' + (next_random(mut seed) % kinds) as u8);
            }
        } else {
            let kinds = 1 + next_random(mut seed) % 5;
            let times = 1 + next_random(mut seed) % 4;
            for k in 0..kinds {
                for _ in 0..times {
                    bytes.push(b'a' + k as u8);
                }
            }
            if next_random(mut seed) % 2 == 0 {
                bytes.push(b'a' + (next_random(mut seed) % (kinds + 1)) as u8);
            } else {
                let at = next_random(mut seed) % bytes.len();
                bytes.remove(at);
            }
            for i in (1..bytes.len()).rev() {
                let j = next_random(mut seed) % (i + 1);
                bytes.swap(i, j);
            }
            while bytes.len() < 2 {
                bytes.push(b'a');
            }
        }
        cases.push(bytes);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let bytes = cases[c].clone();
        let truth = equal_literally(String.from_utf8(bytes.clone()).unwrap());
        check = (check * 2 + if truth { 1 } else { 0 }) % 1000000007;
        let mut sorted = bytes.clone();
        sorted.sort();
        let renamed: Vec[u8] = bytes.iter().map(|b| if b == b'z' { b'a' } else { b + 1 }).collect();
        let mut back = bytes.clone();
        back.reverse();
        let mut held: Vec[i64] = Vec.filled(26, 0);
        for b in bytes.iter() {
            held[b - b'a'] += 1;
        }
        let counts: Vec[i64] = held.iter().filter(|h| h > 0).collect();
        let level = counts.iter().all(|h| h == counts[0]);
        let mut lacking = 0;
        while lacking < 26 and held[lacking] > 0 {
            lacking += 1;
        }
        let mut grown = bytes.clone();
        grown.push(b'a' + lacking.min(25) as u8);
        let got: Vec[bool] = (0..6).map(|arm| answer(arm, bytes)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, sorted) == value,
                answer(arm, renamed) == value,
                answer(arm, back) == value,
                not level or lacking == 26 or answer(arm, grown),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
