// LeetCode #2423: Remove Letter To Equalize Frequency -- the bench, the ★
// arm: the 26 letter counts, each held letter taken away once in turn and
// the counts left that are not zero compared.

fn equal_frequency(word: String) -> bool {
    let mut count: Array[i64, 26] = [0; 26];
    for b in word.bytes().iter() {
        count[b - b'a'] += 1;
    }
    for c in 0..26 {
        if count[c] == 0 {
            continue;
        }
        count[c] -= 1;
        let mut want = 0;
        let mut equal = true;
        for k in 0..26 {
            if count[k] > 0 {
                if want == 0 {
                    want = count[k];
                } else if count[k] != want {
                    equal = false;
                }
            }
        }
        count[c] += 1;
        if equal {
            return true;
        }
    }
    false
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10^4 words, each 1 to 20 letters held 1 to 5 times each, then one
    // letter added or taken away and the letters shuffled, built once;
    // each pass answers every word and folds the answer and the pass
    let mut seed = 2423;
    let mut words: Vec[String] = Vec.new();
    for _ in 0..10000 {
        let kinds = 1 + next_random(mut seed) % 20;
        let times = 1 + next_random(mut seed) % 5;
        let mut bytes: Vec[u8] = Vec.new();
        for k in 0..kinds {
            for _ in 0..times {
                bytes.push(b'a' + k as u8);
            }
        }
        if next_random(mut seed) % 2 == 0 {
            bytes.push(b'a' + (next_random(mut seed) % 26) as u8);
        } else {
            let at = next_random(mut seed) % bytes.len();
            bytes.remove(at);
        }
        for i in (1..bytes.len()).rev() {
            let j = next_random(mut seed) % (i + 1);
            bytes.swap(i, j);
        }
        while bytes.len() < 2 {
            bytes.push(b'a');
        }
        words.push(String.from_utf8(bytes).unwrap());
    }
    let mut check = 0;
    for p in 0..200 {
        for w in words.iter() {
            check = (check * 3 + if equal_frequency(w) { 1 } else { 0 } + p) % 1000000007;
        }
    }
    println(f"200 passes over 10^4 words: checksum {check}");
}
