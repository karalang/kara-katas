// LeetCode #2476: Closest Nodes Queries in a Binary Search Tree -- an
// ordered map: every value of the tree put in a `SortedMap` by a walk of
// any order, then each query answered by its `floor` and `ceiling`, the
// largest key at most it and the smallest at least it. O((n + q) log n).

fn gather(node: Option[TreeNode], into: mut ref SortedMap[i64, bool]) {
    if let Some(n) = node {
        into.insert(n.val, true);
        gather(n.left, mut into);
        gather(n.right, mut into);
    }
}

fn closest_nodes(root: Option[TreeNode], queries: Vec[i64]) -> Vec[Vec[i64]] {
    let mut keys: SortedMap[i64, bool] = SortedMap.new();
    gather(root, mut keys);
    let mut answers: Vec[Vec[i64]] = Vec.new();
    for q in queries.iter() {
        let floor = match keys.floor(q) {
            Some((k, _)) => k,
            None => -1,
        };
        let ceiling = match keys.ceiling(q) {
            Some((k, _)) => k,
            None => -1,
        };
        answers.push([floor, ceiling].to_vec());
    }
    answers
}

// ---- test harness ---------------------------------------------------------

// LeetCode's own node: an `i32` value
shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v as i32, left: None, right: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw up to 2^30, two 15-bit draws joined
fn wide_random(seed: mut ref i64) -> i64 {
    let high = next_random(mut seed);
    high * 32768 + next_random(mut seed)
}

// LeetCode's level-order form, "[1,2,null,3]": each node's two children
// come next, in the order the nodes were met, "null" for none.
fn parse(text: Str) -> Option[TreeNode] {
    let inner = text.strip_prefix("[").unwrap().strip_suffix("]").unwrap();
    let items: Vec[Option[i64]] = inner.split(",").map(|s| if s == "null" { None } else { Some(i64.parse(s).unwrap()) }).collect();
    let root = leaf(items[0].unwrap());
    let mut queue: Vec[TreeNode] = [root].to_vec();
    let mut head = 0;
    let mut i = 1;
    while i < items.len() {
        let node = queue[head];
        head += 1;
        if let Some(v) = items[i] {
            let child = leaf(v);
            node.left = Some(child);
            queue.push(child);
        }
        i += 1;
        if i < items.len() {
            if let Some(v) = items[i] {
                let child = leaf(v);
                node.right = Some(child);
                queue.push(child);
            }
            i += 1;
        }
    }
    Some(root)
}

// the search tree the distinct `values` make, inserted in their order
fn search_tree(values: Vec[i64]) -> Option[TreeNode] {
    let root = leaf(values[0]);
    for k in 1..values.len() {
        let v = values[k];
        let mut at = root;
        loop {
            if v < at.val {
                match at.left {
                    Some(c) => at = c,
                    None => {
                        at.left = Some(leaf(v));
                        break;
                    }
                }
            } else {
                match at.right {
                    Some(c) => at = c,
                    None => {
                        at.right = Some(leaf(v));
                        break;
                    }
                }
            }
        }
    }
    Some(root)
}

// `n` distinct random values from 1 to `top`, in the order drawn
fn distinct_values(n: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let mut used: Set[i64] = Set.new();
    let mut values: Vec[i64] = Vec.new();
    while values.len() < n {
        let v = 1 + wide_random(mut seed) % top;
        if not used.contains(v) {
            used.insert(v);
            values.push(v);
        }
    }
    values
}

// the answers folded in order, each pair raised by 1 so a -1 counts
fn fold(answers: Vec[Vec[i64]]) -> i64 {
    let mut check = answers.len();
    for pair in answers.iter() {
        check = (check * 31 + pair[0] + 1) % 1000000007;
        check = (check * 31 + pair[1] + 1) % 1000000007;
    }
    check
}

fn main() {
    // LeetCode's two examples; then two nodes asked below, on, between
    // and above them; and a left path asked below, on and above it
    let examples: Vec[(Str, Vec[i64])] = [
        ("[6,2,13,1,4,9,15,null,null,null,null,null,null,14]", [2, 5, 16].to_vec()),
        ("[4,null,9]", [3].to_vec()),
        ("[10,null,20]", [1, 10, 15, 20, 25].to_vec()),
        ("[5,4,null,3,null,2]", [1, 2, 3, 4, 5, 6].to_vec()),
    ].to_vec();
    for (text, queries) in examples.into_iter() {
        let shown = f"{queries}";
        println(f"{text}, {shown} -> {closest_nodes(parse(text), queries)}");
    }
    // the constraints' largest, 10^5 nodes from 1 to 10^6 asked 10^4
    // random values; then a path of 2000 nodes, made by inserting in
    // order, asked 10^4: each as a checksum of its answers
    let mut seed = 2476;
    let big = search_tree(distinct_values(100000, 1000000, mut seed));
    let asked: Vec[i64] = (0..10000).map(|_| 1 + wide_random(mut seed) % 1000000).collect();
    println(f"10^5 nodes, 10^4 queries: checksum {fold(closest_nodes(big, asked))}");
    let path = search_tree((1..2001).map(|i| 500 * i).collect());
    let along: Vec[i64] = (0..10000).map(|_| 1 + wide_random(mut seed) % 1000000).collect();
    println(f"a path of 2000, 10^4 queries: checksum {fold(closest_nodes(path, along))}");
    // 2000 random trees of 2 to 40 nodes from 1 to 60, each asked 1 to
    // 10 values from 1 to 61: a checksum of every answer's checksum
    let mut check = 0;
    for _ in 0..2000 {
        let n = 2 + next_random(mut seed) % 39;
        let root = search_tree(distinct_values(n, 60, mut seed));
        let q = 1 + next_random(mut seed) % 10;
        let queries: Vec[i64] = (0..q).map(|_| 1 + next_random(mut seed) % 61).collect();
        check = (check * 31 + fold(closest_nodes(root, queries))) % 1000000007;
    }
    println(f"2000 random: checksum {check}");
}
