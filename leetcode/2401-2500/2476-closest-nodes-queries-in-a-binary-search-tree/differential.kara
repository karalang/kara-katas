// LeetCode #2476: Closest Nodes Queries in a Binary Search Tree -- the
// differential. The six arms against the statement read literally: for
// each query, every node of the tree visited, breadth first, keeping
// the largest value at most the query and the smallest at least it, -1
// where there is none. 360 random search trees, each built by inserting
// distinct values in a random order: 300 of 2 to 12 nodes from 1 to 30
// asked 1 to 6 values from 1 to 31, then 60 of up to 30 nodes from 1 to
// 100 asked up to 12 from 1 to 101. Every case is drawn before any arm
// answers.
//
// P1  the answers are the literal reading's
// P2  the tree mirrored, every value `v` written `1000 - v` and every
//     query `q` asked as `1000 - q`: each pair swapped and written the
//     same way, a -1 kept
// P3  every value of the tree asked: each answered by itself twice
// P4  every value `v` written `2v` and every query `q` asked as `2q + 1`:
//     the largest at most it twice the one for `q`, and the smallest at
//     least it twice the literal reading's for `q + 1`
// P5  999 inserted: every -1 that stood for the smallest at least a
//     query becomes 999, and nothing else changes
// P6  each arm agrees with at least three of the other five

// LeetCode's own node: an `i32` value
shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v as i32, left: None, right: None }
}

// ---- the statement read literally ------------------------------------------

fn closest_literally(root: Option[TreeNode], queries: Vec[i64]) -> Vec[Vec[i64]] {
    let mut answers: Vec[Vec[i64]] = Vec.new();
    for q in queries.iter() {
        let mut floor = -1;
        let mut ceiling = -1;
        let mut level: Vec[TreeNode] = Vec.new();
        if let Some(r) = root {
            level.push(r);
        }
        while level.len() > 0 {
            let mut next: Vec[TreeNode] = Vec.new();
            for n in level.iter() {
                let v = n.val as i64;
                if v <= q and v > floor {
                    floor = v;
                }
                if v >= q and (ceiling == -1 or v < ceiling) {
                    ceiling = v;
                }
                if let Some(c) = n.left {
                    next.push(c);
                }
                if let Some(c) = n.right {
                    next.push(c);
                }
            }
            level = next;
        }
        answers.push([floor, ceiling].to_vec());
    }
    answers
}

// a copy of the tree, mirrored with every value `v` written `1000 - v`
// if `mirror`, else as it is
fn copy(node: Option[TreeNode], mirror: bool) -> Option[TreeNode] {
    match node {
        None => None,
        Some(n) => {
            let made = leaf(if mirror { 1000 - n.val } else { n.val });
            let left = copy(n.left, mirror);
            let right = copy(n.right, mirror);
            if mirror {
                made.left = right;
                made.right = left;
            } else {
                made.left = left;
                made.right = right;
            }
            Some(made)
        }
    }
}

// a copy of the tree, every value doubled
fn doubled(node: Option[TreeNode]) -> Option[TreeNode] {
    match node {
        None => None,
        Some(n) => {
            let made = leaf(2 * n.val);
            made.left = doubled(n.left);
            made.right = doubled(n.right);
            Some(made)
        }
    }
}

// `v` put into the search tree below `root`
fn insert(root: TreeNode, v: i64) {
    let mut at = root;
    loop {
        if v < at.val {
            match at.left {
                Some(c) => at = c,
                None => {
                    at.left = Some(leaf(v));
                    break;
                }
            }
        } else {
            match at.right {
                Some(c) => at = c,
                None => {
                    at.right = Some(leaf(v));
                    break;
                }
            }
        }
    }
}

// ---- star (closest.kara) -------------------------------------------------

fn star_walk(node: Option[TreeNode], values: mut ref Vec[i64]) {
    if let Some(n) = node {
        star_walk(n.left, mut values);
        values.push(n.val);
        star_walk(n.right, mut values);
    }
}

fn star_closest_nodes(root: Option[TreeNode], queries: Vec[i64]) -> Vec[Vec[i64]] {
    let mut values: Vec[i64] = Vec.new();
    star_walk(root, mut values);
    let mut answers: Vec[Vec[i64]] = Vec.new();
    for q in queries.iter() {
        // the first place holding a value at least `q`
        let mut lo = 0;
        let mut hi = values.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if values[mid] < q {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        let ceiling = if lo < values.len() { values[lo] } else { -1 };
        let floor = if lo < values.len() and values[lo] == q {
            q
        } else if lo > 0 {
            values[lo - 1]
        } else {
            -1
        };
        answers.push([floor, ceiling].to_vec());
    }
    answers
}

// ---- walk (closest_walk.kara) --------------------------------------------

fn walk_closest_nodes(root: Option[TreeNode], queries: Vec[i64]) -> Vec[Vec[i64]] {
    let mut answers: Vec[Vec[i64]] = Vec.new();
    for q in queries.iter() {
        let mut floor = -1;
        let mut ceiling = -1;
        let mut at = root;
        while let Some(n) = at {
            let v = n.val as i64;
            if v == q {
                floor = v;
                ceiling = v;
                break;
            } else if v < q {
                floor = v;
                at = n.right;
            } else {
                ceiling = v;
                at = n.left;
            }
        }
        answers.push([floor, ceiling].to_vec());
    }
    answers
}

// ---- ordered (closest_ordered.kara) --------------------------------------

fn ordered_gather(node: Option[TreeNode], into: mut ref SortedMap[i64, bool]) {
    if let Some(n) = node {
        into.insert(n.val, true);
        ordered_gather(n.left, mut into);
        ordered_gather(n.right, mut into);
    }
}

fn ordered_closest_nodes(root: Option[TreeNode], queries: Vec[i64]) -> Vec[Vec[i64]] {
    let mut keys: SortedMap[i64, bool] = SortedMap.new();
    ordered_gather(root, mut keys);
    let mut answers: Vec[Vec[i64]] = Vec.new();
    for q in queries.iter() {
        let floor = match keys.floor(q) {
            Some((k, _)) => k,
            None => -1,
        };
        let ceiling = match keys.ceiling(q) {
            Some((k, _)) => k,
            None => -1,
        };
        answers.push([floor, ceiling].to_vec());
    }
    answers
}

// ---- stack (closest_stack.kara) ------------------------------------------

fn stack_closest_nodes(root: Option[TreeNode], queries: Vec[i64]) -> Vec[Vec[i64]] {
    let mut values: Vec[i64] = Vec.new();
    let mut stack: Vec[TreeNode] = Vec.new();
    let mut at = root;
    loop {
        while let Some(n) = at {
            stack.push(n);
            at = n.left;
        }
        match stack.pop() {
            Some(n) => {
                values.push(n.val);
                at = n.right;
            }
            None => break,
        }
    }
    let mut answers: Vec[Vec[i64]] = Vec.new();
    for q in queries.iter() {
        let pair = {
            let i = values.partition_point(|y| y < q);
            if i < values.len() and values[i] == q {
                [q, q].to_vec()
            } else {
                let floor = if i > 0 {
                    values[i - 1]
                } else {
                    -1
                };
                let ceiling = if i < values.len() {
                    values[i]
                } else {
                    -1
                };
                [floor, ceiling].to_vec()
            }
        };
        answers.push(pair);
    }
    answers
}

// ---- iter (closest_iter.kara) --------------------------------------------

fn iter_in_order(node: Option[TreeNode]) -> Vec[i64] {
    match node {
        None => Vec.new(),
        Some(n) => {
            let mut values = iter_in_order(n.left);
            values.push(n.val);
            values.extend(iter_in_order(n.right));
            values
        }
    }
}

fn iter_closest_nodes(root: Option[TreeNode], queries: Vec[i64]) -> Vec[Vec[i64]] {
    let values = iter_in_order(root);
    queries.iter().map(|q| {
        let i = values.partition_point(|v| v < q);
        let ceiling = values.get(i).cloned().unwrap_or(-1);
        let floor = if ceiling == q { q } else if i > 0 { values[i - 1] } else { -1 };
        [floor, ceiling].to_vec()
    }).collect()
}

// ---- solution (closest_solution.kara) ------------------------------------

fn solution_inorder(node: Option[TreeNode], out: mut ref Vec[i32]) {
    if let Some(n) = node {
        solution_inorder(n.left, mut out);
        out.push(n.val);
        solution_inorder(n.right, mut out);
    }
}

impl Solution {
    pub fn closest_nodes(root: Option[TreeNode], queries: Vec[i32]) -> Vec[Vec[i32]] {
        let mut vals = Vec.new();
        solution_inorder(root, mut vals);
        queries
            .iter()
            .map(|q| {
                let i = vals.partition_point(|v| v < q);
                let max = if i < vals.len() { vals[i] } else { -1 };
                let min = if i < vals.len() and vals[i] == q {
                    q
                } else if i > 0 {
                    vals[i - 1]
                } else {
                    -1
                };
                [min, max]
            })
            .collect()
    }
}

struct Solution {}

fn solution_closest_nodes(root: Option[TreeNode], queries: Vec[i64]) -> Vec[Vec[i64]] {
    let asked: Vec[i32] = queries.iter().map(|v| v as i32).collect();
    let got = Solution.closest_nodes(root, asked);
    got.iter().map(|pair| pair.iter().map(|v| v as i64).collect()).collect()
}

// ---- the differential -------------------------------------------------------

fn answer(arm: i64, root: Option[TreeNode], queries: Vec[i64]) -> Vec[Vec[i64]] {
    match arm {
        0 => star_closest_nodes(root, queries),
        1 => walk_closest_nodes(root, queries),
        2 => ordered_closest_nodes(root, queries),
        3 => stack_closest_nodes(root, queries),
        4 => iter_closest_nodes(root, queries),
        _ => solution_closest_nodes(root, queries),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn values_of(node: Option[TreeNode], into: mut ref Vec[i64]) {
    if let Some(n) = node {
        into.push(n.val);
        values_of(n.left, mut into);
        values_of(n.right, mut into);
    }
}

fn main() {
    let arms = ["star", "walk", "ordered", "stack", "iter", "solution"];
    let mut seed = 2476;
    let mut cases: Vec[(Option[TreeNode], Vec[i64])] = Vec.new();
    for t in 0..360 {
        let (most, top, asks) = if t < 300 { (11, 30, 6) } else { (29, 100, 12) };
        let n = 2 + next_random(mut seed) % most;
        let mut used: Set[i64] = Set.new();
        let mut order: Vec[i64] = Vec.new();
        while order.len() < n {
            let v = 1 + next_random(mut seed) % top;
            if not used.contains(v) {
                used.insert(v);
                order.push(v);
            }
        }
        let root = leaf(order[0]);
        for k in 1..n {
            insert(root, order[k]);
        }
        let q = 1 + next_random(mut seed) % asks;
        let queries: Vec[i64] = (0..q).map(|_| 1 + next_random(mut seed) % (top + 1)).collect();
        cases.push((Some(root), queries));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (root, queries) = cases[c].clone();
        let truth = closest_literally(root, queries);
        for pair in truth.iter() {
            check = (check * 31 + pair[0] + 1) % 1000000007;
            check = (check * 31 + pair[1] + 1) % 1000000007;
        }
        let got: Vec[Vec[Vec[i64]]] = (0..6).map(|arm| answer(arm, copy(root, false), queries)).collect();
        let flipped: Vec[i64] = queries.iter().map(|q| 1000 - q).collect();
        let mut values: Vec[i64] = Vec.new();
        values_of(root, mut values);
        let selves: Vec[Vec[i64]] = values.iter().map(|v| [v, v].to_vec()).collect();
        let odd: Vec[i64] = queries.iter().map(|q| 2 * q + 1).collect();
        let above: Vec[i64] = queries.iter().map(|q| q + 1).collect();
        let strictly = closest_literally(root, above);
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let mirrored: Vec[Vec[i64]] = value.iter().map(|p| {
                let low = if p[1] == -1 { -1 } else { 1000 - p[1] };
                let high = if p[0] == -1 { -1 } else { 1000 - p[0] };
                [low, high].to_vec()
            }).collect();
            let twice: Vec[Vec[i64]] = (0..value.len()).map(|i| {
                let low = if value[i][0] == -1 { -1 } else { 2 * value[i][0] };
                let high = if strictly[i][1] == -1 { -1 } else { 2 * strictly[i][1] };
                [low, high].to_vec()
            }).collect();
            let raised: Vec[Vec[i64]] = value.iter().map(|p| [p[0], if p[1] == -1 { 999 } else { p[1] }].to_vec()).collect();
            let grown = copy(root, false);
            insert(grown.unwrap(), 999);
            let verdicts = [
                value == truth,
                answer(arm, copy(root, true), flipped) == mirrored,
                answer(arm, copy(root, false), values) == selves,
                answer(arm, doubled(root), odd) == twice,
                answer(arm, grown, queries) == raised,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
