// LeetCode #2415: Reverse Odd Levels of Binary Tree -- the differential. The
// six arms against the statement read literally: a walk down the tree
// gathers every level's values from left to right, each odd level's list
// is reversed, and the lists are read off in order. No mirror pairs and no
// level-order positions. 360 cases: 300 random perfect trees of 0 to 6
// levels below the root, values below 1 to 50; 30 of up to 12 levels,
// values up to 10^5; and 30 of up to 12 levels, values below 4. Every case
// is drawn before any arm answers.
//
// P1  the answer, read in level order, is the literal reading's
// P2  the arm run again on its own answer: the original tree
// P3  the tree mirrored, every level reversed: the answer mirrored
// P4  every value raised by 7: every value of the answer raised by 7
// P5  every even level as it was, and every odd level holding the same
//     values, sorted, as before
// P6  each arm agrees with at least three of the other five

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

// ---- the statement read literally ------------------------------------------

fn gather(node: Option[TreeNode], depth: i64, rows: mut ref Vec[Vec[i64]]) {
    if let Some(n) = node {
        if rows.len() == depth {
            rows.push(Vec.new());
        }
        rows[depth].push(n.val);
        gather(n.left, depth + 1, mut rows);
        gather(n.right, depth + 1, mut rows);
    }
}

fn reversed_literally(values: Slice[i64]) -> Vec[i64] {
    let mut rows: Vec[Vec[i64]] = Vec.new();
    gather(build(values), 0, mut rows);
    let mut out: Vec[i64] = Vec.new();
    for d in 0..rows.len() {
        let mut row = rows[d].clone();
        if d % 2 == 1 {
            row.reverse();
        }
        out.extend(row);
    }
    out
}

// ---- star (reverse.kara) -------------------------------------------------

fn star_swap_pairs(a: Option[TreeNode], b: Option[TreeNode], odd: bool) {
    if let (Some(x), Some(y)) = (a, b) {
        if odd {
            let t = x.val;
            x.val = y.val;
            y.val = t;
        }
        star_swap_pairs(x.left, y.right, not odd);
        star_swap_pairs(x.right, y.left, not odd);
    }
}

fn star_reverse_odd_levels(root: Option[TreeNode]) -> Option[TreeNode] {
    if let Some(r) = root {
        star_swap_pairs(r.left, r.right, true);
    }
    root
}

// ---- bfs (reverse_bfs.kara) ----------------------------------------------

fn bfs_reverse_odd_levels(root: Option[TreeNode]) -> Option[TreeNode] {
    let mut level: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        level.push(r);
    }
    let mut odd = false;
    while level.len() > 0 {
        if odd {
            let n = level.len();
            for i in 0..n / 2 {
                let t = level[i].val;
                level[i].val = level[n - 1 - i].val;
                level[n - 1 - i].val = t;
            }
        }
        let mut next: Vec[TreeNode] = Vec.new();
        for node in level.iter() {
            if let Some(l) = node.left {
                next.push(l);
            }
            if let Some(r) = node.right {
                next.push(r);
            }
        }
        level = next;
        odd = not odd;
    }
    root
}

// ---- array (reverse_array.kara) ------------------------------------------

fn array_reverse_odd_levels(root: Option[TreeNode]) -> Option[TreeNode] {
    let mut nodes: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        nodes.push(r);
    }
    let mut i = 0;
    while i < nodes.len() {
        let node = nodes[i];
        if let Some(l) = node.left {
            nodes.push(l);
        }
        if let Some(r) = node.right {
            nodes.push(r);
        }
        i += 1;
    }
    let mut values: Vec[i32] = nodes.iter().map(|n| n.val).collect();
    let mut start = 1;
    let mut width = 2;
    while start < values.len() {
        values[start..start + width].reverse();
        start += 3 * width;
        width *= 4;
    }
    for k in 0..nodes.len() {
        nodes[k].val = values[k];
    }
    root
}

// ---- stack (reverse_stack.kara) ------------------------------------------

fn stack_reverse_odd_levels(root: Option[TreeNode]) -> Option[TreeNode] {
    let mut stack: Vec[(TreeNode, TreeNode, i64)] = Vec.new();
    if let Some(r) = root {
        if let (Some(a), Some(b)) = (r.left, r.right) {
            stack.push((a, b, 1));
        }
    }
    while let Some((a, b, depth)) = stack.pop() {
        if depth % 2 == 1 {
            let t = a.val;
            a.val = b.val;
            b.val = t;
        }
        if let (Some(al), Some(br)) = (a.left, b.right) {
            stack.push((al, br, depth + 1));
        }
        if let (Some(ar), Some(bl)) = (a.right, b.left) {
            stack.push((ar, bl, depth + 1));
        }
    }
    root
}

// ---- iter (reverse_iter.kara) --------------------------------------------

fn iter_reverse_odd_levels(root: Option[TreeNode]) -> Option[TreeNode] {
    let mut level: Vec[TreeNode] = root.iter().collect();
    let mut odd = false;
    while not level.is_empty() {
        if odd {
            let values: Vec[i32] = level.iter().map(|n| n.val).collect();
            for (node, v) in level.iter().zip(values.iter().rev()) {
                node.val = v;
            }
        }
        level = level.iter().flat_map(|n| n.left.iter().chain(n.right.iter())).collect();
        odd = not odd;
    }
    root
}

// ---- solution (reverse_solution.kara) ------------------------------------

fn solution_dfs(a: Option[TreeNode], b: Option[TreeNode], odd: bool) {
    if let (Some(a), Some(b)) = (a, b) {
        if odd {
            let t = a.val;
            a.val = b.val;
            b.val = t;
        }
        solution_dfs(a.left.clone(), b.right.clone(), not odd);
        solution_dfs(a.right.clone(), b.left.clone(), not odd);
    }
}

impl Solution {
    pub fn reverse_odd_levels(root: Option[TreeNode]) -> Option[TreeNode] {
        if let Some(r) = root.clone() {
            solution_dfs(r.left.clone(), r.right.clone(), true);
        }
        root
    }
}

struct Solution {}

fn solution_reverse_odd_levels(root: Option[TreeNode]) -> Option[TreeNode] {
    Solution.reverse_odd_levels(root)
}

// ---- the differential -----------------------------------------------------

fn run(arm: i64, root: Option[TreeNode]) -> Option[TreeNode] {
    match arm {
        0 => star_reverse_odd_levels(root),
        1 => bfs_reverse_odd_levels(root),
        2 => array_reverse_odd_levels(root),
        3 => stack_reverse_odd_levels(root),
        4 => iter_reverse_odd_levels(root),
        _ => solution_reverse_odd_levels(root),
    }
}

fn answer(arm: i64, values: Slice[i64]) -> Vec[i64] {
    levels(run(arm, build(values)))
}

// The perfect tree whose level order is `values`: node i's children are
// nodes 2 i + 1 and 2 i + 2.
fn build(values: Slice[i64]) -> Option[TreeNode] {
    let nodes: Vec[TreeNode] = values.iter().map(|v| TreeNode {
        val: v as i32,
        left: None,
        right: None,
    }).collect();
    for i in 0..nodes.len() / 2 {
        nodes[i].left = Some(nodes[2 * i + 1]);
        nodes[i].right = Some(nodes[2 * i + 2]);
    }
    Some(nodes[0])
}

// The tree's values in level order.
fn levels(root: Option[TreeNode]) -> Vec[i64] {
    let mut queue: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        queue.push(r);
    }
    let mut head = 0;
    while head < queue.len() {
        let node = queue[head];
        head += 1;
        if let Some(l) = node.left {
            queue.push(l);
        }
        if let Some(r) = node.right {
            queue.push(r);
        }
    }
    queue.iter().map(|n| n.val as i64).collect()
}

// Every level of a level-order list reversed: the mirrored tree.
fn mirrored(values: Slice[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut start = 0;
    let mut width = 1;
    while start < values.len() {
        let mut row = values[start..start + width].to_vec();
        row.reverse();
        out.extend(row);
        start += width;
        width *= 2;
    }
    out
}

// Whether `got` keeps `values`' even levels and holds each odd level's
// values, sorted, as `values` does.
fn same_levels(values: Slice[i64], got: Slice[i64]) -> bool {
    if got.len() != values.len() {
        return false;
    }
    let mut start = 0;
    let mut width = 1;
    let mut depth = 0;
    while start < values.len() {
        let mut a = values[start..start + width].to_vec();
        let mut b = got[start..start + width].to_vec();
        if depth % 2 == 1 {
            a.sort();
            b.sort();
        }
        if a != b {
            return false;
        }
        start += width;
        width *= 2;
        depth += 1;
    }
    true
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn digest(values: Slice[i64]) -> i64 {
    let mut h = 0;
    for v in values.iter() {
        h = (h * 31 + v) % 1000000007;
    }
    h
}

fn main() {
    let names = ["star", "bfs", "array", "stack", "iter", "solution"];
    let mut seed = 2415;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for t in 0..360 {
        let (depth, top) = if t < 300 {
            (next_random(mut seed) % 7, 1 + next_random(mut seed) % 50)
        } else if t < 330 {
            (1 + next_random(mut seed) % 12, 100001)
        } else {
            (1 + next_random(mut seed) % 12, 4)
        };
        let values: Vec[i64] = (0..(1 << depth + 1) - 1).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % top).collect();
        cases.push(values);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let values = cases[c].clone();
        let truth = reversed_literally(values);
        check = (check * 31 + digest(truth)) % 1000000007;
        let mirror = mirrored(values);
        let raised: Vec[i64] = values.iter().map(|v| v + 7).collect();
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, values)).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let shifted: Vec[i64] = value.iter().map(|v| v + 7).collect();
            let verdicts = [value == truth, answer(arm, value) == values, answer(arm, mirror) == mirrored(value), answer(arm, raised) == shifted, same_levels(values, value), same >= 3];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
