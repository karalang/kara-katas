// LeetCode #2415: Reverse Odd Levels of Binary Tree -- the bench, the ★
// arm: mirror pairs walked down together, the values of each pair on an
// odd level swapped.

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn swap_pairs(a: Option[TreeNode], b: Option[TreeNode], odd: bool) {
    if let (Some(x), Some(y)) = (a, b) {
        if odd {
            let t = x.val;
            x.val = y.val;
            y.val = t;
        }
        swap_pairs(x.left, y.right, not odd);
        swap_pairs(x.right, y.left, not odd);
    }
}

fn reverse_odd_levels(root: Option[TreeNode]) -> Option[TreeNode] {
    if let Some(r) = root {
        swap_pairs(r.left, r.right, true);
    }
    root
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// The value at the end of the walk that takes the left child while `left`
// holds, and the right one otherwise.
fn edge(root: TreeNode, left: bool) -> i64 {
    let mut at = root;
    loop {
        let next = if left {
            at.left
        } else {
            at.right
        };
        match next {
            Some(c) => at = c,
            None => return at.val,
        }
    }
}

fn main() {
    // 10 perfect trees of 2^14 - 1 nodes, values below 10^5; each pass
    // reverses every tree in place and folds its two leftmost and two
    // rightmost values, plus the pass
    let mut seed = 2415;
    let mut roots: Vec[TreeNode] = Vec.new();
    for _ in 0..10 {
        let nodes: Vec[TreeNode] = (0..16383).map(|_| TreeNode {
            val: ((next_random(mut seed) * 32768 + next_random(mut seed)) % 100000) as i32,
            left: None,
            right: None,
        }).collect();
        for i in 0..8191 {
            nodes[i].left = Some(nodes[2 * i + 1]);
            nodes[i].right = Some(nodes[2 * i + 2]);
        }
        roots.push(nodes[0]);
    }
    let mut check = 0;
    for p in 0..1000 {
        for root in roots.iter() {
            let r = reverse_odd_levels(Some(root)).unwrap();
            let a = r.left.unwrap().val;
            let b = r.right.unwrap().val;
            check = (check * 31 + a + p) % 1000000007;
            check = (check * 31 + b + edge(r, true) + edge(r, false)) % 1000000007;
        }
    }
    println(f"1000 passes over 10 trees of 2^14 - 1 nodes: checksum {check}");
}
