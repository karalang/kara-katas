// LeetCode #2465: Number of Distinct Averages -- counts: the values lie
// from 0 to 100, so a count of each stands in for sorting, and two
// pointers walk in from both ends of the counts, pairing one from each,
// the pair's sum marked in a table of the 201 sums possible. O(n + 101).

fn distinct_averages(nums: Vec[i64]) -> i64 {
    let mut count: Vec[i64] = Vec.filled(101, 0);
    for v in nums.iter() {
        count[v] += 1;
    }
    let mut seen: Vec[bool] = Vec.filled(201, false);
    let mut low = 0;
    let mut high = 100;
    for _ in 0..nums.len() / 2 {
        while count[low] == 0 {
            low += 1;
        }
        count[low] -= 1;
        while count[high] == 0 {
            high -= 1;
        }
        count[high] -= 1;
        seen[low + high] = true;
    }
    seen.iter().filter(|s| *s).count()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then every number the same; the two ends of
    // the range; every pair summing alike; and averages that differ only by
    // a half
    let cases: Vec[Vec[i64]] = [
        [4, 1, 4, 0, 3, 5].to_vec(),
        [1, 100].to_vec(),
        [7, 7, 7, 7].to_vec(),
        [0, 100, 0, 100].to_vec(),
        [1, 2, 3, 4, 5, 6].to_vec(),
        [0, 1, 1, 3].to_vec(),
    ].to_vec();
    for nums in cases.into_iter() {
        let shown = f"{nums}";
        println(f"{shown} -> {distinct_averages(nums)}");
    }
    // the constraints' largest: 100 numbers, 0 to 99; then 100 random
    // from 0 to 100 and 100 random from 0 to 3
    let all: Vec[i64] = (0..100).collect();
    println(f"0 to 99: {distinct_averages(all)}");
    let mut seed = 2465;
    for top in [101, 4].iter() {
        let nums: Vec[i64] = (0..100).map(|_| next_random(mut seed) % top).collect();
        println(f"100 random below {top}: {distinct_averages(nums)}");
    }
    // 3000 random lists of 2 to 20 numbers, an even count, from 0 to 100:
    // a checksum of every answer in order
    let mut check = 0;
    for _ in 0..3000 {
        let n = 2 * (1 + next_random(mut seed) % 10);
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 101).collect();
        check = (check * 31 + distinct_averages(nums)) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
