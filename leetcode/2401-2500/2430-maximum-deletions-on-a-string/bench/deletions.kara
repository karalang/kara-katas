// LeetCode #2430: Maximum Deletions on a String -- the bench, the ★ arm:
// the longest common prefix of the suffixes at `i` and `k` kept in two
// rows, each row from the one after it, and `best[i]` the most
// operations that clear the suffix from `i`.

fn delete_string(b: Vec[u8]) -> i64 {
    let n = b.len();
    let mut next_row: Vec[i64] = Vec.filled(n + 1, 0);
    let mut row: Vec[i64] = Vec.filled(n + 1, 0);
    let mut best: Vec[i64] = Vec.filled(n + 1, 0);
    for i in (0..n).rev() {
        for k in i + 1..n {
            row[k] = if b[i] == b[k] { next_row[k + 1] + 1 } else { 0 };
        }
        best[i] = 1;
        for j in 1..(n - i) / 2 + 1 {
            if row[i + j] >= j {
                best[i] = best[i].max(best[i + j] + 1);
            }
        }
        let done = next_row;
        next_row = row;
        row = done;
    }
    best[0]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2430;
    // 8 words of 4000 letters, the constraints' longest, from `a` and `b`,
    // each letter a copy of one up to 3 before it half the time
    let mut words: Vec[Vec[u8]] = Vec.new();
    for _ in 0..8 {
        let mut w: Vec[u8] = Vec.new();
        for i in 0..4000 {
            let back = 1 + next_random(mut seed) % 3;
            if i >= back and next_random(mut seed) % 2 == 0 {
                w.push(w[i - back]);
            } else {
                w.push(b'a' + (next_random(mut seed) % 2) as u8);
            }
        }
        words.push(w);
    }
    // pass `p` sets one letter of every word, then answers every word
    let mut check = 0;
    for p in 0..6 {
        for w in 0..words.len() {
            let at = (p * 997 + w * 131) % 4000;
            words[w][at] = b'a' + (p % 2) as u8;
            check = (check * 31 + delete_string(words[w]) + p) % 1000000007;
        }
    }
    println(f"6 passes over 8 words of 4000 letters: checksum {check}");
}
