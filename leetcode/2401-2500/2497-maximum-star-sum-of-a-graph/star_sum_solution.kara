// LeetCode #2497: Maximum Star Sum of a Graph -- LeetCode's Rust
// template: `Vec<i32>`, `Vec<Vec<i32>>` and `k: i32` in, `i32` out; each
// node's positive neighbours' values pushed, `sort_unstable_by` largest
// first, the first `k` `take`n and summed; carried by `karac fix`.

struct Solution {}

impl Solution {
    pub fn max_star_sum(vals: Vec[i32], edges: Vec[Vec[i32]], k: i32) -> i32 {
        let n = vals.len();
        let mut g: Vec[Vec[i32]] = Vec.filled(n, Vec.new());
        for e in ref edges {
            let (a, b) = (e[0] as i64, e[1] as i64);
            if vals[b] > 0 {
                g[a].push(vals[b]);
            }
            if vals[a] > 0 {
                g[b].push(vals[a]);
            }
        }
        let mut ans = i32.MIN;
        for i in 0..n {
            g[i].sort_by(|x, y| y.cmp(x));
            let s: i32 = g[i].iter().take(k).sum();
            ans = ans.max(vals[i] + s);
        }
        ans
    }
}

fn max_star_sum(vals: Vec[i64], edges: Vec[Vec[i64]], k: i64) -> i64 {
    let asked: Vec[Vec[i32]] = edges.iter().map(|e| e.iter().map(|v| v as i32).collect()).collect();
    Solution.max_star_sum(vals.iter().map(|v| v as i32).collect(), asked, k as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// `n` values from -`top` to `top`, and up to `tries` random edges, none
// repeated
fn random_graph(n: i64, tries: i64, top: i64, seed: mut ref i64) -> (Vec[i64], Vec[Vec[i64]]) {
    let mut vals: Vec[i64] = Vec.new();
    for _ in 0..n {
        vals.push(wide(mut seed) % (2 * top + 1) - top);
    }
    let mut taken: Set[i64] = Set.new();
    let mut edges: Vec[Vec[i64]] = Vec.new();
    for _ in 0..tries {
        let a = wide(mut seed) % n;
        let b = wide(mut seed) % n;
        if a != b and taken.insert(a.min(b) * 1000000 + a.max(b)) {
            edges.push([a, b].to_vec());
        }
    }
    (vals, edges)
}

fn main() {
    // LeetCode's two examples, then six more
    let cases: Vec[(Vec[i64], Vec[Vec[i64]], i64)] = [
        ([1, 2, 3, 4, 10, -10, -20].to_vec(), [[0, 1].to_vec(), [1, 2].to_vec(), [1, 3].to_vec(), [3, 4].to_vec(), [3, 5].to_vec(), [3, 6].to_vec()].to_vec(), 2),
        ([-5].to_vec(), Vec.new(), 0),
        ([-1, -2, -3].to_vec(), [[0, 1].to_vec(), [1, 2].to_vec()].to_vec(), 2),
        ([5, 7, 9].to_vec(), [[0, 1].to_vec(), [1, 2].to_vec(), [0, 2].to_vec()].to_vec(), 0),
        ([5, 7, 9].to_vec(), [[0, 1].to_vec(), [1, 2].to_vec(), [0, 2].to_vec()].to_vec(), 2),
        ([-3, 4, 4, 4].to_vec(), [[0, 1].to_vec(), [0, 2].to_vec(), [0, 3].to_vec()].to_vec(), 3),
        ([0, 0, 1].to_vec(), [[0, 1].to_vec()].to_vec(), 1),
        ([2, -1, 3].to_vec(), [[0, 1].to_vec(), [1, 2].to_vec()].to_vec(), 2),
    ].to_vec();
    for (vals, edges, k) in cases.iter() {
        println(f"{vals.len()} nodes, {edges.len()} edges, k {k} -> {max_star_sum(vals, edges, k)}");
    }
    // 2000 random graphs of 1 to 30 nodes and up to 60 tries at an edge,
    // values to 20 and to 10^4, `k` from 0 to n - 1: a checksum each
    let mut seed = 2497;
    for top in [20, 10000] {
        let mut check = 0;
        for _ in 0..2000 {
            let n = next_random(mut seed) % 30 + 1;
            let tries = next_random(mut seed) % 61;
            let k = next_random(mut seed) % n;
            let (vals, edges) = random_graph(n, tries, top, mut seed);
            check = (check * 31 + max_star_sum(vals, edges, k) + 1000000000) % 1000000007;
        }
        println(f"2000 random to {top}: checksum {check}");
    }
    // the constraints' largest, 10^5 nodes: a star of 10^4s round node 0
    // with k = n - 1; 10^5 random edges with k = 50 and k = 0; and a path
    // whose values alternate in sign, k = 2
    let n = 100000;
    let hub: Vec[Vec[i64]] = (1..n).map(|v| [0, v].to_vec()).collect();
    let tens: Vec[i64] = Vec.filled(n, 10000);
    println(f"10^5 star: {max_star_sum(tens, hub, n - 1)}");
    let (vals, edges) = random_graph(n, 100000, 10000, mut seed);
    println(f"10^5 random, {edges.len()} edges: k 50 -> {max_star_sum(vals, edges, 50)}, k 0 -> {max_star_sum(vals, edges, 0)}");
    let signs: Vec[i64] = (0..n).map(|v| if v % 2 == 0 { -(v % 10000) } else { v % 10000 }).collect();
    let path: Vec[Vec[i64]] = (0..n - 1).map(|v| [v, v + 1].to_vec()).collect();
    println(f"10^5 path: {max_star_sum(signs, path, 2)}");
}
