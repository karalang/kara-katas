// LeetCode #2427: Number of Common Factors -- the differential. The six
// arms against the statement read literally: every `x` from 1 to the
// larger of `a` and `b` tried, and counted when it divides both. No gcd
// taken. 360 cases: 300 random pairs from 1 to 1000, the second a
// multiple of a factor of the first half the time; then 30 pairs of one
// value twice; then 30 pairs of products of the primes 2, 3, 5 and 7 up
// to 1000, rich in divisors. Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  `a` and `b` swapped: the same answer
// P3  both multiplied by the least prime from 2 to 13 that does not divide
//     both: twice the answer
// P4  `b` replaced by `a + b`: the same answer
// P5  no more than the factors of `a` alone, and exactly 1 against 1
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn factors_literally(a: i64, b: i64) -> i64 {
    let mut count = 0;
    for x in 1..a.max(b) + 1 {
        if a % x == 0 and b % x == 0 {
            count += 1;
        }
    }
    count
}

// ---- star (factors.kara) -------------------------------------------------

fn star_gcd(a: i64, b: i64) -> i64 {
    let mut a = a;
    let mut b = b;
    while b != 0 {
        let r = a % b;
        a = b;
        b = r;
    }
    a
}

fn star_common_factors(a: i64, b: i64) -> i64 {
    let g = star_gcd(a, b);
    let mut count = 0;
    let mut d = 1;
    while d * d <= g {
        if g % d == 0 {
            count += if d * d == g { 1 } else { 2 };
        }
        d += 1;
    }
    count
}

// ---- naive (factors_naive.kara) ------------------------------------------

fn naive_common_factors(a: i64, b: i64) -> i64 {
    let mut count = 0;
    for x in 1..a.min(b) + 1 {
        if a % x == 0 and b % x == 0 {
            count += 1;
        }
    }
    count
}

// ---- sets (factors_sets.kara) --------------------------------------------

fn sets_divisors(n: i64) -> SortedSet[i64] {
    let mut found: SortedSet[i64] = SortedSet.new();
    let mut d = 1;
    while d * d <= n {
        if n % d == 0 {
            found.insert(d);
            found.insert(n / d);
        }
        d += 1;
    }
    found
}

fn sets_common_factors(a: i64, b: i64) -> i64 {
    let of_a = sets_divisors(a);
    let of_b = sets_divisors(b);
    of_a.intersection(of_b).len()
}

// ---- primes (factors_primes.kara) ----------------------------------------

fn primes_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { primes_gcd(b, a % b) }
}

fn primes_common_factors(a: i64, b: i64) -> i64 {
    let mut g = primes_gcd(a, b);
    let mut count = 1;
    let mut p = 2;
    while p * p <= g {
        let mut e = 0;
        while g % p == 0 {
            g /= p;
            e += 1;
        }
        count *= e + 1;
        p += 1;
    }
    if g > 1 {
        count *= 2;
    }
    count
}

// ---- iter (factors_iter.kara) --------------------------------------------

fn iter_common_factors(a: i64, b: i64) -> i64 {
    let g = (1..a.min(b) + 1).rev().find(|x| a % x == 0 and b % x == 0).unwrap();
    (1..g + 1).filter(|d| g % d == 0).count()
}

// ---- solution (factors_solution.kara) ------------------------------------

impl Solution {
    pub fn common_factors(a: i32, b: i32) -> i32 {
        let g = Solution.gcd(a, b);
        (1..=g).filter(|x| g % x == 0).count() as i32
    }

    fn gcd(a: i32, b: i32) -> i32 {
        if b == 0 { a } else { Solution.gcd(b, a % b) }
    }
}

struct Solution {}

fn solution_common_factors(a: i64, b: i64) -> i64 {
    Solution.common_factors(a as i32, b as i32)
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, a: i64, b: i64) -> i64 {
    match arm {
        0 => star_common_factors(a, b),
        1 => naive_common_factors(a, b),
        2 => sets_common_factors(a, b),
        3 => primes_common_factors(a, b),
        4 => iter_common_factors(a, b),
        _ => solution_common_factors(a, b),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arms = ["star", "naive", "sets", "primes", "iter", "solution"];
    let mut seed = 2427;
    let mut cases: Vec[(i64, i64)] = Vec.new();
    for t in 0..360 {
        if t < 300 {
            let a = 1 + next_random(mut seed) % 1000;
            let b = if next_random(mut seed) % 2 == 0 {
                1 + next_random(mut seed) % 1000
            } else {
                let f = 1 + next_random(mut seed) % a;
                f * (1 + next_random(mut seed) % (1000 / f))
            };
            cases.push((a, b));
        } else if t < 330 {
            let a = 1 + next_random(mut seed) % 1000;
            cases.push((a, a));
        } else {
            let mut pair: Vec[i64] = Vec.new();
            for _ in 0..2 {
                let mut v = 1;
                let mut going = true;
                while going {
                    let p = [2, 3, 5, 7][next_random(mut seed) % 4];
                    if v * p > 1000 or next_random(mut seed) % 8 == 0 {
                        going = false;
                    } else {
                        v *= p;
                    }
                }
                pair.push(v);
            }
            cases.push((pair[0], pair[1]));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (a, b) = cases[c];
        let truth = factors_literally(a, b);
        check = (check * 31 + truth) % 1000000007;
        let mut q = 0;
        for p in [2, 3, 5, 7, 11, 13].iter() {
            if q == 0 and (a % p != 0 or b % p != 0) {
                q = p;
            }
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, a, b)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, b, a) == value,
                answer(arm, a * q, b * q) == 2 * value,
                answer(arm, a, a + b) == value,
                value <= answer(arm, a, a) and answer(arm, a, 1) == 1,
                same >= 3,
            ];
            for k in 0..6 {
                checks += 1;
                if not verdicts[k] {
                    by_property[k] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{k + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for k in 0..6 {
            if by_property[k] > 0 {
                println(f"P{k + 1} {by_property[k]}");
            }
        }
    }
}
