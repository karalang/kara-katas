// LeetCode #2427: Number of Common Factors -- the bench, the ★ arm: the
// divisors of gcd(a, b), counted in pairs up to its square root.

fn gcd(a: i64, b: i64) -> i64 {
    let mut a = a;
    let mut b = b;
    while b != 0 {
        let r = a % b;
        a = b;
        b = r;
    }
    a
}

fn common_factors(a: i64, b: i64) -> i64 {
    let g = gcd(a, b);
    let mut count = 0;
    let mut d = 1;
    while d * d <= g {
        if g % d == 0 {
            count += if d * d == g { 1 } else { 2 };
        }
        d += 1;
    }
    count
}

fn main() {
    // every pair from 1 to 1000, 5 passes, pass `p` pairing `a` with the
    // `b` that many places on, wrapping past 1000
    let mut check = 0;
    for p in 0..5 {
        for a in 1..1001 {
            for b in 1..1001 {
                let other = (b + p - 1) % 1000 + 1;
                check = (check * 31 + common_factors(a, other) + p) % 1000000007;
            }
        }
    }
    println(f"5 passes over 10^6 pairs: checksum {check}");
}
