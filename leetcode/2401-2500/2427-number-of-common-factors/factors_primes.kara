// LeetCode #2427: Number of Common Factors -- prime factors: the gcd of
// `a` and `b`, by recursion, factored by trial division; a number
// `p1^e1 ... pk^ek` has `(e1 + 1) ... (ek + 1)` divisors, every common
// factor being one choice of each exponent. O(log min(a, b) + sqrt(g)).

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn common_factors(a: i64, b: i64) -> i64 {
    let mut g = gcd(a, b);
    let mut count = 1;
    let mut p = 2;
    while p * p <= g {
        let mut e = 0;
        while g % p == 0 {
            g /= p;
            e += 1;
        }
        count *= e + 1;
        p += 1;
    }
    if g > 1 {
        count *= 2;
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; 1 and 1; the constraints' largest, 1000
    // twice; two primes; one dividing the other; 720 and 840, gcd 120
    for (a, b) in [(12, 6), (25, 30), (1, 1), (1000, 1000), (997, 991), (7, 994), (720, 840)].iter() {
        println(f"{a} {b}: {common_factors(a, b)}");
    }
    // every pair from 1 to 200: a checksum of the answers in order, and
    // their total
    let mut check = 0;
    let mut total = 0;
    for a in 1..201 {
        for b in 1..201 {
            let answer = common_factors(a, b);
            check = (check * 31 + answer) % 1000000007;
            total += answer;
        }
    }
    println(f"pairs to 200: checksum {check}, total {total}");
    // 3000 random pairs from 1 to 1000, the second a multiple of a random
    // factor of the first half the time
    let mut seed = 2427;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let a = 1 + next_random(mut seed) % 1000;
        let b = if next_random(mut seed) % 2 == 0 {
            1 + next_random(mut seed) % 1000
        } else {
            let f = 1 + next_random(mut seed) % a;
            f * (1 + next_random(mut seed) % (1000 / f))
        };
        let answer = common_factors(a, b);
        check = (check * 31 + answer) % 1000000007;
        total += answer;
    }
    println(f"3000 random: checksum {check}, total {total}");
}
