// LeetCode #2413: Smallest Even Multiple -- the differential. The six arms
// against the statement read literally: 1, 2, 3 and so on tried in turn,
// and the first that both 2 and n divide. No parity test and no gcd. 200
// cases: every n from 1 to 150, then 50 random n up to 10^5.
//
// P1  the answer is the literal reading's
// P2  2 and n both divide the answer, and it is n or 2 n
// P3  2 n: the answer 2 n, which is n's answer when n is odd
// P4  3 n: three times n's answer
// P5  n + 1: of the answers' quotients by n and by n + 1, one is 1 and
//     one is 2
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn even_multiple_literally(n: i64) -> i64 {
    let mut m = 1;
    while m % 2 != 0 or m % n != 0 {
        m += 1;
    }
    m
}

// ---- star (even.kara) ----------------------------------------------------

fn star_smallest_even_multiple(n: i64) -> i64 {
    if n % 2 == 0 {
        n
    } else {
        2 * n
    }
}

// ---- gcd (even_gcd.kara) -------------------------------------------------

fn gcd_gcd(a: i64, b: i64) -> i64 {
    if b == 0 {
        a
    } else {
        gcd_gcd(b, a % b)
    }
}

fn gcd_smallest_even_multiple(n: i64) -> i64 {
    2 * n / gcd_gcd(2, n)
}

// ---- count (even_count.kara) ---------------------------------------------

fn count_smallest_even_multiple(n: i64) -> i64 {
    let mut m = n;
    while m % 2 != 0 {
        m += n;
    }
    m
}

// ---- shift (even_shift.kara) ---------------------------------------------

fn shift_smallest_even_multiple(n: i64) -> i64 {
    n << (n & 1)
}

// ---- iter (even_iter.kara) -----------------------------------------------

fn iter_smallest_even_multiple(n: i64) -> i64 {
    (2..2 * n + 1).step_by(2).find(|m| m % n == 0).unwrap()
}

// ---- solution (even_solution.kara) ---------------------------------------

impl Solution {
    pub fn smallest_even_multiple(n: i32) -> i32 {
        if n % 2 == 0 {
            n
        } else {
            n * 2
        }
    }
}

struct Solution {}

fn solution_smallest_even_multiple(n: i64) -> i64 {
    Solution.smallest_even_multiple(n as i32)
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, n: i64) -> i64 {
    match arm {
        0 => star_smallest_even_multiple(n),
        1 => gcd_smallest_even_multiple(n),
        2 => count_smallest_even_multiple(n),
        3 => shift_smallest_even_multiple(n),
        4 => iter_smallest_even_multiple(n),
        _ => solution_smallest_even_multiple(n),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "gcd", "count", "shift", "iter", "solution"];
    let mut seed = 2413;
    let mut cases: Vec[i64] = (1..151).collect();
    for _ in 0..50 {
        cases.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let n = cases[c];
        let truth = even_multiple_literally(n);
        check = (check * 31 + truth) % 1000000007;
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, n)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let doubled = answer(arm, 2 * n);
            let next = answer(arm, n + 1);
            let quotients = if value % n == 0 and next % (n + 1) == 0 {
                value / n + next / (n + 1)
            } else {
                0
            };
            let verdicts = [value == truth, value % 2 == 0 and value % n == 0 and (value == n or value == 2 * n), doubled == 2 * n and (n % 2 == 0 or doubled == value), answer(arm, 3 * n) == 3 * value, quotients == 3, same >= 3];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
