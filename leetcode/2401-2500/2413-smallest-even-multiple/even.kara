// LeetCode #2413: Smallest Even Multiple -- the ★ arm, parity. The least
// common multiple of 2 and n is n itself when n is even, and 2 n when it
// is odd. O(1).

fn smallest_even_multiple(n: i64) -> i64 {
    if n % 2 == 0 {
        n
    } else {
        2 * n
    }
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples; the ends of the range
    println(f"{smallest_even_multiple(5)} {smallest_even_multiple(6)}");
    println(f"{smallest_even_multiple(1)} {smallest_even_multiple(2)} {smallest_even_multiple(149)} {smallest_even_multiple(150)}");
    // every n from 1 to 150: the answers from 1 to 20, then a checksum of
    // all of them and their total
    let firsts: Vec[String] = (1..21).map(|n| f"{smallest_even_multiple(n)}").collect();
    println(firsts.join(" "));
    let mut check = 0;
    let mut total = 0;
    for n in 1..151 {
        let a = smallest_even_multiple(n);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"1 to 150: checksum {check}, total {total}");
}
