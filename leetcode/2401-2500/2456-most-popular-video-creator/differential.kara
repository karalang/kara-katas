// LeetCode #2456: Most Popular Video Creator -- the differential. The six
// arms against the statement read literally: the creators listed once
// each, in order, by a `SortedSet`; each one's popularity summed over
// every video; the highest found; and for each creator at it, the most
// views among their videos found first, then the least id among the
// videos with that many. No running total or best is kept. 360 cases:
// 300 random of 1 to 10 videos, creators and ids of 1 to 2 letters from
// 3, views up to 5; then 30 of up to 40 videos, creators of up to 3
// letters from 3, ids of up to 5 from 26, views up to 49999; then 30 of
// up to 40 videos, creators and ids of one letter from 2, views up to 2,
// full of ties. Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the videos in reverse order: the same answer
// P3  every view doubled: the same answer
// P4  every video listed twice: the same answer
// P5  the first answered creator's best video raised by one view: that creator and video alone
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn creator_literally(creators: Vec[String], ids: Vec[String], views: Vec[i64]) -> Vec[Vec[String]] {
    let n = creators.len();
    let names: SortedSet[String] = SortedSet.from(creators.clone());
    let mut popularity: Vec[(String, i64)] = Vec.new();
    for c in names.iter() {
        let mut sum = 0;
        for i in 0..n {
            if creators[i] == c {
                sum += views[i];
            }
        }
        popularity.push((c.clone(), sum));
    }
    let mut highest = 0;
    for (_, p) in popularity.iter() {
        if p > highest {
            highest = p;
        }
    }
    let mut answer: Vec[Vec[String]] = Vec.new();
    for (c, p) in popularity.iter() {
        if p != highest {
            continue;
        }
        let mut most = -1;
        for i in 0..n {
            if creators[i] == c and views[i] > most {
                most = views[i];
            }
        }
        let mut least: Option[String] = None;
        for i in 0..n {
            if creators[i] == c and views[i] == most {
                least = match least {
                    Some(id) => if ids[i] < id { Some(ids[i].clone()) } else { Some(id) },
                    None => Some(ids[i].clone()),
                };
            }
        }
        answer.push([c.clone(), least.unwrap()].to_vec());
    }
    answer
}

// ---- star (creator.kara) -------------------------------------------------

fn star_most_popular_creator(creators: Vec[String], ids: Vec[String], views: Vec[i64]) -> Vec[Vec[String]] {
    let mut stats: Map[String, (i64, i64, String)] = Map.new();
    for i in 0..creators.len() {
        let c = creators[i].clone();
        match stats.get(c) {
            Some((total, top, id)) => {
                let better = views[i] > top or (views[i] == top and ids[i] < id);
                stats[c] = if better { (total + views[i], views[i], ids[i].clone()) } else { (total + views[i], top, id.clone()) };
            }
            None => stats[c] = (views[i], views[i], ids[i].clone()),
        }
    }
    let mut most = 0;
    for (_, (total, _, _)) in stats.iter() {
        most = most.max(total);
    }
    let mut answer: Vec[Vec[String]] = Vec.new();
    for (c, (total, _, id)) in stats.iter() {
        if total == most {
            answer.push([c.clone(), id.clone()].to_vec());
        }
    }
    answer.sort();
    answer
}

// ---- naive (creator_naive.kara) ------------------------------------------

fn naive_most_popular_creator(creators: Vec[String], ids: Vec[String], views: Vec[i64]) -> Vec[Vec[String]] {
    let n = creators.len();
    let mut popularity: Vec[i64] = Vec.new();
    for i in 0..n {
        let mut sum = 0;
        for j in 0..n {
            if creators[j] == creators[i] {
                sum += views[j];
            }
        }
        popularity.push(sum);
    }
    let highest = popularity.iter().max().unwrap();
    let mut answer: Vec[Vec[String]] = Vec.new();
    for i in 0..n {
        let first = (0..i).all(|j| creators[j] != creators[i]);
        if first and popularity[i] == highest {
            let mut best = i;
            for j in 0..n {
                if creators[j] == creators[i] and (views[j] > views[best] or (views[j] == views[best] and ids[j] < ids[best])) {
                    best = j;
                }
            }
            answer.push([creators[i].clone(), ids[best].clone()].to_vec());
        }
    }
    answer.sort();
    answer
}

// ---- sorted (creator_sorted.kara) ----------------------------------------

fn sorted_most_popular_creator(creators: Vec[String], ids: Vec[String], views: Vec[i64]) -> Vec[Vec[String]] {
    let n = creators.len();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by_key(|i| (creators[i].clone(), -views[i], ids[i].clone()));
    let mut runs: Vec[(i64, i64)] = Vec.new();
    let mut start = 0;
    while start < n {
        let mut end = start;
        let mut sum = 0;
        while end < n and creators[order[end]] == creators[order[start]] {
            sum += views[order[end]];
            end += 1;
        }
        runs.push((sum, order[start]));
        start = end;
    }
    let most = runs.iter().map(|r| r.0).max().unwrap();
    runs.iter().filter(|r| r.0 == most).map(|r| [creators[r.1].clone(), ids[r.1].clone()].to_vec()).collect()
}

// ---- ordered (creator_ordered.kara) --------------------------------------

fn ordered_most_popular_creator(creators: Vec[String], ids: Vec[String], views: Vec[i64]) -> Vec[Vec[String]] {
    let mut totals: SortedMap[String, i64] = SortedMap.new();
    let mut best: SortedMap[String, (i64, String)] = SortedMap.new();
    for i in 0..creators.len() {
        let c = creators[i].clone();
        totals[c.clone()] = totals.get(c).unwrap_or(0) + views[i];
        let replace = match best.get(c) {
            Some((v, id)) => views[i] > v or (views[i] == v and ids[i] < id),
            None => true,
        };
        if replace {
            best[c] = (views[i], ids[i].clone());
        }
    }
    let most = totals.values().max().unwrap();
    let mut answer: Vec[Vec[String]] = Vec.new();
    for (c, total) in totals.iter() {
        if total == most {
            answer.push([c.clone(), best[c].1.clone()].to_vec());
        }
    }
    answer
}

// ---- iter (creator_iter.kara) --------------------------------------------

fn iter_most_popular_creator(creators: Vec[String], ids: Vec[String], views: Vec[i64]) -> Vec[Vec[String]] {
    let stats: Map[String, (i64, i64, String)] = (0..creators.len()).fold(Map.new(), |m, i| {
        let mut m = m;
        let c = creators[i].clone();
        let next = match m.get(c) {
            Some((total, v, id)) => {
                if views[i] > v or (views[i] == v and ids[i] < id) {
                    (total + views[i], views[i], ids[i].clone())
                } else {
                    (total + views[i], v, id.clone())
                }
            }
            None => (views[i], views[i], ids[i].clone()),
        };
        m[c] = next;
        m
    });
    let most = stats.values().map(|s| s.0).max().unwrap();
    let mut answer: Vec[Vec[String]] = stats.iter().filter(|(_, s)| s.0 == most).map(|(c, s)| [c.clone(), s.2.clone()].to_vec()).collect();
    answer.sort();
    answer
}

// ---- solution (creator_solution.kara) ------------------------------------

impl Solution {
    pub fn most_popular_creator(creators: Vec[String], ids: Vec[String], views: Vec[i32]) -> Vec[Vec[String]] {
        let mut total: Map[String, i64] = Map.new();
        let mut best: Map[String, (i32, String)] = Map.new();
        for i in 0..creators.len() {
            *total.entry(creators[i].clone()).or_insert(0) += views[i];
            let e = best.entry(creators[i].clone()).or_insert((views[i], ids[i].clone()));
            if views[i] > e.0 or (views[i] == e.0 and ids[i] < e.1) {
                *e = (views[i], ids[i].clone());
            }
        }
        let most = *total.values().max().unwrap();
        total
            .iter()
            .filter(|(_, t)| t == most)
            .map(|(c, _)| [c.clone(), best[c].1.clone()])
            .collect()
    }
}

struct Solution {}

fn solution_most_popular_creator(creators: Vec[String], ids: Vec[String], views: Vec[i64]) -> Vec[Vec[String]] {
    let counts: Vec[i32] = views.iter().map(|x| x as i32).collect();
    let mut answer = Solution.most_popular_creator(creators, ids, counts);
    answer.sort();
    answer
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, creators: Vec[String], ids: Vec[String], views: Vec[i64]) -> Vec[Vec[String]] {
    match arm {
        0 => star_most_popular_creator(creators, ids, views),
        1 => naive_most_popular_creator(creators, ids, views),
        2 => sorted_most_popular_creator(creators, ids, views),
        3 => ordered_most_popular_creator(creators, ids, views),
        4 => iter_most_popular_creator(creators, ids, views),
        _ => solution_most_popular_creator(creators, ids, views),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_name(len: i64, letters: i64, seed: mut ref i64) -> String {
    let n = 1 + next_random(mut seed) % len;
    let bytes: Vec[u8] = (0..n).map(|_| (97 + next_random(mut seed) % letters) as u8).collect();
    String.from_utf8(bytes).unwrap()
}

// the views with the given creator's video `id` that has the most views
// raised by one
fn raised_best(creators: Vec[String], ids: Vec[String], views: Vec[i64], pair: Vec[String]) -> Vec[i64] {
    let mut out = views.clone();
    let mut at = -1;
    for i in 0..creators.len() {
        if creators[i] == pair[0] and ids[i] == pair[1] and (at == -1 or views[i] > views[at]) {
            at = i;
        }
    }
    if at >= 0 {
        out[at] += 1;
    }
    out
}

fn main() {
    let arms = ["star", "naive", "sorted", "ordered", "iter", "solution"];
    let mut seed = 2456;
    let mut cases: Vec[(Vec[String], Vec[String], Vec[i64])] = Vec.new();
    for t in 0..360 {
        let (n, cl, cn, il, iln, top) = if t < 300 {
            (1 + next_random(mut seed) % 10, 2, 3, 2, 3, 5)
        } else if t < 330 {
            (1 + next_random(mut seed) % 40, 3, 3, 5, 26, 49999)
        } else {
            (1 + next_random(mut seed) % 40, 1, 2, 1, 2, 2)
        };
        let creators: Vec[String] = (0..n).map(|_| random_name(cl, cn, mut seed)).collect();
        let ids: Vec[String] = (0..n).map(|_| random_name(il, iln, mut seed)).collect();
        let views: Vec[i64] = (0..n).map(|_| next_random(mut seed) % (top + 1)).collect();
        cases.push((creators, ids, views));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (creators, ids, views) = cases[c].clone();
        let truth = creator_literally(creators, ids, views);
        for p in truth.iter() {
            for w in p.iter() {
                for b in w.bytes().iter() {
                    check = (check * 31 + b as i64) % 1000000007;
                }
                check = (check * 31 + 1) % 1000000007;
            }
        }
        check = (check * 31 + 2) % 1000000007;
        let mut back_creators = creators.clone();
        back_creators.reverse();
        let mut back_ids = ids.clone();
        back_ids.reverse();
        let mut back_views = views.clone();
        back_views.reverse();
        let doubled: Vec[i64] = views.iter().map(|v| 2 * v).collect();
        let mut twice_creators = creators.clone();
        twice_creators.extend(creators.iter().cloned());
        let mut twice_ids = ids.clone();
        twice_ids.extend(ids.iter().cloned());
        let mut twice_views = views.clone();
        twice_views.extend(views.iter().cloned());
        let got: Vec[Vec[Vec[String]]] = (0..6).map(|arm| answer(arm, creators, ids, views)).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let alone = if value.len() > 0 and value[0].len() == 2 {
                let raised = raised_best(creators, ids, views, value[0]);
                answer(arm, creators, ids, raised) == [value[0].clone()].to_vec()
            } else {
                false
            };
            let verdicts = [
                value == truth,
                answer(arm, back_creators, back_ids, back_views) == value,
                answer(arm, creators, ids, doubled) == value,
                answer(arm, twice_creators, twice_ids, twice_views) == value,
                alone,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
