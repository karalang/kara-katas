// LeetCode #2456: Most Popular Video Creator -- sorting: the videos'
// indices sorted by creator, then by views falling, then by id, so each
// creator is a run whose first video is their best; each run summed, and
// the runs with the largest sum answered in creator order. O(n log n).

fn most_popular_creator(creators: Vec[String], ids: Vec[String], views: Vec[i64]) -> Vec[Vec[String]] {
    let n = creators.len();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by_key(|i| (creators[i].clone(), -views[i], ids[i].clone()));
    let mut runs: Vec[(i64, i64)] = Vec.new();
    let mut start = 0;
    while start < n {
        let mut end = start;
        let mut sum = 0;
        while end < n and creators[order[end]] == creators[order[start]] {
            sum += views[order[end]];
            end += 1;
        }
        runs.push((sum, order[start]));
        start = end;
    }
    let most = runs.iter().map(|r| r.0).max().unwrap();
    runs.iter().filter(|r| r.0 == most).map(|r| [creators[r.1].clone(), ids[r.1].clone()].to_vec()).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn strings(list: Vec[Str]) -> Vec[String] {
    list.iter().map(|w| w.to_string()).collect()
}

// a random name of 1 to `len` letters from the first `letters`
fn random_name(len: i64, letters: i64, seed: mut ref i64) -> String {
    let n = 1 + next_random(mut seed) % len;
    let bytes: Vec[u8] = (0..n).map(|_| (97 + next_random(mut seed) % letters) as u8).collect();
    String.from_utf8(bytes).unwrap()
}

// every pair as `creator/id`, in the answer's order
fn show(answer: Vec[Vec[String]]) -> String {
    let parts: Vec[String] = answer.iter().map(|p| f"{p[0]}/{p[1]}").collect();
    parts.join(" ")
}

// how many pairs, and a checksum of their letters in order
fn summary(answer: Vec[Vec[String]]) -> String {
    let mut check = 0;
    for p in answer.iter() {
        for w in p.iter() {
            for b in w.bytes().iter() {
                check = (check * 31 + b as i64) % 1000000007;
            }
            check = (check * 31 + 1) % 1000000007;
        }
    }
    f"{answer.len()} pairs, checksum {check}"
}

fn main() {
    // LeetCode's two examples; one video of no views; a creator's tie
    // broken by the least id; two creators tied, one holding the most
    // viewed video; one creator's many small videos above another's one
    // large one
    println(show(most_popular_creator(strings(["alice", "bob", "alice", "chris"].to_vec()), strings(["one", "two", "three", "four"].to_vec()), [5, 10, 5, 4].to_vec())));
    println(show(most_popular_creator(strings(["alice", "alice", "alice"].to_vec()), strings(["a", "b", "c"].to_vec()), [1, 2, 2].to_vec())));
    println(show(most_popular_creator(strings(["z"].to_vec()), strings(["q"].to_vec()), [0].to_vec())));
    println(show(most_popular_creator(strings(["x", "x", "x"].to_vec()), strings(["bb", "ab", "b"].to_vec()), [7, 7, 7].to_vec())));
    println(show(most_popular_creator(strings(["p", "q", "q", "p"].to_vec()), strings(["a", "b", "c", "d"].to_vec()), [6, 3, 3, 0].to_vec())));
    println(show(most_popular_creator(strings(["m", "m", "m", "n"].to_vec()), strings(["c", "b", "a", "z"].to_vec()), [1, 1, 1, 2].to_vec())));
    // 2000 videos by creators from 3 letters, views up to 10^5; then 2000
    // by creators from 1 letter of 2, views up to 3, full of ties
    let mut seed = 2456;
    for (len, letters, top) in [(3, 3, 100000), (1, 2, 3)].iter() {
        let creators: Vec[String] = (0..2000).map(|_| random_name(len, letters, mut seed)).collect();
        let ids: Vec[String] = (0..2000).map(|_| random_name(5, 26, mut seed)).collect();
        let views: Vec[i64] = (0..2000).map(|_| next_random(mut seed) % (top + 1)).collect();
        println(f"2000 videos, names of {len} from {letters}: {summary(most_popular_creator(creators, ids, views))}");
    }
    // 3000 random lists of 1 to 8 videos, creators and ids of 1 to 2
    // letters from 3, views up to 5: a checksum of every summary's
    // checksum in order
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 8;
        let creators: Vec[String] = (0..n).map(|_| random_name(2, 3, mut seed)).collect();
        let ids: Vec[String] = (0..n).map(|_| random_name(2, 3, mut seed)).collect();
        let views: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 6).collect();
        for p in most_popular_creator(creators, ids, views).iter() {
            for w in p.iter() {
                for b in w.bytes().iter() {
                    check = (check * 31 + b as i64) % 1000000007;
                }
                check = (check * 31 + 1) % 1000000007;
            }
        }
        check = (check * 31 + 2) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
