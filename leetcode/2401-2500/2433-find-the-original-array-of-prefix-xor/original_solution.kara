// LeetCode #2433: Find The Original Array of Prefix Xor -- LeetCode's
// Rust template, as Rust writes it, carried by karac fix: the first
// prefix by `std::iter::once`, chained before `windows(2)` of the list
// with each window's two prefixes XORed, and gathered by `collect()`.

impl Solution {
    pub fn find_array(pref: Vec[i32]) -> Vec[i32] {
        once(pref[0]).chain(pref.windows(2).into_iter().map(|w| w[0] ^ w[1])).collect()
    }
}

struct Solution {}

fn find_array(pref: Vec[i64]) -> Vec[i64] {
    let values: Vec[i32] = pref.iter().map(|x| x as i32).collect();
    Solution.find_array(values).iter().map(|x| x as i64).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a checksum of a list's values in order
fn fold(values: Vec[i64]) -> i64 {
    let mut check = 0;
    for v in values.iter() {
        check = (check * 31 + v) % 1000000007;
    }
    check
}

fn main() {
    // LeetCode's two examples; one zero; every prefix the same, so every
    // value after the first is 0; the constraints' largest value, 10^6,
    // against 0 in turn
    let cases: Vec[Vec[i64]] = [[5, 2, 0, 3, 1].to_vec(), [13].to_vec(), [0].to_vec(), [7, 7, 7, 7].to_vec(), [1000000, 0, 1000000, 0].to_vec()].to_vec();
    for pref in cases.into_iter() {
        let shown = f"{pref}";
        println(f"{shown}: {find_array(pref)}");
    }
    // 10^4 random prefixes from 0 to 10^6, then 10^4 that rise by one
    // from 0, each as a checksum
    let mut seed = 2433;
    let random: Vec[i64] = (0..10000).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000001).collect();
    println(f"10^4 random: checksum {fold(find_array(random))}");
    let rising: Vec[i64] = (0..10000).collect();
    println(f"10^4 rising: checksum {fold(find_array(rising))}");
    // 3000 random lists of 1 to 12 prefixes from 0 to 1 up to 0 to 63: a
    // checksum of every answer's checksum in order
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 12;
        let top = 1 + next_random(mut seed) % 63;
        let mut pref: Vec[i64] = Vec.new();
        for _ in 0..n {
            pref.push(next_random(mut seed) % (top + 1));
        }
        check = (check * 31 + fold(find_array(pref))) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
