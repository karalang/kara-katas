// LeetCode #2439: Minimize Maximum of Array -- a stack of levelled
// blocks: each value starts a block of its own, and while a block's
// average is at least the one before it the two are merged, since value
// may flow left across them. The averages left on the stack fall from
// the bottom up, so the bottom block is the prefix with the largest
// average, and its ceiling is the answer. Averages are compared by cross
// multiplication in `i128`, the sums reaching `10^14` and the lengths
// `10^5`. O(n).

struct Block {
    sum: i64,
    len: i64,
}

fn minimize_array_value(nums: Vec[i64]) -> i64 {
    let mut stack: Vec[Block] = Vec.new();
    for x in nums.iter() {
        let mut block = Block { sum: x, len: 1 };
        while stack.len() > 0 {
            let below = ref stack[stack.len() - 1];
            if (block.sum as i128) * (below.len as i128) < (below.sum as i128) * (block.len as i128) {
                break;
            }
            block = Block { sum: block.sum + below.sum, len: block.len + below.len };
            stack.pop();
        }
        stack.push(block);
    }
    (stack[0].sum + stack[0].len - 1) / stack[0].len
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; all zeros; everything at the end
    let cases: Vec[Vec[i64]] = [
        [3, 7, 1, 6].to_vec(),
        [10, 1].to_vec(),
        [0, 0].to_vec(),
        [0, 1000000000].to_vec(),
    ].to_vec();
    for nums in cases.into_iter() {
        println(f"{nums}: {minimize_array_value(nums)}");
    }
    // 10^4 values: 10^9 first; 10^9 last; every one 10^9; a rise by
    // 10^5; then random from 0 to 10^9
    let n = 10000;
    let mut first: Vec[i64] = Vec.filled(n, 0);
    first[0] = 1000000000;
    let mut last: Vec[i64] = Vec.filled(n, 0);
    last[n - 1] = 1000000000;
    let full: Vec[i64] = Vec.filled(n, 1000000000);
    let mut rise: Vec[i64] = Vec.new();
    for i in 0..n {
        rise.push(i * 100000);
    }
    let mut seed = 2439;
    let mut random: Vec[i64] = Vec.new();
    for _ in 0..n {
        random.push(wide_random(mut seed) % 1000000001);
    }
    println(f"10^9 first: {minimize_array_value(first)}");
    println(f"10^9 last: {minimize_array_value(last)}");
    println(f"all 10^9: {minimize_array_value(full)}");
    println(f"rising: {minimize_array_value(rise)}");
    println(f"random: {minimize_array_value(random)}");
    // 3000 random arrays of 2 to 12 values from 0 to 20: a checksum
    // and the total
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let len = 2 + next_random(mut seed) % 11;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..len {
            nums.push(next_random(mut seed) % 21);
        }
        let answer = minimize_array_value(nums);
        check = (check * 31 + answer) % 1000000007;
        total += answer;
    }
    println(f"3000 random: checksum {check}, total {total}");
}
