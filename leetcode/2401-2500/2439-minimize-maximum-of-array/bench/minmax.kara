// LeetCode #2439: Minimize Maximum of Array -- the bench, the ★ arm: the
// largest ceiling average of any prefix, in one pass.

fn minimize_array_value(nums: Vec[i64]) -> i64 {
    let mut sum = 0;
    let mut answer = 0;
    for i in 0..nums.len() {
        sum += nums[i];
        answer = answer.max((sum + i) / (i + 1));
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2439;
    // 10 arrays of 10^5 values from 0 to 10^9
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10 {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001);
        }
        arrays.push(nums);
    }
    // pass `p` sets one value of every array, then answers every array
    // and folds the answer plus the pass
    let mut check = 0;
    for p in 0..100 {
        for c in 0..arrays.len() {
            let at = (p * 7919 + c * 104729) % 100000;
            arrays[c][at] = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001;
            check = (check * 31 + minimize_array_value(arrays[c]) + p) % 1000000007;
        }
    }
    println(f"100 passes over 10 arrays of 10^5 values: checksum {check}");
}
