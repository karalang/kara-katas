// LeetCode #2407: Longest Increasing Subsequence II -- the differential.
// The six arms against the statement read literally: every subsequence,
// each one checked to rise strictly by at most k at every step, and the
// longest that does. No tree and no blocks. 360 cases: 300 random cases
// of 1 to 10 values from 1 to up to 30, k from 1 to 8, which the literal
// reading answers; 30 of up to 3000 values up to 10^4, k up to 10^4; and
// 30 of up to 3000 values up to 500, k up to 20. Every case is drawn
// before any arm answers.
//
// P1  up to 10 values: the answer is the literal reading's
// P2  k at least the largest value less the smallest: the plain longest
//     strictly increasing subsequence, by patience sorting; otherwise
//     between 1 and the number of distinct values
// P3  every value raised by 7: the same answer
// P4  k one larger: an answer at least as long
// P5  the values reversed, each v written m + 1 - v for m the largest:
//     the same answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn lis_literally(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut best = 0;
    for mask in 1..1 << n {
        let picked: Vec[i64] = (0..n).filter(|i| mask >> i & 1 == 1).map(|i| nums[i]).collect();
        let mut rises = true;
        for i in 1..picked.len() {
            let step = picked[i] - picked[i - 1];
            if step <= 0 or step > k {
                rises = false;
            }
        }
        if rises {
            best = best.max(picked.len());
        }
    }
    best
}

// The longest strictly increasing subsequence with no bound on a step, by
// patience sorting: the least last value of a subsequence of each length.
fn plain_lis(nums: Vec[i64]) -> i64 {
    let mut tails: Vec[i64] = Vec.new();
    for x in nums.iter() {
        let mut lo = 0;
        let mut hi = tails.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if tails[mid] < x {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo == tails.len() {
            tails.push(x);
        } else {
            tails[lo] = x;
        }
    }
    tails.len()
}

// ---- star (lis.kara) -----------------------------------------------------

fn star_length_of_lis(nums: Vec[i64], k: i64) -> i64 {
    let top = nums.iter().max().unwrap();
    let mut size = 1;
    while size <= top {
        size *= 2;
    }
    let mut tree: Vec[i64] = Vec.filled(2 * size, 0);
    let mut best = 0;
    for x in nums.iter() {
        // the maximum over the leaves of x - k to x - 1, clamped at 0
        let mut lo = (x - k).max(0) + size;
        let mut hi = x - 1 + size + 1;
        let mut longest = 0;
        while lo < hi {
            if lo % 2 == 1 {
                longest = longest.max(tree[lo]);
                lo += 1;
            }
            if hi % 2 == 1 {
                hi -= 1;
                longest = longest.max(tree[hi]);
            }
            lo /= 2;
            hi /= 2;
        }
        let mut at = x + size;
        tree[at] = tree[at].max(longest + 1);
        best = best.max(longest + 1);
        at /= 2;
        while at > 0 {
            tree[at] = tree[2 * at].max(tree[2 * at + 1]);
            at /= 2;
        }
    }
    best
}

// ---- recursive (lis_recursive.kara) --------------------------------------

fn recursive_query(tree: Vec[i64], node: i64, lo: i64, hi: i64, from: i64, to: i64) -> i64 {
    if to < lo or hi < from {
        return 0;
    }
    if from <= lo and hi <= to {
        return tree[node];
    }
    let mid = (lo + hi) / 2;
    recursive_query(tree, 2 * node, lo, mid, from, to).max(recursive_query(tree, 2 * node + 1, mid + 1, hi, from, to))
}

fn recursive_update(tree: mut ref Vec[i64], node: i64, lo: i64, hi: i64, at: i64, value: i64) {
    if lo == hi {
        tree[node] = tree[node].max(value);
        return;
    }
    let mid = (lo + hi) / 2;
    if at <= mid {
        recursive_update(mut tree, 2 * node, lo, mid, at, value);
    } else {
        recursive_update(mut tree, 2 * node + 1, mid + 1, hi, at, value);
    }
    tree[node] = tree[2 * node].max(tree[2 * node + 1]);
}

fn recursive_length_of_lis(nums: Vec[i64], k: i64) -> i64 {
    let top = nums.iter().max().unwrap();
    let mut tree: Vec[i64] = Vec.filled(4 * top + 4, 0);
    let mut best = 0;
    for x in nums.iter() {
        let longest = recursive_query(tree, 1, 1, top, x - k, x - 1) + 1;
        recursive_update(mut tree, 1, 1, top, x, longest);
        best = best.max(longest);
    }
    best
}

// ---- blocks (lis_blocks.kara) --------------------------------------------

fn blocks_length_of_lis(nums: Vec[i64], k: i64) -> i64 {
    let top = nums.iter().max().unwrap();
    let mut width = 1;
    while width * width < top + 1 {
        width += 1;
    }
    let mut ending: Vec[i64] = Vec.filled(top + 1, 0);
    let mut block: Vec[i64] = Vec.filled(top / width + 1, 0);
    let mut best = 0;
    for x in nums.iter() {
        let mut v = (x - k).max(0);
        let mut longest = 0;
        while v < x {
            if v % width == 0 and v + width <= x {
                longest = longest.max(block[v / width]);
                v += width;
            } else {
                longest = longest.max(ending[v]);
                v += 1;
            }
        }
        longest += 1;
        ending[x] = ending[x].max(longest);
        block[x / width] = block[x / width].max(longest);
        best = best.max(longest);
    }
    best
}

// ---- tree (lis_tree.kara) ------------------------------------------------

struct MaxTree {
    size: i64,
    cells: Vec[i64],
}

impl MaxTree {
    fn new(top: i64) -> MaxTree {
        let mut size = 1;
        while size <= top {
            size *= 2;
        }
        MaxTree {
            size: size,
            cells: Vec.filled(2 * size, 0),
        }
    }

    // The maximum over the values `from` to `to`, both included.
    fn most(self, from: i64, to: i64) -> i64 {
        let mut lo = from + self.size;
        let mut hi = to + self.size;
        let mut found = 0;
        while lo <= hi {
            if lo % 2 == 1 {
                found = found.max(self.cells[lo]);
                lo += 1;
            }
            if hi % 2 == 0 {
                found = found.max(self.cells[hi]);
                hi -= 1;
            }
            lo /= 2;
            hi /= 2;
        }
        found
    }

    fn raise(mut ref self, at: i64, value: i64) {
        let mut node = at + self.size;
        while node > 0 {
            self.cells[node] = self.cells[node].max(value);
            node /= 2;
        }
    }
}

fn tree_length_of_lis(nums: Vec[i64], k: i64) -> i64 {
    let mut tree = MaxTree.new(nums.iter().max().unwrap());
    let mut best = 0;
    for x in nums.iter() {
        let longest = tree.most((x - k).max(0), x - 1) + 1;
        tree.raise(x, longest);
        best = best.max(longest);
    }
    best
}

// ---- iter (lis_iter.kara) ------------------------------------------------

fn iter_length_of_lis(nums: Vec[i64], k: i64) -> i64 {
    let top = nums.iter().max().unwrap();
    let width = (1..top + 2).find(|w| w * w >= top + 1).unwrap();
    let mut ending: Vec[i64] = Vec.filled(top + 1, 0);
    let mut block: Vec[i64] = Vec.filled(top / width + 1, 0);
    nums.iter().fold(0, |best, x| {
        let from = (x - k).max(0);
        let first = (from + width - 1) / width;
        let last = x / width;
        let longest = if first >= last {
            ending[from..x].iter().max().unwrap_or(0)
        } else {
            let left = ending[from..first * width].iter().max().unwrap_or(0);
            let middle = block[first..last].iter().max().unwrap_or(0);
            let right = ending[last * width..x].iter().max().unwrap_or(0);
            left.max(middle).max(right)
        } + 1;
        ending[x] = ending[x].max(longest);
        block[x / width] = block[x / width].max(longest);
        best.max(longest)
    })
}

// ---- solution (lis_solution.kara) ----------------------------------------

impl Solution {
    pub fn length_of_lis(nums: Vec[i32], k: i32) -> i32 {
        let m = *nums.iter().max().unwrap() as i64 + 1;
        let mut tree = Vec.filled(2 * m, 0i32);
        let mut ans: i32 = 0;
        for x in ref nums {
            let x = x as i64;
            let mut (l, r) = (x.saturating_sub(k as i64).max(0) + m, x + m);
            let mut best: i32 = 0;
            while l < r {
                if l & 1 == 1 {
                    best = best.max(tree[l]);
                    l += 1;
                }
                if r & 1 == 1 {
                    r -= 1;
                    best = best.max(tree[r]);
                }
                l >>= 1;
                r >>= 1;
            }
            let mut i = x + m;
            tree[i] = best + 1;
            ans = ans.max(best + 1);
            while i > 1 {
                i >>= 1;
                tree[i] = tree[2 * i].max(tree[2 * i + 1]);
            }
        }
        ans
    }
}

struct Solution {}

fn solution_length_of_lis(nums: Vec[i64], k: i64) -> i64 {
    let values: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.length_of_lis(values, k as i32)
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_length_of_lis(nums, k),
        1 => recursive_length_of_lis(nums, k),
        2 => blocks_length_of_lis(nums, k),
        3 => tree_length_of_lis(nums, k),
        4 => iter_length_of_lis(nums, k),
        _ => solution_length_of_lis(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "recursive", "blocks", "tree", "iter", "solution"];
    let mut seed = 2407;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..360 {
        let (n, top, k) = if t < 300 {
            (1 + next_random(mut seed) % 10, 1 + next_random(mut seed) % 30, 1 + next_random(mut seed) % 8)
        } else if t < 330 {
            (1 + next_random(mut seed) % 3000, 10000, 1 + next_random(mut seed) % 10000)
        } else {
            (1 + next_random(mut seed) % 3000, 500, 1 + next_random(mut seed) % 20)
        };
        let nums: Vec[i64] = (0..n).map(|_| 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top).collect();
        cases.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (nums, k) = cases[c].clone();
        let n = nums.len();
        let truth = if n <= 10 {
            lis_literally(nums, k)
        } else {
            -1
        };
        if truth >= 0 {
            check = (check * 31 + truth) % 1000000007;
        }
        let top = nums.iter().max().unwrap();
        let bottom = nums.iter().min().unwrap();
        let plain = if k >= top - bottom {
            plain_lis(nums)
        } else {
            -1
        };
        let mut distinct = nums.clone();
        distinct.sort();
        distinct.dedup();
        let raised: Vec[i64] = nums.iter().map(|v| v + 7).collect();
        let mut mirrored: Vec[i64] = nums.iter().map(|v| top + 1 - v).collect();
        mirrored.reverse();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [truth < 0 or value == truth, if plain >= 0 {
                value == plain
            } else {
                value >= 1 and value <= distinct.len()
            }, answer(arm, raised, k) == value, answer(arm, nums, k + 1) >= value, answer(arm, mirrored, k) == value, same >= 3];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
