// LeetCode #2491: Divide Players Into Teams of Equal Skill -- benchmark of
// the ★ arm (divide.kara): 20 lists of 10^5 skills that divide, built once,
// then 25 passes; each sets one skill of every list to a value chosen by
// the checksum so far, asks, and puts it back, folding the answer plus
// the pass into the checksum.

fn divide_players(skill: Vec[i64]) -> i64 {
    let mut sorted = skill.clone();
    sorted.sort();
    let n = sorted.len();
    let target = sorted[0] + sorted[n - 1];
    let mut chemistry = 0;
    for i in 0..n / 2 {
        let (a, b) = (sorted[i], sorted[n - 1 - i]);
        if a + b != target {
            return -1;
        }
        chemistry += a * b;
    }
    chemistry
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 100000;
    let passes = 25;
    let mut seed = 2491;
    let mut lists: Vec[Vec[i64]] = Vec.new();
    for l in 0..20 {
        let total = 500 + l * 50;
        let mut skill: Vec[i64] = Vec.new();
        for _ in 0..n / 2 {
            let a = next_random(mut seed) % (total - 1) + 1;
            skill.push(a);
            skill.push(total - a);
        }
        for i in (1..n).rev() {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            skill.swap(i, j);
        }
        lists.push(skill);
    }
    let mut check = 0;
    for p in 0..passes {
        for l in 0..20 {
            let at = check % n;
            let was = lists[l][at];
            lists[l][at] = (check / n + p) % 1000 + 1;
            check = (check * 31 + divide_players(lists[l]) + 1 + p) % 1000000007;
            lists[l][at] = was;
        }
    }
    println(f"{passes} passes over 20 lists of 10^5: checksum {check}");
}
