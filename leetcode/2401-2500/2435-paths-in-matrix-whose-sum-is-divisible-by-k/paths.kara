// LeetCode #2435: Paths in Matrix Whose Sum Is Divisible by K -- the ★
// arm. A path reaches a cell from above or from the left, and only its
// sum modulo `k` matters, so each cell keeps a count for each remainder,
// one row of them at a time: a cell's counts are those above, still in
// place, plus those to its left, each shifted by the cell's value.
// O(m n k) time, O(n k) space.

const MOD: i64 = 1000000007;

fn number_of_paths(grid: Vec[Vec[i64]], k: i64) -> i64 {
    let n = grid[0].len();
    let mut row: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(k, 0));
    for i in 0..grid.len() {
        for j in 0..n {
            let mut came: Vec[i64] = Vec.filled(k, 0);
            if i == 0 and j == 0 {
                came[0] = 1;
            }
            for r in 0..k {
                let left = if j > 0 { row[j - 1][r] } else { 0 };
                came[r] = (came[r] + row[j][r] + left) % MOD;
            }
            let v = grid[i][j];
            for r in 0..k {
                row[j][(r + v) % k] = came[r];
            }
        }
    }
    row[n - 1][0]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_grid(seed: mut ref i64, m: i64, n: i64, top: i64) -> Vec[Vec[i64]] {
    let mut grid: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(next_random(mut seed) % (top + 1));
        }
        grid.push(row);
    }
    grid
}

fn main() {
    // LeetCode's three examples; one cell divisible, and not; a 2 by 2
    // of zeros, both paths counting
    let cases: Vec[(Vec[Vec[i64]], i64)] = [
        ([[5, 2, 4].to_vec(), [3, 0, 5].to_vec(), [0, 7, 2].to_vec()].to_vec(), 3),
        ([[0, 0].to_vec()].to_vec(), 5),
        ([[7, 3, 4, 9].to_vec(), [2, 3, 6, 2].to_vec(), [2, 3, 7, 0].to_vec()].to_vec(), 1),
        ([[50].to_vec()].to_vec(), 50),
        ([[49].to_vec()].to_vec(), 50),
        ([[0, 0].to_vec(), [0, 0].to_vec()].to_vec(), 7),
    ].to_vec();
    for (grid, k) in cases.into_iter() {
        println(f"{grid.len()} by {grid[0].len()}, k = {k}: {number_of_paths(grid, k)}");
    }
    // the constraints' largest: 200 by 250 with k = 50, a count past
    // 10^9 + 7 many times over; 2 by 25000 with k = 17; and 250 by 200 of
    // all 100 with k = 1, every path counting
    let mut seed = 2435;
    println(f"200 by 250, k = 50: {number_of_paths(random_grid(mut seed, 200, 250, 100), 50)}");
    println(f"2 by 25000, k = 17: {number_of_paths(random_grid(mut seed, 2, 25000, 100), 17)}");
    let full: Vec[Vec[i64]] = (0..250).map(|_| Vec.filled(200, 100)).collect();
    println(f"250 by 200 of 100, k = 1: {number_of_paths(full, 1)}");
    // 3000 random grids of 1 to 4 by 1 to 4, values up to 9, k from 1 to
    // 6: a checksum of the answers in order, and their total
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let m = 1 + next_random(mut seed) % 4;
        let n = 1 + next_random(mut seed) % 4;
        let k = 1 + next_random(mut seed) % 6;
        let answer = number_of_paths(random_grid(mut seed, m, n, 9), k);
        check = (check * 31 + answer) % 1000000007;
        total += answer;
    }
    println(f"3000 random: checksum {check}, total {total}");
}
