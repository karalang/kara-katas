// LeetCode #2429: Minimize XOR -- bit by bit from the top, each bit of `x`
// chosen to match `num1`'s whenever the bits still to place can be put
// in the bits below, and the other way otherwise. A match at a higher
// bit outweighs every bit below it, so each choice is final. O(31).

fn minimize_xor(num1: i64, num2: i64) -> i64 {
    let mut left = num2.count_ones();
    let mut x = 0;
    for bit in (0..31).rev() {
        let wanted = (num1 >> bit) & 1;
        // after this bit, `bit` bits remain below it
        let set = if wanted == 1 { left > 0 } else { left > bit };
        if set {
            x |= 1 << bit;
            left -= 1;
        }
    }
    x
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; 1 and 1; the constraints' largest, 10^9
    // twice; 1 against 29 set bits, the most a value to 10^9 holds; 2^29
    // against 29 set bits; 10^9 against one set bit; 2^29 - 1 against 1
    for (a, b) in [(3, 5), (1, 12), (1, 1), (1000000000, 1000000000), (1, 536870911), (536870912, 536870911), (1000000000, 1), (536870911, 1)].iter() {
        println(f"{a} {b}: {minimize_xor(a, b)}");
    }
    // 3000 random pairs from 1 to 10^9, and 3000 from 1 to 63: a checksum
    // of the answers in order
    let mut seed = 2429;
    for top in [1000000000, 63].iter() {
        let mut check = 0;
        for _ in 0..3000 {
            let a = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
            let b = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
            check = (check * 31 + minimize_xor(a, b)) % 1000000007;
        }
        println(f"3000 random up to {top}: checksum {check}");
    }
}
