// LeetCode #2488: Count Subarrays With Median K -- the differential. The
// six arms against the statement read literally: every subarray sorted
// afresh and its median, the left of the two middle numbers at an even
// length, compared with `k`. 300 random orders of 1 to 12 numbers, then
// 20 of one or two, and 40 of 20 to 40; `k` any of the numbers; every one
// drawn before any arm answers.
//
// P1  the count is the statement read literally
// P2  at least 1, `[k]` itself, and at most the subarrays that hold `k`
// P3  the numbers reversed: the same count
// P4  `k` the least, 1: one more than the numbers beside 1
// P5  `k` the greatest, `n`: 1
// P6  each arm agrees with at least three of the other five

// ---- star (median.kara) --------------------------------------------------

fn star_count_subarrays(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let at = nums.iter().position(|v| v == k).unwrap();
    let mut starts: Map[i64, i64] = Map.new();
    starts[0] = 1;
    let mut balance = 0;
    for i in (0..at).rev() {
        balance += if nums[i] > k { 1 } else { -1 };
        starts[balance] = starts.get(balance).unwrap_or(0) + 1;
    }
    let mut count = 0;
    balance = 0;
    for j in at..n {
        if j > at {
            balance += if nums[j] > k { 1 } else { -1 };
        }
        count += starts.get(-balance).unwrap_or(0) + starts.get(1 - balance).unwrap_or(0);
    }
    count
}

// ---- array (median_array.kara) -------------------------------------------

fn array_count_subarrays(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut at = 0;
    while nums[at] != k {
        at += 1;
    }
    let mut starts: Vec[i64] = Vec.filled(2 * n + 2, 0);
    let mut balance = 0;
    starts[n] = 1;
    for i in (0..at).rev() {
        if nums[i] > k {
            balance += 1;
        } else {
            balance -= 1;
        }
        starts[n + balance] += 1;
    }
    let mut count = 0;
    balance = 0;
    for j in at..n {
        if nums[j] > k {
            balance += 1;
        } else if nums[j] < k {
            balance -= 1;
        }
        count += starts[n - balance];
        if n + 1 - balance <= 2 * n {
            count += starts[n + 1 - balance];
        }
    }
    count
}

// ---- prefix (median_prefix.kara) -----------------------------------------

fn prefix_count_subarrays(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut sums: Vec[i64] = Vec.filled(n + 1, 0);
    let mut at = 0;
    for i in 0..n {
        let sign = if nums[i] > k { 1 } else if nums[i] < k { -1 } else { 0 };
        sums[i + 1] = sums[i] + sign;
        if nums[i] == k {
            at = i;
        }
    }
    let mut seen: Map[i64, i64] = Map.new();
    for i in 0..at + 1 {
        seen[sums[i]] = seen.get(sums[i]).unwrap_or(0) + 1;
    }
    let mut count = 0;
    for j in at..n {
        count += seen.get(sums[j + 1]).unwrap_or(0) + seen.get(sums[j + 1] - 1).unwrap_or(0);
    }
    count
}

// ---- sorted (median_sorted.kara) -----------------------------------------

fn sorted_count_subarrays(nums: Vec[i64], k: i64) -> i64 {
    let at = nums.iter().position(|v| v == k).unwrap();
    let mut starts: Vec[i64] = [0].to_vec();
    let mut balance = 0;
    for v in nums[0..at].iter().rev() {
        balance += if v > k { 1 } else { -1 };
        starts.push(balance);
    }
    starts.sort();
    let mut count = 0;
    balance = 0;
    for v in nums[at..].iter() {
        balance += if v > k { 1 } else if v < k { -1 } else { 0 };
        // the starts whose balance is -balance or 1 - balance
        let low = starts.partition_point(|s| s < -balance);
        let high = starts.partition_point(|s| s <= 1 - balance);
        count += high - low;
    }
    count
}

// ---- iter (median_iter.kara) ---------------------------------------------

fn iter_count_subarrays(nums: Vec[i64], k: i64) -> i64 {
    let at = nums.iter().position(|v| v == k).unwrap();
    let sign = |v: i64| if v > k { 1 } else if v < k { -1 } else { 0 };
    let starts: Map[i64, i64] = nums[0..at]
        .iter()
        .rev()
        .scan(0, |balance, v| {
            let balance = balance + sign(v);
            Some((balance, balance))
        })
        .fold(Map.from([(0, 1)]), |counts: own Map[i64, i64], b| {
            let mut counts = counts;
            counts[b] = counts.get(b).unwrap_or(0) + 1;
            counts
        });
    nums[at..]
        .iter()
        .scan(0, |balance, v| {
            let balance = balance + sign(v);
            Some((balance, balance))
        })
        .map(|b| starts.get(-b).unwrap_or(0) + starts.get(1 - b).unwrap_or(0))
        .sum()
}

// ---- solution (median_solution.kara) -------------------------------------

struct Solution {}

impl Solution {
    pub fn count_subarrays(nums: Vec[i32], k: i32) -> i32 {
        let pos = nums.iter().position(|x| x == k).unwrap();
        let mut cnt: Map[i32, i32] = Map.new();
        cnt.insert(0, 1);
        let mut bal = 0;
        for i in (0..pos).rev() {
            bal += if nums[i] > k { 1 } else { -1 };
            *cnt.entry(bal).or_insert(0) += 1;
        }
        let mut ans: i32 = 0;
        bal = 0;
        for j in pos..nums.len() {
            if nums[j] > k {
                bal += 1;
            } else if nums[j] < k {
                bal -= 1;
            }
            ans += cnt.get(-bal).unwrap_or(0) + cnt.get(1 - bal).unwrap_or(0);
        }
        ans
    }
}

fn solution_count_subarrays(nums: Vec[i64], k: i64) -> i64 {
    Solution.count_subarrays(nums.iter().map(|v| v as i32).collect(), k as i32)
}

// ---- the statement read literally

fn literal(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut count = 0;
    for i in 0..n {
        for j in i..n {
            let mut part: Vec[i64] = nums[i..j + 1].to_vec();
            part.sort();
            if part[(part.len() - 1) / 2] == k {
                count += 1;
            }
        }
    }
    count
}

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_count_subarrays(nums, k),
        1 => array_count_subarrays(nums, k),
        2 => prefix_count_subarrays(nums, k),
        3 => sorted_count_subarrays(nums, k),
        4 => iter_count_subarrays(nums, k),
        _ => solution_count_subarrays(nums, k),
    }
}

// ---- cases

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn permutation(n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = (1..n + 1).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        nums.swap(i, j);
    }
    nums
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    let names = ["star", "array", "prefix", "sorted", "iter", "solution"];
    let mut seed = 2488;
    let mut problems: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..360 {
        let mut n = next_random(mut seed) % 12 + 1;
        if t >= 300 and t < 320 {
            n = next_random(mut seed) % 2 + 1;
        } else if t >= 320 {
            n = next_random(mut seed) % 21 + 20;
        }
        let nums = permutation(n, mut seed);
        let k = next_random(mut seed) % n + 1;
        problems.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (nums, k) in problems.iter() {
        let n = nums.len();
        let truth = literal(nums, k);
        check = (check * 31 + truth) % 1000000007;
        let at = nums.iter().position(|v| v == k).unwrap();
        let one = nums.iter().position(|v| v == 1).unwrap();
        let beside = (if one > 0 { 1 } else { 0 }) + (if one + 1 < n { 1 } else { 0 });
        let reversed: Vec[i64] = nums.iter().rev().cloned().collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                x >= 1 and x <= (at + 1) * (n - at),
                answer(arm, reversed, k) == x,
                answer(arm, nums, 1) == 1 + beside,
                answer(arm, nums, n) == 1,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{show(nums)}, {k} arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
