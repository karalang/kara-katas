// LeetCode #2457: Minimum Addition to Make Integer Beautiful -- a digit
// vector: `n`'s digits lowest first, and while their sum is too large
// the lowest nonzero digit is cleared and one carried into the digit
// above it, the carry running on through nines; the digits read back
// into a number. O(log^2 n).

fn make_integer_beautiful(n: i64, target: i64) -> i64 {
    let mut digits: Vec[i64] = Vec.new();
    let mut rest = n;
    while rest > 0 {
        digits.push(rest % 10);
        rest /= 10;
    }
    let mut low = 0;
    while digits.iter().sum() > target {
        while digits[low] == 0 {
            low += 1;
        }
        digits[low] = 0;
        let mut at = low + 1;
        loop {
            if at == digits.len() {
                digits.push(0);
            }
            if digits[at] < 9 {
                digits[at] += 1;
                break;
            }
            digits[at] = 0;
            at += 1;
        }
    }
    let mut m = 0;
    for d in digits.iter().rev() {
        m = m * 10 + d;
    }
    m - n
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; 10^12, the constraints' most, already
    // fitting; 10^12 - 1 down to one digit, a carry through twelve nines;
    // 19 down to 1; a zero ending kept; the most digit sum a target needs
    println(f"{make_integer_beautiful(16, 6)}");
    println(f"{make_integer_beautiful(467, 6)}");
    println(f"{make_integer_beautiful(1, 1)}");
    println(f"{make_integer_beautiful(1000000000000, 1)}");
    println(f"{make_integer_beautiful(999999999999, 1)}");
    println(f"{make_integer_beautiful(19, 1)}");
    println(f"{make_integer_beautiful(190, 1)}");
    println(f"{make_integer_beautiful(999999999999, 108)}");
    // 2000 random values up to 10^12 against targets from 1 to 150: a
    // checksum of the answers in order, and their total
    let mut seed = 2457;
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let n = 1 + (next_random(mut seed) * 1073741824 + next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000000;
        let target = 1 + next_random(mut seed) % 150;
        let answer = make_integer_beautiful(n, target);
        check = (check * 31 + answer) % 1000000007;
        total += answer;
    }
    println(f"2000 values up to 10^12: checksum {check}, total {total}");
    // 3000 random values up to 10^4 against targets from 1 to 20
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 10000;
        let target = 1 + next_random(mut seed) % 20;
        check = (check * 31 + make_integer_beautiful(n, target)) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
