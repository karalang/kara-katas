// LeetCode #2457: Minimum Addition to Make Integer Beautiful -- bench.
// 10^5 pairs of a value up to 10^12 and a target are built once; each of
// 36 passes moves every target by the pass, so no answer carries over,
// then answers every pair, folding the answer plus the pass into the
// checksum. The ★ arm: while the digit sum is too large, `n + x` is
// rounded up to the next multiple of a power of ten one place higher.

fn digit_sum(x: i64) -> i64 {
    let mut rest = x;
    let mut sum = 0;
    while rest > 0 {
        sum += rest % 10;
        rest /= 10;
    }
    sum
}

fn make_integer_beautiful(n: i64, target: i64) -> i64 {
    let mut m = n;
    let mut p = 1;
    while digit_sum(m) > target {
        p *= 10;
        m = (m + p - 1) / p * p;
    }
    m - n
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2457;
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for _ in 0..100000 {
        let n = 1 + (next_random(mut seed) * 1073741824 + next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000000;
        pairs.push((n, next_random(mut seed) % 150));
    }
    let mut check = 0;
    for p in 0..36 {
        for (n, t) in pairs.iter() {
            check = (check * 31 + make_integer_beautiful(n, 1 + (t + p) % 150) + p) % 1000000007;
        }
    }
    println(f"36 passes over 10^5 pairs: checksum {check}");
}
