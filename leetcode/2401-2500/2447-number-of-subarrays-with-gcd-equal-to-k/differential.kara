// LeetCode #2447: Number of Subarrays With GCD Equal to K -- the
// differential. The six arms against the statement read literally: every
// subarray `nums[i..=j]` tested value by value, and counted when `k`
// divides every value and no larger multiple of `k`, up to the least
// value, does. A common divisor larger than `k` would make the GCD a
// multiple of `k` larger than `k`, so those are the only ones to try. No
// remainder chain is run. 360 cases: 300 random arrays of 1 to 10 values
// from 1 to 60, `k` from 1 to 12; then 30 of up to 30 values, each `k`
// times 1 to 30, `k` up to 10^6; then 30 of up to 60 values from 1 to 12,
// `k` 1 or 2. Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the values reversed: the same answer
// P3  every value put twice in a row: four times the answer, less the
//     count of values equal to `k`
// P4  `k` appended: the answer plus one more than the length of the run
//     of multiples of `k` that ends the array
// P5  a value that is no multiple of `k` put at a place, when `k` is
//     above 1: the two parts' answers added
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn divides_all(d: i64, nums: Vec[i64], i: i64, j: i64) -> bool {
    for t in i..j + 1 {
        if nums[t] % d != 0 {
            return false;
        }
    }
    true
}

fn gcd_literally(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut count = 0;
    for i in 0..n {
        for j in i..n {
            if not divides_all(k, nums, i, j) {
                continue;
            }
            let mut least = nums[i];
            for t in i..j + 1 {
                least = least.min(nums[t]);
            }
            let mut larger = false;
            let mut d = 2 * k;
            while d <= least and not larger {
                larger = divides_all(d, nums, i, j);
                d += k;
            }
            if not larger {
                count += 1;
            }
        }
    }
    count
}

// ---- star (gcd.kara) -----------------------------------------------------

fn star_gcd(a: i64, b: i64) -> i64 {
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let r = x % y;
        x = y;
        y = r;
    }
    x
}

fn star_subarray_gcd(nums: Vec[i64], k: i64) -> i64 {
    let mut count = 0;
    for i in 0..nums.len() {
        let mut g = 0;
        for j in i..nums.len() {
            g = star_gcd(g, nums[j]);
            if g % k != 0 {
                break;
            }
            if g == k {
                count += 1;
            }
        }
    }
    count
}

// ---- naive (gcd_naive.kara) ----------------------------------------------

fn naive_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { naive_gcd(b, a % b) }
}

fn naive_subarray_gcd(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut count = 0;
    for i in 0..n {
        let mut g = nums[i];
        for j in i..n {
            g = naive_gcd(g, nums[j]);
            if g == k {
                count += 1;
            }
        }
    }
    count
}

// ---- list (gcd_list.kara) ------------------------------------------------

fn list_gcd(a: i64, b: i64) -> i64 {
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let r = x % y;
        x = y;
        y = r;
    }
    x
}

fn list_subarray_gcd(nums: Vec[i64], k: i64) -> i64 {
    let mut count = 0;
    let mut ending: Vec[(i64, i64)] = Vec.new();
    for x in nums.iter() {
        let mut next: Vec[(i64, i64)] = [(x, 1)].to_vec();
        for (g, c) in ending.iter() {
            let h = list_gcd(g, x);
            let last = next.len() - 1;
            if next[last].0 == h {
                next[last].1 += c;
            } else {
                next.push((h, c));
            }
        }
        for (g, c) in next.iter() {
            if g == k {
                count += c;
            }
        }
        ending = next;
    }
    count
}

// ---- sparse (gcd_sparse.kara) --------------------------------------------

fn sparse_gcd(a: i64, b: i64) -> i64 {
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let r = x % y;
        x = y;
        y = r;
    }
    x
}

struct Sparse {
    table: Vec[Vec[i64]],
}

impl Sparse {
    fn new(nums: Vec[i64]) -> Sparse {
        let n = nums.len();
        let mut table: Vec[Vec[i64]] = [nums.clone()].to_vec();
        let mut span = 1;
        while 2 * span <= n {
            let below = table[table.len() - 1].clone();
            let mut row: Vec[i64] = Vec.new();
            for i in 0..n - 2 * span + 1 {
                row.push(sparse_gcd(below[i], below[i + span]));
            }
            table.push(row);
            span *= 2;
        }
        Sparse { table: table }
    }

    // the GCD of `nums[l..=r]`
    fn query(self, l: i64, r: i64) -> i64 {
        let mut p = 0;
        while (2 << p) <= r - l + 1 {
            p += 1;
        }
        sparse_gcd(self.table[p][l], self.table[p][r + 1 - (1 << p)])
    }
}

// the first end `j` from `i` with `stop(sparse_gcd(nums[i..=j]))`, or `n`
fn sparse_first_end(sparse: Sparse, i: i64, n: i64, k: i64, exact: bool) -> i64 {
    let mut lo = i;
    let mut hi = n;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let g = sparse.query(i, mid);
        let stop = g % k != 0 or (exact and g == k);
        if stop {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

fn sparse_subarray_gcd(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let sparse = Sparse.new(nums);
    let mut count = 0;
    for i in 0..n {
        let first = sparse_first_end(sparse, i, n, k, true);
        let past = sparse_first_end(sparse, i, n, k, false);
        count += past - first;
    }
    count
}

// ---- iter (gcd_iter.kara) ------------------------------------------------

fn iter_gcd(a: i64, b: i64) -> i64 {
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let r = x % y;
        x = y;
        y = r;
    }
    x
}

fn iter_subarray_gcd(nums: Vec[i64], k: i64) -> i64 {
    (0..nums.len())
        .map(|i| {
            nums[i..]
                .iter()
                .scan(0, |g, x| {
                    let g = iter_gcd(g, x);
                    Some((g, g))
                })
                .take_while(|g| g % k == 0)
                .filter(|g| g == k)
                .count()
        })
        .sum()
}

// ---- solution (gcd_solution.kara) ----------------------------------------

fn solution_gcd(a: i32, b: i32) -> i32 {
    if b == 0 { a } else { solution_gcd(b, a % b) }
}

impl Solution {
    pub fn subarray_gcd(nums: Vec[i32], k: i32) -> i32 {
        let n = nums.len();
        let mut ans = 0;
        for i in 0..n {
            let mut g = 0;
            for j in i..n {
                g = solution_gcd(g, nums[j]);
                if g == k {
                    ans += 1;
                } else if g < k {
                    break;
                }
            }
        }
        ans
    }
}

struct Solution {}

fn solution_subarray_gcd(nums: Vec[i64], k: i64) -> i64 {
    let values: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.subarray_gcd(values, k as i32)
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_subarray_gcd(nums, k),
        1 => naive_subarray_gcd(nums, k),
        2 => list_subarray_gcd(nums, k),
        3 => sparse_subarray_gcd(nums, k),
        4 => iter_subarray_gcd(nums, k),
        _ => solution_subarray_gcd(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arms = ["star", "naive", "list", "sparse", "iter", "solution"];
    let mut seed = 2447;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..360 {
        let mut nums: Vec[i64] = Vec.new();
        let mut k = 0;
        if t < 300 {
            for _ in 0..1 + next_random(mut seed) % 10 {
                nums.push(1 + next_random(mut seed) % 60);
            }
            k = 1 + next_random(mut seed) % 12;
        } else if t < 330 {
            k = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000;
            for _ in 0..1 + next_random(mut seed) % 30 {
                nums.push(k * (1 + next_random(mut seed) % 30));
            }
        } else {
            for _ in 0..1 + next_random(mut seed) % 60 {
                nums.push(1 + next_random(mut seed) % 12);
            }
            k = 1 + next_random(mut seed) % 2;
        }
        cases.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (nums, k) = cases[c].clone();
        let n = nums.len();
        let truth = gcd_literally(nums, k);
        check = (check * 31 + truth) % 1000000007;
        let mut reversed = nums.clone();
        reversed.reverse();
        let mut doubled: Vec[i64] = Vec.new();
        let mut equal = 0;
        for x in nums.iter() {
            doubled.push(x);
            doubled.push(x);
            if x == k {
                equal += 1;
            }
        }
        let mut appended = nums.clone();
        appended.push(k);
        let mut run = 0;
        while run < n and nums[n - 1 - run] % k == 0 {
            run += 1;
        }
        let place = next_random(mut seed) % (n + 1);
        let mut split = nums[..place].to_vec();
        split.push(k + 1);
        split.extend(nums[place..].iter().cloned());
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let parts = answer(arm, nums[..place].to_vec(), k) + answer(arm, nums[place..].to_vec(), k);
            let verdicts = [
                value == truth,
                answer(arm, reversed, k) == value,
                answer(arm, doubled, k) == 4 * value - equal,
                answer(arm, appended, k) == value + run + 1,
                k == 1 or answer(arm, split, k) == parts,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
