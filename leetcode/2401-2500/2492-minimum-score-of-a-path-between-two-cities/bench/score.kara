// LeetCode #2492: Minimum Score of a Path Between Two Cities -- benchmark
// of the ★ arm (score.kara): one map of 10^5 cities and 10^5 roads, built
// once, then 50 passes; each sets one road's distance to a value chosen
// by the checksum so far, asks, and puts it back, folding the answer plus
// the pass into the checksum.

fn min_score(n: i64, roads: Vec[Vec[i64]]) -> i64 {
    let mut next: Vec[Vec[(i64, i64)]] = Vec.filled(n + 1, Vec.new());
    for road in roads.iter() {
        next[road[0]].push((road[1], road[2]));
        next[road[1]].push((road[0], road[2]));
    }
    let mut seen: Vec[bool] = Vec.filled(n + 1, false);
    let mut queue: Vec[i64] = [1].to_vec();
    seen[1] = true;
    let mut head = 0;
    let mut least = i64.MAX;
    while head < queue.len() {
        let city = queue[head];
        head += 1;
        for (other, distance) in next[city].iter() {
            least = least.min(distance);
            if not seen[other] {
                seen[other] = true;
                queue.push(other);
            }
        }
    }
    least
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 100000;
    let passes = 50;
    let mut seed = 2492;
    let mut roads: Vec[Vec[i64]] = [[1, n, 10000].to_vec()].to_vec();
    while roads.len() < n {
        let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % n + 1;
        let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % n + 1;
        if a != b {
            roads.push([a, b, next_random(mut seed) % 10000 + 1].to_vec());
        }
    }
    let m = roads.len();
    let mut check = 0;
    for p in 0..passes {
        let at = check % m;
        let was = roads[at][2];
        roads[at][2] = (check / m + p) % 10000 + 1;
        check = (check * 31 + min_score(n, roads) + p) % 1000000007;
        roads[at][2] = was;
    }
    println(f"{passes} passes over 10^5 cities and {m} roads: checksum {check}");
}
