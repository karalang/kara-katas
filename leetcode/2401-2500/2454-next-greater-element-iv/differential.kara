// LeetCode #2454: Next Greater Element IV -- the differential. The six
// arms against the statement read literally: for each `i`, every `j`
// after it tried in order, and `j` is the answer when `nums[j] > nums[i]`
// and exactly one `k` between them has `nums[k] > nums[i]`, counted
// afresh for each `j`. No stack is kept and no greater value carried
// over. 360 cases: 300 random of 1 to 10 values up to 9; then 30 of up
// to 40 values up to 10^8; then 30 of up to 40 values up to 2, full of
// repeats. Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  every value raised by one constant up to 1000: each answer raised by it, -1 kept
// P3  every value doubled: each answer doubled, -1 kept
// P4  each answer -1 or a value later in the array and greater than its own
// P5  two values above every other put after the end: each answer kept, each -1 that value, and -1 for the two
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn second_literally(nums: Vec[i64]) -> Vec[i64] {
    let n = nums.len();
    let mut answer: Vec[i64] = Vec.new();
    for i in 0..n {
        let mut found = -1;
        for j in i + 1..n {
            let mut between = 0;
            for k in i + 1..j {
                if nums[k] > nums[i] {
                    between += 1;
                }
            }
            if nums[j] > nums[i] and between == 1 {
                found = nums[j];
                break;
            }
        }
        answer.push(found);
    }
    answer
}

// ---- star (second.kara) --------------------------------------------------

fn star_second_greater_element(nums: Vec[i64]) -> Vec[i64] {
    let n = nums.len();
    let mut answer: Vec[i64] = Vec.filled(n, -1);
    let mut first: Vec[i64] = Vec.new();
    let mut second: Vec[i64] = Vec.new();
    for j in 0..n {
        while second.len() > 0 and nums[second[second.len() - 1]] < nums[j] {
            answer[second.pop().unwrap()] = nums[j];
        }
        let mut cut = first.len();
        while cut > 0 and nums[first[cut - 1]] < nums[j] {
            cut -= 1;
        }
        for i in cut..first.len() {
            second.push(first[i]);
        }
        first.truncate(cut);
        first.push(j);
    }
    answer
}

// ---- naive (second_naive.kara) -------------------------------------------

fn naive_second_greater_element(nums: Vec[i64]) -> Vec[i64] {
    let n = nums.len();
    let mut answer: Vec[i64] = Vec.new();
    for i in 0..n {
        let mut seen = 0;
        let mut found = -1;
        for j in i + 1..n {
            if nums[j] > nums[i] {
                seen += 1;
                if seen == 2 {
                    found = nums[j];
                    break;
                }
            }
        }
        answer.push(found);
    }
    answer
}

// ---- heap (second_heap.kara) ---------------------------------------------

fn heap_second_greater_element(nums: Vec[i64]) -> Vec[i64] {
    let n = nums.len();
    let mut answer: Vec[i64] = Vec.filled(n, -1);
    let mut waiting: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut once: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    for j in 0..n {
        while let Some((v, i)) = once.peek() {
            if v >= nums[j] {
                break;
            }
            answer[i] = nums[j];
            once.pop();
        }
        while let Some((v, i)) = waiting.peek() {
            if v >= nums[j] {
                break;
            }
            once.push((v, i));
            waiting.pop();
        }
        waiting.push((nums[j], j));
    }
    answer
}

// ---- sorted (second_sorted.kara) -----------------------------------------

fn sorted_second_greater_element(nums: Vec[i64]) -> Vec[i64] {
    let n = nums.len();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by_key(|i| -nums[i]);
    let mut answer: Vec[i64] = Vec.filled(n, -1);
    let mut greater: SortedSet[i64] = SortedSet.new();
    let mut start = 0;
    while start < n {
        let mut end = start;
        while end < n and nums[order[end]] == nums[order[start]] {
            end += 1;
        }
        for k in start..end {
            let i = order[k];
            if let Some(j) = greater.range(i + 1, n).nth(1) {
                answer[i] = nums[j];
            }
        }
        for k in start..end {
            greater.insert(order[k]);
        }
        start = end;
    }
    answer
}

// ---- iter (second_iter.kara) ---------------------------------------------

fn iter_second_greater_element(nums: Vec[i64]) -> Vec[i64] {
    (0..nums.len())
        .map(|i| nums.iter().skip(i + 1).filter(|x| x > nums[i]).nth(1).unwrap_or(-1))
        .collect()
}

// ---- solution (second_solution.kara) -------------------------------------

impl Solution {
    pub fn second_greater_element(nums: Vec[i32]) -> Vec[i32] {
        let n = nums.len();
        let mut ans = Vec.filled(n, -1);
        let mut s1: Vec[i64] = Vec.new();
        let mut s2: Vec[i64] = Vec.new();
        for i in 0..n {
            while let Some(j) = s2.last().cloned() {
                if nums[j] < nums[i] {
                    ans[j] = nums[i];
                    s2.pop();
                } else {
                    break;
                }
            }
            let mut moved = Vec.new();
            while let Some(j) = s1.last().cloned() {
                if nums[j] < nums[i] {
                    moved.push(s1.pop().unwrap());
                } else {
                    break;
                }
            }
            s2.extend(moved.into_iter().rev());
            s1.push(i);
        }
        ans
    }
}

struct Solution {}

fn solution_second_greater_element(nums: Vec[i64]) -> Vec[i64] {
    let values: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.second_greater_element(values).iter().map(|x| x as i64).collect()
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, nums: Vec[i64]) -> Vec[i64] {
    match arm {
        0 => star_second_greater_element(nums),
        1 => naive_second_greater_element(nums),
        2 => heap_second_greater_element(nums),
        3 => sorted_second_greater_element(nums),
        4 => iter_second_greater_element(nums),
        _ => solution_second_greater_element(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// each answer -1, or a value after `i` that is greater than `nums[i]`
fn later_and_greater(nums: Vec[i64], got: Vec[i64]) -> bool {
    if got.len() != nums.len() {
        return false;
    }
    for i in 0..nums.len() {
        if got[i] != -1 and not (got[i] > nums[i] and nums[i + 1..].contains(got[i])) {
            return false;
        }
    }
    true
}

fn main() {
    let arms = ["star", "naive", "heap", "sorted", "iter", "solution"];
    let mut seed = 2454;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..360 {
        let (n, top) = if t < 300 {
            (1 + next_random(mut seed) % 10, 9)
        } else if t < 330 {
            (1 + next_random(mut seed) % 40, 100000000)
        } else {
            (1 + next_random(mut seed) % 40, 2)
        };
        let nums: Vec[i64] = (0..n).map(|_| wide_random(mut seed) % (top + 1)).collect();
        cases.push((nums, 1 + next_random(mut seed) % 1000));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (nums, lift) = cases[c].clone();
        let truth = second_literally(nums);
        for v in truth.iter() {
            check = (check * 31 + v + 1) % 1000000007;
        }
        check = (check * 31 + 7) % 1000000007;
        let n = nums.len();
        let raised: Vec[i64] = nums.iter().map(|x| x + lift).collect();
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let above = nums.iter().max().unwrap() + 1;
        let mut extended = nums.clone();
        extended.push(above);
        extended.push(above);
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let lifted: Vec[i64] = value.iter().map(|v| if v == -1 { -1 } else { v + lift }).collect();
            let twice: Vec[i64] = value.iter().map(|v| if v == -1 { -1 } else { 2 * v }).collect();
            let mut topped: Vec[i64] = value.iter().map(|v| if v == -1 { above } else { v }).collect();
            topped.push(-1);
            topped.push(-1);
            let verdicts = [
                value == truth,
                answer(arm, raised) == lifted,
                answer(arm, doubled) == twice,
                later_and_greater(nums, value),
                value.len() == n and answer(arm, extended) == topped,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
