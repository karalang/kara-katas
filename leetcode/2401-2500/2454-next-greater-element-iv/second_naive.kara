// LeetCode #2454: Next Greater Element IV -- the statement read
// directly: from each index the values to its right scanned, those
// greater counted, and the second of them is the answer. O(n^2).

fn second_greater_element(nums: Vec[i64]) -> Vec[i64] {
    let n = nums.len();
    let mut answer: Vec[i64] = Vec.new();
    for i in 0..n {
        let mut seen = 0;
        let mut found = -1;
        for j in i + 1..n {
            if nums[j] > nums[i] {
                seen += 1;
                if seen == 2 {
                    found = nums[j];
                    break;
                }
            }
        }
        answer.push(found);
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn fold(values: Vec[i64]) -> i64 {
    let mut check = 0;
    for v in values.iter() {
        check = (check * 31 + v + 1) % 1000000007;
    }
    check
}

fn main() {
    // LeetCode's two examples; one value; rising, every answer two ahead;
    // falling, none; repeats, two equal greater values counted as two;
    // 0 and 10^9, the constraints' least and most
    println(f"{second_greater_element([2, 4, 0, 9, 6].to_vec())}");
    println(f"{second_greater_element([3, 3].to_vec())}");
    println(f"{second_greater_element([7].to_vec())}");
    println(f"{second_greater_element([1, 2, 3, 4, 5].to_vec())}");
    println(f"{second_greater_element([5, 4, 3, 2, 1].to_vec())}");
    println(f"{second_greater_element([1, 5, 5, 1, 5, 2, 9].to_vec())}");
    println(f"{second_greater_element([0, 1000000000, 0, 1000000000, 1000000000].to_vec())}");
    // 2000 random values up to 10^9, and 2000 up to 3, as checksums
    let mut seed = 2454;
    let wide: Vec[i64] = (0..2000).map(|_| wide_random(mut seed) % 1000000001).collect();
    println(f"2000 values up to 10^9: checksum {fold(second_greater_element(wide))}");
    let narrow: Vec[i64] = (0..2000).map(|_| next_random(mut seed) % 4).collect();
    println(f"2000 values up to 3: checksum {fold(second_greater_element(narrow))}");
    // 3000 random arrays of 1 to 8 values up to 9: a checksum of every
    // answer's checksum in order
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 8;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 10).collect();
        check = (check * 31 + fold(second_greater_element(nums))) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
