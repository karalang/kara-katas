// LeetCode #2440: Create Components With Same Value -- the differential.
// The six arms against the statement read literally: every set of edges
// tried as the deleted ones, the components left found by merging the
// ends of each edge kept, and the set counted when every component has
// the same sum; the most edges in such a set is the answer. No divisor
// of the total is formed and no subtree summed. 360 cases: 300 random
// trees of 1 to 8 nodes, values from 1 to 1, 2 or 3; then 30 of 8 to 10
// nodes, all 1 but two from 1 to 4; then 30 of 6 to 10 nodes, values 1
// and 2. Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the nodes renamed by a random permutation, the edges shuffled:
//     the same answer
// P3  every value times k from 2 to 4: the same answer
// P4  the answer plus one divides the total, and the answer is below n
// P5  two copies joined by an edge between their nodes 0: at least
//     twice the answer plus one
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn leader(group: mut ref Vec[i64], x: i64) -> i64 {
    let mut r = x;
    while group[r] != r {
        r = group[r];
    }
    r
}

fn components_literally(nums: Vec[i64], edges: Vec[Vec[i64]]) -> i64 {
    let n = nums.len();
    let m = edges.len();
    let mut best = 0;
    for mask in 0..(1 << m) {
        let mut group: Vec[i64] = (0..n).collect();
        let mut deleted = 0;
        for j in 0..m {
            if (mask >> j) & 1 == 1 {
                deleted += 1;
            } else {
                let a = leader(mut group, edges[j][0]);
                let b = leader(mut group, edges[j][1]);
                group[a] = b;
            }
        }
        let mut sums: Vec[i64] = Vec.filled(n, 0);
        for u in 0..n {
            let r = leader(mut group, u);
            sums[r] += nums[u];
        }
        let mut value = -1;
        let mut same = true;
        for u in 0..n {
            if group[u] == u {
                if value < 0 {
                    value = sums[u];
                } else if sums[u] != value {
                    same = false;
                }
            }
        }
        if same and deleted > best {
            best = deleted;
        }
    }
    best
}
// ---- star (components.kara) ----------------------------------------------

fn star_fits(order: Vec[i64], parent: Vec[i64], nums: Vec[i64], target: i64) -> bool {
    let mut sum = nums.clone();
    let mut i = order.len();
    while i > 0 {
        i -= 1;
        let u = order[i];
        if sum[u] > target {
            return false;
        }
        if sum[u] < target {
            if u == 0 {
                return false;
            }
            sum[parent[u]] += sum[u];
        }
    }
    true
}

fn star_component_value(nums: Vec[i64], edges: Vec[Vec[i64]]) -> i64 {
    let n = nums.len();
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    let mut order: Vec[i64] = [0].to_vec();
    let mut seen: Vec[bool] = Vec.filled(n, false);
    seen[0] = true;
    let mut head = 0;
    while head < order.len() {
        let u = order[head];
        head += 1;
        for v in adjacent[u].iter() {
            if not seen[v] {
                seen[v] = true;
                parent[v] = u;
                order.push(v);
            }
        }
    }
    let mut total = 0;
    for x in nums.iter() {
        total += x;
    }
    let mut k = n;
    while k > 1 {
        if total % k == 0 and star_fits(order, parent, nums, total / k) {
            return k - 1;
        }
        k -= 1;
    }
    0
}

// ---- dfs (components_dfs.kara) -------------------------------------------

fn dfs_left_over(u: i64, from: i64, adjacent: Vec[Vec[i64]], nums: Vec[i64], target: i64) -> i64 {
    let mut sum = nums[u];
    for v in adjacent[u].iter() {
        if v != from {
            let below = dfs_left_over(v, u, adjacent, nums, target);
            if below < 0 {
                return -1;
            }
            sum += below;
        }
    }
    if sum > target {
        -1
    } else if sum == target {
        0
    } else {
        sum
    }
}

fn dfs_component_value(nums: Vec[i64], edges: Vec[Vec[i64]]) -> i64 {
    let n = nums.len();
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut total = 0;
    for x in nums.iter() {
        total += x;
    }
    for k in (2..n + 1).rev() {
        if total % k == 0 and dfs_left_over(0, -1, adjacent, nums, total / k) == 0 {
            return k - 1;
        }
    }
    0
}

// ---- peel (components_peel.kara) -----------------------------------------

fn peel_fits(adjacent: Vec[Vec[i64]], nums: Vec[i64], target: i64) -> bool {
    let n = nums.len();
    let mut sum = nums.clone();
    let mut degree: Vec[i64] = adjacent.iter().map(|a| a.len()).collect();
    let mut done: Vec[bool] = Vec.filled(n, false);
    let mut queue: Vec[i64] = Vec.new();
    for u in 0..n {
        if degree[u] <= 1 {
            queue.push(u);
        }
    }
    let mut head = 0;
    let mut left = n;
    while head < queue.len() {
        let u = queue[head];
        head += 1;
        done[u] = true;
        left -= 1;
        if sum[u] > target {
            return false;
        }
        if left == 0 {
            return sum[u] == target;
        }
        for v in adjacent[u].iter() {
            if not done[v] {
                if sum[u] < target {
                    sum[v] += sum[u];
                }
                degree[v] -= 1;
                if degree[v] == 1 {
                    queue.push(v);
                }
            }
        }
    }
    true
}

fn peel_component_value(nums: Vec[i64], edges: Vec[Vec[i64]]) -> i64 {
    let n = nums.len();
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut total = 0;
    for x in nums.iter() {
        total += x;
    }
    let mut k = n;
    while k > 1 {
        if total % k == 0 and peel_fits(adjacent, nums, total / k) {
            return k - 1;
        }
        k -= 1;
    }
    0
}

// ---- count (components_count.kara) ---------------------------------------

fn count_component_value(nums: Vec[i64], edges: Vec[Vec[i64]]) -> i64 {
    let n = nums.len();
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    // a stack walk: each node pushed once, its parent recorded, and the
    // sums folded upward in the reverse of the order nodes were taken
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    let mut taken: Vec[i64] = Vec.new();
    let mut stack: Vec[i64] = [0].to_vec();
    while stack.len() > 0 {
        let u = stack.pop().unwrap();
        taken.push(u);
        for v in adjacent[u].iter() {
            if v != parent[u] {
                parent[v] = u;
                stack.push(v);
            }
        }
    }
    let mut subtree = nums.clone();
    for u in taken.iter().rev() {
        if u != 0 {
            subtree[parent[u]] += subtree[u];
        }
    }
    let total = subtree[0];
    for k in (2..n + 1).rev() {
        if total % k == 0 {
            let t = total / k;
            let mut multiples = 0;
            for s in subtree.iter() {
                if s % t == 0 {
                    multiples += 1;
                }
            }
            if multiples == k {
                return k - 1;
            }
        }
    }
    0
}

// ---- iter (components_iter.kara) -----------------------------------------

fn iter_fits(order: Vec[i64], parent: Vec[i64], nums: Vec[i64], target: i64) -> bool {
    let (_, ok) = order.iter().rev().fold((nums.clone(), true), |state, u| {
        let mut (sum, ok) = state;
        if not ok or sum[u] > target or (u == 0 and sum[u] < target) {
            return (sum, false);
        }
        if sum[u] < target {
            let p = parent[u];
            sum[p] += sum[u];
        }
        (sum, true)
    });
    ok
}

fn iter_component_value(nums: Vec[i64], edges: Vec[Vec[i64]]) -> i64 {
    let n = nums.len();
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    let mut order: Vec[i64] = [0].to_vec();
    let mut head = 0;
    while head < order.len() {
        let u = order[head];
        head += 1;
        let next: Vec[i64] = adjacent[u].iter().filter(|v| v != parent[u]).collect();
        for v in next.into_iter() {
            parent[v] = u;
            order.push(v);
        }
    }
    let total: i64 = nums.iter().sum();
    (2..n + 1)
        .rev()
        .filter(|k| total % k == 0)
        .find(|k| iter_fits(order, parent, nums, total / k))
        .map(|k| k - 1)
        .unwrap_or(0)
}

// ---- solution (components_solution.kara) ---------------------------------

fn solution_dfs(u: usize, p: usize, g: ref Vec[Vec[usize]], nums: ref Vec[i32], target: i32) -> i32 {
    let mut s = nums[u];
    for v in ref g[u] {
        if v != p {
            let r = solution_dfs(v, u, g, nums, target);
            if r < 0 {
                return -1;
            }
            s += r;
        }
    }
    if s > target {
        -1
    } else if s == target {
        0
    } else {
        s
    }
}

impl Solution {
    pub fn component_value(nums: Vec[i32], edges: Vec[Vec[i32]]) -> i32 {
        let n = nums.len();
        let mut g = Vec.filled(n, Vec.new());
        for e in ref edges {
            let (a, b) = (e[0] as usize, e[1] as usize);
            g[a].push(b);
            g[b].push(a);
        }
        let total: i32 = nums.iter().sum();
        for k in (1..=n as i32).rev() {
            if total % k == 0 and solution_dfs(0, usize.MAX, g, nums, total / k) == 0 {
                return k - 1;
            }
        }
        0
    }
}

struct Solution {}

fn solution_component_value(nums: Vec[i64], edges: Vec[Vec[i64]]) -> i64 {
    let values: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    let rows: Vec[Vec[i32]] = edges.iter().map(|e| e.iter().map(|x| x as i32).collect()).collect();
    Solution.component_value(values, rows)
}
// ---- the differential -----------------------------------------------------

fn answer(arm: i64, nums: Vec[i64], edges: Vec[Vec[i64]]) -> i64 {
    match arm {
        0 => star_component_value(nums, edges),
        1 => dfs_component_value(nums, edges),
        2 => peel_component_value(nums, edges),
        3 => count_component_value(nums, edges),
        4 => iter_component_value(nums, edges),
        _ => solution_component_value(nums, edges),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_tree(n: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut edges: Vec[Vec[i64]] = Vec.new();
    for i in 1..n {
        let p = next_random(mut seed) % i;
        if next_random(mut seed) % 2 == 0 {
            edges.push([p, i].to_vec());
        } else {
            edges.push([i, p].to_vec());
        }
    }
    edges
}

fn main() {
    let arms = ["star", "dfs", "peel", "count", "iter", "solution"];
    let mut seed = 2440;
    let mut cases: Vec[(Vec[i64], Vec[Vec[i64]])] = Vec.new();
    for t in 0..360 {
        let mut nums: Vec[i64] = Vec.new();
        let n = if t < 300 { 1 + next_random(mut seed) % 8 } else if t < 330 { 8 + next_random(mut seed) % 3 } else { 6 + next_random(mut seed) % 5 };
        if t < 300 {
            let top = 1 + next_random(mut seed) % 3;
            for _ in 0..n {
                nums.push(1 + next_random(mut seed) % top);
            }
        } else if t < 330 {
            nums = Vec.filled(n, 1);
            for _ in 0..2 {
                let at = next_random(mut seed) % n;
                nums[at] = 1 + next_random(mut seed) % 4;
            }
        } else {
            for _ in 0..n {
                nums.push(1 + next_random(mut seed) % 2);
            }
        }
        cases.push((nums, random_tree(n, mut seed)));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (nums, edges) = cases[c].clone();
        let n = nums.len();
        let truth = components_literally(nums, edges);
        check = (check * 31 + truth) % 1000000007;
        // a random renaming, and the edges shuffled
        let mut name: Vec[i64] = (0..n).collect();
        for i in 1..n {
            let j = next_random(mut seed) % (i + 1);
            name.swap(i, j);
        }
        let mut renamed_nums: Vec[i64] = Vec.filled(n, 0);
        for u in 0..n {
            renamed_nums[name[u]] = nums[u];
        }
        let mut renamed_edges: Vec[Vec[i64]] = edges.iter().map(|e| [name[e[1]], name[e[0]]].to_vec()).collect();
        for i in 1..renamed_edges.len() {
            let j = next_random(mut seed) % (i + 1);
            renamed_edges.swap(i, j);
        }
        let k = 2 + next_random(mut seed) % 3;
        let scaled: Vec[i64] = nums.iter().map(|x| x * k).collect();
        let mut twice = nums.clone();
        for x in nums.iter() {
            twice.push(x);
        }
        let mut twice_edges = edges.clone();
        for e in edges.iter() {
            twice_edges.push([e[0] + n, e[1] + n].to_vec());
        }
        twice_edges.push([0, n].to_vec());
        let mut total = 0;
        for x in nums.iter() {
            total += x;
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, edges)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, renamed_nums, renamed_edges) == value,
                answer(arm, scaled, edges) == value,
                value >= 0 and value < n and total % (value + 1) == 0,
                answer(arm, twice, twice_edges) >= 2 * value + 1,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
