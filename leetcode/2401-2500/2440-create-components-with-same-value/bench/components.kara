// LeetCode #2440: Create Components With Same Value -- the bench, the ★
// arm: each component count dividing the total, from `n` down, checked by
// gathering subtree sums in reverse breadth-first order.

fn fits(order: Vec[i64], parent: Vec[i64], nums: Vec[i64], target: i64) -> bool {
    let mut sum = nums.clone();
    let mut i = order.len();
    while i > 0 {
        i -= 1;
        let u = order[i];
        if sum[u] > target {
            return false;
        }
        if sum[u] < target {
            if u == 0 {
                return false;
            }
            sum[parent[u]] += sum[u];
        }
    }
    true
}

fn component_value(nums: Vec[i64], edges: Vec[Vec[i64]]) -> i64 {
    let n = nums.len();
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    let mut order: Vec[i64] = [0].to_vec();
    let mut seen: Vec[bool] = Vec.filled(n, false);
    seen[0] = true;
    let mut head = 0;
    while head < order.len() {
        let u = order[head];
        head += 1;
        for v in adjacent[u].iter() {
            if not seen[v] {
                seen[v] = true;
                parent[v] = u;
                order.push(v);
            }
        }
    }
    let mut total = 0;
    for x in nums.iter() {
        total += x;
    }
    let mut k = n;
    while k > 1 {
        if total % k == 0 and fits(order, parent, nums, total / k) {
            return k - 1;
        }
        k -= 1;
    }
    0
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2440;
    // 10 random trees of 2 * 10^4 nodes, values from 1 to 50
    let n = 20000;
    let mut trees: Vec[Vec[Vec[i64]]] = Vec.new();
    let mut values: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10 {
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for i in 1..n {
            edges.push([next_random(mut seed) % i, i].to_vec());
        }
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push(1 + next_random(mut seed) % 50);
        }
        trees.push(edges);
        values.push(nums);
    }
    // pass `p` sets one value of every tree, then answers every tree and
    // folds the answer plus the pass
    let mut check = 0;
    for p in 0..50 {
        for c in 0..trees.len() {
            let at = (p * 7919 + c * 104729) % n;
            values[c][at] = 1 + next_random(mut seed) % 50;
            check = (check * 31 + component_value(values[c], trees[c]) + p) % 1000000007;
        }
    }
    println(f"50 passes over 10 trees of 2 * 10^4 nodes: checksum {check}");
}
