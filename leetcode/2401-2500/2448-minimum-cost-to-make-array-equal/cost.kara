// LeetCode #2448: Minimum Cost to Make Array Equal -- the ★ arm: the
// total cost of a target `x` is a sum of `cost[i] |nums[i] - x|`, which
// falls while more cost lies above `x` than below it and rises after, so
// its least is at a weighted median: the values sorted, and the first
// whose running cost reaches half the total. O(n log n).

fn min_cost(nums: Vec[i64], cost: Vec[i64]) -> i64 {
    let mut pairs: Vec[(i64, i64)] = nums.iter().cloned().zip(cost.iter().cloned()).collect();
    pairs.sort();
    let total: i64 = cost.iter().sum();
    let mut running = 0;
    let mut target = 0;
    for (value, c) in pairs.iter() {
        running += c;
        if 2 * running >= total {
            target = value;
            break;
        }
    }
    let mut answer = 0;
    for i in 0..nums.len() {
        answer += (nums[i] - target).abs() * cost[i];
    }
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; one value; two values of equal cost; one
    // heavy cost against many light ones
    println(f"example 1: {min_cost([1, 3, 5, 2].to_vec(), [2, 3, 1, 14].to_vec())}");
    println(f"example 2: {min_cost([2, 2, 2, 2, 2].to_vec(), [4, 2, 8, 1, 3].to_vec())}");
    println(f"one value: {min_cost([1000000].to_vec(), [1000000].to_vec())}");
    println(f"equal costs: {min_cost([1, 1000000].to_vec(), [7, 7].to_vec())}");
    println(f"one heavy: {min_cost([5, 1, 2, 3, 4, 6, 7].to_vec(), [100, 1, 1, 1, 1, 1, 1].to_vec())}");
    // 2000 values: values and costs from 1 to 10^6; values from 1 to 10
    // and costs to 10^6; values to 10^6 and every cost 10^6, the
    // largest the constraints allow
    let n = 2000;
    let mut seed = 2448;
    let mut wide: Vec[i64] = Vec.new();
    let mut wide_cost: Vec[i64] = Vec.new();
    for _ in 0..n {
        wide.push(1 + wide_random(mut seed) % 1000000);
        wide_cost.push(1 + wide_random(mut seed) % 1000000);
    }
    println(f"wide: {min_cost(wide, wide_cost)}");
    let mut narrow: Vec[i64] = Vec.new();
    let mut narrow_cost: Vec[i64] = Vec.new();
    for _ in 0..n {
        narrow.push(1 + next_random(mut seed) % 10);
        narrow_cost.push(1 + wide_random(mut seed) % 1000000);
    }
    println(f"narrow: {min_cost(narrow, narrow_cost)}");
    let mut spread: Vec[i64] = Vec.new();
    for _ in 0..n {
        spread.push(1 + wide_random(mut seed) % 1000000);
    }
    let heavy: Vec[i64] = Vec.filled(n, 1000000);
    println(f"every cost 10^6: {min_cost(spread, heavy)}");
    // 3000 random cases of 1 to 8 values from 1 to 10, costs from 1 to 10:
    // a checksum and the total
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let len = 1 + next_random(mut seed) % 8;
        let mut nums: Vec[i64] = Vec.new();
        let mut cost: Vec[i64] = Vec.new();
        for _ in 0..len {
            nums.push(1 + next_random(mut seed) % 10);
            cost.push(1 + next_random(mut seed) % 10);
        }
        let answer = min_cost(nums, cost);
        check = (check * 31 + answer) % 1000000007;
        total += answer;
    }
    println(f"3000 random: checksum {check}, total {total}");
}
