// LeetCode #2419: Longest Subarray With Maximum Bitwise AND -- runs. The
// array is cut into runs of equal values, each a value and a length; the
// answer is the longest run among those of the largest value. O(n).

fn longest_subarray(nums: Vec[i64]) -> i64 {
    let mut runs: Vec[(i64, i64)] = Vec.new();
    for x in nums.iter() {
        let n = runs.len();
        if n > 0 and runs[n - 1].0 == x {
            runs[n - 1] = (x, runs[n - 1].1 + 1);
        } else {
            runs.push((x, 1));
        }
    }
    let mut best = (0, 0);
    for r in runs.iter() {
        if r.0 > best.0 or r.0 == best.0 and r.1 > best.1 {
            best = r;
        }
    }
    best.1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` values from 1 to `top`, each a copy of the one before it with
// probability 1 / `stay`.
fn values(seed: mut ref i64, n: i64, top: i64, stay: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    for i in 0..n {
        if i > 0 and next_random(mut seed) % stay == 0 {
            nums.push(nums[i - 1]);
        } else {
            nums.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top);
        }
    }
    nums
}

fn main() {
    // LeetCode's two examples; one value; all the same; the largest at
    // both ends; two runs of the largest as long as each other
    println(f"{longest_subarray([1, 2, 3, 3, 2, 2].to_vec())}");
    println(f"{longest_subarray([1, 2, 3, 4].to_vec())}");
    println(f"{longest_subarray([1000000].to_vec())}");
    println(f"{longest_subarray([7, 7, 7, 7, 7].to_vec())}");
    println(f"{longest_subarray([9, 9, 1, 9, 9, 9, 2, 9].to_vec())}");
    println(f"{longest_subarray([6, 5, 3, 6, 6, 1, 6, 6].to_vec())}");
    // 10^5 values up to 10^6, and 10^5 of 1 to 3 in long runs
    let mut seed = 2419;
    println(f"{longest_subarray(values(mut seed, 100000, 1000000, 2))}");
    println(f"{longest_subarray(values(mut seed, 100000, 3, 50))}");
    // 3000 random arrays of up to 30 values up to 1 to 8; a checksum of the
    // answers and their total
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 30;
        let top = 1 + next_random(mut seed) % 8;
        let a = longest_subarray(values(mut seed, n, top, 1 + next_random(mut seed) % 4));
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"3000 random: checksum {check}, total {total}");
}
