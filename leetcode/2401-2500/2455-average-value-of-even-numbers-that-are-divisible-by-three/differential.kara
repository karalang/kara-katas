// LeetCode #2455: Average Value of Even Numbers That Are Divisible by
// Three -- the differential. The six arms against the statement read
// literally: a value kept when two divides it and three divides it, each
// tested by stepping that number up from 0 until it reaches or passes
// the value; the average rounded down found as the largest whole number
// whose product with the count is no more than the sum, tried from 0
// upward. No remainder or quotient is taken. 360 cases: 300 random of 1
// to 10 values up to 40; then 30 of up to 100 values up to 994; then 30
// of up to 30 values, all multiples of six up to 990. Every case is
// drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the values in reverse order: the same answer
// P3  the values twice over: the same answer
// P4  every value raised by 6: the answer plus 6, or 0 when no value is kept
// P5  the odd values 1 and 999 added: the same answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn divides(d: i64, x: i64) -> bool {
    let mut m = 0;
    while m < x {
        m += d;
    }
    m == x
}

fn average_literally(nums: Vec[i64]) -> i64 {
    let mut sum = 0;
    let mut count = 0;
    for x in nums.iter() {
        if divides(2, x) and divides(3, x) {
            sum += x;
            count += 1;
        }
    }
    if count == 0 {
        return 0;
    }
    let mut q = 0;
    while (q + 1) * count <= sum {
        q += 1;
    }
    q
}

// ---- star (average.kara) -------------------------------------------------

fn star_average_value(nums: Vec[i64]) -> i64 {
    let mut sum = 0;
    let mut count = 0;
    for x in nums.iter() {
        if x % 6 == 0 {
            sum += x;
            count += 1;
        }
    }
    if count == 0 { 0 } else { sum / count }
}

// ---- naive (average_naive.kara) ------------------------------------------

fn naive_average_value(nums: Vec[i64]) -> i64 {
    let mut kept: Vec[i64] = Vec.new();
    for x in nums.iter() {
        let even = x % 2 == 0;
        let by_three = x % 3 == 0;
        if even and by_three {
            kept.push(x);
        }
    }
    if kept.is_empty() {
        return 0;
    }
    let mut total = 0;
    for x in kept.iter() {
        total += x;
    }
    total / kept.len()
}

// ---- digits (average_digits.kara) ----------------------------------------

fn digits_digit_sum(x: i64) -> i64 {
    let mut rest = x;
    let mut sum = 0;
    while rest > 0 {
        sum += rest % 10;
        rest /= 10;
    }
    sum
}

fn digits_average_value(nums: Vec[i64]) -> i64 {
    let mut sum = 0;
    let mut count = 0;
    for x in nums.iter() {
        let last = x % 10;
        if last % 2 == 0 and digits_digit_sum(x) % 3 == 0 {
            sum += x;
            count += 1;
        }
    }
    if count == 0 { 0 } else { sum / count }
}

// ---- table (average_table.kara) ------------------------------------------

fn table_average_value(nums: Vec[i64]) -> i64 {
    let mut times: Vec[i64] = Vec.filled(1001, 0);
    for x in nums.iter() {
        times[x] += 1;
    }
    let mut sum = 0;
    let mut count = 0;
    let mut v = 6;
    while v <= 1000 {
        sum += v * times[v];
        count += times[v];
        v += 6;
    }
    if count == 0 { 0 } else { sum / count }
}

// ---- iter (average_iter.kara) --------------------------------------------

fn iter_average_value(nums: Vec[i64]) -> i64 {
    let (sum, count) = nums.iter().filter(|x| x % 6 == 0).fold((0, 0), |(s, c), x| (s + x, c + 1));
    if count == 0 { 0 } else { sum / count }
}

// ---- solution (average_solution.kara) ------------------------------------

impl Solution {
    pub fn average_value(nums: own Vec[i32]) -> i32 {
        let v: Vec[i32] = nums.into_iter().filter(|x| x % 6 == 0).collect();
        if v.is_empty() {
            0
        } else {
            v.iter().sum() / v.len() as i32
        }
    }
}

struct Solution {}

fn solution_average_value(nums: Vec[i64]) -> i64 {
    let values: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.average_value(values)
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_average_value(nums),
        1 => naive_average_value(nums),
        2 => digits_average_value(nums),
        3 => table_average_value(nums),
        4 => iter_average_value(nums),
        _ => solution_average_value(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arms = ["star", "naive", "digits", "table", "iter", "solution"];
    let mut seed = 2455;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for t in 0..360 {
        if t < 300 {
            let n = 1 + next_random(mut seed) % 10;
            cases.push((0..n).map(|_| 1 + next_random(mut seed) % 40).collect());
        } else if t < 330 {
            let n = 1 + next_random(mut seed) % 100;
            cases.push((0..n).map(|_| 1 + next_random(mut seed) % 994).collect());
        } else {
            let n = 1 + next_random(mut seed) % 30;
            cases.push((0..n).map(|_| 6 * (1 + next_random(mut seed) % 165)).collect());
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let nums = cases[c].clone();
        let truth = average_literally(nums);
        check = (check * 31 + truth) % 1000000007;
        let mut back = nums.clone();
        back.reverse();
        let mut twice = nums.clone();
        twice.extend(nums.iter().cloned());
        let raised: Vec[i64] = nums.iter().map(|x| x + 6).collect();
        let mut odd = nums.clone();
        odd.push(1);
        odd.insert(0, 999);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let kept = nums.iter().any(|x| x % 6 == 0);
            let verdicts = [
                value == truth,
                answer(arm, back) == value,
                answer(arm, twice) == value,
                answer(arm, raised) == (if kept { value + 6 } else { 0 }),
                answer(arm, odd) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
