// LeetCode #2441: Largest Positive Integer That Exists With Its Negative
// -- the bench, the ★ arm: a table of 2001 flags, offset by 1000, and
// the largest magnitude whose negative was seen.

fn find_max_k(nums: Vec[i64]) -> i64 {
    let mut seen: Vec[bool] = Vec.filled(2001, false);
    let mut best = -1;
    for x in nums.iter() {
        if seen[1000 - x] {
            best = best.max(x.abs());
        }
        seen[1000 + x] = true;
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn nonzero(seed: mut ref i64) -> i64 {
    let v = 1 + next_random(mut seed) % 1000;
    if next_random(mut seed) % 2 == 0 { v } else { -v }
}

fn main() {
    let mut seed = 2441;
    // 100 arrays of 1000 values from -1000 to 1000, the constraints'
    // largest
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..100 {
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..1000 {
            nums.push(nonzero(mut seed));
        }
        arrays.push(nums);
    }
    // pass `p` sets one value of every array, then answers every array
    // and folds the answer plus the pass
    let mut check = 0;
    for p in 0..1000 {
        for c in 0..arrays.len() {
            let at = (p * 7919 + c * 104729) % 1000;
            arrays[c][at] = nonzero(mut seed);
            check = (check * 31 + find_max_k(arrays[c]) + p) % 1000000007;
        }
    }
    println(f"1000 passes over 100 arrays of 1000 values: checksum {check}");
}
