// LeetCode #2487: Remove Nodes From Linked List -- recursively: the rest
// of the list is cleared first, and its head is then the greatest value to
// the right; a node smaller than that is dropped for the cleared rest, and
// otherwise keeps its place in front of it. O(n) deep.

shared struct ListNode {
    val: i64,
    mut next: Option[ListNode],
}

fn remove_nodes(head: Option[ListNode]) -> Option[ListNode] {
    let node = head?;
    let rest = remove_nodes(node.next);
    if let Some(greatest) = rest {
        if greatest.val > node.val {
            return rest;
        }
    }
    node.next = rest;
    Some(node)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn build(values: Vec[i64]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for v in values.iter().rev() {
        head = Some(ListNode { val: v, next: head });
    }
    head
}

fn values_of(head: Option[ListNode]) -> Vec[i64] {
    let mut out = Vec.new();
    let mut cur = head;
    while let Some(node) = cur {
        out.push(node.val);
        cur = node.next;
    }
    out
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(", ")}]"
}

fn checksum(v: Vec[i64]) -> i64 {
    v.iter().fold(0, |check, x| (check * 31 + x) % 1000000007)
}

fn main() {
    // LeetCode's two examples, then six more
    let examples: Vec[Vec[i64]] = [
        [5, 2, 13, 3, 8].to_vec(),
        [1, 1, 1, 1].to_vec(),
        [7].to_vec(),
        [1, 2, 3, 4, 5].to_vec(),
        [5, 4, 3, 2, 1].to_vec(),
        [3, 1, 3, 2, 3].to_vec(),
        [2, 9, 4, 9, 1, 1].to_vec(),
        [4, 6, 2, 6, 5, 3, 5].to_vec(),
    ].to_vec();
    for values in examples.iter() {
        println(f"{show(values)} -> {show(values_of(remove_nodes(build(values))))}");
    }
    // 2000 random lists of 1 to 200 values, from 1 to 10^5 and from 1 to 5
    let mut seed = 2487;
    for top in [100000, 5] {
        let mut check = 0;
        let mut kept = 0;
        for _ in 0..2000 {
            let n = next_random(mut seed) % 200 + 1;
            let values: Vec[i64] = (0..n).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1).collect();
            let out = values_of(remove_nodes(build(values)));
            kept += out.len();
            check = (check * 31 + checksum(out) + 1) % 1000000007;
        }
        println(f"2000 lists of values to {top}: {kept} values kept, checksum {check}");
    }
    // the largest the constraints allow: 10^5 values falling, rising, all
    // the same, and random
    let falling: Vec[i64] = (0..100000).map(|i| 100000 - i).collect();
    let rising: Vec[i64] = (0..100000).map(|i| i + 1).collect();
    let same: Vec[i64] = (0..100000).map(|_| 100000).collect();
    let random: Vec[i64] = (0..100000).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1).collect();
    for (name, values) in [("falling", falling), ("rising", rising), ("the same", same), ("random", random)] {
        let out = values_of(remove_nodes(build(values)));
        println(f"10^5 {name}: {out.len()} kept, checksum {checksum(out)}");
    }
}
