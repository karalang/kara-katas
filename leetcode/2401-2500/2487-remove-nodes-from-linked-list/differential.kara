// LeetCode #2487: Remove Nodes From Linked List -- the differential. The
// six arms against the statement read literally: a value is kept exactly
// when no value after it is greater. The Rust template's arm keeps its own
// `i32` nodes, renamed `BoxNode` here, and is handed and gives back the
// shared list through a copy. 300 random lists of 1 to 12 values, from 1
// to 3 or from 1 to 20; then 20 of one or two values, and 40 of 50 to 100
// values from 1 to 10^5; every one drawn before any arm answers.
//
// P1  the values kept are the statement read literally
// P2  the values kept never rise, and the last is the list's last
// P3  the values kept are the list's in order, every copy of its greatest
//     among them
// P4  a value greater than every other put at the end: it alone is kept
// P5  removing again keeps every value
// P6  each arm agrees with at least three of the other five

shared struct ListNode {
    val: i64,
    mut next: Option[ListNode],
}

// ---- star (remove.kara) --------------------------------------------------

fn star_remove_nodes(head: Option[ListNode]) -> Option[ListNode] {
    let mut stack: Vec[ListNode] = Vec.new();
    let mut cur = head;
    while let Some(node) = cur {
        cur = node.next;
        while let Some(top) = stack.last() {
            if top.val >= node.val {
                break;
            }
            stack.pop();
        }
        stack.push(node);
    }
    let mut result: Option[ListNode] = None;
    while let Some(node) = stack.pop() {
        node.next = result;
        result = Some(node);
    }
    result
}

// ---- reverse (remove_reverse.kara) ---------------------------------------

fn reverse_reverse(head: Option[ListNode]) -> Option[ListNode] {
    let mut done: Option[ListNode] = None;
    let mut cur = head;
    while let Some(node) = cur {
        cur = node.next;
        node.next = done;
        done = Some(node);
    }
    done
}

fn reverse_remove_nodes(head: Option[ListNode]) -> Option[ListNode] {
    let last = reverse_reverse(head)?;
    let mut kept = last;
    while let Some(next) = kept.next {
        if next.val < kept.val {
            kept.next = next.next;
        } else {
            kept = next;
        }
    }
    reverse_reverse(Some(last))
}

// ---- rec (remove_rec.kara) -----------------------------------------------

fn rec_remove_nodes(head: Option[ListNode]) -> Option[ListNode] {
    let node = head?;
    let rest = rec_remove_nodes(node.next);
    if let Some(greatest) = rest {
        if greatest.val > node.val {
            return rest;
        }
    }
    node.next = rest;
    Some(node)
}

// ---- values (remove_values.kara) -----------------------------------------

fn values_remove_nodes(head: Option[ListNode]) -> Option[ListNode] {
    let mut values: Vec[i64] = Vec.new();
    let mut cur = head;
    while let Some(node) = cur {
        values.push(node.val);
        cur = node.next;
    }
    let mut greatest = 0;
    let mut result: Option[ListNode] = None;
    for v in values.iter().rev() {
        if v >= greatest {
            greatest = v;
            result = Some(ListNode { val: v, next: result });
        }
    }
    result
}

// ---- iter (remove_iter.kara) ---------------------------------------------

struct IterNodes {
    cur: Option[ListNode],
}

impl Iterator for IterNodes {
    type Item = ListNode;

    fn next(mut ref self) -> Option[ListNode] {
        let node = self.cur?;
        self.cur = node.next;
        Some(node)
    }
}

fn iter_remove_nodes(head: Option[ListNode]) -> Option[ListNode] {
    let nodes: Vec[ListNode] = IterNodes { cur: head }.collect();
    nodes.iter().rev().fold(None, |kept, node| match kept {
        Some(first) if first.val > node.val => Some(first),
        _ => {
            node.next = kept;
            Some(node)
        }
    })
}

// ---- solution (remove_solution.kara) -------------------------------------

#[derive(PartialEq, Eq, Clone, Debug)]
pub struct BoxNode {
  pub val: i32,
  pub next: Option[BoxNode]
}

impl BoxNode {
  #[inline]
  fn new(val: i32) -> Self {
    BoxNode {
      next: None,
      val
    }
  }
}

struct Solution {}

impl Solution {
    pub fn remove_nodes(head: own Option[BoxNode]) -> Option[BoxNode] {
        let mut head = head;
        let mut stack: Vec[BoxNode] = Vec.new();
        while let Some(node) = head {
            let mut node = node;
            head = node.next.take();
            while let Some(top) = stack.last() {
                if top.val < node.val {
                    stack.pop();
                } else {
                    break;
                }
            }
            stack.push(node);
        }
        let mut result = None;
        while let Some(node) = stack.pop() {
            let mut node = node;
            node.next = result;
            result = Some(node);
        }
        result
    }
}

fn solution_remove_nodes(head: Option[ListNode]) -> Option[ListNode] {
    let mut values: Vec[i64] = Vec.new();
    let mut cur = head;
    while let Some(node) = cur {
        values.push(node.val);
        cur = node.next;
    }
    let mut asked: Option[BoxNode] = None;
    for v in values.iter().rev() {
        asked = Some(BoxNode { val: v as i32, next: asked });
    }
    let mut out: Option[ListNode] = None;
    let mut kept: Vec[i64] = Vec.new();
    let mut got = Solution.remove_nodes(asked);
    while let Some(node) = got {
        kept.push(node.val);
        got = node.next;
    }
    for v in kept.iter().rev() {
        out = Some(ListNode { val: v, next: out });
    }
    out
}

// ---- the statement read literally

fn literal(values: Vec[i64]) -> Vec[i64] {
    let mut kept: Vec[i64] = Vec.new();
    for i in 0..values.len() {
        let mut greater = false;
        for j in i + 1..values.len() {
            if values[j] > values[i] {
                greater = true;
            }
        }
        if not greater {
            kept.push(values[i]);
        }
    }
    kept
}

fn build(values: Vec[i64]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for v in values.iter().rev() {
        head = Some(ListNode { val: v, next: head });
    }
    head
}

fn values_of(head: Option[ListNode]) -> Vec[i64] {
    let mut out = Vec.new();
    let mut cur = head;
    while let Some(node) = cur {
        out.push(node.val);
        cur = node.next;
    }
    out
}

fn remove(arm: i64, head: Option[ListNode]) -> Option[ListNode] {
    match arm {
        0 => star_remove_nodes(head),
        1 => reverse_remove_nodes(head),
        2 => rec_remove_nodes(head),
        3 => values_remove_nodes(head),
        4 => iter_remove_nodes(head),
        _ => solution_remove_nodes(head),
    }
}

fn answer(arm: i64, values: Vec[i64]) -> Vec[i64] {
    values_of(remove(arm, build(values)))
}

// `part` is `whole` with some values left out, in order
fn within(part: Vec[i64], whole: Vec[i64]) -> bool {
    let mut k = 0;
    for v in whole.iter() {
        if k < part.len() and part[k] == v {
            k += 1;
        }
    }
    k == part.len()
}

// ---- lists

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    let names = ["star", "reverse", "rec", "values", "iter", "solution"];
    let mut seed = 2487;
    let mut problems: Vec[Vec[i64]] = Vec.new();
    for t in 0..360 {
        let mut n = next_random(mut seed) % 12 + 1;
        let mut top = if next_random(mut seed) % 2 == 0 { 3 } else { 20 };
        if t >= 300 and t < 320 {
            n = next_random(mut seed) % 2 + 1;
        } else if t >= 320 {
            n = next_random(mut seed) % 51 + 50;
            top = 100000;
        }
        let values: Vec[i64] = (0..n).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1).collect();
        problems.push(values);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for values in problems.iter() {
        let n = values.len();
        let truth = literal(values);
        for v in truth.iter() {
            check = (check * 31 + v) % 1000000007;
        }
        check = (check * 31 + 1000000) % 1000000007;
        let greatest = values.iter().max().unwrap();
        let copies = values.iter().filter(|v| v == greatest).count();
        let mut topped = values.clone();
        topped.push(greatest + 1);
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, values)).collect();
        for arm in 0..6 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let mut falling = x.len() > 0 and x[x.len() - 1] == values[n - 1];
            for i in 1..x.len() {
                if x[i] > x[i - 1] {
                    falling = false;
                }
            }
            let ordered = within(x, values) and x.iter().filter(|v| v == greatest).count() == copies;
            let verdicts = [
                x == truth,
                falling,
                ordered,
                answer(arm, topped) == [greatest + 1].to_vec(),
                answer(arm, x) == x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{show(values)} arm {names[arm]}: P{q + 1} fails, answer {show(x)}, literal {show(truth)}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
