// LeetCode #2410: Maximum Matching of Players With Trainers -- iterators.
// The ★ arm's walk as a `fold` over the sorted trainers, carrying how many
// of the sorted players are matched. O(n log n + m log m).

fn match_players_and_trainers(players: Vec[i64], trainers: Vec[i64]) -> i64 {
    let mut p = players.clone();
    let mut t = trainers.clone();
    p.sort();
    t.sort();
    t.iter().fold(0, |matched, capacity| if matched < p.len() and p[matched] <= capacity {
        matched + 1
    } else {
        matched
    })
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` values from 1 to `top`.
fn values(seed: mut ref i64, n: i64, top: i64) -> Vec[i64] {
    (0..n).map(|_| 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top).collect()
}

fn main() {
    // LeetCode's two examples; one of each, too weak and strong enough;
    // every player stronger than every trainer
    println(f"{match_players_and_trainers([4, 7, 9].to_vec(), [8, 2, 5, 8].to_vec())}");
    println(f"{match_players_and_trainers([1, 1, 1].to_vec(), [10].to_vec())}");
    println(f"{match_players_and_trainers([5].to_vec(), [4].to_vec())} {match_players_and_trainers([5].to_vec(), [5].to_vec())}");
    println(f"{match_players_and_trainers([7, 8, 9].to_vec(), [1, 2, 3, 4, 5, 6].to_vec())}");
    // 10^5 each up to 10^9; 10^5 players against 5 * 10^4 trainers drawn
    // higher
    let mut seed = 2410;
    let players = values(mut seed, 100000, 1000000000);
    let trainers = values(mut seed, 100000, 1000000000);
    println(f"{match_players_and_trainers(players, trainers)}");
    let weak = values(mut seed, 100000, 500000000);
    let strong: Vec[i64] = values(mut seed, 50000, 500000000).iter().map(|t| t + 250000000).collect();
    println(f"{match_players_and_trainers(weak, strong)}");
    // 2000 random cases of up to 20 players and 20 trainers from 1 to 30;
    // a checksum of the answers and their total
    let mut check = 0;
    let mut total = 0;
    for _ in 0..2000 {
        let p = values(mut seed, 1 + next_random(mut seed) % 20, 30);
        let t = values(mut seed, 1 + next_random(mut seed) % 20, 30);
        let a = match_players_and_trainers(p, t);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"2000 random: checksum {check}, total {total}");
}
