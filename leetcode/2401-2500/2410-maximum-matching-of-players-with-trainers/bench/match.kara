// LeetCode #2410: Maximum Matching of Players With Trainers -- the bench,
// the ★ arm: both lists copied and sorted, each trainer upward taking the
// weakest player not yet matched if it is strong enough.

fn match_players_and_trainers(players: Vec[i64], trainers: Vec[i64]) -> i64 {
    let mut p = players.clone();
    let mut t = trainers.clone();
    p.sort();
    t.sort();
    let mut matched = 0;
    for capacity in t.iter() {
        if matched < p.len() and p[matched] <= capacity {
            matched += 1;
        }
    }
    matched
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10 cases of 10^5 players up to 10^9 and 10^5 trainers, case i's
    // from 1 + 10^7 i to 9 * 10^8 + 10^7 i; each pass answers them all and
    // folds every answer, plus the pass
    let mut seed = 2410;
    let mut cases: Vec[(Vec[i64], Vec[i64])] = Vec.new();
    for i in 0..10 {
        let players: Vec[i64] = (0..100000).map(|_| 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000).collect();
        let trainers: Vec[i64] = (0..100000).map(|_| 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 900000000 + 10000000 * i).collect();
        cases.push((players, trainers));
    }
    let mut check = 0;
    for p in 0..5 {
        for (players, trainers) in cases.iter() {
            check = (check * 31 + match_players_and_trainers(players, trainers) + p) % 1000000007;
        }
    }
    println(f"5 passes over 10 cases of 10^5 players and trainers: checksum {check}");
}
