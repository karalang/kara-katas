// LeetCode #2463: Minimum Total Distance Traveled -- the bench, the ★
// arm: a table over the sorted robots and factories, each factory either
// skipped or given the next run of robots up to its limit.

const NONE: i64 = 9000000000000000000;

fn minimum_total_distance(robot: Vec[i64], factory: Vec[Vec[i64]]) -> i64 {
    let mut robots = robot.clone();
    robots.sort();
    let mut factories = factory.clone();
    factories.sort();
    let n = robots.len();
    let m = factories.len();
    let mut best: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(m + 1, NONE));
    for j in 0..m + 1 {
        best[n][j] = 0;
    }
    for j in (0..m).rev() {
        let (at, limit) = (factories[j][0], factories[j][1]);
        for i in (0..n).rev() {
            let mut least = best[i][j + 1];
            let mut run = 0;
            for t in 1..limit.min(n - i) + 1 {
                run += (robots[i + t - 1] - at).abs();
                if best[i + t][j + 1] < NONE {
                    least = least.min(run + best[i + t][j + 1]);
                }
            }
            best[i][j] = least;
        }
    }
    best[0][0]
}
fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    let high = next_random(mut seed);
    high * 32768 + next_random(mut seed)
}

// `n` distinct robots and `m` distinct factories, positions from `-top`
// to `top`, the limits random up to `cap` and then raised in turn until
// they hold every robot
fn random_case(n: i64, m: i64, top: i64, cap: i64, seed: mut ref i64) -> (Vec[i64], Vec[Vec[i64]]) {
    let mut taken: Set[i64] = Set.new();
    let mut robot: Vec[i64] = Vec.new();
    while robot.len() < n {
        let p = wide_random(mut seed) % (2 * top + 1) - top;
        if taken.insert(p) {
            robot.push(p);
        }
    }
    let mut places: Set[i64] = Set.new();
    let mut factory: Vec[Vec[i64]] = Vec.new();
    while factory.len() < m {
        let p = wide_random(mut seed) % (2 * top + 1) - top;
        if places.insert(p) {
            factory.push([p, next_random(mut seed) % (cap + 1)].to_vec());
        }
    }
    let mut room: i64 = factory.iter().map(|f| f[1]).sum();
    let mut j = 0;
    while room < n {
        factory[j % m][1] += 1;
        room += 1;
        j += 1;
    }
    (robot, factory)
}

fn main() {
    // 40 cases of 100 robots and 100 factories over 2 10^9 places, limits
    // up to 2, built once; then 72 passes, each raising one limit of every
    // case, chosen by the checksum so far, then answering every case and
    // folding the answer plus the pass into the checksum
    let mut seed = 2463;
    let mut cases: Vec[(Vec[i64], Vec[Vec[i64]])] = (0..40).map(|_| random_case(100, 100, 1000000000, 2, mut seed)).collect();
    let mut check = 0;
    for p in 0..72 {
        for c in 0..cases.len() {
            cases[c].1[(check + c) % 100][1] += 1;
            check = (check * 31 + minimum_total_distance(cases[c].0, cases[c].1) % 1000000007 + p) % 1000000007;
        }
    }
    println(f"72 passes over 40 cases of 100 robots: checksum {check}");
}
