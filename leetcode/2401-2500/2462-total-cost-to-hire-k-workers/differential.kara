// LeetCode #2462: Total Cost to Hire K Workers -- the differential. The
// six arms against the statement read literally: the workers not yet
// hired kept as a list of indices; each session builds its candidates as
// the list's first `candidates` and its last `candidates`, all of it when
// those overlap, and hires the cheapest, the lower index on a tie, each
// compared by hand. 360 cases: 300 random lists of 1 to 12 costs from 1
// to 6; then 30 of up to 200 costs from 1 to 1000, with up to 20
// candidates; then 30 of up to 200 costs from 1 to 5; each with a random
// `k`, and `candidates` from 1 to the length unless said. Every case is
// drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the costs made distinct, `1000 v + i`: the same answer for the list reversed
// P3  every cost raised by one constant below 1000: the answer plus `k` times it
// P4  the answer between the sums of the `k` cheapest and the `k` dearest
// P5  `candidates` the whole list: the sum of the `k` cheapest
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn cost_literally(costs: Vec[i64], k: i64, candidates: i64) -> i64 {
    let mut left: Vec[i64] = (0..costs.len()).collect();
    let mut total = 0;
    for _ in 0..k {
        let m = left.len();
        let mut pool: Vec[i64] = Vec.new();
        if m <= 2 * candidates {
            pool = left.clone();
        } else {
            pool.extend(left[..candidates].to_vec());
            pool.extend(left[m - candidates..].to_vec());
        }
        let mut pick = pool[0];
        for w in pool.iter() {
            if costs[w] < costs[pick] or costs[w] == costs[pick] and w < pick {
                pick = w;
            }
        }
        total += costs[pick];
        left.retain(|w| w != pick);
    }
    total
}

// ---- star (hire.kara) ----------------------------------------------------

fn star_total_cost(costs: Vec[i64], k: i64, candidates: i64) -> i64 {
    let n = costs.len();
    let mut front: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut back: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut next = 0;
    let mut last = n - 1;
    while next < candidates and next <= last {
        front.push((costs[next], next));
        next += 1;
    }
    while n - 1 - last < candidates and next <= last {
        back.push((costs[last], last));
        last -= 1;
    }
    let mut total = 0;
    for _ in 0..k {
        let take_front = match (front.peek(), back.peek()) {
            (Some(f), Some(b)) => f <= b,
            (Some(_), None) => true,
            _ => false,
        };
        if take_front {
            let (cost, _) = front.pop().unwrap();
            total += cost;
            if next <= last {
                front.push((costs[next], next));
                next += 1;
            }
        } else {
            let (cost, _) = back.pop().unwrap();
            total += cost;
            if next <= last {
                back.push((costs[last], last));
                last -= 1;
            }
        }
    }
    total
}

// ---- naive (hire_naive.kara) ---------------------------------------------

fn naive_total_cost(costs: Vec[i64], k: i64, candidates: i64) -> i64 {
    let mut left: Vec[(i64, i64)] = Vec.new();
    for i in 0..costs.len() {
        left.push((costs[i], i));
    }
    let mut total = 0;
    for _ in 0..k {
        let m = left.len();
        let mut best = -1;
        for p in 0..m {
            if m < 2 * candidates or p < candidates or p >= m - candidates {
                if best < 0 or left[p] < left[best] {
                    best = p;
                }
            }
        }
        total += left[best].0;
        left.remove(best);
    }
    total
}

// ---- one (hire_one.kara) -------------------------------------------------

fn one_total_cost(costs: Vec[i64], k: i64, candidates: i64) -> i64 {
    let n = costs.len();
    let mut pool: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut next = 0;
    let mut last = n - 1;
    while next < candidates and next <= last {
        pool.push((costs[next], next));
        next += 1;
    }
    while n - 1 - last < candidates and next <= last {
        pool.push((costs[last], last));
        last -= 1;
    }
    let mut total = 0;
    for _ in 0..k {
        let (cost, at) = pool.pop().unwrap();
        total += cost;
        if next <= last {
            if at < next {
                pool.push((costs[next], next));
                next += 1;
            } else {
                pool.push((costs[last], last));
                last -= 1;
            }
        }
    }
    total
}

// ---- sorted (hire_sorted.kara) -------------------------------------------

fn sorted_total_cost(costs: Vec[i64], k: i64, candidates: i64) -> i64 {
    let n = costs.len();
    let mut pool: SortedSet[(i64, i64)] = SortedSet.new();
    for i in 0..n {
        if i < candidates or i >= n - candidates {
            pool.insert((costs[i], i));
        }
    }
    let mut next = candidates;
    let mut last = n - 1 - candidates;
    let mut total = 0;
    for _ in 0..k {
        let (cost, at) = pool.min().unwrap();
        pool.remove((cost, at));
        total += cost;
        if next <= last {
            let i = if at < next { next } else { last };
            pool.insert((costs[i], i));
            if at < next {
                next += 1;
            } else {
                last -= 1;
            }
        }
    }
    total
}

// ---- iter (hire_iter.kara) -----------------------------------------------

fn iter_total_cost(costs: Vec[i64], k: i64, candidates: i64) -> i64 {
    let n = costs.len();
    let c = candidates.min((n + 1) / 2);
    let mut front: PriorityQueue[(i64, i64)] = costs.iter().enumerate().take(c).map(|(i, v)| (v, i)).collect();
    let mut back: PriorityQueue[(i64, i64)] = costs.iter().enumerate().rev().take(candidates).filter(|(i, _)| i >= c).map(|(i, v)| (v, i)).collect();
    let mut next = c;
    let mut last = n - 1 - back.len();
    (0..k).map(|_| {
        let from_front = back.is_empty() or (not front.is_empty() and front.peek().unwrap() <= back.peek().unwrap());
        if from_front {
            let (cost, _) = front.pop().unwrap();
            if next <= last {
                front.push((costs[next], next));
                next += 1;
            }
            cost
        } else {
            let (cost, _) = back.pop().unwrap();
            if next <= last {
                back.push((costs[last], last));
                last -= 1;
            }
            cost
        }
    }).sum()
}

// ---- solution (hire_solution.kara) ---------------------------------------

impl Solution {
    pub fn total_cost(costs: Vec[i32], k: i32, candidates: i32) -> i64 {
        let n = costs.len();
        let c = candidates as i64;
        let mut front = PriorityQueue.new();
        let mut back = PriorityQueue.new();
        let mut l = 0;
        let mut r = n;
        while l < c and l < r {
            front.push((costs[l], l));
            l += 1;
        }
        while n - r < c and l < r {
            r -= 1;
            back.push((costs[r], r));
        }
        let mut ans: i64 = 0;
        for _ in 0..k {
            let take_front = match (front.peek(), back.peek()) {
                (Some(f), Some(b)) => f <= b,
                (Some(_), None) => true,
                _ => false,
            };
            if take_front {
                let (cost, _) = front.pop().unwrap();
                ans += cost;
                if l < r {
                    front.push((costs[l], l));
                    l += 1;
                }
            } else {
                let (cost, _) = back.pop().unwrap();
                ans += cost;
                if l < r {
                    r -= 1;
                    back.push((costs[r], r));
                }
            }
        }
        ans
    }
}

struct Solution {}

fn solution_total_cost(costs: Vec[i64], k: i64, candidates: i64) -> i64 {
    let asked: Vec[i32] = costs.iter().map(|v| v as i32).collect();
    Solution.total_cost(asked, k as i32, candidates as i32)
}

// ---- the differential -------------------------------------------------------

fn answer(arm: i64, costs: Vec[i64], k: i64, candidates: i64) -> i64 {
    match arm {
        0 => star_total_cost(costs, k, candidates),
        1 => naive_total_cost(costs, k, candidates),
        2 => one_total_cost(costs, k, candidates),
        3 => sorted_total_cost(costs, k, candidates),
        4 => iter_total_cost(costs, k, candidates),
        _ => solution_total_cost(costs, k, candidates),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arms = ["star", "naive", "one", "sorted", "iter", "solution"];
    let mut seed = 2462;
    let mut cases: Vec[(Vec[i64], i64, i64)] = Vec.new();
    for t in 0..360 {
        let (n, top) = if t < 300 {
            (1 + next_random(mut seed) % 12, 6)
        } else if t < 330 {
            (1 + next_random(mut seed) % 200, 1000)
        } else {
            (1 + next_random(mut seed) % 200, 5)
        };
        let costs: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % top).collect();
        let k = 1 + next_random(mut seed) % n;
        let reach = if t >= 300 and t < 330 { n.min(20) } else { n };
        let candidates = 1 + next_random(mut seed) % reach;
        cases.push((costs, k, candidates));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (costs, k, candidates) = cases[c].clone();
        let n = costs.len();
        let truth = cost_literally(costs, k, candidates);
        check = (check * 31 + truth) % 1000000007;
        let distinct: Vec[i64] = (0..n).map(|i| costs[i] * 1000 + i).collect();
        let mut mirrored = distinct.clone();
        mirrored.reverse();
        let lift = 1 + next_random(mut seed) % 999;
        let lifted: Vec[i64] = costs.iter().map(|v| v + lift).collect();
        let mut sorted = costs.clone();
        sorted.sort();
        let cheapest: i64 = sorted[..k].iter().sum();
        let dearest: i64 = sorted[n - k..].iter().sum();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, costs, k, candidates)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, distinct, k, candidates) == answer(arm, mirrored, k, candidates),
                answer(arm, lifted, k, candidates) == value + k * lift,
                cheapest <= value and value <= dearest,
                answer(arm, costs, k, n) == cheapest,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
