// LeetCode #2462: Total Cost to Hire K Workers -- the bench, the ★ arm:
// two heaps of `(cost, index)`, the first and the last `candidates`
// workers, each session taking the cheaper top and refilling its heap
// from the untaken middle.

fn total_cost(costs: Vec[i64], k: i64, candidates: i64) -> i64 {
    let n = costs.len();
    let mut front: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut back: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut next = 0;
    let mut last = n - 1;
    while next < candidates and next <= last {
        front.push((costs[next], next));
        next += 1;
    }
    while n - 1 - last < candidates and next <= last {
        back.push((costs[last], last));
        last -= 1;
    }
    let mut total = 0;
    for _ in 0..k {
        let take_front = match (front.peek(), back.peek()) {
            (Some(f), Some(b)) => f <= b,
            (Some(_), None) => true,
            _ => false,
        };
        if take_front {
            let (cost, _) = front.pop().unwrap();
            total += cost;
            if next <= last {
                front.push((costs[next], next));
                next += 1;
            }
        } else {
            let (cost, _) = back.pop().unwrap();
            total += cost;
            if next <= last {
                back.push((costs[last], last));
                last -= 1;
            }
        }
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    let high = next_random(mut seed);
    high * 32768 + next_random(mut seed)
}

fn main() {
    // 10 lists of 10^5 costs from 1 to 10^5 built once; then 32 passes,
    // each setting one cost of every list from the checksum so far, then
    // answering every list with k of 5 10^4 and 1 + 97 p candidates,
    // folding the answer plus the pass into the checksum
    let mut seed = 2462;
    let mut lists: Vec[Vec[i64]] = (0..10).map(|_| (0..100000).map(|_| 1 + wide_random(mut seed) % 100000).collect()).collect();
    let mut check = 0;
    for p in 0..32 {
        let candidates = 1 + 97 * p;
        for a in 0..lists.len() {
            lists[a][(check + a) % 100000] = 1 + check % 100000;
            check = (check * 31 + total_cost(lists[a], 50000, candidates) + p) % 1000000007;
        }
    }
    println(f"32 passes over 10 lists of 10^5: checksum {check}");
}
