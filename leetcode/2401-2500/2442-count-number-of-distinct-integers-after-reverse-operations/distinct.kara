// LeetCode #2442: Count Number of Distinct Integers After Reverse
// Operations -- the ★ arm. Each value's digits are reversed by taking
// them off the bottom with `% 10` and `/ 10`, and the values with their
// reversals all lie from 1 to the largest of them, at most `10^6`; so a
// table of flags that long marks each, and a value counts the first time
// its flag is set. O(n log V) for the digits, and a table of `V` flags.

fn reversed(x: i64) -> i64 {
    let mut r = 0;
    let mut y = x;
    while y > 0 {
        r = r * 10 + y % 10;
        y /= 10;
    }
    r
}

fn count_distinct_integers(nums: Vec[i64]) -> i64 {
    let mut values = nums.clone();
    for x in nums.iter() {
        values.push(reversed(x));
    }
    let mut largest = 0;
    for v in values.iter() {
        largest = largest.max(v);
    }
    let mut seen: Vec[bool] = Vec.filled(largest + 1, false);
    let mut count = 0;
    for v in values.iter() {
        if not seen[v] {
            seen[v] = true;
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; the constraints' largest value; values
    // whose reversals all meet; palindromes only
    let cases: Vec[Vec[i64]] = [
        [1, 13, 10, 12, 31].to_vec(),
        [2, 2, 2].to_vec(),
        [1000000].to_vec(),
        [100, 1, 10].to_vec(),
        [121, 7, 1221, 98789].to_vec(),
    ].to_vec();
    for nums in cases.into_iter() {
        println(f"{nums}: {count_distinct_integers(nums)}");
    }
    // 10^5 values, the constraints' most: every value from 1 to 10^5;
    // every multiple of 10 up to 10^6; 10^5 random from 1 to 10^6
    let mut seed = 2442;
    let every: Vec[i64] = (1..100001).collect();
    println(f"1 to 10^5: {count_distinct_integers(every)}");
    let tens: Vec[i64] = (1..100001).map(|i| i * 10).collect();
    println(f"multiples of 10: {count_distinct_integers(tens)}");
    let mut random: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        random.push(1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000);
    }
    println(f"random: {count_distinct_integers(random)}");
    // 3000 random arrays of 1 to 10 values from 1 to 200: a checksum and
    // the total
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let len = 1 + next_random(mut seed) % 10;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..len {
            nums.push(1 + next_random(mut seed) % 200);
        }
        let answer = count_distinct_integers(nums);
        check = (check * 31 + answer) % 1000000007;
        total += answer;
    }
    println(f"3000 random: checksum {check}, total {total}");
}
