// LeetCode #2470: Number of Subarrays With LCM Equal to K -- the
// differential. The six arms against the statement read literally: for
// every subarray, its least common multiple found by trying the
// multiples of its first number in turn, up to `k`, for one that every
// number divides; the subarray counts when that least one is `k`. 360
// cases: 300 random lists of 1 to 10 numbers with `k` from 1 to 60; then
// 60 of up to 16 with `k` from 1 to 120; each number a divisor of `k`
// but now and then any number to 500. Every case is drawn before any arm
// answers.
//
// P1  the count is the literal reading's
// P2  the list reversed: the same count
// P3  the list, a number that does not divide `k`, then the list again:
//     twice the count
// P4  every number and `k` doubled: the same count
// P5  `k` appended: the count up by one more than the run of divisors
//     of `k` that ends the list
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

// the least common multiple of `nums[from..to]` if it is at most `k`,
// else 0
fn lcm_literally(nums: Vec[i64], from: i64, to: i64, k: i64) -> i64 {
    let mut m = nums[from];
    while m <= k {
        let mut every = true;
        for i in from..to {
            if m % nums[i] != 0 {
                every = false;
            }
        }
        if every {
            return m;
        }
        m += nums[from];
    }
    0
}

fn count_literally(nums: Vec[i64], k: i64) -> i64 {
    let mut count = 0;
    for from in 0..nums.len() {
        for to in from + 1..nums.len() + 1 {
            if lcm_literally(nums, from, to, k) == k {
                count += 1;
            }
        }
    }
    count
}

// ---- star (lcm.kara) -----------------------------------------------------

fn star_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { star_gcd(b, a % b) }
}

fn star_subarray_lcm(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut count = 0;
    for start in 0..n {
        let mut lcm = 1;
        for end in start..n {
            lcm = lcm / star_gcd(lcm, nums[end]) * nums[end];
            if k % lcm != 0 {
                break;
            }
            if lcm == k {
                count += 1;
            }
        }
    }
    count
}

// ---- window (lcm_window.kara) --------------------------------------------

fn window_subarray_lcm(nums: Vec[i64], k: i64) -> i64 {
    // the prime powers of `k`
    let mut powers: Vec[i64] = Vec.new();
    let mut rest = k;
    let mut p = 2;
    while p * p <= rest {
        if rest % p == 0 {
            let mut power = 1;
            while rest % p == 0 {
                rest /= p;
                power *= p;
            }
            powers.push(power);
        }
        p += 1;
    }
    if rest > 1 {
        powers.push(rest);
    }
    let mut last: Vec[i64] = Vec.filled(powers.len(), -1);
    let mut run_start = 0;
    let mut count = 0;
    for end in 0..nums.len() {
        let v = nums[end];
        if k % v != 0 {
            run_start = end + 1;
            continue;
        }
        for i in 0..powers.len() {
            if v % powers[i] == 0 {
                last[i] = end;
            }
        }
        let mut earliest = end;
        for i in 0..powers.len() {
            earliest = earliest.min(last[i]);
        }
        if earliest >= run_start {
            count += earliest - run_start + 1;
        }
    }
    count
}

// ---- sieve (lcm_sieve.kara) ----------------------------------------------

fn sieve_all_dividing(nums: Vec[i64], m: i64) -> i64 {
    let mut total = 0;
    let mut run = 0;
    for v in nums.iter() {
        if m % v == 0 {
            run += 1;
            total += run;
        } else {
            run = 0;
        }
    }
    total
}

fn sieve_subarray_lcm(nums: Vec[i64], k: i64) -> i64 {
    let mut primes: Vec[i64] = Vec.new();
    let mut rest = k;
    let mut p = 2;
    while p * p <= rest {
        if rest % p == 0 {
            primes.push(p);
            while rest % p == 0 {
                rest /= p;
            }
        }
        p += 1;
    }
    if rest > 1 {
        primes.push(rest);
    }
    let mut count = 0;
    for mask in 0..(1 << primes.len()) {
        let mut d = 1;
        let mut sign = 1;
        for i in 0..primes.len() {
            if (mask >> i) & 1 == 1 {
                d *= primes[i];
                sign = -sign;
            }
        }
        count += sign * sieve_all_dividing(nums, k / d);
    }
    count
}

// ---- map (lcm_map.kara) --------------------------------------------------

fn map_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { map_gcd(b, a % b) }
}

fn map_subarray_lcm(nums: Vec[i64], k: i64) -> i64 {
    let mut ending: Map[i64, i64] = Map.new();
    let mut count = 0;
    for v in nums.iter() {
        let mut next: Map[i64, i64] = Map.new();
        if k % v == 0 {
            next.insert(v, 1);
            for (lcm, ways) in ending.iter() {
                let joined = lcm / map_gcd(lcm, v) * v;
                if k % joined == 0 {
                    let had = next.get(joined).unwrap_or(0);
                    next.insert(joined, had + ways);
                }
            }
        }
        count += next.get(k).unwrap_or(0);
        ending = next;
    }
    count
}

// ---- iter (lcm_iter.kara) ------------------------------------------------

fn iter_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { iter_gcd(b, a % b) }
}

fn iter_subarray_lcm(nums: Vec[i64], k: i64) -> i64 {
    (0..nums.len()).map(|start| {
        nums.iter().skip(start).scan(1, |lcm, v| {
            let joined = lcm / iter_gcd(lcm, v) * v;
            Some((joined, joined))
        }).take_while(|lcm| k % lcm == 0).filter(|lcm| lcm == k).count()
    }).sum()
}

// ---- solution (lcm_solution.kara) ----------------------------------------

fn solution_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { solution_gcd(b, a % b) }
}

impl Solution {
    pub fn subarray_lcm(nums: Vec[i32], k: i32) -> i32 {
        let n = nums.len();
        let mut count = 0;
        for i in 0..n {
            let mut l: i64 = 1;
            for j in i..n {
                l = l / solution_gcd(l, nums[j]) * nums[j];
                if l > k {
                    break;
                }
                if l == k {
                    count += 1;
                }
            }
        }
        count
    }
}

struct Solution {}

fn solution_subarray_lcm(nums: Vec[i64], k: i64) -> i64 {
    let asked: Vec[i32] = nums.iter().map(|v| v as i32).collect();
    Solution.subarray_lcm(asked, k as i32)
}

// ---- the differential -------------------------------------------------------

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_subarray_lcm(nums, k),
        1 => window_subarray_lcm(nums, k),
        2 => sieve_subarray_lcm(nums, k),
        3 => map_subarray_lcm(nums, k),
        4 => iter_subarray_lcm(nums, k),
        _ => solution_subarray_lcm(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arms = ["star", "window", "sieve", "map", "iter", "solution"];
    let mut seed = 2470;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..360 {
        let (n, k) = if t < 300 {
            (1 + next_random(mut seed) % 10, 1 + next_random(mut seed) % 60)
        } else {
            (1 + next_random(mut seed) % 16, 1 + next_random(mut seed) % 120)
        };
        let divisors: Vec[i64] = (1..k + 1).filter(|d| k % d == 0).collect();
        let nums: Vec[i64] = (0..n).map(|_| {
            if next_random(mut seed) % 6 == 0 {
                1 + next_random(mut seed) % 500
            } else {
                divisors[next_random(mut seed) % divisors.len()]
            }
        }).collect();
        cases.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (nums, k) = cases[c].clone();
        let truth = count_literally(nums, k);
        check = (check * 31 + truth) % 1000000007;
        let mut reversed = nums.clone();
        reversed.reverse();
        let mut twice = nums.clone();
        twice.push(k + 1);
        twice.extend(nums.clone());
        let doubled: Vec[i64] = nums.iter().map(|v| 2 * v).collect();
        let mut capped = nums.clone();
        capped.push(k);
        let mut run = 0;
        for v in nums.iter() {
            run = if k % v == 0 { run + 1 } else { 0 };
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, reversed, k) == value,
                answer(arm, twice, k) == 2 * value,
                answer(arm, doubled, 2 * k) == value,
                answer(arm, capped, k) == value + run + 1,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
