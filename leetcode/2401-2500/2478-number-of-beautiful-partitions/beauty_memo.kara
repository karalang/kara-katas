// LeetCode #2478: Number of Beautiful Partitions -- top down, memoized:
// `from(e, j)` counts the ways to cut the digits from place `e`, where a
// part may begin, into `j` beautiful parts, and `after(i, j)` sums
// `from` over such places at or past `i`. A part begun at `e` ends at
// some such place at least `minLength` on, so `from(e, j)` is
// `after(e + minLength, j - 1)`. Both are kept in flat tables. O(n k).

fn is_prime_digit(c: i64) -> bool {
    c == 2 or c == 3 or c == 5 or c == 7
}

struct Memo {
    n: i64,
    min_length: i64,
    begins: Vec[bool],
    from_table: Vec[i64],
    after_table: Vec[i64],
}

fn from(memo: mut ref Memo, e: i64, j: i64) -> i64 {
    if j == 0 {
        return if e == memo.n { 1 } else { 0 };
    }
    if e == memo.n {
        return 0;
    }
    let at = j * (memo.n + 2) + e;
    if memo.from_table[at] < 0 {
        let found = after(mut memo, e + memo.min_length, j - 1);
        memo.from_table[at] = found;
    }
    memo.from_table[at]
}

fn after(memo: mut ref Memo, i: i64, j: i64) -> i64 {
    if i > memo.n {
        return 0;
    }
    let at = j * (memo.n + 2) + i;
    if memo.after_table[at] < 0 {
        let mut total = after(mut memo, i + 1, j);
        if memo.begins[i] {
            total = (total + from(mut memo, i, j)) % 1000000007;
        }
        memo.after_table[at] = total;
    }
    memo.after_table[at]
}

fn beautiful_partitions(s: Str, k: i64, min_length: i64) -> i64 {
    let digits: Vec[i64] = s.chars().map(|c| c as i64 - '0' as i64).collect();
    let n = digits.len();
    if not is_prime_digit(digits[0]) or is_prime_digit(digits[n - 1]) {
        return 0;
    }
    let mut begins: Vec[bool] = Vec.filled(n + 1, false);
    begins[n] = true;
    for i in 1..n {
        begins[i] = not is_prime_digit(digits[i - 1]) and is_prime_digit(digits[i]);
    }
    let size = (k + 1) * (n + 2);
    let mut memo = Memo { n: n, min_length: min_length, begins: begins, from_table: Vec.filled(size, -1), after_table: Vec.filled(size, -1) };
    from(mut memo, 0, k)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` random digits from 1 to 9
fn random_digits(n: i64, seed: mut ref i64) -> String {
    let mut text = "".to_string();
    for _ in 0..n {
        text.push_str(f"{1 + next_random(mut seed) % 9}");
    }
    text
}

fn main() {
    // LeetCode's three examples; then one digit, a prime one and a
    // non-prime one; a string that cannot start; one that cannot end;
    // parts too long for the string; every cut taken; and two parts
    // asked of a string with no cut inside it
    let cases: Vec[(String, i64, i64)] = [
        ("23542185131", 3, 2),
        ("23542185131", 3, 3),
        ("3312958", 3, 1),
        ("2", 1, 1),
        ("1", 1, 1),
        ("12", 1, 1),
        ("23", 1, 1),
        ("2121", 2, 3),
        ("212121", 3, 2),
        ("2222111", 2, 1),
    ].to_vec();
    for (s, k, m) in cases.into_iter() {
        let shown = f"{s}";
        println(f"\"{shown}\", {k}, {m} -> {beautiful_partitions(s, k, m)}");
    }
    // the constraints' largest, 1000 digits: "21" 500 times, cut
    // everywhere into 500 parts and into 250 of at least 4; and a
    // random string with k of 1, 10, 100 and 300 and minLength 1, 2 and 3
    let alternating = "21".repeat(500);
    println(f"\"21\" x 500, 500, 2 -> {beautiful_partitions(alternating, 500, 2)}");
    println(f"\"21\" x 500, 250, 4 -> {beautiful_partitions(alternating, 250, 4)}");
    println(f"\"21\" x 500, 100, 3 -> {beautiful_partitions(alternating, 100, 3)}");
    let mut seed = 2478;
    let long = f"2{random_digits(998, mut seed)}1";
    for k in [1, 10, 100, 300].iter() {
        for m in [1, 2, 3].iter() {
            println(f"random 1000, {k}, {m} -> {beautiful_partitions(long, k, m)}");
        }
    }
    // 3000 random strings of 1 to 40 digits, k and minLength from 1 to
    // the length: a checksum of every answer in order
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 40;
        let s = random_digits(n, mut seed);
        let k = 1 + next_random(mut seed) % n;
        let m = 1 + next_random(mut seed) % n;
        check = (check * 31 + beautiful_partitions(s, k, m)) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
