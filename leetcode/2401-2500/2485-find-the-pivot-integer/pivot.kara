// LeetCode #2485: Find the Pivot Integer -- by the square root: the sum
// of 1 to `x` and the sum of `x` to `n` are `x (x + 1) / 2` and
// `n (n + 1) / 2 - x (x - 1) / 2`, equal exactly when `x^2` is
// `n (n + 1) / 2`. So the pivot is that total's square root when it is
// a whole number, found by rounding the `f64` root and checking it, and
// there is none otherwise. O(1).

fn pivot_integer(n: i64) -> i64 {
    let total = n * (n + 1) / 2;
    let x = (total as f64).sqrt().round() as i64;
    if x * x == total { x } else { -1 }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; then the next two counts with a pivot,
    // two without, and the constraints' largest
    for n in [8, 1, 4, 49, 288, 2, 9, 1000].iter() {
        println(f"{n} -> {pivot_integer(n)}");
    }
    // every count from 1 to 1000, the constraints' whole range: the
    // counts with a pivot, and the pivots
    let mut found: Vec[String] = Vec.new();
    for n in 1..1001 {
        let x = pivot_integer(n);
        if x != -1 {
            found.push(f"{n}:{x}");
        }
    }
    println(f"1 to 1000 -> {found.len()} with a pivot: {found.join(" ")}");
    // 3000 random counts from 1 to 1000: a checksum of every answer in
    // order
    let mut seed = 2485;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 1000;
        check = (check * 31 + pivot_integer(n) + 2) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
