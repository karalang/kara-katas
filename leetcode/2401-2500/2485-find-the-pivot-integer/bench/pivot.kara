// LeetCode #2485: Find the Pivot Integer -- bench: the ★ arm, the
// rounded `f64` square root of `n (n + 1) / 2` when its square is that
// total, else -1. O(1).

fn pivot_integer(n: i64) -> i64 {
    let total = n * (n + 1) / 2;
    let x = (total as f64).sqrt().round() as i64;
    if x * x == total { x } else { -1 }
}

// ---- bench ------------------------------------------------------------------

fn main() {
    // 24000 passes over every count from 1 to 1000, each starting at a
    // count chosen by the checksum so far, folding each answer plus the
    // pass into the checksum
    let mut check = 0;
    for p in 0..24000 {
        let start = check % 1000;
        for i in 0..1000 {
            let n = 1 + (start + i) % 1000;
            check = (check * 31 + pivot_integer(n) + 2 + p) % 1000000007;
        }
    }
    println(f"24000 passes over every count from 1 to 1000: checksum {check}");
}
