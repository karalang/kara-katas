// LeetCode #2477: Minimum Fuel Cost to Report to the Capital -- the bench,
// the ★ arm: a breadth-first order from the capital, walked backwards,
// gives each city its subtree's size, and the road out of it carries
// `ceil(size / seats)` cars.

fn minimum_fuel_cost(roads: Vec[Vec[i64]], seats: i64) -> i64 {
    let n = roads.len() + 1;
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for road in roads.iter() {
        adjacent[road[0]].push(road[1]);
        adjacent[road[1]].push(road[0]);
    }
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    let mut order: Vec[i64] = [0].to_vec();
    parent[0] = 0;
    let mut next = 0;
    while next < order.len() {
        let city = order[next];
        next += 1;
        for other in adjacent[city].iter() {
            if parent[other] < 0 {
                parent[other] = city;
                order.push(other);
            }
        }
    }
    let mut size: Vec[i64] = Vec.filled(n, 1);
    let mut fuel = 0;
    for k in (1..n).rev() {
        let city = order[k];
        fuel += (size[city] + seats - 1) / seats;
        size[parent[city]] += size[city];
    }
    fuel
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    let high = next_random(mut seed);
    high * 32768 + next_random(mut seed)
}

fn random_roads(n: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut roads: Vec[Vec[i64]] = Vec.new();
    for k in 1..n {
        let other = wide_random(mut seed) % k;
        if next_random(mut seed) % 2 == 0 {
            roads.push([k, other].to_vec());
        } else {
            roads.push([other, k].to_vec());
        }
    }
    for i in (1..roads.len()).rev() {
        let j = wide_random(mut seed) % (i + 1);
        roads.swap(i, j);
    }
    roads
}

fn main() {
    // 20 random trees of 10^4 cities built once; then 60 passes, each
    // answering every tree with 1 to 50 seats chosen by the checksum so
    // far, folding the fuel plus the pass into the checksum
    let mut seed = 2477;
    let trees: Vec[Vec[Vec[i64]]] = (0..20).map(|_| random_roads(10000, mut seed)).collect();
    let mut check = 0;
    for p in 0..60 {
        for roads in trees.iter() {
            let seats = 1 + check % 50;
            check = (check * 31 + minimum_fuel_cost(roads, seats) + p) % 1000000007;
        }
    }
    println(f"60 passes over 20 trees of 10^4: checksum {check}");
}
