// LeetCode #2477: Minimum Fuel Cost to Report to the Capital --
// iterators: the breadth-first order grown by `extend` with each city's
// unseen neighbours taken by `filter`, then the sizes by a `rev` walk
// over it, and the fuel the `map` and `sum` of every city's cars but the
// capital's. O(n).

fn minimum_fuel_cost(roads: Vec[Vec[i64]], seats: i64) -> i64 {
    let n = roads.len() + 1;
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for road in roads.iter() {
        adjacent[road[0]].push(road[1]);
        adjacent[road[1]].push(road[0]);
    }
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    parent[0] = 0;
    let mut order: Vec[i64] = [0].to_vec();
    let mut next = 0;
    while next < order.len() {
        let city = order[next];
        next += 1;
        let fresh: Vec[i64] = adjacent[city].iter().filter(|o| parent[o] < 0).cloned().collect();
        for o in fresh.iter() {
            parent[o] = city;
        }
        order.extend(fresh);
    }
    let mut size: Vec[i64] = Vec.filled(n, 1);
    for city in order.iter().skip(1).rev() {
        size[parent[city]] += size[city];
    }
    (1..n).map(|city| (size[city] + seats - 1) / seats).sum()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw up to 2^30, two 15-bit draws joined
fn wide_random(seed: mut ref i64) -> i64 {
    let high = next_random(mut seed);
    high * 32768 + next_random(mut seed)
}

// the roads of a random tree of `n` cities: each city after the first
// joined to a random earlier one, each road's ends in a random order,
// and the roads shuffled
fn random_roads(n: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut roads: Vec[Vec[i64]] = Vec.new();
    for k in 1..n {
        let other = wide_random(mut seed) % k;
        if next_random(mut seed) % 2 == 0 {
            roads.push([k, other].to_vec());
        } else {
            roads.push([other, k].to_vec());
        }
    }
    for i in (1..roads.len()).rev() {
        let j = wide_random(mut seed) % (i + 1);
        roads.swap(i, j);
    }
    roads
}

fn main() {
    // LeetCode's three examples; then a path from the capital with one
    // seat; a star round it with two; and a path with the capital in the
    // middle
    let cases: Vec[(Vec[Vec[i64]], i64)] = [
        ([[0, 1].to_vec(), [0, 2].to_vec(), [0, 3].to_vec()].to_vec(), 5),
        ([[3, 1].to_vec(), [3, 2].to_vec(), [1, 0].to_vec(), [0, 4].to_vec(), [0, 5].to_vec(), [4, 6].to_vec()].to_vec(), 2),
        (Vec.new(), 1),
        ([[0, 1].to_vec(), [1, 2].to_vec(), [2, 3].to_vec(), [3, 4].to_vec()].to_vec(), 1),
        ([[0, 1].to_vec(), [0, 2].to_vec(), [0, 3].to_vec(), [0, 4].to_vec(), [0, 5].to_vec()].to_vec(), 2),
        ([[2, 1].to_vec(), [1, 0].to_vec(), [0, 3].to_vec(), [3, 4].to_vec()].to_vec(), 3),
    ].to_vec();
    for (roads, seats) in cases.into_iter() {
        let shown = f"{roads}";
        println(f"{shown}, seats {seats} -> {minimum_fuel_cost(roads, seats)}");
    }
    // the constraints' largest, 10^5 cities, with 1, 3 and 10^5 seats; then
    // a path of 2000 cities from the capital, with 1 and 7 seats
    let mut seed = 2477;
    let big = random_roads(100000, mut seed);
    for seats in [1, 3, 100000].iter() {
        println(f"10^5 cities, seats {seats} -> {minimum_fuel_cost(big, seats)}");
    }
    let path: Vec[Vec[i64]] = (1..2000).map(|k| [k - 1, k].to_vec()).collect();
    println(f"a path of 2000, seats 1 -> {minimum_fuel_cost(path, 1)}");
    println(f"a path of 2000, seats 7 -> {minimum_fuel_cost(path, 7)}");
    // 3000 random trees of 1 to 40 cities with 1 to 10 seats: a checksum
    // of every answer in order
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 40;
        let roads = random_roads(n, mut seed);
        let seats = 1 + next_random(mut seed) % 10;
        check = (check * 31 + minimum_fuel_cost(roads, seats)) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
