// LeetCode #2466: Count Ways To Build Good Strings -- pushed forward: each
// length's count is added to the two lengths one block longer, and a
// count is final once every shorter length has pushed into it. Only the
// last `max(zero, one)` counts matter, so a ring of that many plus one
// holds them. O(high) time, O(zero + one) space.

const MOD: i64 = 1000000007;

fn count_good_strings(low: i64, high: i64, zero: i64, one: i64) -> i64 {
    let size = zero.max(one) + 1;
    let mut ring: Vec[i64] = Vec.filled(size, 0);
    ring[0] = 1;
    let mut total = 0;
    for len in 0..high + 1 {
        let here = ring[len % size];
        ring[len % size] = 0;
        if len >= low {
            total = (total + here) % MOD;
        }
        let z = (len + zero) % size;
        ring[z] = (ring[z] + here) % MOD;
        let o = (len + one) % size;
        ring[o] = (ring[o] + here) % MOD;
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then one block of each, length one; blocks
    // of two that never reach an odd length; equal block sizes; and the
    // largest blocks the constraints allow
    let cases: Vec[(i64, i64, i64, i64)] = [
        (3, 3, 1, 1),
        (2, 3, 1, 2),
        (1, 1, 1, 1),
        (5, 5, 2, 2),
        (4, 9, 2, 2),
        (6, 20, 6, 6),
        (7, 30, 3, 7),
    ].to_vec();
    for (low, high, zero, one) in cases.into_iter() {
        println(f"({low}, {high}, {zero}, {one}) -> {count_good_strings(low, high, zero, one)}");
    }
    // the constraints' largest: every length up to 10^5 with blocks of
    // one; only 10^5 itself; and blocks of 1 and 10^5
    println(f"(1, 100000, 1, 1) -> {count_good_strings(1, 100000, 1, 1)}");
    println(f"(100000, 100000, 1, 1) -> {count_good_strings(100000, 100000, 1, 1)}");
    println(f"(100000, 100000, 1, 100000) -> {count_good_strings(100000, 100000, 1, 100000)}");
    println(f"(50000, 100000, 3, 7) -> {count_good_strings(50000, 100000, 3, 7)}");
    // 3000 random cases with `high` up to 300 and each block no longer
    // than `low`: a checksum of every answer in order
    let mut seed = 2466;
    let mut check = 0;
    for _ in 0..3000 {
        let a = 1 + next_random(mut seed) % 300;
        let b = 1 + next_random(mut seed) % 300;
        let low = a.min(b);
        let high = a.max(b);
        let zero = 1 + next_random(mut seed) % low;
        let one = 1 + next_random(mut seed) % low;
        check = (check * 31 + count_good_strings(low, high, zero, one)) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
