// LeetCode #2466: Count Ways To Build Good Strings -- the differential.
// The six arms against the statement read literally: every string built
// by appending a block of `zero` zeros or of `one` ones, starting from the
// empty string, kept as text in a `Set` while no longer than `high`, and
// the good ones counted by length. 360 cases: 300 random with `high` up
// to 12 and blocks no longer than `low`; then 60 with `high` up to 24 and
// blocks of 3 or more. Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the two block sizes swapped: the same answer
// P3  the range split at a random length: the two answers sum to it
// P4  every bound and block doubled: the same answer
// P5  the answer is above 0 exactly when some length in range is a sum
//     of blocks, and below 10^9 + 7
// P6  each arm agrees with at least three of the other five

const MOD: i64 = 1000000007;

// ---- the statement read literally ------------------------------------------

fn good_literally(low: i64, high: i64, zero: i64, one: i64) -> i64 {
    let zeros = "0".repeat(zero);
    let ones = "1".repeat(one);
    let mut built: Set[String] = Set.new();
    let mut waiting: Vec[String] = [""].to_vec();
    while waiting.len() > 0 {
        let text = waiting.pop().unwrap();
        for block in [zeros.clone(), ones.clone()].iter() {
            let longer = f"{text}{block}";
            if longer.len() <= high and not built.contains(longer) {
                built.insert(longer.clone());
                waiting.push(longer);
            }
        }
    }
    built.iter().filter(|text| text.len() >= low).count()
}

// some length from `low` to `high` is `a * zero + b * one`
fn reachable(low: i64, high: i64, zero: i64, one: i64) -> bool {
    let mut a = 0;
    while a * zero <= high {
        let mut b = 0;
        while a * zero + b * one <= high {
            if a * zero + b * one >= low {
                return true;
            }
            b += 1;
        }
        a += 1;
    }
    false
}

// ---- star (good.kara) ----------------------------------------------------

fn star_count_good_strings(low: i64, high: i64, zero: i64, one: i64) -> i64 {
    let mut ways: Vec[i64] = Vec.filled(high + 1, 0);
    ways[0] = 1;
    let mut total = 0;
    for len in 1..high + 1 {
        if len >= zero {
            ways[len] = (ways[len] + ways[len - zero]) % MOD;
        }
        if len >= one {
            ways[len] = (ways[len] + ways[len - one]) % MOD;
        }
        if len >= low {
            total = (total + ways[len]) % MOD;
        }
    }
    total
}

// ---- memo (good_memo.kara) -----------------------------------------------

fn memo_count_from(len: i64, low: i64, high: i64, zero: i64, one: i64, memo: mut ref Vec[i64]) -> i64 {
    if len > high {
        return 0;
    }
    if memo[len] >= 0 {
        return memo[len];
    }
    let mut ways = if len >= low { 1 } else { 0 };
    ways = (ways + memo_count_from(len + zero, low, high, zero, one, mut memo)) % MOD;
    ways = (ways + memo_count_from(len + one, low, high, zero, one, mut memo)) % MOD;
    memo[len] = ways;
    ways
}

fn memo_count_good_strings(low: i64, high: i64, zero: i64, one: i64) -> i64 {
    let mut memo: Vec[i64] = Vec.filled(high + 1, -1);
    memo_count_from(0, low, high, zero, one, mut memo)
}

// ---- blocks (good_blocks.kara) -------------------------------------------

fn blocks_power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut b = base % MOD;
    let mut e = exp;
    while e > 0 {
        if e & 1 == 1 {
            result = result * b % MOD;
        }
        b = b * b % MOD;
        e >>= 1;
    }
    result
}

fn blocks_count_good_strings(low: i64, high: i64, zero: i64, one: i64) -> i64 {
    let top = 2 * high + 2;
    let mut fact: Vec[i64] = Vec.filled(top + 1, 1);
    for i in 1..top + 1 {
        fact[i] = fact[i - 1] * i % MOD;
    }
    let mut inv: Vec[i64] = Vec.filled(top + 1, 1);
    inv[top] = blocks_power(fact[top], MOD - 2);
    for i in (1..top + 1).rev() {
        inv[i - 1] = inv[i] * i % MOD;
    }
    let choose = |n: i64, k: i64| {
        if k < 0 or k > n {
            0
        } else {
            fact[n] * inv[k] % MOD * inv[n - k] % MOD
        }
    };
    let mut total = 0;
    let mut a = 0;
    while a * zero <= high {
        let left_low = (low - a * zero).max(0);
        let left_high = high - a * zero;
        // the least `b` with `b * one >= left_low`, the most with
        // `b * one <= left_high`
        let lo = (left_low + one - 1) / one;
        let hi = left_high / one;
        if lo <= hi {
            let span = (choose(a + hi + 1, a + 1) - choose(a + lo, a + 1) + MOD) % MOD;
            total = (total + span) % MOD;
        }
        a += 1;
    }
    total
}

// ---- push (good_push.kara) -----------------------------------------------

fn push_count_good_strings(low: i64, high: i64, zero: i64, one: i64) -> i64 {
    let size = zero.max(one) + 1;
    let mut ring: Vec[i64] = Vec.filled(size, 0);
    ring[0] = 1;
    let mut total = 0;
    for len in 0..high + 1 {
        let here = ring[len % size];
        ring[len % size] = 0;
        if len >= low {
            total = (total + here) % MOD;
        }
        let z = (len + zero) % size;
        ring[z] = (ring[z] + here) % MOD;
        let o = (len + one) % size;
        ring[o] = (ring[o] + here) % MOD;
    }
    total
}

// ---- iter (good_iter.kara) -----------------------------------------------

fn iter_count_good_strings(low: i64, high: i64, zero: i64, one: i64) -> i64 {
    let mut ways: Vec[i64] = Vec.filled(high + 1, 0);
    ways[0] = 1;
    (1..high + 1).for_each(|len| {
        ways[len] = [zero, one].iter().filter_map(|step| if len >= step { Some(ways[len - step]) } else { None }).fold(0, |acc, w| (acc + w) % MOD);
    });
    ways.iter().skip(low).fold(0, |acc, w| (acc + w) % MOD)
}

// ---- solution (good_solution.kara) ---------------------------------------

impl Solution {
    pub fn count_good_strings(low: i32, high: i32, zero: i32, one: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let (low, high, zero, one) = (low as i64, high as i64, zero as i64, one as i64);
        let mut dp = Vec.filled(high + 1, 0);
        dp[0] = 1;
        let mut ans = 0;
        for len in 1..=high {
            if len >= zero {
                dp[len] += dp[len - zero];
            }
            if len >= one {
                dp[len] += dp[len - one];
            }
            dp[len] %= MOD;
            if len >= low {
                ans = (ans + dp[len]) % MOD;
            }
        }
        ans as i32
    }
}

struct Solution {}

fn solution_count_good_strings(low: i64, high: i64, zero: i64, one: i64) -> i64 {
    Solution.count_good_strings(low as i32, high as i32, zero as i32, one as i32)
}

// ---- the differential -------------------------------------------------------

fn answer(arm: i64, low: i64, high: i64, zero: i64, one: i64) -> i64 {
    match arm {
        0 => star_count_good_strings(low, high, zero, one),
        1 => memo_count_good_strings(low, high, zero, one),
        2 => blocks_count_good_strings(low, high, zero, one),
        3 => push_count_good_strings(low, high, zero, one),
        4 => iter_count_good_strings(low, high, zero, one),
        _ => solution_count_good_strings(low, high, zero, one),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arms = ["star", "memo", "blocks", "push", "iter", "solution"];
    let mut seed = 2466;
    let mut cases: Vec[(i64, i64, i64, i64, i64)] = Vec.new();
    for t in 0..360 {
        let (top, least) = if t < 300 { (12, 1) } else { (24, 3) };
        let a = least + next_random(mut seed) % (top - least + 1);
        let b = least + next_random(mut seed) % (top - least + 1);
        let low = a.min(b);
        let high = a.max(b);
        let zero = least + next_random(mut seed) % (low - least + 1);
        let one = least + next_random(mut seed) % (low - least + 1);
        // where P3 splits the range: `low` to `cut`, then `cut + 1` on
        let cut = low + next_random(mut seed) % (high - low + 1);
        cases.push((low, high, zero, one, cut));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (low, high, zero, one, cut) = cases[c];
        let truth = good_literally(low, high, zero, one);
        check = (check * 31 + truth) % 1000000007;
        let some = reachable(low, high, zero, one);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, low, high, zero, one)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let split = if cut == high {
                answer(arm, low, cut, zero, one)
            } else {
                (answer(arm, low, cut, zero, one) + answer(arm, cut + 1, high, zero, one)) % MOD
            };
            let verdicts = [
                value == truth,
                answer(arm, low, high, one, zero) == value,
                split == value,
                answer(arm, 2 * low, 2 * high, 2 * zero, 2 * one) == value,
                (value > 0) == some and value < MOD,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
