// LeetCode #2469: Convert the Temperature -- iterators: each scale as a
// pair of a factor and an offset, kelvin `(1, 273.15)` and Fahrenheit
// `(1.8, 32)`, mapped over by `map`. O(1).

fn convert_temperature(celsius: f64) -> Vec[f64] {
    let scales: Vec[(f64, f64)] = [(1.0, 273.15), (1.8, 32.0)].to_vec();
    scales.iter().map(|(factor, offset)| celsius * factor + offset).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(values: Vec[f64]) -> String {
    f"[{values[0]:.5}, {values[1]:.5}]"
}

fn main() {
    // LeetCode's two examples; then the range's two ends, a hundredth
    // above the first, 40, and a hundredth below the last
    for celsius in [36.50, 122.11, 0.00, 1000.00, 0.01, 40.00, 999.99].iter() {
        println(f"{celsius:.2} -> {show(convert_temperature(celsius))}");
    }
    // every hundredth from 0 to 1000, the constraints' whole range: the
    // sums of each answer's two values, rounded to hundred-thousandths
    let mut kelvin_sum = 0;
    let mut fahrenheit_sum = 0;
    for hundredths in 0..100001 {
        let got = convert_temperature(hundredths as f64 / 100.0);
        kelvin_sum += (got[0] * 100000.0).round() as i64;
        fahrenheit_sum += (got[1] * 100000.0).round() as i64;
    }
    println(f"every hundredth: kelvin {kelvin_sum}, fahrenheit {fahrenheit_sum}");
    // 3000 random temperatures with two decimals: a checksum of every
    // answer rounded to hundred-thousandths
    let mut seed = 2469;
    let mut check = 0;
    for _ in 0..3000 {
        let hundredths = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100001;
        let got = convert_temperature(hundredths as f64 / 100.0);
        for v in got.iter() {
            check = (check * 31 + (v * 100000.0).round() as i64) % 1000000007;
        }
    }
    println(f"3000 random: checksum {check}");
}
