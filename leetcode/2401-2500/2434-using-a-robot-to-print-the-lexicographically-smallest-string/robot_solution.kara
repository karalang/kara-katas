// LeetCode #2434: Using a Robot to Print the Lexicographically Smallest
// String -- LeetCode's Rust template, as Rust writes it, carried by karac
// fix: `s.as_bytes()`, the suffix minima in `vec![b'z'; n + 1]`, and the
// stack popped by `while let Some(&c) = t.last()` into a
// `String::with_capacity(n)` by `push(c as char)`.

impl Solution {
    pub fn robot_with_string(s: String) -> String {
        let s = s.bytes();
        let n = s.len();
        let mut min_suffix = Vec.filled(n + 1, b'z');
        for i in (0..n).rev() {
            min_suffix[i] = min_suffix[i + 1].min(s[i]);
        }
        let mut t: Vec[u8] = Vec.new();
        let mut ans = String.with_capacity(n);
        for i in 0..n {
            t.push(s[i]);
            while let Some(c) = t.last().cloned() {
                if c <= min_suffix[i + 1] {
                    ans.push(c as char);
                    t.pop();
                } else {
                    break;
                }
            }
        }
        ans
    }
}

struct Solution {}

fn robot_with_string(s: String) -> String {
    Solution.robot_with_string(s)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, n: i64, kinds: i64) -> String {
    let mut bytes: Vec[u8] = Vec.new();
    for _ in 0..n {
        bytes.push(b'a' + (next_random(mut seed) % kinds) as u8);
    }
    String.from_utf8(bytes).unwrap()
}

// a checksum of a word's letters in order
fn fold(word: String) -> i64 {
    let mut check = 0;
    for b in word.bytes().iter() {
        check = (check * 31 + b as i64) % 1000000007;
    }
    check
}

fn main() {
    // LeetCode's three examples; one letter; letters already in order;
    // the alphabet backwards, which comes out in order; a run of one
    // letter with a smaller one last
    for s in ["zza", "bac", "bdda", "q", "abcde", "zyxwvutsrqponmlkjihgfedcba", "bbbba"].iter() {
        println(f"{s}: {robot_with_string(s.to_string())}");
    }
    // 10^4 random letters from 26, and the alphabet backwards over and
    // over, each as a checksum
    let mut seed = 2434;
    println(f"10^4 random: checksum {fold(robot_with_string(random_word(mut seed, 10000, 26)))}");
    let mut falling: Vec[u8] = Vec.new();
    for i in 0..10000 {
        falling.push(b'z' - (i % 26) as u8);
    }
    println(f"10^4 falling: checksum {fold(robot_with_string(String.from_utf8(falling).unwrap()))}");
    // 3000 random words of 1 to 12 letters from the first 1 to 4: a
    // checksum of every answer's checksum in order
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 12;
        let kinds = 1 + next_random(mut seed) % 4;
        check = (check * 31 + fold(robot_with_string(random_word(mut seed, n, kinds)))) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
