// LeetCode #2443: Sum of Number and Its Reverse -- the bench, the ★ arm:
// every `k` from 0 to `num` tried, its digits reversed by `% 10` and
// `/ 10`.

fn reversed(x: i64) -> i64 {
    let mut r = 0;
    let mut y = x;
    while y > 0 {
        r = r * 10 + y % 10;
        y /= 10;
    }
    r
}

fn sum_of_number_and_reverse(num: i64) -> bool {
    for k in 0..num + 1 {
        if k + reversed(k) == num {
            return true;
        }
    }
    false
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2443;
    // 400 nums from 9 * 10^4 to 10^5, the top of the constraints, each
    // folded with its verdict and its place
    let mut check = 0;
    for i in 0..400 {
        let num = 90000 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 10001;
        let verdict = if sum_of_number_and_reverse(num) { 1 } else { 0 };
        check = (check * 31 + num * 2 + verdict + i) % 1000000007;
    }
    println(f"400 nums near 10^5: checksum {check}");
}
