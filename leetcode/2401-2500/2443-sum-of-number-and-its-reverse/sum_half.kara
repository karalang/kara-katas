// LeetCode #2443: Sum of Number and Its Reverse -- half the range: if
// `k + reverse(k) = num` then `k` or its reversal is at least `num / 2`,
// since they add to `num`; and when the reversal is the larger, `k` has
// no trailing zero, so the reversal reversed is `k` again and works too.
// So only `k` from `num / 2` up need be tried, from the top down.
// O(num log num) with half the tries.

fn reversed(x: i64) -> i64 {
    let mut r = 0;
    let mut y = x;
    while y > 0 {
        r = r * 10 + y % 10;
        y /= 10;
    }
    r
}

fn sum_of_number_and_reverse(num: i64) -> bool {
    let mut k = num;
    while k >= num / 2 {
        if k + reversed(k) == num {
            return true;
        }
        if k == 0 {
            break;
        }
        k -= 1;
    }
    false
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; 0, 1 and 10; the constraints' largest
    for num in [443, 63, 181, 0, 1, 10, 100000].iter() {
        println(f"{num}: {sum_of_number_and_reverse(num)}");
    }
    // every num from 0 to 1000: how many hold, and a checksum of those
    let mut count = 0;
    let mut check = 0;
    for num in 0..1001 {
        if sum_of_number_and_reverse(num) {
            count += 1;
            check = (check * 31 + num) % 1000000007;
        }
    }
    println(f"0 to 1000: {count} hold, checksum {check}");
    // 30 random nums from 0 to 10^5: a checksum of the verdicts
    let mut seed = 2443;
    let mut bits = 0;
    for _ in 0..30 {
        let num = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100001;
        bits = bits * 2 + if sum_of_number_and_reverse(num) { 1 } else { 0 };
    }
    println(f"30 random: verdicts {bits}");
    // 30 sums of a random `k` up to 5 * 10^4 and its reversal, kept to
    // 10^5, each plus one: how many hold
    let mut held = 0;
    let mut tried = 0;
    while tried < 30 {
        let k = (next_random(mut seed) * 32768 + next_random(mut seed)) % 50001;
        let mut r = 0;
        let mut y = k;
        while y > 0 {
            r = r * 10 + y % 10;
            y /= 10;
        }
        if k + r + 1 <= 100000 {
            tried += 1;
            if sum_of_number_and_reverse(k + r) {
                held += 1;
            }
            if sum_of_number_and_reverse(k + r + 1) {
                held += 1;
            }
        }
    }
    println(f"30 sums and 30 sums plus one: {held} hold");
}
