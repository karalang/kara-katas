// LeetCode #2443: Sum of Number and Its Reverse -- the differential. The
// six arms against the statement read literally: every split of `num`
// into `a + b` tried, `a`'s decimal digits listed from the top, reversed,
// stripped of the zeros that then lead, and compared digit by digit with
// `b`'s list; a split that matches answers true. No reversal is formed as
// a number. 360 cases: 300 random nums from 0 to 2000; then 30 from 0 to
// 5000; then 30 sums `k + reverse(k)` for a random `k` up to 3000.
// Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  `k + reverse(k)` for a random `k` from 0 to `num`: true
// P3  twice the palindrome made from `num`'s leading half: true
// P4  11 times `m`, `m` from 0 to 18: true
// P5  `101 s + 20 b`, `s` from 1 to 18 and `b` from 0 to 9: true
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn digit_list(x: i64) -> Vec[i64] {
    let mut digits: Vec[i64] = Vec.new();
    let mut y = x;
    loop {
        digits.insert(0, y % 10);
        y /= 10;
        if y == 0 {
            break;
        }
    }
    digits
}

fn sum_literally(num: i64) -> bool {
    for a in 0..num + 1 {
        let b = num - a;
        let mut flipped = digit_list(a);
        flipped.reverse();
        while flipped.len() > 1 and flipped[0] == 0 {
            flipped.remove(0);
        }
        if flipped == digit_list(b) {
            return true;
        }
    }
    false
}
// ---- star (sum.kara) -----------------------------------------------------

fn star_reversed(x: i64) -> i64 {
    let mut r = 0;
    let mut y = x;
    while y > 0 {
        r = r * 10 + y % 10;
        y /= 10;
    }
    r
}

fn star_sum_of_number_and_reverse(num: i64) -> bool {
    for k in 0..num + 1 {
        if k + star_reversed(k) == num {
            return true;
        }
    }
    false
}

// ---- half (sum_half.kara) ------------------------------------------------

fn half_reversed(x: i64) -> i64 {
    let mut r = 0;
    let mut y = x;
    while y > 0 {
        r = r * 10 + y % 10;
        y /= 10;
    }
    r
}

fn half_sum_of_number_and_reverse(num: i64) -> bool {
    let mut k = num;
    while k >= num / 2 {
        if k + half_reversed(k) == num {
            return true;
        }
        if k == 0 {
            break;
        }
        k -= 1;
    }
    false
}

// ---- table (sum_table.kara) ----------------------------------------------

fn table_sum_of_number_and_reverse(num: i64) -> bool {
    let mut reverse: Vec[i64] = Vec.filled(num + 1, 0);
    let mut place: Vec[i64] = Vec.filled(num + 1, 1);
    let mut hit: Vec[bool] = Vec.filled(num + 1, false);
    for k in 0..num + 1 {
        if k >= 10 {
            reverse[k] = (k % 10) * place[k / 10] + reverse[k / 10];
            place[k] = place[k / 10] * 10;
        } else {
            reverse[k] = k;
            place[k] = 10;
        }
        let s = k + reverse[k];
        if s <= num {
            hit[s] = true;
        }
    }
    hit[num]
}

// ---- text (sum_text.kara) ------------------------------------------------

fn text_sum_of_number_and_reverse(num: i64) -> bool {
    for k in 0..num + 1 {
        let mut digits = f"{k}".bytes().to_vec();
        digits.reverse();
        let r = i64.parse(String.from_utf8(digits).unwrap()).unwrap();
        if k + r == num {
            return true;
        }
    }
    false
}

// ---- iter (sum_iter.kara) ------------------------------------------------

fn iter_reversed(x: i64) -> i64 {
    successors(Some(x), |y| if y >= 10 { Some(y / 10) } else { None })
        .fold(0, |r, y| r * 10 + y % 10)
}

fn iter_sum_of_number_and_reverse(num: i64) -> bool {
    (0..=num).any(|k| k + iter_reversed(k) == num)
}

// ---- solution (sum_solution.kara) ----------------------------------------

impl Solution {
    pub fn sum_of_number_and_reverse(num: i32) -> bool {
        (0..=num).any(|k| k + i32.parse(String.from_iter(k.to_string().chars().rev())).unwrap() == num)
    }
}

struct Solution {}

fn solution_sum_of_number_and_reverse(num: i64) -> bool {
    Solution.sum_of_number_and_reverse(num as i32)
}
// ---- the differential -----------------------------------------------------

fn answer(arm: i64, num: i64) -> bool {
    match arm {
        0 => star_sum_of_number_and_reverse(num),
        1 => half_sum_of_number_and_reverse(num),
        2 => table_sum_of_number_and_reverse(num),
        3 => text_sum_of_number_and_reverse(num),
        4 => iter_sum_of_number_and_reverse(num),
        _ => solution_sum_of_number_and_reverse(num),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn flip(x: i64) -> i64 {
    let mut r = 0;
    let mut y = x;
    while y > 0 {
        r = r * 10 + y % 10;
        y /= 10;
    }
    r
}

fn main() {
    let arms = ["star", "half", "table", "text", "iter", "solution"];
    let mut seed = 2443;
    let mut cases: Vec[i64] = Vec.new();
    for t in 0..360 {
        if t < 300 {
            cases.push(next_random(mut seed) % 2001);
        } else if t < 330 {
            cases.push(next_random(mut seed) % 5001);
        } else {
            let k = next_random(mut seed) % 3001;
            cases.push(k + flip(k));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let num = cases[c];
        let truth = sum_literally(num);
        check = (check * 31 + if truth { num + 1 } else { 0 }) % 1000000007;
        let k = next_random(mut seed) % (num + 1);
        // the palindrome on `num`'s leading half: its digits then those
        // before the middle, reversed
        let digits = f"{num}".len();
        let mut lead = num;
        for _ in 0..digits / 2 {
            lead /= 10;
        }
        let mut palindrome = lead;
        let mut rest = if digits % 2 == 1 { lead / 10 } else { lead };
        while rest > 0 {
            palindrome = palindrome * 10 + rest % 10;
            rest /= 10;
        }
        let m = next_random(mut seed) % 19;
        let s = 1 + next_random(mut seed) % 18;
        let b = next_random(mut seed) % 10;
        let got: Vec[bool] = (0..6).map(|arm| answer(arm, num)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, k + flip(k)),
                answer(arm, 2 * palindrome),
                answer(arm, 11 * m),
                answer(arm, 101 * s + 20 * b),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
