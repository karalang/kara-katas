// LeetCode #2425: Bitwise XOR of All Pairings -- the bench, the ★ arm: the
// XOR of `nums1` when `nums2` has odd length, XORed with that of `nums2`
// when `nums1` has odd length.

fn xor_all_nums(nums1: Vec[i64], nums2: Vec[i64]) -> i64 {
    let mut answer = 0;
    if nums2.len() % 2 == 1 {
        for x in nums1.iter() {
            answer ^= x;
        }
    }
    if nums1.len() % 2 == 1 {
        for y in nums2.iter() {
            answer ^= y;
        }
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2425;
    // pair `i`: lists of 10^5 - i and 10^5 - i / 2 - 1 values up to 10^9,
    // so every mix of odd and even lengths comes up
    let mut firsts: Vec[Vec[i64]] = Vec.new();
    let mut seconds: Vec[Vec[i64]] = Vec.new();
    for i in 0..10 {
        for (list, n) in [(0, 100000 - i), (1, 100000 - i / 2 - 1)].iter() {
            let mut nums: Vec[i64] = Vec.new();
            for _ in 0..n {
                nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001);
            }
            if list == 0 {
                firsts.push(nums);
            } else {
                seconds.push(nums);
            }
        }
    }
    // every pass changes one value of each first list before answering
    let mut check = 0;
    for p in 0..500 {
        for i in 0..10 {
            let at = (p * 7919) % firsts[i].len();
            firsts[i][at] ^= p % 1024;
            check = (check * 31 + xor_all_nums(firsts[i], seconds[i]) + p) % 1000000007;
        }
    }
    println(f"500 passes over 10 pairs of 10^5 values: checksum {check}");
}
