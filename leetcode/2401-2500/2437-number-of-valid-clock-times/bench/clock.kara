// LeetCode #2437: Number of Valid Clock Times -- the bench, the ★ arm:
// the hours that fit the first two characters times the minutes that
// fit the last two.

fn fits(pattern: Slice[u8], value: i64) -> bool {
    let tens = b'0' + (value / 10) as u8;
    let units = b'0' + (value % 10) as u8;
    (pattern[0] == b'?' or pattern[0] == tens) and (pattern[1] == b'?' or pattern[1] == units)
}

fn count_time(time: String) -> i64 {
    let b = time.bytes();
    let mut hours = 0;
    for h in 0..24 {
        if fits(b[0..2], h) {
            hours += 1;
        }
    }
    let mut minutes = 0;
    for m in 0..60 {
        if fits(b[3..5], m) {
            minutes += 1;
        }
    }
    hours * minutes
}

fn main() {
    // every valid time with every set of its digits hidden: 1440 times
    // by 16 masks
    let mut times: Vec[String] = Vec.new();
    for at in 0..1440 {
        for mask in 0..16 {
            let shown = f"{at / 60:02}:{at % 60:02}";
            let mut out: Vec[u8] = Vec.new();
            let mut digit = 0;
            for c in shown.bytes().iter() {
                if c == b':' {
                    out.push(c);
                } else {
                    out.push(if (mask >> digit) & 1 == 1 { b'?' } else { c });
                    digit += 1;
                }
            }
            times.push(String.from_utf8(out).unwrap());
        }
    }
    // pass `p` answers every string, in an order the pass shifts
    let mut check = 0;
    let n = times.len();
    for p in 0..120 {
        for i in 0..n {
            check = (check * 31 + count_time(times[(i * 7 + p) % n]) + p) % 1000000007;
        }
    }
    println(f"120 passes over 23040 patterns: checksum {check}");
}
