// LeetCode #2461: Maximum Sum of Distinct Subarrays With Length K -- the
// differential. The six arms against the statement read literally: every
// subarray of length `k` taken as its own list, its values distinct when
// no two places in it hold the same value, compared pair by pair, and
// the largest sum of a distinct one kept, 0 when there is none. 360
// cases: 300 random arrays of 1 to 12 values from 1 to 6; then 30 of up
// to 200 values from 1 to 1000; then 30 of up to 200 values from 1 to
// 20; each with a random `k` from 1 to the length, at most 30. Every
// case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the array reversed: the same answer
// P3  every value raised by one constant below 1000: the answer plus `k` times it, or 0 if it was 0
// P4  `k` of 1: the largest value
// P5  the array followed by itself: an answer no smaller
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn sum_literally(nums: Vec[i64], k: i64) -> i64 {
    let mut best = 0;
    for start in 0..nums.len() - k + 1 {
        let part: Vec[i64] = nums[start..start + k].to_vec();
        let mut distinct = true;
        for i in 0..k {
            for j in i + 1..k {
                if part[i] == part[j] {
                    distinct = false;
                }
            }
        }
        if distinct {
            let total: i64 = part.iter().sum();
            best = best.max(total);
        }
    }
    best
}

// ---- star (distinct.kara) ------------------------------------------------

fn star_maximum_subarray_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut count: Map[i64, i64] = Map.new();
    let mut sum = 0;
    let mut best = 0;
    for i in 0..nums.len() {
        count[nums[i]] = count.get(nums[i]).unwrap_or(0) + 1;
        sum += nums[i];
        if i >= k {
            let out = nums[i - k];
            count[out] -= 1;
            if count[out] == 0 {
                count.remove(out);
            }
            sum -= out;
        }
        if i + 1 >= k and count.len() == k {
            best = best.max(sum);
        }
    }
    best
}

// ---- naive (distinct_naive.kara) -----------------------------------------

fn naive_maximum_subarray_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut best = 0;
    for start in 0..nums.len() - k + 1 {
        let mut seen: Set[i64] = Set.new();
        let mut sum = 0;
        for i in start..start + k {
            seen.insert(nums[i]);
            sum += nums[i];
        }
        if seen.len() == k {
            best = best.max(sum);
        }
    }
    best
}

// ---- last (distinct_last.kara) -------------------------------------------

fn last_maximum_subarray_sum(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    let mut last: Map[i64, i64] = Map.new();
    let mut from = 0;
    let mut best = 0;
    for i in 0..n {
        if let Some(j) = last.get(nums[i]) {
            from = from.max(j + 1);
        }
        last[nums[i]] = i;
        if i + 1 - from >= k {
            best = best.max(prefix[i + 1] - prefix[i + 1 - k]);
        }
    }
    best
}

// ---- shrink (distinct_shrink.kara) ---------------------------------------

fn shrink_maximum_subarray_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut window: Set[i64] = Set.new();
    let mut front = 0;
    let mut sum = 0;
    let mut best = 0;
    for v in nums.iter() {
        while window.contains(v) {
            window.remove(nums[front]);
            sum -= nums[front];
            front += 1;
        }
        window.insert(v);
        sum += v;
        if window.len() == k {
            best = best.max(sum);
            window.remove(nums[front]);
            sum -= nums[front];
            front += 1;
        }
    }
    best
}

// ---- iter (distinct_iter.kara) -------------------------------------------

fn iter_maximum_subarray_sum(nums: Vec[i64], k: i64) -> i64 {
    let prefix: Vec[i64] = once(0).chain(nums.iter().scan(0, |s, v| Some((s + v, s + v)))).collect();
    let mut last: Map[i64, i64] = Map.new();
    let from: Vec[i64] = nums.iter().enumerate().scan(0, |f, (i, v)| {
        let g = match last.insert(v, i) {
            Some(j) => f.max(j + 1),
            None => f,
        };
        Some((g, g))
    }).collect();
    (k - 1..nums.len()).filter(|i| i + 1 - from[i] >= k).map(|i| prefix[i + 1] - prefix[i + 1 - k]).max().unwrap_or(0)
}

// ---- solution (distinct_solution.kara) -----------------------------------

impl Solution {
    pub fn maximum_subarray_sum(nums: Vec[i32], k: i32) -> i64 {
        let k = k as i64;
        let mut m: Map[i32, i32] = Map.new();
        let mut sum: i64 = 0;
        let mut ans: i64 = 0;
        for i in 0..nums.len() {
            *m.entry(nums[i]).or_insert(0) += 1;
            sum += nums[i];
            if i >= k {
                let x = nums[i - k];
                let c = m.get_mut(x).unwrap();
                *c -= 1;
                if *c == 0 {
                    m.remove(x);
                }
                sum -= x;
            }
            if i + 1 >= k and m.len() == k {
                ans = ans.max(sum);
            }
        }
        ans
    }
}

struct Solution {}

fn solution_maximum_subarray_sum(nums: Vec[i64], k: i64) -> i64 {
    let asked: Vec[i32] = nums.iter().map(|v| v as i32).collect();
    Solution.maximum_subarray_sum(asked, k as i32)
}

// ---- the differential -------------------------------------------------------

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_maximum_subarray_sum(nums, k),
        1 => naive_maximum_subarray_sum(nums, k),
        2 => last_maximum_subarray_sum(nums, k),
        3 => shrink_maximum_subarray_sum(nums, k),
        4 => iter_maximum_subarray_sum(nums, k),
        _ => solution_maximum_subarray_sum(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arms = ["star", "naive", "last", "shrink", "iter", "solution"];
    let mut seed = 2461;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..360 {
        let (n, top) = if t < 300 {
            (1 + next_random(mut seed) % 12, 6)
        } else if t < 330 {
            (1 + next_random(mut seed) % 200, 1000)
        } else {
            (1 + next_random(mut seed) % 200, 20)
        };
        let nums: Vec[i64] = (0..n).map(|_| 1 + next_random(mut seed) % top).collect();
        let k = 1 + next_random(mut seed) % n.min(30);
        cases.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (nums, k) = cases[c].clone();
        let truth = sum_literally(nums, k);
        check = (check * 31 + truth) % 1000000007;
        let mut reversed = nums.clone();
        reversed.reverse();
        let lift = 1 + next_random(mut seed) % 999;
        let lifted: Vec[i64] = nums.iter().map(|v| v + lift).collect();
        let largest = nums.iter().max().unwrap();
        let mut twice = nums.clone();
        twice.extend(nums.clone());
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let raised = if value == 0 { 0 } else { value + k * lift };
            let verdicts = [
                value == truth,
                answer(arm, reversed, k) == value,
                answer(arm, lifted, k) == raised,
                answer(arm, nums, 1) == largest,
                answer(arm, twice, k) >= value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
