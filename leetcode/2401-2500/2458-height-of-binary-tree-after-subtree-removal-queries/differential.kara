// LeetCode #2458: Height of Binary Tree After Subtree Removal Queries --
// the differential. The six arms against the statement read literally:
// every node listed with its parent by a breadth-first walk; for each
// query, a node is removed when the query is it or one of its ancestors,
// found by climbing its parents; and the height is the most steps any
// remaining node climbs to the root. No subtree height is kept. 360
// cases: 300 random trees of 2 to 12 nodes; then 30 of up to 60; then 30
// paths of up to 30 nodes, each step left or right at random. Every node
// but the root is asked. Every case is drawn before any arm answers.
//
// P1  the answers are the literal reading's
// P2  the tree mirrored, left and right swapped at every node: the same answers
// P3  each answer at least the depth of the asked node's parent
// P4  each answer no more than the whole tree's height
// P5  a new root put above the old one: every answer one more, and the old root's answer 0
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn heights_literally(root: Option[TreeNode], queries: Vec[i64]) -> Vec[i64] {
    let mut values: Vec[i64] = Vec.new();
    let mut parent: Map[i64, i64] = Map.new();
    let mut queue: Vec[(TreeNode, i64)] = Vec.new();
    if let Some(r) = root {
        queue.push((r, -1));
    }
    let mut head = 0;
    while head < queue.len() {
        let (node, up) = queue[head].clone();
        head += 1;
        values.push(node.val);
        parent[node.val as i64] = up;
        if let Some(c) = node.left {
            queue.push((c, node.val as i64));
        }
        if let Some(c) = node.right {
            queue.push((c, node.val as i64));
        }
    }
    let mut answers: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let mut height = 0;
        for v in values.iter() {
            let mut steps = 0;
            let mut at = v;
            let mut removed = false;
            while at != -1 {
                if at == q {
                    removed = true;
                }
                at = parent[at];
                steps += 1;
            }
            if not removed and steps - 1 > height {
                height = steps - 1;
            }
        }
        answers.push(height);
    }
    answers
}

// ---- star (heights.kara) -------------------------------------------------

fn star_height(node: Option[TreeNode], heights: mut ref Map[i64, i64]) -> i64 {
    match node {
        None => -1,
        Some(n) => {
            let h = 1 + star_height(n.left, mut heights).max(star_height(n.right, mut heights));
            heights[n.val as i64] = h;
            h
        },
    }
}

fn star_of(node: Option[TreeNode], heights: Map[i64, i64]) -> i64 {
    match node {
        None => -1,
        Some(n) => heights[n.val as i64],
    }
}

fn star_walk(node: Option[TreeNode], depth: i64, rest: i64, heights: Map[i64, i64], answers: mut ref Map[i64, i64]) {
    if let Some(n) = node {
        answers[n.val as i64] = rest;
        star_walk(n.left, depth + 1, rest.max(depth + 1 + star_of(n.right, heights)), heights, mut answers);
        star_walk(n.right, depth + 1, rest.max(depth + 1 + star_of(n.left, heights)), heights, mut answers);
    }
}

fn star_tree_queries(root: Option[TreeNode], queries: Vec[i64]) -> Vec[i64] {
    let mut heights: Map[i64, i64] = Map.new();
    star_height(root, mut heights);
    let mut answers: Map[i64, i64] = Map.new();
    star_walk(root, 0, 0, heights, mut answers);
    queries.iter().map(|q| answers[q]).collect()
}

// ---- naive (heights_naive.kara) ------------------------------------------

fn naive_height_without(node: Option[TreeNode], removed: i64) -> i64 {
    match node {
        None => -1,
        Some(n) => {
            if n.val == removed {
                -1
            } else {
                1 + naive_height_without(n.left, removed).max(naive_height_without(n.right, removed))
            }
        },
    }
}

fn naive_tree_queries(root: Option[TreeNode], queries: Vec[i64]) -> Vec[i64] {
    queries.iter().map(|q| naive_height_without(root, q)).collect()
}

// ---- euler (heights_euler.kara) ------------------------------------------

fn euler_tour(node: Option[TreeNode], depth: i64, depths: mut ref Vec[i64], place: mut ref Map[i64, i64], size: mut ref Map[i64, i64]) -> i64 {
    match node {
        None => 0,
        Some(n) => {
            let v = n.val as i64;
            place[v] = depths.len();
            depths.push(depth);
            let s = 1 + euler_tour(n.left, depth + 1, mut depths, mut place, mut size) + euler_tour(n.right, depth + 1, mut depths, mut place, mut size);
            size[v] = s;
            s
        },
    }
}

fn euler_tree_queries(root: Option[TreeNode], queries: Vec[i64]) -> Vec[i64] {
    let mut depths: Vec[i64] = Vec.new();
    let mut place: Map[i64, i64] = Map.new();
    let mut size: Map[i64, i64] = Map.new();
    euler_tour(root, 0, mut depths, mut place, mut size);
    let n = depths.len();
    let mut before: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        before[i + 1] = before[i].max(depths[i]);
    }
    let mut after: Vec[i64] = Vec.filled(n + 1, 0);
    for i in (0..n).rev() {
        after[i] = after[i + 1].max(depths[i]);
    }
    let mut answers: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let start = place[q];
        answers.push(before[start].max(after[start + size[q]]));
    }
    answers
}

// ---- levels (heights_levels.kara) ----------------------------------------

fn levels_reach(node: Option[TreeNode], depth: i64, at: mut ref Map[i64, (i64, i64)], levels: mut ref Vec[(i64, i64, i64)]) -> i64 {
    match node {
        None => depth - 1,
        Some(n) => {
            let deepest = levels_reach(n.left, depth + 1, mut at, mut levels).max(levels_reach(n.right, depth + 1, mut at, mut levels));
            at[n.val as i64] = (depth, deepest);
            while levels.len() <= depth {
                levels.push((-1, -1, 0));
            }
            let (first, second, count) = levels[depth];
            levels[depth] = if deepest >= first { (deepest, first, count + 1) } else { (first, second.max(deepest), count + 1) };
            deepest
        },
    }
}

fn levels_tree_queries(root: Option[TreeNode], queries: Vec[i64]) -> Vec[i64] {
    let mut at: Map[i64, (i64, i64)] = Map.new();
    let mut levels: Vec[(i64, i64, i64)] = Vec.new();
    levels_reach(root, 0, mut at, mut levels);
    let mut answers: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let (depth, deepest) = at[q];
        let (first, second, count) = levels[depth];
        let other = if count == 1 { depth - 1 } else if deepest == first { second } else { first };
        answers.push(other.max(depth - 1));
    }
    answers
}

// ---- iter (heights_iter.kara) --------------------------------------------

fn iter_tour(node: Option[TreeNode], depth: i64, out: mut ref Vec[(i64, i64, i64)]) -> i64 {
    match node {
        None => 0,
        Some(n) => {
            let at = out.len();
            out.push((n.val as i64, depth, 0));
            let size = 1 + iter_tour(n.left, depth + 1, mut out) + iter_tour(n.right, depth + 1, mut out);
            out[at] = (n.val as i64, depth, size);
            size
        },
    }
}

fn iter_tree_queries(root: Option[TreeNode], queries: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[(i64, i64, i64)] = Vec.new();
    iter_tour(root, 0, mut out);
    let place: Map[i64, (i64, i64)] = out.iter().enumerate().map(|(i, e)| (e.0, (i, e.2))).collect();
    let before: Vec[i64] = once(0).chain(out.iter().scan(0, |m, e| Some((m.max(e.1), m.max(e.1))))).collect();
    let mut after: Vec[i64] = out.iter().rev().scan(0, |m, e| Some((m.max(e.1), m.max(e.1)))).collect();
    after.reverse();
    after.push(0);
    queries.iter().map(|q| {
        let (start, size) = place[q];
        before[start].max(after[start + size])
    }).collect()
}

// ---- solution (heights_solution.kara) ------------------------------------

fn solution_height(node: Option[TreeNode], memo: mut ref Map[i32, i32]) -> i32 {
    match node {
        None => -1,
        Some(n) => {
            let h = 1 + solution_height(n.left, mut memo).max(solution_height(n.right, mut memo));
            memo.insert(n.val, h);
            h
        }
    }
}

fn solution_walk(node: Option[TreeNode], depth: i32, rest: i32, memo: ref Map[i32, i32], ans: mut ref Map[i32, i32]) {
    if let Some(n) = node {
        ans.insert(n.val, rest);
        let hl = n.left.as_ref().map_or(-1, |c| memo[c.val]);
        let hr = n.right.as_ref().map_or(-1, |c| memo[c.val]);
        solution_walk(n.left, depth + 1, rest.max(depth + 1 + hr), memo, mut ans);
        solution_walk(n.right, depth + 1, rest.max(depth + 1 + hl), memo, mut ans);
    }
}

impl Solution {
    pub fn tree_queries(root: Option[TreeNode], queries: Vec[i32]) -> Vec[i32] {
        let mut memo = Map.new();
        solution_height(root, mut memo);
        let mut ans = Map.new();
        solution_walk(root, 0, 0, memo, mut ans);
        queries.iter().map(|q| ans[q]).collect()
    }
}

struct Solution {}

fn solution_tree_queries(root: Option[TreeNode], queries: Vec[i64]) -> Vec[i64] {
    let asked: Vec[i32] = queries.iter().map(|q| q as i32).collect();
    Solution.tree_queries(root, asked).iter().map(|a| a as i64).collect()
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, root: Option[TreeNode], queries: Vec[i64]) -> Vec[i64] {
    match arm {
        0 => star_tree_queries(root, queries),
        1 => naive_tree_queries(root, queries),
        2 => euler_tree_queries(root, queries),
        3 => levels_tree_queries(root, queries),
        4 => iter_tree_queries(root, queries),
        _ => solution_tree_queries(root, queries),
    }
}

// LeetCode's own node: an `i32` value
shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v as i32, left: None, right: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` nodes with the values 1 to `n` in a random order, each after the
// first hung below a random earlier one at a free side found by going
// down at random
fn random_tree(n: i64, seed: mut ref i64) -> Option[TreeNode] {
    let mut values: Vec[i64] = (1..n + 1).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        values.swap(i, j);
    }
    let nodes: Vec[TreeNode] = values.iter().map(|v| leaf(v)).collect();
    for k in 1..n {
        let mut at = nodes[next_random(mut seed) % k];
        loop {
            if next_random(mut seed) % 2 == 0 {
                match at.left {
                    Some(c) => at = c,
                    None => {
                        at.left = Some(nodes[k]);
                        break;
                    }
                }
            } else {
                match at.right {
                    Some(c) => at = c,
                    None => {
                        at.right = Some(nodes[k]);
                        break;
                    }
                }
            }
        }
    }
    Some(nodes[0])
}

// a path of `n` nodes, values 1 to `n` from the top, each step a random side
fn random_path(n: i64, seed: mut ref i64) -> Option[TreeNode] {
    let nodes: Vec[TreeNode] = (0..n).map(|i| leaf(i + 1)).collect();
    for i in 1..n {
        if next_random(mut seed) % 2 == 0 {
            nodes[i - 1].left = Some(nodes[i]);
        } else {
            nodes[i - 1].right = Some(nodes[i]);
        }
    }
    Some(nodes[0])
}

fn mirrored(node: Option[TreeNode]) -> Option[TreeNode] {
    match node {
        None => None,
        Some(n) => Some(TreeNode { val: n.val, left: mirrored(n.right), right: mirrored(n.left) }),
    }
}

// every node's depth by its value
fn depths(node: Option[TreeNode], depth: i64, out: mut ref Map[i64, i64]) {
    if let Some(n) = node {
        out[n.val as i64] = depth;
        depths(n.left, depth + 1, mut out);
        depths(n.right, depth + 1, mut out);
    }
}

fn height(node: Option[TreeNode]) -> i64 {
    match node {
        None => -1,
        Some(n) => 1 + height(n.left).max(height(n.right)),
    }
}

fn main() {
    let arms = ["star", "naive", "euler", "levels", "iter", "solution"];
    let mut seed = 2458;
    let mut cases: Vec[(Option[TreeNode], i64)] = Vec.new();
    for t in 0..360 {
        if t < 300 {
            let n = 2 + next_random(mut seed) % 11;
            cases.push((random_tree(n, mut seed), n));
        } else if t < 330 {
            let n = 2 + next_random(mut seed) % 59;
            cases.push((random_tree(n, mut seed), n));
        } else {
            let n = 2 + next_random(mut seed) % 29;
            cases.push((random_path(n, mut seed), n));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (root, n) = cases[c].clone();
        let top = root.unwrap().val as i64;
        let queries: Vec[i64] = (1..n + 1).filter(|v| v != top).collect();
        let truth = heights_literally(root, queries);
        for v in truth.iter() {
            check = (check * 31 + v + 1) % 1000000007;
        }
        check = (check * 31 + 7) % 1000000007;
        let mirror = mirrored(root);
        let mut depth: Map[i64, i64] = Map.new();
        depths(root, 0, mut depth);
        let whole = height(root);
        let above = Some(TreeNode { val: (n + 1) as i32, left: root, right: None });
        let mut with_top = queries.clone();
        with_top.push(top);
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, root, queries)).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let mut raised: Vec[i64] = value.iter().map(|v| v + 1).collect();
            raised.push(0);
            let verdicts = [
                value == truth,
                answer(arm, mirror, queries) == value,
                (0..value.len()).all(|i| value[i] >= depth[queries[i]] - 1),
                value.len() == queries.len() and value.iter().all(|v| v <= whole),
                answer(arm, above, with_top) == raised,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
