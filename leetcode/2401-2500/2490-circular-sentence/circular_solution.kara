// LeetCode #2490: Circular Sentence -- LeetCode's Rust template: a
// `String` in, `bool` out; the bytes read by `as_bytes()`, every
// `windows(3)` with a space in the middle asked for equal ends, and the
// first byte compared with the last; carried by `karac fix`.

struct Solution {}

impl Solution {
    pub fn is_circular_sentence(sentence: String) -> bool {
        let s = sentence.bytes();
        s[0] == s[s.len() - 1] and s.windows(3).into_iter().all(|w| w[1] != b' ' or w[0] == w[2])
    }
}

fn is_circular_sentence(sentence: Str) -> bool {
    Solution.is_circular_sentence(sentence.to_string())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `words` random words of 1 to `longest` letters from `letters`, each
// word begun by the last letter of the one before it half the time
fn random_sentence(words: i64, longest: i64, letters: Str, seed: mut ref i64) -> String {
    let pool: Vec[char] = letters.chars().collect();
    let mut parts: Vec[String] = Vec.new();
    let mut last = pool[0];
    for w in 0..words {
        let len = next_random(mut seed) % longest + 1;
        let mut word: Vec[char] = Vec.new();
        for i in 0..len {
            if i == 0 and w > 0 and next_random(mut seed) % 2 == 0 {
                word.push(last);
            } else {
                word.push(pool[next_random(mut seed) % pool.len()]);
            }
        }
        last = word[word.len() - 1];
        let text: String = word.into_iter().collect();
        parts.push(text);
    }
    parts.join(" ")
}

fn main() {
    // LeetCode's three examples, then eight more
    let cases = [
        "leetcode exercises sound delightful",
        "eetcode",
        "Leetcode is cool",
        "a",
        "ab",
        "aa a",
        "Aa a",
        "ab ba",
        "ab bc ca",
        "ab bc cb",
        "I Ii iI",
    ];
    for s in cases.iter() {
        println(f"\"{s}\" -> {is_circular_sentence(s)}");
    }
    // 3000 random sentences of 1 to 10 words of 1 to 5 letters from `aAb`,
    // then 3000 from all 52 letters: how many are circular, and a checksum
    let mut seed = 2490;
    for letters in ["aAb", "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"] {
        let mut circular = 0;
        let mut check = 0;
        for t in 0..3000 {
            let words = next_random(mut seed) % 10 + 1;
            let s = random_sentence(words, 5, letters, mut seed);
            if is_circular_sentence(s) {
                circular += 1;
                check = (check * 31 + t + s.len()) % 1000000007;
            }
        }
        println(f"3000 random from {letters.len()} letters: {circular} circular, checksum {check}");
    }
    // the constraints' longest, 500 characters: one word, 250 words of
    // one letter, and the 250 with the last one changed
    let one = "a".repeat(500);
    let many = ["b"; 250].to_vec().join(" ");
    let broken = f"{"b ".repeat(249)}c";
    println(f"one word of 500 -> {is_circular_sentence(one)}");
    println(f"250 words of one letter -> {is_circular_sentence(many)}");
    println(f"the last one changed -> {is_circular_sentence(broken)}");
}
