// LeetCode #2482: Difference Between Ones and Zeros in Row and Column --
// LeetCode's Rust template, as written for LeetCode: `Vec<Vec<i32>>` in
// and out; the ones counted into two `vec![0; _]` lists of `i32`, and
// the answer built by `iter().map(...).collect()` with `as i32` casts
// on the sizes. Carried by `karac fix`.

struct Solution {}

impl Solution {
    pub fn ones_minus_zeros(grid: Vec[Vec[i32]]) -> Vec[Vec[i32]] {
        let (m, n) = (grid.len(), grid[0].len());
        let mut rows = Vec.filled(m, 0i32);
        let mut cols = Vec.filled(n, 0i32);
        for i in 0..m {
            for j in 0..n {
                rows[i] += grid[i][j];
                cols[j] += grid[i][j];
            }
        }
        (0..m)
            .map(|i| {
                (0..n)
                    .map(|j| 2 * rows[i] + 2 * cols[j] - m as i32 - n as i32)
                    .collect()
            })
            .collect()
    }
}

fn ones_minus_zeros(grid: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let asked: Vec[Vec[i32]] = grid.iter().map(|row| row.iter().map(|v| v as i32).collect()).collect();
    Solution.ones_minus_zeros(asked).iter().map(|row| row.iter().map(|v| v as i64).collect()).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// an `m` by `n` grid of random bits
fn random_grid(m: i64, n: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    (0..m).map(|_| (0..n).map(|_| next_random(mut seed) % 2).collect()).collect()
}

fn fold(diff: Vec[Vec[i64]]) -> i64 {
    let mut check = diff.len();
    for row in diff.iter() {
        for v in row.iter() {
            check = (check * 31 + v + 1000000) % 1000000007;
        }
    }
    check
}

fn main() {
    // LeetCode's two examples; then one cell of each bit; a single row; a
    // single column; and a grid of zeros
    let grids: Vec[Vec[Vec[i64]]] = [
        [[0, 1, 1].to_vec(), [1, 0, 1].to_vec(), [0, 0, 1].to_vec()].to_vec(),
        [[1, 1, 1].to_vec(), [1, 1, 1].to_vec()].to_vec(),
        [[0].to_vec()].to_vec(),
        [[1].to_vec()].to_vec(),
        [[1, 0, 1, 1, 0].to_vec()].to_vec(),
        [[1].to_vec(), [0].to_vec(), [0].to_vec(), [1].to_vec()].to_vec(),
        [[0, 0].to_vec(), [0, 0].to_vec()].to_vec(),
    ].to_vec();
    for grid in grids.iter() {
        println(f"{grid} -> {ones_minus_zeros(grid)}");
    }
    // the constraints' largest, 10^5 cells: a row, a column, and a square
    // of 316 by 316 random bits; each as a checksum
    let mut seed = 2482;
    for (m, n) in [(1, 100000), (100000, 1), (316, 316)].iter() {
        let grid = random_grid(m, n, mut seed);
        println(f"{m} by {n} -> checksum {fold(ones_minus_zeros(grid))}");
    }
    // 3000 random grids of 1 to 8 rows and 1 to 8 columns: a checksum of
    // every answer's checksum in order
    let mut check = 0;
    for _ in 0..3000 {
        let m = 1 + next_random(mut seed) % 8;
        let n = 1 + next_random(mut seed) % 8;
        check = (check * 31 + fold(ones_minus_zeros(random_grid(m, n, mut seed)))) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
