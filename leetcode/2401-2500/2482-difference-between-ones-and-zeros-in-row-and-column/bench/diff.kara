// LeetCode #2482: Difference Between Ones and Zeros in Row and Column --
// bench: the ★ arm, by the ones alone, `2 r + 2 c - m - n` from every
// row's and column's ones. O(m n).

fn ones_minus_zeros(grid: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let m = grid.len();
    let n = grid[0].len();
    let mut row_ones: Vec[i64] = Vec.filled(m, 0);
    let mut col_ones: Vec[i64] = Vec.filled(n, 0);
    for i in 0..m {
        for j in 0..n {
            row_ones[i] += grid[i][j];
            col_ones[j] += grid[i][j];
        }
    }
    let mut diff: Vec[Vec[i64]] = Vec.new();
    for i in 0..m {
        let mut row: Vec[i64] = Vec.new();
        for j in 0..n {
            row.push(2 * row_ones[i] + 2 * col_ones[j] - m - n);
        }
        diff.push(row);
    }
    diff
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 random 100 by 100 grids built once; then 180 passes, each
    // flipping one cell of every grid, chosen by the checksum so far,
    // answering it, and folding every value plus the pass into the
    // checksum
    let mut seed = 2482;
    let mut grids: Vec[Vec[Vec[i64]]] = (0..20).map(|_| (0..100).map(|_| (0..100).map(|_| next_random(mut seed) % 2).collect()).collect()).collect();
    let mut check = 0;
    for p in 0..180 {
        for g in 0..20 {
            let (i, j) = (check % 100, check / 100 % 100);
            grids[g][i][j] = 1 - grids[g][i][j];
            let diff = ones_minus_zeros(grids[g]);
            for row in diff.iter() {
                for v in row.iter() {
                    check = (check * 31 + v + 200 + p) % 1000000007;
                }
            }
        }
    }
    println(f"180 passes over 20 grids of 100 by 100: checksum {check}");
}
