// LeetCode #2460: Apply Operations to an Array -- the differential. The
// six arms against the statement read literally: the `n - 1` operations
// on a copy, each place `i` compared with `i + 1` in turn, then the zeros
// shifted to the end one at a time, the first zero that stands before a
// nonzero value removed and pushed onto the end, until none does. 360
// cases: 300 random arrays of 2 to 12 values from 0 to 2; then 30 of up
// to 200 values from 0 to 1000; then 30 of up to 200 values from 0 to 3.
// Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the answer as long as the input, with the same sum
// P3  no zero before a nonzero value, and no more nonzero values than the input has
// P4  a zero put after the input: the answer with a zero after it
// P5  every value doubled: every answer doubled
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn apply_literally(nums: Vec[i64]) -> Vec[i64] {
    let mut a = nums.clone();
    for i in 0..a.len() - 1 {
        if a[i] == a[i + 1] {
            a[i] = a[i] * 2;
            a[i + 1] = 0;
        }
    }
    loop {
        let mut first = -1;
        for i in 0..a.len() - 1 {
            if first < 0 and a[i] == 0 and a[i + 1] != 0 {
                first = i;
            }
        }
        if first < 0 {
            break;
        }
        a.remove(first);
        a.push(0);
    }
    a
}

// ---- star (apply.kara) ---------------------------------------------------

fn star_apply_operations(nums: own Vec[i64]) -> Vec[i64] {
    let mut nums = nums;
    let n = nums.len();
    for i in 0..n - 1 {
        if nums[i] == nums[i + 1] {
            nums[i] *= 2;
            nums[i + 1] = 0;
        }
    }
    let mut k = 0;
    for i in 0..n {
        if nums[i] != 0 {
            nums[k] = nums[i];
            k += 1;
        }
    }
    for i in k..n {
        nums[i] = 0;
    }
    nums
}

// ---- naive (apply_naive.kara) --------------------------------------------

fn naive_apply_operations(nums: own Vec[i64]) -> Vec[i64] {
    let mut nums = nums;
    let n = nums.len();
    for i in 0..n - 1 {
        if nums[i] == nums[i + 1] {
            nums[i] = nums[i] * 2;
            nums[i + 1] = 0;
        }
    }
    let mut moved = true;
    while moved {
        moved = false;
        for i in 0..n - 1 {
            if nums[i] == 0 and nums[i + 1] != 0 {
                nums.swap(i, i + 1);
                moved = true;
            }
        }
    }
    nums
}

// ---- pairs (apply_pairs.kara) --------------------------------------------

fn pairs_apply_operations(nums: Vec[i64]) -> Vec[i64] {
    let n = nums.len();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        if nums[i] == 0 {
            i += 1;
        } else if i + 1 < n and nums[i] == nums[i + 1] {
            out.push(nums[i] * 2);
            i += 2;
        } else {
            out.push(nums[i]);
            i += 1;
        }
    }
    while out.len() < n {
        out.push(0);
    }
    out
}

// ---- swap (apply_swap.kara) ----------------------------------------------

fn swap_apply_operations(nums: own Vec[i64]) -> Vec[i64] {
    let mut nums = nums;
    let n = nums.len();
    let mut free = 0;
    for i in 0..n {
        if i + 1 < n and nums[i] == nums[i + 1] {
            nums[i] *= 2;
            nums[i + 1] = 0;
        }
        if nums[i] != 0 {
            nums.swap(free, i);
            free += 1;
        }
    }
    nums
}

// ---- iter (apply_iter.kara) ----------------------------------------------

fn iter_apply_operations(nums: Vec[i64]) -> Vec[i64] {
    let done: Vec[i64] = nums.iter().skip(1).cloned().chain(once(-1)).scan(nums[0], |carry, next| {
        if carry == next {
            Some((0, carry * 2))
        } else {
            Some((next, carry))
        }
    }).collect();
    done.iter().filter(|v| v != 0).chain(done.iter().filter(|v| v == 0)).collect()
}

// ---- solution (apply_solution.kara) --------------------------------------

impl Solution {
    pub fn apply_operations(nums: own Vec[i32]) -> Vec[i32] {
        let mut nums = nums;
        let n = nums.len();
        for i in 0..n - 1 {
            if nums[i] == nums[i + 1] {
                nums[i] *= 2;
                nums[i + 1] = 0;
            }
        }
        let mut res: Vec[i32] = nums.iter().cloned().filter(|x| x != 0).collect();
        res.resize(n, 0);
        res
    }
}

struct Solution {}

fn solution_apply_operations(nums: Vec[i64]) -> Vec[i64] {
    let asked: Vec[i32] = nums.iter().map(|v| v as i32).collect();
    Solution.apply_operations(asked).iter().map(|v| v as i64).collect()
}

// ---- the differential -------------------------------------------------------

fn answer(arm: i64, nums: Vec[i64]) -> Vec[i64] {
    match arm {
        0 => star_apply_operations(nums.clone()),
        1 => naive_apply_operations(nums.clone()),
        2 => pairs_apply_operations(nums),
        3 => swap_apply_operations(nums.clone()),
        4 => iter_apply_operations(nums),
        _ => solution_apply_operations(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arms = ["star", "naive", "pairs", "swap", "iter", "solution"];
    let mut seed = 2460;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for t in 0..360 {
        let (n, top) = if t < 300 {
            (2 + next_random(mut seed) % 11, 3)
        } else if t < 330 {
            (2 + next_random(mut seed) % 199, 1001)
        } else {
            (2 + next_random(mut seed) % 199, 4)
        };
        cases.push((0..n).map(|_| next_random(mut seed) % top).collect());
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let nums = cases[c].clone();
        let truth = apply_literally(nums);
        for v in truth.iter() {
            check = (check * 31 + v + 1) % 1000000007;
        }
        check = (check * 31 + 7) % 1000000007;
        let total: i64 = nums.iter().sum();
        let nonzero = nums.iter().filter(|v| v != 0).count();
        let mut longer = nums.clone();
        longer.push(0);
        let doubled: Vec[i64] = nums.iter().map(|v| v * 2).collect();
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let sum: i64 = value.iter().sum();
            let kept = value.iter().filter(|v| v != 0).count();
            let packed = (0..value.len()).all(|i| i < kept and value[i] != 0 or i >= kept and value[i] == 0);
            let mut padded = value.clone();
            padded.push(0);
            let twice: Vec[i64] = value.iter().map(|v| v * 2).collect();
            let verdicts = [
                value == truth,
                value.len() == nums.len() and sum == total,
                packed and kept <= nonzero,
                answer(arm, longer) == padded,
                answer(arm, doubled) == twice,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
