// LeetCode #2421: Number of Good Paths -- the bench, the ★ arm: union-find
// over the nodes in order of value, each value's nodes joined to their
// neighbours no larger and then counted by root.

// The root of `x`'s set, halving the path on the way.
fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn number_of_good_paths(vals: Vec[i64], edges: Vec[(i64, i64)]) -> i64 {
    let n = vals.len();
    let mut adj: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for (a, b) in edges.iter() {
        adj[a].push(b);
        adj[b].push(a);
    }
    let mut parent: Vec[i64] = (0..n).collect();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by_key(|i| vals[i]);
    let mut good = n;
    let mut i = 0;
    while i < n {
        let mut j = i;
        while j < n and vals[order[j]] == vals[order[i]] {
            j += 1;
        }
        for t in i..j {
            let u = order[t];
            for v in adj[u].iter() {
                if vals[v] <= vals[u] {
                    let ru = find(mut parent, u);
                    let rv = find(mut parent, v);
                    parent[ru] = rv;
                }
            }
        }
        let mut count: Map[i64, i64] = Map.new();
        for t in i..j {
            let root = find(mut parent, order[t]);
            count[root] = count.get(root).unwrap_or(0) + 1;
        }
        for c in count.values() {
            good += c * (c - 1) / 2;
        }
        i = j;
    }
    good
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10 random trees of 3 * 10^4 nodes, tree i with values 1 to
    // 3 + 1000 i, built once; each pass answers every tree and folds the
    // answer plus the pass
    let mut seed = 2421;
    let mut trees: Vec[(Vec[i64], Vec[(i64, i64)])] = Vec.new();
    for t in 0..10 {
        let n = 30000;
        let mut vals: Vec[i64] = Vec.new();
        for _ in 0..n {
            vals.push(1 + next_random(mut seed) % (3 + 1000 * t));
        }
        let mut edges: Vec[(i64, i64)] = Vec.new();
        for i in 1..n {
            let p = next_random(mut seed) % i;
            edges.push((p, i));
        }
        trees.push((vals, edges));
    }
    let mut check = 0;
    for p in 0..20 {
        for (vals, edges) in trees.iter() {
            check = (check * 31 + number_of_good_paths(vals, edges) + p) % 1000000007;
        }
    }
    println(f"20 passes over 10 trees of 3 * 10^4 nodes: checksum {check}");
}
