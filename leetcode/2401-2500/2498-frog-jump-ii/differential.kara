// LeetCode #2498: Frog Jump II -- the differential. The six arms against
// the statement read literally: every stone between the ends given one
// of three lots, the way out, the way back, or unused, by counting in
// base 3; each lot's path walked from the first stone to the last, and
// the least of the longest jumps taken. 300 random rows of 2 to 8 stones
// with gaps to 3 or to 10^6; then 20 of two stones, and 40 of 9 stones
// with gaps to 10^4; every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  at least the widest gap, and at most the last stone
// P3  every stone doubled: twice the answer
// P4  the row turned round, each stone's distance from the last: the same
// P5  every stone doubled and one put halfway between each two: twice
//     the widest gap
// P6  each arm agrees with at least three of the other five

// ---- star (frog.kara) ----------------------------------------------------

fn star_max_jump(stones: Vec[i64]) -> i64 {
    let mut cost = stones[1] - stones[0];
    for i in 2..stones.len() {
        cost = cost.max(stones[i] - stones[i - 2]);
    }
    cost
}

// ---- search (frog_search.kara) -------------------------------------------

fn search_fits(stones: Vec[i64], cost: i64) -> bool {
    let n = stones.len();
    let mut at = 0;
    let mut next = 2;
    while next < n {
        if stones[next] - stones[at] > cost {
            return false;
        }
        at = next;
        next += 2;
    }
    if stones[n - 1] - stones[at] > cost {
        return false;
    }
    at = 1.min(n - 1);
    if stones[at] - stones[0] > cost {
        return false;
    }
    next = 3;
    while next < n {
        if stones[next] - stones[at] > cost {
            return false;
        }
        at = next;
        next += 2;
    }
    stones[n - 1] - stones[at] <= cost
}

fn search_max_jump(stones: Vec[i64]) -> i64 {
    let mut low = 1;
    let mut high = stones[stones.len() - 1];
    while low < high {
        let middle = low + (high - low) / 2;
        if search_fits(stones, middle) {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    low
}

// ---- paths (frog_paths.kara) ---------------------------------------------

fn paths_longest(path: Vec[i64]) -> i64 {
    let mut most = 0;
    for i in 1..path.len() {
        most = most.max((path[i] - path[i - 1]).abs());
    }
    most
}

fn paths_max_jump(stones: Vec[i64]) -> i64 {
    let n = stones.len();
    let mut out: Vec[i64] = Vec.new();
    let mut back: Vec[i64] = Vec.new();
    for i in 0..n - 1 {
        if i % 2 == 0 {
            out.push(stones[i]);
        }
    }
    out.push(stones[n - 1]);
    back.push(stones[n - 1]);
    for i in (1..n - 1).rev() {
        if i % 2 == 1 {
            back.push(stones[i]);
        }
    }
    back.push(stones[0]);
    paths_longest(out).max(paths_longest(back))
}

// ---- rec (frog_rec.kara) -------------------------------------------------

fn rec_cost_to(stones: Vec[i64], i: i64) -> i64 {
    if i == 1 {
        return stones[1] - stones[0];
    }
    (stones[i] - stones[i - 2]).max(rec_cost_to(stones, i - 1))
}

fn rec_max_jump(stones: Vec[i64]) -> i64 {
    rec_cost_to(stones, stones.len() - 1)
}

// ---- iter (frog_iter.kara) -----------------------------------------------

fn iter_max_jump(stones: Vec[i64]) -> i64 {
    let first = stones[1] - stones[0];
    stones.iter().zip(stones.iter().skip(2)).map(|(a, b)| b - a).fold(first, |most, span| most.max(span))
}

// ---- solution (frog_solution.kara) ---------------------------------------

struct Solution {}

impl Solution {
    pub fn max_jump(stones: Vec[i32]) -> i32 {
        let mut ans = stones[1] - stones[0];
        for w in stones.windows(3) {
            ans = ans.max(w[2] - w[0]);
        }
        ans
    }
}

fn solution_max_jump(stones: Vec[i64]) -> i64 {
    Solution.max_jump(stones.iter().map(|v| v as i32).collect())
}

// ---- the statement read literally

fn literal(stones: Vec[i64]) -> i64 {
    let n = stones.len();
    let mut lots = 1;
    for _ in 0..n - 2 {
        lots *= 3;
    }
    let mut best = -1;
    for code in 0..lots {
        let mut cost = 0;
        for lot in 0..2 {
            let mut at = stones[0];
            let mut rest = code;
            for i in 1..n - 1 {
                if rest % 3 == lot {
                    cost = cost.max(stones[i] - at);
                    at = stones[i];
                }
                rest /= 3;
            }
            cost = cost.max(stones[n - 1] - at);
        }
        if best == -1 or cost < best {
            best = cost;
        }
    }
    best
}

// ---- cases

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn answer(arm: i64, stones: Vec[i64]) -> i64 {
    match arm {
        0 => star_max_jump(stones),
        1 => search_max_jump(stones),
        2 => paths_max_jump(stones),
        3 => rec_max_jump(stones),
        4 => iter_max_jump(stones),
        _ => solution_max_jump(stones),
    }
}

fn main() {
    let names = ["star", "search", "paths", "rec", "iter", "solution"];
    let mut seed = 2498;
    let mut problems: Vec[Vec[i64]] = Vec.new();
    for t in 0..360 {
        let (n, top) = if t < 300 {
            (next_random(mut seed) % 7 + 2, if t % 2 == 0 { 3 } else { 1000000 })
        } else if t < 320 {
            (2, 1000000)
        } else {
            (9, 10000)
        };
        let mut stones: Vec[i64] = [0].to_vec();
        for _ in 1..n {
            let last = stones[stones.len() - 1];
            stones.push(last + wide(mut seed) % top + 1);
        }
        problems.push(stones);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for stones in problems.iter() {
        let n = stones.len();
        let last = stones[n - 1];
        let truth = literal(stones);
        check = (check * 31 + truth) % 1000000007;
        let widest = (1..n).map(|i| stones[i] - stones[i - 1]).max().unwrap();
        let doubled: Vec[i64] = stones.iter().map(|s| 2 * s).collect();
        let turned: Vec[i64] = stones.iter().rev().map(|s| last - s).collect();
        let mut halved: Vec[i64] = [0].to_vec();
        for i in 1..n {
            halved.push(stones[i - 1] + stones[i]);
            halved.push(2 * stones[i]);
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, stones)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                x >= widest and x <= last,
                answer(arm, doubled) == 2 * x,
                answer(arm, turned) == x,
                answer(arm, halved) == 2 * widest,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{n} stones, last {last}, arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
