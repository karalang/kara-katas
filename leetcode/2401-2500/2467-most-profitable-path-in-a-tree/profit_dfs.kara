// LeetCode #2467: Most Profitable Path in a Tree -- one depth-first walk:
// each call returns the best income below its node and the distance from
// its node down to Bob, if Bob is below. That distance is the second Bob
// reaches the node, and the depth is the second Alice does, so the gate
// is settled as the call returns, before its income is added to the best
// below. O(n), recursing as deep as the tree.

fn walk(node: i64, from: i64, depth: i64, bob: i64, adjacent: Vec[Vec[i64]], amount: Vec[i64]) -> (i64, i64) {
    let mut bob_distance = if node == bob { 0 } else { amount.len() };
    let mut best_below = i64.MIN;
    for child in adjacent[node].iter() {
        if child != from {
            let (below, distance) = walk(child, node, depth + 1, bob, adjacent, amount);
            best_below = best_below.max(below);
            bob_distance = bob_distance.min(distance + 1);
        }
    }
    let gate = if depth < bob_distance {
        amount[node]
    } else if depth == bob_distance {
        amount[node] / 2
    } else {
        0
    };
    let income = if best_below == i64.MIN { gate } else { gate + best_below };
    (income, bob_distance)
}

fn most_profitable_path(edges: Vec[Vec[i64]], bob: i64, amount: Vec[i64]) -> i64 {
    let n = amount.len();
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for edge in edges.iter() {
        adjacent[edge[0]].push(edge[1]);
        adjacent[edge[1]].push(edge[0]);
    }
    let (best, _) = walk(0, -1, 0, bob, adjacent, amount);
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// a random tree on `n` nodes: each node past 0 joined to an earlier one
// at most `reach` back, the edges then shuffled and each turned at random
fn random_tree(n: i64, reach: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut edges: Vec[Vec[i64]] = Vec.new();
    for node in 1..n {
        let back = 1 + wide_random(mut seed) % reach.min(node);
        let other = node - back;
        if next_random(mut seed) % 2 == 0 {
            edges.push([node, other].to_vec());
        } else {
            edges.push([other, node].to_vec());
        }
    }
    for i in (1..edges.len()).rev() {
        let j = wide_random(mut seed) % (i + 1);
        edges.swap(i, j);
    }
    edges
}

// even amounts from -10^4 to 10^4
fn random_amounts(n: i64, seed: mut ref i64) -> Vec[i64] {
    (0..n).map(|_| 2 * (next_random(mut seed) % 10001) - 10000).collect()
}

fn main() {
    // LeetCode's two examples; then Bob meeting Alice on a node; Bob a
    // child of the root; a gate shared on an odd half; every gate a cost
    let cases: Vec[(Vec[Vec[i64]], i64, Vec[i64])] = [
        ([[0, 1].to_vec(), [1, 2].to_vec(), [1, 3].to_vec(), [3, 4].to_vec()].to_vec(), 3, [-2, 4, 2, -4, 6].to_vec()),
        ([[0, 1].to_vec()].to_vec(), 1, [-7280, 2350].to_vec()),
        ([[0, 1].to_vec(), [1, 2].to_vec(), [2, 3].to_vec(), [3, 4].to_vec()].to_vec(), 4, [0, 2, 10, 4, 8].to_vec()),
        ([[1, 0].to_vec(), [0, 2].to_vec(), [2, 3].to_vec()].to_vec(), 1, [6, -4, 2, 8].to_vec()),
        ([[0, 1].to_vec(), [1, 2].to_vec(), [0, 3].to_vec()].to_vec(), 2, [2, 6, -2, -10].to_vec()),
        ([[0, 1].to_vec(), [0, 2].to_vec(), [2, 3].to_vec()].to_vec(), 3, [-2, -4, -6, -8].to_vec()),
    ].to_vec();
    for (edges, bob, amount) in cases.into_iter() {
        println(f"bob {bob}, {amount} -> {most_profitable_path(edges, bob, amount)}");
    }
    // the constraints' largest, 10^5 nodes: a path with Bob at its far
    // end; a star with Bob on a leaf; a random tree; then a deep random
    // tree of 10^4, each node joined to one of the three before it, kept
    // small for the naive arm, whose walks are as long as the tree is deep
    let mut seed = 2467;
    let n = 100000;
    let path: Vec[Vec[i64]] = (1..n).map(|v| [v - 1, v].to_vec()).collect();
    println(f"path of 10^5: {most_profitable_path(path, n - 1, random_amounts(n, mut seed))}");
    let star: Vec[Vec[i64]] = (1..n).map(|v| [0, v].to_vec()).collect();
    println(f"star of 10^5: {most_profitable_path(star, n / 2, random_amounts(n, mut seed))}");
    let tree = random_tree(n, n, mut seed);
    println(f"random tree of 10^5: {most_profitable_path(tree, n - 1, random_amounts(n, mut seed))}");
    let deep = random_tree(10000, 3, mut seed);
    println(f"deep random tree of 10^4: {most_profitable_path(deep, 3333, random_amounts(10000, mut seed))}");
    // 3000 random trees of 2 to 40 nodes, Bob anywhere but the root: a
    // checksum of every answer in order
    let mut check = 0;
    for _ in 0..3000 {
        let n = 2 + next_random(mut seed) % 39;
        let edges = random_tree(n, 1 + next_random(mut seed) % n, mut seed);
        let bob = 1 + next_random(mut seed) % (n - 1);
        let amount = random_amounts(n, mut seed);
        check = (check * 31 + most_profitable_path(edges, bob, amount) + 1000000007) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
