// LeetCode #2471: Minimum Number of Operations to Sort a Binary Tree by
// Level -- the differential. The six arms against the statement read
// literally: each level's values read off left to right, and the fewest
// swaps that sort it found by a breadth-first search over the orders one
// swap apart, from the level as it stands to the level sorted. 360 random
// trees: 300 of 1 to 9 nodes, then 60 of up to 12; their values distinct,
// from 1 to 50000. Every case is drawn before any arm answers.
//
// P1  the count is the literal reading's
// P2  every level sorted, then reversed: half of each level's width,
//     rounded down, summed
// P3  the tree mirrored and every value `v` written `100001 - v`: the
//     same count
// P4  two copies under a new root, the second's values raised by 50000:
//     twice the count
// P5  every level sorted, then the first two values of the widest level
//     swapped: 1, or 0 if no level holds two
// P6  each arm agrees with at least three of the other five

// LeetCode's own node: an `i32` value
shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v as i32, left: None, right: None }
}

// ---- the statement read literally ------------------------------------------

fn levels_of(root: Option[TreeNode]) -> Vec[Vec[TreeNode]] {
    let mut levels: Vec[Vec[TreeNode]] = Vec.new();
    let mut level: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        level.push(r);
    }
    while level.len() > 0 {
        let mut next: Vec[TreeNode] = Vec.new();
        for n in level.iter() {
            if let Some(c) = n.left {
                next.push(c);
            }
            if let Some(c) = n.right {
                next.push(c);
            }
        }
        levels.push(level);
        level = next;
    }
    levels
}

// the fewest swaps that sort `values`, by searching the orders
fn fewest_swaps(values: own Vec[i64]) -> i64 {
    let mut goal = values.clone();
    goal.sort();
    let mut seen: Set[String] = Set.new();
    seen.insert(f"{values}");
    let mut frontier: Vec[Vec[i64]] = [values].to_vec();
    let mut steps = 0;
    loop {
        let mut next: Vec[Vec[i64]] = Vec.new();
        for order in frontier.iter() {
            if order == goal {
                return steps;
            }
            for i in 0..order.len() {
                for j in i + 1..order.len() {
                    let mut swapped = order.clone();
                    swapped.swap(i, j);
                    let key = f"{swapped}";
                    if not seen.contains(key) {
                        seen.insert(key);
                        next.push(swapped);
                    }
                }
            }
        }
        frontier = next;
        steps += 1;
    }
}

fn swaps_literally(root: Option[TreeNode]) -> i64 {
    levels_of(root).iter().map(|level| fewest_swaps(level.iter().map(|n| n.val as i64).collect())).sum()
}

// a copy of the tree, every value `v` written `scale * v + shift`, and
// mirrored if `mirror`
fn copy(node: Option[TreeNode], scale: i64, shift: i64, mirror: bool) -> Option[TreeNode] {
    match node {
        None => None,
        Some(n) => {
            let made = leaf(scale * n.val + shift);
            let left = copy(n.left, scale, shift, mirror);
            let right = copy(n.right, scale, shift, mirror);
            if mirror {
                made.left = right;
                made.right = left;
            } else {
                made.left = left;
                made.right = right;
            }
            Some(made)
        },
    }
}

// ---- star (swaps.kara) ---------------------------------------------------

fn star_minimum_operations(root: Option[TreeNode]) -> i64 {
    let mut total = 0;
    let mut level: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        level.push(r);
    }
    while level.len() > 0 {
        let values: Vec[i64] = level.iter().map(|n| n.val as i64).collect();
        let mut sorted = values.clone();
        sorted.sort();
        let mut target: Map[i64, i64] = Map.new();
        for i in 0..sorted.len() {
            target.insert(sorted[i], i);
        }
        let mut seen: Vec[bool] = Vec.filled(values.len(), false);
        for i in 0..values.len() {
            let mut length = 0;
            let mut at = i;
            while not seen[at] {
                seen[at] = true;
                at = target[values[at]];
                length += 1;
            }
            if length > 1 {
                total += length - 1;
            }
        }
        let mut next: Vec[TreeNode] = Vec.new();
        for n in level.iter() {
            if let Some(c) = n.left {
                next.push(c);
            }
            if let Some(c) = n.right {
                next.push(c);
            }
        }
        level = next;
    }
    total
}

// ---- greedy (swaps_greedy.kara) ------------------------------------------

fn greedy_minimum_operations(root: Option[TreeNode]) -> i64 {
    let mut total = 0;
    let mut level: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        level.push(r);
    }
    while level.len() > 0 {
        let mut values: Vec[i64] = level.iter().map(|n| n.val as i64).collect();
        let mut sorted = values.clone();
        sorted.sort();
        let mut place: Map[i64, i64] = Map.new();
        for i in 0..values.len() {
            place.insert(values[i], i);
        }
        for i in 0..values.len() {
            if values[i] != sorted[i] {
                let j = place[sorted[i]];
                place.insert(values[i], j);
                place.insert(sorted[i], i);
                values.swap(i, j);
                total += 1;
            }
        }
        let mut next: Vec[TreeNode] = Vec.new();
        for n in level.iter() {
            if let Some(c) = n.left {
                next.push(c);
            }
            if let Some(c) = n.right {
                next.push(c);
            }
        }
        level = next;
    }
    total
}

// ---- union (swaps_union.kara) --------------------------------------------

fn union_find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut root = x;
    while parent[root] != root {
        root = parent[root];
    }
    let mut at = x;
    while parent[at] != root {
        let next = parent[at];
        parent[at] = root;
        at = next;
    }
    root
}

fn union_minimum_operations(root: Option[TreeNode]) -> i64 {
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    if let Some(r) = root {
        queue.push_back(r);
    }
    let mut total = 0;
    while not queue.is_empty() {
        let width = queue.len();
        let mut values: Vec[i64] = Vec.new();
        for _ in 0..width {
            let node = queue.pop_front().unwrap();
            values.push(node.val);
            if let Some(c) = node.left {
                queue.push_back(c);
            }
            if let Some(c) = node.right {
                queue.push_back(c);
            }
        }
        let mut sorted = values.clone();
        sorted.sort();
        let mut parent: Vec[i64] = (0..width).collect();
        let mut groups = width;
        for i in 0..width {
            let home = sorted.binary_search(values[i]).unwrap();
            let a = union_find(mut parent, i);
            let b = union_find(mut parent, home);
            if a != b {
                parent[a] = b;
                groups -= 1;
            }
        }
        total += width - groups;
    }
    total
}

// ---- ranks (swaps_ranks.kara) --------------------------------------------

fn ranks_gather(node: Option[TreeNode], depth: i64, levels: mut ref Vec[Vec[i64]]) {
    if let Some(n) = node {
        if levels.len() == depth {
            levels.push(Vec.new());
        }
        levels[depth].push(n.val);
        ranks_gather(n.left, depth + 1, mut levels);
        ranks_gather(n.right, depth + 1, mut levels);
    }
}

fn ranks_minimum_operations(root: Option[TreeNode]) -> i64 {
    let mut levels: Vec[Vec[i64]] = Vec.new();
    ranks_gather(root, 0, mut levels);
    let mut total = 0;
    for values in levels.iter() {
        let w = values.len();
        let mut order: Vec[i64] = (0..w).collect();
        order.sort_by_key(|i| values[i]);
        let mut seen: Vec[bool] = Vec.filled(w, false);
        for i in 0..w {
            if seen[i] {
                continue;
            }
            let mut at = i;
            let mut length = 0;
            while not seen[at] {
                seen[at] = true;
                at = order[at];
                length += 1;
            }
            total += length - 1;
        }
    }
    total
}

// ---- iter (swaps_iter.kara) ----------------------------------------------

fn iter_minimum_operations(root: Option[TreeNode]) -> i64 {
    let mut level: Vec[TreeNode] = root.into_iter().collect();
    let mut total = 0;
    while level.len() > 0 {
        let values: Vec[i64] = level.iter().map(|n| n.val as i64).collect();
        let mut order: Vec[i64] = (0..values.len()).collect();
        order.sort_by_key(|i| values[i]);
        let mut seen: Vec[bool] = Vec.filled(values.len(), false);
        let cycles = (0..values.len()).filter(|i| {
            if seen[i] {
                false
            } else {
                let mut at = i;
                while not seen[at] {
                    seen[at] = true;
                    at = order[at];
                }
                true
            }
        }).count();
        total += values.len() - cycles;
        level = level.iter().flat_map(|n| [n.left, n.right].to_vec().into_iter()).filter_map(|c| c).collect();
    }
    total
}

// ---- solution (swaps_solution.kara) --------------------------------------

impl Solution {
    pub fn minimum_operations(root: Option[TreeNode]) -> i32 {
        let mut queue = VecDeque.new();
        if let Some(r) = root {
            queue.push_back(r);
        }
        let mut ans = 0;
        while not queue.is_empty() {
            let size = queue.len();
            let mut vals = Vec.with_capacity(size);
            for _ in 0..size {
                let node = queue.pop_front().unwrap();
                vals.push(node.val);
                if let Some(l) = node.left.clone() {
                    queue.push_back(l);
                }
                if let Some(r) = node.right.clone() {
                    queue.push_back(r);
                }
            }
            let mut sorted = vals.clone();
            sorted.sort();
            let pos: Map[i32, i64] = sorted.iter().enumerate().map(|(i, v)| (v, i)).collect();
            let mut visited = Vec.filled(size, false);
            for i in 0..size {
                if visited[i] or pos[vals[i]] == i {
                    continue;
                }
                let mut j = i;
                let mut len = 0;
                while not visited[j] {
                    visited[j] = true;
                    j = pos[vals[j]];
                    len += 1;
                }
                ans += len - 1;
            }
        }
        ans
    }
}

struct Solution {}

fn solution_minimum_operations(root: Option[TreeNode]) -> i64 {
    Solution.minimum_operations(root)
}

// ---- the differential -------------------------------------------------------

fn answer(arm: i64, root: Option[TreeNode]) -> i64 {
    match arm {
        0 => star_minimum_operations(root),
        1 => greedy_minimum_operations(root),
        2 => union_minimum_operations(root),
        3 => ranks_minimum_operations(root),
        4 => iter_minimum_operations(root),
        _ => solution_minimum_operations(root),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` nodes with distinct values from 1 to 50000, each after the first
// hung below a random earlier one, a random side taken down from it
// until a free one is found
fn random_tree(n: i64, seed: mut ref i64) -> Option[TreeNode] {
    let mut used: Set[i64] = Set.new();
    let mut nodes: Vec[TreeNode] = Vec.new();
    while nodes.len() < n {
        let v = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 50000;
        if not used.contains(v) {
            used.insert(v);
            nodes.push(leaf(v));
        }
    }
    for k in 1..n {
        let mut at = nodes[next_random(mut seed) % k];
        loop {
            if next_random(mut seed) % 2 == 0 {
                match at.left {
                    Some(c) => at = c,
                    None => {
                        at.left = Some(nodes[k]);
                        break;
                    }
                }
            } else {
                match at.right {
                    Some(c) => at = c,
                    None => {
                        at.right = Some(nodes[k]);
                        break;
                    }
                }
            }
        }
    }
    Some(nodes[0])
}

fn main() {
    let arms = ["star", "greedy", "union", "ranks", "iter", "solution"];
    let mut seed = 2471;
    let mut cases: Vec[Option[TreeNode]] = Vec.new();
    for t in 0..360 {
        let n = if t < 300 { 1 + next_random(mut seed) % 9 } else { 1 + next_random(mut seed) % 12 };
        cases.push(random_tree(n, mut seed));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let root = cases[c];
        let truth = swaps_literally(root);
        check = (check * 31 + truth) % 1000000007;
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, copy(root, 1, 0, false))).collect();
        // every level sorted in a copy, then the widest level's first two
        // values swapped
        let tidy = copy(root, 1, 0, false);
        let levels = levels_of(tidy);
        let mut widest = 0;
        for d in 0..levels.len() {
            let mut values: Vec[i32] = levels[d].iter().map(|n| n.val).collect();
            values.sort();
            for i in 0..values.len() {
                levels[d][i].val = values[i];
            }
            if levels[d].len() > levels[widest].len() {
                widest = d;
            }
        }
        let one = if levels[widest].len() >= 2 { 1 } else { 0 };
        if one == 1 {
            let first = levels[widest][0].val;
            levels[widest][0].val = levels[widest][1].val;
            levels[widest][1].val = first;
        }
        // every level sorted in another copy, then reversed: half its
        // width, rounded down, a level
        let backward = copy(root, 1, 0, false);
        let mut halves = 0;
        for level in levels_of(backward).iter() {
            let mut values: Vec[i32] = level.iter().map(|n| n.val).collect();
            values.sort();
            values.reverse();
            for i in 0..values.len() {
                level[i].val = values[i];
            }
            halves += level.len() / 2;
        }
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let joined = leaf(100000);
            joined.left = copy(root, 1, 0, false);
            joined.right = copy(root, 1, 50000, false);
            let verdicts = [
                value == truth,
                answer(arm, copy(backward, 1, 0, false)) == halves,
                answer(arm, copy(root, -1, 100001, true)) == value,
                answer(arm, Some(joined)) == 2 * value,
                answer(arm, copy(tidy, 1, 0, false)) == one,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
