// LeetCode #2471: Minimum Number of Operations to Sort a Binary Tree by
// Level -- the bench, the ★ arm: the levels by a breadth-first walk, and
// in each the cycles of the permutation that sorts it, a `Map` from each
// value to its sorted place.

fn minimum_operations(root: Option[TreeNode]) -> i64 {
    let mut total = 0;
    let mut level: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        level.push(r);
    }
    while level.len() > 0 {
        let values: Vec[i64] = level.iter().map(|n| n.val as i64).collect();
        let mut sorted = values.clone();
        sorted.sort();
        let mut target: Map[i64, i64] = Map.new();
        for i in 0..sorted.len() {
            target.insert(sorted[i], i);
        }
        let mut seen: Vec[bool] = Vec.filled(values.len(), false);
        for i in 0..values.len() {
            let mut length = 0;
            let mut at = i;
            while not seen[at] {
                seen[at] = true;
                at = target[values[at]];
                length += 1;
            }
            if length > 1 {
                total += length - 1;
            }
        }
        let mut next: Vec[TreeNode] = Vec.new();
        for n in level.iter() {
            if let Some(c) = n.left {
                next.push(c);
            }
            if let Some(c) = n.right {
                next.push(c);
            }
        }
        level = next;
    }
    total
}

// ---- bench ------------------------------------------------------------------

// LeetCode's own node: an `i32` value
shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i64) -> TreeNode {
    TreeNode { val: v as i32, left: None, right: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the nodes of a random tree, the root first: the values 1 to `n` in a
// random order, each node after the first hung below a random earlier
// one, a random side taken down from it until a free one is found
fn random_tree(n: i64, seed: mut ref i64) -> Vec[TreeNode] {
    let mut values: Vec[i64] = (1..n + 1).collect();
    for i in (1..n).rev() {
        let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
        values.swap(i, j);
    }
    let nodes: Vec[TreeNode] = values.iter().map(|v| leaf(v)).collect();
    for k in 1..n {
        let mut at = nodes[(next_random(mut seed) * 32768 + next_random(mut seed)) % k];
        loop {
            if next_random(mut seed) % 2 == 0 {
                match at.left {
                    Some(c) => at = c,
                    None => {
                        at.left = Some(nodes[k]);
                        break;
                    }
                }
            } else {
                match at.right {
                    Some(c) => at = c,
                    None => {
                        at.right = Some(nodes[k]);
                        break;
                    }
                }
            }
        }
    }
    nodes
}

fn main() {
    // 20 random trees of 10^4 nodes built once; then 110 passes, each
    // answering every tree, folding the count plus the pass into the
    // checksum, then swapping two of its values chosen by the checksum
    let n = 10000;
    let mut seed = 2471;
    let trees: Vec[Vec[TreeNode]] = (0..20).map(|_| random_tree(n, mut seed)).collect();
    let mut check = 0;
    for p in 0..110 {
        for nodes in trees.iter() {
            check = (check * 31 + minimum_operations(Some(nodes[0])) + p) % 1000000007;
            let a = nodes[check % n];
            let b = nodes[(check / n + p) % n];
            let first = a.val;
            a.val = b.val;
            b.val = first;
        }
    }
    println(f"110 passes over 20 trees of 10^4: checksum {check}");
}
