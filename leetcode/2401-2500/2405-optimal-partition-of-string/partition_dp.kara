// LeetCode #2405: Optimal Partition of String -- dynamic programming.
// The fewest parts of each prefix: the best over every last part ending
// there whose letters are distinct, found by walking back from the end
// until a letter repeats, at most 26 steps. No greedy argument needed.
// O(26 n).

fn partition_string(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut fewest: Vec[i64] = Vec.filled(n + 1, n + 1);
    fewest[0] = 0;
    for i in 1..n + 1 {
        let mut seen = 0;
        let mut j = i;
        while j > 0 {
            let bit = 1 << (b[j - 1] - b'a') as i64;
            if seen & bit != 0 {
                break;
            }
            seen |= bit;
            j -= 1;
            fewest[i] = fewest[i].min(fewest[j] + 1);
        }
    }
    fewest[n]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn letters(seed: mut ref i64, n: i64, kinds: i64) -> String {
    let bytes: Vec[u8] = (0..n).map(|_| b'a' + (next_random(mut seed) % kinds) as u8).collect();
    String.from_utf8(bytes).unwrap()
}

fn main() {
    // LeetCode's two examples; one letter; the alphabet once and twice
    println(f"{partition_string("abacaba")}");
    println(f"{partition_string("ssssss")}");
    println(f"{partition_string("a")}");
    println(f"{partition_string("abcdefghijklmnopqrstuvwxyz")} {partition_string("abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz")}");
    // 10^5 letters of all 26, and 10^5 of 3
    let mut seed = 2405;
    println(f"{partition_string(letters(mut seed, 100000, 26))}");
    println(f"{partition_string(letters(mut seed, 100000, 3))}");
    // 3000 random strings of 1 to 30 letters from the first 1 to 26; a
    // checksum of the answers and their total
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 30;
        let kinds = 1 + next_random(mut seed) % 26;
        let a = partition_string(letters(mut seed, n, kinds));
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"3000 random: checksum {check}, total {total}");
}
