// LeetCode #2405: Optimal Partition of String -- the differential. The
// six arms against the statement read literally: every way to cut the
// string, each part's letters compared pair by pair, and the fewest parts
// of any cutting whose parts all have distinct letters. No greedy and no
// masks. 360 cases: 300 random strings of 1 to 12 letters from the first
// 1 to 6, which the literal reading answers; 30 of up to 3000 letters of
// all 26; and 30 of up to 3000 letters of the first 2 to 4. Every case is
// drawn before any arm answers.
//
// P1  up to 12 letters: the answer is the literal reading's
// P2  at least n / 26 rounded up, at least the most times any letter
//     appears, and at most n
// P3  the string reversed: the same answer
// P4  every letter renamed one along the alphabet: the same answer
// P5  the string written twice: twice the answer, or one less
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn distinct(b: Slice[u8], from: i64, to: i64) -> bool {
    for p in from..to {
        for q in p + 1..to {
            if b[p] == b[q] {
                return false;
            }
        }
    }
    true
}

fn fewest_from(b: Slice[u8], from: i64) -> i64 {
    if from == b.len() {
        return 0;
    }
    let mut best = b.len() + 1;
    for to in from + 1..b.len() + 1 {
        if distinct(b, from, to) {
            best = best.min(1 + fewest_from(b, to));
        }
    }
    best
}

fn partition_literally(s: String) -> i64 {
    fewest_from(s.bytes(), 0)
}

// ---- star (partition.kara) -----------------------------------------------

fn star_partition_string(s: String) -> i64 {
    let mut parts = 1;
    let mut seen = 0;
    for b in s.bytes().iter() {
        let bit = 1 << b - b'a';
        if seen & bit != 0 {
            parts += 1;
            seen = 0;
        }
        seen |= bit;
    }
    parts
}

// ---- last (partition_last.kara) ------------------------------------------

fn last_partition_string(s: String) -> i64 {
    let mut last: Vec[i64] = Vec.filled(26, -1);
    let mut start = 0;
    let mut parts = 1;
    let b = s.bytes();
    for i in 0..b.len() {
        let c = (b[i] - b'a') as i64;
        if last[c] >= start {
            parts += 1;
            start = i;
        }
        last[c] = i;
    }
    parts
}

// ---- set (partition_set.kara) --------------------------------------------

fn set_partition_string(s: String) -> i64 {
    let mut seen: Set[char] = Set.new();
    let mut parts = 1;
    for c in s.chars() {
        if seen.contains(c) {
            parts += 1;
            seen.clear();
        }
        seen.insert(c);
    }
    parts
}

// ---- dp (partition_dp.kara) ----------------------------------------------

fn dp_partition_string(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut fewest: Vec[i64] = Vec.filled(n + 1, n + 1);
    fewest[0] = 0;
    for i in 1..n + 1 {
        let mut seen = 0;
        let mut j = i;
        while j > 0 {
            let bit = 1 << (b[j - 1] - b'a') as i64;
            if seen & bit != 0 {
                break;
            }
            seen |= bit;
            j -= 1;
            fewest[i] = fewest[i].min(fewest[j] + 1);
        }
    }
    fewest[n]
}

// ---- iter (partition_iter.kara) ------------------------------------------

fn iter_partition_string(s: String) -> i64 {
    let (_, parts) = s.bytes().iter().fold((0, 1), |(seen, parts), b| {
        let bit = 1 << (b - b'a') as i64;
        if seen & bit != 0 {
            (bit, parts + 1)
        } else {
            (seen | bit, parts)
        }
    });
    parts
}

// ---- solution (partition_solution.kara) ----------------------------------

struct Solution {}

impl Solution {
    pub fn partition_string(s: String) -> i32 {
        let mut ans = 1;
        let mut seen = [false; 26];
        for c in s.chars() {
            let i = (c as u32 as u8 - b'a') as usize;
            if seen[i] {
                ans += 1;
                seen = [false; 26];
            }
            seen[i] = true;
        }
        ans
    }
}

fn solution_partition_string(s: String) -> i64 {
    Solution.partition_string(s)
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, s: String) -> i64 {
    match arm {
        0 => star_partition_string(s),
        1 => last_partition_string(s),
        2 => set_partition_string(s),
        3 => dp_partition_string(s),
        4 => iter_partition_string(s),
        _ => solution_partition_string(s),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "last", "set", "dp", "iter", "solution"];
    let mut seed = 2405;
    let mut cases: Vec[String] = Vec.new();
    for t in 0..360 {
        let (n, kinds) = if t < 300 {
            (1 + next_random(mut seed) % 12, 1 + next_random(mut seed) % 6)
        } else if t < 330 {
            (1 + next_random(mut seed) % 3000, 26)
        } else {
            (1 + next_random(mut seed) % 3000, 2 + next_random(mut seed) % 3)
        };
        let bytes: Vec[u8] = (0..n).map(|_| b'a' + (next_random(mut seed) % kinds) as u8).collect();
        cases.push(String.from_utf8(bytes).unwrap());
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let s = cases[c].clone();
        let b = s.bytes();
        let n = b.len();
        let truth = if n <= 12 {
            partition_literally(s)
        } else {
            -1
        };
        if truth >= 0 {
            check = (check * 31 + truth) % 1000000007;
        }
        let mut times: Vec[i64] = Vec.filled(26, 0);
        for x in b.iter() {
            times[x - b'a'] += 1;
        }
        let most = times.iter().max().unwrap();
        let mut backwards = b.to_vec();
        backwards.reverse();
        let reversed = String.from_utf8(backwards).unwrap();
        let renamed = String.from_utf8(b.iter().map(|x| b'a' + (x - b'a' + 1) % 26).collect()).unwrap();
        let twice = f"{s}{s}";
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, s)).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let doubled = answer(arm, twice);
            let verdicts = [truth < 0 or value == truth, value >= (n + 25) / 26 and value >= most and value <= n, answer(arm, reversed) == value, answer(arm, renamed) == value, doubled == 2 * value or doubled == 2 * value - 1, same >= 3];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
