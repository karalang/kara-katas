// LeetCode #2446: Determine if Two Events Have Conflict -- the statement
// read directly: every minute of the day written as `HH:MM`, marked when
// it lies within the first event, and the events conflict when some
// marked minute lies within the second too. O(1440).

fn have_conflict(event1: Vec[String], event2: Vec[String]) -> bool {
    let mut busy: Vec[bool] = Vec.filled(1440, false);
    for m in 0..1440 {
        let time = f"{m / 60:02}:{m % 60:02}";
        if event1[0] <= time and time <= event1[1] {
            busy[m] = true;
        }
    }
    for m in 0..1440 {
        let time = f"{m / 60:02}:{m % 60:02}";
        if busy[m] and event2[0] <= time and time <= event2[1] {
            return true;
        }
    }
    false
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn clock(minute: i64) -> String {
    f"{minute / 60:02}:{minute % 60:02}"
}

// an event of two random times from 00:00 to 23:59, the earlier first
fn random_event(seed: mut ref i64) -> Vec[String] {
    let a = next_random(mut seed) % 1440;
    let b = next_random(mut seed) % 1440;
    [clock(a.min(b)), clock(a.max(b))].to_vec()
}

fn main() {
    // LeetCode's three examples; the same event twice; touching at the
    // end; the whole day; one minute each, apart and together
    let cases: Vec[(Vec[String], Vec[String])] = [
        (["01:15", "02:00"].to_vec(), ["02:00", "03:00"].to_vec()),
        (["01:00", "02:00"].to_vec(), ["01:20", "03:00"].to_vec()),
        (["10:00", "11:00"].to_vec(), ["14:00", "15:00"].to_vec()),
        (["09:30", "10:30"].to_vec(), ["09:30", "10:30"].to_vec()),
        (["14:00", "15:00"].to_vec(), ["10:00", "14:00"].to_vec()),
        (["00:00", "23:59"].to_vec(), ["12:00", "12:01"].to_vec()),
        (["05:05", "05:05"].to_vec(), ["05:06", "05:06"].to_vec()),
        (["05:05", "05:05"].to_vec(), ["05:05", "05:05"].to_vec()),
    ].to_vec();
    for (a, b) in cases.into_iter() {
        println(f"{a} {b}: {have_conflict(a, b)}");
    }
    // 3000 random pairs of events: how many conflict, and a checksum of
    // the places that do
    let mut seed = 2446;
    let mut count = 0;
    let mut check = 0;
    for i in 0..3000 {
        let a = random_event(mut seed);
        let b = random_event(mut seed);
        if have_conflict(a, b) {
            count += 1;
            check = (check * 31 + i) % 1000000007;
        }
    }
    println(f"3000 random: {count} conflict, checksum {check}");
    // 3000 random pairs of short events, at most 30 minutes each
    count = 0;
    check = 0;
    for i in 0..3000 {
        let s = next_random(mut seed) % 1410;
        let t = next_random(mut seed) % 1410;
        let a = [clock(s), clock(s + next_random(mut seed) % 30)].to_vec();
        let b = [clock(t), clock(t + next_random(mut seed) % 30)].to_vec();
        if have_conflict(a, b) {
            count += 1;
            check = (check * 31 + i) % 1000000007;
        }
    }
    println(f"3000 short: {count} conflict, checksum {check}");
}
