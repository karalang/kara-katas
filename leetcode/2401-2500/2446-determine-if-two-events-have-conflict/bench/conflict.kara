// LeetCode #2446: Determine if Two Events Have Conflict -- the bench, the
// ★ arm: the four `HH:MM` strings compared as text.

fn have_conflict(event1: Vec[String], event2: Vec[String]) -> bool {
    event1[0] <= event2[1] and event2[0] <= event1[1]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn clock(minute: i64) -> String {
    f"{minute / 60:02}:{minute % 60:02}"
}

fn main() {
    let mut seed = 2446;
    // 10^5 events of two random times, the earlier first
    let n = 100000;
    let mut events: Vec[Vec[String]] = Vec.new();
    for _ in 0..n {
        let a = next_random(mut seed) % 1440;
        let b = next_random(mut seed) % 1440;
        events.push([clock(a.min(b)), clock(a.max(b))].to_vec());
    }
    // pass `p` pairs event `i` with event `(7 i + p + 1) mod n`, folding
    // each answer plus the pass into the checksum
    let mut check = 0;
    for p in 0..300 {
        for i in 0..n {
            let j = (7 * i + p + 1) % n;
            let answer = if have_conflict(events[i], events[j]) { 1 } else { 0 };
            check = (check * 31 + answer + p) % 1000000007;
        }
    }
    println(f"300 passes over 10^5 events: checksum {check}");
}
