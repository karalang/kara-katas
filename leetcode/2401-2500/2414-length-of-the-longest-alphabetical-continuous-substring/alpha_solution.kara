// LeetCode #2414: Length of the Longest Alphabetical Continuous Substring
// -- LeetCode's Rust template, as Rust writes it, carried by karac fix:
// the string shadowed by its `as_bytes()`, and the run and the best kept
// in a `(mut ans, mut cnt)` pair.

impl Solution {
    pub fn longest_continuous_substring(s: String) -> i32 {
        let s = s.bytes();
        let mut (ans, cnt) = (1i32, 1i32);
        for i in 1..s.len() {
            if s[i] == s[i - 1] + 1 {
                cnt += 1;
                ans = ans.max(cnt);
            } else {
                cnt = 1;
            }
        }
        ans
    }
}

struct Solution {}

fn longest_continuous_substring(s: String) -> i64 {
    Solution.longest_continuous_substring(s)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters, each the one after the last with probability 1 / `step`,
// otherwise one of the first `kinds` at random.
fn letters(seed: mut ref i64, n: i64, kinds: i64, step: i64) -> String {
    let mut bytes: Vec[u8] = Vec.new();
    for i in 0..n {
        if i > 0 and bytes[i - 1] < b'z' and next_random(mut seed) % step == 0 {
            bytes.push(bytes[i - 1] + 1);
        } else {
            bytes.push(b'a' + (next_random(mut seed) % kinds) as u8);
        }
    }
    String.from_utf8(bytes).unwrap()
}

fn main() {
    // LeetCode's two examples; one letter; the whole alphabet, and it
    // backwards; the alphabet twice
    println(f"{longest_continuous_substring("abacaba")}");
    println(f"{longest_continuous_substring("abcde")}");
    println(f"{longest_continuous_substring("z")}");
    println(f"{longest_continuous_substring("abcdefghijklmnopqrstuvwxyz")} {longest_continuous_substring("zyxwvutsrqponmlkjihgfedcba")}");
    println(f"{longest_continuous_substring("xyzabcdefghijklmnopqrstuvwxyzab")}");
    // 10^5 letters of all 26 rising often, and 10^5 random ones
    let mut seed = 2414;
    println(f"{longest_continuous_substring(letters(mut seed, 100000, 26, 2))}");
    println(f"{longest_continuous_substring(letters(mut seed, 100000, 26, 100))}");
    // 3000 random strings of up to 30 letters from the first 2 to 26; a
    // checksum of the answers and their total
    let mut check = 0;
    let mut total = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 30;
        let kinds = 2 + next_random(mut seed) % 25;
        let a = longest_continuous_substring(letters(mut seed, n, kinds, 1 + next_random(mut seed) % 4));
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"3000 random: checksum {check}, total {total}");
}
