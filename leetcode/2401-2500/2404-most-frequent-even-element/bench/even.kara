// LeetCode #2404: Most Frequent Even Element -- the bench, the ★ arm: a
// `Map` of counts of the even values, then every entry read for the most
// frequent and the smallest among equal counts.

fn most_frequent_even(nums: Vec[i64]) -> i64 {
    let mut count: Map[i64, i64] = Map.new();
    for x in nums.iter() {
        if x % 2 == 0 {
            count[x] = count.get(x).unwrap_or(0) + 1;
        }
    }
    let mut best = -1;
    let mut most = 0;
    for (x, c) in count.iter() {
        if c > most or c == most and x < best {
            best = x;
            most = c;
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 200 arrays of 2000 values, array i below 1 + 50 i; each pass answers
    // them all and folds every answer, plus the pass
    let mut seed = 2404;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for i in 0..200 {
        let nums: Vec[i64] = (0..2000).map(|_| next_random(mut seed) % (1 + 50 * i)).collect();
        arrays.push(nums);
    }
    let mut check = 0;
    for p in 0..100 {
        for nums in arrays.iter() {
            check = (check * 31 + most_frequent_even(nums) + 1 + p) % 1000000007;
        }
    }
    println(f"100 passes over 200 arrays of 2000 values: checksum {check}");
}
