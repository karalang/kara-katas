// LeetCode #2483: Minimum Penalty for a Shop -- LeetCode's Rust
// template, as written for LeetCode: `String` in, `i32` out; the
// penalty at 0 counted by `bytes().filter(...).count()`, then a walk
// over `bytes().enumerate()` with a `match` on the byte, the answer an
// `i32`. Carried by `karac fix`.

struct Solution {}

impl Solution {
    pub fn best_closing_time(customers: String) -> i32 {
        let mut penalty = customers.bytes().iter().filter(|b| b == b'Y').count() as i32;
        let mut best = penalty;
        let mut ans = 0;
        for (i, b) in customers.bytes().iter().enumerate() {
            match b {
                b'Y' => penalty -= 1,
                _ => penalty += 1,
            }
            if penalty < best {
                best = penalty;
                ans = i as i32 + 1;
            }
        }
        ans
    }
}

fn best_closing_time(customers: Str) -> i64 {
    Solution.best_closing_time(customers.to_string())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` random hours, each a customer with odds `yes` in 100
fn random_log(n: i64, yes: i64, seed: mut ref i64) -> String {
    let mut text = "".to_string();
    for _ in 0..n {
        if next_random(mut seed) % 100 < yes {
            text.push_str("Y");
        } else {
            text.push_str("N");
        }
    }
    text
}

fn main() {
    // LeetCode's three examples; then one hour of each kind; two hours
    // either way round, the second a tie between opening never and
    // closing last; and a tie between two inner hours
    for log in ["YYNY", "NNNNN", "YYYY", "Y", "N", "YN", "NY", "YNYN"].iter() {
        println(f"{log} -> {best_closing_time(log)}");
    }
    // the constraints' largest, 10^5 hours: all customers, none, taking
    // turns, and random with odds of a half and of six in ten
    let mut seed = 2483;
    println(f"10^5 Y -> {best_closing_time("Y".repeat(100000))}");
    println(f"10^5 N -> {best_closing_time("N".repeat(100000))}");
    println(f"\"YN\" x 50000 -> {best_closing_time("YN".repeat(50000))}");
    for yes in [50, 60].iter() {
        let log = random_log(100000, yes, mut seed);
        println(f"10^5 random at {yes} in 100 -> {best_closing_time(log)}");
    }
    // 3000 random logs of 1 to 40 hours with odds from 0 to 100 in 100:
    // a checksum of every answer in order
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 40;
        let yes = next_random(mut seed) % 101;
        check = (check * 31 + best_closing_time(random_log(n, yes, mut seed))) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
