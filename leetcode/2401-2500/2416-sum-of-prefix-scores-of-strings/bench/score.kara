// LeetCode #2416: Sum of Prefix Scores of Strings -- the bench, the ★ arm:
// a trie in flat arrays, node k's child by letter c at `next[26 k + c]`
// and `count[k]` the words through it.

fn sum_prefix_scores(words: Vec[String]) -> Vec[i64] {
    let mut next: Vec[i64] = Vec.filled(26, 0);
    let mut count: Vec[i64] = Vec.filled(1, 0);
    for w in words.iter() {
        let mut at = 0;
        for b in w.bytes().iter() {
            let c = (b - b'a') as i64;
            if next[26 * at + c] == 0 {
                next[26 * at + c] = count.len();
                count.push(0);
                for _ in 0..26 {
                    next.push(0);
                }
            }
            at = next[26 * at + c];
            count[at] += 1;
        }
    }
    let mut scores: Vec[i64] = Vec.new();
    for w in words.iter() {
        let mut at = 0;
        let mut score = 0;
        for b in w.bytes().iter() {
            at = next[26 * at + (b - b'a')];
            score += count[at];
        }
        scores.push(score);
    }
    scores
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10 lists of 2000 words of 1 to 50 letters, list i from the first
    // 2 + 2 i letters; each pass scores every list and folds every score
    // plus the pass
    let mut seed = 2416;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for i in 0..10 {
        let mut words: Vec[String] = Vec.new();
        for _ in 0..2000 {
            let len = 1 + next_random(mut seed) % 50;
            let mut bytes: Vec[u8] = Vec.new();
            for _ in 0..len {
                bytes.push(b'a' + (next_random(mut seed) % (2 + 2 * i)) as u8);
            }
            words.push(String.from_utf8(bytes).unwrap());
        }
        lists.push(words);
    }
    let mut check = 0;
    for p in 0..20 {
        for words in lists.iter() {
            for s in sum_prefix_scores(words).iter() {
                check = (check * 31 + s + p) % 1000000007;
            }
        }
    }
    println(f"20 passes over 10 lists of 2000 words: checksum {check}");
}
