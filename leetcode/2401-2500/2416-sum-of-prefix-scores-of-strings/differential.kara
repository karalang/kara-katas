// LeetCode #2416: Sum of Prefix Scores of Strings -- the differential.
// The six arms against the statement read literally: for each word, each
// of its non-empty prefixes, and every word checked for starting with it.
// No trie, no hashing, no sort. 360 cases: 300 random lists of 1 to 8
// words of 1 to 5 letters from the first 1 to 3; 30 of up to 60 words of
// up to 20 letters from the first 2; and 30 of up to 60 words of up to 20
// letters from all 26. Every case is drawn before any arm answers.
//
// P1  the answers are the literal reading's
// P2  each answer at least its word's length and at most the number of
//     words times it
// P3  the words in reverse order: the answers reversed
// P4  every letter renamed to the next, z to a: the same answers
// P5  the list given twice: every answer doubled, for both copies
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn scores_literally(words: Slice[String]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for w in words.iter() {
        let mut total = 0;
        for k in 1..w.len() + 1 {
            let prefix = w[0..k].to_string();
            for other in words.iter() {
                if other.starts_with(prefix) {
                    total += 1;
                }
            }
        }
        out.push(total);
    }
    out
}

// ---- star (score.kara) ---------------------------------------------------

fn star_sum_prefix_scores(words: Vec[String]) -> Vec[i64] {
    let mut next: Vec[i64] = Vec.filled(26, 0);
    let mut count: Vec[i64] = Vec.filled(1, 0);
    for w in words.iter() {
        let mut at = 0;
        for b in w.bytes().iter() {
            let c = (b - b'a') as i64;
            if next[26 * at + c] == 0 {
                next[26 * at + c] = count.len();
                count.push(0);
                for _ in 0..26 {
                    next.push(0);
                }
            }
            at = next[26 * at + c];
            count[at] += 1;
        }
    }
    let mut scores: Vec[i64] = Vec.new();
    for w in words.iter() {
        let mut at = 0;
        let mut score = 0;
        for b in w.bytes().iter() {
            at = next[26 * at + (b - b'a')];
            score += count[at];
        }
        scores.push(score);
    }
    scores
}

// ---- hash (score_hash.kara) ----------------------------------------------

fn hash_sum_prefix_scores(words: Vec[String]) -> Vec[i64] {
    let mut count: Map[(i64, i64), i64] = Map.new();
    for w in words.iter() {
        let mut h1 = 0;
        let mut h2 = 0;
        for b in w.bytes().iter() {
            h1 = (h1 * 131 + b) % 1000000007;
            h2 = (h2 * 137 + b) % 998244353;
            count[(h1, h2)] = count.get((h1, h2)).unwrap_or(0) + 1;
        }
    }
    let mut scores: Vec[i64] = Vec.new();
    for w in words.iter() {
        let mut h1 = 0;
        let mut h2 = 0;
        let mut score = 0;
        for b in w.bytes().iter() {
            h1 = (h1 * 131 + b) % 1000000007;
            h2 = (h2 * 137 + b) % 998244353;
            score += count[(h1, h2)];
        }
        scores.push(score);
    }
    scores
}

// ---- sort (score_sort.kara) ----------------------------------------------

fn sort_common(a: String, b: String) -> i64 {
    let x = a.bytes();
    let y = b.bytes();
    let mut k = 0;
    while k < x.len() and k < y.len() and x[k] == y[k] {
        k += 1;
    }
    k
}

fn sort_sum_prefix_scores(words: Vec[String]) -> Vec[i64] {
    let n = words.len();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by(|a, b| words[a].cmp(words[b]));
    let mut shared: Vec[i64] = Vec.filled(n, 0);
    for k in 1..n {
        shared[k] = sort_common(words[order[k - 1]], words[order[k]]);
    }
    let mut scores: Vec[i64] = Vec.filled(n, 0);
    for k in 0..n {
        let mut score = words[order[k]].len();
        let mut low = score;
        for j in k + 1..n {
            low = low.min(shared[j]);
            score += low;
        }
        low = words[order[k]].len();
        let mut j = k;
        while j > 0 {
            low = low.min(shared[j]);
            score += low;
            j -= 1;
        }
        scores[order[k]] = score;
    }
    scores
}

// ---- trie (score_trie.kara) ----------------------------------------------

struct ArmNode {
    next: Array[i64, 26],
    count: i64,
}

struct ArmTrie {
    nodes: Vec[ArmNode],
}

impl ArmTrie {
    fn new() -> ArmTrie {
        let mut nodes: Vec[ArmNode] = Vec.new();
        nodes.push(ArmNode {
            next: [0; 26],
            count: 0,
        });
        ArmTrie {
            nodes: nodes,
        }
    }

    fn insert(mut ref self, word: String) {
        let mut at = 0;
        for b in word.bytes().iter() {
            let c = b - b'a';
            if self.nodes[at].next[c] == 0 {
                self.nodes[at].next[c] = self.nodes.len();
                self.nodes.push(ArmNode {
                    next: [0; 26],
                    count: 0,
                });
            }
            at = self.nodes[at].next[c];
            self.nodes[at].count += 1;
        }
    }

    fn score(self, word: String) -> i64 {
        let mut at = 0;
        let mut total = 0;
        for b in word.bytes().iter() {
            at = self.nodes[at].next[b - b'a'];
            total += self.nodes[at].count;
        }
        total
    }
}

fn trie_sum_prefix_scores(words: Vec[String]) -> Vec[i64] {
    let mut trie = ArmTrie.new();
    for w in words.iter() {
        trie.insert(w);
    }
    words.iter().map(|w| trie.score(w)).collect()
}

// ---- iter (score_iter.kara) ----------------------------------------------

fn iter_sum_prefix_scores(words: Vec[String]) -> Vec[i64] {
    words.iter().map(|w| {
        words.iter().map(|o| w.bytes().iter().zip(o.bytes().iter()).take_while(|(a, b)| a == b).count()).sum()
    }).collect()
}

// ---- solution (score_solution.kara) --------------------------------------

#[derive(Default)]
struct Trie {
    children: Array[Option[Trie], 26],
    cnt: i32,
}

impl Solution {
    pub fn sum_prefix_scores(words: Vec[String]) -> Vec[i32] {
        let mut root = Trie.default();
        for w in ref words {
            let mut node = mut ref root;
            for c in w.bytes() {
                let i = (c - b'a') as usize;
                node = node.children[i].get_or_insert_with(|| Trie.default());
                node.cnt += 1;
            }
        }
        words.iter().map(|w| {
            let mut node = ref root;
            let mut s: i32 = 0;
            for c in w.bytes() {
                node = node.children[(c - b'a') as usize].as_ref().unwrap();
                s += node.cnt;
            }
            s
        }).collect()
    }
}

struct Solution {}

fn solution_sum_prefix_scores(words: Vec[String]) -> Vec[i64] {
    Solution.sum_prefix_scores(words).iter().map(|s| s as i64).collect()
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, words: Slice[String]) -> Vec[i64] {
    let words = words.to_vec();
    match arm {
        0 => star_sum_prefix_scores(words),
        1 => hash_sum_prefix_scores(words),
        2 => sort_sum_prefix_scores(words),
        3 => trie_sum_prefix_scores(words),
        4 => iter_sum_prefix_scores(words),
        _ => solution_sum_prefix_scores(words),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arms = ["star", "hash", "sort", "trie", "iter", "solution"];
    let mut seed = 2416;
    let mut cases: Vec[Vec[String]] = Vec.new();
    for t in 0..360 {
        let (n, longest, kinds) = if t < 300 {
            (1 + next_random(mut seed) % 8, 5, 1 + next_random(mut seed) % 3)
        } else if t < 330 {
            (1 + next_random(mut seed) % 60, 20, 2)
        } else {
            (1 + next_random(mut seed) % 60, 20, 26)
        };
        let mut words: Vec[String] = Vec.new();
        for _ in 0..n {
            let len = 1 + next_random(mut seed) % longest;
            let bytes: Vec[u8] = (0..len).map(|_| b'a' + (next_random(mut seed) % kinds) as u8).collect();
            words.push(String.from_utf8(bytes).unwrap());
        }
        cases.push(words);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let words = cases[c].clone();
        let n = words.len();
        let truth = scores_literally(words);
        for s in truth.iter() {
            check = (check * 31 + s) % 1000000007;
        }
        let mut back = words.clone();
        back.reverse();
        let renamed: Vec[String] = words.iter().map(|w| String.from_utf8(w.bytes().iter().map(|b| b'a' + (b - b'a' + 1) % 26).collect()).unwrap()).collect();
        let mut twice = words.clone();
        twice.extend(words.clone());
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, words)).collect();
        for arm in 0..6 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let mut bounded = value.len() == n;
            if bounded {
                for i in 0..n {
                    let len = words[i].len();
                    if value[i] < len or value[i] > n * len {
                        bounded = false;
                    }
                }
            }
            let mut reversed = value.clone();
            reversed.reverse();
            let mut doubled: Vec[i64] = value.iter().map(|s| 2 * s).collect();
            doubled.extend(doubled.clone());
            let verdicts = [value == truth, bounded, answer(arm, back) == reversed, answer(arm, renamed) == value, answer(arm, twice) == doubled, same >= 3];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
