// LeetCode #2472: Maximum Number of Non-overlapping Palindrome Substrings
// -- the bench, the ★ arm: the greedy over starts, a palindrome of `k`
// letters from here taken first, else one of `k + 1`, each checked by two
// indices walked inward. The string is a `Vec[char]`.

fn is_palindrome(c: Vec[char], from: i64, to: i64) -> bool {
    let mut lo = from;
    let mut hi = to;
    while lo < hi {
        if c[lo] != c[hi] {
            return false;
        }
        lo += 1;
        hi -= 1;
    }
    true
}

fn max_palindromes(c: Vec[char], k: i64) -> i64 {
    let n = c.len();
    let mut count = 0;
    let mut i = 0;
    while i + k <= n {
        if is_palindrome(c, i, i + k - 1) {
            count += 1;
            i += k;
        } else if i + k < n and is_palindrome(c, i, i + k) {
            count += 1;
            i += k + 1;
        } else {
            i += 1;
        }
    }
    count
}

// ---- bench ------------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 strings of 2000 letters from "ab" built once; then 2400 passes,
    // each setting one letter of every string from the checksum so far,
    // then answering it with `k` from 2 to 6 by the pass, folding the
    // count plus the pass into the checksum
    let n = 2000;
    let letters = ['a', 'b'];
    let mut seed = 2472;
    let mut texts: Vec[Vec[char]] = (0..20).map(|_| (0..n).map(|_| letters[next_random(mut seed) % 2]).collect()).collect();
    let mut check = 0;
    for p in 0..2400 {
        let k = 2 + p % 5;
        for a in 0..texts.len() {
            texts[a][(check + a) % n] = letters[check % 2];
            check = (check * 31 + max_palindromes(texts[a], k) + p) % 1000000007;
        }
    }
    println(f"2400 passes over 20 strings of 2000: checksum {check}");
}
