// LeetCode #2472: Maximum Number of Non-overlapping Palindrome Substrings
// -- the differential. The six arms against the statement read
// literally: from each letter on, every choice tried, the letter left
// out or every substring of `k` letters or more that starts there and
// equals its own reverse taken, and the most that follow added. 360
// random strings: 300 of 1 to 10 letters, then 60 of up to 14; each
// from the first one to three letters of the alphabet, with `k` from 1
// to its length. Every case is drawn before any arm answers.
//
// P1  the count is the literal reading's
// P2  the string reversed: the same count
// P3  the string, "yz", then the string again: twice the count, and two
//     more when `k` is 1
// P4  `k` raised by one: no more
// P5  `k` letters "x" and a "y" put in front: one more, or two when `k`
//     is 1
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn reversed(s: String) -> String {
    let mut out = "".to_string();
    for ch in s.chars().rev() {
        out.push(ch);
    }
    out
}

fn most_literally(s: String, k: i64, from: i64) -> i64 {
    if from >= s.len() {
        return 0;
    }
    let mut best = most_literally(s, k, from + 1);
    for to in from + k..s.len() + 1 {
        let piece = s.substring(from, to);
        if piece == reversed(piece) {
            best = best.max(1 + most_literally(s, k, to));
        }
    }
    best
}

// ---- star (palindromes.kara) ---------------------------------------------

fn star_is_palindrome(c: Vec[char], from: i64, to: i64) -> bool {
    let mut lo = from;
    let mut hi = to;
    while lo < hi {
        if c[lo] != c[hi] {
            return false;
        }
        lo += 1;
        hi -= 1;
    }
    true
}

fn star_max_palindromes(s: String, k: i64) -> i64 {
    let c: Vec[char] = s.chars().collect();
    let n = c.len();
    let mut count = 0;
    let mut i = 0;
    while i + k <= n {
        if star_is_palindrome(c, i, i + k - 1) {
            count += 1;
            i += k;
        } else if i + k < n and star_is_palindrome(c, i, i + k) {
            count += 1;
            i += k + 1;
        } else {
            i += 1;
        }
    }
    count
}

// ---- table (palindromes_table.kara) --------------------------------------

fn table_max_palindromes(s: String, k: i64) -> i64 {
    let c: Vec[char] = s.chars().collect();
    let n = c.len();
    let mut palindrome: Vec[Vec[bool]] = Vec.filled(n, Vec.filled(n, false));
    for length in 1..n + 1 {
        for i in 0..n - length + 1 {
            let j = i + length - 1;
            palindrome[i][j] = c[i] == c[j] and (length <= 2 or palindrome[i + 1][j - 1]);
        }
    }
    let mut best: Vec[i64] = Vec.filled(n + 1, 0);
    for j in 1..n + 1 {
        best[j] = best[j - 1];
        for i in 0..j {
            if j - i >= k and palindrome[i][j - 1] {
                best[j] = best[j].max(best[i] + 1);
            }
        }
    }
    best[n]
}

// ---- centers (palindromes_centers.kara) ----------------------------------

fn centers_max_palindromes(s: String, k: i64) -> i64 {
    let c: Vec[char] = s.chars().collect();
    let n = c.len();
    let mut starts: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for center in 0..2 * n - 1 {
        let mut lo = center / 2;
        let mut hi = lo + center % 2;
        while lo >= 0 and hi < n and c[lo] == c[hi] {
            if hi - lo + 1 >= k {
                starts[hi].push(lo);
                break;
            }
            lo -= 1;
            hi += 1;
        }
    }
    let mut best: Vec[i64] = Vec.filled(n + 1, 0);
    for j in 1..n + 1 {
        best[j] = best[j - 1];
        for lo in starts[j - 1].iter() {
            best[j] = best[j].max(best[lo] + 1);
        }
    }
    best[n]
}

// ---- manacher (palindromes_manacher.kara) --------------------------------

fn manacher_max_palindromes(s: String, k: i64) -> i64 {
    let mut t: Vec[char] = ['#'].to_vec();
    for ch in s.chars() {
        t.push(ch);
        t.push('#');
    }
    let m = t.len();
    let mut radius: Vec[i64] = Vec.filled(m, 0);
    let mut center = 0;
    let mut right = 0;
    for i in 0..m {
        let mut r = if i < right { radius[2 * center - i].min(right - i) } else { 0 };
        while i - r - 1 >= 0 and i + r + 1 < m and t[i - r - 1] == t[i + r + 1] {
            r += 1;
        }
        radius[i] = r;
        if i + r > right {
            center = i;
            right = i + r;
        }
    }
    let n = (m - 1) / 2;
    let mut count = 0;
    let mut i = 0;
    while i + k <= n {
        if radius[2 * i + k] >= k {
            count += 1;
            i += k;
        } else if i + k < n and radius[2 * i + k + 1] >= k + 1 {
            count += 1;
            i += k + 1;
        } else {
            i += 1;
        }
    }
    count
}

// ---- iter (palindromes_iter.kara) ----------------------------------------

fn iter_max_palindromes(s: String, k: i64) -> i64 {
    let c: Vec[char] = s.chars().collect();
    let n = c.len();
    let mut count = 0;
    let mut i = 0;
    while i + k <= n {
        let found = (k..k + 2).find(|length| i + length <= n and (0..length / 2).all(|d| c[i + d] == c[i + length - 1 - d]));
        match found {
            Some(length) => {
                count += 1;
                i += length;
            }
            None => i += 1,
        }
    }
    count
}

// ---- solution (palindromes_solution.kara) --------------------------------

impl Solution {
    pub fn max_palindromes(s: String, k: i32) -> i32 {
        let s = s.bytes();
        let n = s.len();
        let k = k as i64;
        let mut dp = Vec.filled(n + 1, 0i32);
        for i in 0..n {
            dp[i + 1] = dp[i];
            for len in [k, k + 1] {
                if len > i + 1 {
                    continue;
                }
                let start = i + 1 - len;
                let mut (l, r) = (start, i);
                let mut ok = true;
                while l < r {
                    if s[l] != s[r] {
                        ok = false;
                        break;
                    }
                    l += 1;
                    r -= 1;
                }
                if ok {
                    dp[i + 1] = dp[i + 1].max(dp[start] + 1);
                }
            }
        }
        dp[n]
    }
}

struct Solution {}

fn solution_max_palindromes(s: String, k: i64) -> i64 {
    Solution.max_palindromes(s, k as i32)
}

// ---- the differential -------------------------------------------------------

fn answer(arm: i64, s: String, k: i64) -> i64 {
    match arm {
        0 => star_max_palindromes(s, k),
        1 => table_max_palindromes(s, k),
        2 => centers_max_palindromes(s, k),
        3 => manacher_max_palindromes(s, k),
        4 => iter_max_palindromes(s, k),
        _ => solution_max_palindromes(s, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_text(n: i64, kinds: i64, seed: mut ref i64) -> String {
    let letters = "abc";
    let mut text = "".to_string();
    for _ in 0..n {
        let at = next_random(mut seed) % kinds;
        text.push_str(letters.substring(at, at + 1));
    }
    text
}

fn main() {
    let arms = ["star", "table", "centers", "manacher", "iter", "solution"];
    let mut seed = 2472;
    let mut cases: Vec[(String, i64)] = Vec.new();
    for t in 0..360 {
        let n = if t < 300 { 1 + next_random(mut seed) % 10 } else { 1 + next_random(mut seed) % 14 };
        let kinds = 1 + next_random(mut seed) % 3;
        let s = random_text(n, kinds, mut seed);
        let k = 1 + next_random(mut seed) % n;
        cases.push((s, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (s, k) = ref cases[c];
        let truth = most_literally(s, k, 0);
        check = (check * 31 + truth) % 1000000007;
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, s, k)).collect();
        let back = reversed(s);
        let twice = f"{s}yz{s}";
        let extra = if k == 1 { 2 } else { 1 };
        let mut front = "".to_string();
        for _ in 0..k {
            front.push('x');
        }
        front.push('y');
        front.push_str(s);
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                answer(arm, back, k) == value,
                answer(arm, twice, k) == 2 * value + 2 * (extra - 1),
                answer(arm, s, k + 1) <= value,
                answer(arm, front, k) == value + extra,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {arms[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
