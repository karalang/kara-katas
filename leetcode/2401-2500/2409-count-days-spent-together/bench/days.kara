// LeetCode #2409: Count Days Spent Together -- the bench, the ★ arm: each
// "MM-DD" read from its bytes into a day of the year, the shared stay from
// the later arrival to the earlier departure.

fn day_of_year(date: String) -> i64 {
    let before = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    let b = date.bytes();
    let month = ((b[0] - b'0') * 10 + b[1] - b'0') as i64;
    let day = ((b[3] - b'0') * 10 + b[4] - b'0') as i64;
    before[month - 1] + day
}

fn count_days_together(arrive_alice: String, leave_alice: String, arrive_bob: String, leave_bob: String) -> i64 {
    let first = day_of_year(arrive_alice).max(day_of_year(arrive_bob));
    let last = day_of_year(leave_alice).min(day_of_year(leave_bob));
    (last - first + 1).max(0)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // every day's "MM-DD", then 10^5 random pairs of stays as four indexes;
    // each pass answers them all and folds every answer, plus the pass
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let mut names: Vec[String] = Vec.new();
    for m in 0..12 {
        for d in 0..lengths[m] {
            names.push(f"{m + 1:02}-{d + 1:02}");
        }
    }
    let mut seed = 2409;
    let mut stays: Vec[(i64, i64, i64, i64)] = Vec.new();
    for _ in 0..100000 {
        let (a, b) = (next_random(mut seed) % 365, next_random(mut seed) % 365);
        let (c, d) = (next_random(mut seed) % 365, next_random(mut seed) % 365);
        stays.push((a.min(b), a.max(b), c.min(d), c.max(d)));
    }
    let mut check = 0;
    for p in 0..100 {
        for (a, b, c, d) in stays.iter() {
            check = (check * 31 + count_days_together(names[a], names[b], names[c], names[d]) + p) % 1000000007;
        }
    }
    println(f"100 passes over 10^5 pairs of stays: checksum {check}");
}
