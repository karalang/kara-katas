// LeetCode #2409: Count Days Spent Together -- the differential. The six
// arms against the statement read literally: every day of the year as a
// (month, day) pair, each stay's ends parsed into pairs, a day inside a
// stay when it is between them pair by pair, and the days inside both
// counted. No day numbers and no string comparison. 1000 cases: random
// pairs of stays, a tenth of them one day long. Every case is drawn
// before any arm answers.
//
// P1  the answer is the literal reading's
// P2  Alice and Bob swapped: the same answer
// P3  Alice with herself: her stay's length, and the answer at most the
//     shorter stay's length
// P4  Bob's stay cut after its first day: the two parts' answers sum to
//     the whole's
// P5  both stays moved a day later, when both end before 12-31: the same
//     answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally ------------------------------------------

fn pair(date: String) -> (i64, i64) {
    let b = date.bytes();
    (((b[0] - b'0') * 10 + b[1] - b'0') as i64, ((b[3] - b'0') * 10 + b[4] - b'0') as i64)
}

fn inside(day: (i64, i64), from: (i64, i64), to: (i64, i64)) -> bool {
    let after = day.0 > from.0 or day.0 == from.0 and day.1 >= from.1;
    let before = day.0 < to.0 or day.0 == to.0 and day.1 <= to.1;
    after and before
}

fn together_literally(arrive_alice: String, leave_alice: String, arrive_bob: String, leave_bob: String) -> i64 {
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let mut count = 0;
    for m in 1..13 {
        for d in 1..lengths[m - 1] + 1 {
            if inside((m, d), pair(arrive_alice), pair(leave_alice)) and inside((m, d), pair(arrive_bob), pair(leave_bob)) {
                count += 1;
            }
        }
    }
    count
}

// ---- star (days.kara) ----------------------------------------------------

fn star_day_of_year(date: String) -> i64 {
    let before = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    let b = date.bytes();
    let month = ((b[0] - b'0') * 10 + b[1] - b'0') as i64;
    let day = ((b[3] - b'0') * 10 + b[4] - b'0') as i64;
    before[month - 1] + day
}

fn star_count_days_together(arrive_alice: String, leave_alice: String, arrive_bob: String, leave_bob: String) -> i64 {
    let first = star_day_of_year(arrive_alice).max(star_day_of_year(arrive_bob));
    let last = star_day_of_year(leave_alice).min(star_day_of_year(leave_bob));
    (last - first + 1).max(0)
}

// ---- compare (days_compare.kara) -----------------------------------------

fn compare_day_of_year(date: String) -> i64 {
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let month: i64 = i64.parse(date[0..2]).unwrap();
    let day: i64 = i64.parse(date[3..5]).unwrap();
    let mut before = 0;
    for m in 0..month - 1 {
        before += lengths[m];
    }
    before + day
}

fn compare_count_days_together(arrive_alice: String, leave_alice: String, arrive_bob: String, leave_bob: String) -> i64 {
    let first = if arrive_alice > arrive_bob {
        arrive_alice
    } else {
        arrive_bob
    };
    let last = if leave_alice < leave_bob {
        leave_alice
    } else {
        leave_bob
    };
    if first > last {
        return 0;
    }
    compare_day_of_year(last) - compare_day_of_year(first) + 1
}

// ---- calendar (days_calendar.kara) ---------------------------------------

fn calendar_count_days_together(arrive_alice: String, leave_alice: String, arrive_bob: String, leave_bob: String) -> i64 {
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let mut names: Vec[String] = Vec.new();
    for m in 0..12 {
        for d in 0..lengths[m] {
            names.push(f"{m + 1:02}-{d + 1:02}");
        }
    }
    let mut alice = [false; 365];
    for i in 0..365 {
        alice[i] = arrive_alice <= names[i] and names[i] <= leave_alice;
    }
    let mut together = 0;
    for i in 0..365 {
        if alice[i] and arrive_bob <= names[i] and names[i] <= leave_bob {
            together += 1;
        }
    }
    together
}

// ---- split (days_split.kara) ---------------------------------------------

fn split_day_of_year(date: String) -> i64 {
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let parts: Vec[String] = date.split("-").map(|p| p.to_string()).collect();
    let month: i64 = i64.parse(parts[0]).unwrap();
    let day: i64 = i64.parse(parts[1]).unwrap();
    let mut n = day;
    let mut m = 1;
    while m < month {
        n += lengths[m - 1];
        m += 1;
    }
    n
}

fn split_count_days_together(arrive_alice: String, leave_alice: String, arrive_bob: String, leave_bob: String) -> i64 {
    let first = split_day_of_year(arrive_alice).max(split_day_of_year(arrive_bob));
    let last = split_day_of_year(leave_alice).min(split_day_of_year(leave_bob));
    if last < first {
        0
    } else {
        last - first + 1
    }
}

// ---- iter (days_iter.kara) -----------------------------------------------

fn iter_day_of_year(date: String) -> i64 {
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let fields: Vec[i64] = date.split("-").map(|p| i64.parse(p).unwrap()).collect();
    lengths.iter().take(fields[0] - 1).sum() + fields[1]
}

fn iter_count_days_together(arrive_alice: String, leave_alice: String, arrive_bob: String, leave_bob: String) -> i64 {
    let first = [arrive_alice, arrive_bob].iter().map(|d| iter_day_of_year(d)).max().unwrap();
    let last = [leave_alice, leave_bob].iter().map(|d| iter_day_of_year(d)).min().unwrap();
    (last - first + 1).max(0)
}

// ---- solution (days_solution.kara) ---------------------------------------

impl Solution {
    pub fn count_days_together(arrive_alice: String, leave_alice: String, arrive_bob: String, leave_bob: String) -> i32 {
        let days = [31i32, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
        let f: Fn(ref String) -> i32 = |s: ref String| {
            let m: usize = usize.parse(s[..2]).unwrap();
            let d: i32 = i32.parse(s[3..]).unwrap();
            days[..m - 1].iter().sum() + d
        };
        let a = f(arrive_alice).max(f(arrive_bob));
        let b = f(leave_alice).min(f(leave_bob));
        (b - a + 1).max(0)
    }
}

struct Solution {}

fn solution_count_days_together(arrive_alice: String, leave_alice: String, arrive_bob: String, leave_bob: String) -> i64 {
    Solution.count_days_together(arrive_alice, leave_alice, arrive_bob, leave_bob)
}

// ---- the differential -----------------------------------------------------

fn answer(arm: i64, arrive_alice: String, leave_alice: String, arrive_bob: String, leave_bob: String) -> i64 {
    match arm {
        0 => star_count_days_together(arrive_alice, leave_alice, arrive_bob, leave_bob),
        1 => compare_count_days_together(arrive_alice, leave_alice, arrive_bob, leave_bob),
        2 => calendar_count_days_together(arrive_alice, leave_alice, arrive_bob, leave_bob),
        3 => split_count_days_together(arrive_alice, leave_alice, arrive_bob, leave_bob),
        4 => iter_count_days_together(arrive_alice, leave_alice, arrive_bob, leave_bob),
        _ => solution_count_days_together(arrive_alice, leave_alice, arrive_bob, leave_bob),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// Day `n` of the year, from 0, as "MM-DD".
fn date(n: i64) -> String {
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let mut month = 0;
    let mut day = n;
    while day >= lengths[month] {
        day -= lengths[month];
        month += 1;
    }
    f"{month + 1:02}-{day + 1:02}"
}

fn main() {
    let names = ["star", "compare", "calendar", "split", "iter", "solution"];
    let mut seed = 2409;
    let mut cases: Vec[(i64, i64, i64, i64)] = Vec.new();
    for _ in 0..1000 {
        let mut ends: Vec[i64] = Vec.new();
        for _ in 0..2 {
            let a = next_random(mut seed) % 365;
            let b = if next_random(mut seed) % 10 == 0 {
                a
            } else {
                next_random(mut seed) % 365
            };
            ends.push(a.min(b));
            ends.push(a.max(b));
        }
        cases.push((ends[0], ends[1], ends[2], ends[3]));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for c in 0..cases.len() {
        let (aa, la, ab, lb) = cases[c];
        let truth = together_literally(date(aa), date(la), date(ab), date(lb));
        check = (check * 31 + truth) % 1000000007;
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, date(aa), date(la), date(ab), date(lb))).collect();
        for arm in 0..6 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let alone = answer(arm, date(aa), date(la), date(aa), date(la));
            let cut = if ab < lb {
                answer(arm, date(aa), date(la), date(ab), date(ab)) + answer(arm, date(aa), date(la), date(ab + 1), date(lb))
            } else {
                value
            };
            let moved = if la < 364 and lb < 364 {
                answer(arm, date(aa + 1), date(la + 1), date(ab + 1), date(lb + 1))
            } else {
                value
            };
            let verdicts = [value == truth, answer(arm, date(ab), date(lb), date(aa), date(la)) == value, alone == la - aa + 1 and value <= (la - aa + 1).min(lb - ab + 1), cut == value, moved == value, same >= 3];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 6 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
