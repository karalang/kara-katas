// LeetCode #2481: Minimum Cuts to Divide a Circle -- by a common
// divisor: a cut through the centre draws two radii exactly when half a
// turn is a whole number of slices, so each cut draws `gcd(n, 2)`
// radii and `n` of them take `n / gcd(n, 2)` cuts. Euclid's algorithm
// finds the divisor. One slice needs no cut. O(1).

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn number_of_cuts(n: i64) -> i64 {
    if n == 1 {
        return 0;
    }
    n / gcd(n, 2)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then one slice, two, and the
    // constraints' largest odd and even counts
    for n in [4, 3, 1, 2, 99, 100].iter() {
        println(f"{n} -> {number_of_cuts(n)}");
    }
    // every count from 1 to 100, the constraints' whole range
    let every: Vec[i64] = (1..101).map(|n| number_of_cuts(n)).collect();
    println(f"1 to 100 -> {every}");
    // 3000 random counts from 1 to 100: a checksum of every answer in
    // order
    let mut seed = 2481;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 100;
        check = (check * 31 + number_of_cuts(n)) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
