// LeetCode #2481: Minimum Cuts to Divide a Circle -- by parity: `n`
// equal slices need `n` radii, equally spaced. With `n` even every
// radius has its opposite among them, and one cut through the centre
// draws both, so `n / 2` cuts; with `n` odd no radius has, and each takes
// a cut of its own, so `n`. One slice is the whole circle and needs
// none. O(1).

fn number_of_cuts(n: i64) -> i64 {
    if n == 1 {
        0
    } else if n % 2 == 0 {
        n / 2
    } else {
        n
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then one slice, two, and the
    // constraints' largest odd and even counts
    for n in [4, 3, 1, 2, 99, 100].iter() {
        println(f"{n} -> {number_of_cuts(n)}");
    }
    // every count from 1 to 100, the constraints' whole range
    let every: Vec[i64] = (1..101).map(|n| number_of_cuts(n)).collect();
    println(f"1 to 100 -> {every}");
    // 3000 random counts from 1 to 100: a checksum of every answer in
    // order
    let mut seed = 2481;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 100;
        check = (check * 31 + number_of_cuts(n)) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
