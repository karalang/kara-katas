// LeetCode #2481: Minimum Cuts to Divide a Circle -- by pairing radii:
// the `n` radii numbered round the circle, each not yet drawn is drawn
// by a cut, and the cut runs on through the centre to draw the radius
// opposite too when there is one, half a turn on at `k + n / 2` for an
// even `n`. One slice needs no cut. O(n).

fn number_of_cuts(n: i64) -> i64 {
    if n == 1 {
        return 0;
    }
    let mut drawn: Vec[bool] = Vec.filled(n, false);
    let mut cuts = 0;
    for k in 0..n {
        if drawn[k] {
            continue;
        }
        drawn[k] = true;
        if n % 2 == 0 {
            drawn[(k + n / 2) % n] = true;
        }
        cuts += 1;
    }
    cuts
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then one slice, two, and the
    // constraints' largest odd and even counts
    for n in [4, 3, 1, 2, 99, 100].iter() {
        println(f"{n} -> {number_of_cuts(n)}");
    }
    // every count from 1 to 100, the constraints' whole range
    let every: Vec[i64] = (1..101).map(|n| number_of_cuts(n)).collect();
    println(f"1 to 100 -> {every}");
    // 3000 random counts from 1 to 100: a checksum of every answer in
    // order
    let mut seed = 2481;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 100;
        check = (check * 31 + number_of_cuts(n)) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
