// LeetCode #2481: Minimum Cuts to Divide a Circle -- bench: the ★ arm,
// by parity, `n / 2` cuts for an even count, `n` for an odd one, and
// none for one slice. O(1).

fn number_of_cuts(n: i64) -> i64 {
    if n == 1 {
        0
    } else if n % 2 == 0 {
        n / 2
    } else {
        n
    }
}

// ---- bench ------------------------------------------------------------------

fn main() {
    // 500000 passes over every count from 1 to 100, each starting at a
    // count chosen by the checksum so far, folding each answer plus the
    // pass into the checksum
    let mut check = 0;
    for p in 0..500000 {
        let start = check % 100;
        for i in 0..100 {
            let n = 1 + (start + i) % 100;
            check = (check * 31 + number_of_cuts(n) + p) % 1000000007;
        }
    }
    println(f"500000 passes over every count from 1 to 100: checksum {check}");
}
