// LeetCode #2481: Minimum Cuts to Divide a Circle -- by angles: the
// radii's angles in degrees, `360 k / n` as `f64`, sorted; a radius whose
// angle less 180 is among them, within `10^-9`, is the far end of a cut
// already drawn through the centre, and every other radius takes a cut.
// One slice needs no cut. O(n log n).

fn number_of_cuts(n: i64) -> i64 {
    if n == 1 {
        return 0;
    }
    let angles: Vec[f64] = (0..n).map(|k| 360.0 * k as f64 / n as f64).collect();
    let mut cuts = 0;
    for a in angles.iter() {
        let back = a - 180.0;
        let opposite = angles.iter().any(|b| (b - back).abs() < 0.000000001);
        if not opposite {
            cuts += 1;
        }
    }
    cuts
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; then one slice, two, and the
    // constraints' largest odd and even counts
    for n in [4, 3, 1, 2, 99, 100].iter() {
        println(f"{n} -> {number_of_cuts(n)}");
    }
    // every count from 1 to 100, the constraints' whole range
    let every: Vec[i64] = (1..101).map(|n| number_of_cuts(n)).collect();
    println(f"1 to 100 -> {every}");
    // 3000 random counts from 1 to 100: a checksum of every answer in
    // order
    let mut seed = 2481;
    let mut check = 0;
    for _ in 0..3000 {
        let n = 1 + next_random(mut seed) % 100;
        check = (check * 31 + number_of_cuts(n)) % 1000000007;
    }
    println(f"3000 random: checksum {check}");
}
