// LeetCode #1662: Check If Two String Arrays are Equivalent -- the
// differential.
//
// Four arms against the statement read literally, on 3000 random pairs
// of word arrays of up to 12 letters, half of them spelling the same text
// and half one letter apart.
//
// P1  the answer is the statement read literally
// P2  the arrays swapped give the same answer
// P3  the second array's text cut into other words gives the same answer
// P4  every letter moved one along the alphabet gives the same answer
// P5  each arm agrees with at least two of the other three

// ---- equivalent.kara: the ★ arm: two cursors, one in each array

fn star_arm(word1: Vec[String], word2: Vec[String]) -> bool {
    let mut (w1, i1) = (0, 0);
    let mut (w2, i2) = (0, 0);
    while w1 < word1.len() and w2 < word2.len() {
        let a = word1[w1].bytes();
        let b = word2[w2].bytes();
        if a[i1] != b[i2] {
            return false;
        }
        i1 += 1;
        i2 += 1;
        if i1 == a.len() {
            w1 += 1;
            i1 = 0;
        }
        if i2 == b.len() {
            w2 += 1;
            i2 = 0;
        }
    }
    w1 == word1.len() and w2 == word2.len()
}

// ---- equivalent_concat.kara: each array joined into one text

fn concat_arm(word1: Vec[String], word2: Vec[String]) -> bool {
    word1.concat() == word2.concat()
}

// ---- equivalent_chars.kara: the letters of each array as one stream

fn chars_arm(word1: Vec[String], word2: Vec[String]) -> bool {
    word1.iter().flat_map(|w| w.chars()).eq(word2.iter().flat_map(|w| w.chars()))
}

// ---- equivalent_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn array_strings_are_equal(word1: Vec[String], word2: Vec[String]) -> bool {
        let mut it1 = word1.iter().flat_map(|w| w.chars());
        let mut it2 = word2.iter().flat_map(|w| w.chars());
        loop {
            match (it1.next(), it2.next()) {
                (Some(a), Some(b)) if a == b => continue,
                (None, None) => return true,
                _ => return false,
            }
        }
    }
}

fn solution_arm(word1: Vec[String], word2: Vec[String]) -> bool {
    SolutionArm.array_strings_are_equal(word1, word2)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_text(n: i64, kinds: i64, seed: mut ref i64) -> String {
    let mut text = String.new();
    for _ in 0..n {
        let letter = (b'a' + (next_random(mut seed) % kinds) as u8) as char;
        text.push(letter);
    }
    text
}

fn cut(text: Str, gap: i64, seed: mut ref i64) -> Vec[String] {
    let mut words = Vec.new();
    let mut start = 0;
    for i in 1..text.len() {
        if next_random(mut seed) % gap == 0 {
            words.push(text[start..i].to_string());
            start = i;
        }
    }
    words.push(text[start..].to_string());
    words
}

fn spoil(text: Str, seed: mut ref i64) -> String {
    let at = next_random(mut seed) % text.len();
    match next_random(mut seed) % 3 {
        0 => {
            let old = text.bytes()[at];
            let new = if old == b'a' { b'b' } else { b'a' };
            let mut bytes = text.bytes().to_vec();
            bytes[at] = new;
            String.from_utf8(bytes).unwrap()
        }
        1 if text.len() > 1 => f"{text[..at]}{text[at + 1..]}",
        _ => f"{text}a",
    }
}

// the statement read literally: each array's words concatenated in
// order, one letter at a time, and the two strings compared
fn literal(word1: Slice[String], word2: Slice[String]) -> bool {
    let mut a = String.new();
    for w in word1 {
        for c in w.chars() {
            a.push(c);
        }
    }
    let mut b = String.new();
    for w in word2 {
        for c in w.chars() {
            b.push(c);
        }
    }
    a == b
}

// every letter moved one along the alphabet, `z` to `a`
fn shifted(words: Slice[String]) -> Vec[String] {
    words
        .iter()
        .map(|w| w.chars().map(|c| (b'a' + (c as u32 as u8 - b'a' + 1) % 26) as char).collect())
        .collect()
}

fn arm(k: i64, word1: Vec[String], word2: Vec[String]) -> bool {
    match k {
        0 => star_arm(word1, word2),
        1 => concat_arm(word1, word2),
        2 => chars_arm(word1, word2),
        _ => solution_arm(word1, word2),
    }
}

fn arm_name(k: i64) -> Str {
    ["the ★ arm", "concat", "chars", "solution"][k]
}

fn main() {
    let mut seed = 1662;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    // each case: the two arrays, and the second array's text cut again
    let mut cases: Vec[(Vec[String], Vec[String], Vec[String])] = Vec.new();
    for p in 0..problems {
        let n = next_random(mut seed) % 12 + 1;
        let kinds = next_random(mut seed) % 3 + 1;
        let text = random_text(n, kinds, mut seed);
        let other = if p % 2 == 0 { text.clone() } else { spoil(text, mut seed) };
        let word1 = cut(text, 3, mut seed);
        let word2 = cut(other, 3, mut seed);
        let recut = cut(other, 2, mut seed);
        cases.push((word1, word2, recut));
    }
    for (p, (word1, word2, recut)) in cases.iter().enumerate() {
        let want = literal(word1, word2);
        check = (check * 31 + (if want { 2 } else { 1 }) + word1.len() + word2.len()) % 1000000007;
        let mut answers: Vec[bool] = Vec.new();
        for k in 0..4 {
            let got = arm(k, word1, word2);
            answers.push(got);
            let failed = [
                got != want,
                arm(k, word2, word1) != got,
                arm(k, word1, recut) != got,
                arm(k, shifted(word1), shifted(word2)) != got,
            ];
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({word1} against {word2}), {arm_name(k)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for k in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[k]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(k)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
