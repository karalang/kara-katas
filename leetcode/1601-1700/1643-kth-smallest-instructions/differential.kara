// LeetCode #1643: Kth Smallest Instructions -- the differential.
//
// Four arms against the statement read literally, on 3000 random
// destinations of 1 to 5 rows and columns: every fourth k the first path,
// every fourth the last, the rest random. Every case is drawn before any
// arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer moves right `column` times and down `row` times
// P3  the path for k + 1, when there is one, sorts after the path for k
// P4  'H' and 'V' swapped, the answer is the path from the other end of
//     the order to the destination turned on its side
// P5  each arm agrees with at least two of the other three

// ---- kth.kara: the ★ arm: Pascal's triangle, one move at a time

fn star_arm(destination: Vec[i32], k: i32) -> String {
    let mut (v, h) = (destination[0] as i64, destination[1] as i64);
    let n = v + h;
    let mut choose = Vec.filled(n + 1, Vec.filled(n + 1, 0));
    for i in 0..=n {
        choose[i][0] = 1;
        for j in 1..=i {
            choose[i][j] = choose[i - 1][j - 1] + choose[i - 1][j];
        }
    }
    let mut k = k as i64;
    let mut path = String.new();
    for _ in 0..n {
        let starting_h = choose[h + v - 1][v];
        if k <= starting_h {
            path.push('H');
            h -= 1;
        } else {
            path.push('V');
            k -= starting_h;
            v -= 1;
        }
    }
    path
}

// ---- kth_grid.kara: a table of paths from every cell

fn grid_arm(destination: Vec[i32], k: i32) -> String {
    let rows = destination[0] as i64;
    let columns = destination[1] as i64;
    let mut paths = Vec.filled(rows + 1, Vec.filled(columns + 1, 1));
    for r in (0..rows).rev() {
        for c in (0..columns).rev() {
            paths[r][c] = paths[r + 1][c] + paths[r][c + 1];
        }
    }
    let mut k = k as i64;
    let mut (r, c) = (0, 0);
    let mut path = String.new();
    while r < rows or c < columns {
        if c < columns and (r == rows or k <= paths[r][c + 1]) {
            path.push('H');
            c += 1;
        } else {
            if c < columns {
                k -= paths[r][c + 1];
            }
            path.push('V');
            r += 1;
        }
    }
    path
}

// ---- kth_recursive.kara: recursive, the binomial by the multiplicative formula

fn recursive_starting_h(h: i64, v: i64) -> i64 {
    let mut count = 1;
    for i in 1..=v {
        count = count * (h - 1 + i) / i;
    }
    count
}

fn recursive_kth(h: i64, v: i64, k: i64) -> String {
    if h == 0 {
        return "V".repeat(v);
    }
    if v == 0 {
        return "H".repeat(h);
    }
    let first = recursive_starting_h(h, v);
    if k <= first {
        "H" + recursive_kth(h - 1, v, k)
    } else {
        "V" + recursive_kth(h, v - 1, k - first)
    }
}

fn recursive_arm(destination: Vec[i32], k: i32) -> String {
    recursive_kth(destination[1], destination[0], k)
}

// ---- kth_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn kth_smallest_path(destination: Vec[i32], k: i32) -> String {
        let mut (v, h) = (destination[0] as i64, destination[1] as i64);
        let mut c = Vec.filled(31, Vec.filled(31, 0i32));
        for i in 0..31 {
            c[i][0] = 1;
            for j in 1..=i {
                c[i][j] = c[i - 1][j - 1] + c[i - 1][j];
            }
        }
        let mut k = k;
        let mut ans = String.new();
        while h > 0 and v > 0 {
            let cnt = c[h + v - 1][v];
            if k <= cnt {
                ans.push('H');
                h -= 1;
            } else {
                ans.push('V');
                k -= cnt;
                v -= 1;
            }
        }
        ans.push_str("H".repeat(h));
        ans.push_str("V".repeat(v));
        ans
    }
}

fn solution_arm(destination: Vec[i32], k: i32) -> String {
    SolutionArm.kth_smallest_path(destination, k)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn count_paths(row: i64, column: i64) -> i64 {
    let mut count = 1;
    for i in 1..=row {
        count = count * (column + i) / i;
    }
    count
}

fn arm(a: i64, destination: Vec[i32], k: i32) -> String {
    match a {
        0 => star_arm(destination, k),
        1 => grid_arm(destination, k),
        2 => recursive_arm(destination, k),
        _ => solution_arm(destination, k),
    }
}

fn arm_name(a: i64) -> String {
    ["kth", "grid", "recursive", "solution"][a].to_string()
}

// ---- the statement read literally: every string of `row + column` moves
// is a bit mask read from the top bit down, 'H' a 0 and 'V' a 1, so the
// masks count up in lexicographic order; the k-th of those with `row`
// ones is the answer

fn literal(row: i64, column: i64, k: i64) -> String {
    let n = row + column;
    let mut seen = 0;
    for mask in 0..(1 << n) {
        let mut ones = 0;
        for j in 0..n {
            ones += mask >> j & 1;
        }
        if ones != row {
            continue;
        }
        seen += 1;
        if seen == k {
            let mut path = String.new();
            for j in (0..n).rev() {
                path.push(if mask >> j & 1 == 1 { 'V' } else { 'H' });
            }
            return path;
        }
    }
    String.new()
}

fn swapped(path: String) -> String {
    path.chars().map(|c| if c == 'H' { 'V' } else { 'H' }).collect()
}

fn main() {
    let mut seed = 1643;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(i64, i64, i64)] = [];
    for p in 0..problems {
        let row = next_random(mut seed) % 5 + 1;
        let column = next_random(mut seed) % 5 + 1;
        let total = count_paths(row, column);
        // every fourth k the first path, every fourth the last
        let k = match p % 4 {
            0 => 1,
            1 => total,
            _ => next_random(mut seed) % total + 1,
        };
        cases.push((row, column, k));
    }
    for p in 0..problems {
        let (row, column, k) = cases[p];
        let total = count_paths(row, column);
        let destination = [row as i32, column as i32];
        let want = literal(row, column, k);
        for b in want.bytes() {
            check = (check * 3 + if b == b'H' { 1 } else { 2 }) % 1000000007;
        }
        let mut answers: Vec[String] = [];
        for a in 0..4 {
            let got = arm(a, destination, k as i32);
            answers.push(got.clone());
            let hs = got.chars().filter(|c| c == 'H').count();
            let vs = got.chars().filter(|c| c == 'V').count();
            let failed = [
                got != want,
                hs != column or vs != row or got.len() != row + column,
                k < total and arm(a, destination, (k + 1) as i32) <= got,
                arm(a, [column as i32, row as i32], (total + 1 - k) as i32) != swapped(got),
            ];
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ([{row}, {column}], {k}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|x| x == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
