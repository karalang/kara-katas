// LeetCode #1643: Kth Smallest Instructions -- recursive.
//
// The path is 'H' and the k-th path of what is left when k is among the
// paths that start with 'H', and 'V' and the rest otherwise; once either
// move runs out, the rest is all the other. The binomial is worked out
// by the multiplicative formula at each step. O((r + c)^2).

fn starting_h(h: i64, v: i64) -> i64 {
    let mut count = 1;
    for i in 1..=v {
        count = count * (h - 1 + i) / i;
    }
    count
}

fn kth(h: i64, v: i64, k: i64) -> String {
    if h == 0 {
        return "V".repeat(v);
    }
    if v == 0 {
        return "H".repeat(h);
    }
    let first = starting_h(h, v);
    if k <= first {
        "H" + kth(h - 1, v, k)
    } else {
        "V" + kth(h, v - 1, k - first)
    }
}

fn kth_smallest_path(destination: Vec[i32], k: i32) -> String {
    kth(destination[1], destination[0], k)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the number of paths to `[row, column]`, for drawing k
fn count_paths(row: i64, column: i64) -> i64 {
    let mut count = 1;
    for i in 1..=row {
        count = count * (column + i) / i;
    }
    count
}

// `count` random destinations of 1 to `most` rows and columns, each with
// a k drawn from all of its paths; the moves right before the first move
// down summed, and a checksum over every letter
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let row = next_random(mut seed) % most + 1;
        let column = next_random(mut seed) % most + 1;
        let k = (next_random(mut seed) * 32768 + next_random(mut seed)) % count_paths(row, column) + 1;
        let path = kth_smallest_path([row as i32, column as i32], k as i32);
        total += path.find("V").unwrap();
        for b in path.bytes() {
            check = (check * 3 + if b == b'H' { 1 } else { 2 }) % 1000000007;
        }
    }
    println(f"{count} destinations of up to {most} by {most}: first moves down sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then the last path of the smallest grid,
    // the last of the largest, and the first of a single row down
    println(kth_smallest_path([2, 3], 1));
    println(kth_smallest_path([2, 3], 2));
    println(kth_smallest_path([2, 3], 3));
    println(kth_smallest_path([1, 1], 2));
    println(kth_smallest_path([15, 15], 155117520));
    println(kth_smallest_path([1, 15], 1));
    let mut seed = 1643;
    batch(3000, 3, mut seed);
    batch(3000, 15, mut seed);
    batch(100000, 15, mut seed);
}
