// LeetCode #1692: Count Ways to Distribute Candies -- the whole table.
//
// table[i][j], the ways for i candies in j bags, from the same recurrence
// as the ★ arm, every row kept: table[i][j] = j * table[i - 1][j] +
// table[i - 1][j - 1]. O(nk) time and space, modulo 10^9 + 7.

fn ways_to_distribute(n: i32, k: i32) -> i32 {
    let modulus: i64 = 1000000007;
    let rows = n as i64 + 1;
    let cols = k as i64 + 1;
    let mut table: Vec[Vec[i64]] = Vec.filled(rows, Vec.filled(cols, 0));
    table[0][0] = 1;
    for i in 1..rows {
        for j in 1..cols {
            table[i][j] = (j * table[i - 1][j] + table[i - 1][j - 1]) % modulus;
        }
    }
    table[n][k] as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random problems of n from 1 to `most` and k from 1 to n; the
// answers summed, and a checksum of them
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let k = next_random(mut seed) % n + 1;
        let answer = ways_to_distribute(n as i32, k as i32);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} problems of n up to {most}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one candy, n bags of n, and one bag
    println(ways_to_distribute(3, 2));
    println(ways_to_distribute(4, 2));
    println(ways_to_distribute(20, 5));
    println(ways_to_distribute(1, 1));
    println(ways_to_distribute(1000, 1000));
    println(ways_to_distribute(1000, 1));
    let mut seed = 1692;
    batch(3000, 10, mut seed);
    batch(300, 100, mut seed);
    batch(10, 1000, mut seed);
}
