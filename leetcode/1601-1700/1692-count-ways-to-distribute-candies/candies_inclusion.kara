// LeetCode #1692: Count Ways to Distribute Candies -- inclusion and
// exclusion over the empty bags.
//
// The ways to put n candies in k labelled bags, none empty, are
// sum over i of (-1)^i C(k, i) (k - i)^n: every way, less those with a
// chosen bag empty, and so on. The bags are not labelled, so that is
// divided by k!, by Fermat's inverse, a power to 10^9 + 5. The binomials
// come from factorials. O(k log n).

fn power(base: i64, exponent: i64, modulus: i64) -> i64 {
    let mut result = 1;
    let mut b = base % modulus;
    let mut e = exponent;
    while e > 0 {
        if e & 1 == 1 {
            result = result * b % modulus;
        }
        b = b * b % modulus;
        e >>= 1;
    }
    result
}

fn ways_to_distribute(n: i32, k: i32) -> i32 {
    let modulus = 1000000007;
    let mut factorial = Vec.filled(k + 1, 1);
    for i in 1..=k {
        factorial[i] = factorial[i - 1] * i % modulus;
    }
    let inverse = |x| power(x, modulus - 2, modulus);
    let mut labelled = 0;
    for i in 0..=k {
        let choose = factorial[k] * inverse(factorial[i]) % modulus * inverse(factorial[k - i]) % modulus;
        let term = choose * power(k - i, n, modulus) % modulus;
        if i % 2 == 0 {
            labelled = (labelled + term) % modulus;
        } else {
            labelled = (labelled - term + modulus) % modulus;
        }
    }
    (labelled * inverse(factorial[k]) % modulus) as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random problems of n from 1 to `most` and k from 1 to n; the
// answers summed, and a checksum of them
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let k = next_random(mut seed) % n + 1;
        let answer = ways_to_distribute(n as i32, k as i32);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} problems of n up to {most}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one candy, n bags of n, and one bag
    println(ways_to_distribute(3, 2));
    println(ways_to_distribute(4, 2));
    println(ways_to_distribute(20, 5));
    println(ways_to_distribute(1, 1));
    println(ways_to_distribute(1000, 1000));
    println(ways_to_distribute(1000, 1));
    let mut seed = 1692;
    batch(3000, 10, mut seed);
    batch(300, 100, mut seed);
    batch(10, 1000, mut seed);
}
