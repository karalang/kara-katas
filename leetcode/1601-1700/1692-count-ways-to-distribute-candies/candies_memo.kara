// LeetCode #1692: Count Ways to Distribute Candies -- the recurrence from
// the top, each answer remembered.
//
// ways(i, j) = j * ways(i - 1, j) + ways(i - 1, j - 1), from ways(n, k)
// down, with ways(i, i) = 1 and ways(i, j) = 0 for more bags than candies
// or none; a `Map` from (i, j) keeps each answer. A stretch of ways(i, 1)
// calls goes n deep. O(nk), modulo 10^9 + 7.

fn ways(i: i64, j: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if j == 0 or j > i {
        return 0;
    }
    if j == i or j == 1 {
        return 1;
    }
    if let Some(known) = memo.get((i, j)) {
        return known;
    }
    let answer = (j * ways(i - 1, j, mut memo) + ways(i - 1, j - 1, mut memo)) % 1000000007;
    memo.insert((i, j), answer);
    answer
}

fn ways_to_distribute(n: i32, k: i32) -> i32 {
    let mut memo = Map.new();
    ways(n, k, mut memo) as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random problems of n from 1 to `most` and k from 1 to n; the
// answers summed, and a checksum of them
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let k = next_random(mut seed) % n + 1;
        let answer = ways_to_distribute(n as i32, k as i32);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} problems of n up to {most}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one candy, n bags of n, and one bag
    println(ways_to_distribute(3, 2));
    println(ways_to_distribute(4, 2));
    println(ways_to_distribute(20, 5));
    println(ways_to_distribute(1, 1));
    println(ways_to_distribute(1000, 1000));
    println(ways_to_distribute(1000, 1));
    let mut seed = 1692;
    batch(3000, 10, mut seed);
    batch(300, 100, mut seed);
    batch(10, 1000, mut seed);
}
