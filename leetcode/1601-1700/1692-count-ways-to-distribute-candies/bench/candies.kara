// LeetCode #1692: Count Ways to Distribute Candies -- the bench: the ★ arm
// on 200 problems of 1000 candies, LeetCode's most, each with a random
// number of bags up to 1000, all drawn first, each answered 8 times.
//
// One row of the Stirling numbers at a time, overwritten from the right.
// O(nk), modulo 10^9 + 7.

fn ways_to_distribute(n: i32, k: i32) -> i32 {
    let modulus = 1000000007;
    let mut ways = Vec.filled(k + 1, 0);
    ways[0] = 1;
    for i in 1..=n {
        for j in (1..=min(i, k)).rev() {
            ways[j] = (j * ways[j] + ways[j - 1]) % modulus;
        }
        ways[0] = 0;
    }
    ways[k] as i32
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 200;
    let rounds = 8;
    let n = 1000;
    let mut seed = 1692;
    let mut bags: Vec[i32] = Vec.new();
    for _ in 0..count {
        bags.push((next_random(mut seed) % n + 1) as i32);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for k in bags.iter() {
            let answer = ways_to_distribute(n as i32, k);
            total += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} problems of {n} candies, {rounds} rounds: answers sum to {total}, checksum {check}");
}
