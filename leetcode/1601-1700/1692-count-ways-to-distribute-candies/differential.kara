// LeetCode #1692: Count Ways to Distribute Candies -- the differential.
//
// Four arms against the statement read literally, on 3000 random problems
// of n from 1 to 8 candies and k from 1 to n bags.
//
// P1  the answer is the statement read literally
// P2  n candies in n bags, and in one bag, go one way each
// P3  the answer is k times the arm's answer for n - 1 candies in k bags,
//     plus its answer for n - 1 in k - 1
// P4  the arm's answers for 1 to n bags sum to the Bell number of n
// P5  each arm agrees with at least two of the other three

// ---- candies.kara: the ★ arm: one row of the Stirling numbers at a time

fn star_arm(n: i32, k: i32) -> i32 {
    let modulus = 1000000007;
    let mut ways = Vec.filled(k + 1, 0);
    ways[0] = 1;
    for i in 1..=n {
        for j in (1..=min(i, k)).rev() {
            ways[j] = (j * ways[j] + ways[j - 1]) % modulus;
        }
        ways[0] = 0;
    }
    ways[k] as i32
}

// ---- candies_table.kara: the whole table

fn table_arm(n: i32, k: i32) -> i32 {
    let modulus: i64 = 1000000007;
    let rows = n as i64 + 1;
    let cols = k as i64 + 1;
    let mut table: Vec[Vec[i64]] = Vec.filled(rows, Vec.filled(cols, 0));
    table[0][0] = 1;
    for i in 1..rows {
        for j in 1..cols {
            table[i][j] = (j * table[i - 1][j] + table[i - 1][j - 1]) % modulus;
        }
    }
    table[n][k] as i32
}

// ---- candies_inclusion.kara: inclusion and exclusion over the empty bags

fn power(base: i64, exponent: i64, modulus: i64) -> i64 {
    let mut result = 1;
    let mut b = base % modulus;
    let mut e = exponent;
    while e > 0 {
        if e & 1 == 1 {
            result = result * b % modulus;
        }
        b = b * b % modulus;
        e >>= 1;
    }
    result
}

fn inclusion_arm(n: i32, k: i32) -> i32 {
    let modulus = 1000000007;
    let mut factorial = Vec.filled(k + 1, 1);
    for i in 1..=k {
        factorial[i] = factorial[i - 1] * i % modulus;
    }
    let inverse = |x| power(x, modulus - 2, modulus);
    let mut labelled = 0;
    for i in 0..=k {
        let choose = factorial[k] * inverse(factorial[i]) % modulus * inverse(factorial[k - i]) % modulus;
        let term = choose * power(k - i, n, modulus) % modulus;
        if i % 2 == 0 {
            labelled = (labelled + term) % modulus;
        } else {
            labelled = (labelled - term + modulus) % modulus;
        }
    }
    (labelled * inverse(factorial[k]) % modulus) as i32
}

// ---- candies_memo.kara: the recurrence from the top, each answer remembered

fn memo_ways(i: i64, j: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if j == 0 or j > i {
        return 0;
    }
    if j == i or j == 1 {
        return 1;
    }
    if let Some(known) = memo.get((i, j)) {
        return known;
    }
    let answer = (j * memo_ways(i - 1, j, mut memo) + memo_ways(i - 1, j - 1, mut memo)) % 1000000007;
    memo.insert((i, j), answer);
    answer
}

fn memo_arm(n: i32, k: i32) -> i32 {
    let mut memo = Map.new();
    memo_ways(n, k, mut memo) as i32
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: candy i goes into one of the bags used so
// far or, while fewer than k are used, into a new one, so that each way is
// met once, its bags named in the order they are first used. A way counts
// when all k bags hold a candy.
fn place(i: i64, n: i64, k: i64, used: i64) -> i64 {
    if i == n {
        return if used == k { 1 } else { 0 };
    }
    let mut count = used * place(i + 1, n, k, used);
    if used < k {
        count += place(i + 1, n, k, used + 1);
    }
    count
}

fn literal(n: i64, k: i64) -> i64 {
    place(0, n, k, 0)
}

// the Bell number of n, the ways to split n candies into any number of
// bags, from Bell's triangle
fn bell(n: i64) -> i64 {
    let mut row = [1];
    for _ in 1..n {
        let mut next = [row[row.len() - 1]];
        for v in row.iter() {
            next.push(next[next.len() - 1] + v);
        }
        row = next;
    }
    row[row.len() - 1]
}

fn arm(a: i64, n: i64, k: i64) -> i64 {
    let n = n as i32;
    let k = k as i32;
    match a {
        0 => star_arm(n, k),
        1 => table_arm(n, k),
        2 => inclusion_arm(n, k),
        _ => memo_arm(n, k),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "table", "inclusion", "memo"][a]
}

fn main() {
    let mut seed = 1692;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(i64, i64)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 8 + 1;
        let k = next_random(mut seed) % n + 1;
        cases.push((n, k));
    }
    for (p, (n, k)) in cases.iter().enumerate() {
        let want = literal(n, k);
        check = (check * 31 + want + n + k) % 1000000007;
        let mut answers: Vec[i64] = Vec.new();
        for a in 0..4 {
            let got = arm(a, n, k);
            answers.push(got);
            let before = if n == 1 or k == n { 0 } else { arm(a, n - 1, k) };
            let fewer = if n == 1 or k == 1 { 0 } else { arm(a, n - 1, k - 1) };
            let all: i64 = (1..=n).map(|j| arm(a, n, j)).sum();
            let failed = [
                got != want,
                arm(a, n, n) != 1 or arm(a, n, 1) != 1,
                n > 1 and got != k * before + fewer,
                all != bell(n),
            ];
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} (n {n}, k {k}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
