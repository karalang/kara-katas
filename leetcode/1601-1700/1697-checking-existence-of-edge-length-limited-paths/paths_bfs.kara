// LeetCode #1697: Checking Existence of Edge Length Limited Paths -- a
// search for each query.
//
// The graph as adjacency lists of (node, length); each query walks it
// breadth first from p by the edges shorter than its limit and asks
// whether q is reached. O(Q * (n + E)).

fn distance_limited_paths_exist(n: i32, edge_list: Vec[Vec[i32]], queries: Vec[Vec[i32]]) -> Vec[bool] {
    let mut next: Vec[Vec[(i64, i32)]] = Vec.filled(n, Vec.new());
    for e in edge_list.iter() {
        next[e[0]].push((e[1], e[2]));
        next[e[1]].push((e[0], e[2]));
    }
    let mut answer: Vec[bool] = Vec.new();
    for query in queries.iter() {
        let (p, q, limit) = (query[0], query[1], query[2]);
        let mut seen = Vec.filled(n, false);
        seen[p] = true;
        let mut waiting: VecDeque[i64] = VecDeque.new();
        waiting.push_back(p);
        while let Some(at) = waiting.pop_front() {
            for (to, length) in next[at].iter() {
                if length < limit and not seen[to] {
                    seen[to] = true;
                    waiting.push_back(to);
                }
            }
        }
        answer.push(seen[q]);
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random graphs of 2 to `most` nodes, each with up to 2 * `most`
// edges and up to `most` queries, lengths and limits from 1 to `top`;
// the answers that are true, and a checksum of every answer
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut trues = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (most - 1) + 2;
        let mut edges: Vec[Vec[i32]] = Vec.new();
        for _ in 0..next_random(mut seed) % (2 * most) + 1 {
            let u = next_random(mut seed) % n;
            let v = (u + 1 + next_random(mut seed) % (n - 1)) % n;
            edges.push([u as i32, v as i32, (next_random(mut seed) % top + 1) as i32]);
        }
        let mut queries: Vec[Vec[i32]] = Vec.new();
        for _ in 0..next_random(mut seed) % most + 1 {
            let p = next_random(mut seed) % n;
            let q = (p + 1 + next_random(mut seed) % (n - 1)) % n;
            queries.push([p as i32, q as i32, (next_random(mut seed) % top + 1) as i32]);
        }
        let answer = distance_limited_paths_exist(n as i32, edges, queries);
        for a in answer.iter() {
            if a {
                trues += 1;
            }
            check = (check * 31 + if a { 2 } else { 1 }) % 1000000007;
        }
    }
    println(f"{count} graphs of up to {most} nodes, lengths up to {top}: {trues} true, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then a limit equal to the only edge's
    // length, and two nodes joined twice
    println(distance_limited_paths_exist(3, [[0, 1, 2], [1, 2, 4], [2, 0, 8], [1, 0, 16]], [[0, 1, 2], [0, 2, 5]]));
    println(distance_limited_paths_exist(5, [[0, 1, 10], [1, 2, 5], [2, 3, 9], [3, 4, 13]], [[0, 4, 14], [1, 4, 13]]));
    println(distance_limited_paths_exist(2, [[0, 1, 3]], [[0, 1, 3], [1, 0, 4]]));
    println(distance_limited_paths_exist(2, [[0, 1, 7], [1, 0, 2]], [[0, 1, 3], [0, 1, 2]]));
    let mut seed = 1697;
    batch(3000, 6, 5, mut seed);
    batch(300, 100, 100, mut seed);
    batch(10, 2000, 1000000000, mut seed);
}
