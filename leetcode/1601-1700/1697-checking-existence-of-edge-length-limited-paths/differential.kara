// LeetCode #1697: Checking Existence of Edge Length Limited Paths --
// the differential.
//
// Four arms against the statement read literally, on 3000 random graphs
// of 2 to 6 nodes and 1 to 8 edges, with 1 to 6 queries, lengths and
// limits from 1 to 5.
//
// P1  the answers are the statement read literally
// P2  each query's two nodes swapped give the same answers
// P3  each limit raised by one turns no answer from true to false
// P4  the edges listed in reverse give the same answers
// P5  each arm agrees with at least two of the other three

// ---- paths.kara: the ★ arm: the queries answered offline, by rising limit, over a union-find

// the root of x's set, every node on the way pointed at it
fn star_find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut root = x;
    while parent[root] != root {
        root = parent[root];
    }
    let mut at = x;
    while parent[at] != root {
        let next = parent[at];
        parent[at] = root;
        at = next;
    }
    root
}

fn star_arm(n: i32, edge_list: Vec[Vec[i32]], queries: Vec[Vec[i32]]) -> Vec[bool] {
    let mut edges = edge_list.clone();
    edges.sort_by_key(|e| e[2]);
    let mut order: Vec[i64] = (0..queries.len()).collect();
    order.sort_by_key(|i| queries[i][2]);
    let mut parent: Vec[i64] = (0..n as i64).collect();
    let mut answer = Vec.filled(queries.len(), false);
    let mut joined = 0;
    for i in order.iter() {
        let limit = queries[i][2];
        while joined < edges.len() and edges[joined][2] < limit {
            let a = star_find(mut parent, edges[joined][0]);
            let b = star_find(mut parent, edges[joined][1]);
            parent[a] = b;
            joined += 1;
        }
        answer[i] = star_find(mut parent, queries[i][0]) == star_find(mut parent, queries[i][1]);
    }
    answer
}

// ---- paths_bfs.kara: a search for each query

fn bfs_arm(n: i32, edge_list: Vec[Vec[i32]], queries: Vec[Vec[i32]]) -> Vec[bool] {
    let mut next: Vec[Vec[(i64, i32)]] = Vec.filled(n, Vec.new());
    for e in edge_list.iter() {
        next[e[0]].push((e[1], e[2]));
        next[e[1]].push((e[0], e[2]));
    }
    let mut answer: Vec[bool] = Vec.new();
    for query in queries.iter() {
        let (p, q, limit) = (query[0], query[1], query[2]);
        let mut seen = Vec.filled(n, false);
        seen[p] = true;
        let mut waiting: VecDeque[i64] = VecDeque.new();
        waiting.push_back(p);
        while let Some(at) = waiting.pop_front() {
            for (to, length) in next[at].iter() {
                if length < limit and not seen[to] {
                    seen[to] = true;
                    waiting.push_back(to);
                }
            }
        }
        answer.push(seen[q]);
    }
    answer
}

// ---- paths_forest.kara: the minimum spanning forest, then the longest edge on each tree path

fn root_of(parent: mut ref Vec[i64], x: i64) -> i64 {
    if parent[x] == x {
        return x;
    }
    let root = root_of(mut parent, parent[x]);
    parent[x] = root;
    root
}

fn forest_arm(n: i32, edge_list: Vec[Vec[i32]], queries: Vec[Vec[i32]]) -> Vec[bool] {
    let mut edges = edge_list.clone();
    edges.sort_by_key(|e| e[2]);
    let mut sets: Vec[i64] = (0..n as i64).collect();
    let mut tree: Vec[Vec[(i64, i32)]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        let a = root_of(mut sets, e[0]);
        let b = root_of(mut sets, e[1]);
        if a != b {
            sets[a] = b;
            tree[e[0]].push((e[1], e[2]));
            tree[e[1]].push((e[0], e[2]));
        }
    }
    // each tree rooted at its first node: parent, the length up, the depth
    let mut up: Vec[i64] = Vec.filled(n, -1);
    let mut length: Vec[i32] = Vec.filled(n, 0);
    let mut depth: Vec[i64] = Vec.filled(n, -1);
    for start in 0..n as i64 {
        if depth[start] >= 0 {
            continue;
        }
        depth[start] = 0;
        let mut stack = [start];
        while let Some(at) = stack.pop() {
            for (to, l) in tree[at].iter() {
                if depth[to] < 0 {
                    depth[to] = depth[at] + 1;
                    up[to] = at;
                    length[to] = l;
                    stack.push(to);
                }
            }
        }
    }
    let mut answer: Vec[bool] = Vec.new();
    for query in queries.iter() {
        let mut (a, b) = (query[0] as i64, query[1] as i64);
        let mut longest = 0;
        while a != b and (up[a] >= 0 or up[b] >= 0) {
            if depth[a] >= depth[b] and up[a] >= 0 {
                longest = max(longest, length[a]);
                a = up[a];
            } else {
                longest = max(longest, length[b]);
                b = up[b];
            }
        }
        answer.push(a == b and longest < query[2]);
    }
    answer
}

// ---- paths_solution.kara: LeetCode's Rust template as karac fix left it

fn solution_find(parent: mut ref Vec[i64], x: i64) -> i64 {
    if parent[x] != x {
        let p = parent[x];
        parent[x] = solution_find(mut parent, p);
    }
    parent[x]
}

struct SolutionArm {}

impl SolutionArm {
    pub fn distance_limited_paths_exist(n: i32, edge_list: own Vec[Vec[i32]], queries: Vec[Vec[i32]]) -> Vec[bool] {
        let mut edge_list = edge_list;
        edge_list.sort_by_key(|e| e[2]);
        let mut order: Vec[i64] = (0..queries.len()).collect();
        order.sort_by_key(|i| queries[i][2]);
        let mut parent: Vec[i64] = (0..n as i64).collect();
        let mut ans = Vec.filled(queries.len(), false);
        let mut j = 0;
        for i in order {
            let limit = queries[i][2];
            while j < edge_list.len() and edge_list[j][2] < limit {
                let a = solution_find(mut parent, edge_list[j][0]);
                let b = solution_find(mut parent, edge_list[j][1]);
                parent[a] = b;
                j += 1;
            }
            ans[i] = solution_find(mut parent, queries[i][0]) == solution_find(mut parent, queries[i][1]);
        }
        ans
    }
}

fn solution_arm(n: i32, edge_list: own Vec[Vec[i32]], queries: Vec[Vec[i32]]) -> Vec[bool] {
    SolutionArm.distance_limited_paths_exist(n, edge_list, queries)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// whether some path from `at` to `to` that visits no node twice uses only
// edges shorter than `limit`, the nodes on the way so far in `on`
fn walk(at: i64, to: i64, limit: i32, edges: Vec[Vec[i32]], on: mut ref Vec[bool]) -> bool {
    if at == to {
        return true;
    }
    on[at] = true;
    let mut found = false;
    for e in edges.iter() {
        for (from, next) in [(e[0], e[1]), (e[1], e[0])] {
            if not found and from == at and not on[next] and e[2] < limit {
                found = walk(next, to, limit, edges, mut on);
            }
        }
    }
    on[at] = false;
    found
}

// the statement read literally: each query asks whether any path from p
// to q, every node on it once, has every edge strictly shorter than its
// limit; the paths are walked one by one
fn literal(n: i64, edges: Vec[Vec[i32]], queries: Vec[Vec[i32]]) -> Vec[bool] {
    let mut answer: Vec[bool] = Vec.new();
    for query in queries.iter() {
        let mut on = Vec.filled(n, false);
        answer.push(walk(query[0], query[1], query[2], edges, mut on));
    }
    answer
}

fn arm(a: i64, n: i64, edges: Vec[Vec[i32]], queries: Vec[Vec[i32]]) -> Vec[bool] {
    let n = n as i32;
    let edges = edges.clone();
    match a {
        0 => star_arm(n, edges, queries),
        1 => bfs_arm(n, edges, queries),
        2 => forest_arm(n, edges, queries),
        _ => solution_arm(n, edges, queries),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "bfs", "forest", "solution"][a]
}

fn main() {
    let mut seed = 1697;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(i64, Vec[Vec[i32]], Vec[Vec[i32]])] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 5 + 2;
        let mut edges: Vec[Vec[i32]] = Vec.new();
        for _ in 0..next_random(mut seed) % 8 + 1 {
            let u = next_random(mut seed) % n;
            let v = (u + 1 + next_random(mut seed) % (n - 1)) % n;
            edges.push([u as i32, v as i32, (next_random(mut seed) % 5 + 1) as i32]);
        }
        let mut queries: Vec[Vec[i32]] = Vec.new();
        for _ in 0..next_random(mut seed) % 6 + 1 {
            let p = next_random(mut seed) % n;
            let q = (p + 1 + next_random(mut seed) % (n - 1)) % n;
            queries.push([p as i32, q as i32, (next_random(mut seed) % 5 + 1) as i32]);
        }
        cases.push((n, edges, queries));
    }
    for (p, (n, edges, queries)) in cases.iter().enumerate() {
        let want = literal(n, edges, queries);
        for w in want.iter() {
            check = (check * 31 + if w { 2 } else { 1 }) % 1000000007;
        }
        check = (check * 31 + n + edges.len()) % 1000000007;
        let swapped: Vec[Vec[i32]] = queries.iter().map(|q| [q[1], q[0], q[2]]).collect();
        let raised: Vec[Vec[i32]] = queries.iter().map(|q| [q[0], q[1], q[2] + 1]).collect();
        let reversed: Vec[Vec[i32]] = edges.iter().rev().cloned().collect();
        let mut answers: Vec[Vec[bool]] = Vec.new();
        for a in 0..4 {
            let got = arm(a, n, edges, queries);
            let higher = arm(a, n, edges, raised);
            let failed = [
                got != want,
                arm(a, n, edges, swapped) != got,
                (0..got.len()).any(|j| got[j] and not higher[j]),
                arm(a, n, reversed, queries) != got,
            ];
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} (n {n}, {edges}, {queries}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
            answers.push(got);
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
