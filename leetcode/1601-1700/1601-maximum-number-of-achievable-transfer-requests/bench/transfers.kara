// LeetCode #1601: Maximum Number of Achievable Transfer Requests -- the
// bench: the ★ arm on 100 problems of 16 requests among 6 buildings, all
// drawn first.
//
// The ★ arm: every subset of the requests as a bit mask, a subset no
// larger than the best skipped.

fn maximum_requests(n: i32, requests: Vec[Vec[i32]]) -> i32 {
    let r = requests.len();
    let mut best = 0;
    for mask in 0..1 << r {
        let size = mask.count_ones() as i32;
        if size <= best {
            continue;
        }
        let mut net = Vec.filled(n, 0);
        for i in 0..r {
            if mask >> i & 1 == 1 {
                net[requests[i][0]] -= 1;
                net[requests[i][1]] += 1;
            }
        }
        if net.iter().all(|d| *d == 0) {
            best = size;
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1601;
    let mut problems: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..100 {
        let requests: Vec[Vec[i32]] = (0..16).map(|_| [(next_random(mut seed) % 6) as i32, (next_random(mut seed) % 6) as i32]).collect();
        problems.push(requests);
    }
    let mut check = 0;
    let mut total = 0;
    for requests in problems.iter() {
        let answer = maximum_requests(6, requests);
        total += answer;
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"100 problems of 16 requests among 6 buildings: total {total}, checksum {check}");
}
