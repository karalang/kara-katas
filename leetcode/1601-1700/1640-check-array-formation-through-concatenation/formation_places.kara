// LeetCode #1640: Check Array Formation Through Concatenation -- every
// value's place.
//
// The values are distinct, so each has one place in the array. The array
// can be formed exactly when every piece's values sit at consecutive
// places, in order, and the pieces hold as many values as the array:
// distinct values in pieces that each fit then cover it once. O(n).

fn can_form_array(arr: Vec[i32], pieces: Vec[Vec[i32]]) -> bool {
    let place: Map[i32, i64] = arr.iter().enumerate().map(|(k, v)| (v, k)).collect();
    let mut covered = 0;
    for piece in pieces.iter() {
        let Some(first) = place.get(piece[0]) else {
            return false;
        };
        for (k, value) in piece.iter().enumerate() {
            if place.get(value).cloned() != Some(first + k) {
                return false;
            }
        }
        covered += piece.len();
    }
    covered == arr.len()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// distinct values 1 to `top`, `n` of them, in a random order
fn distinct(n: i64, top: i64, seed: mut ref i64) -> Vec[i32] {
    let mut chosen: Set[i64] = Set.new();
    let mut values: Vec[i32] = Vec.new();
    while values.len() < n {
        let v = next_random(mut seed) % top + 1;
        if chosen.insert(v) {
            values.push(v as i32);
        }
    }
    values
}

// `count` random cases: an array of 1 to `most` distinct values cut into
// pieces and shuffled, then one change (none, two values swapped inside
// the array, or a value replaced) to make some cases fail; the trues
// counted, and a checksum
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut trues = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut arr = distinct(n, 2 * most, mut seed);
        let mut pieces: Vec[Vec[i32]] = Vec.new();
        let mut start = 0;
        while start < n {
            let end = min(n, start + next_random(mut seed) % 3 + 1);
            pieces.push(arr[start..end].to_vec());
            start = end;
        }
        for k in (1..pieces.len()).rev() {
            let j = next_random(mut seed) % (k + 1);
            pieces.swap(k, j);
        }
        let change = next_random(mut seed) % 3;
        if change == 1 and n > 1 {
            let (a, b) = (next_random(mut seed) % n, next_random(mut seed) % n);
            arr.swap(a, b);
        } else if change == 2 {
            let k = next_random(mut seed) % n;
            arr[k] = (2 * most + 1) as i32;
        }
        let formed = can_form_array(arr, pieces);
        if formed {
            trues += 1;
        }
        check = (check * 31 + if formed { 2 } else { 1 }) % 1000000007;
    }
    println(f"{count} cases of up to {most} values: {trues} can be formed, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, and a piece in the
    // wrong order inside
    println(can_form_array([15, 88], [[88], [15]]));
    println(can_form_array([49, 18, 16], [[16, 18, 49]]));
    println(can_form_array([91, 4, 64, 78], [[78], [4, 64], [91]]));
    println(can_form_array([1], [[1]]));
    println(can_form_array([1, 2, 3], [[1], [3, 2]]));
    let mut seed = 1640;
    batch(3000, 6, mut seed);
    batch(300, 100, mut seed);
    batch(20, 5000, mut seed);
}
