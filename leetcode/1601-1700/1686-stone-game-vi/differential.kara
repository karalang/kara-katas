// LeetCode #1686: Stone Game VI -- the differential.
//
// Four arms against the statement read literally, on 3000 random games
// of 1 to 10 stones.
//
// P1  the answer is the statement read literally
// P2  the stones in reverse order give the same answer
// P3  every value doubled gives the same answer
// P4  two stones worth 100 to both added give the same answer
// P5  each arm agrees with at least two of the other three

// ---- stones.kara: the ★ arm: the stones by their worth to both players

fn star_arm(alice: Vec[i32], bob: Vec[i32]) -> i32 {
    let n = alice.len();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by_key(|i| -(alice[i] + bob[i]));
    let mut difference: i32 = 0;
    for (turn, i) in order.iter().enumerate() {
        if turn % 2 == 0 {
            difference += alice[i];
        } else {
            difference -= bob[i];
        }
    }
    difference.signum()
}

// ---- stones_count.kara: the stones counted by weight

fn count_arm(alice: Vec[i32], bob: Vec[i32]) -> i32 {
    let mut count = [0; 201];
    let mut worth = [0; 201];
    for i in 0..alice.len() {
        let w = alice[i] + bob[i];
        count[w] += 1;
        worth[w] += alice[i];
    }
    let mut turn = 0;
    let mut difference = 0;
    for w in (2..=200).rev() {
        let c = count[w];
        // the odd turns among turn, turn + 1, .., turn + c - 1
        let bobs = (turn + c) / 2 - turn / 2;
        difference += worth[w] - bobs * w;
        turn += c;
    }
    if difference > 0 {
        1
    } else if difference < 0 {
        -1
    } else {
        0
    }
}

// ---- stones_heap.kara: a max-first priority queue of the stones

fn heap_arm(alice: Vec[i32], bob: Vec[i32]) -> i32 {
    let mut heap = PriorityQueue.max_first();
    for i in 0..alice.len() {
        heap.push((alice[i] + bob[i], alice[i], bob[i]));
    }
    let mut totals = [0, 0];
    let mut turn = 0;
    while let Some((_, a, b)) = heap.pop() {
        totals[turn] += if turn == 0 { a } else { b };
        turn = 1 - turn;
    }
    match totals[0].cmp(totals[1]) {
        Ordering.Greater => 1,
        Ordering.Less => -1,
        Ordering.Equal => 0,
    }
}

// ---- stones_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn stone_game_vi(alice_values: Vec[i32], bob_values: Vec[i32]) -> i32 {
        let mut v: Vec[(i32, i32, i32)] = alice_values
            .iter()
            .zip(bob_values.iter())
            .map(|(a, b)| (a + b, a, b))
            .collect();
        v.sort_by(|x, y| y.0.cmp(x.0));
        let mut (alice, bob) = (0, 0);
        for (i, (_, a, b)) in v.iter().enumerate() {
            if i % 2 == 0 {
                alice += a;
            } else {
                bob += b;
            }
        }
        match alice.cmp(bob) { Ordering.Less => -1i32, Ordering.Equal => 0i32, Ordering.Greater => 1i32 }
    }
}

fn solution_arm(alice: Vec[i32], bob: Vec[i32]) -> i32 {
    SolutionArm.stone_game_vi(alice, bob)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the best the player to move can make of the stones not in `taken`: the
// most their total can exceed the other's from here, over every stone
// they could take next, the other then doing the same
fn best(taken: i64, mover: i64, alice: Vec[i32], bob: Vec[i32], memo: mut ref Vec[Option[i64]]) -> i64 {
    let n = alice.len();
    if taken == (1 << n) - 1 {
        return 0;
    }
    if let Some(v) = memo[taken] {
        return v;
    }
    let mut most = i64.MIN;
    for i in 0..n {
        if taken >> i & 1 == 0 {
            let worth = if mover == 0 { alice[i] } else { bob[i] };
            let v = worth - best(taken | 1 << i, 1 - mover, alice, bob, mut memo);
            most = max(most, v);
        }
    }
    memo[taken] = Some(most);
    most
}

// the statement read literally: both play optimally, Alice first. The
// outcome is the sign of the best difference she can force, since a better
// difference is never a worse result
fn literal(alice: Vec[i32], bob: Vec[i32]) -> i32 {
    let mut memo = Vec.filled(1 << alice.len(), None);
    let d = best(0, 0, alice, bob, mut memo);
    if d > 0 {
        1
    } else if d < 0 {
        -1
    } else {
        0
    }
}

fn arm(a: i64, alice: Vec[i32], bob: Vec[i32]) -> i32 {
    match a {
        0 => star_arm(alice, bob),
        1 => count_arm(alice, bob),
        2 => heap_arm(alice, bob),
        _ => solution_arm(alice, bob),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "count", "heap", "solution"][a]
}

fn main() {
    let mut seed = 1686;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    // 1 to 10 stones, each worth 1 to `top` to each player
    let mut cases: Vec[(Vec[i32], Vec[i32])] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 10 + 1;
        let top = next_random(mut seed) % 6 + 1;
        let mut alice: Vec[i32] = Vec.new();
        let mut bob: Vec[i32] = Vec.new();
        for _ in 0..n {
            alice.push((next_random(mut seed) % top + 1) as i32);
            bob.push((next_random(mut seed) % top + 1) as i32);
        }
        cases.push((alice, bob));
    }
    for (p, (alice, bob)) in cases.iter().enumerate() {
        let want = literal(alice, bob);
        check = (check * 31 + want + 2) % 1000000007;
        check = (check * 31 + alice.len()) % 1000000007;
        let alice_reversed: Vec[i32] = alice.iter().rev().cloned().collect();
        let bob_reversed: Vec[i32] = bob.iter().rev().cloned().collect();
        let alice_doubled: Vec[i32] = alice.iter().map(|v| 2 * v).collect();
        let bob_doubled: Vec[i32] = bob.iter().map(|v| 2 * v).collect();
        let mut alice_more = alice.clone();
        let mut bob_more = bob.clone();
        alice_more.extend([100, 100]);
        bob_more.extend([100, 100]);
        let mut answers: Vec[i32] = Vec.new();
        for a in 0..4 {
            let got = arm(a, alice, bob);
            let failed = [
                got != want,
                arm(a, alice_reversed, bob_reversed) != got,
                arm(a, alice_doubled, bob_doubled) != got,
                arm(a, alice_more, bob_more) != got,
            ];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({alice} {bob}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
