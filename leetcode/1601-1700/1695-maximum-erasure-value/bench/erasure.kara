// LeetCode #1695: Maximum Erasure Value -- the bench: the ★ arm on 50
// random arrays of 100000 values up to 10^4, LeetCode's largest, all drawn
// first, each answered 60 times.
//
// The window ending at i starts just after the last place any value in it
// was seen before; its sum is a difference of prefix sums. O(n).

fn maximum_unique_subarray(nums: Vec[i32]) -> i32 {
    let mut last: Vec[i64] = Vec.filled(10001, -1);
    let mut prefix: Vec[i32] = Vec.filled(nums.len() + 1, 0);
    let mut start = 0;
    let mut best = 0;
    for (i, v) in nums.iter().enumerate() {
        prefix[i + 1] = prefix[i] + v;
        start = max(start, last[v] + 1);
        last[v] = i;
        best = max(best, prefix[i + 1] - prefix[start]);
    }
    best
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 50;
    let rounds = 60;
    let n = 100000;
    let mut seed = 1695;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    for _ in 0..count {
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) % 10000 + 1) as i32);
        }
        arrays.push(nums);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in arrays.iter() {
            let answer = maximum_unique_subarray(nums);
            total += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {n} values, {rounds} rounds: answers sum to {total}, checksum {check}");
}
