// LeetCode #1642: Furthest Building You Can Reach -- bricks first.
//
// The mirror image of the ★ arm: pay for every climb in bricks, keeping
// the climbs paid so in a largest-first heap (a `PriorityQueue` of
// `Reverse`d climbs here, since it pops smallest first). When the bricks
// run short, take back the largest climb paid so and spend a ladder on it
// instead; with no ladder left, this building is the end. O(n log n).

import std.cmp.Reverse;

fn furthest_building(heights: Vec[i32], bricks: i32, ladders: i32) -> i64 {
    let mut paid: PriorityQueue[Reverse[i32]] = PriorityQueue.new();
    let mut (bricks, ladders) = (bricks as i64, ladders);
    for i in 1..heights.len() {
        let climb = heights[i] - heights[i - 1];
        if climb <= 0 {
            continue;
        }
        paid.push(Reverse { value: climb });
        bricks -= climb;
        if bricks < 0 {
            if ladders == 0 {
                return i - 1;
            }
            let Reverse { value: largest } = paid.pop().unwrap();
            bricks += largest;
            ladders -= 1;
        }
    }
    heights.len() - 1
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random rows of 1 to `most` buildings up to `top` high, with
// bricks up to `top` times a third of the row and up to a tenth of the
// row in ladders; the furthest indices summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut heights: Vec[i32] = Vec.new();
        for _ in 0..n {
            heights.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1) as i32);
        }
        let bricks = ((next_random(mut seed) * 32768 + next_random(mut seed)) % (top * (n / 3 + 1))) as i32;
        let ladders = (next_random(mut seed) % (n / 10 + 2)) as i32;
        let furthest = furthest_building(heights, bricks, ladders);
        total += furthest;
        check = (check * 31 + furthest + 1) % 1000000007;
    }
    println(f"{count} rows of up to {most} buildings: indices sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one building, all downhill, and
    // nothing to climb with
    println(furthest_building([4, 2, 7, 6, 9, 14, 12], 5, 1));
    println(furthest_building([4, 12, 2, 7, 3, 18, 20, 3, 19], 10, 2));
    println(furthest_building([14, 3, 19, 3], 17, 0));
    println(furthest_building([5], 0, 0));
    println(furthest_building([9, 7, 4, 1], 0, 0));
    println(furthest_building([1, 2], 0, 0));
    let mut seed = 1642;
    batch(3000, 8, 5, mut seed);
    batch(300, 1000, 1000000, mut seed);
    batch(5, 100000, 1000000, mut seed);
}
