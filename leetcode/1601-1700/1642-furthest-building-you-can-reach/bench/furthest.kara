// LeetCode #1642: Furthest Building You Can Reach -- the bench: the ★ arm
// on 50 random rows of 100000 buildings up to 10^4 high, each with up to
// 10^9 bricks and up to 5000 ladders, all drawn first.

fn furthest_building(heights: Vec[i32], bricks: i32, ladders: i32) -> i64 {
    let mut laddered: PriorityQueue[i32] = PriorityQueue.new();
    let mut bricks = bricks;
    for i in 1..heights.len() {
        let climb = heights[i] - heights[i - 1];
        if climb <= 0 {
            continue;
        }
        laddered.push(climb);
        if laddered.len() > ladders {
            bricks -= laddered.pop().unwrap();
            if bricks < 0 {
                return i - 1;
            }
        }
    }
    heights.len() - 1
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1642;
    let mut rows: Vec[(Vec[i32], i32, i32)] = Vec.new();
    for _ in 0..50 {
        let mut heights: Vec[i32] = Vec.new();
        for _ in 0..100000 {
            heights.push((next_random(mut seed) % 10000 + 1) as i32);
        }
        let bricks = ((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001) as i32;
        let ladders = (next_random(mut seed) % 5001) as i32;
        rows.push((heights, bricks, ladders));
    }
    let mut check = 0;
    let mut total = 0;
    for (heights, bricks, ladders) in rows.iter() {
        let furthest = furthest_building(heights, bricks, ladders);
        total += furthest;
        check = (check * 31 + furthest + 1) % 1000000007;
    }
    println(f"50 rows of 100000 buildings: indices sum to {total}, checksum {check}");
}
