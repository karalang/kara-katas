// LeetCode #1691: Maximum Height by Stacking Cuboids -- the ★ arm: sides
// sorted, cuboids sorted, the tallest stack ending at each.
//
// A best stack stands every cuboid on its two shorter sides, its longest
// side up: with each cuboid's sides sorted, one fits on another when each
// side is no longer. Sorted as lists, a cuboid can only stand on one
// before it, so best[i], the tallest stack with cuboid i on top, is its
// height plus the best of those it fits on. O(n^2).

fn max_height(cuboids: Vec[Vec[i32]]) -> i32 {
    let mut boxes: Vec[Vec[i32]] = cuboids
        .iter()
        .map(|c| {
            let mut sides = c.clone();
            sides.sort();
            sides
        })
        .collect();
    boxes.sort();
    let n = boxes.len();
    let mut best: Vec[i32] = Vec.filled(n, 0);
    let mut tallest = 0;
    for i in 0..n {
        best[i] = boxes[i][2];
        for j in 0..i {
            if boxes[j][0] <= boxes[i][0] and boxes[j][1] <= boxes[i][1] and boxes[j][2] <= boxes[i][2] {
                best[i] = max(best[i], best[j] + boxes[i][2]);
            }
        }
        tallest = max(tallest, best[i]);
    }
    tallest
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random sets of 1 to `most` cuboids with sides 1 to `top`; the
// answers summed, and a checksum of them
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut cuboids: Vec[Vec[i32]] = Vec.new();
        for _ in 0..n {
            let mut sides: Vec[i32] = Vec.new();
            for _ in 0..3 {
                sides.push((next_random(mut seed) % top + 1) as i32);
            }
            cuboids.push(sides);
        }
        let answer = max_height(cuboids);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} sets of up to {most} cuboids up to {top}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, and one cuboid
    println(max_height([[50, 45, 20], [95, 37, 53], [45, 23, 12]]));
    println(max_height([[38, 25, 45], [76, 35, 3]]));
    println(max_height([[7, 11, 17], [7, 17, 11], [11, 7, 17], [11, 17, 7], [17, 7, 11], [17, 11, 7]]));
    println(max_height([[1, 2, 3]]));
    let mut seed = 1691;
    batch(3000, 6, 5, mut seed);
    batch(300, 30, 50, mut seed);
    batch(30, 100, 100, mut seed);
}
