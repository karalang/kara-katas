// LeetCode #1691: Maximum Height by Stacking Cuboids -- the longest path
// in the graph of fits, in Kahn's order.
//
// Sides sorted as in the ★ arm. An edge runs from j to i when j fits on i
// (equal cuboids by index, so the graph has no cycle); a cuboid comes off
// a `VecDeque` once every cuboid that fits on it has, and passes its
// tallest stack up to the ones it fits on. O(n^2).

fn max_height(cuboids: Vec[Vec[i32]]) -> i32 {
    let n = cuboids.len();
    let mut boxes: Vec[Vec[i32]] = cuboids.clone();
    for sides in boxes.iter_mut() {
        sides.sort();
    }
    let mut under: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    let mut waiting: Vec[i64] = Vec.filled(n, 0);
    for j in 0..n {
        for i in 0..n {
            let fits = boxes[j][0] <= boxes[i][0] and boxes[j][1] <= boxes[i][1] and boxes[j][2] <= boxes[i][2];
            if i != j and fits and (boxes[j] != boxes[i] or j < i) {
                under[j].push(i);
                waiting[i] += 1;
            }
        }
    }
    let mut ready: VecDeque[i64] = VecDeque.new();
    for i in 0..n {
        if waiting[i] == 0 {
            ready.push_back(i);
        }
    }
    let mut best: Vec[i32] = boxes.iter().map(|b| b[2]).collect();
    while let Some(j) = ready.pop_front() {
        for i in under[j].iter() {
            best[i] = max(best[i], best[j] + boxes[i][2]);
            waiting[i] -= 1;
            if waiting[i] == 0 {
                ready.push_back(i);
            }
        }
    }
    best.iter().max().unwrap()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random sets of 1 to `most` cuboids with sides 1 to `top`; the
// answers summed, and a checksum of them
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut cuboids: Vec[Vec[i32]] = Vec.new();
        for _ in 0..n {
            let mut sides: Vec[i32] = Vec.new();
            for _ in 0..3 {
                sides.push((next_random(mut seed) % top + 1) as i32);
            }
            cuboids.push(sides);
        }
        let answer = max_height(cuboids);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} sets of up to {most} cuboids up to {top}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, and one cuboid
    println(max_height([[50, 45, 20], [95, 37, 53], [45, 23, 12]]));
    println(max_height([[38, 25, 45], [76, 35, 3]]));
    println(max_height([[7, 11, 17], [7, 17, 11], [11, 7, 17], [11, 17, 7], [17, 7, 11], [17, 11, 7]]));
    println(max_height([[1, 2, 3]]));
    let mut seed = 1691;
    batch(3000, 6, 5, mut seed);
    batch(300, 30, 50, mut seed);
    batch(30, 100, 100, mut seed);
}
