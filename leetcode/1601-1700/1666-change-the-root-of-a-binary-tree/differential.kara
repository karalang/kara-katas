// LeetCode #1666: Change the Root of a Binary Tree -- the differential.
//
// Three arms against the statement read literally, on 3000 random trees
// of 2 to 8 nodes, each turned to hang from a random leaf. Each arm is
// given a tree of its own.
//
// P1  the new tree is the statement read literally
// P2  every parent link names the node above it, and the root's none
// P3  the new tree holds every node once
// P4  the leaf is the root, and the old root as deep as the leaf was
// P5  the three arms agree

// ---- flip.kara: the ★ arm: up from the leaf

fn star_arm(root: Node, leaf: Node) -> Node {
    let mut cur = leaf;
    let mut below: Option[Node] = None;
    loop {
        let above = cur.parent;
        cur.parent = below;
        let Some(p) = above else {
            break;
        };
        if p.left.is_some_and(|l| l.ref_eq(cur)) {
            p.left = None;
        } else {
            p.right = None;
        }
        if cur.left.is_some() {
            cur.right = cur.left;
        }
        cur.left = Some(p);
        below = Some(cur);
        cur = p;
    }
    leaf
}

// ---- flip_recursive.kara: recursive

fn recursive_hang(node: Node, below: Option[Node]) {
    let above = node.parent;
    node.parent = below;
    if let Some(b) = below {
        if node.left.is_some_and(|l| l.ref_eq(b)) {
            node.left = None;
        } else {
            node.right = None;
        }
    }
    if let Some(p) = above {
        if node.left.is_some() {
            node.right = node.left;
        }
        recursive_hang(p, Some(node));
        node.left = Some(p);
    }
}

fn recursive_arm(root: Node, leaf: Node) -> Node {
    recursive_hang(leaf, None);
    leaf
}

// ---- flip_path.kara: the path first

fn path_arm(root: Node, leaf: Node) -> Node {
    let mut path = [leaf];
    while let Some(p) = path[path.len() - 1].parent {
        path.push(p);
    }
    for i in 1..path.len() {
        let (child, p) = (path[i - 1], path[i]);
        if p.left.is_some_and(|l| l.ref_eq(child)) {
            p.left = None;
        } else {
            p.right = None;
        }
    }
    for i in 0..path.len() - 1 {
        let (node, p) = (path[i], path[i + 1]);
        if node.left.is_some() {
            node.right = node.left;
        }
        node.left = Some(p);
        p.parent = node;
    }
    leaf.parent = None;
    leaf
}

// ---- the harness ----------------------------------------------------------

shared struct Node {
    mut val: i32,
    mut left: Option[Node],
    mut right: Option[Node],
    mut parent: weak Node,
}

fn leaf(val: i32) -> Node {
    Node { val: val, left: None, right: None, parent: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a tree as plain numbers: for each value, its left child, right child
// and parent, -1 for none
struct Shape {
    left: Vec[i64],
    right: Vec[i64],
    parent: Vec[i64],
}

// `n` nodes holding 0 to n - 1, each hung from a random earlier one down
// a random walk to the first free child
fn random_shape(n: i64, seed: mut ref i64) -> Shape {
    let mut values: Vec[i64] = (0..n).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        values.swap(i, j);
    }
    let mut shape = Shape { left: Vec.filled(n, -1), right: Vec.filled(n, -1), parent: Vec.filled(n, -1) };
    for i in 1..n {
        let v = values[i];
        let mut at = values[next_random(mut seed) % i];
        loop {
            let left = next_random(mut seed) % 2 == 0;
            let next = if left { shape.left[at] } else { shape.right[at] };
            if next >= 0 {
                at = next;
            } else {
                if left {
                    shape.left[at] = v;
                } else {
                    shape.right[at] = v;
                }
                shape.parent[v] = at;
                break;
            }
        }
    }
    shape
}

// the tree a shape describes, as nodes indexed by value
fn build(shape: Shape) -> Vec[Node] {
    let n = shape.left.len();
    let nodes: Vec[Node] = (0..n).map(|v| leaf(v as i32)).collect();
    for v in 0..n {
        if shape.left[v] >= 0 {
            nodes[v].left = Some(nodes[shape.left[v]]);
        }
        if shape.right[v] >= 0 {
            nodes[v].right = Some(nodes[shape.right[v]]);
        }
        if shape.parent[v] >= 0 {
            nodes[v].parent = nodes[shape.parent[v]];
        }
    }
    nodes
}

fn root_of(shape: Shape) -> i64 {
    (0..shape.parent.len()).find(|v| shape.parent[v] < 0).unwrap()
}

// the statement read literally, on the numbers: from the leaf up to the
// root, each node let go by its parent, its left child moved to the
// right, and its parent made its left child; the new tree's values in
// level order, -1 for an empty slot
fn literal(shape: Shape, from: i64) -> Vec[i64] {
    let mut left = shape.left.clone();
    let mut right = shape.right.clone();
    let mut cur = from;
    while shape.parent[cur] >= 0 {
        let p = shape.parent[cur];
        if left[p] == cur {
            left[p] = -1;
        } else {
            right[p] = -1;
        }
        if left[cur] >= 0 {
            right[cur] = left[cur];
        }
        left[cur] = p;
        cur = p;
    }
    let mut order = Vec.new();
    let mut queue = VecDeque.new();
    queue.push_back(from);
    while let Some(v) = queue.pop_front() {
        order.push(v);
        if v >= 0 {
            queue.push_back(left[v]);
            queue.push_back(right[v]);
        }
    }
    order
}

// a tree's values in level order, -1 for an empty slot
fn slots(root: Node) -> Vec[i64] {
    let mut order = Vec.new();
    let mut queue: VecDeque[Option[Node]] = VecDeque.new();
    queue.push_back(Some(root));
    while let Some(slot) = queue.pop_front() {
        match slot {
            Some(node) => {
                order.push(node.val as i64);
                queue.push_back(node.left);
                queue.push_back(node.right);
            }
            None => order.push(-1),
        }
    }
    order
}

// whether every child's parent link names the node above it, and the
// root's names none
fn links_agree(root: Node) -> bool {
    if root.parent.is_some() {
        return false;
    }
    let mut stack = [root];
    while let Some(node) = stack.pop() {
        for child in [node.left, node.right] {
            if let Some(c) = child {
                match c.parent {
                    Some(p) if p.ref_eq(node) => stack.push(c),
                    _ => return false,
                }
            }
        }
    }
    true
}

// how far below the root `node` hangs, by its parent links
fn depth(node: Node) -> i64 {
    let mut d = 0;
    let mut at = node;
    while let Some(p) = at.parent {
        d += 1;
        at = p;
    }
    d
}

fn arm(a: i64, root: Node, from: Node) -> Node {
    match a {
        0 => star_arm(root, from),
        1 => recursive_arm(root, from),
        _ => path_arm(root, from),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "recursive", "path"][a]
}

fn main() {
    let mut seed = 1666;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(Shape, i64)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 7 + 2;
        let shape = random_shape(n, mut seed);
        let leaves: Vec[i64] = (0..n)
            .filter(|v| shape.parent[v] >= 0 and shape.left[v] < 0 and shape.right[v] < 0)
            .collect();
        let from = leaves[next_random(mut seed) % leaves.len()];
        cases.push((shape, from));
    }
    for (p, (shape, from)) in cases.iter().enumerate() {
        let want = literal(shape, from);
        for v in want.iter() {
            check = (check * 31 + v + 2) % 1000000007;
        }
        let mut answers: Vec[Vec[i64]] = Vec.new();
        for a in 0..3 {
            let nodes = build(shape);
            let old_root = nodes[root_of(shape)];
            let old_depth = depth(nodes[from]);
            let got = arm(a, old_root, nodes[from]);
            let order = slots(got);
            let mut seen: Vec[i64] = order.iter().filter(|v| v >= 0).collect();
            seen.sort();
            let failed = [
                order != want,
                not links_agree(got),
                seen != Vec[i64].from_iter(0..shape.left.len()),
                got.val != from or depth(old_root) != old_depth,
            ];
            answers.push(order);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} (leaf {from}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..3 {
            checks += 1;
            if answers.iter().any(|y| y != answers[a]) {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 3 arms: {failures} failures");
}
