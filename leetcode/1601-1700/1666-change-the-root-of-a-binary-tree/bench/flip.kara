// LeetCode #1666: Change the Root of a Binary Tree -- the bench: the ★
// arm on 30 random trees of 100000 nodes with parent links, each turned
// 50000 times to hang from a leaf reached by a random walk down from a
// random node, the start nodes drawn first.

fn flip_binary_tree(root: Node, leaf: Node) -> Node {
    let mut cur = leaf;
    let mut below: Option[Node] = None;
    loop {
        let above = cur.parent;
        cur.parent = below;
        let Some(p) = above else {
            break;
        };
        if p.left.is_some_and(|l| l.ref_eq(cur)) {
            p.left = None;
        } else {
            p.right = None;
        }
        if cur.left.is_some() {
            cur.right = cur.left;
        }
        cur.left = Some(p);
        below = Some(cur);
        cur = p;
    }
    leaf
}

// ---- the harness ----------------------------------------------------------

shared struct Node {
    mut val: i32,
    mut left: Option[Node],
    mut right: Option[Node],
    mut parent: weak Node,
}

fn leaf(val: i32) -> Node {
    Node { val: val, left: None, right: None, parent: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` nodes holding 0 to n - 1 shuffled, each hung from a random node
// already placed, down a random walk to the first free child; the nodes
// in the order placed, the root first
fn random_tree(n: i64, seed: mut ref i64) -> Vec[Node] {
    let mut values: Vec[i32] = (0..n).map(|v| v as i32).collect();
    for i in (1..n).rev() {
        let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
        values.swap(i, j);
    }
    let mut nodes: Vec[Node] = Vec.new();
    for i in 0..n {
        let node = leaf(values[i]);
        if i > 0 {
            let mut at = nodes[(next_random(mut seed) * 32768 + next_random(mut seed)) % i];
            loop {
                if next_random(mut seed) % 2 == 0 {
                    match at.left {
                        Some(child) => at = child,
                        None => {
                            node.parent = at;
                            at.left = Some(node);
                            break;
                        }
                    }
                } else {
                    match at.right {
                        Some(child) => at = child,
                        None => {
                            node.parent = at;
                            at.right = Some(node);
                            break;
                        }
                    }
                }
            }
        }
        nodes.push(node);
    }
    nodes
}

fn main() {
    let mut seed = 1666;
    let mut trees: Vec[(Vec[Node], Vec[i64])] = Vec.new();
    for _ in 0..30 {
        let nodes = random_tree(100000, mut seed);
        let mut starts: Vec[i64] = Vec.new();
        for _ in 0..50000 {
            starts.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 100000);
        }
        trees.push((nodes, starts));
    }
    let mut check = 0;
    let mut steps = 0;
    for (nodes, starts) in trees.iter() {
        let mut root = nodes[0];
        for s in starts.iter() {
            let mut at = nodes[s];
            loop {
                let first = if next_random(mut seed) % 2 == 0 { at.left } else { at.right };
                match first.or(at.left).or(at.right) {
                    Some(child) => at = child,
                    None => break,
                }
                steps += 1;
            }
            root = flip_binary_tree(root, at);
            check = (check * 31 + root.val + 1) % 1000000007;
        }
    }
    println(f"30 trees of 100000 nodes, 50000 turns each: {steps} steps down, checksum {check}");
}
