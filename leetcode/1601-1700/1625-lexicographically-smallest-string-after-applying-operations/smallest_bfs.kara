// LeetCode #1625: Lexicographically Smallest String After Applying
// Operations -- a breadth-first walk.
//
// The statement read straight: from `s`, every string the two operations
// reach, each once, through a queue and a set of the strings seen; the
// least of them. O(states * n), with at most 100 n states.

fn find_lex_smallest_string(s: String, a: i32, b: i32) -> String {
    let n = s.len();
    let mut seen: Set[String] = [s.clone()];
    let mut queue: VecDeque[String] = VecDeque.new();
    queue.push_back(s.clone());
    let mut best = s.clone();
    while let Some(t) = queue.pop_front() {
        if t < best {
            best = t.clone();
        }
        let added: String = t
            .chars()
            .enumerate()
            .map(|(i, c)| if i % 2 == 1 { (b'0' + ((c as u32 as u8 - b'0') + a as u8) % 10) as char } else { c })
            .collect();
        let rotated = f"{t[n - b..]}{t[..n - b]}";
        for next in [added, rotated] {
            if seen.insert(next.clone()) {
                queue.push_back(next.clone());
            }
        }
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` random cases of an even length up to `longest`: how many are
// already their own smallest, and a checksum of every answer's digits
fn batch(count: i64, longest: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut unchanged = 0;
    for _ in 0..count {
        let n = 2 * (next_random(mut seed) % (longest / 2) + 1);
        let mut s = String.new();
        for _ in 0..n {
            s.push((b'0' + (next_random(mut seed) % 10) as u8) as char);
        }
        let a = (next_random(mut seed) % 9 + 1) as i32;
        let b = (next_random(mut seed) % (n - 1) + 1) as i32;
        let got = find_lex_smallest_string(s, a, b);
        if got == s {
            unchanged += 1;
        }
        for c in got.chars() {
            check = mix(check, c as i64 - '0' as i64);
        }
    }
    println(f"{count} cases of up to {longest} digits: {unchanged} already smallest, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then a rotation of the whole string but
    // one, and an even rotation that leaves the even digits alone
    println(find_lex_smallest_string("5525", 9, 2));
    println(find_lex_smallest_string("74", 5, 1));
    println(find_lex_smallest_string("0011", 4, 2));
    println(find_lex_smallest_string("43987654", 7, 3));
    println(find_lex_smallest_string("9999999999", 5, 4));
    let mut seed = 1625;
    batch(1000, 10, mut seed);
    batch(100, 40, mut seed);
    batch(10, 100, mut seed);
}
