// LeetCode #1625: Lexicographically Smallest String After Applying
// Operations -- the bench, on the ★ arm: every rotation by a multiple of
// gcd(b, n) with every count of additions to its odd (and, for an odd b,
// even) digits, each string made and the least kept.
//
// Build once, then punch: 200 random cases of 100 digits, `a` and `b`
// drawn too, all first, then each one's answer.

fn gcd(x: i64, y: i64) -> i64 {
    if y == 0 { x } else { gcd(y, x % y) }
}

fn find_lex_smallest_string(s: String, a: i32, b: i32) -> String {
    let digits: Vec[i64] = s.chars().map(|c| c as i64 - '0' as i64).collect();
    let n = digits.len();
    let step = gcd(b, n);
    let even_counts = if b % 2 == 1 { 10 } else { 1 };
    let mut best = s.clone();
    for start in (0..n).step_by(step) {
        for odd in 0..10 {
            for even in 0..even_counts {
                let mut t = String.new();
                for i in 0..n {
                    let count = if i % 2 == 1 { odd } else { even };
                    let d = (digits[(i + start) % n] + count * a) % 10;
                    t.push((b'0' + d as u8) as char);
                }
                if t < best {
                    best = t;
                }
            }
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1625;
    let mut cases: Vec[(String, i32, i32)] = Vec.new();
    for _ in 0..200 {
        let mut s = String.new();
        for _ in 0..100 {
            s.push((b'0' + (next_random(mut seed) % 10) as u8) as char);
        }
        let a = (next_random(mut seed) % 9 + 1) as i32;
        let b = (next_random(mut seed) % 99 + 1) as i32;
        cases.push((s, a, b));
    }
    let mut check = 0;
    let mut zeros = 0;
    for (s, a, b) in cases.iter() {
        let got = find_lex_smallest_string(s, a, b);
        for c in got.chars() {
            if c == '0' {
                zeros += 1;
            }
            check = mix(check, c as i64 - '0' as i64);
        }
    }
    println(f"200 cases of 100 digits: {zeros} zeros in the answers, checksum {check}");
}
