// LeetCode #1616: Split Two Strings to Make Palindrome -- the bench,
// split.kara's two pointers: a from the front against b from the back as
// far as they agree, then whether the middle left over, of a or of b, is
// a palindrome by itself; then the roles swapped.

fn is_palindrome(s: Slice[u8], lo: i64, hi: i64) -> bool {
    let mut i = lo;
    let mut j = hi;
    while i < j {
        if s[i] != s[j] {
            return false;
        }
        i += 1;
        j -= 1;
    }
    true
}

fn joins(a: Slice[u8], b: Slice[u8]) -> bool {
    let mut i = 0;
    let mut j = a.len() - 1;
    while i < j and a[i] == b[j] {
        i += 1;
        j -= 1;
    }
    is_palindrome(a, i, j) or is_palindrome(b, i, j)
}

fn check_palindrome_formation(a: String, b: String) -> bool {
    joins(a.bytes(), b.bytes()) or joins(b.bytes(), a.bytes())
}


fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// two strings of `n` letters from two that split: a random, b's ends the
// mirror of a's and b's middle a palindrome; then, one time in two, one
// letter of b changed at random
fn pair(n: i64, seed: mut ref i64) -> (String, String) {
    let mut a: Vec[char] = Vec.new();
    let mut b: Vec[char] = Vec.new();
    for _ in 0..n {
        a.push((b'a' + (next_random(mut seed) % 2) as u8) as char);
        b.push((b'a' + (next_random(mut seed) % 2) as u8) as char);
    }
    let k = (next_random(mut seed) * 32768 + next_random(mut seed)) % (n / 2 + 1);
    for j in 0..k {
        b[n - 1 - j] = a[j];
    }
    for j in 0..(n - 2 * k) / 2 {
        b[n - k - 1 - j] = b[k + j];
    }
    if next_random(mut seed) % 2 == 0 {
        let i = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        b[i] = (b'a' + (next_random(mut seed) % 2) as u8) as char;
    }
    (a.iter().collect(), b.iter().collect())
}

fn main() {
    let mut seed = 1616;
    let mut pairs: Vec[(String, String)] = Vec.new();
    for _ in 0..10 {
        pairs.push(pair(500000, mut seed));
    }
    let mut check = 0;
    let mut yes = 0;
    for (a, b) in pairs.iter() {
        for _ in 0..30 {
            let answer = check_palindrome_formation(a, b);
            if answer {
                yes += 1;
            }
            check = mix(check, if answer { 1 } else { 0 });
        }
    }
    println(f"10 pairs of 500000 letters from 2, each checked 30 times: {yes} split, checksum {check}");
}
