// LeetCode #1630: Arithmetic Subarrays -- the differential.
//
// Four arms against the statement read literally, on 3000 random problems
// of 2 to 8 numbers and 1 to 6 queries: every other one with numbers from
// -2 to 2, so repeats and arithmetic runs are common, the rest from -20
// to 20. Every random choice is drawn before any arm answers.
//
// P1  the answers are the statement read literally
// P2  every number negated leaves the answers
// P3  every number x made 3x + 7 leaves the answers
// P4  the numbers reversed, with each query's run mirrored, leave the
//     answers
// P5  each query asked alone gets the answer it got among the others
// P6  each arm agrees with at least two of the other three

// ---- subarrays.kara: the ★ arm: each run sorted, then its steps compared

fn star_arm(nums: Vec[i32], l: Vec[i32], r: Vec[i32]) -> Vec[bool] {
    l.iter()
        .zip(r.iter())
        .map(|(a, b)| {
            let mut run = nums[a..=b].to_vec();
            run.sort();
            let step = run[1] - run[0];
            run.windows(2).into_iter().all(|pair| pair[1] - pair[0] == step)
        })
        .collect()
}

// ---- subarrays_set.kara: no sort: the step from the ends, a Set for the rest

fn set_is_arithmetic(run: Slice[i32]) -> bool {
    let low = run.iter().min().unwrap() as i64;
    let high = run.iter().max().unwrap() as i64;
    let gaps = run.len() - 1;
    if (high - low) % gaps != 0 {
        return false;
    }
    let step = (high - low) / gaps;
    if step == 0 {
        return true;
    }
    let mut seen: Set[i64] = Set.new();
    for x in run.iter() {
        let above = x as i64 - low;
        if above % step != 0 or not seen.insert(x) {
            return false;
        }
    }
    true
}

fn set_arm(nums: Vec[i32], l: Vec[i32], r: Vec[i32]) -> Vec[bool] {
    let mut answers: Vec[bool] = Vec.new();
    for i in 0..l.len() {
        answers.push(set_is_arithmetic(nums[l[i]..=r[i]]));
    }
    answers
}

// ---- subarrays_slots.kara: no sort and no set: each number marks its slot

fn slots_arm(nums: Vec[i32], l: Vec[i32], r: Vec[i32]) -> Vec[bool] {
    let mut answers: Vec[bool] = Vec.new();
    for q in 0..l.len() {
        let (from, to) = (l[q] as i64, r[q] as i64);
        let k = to - from + 1;
        let mut low = nums[from] as i64;
        let mut high = low;
        for i in from..=to {
            low = min(low, nums[i] as i64);
            high = max(high, nums[i] as i64);
        }
        let mut arithmetic = (high - low) % (k - 1) == 0;
        let step = (high - low) / (k - 1);
        if arithmetic and step > 0 {
            let mut marked: Vec[bool] = Vec.filled(k, false);
            for i in from..=to {
                let above = nums[i] - low;
                if above % step != 0 or marked[above / step] {
                    arithmetic = false;
                    break;
                }
                marked[above / step] = true;
            }
        }
        answers.push(arithmetic);
    }
    answers
}

// ---- subarrays_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn check_arithmetic_subarrays(nums: Vec[i32], l: Vec[i32], r: Vec[i32]) -> Vec[bool] {
        let mut ans = Vec.with_capacity(l.len());
        for i in 0..l.len() {
            let mut sub: Vec[i32] = nums[l[i] as usize..=r[i] as usize].to_vec();
            sub.sort();
            let d = sub[1] - sub[0];
            let mut ok = true;
            for j in 2..sub.len() {
                if sub[j] - sub[j - 1] != d {
                    ok = false;
                    break;
                }
            }
            ans.push(ok);
        }
        ans
    }
}

fn solution_arm(nums: Vec[i32], l: Vec[i32], r: Vec[i32]) -> Vec[bool] {
    SolutionArm.check_arithmetic_subarrays(nums, l, r)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(k: i64, nums: Vec[i32], l: Vec[i32], r: Vec[i32]) -> Vec[bool] {
    match k {
        0 => star_arm(nums, l, r),
        1 => set_arm(nums, l, r),
        2 => slots_arm(nums, l, r),
        _ => solution_arm(nums, l, r),
    }
}

fn arm_name(k: i64) -> String {
    ["subarrays", "set", "slots", "solution"][k].to_string()
}

// ---- the statement read literally: a run can be rearranged into an
// arithmetic sequence when some first number and some second one, with
// their difference as the step, make a sequence whose numbers are the
// run's, each as often

fn rearranges(run: Vec[i64]) -> bool {
    let k = run.len();
    for i in 0..k {
        for j in 0..k {
            if i == j {
                continue;
            }
            let step = run[j] - run[i];
            let mut left = run.clone();
            let mut all_found = true;
            for t in 0..k {
                match left.iter().position(|x| x == run[i] + t * step) {
                    Some(at) => {
                        left.remove(at);
                    }
                    None => {
                        all_found = false;
                        break;
                    }
                }
            }
            if all_found {
                return true;
            }
        }
    }
    false
}

fn literal(nums: Vec[i32], l: Vec[i32], r: Vec[i32]) -> Vec[bool] {
    let mut answers: Vec[bool] = [];
    for q in 0..l.len() {
        let mut run: Vec[i64] = [];
        for i in l[q]..=r[q] {
            run.push(nums[i]);
        }
        answers.push(rearranges(run));
    }
    answers
}

fn main() {
    let mut seed = 1630;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(Vec[i32], Vec[i32], Vec[i32])] = [];
    for p in 0..problems {
        // every other case with numbers from -2 to 2, so repeats and
        // arithmetic runs are common
        let spread = if p % 2 == 0 { 2 } else { 20 };
        let n = next_random(mut seed) % 7 + 2;
        let mut nums: Vec[i32] = [];
        for _ in 0..n {
            nums.push((next_random(mut seed) % (2 * spread + 1) - spread) as i32);
        }
        let mut l: Vec[i32] = [];
        let mut r: Vec[i32] = [];
        for _ in 0..next_random(mut seed) % 6 + 1 {
            let a = next_random(mut seed) % (n - 1);
            l.push(a as i32);
            r.push((a + 1 + next_random(mut seed) % (n - 1 - a)) as i32);
        }
        cases.push((nums, l, r));
    }
    for p in 0..problems {
        let (nums, l, r) = cases[p].clone();
        let n = nums.len() as i32;
        let negated: Vec[i32] = nums.iter().map(|x| -x).collect();
        let affine: Vec[i32] = nums.iter().map(|x| 3 * x + 7).collect();
        let reversed: Vec[i32] = nums.iter().rev().cloned().collect();
        let mirrored_l: Vec[i32] = r.iter().map(|b| n - 1 - b).collect();
        let mirrored_r: Vec[i32] = l.iter().map(|a| n - 1 - a).collect();
        let want = literal(nums, l, r);
        for answer in want.iter() {
            check = (check * 31 + *answer as i64 + 1) % 1000000007;
        }
        let mut answers: Vec[Vec[bool]] = [];
        for k in 0..4 {
            let got = arm(k, nums, l, r);
            answers.push(got.clone());
            let mut alone = true;
            for q in 0..l.len() {
                if arm(k, nums, [l[q]], [r[q]]) != [got[q]] {
                    alone = false;
                }
            }
            let failed = [
                got != want,
                arm(k, negated, l, r) != got,
                arm(k, affine, l, r) != got,
                arm(k, reversed, mirrored_l, mirrored_r) != got,
                not alone,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({nums}, {l}, {r}), {arm_name(k)}: P{q + 1}");
                    }
                }
            }
        }
        // P6
        for k in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|x| x == answers[k]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
