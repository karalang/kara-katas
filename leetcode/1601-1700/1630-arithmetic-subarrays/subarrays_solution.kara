// LeetCode #1630: Arithmetic Subarrays -- LeetCode's Rust template, as
// written there, carried over by `karac fix`.
//
// Each query's run copied into a new `Vec` and sorted with
// `sort_unstable`, then checked pair by pair. O(m · n log n).

struct Solution {}

impl Solution {
    pub fn check_arithmetic_subarrays(nums: Vec[i32], l: Vec[i32], r: Vec[i32]) -> Vec[bool] {
        let mut ans = Vec.with_capacity(l.len());
        for i in 0..l.len() {
            let mut sub: Vec[i32] = nums[l[i] as usize..=r[i] as usize].to_vec();
            sub.sort();
            let d = sub[1] - sub[0];
            let mut ok = true;
            for j in 2..sub.len() {
                if sub[j] - sub[j - 1] != d {
                    ok = false;
                    break;
                }
            }
            ans.push(ok);
        }
        ans
    }
}

fn check_arithmetic_subarrays(nums: Vec[i32], l: Vec[i32], r: Vec[i32]) -> Vec[bool] {
    Solution.check_arithmetic_subarrays(nums, l, r)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random problems of 2 to `most` numbers from -`spread` to
// `spread` and 1 to `asks` queries; the arithmetic answers counted, and a
// checksum over every answer
fn batch(count: i64, most: i64, spread: i64, asks: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut yes = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (most - 1) + 2;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) % (2 * spread + 1) - spread) as i32);
        }
        let m = next_random(mut seed) % asks + 1;
        let mut l: Vec[i32] = Vec.new();
        let mut r: Vec[i32] = Vec.new();
        for _ in 0..m {
            let a = next_random(mut seed) % (n - 1);
            l.push(a as i32);
            r.push((a + 1 + next_random(mut seed) % (n - 1 - a)) as i32);
        }
        for answer in check_arithmetic_subarrays(nums, l, r) {
            if answer {
                yes += 1;
            }
            check = (check * 31 + answer as i64 + 1) % 1000000007;
        }
    }
    println(f"{count} problems of up to {most} numbers: {yes} queries arithmetic, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then a run of one repeated number, and a
    // run with a repeat that keeps it from being arithmetic
    println(check_arithmetic_subarrays([4, 6, 5, 9, 3, 7], [0, 0, 2], [2, 3, 5]));
    println(check_arithmetic_subarrays([-12, -9, -3, -12, -6, 15, 20, -25, -20, -15, -10], [0, 1, 6, 4, 8, 7], [4, 4, 9, 7, 9, 10]));
    println(check_arithmetic_subarrays([7, 7, 7, 7], [0, 1], [3, 2]));
    println(check_arithmetic_subarrays([1, 3, 3, 5, 7], [0, 1], [4, 3]));
    let mut seed = 1630;
    batch(3000, 8, 2, 6, mut seed);
    batch(300, 500, 100000, 50, mut seed);
    batch(20, 500, 3, 500, mut seed);
}
