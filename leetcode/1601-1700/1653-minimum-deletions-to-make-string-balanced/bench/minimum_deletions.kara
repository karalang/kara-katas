// LeetCode #1653: Minimum Deletions to Make String Balanced -- the bench:
// the ★ arm on 500 random strings of 100000 a's and b's, each with its
// own chance of a b, all drawn first.

fn minimum_deletions(s: String) -> i64 {
    let mut deletions = 0;
    let mut bs = 0;
    for c in s.chars() {
        if c == 'b' {
            bs += 1;
        } else {
            deletions = min(deletions + 1, bs);
        }
    }
    deletions
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1653;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..500 {
        let percent = next_random(mut seed) % 101;
        let mut s = String.new();
        for _ in 0..100000 {
            s.push(if next_random(mut seed) % 100 < percent { 'b' } else { 'a' });
        }
        strings.push(s);
    }
    let mut check = 0;
    let mut total = 0;
    for s in strings.iter() {
        let deletions = minimum_deletions(s);
        total += deletions;
        check = (check * 31 + deletions + 1) % 1000000007;
    }
    println(f"500 strings of 100000 letters: deletions sum to {total}, checksum {check}");
}
