// LeetCode #1658: Minimum Operations to Reduce X to Zero -- the bench: the
// ★ arm on 1000 random arrays of 100000 numbers from 1 to 10000, each x a
// random prefix plus a random suffix of its array, all drawn first.

fn min_operations(nums: Vec[i32], x: i32) -> i32 {
    let total: i64 = nums.iter().sum();
    let target = total - x;
    if target < 0 {
        return -1;
    }
    let n = nums.len();
    let mut longest = -1;
    let mut sum = 0;
    let mut left = 0;
    for right in 0..n {
        sum += nums[right];
        while sum > target {
            sum -= nums[left];
            left += 1;
        }
        if sum == target {
            longest = max(longest, right - left + 1);
        }
    }
    if longest < 0 { -1 } else { (n - longest) as i32 }
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1658;
    let n = 100000;
    let mut problems: Vec[(Vec[i32], i32)] = Vec.new();
    for _ in 0..1000 {
        let nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 10000 + 1) as i32).collect();
        let left = next_random(mut seed) % 1000;
        let right = next_random(mut seed) % 1000;
        let mut x = 0;
        for i in 0..left {
            x += nums[i];
        }
        for i in n - right..n {
            x += nums[i];
        }
        problems.push((nums, max(x, 1) as i32));
    }
    let mut check = 0;
    let mut total = 0;
    for (nums, x) in problems.iter() {
        let answer = min_operations(nums, x);
        total += answer;
        check = (check * 31 + answer + 2) % 1000000007;
    }
    println(f"1000 arrays of 100000 numbers: operations sum to {total}, checksum {check}");
}
