// LeetCode #1658: Minimum Operations to Reduce X to Zero -- LeetCode's
// Rust template, as written there, carried over by `karac fix`.
//
// The ★ arm's sliding window for the longest middle summing to the total
// less x, on `i32`s and `usize` indices. O(n).

struct Solution {}

impl Solution {
    pub fn min_operations(nums: Vec[i32], x: i32) -> i32 {
        let target: i32 = nums.iter().sum() - x;
        if target < 0 {
            return -1;
        }
        let mut best: i32 = -1;
        let mut sum = 0;
        let mut l = 0;
        for r in 0..nums.len() {
            sum += nums[r];
            while sum > target {
                sum -= nums[l];
                l += 1;
            }
            if sum == target {
                best = best.max((r - l + 1) as i32);
            }
        }
        if best == -1 { -1 } else { nums.len() as i32 - best }
    }
}

fn min_operations(nums: Vec[i32], x: i32) -> i32 {
    Solution.min_operations(nums, x)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random arrays of 1 to `most` numbers from 1 to `top`, each with
// an x that half the time is a prefix plus a suffix of it and otherwise
// random; every answer summed, how many are -1, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    let mut impossible = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % top + 1) as i32).collect();
        let x = if next_random(mut seed) % 2 == 0 {
            let left = next_random(mut seed) % (n + 1);
            let right = next_random(mut seed) % (n - left + 1);
            let mut sum = 0;
            for i in 0..left {
                sum += nums[i];
            }
            for i in n - right..n {
                sum += nums[i];
            }
            max(sum, 1) as i32
        } else {
            (next_random(mut seed) % (top * n) + 1) as i32
        };
        let answer = min_operations(nums, x);
        if answer < 0 {
            impossible += 1;
        }
        total += answer;
        check = (check * 31 + answer + 2) % 1000000007;
    }
    println(f"{count} arrays of up to {most} numbers to {top}: operations sum to {total}, {impossible} impossible, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then x the whole array, x one end, and x
    // larger than the whole array
    println(min_operations([1, 1, 4, 2, 3], 5));
    println(min_operations([5, 6, 7, 8, 9], 4));
    println(min_operations([3, 2, 20, 1, 1, 3], 10));
    println(min_operations([2, 3, 4], 9));
    println(min_operations([7, 1, 1], 7));
    println(min_operations([1, 2], 4));
    let mut seed = 1658;
    batch(3000, 10, 5, mut seed);
    batch(1000, 1000, 10000, mut seed);
    batch(20, 100000, 10000, mut seed);
}
