// LeetCode #1648: Sell Diminishing-Valued Colored Balls -- the bench: the
// ★ arm on 100 random inventories of 100000 colors with up to 10^9 balls
// each, and an order for up to 10^9 of them, all drawn first.

fn max_profit(inventory: Vec[i32], orders: i32) -> i32 {
    const MOD: i64 = 1_000_000_007;
    let mut counts: Vec[i64] = inventory.iter().map(|b| b as i64).collect();
    counts.sort();
    counts.reverse();
    counts.push(0);
    let mut orders = orders as i64;
    let mut profit = 0;
    for i in 0..counts.len() - 1 {
        let width = i + 1;
        let (high, low) = (counts[i], counts[i + 1]);
        if high == low {
            continue;
        }
        // sum of high, high - 1, ..., stop + 1, `width` times over
        let series = |stop: i64| (high + stop + 1) * (high - stop) / 2 % MOD * width % MOD;
        if width * (high - low) < orders {
            profit = (profit + series(low)) % MOD;
            orders -= width * (high - low);
        } else {
            let rows = orders / width;
            let rest = orders % width;
            profit = (profit + series(high - rows)) % MOD;
            profit = (profit + rest * (high - rows) % MOD) % MOD;
            return profit as i32;
        }
    }
    profit as i32
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1648;
    let mut cases: Vec[(Vec[i32], i32)] = Vec.new();
    for _ in 0..100 {
        let mut inventory: Vec[i32] = Vec.new();
        for _ in 0..100000 {
            inventory.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1) as i32);
        }
        let orders = ((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1) as i32;
        cases.push((inventory, orders));
    }
    let mut check = 0;
    let mut total = 0;
    for (inventory, orders) in cases.iter() {
        let profit = max_profit(inventory, orders);
        total += profit;
        check = (check * 31 + profit + 1) % 1000000007;
    }
    println(f"100 inventories of 100000 colors: profits sum to {total}, checksum {check}");
}
