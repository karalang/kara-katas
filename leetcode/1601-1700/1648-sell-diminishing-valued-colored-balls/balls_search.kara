// LeetCode #1648: Sell Diminishing-Valued Colored Balls -- a binary search
// on the last price.
//
// Every ball worth more than some price t is sold, and the rest of the
// orders at t itself. The lowest t whose balls above it number no more
// than the orders is found by binary search, as the count only falls as
// t rises. O(n log m) for m the largest count.

fn sold_above(inventory: Slice[i32], t: i64) -> i64 {
    inventory.iter().map(|b| max(b as i64 - t, 0)).sum()
}

fn max_profit(inventory: Vec[i32], orders: i32) -> i32 {
    const MOD: i64 = 1_000_000_007;
    let orders = orders as i64;
    let mut (low, high) = (0, inventory.iter().max().unwrap() as i64);
    while low < high {
        let middle = (low + high) / 2;
        if sold_above(inventory, middle) <= orders {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    let t = low;
    let mut profit = 0;
    for b in inventory.iter() {
        let b = b as i64;
        if b > t {
            profit = (profit + (b + t + 1) * (b - t) / 2) % MOD;
        }
    }
    let rest = orders - sold_above(inventory, t);
    ((profit + rest % MOD * t) % MOD) as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random inventories of 1 to `most` colors with up to `top` balls
// each, and an order for 1 to all of the balls, at most 10^9; the profits
// summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut inventory: Vec[i32] = Vec.new();
        let mut balls = 0;
        for _ in 0..n {
            let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1;
            inventory.push(b as i32);
            balls += b;
        }
        let orders = (next_random(mut seed) * 32768 + next_random(mut seed)) % min(balls, 1000000000) + 1;
        let profit = max_profit(inventory, orders as i32);
        total += profit;
        check = (check * 31 + profit + 1) % 1000000007;
    }
    println(f"{count} inventories of up to {most} colors: profits sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one color sold out, every ball worth
    // the same, and the largest case, which wraps the modulus
    println(max_profit([2, 5], 4));
    println(max_profit([3, 5], 6));
    println(max_profit([7], 7));
    println(max_profit([4, 4, 4], 5));
    println(max_profit([1000000000], 1000000000));
    let mut seed = 1648;
    batch(3000, 4, 6, mut seed);
    batch(1000, 100, 1000000000, mut seed);
    batch(20, 100000, 1000000000, mut seed);
}
