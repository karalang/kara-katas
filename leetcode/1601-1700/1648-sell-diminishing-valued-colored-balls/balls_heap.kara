// LeetCode #1648: Sell Diminishing-Valued Colored Balls -- a heap of
// levels.
//
// The counts in a largest-first heap (a `PriorityQueue` of `Reverse`d
// counts, since it pops smallest first), with every color at the top
// level popped together. They sell down to the next level as one block,
// or part of the way when the orders run out, and then join that level.
// O(n log n).

import std.cmp.Reverse;

fn max_profit(inventory: Vec[i32], orders: i32) -> i32 {
    const MOD: i64 = 1_000_000_007;
    let mut heap: PriorityQueue[Reverse[i64]] = PriorityQueue.new();
    for b in inventory.iter() {
        heap.push(Reverse { value: b });
    }
    let mut orders = orders as i64;
    let mut profit = 0;
    let mut width = 0;
    let mut level = heap.pop().unwrap().value;
    width += 1;
    while orders > 0 {
        while let Some(top) = heap.peek() {
            if top.value != level {
                break;
            }
            heap.pop();
            width += 1;
        }
        let next = match heap.peek() {
            Some(top) => top.value,
            None => 0,
        };
        let block = width * (level - next);
        let take = min(block, orders);
        let rows = take / width;
        let rest = take % width;
        let bottom = level - rows;
        profit = (profit + (level + bottom + 1) * rows / 2 % MOD * width % MOD) % MOD;
        profit = (profit + rest * bottom % MOD) % MOD;
        orders -= take;
        level = next;
    }
    profit as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random inventories of 1 to `most` colors with up to `top` balls
// each, and an order for 1 to all of the balls, at most 10^9; the profits
// summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut inventory: Vec[i32] = Vec.new();
        let mut balls = 0;
        for _ in 0..n {
            let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1;
            inventory.push(b as i32);
            balls += b;
        }
        let orders = (next_random(mut seed) * 32768 + next_random(mut seed)) % min(balls, 1000000000) + 1;
        let profit = max_profit(inventory, orders as i32);
        total += profit;
        check = (check * 31 + profit + 1) % 1000000007;
    }
    println(f"{count} inventories of up to {most} colors: profits sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one color sold out, every ball worth
    // the same, and the largest case, which wraps the modulus
    println(max_profit([2, 5], 4));
    println(max_profit([3, 5], 6));
    println(max_profit([7], 7));
    println(max_profit([4, 4, 4], 5));
    println(max_profit([1000000000], 1000000000));
    let mut seed = 1648;
    batch(3000, 4, 6, mut seed);
    batch(1000, 100, 1000000000, mut seed);
    batch(20, 100000, 1000000000, mut seed);
}
