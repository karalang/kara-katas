// LeetCode #1648: Sell Diminishing-Valued Colored Balls -- the ★ arm.
//
// Sell from the top down in layers. With the counts sorted largest
// first, the i + 1 largest colors stand level at each step; taking all
// of them from their level down to the next color's level sells whole
// rows of i + 1 balls, each row an arithmetic series. When the orders
// run out partway, the full rows left go first and then a part row at
// the lowest value. O(n log n).

fn max_profit(inventory: Vec[i32], orders: i32) -> i32 {
    const MOD: i64 = 1_000_000_007;
    let mut counts: Vec[i64] = inventory.iter().map(|b| b as i64).collect();
    counts.sort();
    counts.reverse();
    counts.push(0);
    let mut orders = orders as i64;
    let mut profit = 0;
    for i in 0..counts.len() - 1 {
        let width = i + 1;
        let (high, low) = (counts[i], counts[i + 1]);
        if high == low {
            continue;
        }
        // sum of high, high - 1, ..., stop + 1, `width` times over
        let series = |stop: i64| (high + stop + 1) * (high - stop) / 2 % MOD * width % MOD;
        if width * (high - low) < orders {
            profit = (profit + series(low)) % MOD;
            orders -= width * (high - low);
        } else {
            let rows = orders / width;
            let rest = orders % width;
            profit = (profit + series(high - rows)) % MOD;
            profit = (profit + rest * (high - rows) % MOD) % MOD;
            return profit as i32;
        }
    }
    profit as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random inventories of 1 to `most` colors with up to `top` balls
// each, and an order for 1 to all of the balls, at most 10^9; the profits
// summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut inventory: Vec[i32] = Vec.new();
        let mut balls = 0;
        for _ in 0..n {
            let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1;
            inventory.push(b as i32);
            balls += b;
        }
        let orders = (next_random(mut seed) * 32768 + next_random(mut seed)) % min(balls, 1000000000) + 1;
        let profit = max_profit(inventory, orders as i32);
        total += profit;
        check = (check * 31 + profit + 1) % 1000000007;
    }
    println(f"{count} inventories of up to {most} colors: profits sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one color sold out, every ball worth
    // the same, and the largest case, which wraps the modulus
    println(max_profit([2, 5], 4));
    println(max_profit([3, 5], 6));
    println(max_profit([7], 7));
    println(max_profit([4, 4, 4], 5));
    println(max_profit([1000000000], 1000000000));
    let mut seed = 1648;
    batch(3000, 4, 6, mut seed);
    batch(1000, 100, 1000000000, mut seed);
    batch(20, 100000, 1000000000, mut seed);
}
