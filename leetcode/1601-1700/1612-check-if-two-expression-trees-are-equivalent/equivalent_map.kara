// LeetCode #1612: Check If Two Expression Trees are Equivalent -- a map
// of counts, walked with a stack.
//
// Each tree's leaves counted into a `Map[char, i64]` by a walk with an
// explicit stack, and the two maps compared. O(n) time and space.

fn leaf_counts(root: Option[Node]) -> Map[char, i64] {
    let mut counts = Map.new();
    let mut stack: Vec[Node] = Vec.new();
    if let Some(r) = root {
        stack.push(r);
    }
    while let Some(n) = stack.pop() {
        match (n.left, n.right) {
            (None, None) => *counts.entry(n.val).or_insert(0) += 1,
            (l, r) => {
                if let Some(l) = l {
                    stack.push(l);
                }
                if let Some(r) = r {
                    stack.push(r);
                }
            }
        }
    }
    counts
}

fn check_equivalence(root1: Option[Node], root2: Option[Node]) -> bool {
    leaf_counts(root1) == leaf_counts(root2)
}

// ---- the harness: the same in every arm --------------------------------

shared struct Node {
    mut val: char,
    mut left: Option[Node],
    mut right: Option[Node],
}

fn leaf(c: char) -> Node {
    Node { val: c, left: None, right: None }
}

fn plus(l: Node, r: Node) -> Node {
    Node { val: '+', left: Some(l), right: Some(r) }
}

// the tree LeetCode's level-order list describes, `None` for null
fn from_level_order(items: Slice[Option[char]]) -> Option[Node] {
    let root = leaf(items[0].unwrap());
    let mut queue = VecDeque.new();
    queue.push_back(root);
    let mut i = 1;
    while i < items.len() {
        let node = queue.pop_front().unwrap();
        for side in 0..2 {
            if i < items.len() {
                if let Some(c) = items[i] {
                    let child = leaf(c);
                    if side == 0 {
                        node.left = Some(child);
                    } else {
                        node.right = Some(child);
                    }
                    queue.push_back(child);
                }
                i += 1;
            }
        }
    }
    Some(root)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// an expression over `leaves`: two subtrees at a time, picked at random
// from those still loose, joined under a `+` until one is left
fn random_expression(leaves: Slice[char], seed: mut ref i64) -> Node {
    let mut loose: Vec[Node] = leaves.iter().map(|c| leaf(*c)).collect();
    while loose.len() > 1 {
        let a = loose.swap_remove((next_random(mut seed) * 32768 + next_random(mut seed)) % loose.len());
        let b = loose.swap_remove((next_random(mut seed) * 32768 + next_random(mut seed)) % loose.len());
        loose.push(plus(a, b));
    }
    loose[0]
}

// `count` pairs of expressions over up to `most` leaves from the first
// `letters` letters: the second over the same leaves shuffled, and in
// half the pairs one leaf of the second changed (which may change it to
// itself)
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut leaves_seen = 0;
    let mut equivalent = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let leaves: Vec[char] = (0..n).map(|_| (b'a' + (next_random(mut seed) % letters) as u8) as char).collect();
        let mut other = leaves.clone();
        for i in (1..n).rev() {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            other.swap(i, j);
        }
        if next_random(mut seed) % 2 == 0 {
            let i = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
            other[i] = (b'a' + (next_random(mut seed) % letters) as u8) as char;
        }
        let first = random_expression(leaves, mut seed);
        let second = random_expression(other, mut seed);
        let same = check_equivalence(Some(first), Some(second));
        if same {
            equivalent += 1;
        }
        check = mix(check, if same { 1 } else { 0 });
        leaves_seen += n;
    }
    println(f"{count} pairs of up to {most} leaves from {letters} letters: {leaves_seen} leaves, {equivalent} equivalent, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then a leaf against a sum, one letter
    // twice against two letters, and the same letters regrouped
    let examples: Vec[(Vec[Option[char]], Vec[Option[char]])] = [
        ([Some('x')], [Some('x')]),
        ([Some('+'), Some('a'), Some('+'), None, None, Some('b'), Some('c')], [Some('+'), Some('+'), Some('a'), Some('b'), Some('c')]),
        ([Some('+'), Some('a'), Some('+'), None, None, Some('b'), Some('c')], [Some('+'), Some('+'), Some('a'), Some('b'), Some('d')]),
        ([Some('a')], [Some('+'), Some('a'), Some('a')]),
        ([Some('+'), Some('a'), Some('a')], [Some('+'), Some('a'), Some('b')]),
        ([Some('+'), Some('+'), Some('+'), Some('a'), Some('b'), Some('c'), Some('d')], [Some('+'), Some('d'), Some('+'), None, None, Some('c'), Some('+'), None, None, Some('b'), Some('a')]),
    ];
    for (one, two) in examples.iter() {
        println(f"{check_equivalence(from_level_order(one), from_level_order(two))}");
    }
    let mut seed = 1612;
    batch(3000, 6, 3, mut seed);
    batch(300, 1000, 26, mut seed);
    batch(3, 100000, 26, mut seed);
}
