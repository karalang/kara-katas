// LeetCode #1612: Check If Two Expression Trees are Equivalent -- the
// bench: the ★ arm on 10 pairs of expressions over 50000 leaves from 26
// letters, each pair checked 10 times, five each way round, all built
// first.
//
// The ★ arm: one walk counts the first tree's leaves up and the second's
// down, into one array of 26 counts.

fn tally(node: Option[Node], sign: i32, counts: mut ref Array[i32, 26]) {
    if let Some(n) = node {
        if n.val == '+' {
            tally(n.left, sign, mut counts);
            tally(n.right, sign, mut counts);
        } else {
            counts[n.val as u32 as u8 - b'a'] += sign;
        }
    }
}

fn check_equivalence(root1: Option[Node], root2: Option[Node]) -> bool {
    let mut counts = [0; 26];
    tally(root1, 1, mut counts);
    tally(root2, -1, mut counts);
    counts.iter().all(|c| *c == 0)
}

// ---- the harness

shared struct Node {
    mut val: char,
    mut left: Option[Node],
    mut right: Option[Node],
}

fn leaf(c: char) -> Node {
    Node { val: c, left: None, right: None }
}

fn plus(l: Node, r: Node) -> Node {
    Node { val: '+', left: Some(l), right: Some(r) }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn random_expression(leaves: Slice[char], seed: mut ref i64) -> Node {
    let mut loose: Vec[Node] = leaves.iter().map(|c| leaf(*c)).collect();
    while loose.len() > 1 {
        let a = loose.swap_remove((next_random(mut seed) * 32768 + next_random(mut seed)) % loose.len());
        let b = loose.swap_remove((next_random(mut seed) * 32768 + next_random(mut seed)) % loose.len());
        loose.push(plus(a, b));
    }
    loose[0]
}

fn main() {
    let mut seed = 1612;
    let n = 50000;
    let mut pairs: Vec[(Node, Node)] = Vec.new();
    for _ in 0..10 {
        let leaves: Vec[char] = (0..n).map(|_| (b'a' + (next_random(mut seed) % 26) as u8) as char).collect();
        let mut other = leaves.clone();
        for i in (1..n).rev() {
            let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
            other.swap(i, j);
        }
        if next_random(mut seed) % 2 == 0 {
            let i = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
            other[i] = (b'a' + (next_random(mut seed) % 26) as u8) as char;
        }
        pairs.push((random_expression(leaves, mut seed), random_expression(other, mut seed)));
    }
    let mut check = 0;
    let mut equivalent = 0;
    for (one, two) in pairs.iter() {
        for k in 0..10 {
            let same = if k % 2 == 0 { check_equivalence(Some(*one), Some(*two)) } else { check_equivalence(Some(*two), Some(*one)) };
            if same {
                equivalent += 1;
            }
            check = mix(check, if same { 1 } else { 0 });
        }
    }
    println(f"10 pairs of 50000 leaves from 26 letters, 100 checks: {equivalent} equivalent, checksum {check}");
}
