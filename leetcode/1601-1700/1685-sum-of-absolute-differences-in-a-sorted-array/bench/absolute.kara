// LeetCode #1685: Sum of Absolute Differences in a Sorted Array -- the
// bench: the ★ arm on 50 random sorted arrays of 100000 values, all drawn
// first, each answered 20 times.
//
// The array is sorted, so the values before i are at most nums[i] and
// those after at least: the answer is nums[i] * i less the sum before,
// plus the sum after less nums[i] * (n - 1 - i). One pass carries the sum
// before; the sum after is the total less it and nums[i]. O(n).

fn sum_differences(nums: Vec[i32]) -> Vec[i32] {
    let n = nums.len();
    let total = nums.iter().sum();
    let mut before: i32 = 0;
    let mut result: Vec[i32] = Vec.with_capacity(n);
    for i in 0..n {
        let x = nums[i];
        let after = total - before - x;
        result.push((x * i - before + after - x * (n - 1 - i)) as i32);
        before += x;
    }
    result
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 50;
    let size = 100000;
    let rounds = 20;
    let mut seed = 1685;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    for _ in 0..count {
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..size {
            nums.push((next_random(mut seed) % 10000 + 1) as i32);
        }
        nums.sort();
        arrays.push(nums);
    }
    let mut total: i64 = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in arrays.iter() {
            let answer = sum_differences(nums);
            let first = answer[0];
            let middle = answer[size / 2];
            let last = answer[size - 1];
            total += middle;
            check = (check * 31 + first + middle + last + r) % 1000000007;
        }
    }
    println(f"{count} arrays of {size} values, {rounds} rounds: middles sum to {total}, checksum {check}");
}
