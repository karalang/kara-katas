// LeetCode #1685: Sum of Absolute Differences in a Sorted Array -- each
// answer from the one before.
//
// The first answer is the sum less n times the first value. Moving from
// i - 1 to i by d = nums[i] - nums[i - 1] takes every value from 0 to
// i - 1 d further and every one from i to n - 1 d nearer: the answer grows
// by d * (2i - n). O(n).

fn sum_differences(nums: Vec[i32]) -> Vec[i32] {
    let n = nums.len();
    let mut result = Vec.filled(n, 0);
    result[0] = nums.iter().sum() - n as i32 * nums[0];
    for i in 1..n {
        let d = nums[i] - nums[i - 1];
        result[i] = result[i - 1] + d * (2 * i as i32 - n as i32);
    }
    result
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random sorted arrays of 2 to `most` values from 1 to `top`; every
// answer's values summed, and a checksum of them
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut total: i64 = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most - 1) + 2;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) % top + 1) as i32);
        }
        nums.sort();
        let answer = sum_differences(nums);
        for v in answer.iter() {
            total += v;
            check = (check * 31 + v) % 1000000007;
        }
    }
    println(f"{count} arrays of up to {most} values up to {top}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, all equal, two far apart, and a run of each
    println(sum_differences([2, 3, 5]));
    println(sum_differences([1, 4, 6, 8, 10]));
    println(sum_differences([7, 7, 7]));
    println(sum_differences([1, 10000]));
    println(sum_differences([1, 1, 2, 2, 2, 9]));
    let mut seed = 1685;
    batch(3000, 12, 10, mut seed);
    batch(300, 1000, 10000, mut seed);
    batch(10, 100000, 10000, mut seed);
}
