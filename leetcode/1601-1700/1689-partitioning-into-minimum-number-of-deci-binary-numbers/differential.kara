// LeetCode #1689: Partitioning Into Minimum Number Of Deci-Binary Numbers
// -- the differential.
//
// Four arms against the statement read literally, on 3000 random n from
// 1 to 9999.
//
// P1  the answer is the statement read literally
// P2  the digits sorted, largest first, give the same answer
// P3  n written twice gives the same answer
// P4  a digit d written after n gives the larger of the answer and d
// P5  each arm agrees with at least two of the other three

// ---- deci.kara: the ★ arm: the largest digit

fn star_arm(n: String) -> i32 {
    let mut largest = 0;
    for b in n.bytes() {
        largest = max(largest, b - b'0');
    }
    largest
}

// ---- deci_chars.kara: the largest digit by `to_digit` and `max`

fn chars_arm(n: String) -> i32 {
    n.chars().map(|c| c.to_digit(10).unwrap()).max().unwrap() as i32
}

// ---- deci_peel.kara: the deci-binary numbers taken off one at a time

fn peel_arm(n: String) -> i32 {
    let mut digits: Vec[i32] = n.bytes().iter().map(|b| (b - b'0') as i32).collect();
    let mut rounds = 0;
    while digits.iter().any(|d| d > 0) {
        for d in digits.iter_mut() {
            if *d > 0 {
                *d -= 1;
            }
        }
        rounds += 1;
    }
    rounds
}

// ---- deci_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn min_partitions(n: String) -> i32 {
        (n.bytes().iter().max().unwrap() - b'0')
    }
}

fn solution_arm(n: String) -> i32 {
    SolutionArm.min_partitions(n)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally, for every n below 10000 at once: the
// fewest deci-binary numbers (each digit 0 or 1, no leading 0) that sum
// to n, carries allowed, by a table over the value
fn literal_table() -> Vec[i32] {
    let mut deci: Vec[i64] = Vec.new();
    for v in 1..10000 {
        if f"{v}".chars().all(|c| c == '0' or c == '1') {
            deci.push(v);
        }
    }
    let mut fewest = Vec.filled(10000, i32.MAX);
    fewest[0] = 0;
    for v in 1..10000 {
        for d in deci.iter() {
            if d <= v and fewest[v - d] != i32.MAX {
                fewest[v] = min(fewest[v], fewest[v - d] + 1);
            }
        }
    }
    fewest
}

fn arm(a: i64, n: String) -> i32 {
    match a {
        0 => star_arm(n),
        1 => chars_arm(n),
        2 => peel_arm(n),
        _ => solution_arm(n),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "chars", "peel", "solution"][a]
}

fn main() {
    let mut seed = 1689;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let fewest = literal_table();
    // n from 1 to 9999, and a digit to write after it
    let mut cases: Vec[(i64, i32)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 9999 + 1;
        let d = next_random(mut seed) % 10;
        cases.push((n, d as i32));
    }
    for (p, (n, d)) in cases.iter().enumerate() {
        let want = fewest[n];
        check = (check * 31 + want) % 1000000007;
        check = (check * 31 + n) % 1000000007;
        let text = f"{n}";
        let mut sorted: Vec[char] = text.chars().collect();
        sorted.sort();
        sorted.reverse();
        let sorted_text: String = sorted.iter().collect();
        let twice = f"{text}{text}";
        let longer = f"{text}{d}";
        let mut answers: Vec[i32] = Vec.new();
        for a in 0..4 {
            let got = arm(a, text);
            let failed = [
                got != want,
                arm(a, sorted_text) != got,
                arm(a, twice) != got,
                arm(a, longer) != max(got, d),
            ];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({n}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
