// LeetCode #1689: Partitioning Into Minimum Number Of Deci-Binary Numbers
// -- the bench: the ★ arm on 100 random numbers of 100000 digits, all
// drawn first, each answered 50 times.
//
// A deci-binary number adds at most 1 to each digit, so a digit d needs d
// of them; and d of them suffice, the k-th holding a 1 wherever the digit
// is at least k. The answer is the largest digit, one pass over the
// bytes. O(n).

fn min_partitions(n: String) -> i32 {
    let mut largest = 0;
    for b in n.bytes() {
        largest = max(largest, b - b'0');
    }
    largest
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100;
    let size = 100000;
    let rounds = 50;
    let digits = "0123456789".bytes();
    let mut seed = 1689;
    // each number's digits up to a random top from 1 to 9, the first not 0
    let mut numbers: Vec[String] = Vec.new();
    for _ in 0..count {
        let top = next_random(mut seed) % 9 + 1;
        let mut n = String.with_capacity(size);
        n.push(digits[next_random(mut seed) % top + 1] as char);
        for _ in 1..size {
            n.push(digits[next_random(mut seed) % (top + 1)] as char);
        }
        numbers.push(n);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for n in numbers.iter() {
            let answer = min_partitions(n);
            total += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} numbers of {size} digits, {rounds} rounds: answers sum to {total}, checksum {check}");
}
