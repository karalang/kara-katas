// LeetCode #1689: Partitioning Into Minimum Number Of Deci-Binary Numbers
// -- a Rust solution as LeetCode's Rust users write it: the largest byte
// by `bytes().max()`, less `b'0'`, `as i32`.

struct Solution {}

impl Solution {
    pub fn min_partitions(n: String) -> i32 {
        (n.bytes().iter().max().unwrap() - b'0')
    }
}

fn min_partitions(n: String) -> i32 {
    Solution.min_partitions(n)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random numbers of 1 to `most` digits, each digit up to a random
// top from 1 to 9 and the first not 0; the answers summed, and a checksum
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let digits = "0123456789".bytes();
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let length = next_random(mut seed) % most + 1;
        let top = next_random(mut seed) % 9 + 1;
        let mut n = String.new();
        n.push(digits[next_random(mut seed) % top + 1] as char);
        for _ in 1..length {
            n.push(digits[next_random(mut seed) % (top + 1)] as char);
        }
        let answer = min_partitions(n);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} numbers of up to {most} digits: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, 1, and a power of ten
    println(min_partitions("32"));
    println(min_partitions("82734"));
    println(min_partitions("27346209830709182346"));
    println(min_partitions("1"));
    println(min_partitions("1000"));
    let mut seed = 1689;
    batch(3000, 10, mut seed);
    batch(300, 1000, mut seed);
    batch(10, 100000, mut seed);
}
