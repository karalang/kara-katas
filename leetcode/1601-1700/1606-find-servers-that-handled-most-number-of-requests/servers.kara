// LeetCode #1606: Find Servers That Handled Most Number of Requests --
// the ★ arm.
//
// The free servers in a `SortedSet`, so the first free one at or after
// `i % k` is `range(i % k, k)`'s first, or else the set's smallest; the
// busy ones in a `PriorityQueue` of (time free, server), smallest first,
// given back to the set as each request arrives. O(n log k).

fn busiest_servers(k: i32, arrival: own Vec[i32], load: own Vec[i32]) -> Vec[i32] {
    let mut free: SortedSet[i32] = (0..k).collect();
    let mut busy: PriorityQueue[(i64, i32)] = PriorityQueue.new();
    let mut handled = Vec.filled(k, 0);
    for i in 0..arrival.len() {
        let now = arrival[i] as i64;
        while let Some((t, _)) = busy.peek() {
            if t > now {
                break;
            }
            let (_, s) = busy.pop().unwrap();
            free.insert(s);
        }
        let start = (i % k) as i32;
        let pick = free.range(start, k).next().or(free.min()).cloned();
        if let Some(s) = pick {
            free.remove(s);
            busy.push((now + load[i], s));
            handled[s] += 1;
        }
    }
    let most = *handled.iter().max().unwrap();
    (0..k).filter(|s| handled[s] == most).collect()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` problems of up to `most_k` servers and `most_n` requests, each
// arriving 1 to `gap` after the one before and lasting 1 to `longest`
fn batch(count: i64, most_k: i64, most_n: i64, gap: i64, longest: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut requests = 0;
    let mut busiest = 0;
    for _ in 0..count {
        let k = (next_random(mut seed) % most_k + 1) as i32;
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most_n + 1;
        let mut arrival: Vec[i32] = Vec.new();
        let mut load: Vec[i32] = Vec.new();
        let mut t = 0;
        for _ in 0..n {
            t += next_random(mut seed) % gap + 1;
            arrival.push(t as i32);
            load.push((next_random(mut seed) % longest + 1) as i32);
        }
        let servers = busiest_servers(k, arrival, load);
        for s in servers.iter() {
            check = mix(check, *s);
        }
        check = mix(check, -1);
        busiest += servers.len();
        requests += n;
    }
    println(f"{count} problems of up to {most_k} servers and {most_n} requests: {requests} requests, {busiest} busiest, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one server, every request dropped
    // but the first, and requests that each wrap past the last server
    let examples: Vec[(i32, Vec[i32], Vec[i32])] = [
        (3, [1, 2, 3, 4, 5], [5, 2, 3, 3, 3]),
        (3, [1, 2, 3, 4], [1, 2, 1, 2]),
        (3, [1, 2, 3], [10, 12, 11]),
        (1, [1, 2, 3, 4], [1, 5, 1, 1]),
        (2, [1, 2, 3, 4], [100, 100, 100, 100]),
        (3, [1, 2, 3, 4, 5, 6], [9, 9, 1, 9, 9, 9]),
    ];
    for (k, arrival, load) in examples.iter() {
        let servers: Vec[String] = busiest_servers(k, arrival.clone(), load.clone()).iter().map(|s| s.to_string()).collect();
        println(f"[{servers.join(",")}]");
    }
    let mut seed = 1606;
    batch(3000, 4, 10, 3, 8, mut seed);
    batch(300, 100, 3000, 5, 400, mut seed);
    batch(3, 1000, 100000, 10, 10000, mut seed);
}
