// LeetCode #1606: Find Servers That Handled Most Number of Requests --
// the bench: the ★ arm on 20 problems of 10000 servers and 100000
// requests, each arriving 1 to 3 after the one before and lasting 1 to
// 30000, all drawn first.
//
// The ★ arm: the free servers in a sorted set, the busy ones in a
// priority queue of (time free, server).

fn busiest_servers(k: i32, arrival: own Vec[i32], load: own Vec[i32]) -> Vec[i32] {
    let mut free: SortedSet[i32] = (0..k).collect();
    let mut busy: PriorityQueue[(i64, i32)] = PriorityQueue.new();
    let mut handled = Vec.filled(k, 0);
    for i in 0..arrival.len() {
        let now = arrival[i] as i64;
        while let Some((t, _)) = busy.peek() {
            if t > now {
                break;
            }
            let (_, s) = busy.pop().unwrap();
            free.insert(s);
        }
        let start = (i % k) as i32;
        let pick = free.range(start, k).next().or(free.min()).cloned();
        if let Some(s) = pick {
            free.remove(s);
            busy.push((now + load[i], s));
            handled[s] += 1;
        }
    }
    let most = *handled.iter().max().unwrap();
    (0..k).filter(|s| handled[s] == most).collect()
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1606;
    let mut problems: Vec[(Vec[i32], Vec[i32])] = Vec.new();
    for _ in 0..20 {
        let mut arrival: Vec[i32] = Vec.new();
        let mut load: Vec[i32] = Vec.new();
        let mut t = 0;
        for _ in 0..100000 {
            t += next_random(mut seed) % 3 + 1;
            arrival.push(t as i32);
            load.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % 30000 + 1) as i32);
        }
        problems.push((arrival, load));
    }
    let mut check = 0;
    let mut busiest = 0;
    for (arrival, load) in problems.iter() {
        let servers = busiest_servers(10000, arrival.clone(), load.clone());
        for s in servers.iter() {
            check = mix(check, *s);
        }
        busiest += servers.len();
    }
    println(f"20 problems of 10000 servers and 100000 requests: {busiest} busiest, checksum {check}");
}
