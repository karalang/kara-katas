// LeetCode #1671: Minimum Number of Removals to Make Mountain Array -- the
// bench: the ★ arm on 300 arrays of 1000 values up to 10^9, one raised
// above the rest, all drawn first.

fn minimum_mountain_removals(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut up = Vec.filled(n, 1);
    let mut down = Vec.filled(n, 1);
    for i in 0..n {
        for j in 0..i {
            if nums[j] < nums[i] {
                up[i] = max(up[i], up[j] + 1);
            }
        }
    }
    for i in (0..n).rev() {
        for j in i + 1..n {
            if nums[j] < nums[i] {
                down[i] = max(down[i], down[j] + 1);
            }
        }
    }
    let mut longest = 0;
    for i in 1..n - 1 {
        if up[i] > 1 and down[i] > 1 {
            longest = max(longest, up[i] + down[i] - 1);
        }
    }
    (n - longest) as i32
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arrays = 300;
    let n = 1000;
    let most = 1000000000;
    let mut seed = 1671;
    let mut all: Vec[Vec[i32]] = Vec.new();
    for _ in 0..arrays {
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1) as i32);
        }
        let peak = next_random(mut seed) % (n - 2) + 1;
        nums[peak] = (most + 1) as i32;
        all.push(nums);
    }
    let mut total = 0;
    let mut check = 0;
    for nums in all.iter() {
        let removed = minimum_mountain_removals(nums);
        total += removed;
        check = (check * 31 + removed) % 1000000007;
    }
    println(f"{arrays} arrays of {n} values: {total} removals, checksum {check}");
}
