// LeetCode #1673: Find the Most Competitive Subsequence -- the
// differential.
//
// Four arms against the statement read literally, on 3000 random arrays
// of 1 to 10 values from 0 to between 1 and 5, each with a random k.
//
// P1  the answer is the statement read literally
// P2  the answer holds k values and is a subsequence of nums
// P3  a value above all the others put in front changes nothing
// P4  a value below all the others put in front, with k + 1, gives that
//     value and then the same answer
// P5  each arm agrees with at least two of the other three

// ---- competitive.kara: the ★ arm: a rising stack

fn star_arm(nums: Vec[i32], k: i32) -> Vec[i32] {
    let n = nums.len();
    let k = k as i64;
    let mut stack: Vec[i32] = Vec.new();
    for i in 0..n {
        while let Some(top) = stack.last() {
            if top > nums[i] and stack.len() - 1 + n - i >= k {
                stack.pop();
            } else {
                break;
            }
        }
        if stack.len() < k {
            stack.push(nums[i]);
        }
    }
    stack
}

// ---- competitive_scan.kara: each place filled by a scan

fn scan_arm(nums: Vec[i32], k: i32) -> Vec[i32] {
    let n = nums.len();
    let mut answer = Vec.new();
    let mut start = 0;
    for j in 0..k as i64 {
        let end = n - (k - j - 1);
        let mut best = start;
        for i in start + 1..end {
            if nums[i] < nums[best] {
                best = i;
            }
        }
        answer.push(nums[best]);
        start = best + 1;
    }
    answer
}

// ---- competitive_heap.kara: each window's smallest from a heap

fn heap_arm(nums: Vec[i32], k: i32) -> Vec[i32] {
    let n = nums.len();
    let k = k as i64;
    let mut heap: PriorityQueue[(i32, i64)] = PriorityQueue.new();
    let mut answer = Vec.new();
    let mut start = 0;
    for i in 0..n - k {
        heap.push((nums[i], i));
    }
    for j in 0..k {
        let i = n - k + j;
        heap.push((nums[i], i));
        loop {
            let (v, at) = heap.pop().unwrap();
            if at >= start {
                answer.push(v);
                start = at + 1;
                break;
            }
        }
    }
    answer
}

// ---- competitive_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn most_competitive(nums: Vec[i32], k: i32) -> Vec[i32] {
        let k = k as i64;
        let n = nums.len();
        let mut stack: Vec[i32] = Vec.with_capacity(k);
        for (i, x) in nums.iter().enumerate() {
            while let Some(top) = stack.last().cloned() {
                if top > x and stack.len() + n - i > k {
                    stack.pop();
                } else {
                    break;
                }
            }
            if stack.len() < k {
                stack.push(x);
            }
        }
        stack
    }
}

fn solution_arm(nums: Vec[i32], k: i32) -> Vec[i32] {
    SolutionArm.most_competitive(nums, k)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every subsequence of k values, each a
// choice of k indexes in order, compared as sequences; the smallest
fn literal(nums: Slice[i32], k: i64) -> Vec[i32] {
    let n = nums.len();
    let mut best: Option[Vec[i32]] = None;
    for mask in 0..1 << n {
        let picked: Vec[i32] = (0..n).filter(|i| mask >> i & 1 == 1).map(|i| nums[i]).collect();
        if picked.len() != k {
            continue;
        }
        let smaller = match best {
            Some(ref b) => picked < b,
            None => true,
        };
        if smaller {
            best = Some(picked);
        }
    }
    best.unwrap()
}

// whether `part` can be read out of `whole` in order
fn is_subsequence(part: Slice[i32], whole: Slice[i32]) -> bool {
    let mut at = 0;
    for v in whole.iter() {
        if at < part.len() and part[at] == v {
            at += 1;
        }
    }
    at == part.len()
}

fn arm(a: i64, nums: Slice[i32], k: i64) -> Vec[i32] {
    let nums = nums.to_vec();
    let k = k as i32;
    match a {
        0 => star_arm(nums, k),
        1 => scan_arm(nums, k),
        2 => heap_arm(nums, k),
        _ => solution_arm(nums, k),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "scan", "heap", "solution"][a]
}

fn main() {
    let mut seed = 1673;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(Vec[i32], i64)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 10 + 1;
        let most = next_random(mut seed) % 5 + 1;
        let nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % most) as i32).collect();
        let k = next_random(mut seed) % n + 1;
        cases.push((nums, k));
    }
    for (p, (nums, k)) in cases.iter().enumerate() {
        let want = literal(nums, k);
        for v in want.iter() {
            check = (check * 31 + v + 1) % 1000000007;
        }
        let mut behind = [9];
        behind.extend(nums.iter());
        let mut fronted = [-1];
        fronted.extend(nums.iter());
        let mut answers: Vec[Vec[i32]] = Vec.new();
        for a in 0..4 {
            let got = arm(a, nums, k);
            let after = arm(a, fronted, k + 1);
            let failed = [
                got != want,
                got.len() != k or not is_subsequence(got, nums),
                arm(a, behind, k) != got,
                after[0] != -1 or after[1..] != got,
            ];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({nums}, k = {k}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
