// LeetCode #1673: Find the Most Competitive Subsequence -- the ★ arm: a
// rising stack.
//
// The answer is built on a stack. Each value pops the larger values on
// top while enough values remain after it to still fill k, then goes on
// if the stack is not yet full. What is left is the smallest choice from
// the front: no kept value has a smaller one after it that could have
// taken its place. Each value is pushed and popped at most once: O(n).

fn most_competitive(nums: Vec[i32], k: i32) -> Vec[i32] {
    let n = nums.len();
    let k = k as i64;
    let mut stack: Vec[i32] = Vec.new();
    for i in 0..n {
        while let Some(top) = stack.last() {
            if top > nums[i] and stack.len() - 1 + n - i >= k {
                stack.pop();
            } else {
                break;
            }
        }
        if stack.len() < k {
            stack.push(nums[i]);
        }
    }
    stack
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` arrays of 1 to `longest` values from 0 to `most` - 1, each with
// a random k; the values chosen, and a checksum of every answer
fn batch(count: i64, longest: i64, most: i64, seed: mut ref i64) {
    let mut chosen = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % longest + 1;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % most) as i32);
        }
        let k = (next_random(mut seed) % n + 1) as i32;
        let answer = most_competitive(nums, k);
        chosen += answer.len();
        for v in answer.iter() {
            check = (check * 31 + v + 1) % 1000000007;
        }
    }
    println(f"{count} arrays of up to {longest} values below {most}: {chosen} chosen, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then all of it, one value, a rising and a
    // falling array
    println(most_competitive([3, 5, 2, 6], 2));
    println(most_competitive([2, 4, 3, 3, 5, 4, 9, 6], 4));
    println(most_competitive([5, 1, 4], 3));
    println(most_competitive([7, 3, 9, 1], 1));
    println(most_competitive([1, 2, 3, 4, 5], 3));
    println(most_competitive([5, 4, 3, 2, 1], 3));
    let mut seed = 1673;
    batch(3000, 12, 5, mut seed);
    batch(300, 1000, 1000000000, mut seed);
    batch(10, 100000, 10, mut seed);
}
