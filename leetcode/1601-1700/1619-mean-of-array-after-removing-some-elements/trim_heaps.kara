// LeetCode #1619: Mean of Array After Removing Some Elements -- two heaps.
//
// The whole sum, less the n / 20 smallest and the n / 20 largest, each
// kept in a heap of that size as the values stream past: a max-heap holds
// the smallest so far, a min-heap (of `Reverse`) the largest.
// O(n log k) for k = n / 20.

import std.cmp.Reverse;

fn trim_mean(arr: Slice[i32]) -> f64 {
    let n = arr.len();
    let k = n / 20;
    let mut smallest: PriorityQueue[i32] = PriorityQueue.max_first();
    let mut largest: PriorityQueue[Reverse[i32]] = PriorityQueue.max_first();
    let mut total: i64 = 0;
    for x in arr.iter() {
        total += x;
        smallest.push(x);
        if smallest.len() > k {
            smallest.pop();
        }
        largest.push(Reverse { value: x });
        if largest.len() > k {
            largest.pop();
        }
    }
    let low: i64 = smallest.iter().map(|x| x as i64).sum();
    let high: i64 = largest.iter().map(|Reverse { value: x }| x as i64).sum();
    (total - low - high) as f64 / (n - 2 * k) as f64
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A draw below `bound`, from two draws so that it can pass 32768.
fn wide_random(seed: mut ref i64, bound: i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % bound
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0.0;
    let mut values = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) % (most / 20) + 1) * 20;
        let arr: Vec[i32] = (0..n).map(|_| wide_random(mut seed, top + 1) as i32).collect();
        let mean = trim_mean(arr);
        total += mean;
        check = mix(check, (mean * 100000.0).round() as i64);
        values += n;
    }
    println(f"{count} arrays of up to {most} values below {top + 1}: {values} values, means sum to {total:.5}, checksum {check}");
}

fn main() {
    // LeetCode's three examples
    println(f"{trim_mean([1, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 3]):.5}");
    println(f"{trim_mean([6, 2, 7, 5, 1, 2, 0, 3, 10, 2, 5, 0, 5, 5, 0, 8, 7, 6, 8, 0]):.5}");
    println(f"{trim_mean([6, 0, 7, 0, 7, 5, 7, 8, 3, 4, 0, 7, 8, 1, 6, 8, 1, 1, 2, 4, 8, 1, 9, 5, 4, 3, 8, 5, 10, 8, 6, 6, 1, 0, 6, 10, 8, 2, 3, 4]):.5}");
    let mut seed = 1619;
    batch(3000, 40, 10, mut seed);
    batch(300, 1000, 100000, mut seed);
    batch(30, 1000, 5, mut seed);
}
