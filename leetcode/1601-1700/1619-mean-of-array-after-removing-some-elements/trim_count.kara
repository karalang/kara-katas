// LeetCode #1619: Mean of Array After Removing Some Elements -- counting.
//
// No sort: count each value up to the largest, then walk the counts from
// the bottom, passing over the first n / 20 values and the last n / 20,
// adding the rest. O(n + m) for n values below m.

fn trim_mean(arr: Slice[i32]) -> f64 {
    let n = arr.len();
    let k = n / 20;
    let top = arr.iter().max().unwrap();
    let mut counts = Vec.filled(top as i64 + 1, 0);
    for x in arr.iter() {
        counts[x] += 1;
    }
    let mut seen = 0;
    let mut sum = 0;
    for (v, c) in counts.iter().enumerate() {
        // of this value's copies, the ones at sorted places k to n - k - 1
        let first = max(seen, k);
        let last = min(seen + c, n - k);
        if last > first {
            sum += (last - first) * v;
        }
        seen += c;
    }
    sum as f64 / (n - 2 * k) as f64
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A draw below `bound`, from two draws so that it can pass 32768.
fn wide_random(seed: mut ref i64, bound: i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % bound
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0.0;
    let mut values = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) % (most / 20) + 1) * 20;
        let arr: Vec[i32] = (0..n).map(|_| wide_random(mut seed, top + 1) as i32).collect();
        let mean = trim_mean(arr);
        total += mean;
        check = mix(check, (mean * 100000.0).round() as i64);
        values += n;
    }
    println(f"{count} arrays of up to {most} values below {top + 1}: {values} values, means sum to {total:.5}, checksum {check}");
}

fn main() {
    // LeetCode's three examples
    println(f"{trim_mean([1, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 3]):.5}");
    println(f"{trim_mean([6, 2, 7, 5, 1, 2, 0, 3, 10, 2, 5, 0, 5, 5, 0, 8, 7, 6, 8, 0]):.5}");
    println(f"{trim_mean([6, 0, 7, 0, 7, 5, 7, 8, 3, 4, 0, 7, 8, 1, 6, 8, 1, 1, 2, 4, 8, 1, 9, 5, 4, 3, 8, 5, 10, 8, 6, 6, 1, 0, 6, 10, 8, 2, 3, 4]):.5}");
    let mut seed = 1619;
    batch(3000, 40, 10, mut seed);
    batch(300, 1000, 100000, mut seed);
    batch(30, 1000, 5, mut seed);
}
