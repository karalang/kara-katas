// LeetCode #1619: Mean of Array After Removing Some Elements -- the bench,
// on the ★ arm: sort a copy, then the mean of the middle 90%.
//
// Build once, then punch: 20000 random arrays of 1000 values below
// 100001, all drawn first, then each one's trimmed mean.

fn trim_mean(arr: Slice[i32]) -> f64 {
    let mut sorted = arr.to_vec();
    sorted.sort();
    let k = sorted.len() / 20;
    let kept = sorted[k..sorted.len() - k];
    kept.iter().sum() as f64 / kept.len() as f64
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1619;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    for _ in 0..20000 {
        arrays.push((0..1000).map(|_| ((next_random(mut seed) * 32768 + next_random(mut seed)) % 100001) as i32).collect());
    }
    let mut check = 0;
    let mut total = 0.0;
    for arr in arrays.iter() {
        let mean = trim_mean(arr);
        total += mean;
        check = mix(check, (mean * 100000.0).round() as i64);
    }
    println(f"20000 arrays of 1000 values: means sum to {total:.5}, checksum {check}");
}
