// LeetCode #1682: Longest Palindromic Subsequence II -- a memoized search
// that drops an end at a time.
//
// `longest(i, j, outer)` is the longest good palindromic subsequence of
// s[i..=j] whose outer letter is not `outer`, the letter of the layer
// around it (26 for none). Equal ends of another letter can be its outer
// pair; else either end is dropped. Each (i, j, outer) is solved once.
// O(n^2 * 27).

fn longest_palindrome_subseq(s: String) -> i32 {
    let letters: Vec[i64] = s.bytes().iter().map(|b| (b - b'a') as i64).collect();
    let n = letters.len();
    let mut memo: Vec[i32] = Vec.filled(n * n * 27, -1);
    if n == 0 {
        return 0;
    }
    longest(letters, 0, n - 1, 26, mut memo)
}

fn longest(letters: Slice[i64], i: i64, j: i64, outer: i64, memo: mut ref Vec[i32]) -> i32 {
    if i >= j {
        return 0;
    }
    let n = letters.len();
    let key = (i * n + j) * 27 + outer;
    if memo[key] >= 0 {
        return memo[key];
    }
    let found = if letters[i] == letters[j] and letters[i] != outer {
        2 + longest(letters, i + 1, j - 1, letters[i], mut memo)
    } else {
        max(longest(letters, i + 1, j, outer, mut memo), longest(letters, i, j - 1, outer, mut memo))
    };
    memo[key] = found;
    found
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random strings of 1 to `longest` letters from the first
// `letters` of the alphabet; the answers summed, and a checksum
fn batch(count: i64, longest: i64, letters: i64, seed: mut ref i64) {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % longest + 1;
        let mut s = String.new();
        for _ in 0..n {
            let at = next_random(mut seed) % letters;
            s.push_str(alphabet[at..at + 1]);
        }
        let answer = longest_palindrome_subseq(s);
        total += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} strings of up to {longest} letters from {letters}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one letter, one letter repeated, and
    // a palindrome whose layers alternate
    println(longest_palindrome_subseq("bbabab"));
    println(longest_palindrome_subseq("dcbccacdb"));
    println(longest_palindrome_subseq("a"));
    println(longest_palindrome_subseq("aaaa"));
    println(longest_palindrome_subseq("abababba"));
    let mut seed = 1682;
    batch(3000, 10, 3, mut seed);
    batch(300, 60, 4, mut seed);
    batch(10, 250, 26, mut seed);
}
