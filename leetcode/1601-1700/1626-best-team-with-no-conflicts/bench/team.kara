// LeetCode #1626: Best Team With No Conflicts -- the bench, on the ★ arm:
// sorted by (age, score), the best team ending at each player from every
// earlier player scoring no higher.
//
// Build once, then punch: 100 random teams of 1000 players, scores up to
// 10^6 and ages up to 1000, all drawn first, then each one's best score.

fn best_team_score(scores: Vec[i32], ages: Vec[i32]) -> i32 {
    let mut players: Vec[(i32, i32)] = ages.iter().zip(scores.iter()).collect();
    players.sort();
    let n = players.len();
    let mut best: Vec[i64] = Vec.filled(n, 0);
    for i in 0..n {
        let score = players[i].1;
        best[i] = score;
        for j in 0..i {
            if players[j].1 <= score {
                best[i] = max(best[i], best[j] + score);
            }
        }
    }
    best.iter().max().unwrap() as i32
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1626;
    let mut teams: Vec[(Vec[i32], Vec[i32])] = Vec.new();
    for _ in 0..100 {
        let mut scores: Vec[i32] = Vec.new();
        let mut ages: Vec[i32] = Vec.new();
        for _ in 0..1000 {
            let high = next_random(mut seed);
            scores.push(((high * 32768 + next_random(mut seed)) % 1000000 + 1) as i32);
            ages.push((next_random(mut seed) % 1000 + 1) as i32);
        }
        teams.push((scores, ages));
    }
    let mut check = 0;
    let mut total = 0;
    for (scores, ages) in teams.iter() {
        let got = best_team_score(scores, ages);
        total += got;
        check = mix(check, got);
    }
    println(f"100 teams of 1000 players: best scores sum to {total}, checksum {check}");
}
