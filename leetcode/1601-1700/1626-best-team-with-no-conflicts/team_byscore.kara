// LeetCode #1626: Best Team With No Conflicts -- sorted by score.
//
// The same rising-run count turned round: sorted by score, then age, a
// team has no conflict exactly when its ages never fall along that
// order, so each player extends the best team ending at an earlier
// player no older. O(n^2).

struct Player {
    score: i64,
    age: i64,
}

fn best_team_score(scores: Vec[i32], ages: Vec[i32]) -> i32 {
    let mut players: Vec[Player] = Vec.new();
    for i in 0..scores.len() {
        players.push(Player { score: scores[i], age: ages[i] });
    }
    players.sort_by_key(|p| (p.score, p.age));
    let mut best: Vec[i64] = Vec.new();
    for (i, p) in players.iter().enumerate() {
        let mut most = 0;
        for j in 0..i {
            if players[j].age <= p.age {
                most = max(most, best[j]);
            }
        }
        best.push(most + p.score);
    }
    best.iter().max().unwrap() as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` random teams of 1 to `most` players, scores up to `top_score`
// and ages up to `top_age`; the answers summed, and a checksum
fn batch(count: i64, most: i64, top_score: i64, top_age: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut scores: Vec[i32] = Vec.new();
        let mut ages: Vec[i32] = Vec.new();
        for _ in 0..n {
            scores.push((next_random(mut seed) % top_score + 1) as i32);
            ages.push((next_random(mut seed) % top_age + 1) as i32);
        }
        let got = best_team_score(scores, ages);
        total += got;
        check = mix(check, got);
    }
    println(f"{count} teams of up to {most} players: best scores sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one player, and players all of one
    // age, who never conflict
    println(best_team_score([1, 3, 5, 10, 15], [1, 2, 3, 4, 5]));
    println(best_team_score([4, 5, 6, 5], [2, 1, 2, 1]));
    println(best_team_score([1, 2, 3, 5], [8, 9, 10, 1]));
    println(best_team_score([7], [30]));
    println(best_team_score([9, 2, 7, 4], [5, 5, 5, 5]));
    let mut seed = 1626;
    batch(3000, 10, 10, 5, mut seed);
    batch(300, 100, 1000, 100, mut seed);
    batch(10, 1000, 30000, 1000, mut seed);
}
