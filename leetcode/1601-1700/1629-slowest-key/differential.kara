// LeetCode #1629: Slowest Key -- the differential.
//
// Four arms against the statement read literally, on 3000 random problems
// of 2 to 8 presses: every other one with keys from a to d and presses of
// 1 to 3 ms, so ties are common, the rest with any key and presses of 1
// to 50 ms. Every random choice is drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  every release time doubled leaves the answer
// P3  one more press, longer than all before it, is the answer, whatever
//     its key
// P4  the answer is one of the keys pressed
// P5  a 1 ms press of `a` put first leaves the answer
// P6  each arm agrees with at least two of the other three

// ---- keys.kara: the ★ arm: the largest (duration, key) pair

fn star_arm(release_times: Vec[i32], keys_pressed: String) -> char {
    let mut previous = 0;
    let mut best = (0, 'a');
    for (time, key) in release_times.iter().zip(keys_pressed.chars()) {
        best = max(best, (time - previous, key));
        previous = time;
    }
    best.1
}

// ---- keys_table.kara: each letter's longest press, then the letters from z down

fn table_arm(release_times: Vec[i32], keys_pressed: String) -> char {
    let keys = keys_pressed.bytes();
    let mut longest = [0; 26];
    for i in 0..release_times.len() {
        let start = if i == 0 { 0 } else { release_times[i - 1] };
        let slot = (keys[i] - b'a') as i64;
        longest[slot] = max(longest[slot], release_times[i] - start);
    }
    let top = longest.iter().max().unwrap();
    let mut letter = 25;
    while longest[letter] != top {
        letter -= 1;
    }
    (b'a' + letter as u8) as char
}

// ---- keys_loop.kara: an index loop keeping the best as two variables

fn loop_arm(release_times: Vec[i32], keys_pressed: String) -> char {
    let keys: Vec[char] = keys_pressed.chars().collect();
    let mut best_key = keys[0];
    let mut best_time = release_times[0];
    for i in 1..keys.len() {
        let time = release_times[i] - release_times[i - 1];
        if time > best_time or (time == best_time and keys[i] > best_key) {
            best_key = keys[i];
            best_time = time;
        }
    }
    best_key
}

// ---- keys_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn slowest_key(release_times: Vec[i32], keys_pressed: String) -> char {
        let keys = keys_pressed.bytes();
        let mut best = (release_times[0], keys[0]);
        for i in 1..release_times.len() {
            let press = (release_times[i] - release_times[i - 1], keys[i]);
            if press > best {
                best = press;
            }
        }
        best.1 as char
    }
}

fn solution_arm(release_times: Vec[i32], keys_pressed: String) -> char {
    SolutionArm.slowest_key(release_times, keys_pressed)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(k: i64, release_times: Vec[i32], keys_pressed: String) -> char {
    match k {
        0 => star_arm(release_times, keys_pressed),
        1 => table_arm(release_times, keys_pressed),
        2 => loop_arm(release_times, keys_pressed),
        _ => solution_arm(release_times, keys_pressed),
    }
}

fn arm_name(k: i64) -> String {
    ["keys", "table", "loop", "solution"][k].to_string()
}

// ---- the statement read literally: every press's duration listed, the
// longest found, and the largest key among the presses that long

fn literal(release_times: Vec[i32], keys_pressed: String) -> char {
    let keys: Vec[char] = keys_pressed.chars().collect();
    let mut durations: Vec[i32] = [release_times[0]];
    for i in 1..release_times.len() {
        durations.push(release_times[i] - release_times[i - 1]);
    }
    let longest = durations.iter().max().unwrap();
    let mut answer = 'a';
    for i in 0..keys.len() {
        if durations[i] == longest and keys[i] > answer {
            answer = keys[i];
        }
    }
    answer
}

fn main() {
    let mut seed = 1629;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(Vec[i32], String, char)] = [];
    for p in 0..problems {
        // every other case with few letters and short presses, so ties
        // are common
        let (letters, longest) = if p % 2 == 0 { (4, 3) } else { (26, 50) };
        let n = next_random(mut seed) % 7 + 2;
        let mut release_times: Vec[i32] = [];
        let mut keys_pressed = String.new();
        let mut time = 0;
        for _ in 0..n {
            time += next_random(mut seed) % longest + 1;
            release_times.push(time as i32);
            keys_pressed.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        let extra = (b'a' + (next_random(mut seed) % 26) as u8) as char;
        cases.push((release_times, keys_pressed, extra));
    }
    for p in 0..problems {
        let (release_times, keys_pressed, extra) = cases[p].clone();
        let want = literal(release_times, keys_pressed);
        check = (check * 31 + want as i64) % 1000000007;
        let doubled: Vec[i32] = release_times.iter().map(|t| 2 * t).collect();
        let last = release_times[release_times.len() - 1];
        let mut longer = release_times.clone();
        longer.push(last + last + 1);
        let mut longer_keys = keys_pressed.clone();
        longer_keys.push(extra);
        let shifted: Vec[i32] = [1].iter().cloned().chain(release_times.iter().map(|t| t + 1)).collect();
        let shifted_keys = f"a{keys_pressed}";
        let mut answers: Vec[char] = [];
        for k in 0..4 {
            let got = arm(k, release_times, keys_pressed);
            answers.push(got);
            let failed = [
                got != want,
                arm(k, doubled, keys_pressed) != got,
                arm(k, longer, longer_keys) != extra,
                not keys_pressed.contains(got.to_string()),
                arm(k, shifted, shifted_keys) != got,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({release_times}, {keys_pressed}), {arm_name(k)}: P{q + 1}");
                    }
                }
            }
        }
        // P6
        for k in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|x| x == answers[k]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
