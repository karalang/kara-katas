// LeetCode #1696: Jump Game VI -- the best score in reach from a heap.
//
// Each score goes into a max-first `PriorityQueue` with its index; the top
// is taken once any that has left the reach is popped. O(n log n).

fn max_result(nums: Vec[i32], k: i32) -> i32 {
    let mut scores: PriorityQueue[(i32, i64)] = PriorityQueue.max_first();
    scores.push((nums[0], 0));
    let mut last = nums[0];
    for i in 1..nums.len() {
        while scores.peek().unwrap().1 < i - k {
            scores.pop();
        }
        last = nums[i] + scores.peek().unwrap().0;
        scores.push((last, i));
    }
    last
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random arrays of 1 to `most` values from -`top` to `top`, each
// with a k from 1 to the smaller of its length and `reach`; the answers
// summed, and a checksum of them
fn batch(count: i64, most: i64, top: i64, reach: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) % (2 * top + 1) - top) as i32);
        }
        let k = next_random(mut seed) % min(n, reach) + 1;
        let answer = max_result(nums, k as i32);
        total += answer;
        check = ((check * 31 + answer) % 1000000007 + 1000000007) % 1000000007;
    }
    println(f"{count} arrays of up to {most} values within {top}, k up to {reach}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, and steps of one
    println(max_result([1, -1, -2, 4, -7, 3], 2));
    println(max_result([10, -5, -2, 4, 0, 3], 3));
    println(max_result([1, -5, -20, 4, -1, 3, -6, -3], 2));
    println(max_result([5], 1));
    println(max_result([1, -1, -1, 1], 1));
    let mut seed = 1696;
    batch(3000, 12, 5, 12, mut seed);
    batch(300, 1000, 10000, 1000, mut seed);
    batch(10, 100000, 10000, 100, mut seed);
}
