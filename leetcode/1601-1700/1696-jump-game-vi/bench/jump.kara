// LeetCode #1696: Jump Game VI -- the bench: the ★ arm on 50 random
// arrays of 100000 values from -10^4 to 10^4, LeetCode's largest, each
// with a random k up to 100000, all drawn first, each answered 20 times.
//
// A `VecDeque` holds the indexes in reach whose scores fall from front to
// back, so the front is the best score to jump from. O(n).

fn max_result(nums: Vec[i32], k: i32) -> i32 {
    let mut best = Vec.filled(nums.len(), 0);
    best[0] = nums[0];
    let mut reach: VecDeque[i64] = VecDeque.new();
    reach.push_back(0);
    for i in 1..nums.len() {
        if reach[0] < i - k {
            reach.pop_front();
        }
        best[i] = nums[i] + best[reach[0]];
        while not reach.is_empty() and best[reach[reach.len() - 1]] <= best[i] {
            reach.pop_back();
        }
        reach.push_back(i);
    }
    best[nums.len() - 1]
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 50;
    let rounds = 20;
    let n = 100000;
    let mut seed = 1696;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    let mut ks: Vec[i32] = Vec.new();
    for _ in 0..count {
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) % 20001 - 10000) as i32);
        }
        arrays.push(nums);
        ks.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % n + 1) as i32);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (c, nums) in arrays.iter().enumerate() {
            let answer = max_result(nums, ks[c]);
            total += answer;
            check = ((check * 31 + answer + r) % 1000000007 + 1000000007) % 1000000007;
        }
    }
    println(f"{count} arrays of {n} values, {rounds} rounds: answers sum to {total}, checksum {check}");
}
