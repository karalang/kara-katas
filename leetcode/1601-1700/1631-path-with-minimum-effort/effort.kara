// LeetCode #1631: Path With Minimum Effort -- the ★ arm.
//
// Dijkstra's algorithm with a path's cost its largest step rather than
// its sum: a `PriorityQueue` (smallest first) of (effort, row, column),
// each cell settled the first time it is popped, and a neighbour's effort
// the larger of the path's and the step to it. O(rc log rc).

fn minimum_effort_path(heights: Vec[Vec[i32]]) -> i32 {
    let (rows, cols) = (heights.len(), heights[0].len());
    let mut best: Vec[Vec[i32]] = Vec.filled(rows, Vec.filled(cols, i32.MAX));
    let mut queue: PriorityQueue[(i32, i64, i64)] = PriorityQueue.new();
    best[0][0] = 0;
    queue.push((0, 0, 0));
    while let Some((effort, r, c)) = queue.pop() {
        if r == rows - 1 and c == cols - 1 {
            return effort;
        }
        if effort > best[r][c] {
            continue;
        }
        for (dr, dc) in [(-1, 0), (1, 0), (0, -1), (0, 1)] {
            let (nr, nc) = (r + dr, c + dc);
            if nr < 0 or nr >= rows or nc < 0 or nc >= cols {
                continue;
            }
            let step = max(effort, (heights[nr][nc] - heights[r][c]).abs());
            if step < best[nr][nc] {
                best[nr][nc] = step;
                queue.push((step, nr, nc));
            }
        }
    }
    0
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random grids of 1 to `most` rows and columns, heights 1 to
// `top`; the efforts summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let rows = next_random(mut seed) % most + 1;
        let cols = next_random(mut seed) % most + 1;
        let mut heights: Vec[Vec[i32]] = Vec.new();
        for _ in 0..rows {
            let mut row: Vec[i32] = Vec.new();
            for _ in 0..cols {
                row.push((next_random(mut seed) % top + 1) as i32);
            }
            heights.push(row);
        }
        let effort = minimum_effort_path(heights);
        total += effort;
        check = (check * 31 + effort + 1) % 1000000007;
    }
    println(f"{count} grids of up to {most} x {most}: efforts sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one cell, and one row
    println(minimum_effort_path([[1, 2, 2], [3, 8, 2], [5, 3, 5]]));
    println(minimum_effort_path([[1, 2, 3], [3, 8, 4], [5, 3, 5]]));
    println(minimum_effort_path([[1, 2, 1, 1, 1], [1, 2, 1, 2, 1], [1, 2, 1, 2, 1], [1, 2, 1, 2, 1], [1, 1, 1, 2, 1]]));
    println(minimum_effort_path([[7]]));
    println(minimum_effort_path([[1, 10, 4, 6]]));
    let mut seed = 1631;
    batch(2000, 4, 5, mut seed);
    batch(200, 20, 1000, mut seed);
    batch(5, 100, 30000, mut seed);
}
