// LeetCode #1631: Path With Minimum Effort -- a binary search on the
// effort, each guess checked by a flood.
//
// A path within effort e exists exactly when a breadth-first flood over
// steps of at most e reaches the corner, and that only gets easier as e
// grows, so the least such e is found by halving the range from 0 to the
// largest step in the grid. O(rc log H).

fn reachable(heights: Vec[Vec[i32]], limit: i32) -> bool {
    let (rows, cols) = (heights.len(), heights[0].len());
    let mut seen: Vec[Vec[bool]] = Vec.filled(rows, Vec.filled(cols, false));
    let mut queue: VecDeque[(i64, i64)] = VecDeque.new();
    seen[0][0] = true;
    queue.push_back((0, 0));
    while let Some((r, c)) = queue.pop_front() {
        let here = heights[r][c];
        let mut next: Vec[(i64, i64)] = Vec.new();
        if r > 0 {
            next.push((r - 1, c));
        }
        if r + 1 < rows {
            next.push((r + 1, c));
        }
        if c > 0 {
            next.push((r, c - 1));
        }
        if c + 1 < cols {
            next.push((r, c + 1));
        }
        for (nr, nc) in next {
            if not seen[nr][nc] and (heights[nr][nc] - here).abs() <= limit {
                seen[nr][nc] = true;
                queue.push_back((nr, nc));
            }
        }
    }
    seen[rows - 1][cols - 1]
}

fn minimum_effort_path(heights: Vec[Vec[i32]]) -> i32 {
    let mut low: i32 = 0;
    let mut high = 0;
    for row in heights.iter() {
        for h in row.iter() {
            high = max(high, h);
        }
    }
    while low < high {
        let middle = (low + high) / 2;
        if reachable(heights, middle) {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    low
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random grids of 1 to `most` rows and columns, heights 1 to
// `top`; the efforts summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let rows = next_random(mut seed) % most + 1;
        let cols = next_random(mut seed) % most + 1;
        let mut heights: Vec[Vec[i32]] = Vec.new();
        for _ in 0..rows {
            let mut row: Vec[i32] = Vec.new();
            for _ in 0..cols {
                row.push((next_random(mut seed) % top + 1) as i32);
            }
            heights.push(row);
        }
        let effort = minimum_effort_path(heights);
        total += effort;
        check = (check * 31 + effort + 1) % 1000000007;
    }
    println(f"{count} grids of up to {most} x {most}: efforts sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one cell, and one row
    println(minimum_effort_path([[1, 2, 2], [3, 8, 2], [5, 3, 5]]));
    println(minimum_effort_path([[1, 2, 3], [3, 8, 4], [5, 3, 5]]));
    println(minimum_effort_path([[1, 2, 1, 1, 1], [1, 2, 1, 2, 1], [1, 2, 1, 2, 1], [1, 2, 1, 2, 1], [1, 1, 1, 2, 1]]));
    println(minimum_effort_path([[7]]));
    println(minimum_effort_path([[1, 10, 4, 6]]));
    let mut seed = 1631;
    batch(2000, 4, 5, mut seed);
    batch(200, 20, 1000, mut seed);
    batch(5, 100, 30000, mut seed);
}
