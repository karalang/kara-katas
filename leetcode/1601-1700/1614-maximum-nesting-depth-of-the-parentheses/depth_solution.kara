// LeetCode #1614: Maximum Nesting Depth of the Parentheses -- a Rust
// solution as LeetCode's Rust users write it (`s.chars().fold` over a
// `(depth, most)` pair), carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn max_depth(s: String) -> i32 {
        s.chars()
            // `(0, 0)` is refused as `i64` with no fix, the `max` on the
            // accumulator settling it (B-2026-11-17-129)
            .fold((0i32, 0i32), |(d, m), c| match c {
                '(' => (d + 1, m.max(d + 1)),
                ')' => (d - 1, m),
                _ => (d, m),
            })
            .1
    }
}

fn max_depth(s: String) -> i32 {
    Solution.max_depth(s)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// a random expression of about `size` terms: terms joined by operators,
// each term a digit or, while `size` allows, an expression in parentheses
fn expression(size: i64, out: mut ref String, seed: mut ref i64) {
    let mut left = size;
    loop {
        if left > 1 and next_random(mut seed) % 3 == 0 {
            let inner = next_random(mut seed) % left + 1;
            out.push('(');
            expression(inner, mut out, mut seed);
            out.push(')');
            left -= inner;
        } else {
            out.push((b'0' + (next_random(mut seed) % 10) as u8) as char);
            left -= 1;
        }
        if left <= 0 {
            break;
        }
        out.push(['+', '-', '*', '/'][next_random(mut seed) % 4]);
    }
}

fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut chars = 0;
    let mut deepest = 0;
    for _ in 0..count {
        let size = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut s = String.new();
        expression(size, mut s, mut seed);
        let depth = max_depth(s);
        check = mix(check, depth);
        deepest = max(deepest, depth);
        chars += s.len();
    }
    println(f"{count} expressions of up to {most} terms: {chars} characters, deepest {deepest}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then a bare digit, one pair, a deep
    // chain, and two pairs side by side
    for s in ["(1+(2*3)+((8)/4))+1", "(1)+((2))+(((3)))", "7", "(5)", "((((((9))))))", "(1)*(2)"] {
        println(f"{max_depth(s.to_string())}");
    }
    let mut seed = 1614;
    batch(3000, 6, mut seed);
    batch(300, 1000, mut seed);
    batch(3, 100000, mut seed);
}
