// LeetCode #1614: Maximum Nesting Depth of the Parentheses -- the bench:
// the ★ arm on 10 random expressions of 200000 terms, each checked 10
// times, all built first.
//
// The ★ arm: one pass counting the parentheses open, keeping the most.

fn max_depth(s: String) -> i32 {
    let mut open = 0;
    let mut most: i32 = 0;
    for c in s.chars() {
        if c == '(' {
            open += 1;
            most = max(most, open);
        } else if c == ')' {
            open -= 1;
        }
    }
    most
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn expression(size: i64, out: mut ref String, seed: mut ref i64) {
    let mut left = size;
    loop {
        if left > 1 and next_random(mut seed) % 3 == 0 {
            let inner = next_random(mut seed) % left + 1;
            out.push('(');
            expression(inner, mut out, mut seed);
            out.push(')');
            left -= inner;
        } else {
            out.push((b'0' + (next_random(mut seed) % 10) as u8) as char);
            left -= 1;
        }
        if left <= 0 {
            break;
        }
        out.push(['+', '-', '*', '/'][next_random(mut seed) % 4]);
    }
}

fn main() {
    let mut seed = 1614;
    let mut expressions: Vec[String] = Vec.new();
    for _ in 0..10 {
        let mut s = String.new();
        expression(200000, mut s, mut seed);
        expressions.push(s);
    }
    let mut check = 0;
    let mut chars = 0;
    for s in expressions.iter() {
        for _ in 0..10 {
            check = mix(check, max_depth(s));
            chars += s.len();
        }
    }
    println(f"10 expressions of 200000 terms, each read 10 times: {chars} characters, checksum {check}");
}
