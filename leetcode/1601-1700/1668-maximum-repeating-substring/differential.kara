// LeetCode #1668: Maximum Repeating Substring -- the differential.
//
// Four arms against the statement read literally, on 3000 random
// problems: words of 1 to 3 letters, sequences of up to 16 built of whole
// copies of the word and single letters, from an alphabet of 1 to 3.
//
// P1  the answer is the statement read literally
// P2  the word repeated answer times is in the sequence
// P3  the word repeated answer + 1 times is not
// P4  the word added to the end of the sequence answers the same or one more
// P5  each arm agrees with at least two of the other three

// ---- maximum.kara: the ★ arm: the repeated word grown

fn star_arm(sequence: Str, word: Str) -> i32 {
    let mut k = 0;
    let mut repeated = word.to_string();
    while sequence.contains(repeated) {
        k += 1;
        repeated.push_str(word);
    }
    k
}

// ---- maximum_runs.kara: runs of copies by where they end

fn runs_arm(sequence: Str, word: Str) -> i32 {
    let (n, m) = (sequence.len(), word.len());
    let mut runs = Vec.filled(n + 1, 0i32);
    let mut best: i32 = 0;
    for end in m..=n {
        if sequence[end - m..end] == word {
            runs[end] = runs[end - m] + 1;
            best = max(best, runs[end]);
        }
    }
    best
}

// ---- maximum_scan.kara: copies counted from every start

fn scan_arm(sequence: Str, word: Str) -> i32 {
    let mut best: i32 = 0;
    for start in 0..sequence.len() {
        let mut k: i32 = 0;
        let mut at = start;
        while sequence[at..].starts_with(word) {
            k += 1;
            at += word.len();
        }
        best = best.max(k);
    }
    best
}

// ---- maximum_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn max_repeating(sequence: String, word: String) -> i32 {
        let mut k: i32 = 0;
        while sequence.contains(word.repeat(k + 1)) {
            k += 1;
        }
        k
    }
}

fn solution_arm(sequence: Str, word: Str) -> i32 {
    SolutionArm.max_repeating(sequence.to_string(), word.to_string())
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters drawn from the first `kinds` of the alphabet
fn random_text(n: i64, kinds: i64, seed: mut ref i64) -> String {
    let mut text = String.new();
    for _ in 0..n {
        let letter = (b'a' + (next_random(mut seed) % kinds) as u8) as char;
        text.push(letter);
    }
    text
}

// a sequence of about `n` letters built of whole copies of `word` and
// single random letters, half and half
fn random_sequence(word: Str, n: i64, kinds: i64, seed: mut ref i64) -> String {
    let mut text = String.new();
    while text.len() < n {
        if next_random(mut seed) % 2 == 0 {
            text.push_str(word);
        } else {
            text.push_str(random_text(1, kinds, mut seed));
        }
    }
    text
}

// the statement read literally: every piece of the sequence that is the
// word some k times over, k counted by cutting the piece into word-long
// parts and comparing each; the largest k, or 0
fn literal(sequence: Str, word: Str) -> i64 {
    let (n, m) = (sequence.len(), word.len());
    let mut best = 0;
    for i in 0..n {
        for j in i + 1..=n {
            if (j - i) % m != 0 {
                continue;
            }
            let k = (j - i) / m;
            if (0..k).all(|c| sequence[i + c * m..i + c * m + m] == word) {
                best = max(best, k);
            }
        }
    }
    best
}

fn arm(a: i64, sequence: Str, word: Str) -> i64 {
    match a {
        0 => star_arm(sequence, word),
        1 => runs_arm(sequence, word),
        2 => scan_arm(sequence, word),
        _ => solution_arm(sequence, word),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "runs", "scan", "solution"][a]
}

fn main() {
    let mut seed = 1668;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(String, String)] = Vec.new();
    for _ in 0..problems {
        let kinds = next_random(mut seed) % 3 + 1;
        let word = random_text(next_random(mut seed) % 3 + 1, kinds, mut seed);
        let sequence = random_sequence(word, next_random(mut seed) % 16 + 1, kinds, mut seed);
        cases.push((sequence, word));
    }
    for (p, (sequence, word)) in cases.iter().enumerate() {
        let want = literal(sequence, word);
        check = (check * 31 + want + sequence.len()) % 1000000007;
        let mut answers: Vec[i64] = Vec.new();
        for a in 0..4 {
            let got = arm(a, sequence, word);
            answers.push(got);
            let longer = arm(a, f"{sequence}{word}", word);
            let failed = [
                got != want,
                not sequence.contains(word.repeat(got)),
                sequence.contains(word.repeat(got + 1)),
                longer < got or longer > got + 1,
            ];
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({word} in {sequence}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
