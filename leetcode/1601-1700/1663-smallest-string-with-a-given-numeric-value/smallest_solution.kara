// LeetCode #1663: Smallest String With A Given Numeric Value -- a Rust
// solution as LeetCode's Rust users write it (from the front, each letter
// the smallest the rest can still make up, pushed onto a `String` with
// capacity), carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn get_smallest_string(n: i32, k: i32) -> String {
        let mut k = k;
        let mut s = String.with_capacity(n);
        for i in 0..n {
            let rest = (n - i - 1) * 26;
            let c = max(1, k - rest);
            s.push((b'a' + c as u8 - 1) as char);
            k -= c;
        }
        s
    }
}

fn get_smallest_string(n: i32, k: i32) -> String {
    Solution.get_smallest_string(n, k)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` problems with n up to `longest` and k anywhere from n to 26n;
// the z's counted, and a checksum of every letter
fn batch(count: i64, longest: i64, seed: mut ref i64) {
    let mut zs = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % longest + 1;
        let k = n + (next_random(mut seed) * 32768 + next_random(mut seed)) % (25 * n + 1);
        let s = get_smallest_string(n as i32, k as i32);
        for b in s.bytes() {
            if b == b'z' {
                zs += 1;
            }
            check = (check * 31 + b) % 1000000007;
        }
    }
    println(f"{count} problems with n up to {longest}: {zs} z's, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one letter at each end and a string
    // of z's alone
    println(get_smallest_string(3, 27));
    println(get_smallest_string(5, 73));
    println(get_smallest_string(1, 1));
    println(get_smallest_string(1, 26));
    println(get_smallest_string(4, 104));
    println(get_smallest_string(6, 30));
    let mut seed = 1663;
    batch(3000, 10, mut seed);
    batch(300, 1000, mut seed);
    batch(10, 100000, mut seed);
}
