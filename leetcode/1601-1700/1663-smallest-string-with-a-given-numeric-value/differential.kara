// LeetCode #1663: Smallest String With A Given Numeric Value -- the
// differential.
//
// Four arms against the statement read literally, on 3000 random
// problems with n up to 3 and k anywhere from n to 26n.
//
// P1  the answer is the statement read literally
// P2  the answer is n lowercase letters
// P3  its letters' values sum to k
// P4  its letters never go down: the smallest such string is sorted
// P5  each arm agrees with at least two of the other three

// ---- smallest.kara: the ★ arm: from the back

fn star_arm(n: i32, k: i32) -> String {
    let n = n as i64;
    let mut letters = Vec.filled(n, b'a');
    let mut left = k - n;
    let mut i = n - 1;
    while left > 0 {
        let more = min(left, 25);
        letters[i] += more as u8;
        left -= more;
        i -= 1;
    }
    String.from_utf8(letters).unwrap()
}

// ---- smallest_count.kara: counted: a's, one letter, z's

fn count_arm(n: i32, k: i32) -> String {
    let extra = k - n;
    let zs = extra / 25;
    let middle = extra % 25;
    let mut s = "a".repeat((n - zs - if middle > 0 { 1 } else { 0 }) as i64);
    if middle > 0 {
        s.push((b'a' + middle as u8) as char);
    }
    s + "z".repeat(zs as i64)
}

// ---- smallest_front.kara: from the front

fn front_arm(n: i32, k: i32) -> String {
    let mut left = k;
    (0..n)
        .map(|i| {
            let value = max(1, left - 26 * (n - i - 1));
            left -= value;
            (b'a' + (value - 1) as u8) as char
        })
        .collect()
}

// ---- smallest_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn get_smallest_string(n: i32, k: i32) -> String {
        let mut k = k;
        let mut s = String.with_capacity(n);
        for i in 0..n {
            let rest = (n - i - 1) * 26;
            let c = max(1, k - rest);
            s.push((b'a' + c as u8 - 1) as char);
            k -= c;
        }
        s
    }
}

fn solution_arm(n: i32, k: i32) -> String {
    SolutionArm.get_smallest_string(n, k)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: the strings of length n in alphabetical
// order, `aa..a` first, and the first whose letters sum to k
fn literal(n: i32, k: i32) -> String {
    let mut total = 1;
    for _ in 0..n {
        total *= 26;
    }
    for code in 0..total {
        let mut letters = Vec.filled(n, b'a');
        let mut rest = code;
        let mut sum = 0;
        for i in (0..n as i64).rev() {
            letters[i] = b'a' + (rest % 26) as u8;
            sum += rest % 26 + 1;
            rest /= 26;
        }
        if sum == k {
            return String.from_utf8(letters).unwrap();
        }
    }
    panic("no string of length n sums to k")
}

fn arm(a: i64, n: i32, k: i32) -> String {
    match a {
        0 => star_arm(n, k),
        1 => count_arm(n, k),
        2 => front_arm(n, k),
        _ => solution_arm(n, k),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "count", "front", "solution"][a]
}

fn main() {
    let mut seed = 1663;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(i32, i32)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 3 + 1;
        let k = n + next_random(mut seed) % (25 * n + 1);
        cases.push((n as i32, k as i32));
    }
    for (p, (n, k)) in cases.iter().enumerate() {
        let want = literal(n, k);
        for b in want.bytes() {
            check = (check * 31 + b) % 1000000007;
        }
        let mut answers: Vec[String] = Vec.new();
        for a in 0..4 {
            let got = arm(a, n, k);
            let bytes = got.bytes();
            let mut sum = 0;
            for b in bytes {
                sum += (b - b'a') as i64 + 1;
            }
            let failed = [
                got != want,
                bytes.len() != n or bytes.iter().any(|b| b < b'a' or b > b'z'),
                sum != k,
                bytes.windows(2).into_iter().any(|w| w[0] > w[1]),
            ];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} (n = {n}, k = {k}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
