// LeetCode #1604: Alert Using Same Key-Card Three or More Times in a One
// Hour Period -- one sort of every swipe.
//
// Every swipe made a `(name, minute)` pair and the list sorted once, so
// each name's swipes stand together in time order and the names come in
// order; a swipe and the one two before it, by the same name and at most
// 60 minutes apart, alert that name once. O(n log n).

fn alert_names(key_name: Slice[String], key_time: Slice[String]) -> Vec[String] {
    let mut swipes: Vec[(String, i32)] = key_name
        .iter()
        .zip(key_time.iter())
        .map(|(name, time)| (name.clone(), i32.parse(time[..2]).unwrap() * 60 + i32.parse(time[3..]).unwrap()))
        .collect();
    swipes.sort();
    let mut out: Vec[String] = Vec.new();
    for i in 2..swipes.len() {
        let (name, t) = swipes[i].clone();
        let (before, s) = ref swipes[i - 2];
        if name == before and t - s <= 60 and out.last() != Some(ref name) {
            out.push(name.clone());
        }
    }
    out
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

const NAMES: Array[Str, 8] = ["daniel", "luis", "alice", "bob", "john", "leslie", "clare", "anna"];

// `count` days of `uses` swipes or fewer by up to `people` names, each
// at a random minute in a window of `span` minutes from a random start
fn batch(count: i64, people: i64, uses: i64, span: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut alerts = 0;
    let mut swipes = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % uses + 1;
        let start = next_random(mut seed) % (1440 - span + 1);
        let mut names: Vec[String] = Vec.new();
        let mut times: Vec[String] = Vec.new();
        for _ in 0..n {
            let who = next_random(mut seed) % people;
            names.push(if who < 8 { NAMES[who].to_string() } else { f"{NAMES[who % 8]}{who / 8}" });
            let t = start + next_random(mut seed) % span;
            times.push(f"{t / 60:02}:{t % 60:02}");
        }
        for name in alert_names(names, times).iter() {
            alerts += 1;
            for b in name.bytes() {
                check = mix(check, b);
            }
            check = mix(check, 0);
        }
        check = mix(check, 1);
        swipes += n;
    }
    println(f"{count} days of up to {uses} swipes by up to {people} names: {swipes} swipes, {alerts} alerts, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then three uses an hour apart exactly, one
    // just past the hour, and a midnight that does not wrap
    let examples: Vec[(Vec[String], Vec[String])] = [
        (["daniel", "daniel", "daniel", "luis", "luis", "luis", "luis"], ["10:00", "10:40", "11:00", "09:00", "11:00", "13:00", "15:00"]),
        (["alice", "alice", "alice", "bob", "bob", "bob", "bob"], ["12:01", "12:00", "18:00", "21:00", "21:20", "21:30", "23:00"]),
        (["john", "john", "john"], ["23:58", "23:59", "00:01"]),
        (["leslie", "leslie", "leslie", "clare", "clare", "clare", "clare"], ["13:00", "13:20", "14:00", "18:00", "18:51", "19:30", "19:49"]),
        (["anna", "anna", "anna", "anna"], ["08:00", "08:30", "09:01", "09:31"]),
    ];
    for (names, times) in examples.iter() {
        let found = alert_names(names, times);
        println(f"[{found.join(", ")}]");
    }
    let mut seed = 1604;
    batch(3000, 4, 8, 120, mut seed);
    batch(300, 50, 2000, 1440, mut seed);
    batch(3, 2000, 100000, 1440, mut seed);
}
