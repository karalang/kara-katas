// LeetCode #1604: Alert Using Same Key-Card Three or More Times in a One
// Hour Period -- the bench: the ★ arm on 30 days of 100000 swipes by 20000
// names, all drawn first.
//
// The ★ arm: each name's minutes in a sorted map, each list sorted, and a
// name alerted when a swipe and the one two after it are an hour apart or
// less.

fn minutes(t: Str) -> i32 {
    let (h, m) = t.split_once(":").unwrap();
    i32.parse(h).unwrap() * 60 + i32.parse(m).unwrap()
}

fn alert_names(key_name: Slice[String], key_time: Slice[String]) -> Vec[String] {
    let mut uses: SortedMap[String, Vec[i32]] = SortedMap.new();
    for (name, time) in key_name.iter().zip(key_time.iter()) {
        uses.entry(name.clone()).or_insert(Vec.new()).push(minutes(time));
    }
    let mut out = Vec.new();
    for (name, times) in uses.iter_mut() {
        times.sort();
        if (2..times.len()).any(|i| times[i] - times[i - 2] <= 60) {
            out.push(name.clone());
        }
    }
    out
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

const NAMES: Array[Str, 8] = ["daniel", "luis", "alice", "bob", "john", "leslie", "clare", "anna"];

fn main() {
    let mut seed = 1604;
    let mut days: Vec[(Vec[String], Vec[String])] = Vec.new();
    for _ in 0..30 {
        let mut names: Vec[String] = Vec.new();
        let mut times: Vec[String] = Vec.new();
        for _ in 0..100000 {
            let who = (next_random(mut seed) * 32768 + next_random(mut seed)) % 20000;
            names.push(if who < 8 { NAMES[who].to_string() } else { f"{NAMES[who % 8]}{who / 8}" });
            let t = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1440;
            times.push(f"{t / 60:02}:{t % 60:02}");
        }
        days.push((names, times));
    }
    let mut check = 0;
    let mut alerts = 0;
    for (names, times) in days.iter() {
        for name in alert_names(names, times).iter() {
            alerts += 1;
            for b in name.bytes() {
                check = mix(check, b);
            }
            check = mix(check, 0);
        }
    }
    println(f"30 days of 100000 swipes by 20000 names: {alerts} alerts, checksum {check}");
}
