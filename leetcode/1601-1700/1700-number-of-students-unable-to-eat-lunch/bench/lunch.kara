// LeetCode #1700: Number of Students Unable to Eat Lunch -- the bench: the
// ★ arm on 50000 random lunches of 100 students, LeetCode's most, all
// drawn first, each answered 80 times.
//
// The wants of each kind counted; the sandwiches taken from the top while
// anyone wants the next one; those left want the kind that ran out. O(n).

fn count_students(students: Vec[i32], sandwiches: Vec[i32]) -> i32 {
    let mut wanting = [0, 0];
    for s in students.iter() {
        wanting[s] += 1;
    }
    for s in sandwiches.iter() {
        if wanting[s] == 0 {
            break;
        }
        wanting[s] -= 1;
    }
    wanting[0] + wanting[1]
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 50000;
    let rounds = 80;
    let n = 100;
    let mut seed = 1700;
    let mut lunches: Vec[(Vec[i32], Vec[i32])] = Vec.new();
    for _ in 0..count {
        let lean = next_random(mut seed) % 11;
        let mut students: Vec[i32] = Vec.new();
        let mut sandwiches: Vec[i32] = Vec.new();
        for _ in 0..n {
            students.push(if next_random(mut seed) % 10 < lean { 1 } else { 0 });
        }
        for _ in 0..n {
            sandwiches.push(if next_random(mut seed) % 10 < lean { 1 } else { 0 });
        }
        lunches.push((students, sandwiches));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (students, sandwiches) in lunches.iter() {
            let answer = count_students(students, sandwiches);
            total += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} lunches of {n} students, {rounds} rounds: answers sum to {total}, checksum {check}");
}
