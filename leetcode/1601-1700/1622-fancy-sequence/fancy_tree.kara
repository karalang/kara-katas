// LeetCode #1622: Fancy Sequence -- a segment tree of pending maps.
//
// No inverse: every internal node holds a map x -> mul x + add not yet
// handed to its children. addAll and multAll compose onto the root; a
// leaf is written or read only after the maps on its path are pushed down
// to it, so a value appended later never sees an older operation. The
// tree doubles when it fills, after every map is pushed to the leaves.
// O(log n) per call, amortized.

const MOD: i64 = 1000000007;

struct Fancy {
    size: i64,
    levels: i64,
    count: i64,
    leaves: Vec[i64],
    mul: Vec[i64],
    add: Vec[i64],
}

impl Fancy {
    fn new() -> Fancy {
        Fancy.with_size(16, 4, [])
    }

    // `size` leaves, `2^levels == size`, the first of them `values`
    fn with_size(size: i64, levels: i64, values: own Vec[i64]) -> Fancy {
        let count = values.len();
        let mut leaves = values;
        leaves.resize(size, 0);
        Fancy {
            size,
            levels,
            count,
            leaves,
            mul: Vec.filled(size, 1),
            add: Vec.filled(size, 0),
        }
    }

    // hand node's map to its two children
    fn push(mut ref self, node: i64) {
        let (m, a) = (self.mul[node], self.add[node]);
        if m == 1 and a == 0 {
            return;
        }
        for child in [2 * node, 2 * node + 1] {
            if child >= self.size {
                let leaf = child - self.size;
                self.leaves[leaf] = (self.leaves[leaf] * m + a) % MOD;
            } else {
                self.mul[child] = self.mul[child] * m % MOD;
                self.add[child] = (self.add[child] * m + a) % MOD;
            }
        }
        self.mul[node] = 1;
        self.add[node] = 0;
    }

    // push every map on the path from the root down to `leaf`
    fn settle(mut ref self, leaf: i64) {
        for h in (1..=self.levels).rev() {
            self.push((self.size + leaf) >> h);
        }
    }

    fn append(mut ref self, val: i32) {
        if self.count == self.size {
            for node in 1..self.size {
                self.push(node);
            }
            let values = self.leaves.clone();
            self = Fancy.with_size(2 * self.size, self.levels + 1, values);
        }
        let leaf = self.count;
        self.settle(leaf);
        self.leaves[leaf] = val;
        self.count += 1;
    }

    fn add_all(mut ref self, inc: i32) {
        self.add[1] = (self.add[1] + inc) % MOD;
    }

    fn mult_all(mut ref self, m: i32) {
        self.mul[1] = self.mul[1] * m % MOD;
        self.add[1] = self.add[1] * m % MOD;
    }

    fn get_index(mut ref self, idx: i32) -> i32 {
        if idx >= self.count {
            return -1;
        }
        self.settle(idx);
        self.leaves[idx] as i32
    }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// LeetCode's calls by name, from a fresh `Fancy`, printed as LeetCode
// prints the answers
fn replay(calls: Vec[(String, i32)]) {
    let mut fancy = Fancy.new();
    let mut answers: Vec[String] = ["null"];
    for (name, arg) in calls.iter() {
        match name.as_str() {
            "append" => {
                fancy.append(arg);
                answers.push("null");
            }
            "addAll" => {
                fancy.add_all(arg);
                answers.push("null");
            }
            "multAll" => {
                fancy.mult_all(arg);
                answers.push("null");
            }
            _ => answers.push(f"{fancy.get_index(arg)}"),
        }
    }
    println(f"[{answers.join(", ")}]");
}

// `count` sequences of `calls` calls, each on a fresh `Fancy`: four in ten
// append, two in ten each addAll and multAll, the rest getIndex, about one
// in five of those past the end; every getIndex answer folded in
fn batch(count: i64, calls: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut misses = 0;
    for _ in 0..count {
        let mut fancy = Fancy.new();
        let mut length = 0;
        for _ in 0..calls {
            let arg = (next_random(mut seed) % 100 + 1) as i32;
            match next_random(mut seed) % 10 {
                0..=3 => {
                    fancy.append(arg);
                    length += 1;
                }
                4 | 5 => fancy.add_all(arg),
                6 | 7 => fancy.mult_all(arg),
                _ => {
                    let idx = wide_random(mut seed) % (length + length / 4 + 1);
                    let got = fancy.get_index(idx as i32);
                    if got == -1 {
                        misses += 1;
                    }
                    check = mix(check, got);
                }
            }
        }
    }
    println(f"{count} sequences of {calls} calls: {misses} reads past the end, checksum {check}");
}

fn main() {
    // LeetCode's example, then a read of an empty sequence and one value
    // multiplied by 100 eleven times, past the modulus
    let example: Vec[(String, i32)] = [
        ("append", 2), ("addAll", 3), ("append", 7), ("multAll", 2),
        ("getIndex", 0), ("addAll", 3), ("append", 10), ("multAll", 2),
        ("getIndex", 0), ("getIndex", 1), ("getIndex", 2),
    ];
    replay(example);
    replay([("getIndex", 0)]);
    let mut big: Vec[(String, i32)] = [("append", 100)];
    for _ in 0..10 {
        big.push(("multAll", 100));
    }
    big.push(("getIndex", 0));
    big.push(("getIndex", 1));
    replay(big);
    let mut seed = 1622;
    batch(3000, 20, mut seed);
    batch(300, 300, mut seed);
    batch(1, 100000, mut seed);
}
