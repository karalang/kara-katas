// LeetCode #1622: Fancy Sequence -- the bench, on the ★ arm: every value
// stored under the inverse of one map x -> mul x + add, the inverse a
// Fermat power per append.
//
// Build once, then punch: 50 sequences of 100000 calls, all drawn first
// (four in ten append, two in ten each addAll and multAll, the rest
// getIndex, about one in five of those past the end), then each sequence
// played on a fresh Fancy.

const MOD: i64 = 1000000007;

fn power(base: i64, exp: i64) -> i64 {
    let mut (result, b, e) = (1, base % MOD, exp);
    while e > 0 {
        if e & 1 == 1 {
            result = result * b % MOD;
        }
        b = b * b % MOD;
        e >>= 1;
    }
    result
}

struct Fancy {
    stored: Vec[i64],
    mul: i64,
    add: i64,
}

impl Fancy {
    fn new() -> Fancy {
        Fancy { stored: [], mul: 1, add: 0 }
    }

    fn append(mut ref self, val: i32) {
        let shifted = (val - self.add + MOD) % MOD;
        self.stored.push(shifted * power(self.mul, MOD - 2) % MOD);
    }

    fn add_all(mut ref self, inc: i32) {
        self.add = (self.add + inc) % MOD;
    }

    fn mult_all(mut ref self, m: i32) {
        self.mul = self.mul * m % MOD;
        self.add = self.add * m % MOD;
    }

    fn get_index(self, idx: i32) -> i32 {
        match self.stored.get(idx) {
            Some(x) => ((x * self.mul + self.add) % MOD) as i32,
            None => -1,
        }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1622;
    // a call is (kind, argument): 0 append, 1 addAll, 2 multAll, 3 getIndex
    let mut sequences: Vec[Vec[(i64, i32)]] = Vec.new();
    for _ in 0..50 {
        let mut calls: Vec[(i64, i32)] = Vec.new();
        let mut length = 0;
        for _ in 0..100000 {
            let arg = next_random(mut seed) % 100 + 1;
            let r = next_random(mut seed) % 10;
            if r <= 3 {
                calls.push((0, arg as i32));
                length += 1;
            } else if r <= 5 {
                calls.push((1, arg as i32));
            } else if r <= 7 {
                calls.push((2, arg as i32));
            } else {
                let idx = wide_random(mut seed) % (length + length / 4 + 1);
                calls.push((3, idx as i32));
            }
        }
        sequences.push(calls);
    }
    let mut check = 0;
    let mut misses = 0;
    for calls in sequences.iter() {
        let mut fancy = Fancy.new();
        for (kind, arg) in calls.iter() {
            match kind {
                0 => fancy.append(arg),
                1 => fancy.add_all(arg),
                2 => fancy.mult_all(arg),
                _ => {
                    let got = fancy.get_index(arg);
                    if got == -1 {
                        misses += 1;
                    }
                    check = mix(check, got);
                }
            }
        }
    }
    println(f"50 sequences of 100000 calls: {misses} reads past the end, checksum {check}");
}
