// LeetCode #1622: Fancy Sequence -- LeetCode's Rust template, as written
// there, carried over by `karac fix`.
//
// Every value is kept as given, with the number of operations before it.
// `muls[t]`, `adds[t]`: the first t operations composed, x -> mul x + add.
// A read undoes the first t of them and applies all: the ratio
// muls[now] / muls[t], by a Fermat inverse. O(1) per call but the read's
// O(log p).

const MOD: i64 = 1_000_000_007;

struct Fancy {
    vals: Vec[i64],
    stamps: Vec[i64],
    muls: Vec[i64],
    adds: Vec[i64],
}

/**
 * `&self` means the method takes an immutable reference.
 * If you need a mutable reference, change it to `&mut self` instead.
 */
impl Fancy {
    fn new() -> Self {
        Fancy {
            vals: Vec.new(),
            stamps: Vec.new(),
            muls: [1],
            adds: [0],
        }
    }

    fn pow(base: i64, exp: i64) -> i64 {
        let mut base = base;
        let mut exp = exp;
        let mut result = 1;
        base %= MOD;
        while exp > 0 {
            if exp & 1 == 1 {
                result = result * base % MOD;
            }
            base = base * base % MOD;
            exp >>= 1;
        }
        result
    }

    fn append(mut ref self, val: i32) {
        self.vals.push(val);
        self.stamps.push(self.muls.len() - 1);
    }

    fn add_all(mut ref self, inc: i32) {
        let m = *self.muls.last().unwrap();
        let a = *self.adds.last().unwrap();
        self.muls.push(m);
        self.adds.push((a + inc) % MOD);
    }

    fn mult_all(mut ref self, m: i32) {
        let mm = *self.muls.last().unwrap();
        let a = *self.adds.last().unwrap();
        self.muls.push(mm * m % MOD);
        self.adds.push(a * m % MOD);
    }

    fn get_index(self, idx: i32) -> i32 {
        let idx = idx as i64;
        if idx >= self.vals.len() {
            return -1;
        }
        let t = self.stamps[idx];
        let last = self.muls.len() - 1;
        let ratio = self.muls[last] * Fancy.pow(self.muls[t], MOD - 2) % MOD;
        let shift = (self.adds[last] - self.adds[t] * ratio % MOD + MOD) % MOD;
        ((self.vals[idx] * ratio + shift) % MOD) as i32
    }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// LeetCode's calls by name, from a fresh `Fancy`, printed as LeetCode
// prints the answers
fn replay(calls: Vec[(String, i32)]) {
    let mut fancy = Fancy.new();
    let mut answers: Vec[String] = ["null"];
    for (name, arg) in calls.iter() {
        match name.as_str() {
            "append" => {
                fancy.append(arg);
                answers.push("null");
            }
            "addAll" => {
                fancy.add_all(arg);
                answers.push("null");
            }
            "multAll" => {
                fancy.mult_all(arg);
                answers.push("null");
            }
            _ => answers.push(f"{fancy.get_index(arg)}"),
        }
    }
    println(f"[{answers.join(", ")}]");
}

// `count` sequences of `calls` calls, each on a fresh `Fancy`: four in ten
// append, two in ten each addAll and multAll, the rest getIndex, about one
// in five of those past the end; every getIndex answer folded in
fn batch(count: i64, calls: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut misses = 0;
    for _ in 0..count {
        let mut fancy = Fancy.new();
        let mut length = 0;
        for _ in 0..calls {
            let arg = (next_random(mut seed) % 100 + 1) as i32;
            match next_random(mut seed) % 10 {
                0..=3 => {
                    fancy.append(arg);
                    length += 1;
                }
                4 | 5 => fancy.add_all(arg),
                6 | 7 => fancy.mult_all(arg),
                _ => {
                    let idx = wide_random(mut seed) % (length + length / 4 + 1);
                    let got = fancy.get_index(idx as i32);
                    if got == -1 {
                        misses += 1;
                    }
                    check = mix(check, got);
                }
            }
        }
    }
    println(f"{count} sequences of {calls} calls: {misses} reads past the end, checksum {check}");
}

fn main() {
    // LeetCode's example, then a read of an empty sequence and one value
    // multiplied by 100 eleven times, past the modulus
    let example: Vec[(String, i32)] = [
        ("append", 2), ("addAll", 3), ("append", 7), ("multAll", 2),
        ("getIndex", 0), ("addAll", 3), ("append", 10), ("multAll", 2),
        ("getIndex", 0), ("getIndex", 1), ("getIndex", 2),
    ];
    replay(example);
    replay([("getIndex", 0)]);
    let mut big: Vec[(String, i32)] = [("append", 100)];
    for _ in 0..10 {
        big.push(("multAll", 100));
    }
    big.push(("getIndex", 0));
    big.push(("getIndex", 1));
    replay(big);
    let mut seed = 1622;
    batch(3000, 20, mut seed);
    batch(300, 300, mut seed);
    batch(1, 100000, mut seed);
}
