// LeetCode #1622: Fancy Sequence -- blocks of 64 values.
//
// No inverse: each block of up to 64 values holds one pending map
// x -> mul x + add. addAll and multAll compose onto every block's map; a
// value is appended to the last block only after that block's map is
// written into its values, so it never sees an older operation, and a
// read applies its block's map. O(n / 64) per addAll or multAll, O(64)
// per append, O(1) per read.

const MOD: i64 = 1000000007;
const BLOCK: i64 = 64;

struct Block {
    values: Vec[i64],
    mul: i64,
    add: i64,
}

struct Fancy {
    blocks: Vec[Block],
    count: i64,
}

impl Fancy {
    fn new() -> Fancy {
        Fancy { blocks: [], count: 0 }
    }

    fn append(mut ref self, val: i32) {
        if self.count % BLOCK == 0 {
            self.blocks.push(Block { values: [], mul: 1, add: 0 });
        }
        let last = self.blocks.len() - 1;
        let (m, a) = (self.blocks[last].mul, self.blocks[last].add);
        if m != 1 or a != 0 {
            for v in self.blocks[last].values.iter_mut() {
                *v = (*v * m + a) % MOD;
            }
            self.blocks[last].mul = 1;
            self.blocks[last].add = 0;
        }
        self.blocks[last].values.push(val);
        self.count += 1;
    }

    fn add_all(mut ref self, inc: i32) {
        for block in self.blocks.iter_mut() {
            block.add = (block.add + inc) % MOD;
        }
    }

    fn mult_all(mut ref self, m: i32) {
        for block in self.blocks.iter_mut() {
            block.mul = block.mul * m % MOD;
            block.add = block.add * m % MOD;
        }
    }

    fn get_index(self, idx: i32) -> i32 {
        if idx >= self.count {
            return -1;
        }
        let block = ref self.blocks[idx / BLOCK];
        ((block.values[idx % BLOCK] * block.mul + block.add) % MOD) as i32
    }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// LeetCode's calls by name, from a fresh `Fancy`, printed as LeetCode
// prints the answers
fn replay(calls: Vec[(String, i32)]) {
    let mut fancy = Fancy.new();
    let mut answers: Vec[String] = ["null"];
    for (name, arg) in calls.iter() {
        match name.as_str() {
            "append" => {
                fancy.append(arg);
                answers.push("null");
            }
            "addAll" => {
                fancy.add_all(arg);
                answers.push("null");
            }
            "multAll" => {
                fancy.mult_all(arg);
                answers.push("null");
            }
            _ => answers.push(f"{fancy.get_index(arg)}"),
        }
    }
    println(f"[{answers.join(", ")}]");
}

// `count` sequences of `calls` calls, each on a fresh `Fancy`: four in ten
// append, two in ten each addAll and multAll, the rest getIndex, about one
// in five of those past the end; every getIndex answer folded in
fn batch(count: i64, calls: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut misses = 0;
    for _ in 0..count {
        let mut fancy = Fancy.new();
        let mut length = 0;
        for _ in 0..calls {
            let arg = (next_random(mut seed) % 100 + 1) as i32;
            match next_random(mut seed) % 10 {
                0..=3 => {
                    fancy.append(arg);
                    length += 1;
                }
                4 | 5 => fancy.add_all(arg),
                6 | 7 => fancy.mult_all(arg),
                _ => {
                    let idx = wide_random(mut seed) % (length + length / 4 + 1);
                    let got = fancy.get_index(idx as i32);
                    if got == -1 {
                        misses += 1;
                    }
                    check = mix(check, got);
                }
            }
        }
    }
    println(f"{count} sequences of {calls} calls: {misses} reads past the end, checksum {check}");
}

fn main() {
    // LeetCode's example, then a read of an empty sequence and one value
    // multiplied by 100 eleven times, past the modulus
    let example: Vec[(String, i32)] = [
        ("append", 2), ("addAll", 3), ("append", 7), ("multAll", 2),
        ("getIndex", 0), ("addAll", 3), ("append", 10), ("multAll", 2),
        ("getIndex", 0), ("getIndex", 1), ("getIndex", 2),
    ];
    replay(example);
    replay([("getIndex", 0)]);
    let mut big: Vec[(String, i32)] = [("append", 100)];
    for _ in 0..10 {
        big.push(("multAll", 100));
    }
    big.push(("getIndex", 0));
    big.push(("getIndex", 1));
    replay(big);
    let mut seed = 1622;
    batch(3000, 20, mut seed);
    batch(300, 300, mut seed);
    batch(1, 100000, mut seed);
}
