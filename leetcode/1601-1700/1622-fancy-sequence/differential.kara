// LeetCode #1622: Fancy Sequence -- the differential.
//
// Four arms against the statement read literally, on 3000 random call
// sequences: one in three of up to 8 calls, one in three of up to 60 with
// arguments of 1 or 2 only, the rest of up to 400 with arguments up to
// 100, reads up to one past the end. Every random choice is drawn before any
// arm answers.
//
// P1  the answers are the statement read literally
// P2  a multAll(1) after every call leaves the answers
// P3  every addAll(inc) split as addAll(1), addAll(inc - 1) leaves them
// P4  every even multAll(m) split as multAll(2), multAll(m / 2) leaves them
// P5  a read past the end is -1, and every other read is in 0..10^9 + 7
// P6  each arm agrees with at least two of the other three

// ---- fancy.kara: the ★ arm: values stored under the inverse of one map

const STAR_MOD: i64 = 1000000007;

fn star_power(base: i64, exp: i64) -> i64 {
    let mut (result, b, e) = (1, base % STAR_MOD, exp);
    while e > 0 {
        if e & 1 == 1 {
            result = result * b % STAR_MOD;
        }
        b = b * b % STAR_MOD;
        e >>= 1;
    }
    result
}

struct StarFancy {
    stored: Vec[i64],
    mul: i64,
    add: i64,
}

impl StarFancy {
    fn new() -> StarFancy {
        StarFancy { stored: [], mul: 1, add: 0 }
    }

    fn append(mut ref self, val: i32) {
        let shifted = (val - self.add + STAR_MOD) % STAR_MOD;
        self.stored.push(shifted * star_power(self.mul, STAR_MOD - 2) % STAR_MOD);
    }

    fn add_all(mut ref self, inc: i32) {
        self.add = (self.add + inc) % STAR_MOD;
    }

    fn mult_all(mut ref self, m: i32) {
        self.mul = self.mul * m % STAR_MOD;
        self.add = self.add * m % STAR_MOD;
    }

    fn get_index(self, idx: i32) -> i32 {
        match self.stored.get(idx) {
            Some(x) => ((x * self.mul + self.add) % STAR_MOD) as i32,
            None => -1,
        }
    }
}

fn star_run(calls: Vec[(i64, i32)]) -> Vec[i64] {
    let mut fancy = StarFancy.new();
    let mut answers: Vec[i64] = [];
    for (kind, arg) in calls.iter() {
        match kind {
            0 => fancy.append(arg),
            1 => fancy.add_all(arg),
            2 => fancy.mult_all(arg),
            _ => answers.push(fancy.get_index(arg)),
        }
    }
    answers
}

// ---- fancy_tree.kara: a segment tree of pending maps

const TREE_MOD: i64 = 1000000007;

struct TreeFancy {
    size: i64,
    levels: i64,
    count: i64,
    leaves: Vec[i64],
    mul: Vec[i64],
    add: Vec[i64],
}

impl TreeFancy {
    fn new() -> TreeFancy {
        TreeFancy.with_size(16, 4, [])
    }

    // `size` leaves, `2^levels == size`, the first of them `values`
    fn with_size(size: i64, levels: i64, values: own Vec[i64]) -> TreeFancy {
        let count = values.len();
        let mut leaves = values;
        leaves.resize(size, 0);
        TreeFancy {
            size,
            levels,
            count,
            leaves,
            mul: Vec.filled(size, 1),
            add: Vec.filled(size, 0),
        }
    }

    // hand node's map to its two children
    fn push(mut ref self, node: i64) {
        let (m, a) = (self.mul[node], self.add[node]);
        if m == 1 and a == 0 {
            return;
        }
        for child in [2 * node, 2 * node + 1] {
            if child >= self.size {
                let leaf = child - self.size;
                self.leaves[leaf] = (self.leaves[leaf] * m + a) % TREE_MOD;
            } else {
                self.mul[child] = self.mul[child] * m % TREE_MOD;
                self.add[child] = (self.add[child] * m + a) % TREE_MOD;
            }
        }
        self.mul[node] = 1;
        self.add[node] = 0;
    }

    // push every map on the path from the root down to `leaf`
    fn settle(mut ref self, leaf: i64) {
        for h in (1..=self.levels).rev() {
            self.push((self.size + leaf) >> h);
        }
    }

    fn append(mut ref self, val: i32) {
        if self.count == self.size {
            for node in 1..self.size {
                self.push(node);
            }
            let values = self.leaves.clone();
            self = TreeFancy.with_size(2 * self.size, self.levels + 1, values);
        }
        let leaf = self.count;
        self.settle(leaf);
        self.leaves[leaf] = val;
        self.count += 1;
    }

    fn add_all(mut ref self, inc: i32) {
        self.add[1] = (self.add[1] + inc) % TREE_MOD;
    }

    fn mult_all(mut ref self, m: i32) {
        self.mul[1] = self.mul[1] * m % TREE_MOD;
        self.add[1] = self.add[1] * m % TREE_MOD;
    }

    fn get_index(mut ref self, idx: i32) -> i32 {
        if idx >= self.count {
            return -1;
        }
        self.settle(idx);
        self.leaves[idx] as i32
    }
}

fn tree_run(calls: Vec[(i64, i32)]) -> Vec[i64] {
    let mut fancy = TreeFancy.new();
    let mut answers: Vec[i64] = [];
    for (kind, arg) in calls.iter() {
        match kind {
            0 => fancy.append(arg),
            1 => fancy.add_all(arg),
            2 => fancy.mult_all(arg),
            _ => answers.push(fancy.get_index(arg)),
        }
    }
    answers
}

// ---- fancy_blocks.kara: blocks of 64 values

const BLOCKS_MOD: i64 = 1000000007;
const BLOCKS_SIZE: i64 = 64;

struct BlocksBlock {
    values: Vec[i64],
    mul: i64,
    add: i64,
}

struct BlocksFancy {
    blocks: Vec[BlocksBlock],
    count: i64,
}

impl BlocksFancy {
    fn new() -> BlocksFancy {
        BlocksFancy { blocks: [], count: 0 }
    }

    fn append(mut ref self, val: i32) {
        if self.count % BLOCKS_SIZE == 0 {
            self.blocks.push(BlocksBlock { values: [], mul: 1, add: 0 });
        }
        let last = self.blocks.len() - 1;
        let (m, a) = (self.blocks[last].mul, self.blocks[last].add);
        if m != 1 or a != 0 {
            for v in self.blocks[last].values.iter_mut() {
                *v = (*v * m + a) % BLOCKS_MOD;
            }
            self.blocks[last].mul = 1;
            self.blocks[last].add = 0;
        }
        self.blocks[last].values.push(val);
        self.count += 1;
    }

    fn add_all(mut ref self, inc: i32) {
        for block in self.blocks.iter_mut() {
            block.add = (block.add + inc) % BLOCKS_MOD;
        }
    }

    fn mult_all(mut ref self, m: i32) {
        for block in self.blocks.iter_mut() {
            block.mul = block.mul * m % BLOCKS_MOD;
            block.add = block.add * m % BLOCKS_MOD;
        }
    }

    fn get_index(self, idx: i32) -> i32 {
        if idx >= self.count {
            return -1;
        }
        let block = ref self.blocks[idx / BLOCKS_SIZE];
        ((block.values[idx % BLOCKS_SIZE] * block.mul + block.add) % BLOCKS_MOD) as i32
    }
}

fn blocks_run(calls: Vec[(i64, i32)]) -> Vec[i64] {
    let mut fancy = BlocksFancy.new();
    let mut answers: Vec[i64] = [];
    for (kind, arg) in calls.iter() {
        match kind {
            0 => fancy.append(arg),
            1 => fancy.add_all(arg),
            2 => fancy.mult_all(arg),
            _ => answers.push(fancy.get_index(arg)),
        }
    }
    answers
}

// ---- fancy_solution.kara: LeetCode's Rust template as karac fix left it

const SOLUTION_MOD: i64 = 1_000_000_007;

struct SolutionFancy {
    vals: Vec[i64],
    stamps: Vec[i64],
    muls: Vec[i64],
    adds: Vec[i64],
}

/**
 * `&self` means the method takes an immutable reference.
 * If you need a mutable reference, change it to `&mut self` instead.
 */
impl SolutionFancy {
    fn new() -> Self {
        SolutionFancy {
            vals: Vec.new(),
            stamps: Vec.new(),
            muls: [1],
            adds: [0],
        }
    }

    fn pow(base: i64, exp: i64) -> i64 {
        let mut base = base;
        let mut exp = exp;
        let mut result = 1;
        base %= SOLUTION_MOD;
        while exp > 0 {
            if exp & 1 == 1 {
                result = result * base % SOLUTION_MOD;
            }
            base = base * base % SOLUTION_MOD;
            exp >>= 1;
        }
        result
    }

    fn append(mut ref self, val: i32) {
        self.vals.push(val);
        self.stamps.push(self.muls.len() - 1);
    }

    fn add_all(mut ref self, inc: i32) {
        let m = *self.muls.last().unwrap();
        let a = *self.adds.last().unwrap();
        self.muls.push(m);
        self.adds.push((a + inc) % SOLUTION_MOD);
    }

    fn mult_all(mut ref self, m: i32) {
        let mm = *self.muls.last().unwrap();
        let a = *self.adds.last().unwrap();
        self.muls.push(mm * m % SOLUTION_MOD);
        self.adds.push(a * m % SOLUTION_MOD);
    }

    fn get_index(self, idx: i32) -> i32 {
        let idx = idx as i64;
        if idx >= self.vals.len() {
            return -1;
        }
        let t = self.stamps[idx];
        let last = self.muls.len() - 1;
        let ratio = self.muls[last] * SolutionFancy.pow(self.muls[t], SOLUTION_MOD - 2) % SOLUTION_MOD;
        let shift = (self.adds[last] - self.adds[t] * ratio % SOLUTION_MOD + SOLUTION_MOD) % SOLUTION_MOD;
        ((self.vals[idx] * ratio + shift) % SOLUTION_MOD) as i32
    }
}

fn solution_run(calls: Vec[(i64, i32)]) -> Vec[i64] {
    let mut fancy = SolutionFancy.new();
    let mut answers: Vec[i64] = [];
    for (kind, arg) in calls.iter() {
        match kind {
            0 => fancy.append(arg),
            1 => fancy.add_all(arg),
            2 => fancy.mult_all(arg),
            _ => answers.push(fancy.get_index(arg)),
        }
    }
    answers
}

// ---- the harness ----------------------------------------------------------

const PRIME: i64 = 1000000007;

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A call is `(kind, argument)`: 0 append, 1 addAll, 2 multAll, 3 getIndex.
fn arm(a: i64, calls: Vec[(i64, i32)]) -> Vec[i64] {
    match a {
        0 => star_run(calls),
        1 => tree_run(calls),
        2 => blocks_run(calls),
        _ => solution_run(calls),
    }
}

fn arm_name(a: i64) -> String {
    ["fancy", "tree", "blocks", "solution"][a].to_string()
}

// ---- the statement read literally: the values themselves, every addAll
// and multAll applied to each of them as it comes

fn literal(calls: Vec[(i64, i32)]) -> Vec[i64] {
    let mut values: Vec[i64] = [];
    let mut answers: Vec[i64] = [];
    for (kind, arg) in calls.iter() {
        match kind {
            0 => values.push(arg),
            1 => {
                for v in values.iter_mut() {
                    *v = (*v + arg) % PRIME;
                }
            }
            2 => {
                for v in values.iter_mut() {
                    *v = *v * arg % PRIME;
                }
            }
            _ => answers.push(if arg < values.len() { values[arg] } else { -1 }),
        }
    }
    answers
}

// the same calls with a multAll(1) after each
fn with_ones(calls: Vec[(i64, i32)]) -> Vec[(i64, i32)] {
    let mut out = Vec.new();
    for c in calls.iter() {
        out.push(c);
        out.push((2, 1));
    }
    out
}

// every addAll(inc) of 2 or more as addAll(1), addAll(inc - 1)
fn split_adds(calls: Vec[(i64, i32)]) -> Vec[(i64, i32)] {
    let mut out = Vec.new();
    for (kind, arg) in calls.iter() {
        if kind == 1 and arg >= 2 {
            out.push((1, 1));
            out.push((1, arg - 1));
        } else {
            out.push((kind, arg));
        }
    }
    out
}

// every even multAll(m) as multAll(2), multAll(m / 2)
fn split_mults(calls: Vec[(i64, i32)]) -> Vec[(i64, i32)] {
    let mut out = Vec.new();
    for (kind, arg) in calls.iter() {
        if kind == 2 and arg % 2 == 0 {
            out.push((2, 2));
            out.push((2, arg / 2));
        } else {
            out.push((kind, arg));
        }
    }
    out
}

// whether each getIndex reads past the end
fn past_end(calls: Vec[(i64, i32)]) -> Vec[bool] {
    let mut length = 0;
    let mut out = Vec.new();
    for (kind, arg) in calls.iter() {
        if kind == 0 {
            length += 1;
        } else if kind == 3 {
            out.push(arg >= length);
        }
    }
    out
}

fn main() {
    let mut seed = 1622;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut all_calls: Vec[Vec[(i64, i32)]] = [];
    for p in 0..problems {
        // one in three short, one in three of up to 60 calls with arguments
        // of 1 or 2 only, the rest up to 400 calls of arguments up to 100,
        // past the tree's first 16 leaves and the first block of 64
        let count = match p % 3 {
            0 => next_random(mut seed) % 8 + 1,
            1 => next_random(mut seed) % 60 + 1,
            _ => next_random(mut seed) % 400 + 1,
        };
        let most = if p % 3 == 1 { 2 } else { 100 };
        let mut calls: Vec[(i64, i32)] = [];
        let mut length = 0;
        for _ in 0..count {
            let kind = next_random(mut seed) % 4;
            let arg = if kind == 3 {
                next_random(mut seed) % (length + 2)
            } else {
                next_random(mut seed) % most + 1
            };
            if kind == 0 {
                length += 1;
            }
            calls.push((kind, arg as i32));
        }
        all_calls.push(calls);
    }
    for p in 0..problems {
        let calls = ref all_calls[p];
        let want = literal(calls);
        let ends = past_end(calls);
        let mut answers: Vec[Vec[i64]] = [];
        for a in 0..4 {
            let got = arm(a, calls);
            for x in got.iter() {
                check = (check * 31 + x + 1) % PRIME;
            }
            let in_range = got.len() == ends.len()
                and (0..got.len()).all(|i| if ends[i] { got[i] == -1 } else { got[i] >= 0 and got[i] < PRIME });
            let failed = [
                got != want,
                arm(a, with_ones(calls)) != got,
                arm(a, split_adds(calls)) != got,
                arm(a, split_mults(calls)) != got,
                not in_range,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({calls.len()} calls), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
            answers.push(got);
        }
        // P6
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|x| x == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
