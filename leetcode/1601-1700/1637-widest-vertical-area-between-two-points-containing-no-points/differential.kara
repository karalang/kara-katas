// LeetCode #1637: Widest Vertical Area Between Two Points Containing No
// Points -- the differential.
//
// Four arms against the statement read literally, on 3000 random sets of 2
// to 8 points: every other one with x from 0 to 5, so points share an x
// often, the rest 0 to 1000. Every set is drawn before any arm answers.
//
// P1  the width is the statement read literally
// P2  the points in reverse order give the same width
// P3  every x mirrored to 1000 - x gives the same width
// P4  every x doubled doubles the width
// P5  the width is at most the span of the x values, and at least the
//     span shared out over the n - 1 steps, rounded up
// P6  each arm agrees with at least two of the other three

// ---- widest.kara: the ★ arm: sorted, the widest step

fn star_arm(points: Vec[Vec[i32]]) -> i32 {
    let mut xs: Vec[i32] = points.iter().map(|p| p[0]).collect();
    xs.sort();
    xs.windows(2).into_iter().map(|w| w[1] - w[0]).max().unwrap()
}

// ---- widest_set.kara: a sorted set of the distinct x values

fn set_arm(points: Vec[Vec[i32]]) -> i32 {
    let mut xs: SortedSet[i32] = SortedSet.new();
    for point in points.iter() {
        xs.insert(point[0]);
    }
    let mut widest = 0;
    let mut previous: Option[i32] = None;
    for x in xs.iter() {
        if let Some(p) = previous {
            widest = max(widest, x - p);
        }
        previous = Some(x);
    }
    widest
}

// ---- widest_buckets.kara: buckets, in linear time

fn buckets_arm(points: Vec[Vec[i32]]) -> i32 {
    let xs: Vec[i64] = points.iter().map(|p| p[0] as i64).collect();
    let n = xs.len();
    let lo = xs.iter().min().unwrap();
    let hi = xs.iter().max().unwrap();
    if lo == hi {
        return 0;
    }
    let size = max(1, (hi - lo + n - 2) / (n - 1));
    let buckets = (hi - lo) / size + 1;
    let mut smallest: Vec[Option[i64]] = Vec.filled(buckets, None);
    let mut largest: Vec[Option[i64]] = Vec.filled(buckets, None);
    for x in xs.iter() {
        let b = (x - lo) / size;
        smallest[b] = Some(smallest[b].map_or(x, |s| min(s, x)));
        largest[b] = Some(largest[b].map_or(x, |l| max(l, x)));
    }
    let mut widest = 0;
    let mut previous = lo;
    for b in 0..buckets {
        if let (Some(s), Some(l)) = (smallest[b], largest[b]) {
            widest = max(widest, s - previous);
            previous = l;
        }
    }
    widest as i32
}

// ---- widest_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn max_width_of_vertical_area(points: Vec[Vec[i32]]) -> i32 {
        let mut xs: Vec[i32] = points.iter().map(|p| p[0]).collect();
        xs.sort();
        xs.windows(2).into_iter().fold(0, |best, w| best.max(w[1] - w[0]))
    }
}

fn solution_arm(points: Vec[Vec[i32]]) -> i32 {
    SolutionArm.max_width_of_vertical_area(points)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(k: i64, points: Vec[Vec[i32]]) -> i32 {
    match k {
        0 => star_arm(points),
        1 => set_arm(points),
        2 => buckets_arm(points),
        _ => solution_arm(points),
    }
}

fn arm_name(k: i64) -> String {
    ["widest", "set", "buckets", "solution"][k].to_string()
}

// ---- the statement read literally: a vertical area between the x values
// a < b holds no point when no point's x lies strictly between them; the
// widest such area, over every pair of points

fn literal(points: Vec[Vec[i32]]) -> i32 {
    let mut widest = 0;
    for p in points.iter() {
        for q in points.iter() {
            let (a, b) = (p[0], q[0]);
            if a >= b {
                continue;
            }
            if points.iter().all(|r| r[0] <= a or r[0] >= b) {
                widest = max(widest, b - a);
            }
        }
    }
    widest
}

fn main() {
    let mut seed = 1637;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[Vec[Vec[i32]]] = [];
    for p in 0..problems {
        // every other set with x from 0 to 5, so points share an x often
        let top = if p % 2 == 0 { 5 } else { 1000 };
        let n = next_random(mut seed) % 7 + 2;
        let mut points: Vec[Vec[i32]] = [];
        for _ in 0..n {
            let x = next_random(mut seed) % (top + 1);
            let y = next_random(mut seed) % 10;
            points.push([x as i32, y as i32]);
        }
        cases.push(points);
    }
    for p in 0..problems {
        let points = cases[p].clone();
        let reversed: Vec[Vec[i32]] = points.iter().rev().cloned().collect();
        let mirrored: Vec[Vec[i32]] = points.iter().map(|q| [1000 - q[0], q[1]]).collect();
        let doubled: Vec[Vec[i32]] = points.iter().map(|q| [2 * q[0], q[1]]).collect();
        let lo = points.iter().map(|q| q[0]).min().unwrap();
        let hi = points.iter().map(|q| q[0]).max().unwrap();
        let steps = (points.len() - 1) as i32;
        let want = literal(points);
        check = (check * 31 + want + 1) % 1000000007;
        let mut answers: Vec[i32] = [];
        for k in 0..4 {
            let got = arm(k, points);
            answers.push(got);
            let failed = [
                got != want,
                arm(k, reversed) != got,
                arm(k, mirrored) != got,
                arm(k, doubled) != 2 * got,
                got > hi - lo or got < (hi - lo + steps - 1) / steps,
            ];
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({points}), {arm_name(k)}: P{q + 1}");
                    }
                }
            }
        }
        // P6
        for k in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|x| x == answers[k]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(k)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
