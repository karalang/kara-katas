// LeetCode #1678: Goal Parser Interpretation -- the
// differential.
//
// Four arms against the statement read literally, on 3000 random
// commands of 1 to 12 tokens.
//
// P1  the answer is the statement read literally
// P2  the command twice gives the answer twice
// P3  the answer holds no parenthesis, and as many `G`s as the command
// P4  the answer read back gives the command
// P5  each arm agrees with at least two of the other three

// ---- interpret.kara: the ★ arm: one pass over the bytes

fn star_arm(command: String) -> String {
    let bytes = command.bytes();
    let mut out = String.with_capacity(command.len());
    let mut i = 0;
    while i < bytes.len() {
        if bytes[i] == b'G' {
            out.push('G');
            i += 1;
        } else if bytes[i + 1] == b')' {
            out.push('o');
            i += 2;
        } else {
            out.push_str("al");
            i += 4;
        }
    }
    out
}

// ---- interpret_replace.kara: two replacements

fn replace_arm(command: String) -> String {
    command.replace("()", "o").replace("(al)", "al")
}

// ---- interpret_chars.kara: the letters kept, and an o for every empty pair

fn chars_arm(command: String) -> String {
    let mut out = String.new();
    let mut previous = ' ';
    for c in command.chars() {
        match c {
            '(' => {}
            ')' => {
                if previous == '(' {
                    out.push('o');
                }
            }
            _ => out.push(c),
        }
        previous = c;
    }
    out
}

// ---- interpret_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn interpret(command: String) -> String {
        let bytes = command.bytes();
        let mut res = String.new();
        let mut i = 0;
        while i < bytes.len() {
            match bytes[i] {
                b'G' => {
                    res.push('G');
                    i += 1;
                }
                _ if bytes[i + 1] == b')' => {
                    res.push('o');
                    i += 2;
                }
                _ => {
                    res.push_str("al");
                    i += 4;
                }
            }
        }
        res
    }
}

fn solution_arm(command: String) -> String {
    SolutionArm.interpret(command)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: the command is read from the front, and
// whichever of the three tokens it starts with there is replaced by its
// interpretation, in the original order
fn literal(command: Str) -> String {
    let rules = [("G", "G"), ("()", "o"), ("(al)", "al")];
    let mut out = String.new();
    let mut rest = command;
    while not rest.is_empty() {
        for (token, meaning) in rules.iter() {
            if rest.starts_with(token) {
                out.push_str(meaning);
                rest = rest[token.len()..];
                break;
            }
        }
    }
    out
}

// the answer read back into the command it came from
fn read_back(answer: Str) -> String {
    let mut out = String.new();
    for c in answer.chars() {
        match c {
            'G' => out.push('G'),
            'o' => out.push_str("()"),
            'a' => out.push_str("(al"),
            'l' => out.push(')'),
            _ => out.push('?'),
        }
    }
    out
}

fn arm(a: i64, command: Str) -> String {
    let command = command.to_string();
    match a {
        0 => star_arm(command),
        1 => replace_arm(command),
        2 => chars_arm(command),
        _ => solution_arm(command),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "replace", "chars", "solution"][a]
}

fn main() {
    let mut seed = 1678;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let tokens = ["G", "()", "(al)"];
    let mut cases: Vec[String] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 12 + 1;
        let mut command = String.new();
        for _ in 0..n {
            command.push_str(tokens[next_random(mut seed) % 3]);
        }
        cases.push(command);
    }
    for (p, command) in cases.iter().enumerate() {
        let want = literal(command);
        for c in want.chars() {
            check = (check * 31 + c as i64) % 1000000007;
        }
        check = (check * 31 + command.len()) % 1000000007;
        let twice = f"{command}{command}";
        let g_count = command.chars().filter(|c| c == 'G').count();
        let mut answers: Vec[String] = Vec.new();
        for a in 0..4 {
            let got = arm(a, command);
            let failed = [
                got != want,
                arm(a, twice) != f"{got}{got}",
                got.contains("(") or got.contains(")") or got.chars().filter(|c| c == 'G').count() != g_count,
                read_back(got) != command,
            ];
            answers.push(got);
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({command}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
