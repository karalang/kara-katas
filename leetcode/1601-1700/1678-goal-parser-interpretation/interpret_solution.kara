// LeetCode #1678: Goal Parser Interpretation -- a Rust solution as
// LeetCode's Rust users write it, a `match` on the bytes from
// `as_bytes()` with `b'G'` and `b')'`, `push` and `push_str`, carried to
// Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn interpret(command: String) -> String {
        let bytes = command.bytes();
        let mut res = String.new();
        let mut i = 0;
        while i < bytes.len() {
            match bytes[i] {
                b'G' => {
                    res.push('G');
                    i += 1;
                }
                _ if bytes[i + 1] == b')' => {
                    res.push('o');
                    i += 2;
                }
                _ => {
                    res.push_str("al");
                    i += 4;
                }
            }
        }
        res
    }
}

fn interpret(command: String) -> String {
    Solution.interpret(command)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random commands of 1 to `most` tokens; the letters out summed,
// and a checksum of every answer
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let tokens = ["G", "()", "(al)"];
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut command = String.new();
        for _ in 0..n {
            command.push_str(tokens[next_random(mut seed) % 3]);
        }
        let answer = interpret(command);
        total += answer.len();
        for c in answer.chars() {
            check = (check * 31 + c as i64) % 1000000007;
        }
    }
    println(f"{count} commands of up to {most} tokens: {total} letters, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one token of each kind
    println(interpret("G()(al)"));
    println(interpret("G()()()()(al)"));
    println(interpret("(al)G(al)()()G"));
    println(interpret("G"));
    println(interpret("()"));
    println(interpret("(al)"));
    let mut seed = 1678;
    batch(3000, 10, mut seed);
    batch(300, 50, mut seed);
    batch(30, 10000, mut seed);
}
