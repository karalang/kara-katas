// LeetCode #1602: Find Nearest Right Node in Binary Tree -- the
// differential.
//
// Four arms against the statement read literally, on 3000 trees of 1 to
// 8 nodes, each made by hanging nodes on random free child slots, with a
// random node asked for, and six properties. Every random choice is
// drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  in the mirrored tree the answer's own answer is u (when there is one)
// P3  the values relabelled (v made n + 1 - v) leave the answer, relabelled
// P4  a child hung below the deepest node leaves the answer
// P5  the tree put under a new root as its left child leaves the answer
// P6  each arm agrees with at least two of the other three

// ---- nearest_right.kara: the ★ arm: breadth first, a level at a time

fn star_arm(root: Option[TreeNode], u: TreeNode) -> Option[TreeNode] {
    let mut queue = VecDeque.new();
    if let Some(r) = root {
        queue.push_back(r);
    }
    while not queue.is_empty() {
        let width = queue.len();
        for i in 0..width {
            let node = queue.pop_front().unwrap();
            if node.ref_eq(u) {
                return if i + 1 < width { queue.pop_front() } else { None };
            }
            if let Some(l) = node.left {
                queue.push_back(l);
            }
            if let Some(r) = node.right {
                queue.push_back(r);
            }
        }
    }
    None
}

// ---- nearest_right_dfs.kara: depth first, the next node met at u's depth

struct DfsSearch {
    u: TreeNode,
    depth: Option[i64],
    found: Option[TreeNode],
    done: bool,
}

fn dfs_walk(node: Option[TreeNode], depth: i64, s: mut ref DfsSearch) {
    if s.done {
        return;
    }
    let Some(n) = node else {
        return;
    };
    match s.depth {
        Some(d) if d == depth => {
            s.found = Some(n);
            s.done = true;
            return;
        }
        None if n.ref_eq(s.u) => s.depth = Some(depth),
        _ => {}
    }
    dfs_walk(n.left, depth + 1, mut s);
    dfs_walk(n.right, depth + 1, mut s);
}

fn dfs_arm(root: Option[TreeNode], u: TreeNode) -> Option[TreeNode] {
    let mut s = DfsSearch { u: u, depth: None, found: None, done: false };
    dfs_walk(root, 0, mut s);
    s.found
}

// ---- nearest_right_levels.kara: every level listed, u's successor in its level

fn levels_file(node: Option[TreeNode], depth: i64, levels: mut ref Vec[Vec[TreeNode]]) {
    if let Some(n) = node {
        if levels.len() == depth {
            levels.push(Vec.new());
        }
        levels[depth].push(n);
        levels_file(n.left, depth + 1, mut levels);
        levels_file(n.right, depth + 1, mut levels);
    }
}

fn levels_arm(root: Option[TreeNode], u: TreeNode) -> Option[TreeNode] {
    let mut levels = Vec.new();
    levels_file(root, 0, mut levels);
    for level in levels.iter() {
        if let Some(i) = level.iter().position(|n| n.ref_eq(u)) {
            return level.get(i + 1).cloned();
        }
    }
    None
}

// ---- nearest_right_solution.kara: LeetCode's Rust template as karac fix left it

struct Solution {}

impl Solution {
    pub fn find_nearest_right_node(
        root: Option[TreeNode],
        u: Option[TreeNode],
    ) -> Option[TreeNode] {
        let u = u.unwrap();
        let mut q = VecDeque.new();
        if let Some(r) = root {
            q.push_back(r);
        }
        while not q.is_empty() {
            let n = q.len();
            for i in 0..n {
                let node = q.pop_front().unwrap();
                if node.ref_eq(u) {
                    return if i + 1 < n { q.pop_front() } else { None };
                }
                if let Some(l) = node.left.clone() {
                    q.push_back(l);
                }
                if let Some(r) = node.right.clone() {
                    q.push_back(r);
                }
            }
        }
        None
    }
}

fn solution_arm(root: Option[TreeNode], u: TreeNode) -> Option[TreeNode] {
    Solution.find_nearest_right_node(root, Some(u))
}

// ---- the harness ----------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i32) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a tree as made: node `k` holds `values[k]` and, past the first, hangs
// from node `parents[k]` on the left when `lefts[k]`
#[derive(Clone)]
struct Shape {
    values: Vec[i32],
    parents: Vec[i64],
    lefts: Vec[bool],
}

// the nodes of `shape`, in the order made, with every side swapped when
// `mirror` and every value `v` made `relabel - v` when `relabel` > 0
fn grow(shape: Shape, mirror: bool, relabel: i32) -> Vec[TreeNode] {
    let mut nodes: Vec[TreeNode] = Vec.new();
    for k in 0..shape.values.len() {
        let v = if relabel > 0 { relabel - shape.values[k] } else { shape.values[k] };
        let child = leaf(v);
        if k > 0 {
            let parent = nodes[shape.parents[k]];
            if shape.lefts[k] != mirror {
                parent.left = Some(child);
            } else {
                parent.right = Some(child);
            }
        }
        nodes.push(child);
    }
    nodes
}

fn arm(a: i64, root: TreeNode, u: TreeNode) -> i64 {
    let found = match a {
        0 => star_arm(Some(root), u),
        1 => dfs_arm(Some(root), u),
        2 => levels_arm(Some(root), u),
        _ => solution_arm(Some(root), u),
    };
    match found {
        Some(n) => n.val,
        None => 0,
    }
}

fn arm_name(a: i64) -> String {
    ["nearest_right", "dfs", "levels", "solution"][a].to_string()
}

// ---- the statement read literally: each node's level is its depth, and
// one node is to the right of another on a level when its path from the
// root, read as left 0 and right 1, is the larger; the nearest is the one
// with the smallest such path

fn paths(node: Option[TreeNode], depth: i64, path: String, out: mut ref Vec[(TreeNode, i64, String)]) {
    if let Some(n) = node {
        out.push((n, depth, path.clone()));
        paths(n.left, depth + 1, f"{path}0", mut out);
        paths(n.right, depth + 1, f"{path}1", mut out);
    }
}

fn literal(root: TreeNode, u: TreeNode) -> i64 {
    let mut all = Vec.new();
    paths(Some(root), 0, "", mut all);
    let (_, depth, path) = all.iter().find(|e| e.0.ref_eq(u)).unwrap().clone();
    let mut best: Option[(String, i64)] = None;
    for (n, d, p) in all.iter() {
        if d == depth and p > path {
            let nearer = match best {
                Some((ref q, _)) => p < q,
                None => true,
            };
            if nearer {
                best = Some((p.clone(), n.val));
            }
        }
    }
    match best {
        Some((_, v)) => v,
        None => 0,
    }
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 16020;
    let mut cases: Vec[(Shape, i64)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 8 + 1;
        let mut values: Vec[i32] = (1..n + 1).map(|v| v as i32).collect();
        for i in (1..n).rev() {
            values.swap(i, next_random(mut seed) % (i + 1));
        }
        let mut parents = [0];
        let mut lefts = [true];
        let mut free = [(0, true), (0, false)];
        for k in 1..n {
            let (p, l) = free.swap_remove(next_random(mut seed) % free.len());
            parents.push(p);
            lefts.push(l);
            free.push((k, true));
            free.push((k, false));
        }
        let u = next_random(mut seed) % n;
        cases.push((Shape { values: values, parents: parents, lefts: lefts }, u));
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for (p, (shape, u)) in cases.iter().enumerate() {
        let n = shape.values.len();
        let nodes = grow(shape, false, 0);
        let top = (n + 1) as i32;
        let truth = literal(nodes[0], nodes[u]);
        // the deepest node, the first made among the deepest
        let mut depth = [0];
        let mut deepest = 0;
        for k in 1..n {
            depth.push(depth[shape.parents[k]] + 1);
            if depth[k] > depth[deepest] {
                deepest = k;
            }
        }
        let mut answers = Vec.new();
        for a in 0..arms {
            let answer = arm(a, nodes[0], nodes[u]);
            answers.push(answer);
            check = (check * 31 + answer + 1) % 1000000007;
            let mut failed = [answer != truth];
            // P2: in the mirrored tree the answer's own answer is u
            if answer > 0 {
                let mirrored = grow(shape, true, 0);
                let at = shape.values.iter().position(|v| v == answer).unwrap();
                failed.push(arm(a, mirrored[0], mirrored[at]) != shape.values[u]);
            }
            // P3: the values relabelled
            let relabelled = grow(shape, false, top);
            let renamed = arm(a, relabelled[0], relabelled[u]);
            failed.push(if answer > 0 { renamed != top - answer } else { renamed != 0 });
            // P4: a child hung below the deepest node
            let mut longer = shape.clone();
            longer.values.push(top);
            longer.parents.push(deepest);
            longer.lefts.push(true);
            let grown = grow(longer, false, 0);
            failed.push(arm(a, grown[0], grown[u]) != answer);
            // P5: the tree put under a new root as its left child
            let under = leaf(top);
            under.left = Some(nodes[0]);
            failed.push(arm(a, under, nodes[u]) != answer);
            let q0 = if answer > 0 { 0 } else { 1 };
            for (i, f) in failed.iter().enumerate() {
                let q = if i == 0 { 0 } else { i + q0 };
                checks += 1;
                if *f {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
