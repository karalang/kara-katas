// LeetCode #1602: Find Nearest Right Node in Binary Tree -- the bench:
// the ★ arm on 10 random trees of 100000 nodes, 100 nodes of each asked
// for, all drawn first.
//
// The ★ arm: breadth first, a level at a time; the node taken after `u`
// in its level is the answer.

fn find_nearest_right_node(root: Option[TreeNode], u: TreeNode) -> Option[TreeNode] {
    let mut queue = VecDeque.new();
    if let Some(r) = root {
        queue.push_back(r);
    }
    while not queue.is_empty() {
        let width = queue.len();
        for i in 0..width {
            let node = queue.pop_front().unwrap();
            if node.ref_eq(u) {
                return if i + 1 < width { queue.pop_front() } else { None };
            }
            if let Some(l) = node.left {
                queue.push_back(l);
            }
            if let Some(r) = node.right {
                queue.push_back(r);
            }
        }
    }
    None
}

// ---- the harness

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i32) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// a tree of `n` nodes holding 1 to `n` in a random order, each node hung
// on a random free child slot of the nodes before it; every node, in the
// order they were made
fn random_tree(n: i64, seed: mut ref i64) -> Vec[TreeNode] {
    let mut values: Vec[i32] = (1..n + 1).map(|v| v as i32).collect();
    for i in (1..n).rev() {
        let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
        values.swap(i, j);
    }
    let mut nodes = [leaf(values[0])];
    let mut free = [(nodes[0], true), (nodes[0], false)];
    for v in values[1..].iter() {
        let k = (next_random(mut seed) * 32768 + next_random(mut seed)) % free.len();
        let (parent, left) = free.swap_remove(k);
        let child = leaf(*v);
        if left {
            parent.left = Some(child);
        } else {
            parent.right = Some(child);
        }
        free.push((child, true));
        free.push((child, false));
        nodes.push(child);
    }
    nodes
}

fn answer(node: Option[TreeNode]) -> i64 {
    match node {
        Some(n) => n.val,
        None => 0,
    }
}

fn main() {
    let mut seed = 1602;
    let mut trees: Vec[Vec[TreeNode]] = Vec.new();
    let mut picks: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10 {
        let tree = random_tree(100000, mut seed);
        picks.push((0..100).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000).collect());
        trees.push(tree);
    }
    let mut check = 0;
    let mut found = 0;
    for (tree, us) in trees.iter().zip(picks.iter()) {
        for k in us.iter() {
            let a = answer(find_nearest_right_node(Some(tree[0]), tree[*k]));
            if a > 0 {
                found += 1;
            }
            check = mix(check, a);
        }
    }
    println(f"10 trees of 100000 nodes: 1000 queries, {found} found, checksum {check}");
}
