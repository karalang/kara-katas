// LeetCode #1608: Special Array With X Elements Greater Than or Equal X
// -- the ★ arm.
//
// The numbers sorted largest first: `x` is special when the `x`th
// largest is at least `x` and the next one, if any, is below it.
// O(n log n).

fn special_array(nums: own Vec[i32]) -> i32 {
    let mut nums = nums;
    nums.sort_by(|a, b| b.cmp(a));
    let n = nums.len();
    for x in 1..=n {
        if nums[x - 1] >= x and (x == n or nums[x] < x) {
            return x as i32;
        }
    }
    -1
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` problems of up to `most` numbers from 0 to `top`
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut numbers = 0;
    let mut special = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let nums: Vec[i32] = (0..n).map(|_| ((next_random(mut seed) * 32768 + next_random(mut seed)) % (top + 1)) as i32).collect();
        let x = special_array(nums);
        if x >= 0 {
            special += 1;
        }
        check = mix(check, x);
        numbers += n;
    }
    println(f"{count} problems of up to {most} numbers from 0 to {top}: {numbers} numbers, {special} special, checksum {check}");
}

fn main() {
    // LeetCode's three examples and a fourth it once had, then one
    // number, every number the same, and every number above the count
    let examples: Vec[Vec[i32]] = [
        [3, 5],
        [0, 0],
        [0, 4, 3, 0, 4],
        [3, 6, 7, 7, 0],
        [1],
        [2, 2],
        [1000, 1000, 1000],
    ];
    for nums in examples.iter() {
        println(f"{special_array(nums.clone())}");
    }
    let mut seed = 1608;
    batch(3000, 5, 6, mut seed);
    batch(3000, 100, 1000, mut seed);
    batch(30, 100000, 100000, mut seed);
}
