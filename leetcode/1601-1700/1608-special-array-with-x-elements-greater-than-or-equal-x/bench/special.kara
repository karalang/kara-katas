// LeetCode #1608: Special Array With X Elements Greater Than or Equal X
// -- the bench: the ★ arm on 1000 problems of 10000 numbers from 0 to
// 10000, all drawn first.
//
// The ★ arm: the numbers sorted largest first, `x` special when the
// `x`th largest is at least `x` and the next one, if any, is below it.

fn special_array(nums: own Vec[i32]) -> i32 {
    let mut nums = nums;
    nums.sort_by(|a, b| b.cmp(a));
    let n = nums.len();
    for x in 1..=n {
        if nums[x - 1] >= x and (x == n or nums[x] < x) {
            return x as i32;
        }
    }
    -1
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1608;
    let mut problems: Vec[Vec[i32]] = Vec.new();
    for _ in 0..1000 {
        problems.push((0..10000).map(|_| ((next_random(mut seed) * 32768 + next_random(mut seed)) % 10001) as i32).collect());
    }
    let mut check = 0;
    let mut special = 0;
    for nums in problems.iter() {
        let x = special_array(nums.clone());
        if x >= 0 {
            special += 1;
        }
        check = mix(check, x);
    }
    println(f"1000 problems of 10000 numbers from 0 to 10000: {special} special, checksum {check}");
}
