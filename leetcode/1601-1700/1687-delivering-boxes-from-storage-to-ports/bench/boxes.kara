// LeetCode #1687: Delivering Boxes from Storage to Ports -- the bench: the ★
// arm on 50 random problems of 100000 boxes, all drawn first, each answered
// 20 times.
//
// trips[i] is the fewest trips for the first i boxes. A last trip carrying
// boxes j..i - 1 costs 2 plus the port changes among them, changes[i - 1]
// less changes[j], so trips[i] is the least trips[j] - changes[j] over the
// starts j the caps allow, plus changes[i - 1] + 2. The allowed starts
// slide forward, so a deque holds them with rising trips[j] - changes[j]:
// a new start drops the ones behind it that cost no less, and the front
// drops the ones the caps no longer allow. O(n).

fn deliver(boxes: Vec[Vec[i32]], ports_count: i32, max_boxes: i32, max_weight: i32) -> i32 {
    let n = boxes.len();
    // changes[k]: the port changes among boxes 0..=k; weight[k]: the first k boxes' weight
    let mut changes = Vec.filled(n, 0i32);
    let mut weight = Vec.filled(n + 1, 0);
    for k in 0..n {
        weight[k + 1] = weight[k] + boxes[k][1];
        if k > 0 {
            changes[k] = changes[k - 1] + if boxes[k][0] != boxes[k - 1][0] { 1 } else { 0 };
        }
    }
    let mut trips = Vec.filled(n + 1, 0i32);
    let mut starts: VecDeque[i64] = VecDeque.new();
    for i in 1..=n {
        let j = i - 1;
        let cost = trips[j] - changes[j];
        while let Some(back) = starts.back() {
            if trips[back] - changes[back] >= cost {
                starts.pop_back();
            } else {
                break;
            }
        }
        starts.push_back(j);
        while let Some(front) = starts.front() {
            if i - front > max_boxes or weight[i] - weight[front] > max_weight {
                starts.pop_front();
            } else {
                break;
            }
        }
        let front = starts.front().unwrap();
        trips[i] = trips[front] - changes[front] + changes[i - 1] + 2;
    }
    trips[n]
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 50;
    let size = 100000;
    let rounds = 20;
    let mut seed = 1687;
    // up to 100 ports, up to 1000 boxes and 1000 to 100000 in weight a
    // trip, each box 1 to 1000
    let mut problems: Vec[(Vec[Vec[i32]], i32, i32, i32)] = Vec.new();
    for _ in 0..count {
        let ports_count = next_random(mut seed) % 100 + 1;
        let max_boxes = next_random(mut seed) % 1000 + 1;
        let max_weight = (next_random(mut seed) * 32768 + next_random(mut seed)) % 99001 + 1000;
        let mut boxes: Vec[Vec[i32]] = Vec.new();
        for _ in 0..size {
            let port = next_random(mut seed) % ports_count + 1;
            let weight = next_random(mut seed) % 1000 + 1;
            boxes.push([port as i32, weight as i32]);
        }
        problems.push((boxes, ports_count as i32, max_boxes as i32, max_weight as i32));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (boxes, ports_count, max_boxes, max_weight) in problems.iter() {
            let answer = deliver(boxes, ports_count, max_boxes, max_weight);
            total += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} problems of {size} boxes, {rounds} rounds: {total} trips, checksum {check}");
}
