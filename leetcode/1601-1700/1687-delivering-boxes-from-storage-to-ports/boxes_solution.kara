// LeetCode #1687: Delivering Boxes from Storage to Ports -- a Rust solution
// as LeetCode's Rust users write it: `std::collections::VecDeque` of
// `usize` starts, `vec![0i64; n + 1]` prefix weights, a `bool as i32`
// port change, `while let Some(&j) = q.front()`.

struct Solution {}

impl Solution {
    pub fn box_delivering(boxes: Vec[Vec[i32]], _ports_count: i32, max_boxes: i32, max_weight: i32) -> i32 {
        let n = boxes.len();
        let mut neg = Vec.filled(n, 0i32);
        let mut w = Vec.filled(n + 1, 0);
        for i in 0..n {
            w[i + 1] = w[i] + boxes[i][1];
            if i > 0 {
                neg[i] = neg[i - 1] + (boxes[i][0] != boxes[i - 1][0]) as i32;
            }
        }
        let mut dp = Vec.filled(n + 1, 0i32);
        let mut q: VecDeque[i64] = VecDeque.new();
        q.push_back(0);
        for i in 1..=n {
            while let Some(j) = q.front().cloned() {
                if i - j > max_boxes or w[i] - w[j] > max_weight {
                    q.pop_front();
                } else {
                    break;
                }
            }
            let j = *q.front().unwrap();
            dp[i] = dp[j] - neg[j] + neg[i - 1] + 2;
            if i < n {
                let v = dp[i] - neg[i];
                while let Some(k) = q.back().cloned() {
                    if dp[k] - neg[k] >= v {
                        q.pop_back();
                    } else {
                        break;
                    }
                }
                q.push_back(i);
            }
        }
        dp[n]
    }
}

fn deliver(boxes: Vec[Vec[i32]], ports_count: i32, max_boxes: i32, max_weight: i32) -> i32 {
    Solution.box_delivering(boxes, ports_count, max_boxes, max_weight)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random problems of 1 to `most` boxes, up to `ports` ports and up
// to `limit` for each of the two caps; the trips summed, and a checksum
fn batch(count: i64, most: i64, ports: i64, limit: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let ports_count = next_random(mut seed) % ports + 1;
        let max_boxes = next_random(mut seed) % limit + 1;
        let max_weight = next_random(mut seed) % limit + 1;
        let mut boxes: Vec[Vec[i32]] = Vec.new();
        for _ in 0..n {
            let port = next_random(mut seed) % ports_count + 1;
            let weight = next_random(mut seed) % max_weight + 1;
            boxes.push([port as i32, weight as i32]);
        }
        let answer = deliver(boxes, ports_count as i32, max_boxes as i32, max_weight as i32);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} problems of up to {most} boxes, {ports} ports, caps up to {limit}: {total} trips, checksum {check}");
}

fn main() {
    // LeetCode's three examples, one box, and four for one port in one trip
    println(deliver([[1, 1], [2, 1], [1, 1]], 2, 3, 3));
    println(deliver([[1, 2], [3, 3], [3, 1], [3, 1], [2, 4]], 3, 3, 6));
    println(deliver([[1, 4], [1, 2], [2, 1], [2, 1], [3, 2], [3, 4]], 3, 6, 7));
    println(deliver([[1, 1]], 1, 1, 1));
    println(deliver([[5, 1], [5, 1], [5, 1], [5, 1]], 5, 4, 4));
    let mut seed = 1687;
    batch(3000, 10, 3, 5, mut seed);
    batch(300, 1000, 10, 50, mut seed);
    batch(10, 100000, 100000, 100000, mut seed);
}
