// LeetCode #1664: Ways to Make a Fair Array -- one signed sum.
//
// Count each value with a sign, + at an even index and - at an odd one,
// so the even sum minus the odd sum is a single total. Removing index i
// leaves the signs before it and flips every sign after it, so the array
// is fair exactly when the signed sum before i equals the signed sum
// after it. O(n) time, O(1) space.

fn ways_to_make_fair(nums: Vec[i32]) -> i32 {
    let signed = |i: i64, x: i32| if i % 2 == 0 { x as i64 } else { -(x as i64) };
    let total: i64 = nums.iter().enumerate().map(|(i, x)| signed(i, x)).sum();
    let mut before = 0;
    let mut ways = 0;
    for (i, x) in nums.iter().enumerate() {
        let here = signed(i, x);
        if before == total - before - here {
            ways += 1;
        }
        before += here;
    }
    ways
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` arrays of up to `longest` values from 1 to `top`; the fair
// removals summed, and a checksum of every answer
fn batch(count: i64, longest: i64, top: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % longest + 1;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) % top + 1) as i32);
        }
        let answer = ways_to_make_fair(nums);
        total += answer;
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"{count} arrays of up to {longest} values up to {top}: {total} fair removals, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, two equal values, and
    // a run of ones
    println(ways_to_make_fair([2, 1, 6, 4]));
    println(ways_to_make_fair([1, 1, 1]));
    println(ways_to_make_fair([1, 2, 3]));
    println(ways_to_make_fair([7]));
    println(ways_to_make_fair([5, 5]));
    println(ways_to_make_fair([1, 1, 1, 1, 1, 1, 1]));
    let mut seed = 1664;
    batch(3000, 8, 3, mut seed);
    batch(300, 1000, 10, mut seed);
    batch(10, 100000, 2, mut seed);
}
