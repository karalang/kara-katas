// LeetCode #1664: Ways to Make a Fair Array -- prefix sums by parity.
//
// `even[i]` and `odd[i]` hold the sums of the even- and odd-indexed
// values among the first i. Removing index i leaves the values before it
// as they were and swaps the parity of every value after it, so the new
// even sum is even[i] plus the odd values after i, and the new odd sum
// is odd[i] plus the even values after i. O(n) time and space.

fn ways_to_make_fair(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut even = Vec.filled(n + 1, 0);
    let mut odd = Vec.filled(n + 1, 0);
    for i in 0..n {
        even[i + 1] = even[i] + if i % 2 == 0 { nums[i] } else { 0 };
        odd[i + 1] = odd[i] + if i % 2 == 1 { nums[i] } else { 0 };
    }
    (0..n)
        .filter(|i| even[i] + odd[n] - odd[i + 1] == odd[i] + even[n] - even[i + 1])
        .count() as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` arrays of up to `longest` values from 1 to `top`; the fair
// removals summed, and a checksum of every answer
fn batch(count: i64, longest: i64, top: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % longest + 1;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) % top + 1) as i32);
        }
        let answer = ways_to_make_fair(nums);
        total += answer;
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"{count} arrays of up to {longest} values up to {top}: {total} fair removals, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, two equal values, and
    // a run of ones
    println(ways_to_make_fair([2, 1, 6, 4]));
    println(ways_to_make_fair([1, 1, 1]));
    println(ways_to_make_fair([1, 2, 3]));
    println(ways_to_make_fair([7]));
    println(ways_to_make_fair([5, 5]));
    println(ways_to_make_fair([1, 1, 1, 1, 1, 1, 1]));
    let mut seed = 1664;
    batch(3000, 8, 3, mut seed);
    batch(300, 1000, 10, mut seed);
    batch(10, 100000, 2, mut seed);
}
