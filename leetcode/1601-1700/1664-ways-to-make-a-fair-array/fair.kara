// LeetCode #1664: Ways to Make a Fair Array -- one pass with running
// sums.
//
// Removing index i keeps the values before it where they are and moves
// every value after it to the other parity. So with the even and odd
// sums of the values before i, and the totals, the sums after removal
// are before-even + after-odd and before-odd + after-even. One pass,
// O(n) time and O(1) space.

fn ways_to_make_fair(nums: Vec[i32]) -> i32 {
    let mut total = [0, 0];
    for (i, x) in nums.iter().enumerate() {
        total[i % 2] += x;
    }
    let mut before = [0, 0];
    let mut ways = 0;
    for (i, x) in nums.iter().enumerate() {
        let p = i % 2;
        // what follows index i, by its parity before the removal
        let mut after = [total[0] - before[0], total[1] - before[1]];
        after[p] -= x;
        // after the removal the values after i change parity
        if before[0] + after[1] == before[1] + after[0] {
            ways += 1;
        }
        before[p] += x;
    }
    ways
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` arrays of up to `longest` values from 1 to `top`; the fair
// removals summed, and a checksum of every answer
fn batch(count: i64, longest: i64, top: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % longest + 1;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) % top + 1) as i32);
        }
        let answer = ways_to_make_fair(nums);
        total += answer;
        check = (check * 31 + answer + 1) % 1000000007;
    }
    println(f"{count} arrays of up to {longest} values up to {top}: {total} fair removals, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, two equal values, and
    // a run of ones
    println(ways_to_make_fair([2, 1, 6, 4]));
    println(ways_to_make_fair([1, 1, 1]));
    println(ways_to_make_fair([1, 2, 3]));
    println(ways_to_make_fair([7]));
    println(ways_to_make_fair([5, 5]));
    println(ways_to_make_fair([1, 1, 1, 1, 1, 1, 1]));
    let mut seed = 1664;
    batch(3000, 8, 3, mut seed);
    batch(300, 1000, 10, mut seed);
    batch(10, 100000, 2, mut seed);
}
