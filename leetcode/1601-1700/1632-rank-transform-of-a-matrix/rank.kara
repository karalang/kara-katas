// LeetCode #1632: Rank Transform of a Matrix -- the ★ arm.
//
// The cells are taken in order of value, one value's cells at a time.
// Cells of one value that share a row or a column must share a rank, so
// a union-find joins each of them to the first cell of that value seen in
// its row and in its column. Each group's rank is one more than the
// largest rank already given in any of its rows or columns, and those
// row and column maxima then take it. O(rc log rc).

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn matrix_rank_transform(matrix: Vec[Vec[i32]]) -> Vec[Vec[i32]] {
    let (rows, cols) = (matrix.len(), matrix[0].len());
    let mut cells: Vec[(i32, i64, i64)] = Vec.new();
    for r in 0..rows {
        for c in 0..cols {
            cells.push((matrix[r][c], r, c));
        }
    }
    cells.sort();
    let mut row_max: Vec[i32] = Vec.filled(rows, 0);
    let mut col_max: Vec[i32] = Vec.filled(cols, 0);
    let mut answer: Vec[Vec[i32]] = Vec.filled(rows, Vec.filled(cols, 0));
    let mut parent: Vec[i64] = (0..rows * cols).collect();
    let mut start = 0;
    while start < cells.len() {
        let mut end = start;
        while end < cells.len() and cells[end].0 == cells[start].0 {
            end += 1;
        }
        // join the value's cells by row and by column
        let mut first_in_row: Map[i64, i64] = Map.new();
        let mut first_in_col: Map[i64, i64] = Map.new();
        for (_, r, c) in cells[start..end].iter() {
            let id = r * cols + c;
            match first_in_row.get(r) {
                Some(other) => {
                    let (a, b) = (find(mut parent, id), find(mut parent, other));
                    parent[a] = b;
                }
                None => {
                    first_in_row.insert(r, id);
                }
            }
            match first_in_col.get(c) {
                Some(other) => {
                    let (a, b) = (find(mut parent, id), find(mut parent, other));
                    parent[a] = b;
                }
                None => {
                    first_in_col.insert(c, id);
                }
            }
        }
        // each group's rank, from the largest in any of its rows and columns
        let mut group_rank: Map[i64, i32] = Map.new();
        for (_, r, c) in cells[start..end].iter() {
            let root = find(mut parent, r * cols + c);
            let rank = max(row_max[r], col_max[c]) + 1;
            let best = group_rank.get(root).unwrap_or(0);
            group_rank.insert(root, max(best, rank));
        }
        for (_, r, c) in cells[start..end].iter() {
            let rank = group_rank[find(mut parent, r * cols + c)];
            answer[r][c] = rank;
            row_max[r] = rank;
            col_max[c] = rank;
        }
        start = end;
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random matrices of 1 to `most` rows and columns, values from
// -`spread` to `spread`; every rank summed, and a checksum over them all
fn batch(count: i64, most: i64, spread: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let rows = next_random(mut seed) % most + 1;
        let cols = next_random(mut seed) % most + 1;
        let mut matrix: Vec[Vec[i32]] = Vec.new();
        for _ in 0..rows {
            let mut row: Vec[i32] = Vec.new();
            for _ in 0..cols {
                row.push((next_random(mut seed) % (2 * spread + 1) - spread) as i32);
            }
            matrix.push(row);
        }
        for row in matrix_rank_transform(matrix) {
            for rank in row {
                total += rank;
                check = (check * 31 + rank) % 1000000007;
            }
        }
    }
    println(f"{count} matrices of up to {most} x {most}: ranks sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's four examples, then one cell, and a column of one value
    println(matrix_rank_transform([[1, 2], [3, 4]]));
    println(matrix_rank_transform([[7, 7], [7, 7]]));
    println(matrix_rank_transform([[20, -21, 14], [-19, 4, 19], [22, -47, 24], [-19, 4, 19]]));
    println(matrix_rank_transform([[7, 3, 6], [1, 4, 5], [9, 8, 2]]));
    println(matrix_rank_transform([[-5]]));
    println(matrix_rank_transform([[3], [3], [3]]));
    let mut seed = 1632;
    batch(2000, 4, 3, mut seed);
    batch(200, 30, 1000, mut seed);
    batch(5, 200, 5, mut seed);
}
