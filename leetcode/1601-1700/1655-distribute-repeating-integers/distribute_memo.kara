// LeetCode #1655: Distribute Repeating Integers -- memoised search.
//
// `fits(v, mask)`: whether the values from the v-th on can serve the
// customers in `mask`. The v-th value serves some submask of them whose
// wants its count covers, or none, and the rest go on to the next; every
// (v, mask) is decided once. O(k 3^m).

fn can_distribute(nums: Vec[i32], quantity: Vec[i32]) -> bool {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut counts: Vec[i32] = Vec.new();
    let mut run = 0;
    for i in 0..sorted.len() {
        run += 1;
        if i + 1 == sorted.len() or sorted[i + 1] != sorted[i] {
            counts.push(run);
            run = 0;
        }
    }
    let m = quantity.len();
    let mut want: Vec[i32] = Vec.filled(1 << m, 0);
    for mask in 0..1 << m {
        for c in 0..m {
            if mask >> c & 1 == 1 {
                want[mask] += quantity[c];
            }
        }
    }
    let mut memo: Map[(i64, i64), bool] = Map.new();
    fits(counts, want, 0, (1 << m) - 1, mut memo)
}

fn fits(counts: Slice[i32], want: Slice[i32], v: i64, mask: i64, memo: mut ref Map[(i64, i64), bool]) -> bool {
    if mask == 0 {
        return true;
    }
    if v == counts.len() {
        return false;
    }
    if let Some(known) = memo.get((v, mask)) {
        return known;
    }
    let mut ok = fits(counts, want, v + 1, mask, mut memo);
    let mut sub = mask;
    while not ok and sub > 0 {
        if want[sub] <= counts[v] {
            ok = fits(counts, want, v + 1, mask ^ sub, mut memo);
        }
        sub = (sub - 1) & mask;
    }
    memo[(v, mask)] = ok;
    ok
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random problems: up to `size` numbers from up to `values`
// distinct values, and 1 to `customers` customers each wanting 1 to
// `most`; how many can be served, and a checksum
fn batch(count: i64, size: i64, values: i64, customers: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut served = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % size + 1;
        let distinct = next_random(mut seed) % values + 1;
        let nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % distinct + 1) as i32).collect();
        let m = next_random(mut seed) % customers + 1;
        let quantity: Vec[i32] = (0..m).map(|_| (next_random(mut seed) % most + 1) as i32).collect();
        let answer = can_distribute(nums, quantity);
        if answer {
            served += 1;
        }
        check = (check * 31 + (if answer { 2 } else { 1 })) % 1000000007;
    }
    println(f"{count} problems of up to {size} numbers and {customers} customers: {served} served, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one customer wanting everything,
    // and two wanting more than one value holds
    println(can_distribute([1, 2, 3, 4], [2]));
    println(can_distribute([1, 2, 3, 3], [2]));
    println(can_distribute([1, 1, 2, 2], [2, 2]));
    println(can_distribute([7, 7, 7], [3]));
    println(can_distribute([1, 1, 1, 2, 2], [2, 2, 1]));
    let mut seed = 1655;
    batch(3000, 12, 4, 4, 4, mut seed);
    batch(300, 1000, 50, 10, 30, mut seed);
    batch(30, 100000, 50, 10, 1000, mut seed);
}
