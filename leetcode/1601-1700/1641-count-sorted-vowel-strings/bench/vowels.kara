// LeetCode #1641: Count Sorted Vowel Strings -- the bench: the ★ arm on
// 4000000 random n from 1 to 50, all drawn first.

fn count_vowel_strings(n: i64) -> i64 {
    let mut ending: Array[i64, 5] = [1; 5];
    for _ in 1..n {
        for v in 1..5 {
            ending[v] += ending[v - 1];
        }
    }
    ending.iter().sum()
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1641;
    let mut ns: Vec[i64] = Vec.new();
    for _ in 0..4000000 {
        ns.push(next_random(mut seed) % 50 + 1);
    }
    let mut check = 0;
    let mut total = 0;
    for n in ns.iter() {
        let count = count_vowel_strings(n);
        total += count;
        check = (check * 31 + count) % 1000000007;
    }
    println(f"4000000 random n: counts sum to {total}, checksum {check}");
}
