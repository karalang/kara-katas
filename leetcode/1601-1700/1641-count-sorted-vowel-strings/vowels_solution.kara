// LeetCode #1641: Count Sorted Vowel Strings -- LeetCode's Rust template,
// as written there, carried over by `karac fix`.
//
// A table `dp[i][j]`: the sorted strings of length i that start with
// vowel j or later, each row built from the one before it. O(5n).

struct Solution {}

impl Solution {
    pub fn count_vowel_strings(n: i32) -> i32 {
        let n = n as i64;
        let mut dp = Vec.filled(n + 1, [0i32; 6]);
        for j in 0..5 {
            dp[1][j] = (5 - j) as i32;
        }
        for i in 2..=n {
            for j in (0..5).rev() {
                dp[i][j] = dp[i][j + 1] + dp[i - 1][j];
            }
        }
        dp[n][0]
    }
}

fn count_vowel_strings(n: i64) -> i64 {
    Solution.count_vowel_strings(n as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's three examples, then every n of the constraints, summed
    // and with a checksum
    println(count_vowel_strings(1));
    println(count_vowel_strings(2));
    println(count_vowel_strings(33));
    let mut check = 0;
    let mut total = 0;
    for n in 1..=50 {
        let count = count_vowel_strings(n);
        total += count;
        check = (check * 31 + count) % 1000000007;
    }
    println(f"n from 1 to 50: counts sum to {total}, checksum {check}");
    println(count_vowel_strings(50));
}
