// LeetCode #1641: Count Sorted Vowel Strings -- the closed form.
//
// A sorted string of n vowels is fixed by how many of each vowel it
// holds: five counts that sum to n. Stars and bars counts those as
// C(n + 4, 4), and the product of four consecutive numbers is always
// divisible by 4! = 24. O(1).

fn count_vowel_strings(n: i64) -> i64 {
    (n + 1) * (n + 2) * (n + 3) * (n + 4) / 24
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's three examples, then every n of the constraints, summed
    // and with a checksum
    println(count_vowel_strings(1));
    println(count_vowel_strings(2));
    println(count_vowel_strings(33));
    let mut check = 0;
    let mut total = 0;
    for n in 1..=50 {
        let count = count_vowel_strings(n);
        total += count;
        check = (check * 31 + count) % 1000000007;
    }
    println(f"n from 1 to 50: counts sum to {total}, checksum {check}");
    println(count_vowel_strings(50));
}
