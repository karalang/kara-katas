// LeetCode #1641: Count Sorted Vowel Strings -- the ★ arm.
//
// Build the strings one letter at a time, keeping how many sorted strings
// of the length so far end in each vowel. A string can end in vowel v
// after any string that ends in a vowel up to v, so the next counts are
// the running sums of these. O(5n).

fn count_vowel_strings(n: i64) -> i64 {
    let mut ending: Array[i64, 5] = [1; 5];
    for _ in 1..n {
        for v in 1..5 {
            ending[v] += ending[v - 1];
        }
    }
    ending.iter().sum()
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's three examples, then every n of the constraints, summed
    // and with a checksum
    println(count_vowel_strings(1));
    println(count_vowel_strings(2));
    println(count_vowel_strings(33));
    let mut check = 0;
    let mut total = 0;
    for n in 1..=50 {
        let count = count_vowel_strings(n);
        total += count;
        check = (check * 31 + count) % 1000000007;
    }
    println(f"n from 1 to 50: counts sum to {total}, checksum {check}");
    println(count_vowel_strings(50));
}
