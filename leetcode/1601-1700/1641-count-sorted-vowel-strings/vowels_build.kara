// LeetCode #1641: Count Sorted Vowel Strings -- building every string.
//
// Write the strings out letter by letter, each letter no earlier in
// "aeiou" than the one before, and count the ones that reach n letters,
// with a memo on (letters left, smallest vowel allowed) so the 50-letter
// case stays quick. O(25n) with the memo.

fn count_from(left: i64, lowest: i64, memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if left == 0 {
        return 1;
    }
    if let Some(known) = memo.get((left, lowest)) {
        return known;
    }
    let mut count = 0;
    for vowel in lowest..5 {
        count += count_from(left - 1, vowel, mut memo);
    }
    memo.insert((left, lowest), count);
    count
}

fn count_vowel_strings(n: i64) -> i64 {
    let mut memo: Map[(i64, i64), i64] = Map.new();
    count_from(n, 0, mut memo)
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's three examples, then every n of the constraints, summed
    // and with a checksum
    println(count_vowel_strings(1));
    println(count_vowel_strings(2));
    println(count_vowel_strings(33));
    let mut check = 0;
    let mut total = 0;
    for n in 1..=50 {
        let count = count_vowel_strings(n);
        total += count;
        check = (check * 31 + count) % 1000000007;
    }
    println(f"n from 1 to 50: counts sum to {total}, checksum {check}");
    println(count_vowel_strings(50));
}
