// LeetCode #1610: Maximum Number of Visible Points -- every first edge
// scanned.
//
// The directions sorted and doubled as in the ★ arm, then each tried as
// the view's first edge, the directions after it counted one by one
// while they stay within `angle`, with `1e-9` to spare as the ★ arm has.
// O(n^2) in the worst case.

struct View {
    here: i32,
    dirs: Vec[f64],
}

impl View {
    fn new(points: Slice[Vec[i32]], location: Slice[i32]) -> View {
        let mut view = View { here: 0, dirs: Vec.new() };
        for p in points.iter() {
            let dx = p[0] - location[0];
            let dy = p[1] - location[1];
            match (dx, dy) {
                (0, 0) => view.here += 1,
                _ => view.dirs.push((dy as f64).atan2(dx as f64).to_degrees()),
            }
        }
        view.dirs.sort_by(f64.total_cmp);
        let m = view.dirs.len();
        for i in 0..m {
            let d = view.dirs[i];
            view.dirs.push(d + 360.0);
        }
        view
    }

    fn widest(self, angle: f64) -> i64 {
        let m = self.dirs.len() / 2;
        let mut best = 0;
        for i in 0..m {
            let mut k = i;
            while k < self.dirs.len() and self.dirs[k] - self.dirs[i] <= angle {
                k += 1;
            }
            best = max(best, k - i);
        }
        best
    }
}

fn visible_points(points: Slice[Vec[i32]], angle: i32, location: Slice[i32]) -> i32 {
    let view = View.new(points, location);
    view.widest(angle as f64 + 1e-9) as i32 + view.here
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` problems of up to `most` points with coordinates from 0 to
// `top`, the location among them, and an angle from 0 to 359
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut points_seen = 0;
    let mut visible = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let points: Vec[Vec[i32]] = (0..n).map(|_| {
            let x = (next_random(mut seed) % (top + 1)) as i32;
            let y = (next_random(mut seed) % (top + 1)) as i32;
            [x, y]
        }).collect();
        let angle = (next_random(mut seed) % 360) as i32;
        let location = [(next_random(mut seed) % (top + 1)) as i32, (next_random(mut seed) % (top + 1)) as i32];
        let v = visible_points(points, angle, location);
        check = mix(check, v);
        visible += v;
        points_seen += n;
    }
    println(f"{count} problems of up to {most} points from 0 to {top}: {points_seen} points, {visible} visible, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then a view of 0 degrees down a line of
    // points, every point at the location, and points all round
    let examples: Vec[(Vec[Vec[i32]], i32, Vec[i32])] = [
        ([[2, 1], [2, 2], [3, 3]], 90, [1, 1]),
        ([[2, 1], [2, 2], [3, 4], [1, 1]], 90, [1, 1]),
        ([[1, 0], [2, 1]], 13, [1, 1]),
        ([[1, 1], [2, 2], [3, 3], [1, 2]], 0, [0, 0]),
        ([[5, 5], [5, 5]], 10, [5, 5]),
        ([[1, 0], [0, 1], [-1, 0], [0, -1], [0, 0]], 180, [0, 0]),
    ];
    for (points, angle, location) in examples.iter() {
        println(f"{visible_points(points, angle, location)}");
    }
    let mut seed = 1610;
    batch(3000, 6, 4, mut seed);
    batch(300, 1000, 100, mut seed);
    batch(3, 10000, 100, mut seed);
}
