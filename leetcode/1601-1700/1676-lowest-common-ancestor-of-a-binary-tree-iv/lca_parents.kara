// LeetCode #1676: Lowest Common Ancestor of a Binary Tree IV -- climbing
// by parents.
//
// One walk with a stack records every node's parent and depth, by value,
// in two `Map`s. Every node climbs to the depth of the shallowest; then
// all climb a level at a time until they stand on one node. O(n + k * h).

fn lowest_common_ancestor(root: Option[TreeNode], nodes: Vec[TreeNode]) -> Option[TreeNode] {
    let mut parent: Map[i32, TreeNode] = Map.new();
    let mut depth: Map[i32, i64] = Map.new();
    let top = root?;
    depth[top.val] = 0;
    let mut stack = [top];
    while let Some(node) = stack.pop() {
        for child in [node.left, node.right] {
            if let Some(c) = child {
                parent[c.val] = node;
                depth[c.val] = depth[node.val] + 1;
                stack.push(c);
            }
        }
    }
    let mut at = nodes.clone();
    let shallowest = at.iter().map(|n| depth[n.val]).min().unwrap();
    for i in 0..at.len() {
        while depth[at[i].val] > shallowest {
            at[i] = parent[at[i].val];
        }
    }
    while at.iter().any(|n| n.val != at[0].val) {
        for i in 0..at.len() {
            at[i] = parent[at[i].val];
        }
    }
    Some(at[0])
}

// ---- the harness: the same in every arm --------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(val: i32) -> TreeNode {
    TreeNode { val: val, left: None, right: None }
}

// a tree from LeetCode's level order, `None` for a missing child
fn from_level(values: Slice[Option[i32]]) -> Option[TreeNode] {
    let root = leaf(values[0].unwrap());
    let mut waiting: VecDeque[TreeNode] = VecDeque.new();
    waiting.push_back(root);
    let mut i = 1;
    while i < values.len() {
        let parent = waiting.pop_front().unwrap();
        if let Some(v) = values[i] {
            let child = leaf(v);
            parent.left = Some(child);
            waiting.push_back(child);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let child = leaf(v);
                parent.right = Some(child);
                waiting.push_back(child);
            }
            i += 1;
        }
    }
    Some(root)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` nodes holding 0 to n - 1 shuffled, each hung from a random node
// already placed, down a random walk to the first free child; every node,
// the root first
fn random_tree(n: i64, seed: mut ref i64) -> Vec[TreeNode] {
    let mut values: Vec[i32] = (0..n).map(|v| v as i32).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        values.swap(i, j);
    }
    let mut nodes: Vec[TreeNode] = Vec.new();
    for i in 0..n {
        let node = leaf(values[i]);
        if i > 0 {
            let mut at = nodes[next_random(mut seed) % i];
            loop {
                if next_random(mut seed) % 2 == 0 {
                    match at.left {
                        Some(child) => at = child,
                        None => {
                            at.left = Some(node);
                            break;
                        }
                    }
                } else {
                    match at.right {
                        Some(child) => at = child,
                        None => {
                            at.right = Some(node);
                            break;
                        }
                    }
                }
            }
        }
        nodes.push(node);
    }
    nodes
}

// the ancestor's value
fn answer(root: Option[TreeNode], nodes: Vec[TreeNode]) -> i64 {
    lowest_common_ancestor(root, nodes).unwrap().val
}

// the nodes of `tree` at the given values, found by a walk
fn at_values(root: Option[TreeNode], values: Slice[i32]) -> Vec[TreeNode] {
    let mut found: Vec[TreeNode] = Vec.new();
    for v in values.iter() {
        let mut stack: Vec[TreeNode] = [root.unwrap()];
        while let Some(node) = stack.pop() {
            if node.val == v {
                found.push(node);
                break;
            }
            if let Some(l) = node.left {
                stack.push(l);
            }
            if let Some(r) = node.right {
                stack.push(r);
            }
        }
    }
    found
}

// `count` random trees of 1 to `most` nodes, each asked about 5 sets of 1
// to 20 distinct nodes; the answers summed, and a checksum
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut nodes = random_tree(n, mut seed);
        let root = Some(nodes[0]);
        for _ in 0..5 {
            let k = next_random(mut seed) % min(n, 20) + 1;
            // the first k of a partial shuffle
            for i in 0..k {
                let j = i + next_random(mut seed) % (n - i);
                nodes.swap(i, j);
            }
            let picked: Vec[TreeNode] = nodes[..k].to_vec();
            let found = answer(root, picked);
            total += found;
            check = (check * 31 + found + k) % 1000000007;
        }
    }
    println(f"{count} trees of up to {most} nodes: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's four examples, then every node of the example, two
    // leaves under the root's left child, and a one-node tree
    let example = from_level([Some(3), Some(5), Some(1), Some(6), Some(2), Some(0), Some(8), None, None, Some(7), Some(4)]);
    println(answer(example, at_values(example, [4, 7])));
    println(answer(example, at_values(example, [1])));
    println(answer(example, at_values(example, [7, 6, 2, 4])));
    println(answer(example, at_values(example, [0, 1, 2, 3, 4, 5, 6, 7, 8])));
    println(answer(example, at_values(example, [6, 4])));
    let single = from_level([Some(1)]);
    println(answer(single, at_values(single, [1])));
    let mut seed = 1676;
    batch(3000, 8, mut seed);
    batch(300, 1000, mut seed);
    batch(30, 10000, mut seed);
}
