// LeetCode #1675: Minimize Deviation in Array -- the ★ arm: a max-first
// priority queue.
//
// An odd value can only be doubled, once, and an even value only halved,
// down to its odd part, so every value starts at the largest it can reach:
// odd values doubled. The queue pops the largest; while it is even it is
// halved and pushed back, and the smallest value seen so far is kept, so
// the deviation is measured each time the top comes down. Once the largest
// is odd it can only rise, and nothing better is left. O(n log n log m).

fn minimum_deviation(nums: Vec[i32]) -> i32 {
    let mut queue = PriorityQueue.max_first();
    let mut smallest = i32.MAX;
    for x in nums.iter() {
        let start = if x % 2 == 1 { x * 2 } else { x };
        queue.push(start);
        smallest = min(smallest, start);
    }
    let mut best = i32.MAX;
    loop {
        let top = queue.pop().unwrap();
        best = min(best, top - smallest);
        if top % 2 == 1 {
            break;
        }
        smallest = min(smallest, top / 2);
        queue.push(top / 2);
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` arrays of 2 to `longest` values from 1 to `most`; the
// deviations summed, and a checksum of every answer
fn batch(count: i64, longest: i64, most: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (longest - 1) + 2;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1) as i32);
        }
        let deviation = minimum_deviation(nums);
        total += deviation;
        check = (check * 31 + deviation + n) % 1000000007;
    }
    println(f"{count} arrays of up to {longest} values up to {most}: deviations sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then two odd values, one value doubled
    // past the other, and the largest values
    println(minimum_deviation([1, 2, 3, 4]));
    println(minimum_deviation([4, 1, 5, 20, 3]));
    println(minimum_deviation([2, 10, 8]));
    println(minimum_deviation([3, 5]));
    println(minimum_deviation([1, 1024]));
    println(minimum_deviation([1000000000, 999999999]));
    let mut seed = 1675;
    batch(3000, 8, 64, mut seed);
    batch(300, 1000, 1000000000, mut seed);
    batch(10, 50000, 1000000000, mut seed);
}
