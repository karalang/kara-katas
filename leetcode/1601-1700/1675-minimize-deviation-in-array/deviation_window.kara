// LeetCode #1675: Minimize Deviation in Array -- the narrowest window over
// every value each one can reach.
//
// Each value can reach its odd part times 1, 2, 4 and so on up to itself,
// and an odd one also its double. Every value reachable, tagged with the
// index it came from, is sorted; a window slides over them, and the
// narrowest that holds at least one value from every index is the answer,
// its last value less its first. O(n log m log(n log m)).

fn minimum_deviation(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let mut reach: Vec[(i32, i64)] = Vec.new();
    for (i, x) in nums.iter().enumerate() {
        let mut v = if x % 2 == 1 { x * 2 } else { x };
        reach.push((v, i));
        while v % 2 == 0 {
            v /= 2;
            reach.push((v, i));
        }
    }
    reach.sort();
    let mut seen = Vec.filled(n, 0);
    let mut covered = 0;
    let mut start = 0;
    let mut best = i32.MAX;
    for (value, i) in reach.iter() {
        if seen[i] == 0 {
            covered += 1;
        }
        seen[i] += 1;
        while covered == n {
            let (first, j) = reach[start];
            best = min(best, value - first);
            seen[j] -= 1;
            if seen[j] == 0 {
                covered -= 1;
            }
            start += 1;
        }
    }
    best
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` arrays of 2 to `longest` values from 1 to `most`; the
// deviations summed, and a checksum of every answer
fn batch(count: i64, longest: i64, most: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (longest - 1) + 2;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1) as i32);
        }
        let deviation = minimum_deviation(nums);
        total += deviation;
        check = (check * 31 + deviation + n) % 1000000007;
    }
    println(f"{count} arrays of up to {longest} values up to {most}: deviations sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then two odd values, one value doubled
    // past the other, and the largest values
    println(minimum_deviation([1, 2, 3, 4]));
    println(minimum_deviation([4, 1, 5, 20, 3]));
    println(minimum_deviation([2, 10, 8]));
    println(minimum_deviation([3, 5]));
    println(minimum_deviation([1, 1024]));
    println(minimum_deviation([1000000000, 999999999]));
    let mut seed = 1675;
    batch(3000, 8, 64, mut seed);
    batch(300, 1000, 1000000000, mut seed);
    batch(10, 50000, 1000000000, mut seed);
}
