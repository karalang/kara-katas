// LeetCode #1681: Minimum Incompatibility -- the bench: the ★ arm on
// 300 arrays of 16 values from 1 to 16, LeetCode's largest, each with a
// random k that divides 16, all drawn first, each answered 4 times.

fn minimum_incompatibility(nums: Vec[i32], k: i32) -> i32 {
    let n = nums.len();
    let size = n / k;
    let full = (1 << n) - 1;
    // the cost of every possible subset, -1 where it has a repeated value
    let mut cost = Vec.filled(1 << n, -1);
    for s in 0..=full {
        if s.count_ones() != size {
            continue;
        }
        let mut seen = 0;
        let mut lo = i32.MAX;
        let mut hi = i32.MIN;
        let mut ok = true;
        for i in 0..n {
            if s >> i & 1 == 1 {
                let bit = 1 << nums[i];
                if seen & bit != 0 {
                    ok = false;
                    break;
                }
                seen |= bit;
                lo = min(lo, nums[i]);
                hi = max(hi, nums[i]);
            }
        }
        if ok {
            cost[s] = hi - lo;
        }
    }
    let unreached = i32.MAX;
    let mut best = Vec.filled(1 << n, unreached);
    best[0] = 0;
    for m in 0..full {
        if best[m] == unreached or m.count_ones() % size != 0 {
            continue;
        }
        let free = full ^ m;
        let lowest = free & -free;
        // every subset of the free indexes that holds the lowest one
        let mut s = free;
        while s > 0 {
            if s & lowest != 0 and cost[s] >= 0 {
                best[m | s] = min(best[m | s], best[m] + cost[s]);
            }
            s = (s - 1) & free;
        }
    }
    if best[full] == unreached { -1 } else { best[full] }
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arrays = 300;
    let n = 16;
    let rounds = 4;
    let ks = [1, 2, 4, 8, 16];
    let mut seed = 1681;
    let mut cases: Vec[(Vec[i32], i32)] = Vec.new();
    for _ in 0..arrays {
        let nums: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % n + 1) as i32).collect();
        let k = ks[next_random(mut seed) % 5];
        cases.push((nums, k));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, k) in cases.iter() {
            let answer = minimum_incompatibility(nums, k);
            total += answer;
            check = (check * 31 + answer + 1 + r) % 1000000007;
        }
    }
    println(f"{arrays} arrays of {n} values, {rounds} rounds: answers sum to {total}, checksum {check}");
}
