// LeetCode #1611: Minimum One Bit Operations to Make Integers Zero --
// the ★ arm.
//
// The two operations are the steps of the reflected Gray code: the first
// flips bit 0, the second flips the bit just above the lowest set bit.
// So `n` is the Gray code of some number `k`, the moves to zero are the
// count down from `k`, and `k` is `n` turned back from Gray code, the XOR
// of `n` and all its right shifts. O(log n).

fn minimum_one_bit_operations(n: i32) -> i32 {
    let mut n = n;
    let mut k: i32 = 0;
    while n > 0 {
        k ^= n;
        n >>= 1;
    }
    k
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    // LeetCode's two examples, then 0, 1, 2, a power of two, all ones,
    // and the largest n allowed
    for n in [3i32, 6, 0, 1, 2, 1024, 1023, 1000000000] {
        println(f"{minimum_one_bit_operations(n)}");
    }
    let mut check = 0;
    let mut most = 0;
    for n in 0..4096 {
        let ops = minimum_one_bit_operations(n);
        check = mix(check, ops);
        most = max(most, ops);
    }
    println(f"every n below 4096: most {most}, checksum {check}");
    let mut seed = 1611;
    check = 0;
    let mut total = 0;
    for _ in 0..100000 {
        let n = ((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001) as i32;
        let ops = minimum_one_bit_operations(n);
        check = mix(check, ops);
        total += ops;
    }
    println(f"100000 random n to 10^9: total {total}, checksum {check}");
}
