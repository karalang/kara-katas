// LeetCode #1611: Minimum One Bit Operations to Make Integers Zero -- the
// bench: the ★ arm on 10000000 numbers up to 10^9, all drawn first.
//
// The ★ arm: n turned back from Gray code, the XOR of n and all its
// right shifts.

fn minimum_one_bit_operations(n: i32) -> i32 {
    let mut n = n;
    let mut k: i32 = 0;
    while n > 0 {
        k ^= n;
        n >>= 1;
    }
    k
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1611;
    let numbers: Vec[i32] = (0..10000000).map(|_| ((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001) as i32).collect();
    let mut check = 0;
    let mut total = 0;
    for n in numbers.iter() {
        let ops = minimum_one_bit_operations(*n);
        check = mix(check, ops);
        total += ops;
    }
    println(f"10000000 numbers up to 10^9: total {total}, checksum {check}");
}
