// LeetCode #1611: Minimum One Bit Operations to Make Integers Zero -- a
// Rust solution as LeetCode's Rust users write it (a loop over the bits
// from the top with a sign that flips, `i32::BITS`, `leading_zeros`,
// shifts on `i32`), carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn minimum_one_bit_operations(n: i32) -> i32 {
        let mut ans: i32 = 0;
        let mut sign: i32 = 1;
        let mut i = i32.BITS - n.leading_zeros();
        while i > 0 {
            i -= 1;
            if n >> i & 1 == 1 {
                ans += sign * ((1 << (i + 1)) - 1);
                sign = -sign;
            }
        }
        ans
    }
}

fn minimum_one_bit_operations(n: i32) -> i32 {
    Solution.minimum_one_bit_operations(n)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    // LeetCode's two examples, then 0, 1, 2, a power of two, all ones,
    // and the largest n allowed
    for n in [3i32, 6, 0, 1, 2, 1024, 1023, 1000000000] {
        println(f"{minimum_one_bit_operations(n)}");
    }
    let mut check = 0;
    let mut most = 0;
    for n in 0..4096 {
        let ops = minimum_one_bit_operations(n);
        check = mix(check, ops);
        most = max(most, ops);
    }
    println(f"every n below 4096: most {most}, checksum {check}");
    let mut seed = 1611;
    check = 0;
    let mut total = 0;
    for _ in 0..100000 {
        let n = ((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001) as i32;
        let ops = minimum_one_bit_operations(n);
        check = mix(check, ops);
        total += ops;
    }
    println(f"100000 random n to 10^9: total {total}, checksum {check}");
}
