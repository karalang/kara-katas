// LeetCode #1603: Design Parking System -- a Rust solution as LeetCode's
// Rust users write it (`[i32; 3]` slots, `&mut self`, the car type cast
// to `usize` to index), carried to Kāra by `karac fix`.

struct ParkingSystem {
    slots: Array[i32, 3],
}

/**
 * `&self` means the method takes an immutable reference.
 * If you need a mutable reference, change it to `&mut self` instead.
 */
impl ParkingSystem {
    fn new(big: i32, medium: i32, small: i32) -> Self {
        ParkingSystem {
            slots: [big, medium, small],
        }
    }

    fn add_car(mut ref self, car_type: i32) -> bool {
        let idx = (car_type - 1) as usize;
        if self.slots[idx] > 0 {
            self.slots[idx] -= 1;
            true
        } else {
            false
        }
    }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `cars` arrivals at a lot of `most` spaces or fewer of each size, each
// car's size 1 to 3 drawn as it comes; every answer folded in
fn batch(count: i64, most: i64, cars: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut parked = 0;
    for _ in 0..count {
        let big = (next_random(mut seed) % (most + 1)) as i32;
        let medium = (next_random(mut seed) % (most + 1)) as i32;
        let small = (next_random(mut seed) % (most + 1)) as i32;
        let mut lot = ParkingSystem.new(big, medium, small);
        for _ in 0..cars {
            let car_type = (next_random(mut seed) % 3 + 1) as i32;
            let ok = lot.add_car(car_type);
            if ok {
                parked += 1;
            }
            check = mix(check, if ok { 1 } else { 0 });
        }
    }
    println(f"{count} lots of up to {most} spaces a size, {count * cars} cars: {parked} parked, checksum {check}");
}

fn main() {
    // LeetCode's example, then a lot with no space at all, and one with
    // two of each size filled to the brim
    let examples: Vec[((i32, i32, i32), Vec[i32])] = [
        ((1, 1, 0), [1, 2, 3, 1]),
        ((0, 0, 0), [1, 2, 3]),
        ((2, 2, 2), [3, 3, 3, 2, 1, 2, 1, 1, 2]),
    ];
    for ((big, medium, small), cars) in examples.iter() {
        let mut lot = ParkingSystem.new(big, medium, small);
        let answers: Vec[String] = cars.iter().map(|c| f"{lot.add_car(*c)}").collect();
        println(f"[null, {answers.join(", ")}]");
    }
    let mut seed = 1603;
    batch(3000, 3, 10, mut seed);
    batch(300, 1000, 3000, mut seed);
    batch(3, 1000, 1000000, mut seed);
}
