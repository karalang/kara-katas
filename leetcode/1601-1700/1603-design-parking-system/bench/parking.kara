// LeetCode #1603: Design Parking System -- the bench: the ★ arm on 1000
// lots of up to 3000 spaces a size, each met by 10000 cars, the lots and
// the cars drawn first and the whole run 20 times over.
//
// The ★ arm: the spaces left of each size in a list indexed by the car's
// type less one.

struct ParkingSystem {
    left: Vec[i32],
}

impl ParkingSystem {
    fn new(big: i32, medium: i32, small: i32) -> ParkingSystem {
        ParkingSystem { left: [big, medium, small] }
    }

    fn add_car(mut ref self, car_type: i32) -> bool {
        let slot = car_type - 1;
        if self.left[slot] == 0 {
            return false;
        }
        self.left[slot] -= 1;
        true
    }
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1603;
    let mut lots: Vec[(i32, i32, i32)] = Vec.new();
    for _ in 0..1000 {
        let big = (next_random(mut seed) % 3001) as i32;
        let medium = (next_random(mut seed) % 3001) as i32;
        let small = (next_random(mut seed) % 3001) as i32;
        lots.push((big, medium, small));
    }
    let cars: Vec[i32] = (0..10000000).map(|_| (next_random(mut seed) % 3 + 1) as i32).collect();
    let mut check = 0;
    let mut parked = 0;
    for round in 0..20 {
        for (k, (big, medium, small)) in lots.iter().enumerate() {
            let mut lot = ParkingSystem.new(big, medium, small);
            let mut count = 0;
            for c in cars[k * 10000..(k + 1) * 10000].iter() {
                if lot.add_car(*c) {
                    count += 1;
                }
            }
            parked += count;
            check = mix(check, count + round);
        }
    }
    println(f"20 rounds of 1000 lots of up to 3000 spaces a size, 10000 cars each: {parked} parked, checksum {check}");
}
