// LeetCode #1638: Count Substrings That Differ by One Character -- the
// bench: the ★ arm on 5000 random pairs of 100-letter words over the
// letters a to c, all drawn first.

fn count_substrings(s: String, t: String) -> i64 {
    let (a, b) = (s.bytes(), t.bytes());
    let (n, m) = (a.len(), b.len());
    // left[i + 1][j + 1]: the matching run ending at (i, j)
    let mut left: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(m + 1, 0));
    for i in 0..n {
        for j in 0..m {
            if a[i] == b[j] {
                left[i + 1][j + 1] = left[i][j] + 1;
            }
        }
    }
    // right[i][j]: the matching run starting at (i, j)
    let mut right: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(m + 1, 0));
    for i in (0..n).rev() {
        for j in (0..m).rev() {
            if a[i] == b[j] {
                right[i][j] = right[i + 1][j + 1] + 1;
            }
        }
    }
    let mut count = 0;
    for i in 0..n {
        for j in 0..m {
            if a[i] != b[j] {
                count += (left[i][j] + 1) * (right[i + 1][j + 1] + 1);
            }
        }
    }
    count
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64) -> String {
    let mut word = String.new();
    for _ in 0..100 {
        word.push((b'a' + (next_random(mut seed) % 3) as u8) as char);
    }
    word
}

fn main() {
    let mut seed = 1638;
    let mut pairs: Vec[(String, String)] = Vec.new();
    for _ in 0..5000 {
        let s = random_word(mut seed);
        let t = random_word(mut seed);
        pairs.push((s, t));
    }
    let mut check = 0;
    let mut total = 0;
    for (s, t) in pairs.iter() {
        let count = count_substrings(s, t);
        total += count;
        check = (check * 31 + count + 1) % 1000000007;
    }
    println(f"5000 pairs of 100 letters: counts sum to {total}, checksum {check}");
}
