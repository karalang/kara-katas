// LeetCode #1638: Count Substrings That Differ by One Character -- the ★
// arm.
//
// Every counted pair has exactly one mismatched position (i, j), with
// s[i] != t[j]. Around it, the pair can reach left over as many matching
// letters as end at (i - 1, j - 1), and right over as many as start at
// (i + 1, j + 1): `left` and `right` tables of matching runs, filled from
// either end, give (left + 1) * (right + 1) pairs for each mismatch.
// O(nm).

fn count_substrings(s: String, t: String) -> i64 {
    let (a, b) = (s.bytes(), t.bytes());
    let (n, m) = (a.len(), b.len());
    // left[i + 1][j + 1]: the matching run ending at (i, j)
    let mut left: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(m + 1, 0));
    for i in 0..n {
        for j in 0..m {
            if a[i] == b[j] {
                left[i + 1][j + 1] = left[i][j] + 1;
            }
        }
    }
    // right[i][j]: the matching run starting at (i, j)
    let mut right: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(m + 1, 0));
    for i in (0..n).rev() {
        for j in (0..m).rev() {
            if a[i] == b[j] {
                right[i][j] = right[i + 1][j + 1] + 1;
            }
        }
    }
    let mut count = 0;
    for i in 0..n {
        for j in 0..m {
            if a[i] != b[j] {
                count += (left[i][j] + 1) * (right[i + 1][j + 1] + 1);
            }
        }
    }
    count
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(most: i64, letters: i64, seed: mut ref i64) -> String {
    let n = next_random(mut seed) % most + 1;
    let mut word = String.new();
    for _ in 0..n {
        word.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    word
}

// `count` random pairs of words of 1 to `most` letters from the first
// `letters` of the alphabet; the counts summed, and a checksum
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let s = random_word(most, letters, mut seed);
        let t = random_word(most, letters, mut seed);
        let pairs = count_substrings(s, t);
        total += pairs;
        check = (check * 31 + pairs + 1) % 1000000007;
    }
    println(f"{count} pairs of up to {most} letters: counts sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one letter alike, one letter apart,
    // and words with no letter in common
    println(count_substrings("aba", "baba"));
    println(count_substrings("ab", "bb"));
    println(count_substrings("a", "a"));
    println(count_substrings("abe", "bbc"));
    println(count_substrings("aaa", "bbb"));
    let mut seed = 1638;
    batch(3000, 6, 2, mut seed);
    batch(300, 100, 3, mut seed);
    batch(20, 100, 26, mut seed);
}
