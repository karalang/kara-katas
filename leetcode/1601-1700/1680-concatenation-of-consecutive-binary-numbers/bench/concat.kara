// LeetCode #1680: Concatenation of Consecutive Binary Numbers -- the bench:
// the ★ arm on 800 random n up to 100000, LeetCode's largest, all drawn
// first, each answered 5 times.

fn concatenated_binary(n: i32) -> i32 {
    let modulus = 1000000007;
    let mut value = 0;
    let mut bits = 0;
    for i in 1..=n as i64 {
        if i & (i - 1) == 0 {
            bits += 1;
        }
        value = ((value << bits) + i) % modulus;
    }
    value as i32
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 800;
    let rounds = 5;
    let mut seed = 1680;
    let mut ns: Vec[i32] = Vec.new();
    for _ in 0..count {
        ns.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1) as i32);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for n in ns.iter() {
            let answer = concatenated_binary(n);
            total += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} values of n, {rounds} rounds: answers sum to {total}, checksum {check}");
}
