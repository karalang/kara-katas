// LeetCode #1680: Concatenation of Consecutive Binary Numbers -- the ★ arm:
// one running value.
//
// Appending i's bits is shifting the value left by i's bit length and
// adding i. The bit length grows by one at each power of two, which
// `i & (i - 1) == 0` tells. Everything is taken modulo 10^9 + 7 at each
// step; the value stays below 2^30 before a shift of at most 17. O(n).

fn concatenated_binary(n: i32) -> i32 {
    let modulus = 1000000007;
    let mut value = 0;
    let mut bits = 0;
    for i in 1..=n as i64 {
        if i & (i - 1) == 0 {
            bits += 1;
        }
        value = ((value << bits) + i) % modulus;
    }
    value as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random n from 1 to `most`; the answers summed, and a checksum
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = ((next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1) as i32;
        let answer = concatenated_binary(n);
        total += answer;
        check = (check * 31 + answer + n) % 1000000007;
    }
    println(f"{count} values of n up to {most}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then the first n whose answer wraps, and
    // the largest n
    println(concatenated_binary(1));
    println(concatenated_binary(3));
    println(concatenated_binary(12));
    println(concatenated_binary(11));
    println(concatenated_binary(100000));
    let mut seed = 1680;
    batch(3000, 100, mut seed);
    batch(300, 10000, mut seed);
    batch(10, 100000, mut seed);
}
