// LeetCode #1698: Number of Distinct Substrings in a String -- a suffix
// automaton.
//
// The automaton built a letter at a time: each state stands for the
// substrings that end at the same set of places, len[v] the longest and
// len[link[v]] + 1 the shortest, so the answer is the sum of len[v] -
// len[link[v]] over the states other than the start. O(n * 26).

struct State {
    len: i64,
    link: i64,
    next: Vec[i64],
}

fn count_distinct(s: Str) -> i32 {
    let mut states: Vec[State] = [State { len: 0, link: -1, next: Vec.filled(26, -1) }];
    let mut last = 0;
    for b in s.bytes().iter() {
        let c = (b - b'a') as i64;
        let current = states.len();
        states.push(State { len: states[last].len + 1, link: 0, next: Vec.filled(26, -1) });
        let mut p = last;
        while p != -1 and states[p].next[c] == -1 {
            states[p].next[c] = current;
            p = states[p].link;
        }
        if p != -1 {
            let q = states[p].next[c];
            if states[p].len + 1 == states[q].len {
                states[current].link = q;
            } else {
                let copy = states.len();
                states.push(State { len: states[p].len + 1, link: states[q].link, next: states[q].next.clone() });
                while p != -1 and states[p].next[c] == q {
                    states[p].next[c] = copy;
                    p = states[p].link;
                }
                states[q].link = copy;
                states[current].link = copy;
            }
        }
        last = current;
    }
    let mut total = 0;
    for v in 1..states.len() {
        total += states[v].len - states[states[v].link].len;
    }
    total as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random strings of 1 to `most` letters from the first 1 to
// `letters` of the alphabet; the answers summed, and a checksum of them
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let used = next_random(mut seed) % letters + 1;
        let mut s = String.new();
        for _ in 0..n {
            let pick = next_random(mut seed) % used;
            s.push_str(alphabet.substring(pick, pick + 1));
        }
        let answer = count_distinct(s);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} strings of up to {most} letters from up to {letters}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one letter, one letter four times, and
    // a pair twice
    println(count_distinct("aabbaba"));
    println(count_distinct("abcdefg"));
    println(count_distinct("a"));
    println(count_distinct("aaaa"));
    println(count_distinct("abab"));
    let mut seed = 1698;
    batch(3000, 12, 4, mut seed);
    batch(300, 100, 4, mut seed);
    batch(10, 500, 26, mut seed);
}
