// LeetCode #1698: Number of Distinct Substrings in a String -- the bench:
// the ★ arm on 100 random strings of 500 letters, LeetCode's longest, each
// from the first 2 to 26 letters of the alphabet, all drawn first, each
// answered 3 times.
//
// Every suffix walked into a trie of 26 children per node; each node made
// is one distinct substring. O(n^2).

fn count_distinct(s: Str) -> i32 {
    let letters = s.bytes();
    let mut children: Vec[Vec[i64]] = [Vec.filled(26, 0)];
    let mut made = 0;
    for start in 0..letters.len() {
        let mut node = 0;
        for c in letters[start..].iter() {
            let edge = (c - b'a') as i64;
            if children[node][edge] == 0 {
                children.push(Vec.filled(26, 0));
                children[node][edge] = children.len() - 1;
                made += 1;
            }
            node = children[node][edge];
        }
    }
    made
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100;
    let rounds = 3;
    let n = 500;
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    let mut seed = 1698;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..count {
        let used = next_random(mut seed) % 25 + 2;
        let mut s = String.new();
        for _ in 0..n {
            let pick = next_random(mut seed) % used;
            s.push_str(alphabet.substring(pick, pick + 1));
        }
        strings.push(s);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for s in strings.iter() {
            let answer = count_distinct(s);
            total += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} strings of {n} letters, {rounds} rounds: answers sum to {total}, checksum {check}");
}
