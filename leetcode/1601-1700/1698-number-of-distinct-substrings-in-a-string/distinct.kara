// LeetCode #1698: Number of Distinct Substrings in a String -- the ★ arm:
// every suffix put in a trie, one node per distinct substring.
//
// A substring is a prefix of a suffix, so walking each suffix into a trie
// makes one new node for each substring not met before; the answer is the
// nodes made. The trie is a `Vec` of 26 children per node, 0 for none.
// O(n^2) time and nodes.

fn count_distinct(s: Str) -> i32 {
    let letters = s.bytes();
    let mut children: Vec[Vec[i64]] = [Vec.filled(26, 0)];
    let mut made = 0;
    for start in 0..letters.len() {
        let mut node = 0;
        for c in letters[start..].iter() {
            let edge = (c - b'a') as i64;
            if children[node][edge] == 0 {
                children.push(Vec.filled(26, 0));
                children[node][edge] = children.len() - 1;
                made += 1;
            }
            node = children[node][edge];
        }
    }
    made
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random strings of 1 to `most` letters from the first 1 to
// `letters` of the alphabet; the answers summed, and a checksum of them
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let used = next_random(mut seed) % letters + 1;
        let mut s = String.new();
        for _ in 0..n {
            let pick = next_random(mut seed) % used;
            s.push_str(alphabet.substring(pick, pick + 1));
        }
        let answer = count_distinct(s);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} strings of up to {most} letters from up to {letters}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then one letter, one letter four times, and
    // a pair twice
    println(count_distinct("aabbaba"));
    println(count_distinct("abcdefg"));
    println(count_distinct("a"));
    println(count_distinct("aaaa"));
    println(count_distinct("abab"));
    let mut seed = 1698;
    batch(3000, 12, 4, mut seed);
    batch(300, 100, 4, mut seed);
    batch(10, 500, 26, mut seed);
}
