// LeetCode #1674: Minimum Moves to Make Array Complementary -- a Rust
// solution as LeetCode's Rust users write it (the ★ arm's difference array
// as `vec![0i32; 2 * limit + 2]` indexed by `usize` casts, `(a.min(b),
// a.max(b))` as a tuple, and `ans.min(cur)`), carried to Kāra by
// `karac fix`.

struct Solution {}

impl Solution {
    pub fn min_moves(nums: Vec[i32], limit: i32) -> i32 {
        let n = nums.len();
        let limit = limit as i64;
        let mut diff = Vec.filled(2 * limit + 2, 0i32);
        for i in 0..n / 2 {
            let (a, b) = (nums[i] as i64, nums[n - 1 - i] as i64);
            let (lo, hi) = (a.min(b), a.max(b));
            diff[2] += 2;
            diff[lo + 1] -= 1;
            diff[a + b] -= 1;
            diff[a + b + 1] += 1;
            diff[hi + limit + 1] += 1;
        }
        let mut ans = n as i32;
        let mut cur: i32 = 0;
        for s in 2..=2 * limit {
            cur += diff[s];
            ans = ans.min(cur);
        }
        ans
    }
}

fn min_moves(nums: Vec[i32], limit: i32) -> i32 {
    Solution.min_moves(nums, limit)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` arrays of 1 to `pairs` pairs with a limit of 1 to `most`; the
// moves summed, and a checksum of every answer
fn batch(count: i64, pairs: i64, most: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = 2 * (next_random(mut seed) % pairs + 1);
        let limit = next_random(mut seed) % most + 1;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) % limit + 1) as i32);
        }
        let moves = min_moves(nums, limit as i32);
        total += moves;
        check = (check * 31 + moves + n) % 1000000007;
    }
    println(f"{count} arrays of up to {pairs} pairs, limits up to {most}: {total} moves, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then a pair of ones beside (1, 4), and a
    // single pair
    println(min_moves([1, 2, 4, 3], 4));
    println(min_moves([1, 2, 2, 1], 2));
    println(min_moves([1, 2, 1, 2], 2));
    println(min_moves([1, 1, 1, 4], 4));
    println(min_moves([3, 3], 3));
    let mut seed = 1674;
    batch(3000, 6, 6, mut seed);
    batch(300, 100, 100, mut seed);
    batch(10, 1000, 1000, mut seed);
}
