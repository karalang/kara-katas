// LeetCode #1674: Minimum Moves to Make Array Complementary -- the
// differential.
//
// Four arms against the statement read literally, on 3000 random arrays
// of 1 to 6 pairs with a limit of 1 to 6.
//
// P1  the answer is the statement read literally
// P2  the array reversed gives the same answer
// P3  the pairs in another order give the same answer
// P4  a limit one higher never needs more moves
// P5  each arm agrees with at least two of the other three

// ---- complementary.kara: the ★ arm: a difference array over the target sums

fn star_arm(nums: Vec[i32], limit: i32) -> i32 {
    let n = nums.len();
    let limit = limit as i64;
    let mut delta = Vec.filled(2 * limit + 2, 0);
    for i in 0..n / 2 {
        let a = min(nums[i], nums[n - 1 - i]) as i64;
        let b = max(nums[i], nums[n - 1 - i]) as i64;
        delta[2] += 2;
        delta[a + 1] -= 1;
        delta[a + b] -= 1;
        delta[a + b + 1] += 1;
        delta[b + limit + 1] += 1;
    }
    let mut best = n;
    let mut moves = 0;
    for sum in 2..=2 * limit {
        moves += delta[sum];
        best = min(best, moves);
    }
    best as i32
}

// ---- complementary_every.kara: every target sum tried

fn every_arm(nums: Vec[i32], limit: i32) -> i32 {
    let n = nums.len();
    let mut best = i32.MAX;
    for target in 2..=2 * limit {
        let mut moves = 0;
        for i in 0..n / 2 {
            let (a, b) = (nums[i], nums[n - 1 - i]);
            moves += if a + b == target {
                0
            } else if min(a, b) + 1 <= target and target <= max(a, b) + limit {
                1
            } else {
                2
            };
        }
        best = min(best, moves);
    }
    best
}

// ---- complementary_sweep.kara: a sweep over the sums where the cost changes

fn sweep_arm(nums: Vec[i32], limit: i32) -> i32 {
    let n = nums.len();
    let mut steps: SortedMap[i32, i32] = SortedMap.new();
    for i in 0..n / 2 {
        let (a, b) = (min(nums[i], nums[n - 1 - i]), max(nums[i], nums[n - 1 - i]));
        *steps.entry(a + 1).or_insert(0) -= 1;
        *steps.entry(a + b).or_insert(0) -= 1;
        *steps.entry(a + b + 1).or_insert(0) += 1;
        *steps.entry(b + limit + 1).or_insert(0) += 1;
    }
    let mut moves = n as i32;
    let mut best = moves;
    for (_, step) in steps.iter() {
        moves += step;
        best = min(best, moves);
    }
    best
}

// ---- complementary_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn min_moves(nums: Vec[i32], limit: i32) -> i32 {
        let n = nums.len();
        let limit = limit as i64;
        let mut diff = Vec.filled(2 * limit + 2, 0i32);
        for i in 0..n / 2 {
            let (a, b) = (nums[i] as i64, nums[n - 1 - i] as i64);
            let (lo, hi) = (a.min(b), a.max(b));
            diff[2] += 2;
            diff[lo + 1] -= 1;
            diff[a + b] -= 1;
            diff[a + b + 1] += 1;
            diff[hi + limit + 1] += 1;
        }
        let mut ans = n as i32;
        let mut cur: i32 = 0;
        for s in 2..=2 * limit {
            cur += diff[s];
            ans = ans.min(cur);
        }
        ans
    }
}

fn solution_arm(nums: Vec[i32], limit: i32) -> i32 {
    SolutionArm.min_moves(nums, limit)
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: for each sum every pair could share, the
// fewest of its two values each pair must replace by one in 1..=limit to
// reach it, found by trying the replacements; the cheapest sum
fn literal(nums: Slice[i32], limit: i32) -> i64 {
    let n = nums.len();
    let mut best = n;
    for target in 2..=2 * limit {
        let mut moves = 0;
        for i in 0..n / 2 {
            let (a, b) = (nums[i], nums[n - 1 - i]);
            if a + b == target {
                continue;
            }
            let one = (1..=limit).any(|x| x + b == target or a + x == target);
            moves += if one { 1 } else { 2 };
        }
        best = min(best, moves);
    }
    best
}

fn arm(a: i64, nums: Slice[i32], limit: i32) -> i64 {
    let nums = nums.to_vec();
    match a {
        0 => star_arm(nums, limit),
        1 => every_arm(nums, limit),
        2 => sweep_arm(nums, limit),
        _ => solution_arm(nums, limit),
    }
}

fn arm_name(a: i64) -> Str {
    ["the ★ arm", "every", "sweep", "solution"][a]
}

fn main() {
    let mut seed = 1674;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    // each case: the array, its limit, and an order of its pairs
    let mut cases: Vec[(Vec[i32], i32, Vec[i64])] = Vec.new();
    for _ in 0..problems {
        let pairs = next_random(mut seed) % 6 + 1;
        let limit = next_random(mut seed) % 6 + 1;
        let nums: Vec[i32] = (0..2 * pairs).map(|_| (next_random(mut seed) % limit + 1) as i32).collect();
        let mut order: Vec[i64] = (0..pairs).collect();
        for i in (1..pairs).rev() {
            let j = next_random(mut seed) % (i + 1);
            order.swap(i, j);
        }
        cases.push((nums, limit as i32, order));
    }
    for (p, (nums, limit, order)) in cases.iter().enumerate() {
        let n = nums.len();
        let want = literal(nums, limit);
        check = (check * 31 + want + n + limit) % 1000000007;
        let reversed: Vec[i32] = nums.iter().rev().collect();
        // pair i of the new order is pair order[i] of the old, at both ends
        let mut moved = nums.to_vec();
        for i in 0..order.len() {
            moved[i] = nums[order[i]];
            moved[n - 1 - i] = nums[n - 1 - order[i]];
        }
        let mut answers: Vec[i64] = Vec.new();
        for a in 0..4 {
            let got = arm(a, nums, limit);
            answers.push(got);
            let failed = [
                got != want,
                arm(a, reversed, limit) != got,
                arm(a, moved, limit) != got,
                arm(a, nums, limit + 1) > got,
            ];
            for q in 0..4 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p} ({nums}, limit {limit}), {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|y| y == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..6 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
