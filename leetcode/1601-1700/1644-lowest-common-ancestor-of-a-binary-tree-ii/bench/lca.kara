// LeetCode #1644: Lowest Common Ancestor of a Binary Tree II -- the bench:
// the ★ arm on 60 random trees of 10000 nodes, each asked about 50 pairs
// of values, one in five of them not in the tree, all drawn first.

fn lowest_common_ancestor(root: Option[TreeNode], p: TreeNode, q: TreeNode) -> Option[TreeNode] {
    let mut found = None;
    count_below(root, p.val, q.val, mut found);
    found
}

// how many of `p` and `q` are in the subtree at `node`
fn count_below(node: Option[TreeNode], p: i32, q: i32, found: mut ref Option[TreeNode]) -> i64 {
    match node {
        None => 0,
        Some(n) => {
            let here = if n.val == p or n.val == q { 1 } else { 0 };
            let count = count_below(n.left, p, q, mut found) + count_below(n.right, p, q, mut found) + here;
            if count == 2 and found.is_none() {
                *found = Some(n);
            }
            count
        }
    }
}

// ---- the harness ----------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(val: i32) -> TreeNode {
    TreeNode { val: val, left: None, right: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` nodes holding 0 to n - 1 shuffled, each hung from a random node
// already placed, down a random walk to the first free child
fn random_tree(n: i64, seed: mut ref i64) -> Option[TreeNode] {
    let mut values: Vec[i32] = (0..n).map(|v| v as i32).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        values.swap(i, j);
    }
    let mut nodes: Vec[TreeNode] = Vec.new();
    for i in 0..n {
        let node = leaf(values[i]);
        if i > 0 {
            let mut at = nodes[next_random(mut seed) % i];
            loop {
                if next_random(mut seed) % 2 == 0 {
                    match at.left {
                        Some(child) => at = child,
                        None => {
                            at.left = Some(node);
                            break;
                        }
                    }
                } else {
                    match at.right {
                        Some(child) => at = child,
                        None => {
                            at.right = Some(node);
                            break;
                        }
                    }
                }
            }
        }
        nodes.push(node);
    }
    Some(nodes[0])
}

fn main() {
    let mut seed = 1644;
    let mut trees: Vec[(Option[TreeNode], Vec[(i32, i32)])] = Vec.new();
    for _ in 0..60 {
        let root = random_tree(10000, mut seed);
        let mut pairs: Vec[(i32, i32)] = Vec.new();
        for _ in 0..50 {
            let p = next_random(mut seed) % 12500;
            let mut q = next_random(mut seed) % 12500;
            if q == p {
                q = (q + 1) % 12500;
            }
            pairs.push((p as i32, q as i32));
        }
        trees.push((root, pairs));
    }
    let mut check = 0;
    let mut total = 0;
    for (root, pairs) in trees.iter() {
        for (p, q) in pairs.iter() {
            let found = match lowest_common_ancestor(root, leaf(p), leaf(q)) {
                Some(node) => node.val,
                None => -1,
            };
            total += found + 1;
            check = (check * 31 + found + 2) % 1000000007;
        }
    }
    println(f"60 trees of 10000 nodes, 50 pairs each: answers sum to {total}, checksum {check}");
}
