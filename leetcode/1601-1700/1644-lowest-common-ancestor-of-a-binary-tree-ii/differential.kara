// LeetCode #1644: Lowest Common Ancestor of a Binary Tree II -- the
// differential.
//
// Four arms against the statement read literally, on 3000 random trees
// of 1 to 8 nodes, each asked about one pair of values, one in four of
// them on average not in the tree. Every case is drawn before any arm
// answers.
//
// P1  the answer is the statement read literally
// P2  p and q swapped give the same answer
// P3  the mirrored tree gives the same answer
// P4  an answer other than p, asked about with p, is its own answer
// P5  each arm agrees with at least two of the other three

// ---- lca.kara: the ★ arm: one walk counting p and q below each node

fn star_arm(root: Option[TreeNode], p: TreeNode, q: TreeNode) -> Option[TreeNode] {
    let mut found = None;
    count_below(root, p.val, q.val, mut found);
    found
}

// how many of `p` and `q` are in the subtree at `node`
fn count_below(node: Option[TreeNode], p: i32, q: i32, found: mut ref Option[TreeNode]) -> i64 {
    match node {
        None => 0,
        Some(n) => {
            let here = if n.val == p or n.val == q { 1 } else { 0 };
            let count = count_below(n.left, p, q, mut found) + count_below(n.right, p, q, mut found) + here;
            if count == 2 and found.is_none() {
                *found = Some(n);
            }
            count
        }
    }
}

// ---- lca_parents.kara: every parent recorded, then q climbs to p's ancestors

fn parents_arm(root: Option[TreeNode], p: TreeNode, q: TreeNode) -> Option[TreeNode] {
    let mut by_value: Map[i32, TreeNode] = Map.new();
    let mut parent: Map[i32, i32] = Map.new();
    let mut todo: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        todo.push(r);
    }
    while let Some(n) = todo.pop() {
        by_value.insert(n.val, n);
        for child in [n.left, n.right] {
            if let Some(c) = child {
                parent.insert(c.val, n.val);
                todo.push(c);
            }
        }
    }
    if not by_value.contains_key(p.val) or not by_value.contains_key(q.val) {
        return None;
    }
    let mut ancestors: Set[i32] = Set.new();
    let mut at = Some(p.val);
    while let Some(v) = at {
        ancestors.insert(v);
        at = parent.get(v).cloned();
    }
    let mut v = q.val;
    while not ancestors.contains(v) {
        v = parent[v];
    }
    by_value.get(v).cloned()
}

// ---- lca_paths.kara: the paths to p and q, and the last node they share

fn paths_path_to(node: Option[TreeNode], target: i32, path: mut ref Vec[TreeNode]) -> bool {
    let Some(n) = node else {
        return false;
    };
    path.push(n);
    if n.val == target or paths_path_to(n.left, target, mut path) or paths_path_to(n.right, target, mut path) {
        return true;
    }
    path.pop();
    false
}

fn paths_arm(root: Option[TreeNode], p: TreeNode, q: TreeNode) -> Option[TreeNode] {
    let mut to_p: Vec[TreeNode] = Vec.new();
    let mut to_q: Vec[TreeNode] = Vec.new();
    if not paths_path_to(root, p.val, mut to_p) or not paths_path_to(root, q.val, mut to_q) {
        return None;
    }
    let mut last = None;
    for (a, b) in to_p.iter().zip(to_q.iter()) {
        if a.val != b.val {
            break;
        }
        last = Some(a);
    }
    last.cloned()
}

// ---- lca_classic.kara: #236's search, run when both are in the tree

fn classic_contains(node: Option[TreeNode], target: i32) -> bool {
    match node {
        None => false,
        Some(n) => n.val == target or classic_contains(n.left, target) or classic_contains(n.right, target),
    }
}

fn classic_search(node: Option[TreeNode], p: i32, q: i32) -> Option[TreeNode] {
    let n = node?;
    if n.val == p or n.val == q {
        return Some(n);
    }
    let left = classic_search(n.left, p, q);
    let right = classic_search(n.right, p, q);
    if left.is_some() and right.is_some() {
        return Some(n);
    }
    left.or(right)
}

fn classic_arm(root: Option[TreeNode], p: TreeNode, q: TreeNode) -> Option[TreeNode] {
    if classic_contains(root, p.val) and classic_contains(root, q.val) {
        classic_search(root, p.val, q.val)
    } else {
        None
    }
}

// ---- the harness ----------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(val: i32) -> TreeNode {
    TreeNode { val: val, left: None, right: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` nodes holding 0 to n - 1 shuffled, each hung from a random node
// already placed, down a random walk to the first free child
fn random_tree(n: i64, seed: mut ref i64) -> Option[TreeNode] {
    let mut values: Vec[i32] = (0..n).map(|v| v as i32).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        values.swap(i, j);
    }
    let mut nodes: Vec[TreeNode] = Vec.new();
    for i in 0..n {
        let node = leaf(values[i]);
        if i > 0 {
            let mut at = nodes[next_random(mut seed) % i];
            loop {
                if next_random(mut seed) % 2 == 0 {
                    match at.left {
                        Some(child) => at = child,
                        None => {
                            at.left = Some(node);
                            break;
                        }
                    }
                } else {
                    match at.right {
                        Some(child) => at = child,
                        None => {
                            at.right = Some(node);
                            break;
                        }
                    }
                }
            }
        }
        nodes.push(node);
    }
    Some(nodes[0])
}

fn arm(a: i64, root: Option[TreeNode], p: i32, q: i32) -> i64 {
    let found = match a {
        0 => star_arm(root, leaf(p), leaf(q)),
        1 => parents_arm(root, leaf(p), leaf(q)),
        2 => paths_arm(root, leaf(p), leaf(q)),
        _ => classic_arm(root, leaf(p), leaf(q)),
    };
    match found {
        Some(node) => node.val,
        None => -1,
    }
}

fn arm_name(a: i64) -> String {
    ["lca", "parents", "paths", "classic"][a].to_string()
}

// the tree with every node's children swapped, built anew
fn mirrored(node: Option[TreeNode]) -> Option[TreeNode] {
    let n = node?;
    Some(TreeNode { val: n.val, left: mirrored(n.right), right: mirrored(n.left) })
}

// ---- the statement read literally: a node is a common ancestor when
// both p and q are among its descendants, itself included; the lowest is
// the one with the fewest descendants, and if no node is one, or either
// value is not in the tree, there is no answer

fn descendants(node: Option[TreeNode], out: mut ref Vec[i32]) {
    if let Some(n) = node {
        out.push(n.val);
        descendants(n.left, mut out);
        descendants(n.right, mut out);
    }
}

fn literal(root: Option[TreeNode], p: i32, q: i32) -> i64 {
    let mut all: Vec[TreeNode] = Vec.new();
    let mut todo: Vec[TreeNode] = Vec.new();
    if let Some(r) = root {
        todo.push(r);
    }
    while let Some(n) = todo.pop() {
        all.push(n);
        if let Some(l) = n.left {
            todo.push(l);
        }
        if let Some(r) = n.right {
            todo.push(r);
        }
    }
    let mut best = -1;
    let mut fewest = 1000000;
    for n in all.iter() {
        let mut below: Vec[i32] = Vec.new();
        descendants(Some(n), mut below);
        if below.contains(p) and below.contains(q) and below.len() < fewest {
            fewest = below.len();
            best = n.val;
        }
    }
    best
}

fn main() {
    let mut seed = 1644;
    let mut failures = 0;
    let mut checks = 0;
    let mut check = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let problems = 3000;
    let mut cases: Vec[(Option[TreeNode], i32, i32)] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 8 + 1;
        let root = random_tree(n, mut seed);
        // one value in four on average not in the tree
        let range = n + n / 3 + 1;
        let p = next_random(mut seed) % range;
        let mut q = next_random(mut seed) % range;
        if q == p {
            q = (q + 1) % range;
        }
        cases.push((root, p as i32, q as i32));
    }
    for (problem, (root, p, q)) in cases.iter().enumerate() {
        let want = literal(root, p, q);
        check = (check * 31 + want + 2) % 1000000007;
        let flipped = mirrored(root);
        let mut answers: Vec[i64] = Vec.new();
        for a in 0..4 {
            let got = arm(a, root, p, q);
            answers.push(got);
            let failed = [
                got != want,
                arm(a, root, q, p) != got,
                arm(a, flipped, p, q) != got,
                got >= 0 and got != p and arm(a, root, got as i32, p) != got,
            ];
            for k in 0..4 {
                checks += 1;
                if failed[k] {
                    failures += 1;
                    by_property[k + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {problem} ({p}, {q}), {arm_name(a)}: P{k + 1}");
                    }
                }
            }
        }
        // P5
        for a in 0..4 {
            checks += 1;
            let agree = answers.iter().filter(|x| x == answers[a]).count() - 1;
            if agree < 2 {
                failures += 1;
                by_property[5] += 1;
                if failures <= 10 {
                    println(f"problem {problem}, {arm_name(a)}: P5");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for k in 1..6 {
            if by_property[k] > 0 {
                counts.push(f"P{k}: {by_property[k]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over 4 arms: {failures} failures");
}
