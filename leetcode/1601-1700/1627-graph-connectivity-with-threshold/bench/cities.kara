// LeetCode #1627: Graph Connectivity With Threshold -- the bench: the ★
// arm on 100 problems of 10000 cities, thresholds 0 to 99, each asked the
// same 100000 queries, all drawn first.

fn find(parent: mut ref Vec[i32], x: i32) -> i32 {
    let mut root = x;
    while parent[root] != root {
        root = parent[root];
    }
    let mut x = x;
    while parent[x] != root {
        let next = parent[x];
        parent[x] = root;
        x = next;
    }
    root
}

fn are_connected(n: i32, threshold: i32, queries: Vec[Vec[i32]]) -> Vec[bool] {
    let mut parent: Vec[i32] = (0..=n).collect();
    for z in threshold + 1..=n {
        for m in (2 * z..=n).step_by(z) {
            let (a, b) = (find(mut parent, z), find(mut parent, m));
            if a != b {
                parent[b] = a;
            }
        }
    }
    queries.iter().map(|q| find(mut parent, q[0]) == find(mut parent, q[1])).collect()
}
fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1627;
    let n = 10000;
    let mut thresholds: Vec[i32] = Vec.new();
    for _ in 0..100 {
        thresholds.push((next_random(mut seed) % 100) as i32);
    }
    let mut queries: Vec[Vec[i32]] = Vec.new();
    for _ in 0..100000 {
        let a = next_random(mut seed) % n + 1;
        let b = next_random(mut seed) % n + 1;
        queries.push([a as i32, b as i32]);
    }
    let mut check = 0;
    let mut total = 0;
    for threshold in thresholds.iter() {
        let mut yes = 0;
        for answer in are_connected(n as i32, *threshold, queries).iter() {
            if *answer {
                yes += 1;
            }
        }
        total += yes;
        check = (check * 31 + yes + 1) % 1000000007;
    }
    println(f"100 problems of 10000 cities and 100000 queries: {total} connected, checksum {check}");
}
