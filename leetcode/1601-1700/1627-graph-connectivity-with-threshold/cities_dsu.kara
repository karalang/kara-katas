// LeetCode #1627: Graph Connectivity With Threshold -- a `struct Dsu`
// with its methods, the multiples joined as a chain.
//
// `find` halves the path as it climbs; `union` is by rank, the shorter
// tree hung under the taller. Each z above the threshold joins each of
// its multiples to the one before it, z to 2z, 2z to 3z and so on, which
// makes the same groups as joining them all to z. Only the z up to n / 2
// have a second multiple. O(n log n · α(n)).

struct Dsu {
    parent: Vec[i64],
    rank: Vec[i64],
}

impl Dsu {
    fn new(n: i64) -> Dsu {
        Dsu { parent: (0..n).collect(), rank: Vec.filled(n, 0) }
    }

    fn find(mut ref self, x: i64) -> i64 {
        let mut x = x;
        while self.parent[x] != x {
            self.parent[x] = self.parent[self.parent[x]];
            x = self.parent[x];
        }
        x
    }

    fn union(mut ref self, a: i64, b: i64) {
        let (a, b) = (self.find(a), self.find(b));
        if a == b {
            return;
        }
        if self.rank[a] < self.rank[b] {
            self.parent[a] = b;
        } else if self.rank[a] > self.rank[b] {
            self.parent[b] = a;
        } else {
            self.parent[b] = a;
            self.rank[a] += 1;
        }
    }

    fn connected(mut ref self, a: i64, b: i64) -> bool {
        self.find(a) == self.find(b)
    }
}

fn are_connected(n: i32, threshold: i32, queries: Vec[Vec[i32]]) -> Vec[bool] {
    let n = n as i64;
    let mut dsu = Dsu.new(n + 1);
    for z in threshold as i64 + 1..=n / 2 {
        let mut m = 2 * z;
        while m <= n {
            dsu.union(m - z, m);
            m += z;
        }
    }
    let mut answers: Vec[bool] = Vec.new();
    for q in queries.iter() {
        answers.push(dsu.connected(q[0], q[1]));
    }
    answers
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` random problems of up to `most` cities and `asks` queries, the
// threshold anywhere from 0 to n / 2 (above that nothing is joined); the
// connected answers counted, and a checksum over every answer
fn batch(count: i64, most: i64, asks: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut yes = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let threshold = next_random(mut seed) % (n / 2 + 1);
        let q = next_random(mut seed) % asks + 1;
        let mut queries: Vec[Vec[i32]] = Vec.new();
        for _ in 0..q {
            let a = next_random(mut seed) % n + 1;
            let b = next_random(mut seed) % n + 1;
            queries.push([a as i32, b as i32]);
        }
        for answer in are_connected(n as i32, threshold as i32, queries).iter() {
            if *answer {
                yes += 1;
            }
            check = mix(check, *answer as i64);
        }
    }
    println(f"{count} problems of up to {most} cities: {yes} queries connected, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one city asked about itself, and a
    // threshold of n, which joins nothing
    println(are_connected(6, 2, [[1, 4], [2, 5], [3, 6]]));
    println(are_connected(6, 0, [[4, 5], [3, 4], [3, 2], [2, 6], [1, 3]]));
    println(are_connected(5, 1, [[4, 5], [4, 5], [3, 2], [2, 3], [3, 4]]));
    println(are_connected(1, 0, [[1, 1]]));
    println(are_connected(8, 8, [[2, 4], [8, 8], [3, 6]]));
    let mut seed = 1627;
    batch(2000, 20, 10, mut seed);
    batch(200, 1000, 100, mut seed);
    batch(5, 10000, 10000, mut seed);
}
