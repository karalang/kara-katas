// LeetCode #1627: Graph Connectivity With Threshold -- the groups
// flooded, with no union-find.
//
// Every city gets a group label. An unlabelled city starts a group and a
// breadth-first flood from it: a city reaches each of its divisors above
// the threshold, found by trial division up to its square root, and each
// such divisor, the first time it is reached, reaches all its multiples.
// Each divisor is spent once, so the multiples walked total n log n.
// O(n sqrt n).

fn are_connected(n: i32, threshold: i32, queries: Vec[Vec[i32]]) -> Vec[bool] {
    let n = n as i64;
    let threshold = threshold as i64;
    let mut group: Vec[i64] = Vec.filled(n + 1, 0);
    let mut spent: Vec[bool] = Vec.filled(n + 1, false);
    let mut groups = 0;
    for start in 1..=n {
        if group[start] != 0 {
            continue;
        }
        groups += 1;
        group[start] = groups;
        let mut queue: VecDeque[i64] = VecDeque.new();
        queue.push_back(start);
        while let Some(city) = queue.pop_front() {
            let mut divisors: Vec[i64] = Vec.new();
            let mut d = 1;
            while d * d <= city {
                if city % d == 0 {
                    divisors.push(d);
                    divisors.push(city / d);
                }
                d += 1;
            }
            for z in divisors {
                if z <= threshold or spent[z] {
                    continue;
                }
                spent[z] = true;
                let mut m = z;
                while m <= n {
                    if group[m] == 0 {
                        group[m] = groups;
                        queue.push_back(m);
                    }
                    m += z;
                }
            }
        }
    }
    queries.iter().map(|q| group[q[0]] == group[q[1]]).collect()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` random problems of up to `most` cities and `asks` queries, the
// threshold anywhere from 0 to n / 2 (above that nothing is joined); the
// connected answers counted, and a checksum over every answer
fn batch(count: i64, most: i64, asks: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut yes = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let threshold = next_random(mut seed) % (n / 2 + 1);
        let q = next_random(mut seed) % asks + 1;
        let mut queries: Vec[Vec[i32]] = Vec.new();
        for _ in 0..q {
            let a = next_random(mut seed) % n + 1;
            let b = next_random(mut seed) % n + 1;
            queries.push([a as i32, b as i32]);
        }
        for answer in are_connected(n as i32, threshold as i32, queries).iter() {
            if *answer {
                yes += 1;
            }
            check = mix(check, *answer as i64);
        }
    }
    println(f"{count} problems of up to {most} cities: {yes} queries connected, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one city asked about itself, and a
    // threshold of n, which joins nothing
    println(are_connected(6, 2, [[1, 4], [2, 5], [3, 6]]));
    println(are_connected(6, 0, [[4, 5], [3, 4], [3, 2], [2, 6], [1, 3]]));
    println(are_connected(5, 1, [[4, 5], [4, 5], [3, 2], [2, 3], [3, 4]]));
    println(are_connected(1, 0, [[1, 1]]));
    println(are_connected(8, 8, [[2, 4], [8, 8], [3, 6]]));
    let mut seed = 1627;
    batch(2000, 20, 10, mut seed);
    batch(200, 1000, 100, mut seed);
    batch(5, 10000, 10000, mut seed);
}
