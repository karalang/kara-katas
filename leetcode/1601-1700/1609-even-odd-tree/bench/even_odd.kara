// LeetCode #1609: Even Odd Tree -- the bench: the ★ arm on 20 random
// even-odd trees of 100000 nodes, each checked as made and then with 20
// pairs of its values swapped in turn, all drawn first.
//
// The ★ arm: breadth first, a level at a time, each value checked for its
// parity and against the one before it on the level.

fn is_even_odd_tree(root: Option[TreeNode]) -> bool {
    let mut queue = VecDeque.new();
    if let Some(r) = root {
        queue.push_back(r);
    }
    let mut even = true;
    while not queue.is_empty() {
        let mut prev: Option[i32] = None;
        for _ in 0..queue.len() {
            let node = queue.pop_front().unwrap();
            let v = node.val;
            let ok = if even {
                v % 2 == 1 and prev.is_none_or(|p| v > p)
            } else {
                v % 2 == 0 and prev.is_none_or(|p| v < p)
            };
            if not ok {
                return false;
            }
            prev = Some(v);
            if let Some(l) = node.left {
                queue.push_back(l);
            }
            if let Some(r) = node.right {
                queue.push_back(r);
            }
        }
        even = not even;
    }
    true
}

// ---- the harness

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i32) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// a tree of `n` nodes, each hung on a random free child slot of the
// nodes before it, its values even-odd; every node, in the order they
// were made
fn random_tree(n: i64, seed: mut ref i64) -> Vec[TreeNode] {
    let mut nodes = [leaf(0)];
    let mut free = [(nodes[0], true), (nodes[0], false)];
    for _ in 1..n {
        let k = (next_random(mut seed) * 32768 + next_random(mut seed)) % free.len();
        let (parent, left) = free.swap_remove(k);
        let child = leaf(0);
        if left {
            parent.left = Some(child);
        } else {
            parent.right = Some(child);
        }
        free.push((child, true));
        free.push((child, false));
        nodes.push(child);
    }
    let mut level = [nodes[0]];
    let mut depth = 0;
    while not level.is_empty() {
        let mut v: i32 = if depth % 2 == 0 { 1 + 2 * (next_random(mut seed) % 5) as i32 } else { 1000000 - 2 * (next_random(mut seed) % 5) as i32 };
        let mut below = Vec.new();
        for node in level.iter() {
            node.val = v;
            let step = 2 * (next_random(mut seed) % 2 + 1) as i32;
            v = if depth % 2 == 0 { v + step } else { v - step };
            if let Some(l) = node.left {
                below.push(l);
            }
            if let Some(r) = node.right {
                below.push(r);
            }
        }
        level = below;
        depth += 1;
    }
    nodes
}

fn swap_values(a: TreeNode, b: TreeNode) {
    let t = a.val;
    a.val = b.val;
    b.val = t;
}

fn main() {
    let mut seed = 1609;
    let mut trees: Vec[Vec[TreeNode]] = Vec.new();
    let mut picks: Vec[Vec[(i64, i64)]] = Vec.new();
    for _ in 0..20 {
        trees.push(random_tree(100000, mut seed));
        let mut pairs = [(0, 0)];
        for _ in 0..20 {
            let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000;
            let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000;
            pairs.push((a, b));
        }
        picks.push(pairs);
    }
    let mut check = 0;
    let mut checks = 0;
    let mut even_odd = 0;
    for (tree, pairs) in trees.iter().zip(picks.iter()) {
        for (a, b) in pairs.iter() {
            swap_values(tree[a], tree[b]);
            let yes = is_even_odd_tree(Some(tree[0]));
            swap_values(tree[a], tree[b]);
            if yes {
                even_odd += 1;
            }
            check = mix(check, if yes { 1 } else { 0 });
            checks += 1;
        }
    }
    println(f"20 trees of 100000 nodes: {checks} checks, {even_odd} even-odd, checksum {check}");
}
