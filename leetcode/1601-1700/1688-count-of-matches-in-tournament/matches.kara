// LeetCode #1688: Count of Matches in Tournament -- the ★ arm: the rounds
// played out.
//
// Each round plays n / 2 matches; the winners and, when n is odd, the team
// that sat out go on, (n + 1) / 2 of them. O(log n).

fn matches(n: i32) -> i32 {
    let mut teams = n;
    let mut played: i32 = 0;
    while teams > 1 {
        played += teams / 2;
        teams = (teams + 1) / 2;
    }
    played
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, one team, and the most teams
    println(matches(7));
    println(matches(14));
    println(matches(1));
    println(matches(200));
    // every n LeetCode allows, then random n up to 10^9
    let mut total = 0;
    let mut check = 0;
    for n in 1..=200 {
        let answer = matches(n);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"n from 1 to 200: {total} matches, checksum {check}");
    let mut seed = 1688;
    total = 0;
    check = 0;
    for _ in 0..3000 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1;
        let answer = matches(n as i32);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"3000 n up to 1000000000: {total} matches, checksum {check}");
}
