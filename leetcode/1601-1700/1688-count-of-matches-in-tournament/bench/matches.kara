// LeetCode #1688: Count of Matches in Tournament -- the bench: the ★ arm on
// 500000 random n up to 10^9, all drawn first, each answered 40 times.
//
// Each round plays n / 2 matches; the winners and, when n is odd, the team
// that sat out go on, (n + 1) / 2 of them. O(log n).

fn matches(n: i32) -> i32 {
    let mut teams = n;
    let mut played: i32 = 0;
    while teams > 1 {
        played += teams / 2;
        teams = (teams + 1) / 2;
    }
    played
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 500000;
    let rounds = 40;
    let mut seed = 1688;
    let mut values: Vec[i32] = Vec.new();
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1;
        values.push(n as i32);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for n in values.iter() {
            let answer = matches(n);
            total += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} values of n, {rounds} rounds: {total} matches, checksum {check}");
}
