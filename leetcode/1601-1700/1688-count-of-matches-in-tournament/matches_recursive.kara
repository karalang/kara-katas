// LeetCode #1688: Count of Matches in Tournament -- one round, then the
// rest of the tournament.
//
// A round of n teams plays n / 2 matches and leaves n - n / 2 teams, whose
// tournament is the same question again; one team plays none. O(log n)
// calls.

fn matches(n: i32) -> i32 {
    if n == 1 {
        return 0;
    }
    n / 2 + matches(n - n / 2)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, one team, and the most teams
    println(matches(7));
    println(matches(14));
    println(matches(1));
    println(matches(200));
    // every n LeetCode allows, then random n up to 10^9
    let mut total = 0;
    let mut check = 0;
    for n in 1..=200 {
        let answer = matches(n);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"n from 1 to 200: {total} matches, checksum {check}");
    let mut seed = 1688;
    total = 0;
    check = 0;
    for _ in 0..3000 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1;
        let answer = matches(n as i32);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"3000 n up to 1000000000: {total} matches, checksum {check}");
}
