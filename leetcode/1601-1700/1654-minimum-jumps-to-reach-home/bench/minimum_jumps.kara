// LeetCode #1654: Minimum Jumps to Reach Home -- the bench: the ★ arm on
// 5000 random problems with a, b and x up to 2000 and up to 1000
// forbidden positions, all drawn first.

fn minimum_jumps(forbidden: Vec[i32], a: i32, b: i32, x: i32) -> i32 {
    let a = a as i64;
    let b = b as i64;
    let x = x as i64;
    let furthest = forbidden.iter().max().unwrap_or(0) as i64;
    let limit = max(x, furthest) + a + b;
    let mut blocked = Vec.filled(limit + 1, false);
    for f in forbidden.iter() {
        blocked[f] = true;
    }
    // seen[p][1]: p reached with a backward jump last
    let mut seen = Vec.filled(limit + 1, [false, false]);
    let mut queue = VecDeque.new();
    queue.push_back((0, false, 0));
    seen[0][0] = true;
    while let Some((p, back, jumps)) = queue.pop_front() {
        if p == x {
            return jumps;
        }
        let forward = p + a;
        if forward <= limit and not blocked[forward] and not seen[forward][0] {
            seen[forward][0] = true;
            queue.push_back((forward, false, jumps + 1));
        }
        let backward = p - b;
        if not back and backward >= 0 and not blocked[backward] and not seen[backward][1] {
            seen[backward][1] = true;
            queue.push_back((backward, true, jumps + 1));
        }
    }
    -1
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1654;
    let mut problems: Vec[(Vec[i32], i32, i32, i32)] = Vec.new();
    for _ in 0..5000 {
        let a = (next_random(mut seed) % 2000 + 1) as i32;
        let b = (next_random(mut seed) % 2000 + 1) as i32;
        let x = (next_random(mut seed) % 2001) as i32;
        let m = next_random(mut seed) % 1001;
        let mut taken = Vec.filled(2001, false);
        let mut forbidden: Vec[i32] = Vec.new();
        for _ in 0..m {
            let f = (next_random(mut seed) % 2000 + 1) as i32;
            if f != x and not taken[f] {
                taken[f] = true;
                forbidden.push(f);
            }
        }
        problems.push((forbidden, a, b, x));
    }
    let mut check = 0;
    let mut total = 0;
    let mut unreachable = 0;
    for (forbidden, a, b, x) in problems.iter() {
        let answer = minimum_jumps(forbidden, a, b, x);
        if answer < 0 {
            unreachable += 1;
        }
        total += answer;
        check = (check * 31 + answer + 2) % 1000000007;
    }
    println(f"5000 problems up to 2000: jumps sum to {total}, {unreachable} unreachable, checksum {check}");
}
