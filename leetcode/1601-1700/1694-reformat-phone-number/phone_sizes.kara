// LeetCode #1694: Reformat Phone Number -- the block sizes from the count.
//
// With d digits the blocks are all threes when d % 3 is 0, threes and a
// last two when it is 2, and threes and two last twos when it is 1 (a
// lone digit is never left). The sizes are listed first, then the digits
// cut by them. O(n).

fn reformat_number(number: Str) -> String {
    let digits: Vec[u8] = number.bytes().iter().filter(|b| b.is_ascii_digit()).collect();
    let d = digits.len();
    let mut sizes: Vec[i64] = match d % 3 {
        0 => Vec.filled(d / 3, 3),
        1 => Vec.filled((d - 4) / 3, 3),
        _ => Vec.filled(d / 3, 3),
    };
    match d % 3 {
        1 => sizes.extend([2, 2]),
        2 => sizes.push(2),
        _ => {}
    }
    let mut out = String.new();
    let mut at = 0;
    for (i, size) in sizes.iter().enumerate() {
        if i > 0 {
            out.push('-');
        }
        for b in digits[at..at + size].iter() {
            out.push(b as char);
        }
        at += size;
    }
    out
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random numbers of 2 to `most` characters, each a digit, a space
// or a dash, at least two of them digits; the dashes in the answers
// summed, and a checksum of every answer's bytes
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let alphabet = "0123456789 -";
    let mut dashes = 0;
    let mut check = 0;
    for _ in 0..count {
        let length = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most - 1) + 2;
        let mut number = String.new();
        // two digits somewhere, the rest drawn from all twelve
        let first = next_random(mut seed) % length;
        let second = (first + 1 + next_random(mut seed) % (length - 1)) % length;
        for i in 0..length {
            let pick = if i == first or i == second { next_random(mut seed) % 10 } else { next_random(mut seed) % 12 };
            number.push_str(alphabet.substring(pick, pick + 1));
        }
        let answer = reformat_number(number);
        for b in answer.bytes().iter() {
            if b == b'-' {
                dashes += 1;
            }
            check = (check * 31 + b) % 1000000007;
        }
    }
    println(f"{count} numbers of up to {most} characters: {dashes} dashes, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then two digits, four, five, and seven
    // among spaces and dashes
    println(reformat_number("1-23-45 6"));
    println(reformat_number("123 4-567"));
    println(reformat_number("123 4-5678"));
    println(reformat_number("12"));
    println(reformat_number("1234"));
    println(reformat_number("12345"));
    println(reformat_number("--1 2 3 - 4 5 6 7--"));
    let mut seed = 1694;
    batch(3000, 12, mut seed);
    batch(300, 100, mut seed);
    batch(10, 100000, mut seed);
}
