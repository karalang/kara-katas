// LeetCode #1636: Sort Array by Increasing Frequency -- counting, no
// comparison sort.
//
// The values lie in -100..=100, so a fixed array of 201 counters holds
// every count. Then, for each count from 1 up, the values with that count
// are written out from the largest down, each as many times as it
// occurs. O(n + 201m) for a largest count m.

fn frequency_sort(nums: Vec[i32]) -> Vec[i32] {
    let mut count: Array[i64, 201] = [0; 201];
    for x in nums.iter() {
        count[x + 100] += 1;
    }
    let most = count.iter().max().unwrap();
    let mut sorted: Vec[i32] = Vec.new();
    for times in 1..=most {
        for slot in (0..201).rev() {
            if count[slot] == times {
                for _ in 0..times {
                    sorted.push(slot as i32 - 100);
                }
            }
        }
    }
    sorted
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random arrays of 1 to `most` values from -`spread` to `spread`,
// each sorted; a checksum over every value in its new place
fn batch(count: i64, most: i64, spread: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) % (2 * spread + 1) - spread) as i32);
        }
        for x in frequency_sort(nums) {
            check = (check * 31 + x + 1000) % 1000000007;
        }
    }
    println(f"{count} arrays of up to {most} values: checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, every value once, and
    // every value the same
    println(frequency_sort([1, 1, 2, 2, 2, 3]));
    println(frequency_sort([2, 3, 1, 3, 2]));
    println(frequency_sort([-1, 1, -6, 4, 5, -6, 1, 4, 1]));
    println(frequency_sort([7]));
    println(frequency_sort([4, -2, 9, 0]));
    println(frequency_sort([5, 5, 5]));
    let mut seed = 1636;
    batch(3000, 8, 3, mut seed);
    batch(300, 100, 100, mut seed);
    batch(5, 100000, 100, mut seed);
}
