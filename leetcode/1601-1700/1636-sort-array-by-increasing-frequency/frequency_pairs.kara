// LeetCode #1636: Sort Array by Increasing Frequency -- the distinct
// values sorted, then written out.
//
// Only the distinct values need sorting: count them in a `Map`, turn the
// counts into `(count, value)` pairs (the map's walk order does not
// matter, since the sort fixes it), sort those with a comparator, count
// first and then the value the other way round, and write each value out
// as many times as it occurs.
// O(n + d log d) for d distinct values.

fn frequency_sort(nums: Vec[i32]) -> Vec[i32] {
    let mut count: Map[i32, i64] = Map.new();
    for x in nums.iter() {
        *count.entry(x).or_insert(0) += 1;
    }
    let mut pairs: Vec[(i64, i32)] = count.iter().map(|(value, times)| (times, value)).collect();
    pairs.sort_by(|a, b| a.0.cmp(b.0).then(b.1.cmp(a.1)));
    let mut sorted: Vec[i32] = Vec.new();
    for (times, value) in pairs.iter() {
        for _ in 0..times {
            sorted.push(value);
        }
    }
    sorted
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random arrays of 1 to `most` values from -`spread` to `spread`,
// each sorted; a checksum over every value in its new place
fn batch(count: i64, most: i64, spread: i64, seed: mut ref i64) {
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) % (2 * spread + 1) - spread) as i32);
        }
        for x in frequency_sort(nums) {
            check = (check * 31 + x + 1000) % 1000000007;
        }
    }
    println(f"{count} arrays of up to {most} values: checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one value, every value once, and
    // every value the same
    println(frequency_sort([1, 1, 2, 2, 2, 3]));
    println(frequency_sort([2, 3, 1, 3, 2]));
    println(frequency_sort([-1, 1, -6, 4, 5, -6, 1, 4, 1]));
    println(frequency_sort([7]));
    println(frequency_sort([4, -2, 9, 0]));
    println(frequency_sort([5, 5, 5]));
    let mut seed = 1636;
    batch(3000, 8, 3, mut seed);
    batch(300, 100, 100, mut seed);
    batch(5, 100000, 100, mut seed);
}
