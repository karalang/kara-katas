// LeetCode #1624: Largest Substring Between Two Equal Characters -- the
// ★ arm.
//
// One pass: the first index of each letter, and at every later sight of
// it the gap back to that first index. The first sight gives the longest
// gap for every later one. O(n).

fn max_length_between_equal_characters(s: String) -> i32 {
    let mut first = [-1; 26];
    let mut best = -1;
    for (i, c) in s.chars().enumerate() {
        let letter = c as i64 - 'a' as i64;
        if first[letter] == -1 {
            first[letter] = i;
        } else {
            best = max(best, i - first[letter] - 1);
        }
    }
    best as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// `count` strings of 1 to `longest` letters from the first `letters` of
// the alphabet; how many have no repeated letter, and a checksum
fn batch(count: i64, longest: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut none = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % longest + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        let got = max_length_between_equal_characters(s);
        if got == -1 {
            none += 1;
        }
        check = mix(check, got);
    }
    println(f"{count} strings of up to {longest} letters from {letters}: {none} with no pair, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one letter alone, the alphabet with
    // its first letter again, and a letter at both ends of 300
    for s in ["aa", "abca", "cbzxy", "a", "abcdefghijklmnopqrstuvwxyza"] {
        println(max_length_between_equal_characters(s));
    }
    let mut long = "q";
    for _ in 0..298 {
        long.push('z');
    }
    long.push('q');
    println(max_length_between_equal_characters(long));
    let mut seed = 1624;
    batch(3000, 8, 3, mut seed);
    batch(3000, 30, 26, mut seed);
    batch(300, 300, 26, mut seed);
}
