// LeetCode #1624: Largest Substring Between Two Equal Characters -- the
// bench, on the ★ arm: one pass, the first index of each letter, and at
// every later sight the gap back to it.
//
// Build once, then punch: 100000 random strings of 1 to 300 letters, all
// drawn first, then each one's answer.

fn max_length_between_equal_characters(s: String) -> i32 {
    let mut first = [-1; 26];
    let mut best = -1;
    for (i, c) in s.chars().enumerate() {
        let letter = c as i64 - 'a' as i64;
        if first[letter] == -1 {
            first[letter] = i;
        } else {
            best = max(best, i - first[letter] - 1);
        }
    }
    best as i32
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1624;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..100000 {
        let n = next_random(mut seed) % 300 + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push((b'a' + (next_random(mut seed) % 26) as u8) as char);
        }
        strings.push(s);
    }
    let mut check = 0;
    let mut total = 0;
    for s in strings.iter() {
        let got = max_length_between_equal_characters(s);
        total += got;
        check = mix(check, got);
    }
    println(f"100000 random strings: answers sum to {total}, checksum {check}");
}
