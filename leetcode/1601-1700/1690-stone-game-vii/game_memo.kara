// LeetCode #1690: Stone Game VII -- the game searched from the whole row,
// each stretch remembered.
//
// The same recurrence as the ★ arm, from best(0, n - 1) down by recursion;
// a table of `Option[i32]` keeps each stretch's answer, so each is worked
// out once. The sums of the stretches are carried down rather than taken
// from prefix sums. O(n^2).

fn best(i: i64, j: i64, total: i32, stones: Vec[i32], memo: mut ref Vec[Vec[Option[i32]]]) -> i32 {
    if i == j {
        return 0;
    }
    if let Some(known) = memo[i][j] {
        return known;
    }
    let take_left = total - stones[i] - best(i + 1, j, total - stones[i], stones, mut memo);
    let take_right = total - stones[j] - best(i, j - 1, total - stones[j], stones, mut memo);
    let answer = max(take_left, take_right);
    memo[i][j] = Some(answer);
    answer
}

fn stone_game(stones: Vec[i32]) -> i32 {
    let n = stones.len();
    let mut memo = Vec.filled(n, Vec.filled(n, None));
    let total = stones.iter().sum();
    best(0, n - 1, total, stones, mut memo)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random rows of 2 to `most` stones from 1 to `top`; the answers
// summed, and a checksum of them
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (most - 1) + 2;
        let mut stones: Vec[i32] = Vec.new();
        for _ in 0..n {
            stones.push((next_random(mut seed) % top + 1) as i32);
        }
        let answer = stone_game(stones);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} rows of up to {most} stones up to {top}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, two stones alike, and two far apart
    println(stone_game([5, 3, 1, 4, 2]));
    println(stone_game([7, 90, 5, 1, 100, 10, 10, 2]));
    println(stone_game([1, 1]));
    println(stone_game([1000, 1]));
    let mut seed = 1690;
    batch(3000, 10, 10, mut seed);
    batch(300, 100, 1000, mut seed);
    batch(30, 1000, 1000, mut seed);
}
