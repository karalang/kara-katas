// LeetCode #1690: Stone Game VII -- the bench: the ★ arm on 40 random rows
// of 1000 stones, all drawn first, each answered 4 times.
//
// best(i, j) is the most the player to move can lead by on stones i..=j:
// taking the left stone scores the sum of i + 1..=j and leaves the other
// best(i + 1, j); taking the right one scores i..=j - 1 and leaves
// best(i, j - 1). Prefix sums give each sum at once. Going i from the
// right end down, one vector holds row i + 1 until each entry is
// overwritten with row i. O(n^2) time, O(n) space.

fn stone_game(stones: Vec[i32]) -> i32 {
    let n = stones.len();
    let mut prefix = Vec.filled(n + 1, 0i32);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + stones[i];
    }
    let mut best = Vec.filled(n, 0i32);
    for i in (0..n).rev() {
        for j in i + 1..n {
            let take_left = prefix[j + 1] - prefix[i + 1] - best[j];
            let take_right = prefix[j] - prefix[i] - best[j - 1];
            best[j] = max(take_left, take_right);
        }
    }
    best[n - 1]
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 40;
    let size = 1000;
    let rounds = 4;
    let mut seed = 1690;
    let mut rows: Vec[Vec[i32]] = Vec.new();
    for _ in 0..count {
        let mut stones: Vec[i32] = Vec.new();
        for _ in 0..size {
            stones.push((next_random(mut seed) % 1000 + 1) as i32);
        }
        rows.push(stones);
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for stones in rows.iter() {
            let answer = stone_game(stones);
            total += answer;
            check = (check * 31 + answer + r) % 1000000007;
        }
    }
    println(f"{count} rows of {size} stones, {rounds} rounds: answers sum to {total}, checksum {check}");
}
