// LeetCode #1690: Stone Game VII -- the ★ arm: one row of the table at a
// time.
//
// best(i, j) is the most the player to move can lead by on stones i..=j:
// taking the left stone scores the sum of i + 1..=j and leaves the other
// best(i + 1, j); taking the right one scores i..=j - 1 and leaves
// best(i, j - 1). Prefix sums give each sum at once. Going i from the
// right end down, one vector holds row i + 1 until each entry is
// overwritten with row i. O(n^2) time, O(n) space.

fn stone_game(stones: Vec[i32]) -> i32 {
    let n = stones.len();
    let mut prefix = Vec.filled(n + 1, 0i32);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + stones[i];
    }
    let mut best = Vec.filled(n, 0i32);
    for i in (0..n).rev() {
        for j in i + 1..n {
            let take_left = prefix[j + 1] - prefix[i + 1] - best[j];
            let take_right = prefix[j] - prefix[i] - best[j - 1];
            best[j] = max(take_left, take_right);
        }
    }
    best[n - 1]
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random rows of 2 to `most` stones from 1 to `top`; the answers
// summed, and a checksum of them
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % (most - 1) + 2;
        let mut stones: Vec[i32] = Vec.new();
        for _ in 0..n {
            stones.push((next_random(mut seed) % top + 1) as i32);
        }
        let answer = stone_game(stones);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} rows of up to {most} stones up to {top}: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, two stones alike, and two far apart
    println(stone_game([5, 3, 1, 4, 2]));
    println(stone_game([7, 90, 5, 1, 100, 10, 10, 2]));
    println(stone_game([1, 1]));
    println(stone_game([1000, 1]));
    let mut seed = 1690;
    batch(3000, 10, 10, mut seed);
    batch(300, 100, 1000, mut seed);
    batch(30, 1000, 1000, mut seed);
}
