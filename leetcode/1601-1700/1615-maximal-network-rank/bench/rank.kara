// LeetCode #1615: Maximal Network Rank -- the bench: the ★ arm on 2000
// networks of 100 cities, each pair of cities joined by a road with a
// chance of a quarter, all drawn first.
//
// The ★ arm: each city's degree and a table of which pairs share a road,
// then every pair's rank.

fn maximal_network_rank(n: i32, roads: Slice[Vec[i32]]) -> i32 {
    let mut degree = Vec.filled(n, 0);
    let mut joined = Vec.filled(n, Vec.filled(n, false));
    for road in roads.iter() {
        let (a, b) = (road[0], road[1]);
        degree[a] += 1;
        degree[b] += 1;
        joined[a][b] = true;
        joined[b][a] = true;
    }
    let mut best: i32 = 0;
    for a in 0..n {
        for b in a + 1..n {
            let rank = degree[a] + degree[b] - if joined[a][b] { 1 } else { 0 };
            best = max(best, rank);
        }
    }
    best
}

// ---- the harness

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    let mut seed = 1615;
    // `let n = 100` is refused as `i64` at the call below, though the
    // argument should fix it: its use as a `for` range's end settles it
    // first (B-2026-11-18-13); `karac fix` typed it
    let n: i32 = 100;
    let mut networks: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..2000 {
        let mut roads: Vec[Vec[i32]] = Vec.new();
        for a in 0..n {
            for b in a + 1..n {
                if next_random(mut seed) % 4 == 0 {
                    roads.push([a, b]);
                }
            }
        }
        networks.push(roads);
    }
    let mut check = 0;
    let mut roads_seen = 0;
    for roads in networks.iter() {
        check = mix(check, maximal_network_rank(n, roads));
        roads_seen += roads.len();
    }
    println(f"2000 networks of 100 cities: {roads_seen} roads, checksum {check}");
}
