// LeetCode #1615: Maximal Network Rank -- the differential.
//
// Four arms against the statement read literally, on 3000 networks of 2
// to 7 cities with any number of distinct roads, with six properties.
// Every random choice is drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the cities numbered backwards leave the answer
// P3  the roads listed backwards, each turned round, leave the answer
// P4  one more city, with no road, leaves the answer
// P5  the answer is the two highest degrees added, or one less
// P6  each arm agrees with at least two of the other three

// ---- rank.kara: the ★ arm: degrees and a table of joined pairs

fn star_arm(n: i32, roads: Slice[Vec[i32]]) -> i32 {
    let mut degree = Vec.filled(n, 0);
    let mut joined = Vec.filled(n, Vec.filled(n, false));
    for road in roads.iter() {
        let (a, b) = (road[0], road[1]);
        degree[a] += 1;
        degree[b] += 1;
        joined[a][b] = true;
        joined[b][a] = true;
    }
    let mut best: i32 = 0;
    for a in 0..n {
        for b in a + 1..n {
            let rank = degree[a] + degree[b] - if joined[a][b] { 1 } else { 0 };
            best = max(best, rank);
        }
    }
    best
}

// ---- rank_top.kara: only the cities of the top two degrees

fn top_arm(n: i32, roads: Slice[Vec[i32]]) -> i32 {
    let mut degree: Vec[i32] = Vec.filled(n, 0);
    let mut joined: Set[(i32, i32)] = Set.new();
    for road in roads.iter() {
        degree[road[0]] += 1;
        degree[road[1]] += 1;
        joined.insert((min(road[0], road[1]), max(road[0], road[1])));
    }
    let linked = |a: i32, b: i32| joined.contains((min(a, b), max(a, b)));
    let top = *degree.iter().max().unwrap();
    let firsts: Vec[i32] = (0..n).filter(|c| degree[c] == top).collect();
    if firsts.len() > 1 {
        for i in 0..firsts.len() {
            for j in i + 1..firsts.len() {
                if not linked(firsts[i], firsts[j]) {
                    return 2 * top;
                }
            }
        }
        return 2 * top - 1;
    }
    let first = firsts[0];
    let second = (0..n).filter(|c| degree[c] < top).map(|c| degree[c]).max().unwrap_or(0);
    let seconds: Vec[i32] = (0..n).filter(|c| degree[c] == second and c != first).collect();
    if seconds.iter().any(|c| not linked(first, *c)) {
        top + second
    } else {
        top + second - 1
    }
}

// ---- rank_pairs.kara: every pair counted afresh from the list

fn pairs_arm(n: i32, roads: Slice[Vec[i32]]) -> i32 {
    (0..n)
        .flat_map(|a| (a + 1..n).map(|b| (a, b)))
        .map(|(a, b)| roads.iter().filter(|r| r[0] == a or r[1] == a or r[0] == b or r[1] == b).count() as i32)
        .max()
        .unwrap_or(0)
}

// ---- rank_solution.kara: LeetCode's Rust template as karac fix left it

struct SolutionArm {}

impl SolutionArm {
    pub fn maximal_network_rank(n: i32, roads: Vec[Vec[i32]]) -> i32 {
        let n = n as i64;
        let mut deg = Vec.filled(n, 0i32);
        let mut adj = Vec.filled(n, Vec.filled(n, false));
        for r in roads.iter() {
            let (a, b) = (r[0] as i64, r[1] as i64);
            deg[a] += 1;
            deg[b] += 1;
            adj[a][b] = true;
            adj[b][a] = true;
        }
        let mut ans: i32 = 0;
        for i in 0..n {
            for j in i + 1..n {
                ans = ans.max(deg[i] + deg[j] - adj[i][j] as i32);
            }
        }
        ans
    }
}

fn solution_arm(n: i32, roads: Slice[Vec[i32]]) -> i32 {
    SolutionArm.maximal_network_rank(n, roads.to_vec())
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn arm(a: i64, n: i32, roads: Slice[Vec[i32]]) -> i32 {
    match a {
        0 => star_arm(n, roads),
        1 => top_arm(n, roads),
        2 => pairs_arm(n, roads),
        _ => solution_arm(n, roads),
    }
}

fn arm_name(a: i64) -> String {
    ["rank", "top", "pairs", "solution"][a].to_string()
}

// ---- the statement read literally: for each pair of different cities,
// the set of roads directly connected to either city, counted once each;
// the largest such count

fn literal(n: i32, roads: Slice[Vec[i32]]) -> i32 {
    let mut best = 0;
    for a in 0..n {
        for b in 0..n {
            if a != b {
                let mut touching: Set[i64] = Set.new();
                for (i, r) in roads.iter().enumerate() {
                    if r.contains(a) or r.contains(b) {
                        touching.insert(i);
                    }
                }
                best = max(best, touching.len());
            }
        }
    }
    best as i32
}

fn main() {
    let arms = 4;
    let problems = 3000;
    let mut seed = 16150;
    let mut cases: Vec[(i32, Vec[Vec[i32]])] = Vec.new();
    for _ in 0..problems {
        let n = next_random(mut seed) % 6 + 2;
        let wanted = next_random(mut seed) % (n * (n - 1) / 2 + 1);
        let mut taken: Set[(i64, i64)] = Set.new();
        let mut roads: Vec[Vec[i32]] = Vec.new();
        while roads.len() < wanted {
            let a = next_random(mut seed) % n;
            let b = next_random(mut seed) % n;
            if a != b and taken.insert((min(a, b), max(a, b))) {
                roads.push([a as i32, b as i32]);
            }
        }
        cases.push((n as i32, roads));
    }
    let mut check = 0;
    let mut checks = 0;
    let mut failures = 0;
    let mut by_property = [0, 0, 0, 0, 0, 0, 0];
    for (p, (n, roads)) in cases.iter().enumerate() {
        let n = n;
        let relabelled: Vec[Vec[i32]] = roads.iter().map(|r| [n - 1 - r[0], n - 1 - r[1]]).collect();
        let turned: Vec[Vec[i32]] = roads.iter().rev().map(|r| [r[1], r[0]]).collect();
        let mut degree = Vec.filled(n, 0);
        for r in roads.iter() {
            degree[r[0]] += 1;
            degree[r[1]] += 1;
        }
        degree.sort_by(|a, b| b.cmp(a));
        let top_two = degree[0] + degree[1];
        let mut answers = Vec.new();
        for a in 0..arms {
            let x = arm(a, n, roads);
            check = (check * 31 + x + 1) % 1000000007;
            let failed = [
                x != literal(n, roads),
                arm(a, n, relabelled) != x,
                arm(a, n, turned) != x,
                arm(a, n + 1, roads) != x,
                x > top_two or x < top_two - 1,
            ];
            answers.push(x);
            for q in 0..5 {
                checks += 1;
                if failed[q] {
                    failures += 1;
                    by_property[q + 1] += 1;
                    if failures <= 10 {
                        println(f"problem {p}, {arm_name(a)}: P{q + 1}");
                    }
                }
            }
        }
        for a in 0..arms {
            let mut agree = 0;
            for other in 0..arms {
                if other != a and answers[other] == answers[a] {
                    agree += 1;
                }
            }
            checks += 1;
            if agree < 2 {
                failures += 1;
                by_property[6] += 1;
                if failures <= 10 {
                    println(f"problem {p}, {arm_name(a)}: P6");
                }
            }
        }
    }
    if failures > 0 {
        let mut counts = Vec.new();
        for q in 1..7 {
            if by_property[q] > 0 {
                counts.push(f"P{q}: {by_property[q]}");
            }
        }
        println(counts.join(" "));
    }
    println(f"{problems} problems: checksum {check}, {checks} checks over {arms} arms: {failures} failures");
}
