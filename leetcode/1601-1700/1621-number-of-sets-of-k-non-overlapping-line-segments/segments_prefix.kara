// LeetCode #1621: Number of Sets of K Non-Overlapping Line Segments --
// counting with prefix sums.
//
// `ways[j][i]`: the sets of j segments on points 0..=i. Point i is the
// right end of no segment (`ways[j][i - 1]`), or of a segment starting at
// some point s < i, after j - 1 segments on 0..=s: the sum of
// `ways[j - 1][s]` over s < i, kept as a running prefix sum per j.
// O(n k).

const MOD: i64 = 1000000007;

fn number_of_sets(n: i32, k: i32) -> i32 {
    let (n, k) = (n as i64, k as i64);
    // the row for no segments: one way, whatever the points
    let mut prev: Vec[i64] = Vec.filled(n, 1);
    for _ in 1..=k {
        let mut row: Vec[i64] = Vec.filled(n, 0);
        let mut starts = 0;
        for i in 1..n {
            starts = (starts + prev[i - 1]) % MOD;
            row[i] = (row[i - 1] + starts) % MOD;
        }
        prev = row;
    }
    prev[n - 1] as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    // LeetCode's three examples, then the smallest case and two at the
    // ends of the range of k
    println(number_of_sets(4, 2));
    println(number_of_sets(3, 1));
    println(number_of_sets(30, 7));
    println(number_of_sets(2, 1));
    println(number_of_sets(1000, 1));
    println(number_of_sets(1000, 999));
    // every pair up to 40 points
    let mut check = 0;
    let mut pairs = 0;
    for n in 2..=40 {
        for k in 1..n {
            check = mix(check, number_of_sets(n, k));
            pairs += 1;
        }
    }
    println(f"all {pairs} pairs up to 40 points: checksum {check}");
    // random pairs up to 1000 points
    let mut seed = 1621;
    let mut check = 0;
    for _ in 0..30 {
        let n = (next_random(mut seed) % 999 + 2) as i32;
        let k = (next_random(mut seed) % (n as i64 - 1) + 1) as i32;
        check = mix(check, number_of_sets(n, k));
    }
    println(f"30 random pairs up to 1000 points: checksum {check}");
}
