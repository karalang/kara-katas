// LeetCode #1621: Number of Sets of K Non-Overlapping Line Segments -- the
// ★ arm.
//
// Stretch each segment's end by one point, so that segments that share
// an end no longer touch: n points with k segments become n + k - 1
// points with 2k distinct ends chosen in order. The answer is
// C(n + k - 1, 2k) mod 10^9 + 7, by factorials and Fermat's inverse.
// O(n + k + log p).

const MOD: i64 = 1000000007;

fn power(base: i64, exp: i64) -> i64 {
    let mut (result, b, e) = (1, base % MOD, exp);
    while e > 0 {
        if e & 1 == 1 {
            result = result * b % MOD;
        }
        b = b * b % MOD;
        e >>= 1;
    }
    result
}

fn number_of_sets(n: i32, k: i32) -> i32 {
    let top = (n + k - 1) as i64;
    let pick = 2 * k as i64;
    let mut fact = Vec.filled(top + 1, 1);
    for i in 1..=top {
        fact[i] = fact[i - 1] * i % MOD;
    }
    let below = fact[pick] * fact[top - pick] % MOD;
    (fact[top] * power(below, MOD - 2) % MOD) as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

fn main() {
    // LeetCode's three examples, then the smallest case and two at the
    // ends of the range of k
    println(number_of_sets(4, 2));
    println(number_of_sets(3, 1));
    println(number_of_sets(30, 7));
    println(number_of_sets(2, 1));
    println(number_of_sets(1000, 1));
    println(number_of_sets(1000, 999));
    // every pair up to 40 points
    let mut check = 0;
    let mut pairs = 0;
    for n in 2..=40 {
        for k in 1..n {
            check = mix(check, number_of_sets(n, k));
            pairs += 1;
        }
    }
    println(f"all {pairs} pairs up to 40 points: checksum {check}");
    // random pairs up to 1000 points
    let mut seed = 1621;
    let mut check = 0;
    for _ in 0..30 {
        let n = (next_random(mut seed) % 999 + 2) as i32;
        let k = (next_random(mut seed) % (n as i64 - 1) + 1) as i32;
        check = mix(check, number_of_sets(n, k));
    }
    println(f"30 random pairs up to 1000 points: checksum {check}");
}
