// LeetCode #1649: Create Sorted Array through Instructions -- the array
// itself.
//
// Keep `nums` sorted as the statement does. Two binary searches by
// `partition_point` find where the values less than the new one end and
// where those greater begin; the new value goes in between. O(n^2) moves
// in the worst case, but each is one block copy.

fn create_sorted_array(instructions: Vec[i32]) -> i32 {
    const MOD: i64 = 1_000_000_007;
    let mut nums: Vec[i32] = Vec.new();
    let mut cost = 0;
    for v in instructions.iter() {
        let less = nums.partition_point(|x| x < v);
        let not_greater = nums.partition_point(|x| x <= v);
        cost = (cost + min(less, nums.len() - not_greater)) % MOD;
        nums.insert(not_greater, v);
    }
    cost as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random lists of 1 to `most` instructions from 1 to `top`; the
// costs summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut instructions: Vec[i32] = Vec.new();
        for _ in 0..n {
            instructions.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % top + 1) as i32);
        }
        let cost = create_sorted_array(instructions);
        total += cost;
        check = (check * 31 + cost + 1) % 1000000007;
    }
    println(f"{count} lists of up to {most} instructions up to {top}: costs sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one instruction, a list rising,
    // and one falling
    println(create_sorted_array([1, 5, 6, 2]));
    println(create_sorted_array([1, 2, 3, 6, 5, 4]));
    println(create_sorted_array([1, 3, 3, 3, 2, 4, 2, 1, 2]));
    println(create_sorted_array([7]));
    println(create_sorted_array([1, 2, 3, 4, 5]));
    println(create_sorted_array([5, 4, 3, 2, 1]));
    let mut seed = 1649;
    batch(3000, 8, 5, mut seed);
    batch(300, 1000, 1000, mut seed);
    batch(3, 20000, 100000, mut seed);
}
