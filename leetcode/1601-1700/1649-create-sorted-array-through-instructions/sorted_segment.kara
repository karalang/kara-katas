// LeetCode #1649: Create Sorted Array through Instructions -- a segment
// tree.
//
// A bottom-up segment tree of counts over the values, `size` leaves
// rounded up to a power of two: a count over a range of values climbs
// from both ends of it, and an insertion adds one on the way from its
// leaf to the root. O(n log m).

fn range_count(tree: Slice[i64], size: i64, low: i64, high: i64) -> i64 {
    // values low..high, the leaves size + low .. size + high
    let mut (l, r) = (low + size, high + size);
    let mut total = 0;
    while l < r {
        if l % 2 == 1 {
            total += tree[l];
            l += 1;
        }
        if r % 2 == 1 {
            r -= 1;
            total += tree[r];
        }
        l /= 2;
        r /= 2;
    }
    total
}

fn create_sorted_array(instructions: Vec[i32]) -> i32 {
    const MOD: i64 = 1_000_000_007;
    let top = instructions.iter().max().unwrap() as i64;
    let mut size = 1;
    while size <= top {
        size *= 2;
    }
    let mut tree = Vec.filled(2 * size, 0);
    let mut cost = 0;
    for v in instructions.iter() {
        let v = v as i64;
        let less = range_count(tree, size, 0, v);
        let greater = range_count(tree, size, v + 1, size);
        cost = (cost + min(less, greater)) % MOD;
        let mut at = v + size;
        while at > 0 {
            tree[at] += 1;
            at /= 2;
        }
    }
    cost as i32
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random lists of 1 to `most` instructions from 1 to `top`; the
// costs summed, and a checksum
fn batch(count: i64, most: i64, top: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let mut instructions: Vec[i32] = Vec.new();
        for _ in 0..n {
            instructions.push((next_random(mut seed) % top + 1) as i32);
        }
        let cost = create_sorted_array(instructions);
        total += cost;
        check = (check * 31 + cost + 1) % 1000000007;
    }
    println(f"{count} lists of up to {most} instructions up to {top}: costs sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one instruction, a list rising,
    // and one falling
    println(create_sorted_array([1, 5, 6, 2]));
    println(create_sorted_array([1, 2, 3, 6, 5, 4]));
    println(create_sorted_array([1, 3, 3, 3, 2, 4, 2, 1, 2]));
    println(create_sorted_array([7]));
    println(create_sorted_array([1, 2, 3, 4, 5]));
    println(create_sorted_array([5, 4, 3, 2, 1]));
    let mut seed = 1649;
    batch(3000, 8, 5, mut seed);
    batch(300, 1000, 1000, mut seed);
    batch(3, 20000, 100000, mut seed);
}
