// LeetCode #1649: Create Sorted Array through Instructions -- the bench:
// the ★ arm on 60 random lists of 100000 instructions from 1 to 100000,
// all drawn first.

fn create_sorted_array(instructions: Vec[i32]) -> i32 {
    const MOD: i64 = 1_000_000_007;
    let top = instructions.iter().max().unwrap() as i64;
    let mut tree = Vec.filled(top + 1, 0);
    let mut cost = 0;
    for (inserted, v) in instructions.iter().enumerate() {
        let v = v as i64;
        let less = prefix(tree, v - 1);
        let greater = inserted - prefix(tree, v);
        cost = (cost + min(less, greater)) % MOD;
        let mut i = v;
        while i <= top {
            tree[i] += 1;
            i += i & -i;
        }
    }
    cost as i32
}

// how many values from 1 to `v` are in the tree
fn prefix(tree: Slice[i64], v: i64) -> i64 {
    let mut total = 0;
    let mut i = v;
    while i > 0 {
        total += tree[i];
        i -= i & -i;
    }
    total
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1649;
    let mut lists: Vec[Vec[i32]] = Vec.new();
    for _ in 0..60 {
        let mut instructions: Vec[i32] = Vec.new();
        for _ in 0..100000 {
            instructions.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1) as i32);
        }
        lists.push(instructions);
    }
    let mut check = 0;
    let mut total = 0;
    for instructions in lists.iter() {
        let cost = create_sorted_array(instructions);
        total += cost;
        check = (check * 31 + cost + 1) % 1000000007;
    }
    println(f"60 lists of 100000 instructions: costs sum to {total}, checksum {check}");
}
