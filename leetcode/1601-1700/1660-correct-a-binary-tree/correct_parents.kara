// LeetCode #1660: Correct a Binary Tree -- the node with two parents.
//
// Breadth first from the root, recording every link into each node and
// each node's distance from the root. The node the bad link points to is
// the only one with two links in: its real parent one level up, and the
// bad node on its own level. The farther of the two is the bad node, and
// its own parent, its only one, lets go of it. O(n) time and space.

fn correct_binary_tree(root: Option[TreeNode]) -> Option[TreeNode] {
    let start = root?;
    let mut parents: Map[i32, Vec[TreeNode]] = Map.new();
    let mut distance: Map[i32, i64] = Map.new();
    distance.insert(start.val, 0);
    let mut queue = VecDeque.new();
    queue.push_back(start);
    let mut target: Option[i32] = None;
    while let Some(node) = queue.pop_front() {
        let d = distance[node.val];
        for child in [node.left, node.right] {
            if let Some(c) = child {
                parents.entry(c.val).or_insert(Vec.new()).push(node);
                if parents[c.val].len() == 2 {
                    target = Some(c.val);
                }
                if not distance.contains_key(c.val) {
                    distance.insert(c.val, d + 1);
                    queue.push_back(c);
                }
            }
        }
    }
    let pair = ref parents[target.unwrap()];
    let bad = if distance[pair[0].val] > distance[pair[1].val] { pair[0] } else { pair[1] };
    let up = parents[bad.val][0];
    if up.left.is_some_and(|l| l.val == bad.val) {
        up.left = None;
    } else {
        up.right = None;
    }
    root
}

// ---- the harness: the same in every arm --------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn leaf(v: i32) -> TreeNode {
    TreeNode { val: v, left: None, right: None }
}

// the tree LeetCode's level-order list describes, `None` for null
fn from_level_order(items: Slice[Option[i32]]) -> TreeNode {
    let root = leaf(items[0].unwrap());
    let mut queue = VecDeque.new();
    queue.push_back(root);
    let mut i = 1;
    while i < items.len() {
        let node = queue.pop_front().unwrap();
        for side in 0..2 {
            if i < items.len() {
                if let Some(v) = items[i] {
                    let child = leaf(v);
                    if side == 0 {
                        node.left = Some(child);
                    } else {
                        node.right = Some(child);
                    }
                    queue.push_back(child);
                }
                i += 1;
            }
        }
    }
    root
}

// the node holding `val`, by a walk down the child links
fn find(root: TreeNode, val: i32) -> TreeNode {
    let mut stack = [root];
    while let Some(node) = stack.pop() {
        if node.val == val {
            return node;
        }
        if let Some(l) = node.left {
            stack.push(l);
        }
        if let Some(r) = node.right {
            stack.push(r);
        }
    }
    panic("no such node");
}

// LeetCode's level-order form of a tree, trailing nulls dropped
fn written(root: Option[TreeNode]) -> String {
    let mut items: Vec[String] = Vec.new();
    let mut queue: VecDeque[Option[TreeNode]] = VecDeque.new();
    queue.push_back(root);
    while let Some(slot) = queue.pop_front() {
        match slot {
            Some(node) => {
                items.push(f"{node.val}");
                queue.push_back(node.left);
                queue.push_back(node.right);
            }
            None => items.push("null"),
        }
    }
    while items.last() == Some("null") {
        items.pop();
    }
    "[" + items.join(",") + "]"
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn mix(check: i64, x: i64) -> i64 {
    (check * 31 + x + 1) % 1000000007
}

// a tree of `n` nodes holding 0 to n - 1 shuffled, each hung on a random
// free child slot of the nodes before it; the root
fn random_tree(n: i64, seed: mut ref i64) -> TreeNode {
    let mut values: Vec[i32] = (0..n).map(|v| v as i32).collect();
    for i in (1..n).rev() {
        let j = (next_random(mut seed) * 32768 + next_random(mut seed)) % (i + 1);
        values.swap(i, j);
    }
    let root = leaf(values[0]);
    let mut free = [(root, true), (root, false)];
    for i in 1..n {
        let k = (next_random(mut seed) * 32768 + next_random(mut seed)) % free.len();
        let (parent, left) = free.swap_remove(k);
        let child = leaf(values[i]);
        if left {
            parent.left = Some(child);
        } else {
            parent.right = Some(child);
        }
        free.push((child, true));
        free.push((child, false));
    }
    root
}

// the bug: a node with no right child pointed at a node to its right on
// its own level, both drawn at random; the two nodes' values, or None
// when no level has such a pair
fn break_tree(root: TreeNode, seed: mut ref i64) -> Option[(i32, i32)] {
    let mut pairs = 0;
    let mut level = [root];
    let mut levels: Vec[Vec[TreeNode]] = Vec.new();
    while not level.is_empty() {
        let mut below = Vec.new();
        for (i, node) in level.iter().enumerate() {
            if node.right.is_none() {
                pairs += level.len() - 1 - i;
            }
            if let Some(l) = node.left {
                below.push(l);
            }
            if let Some(r) = node.right {
                below.push(r);
            }
        }
        levels.push(level);
        level = below;
    }
    if pairs == 0 {
        return None;
    }
    let mut k = (next_random(mut seed) * 32768 + next_random(mut seed)) % pairs;
    for level in levels.iter() {
        for (i, node) in level.iter().enumerate() {
            if node.right.is_none() {
                let after = level.len() - 1 - i;
                if k < after {
                    let to = level[i + 1 + k];
                    node.right = Some(to);
                    return Some((node.val, to.val));
                }
                k -= after;
            }
        }
    }
    None
}

// the corrected tree folded into `check`, level by level, a missing child
// counted too; the nodes it holds
fn fold(root: Option[TreeNode], check: mut ref i64) -> i64 {
    let mut count = 0;
    let mut queue: VecDeque[Option[TreeNode]] = VecDeque.new();
    queue.push_back(root);
    while let Some(slot) = queue.pop_front() {
        match slot {
            Some(node) => {
                count += 1;
                *check = mix(*check, node.val as i64 + 1);
                queue.push_back(node.left);
                queue.push_back(node.right);
            }
            None => *check = mix(*check, 0),
        }
    }
    count
}

// `count` random trees of 3 to `most` nodes, each broken once (a tree
// with no pair to break is drawn again); the nodes kept, and a checksum
// of the corrected trees
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut kept = 0;
    for _ in 0..count {
        let root = loop {
            let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % (most - 2) + 3;
            let root = random_tree(n, mut seed);
            if break_tree(root, mut seed).is_some() {
                break root;
            }
        };
        kept += fold(correct_binary_tree(Some(root)), mut check);
    }
    println(f"{count} trees of up to {most} nodes: {kept} nodes kept, checksum {check}");
}

fn main() {
    // LeetCode's two examples; then a leaf pointed at its cousin, a node
    // with a left subtree pointed at its brother, and a pointer past
    // several nodes of a level
    let examples: Vec[(Vec[Option[i32]], i32, i32)] = [
        ([Some(1), Some(2), Some(3)], 2, 3),
        ([Some(8), Some(3), Some(1), Some(7), None, Some(9), Some(4), Some(2), None, None, None, Some(5), Some(6)], 7, 4),
        ([Some(1), Some(2), Some(3), Some(4), None, None, Some(5)], 4, 5),
        ([Some(1), Some(2), Some(3), Some(4), None, Some(5), Some(6)], 2, 3),
        ([Some(1), Some(2), Some(3), Some(4), Some(5), Some(6), Some(7)], 4, 7),
    ];
    for (items, from, to) in examples.iter() {
        let root = from_level_order(items);
        find(root, from).right = Some(find(root, to));
        println(written(correct_binary_tree(Some(root))));
    }
    let mut seed = 1660;
    batch(3000, 8, mut seed);
    batch(300, 1000, mut seed);
    batch(30, 100000, mut seed);
}
