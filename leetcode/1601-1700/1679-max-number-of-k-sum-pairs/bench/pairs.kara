// LeetCode #1679: Max Number of K-Sum Pairs -- the bench: the ★ arm on 50
// arrays of 100000 values up to 100000, each with a k up to 200000, all
// drawn first, each answered 10 times.

fn max_operations(nums: Vec[i32], k: i32) -> i32 {
    let mut waiting: Map[i32, i32] = Map.new();
    let mut operations = 0;
    for x in nums.iter() {
        let partner = k - x;
        match waiting.get(partner) {
            Some(c) if c > 0 => {
                waiting[partner] = c - 1;
                operations += 1;
            }
            _ => {
                *waiting.entry(x).or_insert(0) += 1;
            }
        }
    }
    operations
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let arrays = 50;
    let n = 100000;
    let most = 100000;
    let rounds = 10;
    let mut seed = 1679;
    let mut cases: Vec[(Vec[i32], i32)] = Vec.new();
    for _ in 0..arrays {
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1) as i32);
        }
        let k = ((next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * most - 1) + 2) as i32;
        cases.push((nums, k));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, k) in cases.iter() {
            let operations = max_operations(nums, k);
            total += operations;
            check = (check * 31 + operations + r) % 1000000007;
        }
    }
    println(f"{arrays} arrays of {n} values, {rounds} rounds: {total} operations, checksum {check}");
}
