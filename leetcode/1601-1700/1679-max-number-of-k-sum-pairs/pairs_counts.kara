// LeetCode #1679: Max Number of K-Sum Pairs -- every value counted first.
//
// With every value counted, a value v below k - v makes as many pairs as
// the fewer of the two counts, and a value exactly half of k pairs with
// itself, half its count. The counts are summed in a fold over the map, so
// the map's order does not matter. O(n).

fn max_operations(nums: Vec[i32], k: i32) -> i32 {
    let mut counts: Map[i32, i32] = Map.new();
    for x in nums.iter() {
        *counts.entry(x).or_insert(0) += 1;
    }
    counts.iter().fold(0, |operations, (v, c)| {
        let partner = k - v;
        if v < partner {
            operations + min(c, counts.get(partner).unwrap_or(0))
        } else if v == partner {
            operations + c / 2
        } else {
            operations
        }
    })
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` arrays of 1 to `longest` values from 1 to `most`, each with a k
// from 2 to 2 * `most`; the operations summed, and a checksum of every
// answer
fn batch(count: i64, longest: i64, most: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % longest + 1;
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push(((next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1) as i32);
        }
        let k = ((next_random(mut seed) * 32768 + next_random(mut seed)) % (2 * most - 1) + 2) as i32;
        let operations = max_operations(nums, k);
        total += operations;
        check = (check * 31 + operations + n) % 1000000007;
    }
    println(f"{count} arrays of up to {longest} values up to {most}: {total} operations, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then no pair, every value half of k, and
    // one value
    println(max_operations([1, 2, 3, 4], 5));
    println(max_operations([3, 1, 3, 4, 3], 6));
    println(max_operations([1, 1, 1], 3));
    println(max_operations([2, 2, 2, 2, 2], 4));
    println(max_operations([7], 14));
    let mut seed = 1679;
    batch(3000, 12, 6, mut seed);
    batch(300, 1000, 1000, mut seed);
    batch(10, 100000, 100000, mut seed);
}
