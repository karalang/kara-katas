// LeetCode #1684: Count the Number of Consistent Strings -- each word's
// letters as a bit mask.
//
// A word is consistent when its mask has no bit outside the allowed
// letters' mask. O(total length).

fn mask_of(word: String) -> i32 {
    word.bytes().iter().fold(0, |mask, b| mask | 1 << (b - b'a'))
}

fn count_consistent(allowed: String, words: Vec[String]) -> i32 {
    let allowed_mask = mask_of(allowed);
    let mut count = 0;
    for word in words.iter() {
        if mask_of(word) & ~allowed_mask == 0 {
            count += 1;
        }
    }
    count
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// each of the first `letters` letters, kept half the time, at least one
fn draw_allowed(letters: i64, seed: mut ref i64) -> String {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    let mut allowed = String.new();
    for c in alphabet.chars().take(letters) {
        if next_random(mut seed) % 2 == 0 {
            allowed.push(c);
        }
    }
    if allowed.is_empty() {
        allowed.push('a');
    }
    allowed
}

// a word of 1 to 10 letters from the first `letters`
fn draw_word(letters: i64, seed: mut ref i64) -> String {
    let alphabet = "abcdefghijklmnopqrstuvwxyz".bytes();
    let length = next_random(mut seed) % 10 + 1;
    let mut word = String.new();
    for _ in 0..length {
        word.push(alphabet[next_random(mut seed) % letters] as char);
    }
    word
}

// `count` random problems of up to `most` words from the first `letters`
// letters; the answers summed, and a checksum of them
fn batch(count: i64, most: i64, letters: i64, seed: mut ref i64) {
    let mut total = 0;
    let mut check = 0;
    for _ in 0..count {
        let allowed = draw_allowed(letters, mut seed);
        let n = next_random(mut seed) % most + 1;
        let mut words = Vec.new();
        for _ in 0..n {
            words.push(draw_word(letters, mut seed));
        }
        let answer = count_consistent(allowed, words);
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"{count} problems of up to {most} words from {letters} letters: {total} consistent, checksum {check}");
}

fn main() {
    // LeetCode's three examples, every letter allowed, and one letter
    println(count_consistent("ab", ["ad", "bd", "aaab", "baa", "badab"]));
    println(count_consistent("abc", ["a", "b", "c", "ab", "ac", "bc", "abc"]));
    println(count_consistent("cad", ["cc", "acd", "b", "ba", "bac", "bad", "ac", "d"]));
    println(count_consistent("abcdefghijklmnopqrstuvwxyz", ["leetcode", "kara", "zzz"]));
    println(count_consistent("z", ["z", "zz", "az", "zzzzzzzzzz"]));
    let mut seed = 1684;
    batch(3000, 10, 4, mut seed);
    batch(300, 1000, 10, mut seed);
    batch(10, 10000, 26, mut seed);
}
