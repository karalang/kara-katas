// LeetCode #1639: Number of Ways to Form a Target String Given a
// Dictionary -- the bench: the ★ arm on 40 random dictionaries of 1000
// words of 1000 letters and targets of 500 letters, all over the letters
// a to e and drawn first.

const MODULUS: i64 = 1000000007;

fn num_ways(words: Vec[String], target: String) -> i64 {
    let length = words[0].len();
    let goal = target.bytes();
    let mut ways: Vec[i64] = Vec.filled(goal.len() + 1, 0);
    ways[0] = 1;
    for column in 0..length {
        let mut count: Array[i64, 26] = [0; 26];
        for word in words.iter() {
            count[word.bytes()[column] - b'a'] += 1;
        }
        for i in (0..min(column + 1, goal.len())).rev() {
            let have = count[goal[i] - b'a'];
            ways[i + 1] = (ways[i + 1] + ways[i] * have) % MODULUS;
        }
    }
    ways[goal.len()]
}

// ---- the harness ----------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(length: i64, seed: mut ref i64) -> String {
    let mut word = String.new();
    for _ in 0..length {
        word.push((b'a' + (next_random(mut seed) % 5) as u8) as char);
    }
    word
}

fn main() {
    let mut seed = 1639;
    let mut cases: Vec[(Vec[String], String)] = Vec.new();
    for _ in 0..40 {
        let mut words: Vec[String] = Vec.new();
        for _ in 0..1000 {
            words.push(random_word(1000, mut seed));
        }
        let target = random_word(500, mut seed);
        cases.push((words, target));
    }
    let mut check = 0;
    for (words, target) in cases.iter() {
        let ways = num_ways(words, target);
        check = (check * 31 + ways + 1) % 1000000007;
    }
    println(f"40 dictionaries of 1000 words: checksum {check}");
}
