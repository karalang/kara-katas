// LeetCode #1639: Number of Ways to Form a Target String Given a
// Dictionary -- recursion with a memo.
//
// ways(i, k): the ways to form the target from letter i on, using columns
// from k on. Column k is skipped, or supplies letter i from any word that
// has it there. A `Map` keyed by `(i, k)` remembers every answer, and a
// target letter that cannot fit in the columns left gives 0 at once.
// O(Lw + Lt).

const MODULUS: i64 = 1000000007;

fn ways(i: i64, k: i64, goal: Slice[u8], count: Vec[Array[i64, 26]], memo: mut ref Map[(i64, i64), i64]) -> i64 {
    if i == goal.len() {
        return 1;
    }
    if goal.len() - i > count.len() - k {
        return 0;
    }
    if let Some(known) = memo.get((i, k)) {
        return known;
    }
    let take = count[k][goal[i] - b'a'] * ways(i + 1, k + 1, goal, count, mut memo) % MODULUS;
    let skip = ways(i, k + 1, goal, count, mut memo);
    let total = (take + skip) % MODULUS;
    memo.insert((i, k), total);
    total
}

fn num_ways(words: Vec[String], target: String) -> i64 {
    let mut count: Vec[Array[i64, 26]] = Vec.filled(words[0].len(), [0; 26]);
    for word in words.iter() {
        for (k, letter) in word.bytes().iter().enumerate() {
            count[k][letter - b'a'] += 1;
        }
    }
    let mut memo: Map[(i64, i64), i64] = Map.new();
    ways(0, 0, target.bytes(), count, mut memo)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(length: i64, letters: i64, seed: mut ref i64) -> String {
    let mut word = String.new();
    for _ in 0..length {
        word.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    word
}

// `count` random dictionaries of 1 to `most` words of one length from 1
// to `long`, and a target of 1 to that length plus one, all from the first
// `letters` of the alphabet; the ways summed, and a checksum
fn batch(count: i64, most: i64, long: i64, letters: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let length = next_random(mut seed) % long + 1;
        let mut words: Vec[String] = Vec.new();
        for _ in 0..n {
            words.push(random_word(length, letters, mut seed));
        }
        let target = random_word(next_random(mut seed) % (length + 1) + 1, letters, mut seed);
        let ways = num_ways(words, target);
        total += ways;
        check = (check * 31 + ways + 1) % 1000000007;
    }
    println(f"{count} dictionaries of up to {most} words: ways sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's two examples, then a target longer than the words, a
    // letter no word has, and one word that is the target
    println(num_ways(["acca", "bbbb", "caca"], "aba"));
    println(num_ways(["abba", "baab"], "bab"));
    println(num_ways(["ab", "ba"], "aba"));
    println(num_ways(["abc", "abc"], "ad"));
    println(num_ways(["xyz"], "xyz"));
    let mut seed = 1639;
    batch(3000, 4, 5, 2, mut seed);
    batch(100, 50, 60, 3, mut seed);
    batch(3, 1000, 1000, 26, mut seed);
}
