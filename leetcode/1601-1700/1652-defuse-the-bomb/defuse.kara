// LeetCode #1652: Defuse the Bomb -- the ★ arm.
//
// A window of |k| numbers slides once round the circle. For k > 0 the
// window for position i is i + 1 ..= i + k, for k < 0 it is i + k ..
// i, both modulo n; moving to i + 1 adds the number entering on the
// right and drops the one leaving on the left. O(n).

fn decrypt(code: Vec[i32], k: i32) -> Vec[i32] {
    let n = code.len();
    let mut answer = Vec.filled(n, 0);
    if k == 0 {
        return answer;
    }
    let k = k as i64;
    // the window for position 0: [start, end], indices taken modulo n
    let mut (start, end) = if k > 0 { (1, k) } else { (n + k, n - 1) };
    let mut sum: i32 = 0;
    for j in start..=end {
        sum += code[j % n];
    }
    for i in 0..n {
        answer[i] = sum;
        sum -= code[start % n];
        start += 1;
        end += 1;
        sum += code[end % n];
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` random codes of 1 to `most` numbers from 1 to 100, each with a
// k from -(n - 1) to n - 1; every number of every answer summed, and a
// checksum
fn batch(count: i64, most: i64, seed: mut ref i64) {
    let mut check = 0;
    let mut total = 0;
    for _ in 0..count {
        let n = next_random(mut seed) % most + 1;
        let code: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % 100 + 1) as i32).collect();
        let k = (next_random(mut seed) % (2 * n - 1) - (n - 1)) as i32;
        for x in decrypt(code, k).iter() {
            total += x;
            check = (check * 31 + x + 1) % 1000000007;
        }
    }
    println(f"{count} codes of up to {most} numbers: answers sum to {total}, checksum {check}");
}

fn main() {
    // LeetCode's three examples, then one number, k reaching all the way
    // round each way
    println(decrypt([5, 7, 1, 4], 3));
    println(decrypt([1, 2, 3, 4], 0));
    println(decrypt([2, 4, 9, 3], -2));
    println(decrypt([42], 0));
    println(decrypt([1, 2, 3, 4, 5], 4));
    println(decrypt([1, 2, 3, 4, 5], -4));
    let mut seed = 1652;
    batch(3000, 8, mut seed);
    batch(3000, 100, mut seed);
}
