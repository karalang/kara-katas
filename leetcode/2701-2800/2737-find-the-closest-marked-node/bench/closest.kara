// LeetCode #2737: Find the Closest Marked Node -- the bench (closest.kara):
// Dijkstra from s with a `PriorityQueue`, stopping at the first marked
// node taken off it.

fn minimum_distance(n: i64, edges: Vec[Vec[i64]], s: i64, marked: Vec[i64]) -> i64 {
    let mut out: Vec[Vec[(i64, i64)]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        out[e[0]].push((e[1], e[2]));
    }
    let mut is_marked: Vec[bool] = Vec.filled(n, false);
    for v in marked.iter() {
        is_marked[v] = true;
    }
    let mut dist: Vec[i64] = Vec.filled(n, i64.MAX);
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    dist[s] = 0;
    queue.push((0, s));
    while let Some((d, u)) = queue.pop() {
        if d > dist[u] {
            continue;
        }
        if is_marked[u] {
            return d;
        }
        for (v, w) in out[u].iter() {
            if d + w < dist[v] {
                dist[v] = d + w;
                queue.push((d + w, v));
            }
        }
    }
    -1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let graphs = 50;
    let n = 500;
    let m = 10000;
    let rounds = 20;
    let mut seed = 2737;
    let mut problems: Vec[(Vec[Vec[i64]], i64, Vec[i64])] = Vec.new();
    for _ in 0..graphs {
        // 500 nodes and 10^4 edges, LeetCode's most, weighing up to 10^6,
        // and 1 to 3 marked nodes, so the search goes far before it stops
        let mut edges: Vec[Vec[i64]] = Vec.new();
        for _ in 0..m {
            let u = next_random(mut seed) % n;
            let v = (u + 1 + next_random(mut seed) % (n - 1)) % n;
            let w = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000 + 1;
            edges.push([u, v, w].to_vec());
        }
        let s = next_random(mut seed) % n;
        let mut marked: Vec[i64] = Vec.new();
        let want = next_random(mut seed) % 3 + 1;
        while marked.len() < want {
            let v = next_random(mut seed) % n;
            if v != s and not marked.contains(v) {
                marked.push(v);
            }
        }
        problems.push((edges, s, marked));
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (edges, s, marked) in problems.iter() {
            let distance = minimum_distance(n, edges, s, marked);
            sum += distance;
            check = (check * 31 + distance + 1 + r) % 1000000007;
        }
    }
    println(f"{graphs} graphs of {n} nodes and {m} edges, {rounds} rounds: distances sum to {sum}, checksum {check}");
}
