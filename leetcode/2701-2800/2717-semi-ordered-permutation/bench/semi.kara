// LeetCode #2717: Semi-Ordered Permutation -- the bench (semi.kara): 1's
// index plus n's distance from the end, less one when 1 starts right of
// n, the indices found by `position`.

fn semi_ordered_permutation(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let first = nums.iter().position(|v| v == 1).unwrap();
    let last = nums.iter().position(|v| v == n).unwrap();
    let swaps = first + (n - 1 - last);
    if first > last { swaps - 1 } else { swaps }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 200000;
    let rounds = 20;
    let mut seed = 2717;
    let mut perms: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        // 1 to 50, LeetCode's most, shuffled by Fisher and Yates
        let mut nums: Vec[i64] = (1..=50).collect();
        for i in (1..50).rev() {
            let j = next_random(mut seed) % (i + 1);
            nums.swap(i, j);
        }
        perms.push(nums);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in perms.iter() {
            let swaps = semi_ordered_permutation(nums);
            sum += swaps;
            check = (check * 31 + swaps + r) % 1000000007;
        }
    }
    println(f"{count} permutations of 50, {rounds} rounds: swaps sum to {sum}, checksum {check}");
}
