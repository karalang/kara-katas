// LeetCode #2717: Semi-Ordered Permutation -- the one-pass arm. One walk
// over the numbers notes where 1 and n stand, and the answer comes from
// the two places by a `match` on which stands first. O(n).

fn semi_ordered_permutation(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut first = 0;
    let mut last = 0;
    for (i, v) in nums.iter().enumerate() {
        if v == 1 {
            first = i;
        } else if v == n {
            last = i;
        }
    }
    match first < last {
        true => first + n - 1 - last,
        false => first + n - 2 - last,
    }
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 1 to n shuffled by Fisher and Yates
fn random_permutation(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = (1..=n).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        nums.swap(i, j);
    }
    nums
}

fn main() {
    // LeetCode's three examples; two numbers both ways; 50, LeetCode's
    // most, backwards, and with only 1 and 50 traded; 1 and 50 side by
    // side in the middle, both ways round
    println(f"{semi_ordered_permutation([2, 1, 4, 3].to_vec())}");
    println(f"{semi_ordered_permutation([2, 4, 1, 3].to_vec())}");
    println(f"{semi_ordered_permutation([1, 3, 4, 2, 5].to_vec())}");
    println(f"{semi_ordered_permutation([1, 2].to_vec())}");
    println(f"{semi_ordered_permutation([2, 1].to_vec())}");
    println(f"{semi_ordered_permutation((1..=50).rev().collect())}");
    let mut traded: Vec[i64] = (1..=50).collect();
    traded.swap(0, 49);
    println(f"{semi_ordered_permutation(traded)}");
    let mut middle: Vec[i64] = (1..=50).collect();
    middle.swap(0, 24);
    middle.swap(49, 25);
    println(f"{semi_ordered_permutation(middle)}");
    middle.swap(24, 25);
    println(f"{semi_ordered_permutation(middle)}");
    // 10000 random permutations of 2 to 50
    let mut seed = 2717;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..10000 {
        let n = next_random(mut seed) % 49 + 2;
        let swaps = semi_ordered_permutation(random_permutation(mut seed, n));
        sum += swaps;
        check = (check * 31 + swaps) % 1000000007;
    }
    println(f"10000 permutations: swaps sum to {sum}, checksum {check}");
}
