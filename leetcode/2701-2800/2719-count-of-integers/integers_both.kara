// LeetCode #2719: Count of Integers -- the both-bounds arm. One walk
// tight against both bounds at once, num1 padded with leading zeros to
// num2's length: at each place the digits run from num1's (while the
// prefix is num1's) to num2's (while it is num2's), so no subtraction is
// needed. The state of the walk, place, sum and the two tight flags, is
// remembered in a `Map`. O(digits * max_sum * 10).

const MOD: i64 = 1000000007;

struct Walk {
    low: Vec[i64],
    high: Vec[i64],
    min_sum: i64,
    max_sum: i64,
    memo: Map[(i64, i64, bool, bool), i64],
}

impl Walk {
    fn ways(mut ref self, place: i64, sum: i64, at_low: bool, at_high: bool) -> i64 {
        if sum > self.max_sum {
            return 0;
        }
        if place == self.high.len() {
            return if sum >= self.min_sum { 1 } else { 0 };
        }
        let key = (place, sum, at_low, at_high);
        if let Some(w) = self.memo.get(key) {
            return w;
        }
        let from = if at_low { self.low[place] } else { 0 };
        let to = if at_high { self.high[place] } else { 9 };
        let mut total = 0;
        for d in from..=to {
            total = (total + self.ways(place + 1, sum + d, at_low and d == from, at_high and d == to)) % MOD;
        }
        self.memo.insert(key, total);
        total
    }
}

fn count(num1: Str, num2: Str, min_sum: i64, max_sum: i64) -> i64 {
    let high: Vec[i64] = num2.bytes().iter().map(|b| (b - b'0') as i64).collect();
    let mut low: Vec[i64] = Vec.filled(high.len() - num1.len(), 0);
    for b in num1.bytes() {
        low.push((b - b'0'));
    }
    let mut walk = Walk { low, high, min_sum, max_sum, memo: Map.new() };
    walk.ways(0, 0, true, true)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a number of 1 to `longest` digits, the first not zero
fn random_number(seed: mut ref i64, longest: i64) -> String {
    let n = next_random(mut seed) % longest + 1;
    let mut digits = String.new();
    digits.push((b'1' + (next_random(mut seed) % 9) as u8) as char);
    for _ in 1..n {
        digits.push((b'0' + (next_random(mut seed) % 10) as u8) as char);
    }
    digits
}

// a before b as numbers: the shorter first, then by digits
fn at_most(a: Str, b: Str) -> bool {
    a.len() < b.len() or (a.len() == b.len() and a <= b)
}

fn main() {
    // LeetCode's two examples; 1 to 10^22, LeetCode's widest, with every
    // sum allowed and with only 400; one number; the 22 nines
    println(f"{count("1", "12", 1, 8)}");
    println(f"{count("1", "5", 1, 5)}");
    let top = f"1{"0".repeat(22)}";
    println(f"{count("1", top, 1, 400)}");
    println(f"{count("1", top, 400, 400)}");
    println(f"{count("4179", "4179", 21, 21)}");
    let nines = "9".repeat(22);
    println(f"{count(nines, nines, 198, 400)}");
    println(f"{count("1", nines, 99, 99)}");
    // 2000 random ranges up to 10^4 with sums up to 40; then 300 of up to
    // 22 digits with sums up to 200
    let mut seed = 2719;
    let mut sum = 0;
    let mut check = 0;
    for c in 0..2300 {
        let (longest, most) = if c < 2000 { (4, 40) } else { (22, 200) };
        let a = random_number(mut seed, longest);
        let b = random_number(mut seed, longest);
        let low = next_random(mut seed) % most + 1;
        let high = low + next_random(mut seed) % (most - low + 1);
        let found = if at_most(a, b) { count(a, b, low, high) } else { count(b, a, low, high) };
        sum += found;
        check = (check * 31 + found) % 1000000007;
        if c == 1999 {
            println(f"2000 ranges up to 10^4: counts sum to {sum}, checksum {check}");
            sum = 0;
            check = 0;
        }
    }
    println(f"300 ranges up to 22 digits: counts mod p sum to {sum}, checksum {check}");
}
