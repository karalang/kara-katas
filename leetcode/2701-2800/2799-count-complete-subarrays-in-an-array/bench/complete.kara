// LeetCode #2799: Count Complete Subarrays in an Array -- the bench: the
// ★ arm over 2000 arrays of 1000 numbers, LeetCode's most, half from 1
// to 2000 and half from 1 to 20, all drawn first, then each answered 20
// times.

fn count_complete_subarrays(nums: Vec[i64]) -> i64 {
    let d = Set[i64].from_iter(nums.iter().cloned()).len();
    let mut counts: Map[i64, i64] = Map.new();
    let mut start = 0;
    let mut complete = 0;
    for v in nums.iter() {
        *counts.entry(v).or_insert(0) += 1;
        while counts.len() == d {
            let first = nums[start];
            let held = counts.get(first).unwrap();
            if held == 1 {
                break;
            }
            counts.insert(first, held - 1);
            start += 1;
        }
        if counts.len() == d {
            complete += start + 1;
        }
    }
    complete
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 2000;
    let rounds = 20;
    let mut seed = 2799;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..count {
        let top = if c % 2 == 0 { 2000 } else { 20 };
        cases.push((0..1000).map(|_| wide(mut seed) % top + 1).collect());
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in cases.iter() {
            let a = count_complete_subarrays(nums);
            total += a;
            check = (check * 31 + a + r) % 1000000007;
        }
    }
    println(f"{count} arrays of 1000, {rounds} rounds: complete sum to {total}, checksum {check}");
}
