// LeetCode #2799: Count Complete Subarrays in an Array -- the
// differential. The five arms, against the statement read literally:
// every subarray, and each counted when every number of the array is
// found in it; no window and no distinct count. 2000 random arrays of 1
// to 12 numbers from 1 to 4; then 50 of up to 1000 numbers, from 1 to
// 2000 or from 1 to 20. Every case is drawn before any arm answers; the
// literal reading is asked only of the first 2000.
//
// P1  up to 12 numbers, the count is the literal reading's
// P2  every number 1000 more: the same count
// P3  the numbers reversed: the same count
// P4  the first number put again at the end: at least one more
// P5  from 1 to n(n + 1) / 2, and n(n + 1) / 2 when every number is the
//     first
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut count = 0;
    for i in 0..n {
        for j in i..n {
            let part = nums[i..j + 1];
            if nums.iter().all(|v| part.iter().any(|w| w == v)) {
                count += 1;
            }
        }
    }
    count
}


// ---- star (complete.kara) -------------------------------------------

fn star_count_complete_subarrays(nums: Vec[i64]) -> i64 {
    let d = Set[i64].from_iter(nums.iter().cloned()).len();
    let mut counts: Map[i64, i64] = Map.new();
    let mut start = 0;
    let mut complete = 0;
    for v in nums.iter() {
        *counts.entry(v).or_insert(0) += 1;
        while counts.len() == d {
            let first = nums[start];
            let held = counts.get(first).unwrap();
            if held == 1 {
                break;
            }
            counts.insert(first, held - 1);
            start += 1;
        }
        if counts.len() == d {
            complete += start + 1;
        }
    }
    complete
}


// ---- starts (complete_starts.kara) ----------------------------------

fn starts_count_complete_subarrays(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let d = Set[i64].from_iter(nums.iter().cloned()).len();
    let mut complete = 0;
    for start in 0..n {
        let mut seen: Set[i64] = Set.new();
        for end in start..n {
            seen.insert(nums[end]);
            if seen.len() == d {
                complete += n - end;
                break;
            }
        }
    }
    complete
}


// ---- first (complete_first.kara) ------------------------------------

fn first_count_complete_subarrays(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let d = Set[i64].from_iter(nums.iter().cloned()).len();
    let mut first: Map[i64, i64] = Map.new();
    let mut places: SortedMap[i64, i64] = SortedMap.new();
    let mut complete = 0;
    for start in (0..n).rev() {
        let v = nums[start];
        if let Some(old) = first.insert(v, start) {
            places.remove(old);
        }
        places.insert(start, v);
        if first.len() == d {
            let (last, _) = places.last().unwrap();
            complete += n - last;
        }
    }
    complete
}


// ---- table (complete_table.kara) ------------------------------------

fn table_count_complete_subarrays(nums: Vec[i64]) -> i64 {
    let top = nums.iter().max().unwrap();
    let mut seen: Vec[bool] = Vec.filled(top + 1, false);
    let mut d = 0;
    for v in nums.iter() {
        if not seen[v] {
            seen[v] = true;
            d += 1;
        }
    }
    let mut counts: Vec[i64] = Vec.filled(top + 1, 0);
    let mut held = 0;
    let mut start = 0;
    let mut complete = 0;
    for v in nums.iter() {
        if counts[v] == 0 {
            held += 1;
        }
        counts[v] += 1;
        while held == d and counts[nums[start]] > 1 {
            counts[nums[start]] -= 1;
            start += 1;
        }
        if held == d {
            complete += start + 1;
        }
    }
    complete
}


// ---- solution (complete_solution.kara) ------------------------------

struct Solution {}

impl Solution {
    pub fn count_complete_subarrays(nums: Vec[i32]) -> i32 {
        let n = nums.len();
        let k = Set.from_iter(nums.iter()).len();
        let mut cnt: Map[i32, i32] = Map.new();
        let mut ans: i32 = 0;
        let mut l = 0;
        for r in 0..n {
            *cnt.entry(nums[r]).or_insert(0) += 1;
            while cnt.len() == k {
                ans += (n - r) as i32;
                let e = cnt.get_mut(nums[l]).unwrap();
                *e -= 1;
                if *e == 0 {
                    cnt.remove(nums[l]);
                }
                l += 1;
            }
        }
        ans
    }
}

fn solution_count_complete_subarrays(nums: Vec[i64]) -> i64 {
    Solution.count_complete_subarrays(nums.iter().map(|v| v as i32).collect())
}


fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_count_complete_subarrays(nums),
        1 => starts_count_complete_subarrays(nums),
        2 => first_count_complete_subarrays(nums),
        3 => table_count_complete_subarrays(nums),
        _ => solution_count_complete_subarrays(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "starts", "first", "table", "solution"];
    let mut seed = 2799;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        if c < 2000 {
            let n = next_random(mut seed) % 12 + 1;
            cases.push((0..n).map(|_| next_random(mut seed) % 4 + 1).collect());
        } else {
            let n = wide(mut seed) % 1000 + 1;
            let top = if c % 2 == 0 { 2000 } else { 20 };
            cases.push((0..n).map(|_| wide(mut seed) % top + 1).collect());
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nums) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(nums) } else { 0 };
        check = (check * 31 + want + 1) % 1000000007;
        let n = nums.len();
        let raised: Vec[i64] = nums.iter().map(|v| v + 1000).collect();
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let mut again = nums.clone();
        again.push(nums[0]);
        let same: Vec[i64] = Vec.filled(n, nums[0]);
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut agree = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    agree += 1;
                }
            }
            let all = n * (n + 1) / 2;
            let verdicts = [
                not small or value == want,
                answer(arm, raised) == value,
                answer(arm, reversed) == value,
                answer(arm, again) >= value + 1,
                value >= 1 and value <= all and answer(arm, same) == all,
                agree >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
