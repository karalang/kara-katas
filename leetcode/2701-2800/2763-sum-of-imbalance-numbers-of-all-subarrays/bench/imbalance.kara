// LeetCode #2763: Sum of Imbalance Numbers of All Subarrays -- the bench
// (imbalance.kara): each index counted for the subarrays in which it is
// the leftmost occurrence of a run's top value, from the last x or x + 1
// before it and the first x + 1 after it.

fn sum_imbalance_numbers(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut left: Vec[i64] = Vec.filled(n, 0);
    let mut last: Vec[i64] = Vec.filled(n + 2, -1);
    for (i, x) in nums.iter().enumerate() {
        left[i] = last[x].max(last[x + 1]);
        last[x] = i;
    }
    let mut first: Vec[i64] = Vec.filled(n + 2, n);
    let mut total = 0;
    for i in (0..n).rev() {
        let x = nums[i];
        total += (i - left[i]) * (first[x + 1] - i);
        first[x] = i;
    }
    total - n * (n + 1) / 2
}

// ---- the bench: 20000 arrays of 1000, each answered 5 times --------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 20000;
    let rounds = 5;
    let mut seed = 2763;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        // 1000 numbers up to 1000, LeetCode's most
        let nums: Vec[i64] = (0..1000).map(|_| next_random(mut seed) % 1000 + 1).collect();
        cases.push(nums);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in cases.iter() {
            let found = sum_imbalance_numbers(nums);
            sum += found;
            check = (check * 31 + found + r) % 1000000007;
        }
    }
    println(f"{count} arrays of 1000, {rounds} rounds: imbalances sum to {sum}, checksum {check}");
}
