// LeetCode #2763: Sum of Imbalance Numbers of All Subarrays -- the
// differential. The five arms, against the statement read literally:
// every subarray copied out and sorted by `sort`, its imbalance the
// indices of the sorted copy whose next number is more than 1 above, and
// the imbalances summed; no counting of runs. 2000 random arrays of 1 to
// 14 numbers up to their length; then 40 of up to 300. Every case is
// drawn before any arm answers; the literal reading is asked only of the
// first 2000.
//
// P1  up to 14 numbers, the answer is the literal reading's
// P2  the numbers reversed: the same answer
// P3  every number x made n + 1 - x: the same answer
// P4  every number made 1: 0
// P5  from 0 to (n + 1) n (n - 1) / 6; and the last number put again at
//     the end: no less
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut total = 0;
    for i in 0..n {
        for j in i..n {
            let mut sorted: Vec[i64] = nums[i..=j].to_vec();
            sorted.sort();
            for k in 0..sorted.len() - 1 {
                if sorted[k + 1] - sorted[k] > 1 {
                    total += 1;
                }
            }
        }
    }
    total
}


// ---- star (imbalance.kara) ------------------------------------------

fn star_sum_imbalance_numbers(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut left: Vec[i64] = Vec.filled(n, 0);
    let mut last: Vec[i64] = Vec.filled(n + 2, -1);
    for (i, x) in nums.iter().enumerate() {
        left[i] = last[x].max(last[x + 1]);
        last[x] = i;
    }
    let mut first: Vec[i64] = Vec.filled(n + 2, n);
    let mut total = 0;
    for i in (0..n).rev() {
        let x = nums[i];
        total += (i - left[i]) * (first[x + 1] - i);
        first[x] = i;
    }
    total - n * (n + 1) / 2
}


// ---- set (imbalance_set.kara) ---------------------------------------

fn set_sum_imbalance_numbers(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut total = 0;
    for i in 0..n {
        let mut seen: SortedSet[i64] = SortedSet.new();
        let mut gaps = 0;
        for j in i..n {
            let x = nums[j];
            if seen.insert(x) {
                let below = seen.range(0, x).next_back();
                let above = seen.range(x + 1, n + 2).next();
                if let (Some(p), Some(s)) = (below, above) {
                    if s - p > 1 {
                        gaps -= 1;
                    }
                }
                if let Some(p) = below {
                    if x - p > 1 {
                        gaps += 1;
                    }
                }
                if let Some(s) = above {
                    if s - x > 1 {
                        gaps += 1;
                    }
                }
            }
            total += gaps;
        }
    }
    total
}


// ---- bits (imbalance_bits.kara) -------------------------------------

fn bits_sum_imbalance_numbers(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let words = (n + 2) / 64 + 1;
    let mut total = 0;
    for i in 0..n {
        let mut seen: Vec[u64] = Vec.filled(words, 0);
        for j in i..n {
            let x = nums[j];
            seen[x / 64] |= 1 << (x % 64);
            let mut runs = 0;
            for k in 0..words {
                let next = if k + 1 < words { seen[k + 1] } else { 0 };
                let tops = seen[k] & ~((seen[k] >> 1) | (next << 63));
                runs += tops.count_ones();
            }
            total += runs - 1;
        }
    }
    total
}


// ---- sorted (imbalance_sorted.kara) ---------------------------------

fn sorted_sum_imbalance_numbers(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut total = 0;
    for i in 0..n {
        let mut sorted: Vec[i64] = Vec.new();
        let mut gaps = 0;
        for j in i..n {
            let x = nums[j];
            let at = sorted.partition_point(|v| v < x);
            if sorted.get(at).cloned() != Some(x) {
                let below = if at > 0 { sorted.get(at - 1) } else { None };
                let above = sorted.get(at);
                match (below, above) {
                    (Some(p), Some(s)) => gaps += (x - p > 1) as i64 + (s - x > 1) as i64 - (s - p > 1) as i64,
                    (Some(p), None) => gaps += (x - p > 1) as i64,
                    (None, Some(s)) => gaps += (s - x > 1) as i64,
                    (None, None) => {}
                }
                sorted.insert(at, x);
            }
            total += gaps;
        }
    }
    total
}


// ---- solution (imbalance_solution.kara) -----------------------------

struct Solution {}

impl Solution {
    pub fn sum_imbalance_numbers(nums: Vec[i32]) -> i32 {
        let n = nums.len();
        let mut ans = 0;
        for i in 0..n {
            let mut seen = Vec.filled(n + 2, false);
            seen[nums[i] as usize] = true;
            let mut cnt = 0;
            for j in i + 1..n {
                let x = nums[j] as usize;
                if not seen[x] {
                    cnt += 1;
                    if seen[x - 1] {
                        cnt -= 1;
                    }
                    if seen[x + 1] {
                        cnt -= 1;
                    }
                    seen[x] = true;
                }
                ans += cnt;
            }
        }
        ans
    }
}

fn solution_sum_imbalance_numbers(nums: Vec[i64]) -> i64 {
    Solution.sum_imbalance_numbers(nums.iter().map(|x| x as i32).collect())
}


fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_sum_imbalance_numbers(nums),
        1 => set_sum_imbalance_numbers(nums),
        2 => bits_sum_imbalance_numbers(nums),
        3 => sorted_sum_imbalance_numbers(nums),
        _ => solution_sum_imbalance_numbers(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "set", "bits", "sorted", "solution"];
    let mut seed = 2763;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2040 {
        let most = if c < 2000 { 14 } else { 300 };
        let n = next_random(mut seed) % most + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % n + 1).collect();
        cases.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nums) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(nums) } else { 0 };
        check = (check * 31 + want + 1) % 1000000007;
        let n = nums.len();
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let mirrored: Vec[i64] = nums.iter().map(|x| n + 1 - x).collect();
        let ones: Vec[i64] = Vec.filled(n, 1);
        let mut longer = nums.clone();
        longer.push(nums[n - 1]);
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == want,
                answer(arm, reversed) == value,
                answer(arm, mirrored) == value,
                answer(arm, ones) == 0,
                0 <= value and value <= (n + 1) * n * (n - 1) / 6 and answer(arm, longer) >= value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
