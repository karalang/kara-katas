// LeetCode #2716: Minimize String Length -- the differential. The five
// arms, against the statement read literally: from the string given,
// every operation the statement allows tried, an index chosen and the
// closest copy of its letter on each side deleted, breadth first over
// every string reached, and the shortest kept. No counting of letters.
// 1000 random strings of 1 to 8 letters from the first 1 to 4; then 500
// of 1 to 100 from the first 1 to 26. Every case is drawn before any arm
// answers.
//
// P1  up to 8 letters, the answer is the literal reading's
// P2  the string reversed: the same answer
// P3  every letter moved 1 to 25 places on round the alphabet: the same
//     answer
// P4  the string written twice: the same answer
// P5  a letter the string lacks added: one more; and the answer is
//     between 1 and the shorter of the length and 26
// P6  each arm agrees with at least three of the other four


// ---- star (minimize.kara) -------------------------------------------

fn star_minimized_string_length(s: String) -> i64 {
    let seen: Set[char] = s.chars().collect();
    seen.len()
}


// ---- bits (minimize_bits.kara) --------------------------------------

fn bits_minimized_string_length(s: String) -> i64 {
    let mask = s.bytes().iter().fold(0u32, |m, b| m | (1u32 << (b - b'a')));
    mask.count_ones()
}


// ---- table (minimize_table.kara) ------------------------------------

fn table_minimized_string_length(s: String) -> i64 {
    let mut met: Array[bool, 26] = [false; 26];
    let mut count = 0;
    for b in s.bytes() {
        let i = (b - b'a') as i64;
        if not met[i] {
            met[i] = true;
            count += 1;
        }
    }
    count
}


// ---- sorted (minimize_sorted.kara) ----------------------------------

fn sorted_minimized_string_length(s: String) -> i64 {
    let mut letters: Vec[char] = s.chars().collect();
    letters.sort();
    let mut count = 0;
    for i in 0..letters.len() {
        if i == 0 or letters[i] != letters[i - 1] {
            count += 1;
        }
    }
    count
}


// ---- solution (minimize_solution.kara) ------------------------------

struct Solution {}

impl Solution {
    pub fn minimized_string_length(s: String) -> i32 {
        Set[char].from_iter(s.chars()).len() as i32
    }
}

fn solution_minimized_string_length(s: String) -> i64 {
    Solution.minimized_string_length(s)
}

// ---- the statement read literally ------------------------------------------

// the strings reached from s by any sequence of operations, breadth
// first; an operation at index i deletes the closest copy of s[i] to its
// left and the closest to its right, where there are any
fn literal(s: String) -> i64 {
    let mut seen: Set[String] = Set.new();
    seen.insert(s.clone());
    let mut layer: Vec[String] = [s.clone()].to_vec();
    let mut shortest = s.len();
    while layer.len() > 0 {
        let mut next: Vec[String] = Vec.new();
        for t in layer.iter() {
            shortest = shortest.min(t.len());
            let letters: Vec[char] = t.chars().collect();
            let n = letters.len();
            for i in 0..n {
                let mut gone: Vec[i64] = Vec.new();
                let mut j = i - 1;
                while j >= 0 and letters[j] != letters[i] {
                    j -= 1;
                }
                if j >= 0 {
                    gone.push(j);
                }
                let mut k = i + 1;
                while k < n and letters[k] != letters[i] {
                    k += 1;
                }
                if k < n {
                    gone.push(k);
                }
                if gone.len() > 0 {
                    let mut kept = String.new();
                    for p in 0..n {
                        if not gone.contains(p) {
                            kept.push(letters[p]);
                        }
                    }
                    if not seen.contains(kept) {
                        seen.insert(kept.clone());
                        next.push(kept);
                    }
                }
            }
        }
        layer = next;
    }
    shortest
}

fn answer(arm: i64, s: String) -> i64 {
    match arm {
        0 => star_minimized_string_length(s),
        1 => bits_minimized_string_length(s),
        2 => table_minimized_string_length(s),
        3 => sorted_minimized_string_length(s),
        _ => solution_minimized_string_length(s),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, n: i64, letters: i64) -> String {
    let mut word = String.new();
    for _ in 0..n {
        word.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    word
}

fn main() {
    let names = ["star", "bits", "table", "sorted", "solution"];
    let mut seed = 2716;
    // (the string, how far round the alphabet to move it)
    let mut cases: Vec[(String, i64)] = Vec.new();
    for c in 0..1500 {
        let (n, letters) = if c < 1000 {
            (next_random(mut seed) % 8 + 1, next_random(mut seed) % 4 + 1)
        } else {
            (next_random(mut seed) % 100 + 1, next_random(mut seed) % 26 + 1)
        };
        let s = random_word(mut seed, n, letters);
        let turn = next_random(mut seed) % 25 + 1;
        cases.push((s, turn));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (s, turn)) in cases.iter().enumerate() {
        let small = c < 1000;
        let truth = if small { literal(s) } else { -1 };
        if small {
            check = (check * 31 + truth) % 1000000007;
        }
        let reversed: String = s.chars().rev().collect();
        let moved: String = s.bytes().iter().map(|b| (b'a' + ((b - b'a') + turn) as u8 % 26) as char).collect();
        let twice = f"{s}{s}";
        let mut missing = 'a';
        while s.contains(missing.to_string()) and missing != 'z' {
            missing = (missing as u32 as u8 + 1) as char;
        }
        let mut longer = s.clone();
        longer.push(missing);
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, s)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == truth,
                answer(arm, reversed) == value,
                answer(arm, moved) == value,
                answer(arm, twice) == value,
                (s.contains(missing.to_string()) or answer(arm, longer) == value + 1) and 1 <= value and value <= s.len().min(26),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
