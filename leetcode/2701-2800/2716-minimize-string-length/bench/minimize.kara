// LeetCode #2716: Minimize String Length -- the bench (minimize.kara):
// the distinct letters of each string counted by a `Set[char]`.

fn minimized_string_length(s: String) -> i64 {
    let seen: Set[char] = s.chars().collect();
    seen.len()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100000;
    let rounds = 10;
    let mut seed = 2716;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..count {
        // 100 letters, LeetCode's longest, from the first 1 to 26
        let letters = next_random(mut seed) % 26 + 1;
        let mut s = String.new();
        for _ in 0..100 {
            s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        strings.push(s);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for s in strings.iter() {
            let length = minimized_string_length(s);
            sum += length;
            check = (check * 31 + length + r) % 1000000007;
        }
    }
    println(f"{count} strings of 100 letters, {rounds} rounds: lengths sum to {sum}, checksum {check}");
}
