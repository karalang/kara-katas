// LeetCode #2716: Minimize String Length -- the bits arm. A letter's
// place in the alphabet is a bit of a `u32` mask, set by `fold` over the
// string's bytes, and the answer is the mask's `count_ones`. O(n).

fn minimized_string_length(s: String) -> i64 {
    let mask = s.bytes().iter().fold(0u32, |m, b| m | (1u32 << (b - b'a')));
    mask.count_ones()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters, each one of the first `letters` of the alphabet
fn random_word(seed: mut ref i64, n: i64, letters: i64) -> String {
    let mut word = String.new();
    for _ in 0..n {
        word.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    word
}

fn main() {
    // LeetCode's three examples; one letter; the alphabet; 100 a's,
    // LeetCode's longest; the alphabet backwards, four times over, cut
    // to 100
    println(f"{minimized_string_length("aaabc")}");
    println(f"{minimized_string_length("cbbd")}");
    println(f"{minimized_string_length("dddaaa")}");
    println(f"{minimized_string_length("q")}");
    println(f"{minimized_string_length("abcdefghijklmnopqrstuvwxyz")}");
    println(f"{minimized_string_length("a".repeat(100))}");
    let backwards = "zyxwvutsrqponmlkjihgfedcba".repeat(4);
    println(f"{minimized_string_length(backwards[0..100].to_string())}");
    // 5000 random strings of 1 to 100 letters from the first 1 to 26
    let mut seed = 2716;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..5000 {
        let n = next_random(mut seed) % 100 + 1;
        let letters = next_random(mut seed) % 26 + 1;
        let s = random_word(mut seed, n, letters);
        let length = minimized_string_length(s);
        sum += length;
        check = (check * 31 + length) % 1000000007;
    }
    println(f"5000 strings: lengths sum to {sum}, checksum {check}");
}
