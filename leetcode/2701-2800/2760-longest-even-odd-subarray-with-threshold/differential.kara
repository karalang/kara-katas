// LeetCode #2760: Longest Even Odd Subarray With Threshold -- the
// differential. The five arms, against the statement read literally:
// every pair l <= r, kept when nums[l] is even, every neighbouring pair
// in l..=r differs in parity, and every number in it is within the
// threshold, each condition asked by `all` over its own range. 3000
// random arrays of 1 to 15 numbers up to 10, thresholds up to 10; then
// 500 of up to 100 numbers up to 100. Every case is drawn before any arm
// answers.
//
// P1  the answer is the literal reading's
// P2  every number and the threshold 2 more: the same answer
// P3  the threshold raised to 100: no shorter; and lowered below every
//     number: 0
// P4  an odd number put at the front: the same answer
// P5  from 0 to n, and 0 just when no even number is within the threshold
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64], threshold: i64) -> i64 {
    let n = nums.len();
    let mut best = 0;
    for l in 0..n {
        for r in l..n {
            let even_start = nums[l] % 2 == 0;
            let alternating = (l..r).all(|i| nums[i] % 2 != nums[i + 1] % 2);
            let within = (l..=r).all(|i| nums[i] <= threshold);
            if even_start and alternating and within {
                best = best.max(r - l + 1);
            }
        }
    }
    best
}


// ---- star (threshold.kara) ------------------------------------------

fn star_longest_alternating_subarray(nums: Vec[i64], threshold: i64) -> i64 {
    let mut best = 0;
    let mut run = 0;
    for i in 0..nums.len() {
        let x = nums[i];
        if x > threshold {
            run = 0;
        } else if run > 0 and x % 2 != nums[i - 1] % 2 {
            run += 1;
        } else if x % 2 == 0 {
            run = 1;
        } else {
            run = 0;
        }
        best = best.max(run);
    }
    best
}


// ---- brute (threshold_brute.kara) -----------------------------------

fn brute_longest_alternating_subarray(nums: Vec[i64], threshold: i64) -> i64 {
    let n = nums.len();
    let mut best = 0;
    for l in 0..n {
        for r in l..n {
            let mut good = nums[l] % 2 == 0;
            for i in l..=r {
                if nums[i] > threshold {
                    good = false;
                }
                if i < r and nums[i] % 2 == nums[i + 1] % 2 {
                    good = false;
                }
            }
            if good {
                best = best.max(r - l + 1);
            }
        }
    }
    best
}


// ---- pairs (threshold_pairs.kara) -----------------------------------

fn pairs_longest_alternating_subarray(nums: Vec[i64], threshold: i64) -> i64 {
    let joins: Vec[bool] = nums
        .iter()
        .zip(nums.iter().skip(1))
        .map(|(a, b)| a <= threshold and b <= threshold and a % 2 != b % 2)
        .collect();
    let mut best = 0;
    let mut i = 0;
    while i < nums.len() {
        if nums[i] % 2 == 0 and nums[i] <= threshold {
            let mut end = i;
            while end < joins.len() and joins[end] {
                end += 1;
            }
            best = best.max(end - i + 1);
            i = end + 1;
        } else {
            i += 1;
        }
    }
    best
}


// ---- dp (threshold_dp.kara) -----------------------------------------

fn dp_longest_alternating_subarray(nums: Vec[i64], threshold: i64) -> i64 {
    let starts = |x: i64| x % 2 == 0 and x <= threshold;
    let mut ending: Vec[i64] = Vec.filled(nums.len(), 0);
    for i in 0..nums.len() {
        let follows = i > 0 and ending[i - 1] > 0 and nums[i] <= threshold and nums[i] % 2 != nums[i - 1] % 2;
        ending[i] = if follows { ending[i - 1] + 1 } else if starts(nums[i]) { 1 } else { 0 };
    }
    ending.iter().max().unwrap_or(0)
}


// ---- solution (threshold_solution.kara) -----------------------------

struct Solution {}

impl Solution {
    pub fn longest_alternating_subarray(nums: Vec[i32], threshold: i32) -> i32 {
        let n = nums.len();
        let mut ans = 0;
        for l in 0..n {
            if nums[l] % 2 == 0 and nums[l] <= threshold {
                let mut r = l + 1;
                while r < n and nums[r] <= threshold and nums[r] % 2 != nums[r - 1] % 2 {
                    r += 1;
                }
                ans = ans.max(r - l);
            }
        }
        ans as i32
    }
}

fn solution_longest_alternating_subarray(nums: Vec[i64], threshold: i64) -> i64 {
    Solution.longest_alternating_subarray(nums.iter().map(|x| x as i32).collect(), threshold as i32)
}


fn answer(arm: i64, nums: Vec[i64], threshold: i64) -> i64 {
    match arm {
        0 => star_longest_alternating_subarray(nums, threshold),
        1 => brute_longest_alternating_subarray(nums, threshold),
        2 => pairs_longest_alternating_subarray(nums, threshold),
        3 => dp_longest_alternating_subarray(nums, threshold),
        _ => solution_longest_alternating_subarray(nums, threshold),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "brute", "pairs", "dp", "solution"];
    let mut seed = 2760;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for c in 0..3500 {
        let (most, top) = if c < 3000 { (15, 10) } else { (100, 100) };
        let n = next_random(mut seed) % most + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let threshold = next_random(mut seed) % top + 1;
        cases.push((nums, threshold));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (nums, threshold)) in cases.iter().enumerate() {
        let want = literal(nums, threshold);
        check = (check * 31 + want + 1) % 1000000007;
        let n = nums.len();
        let raised: Vec[i64] = nums.iter().map(|x| x + 2).collect();
        let mut odd_first: Vec[i64] = [threshold % 2 * 2 + 1].to_vec();
        odd_first.extend(nums.iter());
        let any_start = nums.iter().any(|x| x % 2 == 0 and x <= threshold);
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums, threshold)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == want,
                answer(arm, raised, threshold + 2) == value,
                answer(arm, nums, 100) >= value and answer(arm, nums, 0) == 0,
                answer(arm, odd_first, threshold) == value,
                0 <= value and value <= n and (value == 0) == not any_start,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums} {threshold}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
