// LeetCode #2760: Longest Even Odd Subarray With Threshold -- the dp arm.
// `ending[i]`, the longest good subarray ending at i, from `ending[i - 1]`
// when the two may stand together, else 1 or 0 by whether i can start
// one; the answer is the largest by `iter().max()`. O(n).

fn longest_alternating_subarray(nums: Vec[i64], threshold: i64) -> i64 {
    let starts = |x: i64| x % 2 == 0 and x <= threshold;
    let mut ending: Vec[i64] = Vec.filled(nums.len(), 0);
    for i in 0..nums.len() {
        let follows = i > 0 and ending[i - 1] > 0 and nums[i] <= threshold and nums[i] % 2 != nums[i - 1] % 2;
        ending[i] = if follows { ending[i - 1] + 1 } else if starts(nums[i]) { 1 } else { 0 };
    }
    ending.iter().max().unwrap_or(0)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples
    println(f"{longest_alternating_subarray([3, 2, 5, 4].to_vec(), 5)}");
    println(f"{longest_alternating_subarray([1, 2].to_vec(), 2)}");
    println(f"{longest_alternating_subarray([2, 3, 4, 5].to_vec(), 4)}");
    // no even number; 100 numbers alternating from 2, LeetCode's most; and
    // a run cut short by a number over the threshold
    println(f"{longest_alternating_subarray([1, 3, 5].to_vec(), 100)}");
    let turns: Vec[i64] = (0..100).map(|i| 2 + i % 2).collect();
    println(f"{longest_alternating_subarray(turns, 3)}");
    println(f"{longest_alternating_subarray([2, 3, 4, 50, 6, 7].to_vec(), 10)}");
    // 20000 random arrays of 1 to 100 numbers from 1 to 100, thresholds
    // from 1 to 100
    let mut seed = 2760;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..20000 {
        let n = next_random(mut seed) % 100 + 1;
        let top = next_random(mut seed) % 100 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let threshold = next_random(mut seed) % 100 + 1;
        let length = longest_alternating_subarray(nums, threshold);
        sum += length;
        check = (check * 31 + length) % 1000000007;
    }
    println(f"20000 arrays: lengths sum to {sum}, checksum {check}");
}
