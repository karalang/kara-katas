// LeetCode #2781: Length of the Longest Valid Substring -- the bench: the
// ★ arm over 10 words of 10^5 letters from a to e, each against 10^5
// forbidden words of 8 to 10 letters, LeetCode's most, all drawn first,
// then each answered 5 times, every answer building its own set.

fn longest_valid_substring(word: String, forbidden: Vec[String]) -> i64 {
    let banned: Set[String] = forbidden.iter().map(|w| w.clone()).collect();
    let n = word.len();
    let mut start = 0;
    let mut best = 0;
    for j in 0..n {
        let mut i = j;
        while i >= start and i + 10 > j {
            if banned.contains(word[i..j + 1]) {
                start = i + 1;
                break;
            }
            i -= 1;
        }
        best = best.max(j + 1 - start);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, n: i64, letters: i64) -> String {
    let mut word = String.new();
    for _ in 0..n {
        word.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    word
}

fn random_words(seed: mut ref i64, count: i64, shortest: i64, longest: i64, letters: i64) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    for _ in 0..count {
        let n = shortest + next_random(mut seed) % (longest - shortest + 1);
        words.push(random_word(mut seed, n, letters));
    }
    words
}

fn main() {
    let count = 10;
    let rounds = 5;
    let mut seed = 2781;
    let mut cases: Vec[(String, Vec[String])] = Vec.new();
    for _ in 0..count {
        let word = random_word(mut seed, 100000, 5);
        cases.push((word, random_words(mut seed, 100000, 8, 10, 5)));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (word, forbidden) in cases.iter() {
            let a = longest_valid_substring(word, forbidden);
            total += a;
            check = (check * 31 + a + 1 + r) % 1000000007;
        }
    }
    println(f"{count} words of 10^5, {rounds} rounds: lengths sum to {total}, checksum {check}");
}
