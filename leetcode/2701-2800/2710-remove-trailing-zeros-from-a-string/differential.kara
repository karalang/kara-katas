// LeetCode #2710: Remove Trailing Zeros From a String -- the
// differential. The five arms, against the statement read literally:
// the shortest prefix that gives the number back when only zeros are
// written after it, every prefix tried from the shortest. 1000 random
// numbers of 1 to 12 digits and 200 of up to 980, zeros 0 to 3 times in
// 4, each with 0 to 3 zeros more on the end. Every case is drawn before
// any arm answers.
//
// P1  the answer is the literal reading's
// P2  the answer does not end in a zero and begins the number
// P3  1 to 20 zeros more on the end: the same answer
// P4  the answer with as many zeros written after it as it is shorter:
//     the number
// P5  the answer's own answer is itself
// P6  each arm agrees with at least three of the other four


// ---- star (zeros.kara) ----------------------------------------------

fn star_remove_trailing_zeros(num: String) -> String {
    let digits = num.bytes();
    let mut end = digits.len();
    while digits[end - 1] == b'0' {
        end -= 1;
    }
    num.slice(0, end).to_string()
}


// ---- strip (zeros_strip.kara) ---------------------------------------

fn strip_remove_trailing_zeros(num: String) -> String {
    let mut rest: Str = num.as_str();
    while let Some(shorter) = rest.strip_suffix("0") {
        rest = shorter;
    }
    rest.to_string()
}


// ---- iter (zeros_iter.kara) -----------------------------------------

fn iter_remove_trailing_zeros(num: String) -> String {
    let kept: Vec[char] = num.chars().rev().skip_while(|c| c == '0').collect();
    kept.iter().rev().collect()
}


// ---- position (zeros_position.kara) ---------------------------------

fn position_remove_trailing_zeros(num: String) -> String {
    let last = num.bytes().iter().rposition(|b| b != b'0').unwrap();
    num[0..last + 1].to_string()
}


// ---- solution (zeros_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn remove_trailing_zeros(num: own String) -> String {
        let mut num = num;
        while num.ends_with("0") {
            num.pop();
        }
        num
    }
}

fn solution_remove_trailing_zeros(num: String) -> String {
    Solution.remove_trailing_zeros(num.clone())
}

// ---- the statement read literally ------------------------------------------

// the number with its trailing zeros removed is the shortest prefix that
// gives the number back when only zeros are written after it: every
// prefix tried from the shortest, its tail held to be all zeros
fn literal(num: String) -> String {
    let n = num.len();
    for k in 1..n + 1 {
        if num.slice(k, n) == "0".repeat(n - k) {
            return num.slice(0, k).to_string();
        }
    }
    num.clone()
}

fn answer(arm: i64, num: String) -> String {
    match arm {
        0 => star_remove_trailing_zeros(num),
        1 => strip_remove_trailing_zeros(num),
        2 => iter_remove_trailing_zeros(num),
        3 => position_remove_trailing_zeros(num),
        _ => solution_remove_trailing_zeros(num),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_number(seed: mut ref i64, n: i64, zeros_in_4: i64) -> String {
    let mut digits = String.new();
    digits.push((b'1' + (next_random(mut seed) % 9) as u8) as char);
    for _ in 0..n - 1 {
        if next_random(mut seed) % 4 < zeros_in_4 {
            digits.push('0');
        } else {
            digits.push((b'0' + (next_random(mut seed) % 10) as u8) as char);
        }
    }
    digits
}

fn fold(check: i64, text: Str) -> i64 {
    let mut check = check;
    for c in text.chars() {
        check = (check * 131 + c as i64) % 1000000007;
    }
    (check * 131 + text.len()) % 1000000007
}

fn main() {
    let names = ["star", "strip", "iter", "position", "solution"];
    let mut seed = 2710;
    // (number, how many zeros to append)
    let mut cases: Vec[(String, i64)] = Vec.new();
    for c in 0..1200 {
        let n = if c < 1000 { next_random(mut seed) % 12 + 1 } else { next_random(mut seed) % 980 + 1 };
        let zeros = next_random(mut seed) % 4;
        let mut num = random_number(mut seed, n, zeros);
        num.push_str("0".repeat(next_random(mut seed) % 4));
        cases.push((num, next_random(mut seed) % 20 + 1));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (num, more)) in cases.iter().enumerate() {
        let truth = literal(num);
        check = fold(check, truth);
        let padded = f"{num}{"0".repeat(more)}";
        let got: Vec[String] = (0..5).map(|arm| answer(arm, num)).collect();
        for arm in 0..5 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == truth,
                not value.ends_with("0") and num.starts_with(value),
                answer(arm, padded) == value,
                f"{value}{"0".repeat(num.len() - value.len())}" == num,
                answer(arm, value) == value,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
