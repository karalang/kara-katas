// LeetCode #2791: Count Paths That Can Form a Palindrome in a Tree -- a
// Rust solution as LeetCode's Rust users write it, carried to Kāra by
// `karac fix`: the children as `Vec<Vec<usize>>`, the masks by an
// explicit stack, and a `HashMap<i32, i64>` of the masks seen so far,
// each node adding the count of its own mask and of the 26 one bit away.

struct Solution {}

impl Solution {
    pub fn count_palindrome_paths(parent: Vec[i32], s: String) -> i64 {
        let n = parent.len();
        let s = s.bytes();
        let mut g: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
        for i in 1..n {
            g[parent[i]].push(i);
        }
        let mut cnt: Map[i32, i64] = Map.new();
        let mut ans: i64 = 0;
        let mut stack = [(0, 0i32)];
        while let Some((u, m)) = stack.pop() {
            if let Some(c) = cnt.get(m).cloned() {
                ans += c;
            }
            for b in 0..26 {
                if let Some(c) = cnt.get(m ^ (1 << b)).cloned() {
                    ans += c;
                }
            }
            *cnt.entry(m).or_insert(0) += 1;
            for v in ref g[u] {
                stack.push((v, m ^ (1 << (s[v] - b'a'))));
            }
        }
        ans
    }
}

fn count_palindrome_paths(parent: Vec[i64], s: Str) -> i64 {
    Solution.count_palindrome_paths(parent.iter().map(|p| p as i32).collect(), s.to_string())
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// a random tree of n nodes, each node's parent one before it, with
// letters from the first `letters` of the alphabet
fn random_tree(n: i64, letters: i64, seed: mut ref i64) -> (Vec[i64], String) {
    let mut parent: Vec[i64] = [-1];
    for i in 1..n {
        parent.push(wide(mut seed) % i);
    }
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut s = String.new();
    for _ in 0..n {
        s.push(alphabet[next_random(mut seed) % letters]);
    }
    (parent, s)
}

fn main() {
    // LeetCode's two examples; a path of 10^5 nodes, LeetCode's most, all
    // a, every pair counted, and deepest from the root; 10^5 nodes on one
    // root, the letters going round the alphabet
    println(f"{count_palindrome_paths([-1, 0, 0, 1, 1, 2], "acaabc")}");
    println(f"{count_palindrome_paths([-1, 0, 0, 0, 0], "aaaaa")}");
    let n = 100000;
    let path: Vec[i64] = (0..n).map(|i| i - 1).collect();
    println(f"{count_palindrome_paths(path, "a".repeat(n))}");
    let star: Vec[i64] = (0..n).map(|i| if i == 0 { -1 } else { 0 }).collect();
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let round: String = (0..n).map(|i| alphabet[i % 26]).collect();
    println(f"{count_palindrome_paths(star, round)}");
    // 3000 random trees of 1 to 12 nodes with letters from a to c; then
    // 20 of 10^5 nodes with letters from a to z
    let mut seed = 2791;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let m = next_random(mut seed) % 12 + 1;
        let (parent, s) = random_tree(m, 3, mut seed);
        let a = count_palindrome_paths(parent, s);
        sum += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"3000 small trees: paths sum to {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for _ in 0..20 {
        let (parent, s) = random_tree(n, 26, mut seed);
        let a = count_palindrome_paths(parent, s);
        sum += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"20 trees of 10^5: paths sum to {sum}, checksum {check}");
}
