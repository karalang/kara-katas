// LeetCode #2736: Maximum Sum Queries -- the segment arm. Online over the
// queries in their own order: nothing sorted by nums1, but a segment tree
// over the pairs sorted by nums2, each node holding the pairs of its
// range sorted by nums1 with suffix maxima of sums; a query takes the
// nodes covering nums2 >= y and binary-searches nums1 >= x in each: a
// merge-sort tree. O(n log^2 n) to build, O(log^2 n) a query.

struct Node {
    // (nums1, sum) sorted by nums1, and best[k] the largest sum from k on
    firsts: Vec[i64],
    best: Vec[i64],
}

fn build(points: Vec[(i64, i64)]) -> Node {
    let mut sorted = points.clone();
    sorted.sort_by(|a, b| a.0.cmp(b.0));
    let firsts: Vec[i64] = sorted.iter().map(|p| p.0).collect();
    let mut best: Vec[i64] = Vec.filled(sorted.len() + 1, -1);
    for k in (0..sorted.len()).rev() {
        best[k] = best[k + 1].max(sorted[k].1);
    }
    Node { firsts, best }
}

// the largest sum in a node among its pairs with nums1 >= x
fn node_best(node: ref Node, x: i64) -> i64 {
    let mut low = 0;
    let mut high = node.firsts.len();
    while low < high {
        let middle = (low + high) / 2;
        if node.firsts[middle] >= x {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    node.best[low]
}

fn maximum_sum_queries(nums1: Vec[i64], nums2: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let n = nums1.len();
    let mut by_second: Vec[(i64, i64, i64)] = (0..n).map(|i| (nums2[i], nums1[i], nums1[i] + nums2[i])).collect();
    by_second.sort_by(|a, b| a.0.cmp(b.0));
    let seconds: Vec[i64] = by_second.iter().map(|p| p.0).collect();
    let mut size = 1;
    while size < n {
        size *= 2;
    }
    // leaves size..size + n hold one pair each; node k covers 2k and 2k + 1
    let mut leaves: Vec[Vec[(i64, i64)]] = Vec.filled(2 * size, Vec.new());
    for i in 0..n {
        leaves[size + i] = [(by_second[i].1, by_second[i].2)].to_vec();
    }
    for k in (1..size).rev() {
        let mut both = leaves[2 * k].clone();
        both.extend(leaves[2 * k + 1].iter());
        leaves[k] = both;
    }
    let tree: Vec[Node] = leaves.iter().map(|points| build(points)).collect();
    queries.iter().map(|query| {
        // the first pair, in nums2 order, with nums2 >= y
        let mut low = 0;
        let mut high = n;
        while low < high {
            let middle = (low + high) / 2;
            if seconds[middle] >= query[1] {
                high = middle;
            } else {
                low = middle + 1;
            }
        }
        let mut left = low + size;
        let mut right = n + size;
        let mut best = -1;
        while left < right {
            if left % 2 == 1 {
                best = best.max(node_best(tree[left], query[0]));
                left += 1;
            }
            if right % 2 == 1 {
                right -= 1;
                best = best.max(node_best(tree[right], query[0]));
            }
            left /= 2;
            right /= 2;
        }
        best
    }).collect()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a number from 1 to most, most up to 10^9
fn random_up_to(seed: mut ref i64, most: i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1
}

fn main() {
    // LeetCode's three examples
    println(f"{maximum_sum_queries([4, 3, 1, 2].to_vec(), [2, 4, 9, 5].to_vec(), [[4, 1].to_vec(), [1, 3].to_vec(), [2, 5].to_vec()].to_vec())}");
    println(f"{maximum_sum_queries([3, 2, 5].to_vec(), [2, 3, 4].to_vec(), [[4, 4].to_vec(), [3, 2].to_vec(), [1, 1].to_vec()].to_vec())}");
    println(f"{maximum_sum_queries([2, 1].to_vec(), [2, 3].to_vec(), [[3, 3].to_vec()].to_vec())}");
    // 1000 random cases of 1 to 20 pairs and queries up to 30; then 10 of
    // 2000 pairs and 2000 queries up to 10^9
    let mut seed = 2736;
    let mut sum = 0;
    let mut check = 0;
    for c in 0..1010 {
        let (n, q, most) = if c < 1000 { (next_random(mut seed) % 20 + 1, next_random(mut seed) % 20 + 1, 30) } else { (2000, 2000, 1000000000) };
        let nums1: Vec[i64] = (0..n).map(|_| random_up_to(mut seed, most)).collect();
        let nums2: Vec[i64] = (0..n).map(|_| random_up_to(mut seed, most)).collect();
        let queries: Vec[Vec[i64]] = (0..q).map(|_| [random_up_to(mut seed, most), random_up_to(mut seed, most)].to_vec()).collect();
        for best in maximum_sum_queries(nums1, nums2, queries).iter() {
            sum += best;
            check = (check * 31 + best + 1) % 1000000007;
        }
        if c == 999 {
            println(f"1000 small cases: answers sum to {sum}, checksum {check}");
            sum = 0;
            check = 0;
        }
    }
    println(f"10 cases of 2000 pairs: answers sum to {sum}, checksum {check}");
}
