// LeetCode #2733: Neither Minimum nor Maximum -- the differential. The
// five arms, against the statement read literally: a number is an answer
// when some number of the array is smaller and some larger; no least or
// greatest is found. 2000 random arrays of 1 to 10 distinct numbers from
// 1 to 100; then 500 of 1 to 100. Every case is drawn before any arm
// answers. Arms may name different numbers, so what is compared is
// whether one is named, and each is checked.
//
// P1  the answer is one the literal reading allows, and -1 exactly when
//     it allows none
// P2  the array reversed: a number named or not, the same
// P3  every number x made 101 - x: a number named or not, the same, and
//     the number named there allowed there
// P4  every number doubled: a number named or not, the same
// P5  a number is named exactly when there are three or more
// P6  each arm agrees with at least three of the other four on whether
//     a number is named


// ---- star (neither.kara) --------------------------------------------

fn star_find_non_min_or_max(nums: Vec[i64]) -> i64 {
    let mut low = nums[0];
    let mut high = nums[0];
    for x in nums.iter() {
        low = low.min(x);
        high = high.max(x);
    }
    for x in nums.iter() {
        if x != low and x != high {
            return x;
        }
    }
    -1
}


// ---- three (neither_three.kara) -------------------------------------

fn three_find_non_min_or_max(nums: Vec[i64]) -> i64 {
    if nums.len() < 3 {
        return -1;
    }
    let mut three: Array[i64, 3] = [nums[0], nums[1], nums[2]];
    three.sort();
    three[1]
}


// ---- sort (neither_sort.kara) ---------------------------------------

fn sort_find_non_min_or_max(nums: Vec[i64]) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    if sorted.len() >= 3 { sorted[1] } else { -1 }
}


// ---- find (neither_find.kara) ---------------------------------------

fn find_find_non_min_or_max(nums: Vec[i64]) -> i64 {
    let low = nums.iter().min().unwrap();
    let high = nums.iter().max().unwrap();
    nums.iter().find(|x| x != low and x != high).unwrap_or(-1)
}


// ---- solution (neither_solution.kara) -------------------------------

struct Solution {}

impl Solution {
    pub fn find_non_min_or_max(nums: Vec[i32]) -> i32 {
        if nums.len() < 3 {
            return -1;
        }
        let mut v = nums[..3].to_vec();
        v.sort();
        v[1]
    }
}

fn solution_find_non_min_or_max(nums: Vec[i64]) -> i64 {
    let nums: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.find_non_min_or_max(nums)
}


// ---- the statement read literally ------------------------------------------

// x may be answered when some number is below it and some above it
fn allowed(nums: Vec[i64], x: i64) -> bool {
    let mut below = false;
    let mut above = false;
    for y in nums.iter() {
        if y < x {
            below = true;
        }
        if y > x {
            above = true;
        }
    }
    nums.contains(x) and below and above
}

fn literal(nums: Vec[i64], answer: i64) -> bool {
    let any = nums.iter().any(|x| allowed(nums, x));
    if answer == -1 { not any } else { allowed(nums, answer) }
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_find_non_min_or_max(nums),
        1 => three_find_non_min_or_max(nums),
        2 => sort_find_non_min_or_max(nums),
        3 => find_find_non_min_or_max(nums),
        _ => solution_find_non_min_or_max(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_numbers(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut all: Vec[i64] = (1..=100).collect();
    for i in (1..100).rev() {
        let j = next_random(mut seed) % (i + 1);
        all.swap(i, j);
    }
    all.truncate(n);
    all
}

fn main() {
    let names = ["star", "three", "sort", "find", "solution"];
    let mut seed = 2733;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2500 {
        let n = if c < 2000 { next_random(mut seed) % 10 + 1 } else { next_random(mut seed) % 100 + 1 };
        cases.push(random_numbers(mut seed, n));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nums) in cases.iter().enumerate() {
        let some = nums.iter().any(|x| allowed(nums, x));
        check = (check * 31 + if some { 1 } else { 0 }) % 1000000007;
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let turned: Vec[i64] = nums.iter().map(|x| 101 - x).collect();
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let got: Vec[bool] = (0..5).map(|arm| answer(arm, nums) != -1).collect();
        for arm in 0..5 {
            let value = answer(arm, nums);
            let named = value != -1;
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == named {
                    same += 1;
                }
            }
            let there = answer(arm, turned);
            let verdicts = [
                literal(nums, value),
                (answer(arm, reversed) != -1) == named,
                (there != -1) == named and literal(turned, there),
                (answer(arm, doubled) != -1) == named,
                named == (nums.len() >= 3),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
