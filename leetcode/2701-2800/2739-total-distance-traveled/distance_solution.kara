// LeetCode #2739: Total Distance Traveled -- a Rust solution as
// LeetCode's Rust users write it, carried to Kāra by `karac fix`: the
// parameters taken `mut` and driven down five liters at a time.

struct Solution {}

impl Solution {
    pub fn distance_traveled(main_tank: i32, additional_tank: i32) -> i32 {
        let mut main_tank = main_tank;
        let mut additional_tank = additional_tank;
        let mut ans: i32 = 0;
        while main_tank >= 5 {
            main_tank -= 5;
            ans += 50;
            if additional_tank > 0 {
                additional_tank -= 1;
                main_tank += 1;
            }
        }
        ans + main_tank * 10
    }
}

fn distance_traveled(main_tank: i64, additional_tank: i64) -> i64 {
    Solution.distance_traveled(main_tank as i32, additional_tank as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples
    println(f"{distance_traveled(5, 10)}");
    println(f"{distance_traveled(1, 2)}");
    // one liter in each; four in the main tank, too few for any transfer;
    // five, just enough for one; nine and two, both transfers used; and
    // LeetCode's largest tanks
    println(f"{distance_traveled(1, 1)}");
    println(f"{distance_traveled(4, 100)}");
    println(f"{distance_traveled(5, 1)}");
    println(f"{distance_traveled(9, 2)}");
    println(f"{distance_traveled(100, 100)}");
    // every pair of tanks LeetCode allows, 1 to 100 liters each
    let mut sum = 0;
    let mut check = 0;
    for main_tank in 1..=100 {
        for additional_tank in 1..=100 {
            let d = distance_traveled(main_tank, additional_tank);
            sum += d;
            check = (check * 31 + d) % 1000000007;
        }
    }
    println(f"10000 pairs of tanks: distances sum to {sum}, checksum {check}");
}
