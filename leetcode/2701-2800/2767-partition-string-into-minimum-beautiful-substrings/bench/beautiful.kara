// LeetCode #2767: Partition String Into Minimum Beautiful Substrings --
// the bench. The ★ arm (beautiful.kara) over 100000 strings of 15 binary
// digits, LeetCode's most: powers of 5 joined while they fit, the rest
// filled with random digits, then half the time one place flipped. All
// the strings drawn first, then each answered 5 times.

fn is_power_of_five(v: i64) -> bool {
    let mut v = v;
    while v > 1 and v % 5 == 0 {
        v /= 5;
    }
    v == 1
}

fn minimum_beautiful_substrings(s: String) -> i64 {
    let n = s.len();
    let mut best: Vec[i64] = Vec.filled(n + 1, -1);
    best[0] = 0;
    for i in 1..=n {
        for j in 0..i {
            if best[j] < 0 or s[j..j + 1] != "1" {
                continue;
            }
            let value = i64.from_str_radix(s[j..i], 2).unwrap();
            if is_power_of_five(value) and (best[i] < 0 or best[j] + 1 < best[i]) {
                best[i] = best[j] + 1;
            }
        }
    }
    best[n]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100000;
    let rounds = 5;
    let powers = ["1", "101", "11001", "1111101", "1001110001", "110000110101", "11110100001001"];
    let mut seed = 2767;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..count {
        let mut s = String.new();
        loop {
            let p = ref powers[next_random(mut seed) % 7];
            if s.len() + p.len() > 15 {
                break;
            }
            s.push_str(p);
        }
        while s.len() < 15 {
            s.push_str(if next_random(mut seed) % 2 == 1 { "1" } else { "0" });
        }
        if next_random(mut seed) % 2 == 1 {
            let k = next_random(mut seed) % 15;
            let flipped = if s[k..k + 1] == "1" { "0" } else { "1" };
            s = f"{s[..k]}{flipped}{s[k + 1..]}";
        }
        strings.push(s);
    }
    let mut split = 0;
    let mut pieces = 0;
    let mut check = 0;
    for r in 0..rounds {
        for s in strings.iter() {
            let a = minimum_beautiful_substrings(s);
            if a > 0 {
                split += 1;
                pieces += a;
            }
            check = (check * 31 + a + 1 + r) % 1000000007;
        }
    }
    println(f"{count} strings of 15, {rounds} rounds: {split} split, pieces sum to {pieces}, checksum {check}");
}
