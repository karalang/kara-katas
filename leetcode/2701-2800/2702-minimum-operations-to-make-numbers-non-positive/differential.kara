// LeetCode #2702: Minimum Operations to Make Numbers Non-positive -- the
// differential. The five arms, against the statement read literally:
// every choice of index tried, breadth first, from the numbers as given,
// until some sequence of choices leaves every number at or below zero.
// No counting of shares. 600 random cases of 1 to 4 numbers up to 10, y
// up to 4 and x up to 6 above it; then 100 of up to 50 numbers up to
// 1000; then 40 of up to 2000 numbers up to 10^9 or 4 * 10^8. Every case
// is drawn before any arm answers.
//
// P1  up to 4 numbers, the answer is the literal reading's
// P2  one number raised: the answer is no smaller
// P3  the numbers, x and y all multiplied by 2 to 5, within 10^9: the
//     same answer
// P4  a number of answer * y appended (at most 10^9): the same answer
// P5  the answer lies between the largest number over x and over y,
//     each rounded up, and its operations take at least the total
// P6  each arm agrees with at least three of the other four


// ---- star (nonpositive.kara) ----------------------------------------

fn star_min_operations(nums: Vec[i64], x: i64, y: i64) -> i64 {
    let mut low = 0;
    let mut high = nums.iter().max().unwrap() / y + 1;
    while low < high {
        let t = (low + high) / 2;
        let mut need = 0;
        for v in nums.iter() {
            if v > t * y {
                need += (v - t * y + x - y - 1) / (x - y);
                if need > t {
                    break;
                }
            }
        }
        if need <= t {
            high = t;
        } else {
            low = t + 1;
        }
    }
    low
}


// ---- sorted (nonpositive_sorted.kara) -------------------------------

fn sorted_min_operations(nums: Vec[i64], x: i64, y: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort_by(|a, b| b.cmp(a));
    let top = sorted[0];
    let mut low = (top + x - 1) / x;
    let mut high = (top + y - 1) / y;
    while low < high {
        let t = low + (high - low) / 2;
        let mut need = 0;
        let mut i = 0;
        while i < sorted.len() and sorted[i] > t * y and need <= t {
            need += (sorted[i] - t * y + x - y - 1) / (x - y);
            i += 1;
        }
        if need <= t {
            high = t;
        } else {
            low = t + 1;
        }
    }
    low
}


// ---- iter (nonpositive_iter.kara) -----------------------------------

fn iter_first_true(low: i64, high: i64, holds: Fn(i64) -> bool) -> i64 {
    let mut low = low;
    let mut high = high;
    while low < high {
        let mid = low + (high - low) / 2;
        if holds(mid) {
            high = mid;
        } else {
            low = mid + 1;
        }
    }
    low
}

fn iter_min_operations(nums: Vec[i64], x: i64, y: i64) -> i64 {
    let most = nums.iter().max().unwrap();
    let enough = |t: i64| {
        let need: i64 = nums.iter().filter(|v| v > t * y).map(|v| (v - t * y + x - y - 1) / (x - y)).sum();
        need <= t
    };
    iter_first_true(0, most / y + 1, enough)
}


// ---- gallop (nonpositive_gallop.kara) -------------------------------

fn gallop_suffices(nums: Vec[i64], x: i64, y: i64, t: i64) -> bool {
    let mut left = t;
    for i in 0..nums.len() {
        let over = nums[i] - t * y;
        if over > 0 {
            left -= (over + x - y - 1) / (x - y);
            if left < 0 {
                return false;
            }
        }
    }
    true
}

fn gallop_min_operations(nums: Vec[i64], x: i64, y: i64) -> i64 {
    if gallop_suffices(nums, x, y, 0) {
        return 0;
    }
    let mut failed = 0;
    let mut enough = 1;
    while not gallop_suffices(nums, x, y, enough) {
        failed = enough;
        enough *= 2;
    }
    while enough - failed > 1 {
        let mid = (failed + enough) / 2;
        if gallop_suffices(nums, x, y, mid) {
            enough = mid;
        } else {
            failed = mid;
        }
    }
    enough
}


// ---- solution (nonpositive_solution.kara) ---------------------------

struct Solution {}

impl Solution {
    pub fn min_operations(nums: Vec[i32], x: i32, y: i32) -> i32 {
        let (x, y) = (x as i64, y as i64);
        let mut lo = 0;
        let mut hi = *nums.iter().max().unwrap() / y + 1;
        let check = |t: i64| {
            let mut cnt = 0;
            for v in nums.iter() {
                let v = v as i64;
                if v > t * y {
                    cnt += (v - t * y + x - y - 1) / (x - y);
                }
            }
            cnt <= t
        };
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if check(mid) {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        lo as i32
    }
}

fn solution_min_operations(nums: Vec[i64], x: i64, y: i64) -> i64 {
    let narrow: Vec[i32] = nums.iter().map(|v| v as i32).collect();
    Solution.min_operations(narrow, x as i32, y as i32)
}

// ---- the statement read literally ------------------------------------------

// every choice of index tried, breadth first, from the numbers as given:
// the first round in which some sequence of choices leaves every number
// at or below zero. Numbers already there are kept at zero, which
// changes no later choice.
fn literal(nums: Vec[i64], x: i64, y: i64) -> i64 {
    let n = nums.len();
    let start: Vec[i64] = nums.iter().map(|v| v.max(0)).collect();
    let mut seen: Set[Vec[i64]] = Set.new();
    seen.insert(start.clone());
    let mut layer: Vec[Vec[i64]] = [start].to_vec();
    let mut rounds = 0;
    loop {
        for state in layer.iter() {
            if state.iter().all(|v| v == 0) {
                return rounds;
            }
        }
        let mut next: Vec[Vec[i64]] = Vec.new();
        for state in layer.iter() {
            for i in 0..n {
                let after: Vec[i64] = (0..n).map(|j| (state[j] - if j == i { x } else { y }).max(0)).collect();
                if not seen.contains(after) {
                    seen.insert(after.clone());
                    next.push(after);
                }
            }
        }
        layer = next;
        rounds += 1;
    }
}

fn answer(arm: i64, nums: Vec[i64], x: i64, y: i64) -> i64 {
    match arm {
        0 => star_min_operations(nums, x, y),
        1 => sorted_min_operations(nums, x, y),
        2 => iter_min_operations(nums, x, y),
        3 => gallop_min_operations(nums, x, y),
        _ => solution_min_operations(nums, x, y),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "sorted", "iter", "gallop", "solution"];
    let mut seed = 2702;
    // (numbers, x, y, which number to raise, by how much, the scale)
    let mut cases: Vec[(Vec[i64], i64, i64, i64, i64, i64)] = Vec.new();
    for c in 0..740 {
        let (n, most, ys) = if c < 600 {
            (next_random(mut seed) % 4 + 1, 10, 4)
        } else if c < 700 {
            (next_random(mut seed) % 50 + 1, 1000, 100)
        } else {
            (next_random(mut seed) % 2000 + 1, if c % 2 == 0 { 1000000000 } else { 400000000 }, 0)
        };
        let nums: Vec[i64] = (0..n).map(|_| wide(mut seed) % most + 1).collect();
        let y = if ys > 0 { next_random(mut seed) % ys + 1 } else { wide(mut seed) % (most - 1) + 1 };
        let x = if ys > 0 { y + next_random(mut seed) % (ys + 2) + 1 } else { y + wide(mut seed) % (most - y) + 1 };
        let raise = next_random(mut seed) % n;
        let by = next_random(mut seed) % 10 + 1;
        let scale = next_random(mut seed) % 4 + 2;
        cases.push((nums, x, y, raise, by, scale));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (nums, x, y, raise, by, scale)) in cases.iter().enumerate() {
        let small = c < 600;
        let truth = if small { literal(nums, x, y) } else { -1 };
        if small {
            check = (check * 31 + truth) % 1000000007;
        }
        let top = nums.iter().max().unwrap();
        let total: i64 = nums.iter().sum();
        let mut raised = nums.clone();
        raised[raise] = (raised[raise] + by).min(1000000000);
        let scalable = top * scale <= 1000000000 and x * scale <= 1000000000;
        let scaled: Vec[i64] = nums.iter().map(|v| v * scale).collect();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums, x, y)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let mut longer = nums.clone();
            longer.push((value * y).min(1000000000).max(1));
            let verdicts = [
                not small or value == truth,
                answer(arm, raised, x, y) >= value,
                not scalable or answer(arm, scaled, x * scale, y * scale) == value,
                value * y < 1 or answer(arm, longer, x, y) == value,
                (top + x - 1) / x <= value and value <= (top + y - 1) / y and value * (x + (nums.len() - 1) * y) >= total,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c}, arm {names[arm]}: P{q + 1} fails, gave {value}, literal {truth}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
