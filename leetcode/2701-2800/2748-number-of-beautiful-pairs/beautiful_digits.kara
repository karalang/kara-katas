// LeetCode #2748: Number of Beautiful Pairs -- the digits arm. Each
// number written out by `to_string()`, its first and last digits read as
// `char`s by `to_digit(10)`; every pair i < j is tested against a
// coprime table built once as an `Array` of 10 by 10 `bool`s. O(n^2).

fn count_beautiful_pairs(nums: Vec[i64]) -> i64 {
    let mut coprime: Array[Array[bool, 10], 10] = [[false; 10]; 10];
    for a in 1..10 {
        for b in 1..10 {
            coprime[a][b] = (1..10).all(|d| a % d != 0 or b % d != 0 or d == 1);
        }
    }
    let texts: Vec[String] = nums.iter().map(|x| x.to_string()).collect();
    let digit = |c: Option[char]| c.unwrap().to_digit(10).unwrap() as i64;
    let mut pairs = 0;
    for i in 0..texts.len() {
        for j in i + 1..texts.len() {
            if coprime[digit(texts[i].chars().next())][digit(texts[j].chars().last())] {
                pairs += 1;
            }
        }
    }
    pairs
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{count_beautiful_pairs([2, 5, 1, 4].to_vec())}");
    println(f"{count_beautiful_pairs([11, 21, 12].to_vec())}");
    // 100 ones, every pair beautiful; 100 of 22, none; LeetCode's largest
    // and smallest numbers
    println(f"{count_beautiful_pairs(Vec.filled(100, 1))}");
    println(f"{count_beautiful_pairs(Vec.filled(100, 22))}");
    println(f"{count_beautiful_pairs([9999, 1, 9999, 1].to_vec())}");
    // 5000 random lists of 2 to 100 numbers from 1 to 9999, none a
    // multiple of 10
    let mut seed = 2748;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..5000 {
        let n = next_random(mut seed) % 99 + 2;
        let nums: Vec[i64] = (0..n).map(|_| {
            let x = next_random(mut seed) % 9999 + 1;
            if x % 10 == 0 { x + 1 } else { x }
        }).collect();
        let pairs = count_beautiful_pairs(nums);
        sum += pairs;
        check = (check * 31 + pairs) % 1000000007;
    }
    println(f"5000 lists: pairs sum to {sum}, checksum {check}");
}
