// LeetCode #2748: Number of Beautiful Pairs -- the differential. The five
// arms, against the statement read literally: every pair i < j, the first
// digit the first character of nums[i] written out and the last digit the
// last character of nums[j], coprime when no digit from 2 to 9 divides
// both. 2000 random lists of 2 to 30 numbers from 1 to 9999, none a
// multiple of 10; then 300 of up to 100. Every case is drawn before any
// arm answers.
//
// P1  the answer is the literal reading's
// P2  every number's digits reversed, and the list reversed: the same
//     answer
// P3  the tens digit of every number of 3 digits or more moved on 3: the
//     same answer
// P4  a 1 put at the end, and one put at the front: each n more
// P5  at most n (n - 1) / 2, and every last digit made 1: exactly that
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64]) -> i64 {
    let mut pairs = 0;
    for i in 0..nums.len() {
        for j in i + 1..nums.len() {
            let first = nums[i].to_string().chars().next().unwrap() as i64 - '0' as i64;
            let last = nums[j].to_string().chars().last().unwrap() as i64 - '0' as i64;
            let mut shared = false;
            for d in 2..=9 {
                if first % d == 0 and last % d == 0 {
                    shared = true;
                }
            }
            if not shared {
                pairs += 1;
            }
        }
    }
    pairs
}


// ---- star (beautiful.kara) ------------------------------------------

fn star_gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { star_gcd(b, a % b) }
}

fn star_count_beautiful_pairs(nums: Vec[i64]) -> i64 {
    let mut firsts: Array[i64, 10] = [0; 10];
    let mut pairs = 0;
    for x in nums.iter() {
        let last = x % 10;
        for d in 1..10 {
            if star_gcd(d, last) == 1 {
                pairs += firsts[d];
            }
        }
        let mut first = x;
        while first >= 10 {
            first /= 10;
        }
        firsts[first] += 1;
    }
    pairs
}


// ---- brute (beautiful_brute.kara) -----------------------------------

fn brute_count_beautiful_pairs(nums: Vec[i64]) -> i64 {
    let mut pairs = 0;
    for i in 0..nums.len() {
        let mut first = nums[i];
        while first >= 10 {
            first /= 10;
        }
        for j in i + 1..nums.len() {
            let mut (a, b) = (first, nums[j] % 10);
            while b != 0 {
                let r = a % b;
                a = b;
                b = r;
            }
            if a == 1 {
                pairs += 1;
            }
        }
    }
    pairs
}


// ---- digits (beautiful_digits.kara) ---------------------------------

fn digits_count_beautiful_pairs(nums: Vec[i64]) -> i64 {
    let mut coprime: Array[Array[bool, 10], 10] = [[false; 10]; 10];
    for a in 1..10 {
        for b in 1..10 {
            coprime[a][b] = (1..10).all(|d| a % d != 0 or b % d != 0 or d == 1);
        }
    }
    let texts: Vec[String] = nums.iter().map(|x| x.to_string()).collect();
    let digit = |c: Option[char]| c.unwrap().to_digit(10).unwrap() as i64;
    let mut pairs = 0;
    for i in 0..texts.len() {
        for j in i + 1..texts.len() {
            if coprime[digit(texts[i].chars().next())][digit(texts[j].chars().last())] {
                pairs += 1;
            }
        }
    }
    pairs
}


// ---- suffix (beautiful_suffix.kara) ---------------------------------

fn suffix_gcd(a: i64, b: i64) -> i64 {
    let mut a = a;
    let mut b = b;
    while b != 0 {
        let r = a % b;
        a = b;
        b = r;
    }
    a
}

fn suffix_count_beautiful_pairs(nums: Vec[i64]) -> i64 {
    let mut lasts: Vec[i64] = Vec.filled(10, 0);
    let mut pairs = 0;
    for x in nums.iter().rev() {
        let first = x.to_string().bytes()[0] as i64 - '0' as i64;
        pairs += (1..10).filter(|e| suffix_gcd(first, e) == 1).map(|e| lasts[e]).sum();
        lasts[x % 10] += 1;
    }
    pairs
}


// ---- solution (beautiful_solution.kara) -----------------------------

fn solution_gcd(a: i32, b: i32) -> i32 {
    if b == 0 { a } else { solution_gcd(b, a % b) }
}

struct Solution {}

impl Solution {
    pub fn count_beautiful_pairs(nums: Vec[i32]) -> i32 {
        let n = nums.len();
        let mut ans = 0;
        for i in 0..n {
            let first = nums[i].to_string().chars().next().unwrap().to_digit(10).unwrap() as i32;
            for j in i + 1..n {
                if solution_gcd(first, nums[j] % 10) == 1 {
                    ans += 1;
                }
            }
        }
        ans
    }
}

fn solution_count_beautiful_pairs(nums: Vec[i64]) -> i64 {
    Solution.count_beautiful_pairs(nums.iter().map(|x| x as i32).collect())
}


fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_count_beautiful_pairs(nums),
        1 => brute_count_beautiful_pairs(nums),
        2 => digits_count_beautiful_pairs(nums),
        3 => suffix_count_beautiful_pairs(nums),
        _ => solution_count_beautiful_pairs(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn reverse_digits(x: i64) -> i64 {
    let text: String = x.to_string().chars().rev().collect();
    i64.parse(text).unwrap()
}

fn main() {
    let names = ["star", "brute", "digits", "suffix", "solution"];
    let mut seed = 2748;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2300 {
        let most = if c < 2000 { 29 } else { 99 };
        let n = next_random(mut seed) % most + 2;
        let nums: Vec[i64] = (0..n).map(|_| {
            let x = next_random(mut seed) % 9999 + 1;
            if x % 10 == 0 { x + 1 } else { x }
        }).collect();
        cases.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nums) in cases.iter().enumerate() {
        let want = literal(nums);
        check = (check * 31 + want + 1) % 1000000007;
        let n = nums.len();
        let mirrored: Vec[i64] = nums.iter().rev().map(|x| reverse_digits(x)).collect();
        let moved: Vec[i64] = nums.iter().map(|x| if x >= 100 { x - (x / 10 % 10) * 10 + (x / 10 % 10 + 3) % 10 * 10 } else { x }).collect();
        let mut one_last = nums.clone();
        one_last.push(1);
        let mut one_first = nums.clone();
        one_first.insert(0, 1);
        let ones: Vec[i64] = nums.iter().map(|x| x - x % 10 + 1).collect();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == want,
                answer(arm, mirrored) == value,
                answer(arm, moved) == value,
                answer(arm, one_last) == value + n and answer(arm, one_first) == value + n,
                value <= n * (n - 1) / 2 and answer(arm, ones) == n * (n - 1) / 2,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
