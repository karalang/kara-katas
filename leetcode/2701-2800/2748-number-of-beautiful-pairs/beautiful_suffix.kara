// LeetCode #2748: Number of Beautiful Pairs -- the suffix arm. From the
// right: the last digits of the numbers after i counted in a `Vec` of
// 10, each number adding the counts of the last digits coprime to its
// first digit, by `iter().rev()`. O(9 n).

fn gcd(a: i64, b: i64) -> i64 {
    let mut a = a;
    let mut b = b;
    while b != 0 {
        let r = a % b;
        a = b;
        b = r;
    }
    a
}

fn count_beautiful_pairs(nums: Vec[i64]) -> i64 {
    let mut lasts: Vec[i64] = Vec.filled(10, 0);
    let mut pairs = 0;
    for x in nums.iter().rev() {
        let first = x.to_string().bytes()[0] as i64 - '0' as i64;
        pairs += (1..10).filter(|e| gcd(first, e) == 1).map(|e| lasts[e]).sum();
        lasts[x % 10] += 1;
    }
    pairs
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{count_beautiful_pairs([2, 5, 1, 4].to_vec())}");
    println(f"{count_beautiful_pairs([11, 21, 12].to_vec())}");
    // 100 ones, every pair beautiful; 100 of 22, none; LeetCode's largest
    // and smallest numbers
    println(f"{count_beautiful_pairs(Vec.filled(100, 1))}");
    println(f"{count_beautiful_pairs(Vec.filled(100, 22))}");
    println(f"{count_beautiful_pairs([9999, 1, 9999, 1].to_vec())}");
    // 5000 random lists of 2 to 100 numbers from 1 to 9999, none a
    // multiple of 10
    let mut seed = 2748;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..5000 {
        let n = next_random(mut seed) % 99 + 2;
        let nums: Vec[i64] = (0..n).map(|_| {
            let x = next_random(mut seed) % 9999 + 1;
            if x % 10 == 0 { x + 1 } else { x }
        }).collect();
        let pairs = count_beautiful_pairs(nums);
        sum += pairs;
        check = (check * 31 + pairs) % 1000000007;
    }
    println(f"5000 lists: pairs sum to {sum}, checksum {check}");
}
