// LeetCode #2748: Number of Beautiful Pairs -- the bench (beautiful.kara):
// the ★ arm, the first digits seen so far counted, each number adding
// the counts of the digits coprime to its last digit.

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}
fn count_beautiful_pairs(nums: Vec[i64]) -> i64 {
    let mut firsts: Array[i64, 10] = [0; 10];
    let mut pairs = 0;
    for x in nums.iter() {
        let last = x % 10;
        for d in 1..10 {
            if gcd(d, last) == 1 {
                pairs += firsts[d];
            }
        }
        let mut first = x;
        while first >= 10 {
            first /= 10;
        }
        firsts[first] += 1;
    }
    pairs
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 20000;
    let rounds = 10;
    let mut seed = 2748;
    let mut lists: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        // 100 numbers from 1 to 9999, none a multiple of 10: LeetCode's most
        let nums: Vec[i64] = (0..100).map(|_| {
            let x = next_random(mut seed) % 9999 + 1;
            if x % 10 == 0 { x + 1 } else { x }
        }).collect();
        lists.push(nums);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in lists.iter() {
            let pairs = count_beautiful_pairs(nums);
            sum += pairs;
            check = (check * 31 + pairs + r) % 1000000007;
        }
    }
    println(f"{count} lists of 100 numbers, {rounds} rounds: pairs sum to {sum}, checksum {check}");
}
