// LeetCode #2748: Number of Beautiful Pairs -- a Rust solution as
// LeetCode's Rust users write it, carried to Kāra by `karac fix`: a `fn
// gcd` nested in the method, and each first digit read off
// `to_string().chars().next()`.

fn gcd(a: i32, b: i32) -> i32 {
    if b == 0 { a } else { gcd(b, a % b) }
}

struct Solution {}

impl Solution {
    pub fn count_beautiful_pairs(nums: Vec[i32]) -> i32 {
        let n = nums.len();
        let mut ans = 0;
        for i in 0..n {
            let first = nums[i].to_string().chars().next().unwrap().to_digit(10).unwrap() as i32;
            for j in i + 1..n {
                if gcd(first, nums[j] % 10) == 1 {
                    ans += 1;
                }
            }
        }
        ans
    }
}

fn count_beautiful_pairs(nums: Vec[i64]) -> i64 {
    Solution.count_beautiful_pairs(nums.iter().map(|x| x as i32).collect())
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{count_beautiful_pairs([2, 5, 1, 4].to_vec())}");
    println(f"{count_beautiful_pairs([11, 21, 12].to_vec())}");
    // 100 ones, every pair beautiful; 100 of 22, none; LeetCode's largest
    // and smallest numbers
    println(f"{count_beautiful_pairs(Vec.filled(100, 1))}");
    println(f"{count_beautiful_pairs(Vec.filled(100, 22))}");
    println(f"{count_beautiful_pairs([9999, 1, 9999, 1].to_vec())}");
    // 5000 random lists of 2 to 100 numbers from 1 to 9999, none a
    // multiple of 10
    let mut seed = 2748;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..5000 {
        let n = next_random(mut seed) % 99 + 2;
        let nums: Vec[i64] = (0..n).map(|_| {
            let x = next_random(mut seed) % 9999 + 1;
            if x % 10 == 0 { x + 1 } else { x }
        }).collect();
        let pairs = count_beautiful_pairs(nums);
        sum += pairs;
        check = (check * 31 + pairs) % 1000000007;
    }
    println(f"5000 lists: pairs sum to {sum}, checksum {check}");
}
