// LeetCode #2772: Apply Operations to Make All Array Elements Equal to
// Zero -- a Rust solution as LeetCode's Rust users write it, carried to
// Kāra by `karac fix`: `k` taken as a `usize`, a `vec![0i64; n + 1]`
// difference array and a running sum `s`, each number widened by `as
// i64`.

struct Solution {}

impl Solution {
    pub fn check_array(nums: Vec[i32], k: i32) -> bool {
        let n = nums.len();
        let k = k as i64;
        let mut d = Vec.filled(n + 1, 0);
        let mut s: i64 = 0;
        for i in 0..n {
            s += d[i];
            let x = nums[i] + s;
            if x == 0 {
                continue;
            }
            if x < 0 or i + k > n {
                return false;
            }
            s -= x;
            d[i + k] += x;
        }
        true
    }
}

fn check_array(nums: ref Vec[i64], k: i64) -> bool {
    Solution.check_array(nums.iter().map(|x| x as i32).collect(), k as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// n numbers built by up to `most` operations at each start of a window
// of k; then, half the time, one number moved 1 up or down
fn built(n: i64, k: i64, most: i64, seed: mut ref i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.filled(n, 0);
    let mut running = 0;
    let mut ops: Vec[i64] = Vec.filled(n, 0);
    for i in 0..n {
        if i + k <= n {
            ops[i] = next_random(mut seed) % (most + 1);
        }
        running += ops[i];
        if i >= k {
            running -= ops[i - k];
        }
        nums[i] = running;
    }
    if next_random(mut seed) % 2 == 1 {
        let at = wide(mut seed) % n;
        if nums[at] > 0 and next_random(mut seed) % 2 == 1 {
            nums[at] -= 1;
        } else {
            nums[at] += 1;
        }
    }
    nums
}

fn main() {
    // LeetCode's two examples; a window of 1
    println(f"{check_array([2, 2, 3, 1, 1, 0].to_vec(), 3)}");
    println(f"{check_array([1, 3, 1, 1].to_vec(), 2)}");
    println(f"{check_array([5, 0, 7].to_vec(), 1)}");
    // 10^5 numbers, LeetCode's most, a window of all of them: all 10^6;
    // and one of them 1 less
    let mut full: Vec[i64] = Vec.filled(100000, 1000000);
    println(f"{check_array(full, 100000)}");
    full[50000] = 999999;
    println(f"{check_array(full, 100000)}");
    // 3000 arrays of 1 to 12 built by operations, half with one number moved
    let mut seed = 2772;
    let mut yes = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 12 + 1;
        let k = next_random(mut seed) % n + 1;
        let nums = built(n, k, 2, mut seed);
        let a = check_array(nums, k);
        if a {
            yes += 1;
        }
        check = (check * 31 + if a { 2 } else { 1 }) % 1000000007;
    }
    println(f"3000 small arrays: {yes} true, checksum {check}");
    // 20 arrays of 10^5, windows up to 1000, up to 9 operations at each start
    let mut yes = 0;
    let mut check = 0;
    for _ in 0..20 {
        let k = wide(mut seed) % 1000 + 1;
        let nums = built(100000, k, 9, mut seed);
        let a = check_array(nums, k);
        if a {
            yes += 1;
        }
        check = (check * 31 + if a { 2 } else { 1 }) % 1000000007;
    }
    println(f"20 arrays of 10^5: {yes} true, checksum {check}");
}
