// LeetCode #2782: Number of Unique Categories -- the differential. The
// five arms, against the statement read literally: the categories read
// straight from the judge's hidden list and counted as a set; no
// questions. 2000 random sets of 1 to 12 elements from 1 to 4
// categories; then 50 of up to 100 elements, LeetCode's most, from up to
// 100. Every case is drawn before any arm answers; the literal reading
// is asked only of the first 2000.
//
// P1  up to 12 elements, the count is the literal reading's
// P2  every category renamed, 1000 more: the same count
// P3  the elements reversed: the same count
// P4  an element of a new category put at the end: one more
// P5  from 1 to n, and 1 when every element has the first one's
//     category; no question about an element that is not there, and no
//     more than n(n - 1) / 2 questions
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(categories: Vec[i64]) -> i64 {
    Set[i64].from_iter(categories.iter().cloned()).len()
}


// ---- star (unique.kara) ---------------------------------------------

fn star_number_of_categories(n: i64, handler: mut ref CategoryHandler) -> i64 {
    let mut representatives: Vec[i64] = Vec.new();
    for i in 0..n {
        if not representatives.iter().any(|r| handler.have_same_category(r, i)) {
            representatives.push(i);
        }
    }
    representatives.len()
}


// ---- earlier (unique_earlier.kara) ----------------------------------

fn earlier_number_of_categories(n: i64, handler: mut ref CategoryHandler) -> i64 {
    let mut categories = 0;
    for i in 0..n {
        let mut seen = false;
        for j in 0..i {
            if handler.have_same_category(j, i) {
                seen = true;
                break;
            }
        }
        if not seen {
            categories += 1;
        }
    }
    categories
}


// ---- union (unique_union.kara) --------------------------------------

fn union_root(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn union_number_of_categories(n: i64, handler: mut ref CategoryHandler) -> i64 {
    let mut parent: Vec[i64] = (0..n).collect();
    for i in 0..n {
        for j in i + 1..n {
            if handler.have_same_category(i, j) {
                let (a, b) = (union_root(mut parent, i), union_root(mut parent, j));
                if a != b {
                    parent[b] = a;
                }
            }
        }
    }
    (0..n).filter(|x| union_root(mut parent, x) == x).count()
}


// ---- peel (unique_peel.kara) ----------------------------------------

fn peel_number_of_categories(n: i64, handler: mut ref CategoryHandler) -> i64 {
    let mut left: Vec[i64] = (0..n).collect();
    let mut categories = 0;
    while not left.is_empty() {
        let first = left[0];
        left = left[1..].iter().filter(|e| not handler.have_same_category(first, e)).collect();
        categories += 1;
    }
    categories
}


// ---- solution (unique_solution.kara) --------------------------------

struct Solution {}

impl Solution {
    pub fn number_of_categories(n: i32, category_handler: mut ref CategoryHandler) -> i32 {
        let mut ans = 0;
        for i in 0..n {
            if not (0..i).any(|j| category_handler.have_same_category(i, j)) {
                ans += 1;
            }
        }
        ans
    }
}

fn solution_number_of_categories(n: i64, handler: mut ref CategoryHandler) -> i64 {
    Solution.number_of_categories(n as i32, mut handler)
}


// LeetCode's interactive judge, with the questions counted and those
// about an element that is not there counted apart
struct CategoryHandler {
    categories: Vec[i64],
    asked: i64,
    strays: i64,
}

impl CategoryHandler {
    fn new(categories: own Vec[i64]) -> CategoryHandler {
        CategoryHandler { categories: categories, asked: 0, strays: 0 }
    }

    fn have_same_category(mut ref self, a: i64, b: i64) -> bool {
        self.asked += 1;
        let n = self.categories.len();
        if a < 0 or b < 0 or a >= n or b >= n {
            self.strays += 1;
            return false;
        }
        self.categories[a] == self.categories[b]
    }
}

// the answer, the questions asked and those about no element
fn answer(arm: i64, categories: Vec[i64]) -> (i64, i64, i64) {
    let n = categories.len();
    let mut handler = CategoryHandler.new(categories.clone());
    let got = match arm {
        0 => star_number_of_categories(n, mut handler),
        1 => earlier_number_of_categories(n, mut handler),
        2 => union_number_of_categories(n, mut handler),
        3 => peel_number_of_categories(n, mut handler),
        _ => solution_number_of_categories(n, mut handler),
    };
    (got, handler.asked, handler.strays)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "earlier", "union", "peel", "solution"];
    let mut seed = 2782;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        let (n, kinds) = if c < 2000 { (next_random(mut seed) % 12 + 1, 4) } else { (next_random(mut seed) % 100 + 1, 100) };
        let k = next_random(mut seed) % kinds + 1;
        cases.push((0..n).map(|_| next_random(mut seed) % k).collect());
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, categories) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(categories) } else { 0 };
        check = (check * 31 + want + 1) % 1000000007;
        let n = categories.len();
        let renamed: Vec[i64] = categories.iter().map(|k| k + 1000).collect();
        let reversed: Vec[i64] = categories.iter().rev().collect();
        let mut more = categories.clone();
        more.push(-1);
        let same: Vec[i64] = Vec.filled(n, categories[0]);
        let got: Vec[(i64, i64, i64)] = (0..5).map(|arm| answer(arm, categories)).collect();
        for arm in 0..5 {
            let (value, asked, strays) = got[arm];
            let mut agree = 0;
            for o in 0..5 {
                let (other, _, _) = got[o];
                if o != arm and other == value {
                    agree += 1;
                }
            }
            let (renamed_value, _, _) = answer(arm, renamed);
            let (reversed_value, _, _) = answer(arm, reversed);
            let (more_value, _, _) = answer(arm, more);
            let (same_value, _, _) = answer(arm, same);
            let verdicts = [
                not small or value == want,
                renamed_value == value,
                reversed_value == value,
                more_value == value + 1,
                value >= 1 and value <= n and same_value == 1 and strays == 0 and asked <= n * (n - 1) / 2,
                agree >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {categories}, arm {names[arm]}: P{q + 1} fails, gave {value} after {asked} questions");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
