// LeetCode #2779: Maximum Beauty of an Array After Applying Operation --
// the bench. The ★ arm (beauty.kara) over 20 arrays of 10^5 numbers up to
// 10^5, LeetCode's most, with k up to 1000. All the arrays drawn first,
// then each answered 10 times, every answer sorting its own copy.

fn maximum_beauty(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    let mut best = 0;
    let mut lo = 0;
    for hi in 0..sorted.len() {
        while sorted[hi] - sorted[lo] > 2 * k {
            lo += 1;
        }
        best = best.max(hi - lo + 1);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 20;
    let rounds = 10;
    let mut seed = 2779;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for _ in 0..count {
        let nums: Vec[i64] = (0..100000).map(|_| wide(mut seed) % 100001).collect();
        cases.push((nums, wide(mut seed) % 1001));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, k) in cases.iter() {
            let b = maximum_beauty(nums, k);
            total += b;
            check = (check * 31 + b + r) % 1000000007;
        }
    }
    println(f"{count} arrays of 10^5, {rounds} rounds: beauties sum to {total}, checksum {check}");
}
