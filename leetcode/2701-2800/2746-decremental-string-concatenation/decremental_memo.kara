// LeetCode #2746: Decremental String Concatenation -- the memo arm. Top
// down: from word i on, with the string so far starting with f and ending
// with l, the fewest letters the rest add, each word tried after and
// before. A `struct Joiner` holds the words and a `Map` memo keyed by
// `(i, f, l)`. O(26^2 n).

struct Joiner {
    words: Vec[String],
    memo: Map[(i64, i64, i64), i64],
}

impl Joiner {
    fn rest(mut ref self, i: i64, f: char, l: char) -> i64 {
        if i == self.words.len() {
            return 0;
        }
        let key = (i, f as i64, l as i64);
        if let Some(known) = self.memo.get(key) {
            return known;
        }
        let w = self.words[i].clone();
        let a = w.chars().next().unwrap();
        let b = w.chars().last().unwrap();
        let after = w.len() - if l == a { 1 } else { 0 } + self.rest(i + 1, f, b);
        let before = w.len() - if b == f { 1 } else { 0 } + self.rest(i + 1, a, l);
        let best = after.min(before);
        self.memo.insert(key, best);
        best
    }
}

fn minimize_concatenated_length(words: Vec[String]) -> i64 {
    let first = words[0].chars().next().unwrap();
    let last = words[0].chars().last().unwrap();
    let length = words[0].len();
    let mut joiner = Joiner { words: words.clone(), memo: Map.new() };
    length + joiner.rest(1, first, last)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n words of 1 to `longest` letters from the first k of the alphabet
fn random_words(seed: mut ref i64, n: i64, longest: i64, k: i64) -> Vec[String] {
    let mut words: Vec[String] = Vec.new();
    for _ in 0..n {
        let len = next_random(mut seed) % longest + 1;
        let mut w = String.new();
        for _ in 0..len {
            w.push((b'a' + (next_random(mut seed) % k) as u8) as char);
        }
        words.push(w);
    }
    words
}

fn main() {
    // LeetCode's three examples
    println(f"{minimize_concatenated_length(["aa", "ab", "bc"].into_iter().map(|w| w.to_string()).collect())}");
    println(f"{minimize_concatenated_length(["ab", "b"].into_iter().map(|w| w.to_string()).collect())}");
    println(f"{minimize_concatenated_length(["aaa", "c", "aba"].into_iter().map(|w| w.to_string()).collect())}");
    // one word; and 1000 words of 50 "a"s, LeetCode's most
    println(f"{minimize_concatenated_length(["xyz"].into_iter().map(|w| w.to_string()).collect())}");
    let many: Vec[String] = (0..1000).map(|_| "a".repeat(50)).collect();
    println(f"{minimize_concatenated_length(many)}");
    // 3000 random lists of 1 to 12 words of 1 to 4 letters from the first
    // 1 to 3; then 30 of 1000 words of up to 50 letters from the first 5
    let mut seed = 2746;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let k = next_random(mut seed) % 3 + 1;
        let n = next_random(mut seed) % 12 + 1;
        let words = random_words(mut seed, n, 4, k);
        let length = minimize_concatenated_length(words);
        sum += length;
        check = (check * 31 + length) % 1000000007;
    }
    println(f"3000 small lists: lengths sum to {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for _ in 0..30 {
        let words = random_words(mut seed, 1000, 50, 5);
        let length = minimize_concatenated_length(words);
        sum += length;
        check = (check * 31 + length) % 1000000007;
    }
    println(f"30 lists of 1000 words: lengths sum to {sum}, checksum {check}");
}
