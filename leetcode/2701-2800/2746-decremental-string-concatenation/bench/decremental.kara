// LeetCode #2746: Decremental String Concatenation -- the bench
// (decremental.kara): the ★ arm, the shortest string for each pair of
// first and last letters in a 26 by 26 `Array`, rolled word by word.

const NONE: i64 = 1000000000;

fn minimize_concatenated_length(words: Vec[String]) -> i64 {
    let first_of = |w: Str| (w.bytes()[0] - b'a') as i64;
    let last_of = |w: Str| (w.bytes()[w.len() - 1] - b'a') as i64;
    let mut best: Array[Array[i64, 26], 26] = [[NONE; 26]; 26];
    best[first_of(words[0])][last_of(words[0])] = words[0].len();
    for w in words.iter().skip(1) {
        let (a, b) = (first_of(w), last_of(w));
        let mut next: Array[Array[i64, 26], 26] = [[NONE; 26]; 26];
        for f in 0..26 {
            for l in 0..26 {
                let length = best[f][l];
                if length == NONE {
                    continue;
                }
                // the word after: it loses its first letter if that is l
                let after = length + w.len() - if l == a { 1 } else { 0 };
                next[f][b] = next[f][b].min(after);
                // the word before: it loses its last letter if that is f
                let before = length + w.len() - if b == f { 1 } else { 0 };
                next[a][l] = next[a][l].min(before);
            }
        }
        best = next;
    }
    let mut shortest = NONE;
    for f in 0..26 {
        for l in 0..26 {
            shortest = shortest.min(best[f][l]);
        }
    }
    shortest
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100;
    let rounds = 5;
    let mut seed = 2746;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..count {
        // 1000 words of 1 to 10 letters from all 26, LeetCode's most words
        let mut words: Vec[String] = Vec.new();
        for _ in 0..1000 {
            let len = next_random(mut seed) % 10 + 1;
            let mut w = String.new();
            for _ in 0..len {
                w.push((b'a' + (next_random(mut seed) % 26) as u8) as char);
            }
            words.push(w);
        }
        lists.push(words);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for words in lists.iter() {
            let length = minimize_concatenated_length(words);
            sum += length;
            check = (check * 31 + length + r) % 1000000007;
        }
    }
    println(f"{count} lists of 1000 words, {rounds} rounds: lengths sum to {sum}, checksum {check}");
}
