// LeetCode #2749: Minimum Operations to Make the Integer Zero -- the
// differential. The five arms, against the statement read literally: k
// operations from 1 to 60, each tried as every way of picking k powers
// 2^i with i from 0 to 60, largest first, whose sum with k num2s is num1;
// no counting of set bits. 1000 random pairs with num1 from 1 to 30 and
// num2 from -3 to 3; then 3000 across LeetCode's whole range. Every case
// is drawn before any arm answers; the literal reading is asked only of
// the first 1000.
//
// P1  num1 up to 30, the answer is the literal reading's
// P2  -1 or from 1 to 60; and for an answer k, t = num1 - k num2 has at
//     most k set bits and is at least k
// P3  num1 and num2 both doubled: no more steps, unless there was no way
// P4  num2 made 0: as many steps as num1 has set bits
// P5  up to 30, an answer k from 2 on: one step of the right power first
//     leaves k - 1 steps, and no step leaves fewer
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

// whether `left` is a sum of exactly `count` powers 2^i with i <= top
fn sum_of_powers(left: i64, count: i64, top: i64) -> bool {
    if count == 0 {
        return left == 0;
    }
    if left < count {
        return false;
    }
    for i in (0..=top).rev() {
        let power = 1 << i;
        if power <= left and sum_of_powers(left - power, count - 1, i) {
            return true;
        }
    }
    false
}

fn literal(num1: i64, num2: i64) -> i64 {
    for k in 1..=60 {
        if sum_of_powers(num1 - k * num2, k, 60) {
            return k;
        }
    }
    -1
}


// ---- star (zero.kara) -----------------------------------------------

fn star_make_the_integer_zero(num1: i64, num2: i64) -> i64 {
    for k in 1..=60 {
        let t = num1 - k * num2;
        if t.count_ones() <= k and k <= t {
            return k;
        }
    }
    -1
}


// ---- kernighan (zero_kernighan.kara) --------------------------------

fn kernighan_make_the_integer_zero(num1: i64, num2: i64) -> i64 {
    let mut k = 1;
    while k <= 60 {
        let mut t = num1 - k * num2;
        if t >= k {
            let mut bits = 0;
            while t != 0 and bits <= k {
                t &= t - 1;
                bits += 1;
            }
            if bits <= k {
                return k;
            }
        }
        k += 1;
    }
    -1
}


// ---- split (zero_split.kara) ----------------------------------------

fn split_can_split(t: i64, k: i64) -> bool {
    if t <= 0 {
        return false;
    }
    let mut pieces: Vec[i64] = Vec.filled(64, 0);
    let mut count = 0;
    for e in 0..63 {
        if (t >> e) & 1 == 1 {
            pieces[e] += 1;
            count += 1;
        }
    }
    if count > k {
        return false;
    }
    let mut e = 62;
    while count < k and e > 0 {
        if pieces[e] == 0 {
            e -= 1;
            continue;
        }
        pieces[e] -= 1;
        pieces[e - 1] += 2;
        count += 1;
    }
    count == k
}

fn split_make_the_integer_zero(num1: i64, num2: i64) -> i64 {
    (1..=60).find(|k| split_can_split(num1 - k * num2, k)).unwrap_or(-1)
}


// ---- binary (zero_binary.kara) --------------------------------------

fn binary_make_the_integer_zero(num1: i64, num2: i64) -> i64 {
    for k in 1..=60 {
        let t = num1 - k * num2;
        if t < k {
            continue;
        }
        let ones = f"{t:b}".chars().filter(|c| c == '1').count();
        if ones <= k {
            return k;
        }
    }
    -1
}


// ---- solution (zero_solution.kara) ----------------------------------

struct Solution {}

impl Solution {
    pub fn make_the_integer_zero(num1: i32, num2: i32) -> i32 {
        for k in 1..=60 {
            let x = num1 - k * num2;
            if x < k {
                continue;
            }
            if x.count_ones() <= k {
                return k as i32;
            }
        }
        -1
    }
}

fn solution_make_the_integer_zero(num1: i64, num2: i64) -> i64 {
    Solution.make_the_integer_zero(num1 as i32, num2 as i32)
}


fn answer(arm: i64, num1: i64, num2: i64) -> i64 {
    match arm {
        0 => star_make_the_integer_zero(num1, num2),
        1 => kernighan_make_the_integer_zero(num1, num2),
        2 => split_make_the_integer_zero(num1, num2),
        3 => binary_make_the_integer_zero(num1, num2),
        _ => solution_make_the_integer_zero(num1, num2),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn set_bits(t: i64) -> i64 {
    (0..63).filter(|e| (t >> e) & 1 == 1).count()
}

fn main() {
    let names = ["star", "kernighan", "split", "binary", "solution"];
    let mut seed = 2749;
    let mut cases: Vec[(i64, i64)] = Vec.new();
    for c in 0..4000 {
        if c < 1000 {
            let num1 = next_random(mut seed) % 30 + 1;
            let num2 = next_random(mut seed) % 7 - 3;
            cases.push((num1, num2));
        } else {
            let num1 = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1;
            let size = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000001;
            let num2 = if next_random(mut seed) % 2 == 0 { size } else { -size };
            cases.push((num1, num2));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (num1, num2)) in cases.iter().enumerate() {
        let small = c < 1000;
        let want = if small { literal(num1, num2) } else { -2 };
        check = (check * 31 + want + 2) % 1000000007;
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, num1, num2)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let witnessed = value == -1 or (1 <= value and value <= 60 and {
                let t = num1 - value * num2;
                set_bits(t) <= value and value <= t
            });
            let doubled = answer(arm, 2 * num1, 2 * num2);
            let one_step_on = not small or value < 2 or {
                let after: Vec[i64] = (0..=40).map(|i| answer(arm, num1 - (1 << i) - num2, num2)).filter(|steps| steps != -1).collect();
                after.iter().min().cloned() == Some(value - 1)
            };
            let verdicts = [
                not small or value == want,
                witnessed,
                value == -1 or (doubled != -1 and doubled <= value),
                answer(arm, num1, 0) == set_bits(num1),
                one_step_on,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} ({num1}, {num2}), arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
