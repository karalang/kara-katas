// LeetCode #2786: Visit Array Positions to Maximize Score -- the bench:
// the ★ arm over 20 arrays of 10^5 numbers up to 10^6 with x up to 10^6,
// LeetCode's most, all drawn first, then each answered 100 times.

fn max_score(nums: Vec[i64], x: i64) -> i64 {
    let unreached = -1000000000000000;
    let mut best = [unreached, unreached];
    best[nums[0] % 2] = nums[0];
    for v in nums[1..].iter() {
        let p = v % 2;
        best[p] = best[p].max(best[1 - p] - x) + v;
    }
    best[0].max(best[1])
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 20;
    let rounds = 100;
    let mut seed = 2786;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for _ in 0..count {
        let nums: Vec[i64] = (0..100000).map(|_| wide(mut seed) % 1000000 + 1).collect();
        cases.push((nums, wide(mut seed) % 1000000 + 1));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, x) in cases.iter() {
            let a = max_score(nums, x);
            total += a;
            check = (check * 31 + a + r) % 1000000007;
        }
    }
    println(f"{count} arrays of 10^5, {rounds} rounds: scores sum to {total}, checksum {check}");
}
