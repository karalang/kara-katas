
// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// m letters drawn from the first `k` of the alphabet
fn word(m: i64, k: i64, seed: mut ref i64) -> String {
    let letters = "abcdefghijklmnopqrstuvwxyz";
    let mut w = String.new();
    for _ in 0..m {
        let r = next_random(mut seed) % k;
        w.push_str(letters[r..r + 1]);
    }
    w
}

// the answer folded to a number, its letters in order
fn digest(s: String) -> i64 {
    s.bytes().iter().fold(0, |h, b| (h * 131 + b as i64) % 1000000007)
}

fn main() {
    // LeetCode's two examples; three 100-letter words, LeetCode's
    // longest, all the same; three that share nothing; three that chain
    println(minimum_string("abc", "bca", "aaa"));
    println(minimum_string("ab", "ba", "aba"));
    let a = "ab".repeat(50);
    println(minimum_string(a, a, a).len());
    let joined = minimum_string("z".repeat(100), "y".repeat(100), "x".repeat(100));
    println(f"{joined.len()} {joined[0..3]} {joined[297..300]}");
    let chain = minimum_string("abcd".repeat(25), "bcda".repeat(25), "cdab".repeat(25));
    println(f"{chain.len()} {digest(chain)}");
    // 3000 random triples of 1 to 4 letters from a to c; then 50 of up
    // to 100 letters from a and b or from the whole alphabet
    let mut seed = 2800;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let a = word(next_random(mut seed) % 4 + 1, 3, mut seed);
        let b = word(next_random(mut seed) % 4 + 1, 3, mut seed);
        let c = word(next_random(mut seed) % 4 + 1, 3, mut seed);
        let s = minimum_string(a, b, c);
        sum += s.len();
        check = (check * 31 + digest(s)) % 1000000007;
    }
    println(f"3000 short triples: lengths sum to {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for t in 0..50 {
        let k = if t % 2 == 0 { 2 } else { 26 };
        let a = word(next_random(mut seed) % 100 + 1, k, mut seed);
        let b = word(next_random(mut seed) % 100 + 1, k, mut seed);
        let c = word(next_random(mut seed) % 100 + 1, k, mut seed);
        let s = minimum_string(a, b, c);
        sum += s.len();
        check = (check * 31 + digest(s)) % 1000000007;
    }
    println(f"50 long triples: lengths sum to {sum}, checksum {check}");
}
