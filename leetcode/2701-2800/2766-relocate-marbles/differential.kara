// LeetCode #2766: Relocate Marbles -- the differential. The five arms,
// against the statement read literally: every marble kept on its own, each
// move carrying every marble standing on its from position, and at the end
// the positions with a marble on them, sorted by a selection of the least
// left each time; no set. 2000 random cases of 1 to 10 marbles and moves
// over places up to 15; then 50 of up to 2000 over places up to 10^9.
// Every case is drawn before any arm answers; the literal reading is asked
// only of the first 2000.
//
// P1  up to 10 marbles, the places are the literal reading's
// P2  every place 1000 more: every answer 1000 more
// P3  a last move from the last move's target to itself: the same places
// P4  the marbles listed in reverse: the same places
// P5  strictly rising, each a starting place or a target, no more than
//     the marbles; and the last move's target among them
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64], move_from: Vec[i64], move_to: Vec[i64]) -> Vec[i64] {
    let mut marbles = nums.clone();
    for i in 0..move_from.len() {
        for k in 0..marbles.len() {
            if marbles[k] == move_from[i] {
                marbles[k] = move_to[i];
            }
        }
    }
    let mut places: Vec[i64] = Vec.new();
    loop {
        let mut least = -1;
        for m in marbles.iter() {
            let above = places.is_empty() or m > places[places.len() - 1];
            if above and (least == -1 or m < least) {
                least = m;
            }
        }
        if least == -1 {
            break;
        }
        places.push(least);
    }
    places
}


// ---- star (marbles.kara) --------------------------------------------

fn star_relocate_marbles(nums: Vec[i64], move_from: Vec[i64], move_to: Vec[i64]) -> Vec[i64] {
    let mut occupied: Set[i64] = nums.iter().collect();
    for (a, b) in move_from.iter().zip(move_to.iter()) {
        occupied.remove(a);
        occupied.insert(b);
    }
    let mut places: Vec[i64] = occupied.into_iter().collect();
    places.sort();
    places
}


// ---- sorted (marbles_sorted.kara) -----------------------------------

fn sorted_relocate_marbles(nums: Vec[i64], move_from: Vec[i64], move_to: Vec[i64]) -> Vec[i64] {
    let mut occupied = SortedSet.from(nums.clone());
    for i in 0..move_from.len() {
        occupied.remove(move_from[i]);
        occupied.insert(move_to[i]);
    }
    occupied.into_iter().collect()
}


// ---- counts (marbles_counts.kara) -----------------------------------

fn counts_relocate_marbles(nums: Vec[i64], move_from: Vec[i64], move_to: Vec[i64]) -> Vec[i64] {
    let mut count: Map[i64, i64] = Map.new();
    for x in nums.iter() {
        *count.entry(x).or_insert(0) += 1;
    }
    for (a, b) in move_from.iter().zip(move_to.iter()) {
        if let Some(moved) = count.remove(a) {
            *count.entry(b).or_insert(0) += moved;
        }
    }
    let mut places: Vec[i64] = count.keys().collect();
    places.sort();
    places
}


// ---- compress (marbles_compress.kara) -------------------------------

fn compress_relocate_marbles(nums: Vec[i64], move_from: Vec[i64], move_to: Vec[i64]) -> Vec[i64] {
    let mut all: Vec[i64] = nums.clone();
    all.extend(move_to.iter());
    all.sort();
    all.dedup();
    let index = |x: i64| all.binary_search(x).unwrap();
    let mut occupied: Vec[bool] = Vec.filled(all.len(), false);
    for x in nums.iter() {
        occupied[index(x)] = true;
    }
    for i in 0..move_from.len() {
        occupied[index(move_from[i])] = false;
        occupied[index(move_to[i])] = true;
    }
    (0..all.len()).filter(|k| occupied[k]).map(|k| all[k]).collect()
}


// ---- solution (marbles_solution.kara) -------------------------------

struct Solution {}

impl Solution {
    pub fn relocate_marbles(nums: own Vec[i32], move_from: Vec[i32], move_to: Vec[i32]) -> Vec[i32] {
        let mut set: Set[i32] = nums.into_iter().collect();
        for i in 0..move_from.len() {
            set.remove(move_from[i]);
            set.insert(move_to[i]);
        }
        let mut ans: Vec[i32] = set.into_iter().collect();
        ans.sort();
        ans
    }
}

fn solution_relocate_marbles(nums: Vec[i64], move_from: Vec[i64], move_to: Vec[i64]) -> Vec[i64] {
    let narrow: Fn(ref Vec[i64]) -> Vec[i32] = |v: ref Vec[i64]| { v.iter().map(|x| x as i32).collect() };
    Solution.relocate_marbles(narrow(nums), narrow(move_from), narrow(move_to))
        .into_iter()
        .map(|x| x as i64)
        .collect()
}


fn answer(arm: i64, nums: Vec[i64], move_from: Vec[i64], move_to: Vec[i64]) -> Vec[i64] {
    match arm {
        0 => star_relocate_marbles(nums, move_from, move_to),
        1 => sorted_relocate_marbles(nums, move_from, move_to),
        2 => counts_relocate_marbles(nums, move_from, move_to),
        3 => compress_relocate_marbles(nums, move_from, move_to),
        _ => solution_relocate_marbles(nums, move_from, move_to),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// n marbles at positions from 1 to top, then moves each from a place that
// holds marbles at the time to any place from 1 to top
fn case(n: i64, moves: i64, top: i64, seed: mut ref i64) -> (Vec[i64], Vec[i64], Vec[i64]) {
    let nums: Vec[i64] = (0..n).map(|_| wide(mut seed) % top + 1).collect();
    let mut places: Vec[i64] = Vec.new();
    let mut slot: Map[i64, i64] = Map.new();
    for x in nums.iter() {
        if not slot.contains_key(x) {
            slot[x] = places.len();
            places.push(x);
        }
    }
    let mut move_from: Vec[i64] = Vec.new();
    let mut move_to: Vec[i64] = Vec.new();
    for _ in 0..moves {
        let a = places[wide(mut seed) % places.len()];
        let b = wide(mut seed) % top + 1;
        move_from.push(a);
        move_to.push(b);
        if a != b {
            let k = slot.remove(a).unwrap();
            let last = places.pop().unwrap();
            if last != a {
                places[k] = last;
                slot[last] = k;
            }
            if not slot.contains_key(b) {
                slot[b] = places.len();
                places.push(b);
            }
        }
    }
    (nums, move_from, move_to)
}

fn shifted(v: Vec[i64]) -> Vec[i64] {
    v.iter().map(|x| x + 1000).collect()
}

fn main() {
    let names = ["star", "sorted", "counts", "compress", "solution"];
    let mut seed = 2766;
    let mut cases: Vec[(Vec[i64], Vec[i64], Vec[i64])] = Vec.new();
    for c in 0..2050 {
        let (most, top) = if c < 2000 { (10, 15) } else { (2000, 1000000000) };
        let n = next_random(mut seed) % most + 1;
        let moves = next_random(mut seed) % most + 1;
        let top = if c < 2000 { next_random(mut seed) % top + 1 } else { top };
        cases.push(case(n, moves, top, mut seed));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (nums, move_from, move_to)) in cases.iter().enumerate() {
        let small = c < 2000;
        let want: Vec[i64] = if small { literal(nums, move_from, move_to) } else { Vec.new() };
        check = (check * 31 + want.len() + 1) % 1000000007;
        for p in want.iter() {
            check = (check * 31 + p) % 1000000007;
        }
        let last = move_to[move_to.len() - 1];
        let mut longer_from = move_from.clone();
        longer_from.push(last);
        let mut longer_to = move_to.clone();
        longer_to.push(last);
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let got: Vec[Vec[i64]] = (0..5).map(|arm| answer(arm, nums, move_from, move_to)).collect();
        for arm in 0..5 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let raised: Vec[i64] = value.iter().map(|x| x + 1000).collect();
            let rising = (1..value.len()).all(|i| value[i - 1] < value[i]);
            let known = value.iter().all(|p| nums.contains(p) or move_to.contains(p));
            let verdicts = [
                not small or value == want,
                answer(arm, shifted(nums), shifted(move_from), shifted(move_to)) == raised,
                answer(arm, nums, longer_from, longer_to) == value,
                answer(arm, reversed, move_from, move_to) == value,
                rising and known and value.len() <= nums.len() and value.contains(last),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums} {move_from} {move_to}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
