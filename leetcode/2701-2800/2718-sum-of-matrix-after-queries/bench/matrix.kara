// LeetCode #2718: Sum of Matrix After Queries -- the bench (matrix.kara):
// the queries read from the last back, each row or column not set later
// filling the lines of the other kind not yet taken.

fn matrix_sum_queries(n: i64, queries: Vec[Vec[i64]]) -> i64 {
    let mut row_taken: Vec[bool] = Vec.filled(n, false);
    let mut col_taken: Vec[bool] = Vec.filled(n, false);
    let mut rows_left = n;
    let mut cols_left = n;
    let mut sum = 0;
    for query in queries.iter().rev() {
        let (kind, index, value) = (query[0], query[1], query[2]);
        if kind == 0 {
            if not row_taken[index] {
                row_taken[index] = true;
                rows_left -= 1;
                sum += value * cols_left;
            }
        } else if not col_taken[index] {
            col_taken[index] = true;
            cols_left -= 1;
            sum += value * rows_left;
        }
    }
    sum
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 40;
    let rounds = 20;
    let mut seed = 2718;
    let mut problems: Vec[(i64, Vec[Vec[i64]])] = Vec.new();
    for _ in 0..count {
        // 10^4 rows and 5 * 10^4 queries of values up to 10^5, LeetCode's
        // largest
        let n = 10000;
        let mut queries: Vec[Vec[i64]] = Vec.new();
        for _ in 0..50000 {
            let kind = next_random(mut seed) % 2;
            let index = wide(mut seed) % n;
            let value = wide(mut seed) % 100001;
            queries.push([kind, index, value].to_vec());
        }
        problems.push((n, queries));
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (n, queries) in problems.iter() {
            let total = matrix_sum_queries(n, queries);
            sum += total % 1000000007;
            check = (check * 31 + total % 1000000007 + r) % 1000000007;
        }
    }
    println(f"{count} cases of 50000 queries on 10000 rows, {rounds} rounds: sums mod p sum to {sum}, checksum {check}");
}
