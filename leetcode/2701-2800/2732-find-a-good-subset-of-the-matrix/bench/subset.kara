// LeetCode #2732: Find a Good Subset of the Matrix -- the bench
// (subset.kara): a row of zeros alone, or the first rows of two disjoint
// masks among the 32.

fn good_subsetof_binary_matrix(grid: Vec[Vec[i64]]) -> Vec[i64] {
    let mut first: Array[i64, 32] = [-1; 32];
    for (i, row) in grid.iter().enumerate() {
        let mut mask = 0;
        for (j, x) in row.iter().enumerate() {
            mask |= x << j;
        }
        if mask == 0 {
            return [i].to_vec();
        }
        if first[mask] < 0 {
            first[mask] = i;
        }
    }
    for a in 1..32 {
        for b in a + 1..32 {
            if a & b == 0 and first[a] >= 0 and first[b] >= 0 {
                return [first[a].min(first[b]), first[a].max(first[b])].to_vec();
            }
        }
    }
    Vec.new()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let grids = 100;
    let m = 10000;
    let n = 5;
    let rounds = 10;
    let mut seed = 2732;
    let mut all: Vec[Vec[Vec[i64]]] = Vec.new();
    for g in 0..grids {
        // 10^4 rows of 5 random bits, LeetCode's largest; in one grid of
        // three, one column is set in every row, so no subset is good and
        // the grid is read to the end; in another, in every row but one
        let kind = g % 3;
        let column = next_random(mut seed) % n;
        let free = next_random(mut seed) % m;
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for r in 0..m {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..n {
                row.push(next_random(mut seed) % 2);
            }
            if kind == 1 or (kind == 2 and r != free) {
                row[column] = 1;
            }
            grid.push(row);
        }
        all.push(grid);
    }
    let mut found = 0;
    let mut check = 0;
    for r in 0..rounds {
        for grid in all.iter() {
            let rows = good_subsetof_binary_matrix(grid);
            if rows.len() > 0 {
                found += 1;
            }
            let named: i64 = rows.iter().sum();
            check = (check * 31 + named + rows.len() + r) % 1000000007;
        }
    }
    println(f"{grids} grids of {m} rows, {rounds} rounds: {found} good subsets found, checksum {check}");
}
