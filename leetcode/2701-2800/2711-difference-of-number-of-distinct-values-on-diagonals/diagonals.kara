// LeetCode #2711: Difference of Number of Distinct Values on Diagonals --
// the ★ arm. Each diagonal, from its start on the top row or the left
// column, is swept down once, each cell given the number of distinct
// values seen above it, and then up once, each cell's count replaced by
// its distance from the number of distinct values below it. A table of
// the 50 values says which were seen. O(m n).

fn difference_of_distinct_values(grid: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let m = grid.len();
    let n = grid[0].len();
    let mut answer: Vec[Vec[i64]] = (0..m).map(|_| (0..n).map(|_| 0).collect()).collect();
    let mut starts: Vec[(i64, i64)] = (0..n).map(|c| (0, c)).collect();
    for r in 1..m {
        starts.push((r, 0));
    }
    for (r0, c0) in starts.iter() {
        let length = (m - r0).min(n - c0);
        let mut seen = [false; 51];
        let mut distinct = 0;
        for k in 0..length {
            answer[r0 + k][c0 + k] = distinct;
            let v = grid[r0 + k][c0 + k];
            if not seen[v] {
                seen[v] = true;
                distinct += 1;
            }
        }
        seen = [false; 51];
        distinct = 0;
        for k in (0..length).rev() {
            answer[r0 + k][c0 + k] = (answer[r0 + k][c0 + k] - distinct).abs();
            let v = grid[r0 + k][c0 + k];
            if not seen[v] {
                seen[v] = true;
                distinct += 1;
            }
        }
    }
    answer
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(grid: Vec[Vec[i64]]) -> String {
    let mut rows: Vec[String] = Vec.new();
    for row in grid.iter() {
        let cells: Vec[String] = row.iter().map(|v| v.to_string()).collect();
        rows.push(f"[{cells.join(", ")}]");
    }
    f"[{rows.join(", ")}]"
}

fn fold(check: i64, grid: Vec[Vec[i64]]) -> i64 {
    let mut check = check;
    for row in grid.iter() {
        for v in row.iter() {
            check = (check * 31 + v) % 1000000007;
        }
    }
    (check * 31 + grid.len() * 100 + grid[0].len()) % 1000000007
}

fn total(grid: Vec[Vec[i64]]) -> i64 {
    let mut sum = 0;
    for row in grid.iter() {
        for v in row.iter() {
            sum += v;
        }
    }
    sum
}

fn main() {
    // LeetCode's two examples; a row and a column; a checkerboard of two
    // values; 50 by 50, LeetCode's largest, every diagonal distinct
    println(show(difference_of_distinct_values([[1, 2, 3].to_vec(), [3, 1, 5].to_vec(), [3, 2, 1].to_vec()].to_vec())));
    println(show(difference_of_distinct_values([[1].to_vec()].to_vec())));
    println(show(difference_of_distinct_values([[1, 2, 3, 4, 5].to_vec()].to_vec())));
    println(show(difference_of_distinct_values([[7].to_vec(), [7].to_vec(), [8].to_vec()].to_vec())));
    let board: Vec[Vec[i64]] = (0..4).map(|r| (0..4).map(|c| (r + c) % 2 + 1).collect()).collect();
    println(show(difference_of_distinct_values(board)));
    let wide: Vec[Vec[i64]] = (0..50).map(|r| (0..50).map(|c| (r * 50 + c) % 50 + 1).collect()).collect();
    let big = difference_of_distinct_values(wide);
    println(f"50 by 50, all distinct along diagonals: corner {big[0][0]}, centre {big[25][25]}, sum {total(big)}");
    // 1000 random grids of 1 to 50 rows and columns, values up to a
    // random cap of 1 to 50
    let mut seed = 2711;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..1000 {
        let m = next_random(mut seed) % 50 + 1;
        let n = next_random(mut seed) % 50 + 1;
        let most = next_random(mut seed) % 50 + 1;
        let grid: Vec[Vec[i64]] = (0..m).map(|_| (0..n).map(|_| next_random(mut seed) % most + 1).collect()).collect();
        let answer = difference_of_distinct_values(grid);
        sum += total(answer);
        check = fold(check, answer);
    }
    println(f"1000 grids: differences sum to {sum}, checksum {check}");
}
