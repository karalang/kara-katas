// LeetCode #2765: Longest Alternating Subarray -- the differential. The
// five arms, against the statement read literally: every subarray s of
// length m > 1, kept when s1 - s0 = 1 and each later step s[k] - s[k - 1]
// is (-1)^(k + 1), each step asked by `all`; the longest kept, or -1.
// 3000 random arrays of 2 to 15 numbers from 1 to a top of 2 to 5; then
// 500 of up to 100. Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  every number 100 more: the same answer
// P3  a number 50 above the greatest put at both ends: the same answer
// P4  the numbers written twice over: no shorter
// P5  -1 or from 2 to n, and -1 just when no neighbour steps up by 1
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut best = -1;
    for l in 0..n {
        for r in l + 1..n {
            let alternates = (1..=r - l).all(|k| {
                let step = nums[l + k] - nums[l + k - 1];
                step == if k % 2 == 1 { 1 } else { -1 }
            });
            if alternates and r - l + 1 > best {
                best = r - l + 1;
            }
        }
    }
    best
}


// ---- star (alternating.kara) ----------------------------------------

fn star_alternating_subarray(nums: Vec[i64]) -> i64 {
    let mut best = -1;
    let mut run = 1;
    for i in 1..nums.len() {
        if run >= 2 and nums[i] == nums[i - 2] {
            run += 1;
        } else if nums[i] - nums[i - 1] == 1 {
            run = 2;
        } else {
            run = 1;
        }
        if run >= 2 {
            best = best.max(run);
        }
    }
    best
}


// ---- brute (alternating_brute.kara) ---------------------------------

fn brute_alternating_subarray(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut best = -1;
    for l in 0..n {
        for r in l + 1..n {
            let good = (l..=r).all(|i| nums[i] == nums[l] + (i - l) % 2);
            if good {
                best = best.max(r - l + 1);
            }
        }
    }
    best
}


// ---- steps (alternating_steps.kara) ---------------------------------

fn steps_alternating_subarray(nums: Vec[i64]) -> i64 {
    let steps: Vec[i64] = nums.windows(2).iter().map(|w| w[1] - w[0]).collect();
    let mut best = 0;
    let mut run = 0;
    for step in steps.iter() {
        let want = if run % 2 == 0 { 1 } else { -1 };
        if step == want {
            run += 1;
        } else if step == 1 {
            run = 1;
        } else {
            run = 0;
        }
        best = best.max(run);
    }
    if best == 0 { -1 } else { best + 1 }
}


// ---- starts (alternating_starts.kara) -------------------------------

struct Run {
    start: i64,
    length: i64,
}

fn starts_alternating_subarray(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut best = Run { start: 0, length: -1 };
    let mut l = 0;
    while l + 1 < n {
        if nums[l + 1] - nums[l] != 1 {
            l += 1;
            continue;
        }
        let mut r = l + 1;
        while r + 1 < n and nums[r + 1] == nums[r - 1] {
            r += 1;
        }
        if r - l + 1 > best.length {
            best = Run { start: l, length: r - l + 1 };
        }
        l = r;
    }
    best.length
}


// ---- solution (alternating_solution.kara) ---------------------------

struct Solution {}

impl Solution {
    pub fn alternating_subarray(nums: Vec[i32]) -> i32 {
        let n = nums.len();
        let mut ans: i32 = -1;
        for i in 0..n - 1 {
            if nums[i + 1] - nums[i] != 1 {
                continue;
            }
            let mut j = i + 1;
            while j < n and nums[j] - nums[i] == ((j - i) % 2) as i32 {
                j += 1;
            }
            ans = ans.max((j - i) as i32);
        }
        ans
    }
}

fn solution_alternating_subarray(nums: Vec[i64]) -> i64 {
    Solution.alternating_subarray(nums.iter().map(|x| x as i32).collect())
}


fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_alternating_subarray(nums),
        1 => brute_alternating_subarray(nums),
        2 => steps_alternating_subarray(nums),
        3 => starts_alternating_subarray(nums),
        _ => solution_alternating_subarray(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "brute", "steps", "starts", "solution"];
    let mut seed = 2765;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..3500 {
        let most = if c < 3000 { 14 } else { 99 };
        let n = next_random(mut seed) % most + 2;
        let top = next_random(mut seed) % 4 + 2;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        cases.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nums) in cases.iter().enumerate() {
        let want = literal(nums);
        check = (check * 31 + want + 2) % 1000000007;
        let n = nums.len();
        let raised: Vec[i64] = nums.iter().map(|x| x + 100).collect();
        let far = nums.iter().max().unwrap() + 50;
        let mut fenced: Vec[i64] = [far].to_vec();
        fenced.extend(nums.iter());
        fenced.push(far);
        let mut twice = nums.clone();
        twice.extend(nums.iter());
        let any_up = (1..n).any(|i| nums[i] - nums[i - 1] == 1);
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == want,
                answer(arm, raised) == value,
                answer(arm, fenced) == value,
                answer(arm, twice) >= value,
                (value == -1 or 2 <= value and value <= n) and (value == -1) == not any_up,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
