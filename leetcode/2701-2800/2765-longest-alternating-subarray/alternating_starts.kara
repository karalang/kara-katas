// LeetCode #2765: Longest Alternating Subarray -- the starts arm. From each
// start l with a step up of 1 the run is extended while each number repeats
// the one two back, and the next start is taken where the run ended, the
// numbers inside it starting no longer run; a `struct Run` holds the best.
// O(n).

struct Run {
    start: i64,
    length: i64,
}

fn alternating_subarray(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut best = Run { start: 0, length: -1 };
    let mut l = 0;
    while l + 1 < n {
        if nums[l + 1] - nums[l] != 1 {
            l += 1;
            continue;
        }
        let mut r = l + 1;
        while r + 1 < n and nums[r + 1] == nums[r - 1] {
            r += 1;
        }
        if r - l + 1 > best.length {
            best = Run { start: l, length: r - l + 1 };
        }
        l = r;
    }
    best.length
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{alternating_subarray([2, 3, 4, 3, 4].to_vec())}");
    println(f"{alternating_subarray([4, 5, 6].to_vec())}");
    // no step up of 1 at all; a run that must start on its second number;
    // 100 numbers alternating, LeetCode's most; and a run of 4 ended by a
    // step up that starts a longer one
    println(f"{alternating_subarray([5, 5, 5].to_vec())}");
    println(f"{alternating_subarray([3, 2, 3, 2].to_vec())}");
    println(f"{alternating_subarray((0..100).map(|i| 7 + i % 2).collect())}");
    println(f"{alternating_subarray([1, 2, 1, 2, 3, 2, 3, 2, 3].to_vec())}");
    // 20000 random arrays of 2 to 100 numbers, each from 1 to its own top
    // of 2 to 5
    let mut seed = 2765;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..20000 {
        let n = next_random(mut seed) % 99 + 2;
        let top = next_random(mut seed) % 4 + 2;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let a = alternating_subarray(nums);
        total += a;
        check = (check * 31 + a + 1) % 1000000007;
    }
    println(f"20000 arrays: lengths sum to {total}, checksum {check}");
}
