// LeetCode #2792: Count Nodes That Are Great Enough -- the differential.
// The five arms, against the statement read literally: for every node,
// its subtree gathered by a stack, and the node counted when the subtree
// holds at least k nodes and the node's value is greater than the values
// of at least k of them; no least values kept. 2000 random trees of 1 to
// 10 nodes with values from 1 to 5 and k from 1 to 4; then 50 of up to
// 2000 nodes with values up to 10^4 and k up to 10. Every case is drawn
// before any arm answers; the literal reading is asked only of the first
// 2000.
//
// P1  up to 10 nodes, the count is the literal reading's
// P2  every value 1000 more: the same count
// P3  the tree mirrored, each left child swapped with the right: the same
// P4  k one more: no more
// P5  from 0 to n - k, the k least values being in no count, and 0 when
//     every value is 1
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(vals: Vec[i64], left: Vec[i64], right: Vec[i64], k: i64) -> i64 {
    let n = vals.len();
    let mut count = 0;
    for u in 0..n {
        let mut subtree: Vec[i64] = Vec.new();
        let mut stack: Vec[i64] = [u];
        while let Some(w) = stack.pop() {
            subtree.push(w);
            if left[w] >= 0 {
                stack.push(left[w]);
            }
            if right[w] >= 0 {
                stack.push(right[w]);
            }
        }
        let below = subtree.iter().filter(|w| vals[w] < vals[u]).count();
        if subtree.len() >= k and below >= k {
            count += 1;
        }
    }
    count
}


// ---- star (great.kara) ----------------------------------------------

fn star_count_great_enough_nodes(vals: Vec[i64], left: Vec[i64], right: Vec[i64], k: i64) -> i64 {
    let n = vals.len();
    // the nodes in an order that puts every parent before its children
    let mut order: Vec[i64] = Vec.new();
    let mut stack: Vec[i64] = [0];
    while let Some(u) = stack.pop() {
        order.push(u);
        for c in [left[u], right[u]].iter() {
            if c >= 0 {
                stack.push(c);
            }
        }
    }
    let mut least: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    let mut great = 0;
    for u in order.iter().rev() {
        let mut mine: Vec[i64] = [vals[u]];
        for c in [left[u], right[u]].iter() {
            if c >= 0 {
                mine.extend(least[c].iter());
            }
        }
        mine.sort();
        mine.truncate(k);
        if mine.len() == k and mine[k - 1] < vals[u] {
            great += 1;
        }
        least[u] = mine;
    }
    great
}


// ---- heap (great_heap.kara) -----------------------------------------

fn heap_least(u: i64, vals: ref Vec[i64], left: ref Vec[i64], right: ref Vec[i64], k: i64, great: mut ref i64) -> PriorityQueue[i64] {
    let mut heap: PriorityQueue[i64] = PriorityQueue.new();
    heap.push(-vals[u]);
    for c in [left[u], right[u]].iter() {
        if c >= 0 {
            let mut below = heap_least(c, vals, left, right, k, mut great);
            while let Some(v) = below.pop() {
                heap.push(v);
                if heap.len() > k {
                    heap.pop();
                }
            }
        }
    }
    if heap.len() == k and -heap.peek().unwrap() < vals[u] {
        *great += 1;
    }
    heap
}

fn heap_count_great_enough_nodes(vals: Vec[i64], left: Vec[i64], right: Vec[i64], k: i64) -> i64 {
    let mut great = 0;
    heap_least(0, vals, left, right, k, mut great);
    great
}


// ---- tour (great_tour.kara) -----------------------------------------

fn tour_count_great_enough_nodes(vals: Vec[i64], left: Vec[i64], right: Vec[i64], k: i64) -> i64 {
    let n = vals.len();
    let mut tour: Vec[i64] = Vec.new();
    let mut start: Vec[i64] = Vec.filled(n, 0);
    let mut stack: Vec[i64] = [0];
    while let Some(u) = stack.pop() {
        start[u] = tour.len();
        tour.push(u);
        if right[u] >= 0 {
            stack.push(right[u]);
        }
        if left[u] >= 0 {
            stack.push(left[u]);
        }
    }
    // each subtree's size, children after parents in the tour
    let mut size: Vec[i64] = Vec.filled(n, 1);
    for u in tour.iter().rev() {
        for c in [left[u], right[u]].iter() {
            if c >= 0 {
                size[u] += size[c];
            }
        }
    }
    // the nodes whose runs end at each place
    let mut ending: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for u in 0..n {
        ending[start[u] + size[u]].push(u);
    }
    // the count below a node's value before its run, then at its end
    let top = vals.iter().max().unwrap();
    let mut fenwick: Vec[i64] = Vec.filled(top + 1, 0);
    let mut before: Vec[i64] = Vec.filled(n, 0);
    let mut great = 0;
    for place in 0..n + 1 {
        for u in ending[place].iter() {
            let mut below = 0;
            let mut i = vals[u] - 1;
            while i > 0 {
                below += fenwick[i];
                i -= i & -i;
            }
            if below - before[u] >= k {
                great += 1;
            }
        }
        if place < n {
            let u = tour[place];
            let mut below = 0;
            let mut i = vals[u] - 1;
            while i > 0 {
                below += fenwick[i];
                i -= i & -i;
            }
            before[u] = below;
            let mut i = vals[u];
            while i <= top {
                fenwick[i] += 1;
                i += i & -i;
            }
        }
    }
    great
}


// ---- merge (great_merge.kara) ---------------------------------------

fn merge_merged(a: ref Vec[i64], b: ref Vec[i64], k: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut (i, j) = (0, 0);
    while out.len() < k and (i < a.len() or j < b.len()) {
        if j == b.len() or (i < a.len() and a[i] <= b[j]) {
            out.push(a[i]);
            i += 1;
        } else {
            out.push(b[j]);
            j += 1;
        }
    }
    out
}

fn merge_walk(u: i64, vals: ref Vec[i64], left: ref Vec[i64], right: ref Vec[i64], k: i64) -> (Vec[i64], i64) {
    let (l, from_left) = if left[u] >= 0 { merge_walk(left[u], vals, left, right, k) } else { (Vec.new(), 0) };
    let (r, from_right) = if right[u] >= 0 { merge_walk(right[u], vals, left, right, k) } else { (Vec.new(), 0) };
    let children = merge_merged(l, r, k);
    let mine = merge_merged(children, [vals[u]], k);
    let here = if mine.len() == k and mine[k - 1] < vals[u] { 1 } else { 0 };
    (mine, from_left + from_right + here)
}

fn merge_count_great_enough_nodes(vals: Vec[i64], left: Vec[i64], right: Vec[i64], k: i64) -> i64 {
    let (_, great) = merge_walk(0, vals, left, right, k);
    great
}


// ---- solution (great_solution.kara) ---------------------------------

fn solution_dfs(node: Option[TreeNode], k: i64, ans: mut ref i32) -> Vec[i32] {
    match node {
        None => Vec.new(),
        Some(n) => {
            let mut v = solution_dfs(n.left, k, mut ans);
            v.extend(solution_dfs(n.right, k, mut ans));
            v.sort();
            if v.len() >= k and v[k - 1] < n.val {
                *ans += 1;
            }
            v.push(n.val);
            v.sort();
            v.truncate(k);
            v
        }
    }
}

struct Solution {}

impl Solution {
    pub fn count_great_enough_nodes(root: Option[TreeNode], k: i32) -> i32 {
        let mut ans = 0;
        solution_dfs(root, k, mut ans);
        ans
    }
}

// LeetCode's own node
shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn solution_count_great_enough_nodes(vals: Vec[i64], left: Vec[i64], right: Vec[i64], k: i64) -> i64 {
    let nodes: Vec[TreeNode] = vals.iter().map(|v| TreeNode { val: v as i32, left: None, right: None }).collect();
    for u in 0..vals.len() {
        if left[u] >= 0 {
            nodes[u].left = Some(nodes[left[u]]);
        }
        if right[u] >= 0 {
            nodes[u].right = Some(nodes[right[u]]);
        }
    }
    Solution.count_great_enough_nodes(Some(nodes[0]), k as i32)
}


fn answer(arm: i64, vals: Vec[i64], left: Vec[i64], right: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_count_great_enough_nodes(vals, left, right, k),
        1 => heap_count_great_enough_nodes(vals, left, right, k),
        2 => tour_count_great_enough_nodes(vals, left, right, k),
        3 => merge_count_great_enough_nodes(vals, left, right, k),
        _ => solution_count_great_enough_nodes(vals, left, right, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "heap", "tour", "merge", "solution"];
    let mut seed = 2792;
    let mut cases: Vec[(Vec[i64], Vec[i64], Vec[i64], i64)] = Vec.new();
    for c in 0..2050 {
        let (n, top, most) = if c < 2000 { (next_random(mut seed) % 10 + 1, 5, 4) } else { (wide(mut seed) % 2000 + 1, 10000, 10) };
        let vals: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let mut left: Vec[i64] = Vec.filled(n, -1);
        let mut right: Vec[i64] = Vec.filled(n, -1);
        for i in 1..n {
            let mut placed = false;
            while not placed {
                let p = wide(mut seed) % i;
                if next_random(mut seed) % 2 == 0 {
                    if left[p] < 0 {
                        left[p] = i;
                        placed = true;
                    }
                } else if right[p] < 0 {
                    right[p] = i;
                    placed = true;
                }
            }
        }
        cases.push((vals, left, right, next_random(mut seed) % most + 1));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (vals, left, right, k)) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(vals, left, right, k) } else { 0 };
        check = (check * 31 + want + 1) % 1000000007;
        let n = vals.len();
        let raised: Vec[i64] = vals.iter().map(|v| v + 1000).collect();
        let ones: Vec[i64] = Vec.filled(n, 1);
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, vals, left, right, k)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == want,
                answer(arm, raised, left, right, k) == value,
                answer(arm, vals, right, left, k) == value,
                answer(arm, vals, left, right, k + 1) <= value,
                value >= 0 and value <= (n - k).max(0) and answer(arm, ones, left, right, k) == 0,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {vals} {left} {right} k {k}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
