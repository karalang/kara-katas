// LeetCode #2780: Minimum Index of a Valid Split -- no counting table: a
// number held more than half the time fills the middle of the sorted
// array, so the dominant is a sorted copy's middle number; its count is
// the length of its run there, found by `partition_point` either side,
// and the first split is scanned as in the ★ arm. O(n log n).

fn minimum_index(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut sorted = nums.clone();
    sorted.sort();
    let x = sorted[n / 2];
    let total = sorted.partition_point(|v| v <= x) - sorted.partition_point(|v| v < x);
    let mut left = 0;
    for i in 0..n - 1 {
        if nums[i] == x {
            left += 1;
        }
        if 2 * left > i + 1 and 2 * (total - left) > n - i - 1 {
            return i;
        }
    }
    -1
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// n numbers with a dominant one: more than half of them x, the rest
// drawn from `others` values, shuffled
fn dominated(n: i64, others: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let x = wide(mut seed) % top + 1;
    let many = n / 2 + 1 + wide(mut seed) % (n - n / 2);
    let mut nums: Vec[i64] = Vec.filled(many, x);
    while nums.len() < n {
        let v = wide(mut seed) % others + 1;
        if v != x {
            nums.push(v);
        }
    }
    for i in (1..n).rev() {
        let j = wide(mut seed) % (i + 1);
        nums.swap(i, j);
    }
    nums
}

fn main() {
    // LeetCode's three examples; one number
    println(f"{minimum_index([1, 2, 2, 2].to_vec())}");
    println(f"{minimum_index([2, 1, 3, 1, 1, 1, 7, 1, 2, 1].to_vec())}");
    println(f"{minimum_index([3, 3, 3, 3, 7, 2, 2].to_vec())}");
    println(f"{minimum_index([5].to_vec())}");
    // 10^5 numbers, LeetCode's most: all 10^9; and 49999 different ones
    // before 50001 of the dominant
    let n = 100000;
    println(f"{minimum_index(Vec.filled(n, 1000000000))}");
    let late: Vec[i64] = (0..n).map(|i| if i < 49999 { i + 2 } else { 1 }).collect();
    println(f"{minimum_index(late)}");
    // 3000 random arrays of 1 to 12 numbers from 1 to 4; 20 of 10^5 up to
    // 10^9
    let mut seed = 2780;
    let mut found = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let m = next_random(mut seed) % 12 + 1;
        let a = minimum_index(dominated(m, 4, 4, mut seed));
        if a >= 0 {
            found += 1;
            total += a;
        }
        check = (check * 31 + a + 1) % 1000000007;
    }
    println(f"3000 small arrays: {found} split, indices sum to {total}, checksum {check}");
    let mut found = 0;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..20 {
        let a = minimum_index(dominated(n, 1000000000, 1000000000, mut seed));
        if a >= 0 {
            found += 1;
            total += a;
        }
        check = (check * 31 + a + 1) % 1000000007;
    }
    println(f"20 arrays of 10^5: {found} split, indices sum to {total}, checksum {check}");
}
