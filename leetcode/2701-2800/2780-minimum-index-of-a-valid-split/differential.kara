// LeetCode #2780: Minimum Index of a Valid Split -- the differential. The
// five arms, against the statement read literally: each split i in turn,
// the left part nums[0..=i] and the right part nums[i + 1..], and for
// every number of the left part its count in each part by `filter`; the
// split is valid when one number is more than half of both, and the
// answer is the first valid split, or -1; no vote and no table. 2000
// random arrays of 1 to 12 numbers from 1 to 4, more than half of them
// one number; then 50 of up to 2000 numbers up to 10^9, the others from
// 3 values or from 10^9. Every case is drawn before any arm answers; the
// literal reading is asked only of the first 2000.
//
// P1  up to 12 numbers, the answer is the literal reading's
// P2  every number 1000 more: the same answer
// P3  the numbers written twice over: a split, and no later one
// P4  the numbers reversed: a split just when there was one
// P5  -1 or from 0 to n - 2, -1 for one number, and a split answered
//     has one number more than half of each part
// P6  each arm agrees with at least three of the other four


// ---- star (split.kara) ----------------------------------------------

fn star_minimum_index(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut x = 0;
    let mut votes = 0;
    for v in nums.iter() {
        if votes == 0 {
            x = v;
        }
        votes += if v == x { 1 } else { -1 };
    }
    let total = nums.iter().filter(|v| v == x).count();
    let mut left = 0;
    for i in 0..n - 1 {
        if nums[i] == x {
            left += 1;
        }
        if 2 * left > i + 1 and 2 * (total - left) > n - i - 1 {
            return i;
        }
    }
    -1
}


// ---- counts (split_counts.kara) -------------------------------------

fn counts_minimum_index(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut counts: Map[i64, i64] = Map.new();
    for v in nums.iter() {
        *counts.entry(v).or_insert(0) += 1;
    }
    let (x, total) = counts.iter().find(|(_, c)| 2 * c > n).unwrap();
    let mut left = 0;
    for i in 0..n - 1 {
        if nums[i] == x {
            left += 1;
        }
        if 2 * left > i + 1 and 2 * (total - left) > n - i - 1 {
            return i;
        }
    }
    -1
}


// ---- sorted (split_sorted.kara) -------------------------------------

fn sorted_minimum_index(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut sorted = nums.clone();
    sorted.sort();
    let x = sorted[n / 2];
    let total = sorted.partition_point(|v| v <= x) - sorted.partition_point(|v| v < x);
    let mut left = 0;
    for i in 0..n - 1 {
        if nums[i] == x {
            left += 1;
        }
        if 2 * left > i + 1 and 2 * (total - left) > n - i - 1 {
            return i;
        }
    }
    -1
}


// ---- sides (split_sides.kara) ---------------------------------------

fn sides_minimum_index(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut left: Map[i64, i64] = Map.new();
    let mut right: Map[i64, i64] = Map.new();
    for v in nums.iter() {
        *right.entry(v).or_insert(0) += 1;
    }
    let mut leader = nums[0];
    for i in 0..n - 1 {
        let v = nums[i];
        let held = left.entry(v).or_insert(0);
        *held += 1;
        let now = *held;
        *right.entry(v).or_insert(0) -= 1;
        if now > (left.get(leader) ?? 0) {
            leader = v;
        }
        let on_left = left.get(leader) ?? 0;
        let on_right = right.get(leader) ?? 0;
        if 2 * on_left > i + 1 and 2 * on_right > n - i - 1 {
            return i;
        }
    }
    -1
}


// ---- solution (split_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn minimum_index(nums: Vec[i32]) -> i32 {
        let mut cnt: Map[i32, i32] = Map.new();
        for x in ref nums {
            *cnt.entry(x).or_insert(0) += 1;
        }
        let (x, total) = cnt.iter().max_by_key(|(_, c)| c).unwrap();
        let n = nums.len() as i32;
        let mut cur = 0;
        for (i, v) in nums.iter().enumerate() {
            if v == x {
                cur += 1;
            }
            let i = i as i32;
            if i < n - 1 and cur * 2 > i + 1 and (total - cur) * 2 > n - i - 1 {
                return i;
            }
        }
        -1
    }
}

fn solution_minimum_index(nums: Vec[i64]) -> i64 {
    let narrowed: Vec[i32] = nums.iter().map(|v| v as i32).collect();
    Solution.minimum_index(narrowed)
}


// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    for i in 0..n - 1 {
        let (left, right) = (nums[0..i + 1], nums[i + 1..n]);
        let valid = left.iter().any(|v| {
            2 * left.iter().filter(|w| w == v).count() > left.len()
                and 2 * right.iter().filter(|w| w == v).count() > right.len()
        });
        if valid {
            return i;
        }
    }
    -1
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_minimum_index(nums),
        1 => counts_minimum_index(nums),
        2 => sorted_minimum_index(nums),
        3 => sides_minimum_index(nums),
        _ => solution_minimum_index(nums),
    }
}

// one number more than half of nums[0..=i] and of nums[i + 1..]: the
// left part's middle once sorted is the only one that can be
fn holds(nums: Vec[i64], i: i64) -> bool {
    let n = nums.len();
    let mut left: Vec[i64] = nums[0..i + 1].to_vec();
    left.sort();
    let x = left[(i + 1) / 2];
    let on_left = left.iter().filter(|v| v == x).count();
    let on_right = nums[i + 1..n].iter().filter(|v| v == x).count();
    2 * on_left > i + 1 and 2 * on_right > n - i - 1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// n numbers with a dominant one: more than half of them x, the rest
// drawn from `others` values, shuffled
fn dominated(n: i64, others: i64, top: i64, seed: mut ref i64) -> Vec[i64] {
    let x = wide(mut seed) % top + 1;
    let many = n / 2 + 1 + wide(mut seed) % (n - n / 2);
    let mut nums: Vec[i64] = Vec.filled(many, x);
    while nums.len() < n {
        let v = wide(mut seed) % others + 1;
        if v != x {
            nums.push(v);
        }
    }
    for i in (1..n).rev() {
        let j = wide(mut seed) % (i + 1);
        nums.swap(i, j);
    }
    nums
}

fn main() {
    let names = ["star", "counts", "sorted", "sides", "solution"];
    let mut seed = 2780;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        if c < 2000 {
            let n = next_random(mut seed) % 12 + 1;
            cases.push(dominated(n, 4, 4, mut seed));
        } else {
            let n = wide(mut seed) % 2000 + 1;
            let others = if c % 2 == 0 { 3 } else { 1000000000 };
            cases.push(dominated(n, others, 1000000000, mut seed));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nums) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(nums) } else { 0 };
        check = (check * 31 + want + 2) % 1000000007;
        let n = nums.len();
        let shifted: Vec[i64] = nums.iter().map(|x| x + 1000).collect();
        let twice: Vec[i64] = nums.iter().chain(nums.iter()).collect();
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let doubled = answer(arm, twice);
            let verdicts = [
                not small or value == want,
                answer(arm, shifted) == value,
                doubled >= 0 and (value == -1 or doubled <= value),
                (answer(arm, reversed) == -1) == (value == -1),
                value >= -1 and value <= n - 2 and (n > 1 or value == -1) and (value == -1 or holds(nums, value)),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
