// LeetCode #2734: Lexicographically Smallest String After Substring
// Operation -- the bench (smallest.kara): the run from the first letter
// that is not an 'a' up to the next 'a' moved back a letter, edited in a
// `Vec[u8]`.

fn smallest_string(s: String) -> String {
    let mut b: Vec[u8] = s.bytes().to_vec();
    let n = b.len();
    let mut i = 0;
    while i < n and b[i] == b'a' {
        i += 1;
    }
    if i == n {
        b[n - 1] = b'z';
    } else {
        while i < n and b[i] != b'a' {
            b[i] -= 1;
            i += 1;
        }
    }
    String.from_utf8(b).unwrap()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100;
    let n = 100000;
    let rounds = 20;
    let mut seed = 2734;
    let mut words: Vec[String] = Vec.new();
    for _ in 0..count {
        // 10^5 letters: up to 5 * 10^4 'a's first, then letters with an
        // 'a' 1 time in 5000, so the run moved back is long
        let lead = next_random(mut seed) % (n / 2);
        let mut word = String.new();
        for k in 0..n {
            let letter = if k < lead or next_random(mut seed) % 5000 == 0 { b'a' } else { b'b' + (next_random(mut seed) % 25) as u8 };
            word.push(letter as char);
        }
        words.push(word);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for word in words.iter() {
            let answer = smallest_string(word);
            let b = answer.bytes();
            let w = word.bytes();
            let mut moved = 0;
            for k in 0..b.len() {
                if b[k] != w[k] {
                    moved += 1;
                }
            }
            sum += moved;
            check = (check * 31 + moved + (b[b.len() / 2] - b'a') + r) % 1000000007;
        }
    }
    println(f"{count} words of {n} letters, {rounds} rounds: letters moved sum to {sum}, checksum {check}");
}
