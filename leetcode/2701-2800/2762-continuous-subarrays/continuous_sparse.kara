// LeetCode #2762: Continuous Subarrays -- the sparse arm. Sparse tables of
// the least and greatest of every stretch of 2^k numbers, a `Vec` of rows
// each built from the one before; any range's least and greatest from two
// overlapping stretches, and two pointers: left moves on while the range
// [left, right] spans more than 2. O(n log n).

struct Sparse {
    lows: Vec[Vec[i64]],
    highs: Vec[Vec[i64]],
}

impl Sparse {
    fn new(nums: Vec[i64]) -> Sparse {
        let mut lows: Vec[Vec[i64]] = [nums.clone()].to_vec();
        let mut highs: Vec[Vec[i64]] = [nums.clone()].to_vec();
        let mut width = 1;
        while 2 * width <= nums.len() {
            let low = lows.last().unwrap();
            let high = highs.last().unwrap();
            let next_low: Vec[i64] = (0..nums.len() - 2 * width + 1).map(|i| low[i].min(low[i + width])).collect();
            let next_high: Vec[i64] = (0..nums.len() - 2 * width + 1).map(|i| high[i].max(high[i + width])).collect();
            lows.push(next_low);
            highs.push(next_high);
            width *= 2;
        }
        Sparse { lows, highs }
    }

    fn span(self, from: i64, to: i64) -> i64 {
        let mut k = 0;
        while 1 << (k + 1) <= to - from + 1 {
            k += 1;
        }
        let other = to - (1 << k) + 1;
        let high = self.highs[k][from].max(self.highs[k][other]);
        let low = self.lows[k][from].min(self.lows[k][other]);
        high - low
    }
}

fn continuous_subarrays(nums: Vec[i64]) -> i64 {
    let table = Sparse.new(nums);
    let mut left = 0;
    let mut total = 0;
    for right in 0..nums.len() {
        while table.span(left, right) > 2 {
            left += 1;
        }
        total += right - left + 1;
    }
    total
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn walk(n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut value = 500000000;
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..n {
        value += next_random(mut seed) % 3 - 1;
        nums.push(value);
    }
    nums
}

fn main() {
    // LeetCode's two examples
    println(f"{continuous_subarrays([5, 4, 2, 4].to_vec())}");
    println(f"{continuous_subarrays([1, 2, 3].to_vec())}");
    // one number; neighbours 3 apart, so only the single numbers
    println(f"{continuous_subarrays([7].to_vec())}");
    println(f"{continuous_subarrays([1, 4, 1, 4].to_vec())}");
    // 10^5 equal numbers, LeetCode's most: every subarray; and 10^5 rising
    // by 1: windows of at most 3
    println(f"{continuous_subarrays(Vec.filled(100000, 1000000000))}");
    println(f"{continuous_subarrays((1..=100000).collect())}");
    // 3000 random arrays of 1 to 30 numbers from 1 to 6; then 20 random
    // walks of 10^5 steps of -1, 0 or 1
    let mut seed = 2762;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let n = next_random(mut seed) % 30 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 6 + 1).collect();
        let a = continuous_subarrays(nums);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"3000 small arrays: subarrays sum to {total}, checksum {check}");
    let mut total = 0;
    let mut check = 0;
    for _ in 0..20 {
        let a = continuous_subarrays(walk(100000, mut seed));
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"20 walks of 100000: subarrays sum to {total}, checksum {check}");
}
