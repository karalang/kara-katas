// LeetCode #2751: Robot Collisions -- the differential. The five arms,
// against the statement read literally: time run in half steps, every
// position doubled and each robot moving one place a tick, and two robots
// on one place fighting there; run until no robot moving right has one
// moving left anywhere after it. No stack. 2000 random cases of 1 to 10
// robots at positions up to 30 with healths up to 5; then 100 of up to
// 2000 robots, positions and healths up to 10^9. Every case is drawn
// before any arm answers; the literal reading is asked only of the first
// 2000.
//
// P1  up to 10 robots, the survivors are the literal reading's
// P2  every position mirrored and every direction turned: the same
//     survivors
// P3  every position doubled, less 1: the same survivors
// P4  the robots listed in reverse order: the survivors reversed
// P5  no more survivors than robots and no health above the total; and
//     every robot facing right: every health as it was
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(positions: Vec[i64], healths: Vec[i64], directions: String) -> Vec[i64] {
    let n = positions.len();
    let right: Vec[bool] = directions.chars().map(|c| c == 'R').collect();
    let mut place: Vec[i64] = positions.iter().map(|p| 2 * p).collect();
    let mut health = healths.clone();
    loop {
        let mut pending = false;
        for i in 0..n {
            for j in 0..n {
                if health[i] > 0 and health[j] > 0 and right[i] and not right[j] and place[i] < place[j] {
                    pending = true;
                }
            }
        }
        if not pending {
            break;
        }
        for i in 0..n {
            if health[i] > 0 {
                place[i] += if right[i] { 1 } else { -1 };
            }
        }
        for i in 0..n {
            for j in i + 1..n {
                if health[i] > 0 and health[j] > 0 and place[i] == place[j] {
                    if health[i] > health[j] {
                        health[i] -= 1;
                        health[j] = 0;
                    } else if health[i] < health[j] {
                        health[j] -= 1;
                        health[i] = 0;
                    } else {
                        health[i] = 0;
                        health[j] = 0;
                    }
                }
            }
        }
    }
    health.into_iter().filter(|h| h > 0).collect()
}


// ---- star (robots.kara) ---------------------------------------------

fn star_survived_robots_healths(positions: Vec[i64], healths: Vec[i64], directions: String) -> Vec[i64] {
    let n = positions.len();
    let facing = directions.bytes();
    let mut health = healths.clone();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by_key(|i| positions[i]);
    let mut rightward: Vec[i64] = Vec.new();
    for i in order.iter() {
        if facing[i] == b'R' {
            rightward.push(i);
            continue;
        }
        while health[i] > 0 {
            let Some(top) = rightward.last().cloned() else { break };
            if health[top] < health[i] {
                health[top] = 0;
                rightward.pop();
                health[i] -= 1;
            } else if health[top] > health[i] {
                health[top] -= 1;
                health[i] = 0;
            } else {
                health[top] = 0;
                rightward.pop();
                health[i] = 0;
            }
        }
    }
    health.into_iter().filter(|h| h > 0).collect()
}


// ---- mirror (robots_mirror.kara) ------------------------------------

fn mirror_survived_robots_healths(positions: Vec[i64], healths: Vec[i64], directions: String) -> Vec[i64] {
    let n = positions.len();
    let facing: Vec[char] = directions.chars().collect();
    let mut health = healths.clone();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by(|a, b| positions[b].cmp(positions[a]));
    let mut leftward: Vec[i64] = Vec.new();
    for i in order.iter() {
        if facing[i] == 'L' {
            leftward.push(i);
            continue;
        }
        while health[i] > 0 and not leftward.is_empty() {
            let top = leftward[leftward.len() - 1];
            match health[top].cmp(health[i]) {
                Ordering.Less => {
                    health[top] = 0;
                    leftward.pop();
                    health[i] -= 1;
                }
                Ordering.Greater => {
                    health[top] -= 1;
                    health[i] = 0;
                }
                Ordering.Equal => {
                    health[top] = 0;
                    leftward.pop();
                    health[i] = 0;
                }
            }
        }
    }
    health.iter().filter(|h| h > 0).collect()
}


// ---- linked (robots_linked.kara) ------------------------------------

fn linked_survived_robots_healths(positions: Vec[i64], healths: Vec[i64], directions: String) -> Vec[i64] {
    let n = positions.len();
    let right: Vec[bool] = directions.chars().map(|c| c == 'R').collect();
    let mut health = healths.clone();
    let mut order: Vec[i64] = (0..n).collect();
    order.sort_by_key(|i| positions[i]);
    // links between places in `order`; -1 for none, n past the end
    let mut prev: Vec[i64] = (0..n).map(|k| k - 1).collect();
    let mut next: Vec[i64] = (0..n).map(|k| k + 1).collect();
    let unlink = |k: i64, prev: mut ref Vec[i64], next: mut ref Vec[i64]| {
        let (p, q) = (prev[k], next[k]);
        if p >= 0 {
            next[p] = q;
        }
        if q < n {
            prev[q] = p;
        }
    };
    let mut k = 0;
    while k < n {
        let q = next[k];
        if q < n and right[order[k]] and not right[order[q]] {
            let (a, b) = (order[k], order[q]);
            if health[a] > health[b] {
                health[a] -= 1;
                health[b] = 0;
                unlink(q, mut prev, mut next);
            } else if health[a] < health[b] {
                health[b] -= 1;
                health[a] = 0;
                unlink(k, mut prev, mut next);
                k = if prev[k] >= 0 { prev[k] } else { q };
            } else {
                health[a] = 0;
                health[b] = 0;
                unlink(k, mut prev, mut next);
                unlink(q, mut prev, mut next);
                k = if prev[k] >= 0 { prev[k] } else { next[q] };
            }
        } else {
            k = q;
        }
    }
    health.into_iter().filter(|h| h > 0).collect()
}


// ---- structs (robots_structs.kara) ----------------------------------

struct Robot {
    index: i64,
    position: i64,
    health: i64,
    right: bool,
}

fn structs_survived_robots_healths(positions: Vec[i64], healths: Vec[i64], directions: String) -> Vec[i64] {
    let mut robots: Vec[Robot] = directions
        .chars()
        .enumerate()
        .map(|(i, c)| Robot { index: i, position: positions[i], health: healths[i], right: c == 'R' })
        .collect();
    robots.sort_by_key(|r| r.position);
    let mut stack: Vec[Robot] = Vec.new();
    let mut survivors: Vec[Robot] = Vec.new();
    for robot in robots.into_iter() {
        if robot.right {
            stack.push(robot);
            continue;
        }
        let mut robot = robot;
        let mut alive = true;
        while let Some(top) = stack.pop() {
            let mut top = top;
            if top.health > robot.health {
                top.health -= 1;
                stack.push(top);
                alive = false;
                break;
            }
            if top.health == robot.health {
                alive = false;
                break;
            }
            robot.health -= 1;
        }
        if alive {
            survivors.push(robot);
        }
    }
    survivors.extend(stack.into_iter());
    survivors.sort_by_key(|r| r.index);
    survivors.iter().map(|r| r.health).collect()
}


// ---- solution (robots_solution.kara) --------------------------------

struct Solution {}

impl Solution {
    pub fn survived_robots_healths(positions: Vec[i32], healths: own Vec[i32], directions: String) -> Vec[i32] {
        let mut healths = healths;
        let n = positions.len();
        let mut idx: Vec[i64] = (0..n).collect();
        idx.sort_by_key(|i| positions[i]);
        let dirs = directions.bytes();
        let mut stack: Vec[i64] = Vec.new();
        for i in ref idx {
            if dirs[i] == b'R' {
                stack.push(i);
            } else {
                while let Some(j) = stack.last().cloned() {
                    if healths[i] == 0 {
                        break;
                    }
                    if healths[j] < healths[i] {
                        healths[j] = 0;
                        healths[i] -= 1;
                        stack.pop();
                    } else if healths[j] > healths[i] {
                        healths[j] -= 1;
                        healths[i] = 0;
                        break;
                    } else {
                        healths[j] = 0;
                        healths[i] = 0;
                        stack.pop();
                        break;
                    }
                }
            }
        }
        healths.into_iter().filter(|h| h > 0).collect()
    }
}

fn solution_survived_robots_healths(positions: Vec[i64], healths: Vec[i64], directions: String) -> Vec[i64] {
    let positions: Vec[i32] = positions.iter().map(|p| p as i32).collect();
    let healths: Vec[i32] = healths.iter().map(|h| h as i32).collect();
    Solution.survived_robots_healths(positions, healths, directions).into_iter().map(|h| h as i64).collect()
}


fn answer(arm: i64, positions: Vec[i64], healths: Vec[i64], directions: String) -> Vec[i64] {
    match arm {
        0 => star_survived_robots_healths(positions, healths, directions),
        1 => mirror_survived_robots_healths(positions, healths, directions),
        2 => linked_survived_robots_healths(positions, healths, directions),
        3 => structs_survived_robots_healths(positions, healths, directions),
        _ => solution_survived_robots_healths(positions, healths, directions),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

struct Case {
    positions: Vec[i64],
    healths: Vec[i64],
    directions: String,
}

fn random_case(seed: mut ref i64, n: i64, far: i64, strongest: i64) -> Case {
    let mut taken: Set[i64] = Set.new();
    let mut positions: Vec[i64] = Vec.new();
    while positions.len() < n {
        let p = (next_random(mut seed) * 32768 + next_random(mut seed)) % far + 1;
        if taken.insert(p) {
            positions.push(p);
        }
    }
    let healths: Vec[i64] = (0..n).map(|_| next_random(mut seed) % strongest + 1).collect();
    let directions: String = (0..n).map(|_| if next_random(mut seed) % 2 == 0 { 'L' } else { 'R' }).collect();
    Case { positions, healths, directions }
}

fn main() {
    let names = ["star", "mirror", "linked", "structs", "solution"];
    let mut seed = 2751;
    let mut cases: Vec[Case] = Vec.new();
    for c in 0..2100 {
        if c < 2000 {
            let n = next_random(mut seed) % 10 + 1;
            cases.push(random_case(mut seed, n, 30, 5));
        } else {
            let n = next_random(mut seed) % 2000 + 1;
            cases.push(random_case(mut seed, n, 1000000000, 1000000000));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, case) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(case.positions, case.healths, case.directions) } else { Vec.new() };
        check = (check * 31 + want.len()) % 1000000007;
        for h in want.iter() {
            check = (check * 31 + h) % 1000000007;
        }
        let n = case.positions.len();
        let mirrored: Vec[i64] = case.positions.iter().map(|p| 1000000001 - p).collect();
        let turned: String = case.directions.chars().map(|d| if d == 'R' { 'L' } else { 'R' }).collect();
        let stretched: Vec[i64] = case.positions.iter().map(|p| 2 * p - 1).collect();
        let positions_back: Vec[i64] = case.positions.iter().rev().collect();
        let healths_back: Vec[i64] = case.healths.iter().rev().collect();
        let directions_back: String = case.directions.chars().rev().collect();
        let all_right: String = "R".repeat(n);
        let total: i64 = case.healths.iter().sum();
        let got: Vec[Vec[i64]] = (0..5).map(|arm| answer(arm, case.positions, case.healths, case.directions)).collect();
        for arm in 0..5 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let reversed: Vec[i64] = value.iter().rev().collect();
            let verdicts = [
                not small or value == want,
                answer(arm, mirrored, case.healths, turned) == value,
                answer(arm, stretched, case.healths, case.directions) == value,
                answer(arm, positions_back, healths_back, directions_back) == reversed,
                value.len() <= n and value.iter().all(|h| 0 < h and h <= total) and answer(arm, case.positions, case.healths, all_right) == case.healths,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {case.positions} {case.healths} {case.directions}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
