// LeetCode #2743: Count Substrings Without Repeating Character -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac
// fix`: a `HashMap<char, usize>` of last places and `chars().enumerate()`.

struct Solution {}

impl Solution {
    pub fn number_of_special_substrings(s: String) -> i32 {
        let mut last: Map[char, i64] = Map.new();
        let mut left = 0;
        let mut ans: i32 = 0;
        for (i, c) in s.chars().enumerate() {
            if let Some(j) = last.get(c).cloned() {
                if j >= left {
                    left = j + 1;
                }
            }
            last.insert(c, i);
            ans += (i - left + 1) as i32;
        }
        ans
    }
}

fn number_of_special_substrings(s: Str) -> i64 {
    Solution.number_of_special_substrings(s.to_string())
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters drawn from the first k of the alphabet
fn random_word(seed: mut ref i64, n: i64, k: i64) -> String {
    let bytes: Vec[u8] = (0..n).map(|_| b'a' + (next_random(mut seed) % k) as u8).collect();
    String.from_utf8(bytes).unwrap()
}

fn main() {
    // LeetCode's two examples
    println(f"{number_of_special_substrings("abcd")}");
    println(f"{number_of_special_substrings("ooo")}");
    // one letter; a word that repeats; and the alphabet, every substring
    // special
    println(f"{number_of_special_substrings("a")}");
    println(f"{number_of_special_substrings("abab")}");
    println(f"{number_of_special_substrings("abcdefghijklmnopqrstuvwxyz")}");
    // 2000 random words of 1 to 30 letters from the first 1 to 26 of the
    // alphabet; then 20 of 10^5 letters, LeetCode's longest
    let mut seed = 2743;
    let mut sum = 0;
    let mut check = 0;
    for c in 0..2020 {
        let (n, k) = if c < 2000 { (next_random(mut seed) % 30 + 1, next_random(mut seed) % 26 + 1) } else { (100000, next_random(mut seed) % 26 + 1) };
        let s = random_word(mut seed, n, k);
        let count = number_of_special_substrings(s);
        sum += count;
        check = (check * 31 + count) % 1000000007;
        if c == 1999 {
            println(f"2000 small words: counts sum to {sum}, checksum {check}");
            sum = 0;
            check = 0;
        }
    }
    println(f"20 words of 100000 letters: counts sum to {sum}, checksum {check}");
}
