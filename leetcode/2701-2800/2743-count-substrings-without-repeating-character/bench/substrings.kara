// LeetCode #2743: Count Substrings Without Repeating Character -- the
// bench: the ★ arm, a window with each letter's last place, over words
// of 10^5 letters drawn first.

fn number_of_special_substrings(s: Str) -> i64 {
    let bytes = s.bytes();
    let mut last: Array[i64, 26] = [-1; 26];
    let mut start = 0;
    let mut count = 0;
    for i in 0..bytes.len() {
        let letter = (bytes[i] - b'a') as i64;
        start = start.max(last[letter] + 1);
        last[letter] = i;
        count += i - start + 1;
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 20;
    let n = 100000;
    let rounds = 300;
    let mut seed = 2743;
    let mut words: Vec[String] = Vec.new();
    for _ in 0..count {
        // 10^5 letters, LeetCode's most, from the first 5 to 26 of the
        // alphabet
        let k = next_random(mut seed) % 22 + 5;
        let mut bytes: Vec[u8] = Vec.new();
        for _ in 0..n {
            bytes.push(b'a' + (next_random(mut seed) % k) as u8);
        }
        words.push(String.from_utf8(bytes).unwrap());
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for s in words.iter() {
            let found = number_of_special_substrings(s);
            sum += found;
            check = (check * 31 + found + r) % 1000000007;
        }
    }
    println(f"{count} words of {n} letters, {rounds} rounds: counts sum to {sum}, checksum {check}");
}
