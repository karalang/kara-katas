// LeetCode #2785: Sort Vowels in a String -- the bench: the ★ arm over
// 20 strings of 10^5 letters, LeetCode's longest, from all 52, all drawn
// first, then each answered 10 times.

fn is_vowel(c: char) -> bool {
    match c {
        'a' | 'e' | 'i' | 'o' | 'u' | 'A' | 'E' | 'I' | 'O' | 'U' => true,
        _ => false,
    }
}

fn sort_vowels(s: Str) -> String {
    let mut vowels: Vec[char] = s.chars().filter(|c| is_vowel(c)).collect();
    vowels.sort();
    let mut next = 0;
    let mut out = String.new();
    for c in s.chars() {
        if is_vowel(c) {
            out.push(vowels[next]);
            next += 1;
        } else {
            out.push(c);
        }
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_text(n: i64, from: Str, seed: mut ref i64) -> String {
    let letters: Vec[char] = from.chars().collect();
    let mut s = String.new();
    for _ in 0..n {
        s.push(letters[next_random(mut seed) % letters.len()]);
    }
    s
}

fn main() {
    let count = 20;
    let rounds = 10;
    let mut seed = 2785;
    let every = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let cases: Vec[String] = (0..count).map(|_| random_text(100000, every, mut seed)).collect();
    let mut check = 0;
    for r in 0..rounds {
        for s in cases.iter() {
            let t = sort_vowels(s);
            check = t.bytes().iter().fold(check, |c, b| (c * 31 + b) % 1000000007);
            check = (check + r) % 1000000007;
        }
    }
    println(f"{count} strings of 10^5, {rounds} rounds: checksum {check}");
}
