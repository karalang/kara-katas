// LeetCode #2768: Number of Black Blocks -- the differential. The five
// arms, against the statement read literally: the grid drawn whole as
// rows of cells, each black cell marked, and every block's four cells
// looked at, the blocks counted by how many are black; no map. 2000
// random grids of 2 to 8 by 2 to 8; then 60 of up to 10^5 by 10^5 with
// up to 500 black cells. Every case is drawn before any arm answers; the
// literal reading is asked only of the first 2000.
//
// P1  up to 8 by 8, the counts are the literal reading's
// P2  the grid transposed: the same counts
// P3  the grid turned upside down: the same counts
// P4  the black cells listed in reverse: the same counts
// P5  no count below 0, the counts summing to (m - 1) (n - 1), and the
//     black cells over all blocks the blocks each black cell lies in
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(m: i64, n: i64, coordinates: Vec[Vec[i64]]) -> Vec[i64] {
    let mut grid: Vec[Vec[bool]] = Vec.filled(m, Vec.filled(n, false));
    for cell in coordinates.iter() {
        grid[cell[0]][cell[1]] = true;
    }
    let mut counts: Vec[i64] = Vec.filled(5, 0);
    for x in 0..m - 1 {
        for y in 0..n - 1 {
            let black = [grid[x][y], grid[x][y + 1], grid[x + 1][y], grid[x + 1][y + 1]].iter().filter(|b| b).count();
            counts[black] += 1;
        }
    }
    counts
}


// ---- star (blocks.kara) ---------------------------------------------

fn star_count_black_blocks(m: i64, n: i64, coordinates: Vec[Vec[i64]]) -> Vec[i64] {
    let mut blocks: Map[(i64, i64), i64] = Map.new();
    for cell in coordinates.iter() {
        let (x, y) = (cell[0], cell[1]);
        for bx in (x - 1).max(0)..=x.min(m - 2) {
            for by in (y - 1).max(0)..=y.min(n - 2) {
                *blocks.entry((bx, by)).or_insert(0) += 1;
            }
        }
    }
    let mut counts: Vec[i64] = Vec.filled(5, 0);
    for (_, black) in blocks.iter() {
        counts[black] += 1;
    }
    counts[0] = (m - 1) * (n - 1) - blocks.len();
    counts
}


// ---- sorted (blocks_sorted.kara) ------------------------------------

fn sorted_count_black_blocks(m: i64, n: i64, coordinates: Vec[Vec[i64]]) -> Vec[i64] {
    let mut keys: Vec[i64] = Vec.new();
    for cell in coordinates.iter() {
        let (x, y) = (cell[0], cell[1]);
        for bx in (x - 1).max(0)..=x.min(m - 2) {
            for by in (y - 1).max(0)..=y.min(n - 2) {
                keys.push(bx * n + by);
            }
        }
    }
    keys.sort();
    let mut counts: Vec[i64] = Vec.filled(5, 0);
    let mut start = 0;
    while start < keys.len() {
        let mut end = start + 1;
        while end < keys.len() and keys[end] == keys[start] {
            end += 1;
        }
        counts[end - start] += 1;
        start = end;
    }
    counts[0] = (m - 1) * (n - 1) - counts[1..].iter().sum();
    counts
}


// ---- set (blocks_set.kara) ------------------------------------------

fn set_count_black_blocks(m: i64, n: i64, coordinates: Vec[Vec[i64]]) -> Vec[i64] {
    let black: Set[(i64, i64)] = coordinates.iter().map(|cell| (cell[0], cell[1])).collect();
    let mut counts: Vec[i64] = Vec.filled(5, 0);
    let mut seen = 0;
    for cell in coordinates.iter() {
        let (x, y) = (cell[0], cell[1]);
        for bx in (x - 1).max(0)..=x.min(m - 2) {
            for by in (y - 1).max(0)..=y.min(n - 2) {
                let corners = [(bx, by), (bx, by + 1), (bx + 1, by), (bx + 1, by + 1)];
                let first = corners.iter().find(|c| black.contains(c)).unwrap();
                if first == (x, y) {
                    counts[corners.iter().filter(|c| black.contains(c)).count()] += 1;
                    seen += 1;
                }
            }
        }
    }
    counts[0] = (m - 1) * (n - 1) - seen;
    counts
}


// ---- rows (blocks_rows.kara) ----------------------------------------

fn rows_black_at(rows: SortedMap[i64, Vec[i64]], x: i64, y: i64) -> bool {
    match rows.get(x) {
        Some(cols) => cols.binary_search(y).is_some(),
        None => false,
    }
}

fn rows_count_black_blocks(m: i64, n: i64, coordinates: Vec[Vec[i64]]) -> Vec[i64] {
    let mut rows: SortedMap[i64, Vec[i64]] = SortedMap.new();
    for cell in coordinates.iter() {
        rows.entry(cell[0]).or_insert(Vec.new()).push(cell[1]);
    }
    for cols in rows.values_mut() {
        cols.sort();
    }
    let mut block_rows: Vec[i64] = Vec.new();
    for x in rows.keys() {
        for bx in [x - 1, x] {
            if 0 <= bx and bx <= m - 2 and block_rows.last().cloned() != Some(bx) {
                block_rows.push(bx);
            }
        }
    }
    let mut counts: Vec[i64] = Vec.filled(5, 0);
    let mut seen = 0;
    for bx in block_rows.iter() {
        let mut starts: Vec[i64] = Vec.new();
        for x in [bx, bx + 1] {
            if let Some(cols) = rows.get(x) {
                for y in cols.iter() {
                    starts.push(y - 1);
                    starts.push(y);
                }
            }
        }
        starts.sort();
        starts.dedup();
        for by in starts.iter() {
            if by < 0 or by > n - 2 {
                continue;
            }
            let mut black = 0;
            for (x, y) in [(bx, by), (bx, by + 1), (bx + 1, by), (bx + 1, by + 1)] {
                if rows_black_at(rows, x, y) {
                    black += 1;
                }
            }
            counts[black] += 1;
            seen += 1;
        }
    }
    counts[0] = (m - 1) * (n - 1) - seen;
    counts
}


// ---- solution (blocks_solution.kara) --------------------------------

struct Solution {}

impl Solution {
    pub fn count_black_blocks(m: i32, n: i32, coordinates: Vec[Vec[i32]]) -> Vec[i64] {
        let mut cnt: Map[i64, i32] = Map.new();
        let (m, n) = (m as i64, n as i64);
        for c in coordinates.iter() {
            let (x, y) = (c[0] as i64, c[1] as i64);
            for dx in 0..2 {
                for dy in 0..2 {
                    let (i, j) = (x - dx, y - dy);
                    if i >= 0 and i < m - 1 and j >= 0 and j < n - 1 {
                        *cnt.entry(i * n + j).or_insert(0) += 1;
                    }
                }
            }
        }
        let mut ans = Vec.filled(5, 0);
        for v in cnt.values() {
            ans[v as usize] += 1;
        }
        ans[0] = (m - 1) * (n - 1) - cnt.len();
        ans
    }
}

fn solution_count_black_blocks(m: i64, n: i64, coordinates: Vec[Vec[i64]]) -> Vec[i64] {
    let narrowed: Vec[Vec[i32]] = coordinates.iter().map(|c| c.iter().map(|v| v as i32).collect()).collect();
    Solution.count_black_blocks(m as i32, n as i32, narrowed)
}


fn answer(arm: i64, m: i64, n: i64, coordinates: Vec[Vec[i64]]) -> Vec[i64] {
    match arm {
        0 => star_count_black_blocks(m, n, coordinates),
        1 => sorted_count_black_blocks(m, n, coordinates),
        2 => set_count_black_blocks(m, n, coordinates),
        3 => rows_count_black_blocks(m, n, coordinates),
        _ => solution_count_black_blocks(m, n, coordinates),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

// a small grid, each cell black at a density of its own, the cells listed
// in a random order
fn small_case(seed: mut ref i64) -> (i64, i64, Vec[Vec[i64]]) {
    let m = next_random(mut seed) % 7 + 2;
    let n = next_random(mut seed) % 7 + 2;
    let density = next_random(mut seed) % 4 + 1;
    let mut cells: Vec[Vec[i64]] = Vec.new();
    for x in 0..m {
        for y in 0..n {
            if next_random(mut seed) % 5 < density {
                cells.push([x, y].to_vec());
            }
        }
    }
    for i in (1..cells.len()).rev() {
        let j = wide(mut seed) % (i + 1);
        cells.swap(i, j);
    }
    (m, n, cells)
}

// a grid up to 10^5 by 10^5, up to 500 distinct black cells in a square of
// side 23 to 300 placed at random, by a stride through the square coprime
// with its area
fn large_case(seed: mut ref i64) -> (i64, i64, Vec[Vec[i64]]) {
    let side = wide(mut seed) % 278 + 23;
    let area = side * side;
    let m = side + wide(mut seed) % (100001 - side);
    let n = side + wide(mut seed) % (100001 - side);
    let x0 = wide(mut seed) % (m - side + 1);
    let y0 = wide(mut seed) % (n - side + 1);
    let mut stride = wide(mut seed) % area;
    while gcd(stride, area) != 1 {
        stride = wide(mut seed) % area;
    }
    let start = wide(mut seed) % area;
    let count = wide(mut seed) % 500 + 1;
    let cells: Vec[Vec[i64]] = (0..count)
        .map(|k| {
            let at = (start + k * stride) % area;
            [x0 + at / side, y0 + at % side].to_vec()
        })
        .collect();
    (m, n, cells)
}

// how many blocks the cell lies in: one to four
fn blocks_of(m: i64, n: i64, x: i64, y: i64) -> i64 {
    (x.min(m - 2) - (x - 1).max(0) + 1) * (y.min(n - 2) - (y - 1).max(0) + 1)
}

fn main() {
    let names = ["star", "sorted", "set", "rows", "solution"];
    let mut seed = 2768;
    let mut cases: Vec[(i64, i64, Vec[Vec[i64]])] = Vec.new();
    for c in 0..2060 {
        cases.push(if c < 2000 { small_case(mut seed) } else { large_case(mut seed) });
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (m, n, cells)) in cases.iter().enumerate() {
        let small = c < 2000;
        let want: Vec[i64] = if small { literal(m, n, cells) } else { Vec.new() };
        for k in want.iter() {
            check = (check * 31 + k + 1) % 1000000007;
        }
        let transposed: Vec[Vec[i64]] = cells.iter().map(|cell| [cell[1], cell[0]].to_vec()).collect();
        let flipped: Vec[Vec[i64]] = cells.iter().map(|cell| [m - 1 - cell[0], cell[1]].to_vec()).collect();
        let reversed: Vec[Vec[i64]] = cells.iter().rev().cloned().collect();
        let lying: i64 = cells.iter().map(|cell| blocks_of(m, n, cell[0], cell[1])).sum();
        let got: Vec[Vec[i64]] = (0..5).map(|arm| answer(arm, m, n, cells)).collect();
        for arm in 0..5 {
            let value = got[arm].clone();
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let total: i64 = value.iter().sum();
            let weighted: i64 = (0..5).map(|i| i * value[i]).sum();
            let verdicts = [
                not small or value == want,
                answer(arm, n, m, transposed) == value,
                answer(arm, m, n, flipped) == value,
                answer(arm, m, n, reversed) == value,
                value.iter().all(|k| k >= 0) and total == (m - 1) * (n - 1) and weighted == lying,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {m} by {n}, {cells.len()} cells, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
