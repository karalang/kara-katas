// LeetCode #2768: Number of Black Blocks -- the bench. The ★ arm
// (blocks.kara) over 100 grids up to 10^5 by 10^5, each with 10^4
// distinct black cells, LeetCode's most, in a square of side 101 to 1000
// placed at random. All the grids drawn first, then each answered 5
// times.

fn count_black_blocks(m: i64, n: i64, coordinates: Vec[Vec[i64]]) -> Vec[i64] {
    let mut blocks: Map[(i64, i64), i64] = Map.new();
    for cell in coordinates.iter() {
        let (x, y) = (cell[0], cell[1]);
        for bx in (x - 1).max(0)..=x.min(m - 2) {
            for by in (y - 1).max(0)..=y.min(n - 2) {
                *blocks.entry((bx, by)).or_insert(0) += 1;
            }
        }
    }
    let mut counts: Vec[i64] = Vec.filled(5, 0);
    for (_, black) in blocks.iter() {
        counts[black] += 1;
    }
    counts[0] = (m - 1) * (n - 1) - blocks.len();
    counts
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn main() {
    let count = 100;
    let rounds = 5;
    let mut seed = 2768;
    let mut grids: Vec[(i64, i64, Vec[Vec[i64]])] = Vec.new();
    for _ in 0..count {
        let side = wide(mut seed) % 900 + 101;
        let area = side * side;
        let m = side + wide(mut seed) % (100001 - side);
        let n = side + wide(mut seed) % (100001 - side);
        let x0 = wide(mut seed) % (m - side + 1);
        let y0 = wide(mut seed) % (n - side + 1);
        let mut stride = wide(mut seed) % area;
        while gcd(stride, area) != 1 {
            stride = wide(mut seed) % area;
        }
        let start = wide(mut seed) % area;
        let cells: Vec[Vec[i64]] = (0..10000)
            .map(|k| {
                let at = (start + k * stride) % area;
                [x0 + at / side, y0 + at % side].to_vec()
            })
            .collect();
        grids.push((m, n, cells));
    }
    let mut sums: Vec[i64] = Vec.filled(5, 0);
    let mut check = 0;
    for r in 0..rounds {
        for (m, n, cells) in grids.iter() {
            let counts = count_black_blocks(m, n, cells);
            for i in 0..5 {
                sums[i] += counts[i];
                check = (check * 31 + counts[i] % 1000000007 + r + 1) % 1000000007;
            }
        }
    }
    println(f"{count} grids of 10^4 cells, {rounds} rounds: counts sum to {sums}, checksum {check}");
}
