// LeetCode #2778: Sum of Squares of Special Elements -- the pairs arm.
// The divisors of n found in pairs, d and n / d for every d up to the
// square root, the root itself once. O(sqrt n).

fn sum_of_squares(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let square = |i: i64| nums[i - 1] * nums[i - 1];
    let mut total = 0;
    let mut d = 1;
    while d * d <= n {
        if n % d == 0 {
            total += square(d);
            if d * d != n {
                total += square(n / d);
            }
        }
        d += 1;
    }
    total
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one number; 50 numbers of 50, LeetCode's
    // most; and 47 numbers, a prime count, rising
    println(f"{sum_of_squares([1, 2, 3, 4].to_vec())}");
    println(f"{sum_of_squares([2, 7, 1, 19, 18, 3].to_vec())}");
    println(f"{sum_of_squares([9].to_vec())}");
    println(f"{sum_of_squares(Vec.filled(50, 50))}");
    println(f"{sum_of_squares((1..=47).collect())}");
    // 5000 random arrays of 1 to 50 numbers from 1 to 50
    let mut seed = 2778;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..5000 {
        let n = next_random(mut seed) % 50 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 50 + 1).collect();
        let s = sum_of_squares(nums);
        total += s;
        check = (check * 31 + s) % 1000000007;
    }
    println(f"5000 arrays: sums total {total}, checksum {check}");
}
