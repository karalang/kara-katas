// LeetCode #2778: Sum of Squares of Special Elements -- the
// differential. The five arms, against the statement read literally: a
// place i is special when some k from 1 to n makes i * k equal n, and
// the squares at the special places summed; no remainder. 3000 random
// arrays of 1 to 50 numbers from 1 to 50, every case drawn before any
// arm answers.
//
// P1  the answer is the literal reading's
// P2  every number negated: the same answer
// P3  the numbers at places that do not divide n raised by 1: the same
//     answer
// P4  every number doubled: four times the answer
// P5  at least the first square, and the last too when n > 1; at most
//     the sum of every square
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut total = 0;
    for i in 1..=n {
        if (1..=n).any(|k| i * k == n) {
            total += nums[i - 1] * nums[i - 1];
        }
    }
    total
}


// ---- star (squares.kara) --------------------------------------------

fn star_sum_of_squares(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut total = 0;
    for i in 1..=n {
        if n % i == 0 {
            total += nums[i - 1] * nums[i - 1];
        }
    }
    total
}


// ---- pairs (squares_pairs.kara) -------------------------------------

fn pairs_sum_of_squares(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let square = |i: i64| nums[i - 1] * nums[i - 1];
    let mut total = 0;
    let mut d = 1;
    while d * d <= n {
        if n % d == 0 {
            total += square(d);
            if d * d != n {
                total += square(n / d);
            }
        }
        d += 1;
    }
    total
}


// ---- iter (squares_iter.kara) ---------------------------------------

fn iter_sum_of_squares(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    nums.iter().enumerate().filter(|(i, _)| n % (i + 1) == 0).map(|(_, x)| x * x).sum()
}


// ---- multiples (squares_multiples.kara) -----------------------------

fn multiples_sum_of_squares(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut divides: Vec[bool] = Vec.filled(n + 1, false);
    for i in 1..=n {
        let mut m = i;
        while m <= n {
            if m == n {
                divides[i] = true;
            }
            m += i;
        }
    }
    (1..=n).filter(|i| divides[i]).map(|i| nums[i - 1] * nums[i - 1]).sum()
}


// ---- solution (squares_solution.kara) -------------------------------

struct Solution {}

impl Solution {
    pub fn sum_of_squares(nums: Vec[i32]) -> i32 {
        let n = nums.len();
        nums.iter()
            .enumerate()
            .filter(|(i, _)| n % (i + 1) == 0)
            .map(|(_, x)| x * x)
            .sum()
    }
}

fn solution_sum_of_squares(nums: ref Vec[i64]) -> i64 {
    Solution.sum_of_squares(nums.iter().map(|x| x as i32).collect())
}


fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_sum_of_squares(nums),
        1 => pairs_sum_of_squares(nums),
        2 => iter_sum_of_squares(nums),
        3 => multiples_sum_of_squares(nums),
        _ => solution_sum_of_squares(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "pairs", "iter", "multiples", "solution"];
    let mut seed = 2778;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for _ in 0..3000 {
        let n = next_random(mut seed) % 50 + 1;
        cases.push((0..n).map(|_| next_random(mut seed) % 50 + 1).collect());
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nums) in cases.iter().enumerate() {
        let want = literal(nums);
        check = (check * 31 + want + 1) % 1000000007;
        let n = nums.len();
        let negated: Vec[i64] = nums.iter().map(|x| -x).collect();
        let others: Vec[i64] = (0..n).map(|i| if n % (i + 1) == 0 { nums[i] } else { nums[i] + 1 }).collect();
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let ends = nums[0] * nums[0] + if n > 1 { nums[n - 1] * nums[n - 1] } else { 0 };
        let all: i64 = nums.iter().map(|x| x * x).sum();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == want,
                answer(arm, negated) == value,
                answer(arm, others) == value,
                answer(arm, doubled) == 4 * value,
                ends <= value and value <= all,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
