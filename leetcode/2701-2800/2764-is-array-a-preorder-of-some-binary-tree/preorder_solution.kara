// LeetCode #2764: Is Array a Preorder of Some Binary Tree -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac
// fix`: a `Vec<i32>` stack popped by `while let Some(&top) =
// stack.last()` until the parent is on top, and `false` when the stack
// runs dry first.

struct Solution {}

impl Solution {
    pub fn is_preorder(nodes: Vec[Vec[i32]]) -> bool {
        let mut stack: Vec[i32] = Vec.new();
        for node in nodes.iter() {
            let (id, parent) = (node[0], node[1]);
            while let Some(top) = stack.last().cloned() {
                if top == parent {
                    break;
                }
                stack.pop();
            }
            if stack.is_empty() and parent != -1 {
                return false;
            }
            stack.push(id);
        }
        true
    }
}

fn is_preorder(nodes: Vec[Vec[i64]]) -> bool {
    Solution.is_preorder(
        nodes
            .iter()
            .map(|node| node.iter().map(|v| v as i32).collect())
            .collect(),
    )
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// a random binary tree of n nodes, ids spread over 0 to 100000, listed in
// a random preorder; then, half the time, two places swapped
fn tree(n: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let shift = wide(mut seed) % 100001;
    let ids: Vec[i64] = (0..n).map(|k| (k * 37 + shift) % 100001).collect();
    let mut kids: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for k in 1..n {
        let mut p = wide(mut seed) % k;
        while kids[p].len() == 2 {
            p = wide(mut seed) % k;
        }
        kids[p].push(k);
    }
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    for p in 0..n {
        for c in kids[p].iter() {
            parent[c] = p;
        }
    }
    let mut order: Vec[i64] = Vec.new();
    let mut stack: Vec[i64] = [0].to_vec();
    while let Some(u) = stack.pop() {
        order.push(u);
        let mut ks = kids[u].clone();
        if ks.len() == 2 and next_random(mut seed) % 2 == 1 {
            ks.swap(0, 1);
        }
        for c in ks.iter().rev() {
            stack.push(c);
        }
    }
    let mut nodes: Vec[Vec[i64]] = order
        .iter()
        .map(|u| [ids[u], if parent[u] >= 0 { ids[parent[u]] } else { -1 }].to_vec())
        .collect();
    if next_random(mut seed) % 2 == 1 and n > 1 {
        let i = wide(mut seed) % n;
        let j = wide(mut seed) % n;
        nodes.swap(i, j);
    }
    nodes
}

fn pairs(list: Slice[(i64, i64)]) -> Vec[Vec[i64]] {
    list.iter().map(|(a, b)| [a, b].to_vec()).collect()
}

fn main() {
    // LeetCode's two examples
    println(f"{is_preorder(pairs([(0, -1), (1, 0), (2, 0), (3, 2), (4, 2)]))}");
    println(f"{is_preorder(pairs([(0, -1), (1, 0), (2, 0), (3, 1), (4, 1)]))}");
    // one node; a chain of 10^5, LeetCode's most, and the same with its
    // second and third nodes swapped; and a node whose parent's subtree
    // has already closed
    println(f"{is_preorder(pairs([(7, -1)]))}");
    let mut chain: Vec[Vec[i64]] = [[0, -1].to_vec()].to_vec();
    for k in 1..100000 {
        chain.push([k, k - 1].to_vec());
    }
    println(f"{is_preorder(chain)}");
    chain.swap(1, 2);
    println(f"{is_preorder(chain)}");
    println(f"{is_preorder(pairs([(5, -1), (3, 5), (9, 5), (1, 3)]))}");
    // 3000 random trees of 1 to 12 nodes; then 10 of 10^5
    let mut seed = 2764;
    let mut good = 0;
    let mut check = 0;
    for c in 0..3000 {
        let n = next_random(mut seed) % 12 + 1;
        if is_preorder(tree(n, mut seed)) {
            good += 1;
            check = (check * 31 + c) % 1000000007;
        }
    }
    println(f"3000 small trees: {good} preorders, checksum {check}");
    let mut good = 0;
    let mut check = 0;
    for c in 0..10 {
        if is_preorder(tree(100000, mut seed)) {
            good += 1;
            check = (check * 31 + c) % 1000000007;
        }
    }
    println(f"10 trees of 100000: {good} preorders, checksum {check}");
}
