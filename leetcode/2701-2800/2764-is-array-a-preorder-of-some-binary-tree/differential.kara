// LeetCode #2764: Is Array a Preorder of Some Binary Tree -- the
// differential. The five arms, against the statement read literally: the
// tree the pairs describe, each node's children in every order, left or
// right, its preorder built by the recursive definition each time, and
// the list a preorder when one of them is the list itself; no stack. 2000
// random trees of 1 to 12 nodes, then 100 of up to 2000, each listed in a
// random preorder and half the time with two places swapped. Every case is
// drawn before any arm answers; the literal reading is asked only of the
// first 2000.
//
// P1  up to 12 nodes, the answer is the literal reading's
// P2  every id x made 100000 - x: the same answer
// P3  a new node put at the end, a child of the node before it: the same
//     answer
// P4  from 2 nodes on, the root moved to the end: false
// P5  the nodes relisted in a preorder of their own tree: true
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal_walk(u: i64, kids: Vec[Vec[i64]], forks: Vec[i64], mask: i64, order: mut ref Vec[i64]) {
    order.push(u);
    let mut children = kids[u].clone();
    if let Some(f) = forks.iter().position(|x| x == u) {
        if mask >> f & 1 == 1 {
            children.reverse();
        }
    }
    for c in children.iter() {
        literal_walk(c, kids, forks, mask, mut order);
    }
}

fn literal(nodes: Vec[Vec[i64]]) -> bool {
    let n = nodes.len();
    let mut root = 0;
    let mut kids: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for i in 0..n {
        if nodes[i][1] == -1 {
            root = i;
        } else {
            for j in 0..n {
                if nodes[j][0] == nodes[i][1] {
                    kids[j].push(i);
                }
            }
        }
    }
    let forks: Vec[i64] = (0..n).filter(|i| kids[i].len() == 2).collect();
    for mask in 0..(1 << forks.len()) {
        let mut order: Vec[i64] = Vec.new();
        literal_walk(root, kids, forks, mask, mut order);
        if (0..n).all(|k| order[k] == k) {
            return true;
        }
    }
    false
}

// a preorder of the tree the pairs describe, children in the order listed
fn relisted(nodes: Vec[Vec[i64]]) -> Vec[Vec[i64]] {
    let mut kids: Map[i64, Vec[i64]] = Map.new();
    let mut root = 0;
    for (i, node) in nodes.iter().enumerate() {
        if node[1] == -1 {
            root = i;
        } else {
            kids.entry(node[1]).or_insert(Vec.new()).push(i);
        }
    }
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut stack: Vec[i64] = [root].to_vec();
    while let Some(i) = stack.pop() {
        out.push(nodes[i].clone());
        if let Some(children) = kids.get(nodes[i][0]) {
            for c in children.iter().rev() {
                stack.push(c);
            }
        }
    }
    out
}


// ---- star (preorder.kara) -------------------------------------------

fn star_is_preorder(nodes: Vec[Vec[i64]]) -> bool {
    let mut stack: Vec[i64] = Vec.new();
    for node in nodes.iter() {
        let (id, parent) = (node[0], node[1]);
        while let Some(top) = stack.last() {
            if top == parent {
                break;
            }
            stack.pop();
        }
        if stack.is_empty() and parent != -1 {
            return false;
        }
        stack.push(id);
    }
    true
}


// ---- recursive (preorder_recursive.kara) ----------------------------

fn recursive_read_subtree(nodes: Vec[Vec[i64]], at: mut ref i64) {
    let id = nodes[*at][0];
    *at += 1;
    while *at < nodes.len() and nodes[*at][1] == id {
        recursive_read_subtree(nodes, mut at);
    }
}

fn recursive_is_preorder(nodes: Vec[Vec[i64]]) -> bool {
    let mut at = 0;
    recursive_read_subtree(nodes, mut at);
    nodes[0][1] == -1 and at == nodes.len()
}


// ---- intervals (preorder_intervals.kara) ----------------------------

fn intervals_is_preorder(nodes: Vec[Vec[i64]]) -> bool {
    let mut place: Map[i64, i64] = Map.new();
    let mut parent: Map[i64, i64] = Map.new();
    let mut waiting: Map[i64, i64] = Map.new();
    let mut size: Map[i64, i64] = Map.new();
    for (i, node) in nodes.iter().enumerate() {
        place[node[0]] = i;
        parent[node[0]] = node[1];
        size[node[0]] = 1;
        waiting.entry(node[0]).or_insert(0);
        *waiting.entry(node[1]).or_insert(0) += 1;
    }
    let mut ready: VecDeque[i64] = nodes.iter().map(|node| node[0]).filter(|id| waiting[id] == 0).collect();
    while let Some(id) = ready.pop_front() {
        let up = parent[id];
        if up == -1 {
            continue;
        }
        size[up] += size[id];
        waiting[up] -= 1;
        if waiting[up] == 0 {
            ready.push_back(up);
        }
    }
    nodes.iter().all(|node| {
        let (id, up) = (node[0], node[1]);
        if up == -1 {
            return place[id] == 0;
        }
        place[up] < place[id] and place[id] + size[id] <= place[up] + size[up]
    })
}


// ---- ancestors (preorder_ancestors.kara) ----------------------------

fn ancestors_is_preorder(nodes: Vec[Vec[i64]]) -> bool {
    if nodes[0][1] != -1 {
        return false;
    }
    let parent: Map[i64, i64] = nodes.iter().map(|node| (node[0], node[1])).collect();
    let mut last = nodes[0][0];
    for node in nodes.iter().skip(1) {
        let mut at = last;
        while at != node[1] {
            if at == -1 {
                return false;
            }
            at = parent[at];
        }
        last = node[0];
    }
    true
}


// ---- solution (preorder_solution.kara) ------------------------------

struct Solution {}

impl Solution {
    pub fn is_preorder(nodes: Vec[Vec[i32]]) -> bool {
        let mut stack: Vec[i32] = Vec.new();
        for node in nodes.iter() {
            let (id, parent) = (node[0], node[1]);
            while let Some(top) = stack.last().cloned() {
                if top == parent {
                    break;
                }
                stack.pop();
            }
            if stack.is_empty() and parent != -1 {
                return false;
            }
            stack.push(id);
        }
        true
    }
}

fn solution_is_preorder(nodes: Vec[Vec[i64]]) -> bool {
    Solution.is_preorder(
        nodes
            .iter()
            .map(|node| node.iter().map(|v| v as i32).collect())
            .collect(),
    )
}


fn answer(arm: i64, nodes: Vec[Vec[i64]]) -> bool {
    match arm {
        0 => star_is_preorder(nodes),
        1 => recursive_is_preorder(nodes),
        2 => intervals_is_preorder(nodes),
        3 => ancestors_is_preorder(nodes),
        _ => solution_is_preorder(nodes),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// a random binary tree of n nodes, ids spread over 0 to 100000, listed in
// a random preorder; then, half the time, two places swapped
fn tree(n: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let shift = wide(mut seed) % 100001;
    let ids: Vec[i64] = (0..n).map(|k| (k * 37 + shift) % 100001).collect();
    let mut kids: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for k in 1..n {
        let mut p = wide(mut seed) % k;
        while kids[p].len() == 2 {
            p = wide(mut seed) % k;
        }
        kids[p].push(k);
    }
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    for p in 0..n {
        for c in kids[p].iter() {
            parent[c] = p;
        }
    }
    let mut order: Vec[i64] = Vec.new();
    let mut stack: Vec[i64] = [0].to_vec();
    while let Some(u) = stack.pop() {
        order.push(u);
        let mut ks = kids[u].clone();
        if ks.len() == 2 and next_random(mut seed) % 2 == 1 {
            ks.swap(0, 1);
        }
        for c in ks.iter().rev() {
            stack.push(c);
        }
    }
    let mut nodes: Vec[Vec[i64]] = order
        .iter()
        .map(|u| [ids[u], if parent[u] >= 0 { ids[parent[u]] } else { -1 }].to_vec())
        .collect();
    if next_random(mut seed) % 2 == 1 and n > 1 {
        let i = wide(mut seed) % n;
        let j = wide(mut seed) % n;
        nodes.swap(i, j);
    }
    nodes
}

fn main() {
    let names = ["star", "recursive", "intervals", "ancestors", "solution"];
    let mut seed = 2764;
    let mut cases: Vec[Vec[Vec[i64]]] = Vec.new();
    for c in 0..2100 {
        let most = if c < 2000 { 12 } else { 2000 };
        let n = next_random(mut seed) % most + 1;
        cases.push(tree(n, mut seed));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nodes) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = small and literal(nodes);
        check = (check * 31 + if want { 2 } else { 1 }) % 1000000007;
        let n = nodes.len();
        let renamed: Vec[Vec[i64]] = nodes
            .iter()
            .map(|node| [100000 - node[0], if node[1] == -1 { -1 } else { 100000 - node[1] }].to_vec())
            .collect();
        let mut fresh = 0;
        while nodes.iter().any(|node| node[0] == fresh) {
            fresh += 1;
        }
        let mut grown = nodes.clone();
        grown.push([fresh, nodes[n - 1][0]].to_vec());
        let mut rotated: Vec[Vec[i64]] = nodes.iter().filter(|node| node[1] != -1).cloned().collect();
        rotated.extend(nodes.iter().filter(|node| node[1] == -1).cloned());
        let ordered = relisted(nodes);
        let got: Vec[bool] = (0..5).map(|arm| answer(arm, nodes)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == want,
                answer(arm, renamed) == value,
                answer(arm, grown) == value,
                n < 2 or not answer(arm, rotated),
                answer(arm, ordered),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nodes}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
