// LeetCode #2735: Collecting Chocolates -- the bench (chocolates.kara):
// each type's cheapest price within k turns, narrowed one turn at a time,
// and the least of k x plus their sum.

fn min_cost(nums: Vec[i64], x: i64) -> i64 {
    let n = nums.len();
    let mut cheapest = nums.clone();
    let mut best: i64 = nums.iter().sum();
    for k in 1..n {
        for t in 0..n {
            cheapest[t] = cheapest[t].min(nums[(t - k + n) % n]);
        }
        let total: i64 = cheapest.iter().sum();
        best = best.min(k * x + total);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let cases = 100;
    let n = 1000;
    let rounds = 3;
    let mut seed = 2735;
    let mut problems: Vec[(Vec[i64], i64)] = Vec.new();
    for _ in 0..cases {
        // 1000 chocolates, LeetCode's most, priced up to 10^9, and a turn
        // up to 10^7, so that the best answer takes many turns
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000 + 1);
        }
        let x = (next_random(mut seed) * 32768 + next_random(mut seed)) % 10000000 + 1;
        problems.push((nums, x));
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (nums, x) in problems.iter() {
            let cost = min_cost(nums, x);
            sum += cost;
            check = (check * 31 + cost + r) % 1000000007;
        }
    }
    println(f"{cases} cases of {n} chocolates, {rounds} rounds: costs sum to {sum}, checksum {check}");
}
