// LeetCode #2706: Buy Two Chocolates -- the pairs arm. Every pair of two
// different chocolates is priced, and the most money any affordable pair
// leaves is kept, starting from the money itself for when none is.
// O(n^2).

fn buy_choco(prices: Vec[i64], money: i64) -> i64 {
    let n = prices.len();
    let mut best: Option[i64] = None;
    for i in 0..n {
        for j in i + 1..n {
            let left = money - prices[i] - prices[j];
            if left >= 0 {
                best = match best {
                    Some(b) if b >= left => Some(b),
                    _ => Some(left),
                };
            }
        }
    }
    best.unwrap_or(money)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; the two cheapest exactly the money; two of
    // the dearest against all the money; 49 of the dearest and one of the
    // cheapest; 50 prices falling from 50
    println(f"{buy_choco([1, 2, 2].to_vec(), 3)}");
    println(f"{buy_choco([3, 2, 3].to_vec(), 3)}");
    println(f"{buy_choco([1, 1].to_vec(), 2)}");
    println(f"{buy_choco([100, 100].to_vec(), 100)}");
    let mut dear: Vec[i64] = (0..49).map(|_| 100).collect();
    dear.push(1);
    println(f"{buy_choco(dear, 100)}");
    let falling: Vec[i64] = (0..50).map(|i| 50 - i).collect();
    println(f"{buy_choco(falling, 100)}");
    // 5000 random cases of 2 to 50 prices up to 100 and money up to 100;
    // then 5000 of 2 to 5 prices up to 10 and money up to 20
    let mut seed = 2706;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..5000 {
        let n = next_random(mut seed) % 49 + 2;
        let prices: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 100 + 1).collect();
        let money = next_random(mut seed) % 100 + 1;
        let left = buy_choco(prices, money);
        sum += left;
        check = (check * 31 + left) % 1000000007;
    }
    println(f"5000 cases: money left sums to {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for _ in 0..5000 {
        let n = next_random(mut seed) % 4 + 2;
        let prices: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 10 + 1).collect();
        let money = next_random(mut seed) % 20 + 1;
        let left = buy_choco(prices, money);
        sum += left;
        check = (check * 31 + left) % 1000000007;
    }
    println(f"5000 cases of 2 to 5 prices up to 10: money left sums to {sum}, checksum {check}");
}
