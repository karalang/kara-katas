// LeetCode #2709: Greatest Common Divisor Traversal -- a Rust solution as
// LeetCode's Rust users write it, carried to Kāra by `karac fix`: a
// union-find `struct` with `usize` parents and a recursive `find(&mut
// self)`, a sieve of `vec![0usize; m + 1]`, and every index joined to
// the index first seen with each prime in a `HashMap<usize, usize>`.

struct Dsu {
    parent: Vec[i64],
    count: i64,
}

impl Dsu {
    fn new(n: i64) -> Self {
        Dsu { parent: (0..n).collect(), count: n }
    }

    fn find(mut ref self, x: i64) -> i64 {
        if self.parent[x] != x {
            let r = self.find(self.parent[x]);
            self.parent[x] = r;
        }
        self.parent[x]
    }

    fn union(mut ref self, a: i64, b: i64) {
        let (ra, rb) = (self.find(a), self.find(b));
        if ra != rb {
            self.parent[ra] = rb;
            self.count -= 1;
        }
    }
}

struct Solution {}

impl Solution {
    pub fn can_traverse_all_pairs(nums: Vec[i32]) -> bool {
        let n = nums.len();
        if n == 1 {
            return true;
        }
        let m = *nums.iter().max().unwrap() as i64;
        let mut spf = Vec.filled(m + 1, 0);
        for i in 2..=m {
            if spf[i] == 0 {
                let mut j = i;
                while j <= m {
                    if spf[j] == 0 {
                        spf[j] = i;
                    }
                    j += i;
                }
            }
        }
        let mut dsu = Dsu.new(n);
        let mut seen: Map[i64, i64] = Map.new();
        for i in 0..n {
            let mut x = nums[i] as i64;
            if x == 1 {
                return false;
            }
            while x > 1 {
                let p = spf[x];
                if let Some(j) = seen.get(p).cloned() {
                    dsu.union(i, j);
                } else {
                    seen.insert(p, i);
                }
                while x % p == 0 {
                    x /= p;
                }
            }
        }
        dsu.count == 1
    }
}

fn can_traverse_all_pairs(nums: Vec[i64]) -> bool {
    let narrow: Vec[i32] = nums.iter().map(|v| v as i32).collect();
    Solution.can_traverse_all_pairs(narrow)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

// whether 2, 3, 5 and 7 are v's only prime factors
fn is_smooth(v: i64) -> bool {
    let mut rest = v;
    for p in [2, 3, 5, 7] {
        while rest % p == 0 {
            rest /= p;
        }
    }
    rest == 1
}

fn main() {
    // LeetCode's three examples; one 1, alone and twice; two primes;
    // 10^5 copies of the prime 99991; every number from 2 to 100001;
    // the even numbers to 10^5; and a prime among numbers that join
    println(f"{can_traverse_all_pairs([2, 3, 6].to_vec())}");
    println(f"{can_traverse_all_pairs([3, 9, 5].to_vec())}");
    println(f"{can_traverse_all_pairs([4, 3, 12, 8].to_vec())}");
    println(f"{can_traverse_all_pairs([1].to_vec())}");
    println(f"{can_traverse_all_pairs([1, 1].to_vec())}");
    println(f"{can_traverse_all_pairs([2, 3].to_vec())}");
    println(f"{can_traverse_all_pairs((0..100000).map(|_| 99991).collect())}");
    println(f"{can_traverse_all_pairs((2..100002).collect())}");
    println(f"{can_traverse_all_pairs((1..50001).map(|i| 2 * i).collect())}");
    let mut joined = [99998, 99991, 2].to_vec();
    for _ in 0..10 {
        joined.push(6);
    }
    println(f"{can_traverse_all_pairs(joined)}");
    // 2000 random cases of 1 to 8 numbers up to 30; then 100 of up to
    // 10^4 numbers, half of them drawn from the numbers up to 10^5 whose
    // only prime factors are 2, 3, 5 and 7, half up to 10^5 at random
    let mut seed = 2709;
    let mut yes = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 8 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 30 + 1).collect();
        let can = can_traverse_all_pairs(nums);
        if can {
            yes += 1;
        }
        check = (check * 31 + if can { 2 } else { 1 }) % 1000000007;
    }
    println(f"2000 cases up to 30: {yes} traversable, checksum {check}");
    let smooth: Vec[i64] = (2..100001).filter(|v| is_smooth(v)).collect();
    yes = 0;
    check = 0;
    for _ in 0..100 {
        let n = next_random(mut seed) % 10000 + 1;
        let nums: Vec[i64] = if next_random(mut seed) % 2 == 0 {
            (0..n).map(|_| smooth[next_random(mut seed) % smooth.len()]).collect()
        } else {
            (0..n).map(|_| wide(mut seed) % 100000 + 1).collect()
        };
        let can = can_traverse_all_pairs(nums);
        if can {
            yes += 1;
        }
        check = (check * 31 + if can { 2 } else { 1 }) % 1000000007;
    }
    println(f"100 cases up to 100000: {yes} traversable, checksum {check}, {smooth.len()} smooth numbers");
}
