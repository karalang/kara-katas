// LeetCode #2730: Find the Longest Semi-Repetitive Substring -- the bench
// (semi.kara): a sliding window over the bytes holding at most one
// adjacent equal pair.

fn longest_semi_repetitive_substring(s: String) -> i64 {
    let b = s.bytes();
    let mut left = 0;
    let mut pairs = 0;
    let mut best = 1;
    for right in 1..b.len() {
        if b[right] == b[right - 1] {
            pairs += 1;
        }
        while pairs > 1 {
            if b[left] == b[left + 1] {
                pairs -= 1;
            }
            left += 1;
        }
        best = best.max(right - left + 1);
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 200000;
    let rounds = 20;
    let mut seed = 2730;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..count {
        // 50 digits, LeetCode's longest, from the first 2 to 10
        let digits = next_random(mut seed) % 9 + 2;
        let mut s = String.new();
        for _ in 0..50 {
            s.push((b'0' + (next_random(mut seed) % digits) as u8) as char);
        }
        strings.push(s);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for s in strings.iter() {
            let length = longest_semi_repetitive_substring(s);
            sum += length;
            check = (check * 31 + length + r) % 1000000007;
        }
    }
    println(f"{count} strings of 50 digits, {rounds} rounds: lengths sum to {sum}, checksum {check}");
}
