// LeetCode #2761: Prime Pairs With Target Sum -- the odd arm. Only odd
// numbers sieved, one bit each in a `Vec[u64]`, bit k standing for 2k + 1;
// 2 is handled apart: it pairs only with n - 2, and then only for an odd
// n, while an even n pairs two odd primes. O(n log log n / 64) words.

fn find_prime_pairs(n: i64) -> Vec[Vec[i64]] {
    let words = n / 128 + 1;
    let mut composite: Vec[u64] = Vec.filled(words, 0);
    let odd_prime = |m: i64, composite: ref Vec[u64]| {
        m >= 3 and m % 2 == 1 and (composite[m / 2 / 64] >> (m / 2 % 64)) & 1 == 0
    };
    let mut p = 3;
    while p * p <= n {
        if odd_prime(p, composite) {
            let mut m = p * p;
            while m <= n {
                composite[m / 2 / 64] |= 1 << (m / 2 % 64);
                m += 2 * p;
            }
        }
        p += 2;
    }
    let mut pairs: Vec[Vec[i64]] = Vec.new();
    if n % 2 == 1 {
        if odd_prime(n - 2, composite) {
            pairs.push([2, n - 2].to_vec());
        }
        return pairs;
    }
    if n == 4 {
        pairs.push([2, 2].to_vec());
    }
    let mut x = 3;
    while x <= n / 2 {
        if odd_prime(x, composite) and odd_prime(n - x, composite) {
            pairs.push([x, n - x].to_vec());
        }
        x += 2;
    }
    pairs
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn fold(pairs: Vec[Vec[i64]], count: mut ref i64, check: mut ref i64) {
    *count += pairs.len();
    *check = (*check * 31 + pairs.len()) % 1000000007;
    for pair in pairs.iter() {
        *check = (*check * 31 + pair[0] * 1000003 + pair[1]) % 1000000007;
    }
}

fn main() {
    // LeetCode's two examples
    println(f"{find_prime_pairs(10)}");
    println(f"{find_prime_pairs(2)}");
    // the smallest n with a pair; an odd n, whose one chance is 2; and a
    // few more
    println(f"{find_prime_pairs(4)}");
    println(f"{find_prime_pairs(9)}");
    println(f"{find_prime_pairs(11)}");
    println(f"{find_prime_pairs(100)}");
    // every n from 1 to 2000; then 20 random n up to 10^6, LeetCode's most,
    // and 10^6 itself
    let mut count = 0;
    let mut check = 0;
    for n in 1..=2000 {
        fold(find_prime_pairs(n), mut count, mut check);
    }
    println(f"n from 1 to 2000: {count} pairs, checksum {check}");
    let mut seed = 2761;
    count = 0;
    check = 0;
    for _ in 0..20 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000 + 1;
        fold(find_prime_pairs(n), mut count, mut check);
    }
    fold(find_prime_pairs(1000000), mut count, mut check);
    println(f"21 n up to 10^6: {count} pairs, checksum {check}");
}
