// LeetCode #2761: Prime Pairs With Target Sum -- the ★ arm. A sieve of
// Eratosthenes up to n in a `Vec[bool]`, each prime p from its square on
// crossing out its multiples; then each x up to n / 2 with x and n - x
// both prime is a pair, in rising x. O(n log log n).

fn find_prime_pairs(n: i64) -> Vec[Vec[i64]] {
    let mut prime: Vec[bool] = Vec.filled(n + 1, true);
    prime[0] = false;
    if n >= 1 {
        prime[1] = false;
    }
    let mut p = 2;
    while p * p <= n {
        if prime[p] {
            let mut m = p * p;
            while m <= n {
                prime[m] = false;
                m += p;
            }
        }
        p += 1;
    }
    let mut pairs: Vec[Vec[i64]] = Vec.new();
    for x in 2..=n / 2 {
        if prime[x] and prime[n - x] {
            pairs.push([x, n - x].to_vec());
        }
    }
    pairs
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn fold(pairs: Vec[Vec[i64]], count: mut ref i64, check: mut ref i64) {
    *count += pairs.len();
    *check = (*check * 31 + pairs.len()) % 1000000007;
    for pair in pairs.iter() {
        *check = (*check * 31 + pair[0] * 1000003 + pair[1]) % 1000000007;
    }
}

fn main() {
    // LeetCode's two examples
    println(f"{find_prime_pairs(10)}");
    println(f"{find_prime_pairs(2)}");
    // the smallest n with a pair; an odd n, whose one chance is 2; and a
    // few more
    println(f"{find_prime_pairs(4)}");
    println(f"{find_prime_pairs(9)}");
    println(f"{find_prime_pairs(11)}");
    println(f"{find_prime_pairs(100)}");
    // every n from 1 to 2000; then 20 random n up to 10^6, LeetCode's most,
    // and 10^6 itself
    let mut count = 0;
    let mut check = 0;
    for n in 1..=2000 {
        fold(find_prime_pairs(n), mut count, mut check);
    }
    println(f"n from 1 to 2000: {count} pairs, checksum {check}");
    let mut seed = 2761;
    count = 0;
    check = 0;
    for _ in 0..20 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000 + 1;
        fold(find_prime_pairs(n), mut count, mut check);
    }
    fold(find_prime_pairs(1000000), mut count, mut check);
    println(f"21 n up to 10^6: {count} pairs, checksum {check}");
}
