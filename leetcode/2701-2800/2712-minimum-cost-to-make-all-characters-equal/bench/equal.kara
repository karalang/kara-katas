// LeetCode #2712: Minimum Cost to Make All Characters Equal -- the bench
// (equal.kara): each boundary between unequal neighbours priced at the
// cheaper flip across it.

fn minimum_cost(s: String) -> i64 {
    let bits = s.bytes();
    let n = bits.len();
    let mut cost = 0;
    for i in 1..n {
        if bits[i] != bits[i - 1] {
            cost += i.min(n - i);
        }
    }
    cost
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 100;
    let rounds = 5;
    let mut seed = 2712;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..count {
        // 10^5 bits, each changed from the one before 0 to 8 times in 8
        let change = next_random(mut seed) % 9;
        let mut bits = String.new();
        let mut last = '0';
        for _ in 0..100000 {
            if next_random(mut seed) % 8 < change {
                last = if last == '0' { '1' } else { '0' };
            }
            bits.push(last);
        }
        strings.push(bits);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for s in strings.iter() {
            let cost = minimum_cost(s);
            sum += cost;
            check = (check * 31 + cost + r) % 1000000007;
        }
    }
    println(f"{count} strings of 100000 bits, {rounds} rounds: costs sum to {sum}, checksum {check}");
}
