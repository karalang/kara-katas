// LeetCode #2789: Largest Element in an Array after Merge Operations --
// the bench: the ★ arm over 20 arrays of 10^5 numbers up to 10^6,
// LeetCode's most, all drawn first, then each answered 100 times.

fn max_array_value(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut held = nums[n - 1];
    for i in (0..n - 1).rev() {
        held = if nums[i] <= held { held + nums[i] } else { nums[i] };
    }
    held
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 20;
    let rounds = 100;
    let mut seed = 2789;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        cases.push((0..100000).map(|_| wide(mut seed) % 1000000 + 1).collect());
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in cases.iter() {
            let a = max_array_value(nums);
            total += a;
            check = (check * 31 + a + r) % 1000000007;
        }
    }
    println(f"{count} arrays of 10^5, {rounds} rounds: largest sum to {total}, checksum {check}");
}
