// LeetCode #2789: Largest Element in an Array after Merge Operations --
// the differential. The five arms, against the statement read literally:
// from the array as given, every operation that can be done, a number no
// greater than the one after it added into that one and taken out, each
// array so reached searched in turn and each searched once; the answer
// the largest number in any of them; no walk from the right. 2000 random
// arrays of 1 to 8 numbers from 1 to 10; then 50 of up to 2000 numbers up
// to 10^6. Every case is drawn before any arm answers; the literal
// reading is asked only of the first 2000.
//
// P1  up to 8 numbers, the answer is the literal reading's
// P2  every number doubled: the answer doubled
// P3  the sum of all put after: twice the sum
// P4  three times the greatest put before: the answer and it, when it is
//     no greater than the answer, and it alone otherwise
// P5  from the greatest number to the sum of all, and the sum when the
//     numbers are sorted
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(nums: Vec[i64]) -> i64 {
    let mut seen: Set[Vec[i64]] = Set.new();
    let mut todo: Vec[Vec[i64]] = [nums.clone()];
    seen.insert(nums.clone());
    let mut best = 0;
    while let Some(now) = todo.pop() {
        for v in now.iter() {
            best = best.max(v);
        }
        for i in 0..now.len() - 1 {
            if now[i] <= now[i + 1] {
                let mut next = now.clone();
                next[i + 1] += next[i];
                next.remove(i);
                if not seen.contains(next) {
                    seen.insert(next.clone());
                    todo.push(next);
                }
            }
        }
    }
    best
}


// ---- star (merge.kara) ----------------------------------------------

fn star_max_array_value(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut held = nums[n - 1];
    for i in (0..n - 1).rev() {
        held = if nums[i] <= held { held + nums[i] } else { nums[i] };
    }
    held
}


// ---- fold (merge_fold.kara) -----------------------------------------

fn fold_max_array_value(nums: Vec[i64]) -> i64 {
    nums.iter().rev().fold(0, |held, v| if v <= held { held + v } else { v })
}


// ---- blocks (merge_blocks.kara) -------------------------------------

fn blocks_max_array_value(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut prefix: Vec[i64] = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + nums[i];
    }
    let mut blocks: Vec[i64] = Vec.new();
    let mut end = n;
    while end > 0 {
        let mut start = end - 1;
        while start > 0 and nums[start - 1] <= prefix[end] - prefix[start] {
            start -= 1;
        }
        blocks.push(prefix[end] - prefix[start]);
        end = start;
    }
    blocks.iter().max().unwrap()
}


// ---- stack (merge_stack.kara) ---------------------------------------

fn stack_max_array_value(nums: Vec[i64]) -> i64 {
    let mut stack = nums.clone();
    let mut held = stack.pop().unwrap();
    let mut best = held;
    while let Some(v) = stack.pop() {
        if v <= held {
            held += v;
        } else {
            held = v;
        }
        best = best.max(held);
    }
    best
}


// ---- solution (merge_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn max_array_value(nums: Vec[i32]) -> i64 {
        let mut ans: i64 = 0;
        for x in nums.iter().rev() {
            let x = x as i64;
            if x <= ans {
                ans += x;
            } else {
                ans = x;
            }
        }
        ans
    }
}

fn solution_max_array_value(nums: Vec[i64]) -> i64 {
    Solution.max_array_value(nums.iter().map(|v| v as i32).collect())
}


fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_max_array_value(nums),
        1 => fold_max_array_value(nums),
        2 => blocks_max_array_value(nums),
        3 => stack_max_array_value(nums),
        _ => solution_max_array_value(nums),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "fold", "blocks", "stack", "solution"];
    let mut seed = 2789;
    let mut cases: Vec[Vec[i64]] = Vec.new();
    for c in 0..2050 {
        if c < 2000 {
            let n = next_random(mut seed) % 8 + 1;
            cases.push((0..n).map(|_| next_random(mut seed) % 10 + 1).collect());
        } else {
            let n = wide(mut seed) % 2000 + 1;
            cases.push((0..n).map(|_| wide(mut seed) % 1000000 + 1).collect());
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, nums) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(nums) } else { 0 };
        check = (check * 31 + want + 1) % 1000000007;
        let total: i64 = nums.iter().sum();
        let greatest = nums.iter().max().unwrap();
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let mut summed = nums.clone();
        summed.push(total);
        let mut fronted: Vec[i64] = [3 * greatest];
        fronted.extend(nums.iter());
        let mut sorted = nums.clone();
        sorted.sort();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, nums)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let front = 3 * greatest;
            let in_front = if front <= value { value + front } else { front };
            let verdicts = [
                not small or value == want,
                answer(arm, doubled) == 2 * value,
                answer(arm, summed) == 2 * total,
                answer(arm, fronted) == in_front,
                greatest <= value and value <= total and answer(arm, sorted) == total,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {nums}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
