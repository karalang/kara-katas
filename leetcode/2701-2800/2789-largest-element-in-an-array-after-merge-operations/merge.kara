// LeetCode #2789: Largest Element in an Array after Merge Operations --
// the ★ arm. From the right: the number being built takes in the one on
// its left whenever that one is no greater, and otherwise the one on the
// left starts afresh, being greater than all it leaves behind; so the
// number held never falls, and the last one held is the largest. O(n).

fn max_array_value(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut held = nums[n - 1];
    for i in (0..n - 1).rev() {
        held = if nums[i] <= held { held + nums[i] } else { nums[i] };
    }
    held
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; a pair that must merge from the right
    // first; 10^5 numbers of 10^6, LeetCode's most; 10^5 numbers falling
    // from 10^6, where nothing merges
    println(f"{max_array_value([2, 3, 7, 9, 3])}");
    println(f"{max_array_value([5, 3, 3])}");
    println(f"{max_array_value([2, 2, 3])}");
    let n = 100000;
    println(f"{max_array_value(Vec.filled(n, 1000000))}");
    let falling: Vec[i64] = (0..n).map(|i| 1000000 - i).collect();
    println(f"{max_array_value(falling)}");
    // 3000 random arrays of 1 to 12 numbers from 1 to 10; then 20 of 10^5
    // numbers up to 10^6
    let mut seed = 2789;
    let mut sum = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let m = next_random(mut seed) % 12 + 1;
        let nums: Vec[i64] = (0..m).map(|_| next_random(mut seed) % 10 + 1).collect();
        let a = max_array_value(nums);
        sum += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"3000 small arrays: largest sum to {sum}, checksum {check}");
    sum = 0;
    check = 0;
    for _ in 0..20 {
        let nums: Vec[i64] = (0..n).map(|_| wide(mut seed) % 1000000 + 1).collect();
        let a = max_array_value(nums);
        sum += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"20 arrays of 10^5: largest sum to {sum}, checksum {check}");
}
