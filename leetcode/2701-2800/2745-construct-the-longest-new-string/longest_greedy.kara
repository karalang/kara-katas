// LeetCode #2745: Construct the Longest New String -- the greedy arm. The
// string built piece by piece: all the "AB"s, then "AA" and "BB" by
// turns, starting with "AA" (which may follow an "AB"), until the piece
// due has run out; with more "BB"s than "AA"s, one "BB" goes in front,
// so that the "BB"s both open and close the turns. The answer is the
// built string's length. O(x + y + z).

fn longest_string(x: i64, y: i64, z: i64) -> i64 {
    let mut built = String.new();
    let mut left_a = x;
    let mut left_b = y;
    if left_b > left_a {
        built.push_str("BB");
        left_b -= 1;
    }
    for _ in 0..z {
        built.push_str("AB");
    }
    let mut a_next = true;
    loop {
        if a_next {
            if left_a == 0 {
                break;
            }
            built.push_str("AA");
            left_a -= 1;
        } else {
            if left_b == 0 {
                break;
            }
            built.push_str("BB");
            left_b -= 1;
        }
        a_next = not a_next;
    }
    built.len()
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples
    println(f"{longest_string(2, 5, 1)}");
    println(f"{longest_string(3, 2, 2)}");
    // one of each; as many "AA" as "BB"; and LeetCode's largest counts
    println(f"{longest_string(1, 1, 1)}");
    println(f"{longest_string(7, 7, 3)}");
    println(f"{longest_string(50, 50, 50)}");
    // every count from 1 to 12 of each piece; then 100 random counts up to
    // 50, LeetCode's most
    let mut sum = 0;
    let mut check = 0;
    for x in 1..=12 {
        for y in 1..=12 {
            for z in 1..=12 {
                let length = longest_string(x, y, z);
                sum += length;
                check = (check * 31 + length) % 1000000007;
            }
        }
    }
    println(f"1728 small counts: lengths sum to {sum}, checksum {check}");
    let mut seed = 2745;
    sum = 0;
    check = 0;
    for _ in 0..100 {
        let x = next_random(mut seed) % 50 + 1;
        let y = next_random(mut seed) % 50 + 1;
        let z = next_random(mut seed) % 50 + 1;
        let length = longest_string(x, y, z);
        sum += length;
        check = (check * 31 + length) % 1000000007;
    }
    println(f"100 counts up to 50: lengths sum to {sum}, checksum {check}");
}
