// LeetCode #2745: Construct the Longest New String -- the differential.
// The five arms, against the statement read literally: every sequence of
// the pieces, one at a time, the string built and kept going only while
// it holds no "AAA" and no "BBB", and the longest string reached kept; no
// rule about which piece may follow which. Every count from 1 to 4 of
// each piece; then 1000 random counts up to 20. Every case is drawn
// before any arm answers; the literal reading is asked only of the
// first 64.
//
// P1  counts up to 4, the answer is the literal reading's
// P2  the counts of "AA" and "BB" swapped: the same answer
// P3  one more "AB": 2 longer
// P4  one more "AA" and one more "BB": 4 longer
// P5  even, at most every piece used, and at least every "AB" used
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn search(built: String, left: Array[i64, 3], best: mut ref i64) {
    *best = (*best).max(built.len());
    let pieces = ["AA", "BB", "AB"];
    for p in 0..3 {
        if left[p] > 0 {
            let longer = f"{built}{pieces[p]}";
            if not longer.contains("AAA") and not longer.contains("BBB") {
                let mut fewer = left;
                fewer[p] -= 1;
                search(longer, fewer, mut best);
            }
        }
    }
}

fn literal(x: i64, y: i64, z: i64) -> i64 {
    let mut best = 0;
    search(String.new(), [x, y, z], mut best);
    best
}


// ---- star (longest.kara) --------------------------------------------

fn star_longest_string(x: i64, y: i64, z: i64) -> i64 {
    let alternating = if x == y { 2 * x } else { 2 * x.min(y) + 1 };
    (alternating + z) * 2
}


// ---- greedy (longest_greedy.kara) -----------------------------------

fn greedy_longest_string(x: i64, y: i64, z: i64) -> i64 {
    let mut built = String.new();
    let mut left_a = x;
    let mut left_b = y;
    if left_b > left_a {
        built.push_str("BB");
        left_b -= 1;
    }
    for _ in 0..z {
        built.push_str("AB");
    }
    let mut a_next = true;
    loop {
        if a_next {
            if left_a == 0 {
                break;
            }
            built.push_str("AA");
            left_a -= 1;
        } else {
            if left_b == 0 {
                break;
            }
            built.push_str("BB");
            left_b -= 1;
        }
        a_next = not a_next;
    }
    built.len()
}


// ---- memo (longest_memo.kara) ---------------------------------------

enum Piece {
    Aa,
    Bb,
    Ab,
    Start,
}

struct Builder {
    memo: Vec[i64],
    y: i64,
    z: i64,
}

impl Builder {
    fn index(self, a: i64, b: i64, c: i64, last: Piece) -> i64 {
        let k = match last {
            Piece.Aa => 0,
            Piece.Bb => 1,
            Piece.Ab => 2,
            Piece.Start => 3,
        };
        ((a * (self.y + 1) + b) * (self.z + 1) + c) * 4 + k
    }

    // the longest string the pieces left can add after `last`
    fn longest(mut ref self, a: i64, b: i64, c: i64, last: Piece) -> i64 {
        let at = self.index(a, b, c, last);
        if self.memo[at] >= 0 {
            return self.memo[at];
        }
        let can_aa = a > 0 and not match last { Piece.Aa => true, _ => false };
        let can_bb = b > 0 and match last { Piece.Aa | Piece.Start => true, _ => false };
        let can_ab = c > 0 and not match last { Piece.Aa => true, _ => false };
        let mut best = 0;
        if can_aa {
            best = best.max(2 + self.longest(a - 1, b, c, Piece.Aa));
        }
        if can_bb {
            best = best.max(2 + self.longest(a, b - 1, c, Piece.Bb));
        }
        if can_ab {
            best = best.max(2 + self.longest(a, b, c - 1, Piece.Ab));
        }
        self.memo[at] = best;
        best
    }
}

fn memo_longest_string(x: i64, y: i64, z: i64) -> i64 {
    let mut builder = Builder { memo: Vec.filled((x + 1) * (y + 1) * (z + 1) * 4, -1), y, z };
    builder.longest(x, y, z, Piece.Start)
}


// ---- table (longest_table.kara) -------------------------------------

fn table_longest_string(x: i64, y: i64, z: i64) -> i64 {
    let at = |a: i64, b: i64, c: i64, last: i64| ((a * (y + 1) + b) * (z + 1) + c) * 4 + last;
    let mut more: Vec[i64] = Vec.filled((x + 1) * (y + 1) * (z + 1) * 4, 0);
    for a in 0..=x {
        for b in 0..=y {
            for c in 0..=z {
                for last in 0..4 {
                    let mut best = 0;
                    if a > 0 and last != 0 {
                        best = best.max(2 + more[at(a - 1, b, c, 0)]);
                    }
                    if b > 0 and (last == 0 or last == 3) {
                        best = best.max(2 + more[at(a, b - 1, c, 1)]);
                    }
                    if c > 0 and last != 0 {
                        best = best.max(2 + more[at(a, b, c - 1, 2)]);
                    }
                    more[at(a, b, c, last)] = best;
                }
            }
        }
    }
    more[at(x, y, z, 3)]
}


// ---- solution (longest_solution.kara) -------------------------------

struct Solution {}

impl Solution {
    pub fn longest_string(x: i32, y: i32, z: i32) -> i32 {
        if x == y {
            (x + y + z) * 2
        } else {
            (min(x, y) * 2 + 1 + z) * 2
        }
    }
}

fn solution_longest_string(x: i64, y: i64, z: i64) -> i64 {
    Solution.longest_string(x as i32, y as i32, z as i32)
}


fn answer(arm: i64, x: i64, y: i64, z: i64) -> i64 {
    match arm {
        0 => star_longest_string(x, y, z),
        1 => greedy_longest_string(x, y, z),
        2 => memo_longest_string(x, y, z),
        3 => table_longest_string(x, y, z),
        _ => solution_longest_string(x, y, z),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "greedy", "memo", "table", "solution"];
    let mut seed = 2745;
    let mut cases: Vec[(i64, i64, i64)] = Vec.new();
    for x in 1..=4 {
        for y in 1..=4 {
            for z in 1..=4 {
                cases.push((x, y, z));
            }
        }
    }
    for _ in 0..1000 {
        let x = next_random(mut seed) % 20 + 1;
        let y = next_random(mut seed) % 20 + 1;
        let z = next_random(mut seed) % 20 + 1;
        cases.push((x, y, z));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (x, y, z)) in cases.iter().enumerate() {
        let small = c < 64;
        let want = if small { literal(x, y, z) } else { -1 };
        check = (check * 31 + want + 1) % 1000000007;
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, x, y, z)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == want,
                answer(arm, y, x, z) == value,
                answer(arm, x, y, z + 1) == value + 2,
                answer(arm, x + 1, y + 1, z) == value + 4,
                value % 2 == 0 and value <= 2 * (x + y + z) and value >= 2 * z,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} ({x}, {y}, {z}), arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
