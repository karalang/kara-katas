// LeetCode #2729: Check if The Number is Fascinating -- the mask arm. The
// digits of n, 2 n and 3 n taken off by `% 10` with no text at all, each
// setting its bit of a mask; a 0, or a digit whose bit is already set,
// fails at once, and nine digits must have been seen. O(1).

fn is_fascinating(n: i64) -> bool {
    let mut mask = 0;
    let mut seen = 0;
    for m in [n, 2 * n, 3 * n] {
        let mut x = m;
        while x > 0 {
            let d = x % 10;
            if d == 0 or (mask >> d) & 1 == 1 {
                return false;
            }
            mask |= 1 << d;
            seen += 1;
            x /= 10;
        }
    }
    seen == 9
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; the smallest and largest three-digit
    // numbers; every fascinating number from 100 to 999; and how many of
    // the 900 are fascinating, with a checksum of their verdicts
    println(f"{is_fascinating(192)}");
    println(f"{is_fascinating(100)}");
    println(f"{is_fascinating(999)}");
    let mut found: Vec[i64] = Vec.new();
    let mut check = 0;
    for n in 100..1000 {
        let yes = is_fascinating(n);
        if yes {
            found.push(n);
        }
        check = (check * 31 + if yes { 2 } else { 1 }) % 1000000007;
    }
    println(f"{found}");
    println(f"{found.len()} of 900 fascinating, checksum {check}");
}
