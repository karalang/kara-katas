// LeetCode #2729: Check if The Number is Fascinating -- the ★ arm. n, 2 n
// and 3 n written one after another by an f-string; the digits sorted
// spell "123456789" exactly when every digit from 1 to 9 is there once
// and no 0 is. O(1).

fn is_fascinating(n: i64) -> bool {
    let joined = f"{n}{2 * n}{3 * n}";
    let mut digits: Vec[char] = joined.chars().collect();
    digits.sort();
    let sorted: String = digits.into_iter().collect();
    sorted == "123456789"
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; the smallest and largest three-digit
    // numbers; every fascinating number from 100 to 999; and how many of
    // the 900 are fascinating, with a checksum of their verdicts
    println(f"{is_fascinating(192)}");
    println(f"{is_fascinating(100)}");
    println(f"{is_fascinating(999)}");
    let mut found: Vec[i64] = Vec.new();
    let mut check = 0;
    for n in 100..1000 {
        let yes = is_fascinating(n);
        if yes {
            found.push(n);
        }
        check = (check * 31 + if yes { 2 } else { 1 }) % 1000000007;
    }
    println(f"{found}");
    println(f"{found.len()} of 900 fascinating, checksum {check}");
}
