// LeetCode #2729: Check if The Number is Fascinating -- a Rust solution
// as LeetCode's Rust users write it, carried to Kāra by `karac fix`:
// `format!` of the three numbers, the chars sorted and collected back
// into a `String` by turbofish, and compared with "123456789".

struct Solution {}

impl Solution {
    pub fn is_fascinating(n: i32) -> bool {
        let s = f"{n}{2 * n}{3 * n}";
        let mut v: Vec[char] = s.chars().collect();
        v.sort();
        String.from_iter(v.into_iter()) == "123456789"
    }
}

fn is_fascinating(n: i64) -> bool {
    Solution.is_fascinating(n as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; the smallest and largest three-digit
    // numbers; every fascinating number from 100 to 999; and how many of
    // the 900 are fascinating, with a checksum of their verdicts
    println(f"{is_fascinating(192)}");
    println(f"{is_fascinating(100)}");
    println(f"{is_fascinating(999)}");
    let mut found: Vec[i64] = Vec.new();
    let mut check = 0;
    for n in 100..1000 {
        let yes = is_fascinating(n);
        if yes {
            found.push(n);
        }
        check = (check * 31 + if yes { 2 } else { 1 }) % 1000000007;
    }
    println(f"{found}");
    println(f"{found.len()} of 900 fascinating, checksum {check}");
}
