// LeetCode #2741: Special Permutations -- the bench: the ★ arm,
// ways[mask][last] carried forward to every partner of `last`, over
// arrays of 14 numbers drawn first.

const MOD: i64 = 1000000007;

fn special_perm(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let full = (1 << n) - 1;
    let mut ways: Vec[Vec[i64]] = Vec.filled(1 << n, Vec.filled(n, 0));
    for i in 0..n {
        ways[1 << i][i] = 1;
    }
    for mask in 1..full {
        for last in 0..n {
            let w = ways[mask][last];
            if w == 0 {
                continue;
            }
            for next in 0..n {
                if (mask >> next) & 1 == 0 and (nums[next] % nums[last] == 0 or nums[last] % nums[next] == 0) {
                    let to = mask | (1 << next);
                    ways[to][next] = (ways[to][next] + w) % MOD;
                }
            }
        }
    }
    let mut total = 0;
    for last in 0..n {
        total = (total + ways[full][last]) % MOD;
    }
    total
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 30;
    let rounds = 5;
    let mut seed = 2741;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        // 14 distinct numbers, LeetCode's most, of the form 2^a 3^b with a
        // up to 5 and b up to 3, so that one divides another often
        let mut nums: Vec[i64] = Vec.new();
        while nums.len() < 14 {
            let a = next_random(mut seed) % 6;
            let b = next_random(mut seed) % 4;
            let x = (1 << a) * [1, 3, 9, 27][b];
            if not nums.contains(x) {
                nums.push(x);
            }
        }
        arrays.push(nums);
    }
    let mut sum = 0;
    let mut check = 0;
    for r in 0..rounds {
        for nums in arrays.iter() {
            let count = special_perm(nums);
            sum += count;
            check = (check * 31 + count + r) % 1000000007;
        }
    }
    println(f"{count} arrays of 14 numbers, {rounds} rounds: counts sum to {sum}, checksum {check}");
}
