// LeetCode #2741: Special Permutations -- the ★ arm. `ways[mask][last]`
// counts the special orders of the numbers in `mask` that end with
// `last`; each is carried forward to every number outside the mask that
// divides or is divided by `last`. The answer sums the full mask's row.
// O(2^n n^2).

const MOD: i64 = 1000000007;

fn special_perm(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let full = (1 << n) - 1;
    let mut ways: Vec[Vec[i64]] = Vec.filled(1 << n, Vec.filled(n, 0));
    for i in 0..n {
        ways[1 << i][i] = 1;
    }
    for mask in 1..full {
        for last in 0..n {
            let w = ways[mask][last];
            if w == 0 {
                continue;
            }
            for next in 0..n {
                if (mask >> next) & 1 == 0 and (nums[next] % nums[last] == 0 or nums[last] % nums[next] == 0) {
                    let to = mask | (1 << next);
                    ways[to][next] = (ways[to][next] + w) % MOD;
                }
            }
        }
    }
    let mut total = 0;
    for last in 0..n {
        total = (total + ways[full][last]) % MOD;
    }
    total
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n distinct numbers of the form 2^a 3^b, a up to 5 and b up to 3, so
// that one divides another often
fn random_smooth(seed: mut ref i64, n: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    while nums.len() < n {
        let x = (1 << (next_random(mut seed) % 6)) * [1, 3, 9, 27][next_random(mut seed) % 4];
        if not nums.contains(x) {
            nums.push(x);
        }
    }
    nums
}

// n distinct numbers from 1 to most
fn random_numbers(seed: mut ref i64, n: i64, most: i64) -> Vec[i64] {
    let mut nums: Vec[i64] = Vec.new();
    while nums.len() < n {
        let x = next_random(mut seed) % most + 1;
        if not nums.contains(x) {
            nums.push(x);
        }
    }
    nums
}

fn main() {
    // LeetCode's two examples
    println(f"{special_perm([2, 3, 6].to_vec())}");
    println(f"{special_perm([1, 4, 3].to_vec())}");
    // two numbers, one dividing the other and not; and 14 powers of two,
    // where every order is special: 14! mod 10^9 + 7
    println(f"{special_perm([1, 2].to_vec())}");
    println(f"{special_perm([2, 3].to_vec())}");
    println(f"{special_perm((0..14).map(|k| 1 << k).collect())}");
    // 2000 random arrays of 2 to 8 distinct numbers, by turns of the form
    // 2^a 3^b and up to 30; then 10 of 14 of the form 2^a 3^b, LeetCode's
    // longest
    let mut seed = 2741;
    let mut sum = 0;
    let mut check = 0;
    for c in 0..2010 {
        let nums = if c < 2000 {
            let n = next_random(mut seed) % 7 + 2;
            if c % 2 == 0 { random_smooth(mut seed, n) } else { random_numbers(mut seed, n, 30) }
        } else {
            random_smooth(mut seed, 14)
        };
        let count = special_perm(nums);
        sum += count;
        check = (check * 31 + count) % 1000000007;
        if c == 1999 {
            println(f"2000 small arrays: counts sum to {sum}, checksum {check}");
            sum = 0;
            check = 0;
        }
    }
    println(f"10 arrays of 14 numbers: counts sum to {sum}, checksum {check}");
}
