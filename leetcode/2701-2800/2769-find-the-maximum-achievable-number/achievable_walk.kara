// LeetCode #2769: Find the Maximum Achievable Number -- the walk arm.
// Every x from num + 3t down, each walked toward num: while they differ
// and an operation is left, the greater one steps down and the other up;
// the first x that meets num is the answer. O(t^2).

fn meets(x: i64, num: i64, t: i64) -> bool {
    let mut (a, b) = (x, num);
    let mut left = t;
    while a != b and left > 0 {
        if a > b {
            a -= 1;
            b += 1;
        } else {
            a += 1;
            b -= 1;
        }
        left -= 1;
    }
    a == b
}

fn the_maximum_achievable_x(num: i64, t: i64) -> i64 {
    let mut x = num + 3 * t;
    while not meets(x, num, t) {
        x -= 1;
    }
    x
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; LeetCode's least and most
    println(f"{the_maximum_achievable_x(4, 1)}");
    println(f"{the_maximum_achievable_x(3, 2)}");
    println(f"{the_maximum_achievable_x(1, 1)}");
    println(f"{the_maximum_achievable_x(50, 50)}");
    // every num and t from 1 to 50
    let mut total = 0;
    let mut check = 0;
    for num in 1..=50 {
        for t in 1..=50 {
            let x = the_maximum_achievable_x(num, t);
            total += x;
            check = (check * 31 + x) % 1000000007;
        }
    }
    println(f"2500 pairs: answers sum to {total}, checksum {check}");
}
