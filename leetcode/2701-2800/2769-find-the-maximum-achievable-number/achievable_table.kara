// LeetCode #2769: Find the Maximum Achievable Number -- the table arm. A
// table over every x from num - 2t - 2 to num + 2t + 2 of whether x has
// met num within k operations, built up from k = 0, where only x = num
// has: x has met within k + 1 if it had within k, or if one operation
// takes x and num to a pair whose gap had. The greatest x marked. O(t^2).

fn the_maximum_achievable_x(num: i64, t: i64) -> i64 {
    let low = num - 2 * t - 2;
    let width = 4 * t + 5;
    let mut met: Vec[bool] = Vec.filled(width, false);
    met[num - low] = true;
    for _ in 0..t {
        let mut next = met.clone();
        for i in 0..width {
            // an operation moves x by -1 or +1 and num by -1 or +1: the gap
            // x - num by -2, 0 or +2, as if x alone moved by that much
            for step in [-2, 0, 2] {
                let j = i + step;
                if 0 <= j and j < width and met[j] {
                    next[i] = true;
                }
            }
        }
        met = next;
    }
    let mut i = width - 1;
    while not met[i] {
        i -= 1;
    }
    low + i
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; LeetCode's least and most
    println(f"{the_maximum_achievable_x(4, 1)}");
    println(f"{the_maximum_achievable_x(3, 2)}");
    println(f"{the_maximum_achievable_x(1, 1)}");
    println(f"{the_maximum_achievable_x(50, 50)}");
    // every num and t from 1 to 50
    let mut total = 0;
    let mut check = 0;
    for num in 1..=50 {
        for t in 1..=50 {
            let x = the_maximum_achievable_x(num, t);
            total += x;
            check = (check * 31 + x) % 1000000007;
        }
    }
    println(f"2500 pairs: answers sum to {total}, checksum {check}");
}
