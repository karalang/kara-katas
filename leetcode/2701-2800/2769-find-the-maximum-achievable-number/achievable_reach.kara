// LeetCode #2769: Find the Maximum Achievable Number -- the reach arm.
// Only the gap x - num matters, and an operation changes it by -2, 0 or
// +2. Backwards from a gap of 0, the gaps that can close within t
// operations are gathered step by step in a `SortedSet`, and the greatest
// one, read by `last`, gives x. O(t^2 log t).

fn the_maximum_achievable_x(num: i64, t: i64) -> i64 {
    let mut gaps: SortedSet[i64] = SortedSet.new();
    gaps.insert(0);
    for _ in 0..t {
        let now: Vec[i64] = gaps.iter().collect();
        for g in now.iter() {
            for step in [-2, 0, 2] {
                gaps.insert(g + step);
            }
        }
    }
    num + gaps.max().unwrap()
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; LeetCode's least and most
    println(f"{the_maximum_achievable_x(4, 1)}");
    println(f"{the_maximum_achievable_x(3, 2)}");
    println(f"{the_maximum_achievable_x(1, 1)}");
    println(f"{the_maximum_achievable_x(50, 50)}");
    // every num and t from 1 to 50
    let mut total = 0;
    let mut check = 0;
    for num in 1..=50 {
        for t in 1..=50 {
            let x = the_maximum_achievable_x(num, t);
            total += x;
            check = (check * 31 + x) % 1000000007;
        }
    }
    println(f"2500 pairs: answers sum to {total}, checksum {check}");
}
