// LeetCode #2773: Height of Special Binary Tree -- the bench. The ★ arm
// (height.kara) over 20 random trees of 10^4 nodes, LeetCode's most, each
// grown by hanging every new node on one of the last 1 to 50 with a free
// side, its leaves joined into a ring. All the trees drawn first, then
// each answered 200 times.

fn depth(u: i64, left: Vec[i64], right: Vec[i64]) -> i64 {
    let mut best = 0;
    let l = left[u];
    if l >= 0 and right[l] != u {
        best = best.max(depth(l, left, right) + 1);
    }
    let r = right[u];
    if r >= 0 and left[r] != u {
        best = best.max(depth(r, left, right) + 1);
    }
    best
}

fn height_of_tree(left: Vec[i64], right: Vec[i64], root: i64) -> i64 {
    depth(root, left, right)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the leaves, left to right, joined into a ring: each leaf's right is the
// next leaf and its left the one before, the last and first joined
fn joined(left: Vec[i64], right: Vec[i64], root: i64) -> (Vec[i64], Vec[i64]) {
    let mut leaves: Vec[i64] = Vec.new();
    let mut stack: Vec[i64] = [root].to_vec();
    while let Some(u) = stack.pop() {
        if left[u] < 0 and right[u] < 0 {
            leaves.push(u);
        }
        if right[u] >= 0 {
            stack.push(right[u]);
        }
        if left[u] >= 0 {
            stack.push(left[u]);
        }
    }
    let mut l = left.clone();
    let mut r = right.clone();
    let k = leaves.len();
    for i in 0..k {
        r[leaves[i]] = leaves[(i + 1) % k];
        l[leaves[i]] = leaves[(i + k - 1) % k];
    }
    (l, r)
}

// a random tree of n nodes, each new node hung on a node among the last
// `reach` with a free side, so a small reach grows a deep tree
fn grown(n: i64, reach: i64, seed: mut ref i64) -> (Vec[i64], Vec[i64]) {
    let mut left: Vec[i64] = Vec.filled(n, -1);
    let mut right: Vec[i64] = Vec.filled(n, -1);
    for k in 1..n {
        let mut p = k - 1 - next_random(mut seed) % reach.min(k);
        while left[p] >= 0 and right[p] >= 0 {
            p = next_random(mut seed) % k;
        }
        let go_left = if left[p] >= 0 { false } else if right[p] >= 0 { true } else { next_random(mut seed) % 2 == 0 };
        if go_left {
            left[p] = k;
        } else {
            right[p] = k;
        }
    }
    joined(left, right, 0)
}

fn main() {
    let count = 20;
    let rounds = 200;
    let mut seed = 2773;
    let mut trees: Vec[(Vec[i64], Vec[i64])] = Vec.new();
    for _ in 0..count {
        let reach = next_random(mut seed) % 50 + 1;
        trees.push(grown(10000, reach, mut seed));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (left, right) in trees.iter() {
            let h = height_of_tree(left, right, 0);
            total += h;
            check = (check * 31 + h + r) % 1000000007;
        }
    }
    println(f"{count} trees of 10^4, {rounds} rounds: heights sum to {total}, checksum {check}");
}
