// LeetCode #2773: Height of Special Binary Tree -- the differential. The
// five arms, against the statement read literally: the tree as it was
// grown, before its leaves were joined into a ring, and its height by the
// recursive definition, the longest path down from the root; no ring to
// see through. 2000 random trees of 2 to 20 nodes; then 60 of up to 3000.
// Every case is drawn before any arm answers.
//
// P1  the answer is the literal reading's
// P2  the nodes numbered backwards: the same answer
// P3  the tree mirrored, left and right swapped throughout: the same
//     answer
// P4  a new root above the old one: one more
// P5  from the least height of n nodes, ceil(log2(n + 1)) - 1, to n - 1
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(left: Vec[i64], right: Vec[i64], u: i64) -> i64 {
    let mut best = 0;
    for child in [left[u], right[u]] {
        if child >= 0 {
            best = best.max(1 + literal(left, right, child));
        }
    }
    best
}


// ---- star (height.kara) ---------------------------------------------

fn star_depth(u: i64, left: Vec[i64], right: Vec[i64]) -> i64 {
    let mut best = 0;
    let l = left[u];
    if l >= 0 and right[l] != u {
        best = best.max(star_depth(l, left, right) + 1);
    }
    let r = right[u];
    if r >= 0 and left[r] != u {
        best = best.max(star_depth(r, left, right) + 1);
    }
    best
}

fn star_height_of_tree(left: Vec[i64], right: Vec[i64], root: i64) -> i64 {
    star_depth(root, left, right)
}


// ---- levels (height_levels.kara) ------------------------------------

fn levels_height_of_tree(left: Vec[i64], right: Vec[i64], root: i64) -> i64 {
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(root);
    let mut levels = 0;
    while not queue.is_empty() {
        levels += 1;
        for _ in 0..queue.len() {
            let u = queue.pop_front().unwrap();
            let l = left[u];
            if l >= 0 and right[l] != u {
                queue.push_back(l);
            }
            let r = right[u];
            if r >= 0 and left[r] != u {
                queue.push_back(r);
            }
        }
    }
    levels - 1
}


// ---- weak (height_weak.kara) ----------------------------------------

shared struct Node {
    mut left: weak Node,
    mut right: weak Node,
}

// whether `side` of the node `from` is the node `back`
fn weak_points_to(from: Option[Node], back: Node) -> bool {
    match from {
        Some(node) => node.ref_eq(back),
        None => false,
    }
}

fn weak_depth(u: Node) -> i64 {
    let mut best = 0;
    if let Some(l) = u.left {
        if not weak_points_to(l.right, u) {
            best = best.max(weak_depth(l) + 1);
        }
    }
    if let Some(r) = u.right {
        if not weak_points_to(r.left, u) {
            best = best.max(weak_depth(r) + 1);
        }
    }
    best
}

fn weak_height_of_tree(left: Vec[i64], right: Vec[i64], root: i64) -> i64 {
    let nodes: Vec[Node] = (0..left.len()).map(|_| Node { left: None, right: None }).collect();
    for u in 0..left.len() {
        if left[u] >= 0 {
            nodes[u].left = nodes[left[u]];
        }
        if right[u] >= 0 {
            nodes[u].right = nodes[right[u]];
        }
    }
    weak_depth(nodes[root])
}


// ---- parents (height_parents.kara) ----------------------------------

fn parents_height_of_tree(left: Vec[i64], right: Vec[i64], root: i64) -> i64 {
    let n = left.len();
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    for u in 0..n {
        if left[u] >= 0 and right[left[u]] != u {
            parent[left[u]] = u;
        }
        if right[u] >= 0 and left[right[u]] != u {
            parent[right[u]] = u;
        }
    }
    let mut depth: Vec[Option[i64]] = Vec.filled(n, None);
    depth[root] = Some(0);
    let mut best = 0;
    for start in 0..n {
        let mut chain: Vec[i64] = Vec.new();
        let mut u = start;
        while depth[u].is_none() {
            chain.push(u);
            u = parent[u];
        }
        let mut d = depth[u].unwrap();
        for v in chain.iter().rev() {
            d += 1;
            depth[v] = Some(d);
        }
        best = best.max(depth[start].unwrap());
    }
    best
}


// ---- solution (height_solution.kara) --------------------------------

fn solution_dfs(node: TreeNode) -> i32 {
    let n = node;
    let mut best: i32 = 0;
    if let Some(l) = ref n.left {
        let back = l.right.as_ref().map_or(false, |r| r.ref_eq(node));
        if not back {
            best = best.max(1 + solution_dfs(l));
        }
    }
    if let Some(r) = ref n.right {
        let back = r.left.as_ref().map_or(false, |l| l.ref_eq(node));
        if not back {
            best = best.max(1 + solution_dfs(r));
        }
    }
    best
}

struct Solution {}

impl Solution {
    pub fn height_of_tree(root: Option[TreeNode]) -> i32 {
        solution_dfs(root.as_ref().unwrap())
    }
}

// LeetCode's own node
shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn solution_height_of_tree(left: Vec[i64], right: Vec[i64], root: i64) -> i64 {
    let nodes: Vec[TreeNode] = (0..left.len()).map(|v| TreeNode { val: v as i32 + 1, left: None, right: None }).collect();
    for u in 0..left.len() {
        if left[u] >= 0 {
            nodes[u].left = Some(nodes[left[u]]);
        }
        if right[u] >= 0 {
            nodes[u].right = Some(nodes[right[u]]);
        }
    }
    let h = Solution.height_of_tree(Some(nodes[root])) as i64;
    for node in nodes.iter() {
        node.left = None;
        node.right = None;
    }
    h
}


fn answer(arm: i64, left: Vec[i64], right: Vec[i64], root: i64) -> i64 {
    match arm {
        0 => star_height_of_tree(left, right, root),
        1 => levels_height_of_tree(left, right, root),
        2 => weak_height_of_tree(left, right, root),
        3 => parents_height_of_tree(left, right, root),
        _ => solution_height_of_tree(left, right, root),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the leaves, left to right, joined into a ring: each leaf's right is the
// next leaf and its left the one before, the last and first joined
fn joined(left: Vec[i64], right: Vec[i64], root: i64) -> (Vec[i64], Vec[i64]) {
    let mut leaves: Vec[i64] = Vec.new();
    let mut stack: Vec[i64] = [root].to_vec();
    while let Some(u) = stack.pop() {
        if left[u] < 0 and right[u] < 0 {
            leaves.push(u);
        }
        if right[u] >= 0 {
            stack.push(right[u]);
        }
        if left[u] >= 0 {
            stack.push(left[u]);
        }
    }
    let mut l = left.clone();
    let mut r = right.clone();
    let k = leaves.len();
    for i in 0..k {
        r[leaves[i]] = leaves[(i + 1) % k];
        l[leaves[i]] = leaves[(i + k - 1) % k];
    }
    (l, r)
}

// a random tree of n nodes, each new node hung on a node among the last
// `reach` with a free side, so a small reach grows a deep tree; not yet
// joined
fn grown(n: i64, reach: i64, seed: mut ref i64) -> (Vec[i64], Vec[i64]) {
    let mut left: Vec[i64] = Vec.filled(n, -1);
    let mut right: Vec[i64] = Vec.filled(n, -1);
    for k in 1..n {
        let mut p = k - 1 - next_random(mut seed) % reach.min(k);
        while left[p] >= 0 and right[p] >= 0 {
            p = next_random(mut seed) % k;
        }
        let go_left = if left[p] >= 0 { false } else if right[p] >= 0 { true } else { next_random(mut seed) % 2 == 0 };
        if go_left {
            left[p] = k;
        } else {
            right[p] = k;
        }
    }
    (left, right)
}

fn main() {
    let names = ["star", "levels", "weak", "parents", "solution"];
    let mut seed = 2773;
    let mut cases: Vec[(Vec[i64], Vec[i64])] = Vec.new();
    for c in 0..2060 {
        let n = if c < 2000 { next_random(mut seed) % 19 + 2 } else { next_random(mut seed) % 2999 + 2 };
        let reach = if c < 2000 { next_random(mut seed) % n + 1 } else { next_random(mut seed) % 50 + 1 };
        cases.push(grown(n, reach, mut seed));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (plain_left, plain_right)) in cases.iter().enumerate() {
        let n = plain_left.len();
        let want = literal(plain_left, plain_right, 0);
        check = (check * 31 + want + 1) % 1000000007;
        let (left, right) = joined(plain_left, plain_right, 0);
        let flip = |v: i64| if v >= 0 { n - 1 - v } else { -1 };
        let back_left: Vec[i64] = (0..n).map(|i| flip(left[n - 1 - i])).collect();
        let back_right: Vec[i64] = (0..n).map(|i| flip(right[n - 1 - i])).collect();
        let mut above_left = left.clone();
        above_left.push(0);
        let mut above_right = right.clone();
        above_right.push(-1);
        let mut least = 0;
        while (1 << (least + 1)) - 1 < n {
            least += 1;
        }
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, left, right, 0)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                value == want,
                answer(arm, back_left, back_right, n - 1) == value,
                answer(arm, right, left, 0) == value,
                answer(arm, above_left, above_right, n) == value + 1,
                least <= value and value <= n - 1,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {plain_left} {plain_right}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
