// LeetCode #2798: Number of Employees Who Met the Target -- the bench:
// the ★ arm over 20000 teams of 50, LeetCode's most, with hours and
// targets up to 10^5, all drawn first, then each answered 500 times.

fn number_of_employees_who_met_target(hours: Vec[i64], target: i64) -> i64 {
    hours.iter().filter(|h| h >= target).count()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let count = 20000;
    let rounds = 500;
    let mut seed = 2798;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for _ in 0..count {
        let hours: Vec[i64] = (0..50).map(|_| wide(mut seed) % 100001).collect();
        cases.push((hours, wide(mut seed) % 100001));
    }
    let mut total = 0;
    let mut check = 0;
    for r in 0..rounds {
        for (hours, target) in cases.iter() {
            let a = number_of_employees_who_met_target(hours, target);
            total += a;
            check = (check * 31 + a + r) % 1000000007;
        }
    }
    println(f"{count} teams of 50, {rounds} rounds: met sum to {total}, checksum {check}");
}
