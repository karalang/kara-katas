// LeetCode #2798: Number of Employees Who Met the Target -- by sorting:
// the hours sorted, the first place at or above the target found by
// `partition_point`, and the places from it on counted. O(n log n).

fn number_of_employees_who_met_target(hours: Vec[i64], target: i64) -> i64 {
    let mut sorted = hours.clone();
    sorted.sort();
    sorted.len() - sorted.partition_point(|h| h < target)
}

// ---- the harness: the same in every arm --------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples; a target of 0, met by everyone; 50 hours of
    // 10^5, LeetCode's most, against a target just above and at them
    println(f"{number_of_employees_who_met_target([0, 1, 2, 3, 4], 2)}");
    println(f"{number_of_employees_who_met_target([5, 1, 4, 2, 2], 6)}");
    println(f"{number_of_employees_who_met_target([0, 0, 7], 0)}");
    let most: Vec[i64] = Vec.filled(50, 100000);
    println(f"{number_of_employees_who_met_target(most, 100000)}");
    println(f"{number_of_employees_who_met_target(most, 100001)}");
    // 3000 random teams of 1 to 50 with hours up to 20 and targets up to
    // 20; then 3000 with hours and targets up to 10^5
    let mut seed = 2798;
    for top in [20, 100000].iter() {
        let mut sum = 0;
        let mut check = 0;
        for _ in 0..3000 {
            let n = next_random(mut seed) % 50 + 1;
            let hours: Vec[i64] = (0..n).map(|_| wide(mut seed) % (top + 1)).collect();
            let target = wide(mut seed) % (top + 1);
            let a = number_of_employees_who_met_target(hours, target);
            sum += a;
            check = (check * 31 + a) % 1000000007;
        }
        println(f"3000 teams, hours up to {top}: met sum to {sum}, checksum {check}");
    }
}
