// LeetCode #2798: Number of Employees Who Met the Target -- the
// differential. The five arms, against the statement read literally:
// each employee's hours spent one at a time against the hours still
// owed, and the employee counted when nothing is owed at the end; no
// comparison of hours with the target. 2000 random teams of 1 to 50 with
// hours and targets up to 20; then 50 with hours and targets up to 10^5.
// Every case is drawn before any arm answers; the literal reading is
// asked only of the first 2000.
//
// P1  hours up to 20, the count is the literal reading's
// P2  the hours and the target 1000 more: the same count
// P3  the target one more: less by those who worked just the target
// P4  the hours reversed: the same count
// P5  from 0 to n, and n when the target is 0
// P6  each arm agrees with at least three of the other four

// ---- the statement read literally ------------------------------------------

fn literal(hours: Vec[i64], target: i64) -> i64 {
    let mut met = 0;
    for h in hours.iter() {
        let mut owed = target;
        let mut worked = h;
        while owed > 0 and worked > 0 {
            owed -= 1;
            worked -= 1;
        }
        if owed == 0 {
            met += 1;
        }
    }
    met
}


// ---- star (met.kara) ------------------------------------------------

fn star_number_of_employees_who_met_target(hours: Vec[i64], target: i64) -> i64 {
    hours.iter().filter(|h| h >= target).count()
}


// ---- loop (met_loop.kara) -------------------------------------------

fn loop_number_of_employees_who_met_target(hours: Vec[i64], target: i64) -> i64 {
    let mut met = 0;
    for h in hours.iter() {
        if h >= target {
            met += 1;
        }
    }
    met
}


// ---- short (met_short.kara) -----------------------------------------

fn short_number_of_employees_who_met_target(hours: Vec[i64], target: i64) -> i64 {
    let short = hours.iter().fold(0, |c, h| if h < target { c + 1 } else { c });
    hours.len() - short
}


// ---- sorted (met_sorted.kara) ---------------------------------------

fn sorted_number_of_employees_who_met_target(hours: Vec[i64], target: i64) -> i64 {
    let mut sorted = hours.clone();
    sorted.sort();
    sorted.len() - sorted.partition_point(|h| h < target)
}


// ---- solution (met_solution.kara) -----------------------------------

struct Solution {}

impl Solution {
    pub fn number_of_employees_who_met_target(hours: Vec[i32], target: i32) -> i32 {
        hours.iter().filter(|h| h >= target).count() as i32
    }
}

fn solution_number_of_employees_who_met_target(hours: Vec[i64], target: i64) -> i64 {
    Solution.number_of_employees_who_met_target(hours.iter().map(|h| h as i32).collect(), target as i32)
}


fn answer(arm: i64, hours: Vec[i64], target: i64) -> i64 {
    match arm {
        0 => star_number_of_employees_who_met_target(hours, target),
        1 => loop_number_of_employees_who_met_target(hours, target),
        2 => short_number_of_employees_who_met_target(hours, target),
        3 => sorted_number_of_employees_who_met_target(hours, target),
        _ => solution_number_of_employees_who_met_target(hours, target),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "loop", "short", "sorted", "solution"];
    let mut seed = 2798;
    let mut cases: Vec[(Vec[i64], i64)] = Vec.new();
    for c in 0..2050 {
        let top = if c < 2000 { 20 } else { 100000 };
        let n = next_random(mut seed) % 50 + 1;
        let hours: Vec[i64] = (0..n).map(|_| wide(mut seed) % (top + 1)).collect();
        cases.push((hours, wide(mut seed) % (top + 1)));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (c, (hours, target)) in cases.iter().enumerate() {
        let small = c < 2000;
        let want = if small { literal(hours, target) } else { 0 };
        check = (check * 31 + want + 1) % 1000000007;
        let n = hours.len();
        let raised: Vec[i64] = hours.iter().map(|h| h + 1000).collect();
        let reversed: Vec[i64] = hours.iter().rev().collect();
        let at_target = hours.iter().filter(|h| h == target).count();
        let got: Vec[i64] = (0..5).map(|arm| answer(arm, hours, target)).collect();
        for arm in 0..5 {
            let value = got[arm];
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == value {
                    same += 1;
                }
            }
            let verdicts = [
                not small or value == want,
                answer(arm, raised, target + 1000) == value,
                answer(arm, hours, target + 1) == value - at_target,
                answer(arm, reversed, target) == value,
                value >= 0 and value <= n and answer(arm, hours, 0) == n,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"case {c} {hours} target {target}, arm {names[arm]}: P{q + 1} fails, gave {value}");
                    }
                }
            }
        }
    }
    let all = by_property.iter().sum();
    println(f"{cases.len()} cases: checksum {check}, {checks} checks over 5 arms: {all} failures");
    if all > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
