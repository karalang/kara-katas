// LeetCode #2787: Ways to Express an Integer as Sum of Powers -- only the
// sums that can be made: a `Map[i64, i64]` from each reachable sum to its
// count of sets, and each power i^x adds to it a copy of every entry
// moved up by i^x, as long as that stays within n. O(n * n^(1/x)).

fn number_of_ways(n: i64, x: i64) -> i64 {
    let modulus = 1000000007;
    let mut sums: Map[i64, i64] = Map.new();
    sums.insert(0, 1);
    let mut i = 1;
    while i.pow(x as u32) <= n {
        let p = i.pow(x as u32);
        let moved: Vec[(i64, i64)] = sums.iter().filter(|(s, _)| s + p <= n).map(|(s, w)| (s + p, w)).collect();
        for (s, w) in moved.iter() {
            let held = sums.entry(s).or_insert(0);
            *held = (*held + w) % modulus;
        }
        i += 1;
    }
    sums.get(n) ?? 0
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; 300 as distinct numbers, LeetCode's most,
    // and as distinct squares, cubes, 4th and 5th powers
    println(f"{number_of_ways(10, 2)}");
    println(f"{number_of_ways(4, 1)}");
    for x in 1..=5 {
        println(f"{number_of_ways(300, x)}");
    }
    // every n from 1 to 300 with every x from 1 to 5
    let mut nonzero = 0;
    let mut check = 0;
    for n in 1..=300 {
        for x in 1..=5 {
            let w = number_of_ways(n, x);
            if w > 0 {
                nonzero += 1;
            }
            check = (check * 31 + w) % 1000000007;
        }
    }
    println(f"1500 pairs: {nonzero} with a way, checksum {check}");
}
