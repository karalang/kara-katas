// LeetCode #2787: Ways to Express an Integer as Sum of Powers -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac
// fix`: `dp = vec![0i64; n + 1]` over `n as usize`, the powers by
// `(i as i64).pow(x as u32)` in a `loop` that breaks past n, and the sums
// walked down by `(p..=n).rev()`.

struct Solution {}

impl Solution {
    pub fn number_of_ways(n: i32, x: i32) -> i32 {
        const MOD: i64 = 1_000_000_007;
        let n = n as i64;
        let mut dp = Vec.filled(n + 1, 0);
        dp[0] = 1;
        let mut i = 1;
        loop {
            let p = i.pow(x as u32);
            if p > n {
                break;
            }
            for s in (p..=n).rev() {
                dp[s] = (dp[s] + dp[s - p]) % MOD;
            }
            i += 1;
        }
        dp[n] as i32
    }
}

fn number_of_ways(n: i64, x: i64) -> i64 {
    Solution.number_of_ways(n as i32, x as i32)
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; 300 as distinct numbers, LeetCode's most,
    // and as distinct squares, cubes, 4th and 5th powers
    println(f"{number_of_ways(10, 2)}");
    println(f"{number_of_ways(4, 1)}");
    for x in 1..=5 {
        println(f"{number_of_ways(300, x)}");
    }
    // every n from 1 to 300 with every x from 1 to 5
    let mut nonzero = 0;
    let mut check = 0;
    for n in 1..=300 {
        for x in 1..=5 {
            let w = number_of_ways(n, x);
            if w > 0 {
                nonzero += 1;
            }
            check = (check * 31 + w) % 1000000007;
        }
    }
    println(f"1500 pairs: {nonzero} with a way, checksum {check}");
}
