// LeetCode #2787: Ways to Express an Integer as Sum of Powers -- the ★
// arm. A 0/1 knapsack: `ways[s]` counts the sets of the powers so far
// summing to s, and each power i^x, smallest first, is added by walking
// s down from n so no power is used twice. O(n * n^(1/x)).

fn number_of_ways(n: i64, x: i64) -> i64 {
    let modulus = 1000000007;
    let mut ways: Vec[i64] = Vec.filled(n + 1, 0);
    ways[0] = 1;
    let mut i = 1;
    while i.pow(x as u32) <= n {
        let p = i.pow(x as u32);
        for s in (p..=n).rev() {
            ways[s] = (ways[s] + ways[s - p]) % modulus;
        }
        i += 1;
    }
    ways[n]
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; 300 as distinct numbers, LeetCode's most,
    // and as distinct squares, cubes, 4th and 5th powers
    println(f"{number_of_ways(10, 2)}");
    println(f"{number_of_ways(4, 1)}");
    for x in 1..=5 {
        println(f"{number_of_ways(300, x)}");
    }
    // every n from 1 to 300 with every x from 1 to 5
    let mut nonzero = 0;
    let mut check = 0;
    for n in 1..=300 {
        for x in 1..=5 {
            let w = number_of_ways(n, x);
            if w > 0 {
                nonzero += 1;
            }
            check = (check * 31 + w) % 1000000007;
        }
    }
    println(f"1500 pairs: {nonzero} with a way, checksum {check}");
}
