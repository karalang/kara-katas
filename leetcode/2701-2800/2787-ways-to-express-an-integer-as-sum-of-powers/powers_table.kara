// LeetCode #2787: Ways to Express an Integer as Sum of Powers -- the
// whole table: `ways[k][s]` counts the sets of the first k powers summing
// to s, each row the one above with or without the k-th power. O(n *
// n^(1/x)) time and space.

fn number_of_ways(n: i64, x: i64) -> i64 {
    let modulus = 1000000007;
    let powers: Vec[i64] = (1..=n).map(|i| i.pow(x as u32)).take_while(|p| p <= n).collect();
    let mut ways: Vec[Vec[i64]] = Vec.filled(powers.len() + 1, Vec.filled(n + 1, 0));
    ways[0][0] = 1;
    for k in 1..=powers.len() {
        let p = powers[k - 1];
        for s in 0..=n {
            ways[k][s] = ways[k - 1][s];
            if s >= p {
                ways[k][s] = (ways[k][s] + ways[k - 1][s - p]) % modulus;
            }
        }
    }
    ways[powers.len()][n]
}

// ---- the harness: the same in every arm --------------------------------

fn main() {
    // LeetCode's two examples; 300 as distinct numbers, LeetCode's most,
    // and as distinct squares, cubes, 4th and 5th powers
    println(f"{number_of_ways(10, 2)}");
    println(f"{number_of_ways(4, 1)}");
    for x in 1..=5 {
        println(f"{number_of_ways(300, x)}");
    }
    // every n from 1 to 300 with every x from 1 to 5
    let mut nonzero = 0;
    let mut check = 0;
    for n in 1..=300 {
        for x in 1..=5 {
            let w = number_of_ways(n, x);
            if w > 0 {
                nonzero += 1;
            }
            check = (check * 31 + w) % 1000000007;
        }
    }
    println(f"1500 pairs: {nonzero} with a way, checksum {check}");
}
