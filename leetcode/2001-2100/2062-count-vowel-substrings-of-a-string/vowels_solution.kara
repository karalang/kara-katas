// LeetCode #2062: Count Vowel Substrings of a String -- LeetCode's Rust
// template (`use std::collections::HashMap`, a closure over
// `"aeiou".contains(c)`, `for (r, &c) in s.iter().enumerate()`, a
// `HashMap<char, i32>` shrunk with `get_mut` and `remove`, `usize` ends
// and an `i32` answer), carried by `karac fix`. The adapter below hands
// the harness's words to it.


struct Solution {}

impl Solution {
    pub fn count_vowel_substrings(word: String) -> i32 {
        let s: Vec[char] = word.chars().collect();
        let is_vowel = |c: char| "aeiou".contains(c.to_string());
        let mut ans: i32 = 0;
        let mut start = 0;
        let mut left = 0;
        let mut cnt: Map[char, i32] = Map.new();
        for (r, c) in s.iter().enumerate() {
            if not is_vowel(c) {
                cnt.clear();
                start = r + 1;
                left = r + 1;
                continue;
            }
            *cnt.entry(c).or_insert(0) += 1;
            while cnt.len() == 5 {
                let lc = s[left];
                let e = cnt.get_mut(lc).unwrap();
                *e -= 1;
                if *e == 0 {
                    cnt.remove(lc);
                }
                left += 1;
            }
            ans += (left - start) as i32;
        }
        ans
    }
}

fn count_vowel_substrings(word: String) -> i64 {
    Solution.count_vowel_substrings(word)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters, each a vowel with chance `p` in 100, else one of `xyz`
fn word_of(n: i64, p: i64, seed: mut ref i64) -> String {
    let vowels: Vec[char] = "aeiou".chars().collect();
    let others: Vec[char] = "xyz".chars().collect();
    let mut out = String.new();
    for _ in 0..n {
        if next_random(mut seed) % 100 < p {
            out.push(vowels[next_random(mut seed) % 5]);
        } else {
            out.push(others[next_random(mut seed) % 3]);
        }
    }
    out
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = ["aeiouu", "unicornarihan", "cuaieuouac", "bbaeixoubb", "a", "aeiou",
        "uoiea", "aaeeiioouu", "xaeioux", "aeioaeiouaeiou"];
    for w in examples.iter() {
        println(f"{w} -> {count_vowel_substrings(w.to_string())}");
    }
    // 500 words of 1 to 100 letters, vowels with chance 50 to 100 in 100
    let mut seed = 2062;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..500 {
        let n = next_random(mut seed) % 100 + 1;
        let p = next_random(mut seed) % 51 + 50;
        let a = count_vowel_substrings(word_of(n, p, mut seed));
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"500 words: sum {total}, checksum {check}");
    // a word of 100 vowels, then `aeiou` twenty times
    println(f"100 vowels -> {count_vowel_substrings(word_of(100, 100, mut seed))}");
    println(f"aeiou x 20 -> {count_vowel_substrings("aeiou".repeat(20))}");
}
