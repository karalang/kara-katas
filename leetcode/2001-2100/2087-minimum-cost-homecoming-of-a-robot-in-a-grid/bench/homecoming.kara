// LeetCode #2087: Minimum Cost Homecoming of a Robot in a Grid -- the ★
// arm as a benchmark. One grid of 10^6 rows and 10^6 columns, each cost
// up to 10^4, and 2000 trips home between random places on it, each the
// two ranges of costs summed: about 1.3 · 10^9 costs added.

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn walk(costs: Vec[i64], from: i64, to: i64) -> i64 {
    if from < to {
        costs[from + 1..=to].iter().sum()
    } else {
        costs[to..from].iter().sum()
    }
}

fn min_cost(start_pos: Vec[i64], home_pos: Vec[i64], row_costs: Vec[i64], col_costs: Vec[i64]) -> i64 {
    walk(row_costs, start_pos[0], home_pos[0]) + walk(col_costs, start_pos[1], home_pos[1])
}

// A place on the grid, from two draws.
fn place(seed: mut ref i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000
}

fn main() {
    let mut seed = 2087;
    let rows: Vec[i64] = (0..1000000).map(|_| next_random(mut seed) % 10001).collect();
    let cols: Vec[i64] = (0..1000000).map(|_| next_random(mut seed) % 10001).collect();
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let start = [place(mut seed), place(mut seed)].to_vec();
        let home = [place(mut seed), place(mut seed)].to_vec();
        let a = min_cost(start, home, rows, cols);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"2000 trips: sum {total}, checksum {check}");
}
