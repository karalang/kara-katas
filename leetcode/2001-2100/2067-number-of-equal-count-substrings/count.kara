// LeetCode #2067: Number of Equal Count Substrings -- the ★ arm. A
// substring holding `k` different letters, each `count` times, is exactly
// `k * count` long, so for each `k` from 1 to 26 a window of that length
// slides over the text: the counts of its letters, and how many of them
// are at exactly `count`. The window is an equal count substring when all
// `k` of its letters are. O(26 n).

fn equal_count_substrings(s: String, count: i64) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut total = 0;
    for k in 1..=26 {
        let len = k * count;
        if len > n {
            break;
        }
        let mut seen: Array[i64, 26] = [0; 26];
        let mut exact = 0;
        for i in 0..n {
            let c = (bytes[i] - b'a') as i64;
            seen[c] += 1;
            if seen[c] == count {
                exact += 1;
            } else if seen[c] == count + 1 {
                exact -= 1;
            }
            if i >= len {
                let d = (bytes[i - len] - b'a') as i64;
                if seen[d] == count {
                    exact -= 1;
                }
                seen[d] -= 1;
                if seen[d] == count {
                    exact += 1;
                }
            }
            if i + 1 >= len and exact == k {
                total += 1;
            }
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters from the first `k` of the alphabet, each run of one letter
// `count` long with chance `p` in 100, else a single letter
fn text_of(n: i64, k: i64, count: i64, p: i64, seed: mut ref i64) -> String {
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut out = String.new();
    let mut len = 0;
    while len < n {
        let c = letters[next_random(mut seed) % k];
        let run = if next_random(mut seed) % 100 < p { count } else { 1 };
        for _ in 0..run.min(n - len) {
            out.push(c);
        }
        len += run.min(n - len);
    }
    out
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = [("aaabcbbcc", 3), ("abcd", 2), ("a", 5), ("a", 1), ("abcabc", 2), ("aabbccab", 2), ("zzzz", 2), ("abab", 1)];
    for (s, count) in examples.iter() {
        println(f"{s} {count} -> {equal_count_substrings(s.to_string(), count)}");
    }
    // 500 texts of 1 to 300 letters from 1 to 26 letters, count 1 to 10,
    // runs of `count` with chance 0 to 100 in 100
    let mut seed = 2067;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..500 {
        let n = next_random(mut seed) % 300 + 1;
        let k = next_random(mut seed) % 26 + 1;
        let count = next_random(mut seed) % 10 + 1;
        let p = next_random(mut seed) % 101;
        let a = equal_count_substrings(text_of(n, k, count, p, mut seed), count);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"500 texts: sum {total}, checksum {check}");
    // the largest the constraints allow: 30000 letters from 4, count 5,
    // and from 26 in runs of 3, count 3
    println(f"30000 letters, 4 kinds, 5 -> {equal_count_substrings(text_of(30000, 4, 5, 50, mut seed), 5)}");
    println(f"30000 letters, 26 kinds, 3 -> {equal_count_substrings(text_of(30000, 26, 3, 100, mut seed), 3)}");
}
