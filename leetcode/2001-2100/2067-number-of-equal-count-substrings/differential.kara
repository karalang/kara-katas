// LeetCode #2067: Number of Equal Count Substrings -- the differential.
// The six arms, against the statement read literally: every substring
// taken out whole, its letters counted afresh, and kept when every letter
// in it is there exactly `count` times. 300 random texts of 1 to 40
// letters from 1 to 6 kinds, count 1 to 4, drawn as the harness draws
// them; then 20 with count 1 from all 26 letters, 20 of 41 to 120
// letters, and 20 holding the whole alphabet shuffled, each letter 1 or 2
// times, between up to 5 random letters on either side; every one drawn
// before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the text reversed has the same answer
// P3  the letters renamed in a cycle (`a` to `b`, ..., `z` to `a`) leave
//     the answer
// P4  every letter written twice and `count` doubled never lowers the
//     answer
// P5  the answer is at most the substrings whose length `count` divides,
//     and with `count` 1 at least the letters
// P6  each arm agrees with at least three of the other five

// ---- count.kara: the ★ arm, a window of `k * count` letters for each `k`
fn star_equal_count_substrings(s: String, count: i64) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut total = 0;
    for k in 1..=26 {
        let len = k * count;
        if len > n {
            break;
        }
        let mut seen: Array[i64, 26] = [0; 26];
        let mut exact = 0;
        for i in 0..n {
            let c = (bytes[i] - b'a') as i64;
            seen[c] += 1;
            if seen[c] == count {
                exact += 1;
            } else if seen[c] == count + 1 {
                exact -= 1;
            }
            if i >= len {
                let d = (bytes[i - len] - b'a') as i64;
                if seen[d] == count {
                    exact -= 1;
                }
                seen[d] -= 1;
                if seen[d] == count {
                    exact += 1;
                }
            }
            if i + 1 >= len and exact == k {
                total += 1;
            }
        }
    }
    total
}

// ---- count_extend.kara: from every start, grown until a letter passes `count`
fn extend_equal_count_substrings(s: String, count: i64) -> i64 {
    let letters: Vec[char] = s.chars().collect();
    let n = letters.len();
    let mut total = 0;
    for i in 0..n {
        let mut seen = Vec.filled(26, 0);
        let mut different = 0;
        for j in i..n {
            let c = letters[j] as i64 - 'a' as i64;
            seen[c] += 1;
            if seen[c] > count {
                break;
            }
            if seen[c] == 1 {
                different += 1;
            }
            if different * count == j - i + 1 {
                total += 1;
            }
        }
    }
    total
}

// ---- count_prefix.kara: prefix counts, each window checked with `all`
fn prefix_equal_count_substrings(s: String, count: i64) -> i64 {
    let mut before: Vec[Array[i64, 26]] = [[0; 26]].to_vec();
    for b in s.bytes().iter() {
        let mut next = before[before.len() - 1];
        next[(b - b'a') as i64] += 1;
        before.push(next);
    }
    let n = s.len();
    let mut total = 0;
    for j in 1..=n {
        for k in 1..=26 {
            let len = k * count;
            if len > j {
                break;
            }
            let (hi, lo) = (before[j], before[j - len]);
            if (0..26).all(|c| hi[c] - lo[c] == 0 or hi[c] - lo[c] == count) {
                total += 1;
            }
        }
    }
    total
}

// ---- count_map.kara: the windows' letters in a `Map[char, i64]`
fn map_equal_count_substrings(s: String, count: i64) -> i64 {
    let letters: Vec[char] = s.chars().collect();
    let n = letters.len();
    let mut total = 0;
    for k in 1..=26 {
        let len = k * count;
        if len > n {
            break;
        }
        let mut seen: Map[char, i64] = Map.new();
        for (i, c) in letters.iter().enumerate() {
            seen[c] = seen.get(c).unwrap_or(0) + 1;
            if i >= len {
                let gone = letters[i - len];
                seen[gone] -= 1;
                if seen[gone] == 0 {
                    seen.remove(gone);
                }
            }
            if seen.len() == k and seen.values().all(|v| v == count) {
                total += 1;
            }
        }
    }
    total
}

// ---- count_struct.kara: the window as a `struct Window` with methods
struct Window {
    seen: Vec[i64],
    exact: i64,
    count: i64,
}

impl Window {
    fn new(count: i64) -> Window {
        Window { seen: Vec.filled(26, 0), exact: 0, count: count }
    }

    fn take(mut ref self, c: i64) {
        self.seen[c] += 1;
        if self.seen[c] == self.count {
            self.exact += 1;
        } else if self.seen[c] == self.count + 1 {
            self.exact -= 1;
        }
    }

    fn let_go(mut ref self, c: i64) {
        if self.seen[c] == self.count {
            self.exact -= 1;
        }
        self.seen[c] -= 1;
        if self.seen[c] == self.count {
            self.exact += 1;
        }
    }
}

fn struct_equal_count_substrings(s: String, count: i64) -> i64 {
    let codes: Vec[i64] = s.bytes().iter().map(|b| (b - b'a') as i64).collect();
    let kinds: SortedSet[i64] = codes.iter().collect();
    let mut total = 0;
    for k in 1..=kinds.len() {
        let len = k * count;
        if len > codes.len() {
            break;
        }
        let mut window = Window.new(count);
        for i in 0..codes.len() {
            window.take(codes[i]);
            if i >= len {
                window.let_go(codes[i - len]);
            }
            if i + 1 >= len and window.exact == k {
                total += 1;
            }
        }
    }
    total
}

// ---- count_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn equal_count_substrings(s: String, count: i32) -> i32 {
        let s = s.bytes();
        let n = s.len();
        let count = count as i64;
        let mut ans = 0;
        for k in 1..=26 {
            let len = k * count;
            if len > n {
                break;
            }
            let mut cnt = [0; 26];
            let mut good = 0;
            for i in 0..n {
                let c = (s[i] - b'a') as i64;
                cnt[c] += 1;
                if cnt[c] == count {
                    good += 1;
                } else if cnt[c] == count + 1 {
                    good -= 1;
                }
                if i >= len {
                    let d = (s[i - len] - b'a') as i64;
                    if cnt[d] == count {
                        good -= 1;
                    }
                    cnt[d] -= 1;
                    if cnt[d] == count {
                        good += 1;
                    }
                }
                if good == k {
                    ans += 1;
                }
            }
        }
        ans
    }
}

struct Solution {}

fn solution_equal_count_substrings(s: String, count: i64) -> i64 {
    Solution.equal_count_substrings(s, count as i32) as i64
}

// ---- the statement read literally

fn literal(s: String, count: i64) -> i64 {
    let letters: Vec[char] = s.chars().collect();
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut total = 0;
    for i in 0..letters.len() {
        for j in i + 1..=letters.len() {
            let piece: Vec[char] = letters[i..j].to_vec();
            let mut equal = true;
            for a in alphabet.iter() {
                let times = piece.iter().filter(|c| c == a).count();
                if times != 0 and times != count {
                    equal = false;
                }
            }
            if equal {
                total += 1;
            }
        }
    }
    total
}

fn answer(arm: i64, s: String, count: i64) -> i64 {
    match arm {
        0 => star_equal_count_substrings(s.clone(), count),
        1 => extend_equal_count_substrings(s.clone(), count),
        2 => prefix_equal_count_substrings(s.clone(), count),
        3 => map_equal_count_substrings(s.clone(), count),
        4 => struct_equal_count_substrings(s.clone(), count),
        _ => solution_equal_count_substrings(s.clone(), count),
    }
}

// ---- texts

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn text_of(n: i64, k: i64, count: i64, p: i64, seed: mut ref i64) -> String {
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut out = String.new();
    let mut len = 0;
    while len < n {
        let c = letters[next_random(mut seed) % k];
        let run = if next_random(mut seed) % 100 < p { count } else { 1 };
        for _ in 0..run.min(n - len) {
            out.push(c);
        }
        len += run.min(n - len);
    }
    out
}

// the alphabet shuffled, each letter `count` times, between up to five
// random letters on either side
fn alphabet_of(count: i64, seed: mut ref i64) -> String {
    let mut letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    for i in (1..26).rev() {
        let j = next_random(mut seed) % (i + 1);
        letters.swap(i, j);
    }
    let mut out = text_of(next_random(mut seed) % 6, 26, 1, 0, mut seed);
    for c in letters.iter() {
        for _ in 0..count {
            out.push(c);
        }
    }
    out.push_str(text_of(next_random(mut seed) % 6, 26, 1, 0, mut seed));
    out
}

fn main() {
    let names = ["star", "extend", "prefix", "map", "struct", "solution"];
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut seed = 2067;
    let mut texts: Vec[(String, i64)] = Vec.new();
    for t in 0..340 {
        let n = if t < 320 { next_random(mut seed) % 40 + 1 } else { next_random(mut seed) % 80 + 41 };
        let k = if t >= 300 and t < 320 { 26 } else { next_random(mut seed) % 6 + 1 };
        let count = if t >= 300 and t < 320 { 1 } else { next_random(mut seed) % 4 + 1 };
        let p = next_random(mut seed) % 101;
        texts.push((text_of(n, k, count, p, mut seed), count));
    }
    for _ in 0..20 {
        let count = next_random(mut seed) % 2 + 1;
        texts.push((alphabet_of(count, mut seed), count));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (s, count) in texts.iter() {
        let truth = literal(s.clone(), count);
        check = (check * 31 + truth) % 1000000007;
        let n = s.len();
        let back: String = s.chars().rev().collect();
        let renamed: String = s.chars().map(|c| alphabet[(c as i64 - 'a' as i64 + 1) % 26]).collect();
        let mut twice = String.new();
        for c in s.chars() {
            twice.push(c);
            twice.push(c);
        }
        let mut most = 0;
        for len in 1..=n {
            if len % count == 0 {
                most += n - len + 1;
            }
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, s.clone(), count)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, back.clone(), count) == x,
                answer(arm, renamed.clone(), count) == x,
                answer(arm, twice.clone(), 2 * count) >= x,
                x <= most and (count != 1 or x >= n),
                same >= 3,
            ];
            for p in 0..6 {
                checks += 1;
                if not verdicts[p] {
                    by_property[p] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{s} {count} arm {names[arm]}: P{p + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{texts.len()} texts: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for p in 0..6 {
            if by_property[p] > 0 {
                println(f"P{p + 1} {by_property[p]}");
            }
        }
    }
}
