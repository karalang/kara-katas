// LeetCode #2067: Number of Equal Count Substrings -- the ★ arm's
// benchmark: 60 texts of 30000 letters from 1 to 26 kinds, half in runs of
// `count`, count 1 to 7.

fn equal_count_substrings(s: String, count: i64) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut total = 0;
    for k in 1..=26 {
        let len = k * count;
        if len > n {
            break;
        }
        let mut seen: Array[i64, 26] = [0; 26];
        let mut exact = 0;
        for i in 0..n {
            let c = (bytes[i] - b'a') as i64;
            seen[c] += 1;
            if seen[c] == count {
                exact += 1;
            } else if seen[c] == count + 1 {
                exact -= 1;
            }
            if i >= len {
                let d = (bytes[i - len] - b'a') as i64;
                if seen[d] == count {
                    exact -= 1;
                }
                seen[d] -= 1;
                if seen[d] == count {
                    exact += 1;
                }
            }
            if i + 1 >= len and exact == k {
                total += 1;
            }
        }
    }
    total
}

// ---- bench ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn text_of(n: i64, k: i64, count: i64, p: i64, seed: mut ref i64) -> String {
    let letters: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut out = String.new();
    let mut len = 0;
    while len < n {
        let c = letters[next_random(mut seed) % k];
        let run = if next_random(mut seed) % 100 < p { count } else { 1 };
        for _ in 0..run.min(n - len) {
            out.push(c);
        }
        len += run.min(n - len);
    }
    out
}

fn main() {
    let mut seed = 2067;
    let mut total = 0;
    let mut check = 0;
    for t in 0..60 {
        let count = t % 7 + 1;
        let a = equal_count_substrings(text_of(30000, t % 26 + 1, count, 50, mut seed), count);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"60 texts: sum {total}, checksum {check}");
}
