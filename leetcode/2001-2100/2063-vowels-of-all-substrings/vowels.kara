// LeetCode #2063: Vowels of All Substrings -- the ★ arm. A substring
// holding place `i` of `n` letters starts at one of the `i + 1` places up
// to `i` and ends at one of the `n - i` from it, so a vowel there is
// counted `(i + 1) · (n - i)` times; the answer is the sum over the
// vowels. O(n), and at most about `n³ / 6`, which fits `i64` for `n` up
// to 100000.

fn count_vowels(word: String) -> i64 {
    let n = word.len();
    let mut total = 0;
    for (i, c) in word.chars().enumerate() {
        if "aeiou".contains(c.to_string()) {
            total += (i + 1) * (n - i);
        }
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters, each a vowel with chance `p` in 100, else one of `bcdxyz`
fn word_of(n: i64, p: i64, seed: mut ref i64) -> String {
    let vowels: Vec[char] = "aeiou".chars().collect();
    let others: Vec[char] = "bcdxyz".chars().collect();
    let mut out = String.new();
    for _ in 0..n {
        if next_random(mut seed) % 100 < p {
            out.push(vowels[next_random(mut seed) % 5]);
        } else {
            out.push(others[next_random(mut seed) % 6]);
        }
    }
    out
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples = ["aba", "abc", "ltcd", "a", "b", "aeiou", "zzzzz", "noosabasboosa"];
    for w in examples.iter() {
        println(f"{w} -> {count_vowels(w.to_string())}");
    }
    // 500 words of 1 to 300 letters, vowels with chance 0 to 100 in 100
    let mut seed = 2063;
    let mut check = 0;
    for _ in 0..500 {
        let n = next_random(mut seed) % 300 + 1;
        let p = next_random(mut seed) % 101;
        check = (check * 31 + count_vowels(word_of(n, p, mut seed))) % 1000000007;
    }
    println(f"500 words: checksum {check}");
    // the largest the constraints allow: 100000 letters, all vowels, then
    // vowels with chance 40 in 100
    println(f"100000 vowels -> {count_vowels(word_of(100000, 100, mut seed))}");
    println(f"100000 letters -> {count_vowels(word_of(100000, 40, mut seed))}");
}
