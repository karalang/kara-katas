// LeetCode #2080: Range Frequency Queries -- the ★ arm's benchmark
// (frequency.kara): 10 arrays of 10^5 values up to 100, 1000 or 10^4,
// each built into the ★ arm's index once and then asked 1000000 queries,
// half for a value in the array: 10^7 queries in all.

struct RangeFreqQuery {
    places: Map[i64, Vec[i64]],
}

impl RangeFreqQuery {
    fn new(arr: Vec[i64]) -> RangeFreqQuery {
        let mut places: Map[i64, Vec[i64]] = Map.new();
        for (i, v) in arr.iter().enumerate() {
            places.entry(v).or_insert(Vec.new()).push(i);
        }
        RangeFreqQuery { places }
    }

    fn query(self, left: i64, right: i64, value: i64) -> i64 {
        match self.places.get(value) {
            Some(at) => at.partition_point(|p| p <= right) - at.partition_point(|p| p < left),
            None => 0,
        }
    }
}

// ---- benchmark -------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2080;
    let n = 100000;
    let mut total = 0;
    let mut check = 0;
    for t in 0..10 {
        let top = [100, 1000, 10000][t % 3];
        let arr: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let index = RangeFreqQuery.new(arr);
        for _ in 0..1000000 {
            let a = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
            let b = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
            let value = if next_random(mut seed) % 2 == 0 { arr[(next_random(mut seed) * 32768 + next_random(mut seed)) % n] } else { next_random(mut seed) % (top + 1) + 1 };
            let c = index.query(a.min(b), a.max(b), value);
            total += c;
            check = (check * 31 + c) % 1000000007;
        }
    }
    println(f"10000000 queries: sum {total}, checksum {check}");
}
