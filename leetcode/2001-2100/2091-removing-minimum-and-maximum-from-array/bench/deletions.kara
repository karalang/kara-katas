// LeetCode #2091: Removing Minimum and Maximum From Array -- the ★ arm as
// a benchmark. 20 arrays of 100000 distinct values, the constraints'
// limit, shuffled, each answered 20 times by one walk for the places of
// the least and the greatest: 400 walks of 10^5 values.

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn minimum_deletions(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut (lo, hi) = (0, 0);
    for k in 1..n {
        if nums[k] < nums[lo] {
            lo = k;
        }
        if nums[k] > nums[hi] {
            hi = k;
        }
    }
    let (i, j) = (lo.min(hi), lo.max(hi));
    (j + 1).min(n - i).min(i + 1 + n - j)
}

fn main() {
    let mut seed = 2091;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..20 {
        let mut v: Vec[i64] = (0..100000).map(|i| 2 * i - 100000).collect();
        for i in (1..100000).rev() {
            let j = next_random(mut seed) % (i + 1);
            v.swap(i, j);
        }
        arrays.push(v);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..20 {
        for t in 0..20 {
            let d = minimum_deletions(arrays[(t + round) % 20]);
            total += d;
            check = (check * 31 + d) % 1000000007;
        }
    }
    println(f"400 answers: sum {total}, checksum {check}");
}
