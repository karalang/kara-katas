// LeetCode #2089: Find Target Indices After Sorting Array -- the
// differential. The six arms, against the statement read literally: the
// array sorted by insertion, and every index whose value is the target.
// 300 random arrays of 1 to 12 values from 1 to 3, 5 or 10, the target
// from 1 to one past the largest; then 20 without the target, and 20 of
// nothing but the target; every one drawn before any arm answers.
//
// P1  the indices are the statement read literally
// P2  the array reversed gives the same indices
// P3  every value and the target doubled give the same indices
// P4  the indices run on one by one from the count of smaller values, as
//     many as the target's copies
// P5  one more copy of the target gives one more index after the last
// P6  each arm agrees with at least three of the other five

// ---- target.kara: the ★ arm, the smaller values and the copies counted
fn star_target_indices(nums: Vec[i64], target: i64) -> Vec[i64] {
    let less = nums.iter().filter(|x| x < target).count();
    let equal = nums.iter().filter(|x| x == target).count();
    (less..less + equal).collect()
}

// ---- target_sorted.kara: a sorted copy, the target's places by `filter`
fn sorted_target_indices(nums: Vec[i64], target: i64) -> Vec[i64] {
    let mut sorted = nums.clone();
    sorted.sort();
    sorted.iter().enumerate().filter(|(_, x)| x == target).map(|(i, _)| i).collect()
}

// ---- target_search.kara: a sorted copy searched twice with `partition_point`
fn search_target_indices(nums: Vec[i64], target: i64) -> Vec[i64] {
    let mut sorted = nums.clone();
    sorted.sort();
    let first = sorted.partition_point(|x| x < target);
    let after = sorted.partition_point(|x| x <= target);
    (first..after).collect()
}

// ---- target_counting.kara: counting sort over the values up to 100
fn counting_target_indices(nums: Vec[i64], target: i64) -> Vec[i64] {
    let mut counts: Vec[i64] = Vec.filled(101, 0);
    for x in nums.iter() {
        counts[x] += 1;
    }
    let first: i64 = counts[..target].iter().sum();
    (first..first + counts[target]).collect()
}

// ---- target_position.kara: a sorted copy, `position` and `rposition`
fn position_target_indices(nums: Vec[i64], target: i64) -> Vec[i64] {
    let mut sorted = nums.clone();
    sorted.sort();
    match (sorted.iter().position(|x| x == target), sorted.iter().rposition(|x| x == target)) {
        (Some(first), Some(last)) => (first..=last).collect(),
        _ => Vec.new(),
    }
}

// ---- target_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn target_indices(nums: own Vec[i32], target: i32) -> Vec[i32] {
        let mut nums = nums;
        nums.sort();
        nums.iter()
            .enumerate()
            .filter(|(_, x)| x == target)
            .map(|(i, _)| i as i32)
            .collect()
    }
}

struct Solution {}

fn solution_target_indices(nums: Vec[i64], target: i64) -> Vec[i64] {
    let v: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.target_indices(v, target as i32).iter().map(|i| i as i64).collect()
}

// ---- the statement read literally

fn literal(nums: Vec[i64], target: i64) -> Vec[i64] {
    let mut sorted: Vec[i64] = Vec.new();
    for x in nums.iter() {
        let mut at = sorted.len();
        while at > 0 and sorted[at - 1] > x {
            at -= 1;
        }
        sorted.insert(at, x);
    }
    let mut out: Vec[i64] = Vec.new();
    for i in 0..sorted.len() {
        if sorted[i] == target {
            out.push(i);
        }
    }
    out
}

fn answer(arm: i64, nums: Vec[i64], target: i64) -> Vec[i64] {
    match arm {
        0 => star_target_indices(nums, target),
        1 => sorted_target_indices(nums, target),
        2 => search_target_indices(nums, target),
        3 => counting_target_indices(nums, target),
        4 => position_target_indices(nums, target),
        _ => solution_target_indices(nums, target),
    }
}

// ---- arrays

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    let names = ["star", "sorted", "search", "counting", "position", "solution"];
    let mut seed = 2089;
    let mut problems: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..340 {
        let n = next_random(mut seed) % 12 + 1;
        let top = [3, 5, 10][next_random(mut seed) % 3];
        let mut nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let target = next_random(mut seed) % (top + 1) + 1;
        if t >= 300 and t < 320 {
            nums = nums.iter().filter(|x| x != target).cloned().collect();
            nums.push(target + 1);
        } else if t >= 320 {
            nums = Vec.filled(n, target);
        }
        problems.push((nums, target));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (nums, target) in problems.iter() {
        let truth = literal(nums, target);
        for i in truth.iter() {
            check = (check * 31 + i + 1) % 1000000007;
        }
        check = (check * 31 + 1000) % 1000000007;
        let reversed: Vec[i64] = nums.iter().rev().cloned().collect();
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let less = nums.iter().filter(|x| x < target).count();
        let copies = nums.iter().filter(|x| x == target).count();
        let mut more = nums.clone();
        more.push(target);
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, nums, target)).collect();
        for arm in 0..6 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let runs = x.len() == copies and (0..x.len()).all(|k| x[k] == less + k);
            let grown = answer(arm, more, target);
            let mut expected = x.clone();
            expected.push(less + copies);
            let verdicts = [
                x == truth,
                answer(arm, reversed, target) == x,
                answer(arm, doubled, 2 * target) == x,
                runs,
                grown == expected,
                same >= 3,
            ];
            for p in 0..6 {
                checks += 1;
                if not verdicts[p] {
                    by_property[p] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{show(nums)} {target} arm {names[arm]}: P{p + 1} fails, answer {show(x)}, literal {show(truth)}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} arrays: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for p in 0..6 {
            if by_property[p] > 0 {
                println(f"P{p + 1} {by_property[p]}");
            }
        }
    }
}
