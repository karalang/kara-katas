// LeetCode #2089: Find Target Indices After Sorting Array -- the ★ arm.
// No sort: once sorted, the target's copies sit after every smaller value
// and run as long as there are copies, so the indices are `less..less +
// equal`, two counts with `filter(..).count()`. O(n).

fn target_indices(nums: Vec[i64], target: i64) -> Vec[i64] {
    let less = nums.iter().filter(|x| x < target).count();
    let equal = nums.iter().filter(|x| x == target).count();
    (less..less + equal).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    // LeetCode's three examples, then four more
    let examples = [
        ([1, 2, 5, 2, 3].to_vec(), 2),
        ([1, 2, 5, 2, 3].to_vec(), 3),
        ([1, 2, 5, 2, 3].to_vec(), 5),
        ([1, 2, 5, 2, 3].to_vec(), 4),
        ([7].to_vec(), 7),
        ([9, 9, 9, 9].to_vec(), 9),
        ([100, 1, 50, 1, 100, 50].to_vec(), 50),
    ];
    for (nums, target) in examples.iter() {
        println(f"{show(nums)} {target} -> {show(target_indices(nums, target))}");
    }
    // 2000 random arrays of 1 to 100 values from 1 to 3, 10 or 100
    let mut seed = 2089;
    let mut found = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 100 + 1;
        let top = [3, 10, 100][next_random(mut seed) % 3];
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % top + 1).collect();
        let target = next_random(mut seed) % top + 1;
        let got = target_indices(nums, target);
        found += got.len();
        for i in got.iter() {
            check = (check * 31 + i + 1) % 1000000007;
        }
        check = (check * 31 + 1000) % 1000000007;
    }
    println(f"2000 arrays: {found} indices, checksum {check}");
    // the constraints' largest, 100 values, all of them the target, and
    // none
    let all: Vec[i64] = Vec.filled(100, 100);
    println(f"100 of 100: {target_indices(all, 100).len()} indices");
    let some: Vec[i64] = (0..100).map(|i| i % 50 + 1).collect();
    println(f"1 to 50 twice, 50: {show(target_indices(some, 50))}, 51: {show(target_indices(some, 51))}");
}
