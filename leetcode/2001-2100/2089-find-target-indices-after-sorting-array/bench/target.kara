// LeetCode #2089: Find Target Indices After Sorting Array -- the ★ arm as
// a benchmark. 10000 arrays of 100 values from 1 to 100, the constraints'
// limit, each asked for every target from 1 to 100: 10^6 answers, each
// two counts over the array and the indices collected into a fresh `Vec`.

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn target_indices(nums: Vec[i64], target: i64) -> Vec[i64] {
    let less = nums.iter().filter(|x| x < target).count();
    let equal = nums.iter().filter(|x| x == target).count();
    (less..less + equal).collect()
}

fn main() {
    let mut seed = 2089;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10000 {
        let nums: Vec[i64] = (0..100).map(|_| next_random(mut seed) % 100 + 1).collect();
        arrays.push(nums);
    }
    let mut total = 0;
    let mut check = 0;
    for nums in arrays.iter() {
        for target in 1..=100 {
            let got = target_indices(nums, target);
            for i in got.iter() {
                total += i * target;
            }
            check = (check * 31 + got.len() * 100 + got.first().unwrap_or(0)) % 1000000007;
        }
    }
    println(f"1000000 answers: sum {total}, checksum {check}");
}
