// LeetCode #2100: Find Good Days to Rob the Bank -- the ★ arm's benchmark:
// 100 schedules of 10^5 days, the constraints' largest, each a walk that
// moves by -1, 0 or +1 guards a day between 0 and 10^5, each asked for a
// random time of 0 to 7 and answered by counting the run before each day
// left to right and the run after it right to left. Every good day of
// every answer goes into the checksum.

fn good_days_to_rob_bank(security: Vec[i64], time: i64) -> Vec[i64] {
    let n = security.len();
    let mut before = Vec.filled(n, 0);
    let mut after = Vec.filled(n, 0);
    for i in 1..n {
        if security[i] <= security[i - 1] {
            before[i] = before[i - 1] + 1;
        }
    }
    for i in (0..n - 1).rev() {
        if security[i] <= security[i + 1] {
            after[i] = after[i + 1] + 1;
        }
    }
    (0..n).filter(|i| before[i] >= time and after[i] >= time).collect()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2100;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..100 {
        let mut guards = 50000;
        let mut security: Vec[i64] = Vec.new();
        for _ in 0..100000 {
            guards = (guards + next_random(mut seed) % 3 - 1).clamp(0, 100000);
            security.push(guards);
        }
        let time = next_random(mut seed) % 8;
        let good = good_days_to_rob_bank(security, time);
        total += good.len();
        for d in good.iter() {
            check = (check * 31 + d + 1) % 1000000007;
        }
    }
    println(f"100 answers: {total} good days, checksum {check}");
}
