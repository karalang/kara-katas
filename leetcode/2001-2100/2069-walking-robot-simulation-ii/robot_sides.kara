// LeetCode #2069: Walking Robot Simulation II -- a side at a time: an
// `enum Facing` whose `turned` gives the next way round and whose `room`
// says how many cells lie ahead before the edge, and a step that goes as
// far along the side as it can, turns, and goes on. Each step is cut to
// the loop's length first, a whole loop kept for a remainder of 0.

enum Facing {
    East,
    North,
    West,
    South,
}

impl Facing {
    fn turned(self) -> Facing {
        match self {
            Facing.East => Facing.North,
            Facing.North => Facing.West,
            Facing.West => Facing.South,
            Facing.South => Facing.East,
        }
    }

    fn name(self) -> String {
        match self {
            Facing.East => "East".to_string(),
            Facing.North => "North".to_string(),
            Facing.West => "West".to_string(),
            Facing.South => "South".to_string(),
        }
    }
}

struct Robot {
    width: i64,
    height: i64,
    x: i64,
    y: i64,
    facing: Facing,
}

impl Robot {
    fn new(width: i64, height: i64) -> Robot {
        Robot { width: width, height: height, x: 0, y: 0, facing: Facing.East }
    }

    // the cells ahead before the edge
    fn room(self) -> i64 {
        match self.facing {
            Facing.East => self.width - 1 - self.x,
            Facing.North => self.height - 1 - self.y,
            Facing.West => self.x,
            Facing.South => self.y,
        }
    }

    fn step(mut ref self, num: i64) {
        let around = 2 * (self.width + self.height) - 4;
        let mut left = (num - 1) % around + 1;
        while left > 0 {
            let room = self.room();
            if room == 0 {
                self.facing = self.facing.turned();
                continue;
            }
            let go = room.min(left);
            match self.facing {
                Facing.East => self.x += go,
                Facing.North => self.y += go,
                Facing.West => self.x -= go,
                Facing.South => self.y -= go,
            }
            left -= go;
        }
    }

    fn get_pos(self) -> Vec[i64] {
        [self.x, self.y].to_vec()
    }

    fn get_dir(self) -> String {
        self.facing.name()
    }
}

// the calls in LeetCode's form: 0 a step of `num`, 1 `getPos`, 2 `getDir`
fn answers(width: i64, height: i64, calls: Vec[(i64, i64)]) -> Vec[String] {
    let mut robot = Robot.new(width, height);
    let mut out: Vec[String] = Vec.new();
    for (call, num) in calls.iter() {
        match call {
            0 => {
                robot.step(num);
                out.push("null".to_string());
            }
            1 => {
                let p = robot.get_pos();
                out.push(f"[{p[0]}, {p[1]}]");
            }
            _ => out.push(robot.get_dir()),
        }
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` calls: a step of 1 to `most` cells with chance 1 in 2, else
// `getPos` or `getDir`
fn calls_of(count: i64, most: i64, seed: mut ref i64) -> Vec[(i64, i64)] {
    let mut calls: Vec[(i64, i64)] = Vec.new();
    for _ in 0..count {
        let kind = next_random(mut seed) % 4;
        if kind < 2 {
            calls.push((0, (next_random(mut seed) * 32768 + next_random(mut seed)) % most + 1));
        } else {
            calls.push((kind - 1, 0));
        }
    }
    calls
}

fn checksum(answers: Vec[String]) -> i64 {
    let mut check = 0;
    for a in answers.iter() {
        for b in a.bytes().iter() {
            check = (check * 131 + b as i64) % 1000000007;
        }
        check = (check * 131 + 10) % 1000000007;
    }
    check
}

fn main() {
    // LeetCode's example, then a robot walked round its edge exactly
    let example = [(0, 2), (0, 2), (1, 0), (2, 0), (0, 2), (0, 1), (0, 4), (1, 0), (2, 0)].to_vec();
    println(f"6 x 3: {answers(6, 3, example).join(" ")}");
    let round = [(2, 0), (0, 14), (1, 0), (2, 0), (0, 13), (1, 0), (2, 0), (0, 1), (1, 0), (2, 0)].to_vec();
    println(f"5 x 4: {answers(5, 4, round).join(" ")}");
    // 300 robots of 2 to 12 by 2 to 12, 1 to 40 calls of steps up to 60
    // or up to 100000
    let mut seed = 2069;
    let mut check = 0;
    for _ in 0..300 {
        let width = next_random(mut seed) % 11 + 2;
        let height = next_random(mut seed) % 11 + 2;
        let count = next_random(mut seed) % 40 + 1;
        let most = [60, 100000][next_random(mut seed) % 2];
        let calls = calls_of(count, most, mut seed);
        check = (check * 31 + checksum(answers(width, height, calls))) % 1000000007;
    }
    println(f"300 robots: checksum {check}");
    // the largest the constraints allow: 100 x 100, 10000 calls
    let calls = calls_of(10000, 100000, mut seed);
    let last = answers(100, 100, calls);
    println(f"100 x 100, 10000 calls: checksum {checksum(last)}, last {last[last.len() - 2]} {last[last.len() - 1]}");
}
