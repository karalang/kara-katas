// LeetCode #2093: Minimum Cost to Reach City With Discounts -- the ★ arm.
// Dijkstra over states of a city and the discounts used so far: from
// `(city, used)` a highway leads on at its toll to `(other, used)`, or at
// half its toll to `(other, used + 1)` while a discount is left. A
// `PriorityQueue` of `(cost, city, used)`, smallest first; the first time
// the last city is popped its cost is the answer. O((n + m) k log(nk)).

fn minimum_cost(n: i64, highways: Vec[(i64, i64, i64)], discounts: i64) -> i64 {
    let mut roads: Vec[Vec[(i64, i64)]] = Vec.filled(n, Vec.new());
    for (a, b, toll) in highways.iter() {
        roads[a].push((b, toll));
        roads[b].push((a, toll));
    }
    let k = discounts + 1;
    let mut best: Vec[i64] = Vec.filled(n * k, i64.MAX);
    let mut heap: PriorityQueue[(i64, i64, i64)] = PriorityQueue.new();
    best[0] = 0;
    heap.push((0, 0, 0));
    while let Some((cost, city, used)) = heap.pop() {
        if city == n - 1 {
            return cost;
        }
        if cost > best[city * k + used] {
            continue;
        }
        for (other, toll) in roads[city].iter() {
            let full = cost + toll;
            if full < best[other * k + used] {
                best[other * k + used] = full;
                heap.push((full, other, used));
            }
            if used < discounts {
                let half = cost + toll / 2;
                if half < best[other * k + used + 1] {
                    best[other * k + used + 1] = half;
                    heap.push((half, other, used + 1));
                }
            }
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `m` highways between distinct pairs of `n` cities, tolls below `top`
fn random_highways(n: i64, m: i64, top: i64, seed: mut ref i64) -> Vec[(i64, i64, i64)] {
    let mut seen: Set[(i64, i64)] = Set.new();
    let mut highways: Vec[(i64, i64, i64)] = Vec.new();
    for _ in 0..m {
        let a = next_random(mut seed) % n;
        let b = (a + 1 + next_random(mut seed) % (n - 1)) % n;
        let toll = (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
        if seen.insert((a.min(b), a.max(b))) {
            highways.push((a, b, toll));
        }
    }
    highways
}

fn main() {
    // LeetCode's three examples, then four more
    let examples = [
        (5, [(0, 1, 4), (2, 1, 3), (1, 4, 11), (3, 2, 3), (3, 4, 2)].to_vec(), 1),
        (4, [(1, 3, 17), (1, 2, 7), (3, 2, 5), (0, 1, 6), (3, 0, 20)].to_vec(), 20),
        (4, [(0, 1, 3), (2, 3, 2)].to_vec(), 0),
        (2, [(0, 1, 7)].to_vec(), 0),
        (2, [(0, 1, 7)].to_vec(), 1),
        (3, [(0, 1, 1), (1, 2, 1), (0, 2, 5)].to_vec(), 1),
        (4, [(0, 1, 9), (1, 2, 9), (2, 3, 9), (0, 3, 40)].to_vec(), 2),
    ];
    for (n, highways, discounts) in examples.iter() {
        println(f"{n} cities, {highways.len()} highways, {discounts} discounts -> {minimum_cost(n, highways, discounts)}");
    }
    // 2000 random maps of 2 to 30 cities and up to 40 highways, tolls below
    // 10, 100 or 100001, and up to 5 discounts
    let mut seed = 2093;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 29 + 2;
        let m = next_random(mut seed) % 40 + 1;
        let top = [10, 100, 100001][next_random(mut seed) % 3];
        let highways = random_highways(n, m, top, mut seed);
        let discounts = next_random(mut seed) % 6;
        let c = minimum_cost(n, highways, discounts);
        total += c;
        check = (check * 31 + c + 2) % 1000000007;
    }
    println(f"2000 maps: sum {total}, checksum {check}");
    // the constraints' largest, 1000 cities and 1000 highways with up to
    // 500 discounts; then a road of 999 highways each costing 100000
    let big = random_highways(1000, 1000, 100001, mut seed);
    println(f"1000 cities: {minimum_cost(1000, big, 0)} with none, {minimum_cost(1000, big, 3)} with 3, {minimum_cost(1000, big, 500)} with 500");
    let road: Vec[(i64, i64, i64)] = (0..999).map(|i| (i, i + 1, 100000)).collect();
    println(f"a road of 999: {minimum_cost(1000, road, 0)} with none, {minimum_cost(1000, road, 500)} with 500");
}
