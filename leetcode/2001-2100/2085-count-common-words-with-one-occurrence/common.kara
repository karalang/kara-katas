// LeetCode #2085: Count Common Words With One Occurrence -- the ★ arm.
// Each list's words counted in a `Map[String, i64]`, and the words of the
// first that occur once there and once in the second counted. O(n + m).

fn counts(words: Vec[String]) -> Map[String, i64] {
    let mut seen: Map[String, i64] = Map.new();
    for w in words.iter() {
        *seen.entry(w.clone()).or_insert(0) += 1;
    }
    seen
}

fn count_words(words1: Vec[String], words2: Vec[String]) -> i64 {
    let one = counts(words1);
    let two = counts(words2);
    one.iter().filter(|(w, c)| c == 1 and two.get(w) == Some(1)).count()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A word of 1 to `longest` letters from the first `width` of the alphabet.
fn random_word(seed: mut ref i64, width: i64, longest: i64) -> String {
    let letters = "abcdefghijklmnopqrstuvwxyz";
    let n = next_random(mut seed) % longest + 1;
    let mut w = String.new();
    for _ in 0..n {
        let at = next_random(mut seed) % width;
        w.push_str(letters.substring(at, at + 1));
    }
    w
}

fn words_of(text: Str) -> Vec[String] {
    text.split(" ").map(|w| w.to_string()).collect()
}

fn main() {
    // LeetCode's three examples, then four more
    let examples = [
        ("leetcode is amazing as is", "amazing leetcode is"),
        ("b bb bbb", "a aa aaa"),
        ("a ab", "a a a ab"),
        ("x", "x"),
        ("x x", "x"),
        ("one two three", "three two one"),
        ("a b c d", "d d c b b a"),
    ];
    for (one, two) in examples.iter() {
        println(f"[{one}] [{two}] -> {count_words(words_of(one), words_of(two))}");
    }
    // 300 random pairs of 1 to 100 words each, of 1 to 3 letters from the
    // first 2, 3 or 5 letters
    let mut seed = 2085;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let width = [2, 3, 5][next_random(mut seed) % 3];
        let n1 = next_random(mut seed) % 100 + 1;
        let n2 = next_random(mut seed) % 100 + 1;
        let words1: Vec[String] = (0..n1).map(|_| random_word(mut seed, width, 3)).collect();
        let words2: Vec[String] = (0..n2).map(|_| random_word(mut seed, width, 3)).collect();
        let a = count_words(words1, words2);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"300 pairs: sum {total}, checksum {check}");
    // the constraints' largest, 1000 words a side of up to 30 letters,
    // drawn from 1500 words
    let vocabulary: Vec[String] = (0..1500).map(|_| random_word(mut seed, 3, 30)).collect();
    let words1: Vec[String] = (0..1000).map(|_| vocabulary[next_random(mut seed) % 1500].clone()).collect();
    let words2: Vec[String] = (0..1000).map(|_| vocabulary[next_random(mut seed) % 1500].clone()).collect();
    println(f"1000 words a side: {count_words(words1, words2)}");
}
