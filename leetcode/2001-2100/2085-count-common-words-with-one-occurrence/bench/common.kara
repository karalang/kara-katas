// LeetCode #2085: Count Common Words With One Occurrence -- the ★ arm as
// a benchmark. 2500 pairs of lists of 1000 words, the constraints' limit,
// each word of 1 to 4 letters from 2 to 26 letters of the alphabet, so from
// nearly every word repeated to nearly none; each pair answered by counting
// both lists into a `Map` and walking the first: five million words
// counted.

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn counts(words: Vec[String]) -> Map[String, i64] {
    let mut seen: Map[String, i64] = Map.new();
    for w in words.iter() {
        *seen.entry(w.clone()).or_insert(0) += 1;
    }
    seen
}

fn count_words(words1: Vec[String], words2: Vec[String]) -> i64 {
    let one = counts(words1);
    let two = counts(words2);
    one.iter().filter(|(w, c)| c == 1 and two.get(w) == Some(1)).count()
}

fn random_list(seed: mut ref i64, alphabet: Vec[char], letters: i64) -> Vec[String] {
    let mut words: Vec[String] = Vec.with_capacity(1000);
    for _ in 0..1000 {
        let len = next_random(mut seed) % 4 + 1;
        let mut w = String.new();
        for _ in 0..len {
            w.push(alphabet[next_random(mut seed) % letters]);
        }
        words.push(w);
    }
    words
}

fn main() {
    let alphabet: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut seed = 2085;
    let mut total = 0;
    let mut check = 0;
    for t in 0..2500 {
        let letters = 2 + t % 25;
        let words1 = random_list(mut seed, alphabet, letters);
        let words2 = random_list(mut seed, alphabet, letters);
        let a = count_words(words1, words2);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"2500 pairs: sum {total}, checksum {check}");
}
