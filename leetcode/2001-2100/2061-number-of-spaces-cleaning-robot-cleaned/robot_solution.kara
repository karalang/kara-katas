// LeetCode #2061: Number of Spaces Cleaning Robot Cleaned -- LeetCode's
// Rust template (`room: Vec<Vec<i32>>` and an `i32` answer, `usize`
// places, a `vec![vec![0u8; n]; m]` of direction bits per cell, `1 << d`,
// `as i32` / `as usize` round trips), carried by `karac fix`. The adapter
// below hands the harness's rooms to it.

impl Solution {
    pub fn number_of_clean_rooms(room: Vec[Vec[i32]]) -> i32 {
        let m = room.len();
        let n = room[0].len();
        let dirs = [(0i32, 1i32), (1, 0), (0, -1), (-1, 0)];
        let mut visited = Vec.filled(m, Vec.filled(n, 0u8));
        let mut (r, c, d) = (0usize, 0usize, 0usize);
        let mut ans = 0;
        loop {
            if visited[r][c] == 0 {
                ans += 1;
            }
            if visited[r][c] & (1 << d) != 0 {
                break;
            }
            visited[r][c] |= 1 << d;
            let nr = r as i32 + dirs[d].0;
            let nc = c as i32 + dirs[d].1;
            if nr >= 0 and nr < m as i32 and nc >= 0 and nc < n as i32 and room[nr as usize][nc as usize] == 0 {
                r = nr as usize;
                c = nc as usize;
            } else {
                d = (d + 1) % 4;
            }
        }
        ans
    }
}

struct Solution {}

fn number_of_clean_rooms(room: Vec[Vec[i64]]) -> i64 {
    let rows: Vec[Vec[i32]] = room.iter().map(|row| row.iter().map(|x| x as i32).collect()).collect();
    Solution.number_of_clean_rooms(rows)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// an `m` by `n` room, each cell an object with chance `p` in 100, the
// top-left cell always empty
fn room_of(m: i64, n: i64, p: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut room: Vec[Vec[i64]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..n {
            row.push(if next_random(mut seed) % 100 < p { 1 } else { 0 });
        }
        room.push(row);
    }
    room[0][0] = 0;
    room
}

fn show(room: Vec[Vec[i64]]) -> String {
    let mut rows: Vec[String] = Vec.new();
    for row in room.iter() {
        let cells: Vec[String] = row.iter().map(|x| f"{x}").collect();
        rows.push(cells.join(""));
    }
    f"[{rows.join(", ")}]"
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[Vec[Vec[i64]]] = [
        [[0, 0, 0].to_vec(), [1, 1, 0].to_vec(), [0, 0, 0].to_vec()].to_vec(),
        [[0, 1, 0].to_vec(), [1, 0, 0].to_vec(), [0, 0, 0].to_vec()].to_vec(),
        [[0, 0, 0].to_vec(), [0, 0, 0].to_vec(), [0, 0, 0].to_vec()].to_vec(),
        [[0].to_vec()].to_vec(),
        [[0, 0, 1, 0].to_vec()].to_vec(),
        [[0].to_vec(), [0].to_vec(), [0].to_vec()].to_vec(),
        [[0, 1].to_vec(), [0, 0].to_vec()].to_vec(),
        [[0, 0, 0, 0].to_vec(), [0, 1, 1, 0].to_vec(), [0, 0, 0, 0].to_vec(), [1, 0, 0, 0].to_vec()].to_vec(),
    ].to_vec();
    for room in examples.iter() {
        println(f"{show(room)} -> {number_of_clean_rooms(room)}");
    }
    // 500 rooms of 1 to 12 by 1 to 12, objects with chance 0 to 50 in 100
    let mut seed = 2061;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..500 {
        let m = next_random(mut seed) % 12 + 1;
        let n = next_random(mut seed) % 12 + 1;
        let p = next_random(mut seed) % 51;
        let a = number_of_clean_rooms(room_of(m, n, p, mut seed));
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"500 rooms: sum {total}, checksum {check}");
    // 4 rooms of 300 by 300, objects with chance 0, 1, 3 and 10 in 100
    for p in [0, 1, 3, 10] {
        println(f"300 x 300, {p} in 100 -> {number_of_clean_rooms(room_of(300, 300, p, mut seed))}");
    }
}
