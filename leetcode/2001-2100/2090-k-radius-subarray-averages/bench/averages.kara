// LeetCode #2090: K Radius Subarray Averages -- the ★ arm as a benchmark.
// 30 arrays of 100000 values up to 100000, the constraints' limit, each
// asked for 10 radii from 0 to 20000: 300 answers, each one slide of the
// window down the array into a fresh `Vec` of averages.

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn get_averages(nums: Vec[i64], k: i64) -> Vec[i64] {
    let n = nums.len();
    let width = 2 * k + 1;
    let mut avgs: Vec[i64] = Vec.filled(n, -1);
    let mut sum = 0;
    for i in 0..n {
        sum += nums[i];
        if i >= width {
            sum -= nums[i - width];
        }
        if i + 1 >= width {
            avgs[i - k] = sum / width;
        }
    }
    avgs
}

fn main() {
    let mut seed = 2090;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..30 {
        let nums: Vec[i64] = (0..100000).map(|_| next_random(mut seed) % 100001).collect();
        arrays.push(nums);
    }
    let radii = [0, 1, 3, 10, 30, 100, 300, 1000, 3000, 20000];
    let mut total = 0;
    let mut check = 0;
    for nums in arrays.iter() {
        for k in radii.iter() {
            let mut s = 0;
            for a in get_averages(nums, k).iter() {
                s += a;
            }
            total += s;
            check = (check * 31 + s) % 1000000007;
        }
    }
    println(f"300 answers: sum {total}, checksum {check}");
}
