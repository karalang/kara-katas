// LeetCode #2094: Finding 3-Digit Even Numbers -- the differential. The
// six arms, against the statement read literally: every number below 1000
// that has three digits, no leading zero, is even, and whose digits can
// each be taken from a different place in the list, in increasing order.
// 300 random lists of 3 to 8 digits, each below 10, 5 or 3; then 20 of
// only 0s and 1s, and 20 of 10 to 20 digits; every one drawn before any
// arm answers.
//
// P1  the numbers are the statement read literally
// P2  the list reversed and turned by one place gives the same numbers
// P3  the numbers are distinct, increasing, even, and from 100 to 998
// P4  a digit more in the list loses no number
// P5  the list without its odd digits gives exactly the numbers whose
//     digits are all even
// P6  each arm agrees with at least three of the other five

// ---- even.kara: the ★ arm, the even numbers from 100 checked against the counts
fn star_find_even_numbers(digits: Vec[i64]) -> Vec[i64] {
    let mut have = [0; 10];
    for d in digits.iter() {
        have[d] += 1;
    }
    let mut found: Vec[i64] = Vec.new();
    for x in (100..1000).step_by(2) {
        let mut need = [0; 10];
        need[x / 100] += 1;
        need[x / 10 % 10] += 1;
        need[x % 10] += 1;
        if (0..10).all(|d| need[d] <= have[d]) {
            found.push(x);
        }
    }
    found
}

// ---- even_triples.kara: every three places, into a `SortedSet`
fn triples_find_even_numbers(digits: Vec[i64]) -> Vec[i64] {
    let n = digits.len();
    let mut made: SortedSet[i64] = SortedSet.new();
    for i in 0..n {
        if digits[i] == 0 {
            continue;
        }
        for j in 0..n {
            if j == i {
                continue;
            }
            for k in 0..n {
                if k != i and k != j and digits[k] % 2 == 0 {
                    made.insert(digits[i] * 100 + digits[j] * 10 + digits[k]);
                }
            }
        }
    }
    made.iter().cloned().collect()
}

// ---- even_backtrack.kara: backtracking over the counts, smallest first
fn backtrack_place(position: i64, so_far: i64, have: mut ref Array[i64, 10], found: mut ref Vec[i64]) {
    if position == 3 {
        found.push(so_far);
        return;
    }
    for d in 0..10 {
        if have[d] == 0 or (position == 0 and d == 0) or (position == 2 and d % 2 == 1) {
            continue;
        }
        have[d] -= 1;
        backtrack_place(position + 1, so_far * 10 + d, mut have, mut found);
        have[d] += 1;
    }
}

fn backtrack_find_even_numbers(digits: Vec[i64]) -> Vec[i64] {
    let mut have = [0; 10];
    for d in digits.iter() {
        have[d] += 1;
    }
    let mut found: Vec[i64] = Vec.new();
    backtrack_place(0, 0, mut have, mut found);
    found
}

// ---- even_text.kara: characters counted in a `Map[char, i64]`
fn text_tally(chars: Vec[char]) -> Map[char, i64] {
    let mut counts: Map[char, i64] = Map.new();
    for c in chars.iter() {
        *counts.entry(c).or_insert(0) += 1;
    }
    counts
}

fn text_find_even_numbers(digits: Vec[i64]) -> Vec[i64] {
    let have = text_tally(digits.iter().map(|d| char.from_digit(d as u32, 10).unwrap()).collect());
    (100..1000)
        .step_by(2)
        .filter(|x| {
            let want = text_tally(x.to_string().chars().collect());
            want.iter().all(|(c, n)| have.get(c).unwrap_or(0) >= n)
        })
        .collect()
}

// ---- even_struct.kara: a `struct Hand` spending a number's digits
struct HandHand {
    counts: Array[i64, 10],
}

impl HandHand {
    fn of(digits: Vec[i64]) -> HandHand {
        let mut counts = [0; 10];
        for d in digits.iter() {
            counts[d] += 1;
        }
        HandHand { counts }
    }

    fn spend(self, x: i64) -> bool {
        let mut left = self.counts;
        let mut rest = x;
        for _ in 0..3 {
            let d = rest % 10;
            if left[d] == 0 {
                return false;
            }
            left[d] -= 1;
            rest /= 10;
        }
        true
    }
}

struct HandEvenThreeDigit {
    next: i64,
}

impl Iterator for HandEvenThreeDigit {
    type Item = i64;

    fn next(mut ref self) -> Option[i64] {
        if self.next > 998 {
            return None;
        }
        let x = self.next;
        self.next += 2;
        Some(x)
    }
}

fn hand_find_even_numbers(digits: Vec[i64]) -> Vec[i64] {
    let hand = HandHand.of(digits);
    HandEvenThreeDigit { next: 100 }.filter(|x| hand.spend(x)).collect()
}

// ---- even_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn find_even_numbers(digits: Vec[i32]) -> Vec[i32] {
        let mut cnt = [0; 10];
        for d in ref digits {
            cnt[d as usize] += 1;
        }
        let mut res = Vec.new();
        for i in 1..10 {
            if cnt[i] == 0 {
                continue;
            }
            cnt[i] -= 1;
            for j in 0..10 {
                if cnt[j] == 0 {
                    continue;
                }
                cnt[j] -= 1;
                for k in (0..10).step_by(2) {
                    if cnt[k] > 0 {
                        res.push((i * 100 + j * 10 + k) as i32);
                    }
                }
                cnt[j] += 1;
            }
            cnt[i] += 1;
        }
        res
    }
}

struct SolutionSolution {}

fn solution_find_even_numbers(digits: Vec[i64]) -> Vec[i64] {
    let d: Vec[i32] = digits.iter().map(|x| x as i32).collect();
    SolutionSolution.find_even_numbers(d).iter().map(|x| x as i64).collect()
}

// ---- the statement read literally

fn literal(digits: Vec[i64]) -> Vec[i64] {
    let mut found: Vec[i64] = Vec.new();
    for x in 0..1000 {
        if x < 100 or x % 2 != 0 {
            continue;
        }
        let mut left = digits.clone();
        let mut made = true;
        for d in [x / 100, x / 10 % 10, x % 10] {
            match left.iter().position(|y| y == d) {
                Some(p) => {
                    left.remove(p);
                }
                None => {
                    made = false;
                }
            }
        }
        if made {
            found.push(x);
        }
    }
    found
}

fn answer(arm: i64, digits: Vec[i64]) -> Vec[i64] {
    match arm {
        0 => star_find_even_numbers(digits),
        1 => triples_find_even_numbers(digits),
        2 => backtrack_find_even_numbers(digits),
        3 => text_find_even_numbers(digits),
        4 => hand_find_even_numbers(digits),
        _ => solution_find_even_numbers(digits),
    }
}

// ---- lists

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    let names = ["star", "triples", "backtrack", "text", "hand", "solution"];
    let mut seed = 2094;
    let mut problems: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..340 {
        let mut len = next_random(mut seed) % 6 + 3;
        let mut top = [10, 5, 3][next_random(mut seed) % 3];
        if t >= 300 and t < 320 {
            top = 2;
        } else if t >= 320 {
            len = next_random(mut seed) % 11 + 10;
        }
        let digits: Vec[i64] = (0..len).map(|_| next_random(mut seed) % top).collect();
        problems.push((digits, next_random(mut seed) % 10));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (digits, extra) in problems.iter() {
        let truth = literal(digits);
        for x in truth.iter() {
            check = (check * 31 + x) % 1000000007;
        }
        check = (check * 31 + 1000) % 1000000007;
        let mut turned: Vec[i64] = digits.iter().rev().cloned().collect();
        turned.rotate_left(1);
        let mut more = digits.clone();
        more.push(extra);
        let evens: Vec[i64] = digits.iter().filter(|d| d % 2 == 0).cloned().collect();
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, digits)).collect();
        for arm in 0..6 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let shaped = (1..x.len()).all(|i| x[i - 1] < x[i]) and x.iter().all(|y| y % 2 == 0 and 100 <= y and y <= 998);
            let grown = answer(arm, more);
            let all_even: Vec[i64] = x.iter().filter(|y| y / 100 % 2 == 0 and y / 10 % 2 == 0).cloned().collect();
            let verdicts = [
                x == truth,
                answer(arm, turned) == x,
                shaped,
                x.iter().all(|y| grown.contains(y)),
                answer(arm, evens) == all_even,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{show(digits)} arm {names[arm]}: P{q + 1} fails, answer {show(x)}, literal {show(truth)}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} lists: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
