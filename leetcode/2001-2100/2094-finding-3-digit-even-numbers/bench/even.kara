// LeetCode #2094: Finding 3-Digit Even Numbers -- the ★ arm's benchmark:
// 100000 random lists of 3 to 100 digits, each below 10, 6 or 4, answered
// by counting the digits and checking each even number from 100 to 998
// against the counts.

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn find_even_numbers(digits: Vec[i64]) -> Vec[i64] {
    let mut have = [0; 10];
    for d in digits.iter() {
        have[d] += 1;
    }
    let mut found: Vec[i64] = Vec.new();
    for x in (100..1000).step_by(2) {
        let mut need = [0; 10];
        need[x / 100] += 1;
        need[x / 10 % 10] += 1;
        need[x % 10] += 1;
        if (0..10).all(|d| need[d] <= have[d]) {
            found.push(x);
        }
    }
    found
}

fn main() {
    let mut seed = 2094;
    let mut count = 0;
    let mut check = 0;
    for _ in 0..100000 {
        let len = next_random(mut seed) % 98 + 3;
        let top = [10, 6, 4][next_random(mut seed) % 3];
        let digits: Vec[i64] = (0..len).map(|_| next_random(mut seed) % top).collect();
        let got = find_even_numbers(digits);
        count += got.len();
        for x in got.iter() {
            check = (check * 31 + x) % 1000000007;
        }
    }
    println(f"100000 answers: {count} numbers, checksum {check}");
}
