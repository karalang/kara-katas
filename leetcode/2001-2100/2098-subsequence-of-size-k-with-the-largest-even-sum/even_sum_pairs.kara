// LeetCode #2098: Subsequence of Size K With the Largest Even Sum -- a
// greedy over pairs, in a `struct Picker` holding the odds and the evens
// largest first. An odd `k` first takes the largest even, since an even
// sum needs an even count of odds; then two at a time, the larger of the
// next two odds and the next two evens, whose sum is even either way. Out
// of pairs before `k` is reached means no even sum. O(n log n).

struct Picker {
    odds: Vec[i64],
    evens: Vec[i64],
    next_odd: i64,
    next_even: i64,
}

impl Picker {
    fn new(nums: Vec[i64]) -> Picker {
        let mut odds: Vec[i64] = nums.iter().filter(|x| x % 2 == 1).collect();
        let mut evens: Vec[i64] = nums.iter().filter(|x| x % 2 == 0).collect();
        odds.sort_by(|a, b| b.cmp(a));
        evens.sort_by(|a, b| b.cmp(a));
        Picker { odds, evens, next_odd: 0, next_even: 0 }
    }

    fn two_odds(self) -> Option[i64] {
        if self.next_odd + 1 < self.odds.len() {
            Some(self.odds[self.next_odd] + self.odds[self.next_odd + 1])
        } else {
            None
        }
    }

    fn two_evens(self) -> Option[i64] {
        if self.next_even + 1 < self.evens.len() {
            Some(self.evens[self.next_even] + self.evens[self.next_even + 1])
        } else {
            None
        }
    }

    fn pick(mut ref self, k: i64) -> i64 {
        let mut need = k;
        let mut sum = 0;
        if need % 2 == 1 {
            if self.evens.len() == 0 {
                return -1;
            }
            sum += self.evens[0];
            self.next_even = 1;
            need -= 1;
        }
        while need > 0 {
            match (self.two_odds(), self.two_evens()) {
                (Some(o), Some(e)) if o >= e => {
                    sum += o;
                    self.next_odd += 2;
                }
                (_, Some(e)) => {
                    sum += e;
                    self.next_even += 2;
                }
                (Some(o), None) => {
                    sum += o;
                    self.next_odd += 2;
                }
                (None, None) => {
                    return -1;
                }
            }
            need -= 2;
        }
        sum
    }
}

fn largest_even_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut picker = Picker.new(nums);
    picker.pick(k)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's three examples, then five more
    let examples = [
        ([4, 1, 5, 3, 1].to_vec(), 3),
        ([4, 6, 2].to_vec(), 3),
        ([1, 3, 5].to_vec(), 1),
        ([7].to_vec(), 1),
        ([0].to_vec(), 1),
        ([5, 5, 2, 9, 1].to_vec(), 2),
        ([9, 8, 1].to_vec(), 2),
        ([3, 3, 3, 3, 3].to_vec(), 5),
    ];
    for (nums, k) in examples.iter() {
        println(f"{nums} k={k} -> {largest_even_sum(nums, k)}");
    }
    // 3000 random lists of 1 to 30 numbers below 10, 100 or 10^5 + 1,
    // each asked for a random k
    let mut seed = 2098;
    let mut none = 0;
    let mut check = 0;
    for round in 0..3000 {
        let n = next_random(mut seed) % 30 + 1;
        let top = [10, 100, 100001][round % 3];
        let nums: Vec[i64] = (0..n).map(|_| wide_random(mut seed) % top).collect();
        let k = next_random(mut seed) % n + 1;
        let got = largest_even_sum(nums, k);
        if got < 0 {
            none += 1;
        }
        check = (check * 31 + got + 1) % 1000000007;
    }
    println(f"3000 lists: {none} with no even sum, checksum {check}");
    // the constraints' largest: 10^5 numbers up to 10^5 for three k, all
    // odd, and all the largest
    let n = 100000;
    let nums: Vec[i64] = (0..n).map(|_| wide_random(mut seed) % 100001).collect();
    for k in [1, 50001, 100000] {
        println(f"100000 random, k={k}: {largest_even_sum(nums, k)}");
    }
    let odd: Vec[i64] = (0..n).map(|i| 2 * (i % 50000) + 1).collect();
    println(f"100000 odd, k=99999: {largest_even_sum(odd, 99999)}, k=100000: {largest_even_sum(odd, 100000)}");
    let same = Vec.filled(n, 100000);
    println(f"100000 of 100000, k=100000: {largest_even_sum(same, 100000)}");
}
