// LeetCode #2098: Subsequence of Size K With the Largest Even Sum -- one
// pass with a heap. A smallest-first `PriorityQueue` holds the `k` largest
// numbers seen so far: each number goes in, and once there are more than
// `k` the smallest comes out and is left out for good, its parity's
// largest left-out noted. What stays is what is taken. O(n log k).

fn largest_even_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut kept: PriorityQueue[i64] = PriorityQueue.new();
    let mut left_odd = -1;
    let mut left_even = -1;
    for x in nums.iter() {
        kept.push(x);
        if kept.len() > k {
            let out = kept.pop().unwrap();
            if out % 2 == 1 {
                left_odd = left_odd.max(out);
            } else {
                left_even = left_even.max(out);
            }
        }
    }
    let mut sum = 0;
    let mut taken_odd = -1;
    let mut taken_even = -1;
    while let Some(x) = kept.pop() {
        sum += x;
        if x % 2 == 1 and taken_odd < 0 {
            taken_odd = x;
        }
        if x % 2 == 0 and taken_even < 0 {
            taken_even = x;
        }
    }
    if sum % 2 == 0 {
        return sum;
    }
    let mut best = -1;
    if taken_odd >= 0 and left_even >= 0 {
        best = best.max(sum - taken_odd + left_even);
    }
    if taken_even >= 0 and left_odd >= 0 {
        best = best.max(sum - taken_even + left_odd);
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's three examples, then five more
    let examples = [
        ([4, 1, 5, 3, 1].to_vec(), 3),
        ([4, 6, 2].to_vec(), 3),
        ([1, 3, 5].to_vec(), 1),
        ([7].to_vec(), 1),
        ([0].to_vec(), 1),
        ([5, 5, 2, 9, 1].to_vec(), 2),
        ([9, 8, 1].to_vec(), 2),
        ([3, 3, 3, 3, 3].to_vec(), 5),
    ];
    for (nums, k) in examples.iter() {
        println(f"{nums} k={k} -> {largest_even_sum(nums, k)}");
    }
    // 3000 random lists of 1 to 30 numbers below 10, 100 or 10^5 + 1,
    // each asked for a random k
    let mut seed = 2098;
    let mut none = 0;
    let mut check = 0;
    for round in 0..3000 {
        let n = next_random(mut seed) % 30 + 1;
        let top = [10, 100, 100001][round % 3];
        let nums: Vec[i64] = (0..n).map(|_| wide_random(mut seed) % top).collect();
        let k = next_random(mut seed) % n + 1;
        let got = largest_even_sum(nums, k);
        if got < 0 {
            none += 1;
        }
        check = (check * 31 + got + 1) % 1000000007;
    }
    println(f"3000 lists: {none} with no even sum, checksum {check}");
    // the constraints' largest: 10^5 numbers up to 10^5 for three k, all
    // odd, and all the largest
    let n = 100000;
    let nums: Vec[i64] = (0..n).map(|_| wide_random(mut seed) % 100001).collect();
    for k in [1, 50001, 100000] {
        println(f"100000 random, k={k}: {largest_even_sum(nums, k)}");
    }
    let odd: Vec[i64] = (0..n).map(|i| 2 * (i % 50000) + 1).collect();
    println(f"100000 odd, k=99999: {largest_even_sum(odd, 99999)}, k=100000: {largest_even_sum(odd, 100000)}");
    let same = Vec.filled(n, 100000);
    println(f"100000 of 100000, k=100000: {largest_even_sum(same, 100000)}");
}
