// LeetCode #2098: Subsequence of Size K With the Largest Even Sum -- the
// differential. The six arms, against the statement read literally: every
// choice of `k` of the numbers tried, the largest even sum of them, or -1.
// 300 random lists of 1 to 10 numbers below 10; then 20 lists of 1 to 10
// odd numbers below 20; then 20 lists of 1 to 12 numbers below 50000; each
// with a random `k`, every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer is -1 or even, and no more than the sum of the `k` largest
// P3  the numbers in reverse order give the same answer
// P4  every number doubled: the answer is twice the sum of the `k` largest
// P5  every number 2 more: the answer is `2k` more, or -1 again
// P6  each arm agrees with at least three of the other five

// ---- even_sum.kara: the ★ arm, the k largest and the better swap
fn star_largest_even_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.to_vec();
    sorted.sort_by(|a, b| b.cmp(a));
    let sum: i64 = sorted[..k].iter().sum();
    if sum % 2 == 0 {
        return sum;
    }
    let taken_odd = sorted[..k].iter().filter(|x| x % 2 == 1).min();
    let taken_even = sorted[..k].iter().filter(|x| x % 2 == 0).min();
    let left_odd = sorted[k..].iter().filter(|x| x % 2 == 1).max();
    let left_even = sorted[k..].iter().filter(|x| x % 2 == 0).max();
    let mut best = -1;
    if let (Some(o), Some(e)) = (taken_odd, left_even) {
        best = best.max(sum - o + e);
    }
    if let (Some(e), Some(o)) = (taken_even, left_odd) {
        best = best.max(sum - e + o);
    }
    best
}

// ---- even_sum_count.kara: a counting sort over the values
fn count_largest_even_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut count = Vec.filled(100001, 0);
    for x in nums.iter() {
        count[x] += 1;
    }
    let mut need = k;
    let mut sum = 0;
    let mut taken = [-1, -1];
    let mut left = [-1, -1];
    let mut v = 100000;
    while v >= 0 {
        let c = count[v];
        if c > 0 {
            let take = c.min(need);
            if take > 0 {
                sum += take * v;
                need -= take;
                taken[v % 2] = v;
            }
            if c > take and left[v % 2] < 0 {
                left[v % 2] = v;
            }
        }
        v -= 1;
    }
    if sum % 2 == 0 {
        return sum;
    }
    let mut best = -1;
    for p in 0..2 {
        if taken[p] >= 0 and left[1 - p] >= 0 {
            best = best.max(sum - taken[p] + left[1 - p]);
        }
    }
    best
}

// ---- even_sum_prefix.kara: every even count of odds, by prefix sums
fn prefix_prefix(xs: Vec[i64]) -> Vec[i64] {
    let mut sums = [0].to_vec();
    for x in xs.iter() {
        sums.push(sums[sums.len() - 1] + x);
    }
    sums
}

fn prefix_largest_even_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut (odds, evens): (Vec[i64], Vec[i64]) = nums.iter().cloned().partition(|x| x % 2 == 1);
    odds.sort_by(|a, b| b.cmp(a));
    evens.sort_by(|a, b| b.cmp(a));
    let odd_sums = prefix_prefix(odds);
    let even_sums = prefix_prefix(evens);
    let mut best = -1;
    let mut take = 0;
    while take <= k and take <= odds.len() {
        if k - take <= evens.len() {
            best = best.max(odd_sums[take] + even_sums[k - take]);
        }
        take += 2;
    }
    best
}

// ---- even_sum_heap.kara: one pass keeping the k largest in a heap
fn heap_largest_even_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut kept: PriorityQueue[i64] = PriorityQueue.new();
    let mut left_odd = -1;
    let mut left_even = -1;
    for x in nums.iter() {
        kept.push(x);
        if kept.len() > k {
            let out = kept.pop().unwrap();
            if out % 2 == 1 {
                left_odd = left_odd.max(out);
            } else {
                left_even = left_even.max(out);
            }
        }
    }
    let mut sum = 0;
    let mut taken_odd = -1;
    let mut taken_even = -1;
    while let Some(x) = kept.pop() {
        sum += x;
        if x % 2 == 1 and taken_odd < 0 {
            taken_odd = x;
        }
        if x % 2 == 0 and taken_even < 0 {
            taken_even = x;
        }
    }
    if sum % 2 == 0 {
        return sum;
    }
    let mut best = -1;
    if taken_odd >= 0 and left_even >= 0 {
        best = best.max(sum - taken_odd + left_even);
    }
    if taken_even >= 0 and left_odd >= 0 {
        best = best.max(sum - taken_even + left_odd);
    }
    best
}

// ---- even_sum_pairs.kara: a `struct Picker` taking two at a time
struct PairsPicker {
    odds: Vec[i64],
    evens: Vec[i64],
    next_odd: i64,
    next_even: i64,
}

impl PairsPicker {
    fn new(nums: Vec[i64]) -> PairsPicker {
        let mut odds: Vec[i64] = nums.iter().filter(|x| x % 2 == 1).collect();
        let mut evens: Vec[i64] = nums.iter().filter(|x| x % 2 == 0).collect();
        odds.sort_by(|a, b| b.cmp(a));
        evens.sort_by(|a, b| b.cmp(a));
        PairsPicker { odds, evens, next_odd: 0, next_even: 0 }
    }

    fn two_odds(self) -> Option[i64] {
        if self.next_odd + 1 < self.odds.len() {
            Some(self.odds[self.next_odd] + self.odds[self.next_odd + 1])
        } else {
            None
        }
    }

    fn two_evens(self) -> Option[i64] {
        if self.next_even + 1 < self.evens.len() {
            Some(self.evens[self.next_even] + self.evens[self.next_even + 1])
        } else {
            None
        }
    }

    fn pick(mut ref self, k: i64) -> i64 {
        let mut need = k;
        let mut sum = 0;
        if need % 2 == 1 {
            if self.evens.len() == 0 {
                return -1;
            }
            sum += self.evens[0];
            self.next_even = 1;
            need -= 1;
        }
        while need > 0 {
            match (self.two_odds(), self.two_evens()) {
                (Some(o), Some(e)) if o >= e => {
                    sum += o;
                    self.next_odd += 2;
                }
                (_, Some(e)) => {
                    sum += e;
                    self.next_even += 2;
                }
                (Some(o), None) => {
                    sum += o;
                    self.next_odd += 2;
                }
                (None, None) => {
                    return -1;
                }
            }
            need -= 2;
        }
        sum
    }
}

fn pairs_largest_even_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut picker = PairsPicker.new(nums);
    picker.pick(k)
}

// ---- even_sum_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn largest_even_sum(nums: own Vec[i32], k: i32) -> i64 {
        let mut nums = nums;
        nums.sort();
        let n = nums.len();
        let k = k as i64;
        let mut sum: i64 = 0;
        let mut mn = [i32.MAX; 2];
        for x in nums[n - k..] {
            sum += x;
            let p = (x & 1) as i64;
            mn[p] = mn[p].min(x);
        }
        if sum % 2 == 0 {
            return sum;
        }
        let mut mx = [-1i32; 2];
        for x in nums[..n - k] {
            let p = (x & 1) as i64;
            mx[p] = mx[p].max(x);
        }
        let mut ans = -1;
        for p in 0..2 {
            if mn[p] != i32.MAX and mx[1 - p] >= 0 {
                ans = ans.max(sum - mn[p] + mx[1 - p]);
            }
        }
        ans
    }
}

struct SolutionSolution {}

fn solution_largest_even_sum(nums: Vec[i64], k: i64) -> i64 {
    SolutionSolution.largest_even_sum(nums.iter().map(|x| x as i32).collect(), k as i32)
}

// ---- the statement read literally

fn literal(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    let mut best = -1;
    for mask in 0..(1 << n) {
        let mut size = 0;
        let mut sum = 0;
        for i in 0..n {
            if (mask >> i) & 1 == 1 {
                size += 1;
                sum += nums[i];
            }
        }
        if size == k and sum % 2 == 0 and sum > best {
            best = sum;
        }
    }
    best
}

fn top_sum(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.to_vec();
    sorted.sort();
    sorted.reverse();
    sorted[..k].iter().sum()
}

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_largest_even_sum(nums, k),
        1 => count_largest_even_sum(nums, k),
        2 => prefix_largest_even_sum(nums, k),
        3 => heap_largest_even_sum(nums, k),
        4 => pairs_largest_even_sum(nums, k),
        _ => solution_largest_even_sum(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "count", "prefix", "heap", "pairs", "solution"];
    let mut seed = 2098;
    let mut problems: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..340 {
        let mut nums: Vec[i64] = Vec.new();
        if t < 300 {
            let n = next_random(mut seed) % 10 + 1;
            for _ in 0..n {
                nums.push(next_random(mut seed) % 10);
            }
        } else if t < 320 {
            let n = next_random(mut seed) % 10 + 1;
            for _ in 0..n {
                nums.push(2 * (next_random(mut seed) % 10) + 1);
            }
        } else {
            let n = next_random(mut seed) % 12 + 1;
            for _ in 0..n {
                nums.push(wide_random(mut seed) % 50000);
            }
        }
        let k = next_random(mut seed) % nums.len() + 1;
        problems.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (nums, k) in problems.iter() {
        let truth = literal(nums, k);
        check = (check * 31 + truth + 1) % 1000000007;
        let top = top_sum(nums, k);
        let mut reversed = nums.to_vec();
        reversed.reverse();
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let raised: Vec[i64] = nums.iter().map(|x| x + 2).collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let up = answer(arm, raised, k);
            let verdicts = [
                x == truth,
                (x == -1 or x % 2 == 0) and x <= top,
                answer(arm, reversed, k) == x,
                answer(arm, doubled, k) == 2 * top,
                if x == -1 { up == -1 } else { up == x + 2 * k },
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} k={k} arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} lists: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
