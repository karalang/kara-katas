// LeetCode #2086: Minimum Number of Food Buckets to Feed the Hamsters --
// dynamic programming over the cells: the fewest buckets so far for each
// state of the last cell, whether it holds a bucket and whether it is a
// hamster still waiting for one on its right, four states in all, with
// `UNSERVED` for a state that cannot happen. O(n).

const UNSERVED: i64 = 1000000000;

// The state of the last cell as an index: a bucket there, a hamster
// waiting there.
fn state(bucket: bool, waiting: bool) -> i64 {
    (if bucket { 2 } else { 0 }) + (if waiting { 1 } else { 0 })
}

fn minimum_buckets(hamsters: Str) -> i64 {
    let mut best: Vec[i64] = Vec.filled(4, UNSERVED);
    best[state(false, false)] = 0;
    for c in hamsters.chars() {
        let mut next: Vec[i64] = Vec.filled(4, UNSERVED);
        for bucket in [false, true] {
            for waiting in [false, true] {
                let cost = best[state(bucket, waiting)];
                if cost == UNSERVED {
                    continue;
                }
                if c == '.' {
                    // a waiting hamster must be fed here
                    let to = state(true, false);
                    next[to] = next[to].min(cost + 1);
                    if not waiting {
                        let to = state(false, false);
                        next[to] = next[to].min(cost);
                    }
                } else if not waiting {
                    // a hamster, fed already when a bucket is on its left
                    let to = state(false, not bucket);
                    next[to] = next[to].min(cost);
                }
            }
        }
        best = next;
    }
    let answer = best[state(false, false)].min(best[state(true, false)]);
    if answer == UNSERVED { -1 } else { answer }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A street of `n` cells, each a hamster `H` with chance `odds` in 10 and
// else empty `.`.
fn random_street(seed: mut ref i64, n: i64, odds: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        if next_random(mut seed) % 10 < odds {
            s.push('H');
        } else {
            s.push('.');
        }
    }
    s
}

fn main() {
    // LeetCode's three examples, then four more
    let examples = ["H..H", ".H.H.", ".HHH.", "H", ".", "H.H.H", "HH.HH.H"];
    for s in examples.iter() {
        println(f"{s} -> {minimum_buckets(s)}");
    }
    // 2000 random streets of 1 to 30 cells, a hamster in 1 to 5 cells of 10
    let mut seed = 2086;
    let mut total = 0;
    let mut impossible = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 30 + 1;
        let odds = next_random(mut seed) % 5 + 1;
        let s = random_street(mut seed, n, odds);
        let a = minimum_buckets(s);
        if a < 0 {
            impossible += 1;
        } else {
            total += a;
        }
        check = (check * 31 + a + 1) % 1000000007;
    }
    println(f"2000 streets: sum {total}, {impossible} impossible, checksum {check}");
    // the constraints' largest, 10^5 cells: pieces that can each be served
    // put together at random, then `H.` over and over
    let pieces = [".", "H.", ".H", "H.H", ".H.H.", "..H"];
    let mut s = String.new();
    while s.len() < 99995 {
        s.push_str(pieces[next_random(mut seed) % 6]);
    }
    while s.len() < 100000 {
        s.push('.');
    }
    println(f"10^5 cells, served: {minimum_buckets(s)}");
    let s = "H.".repeat(50000);
    println(f"10^5 cells, H.H.: {minimum_buckets(s)}");
}
