// LeetCode #2086: Minimum Number of Food Buckets to Feed the Hamsters --
// the differential. The six arms, against the statement read literally:
// every set of empty cells tried, fewest first, and the first that puts a
// bucket beside every hamster taken, or -1 when none does. 300 random
// streets of 1 to 12 cells, a hamster in 2 to 7 cells of 10; then 20
// streets with no hamster, and 20 put together from pieces that can each
// be served; every one drawn before any arm answers.
//
// P1  the count is the statement read literally
// P2  the street reversed gives the same count
// P3  the count is -1 exactly when the street is one hamster, starts or
//     ends with two, or holds three in a row
// P4  a street that can be served takes at least half its hamsters,
//     rounded up, and at most all of them
// P5  a street that can be served, with its first hamster made an empty
//     cell, takes no more
// P6  each arm agrees with at least three of the other five

// ---- bucket.kara: the ★ arm, greedy, the buckets in a `Vec[bool]`
fn star_minimum_buckets(hamsters: Str) -> i64 {
    let cells = hamsters.bytes();
    let n = cells.len();
    let mut bucket: Vec[bool] = Vec.filled(n, false);
    let mut count = 0;
    for i in 0..n {
        if cells[i] != b'H' {
            continue;
        }
        if i > 0 and bucket[i - 1] {
            continue;
        }
        if i + 1 < n and cells[i + 1] == b'.' {
            bucket[i + 1] = true;
            count += 1;
        } else if i > 0 and cells[i - 1] == b'.' {
            bucket[i - 1] = true;
            count += 1;
        } else {
            return -1;
        }
    }
    count
}

// ---- bucket_pattern.kara: by text, the hamsters less the `H.H`s
fn pattern_minimum_buckets(hamsters: Str) -> i64 {
    if hamsters == "H" or hamsters.starts_with("HH") or hamsters.ends_with("HH") or hamsters.contains("HHH") {
        return -1;
    }
    let count = hamsters.chars().filter(|c| c == 'H').count();
    count - hamsters.matches("H.H").count()
}

// ---- bucket_dp.kara: four states of the last cell
const DP_UNSERVED: i64 = 1000000000;

// The dp_state of the last cell as an index: a bucket there, a hamster
// waiting there.
fn dp_state(bucket: bool, waiting: bool) -> i64 {
    (if bucket { 2 } else { 0 }) + (if waiting { 1 } else { 0 })
}

fn dp_minimum_buckets(hamsters: Str) -> i64 {
    let mut best: Vec[i64] = Vec.filled(4, DP_UNSERVED);
    best[dp_state(false, false)] = 0;
    for c in hamsters.chars() {
        let mut next: Vec[i64] = Vec.filled(4, DP_UNSERVED);
        for bucket in [false, true] {
            for waiting in [false, true] {
                let cost = best[dp_state(bucket, waiting)];
                if cost == DP_UNSERVED {
                    continue;
                }
                if c == '.' {
                    // a waiting hamster must be fed here
                    let to = dp_state(true, false);
                    next[to] = next[to].min(cost + 1);
                    if not waiting {
                        let to = dp_state(false, false);
                        next[to] = next[to].min(cost);
                    }
                } else if not waiting {
                    // a hamster, fed already when a bucket is on its left
                    let to = dp_state(false, not bucket);
                    next[to] = next[to].min(cost);
                }
            }
        }
        best = next;
    }
    let answer = best[dp_state(false, false)].min(best[dp_state(true, false)]);
    if answer == DP_UNSERVED { -1 } else { answer }
}

// ---- bucket_fold.kara: the greedy as one `fold`
fn fold_minimum_buckets(hamsters: Str) -> i64 {
    let cells = hamsters.bytes();
    let n = cells.len();
    let (count, _, possible) = cells.iter().enumerate().fold((0, -2, true), |(count, last, possible), (i, c)| {
        if not possible or c != b'H' or last == i - 1 {
            (count, last, possible)
        } else if i + 1 < n and cells[i + 1] == b'.' {
            (count + 1, i + 1, true)
        } else if i > 0 and cells[i - 1] == b'.' {
            (count + 1, i - 1, true)
        } else {
            (count, last, false)
        }
    });
    if possible { count } else { -1 }
}

// ---- bucket_struct.kara: a `struct Street`, served from the right
struct Street {
    cells: Vec[char],
    buckets: Vec[bool],
}

impl Street {
    fn new(hamsters: Str) -> Street {
        let cells: Vec[char] = hamsters.chars().collect();
        let n = cells.len();
        Street { cells, buckets: Vec.filled(n, false) }
    }

    // Whether place `i` is on the street and holds no hamster.
    fn empty(self, i: i64) -> bool {
        i >= 0 and i < self.cells.len() and self.cells[i] == '.'
    }

    fn fed(self, i: i64) -> bool {
        i + 1 < self.cells.len() and self.buckets[i + 1]
    }

    fn place(mut ref self, i: i64) {
        self.buckets[i] = true;
    }

    fn serve(mut ref self) -> i64 {
        let mut count = 0;
        for i in (0..self.cells.len()).rev() {
            if self.cells[i] != 'H' or self.fed(i) {
                continue;
            }
            if self.empty(i - 1) {
                self.place(i - 1);
            } else if self.empty(i + 1) {
                self.place(i + 1);
            } else {
                return -1;
            }
            count += 1;
        }
        count
    }
}

fn street_minimum_buckets(hamsters: Str) -> i64 {
    let mut street = Street.new(hamsters);
    street.serve()
}

// ---- bucket_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn minimum_buckets(hamsters: String) -> i32 {
        let s = hamsters.bytes();
        let n = s.len();
        let mut ans = 0;
        let mut i: i64 = 0;
        while i < n {
            if s[i] == b'H' {
                if i + 1 < n and s[i + 1] == b'.' {
                    ans += 1;
                    i += 2;
                } else if i > 0 and s[i - 1] == b'.' {
                    ans += 1;
                } else {
                    return -1;
                }
            }
            i += 1;
        }
        ans
    }
}

struct Solution {}

fn solution_minimum_buckets(hamsters: Str) -> i64 {
    Solution.minimum_buckets(hamsters.to_string())
}

// ---- the statement read literally

fn literal(street: Str) -> i64 {
    let cells: Vec[char] = street.chars().collect();
    let n = cells.len();
    let empty: Vec[i64] = (0..n).filter(|i| cells[i] == '.').collect();
    let mut best = -1;
    for mask in 0..(1 << empty.len()) {
        let mut bucket: Vec[bool] = Vec.filled(n, false);
        let mut count = 0;
        for k in 0..empty.len() {
            if (mask >> k) & 1 == 1 {
                bucket[empty[k]] = true;
                count += 1;
            }
        }
        let mut served = true;
        for i in 0..n {
            if cells[i] == 'H' and not ((i > 0 and bucket[i - 1]) or (i + 1 < n and bucket[i + 1])) {
                served = false;
            }
        }
        if served and (best < 0 or count < best) {
            best = count;
        }
    }
    best
}

fn answer(arm: i64, street: Str) -> i64 {
    match arm {
        0 => star_minimum_buckets(street),
        1 => pattern_minimum_buckets(street),
        2 => dp_minimum_buckets(street),
        3 => fold_minimum_buckets(street),
        4 => street_minimum_buckets(street),
        _ => solution_minimum_buckets(street),
    }
}

// ---- streets

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "pattern", "dp", "fold", "street", "solution"];
    let pieces = [".", "H.", ".H", "H.H", ".H.H.", "..H"];
    let mut seed = 2086;
    let mut streets: Vec[String] = Vec.new();
    for t in 0..340 {
        let mut s = String.new();
        if t < 300 {
            let n = next_random(mut seed) % 12 + 1;
            let odds = next_random(mut seed) % 6 + 2;
            for _ in 0..n {
                s.push(if next_random(mut seed) % 10 < odds { 'H' } else { '.' });
            }
        } else if t < 320 {
            let n = next_random(mut seed) % 12 + 1;
            s = ".".repeat(n);
        } else {
            let k = next_random(mut seed) % 4 + 1;
            for _ in 0..k {
                s.push_str(pieces[next_random(mut seed) % 6]);
            }
        }
        streets.push(s);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for s in streets.iter() {
        let truth = literal(s);
        check = (check * 31 + truth + 1) % 1000000007;
        let reversed: String = s.chars().rev().collect();
        let blocked = s == "H" or s.starts_with("HH") or s.ends_with("HH") or s.contains("HHH");
        let hamsters = s.chars().filter(|c| c == 'H').count();
        let fewer = s.replacen("H", ".", 1);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, s)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, reversed) == x,
                (x == -1) == blocked,
                x == -1 or (x >= (hamsters + 1) / 2 and x <= hamsters),
                x == -1 or answer(arm, fewer) <= x,
                same >= 3,
            ];
            for p in 0..6 {
                checks += 1;
                if not verdicts[p] {
                    by_property[p] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{s} arm {names[arm]}: P{p + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{streets.len()} streets: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for p in 0..6 {
            if by_property[p] > 0 {
                println(f"P{p + 1} {by_property[p]}");
            }
        }
    }
}
