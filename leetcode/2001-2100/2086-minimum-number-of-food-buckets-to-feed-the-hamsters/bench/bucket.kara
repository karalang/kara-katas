// LeetCode #2086: Minimum Number of Food Buckets to Feed the Hamsters --
// the ★ arm as a benchmark. One street of 10^6 cells put together from
// pieces that can each be served, and 3000 windows of 10^5 cells at random
// places in it, each a view into the street, served by the greedy: up to
// 3 · 10^8 cells walked.

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn minimum_buckets(hamsters: Str) -> i64 {
    let cells = hamsters.bytes();
    let n = cells.len();
    let mut bucket: Vec[bool] = Vec.filled(n, false);
    let mut count = 0;
    for i in 0..n {
        if cells[i] != b'H' {
            continue;
        }
        if i > 0 and bucket[i - 1] {
            continue;
        }
        if i + 1 < n and cells[i + 1] == b'.' {
            bucket[i + 1] = true;
            count += 1;
        } else if i > 0 and cells[i - 1] == b'.' {
            bucket[i - 1] = true;
            count += 1;
        } else {
            return -1;
        }
    }
    count
}

fn main() {
    let pieces = [".", "H.", ".H", "H.H", ".H.H.", "..H"];
    let mut seed = 2086;
    let mut street = String.new();
    while street.len() < 1000000 {
        street.push_str(pieces[next_random(mut seed) % 6]);
    }
    let mut total = 0;
    let mut impossible = 0;
    let mut check = 0;
    for _ in 0..3000 {
        let from = (next_random(mut seed) * 32768 + next_random(mut seed)) % 900000;
        let a = minimum_buckets(street[from..from + 100000]);
        if a < 0 {
            impossible += 1;
        } else {
            total += a;
        }
        check = (check * 31 + a + 1) % 1000000007;
    }
    println(f"3000 windows: sum {total}, {impossible} impossible, checksum {check}");
}
