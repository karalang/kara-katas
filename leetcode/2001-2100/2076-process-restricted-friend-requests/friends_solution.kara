// LeetCode #2076: Process Restricted Friend Requests -- LeetCode's Rust
// template (`n: i32`, `Vec<Vec<i32>>`, `as usize` casts, a nested `fn
// find(p: &mut Vec<usize>, x: usize)` with path compression, `(u, v)`
// destructured, `||` and `&&`), carried by `karac fix`. The adapter below
// hands the harness's problems to it.

fn find(p: mut ref Vec[usize], x: usize) -> usize {
    if p[x] != x {
        let px = p[x];
        p[x] = find(mut p, px);
    }
    p[x]
}

impl Solution {
    pub fn friend_requests(n: i32, restrictions: Vec[Vec[i32]], requests: Vec[Vec[i32]]) -> Vec[bool] {
        let mut p: Vec[usize] = (0..n as usize).collect();
        let mut ans = Vec.with_capacity(requests.len());
        for req in requests.iter() {
            let (u, v) = (find(mut p, req[0] as usize), find(mut p, req[1] as usize));
            if u == v {
                ans.push(true);
                continue;
            }
            let mut ok = true;
            for r in restrictions.iter() {
                let (x, y) = (find(mut p, r[0] as usize), find(mut p, r[1] as usize));
                if (x == u and y == v) or (x == v and y == u) {
                    ok = false;
                    break;
                }
            }
            if ok {
                p[u] = v;
            }
            ans.push(ok);
        }
        ans
    }
}

struct Solution {}

fn friend_requests(n: i64, restrictions: Vec[Vec[i64]], requests: Vec[Vec[i64]]) -> Vec[bool] {
    let r32: Vec[Vec[i32]] = restrictions.iter().map(|p| p.iter().map(|x| x as i32).collect()).collect();
    let q32: Vec[Vec[i32]] = requests.iter().map(|p| p.iter().map(|x| x as i32).collect()).collect();
    Solution.friend_requests(n as i32, r32, q32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `count` pairs of two different people of `n`
fn random_pairs(n: i64, count: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut pairs: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let a = next_random(mut seed) % n;
        let b = (a + 1 + next_random(mut seed) % (n - 1)) % n;
        pairs.push([a, b].to_vec());
    }
    pairs
}

fn show_pairs(pairs: Vec[Vec[i64]]) -> String {
    let parts: Vec[String] = pairs.iter().map(|p| f"[{p[0]},{p[1]}]").collect();
    f"[{parts.join(",")}]"
}

fn show_answers(answers: Vec[bool]) -> String {
    let parts: Vec[String] = answers.iter().map(|a| f"{a}").collect();
    f"[{parts.join(",")}]"
}

fn fold(answers: Vec[bool], check: i64) -> (i64, i64) {
    let mut c = check;
    let mut yes = 0;
    for a in answers.iter() {
        let bit = if a { 1 } else { 0 };
        yes += bit;
        c = (c * 3 + bit + 1) % 1000000007;
    }
    (yes, c)
}

fn main() {
    // LeetCode's three examples, then a few more
    let examples: Vec[(i64, Vec[Vec[i64]], Vec[Vec[i64]])] = [
        (3, [[0, 1].to_vec()].to_vec(), [[0, 2].to_vec(), [2, 1].to_vec()].to_vec()),
        (3, [[0, 1].to_vec()].to_vec(), [[1, 2].to_vec(), [0, 2].to_vec()].to_vec()),
        (5, [[0, 1].to_vec(), [1, 2].to_vec(), [2, 3].to_vec()].to_vec(),
            [[0, 4].to_vec(), [1, 2].to_vec(), [3, 1].to_vec(), [3, 4].to_vec()].to_vec()),
        (2, Vec.new(), [[0, 1].to_vec(), [1, 0].to_vec()].to_vec()),
        (2, [[1, 0].to_vec()].to_vec(), [[0, 1].to_vec(), [0, 1].to_vec()].to_vec()),
        (4, [[0, 3].to_vec()].to_vec(), [[0, 1].to_vec(), [2, 3].to_vec(), [1, 2].to_vec(), [0, 2].to_vec(), [1, 3].to_vec()].to_vec()),
        (6, [[0, 5].to_vec(), [1, 4].to_vec()].to_vec(),
            [[0, 1].to_vec(), [4, 5].to_vec(), [2, 3].to_vec(), [1, 2].to_vec(), [3, 4].to_vec(), [0, 3].to_vec(), [2, 5].to_vec()].to_vec()),
    ].to_vec();
    for (n, restrictions, requests) in examples.iter() {
        let answers = friend_requests(n, restrictions, requests);
        println(f"n = {n}, {show_pairs(restrictions)}, {show_pairs(requests)} -> {show_answers(answers)}");
    }
    // 300 random problems of 2 to 60 people, 0 to 40 restrictions and 1 to
    // 80 requests
    let mut seed = 2076;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 59 + 2;
        let restrictions = random_pairs(n, next_random(mut seed) % 41, mut seed);
        let requests = random_pairs(n, next_random(mut seed) % 80 + 1, mut seed);
        let (yes, c) = fold(friend_requests(n, restrictions, requests), check);
        total += yes;
        check = c;
    }
    println(f"300 problems: {total} accepted, checksum {check}");
    // the largest the constraints allow: 1000 people, 1000 restrictions and
    // 1000 requests
    let restrictions = random_pairs(1000, 1000, mut seed);
    let requests = random_pairs(1000, 1000, mut seed);
    let (yes, c) = fold(friend_requests(1000, restrictions, requests), 0);
    println(f"1000 people: {yes} accepted, checksum {c}");
}
