// LeetCode #2099: Find Subsequence of Length K With the Largest Sum -- the
// differential. The six arms, against the statement read literally: every
// choice of `k` positions tried, the largest sum kept, and of choices with
// that sum the one whose positions come first, the rule every arm follows
// for equal numbers. 300 random lists of 1 to 10 numbers from -3 to 3, so
// that equal numbers are common; then 20 lists of 1 to 10 copies of one
// number; then 20 lists of 1 to 12 numbers from -49000 to 49000; each
// with a random `k`, every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer is `k` numbers of the list in its order, summing to the
//     `k` largest
// P3  the list reversed: an answer with the same sum
// P4  every number 1000 more: the answer with every number 1000 more
// P5  every number doubled: the answer doubled
// P6  each arm agrees with at least three of the other five

// ---- largest_sum.kara: the ★ arm, positions sorted by value
fn star_max_subsequence(nums: Vec[i64], k: i64) -> Vec[i64] {
    let mut order: Vec[i64] = (0..nums.len()).collect();
    order.sort_by(|a, b| nums[b].cmp(nums[a]).then(a.cmp(b)));
    let mut chosen = order[..k].to_vec();
    chosen.sort();
    chosen.iter().map(|i| nums[i]).collect()
}

// ---- largest_sum_threshold.kara: the k-th largest value as a threshold
fn threshold_max_subsequence(nums: Vec[i64], k: i64) -> Vec[i64] {
    let mut sorted = nums.to_vec();
    sorted.sort();
    let t = sorted[sorted.len() - k];
    let above = nums.iter().filter(|x| x > t).count();
    let mut equal_left = k - above;
    let mut out: Vec[i64] = Vec.new();
    for x in nums.iter() {
        if x > t {
            out.push(x);
        } else if x == t and equal_left > 0 {
            out.push(x);
            equal_left -= 1;
        }
    }
    out
}

// ---- largest_sum_heap.kara: one pass keeping the k best in a heap
fn heap_max_subsequence(nums: Vec[i64], k: i64) -> Vec[i64] {
    let mut best: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    for i in 0..nums.len() {
        best.push((nums[i], -i));
        if best.len() > k {
            best.pop();
        }
    }
    let mut at: Vec[i64] = Vec.new();
    while let Some((_, neg)) = best.pop() {
        at.push(-neg);
    }
    at.sort();
    at.iter().map(|i| nums[i]).collect()
}

// ---- largest_sum_pick.kara: k picks of the largest left
fn pick_max_subsequence(nums: Vec[i64], k: i64) -> Vec[i64] {
    let mut taken = Vec.filled(nums.len(), false);
    for _ in 0..k {
        let mut best = -1;
        for i in 0..nums.len() {
            if not taken[i] and (best < 0 or nums[i] > nums[best]) {
                best = i;
            }
        }
        taken[best] = true;
    }
    (0..nums.len()).filter(|i| taken[i]).map(|i| nums[i]).collect()
}

// ---- largest_sum_ranked.kara: a `struct Ranked` with its own `Ord`
struct RankedRanked {
    value: i64,
    at: i64,
}

impl PartialEq for RankedRanked {
    fn eq(ref self, other: ref RankedRanked) -> bool {
        self.value == other.value and self.at == other.at
    }
}

impl Eq for RankedRanked {}

impl PartialOrd for RankedRanked {
    fn partial_cmp(ref self, other: ref RankedRanked) -> Option[Ordering] {
        Some(self.cmp(other))
    }
}

impl Ord for RankedRanked {
    fn cmp(ref self, other: ref RankedRanked) -> Ordering {
        other.value.cmp(self.value).then(self.at.cmp(other.at))
    }
}

fn ranked_max_subsequence(nums: Vec[i64], k: i64) -> Vec[i64] {
    let mut ranked: Vec[RankedRanked] = (0..nums.len()).map(|i| RankedRanked { value: nums[i], at: i }).collect();
    ranked.sort();
    ranked.truncate(k);
    ranked.sort_by_key(|r| r.at);
    ranked.iter().map(|r| r.value).collect()
}

// ---- largest_sum_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl SolutionSolution {
    pub fn max_subsequence(nums: Vec[i32], k: i32) -> Vec[i32] {
        let mut idx: Vec[i64] = (0..nums.len()).collect();
        idx.sort_by(|a, b| (nums[b]).cmp(nums[a]));
        idx.truncate(k as i64);
        idx.sort();
        idx.iter().map(|i| nums[i]).collect()
    }
}

struct SolutionSolution {}

fn solution_max_subsequence(nums: Vec[i64], k: i64) -> Vec[i64] {
    let v: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    SolutionSolution.max_subsequence(v, k as i32).iter().map(|x| x as i64).collect()
}

// ---- the statement read literally

fn literal(nums: Vec[i64], k: i64) -> Vec[i64] {
    let n = nums.len();
    let mut best_sum = 0;
    let mut best: Vec[i64] = Vec.new();
    for mask in 0..(1 << n) {
        let at: Vec[i64] = (0..n).filter(|i| (mask >> i) & 1 == 1).collect();
        if at.len() != k {
            continue;
        }
        let sum: i64 = at.iter().map(|i| nums[i]).sum();
        if best.len() == 0 or sum > best_sum or (sum == best_sum and at < best) {
            best_sum = sum;
            best = at;
        }
    }
    best.iter().map(|i| nums[i]).collect()
}

fn in_order(nums: Vec[i64], sub: Vec[i64]) -> bool {
    let mut at = 0;
    for x in nums.iter() {
        if at < sub.len() and sub[at] == x {
            at += 1;
        }
    }
    at == sub.len()
}

fn answer(arm: i64, nums: Vec[i64], k: i64) -> Vec[i64] {
    match arm {
        0 => star_max_subsequence(nums, k),
        1 => threshold_max_subsequence(nums, k),
        2 => heap_max_subsequence(nums, k),
        3 => pick_max_subsequence(nums, k),
        4 => ranked_max_subsequence(nums, k),
        _ => solution_max_subsequence(nums, k),
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let names = ["star", "threshold", "heap", "pick", "ranked", "solution"];
    let mut seed = 2099;
    let mut problems: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..340 {
        let mut nums: Vec[i64] = Vec.new();
        if t < 300 {
            let n = next_random(mut seed) % 10 + 1;
            for _ in 0..n {
                nums.push(next_random(mut seed) % 7 - 3);
            }
        } else if t < 320 {
            let n = next_random(mut seed) % 10 + 1;
            let v = next_random(mut seed) % 21 - 10;
            for _ in 0..n {
                nums.push(v);
            }
        } else {
            let n = next_random(mut seed) % 12 + 1;
            for _ in 0..n {
                nums.push(wide_random(mut seed) % 98001 - 49000);
            }
        }
        let k = next_random(mut seed) % nums.len() + 1;
        problems.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (nums, k) in problems.iter() {
        let truth = literal(nums, k);
        for x in truth.iter() {
            check = (check * 31 + x + 100000) % 1000000007;
        }
        check = (check * 31 + 7) % 1000000007;
        let mut sorted = nums.to_vec();
        sorted.sort();
        let top: i64 = sorted[sorted.len() - k..].iter().sum();
        let mut reversed = nums.to_vec();
        reversed.reverse();
        let raised: Vec[i64] = nums.iter().map(|x| x + 1000).collect();
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        for arm in 0..6 {
            let x = got[arm].to_vec();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let sum: i64 = x.iter().sum();
            let back: i64 = answer(arm, reversed, k).iter().sum();
            let x_raised: Vec[i64] = x.iter().map(|v| v + 1000).collect();
            let x_doubled: Vec[i64] = x.iter().map(|v| 2 * v).collect();
            let verdicts = [
                x == truth,
                x.len() == k and in_order(nums, x) and sum == top,
                back == top,
                answer(arm, raised, k) == x_raised,
                answer(arm, doubled, k) == x_doubled,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} k={k} arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} lists: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
