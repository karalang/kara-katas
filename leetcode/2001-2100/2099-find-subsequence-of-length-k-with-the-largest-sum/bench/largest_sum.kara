// LeetCode #2099: Find Subsequence of Length K With the Largest Sum -- the
// ★ arm's benchmark: 20000 lists of 1000 numbers from -10^5 to 10^5, the
// constraints' largest, each asked for a random `k` and answered by
// sorting the positions by value, larger first and earlier first among
// equals, and the first `k` back into order. Every number of every answer
// goes into the checksum.

fn max_subsequence(nums: Vec[i64], k: i64) -> Vec[i64] {
    let mut order: Vec[i64] = (0..nums.len()).collect();
    order.sort_by(|a, b| nums[b].cmp(nums[a]).then(a.cmp(b)));
    let mut chosen = order[..k].to_vec();
    chosen.sort();
    chosen.iter().map(|i| nums[i]).collect()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    let mut seed = 2099;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..20000 {
        let nums: Vec[i64] = (0..1000).map(|_| wide_random(mut seed) % 200001 - 100000).collect();
        let k = next_random(mut seed) % 1000 + 1;
        let got = max_subsequence(nums, k);
        total += got.len();
        for x in got.iter() {
            check = (check * 31 + x + 100000) % 1000000007;
        }
    }
    println(f"20000 answers: {total} numbers, checksum {check}");
}
