// LeetCode #2078: Two Furthest Houses With Different Colors -- the ★ arm's
// benchmark (houses.kara): 20000 streets of 100 houses, all of color 0 but
// for two houses of color 1 to 3, then 1000 rounds, each recoloring one
// house of every street, 0 or 1 to 3, and answering every street with the
// ★ arm's scan in from each end: an answer for
// every street that still has two colors.

fn max_distance(colors: Vec[i64]) -> i64 {
    let n = colors.len();
    let mut j = n - 1;
    while colors[j] == colors[0] {
        j -= 1;
    }
    let mut i = 0;
    while colors[i] == colors[n - 1] {
        i += 1;
    }
    j.max(n - 1 - i)
}

// ---- benchmark -------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2078;
    let mut streets: Vec[Vec[i64]] = Vec.new();
    for _ in 0..20000 {
        let mut colors = Vec.filled(100, 0);
        let a = next_random(mut seed) % 100;
        colors[a] = next_random(mut seed) % 3 + 1;
        let b = next_random(mut seed) % 100;
        colors[b] = next_random(mut seed) % 3 + 1;
        streets.push(colors);
    }
    let mut total = 0;
    let mut check = 0;
    let mut answered = 0;
    for _ in 0..1000 {
        for colors in streets.iter_mut() {
            let k = next_random(mut seed) % 100;
            colors[k] = if next_random(mut seed) % 2 == 0 { 0 } else { next_random(mut seed) % 3 + 1 };
            let mixed = colors.iter().any(|c| c != colors[0]);
            if mixed {
                let a = max_distance(colors);
                answered += 1;
                total += a;
                check = (check * 31 + a) % 1000000007;
            }
        }
    }
    println(f"{answered} answers: sum {total}, checksum {check}");
}
