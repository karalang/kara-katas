// LeetCode #2077: Paths in Maze That Lead to Same Room -- by pairs: the
// corridors as a `Set` of `(low, high)` tuples, and for each room every
// pair of the rooms above it asked whether a corridor joins them. Each
// triangle is met at its lowest room. O(Σ d²).

fn number_of_paths(n: i64, corridors: Vec[Vec[i64]]) -> i64 {
    let mut joined: Set[(i64, i64)] = Set.new();
    let mut up: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for c in corridors.iter() {
        let (a, b) = (c[0].min(c[1]), c[0].max(c[1]));
        joined.insert((a, b));
        up[a].push(b);
    }
    let mut count = 0;
    for rooms in up.iter() {
        for (i, x) in rooms.iter().enumerate() {
            for y in rooms[i + 1..].iter() {
                if joined.contains((x.min(y), x.max(y))) {
                    count += 1;
                }
            }
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// up to `count` corridors between rooms 1 to `n`, no two alike, each drawn
// as a pair of rooms with the second taken from `n` or from `near` rooms on
fn random_maze(n: i64, count: i64, near: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut seen: Set[i64] = Set.new();
    let mut corridors: Vec[Vec[i64]] = Vec.new();
    for _ in 0..count {
        let a = next_random(mut seed) % n + 1;
        let step = next_random(mut seed) % near.min(n - 1) + 1;
        let b = (a - 1 + step) % n + 1;
        let key = a.min(b) * 100000 + a.max(b);
        if not seen.contains(key) {
            seen.insert(key);
            corridors.push(if next_random(mut seed) % 2 == 0 { [a, b].to_vec() } else { [b, a].to_vec() });
        }
    }
    corridors
}

fn show(corridors: Vec[Vec[i64]]) -> String {
    let parts: Vec[String] = corridors.iter().map(|c| f"[{c[0]},{c[1]}]").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    // LeetCode's two examples, then a few more
    let examples: Vec[(i64, Vec[Vec[i64]])] = [
        (5, [[1, 2].to_vec(), [5, 2].to_vec(), [4, 1].to_vec(), [2, 4].to_vec(), [3, 1].to_vec(), [3, 4].to_vec()].to_vec()),
        (4, [[1, 2].to_vec(), [3, 4].to_vec()].to_vec()),
        (3, [[1, 2].to_vec(), [2, 3].to_vec(), [3, 1].to_vec()].to_vec()),
        (2, [[1, 2].to_vec()].to_vec()),
        (4, [[1, 2].to_vec(), [1, 3].to_vec(), [1, 4].to_vec(), [2, 3].to_vec(), [2, 4].to_vec(), [3, 4].to_vec()].to_vec()),
        (5, [[1, 2].to_vec(), [2, 3].to_vec(), [3, 4].to_vec(), [4, 5].to_vec(), [5, 1].to_vec()].to_vec()),
        (6, [[6, 1].to_vec(), [1, 5].to_vec(), [5, 6].to_vec(), [2, 3].to_vec(), [3, 4].to_vec(), [4, 2].to_vec(), [1, 2].to_vec()].to_vec()),
    ].to_vec();
    for (n, corridors) in examples.iter() {
        println(f"n = {n}, {show(corridors)} -> {number_of_paths(n, corridors)}");
    }
    // 300 random mazes of 2 to 60 rooms and up to 200 corridors, each
    // corridor to a room up to 3, 10 or 60 on
    let mut seed = 2077;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..300 {
        let n = next_random(mut seed) % 59 + 2;
        let count = next_random(mut seed) % 201;
        let near = [3, 10, 60][next_random(mut seed) % 3];
        let corridors = random_maze(n, count, near, mut seed);
        let a = number_of_paths(n, corridors);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"300 mazes: sum {total}, checksum {check}");
    // the largest the constraints allow: 1000 rooms and 50000 corridors,
    // each to a room up to 60 on
    let corridors = random_maze(1000, 60000, 60, mut seed);
    println(f"1000 rooms, {corridors.len()} corridors -> {number_of_paths(1000, corridors)}");
}
