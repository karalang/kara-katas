// LeetCode #2092: Find All People With Secret -- LeetCode's Rust template
// (`n: i32, meetings: Vec<Vec<i32>>, first_person: i32`, the meetings
// sorted in place by `sort_by_key(|m| m[2])`, a recursive `find` over a
// `Vec<usize>`), carried by `karac fix`. The adapter below hands the
// harness's meetings to it.

fn find(parent: mut ref Vec[usize], x: usize) -> usize {
    if parent[x] != x {
        let r = find(mut parent, parent[x]);
        parent[x] = r;
    }
    parent[x]
}

impl Solution {
    pub fn find_all_people(n: i32, meetings: own Vec[Vec[i32]], first_person: i32) -> Vec[i32] {
        let mut meetings = meetings;
        let n = n as usize;
        let mut parent: Vec[usize] = (0..n).collect();
        meetings.sort_by_key(|m| m[2]);
        parent[first_person as usize] = 0;
        let mut i = 0;
        while i < meetings.len() {
            let mut j = i;
            while j < meetings.len() and meetings[j][2] == meetings[i][2] {
                let a = find(mut parent, meetings[j][0] as usize);
                let b = find(mut parent, meetings[j][1] as usize);
                if a < b {
                    parent[b] = a;
                } else {
                    parent[a] = b;
                }
                j += 1;
            }
            for k in i..j {
                for p in [meetings[k][0] as usize, meetings[k][1] as usize] {
                    if find(mut parent, p) != 0 {
                        parent[p] = p;
                    }
                }
            }
            i = j;
        }
        let mut ans = Vec.new();
        for p in 0..n {
            if find(mut parent, p) == 0 {
                ans.push(p as i32);
            }
        }
        ans
    }
}

struct Solution {}

fn find_all_people(n: i64, meetings: Vec[(i64, i64, i64)], first_person: i64) -> Vec[i64] {
    let m: Vec[Vec[i32]] = meetings.iter().map(|(x, y, t)| [x as i32, y as i32, t as i32]).collect();
    Solution.find_all_people(n as i32, m, first_person as i32).iter().map(|p| p as i64).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    // LeetCode's three examples, then four more
    let examples = [
        (6, [(1, 2, 5), (2, 3, 8), (1, 5, 10)].to_vec(), 1),
        (4, [(3, 1, 3), (1, 2, 2), (0, 3, 3)].to_vec(), 3),
        (5, [(3, 4, 2), (1, 2, 1), (2, 3, 1)].to_vec(), 1),
        (2, Vec.new(), 1),
        (3, [(1, 2, 0)].to_vec(), 1),
        (4, [(2, 3, 1), (1, 2, 2)].to_vec(), 1),
        (5, [(1, 4, 3), (0, 4, 3)].to_vec(), 2),
    ];
    for (n, meetings, first) in examples.iter() {
        println(f"{n} people, first {first}, {meetings.len()} meetings -> {show(find_all_people(n, meetings, first))}");
    }
    // 2000 random gatherings of 2 to 60 people and up to 80 meetings at
    // times from 1 to 10
    let mut seed = 2092;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 59 + 2;
        let m = next_random(mut seed) % 81;
        let mut meetings: Vec[(i64, i64, i64)] = Vec.new();
        for _ in 0..m {
            let x = next_random(mut seed) % n;
            let y = (x + 1 + next_random(mut seed) % (n - 1)) % n;
            meetings.push((x, y, next_random(mut seed) % 10 + 1));
        }
        let first = next_random(mut seed) % (n - 1) + 1;
        let got = find_all_people(n, meetings, first);
        total += got.len();
        for p in got.iter() {
            check = (check * 31 + p + 1) % 1000000007;
        }
        check = (check * 31 + 1000) % 1000000007;
    }
    println(f"2000 gatherings: {total} people, checksum {check}");
    // the constraints' largest, 100000 people and 100000 meetings at random
    // times; then a chain whose times rise, and one whose times fall
    let n = 100000;
    let mut meetings: Vec[(i64, i64, i64)] = Vec.new();
    // two draws make one up to 2^30, as one stops at 2^15
    for _ in 0..100000 {
        let x = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
        let y = (x + 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % (n - 1)) % n;
        meetings.push((x, y, (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1));
    }
    let got = find_all_people(n, meetings, 1);
    let mut c = 0;
    for p in got.iter() {
        c = (c * 31 + p + 1) % 1000000007;
    }
    println(f"100000 people: {got.len()} know, checksum {c}");
    let rising: Vec[(i64, i64, i64)] = (1..n - 1).map(|i| (i, i + 1, i)).collect();
    let falling: Vec[(i64, i64, i64)] = (1..n - 1).map(|i| (i, i + 1, n - i)).collect();
    println(f"rising chain: {find_all_people(n, rising, 1).len()} know; falling chain: {find_all_people(n, falling, 1).len()} know");
}
