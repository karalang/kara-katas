// LeetCode #2092: Find All People With Secret -- the ★ arm as a benchmark.
// 10 gatherings of 100000 people and 100000 meetings, the constraints'
// limit, at 1000 times, each answered 4 times: 40 sorts of the meetings
// and union-find passes over them.

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn find(parent: mut ref Vec[i64], x: i64) -> i64 {
    let mut x = x;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn find_all_people(n: i64, meetings: Vec[(i64, i64, i64)], first_person: i64) -> Vec[i64] {
    let mut sorted = meetings.clone();
    sorted.sort_by_key(|(_, _, t)| t);
    let mut parent: Vec[i64] = (0..n).collect();
    parent[first_person] = 0;
    let mut i = 0;
    while i < sorted.len() {
        let mut j = i;
        while j < sorted.len() and sorted[j].2 == sorted[i].2 {
            let (x, y, _) = sorted[j];
            let (rx, ry) = (find(mut parent, x), find(mut parent, y));
            if rx < ry {
                parent[ry] = rx;
            } else {
                parent[rx] = ry;
            }
            j += 1;
        }
        for k in i..j {
            let (x, y, _) = sorted[k];
            if find(mut parent, x) != 0 {
                parent[x] = x;
            }
            if find(mut parent, y) != 0 {
                parent[y] = y;
            }
        }
        i = j;
    }
    let mut knows: Vec[i64] = Vec.new();
    for p in 0..n {
        if find(mut parent, p) == 0 {
            knows.push(p);
        }
    }
    knows
}

fn main() {
    let mut seed = 2092;
    let n = 100000;
    let mut gatherings: Vec[Vec[(i64, i64, i64)]] = Vec.new();
    for _ in 0..10 {
        let mut meetings: Vec[(i64, i64, i64)] = Vec.new();
        for _ in 0..100000 {
            let x = (next_random(mut seed) * 32768 + next_random(mut seed)) % n;
            let y = (x + 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % (n - 1)) % n;
            meetings.push((x, y, next_random(mut seed) % 1000 + 1));
        }
        gatherings.push(meetings);
    }
    let mut total = 0;
    let mut check = 0;
    for round in 0..4 {
        for g in 0..10 {
            let got = find_all_people(n, gatherings[g], round * 10 + g + 1);
            total += got.len();
            for p in got.iter() {
                check = (check * 31 + p) % 1000000007;
            }
        }
    }
    println(f"40 answers: {total} people, checksum {check}");
}
