// LeetCode #2073: Time Needed to Buy Tickets -- benchmark of the ★ arm
// (../tickets.kara): 20000 lines of 100 people wanting 1 to 100 tickets,
// built first, then every place in every line asked about, 2000000 answers.

fn time_required_to_buy(tickets: Vec[i64], k: i64) -> i64 {
    let want = tickets[k];
    let mut time = 0;
    for (i, t) in tickets.iter().enumerate() {
        time += if i <= k { t.min(want) } else { t.min(want - 1) };
    }
    time
}

// ---- bench ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2073;
    let mut lines: Vec[Vec[i64]] = Vec.new();
    for _ in 0..20000 {
        let mut tickets: Vec[i64] = Vec.new();
        for _ in 0..100 {
            tickets.push(next_random(mut seed) % 100 + 1);
        }
        lines.push(tickets);
    }
    let mut total = 0;
    let mut check = 0;
    for tickets in lines.iter() {
        for k in 0..100 {
            let a = time_required_to_buy(tickets, k);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
    }
    println(f"2000000 answers: sum {total}, checksum {check}");
}
