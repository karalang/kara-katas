// LeetCode #2088: Count Fertile Pyramids in a Land -- the differential.
// The six arms, against the statement read literally: every cell as an
// apex, every height from 2, either way, kept when every cell of the plot
// lies in the land and is fertile. 300 random lands of 1 to 7 rows and
// columns, 5 to 9 cells in 10 fertile; then 20 all fertile, and 20 all
// barren; every one drawn before any arm answers.
//
// P1  the count is the statement read literally
// P2  the land upside down counts the same
// P3  the land mirrored, east for west, counts the same
// P4  the land with a barren row and column round it counts the same
// P5  the first barren cell made fertile counts no fewer
// P6  each arm agrees with at least three of the other five

// ---- pyramids.kara: the ★ arm, the tallest plot at each cell from the row before
// The plots apexed at each cell, the rows taken from `order` in turn, the
// row before in that order holding the cell's base.
fn star_count_one_way(grid: Vec[Vec[i64]], order: Vec[i64]) -> i64 {
    let n = grid[0].len();
    let mut below: Vec[i64] = Vec.filled(n, 0);
    let mut count = 0;
    for r in order.iter() {
        let mut tall: Vec[i64] = Vec.filled(n, 0);
        for c in 0..n {
            if grid[r][c] == 0 {
                continue;
            }
            tall[c] = if c == 0 or c == n - 1 {
                1
            } else {
                below[c - 1].min(below[c]).min(below[c + 1]) + 1
            };
            count += tall[c] - 1;
        }
        below = tall;
    }
    count
}

fn star_count_pyramids(grid: Vec[Vec[i64]]) -> i64 {
    let m = grid.len();
    let up: Vec[i64] = (0..m).rev().collect();
    let down: Vec[i64] = (0..m).collect();
    star_count_one_way(grid, up) + star_count_one_way(grid, down)
}

// ---- pyramids_table.kara: two full tables, bottom up and top down
fn table_count_pyramids(grid: Vec[Vec[i64]]) -> i64 {
    let (m, n) = (grid.len(), grid[0].len());
    let mut up: Vec[Vec[i64]] = grid.clone();
    let mut down: Vec[Vec[i64]] = grid.clone();
    let mut count = 0;
    for r in (0..m - 1).rev() {
        for c in 1..n - 1 {
            if up[r][c] == 1 {
                up[r][c] = up[r + 1][c - 1].min(up[r + 1][c]).min(up[r + 1][c + 1]) + 1;
                count += up[r][c] - 1;
            }
        }
    }
    for r in 1..m {
        for c in 1..n - 1 {
            if down[r][c] == 1 {
                down[r][c] = down[r - 1][c - 1].min(down[r - 1][c]).min(down[r - 1][c + 1]) + 1;
                count += down[r][c] - 1;
            }
        }
    }
    count
}

// ---- pyramids_grow.kara: each apex grown while `all()` the next span is fertile
fn grow_grown(grid: Vec[Vec[i64]], r: i64, c: i64, step: i64) -> i64 {
    let (m, n) = (grid.len(), grid[0].len());
    let mut count = 0;
    let mut i = 1;
    loop {
        let row = r + step * i;
        if row < 0 or row >= m or c - i < 0 or c + i >= n {
            break;
        }
        if not grid[row][c - i..=c + i].iter().all(|x| x == 1) {
            break;
        }
        count += 1;
        i += 1;
    }
    count
}

fn grow_count_pyramids(grid: Vec[Vec[i64]]) -> i64 {
    let mut count = 0;
    for r in 0..grid.len() {
        for c in 0..grid[0].len() {
            if grid[r][c] == 1 {
                count += grow_grown(grid, r, c, 1) + grow_grown(grid, r, c, -1);
            }
        }
    }
    count
}

// ---- pyramids_prefix.kara: each apex grown, a span tested by row prefix sums
fn prefix_count_pyramids(grid: Vec[Vec[i64]]) -> i64 {
    let (m, n) = (grid.len(), grid[0].len());
    let fertile: Vec[Vec[i64]] = grid.iter().map(|row| {
        let mut sums: Vec[i64] = Vec.filled(n + 1, 0);
        for c in 0..n {
            sums[c + 1] = sums[c] + row[c];
        }
        sums
    }).collect();
    let mut count = 0;
    for r in 0..m {
        for c in 0..n {
            if grid[r][c] == 0 {
                continue;
            }
            for step in [1, -1] {
                let mut i = 1;
                while r + step * i >= 0 and r + step * i < m and c - i >= 0 and c + i < n {
                    let row = r + step * i;
                    if fertile[row][c + i + 1] - fertile[row][c - i] != 2 * i + 1 {
                        break;
                    }
                    count += 1;
                    i += 1;
                }
            }
        }
    }
    count
}

// ---- pyramids_memo.kara: a memoised `tallest(r, c)`, the land flipped for the inverse
struct MemoLand {
    grid: Vec[Vec[i64]],
    memo: Map[(i64, i64), i64],
}

impl MemoLand {
    fn tallest(mut ref self, r: i64, c: i64) -> i64 {
        if self.grid[r][c] == 0 {
            return 0;
        }
        if r + 1 == self.grid.len() or c == 0 or c + 1 == self.grid[0].len() {
            return 1;
        }
        if let Some(h) = self.memo.get((r, c)) {
            return h;
        }
        let h = self.tallest(r + 1, c - 1).min(self.tallest(r + 1, c)).min(self.tallest(r + 1, c + 1)) + 1;
        self.memo.insert((r, c), h);
        h
    }

    fn pyramids(mut ref self) -> i64 {
        let mut count = 0;
        for r in 0..self.grid.len() {
            for c in 0..self.grid[0].len() {
                let h = self.tallest(r, c);
                if h > 1 {
                    count += h - 1;
                }
            }
        }
        count
    }
}

fn memo_count_pyramids(grid: Vec[Vec[i64]]) -> i64 {
    let mut land = MemoLand { grid: grid.clone(), memo: Map.new() };
    let mut flipped = MemoLand { grid: grid.iter().rev().cloned().collect(), memo: Map.new() };
    land.pyramids() + flipped.pyramids()
}

// ---- pyramids_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn count_pyramids(grid: Vec[Vec[i32]]) -> i32 {
        let m = grid.len();
        let n = grid[0].len();
        let mut f = grid.clone();
        let mut ans: i32 = 0;
        for i in (0..m - 1).rev() {
            for j in 1..n - 1 {
                if f[i][j] > 0 {
                    f[i][j] = f[i + 1][j - 1].min(f[i + 1][j]).min(f[i + 1][j + 1]) + 1;
                    ans += f[i][j] - 1;
                }
            }
        }
        let mut f = grid.clone();
        for i in 1..m {
            for j in 1..n - 1 {
                if f[i][j] > 0 {
                    f[i][j] = f[i - 1][j - 1].min(f[i - 1][j]).min(f[i - 1][j + 1]) + 1;
                    ans += f[i][j] - 1;
                }
            }
        }
        ans
    }
}

struct Solution {}

fn solution_count_pyramids(grid: Vec[Vec[i64]]) -> i64 {
    let g: Vec[Vec[i32]] = grid.iter().map(|r| r.iter().map(|x| x as i32).collect()).collect();
    Solution.count_pyramids(g)
}

// ---- the statement read literally

fn literal(grid: Vec[Vec[i64]]) -> i64 {
    let (m, n) = (grid.len(), grid[0].len());
    let mut count = 0;
    for r in 0..m {
        for c in 0..n {
            for h in 2..m + 1 {
                for step in [1, -1] {
                    let mut fertile = true;
                    for i in 0..h {
                        for x in c - i..c + i + 1 {
                            let row = r + step * i;
                            if row < 0 or row >= m or x < 0 or x >= n or grid[row][x] == 0 {
                                fertile = false;
                            }
                        }
                    }
                    if fertile {
                        count += 1;
                    }
                }
            }
        }
    }
    count
}

fn answer(arm: i64, grid: Vec[Vec[i64]]) -> i64 {
    match arm {
        0 => star_count_pyramids(grid),
        1 => table_count_pyramids(grid),
        2 => grow_count_pyramids(grid),
        3 => prefix_count_pyramids(grid),
        4 => memo_count_pyramids(grid),
        _ => solution_count_pyramids(grid),
    }
}

// ---- lands

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(grid: Vec[Vec[i64]]) -> String {
    let rows: Vec[String] = grid.iter().map(|r| {
        let cells: Vec[String] = r.iter().map(|x| f"{x}").collect();
        cells.join("")
    }).collect();
    rows.join("/")
}

fn main() {
    let names = ["star", "table", "grow", "prefix", "memo", "solution"];
    let mut seed = 2088;
    let mut lands: Vec[Vec[Vec[i64]]] = Vec.new();
    for t in 0..340 {
        let m = next_random(mut seed) % 7 + 1;
        let n = next_random(mut seed) % 7 + 1;
        let odds = if t < 300 { next_random(mut seed) % 5 + 5 } else if t < 320 { 10 } else { 0 };
        let land: Vec[Vec[i64]] = (0..m).map(|_| (0..n).map(|_| if next_random(mut seed) % 10 < odds { 1 } else { 0 }).collect()).collect();
        lands.push(land);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for g in lands.iter() {
        let (m, n) = (g.len(), g[0].len());
        let truth = literal(g);
        check = (check * 31 + truth) % 1000000007;
        let upside: Vec[Vec[i64]] = g.iter().rev().cloned().collect();
        let mirrored: Vec[Vec[i64]] = g.iter().map(|r| r.iter().rev().cloned().collect()).collect();
        let mut framed: Vec[Vec[i64]] = Vec.new();
        framed.push(Vec.filled(n + 2, 0));
        for r in g.iter() {
            let mut row: Vec[i64] = Vec.new();
            row.push(0);
            row.extend(r.iter().cloned());
            row.push(0);
            framed.push(row);
        }
        framed.push(Vec.filled(n + 2, 0));
        let mut greener = g.clone();
        let mut done = false;
        for r in 0..m {
            for c in 0..n {
                if not done and greener[r][c] == 0 {
                    greener[r][c] = 1;
                    done = true;
                }
            }
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, g)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, upside) == x,
                answer(arm, mirrored) == x,
                answer(arm, framed) == x,
                answer(arm, greener) >= x,
                same >= 3,
            ];
            for p in 0..6 {
                checks += 1;
                if not verdicts[p] {
                    by_property[p] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{show(g)} arm {names[arm]}: P{p + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{lands.len()} lands: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for p in 0..6 {
            if by_property[p] > 0 {
                println(f"P{p + 1} {by_property[p]}");
            }
        }
    }
}
