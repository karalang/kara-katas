// LeetCode #2095: Delete the Middle Node of a Linked List -- LeetCode's
// Rust template (`Option<Box<ListNode>>` with `i32` values, the nodes
// counted through `&head` and `&node.next`, then `as_mut().unwrap()` down
// to the node before the middle and `take()` of its next), carried by
// `karac fix`. The harness converts its `i64` values at `build` and
// `values_of`.

// Definition for singly-linked list.
#[derive(PartialEq, Eq, Clone, Debug)]
pub struct ListNode {
    pub val: i32,
    pub next: Option[ListNode],
}

impl ListNode {
    #[inline]
    fn new(val: i32) -> Self {
        ListNode { next: None, val }
    }
}

struct Solution {}

impl Solution {
    pub fn delete_middle(head: own Option[ListNode]) -> Option[ListNode] {
        let mut n = 0;
        let mut cur = ref head;
        while let Some(node) = cur {
            n += 1;
            cur = ref node.next;
        }
        if n == 1 {
            return None;
        }
        let mut head = head;
        let mut cur = head.as_mut().unwrap();
        for _ in 0..n / 2 - 1 {
            cur = cur.next.as_mut().unwrap();
        }
        let middle = cur.next.take();
        cur.next = middle.unwrap().next;
        head
    }
}

fn delete_middle(head: own Option[ListNode]) -> Option[ListNode] {
    Solution.delete_middle(head)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn build(values: Vec[i64]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for v in values.iter().rev() {
        head = Some(ListNode { val: v as i32, next: head });
    }
    head
}

fn values_of(head: Option[ListNode]) -> Vec[i64] {
    let mut out = Vec.new();
    let mut cur = head;
    while let Some(node) = cur {
        out.push(node.val as i64);
        cur = node.next;
    }
    out
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(", ")}]"
}

fn checksum(v: Vec[i64]) -> i64 {
    v.iter().fold(0, |check, x| (check * 31 + x) % 1000000007)
}

fn main() {
    // LeetCode's three examples, then four more
    let examples: Vec[Vec[i64]] = [
        [1, 3, 4, 7, 1, 2, 6].to_vec(),
        [1, 2, 3, 4].to_vec(),
        [2, 1].to_vec(),
        [5].to_vec(),
        [1, 2, 3].to_vec(),
        [9, 9, 9, 9, 9].to_vec(),
        [10, 20, 30, 40, 50, 60].to_vec(),
    ].to_vec();
    for values in examples.iter() {
        println(f"{show(values)} -> {show(values_of(delete_middle(build(values))))}");
    }
    // 2000 random lists of 1 to 200 values from 1 to 10^5
    let mut seed = 2095;
    let mut check = 0;
    let mut kept = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 200 + 1;
        let values: Vec[i64] = (0..n).map(|_| (next_random(mut seed) * 32768 + next_random(mut seed)) % 100000 + 1).collect();
        let out = values_of(delete_middle(build(values)));
        kept += out.len();
        check = (check * 31 + checksum(out) + 1) % 1000000007;
    }
    println(f"2000 lists: {kept} values kept, checksum {check}");
    // the largest the constraints allow: 100000 values, then 99999
    for n in [100000, 99999] {
        let values: Vec[i64] = (0..n).map(|i| i + 1).collect();
        let out = values_of(delete_middle(build(values)));
        println(f"1 to {n}: {out.len()} kept, checksum {checksum(out)}, {out[n / 2 - 1]} then {out[n / 2]}");
    }
}
