// LeetCode #2095: Delete the Middle Node of a Linked List -- the
// differential. The five arms that check, against the statement read
// literally: the list's values with the one at index n / 2 left out. The
// Rust template's arm is blocked (see the README) and not here. 300 random
// lists of 1 to 12 values from 1 to 20; then 20 of one or two values, and
// 20 of 50 to 100; each with two more values to put round it, every one
// drawn before any arm answers.
//
// P1  the values left are the statement read literally
// P2  one value fewer is left
// P3  a value put before the list and one after it are both kept, round
//     the same values left
// P4  the list reversed: at an odd length the values left come out
//     reversed; at an even one, reversed back, they are the list without
//     the value just before the middle
// P5  deleting twice leaves the list without its two values from index
//     (n - 1) / 2
// P6  each arm agrees with at least two of the other four

shared struct ListNode {
    val: i64,
    mut next: Option[ListNode],
}

// ---- middle.kara: the ★ arm, a slow and a fast runner
fn star_delete_middle(head: Option[ListNode]) -> Option[ListNode] {
    let Some(first) = head else {
        return None;
    };
    let Some(second) = first.next else {
        return None;
    };
    let mut slow = first;
    let mut fast = second.next;
    while let Some(f) = fast {
        let Some(after) = f.next else {
            break;
        };
        slow = slow.next.unwrap();
        fast = after.next;
    }
    let middle = slow.next.unwrap();
    slow.next = middle.next;
    Some(first)
}

// ---- middle_count.kara: counted, then walked to the node before the middle
fn count_delete_middle(head: Option[ListNode]) -> Option[ListNode] {
    let mut n = 0;
    let mut cur = head;
    while let Some(node) = cur {
        n += 1;
        cur = node.next;
    }
    if n < 2 {
        return None;
    }
    let first = head.unwrap();
    let mut before = first;
    for _ in 0..n / 2 - 1 {
        before = before.next.unwrap();
    }
    before.next = before.next.unwrap().next;
    Some(first)
}

// ---- middle_values.kara: the values read out, one removed, a new list built
fn values_delete_middle(head: Option[ListNode]) -> Option[ListNode] {
    let mut values: Vec[i64] = Vec.new();
    let mut cur = head;
    while let Some(node) = cur {
        values.push(node.val);
        cur = node.next;
    }
    values.remove(values.len() / 2);
    let mut list: Option[ListNode] = None;
    for v in values.iter().rev() {
        list = Some(ListNode { val: v, next: list });
    }
    list
}

// ---- middle_rec.kara: a recursive `length` and `cut`
fn rec_length(list: Option[ListNode]) -> i64 {
    match list {
        None => 0,
        Some(node) => 1 + rec_length(node.next),
    }
}

fn rec_cut(list: Option[ListNode], at: i64) -> Option[ListNode] {
    let node = list?;
    if at == 0 {
        return node.next;
    }
    node.next = rec_cut(node.next, at - 1);
    Some(node)
}

fn rec_delete_middle(head: Option[ListNode]) -> Option[ListNode] {
    let n = rec_length(head);
    rec_cut(head, n / 2)
}

// ---- middle_nodes.kara: the nodes collected by an `impl Iterator`, relinked by index
struct NodesNodes {
    cur: Option[ListNode],
}

impl Iterator for NodesNodes {
    type Item = ListNode;

    fn next(mut ref self) -> Option[ListNode] {
        let node = self.cur?;
        self.cur = node.next;
        Some(node)
    }
}

fn nodes_delete_middle(head: Option[ListNode]) -> Option[ListNode] {
    let nodes: Vec[ListNode] = NodesNodes { cur: head }.collect();
    let n = nodes.len();
    if n < 2 {
        return None;
    }
    nodes[n / 2 - 1].next = nodes[n / 2].next;
    Some(nodes[0])
}

// ---- the statement read literally

fn without(values: Vec[i64], at: Vec[i64]) -> Vec[i64] {
    let mut kept: Vec[i64] = Vec.new();
    for i in 0..values.len() {
        if not at.contains(i) {
            kept.push(values[i]);
        }
    }
    kept
}

fn literal(values: Vec[i64]) -> Vec[i64] {
    without(values, [values.len() / 2].to_vec())
}

fn build(values: Vec[i64]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for v in values.iter().rev() {
        head = Some(ListNode { val: v, next: head });
    }
    head
}

fn values_of(head: Option[ListNode]) -> Vec[i64] {
    let mut out = Vec.new();
    let mut cur = head;
    while let Some(node) = cur {
        out.push(node.val);
        cur = node.next;
    }
    out
}

fn delete(arm: i64, head: Option[ListNode]) -> Option[ListNode] {
    match arm {
        0 => star_delete_middle(head),
        1 => count_delete_middle(head),
        2 => values_delete_middle(head),
        3 => rec_delete_middle(head),
        _ => nodes_delete_middle(head),
    }
}

fn answer(arm: i64, values: Vec[i64]) -> Vec[i64] {
    values_of(delete(arm, build(values)))
}

// ---- lists

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    let names = ["star", "count", "values", "rec", "nodes"];
    let mut seed = 2095;
    let mut problems: Vec[(Vec[i64], i64, i64)] = Vec.new();
    for t in 0..340 {
        let mut n = next_random(mut seed) % 12 + 1;
        if t >= 300 and t < 320 {
            n = next_random(mut seed) % 2 + 1;
        } else if t >= 320 {
            n = next_random(mut seed) % 51 + 50;
        }
        let values: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 20 + 1).collect();
        let before = next_random(mut seed) % 20 + 1;
        let after = next_random(mut seed) % 20 + 1;
        problems.push((values, before, after));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (values, before, after) in problems.iter() {
        let n = values.len();
        let truth = literal(values);
        for v in truth.iter() {
            check = (check * 31 + v) % 1000000007;
        }
        check = (check * 31 + 1000) % 1000000007;
        let mut round = [before].to_vec();
        round.extend(values.iter().cloned());
        round.push(after);
        let reversed: Vec[i64] = values.iter().rev().cloned().collect();
        let got: Vec[Vec[i64]] = (0..5).map(|arm| answer(arm, values)).collect();
        for arm in 0..5 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..5 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let mut rounded = [before].to_vec();
            rounded.extend(x.iter().cloned());
            rounded.push(after);
            let back: Vec[i64] = answer(arm, reversed).iter().rev().cloned().collect();
            let flipped: Vec[i64] = x.iter().rev().cloned().collect();
            let turned = if n % 2 == 1 {
                answer(arm, reversed) == flipped
            } else {
                back == without(values, [n / 2 - 1].to_vec())
            };
            // the list keeps a node after one deletion only from two on
            let twice = n < 2 or values_of(delete(arm, delete(arm, build(values)))) == without(values, [(n - 1) / 2, (n - 1) / 2 + 1].to_vec());
            let verdicts = [
                x == truth,
                x.len() == n - 1,
                answer(arm, round) == rounded,
                turned,
                twice,
                same >= 2,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{show(values)} arm {names[arm]}: P{q + 1} fails, answer {show(x)}, literal {show(truth)}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} lists: checksum {check}, {checks} checks over 5 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
