// LeetCode #2060: Check if an Original String Exists Given Two Encoded
// Strings -- the ★ arm's benchmark (../original.kara): 2000 pairs of
// strings of up to 40 characters, runs of one to three digits each
// followed by `u` or `v`, so most of every search's states are visited
// before it answers.

fn possibly_equals(s1: String, s2: String) -> bool {
    let a: Vec[char] = s1.chars().collect();
    let b: Vec[char] = s2.chars().collect();
    let mut seen: Set[(i64, i64, i64)] = Set.new();
    search(a, b, 0, 0, 0, mut seen)
}

fn search(a: Vec[char], b: Vec[char], i: i64, j: i64, lead: i64, seen: mut ref Set[(i64, i64, i64)]) -> bool {
    if i == a.len() and j == b.len() {
        return lead == 0;
    }
    if seen.contains((i, j, lead)) {
        return false;
    }
    seen.insert((i, j, lead));
    if i < a.len() and a[i].is_ascii_digit() {
        let mut num = 0;
        let mut k = i;
        while k < a.len() and a[k].is_ascii_digit() {
            num = num * 10 + a[k].to_digit(10).unwrap();
            k += 1;
            if search(a, b, k, j, lead + num, mut seen) {
                return true;
            }
        }
        return false;
    }
    if j < b.len() and b[j].is_ascii_digit() {
        let mut num = 0;
        let mut k = j;
        while k < b.len() and b[k].is_ascii_digit() {
            num = num * 10 + b[k].to_digit(10).unwrap();
            k += 1;
            if search(a, b, i, k, lead - num, mut seen) {
                return true;
            }
        }
        return false;
    }
    if lead > 0 {
        return j < b.len() and search(a, b, i, j + 1, lead - 1, mut seen);
    }
    if lead < 0 {
        return i < a.len() and search(a, b, i + 1, j, lead + 1, mut seen);
    }
    i < a.len() and j < b.len() and a[i] == b[j] and search(a, b, i + 1, j + 1, 0, mut seen)
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// runs of 1 to 3 digits, each followed by `u` or `v`, up to 40 characters
fn dense(seed: mut ref i64) -> String {
    let mut s = String.new();
    loop {
        let mut run = String.new();
        let len = next_random(mut seed) % 3 + 1;
        for _ in 0..len {
            run.push((b'1' + (next_random(mut seed) % 9) as u8) as char);
        }
        let letter = if next_random(mut seed) % 2 == 0 { 'u' } else { 'v' };
        if s.len() + run.len() + 1 > 40 {
            return s;
        }
        s.push_str(run);
        s.push(letter);
    }
}

fn main() {
    let mut seed = 2060;
    let mut possible = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let s1 = dense(mut seed);
        let s2 = dense(mut seed);
        let ok = possibly_equals(s1, s2);
        if ok {
            possible += 1;
        }
        check = (check * 31 + if ok { 2 } else { 1 }) % 1000000007;
    }
    println(f"2000 pairs: {possible} possible, checksum {check}");
}
