// LeetCode #2060: Check if an Original String Exists Given Two Encoded
// Strings -- forward, cell by cell: `leads[i][j]` is every lead of `s1`
// over `s2` some reading reaches with `i` and `j` characters read. Every
// step reads more of one string or both, so filling the cells in order of
// `i`, then `j`, finishes each before any step leaves it. The strings can
// be read to the end with a lead of 0 exactly when the last cell holds 0.

fn digit_run(s: Slice[char], from: i64) -> Vec[(i64, i64)] {
    // each (end, number) a run of digits starting at `from` reads as
    let mut out: Vec[(i64, i64)] = Vec.new();
    let mut num = 0;
    let mut k = from;
    while k < s.len() and s[k].is_ascii_digit() {
        num = num * 10 + s[k].to_digit(10).unwrap();
        k += 1;
        out.push((k, num));
    }
    out
}

fn possibly_equals(s1: String, s2: String) -> bool {
    let a: Vec[char] = s1.chars().collect();
    let b: Vec[char] = s2.chars().collect();
    let (n, m) = (a.len(), b.len());
    let mut leads: Vec[Vec[Set[i64]]] = Vec.new();
    for _ in 0..=n {
        let mut row: Vec[Set[i64]] = Vec.new();
        for _ in 0..=m {
            row.push(Set.new());
        }
        leads.push(row);
    }
    leads[0][0].insert(0);
    for i in 0..=n {
        for j in 0..=m {
            let here: Vec[i64] = leads[i][j].iter().cloned().collect();
            for lead in here.iter() {
                if i < n and a[i].is_ascii_digit() {
                    for (k, num) in digit_run(a, i).iter() {
                        leads[k][j].insert(lead + num);
                    }
                } else if j < m and b[j].is_ascii_digit() {
                    for (k, num) in digit_run(b, j).iter() {
                        leads[i][k].insert(lead - num);
                    }
                } else if lead > 0 and j < m {
                    leads[i][j + 1].insert(lead - 1);
                } else if lead < 0 and i < n {
                    leads[i + 1][j].insert(lead + 1);
                } else if lead == 0 and i < n and j < m and a[i] == b[j] {
                    leads[i + 1][j + 1].insert(0);
                }
            }
        }
    }
    leads[n][m].contains(0)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters from the first `k` of the alphabet
fn letters(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'a' + (next_random(mut seed) % k) as u8) as char);
    }
    s
}

// Some pieces of `orig` replaced by their lengths, no digit run longer
// than three and no length with a 0 in it.
fn encode(orig: String, seed: mut ref i64) -> String {
    let mut out = String.new();
    let mut run = 0;
    let mut i = 0;
    while i < orig.len() {
        let piece = (next_random(mut seed) % 12 + 1).min(orig.len() - i);
        let text = f"{piece}";
        if next_random(mut seed) % 2 == 0 and not text.contains("0") and run + text.len() <= 3 {
            out.push_str(text);
            run += text.len();
        } else {
            out.push_str(orig.slice(i, i + piece));
            run = 0;
        }
        i += piece;
    }
    out
}

fn main() {
    // LeetCode's four examples, then a few more
    let examples = [
        ("internationalization", "i18n"),
        ("l123e", "44"),
        ("a5b", "c5b"),
        ("112s", "g841"),
        ("ab", "a2"),
        ("1", "z"),
        ("a", "b"),
        ("98u8v8v8v89u888u998v88u98v88u9v99u989v8u", "9v898u98v888v89v998u98v9v888u9v899v998u9"),
    ];
    for (s1, s2) in examples.iter() {
        println(f"{s1}, {s2} -> {possibly_equals(s1.to_string(), s2.to_string())}");
    }
    // 3000 pairs, each encoding a string of 1 to 40 letters from 1 to 3 of
    // the alphabet: the same string, another of its length, or the string
    // with one letter dropped or added
    let mut seed = 2060;
    let mut possible = 0;
    let mut check = 0;
    for t in 0..3000 {
        let n = next_random(mut seed) % 40 + 1;
        let k = next_random(mut seed) % 3 + 1;
        let orig = letters(n, k, mut seed);
        let mut other = if t % 3 == 0 {
            orig.clone()
        } else if t % 3 == 1 {
            letters(n, k, mut seed)
        } else {
            let at = next_random(mut seed) % n;
            if next_random(mut seed) % 2 == 0 {
                f"{orig.slice(0, at)}{orig.slice(at + 1, n)}"
            } else {
                f"{orig}{letters(1, k, mut seed)}"
            }
        };
        if other.is_empty() {
            other = letters(1, k, mut seed);
        }
        let s1 = encode(orig, mut seed);
        let s2 = encode(other, mut seed);
        let ok = possibly_equals(s1, s2);
        if ok {
            possible += 1;
        }
        check = (check * 31 + if ok { 2 } else { 1 }) % 1000000007;
    }
    println(f"3000 pairs: {possible} possible, checksum {check}");
}
