// LeetCode #2060: Check if an Original String Exists Given Two Encoded
// Strings -- each string read first into tokens: a letter, or a digit run
// with every length it can stand for (`"123"` is 1+2+3, 12+3, 1+23 or
// 123). The search then walks tokens, a run taken whole, and keeps every
// state's answer, true or false, in a `Map`.

enum Token {
    Letter(char),
    Lengths(Vec[i64]),
}

// every sum the run's digits make, split into numbers in every way
fn sums(digits: Slice[char]) -> Vec[i64] {
    if digits.is_empty() {
        return [0].to_vec();
    }
    let mut out: Vec[i64] = Vec.new();
    let mut num = 0;
    for k in 0..digits.len() {
        num = num * 10 + digits[k].to_digit(10).unwrap();
        for rest in sums(digits[k + 1..digits.len()]).iter() {
            if not out.contains(num + rest) {
                out.push(num + rest);
            }
        }
    }
    out
}

fn tokens(s: String) -> Vec[Token] {
    let chars: Vec[char] = s.chars().collect();
    let mut out: Vec[Token] = Vec.new();
    let mut i = 0;
    while i < chars.len() {
        if chars[i].is_ascii_digit() {
            let mut k = i;
            while k < chars.len() and chars[k].is_ascii_digit() {
                k += 1;
            }
            out.push(Token.Lengths(sums(chars[i..k])));
            i = k;
        } else {
            out.push(Token.Letter(chars[i]));
            i += 1;
        }
    }
    out
}

fn possibly_equals(s1: String, s2: String) -> bool {
    let a = tokens(s1);
    let b = tokens(s2);
    let mut memo: Map[(i64, i64, i64), bool] = Map.new();
    walk(a, b, 0, 0, 0, mut memo)
}

fn walk(a: Vec[Token], b: Vec[Token], i: i64, j: i64, lead: i64, memo: mut ref Map[(i64, i64, i64), bool]) -> bool {
    if let Some(known) = memo.get((i, j, lead)) {
        return known;
    }
    let answer = match (a.get(i), b.get(j)) {
        (None, None) => lead == 0,
        (Some(Token.Lengths(ls)), _) => ls.iter().any(|l| walk(a, b, i + 1, j, lead + l, mut memo)),
        (_, Some(Token.Lengths(ls))) => ls.iter().any(|l| walk(a, b, i, j + 1, lead - l, mut memo)),
        (_, Some(Token.Letter(_))) if lead > 0 => walk(a, b, i, j + 1, lead - 1, mut memo),
        (Some(Token.Letter(_)), _) if lead < 0 => walk(a, b, i + 1, j, lead + 1, mut memo),
        (Some(Token.Letter(x)), Some(Token.Letter(y))) => lead == 0 and x == y and walk(a, b, i + 1, j + 1, 0, mut memo),
        _ => false,
    };
    memo[(i, j, lead)] = answer;
    answer
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters from the first `k` of the alphabet
fn letters(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'a' + (next_random(mut seed) % k) as u8) as char);
    }
    s
}

// Some pieces of `orig` replaced by their lengths, no digit run longer
// than three and no length with a 0 in it.
fn encode(orig: String, seed: mut ref i64) -> String {
    let mut out = String.new();
    let mut run = 0;
    let mut i = 0;
    while i < orig.len() {
        let piece = (next_random(mut seed) % 12 + 1).min(orig.len() - i);
        let text = f"{piece}";
        if next_random(mut seed) % 2 == 0 and not text.contains("0") and run + text.len() <= 3 {
            out.push_str(text);
            run += text.len();
        } else {
            out.push_str(orig.slice(i, i + piece));
            run = 0;
        }
        i += piece;
    }
    out
}

fn main() {
    // LeetCode's four examples, then a few more
    let examples = [
        ("internationalization", "i18n"),
        ("l123e", "44"),
        ("a5b", "c5b"),
        ("112s", "g841"),
        ("ab", "a2"),
        ("1", "z"),
        ("a", "b"),
        ("98u8v8v8v89u888u998v88u98v88u9v99u989v8u", "9v898u98v888v89v998u98v9v888u9v899v998u9"),
    ];
    for (s1, s2) in examples.iter() {
        println(f"{s1}, {s2} -> {possibly_equals(s1.to_string(), s2.to_string())}");
    }
    // 3000 pairs, each encoding a string of 1 to 40 letters from 1 to 3 of
    // the alphabet: the same string, another of its length, or the string
    // with one letter dropped or added
    let mut seed = 2060;
    let mut possible = 0;
    let mut check = 0;
    for t in 0..3000 {
        let n = next_random(mut seed) % 40 + 1;
        let k = next_random(mut seed) % 3 + 1;
        let orig = letters(n, k, mut seed);
        let mut other = if t % 3 == 0 {
            orig.clone()
        } else if t % 3 == 1 {
            letters(n, k, mut seed)
        } else {
            let at = next_random(mut seed) % n;
            if next_random(mut seed) % 2 == 0 {
                f"{orig.slice(0, at)}{orig.slice(at + 1, n)}"
            } else {
                f"{orig}{letters(1, k, mut seed)}"
            }
        };
        if other.is_empty() {
            other = letters(1, k, mut seed);
        }
        let s1 = encode(orig, mut seed);
        let s2 = encode(other, mut seed);
        let ok = possibly_equals(s1, s2);
        if ok {
            possible += 1;
        }
        check = (check * 31 + if ok { 2 } else { 1 }) % 1000000007;
    }
    println(f"3000 pairs: {possible} possible, checksum {check}");
}
