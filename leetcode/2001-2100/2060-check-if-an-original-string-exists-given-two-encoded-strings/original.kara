// LeetCode #2060: Check if an Original String Exists Given Two Encoded
// Strings -- the ★ arm. A depth-first search over the state (place in
// `s1`, place in `s2`, how many letters `s1` has run ahead of `s2`). A
// digit run is read as each number its prefixes make; a lead is paid off
// one letter at a time by the other string; with no lead, two letters
// must be equal. A `Set` of the states tried keeps each to once: a state
// that led to an answer ended the search. O(n1 · n2 · 2000).

fn possibly_equals(s1: String, s2: String) -> bool {
    let a: Vec[char] = s1.chars().collect();
    let b: Vec[char] = s2.chars().collect();
    let mut seen: Set[(i64, i64, i64)] = Set.new();
    search(a, b, 0, 0, 0, mut seen)
}

fn search(a: Vec[char], b: Vec[char], i: i64, j: i64, lead: i64, seen: mut ref Set[(i64, i64, i64)]) -> bool {
    if i == a.len() and j == b.len() {
        return lead == 0;
    }
    if seen.contains((i, j, lead)) {
        return false;
    }
    seen.insert((i, j, lead));
    if i < a.len() and a[i].is_ascii_digit() {
        let mut num = 0;
        let mut k = i;
        while k < a.len() and a[k].is_ascii_digit() {
            num = num * 10 + a[k].to_digit(10).unwrap();
            k += 1;
            if search(a, b, k, j, lead + num, mut seen) {
                return true;
            }
        }
        return false;
    }
    if j < b.len() and b[j].is_ascii_digit() {
        let mut num = 0;
        let mut k = j;
        while k < b.len() and b[k].is_ascii_digit() {
            num = num * 10 + b[k].to_digit(10).unwrap();
            k += 1;
            if search(a, b, i, k, lead - num, mut seen) {
                return true;
            }
        }
        return false;
    }
    if lead > 0 {
        return j < b.len() and search(a, b, i, j + 1, lead - 1, mut seen);
    }
    if lead < 0 {
        return i < a.len() and search(a, b, i + 1, j, lead + 1, mut seen);
    }
    i < a.len() and j < b.len() and a[i] == b[j] and search(a, b, i + 1, j + 1, 0, mut seen)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `n` letters from the first `k` of the alphabet
fn letters(n: i64, k: i64, seed: mut ref i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push((b'a' + (next_random(mut seed) % k) as u8) as char);
    }
    s
}

// Some pieces of `orig` replaced by their lengths, no digit run longer
// than three and no length with a 0 in it.
fn encode(orig: String, seed: mut ref i64) -> String {
    let mut out = String.new();
    let mut run = 0;
    let mut i = 0;
    while i < orig.len() {
        let piece = (next_random(mut seed) % 12 + 1).min(orig.len() - i);
        let text = f"{piece}";
        if next_random(mut seed) % 2 == 0 and not text.contains("0") and run + text.len() <= 3 {
            out.push_str(text);
            run += text.len();
        } else {
            out.push_str(orig.slice(i, i + piece));
            run = 0;
        }
        i += piece;
    }
    out
}

fn main() {
    // LeetCode's four examples, then a few more
    let examples = [
        ("internationalization", "i18n"),
        ("l123e", "44"),
        ("a5b", "c5b"),
        ("112s", "g841"),
        ("ab", "a2"),
        ("1", "z"),
        ("a", "b"),
        ("98u8v8v8v89u888u998v88u98v88u9v99u989v8u", "9v898u98v888v89v998u98v9v888u9v899v998u9"),
    ];
    for (s1, s2) in examples.iter() {
        println(f"{s1}, {s2} -> {possibly_equals(s1.to_string(), s2.to_string())}");
    }
    // 3000 pairs, each encoding a string of 1 to 40 letters from 1 to 3 of
    // the alphabet: the same string, another of its length, or the string
    // with one letter dropped or added
    let mut seed = 2060;
    let mut possible = 0;
    let mut check = 0;
    for t in 0..3000 {
        let n = next_random(mut seed) % 40 + 1;
        let k = next_random(mut seed) % 3 + 1;
        let orig = letters(n, k, mut seed);
        let mut other = if t % 3 == 0 {
            orig.clone()
        } else if t % 3 == 1 {
            letters(n, k, mut seed)
        } else {
            let at = next_random(mut seed) % n;
            if next_random(mut seed) % 2 == 0 {
                f"{orig.slice(0, at)}{orig.slice(at + 1, n)}"
            } else {
                f"{orig}{letters(1, k, mut seed)}"
            }
        };
        if other.is_empty() {
            other = letters(1, k, mut seed);
        }
        let s1 = encode(orig, mut seed);
        let s2 = encode(other, mut seed);
        let ok = possibly_equals(s1, s2);
        if ok {
            possible += 1;
        }
        check = (check * 31 + if ok { 2 } else { 1 }) % 1000000007;
    }
    println(f"3000 pairs: {possible} possible, checksum {check}");
}
