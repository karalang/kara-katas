// LeetCode #2064: Minimized Maximum of Products Distributed to Any Store
// -- the differential. The six arms, against the statement read
// literally: every load from 1 up tried in turn, each type's products put
// into stores of that load one store at a time, until they fit in `n`.
// 300 random problems of 1 to 8 types, quantities up to 1, 10, 100 or
// 1000, from as many stores as types to ten times as many; then 20 with
// exactly as many stores as types and 20 with a store for every product;
// every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the types in reverse order have the same answer
// P3  one more store never raises the answer
// P4  every quantity doubled never lowers the answer and at most doubles
//     it
// P5  the answer is at least `ceil(total / n)` and at most the largest
//     quantity, which it is when there are as many stores as types
// P6  each arm agrees with at least three of the other five

// ---- stores.kara: the ★ arm, a binary search over the load
fn star_minimized_maximum(n: i64, quantities: Vec[i64]) -> i64 {
    let mut lo = 1;
    let mut hi = quantities.iter().max().unwrap();
    while lo < hi {
        let mid = (lo + hi) / 2;
        let mut need = 0;
        for q in quantities.iter() {
            need += (q + mid - 1) / mid;
        }
        if need <= n {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

// ---- stores_heap.kara: each spare store to the fullest type, a `PriorityQueue`
fn heap_minimized_maximum(n: i64, quantities: Vec[i64]) -> i64 {
    let mut heap: PriorityQueue[(i64, i64, i64)] = PriorityQueue.max_first();
    for q in quantities.iter() {
        heap.push((q, q, 1));
    }
    for _ in 0..n - quantities.len() {
        let (load, q, k) = heap.pop().unwrap();
        if load == 1 {
            return 1;
        }
        heap.push(((q + k) / (k + 1), q, k + 1));
    }
    let (load, _, _) = heap.peek().unwrap();
    load
}

// ---- stores_bits.kara: the largest load that does not fit, a bit at a time
fn bits_minimized_maximum(n: i64, quantities: Vec[i64]) -> i64 {
    let fits = |x: i64| quantities.iter().map(|q| (q + x - 1) / x).sum() <= n;
    let mut below = 0;
    for b in (0..17).rev() {
        let next = below + (1 << b);
        if next <= 100000 and not fits(next) {
            below = next;
        }
    }
    below + 1
}

// ---- stores_recursive.kara: the binary search as recursion over a `Slice`
fn recursive_stores_needed(quantities: Slice[i64], x: i64) -> i64 {
    quantities.iter().fold(0, |need, q| need + (q + x - 1) / x)
}

fn recursive_search(quantities: Slice[i64], n: i64, lo: i64, hi: i64) -> i64 {
    if lo == hi {
        return lo;
    }
    let mid = lo + (hi - lo) / 2;
    if recursive_stores_needed(quantities, mid) <= n {
        recursive_search(quantities, n, lo, mid)
    } else {
        recursive_search(quantities, n, mid + 1, hi)
    }
}

fn recursive_minimized_maximum(n: i64, quantities: Vec[i64]) -> i64 {
    let top = quantities.iter().max().unwrap();
    recursive_search(quantities, n, 1, top)
}

// ---- stores_jump.kara: up from the lower bound, a store fewer at a time
fn jump_minimized_maximum(n: i64, quantities: Vec[i64]) -> i64 {
    let total: i64 = quantities.iter().sum();
    let mut x = ((total + n - 1) / n).max(1);
    loop {
        let mut need = 0;
        let mut next = i64.MAX;
        for q in quantities.iter() {
            let c = (q + x - 1) / x;
            need += c;
            if c > 1 {
                next = next.min((q + c - 2) / (c - 1));
            }
        }
        if need <= n {
            return x;
        }
        x = next;
    }
}

// ---- stores_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn minimized_maximum(n: i32, quantities: Vec[i32]) -> i32 {
        let mut (l, r) = (1i32, *quantities.iter().max().unwrap());
        while l < r {
            let m = l + (r - l) / 2;
            let need: i32 = quantities.iter().map(|q| (q + m - 1) / m).sum();
            if need <= n {
                r = m;
            } else {
                l = m + 1;
            }
        }
        l
    }
}

struct Solution {}

fn solution_minimized_maximum(n: i64, quantities: Vec[i64]) -> i64 {
    let qs: Vec[i32] = quantities.iter().map(|q| q as i32).collect();
    Solution.minimized_maximum(n as i32, qs) as i64
}

// ---- the statement read literally

fn literal(n: i64, quantities: Vec[i64]) -> i64 {
    let mut x = 1;
    loop {
        let mut stores = 0;
        for q in quantities.iter() {
            let mut left = q;
            while left > 0 {
                left -= x.min(left);
                stores += 1;
            }
        }
        if stores <= n {
            return x;
        }
        x += 1;
    }
}

fn answer(arm: i64, n: i64, quantities: Vec[i64]) -> i64 {
    match arm {
        0 => star_minimized_maximum(n, quantities),
        1 => heap_minimized_maximum(n, quantities),
        2 => bits_minimized_maximum(n, quantities),
        3 => recursive_minimized_maximum(n, quantities),
        4 => jump_minimized_maximum(n, quantities),
        _ => solution_minimized_maximum(n, quantities),
    }
}

// ---- problems

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(qs: Vec[i64]) -> String {
    let parts: Vec[String] = qs.iter().map(|q| f"{q}").collect();
    f"[{parts.join(", ")}]"
}

fn main() {
    let names = ["star", "heap", "bits", "recursive", "jump", "solution"];
    let mut seed = 2064;
    let mut problems: Vec[(i64, Vec[i64])] = Vec.new();
    for t in 0..340 {
        let m = next_random(mut seed) % 8 + 1;
        let top = [1, 10, 100, 1000][next_random(mut seed) % 4];
        let mut qs: Vec[i64] = Vec.new();
        for _ in 0..m {
            qs.push(next_random(mut seed) % top + 1);
        }
        let n = if t < 300 {
            m + next_random(mut seed) % (9 * m + 1)
        } else if t < 320 {
            m
        } else {
            qs.iter().sum()
        };
        problems.push((n, qs));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (n, qs) in problems.iter() {
        let truth = literal(n, qs);
        check = (check * 31 + truth) % 1000000007;
        let back: Vec[i64] = qs.iter().rev().cloned().collect();
        let doubled: Vec[i64] = qs.iter().map(|q| 2 * q).collect();
        let total: i64 = qs.iter().sum();
        let top = qs.iter().max().unwrap();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, n, qs)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let twice = answer(arm, n, doubled);
            let verdicts = [
                x == truth,
                answer(arm, n, back) == x,
                answer(arm, n + 1, qs) <= x,
                twice >= x and twice <= 2 * x,
                x >= (total + n - 1) / n and x <= top and (n != qs.len() or x == top),
                same >= 3,
            ];
            for p in 0..6 {
                checks += 1;
                if not verdicts[p] {
                    by_property[p] += 1;
                    if failures.len() < 10 {
                        failures.push(f"n = {n}, {show(qs)} arm {names[arm]}: P{p + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} problems: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for p in 0..6 {
            if by_property[p] > 0 {
                println(f"P{p + 1} {by_property[p]}");
            }
        }
    }
}
