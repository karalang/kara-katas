// LeetCode #2081: Sum of k-Mirror Numbers -- by text. Each palindrome is
// its first half's `to_string()` and that text reversed, the middle digit
// not written twice when the length is odd, parsed back into a number;
// its base-`k` digits are written as a `String`, which must read the same
// reversed.

fn base_text(x: i64, k: i64) -> String {
    let mut text = String.new();
    let mut y = x;
    while y > 0 {
        text.push(char.from_digit((y % k) as u32, 10).unwrap());
        y /= k;
    }
    text
}

fn k_mirror(k: i64, n: i64) -> i64 {
    let mut sum = 0;
    let mut found = 0;
    let mut length = 1;
    while found < n {
        let half = (length + 1) / 2;
        let start = 10.pow((half - 1) as u32);
        for h in start..start * 10 {
            let front = h.to_string();
            let back: String = front.chars().rev().skip(length % 2).collect();
            let p = (i64.parse(front + ref back)).unwrap();
            let digits = base_text(p, k);
            let backwards: String = digits.chars().rev().collect();
            if digits == backwards {
                sum += p;
                found += 1;
                if found == n {
                    break;
                }
            }
        }
        length += 1;
    }
    sum
}

// ---- test harness ---------------------------------------------------------

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    // LeetCode's three examples, then four more
    let examples = [(2, 5), (3, 7), (7, 17), (4, 10), (9, 1), (6, 20), (8, 15)];
    for (k, n) in examples.iter() {
        println(f"k = {k}, n = {n} -> {k_mirror(k, n)}");
    }
    // every base, n from 1 to 20
    let mut total = 0;
    let mut check = 0;
    for k in 2..10 {
        for n in 1..21 {
            let a = k_mirror(k, n);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
    }
    println(f"160 answers: sum {total}, checksum {check}");
    // the constraints' largest n, in every base
    let largest: Vec[i64] = (2..10).map(|k| k_mirror(k, 30)).collect();
    println(f"n = 30: {show(largest)}");
}
