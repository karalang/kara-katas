// LeetCode #2081: Sum of k-Mirror Numbers -- the differential. The six
// arms, against the statement read literally: every number from 1 up,
// kept when its decimal text and its base-`k` digits each read the same
// backwards, and the first `n` kept summed. 300 random questions of a base
// from 2 to 9 and `n` from 1 to 12; then 20 whose `n` is below the base,
// and 20 that reach the 13th to 15th number in a base whose numbers stay
// small; every one drawn before any arm answers.
//
// P1  the sum is the statement read literally
// P2  the `n`th number, the sum less the sum of `n - 1`, is 1 for the
//     first and grows from each to the next
// P3  for `n` below the base and at most 9 the numbers are 1 to `n`, and
//     the sum is `n(n + 1) / 2`
// P4  the `n`th number reads the same backwards in base 10 and in base `k`
// P5  the `n`th number is a multiple of neither 10 nor `k`
// P6  each arm agrees with at least three of the other five

// ---- kmirror.kara: the ★ arm, decimal palindromes from their halves, tried in base `k`
fn star_is_mirror(x: i64, k: i64) -> bool {
    let mut digits: Vec[i64] = Vec.new();
    let mut y = x;
    while y > 0 {
        digits.push(y % k);
        y /= k;
    }
    let m = digits.len();
    for i in 0..m / 2 {
        if digits[i] != digits[m - 1 - i] {
            return false;
        }
    }
    true
}

fn star_k_mirror(k: i64, n: i64) -> i64 {
    let mut sum = 0;
    let mut found = 0;
    let mut length = 1;
    loop {
        let half = (length + 1) / 2;
        let start = 10.pow((half - 1) as u32);
        for h in start..start * 10 {
            let mut p = h;
            let mut rest = if length % 2 == 1 { h / 10 } else { h };
            while rest > 0 {
                p = p * 10 + rest % 10;
                rest /= 10;
            }
            if star_is_mirror(p, k) {
                sum += p;
                found += 1;
                if found == n {
                    return sum;
                }
            }
        }
        length += 1;
    }
}

// ---- kmirror_string.kara: the palindromes and the base-`k` digits as text
fn text_base_text(x: i64, k: i64) -> String {
    let mut text = String.new();
    let mut y = x;
    while y > 0 {
        text.push(char.from_digit((y % k) as u32, 10).unwrap());
        y /= k;
    }
    text
}

fn text_k_mirror(k: i64, n: i64) -> i64 {
    let mut sum = 0;
    let mut found = 0;
    let mut length = 1;
    while found < n {
        let half = (length + 1) / 2;
        let start = 10.pow((half - 1) as u32);
        for h in start..start * 10 {
            let front = h.to_string();
            let back: String = front.chars().rev().skip(length % 2).collect();
            let p = (i64.parse(front + ref back)).unwrap();
            let digits = text_base_text(p, k);
            let backwards: String = digits.chars().rev().collect();
            if digits == backwards {
                sum += p;
                found += 1;
                if found == n {
                    break;
                }
            }
        }
        length += 1;
    }
    sum
}

// ---- kmirror_next.kara: palindrome to palindrome, reversed in base `k`
fn next_digit_count(x: i64) -> i64 {
    let mut count = 0;
    let mut y = x;
    while y > 0 {
        count += 1;
        y /= 10;
    }
    count
}

fn next_next_palindrome(p: i64) -> i64 {
    let len = next_digit_count(p);
    let keep = (len + 1) / 2;
    let half = p / 10.pow((len - keep) as u32) + 1;
    if half == 10.pow(keep as u32) {
        return 10.pow(len as u32) + 1;
    }
    let mut q = half;
    let mut rest = if len % 2 == 1 { half / 10 } else { half };
    while rest > 0 {
        q = q * 10 + rest % 10;
        rest /= 10;
    }
    q
}

fn next_reversed_in(x: i64, k: i64) -> i64 {
    let mut r = 0;
    let mut y = x;
    while y > 0 {
        r = r * k + y % k;
        y /= k;
    }
    r
}

fn next_k_mirror(k: i64, n: i64) -> i64 {
    let mut sum = 0;
    let mut found = 0;
    let mut p = 1;
    while found < n {
        if next_reversed_in(p, k) == p {
            sum += p;
            found += 1;
        }
        p = next_next_palindrome(p);
    }
    sum
}

// ---- kmirror_iter.kara: an `Iterator` of palindromes, filtered, `take(n)`, `sum()`
struct Palindromes {
    length: i64,
    half: i64,
}

impl Palindromes {
    fn new() -> Palindromes {
        Palindromes { length: 1, half: 1 }
    }
}

impl Iterator for Palindromes {
    type Item = i64;

    fn next(mut ref self) -> Option[i64] {
        let width = (self.length + 1) / 2;
        if self.half == 10.pow(width as u32) {
            self.length += 1;
            self.half = 10.pow(((self.length + 1) / 2 - 1) as u32);
        }
        let h = self.half;
        self.half += 1;
        let mut p = h;
        let mut rest = if self.length % 2 == 1 { h / 10 } else { h };
        while rest > 0 {
            p = p * 10 + rest % 10;
            rest /= 10;
        }
        Some(p)
    }
}

fn iter_is_mirror(x: i64, k: i64) -> bool {
    let mut digits: Vec[i64] = Vec.new();
    let mut y = x;
    while y > 0 {
        digits.push(y % k);
        y /= k;
    }
    digits.iter().zip(digits.iter().rev()).all(|(a, b)| a == b)
}

fn iter_k_mirror(k: i64, n: i64) -> i64 {
    Palindromes.new().filter(|p| iter_is_mirror(p, k)).take(n).sum()
}

// ---- kmirror_basek.kara: the base-`k` palindromes, tried in base 10
fn basek_k_mirror(k: i64, n: i64) -> i64 {
    let mut sum = 0;
    let mut found = 0;
    let mut length = 1;
    let mut start = 1;
    loop {
        if length % 2 == 1 and length > 1 {
            start *= k;
        }
        for h in start..start * k {
            let mut p = h;
            let mut rest = if length % 2 == 1 { h / k } else { h };
            while rest > 0 {
                p = p * k + rest % k;
                rest /= k;
            }
            let text = p.to_string();
            let back: String = text.chars().rev().collect();
            if back == text {
                sum += p;
                found += 1;
                if found == n {
                    return sum;
                }
            }
        }
        length += 1;
    }
}

// ---- kmirror_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn k_mirror(k: i32, n: i32) -> i64 {
        let k = k as i64;
        let mut ans: i64 = 0;
        let mut count = 0;
        let mut len: u32 = 1;
        loop {
            let half = (len + 1) / 2;
            let start = 10.pow(half - 1);
            for h in start..start * 10 {
                let mut p = h;
                let mut x = if len % 2 == 1 { h / 10 } else { h };
                while x > 0 {
                    p = p * 10 + x % 10;
                    x /= 10;
                }
                if Solution.is_mirror(p, k) {
                    ans += p;
                    count += 1;
                    if count == n {
                        return ans;
                    }
                }
            }
            len += 1;
        }
    }

    fn is_mirror(x: own i64, k: i64) -> bool {
        let mut x = x;
        let mut digits = Vec.new();
        while x > 0 {
            digits.push(x % k);
            x /= k;
        }
        let m = digits.len();
        (0..m / 2).all(|i| digits[i] == digits[m - 1 - i])
    }
}

struct Solution {}

fn solution_k_mirror(k: i64, n: i64) -> i64 {
    Solution.k_mirror(k as i32, n as i32)
}

// ---- the statement read literally

// The first `count` numbers that read the same backwards in base 10 and
// in base `k`, found by trying every number from 1 up.
fn literal_list(k: i64, count: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = 0;
    while out.len() < count {
        x += 1;
        let ten = x.to_string();
        let ten_back: String = ten.chars().rev().collect();
        let mut base: Vec[i64] = Vec.new();
        let mut y = x;
        while y > 0 {
            base.push(y % k);
            y /= k;
        }
        let mut base_back = base.clone();
        base_back.reverse();
        if ten == ten_back and base == base_back {
            out.push(x);
        }
    }
    out
}

fn answer(arm: i64, k: i64, n: i64) -> i64 {
    match arm {
        0 => star_k_mirror(k, n),
        1 => text_k_mirror(k, n),
        2 => next_k_mirror(k, n),
        3 => iter_k_mirror(k, n),
        4 => basek_k_mirror(k, n),
        _ => solution_k_mirror(k, n),
    }
}

// Whether `x` reads the same backwards in base `b`.
fn reads_back(x: i64, b: i64) -> bool {
    let mut r = 0;
    let mut y = x;
    while y > 0 {
        r = r * b + y % b;
        y /= b;
    }
    r == x
}

// ---- questions

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "text", "next", "iter", "basek", "solution"];
    let mut lists: Vec[Vec[i64]] = Vec.new();
    for k in 0..10 {
        let count = if k == 5 or k == 7 { 12 } else { 15 };
        lists.push(if k < 2 { Vec.new() } else { literal_list(k, count) });
    }
    let mut seed = 2081;
    let mut questions: Vec[(i64, i64)] = Vec.new();
    let deep = [2, 3, 4, 6, 8, 9];
    for t in 0..340 {
        if t < 300 {
            let k = next_random(mut seed) % 8 + 2;
            questions.push((k, next_random(mut seed) % 12 + 1));
        } else if t < 320 {
            let k = next_random(mut seed) % 7 + 3;
            questions.push((k, next_random(mut seed) % (k - 1).min(9) + 1));
        } else {
            let k = deep[next_random(mut seed) % 6];
            questions.push((k, next_random(mut seed) % 3 + 13));
        }
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for (k, n) in questions.iter() {
        let truth: i64 = lists[k].iter().take(n).sum();
        check = (check * 31 + truth) % 1000000007;
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, k, n)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let before = if n >= 2 { answer(arm, k, n - 1) } else { 0 };
            let before2 = if n >= 3 { answer(arm, k, n - 2) } else { 0 };
            let d = x - before;
            let verdicts = [
                x == truth,
                if n == 1 { x == 1 } else { d > before - before2 },
                n > (k - 1).min(9) or x == n * (n + 1) / 2,
                d > 0 and reads_back(d, 10) and reads_back(d, k),
                d % 10 != 0 and d % k != 0,
                same >= 3,
            ];
            for p in 0..6 {
                checks += 1;
                if not verdicts[p] {
                    by_property[p] += 1;
                    if failures.len() < 10 {
                        failures.push(f"k = {k}, n = {n} arm {names[arm]}: P{p + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{questions.len()} questions: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for p in 0..6 {
            if by_property[p] > 0 {
                println(f"P{p + 1} {by_property[p]}");
            }
        }
    }
}
