// LeetCode #2081: Sum of k-Mirror Numbers -- LeetCode's Rust template
// (`k: i32, n: i32`, `10i64.pow(half - 1)` with a `u32` length, a
// `Self::is_mirror` helper taking `mut x`, `vec![]`, `(0..m / 2).all(..)`),
// carried by `karac fix`. The adapter below hands the harness's questions
// to it.

impl Solution {
    pub fn k_mirror(k: i32, n: i32) -> i64 {
        let k = k as i64;
        let mut ans: i64 = 0;
        let mut count = 0;
        let mut len: u32 = 1;
        loop {
            let half = (len + 1) / 2;
            let start = 10.pow(half - 1);
            for h in start..start * 10 {
                let mut p = h;
                let mut x = if len % 2 == 1 { h / 10 } else { h };
                while x > 0 {
                    p = p * 10 + x % 10;
                    x /= 10;
                }
                if Solution.is_mirror(p, k) {
                    ans += p;
                    count += 1;
                    if count == n {
                        return ans;
                    }
                }
            }
            len += 1;
        }
    }

    fn is_mirror(x: own i64, k: i64) -> bool {
        let mut x = x;
        let mut digits = Vec.new();
        while x > 0 {
            digits.push(x % k);
            x /= k;
        }
        let m = digits.len();
        (0..m / 2).all(|i| digits[i] == digits[m - 1 - i])
    }
}

struct Solution {}

fn k_mirror(k: i64, n: i64) -> i64 {
    Solution.k_mirror(k as i32, n as i32)
}

// ---- test harness ---------------------------------------------------------

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    // LeetCode's three examples, then four more
    let examples = [(2, 5), (3, 7), (7, 17), (4, 10), (9, 1), (6, 20), (8, 15)];
    for (k, n) in examples.iter() {
        println(f"k = {k}, n = {n} -> {k_mirror(k, n)}");
    }
    // every base, n from 1 to 20
    let mut total = 0;
    let mut check = 0;
    for k in 2..10 {
        for n in 1..21 {
            let a = k_mirror(k, n);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
    }
    println(f"160 answers: sum {total}, checksum {check}");
    // the constraints' largest n, in every base
    let largest: Vec[i64] = (2..10).map(|k| k_mirror(k, 30)).collect();
    println(f"n = 30: {show(largest)}");
}
