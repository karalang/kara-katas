// LeetCode #2081: Sum of k-Mirror Numbers -- from the other base. The
// base-`k` palindromes in increasing order, by length and then by first
// half, each made by writing the half's base-`k` digits back onto it; a
// number is kept when its decimal text reads the same reversed. The
// smaller base has more palindromes to try, but the same numbers come out
// in the same order.

fn k_mirror(k: i64, n: i64) -> i64 {
    let mut sum = 0;
    let mut found = 0;
    let mut length = 1;
    let mut start = 1;
    loop {
        if length % 2 == 1 and length > 1 {
            start *= k;
        }
        for h in start..start * k {
            let mut p = h;
            let mut rest = if length % 2 == 1 { h / k } else { h };
            while rest > 0 {
                p = p * k + rest % k;
                rest /= k;
            }
            let text = p.to_string();
            let back: String = text.chars().rev().collect();
            if back == text {
                sum += p;
                found += 1;
                if found == n {
                    return sum;
                }
            }
        }
        length += 1;
    }
}

// ---- test harness ---------------------------------------------------------

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    // LeetCode's three examples, then four more
    let examples = [(2, 5), (3, 7), (7, 17), (4, 10), (9, 1), (6, 20), (8, 15)];
    for (k, n) in examples.iter() {
        println(f"k = {k}, n = {n} -> {k_mirror(k, n)}");
    }
    // every base, n from 1 to 20
    let mut total = 0;
    let mut check = 0;
    for k in 2..10 {
        for n in 1..21 {
            let a = k_mirror(k, n);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
    }
    println(f"160 answers: sum {total}, checksum {check}");
    // the constraints' largest n, in every base
    let largest: Vec[i64] = (2..10).map(|k| k_mirror(k, 30)).collect();
    println(f"n = 30: {show(largest)}");
}
