// LeetCode #2081: Sum of k-Mirror Numbers -- the ★ arm. The base-10
// palindromes in increasing order: by length, and within a length by
// their first half, each made by writing the half's digits back onto it
// (all but the middle one when the length is odd). Each is tried in base
// `k`, its digits pushed onto a `Vec` and compared from both ends, until
// `n` are found.

fn is_mirror(x: i64, k: i64) -> bool {
    let mut digits: Vec[i64] = Vec.new();
    let mut y = x;
    while y > 0 {
        digits.push(y % k);
        y /= k;
    }
    let m = digits.len();
    for i in 0..m / 2 {
        if digits[i] != digits[m - 1 - i] {
            return false;
        }
    }
    true
}

fn k_mirror(k: i64, n: i64) -> i64 {
    let mut sum = 0;
    let mut found = 0;
    let mut length = 1;
    loop {
        let half = (length + 1) / 2;
        let start = 10.pow((half - 1) as u32);
        for h in start..start * 10 {
            let mut p = h;
            let mut rest = if length % 2 == 1 { h / 10 } else { h };
            while rest > 0 {
                p = p * 10 + rest % 10;
                rest /= 10;
            }
            if is_mirror(p, k) {
                sum += p;
                found += 1;
                if found == n {
                    return sum;
                }
            }
        }
        length += 1;
    }
}

// ---- test harness ---------------------------------------------------------

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    // LeetCode's three examples, then four more
    let examples = [(2, 5), (3, 7), (7, 17), (4, 10), (9, 1), (6, 20), (8, 15)];
    for (k, n) in examples.iter() {
        println(f"k = {k}, n = {n} -> {k_mirror(k, n)}");
    }
    // every base, n from 1 to 20
    let mut total = 0;
    let mut check = 0;
    for k in 2..10 {
        for n in 1..21 {
            let a = k_mirror(k, n);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
    }
    println(f"160 answers: sum {total}, checksum {check}");
    // the constraints' largest n, in every base
    let largest: Vec[i64] = (2..10).map(|k| k_mirror(k, 30)).collect();
    println(f"n = 30: {show(largest)}");
}
