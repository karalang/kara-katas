// LeetCode #2083: Substrings That Begin and End With the Same Letter --
// the differential. The six arms, against the statement read literally:
// every pair of places `i <= j`, counted when the letters there are the
// same. 300 random strings of 1 to 30 letters from the first 1, 2, 5 or
// 26 of the alphabet; then 20 of one letter, and 20 of letters all
// different; every one drawn before any arm answers.
//
// P1  the count is the statement read literally
// P2  the string reversed gives the same count
// P3  the letters renamed, each moved 7 on round the alphabet, give the
//     same count
// P4  the string followed by the next one counts both, and for each
//     letter its occurrences in the one times those in the other
// P5  the string with its first letter written again at its end counts
//     that letter's occurrences, and one, more
// P6  each arm agrees with at least three of the other five

// ---- same.kara: the ★ arm, 26 counts and `c(c + 1) / 2` each
fn star_number_of_substrings(s: Str) -> i64 {
    let mut counts = [0; 26];
    for b in s.bytes() {
        counts[(b - b'a') as i64] += 1;
    }
    counts.iter().map(|c| c * (c + 1) / 2).sum()
}

// ---- same_running.kara: a running sum of each letter's occurrences so far, in a `Map`
fn running_number_of_substrings(s: Str) -> i64 {
    let mut seen: Map[char, i64] = Map.new();
    let mut total = 0;
    for c in s.chars() {
        let count = seen.entry(c).or_insert(0);
        *count += 1;
        total += *count;
    }
    total
}

// ---- same_sorted.kara: the letters sorted, a run of `c` adding `c(c + 1) / 2`
fn sorted_number_of_substrings(s: Str) -> i64 {
    let mut letters: Vec[char] = s.chars().collect();
    letters.sort();
    let mut total = 0;
    let mut start = 0;
    for i in 1..=letters.len() {
        if i == letters.len() or letters[i] != letters[start] {
            let run = i - start;
            total += run * (run + 1) / 2;
            start = i;
        }
    }
    total
}

// ---- same_letters.kara: each of `'a'..='z'` counted with `filter(..).count()`
fn letters_number_of_substrings(s: Str) -> i64 {
    ('a'..='z')
        .map(|letter| {
            let c = s.chars().filter(|x| x == letter).count();
            c * (c + 1) / 2
        })
        .sum()
}

// ---- same_struct.kara: a `struct Tally` with `add(b)`
struct Tally {
    counts: Vec[i64],
    substrings: i64,
}

impl Tally {
    fn new() -> Tally {
        Tally { counts: Vec.filled(26, 0), substrings: 0 }
    }

    fn add(mut ref self, b: u8) {
        let at = (b - b'a') as i64;
        self.counts[at] += 1;
        self.substrings += self.counts[at];
    }
}

fn tally_number_of_substrings(s: Str) -> i64 {
    let mut tally = Tally.new();
    for b in s.bytes() {
        tally.add(b);
    }
    tally.substrings
}

// ---- same_solution.kara: LeetCode's Rust template, carried by `karac fix`
impl Solution {
    pub fn number_of_substrings(s: String) -> i64 {
        let mut cnt = [0; 26];
        for b in s.bytes() {
            cnt[(b - b'a') as usize] += 1;
        }
        cnt.iter().map(|c| c * (c + 1) / 2).sum()
    }
}

struct Solution {}

fn solution_number_of_substrings(s: Str) -> i64 {
    Solution.number_of_substrings(s.to_string())
}

// ---- the statement read literally

fn literal(s: Str) -> i64 {
    let b = s.bytes();
    let mut count = 0;
    for i in 0..b.len() {
        for j in i..b.len() {
            if b[i] == b[j] {
                count += 1;
            }
        }
    }
    count
}

fn answer(arm: i64, s: Str) -> i64 {
    match arm {
        0 => star_number_of_substrings(s),
        1 => running_number_of_substrings(s),
        2 => sorted_number_of_substrings(s),
        3 => letters_number_of_substrings(s),
        4 => tally_number_of_substrings(s),
        _ => solution_number_of_substrings(s),
    }
}

// Each letter's occurrences in `s`.
fn occurrences(s: Str) -> Vec[i64] {
    let mut counts: Vec[i64] = Vec.filled(26, 0);
    for b in s.bytes() {
        counts[(b - b'a') as i64] += 1;
    }
    counts
}

// ---- strings

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let names = ["star", "running", "sorted", "letters", "tally", "solution"];
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    let mut seed = 2083;
    let mut strings: Vec[String] = Vec.new();
    for t in 0..340 {
        let mut s = String.new();
        if t < 300 {
            let n = next_random(mut seed) % 30 + 1;
            let width = [1, 2, 5, 26][next_random(mut seed) % 4];
            for _ in 0..n {
                let at = next_random(mut seed) % width;
                s.push_str(alphabet.substring(at, at + 1));
            }
        } else if t < 320 {
            let n = next_random(mut seed) % 30 + 1;
            let at = next_random(mut seed) % 26;
            for _ in 0..n {
                s.push_str(alphabet.substring(at, at + 1));
            }
        } else {
            let n = next_random(mut seed) % 26 + 1;
            let from = next_random(mut seed) % (27 - n);
            s.push_str(alphabet.substring(from, from + n));
        }
        strings.push(s);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    for t in 0..strings.len() {
        let s = strings[t].clone();
        let other = strings[(t + 1) % strings.len()].clone();
        let truth = literal(s);
        check = (check * 31 + truth) % 1000000007;
        let reversed: String = s.chars().rev().collect();
        let mut renamed = String.new();
        for b in s.bytes() {
            let at = ((b - b'a') as i64 + 7) % 26;
            renamed.push_str(alphabet.substring(at, at + 1));
        }
        let both = s.clone() + ref other;
        let mine = occurrences(s);
        let theirs = occurrences(other);
        let mut shared = 0;
        for c in 0..26 {
            shared += mine[c] * theirs[c];
        }
        let first = s.substring(0, 1);
        let again = s.clone() + first;
        let first_count = mine[(s.bytes()[0] - b'a') as i64];
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, s)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                answer(arm, reversed) == x,
                answer(arm, renamed) == x,
                answer(arm, both) == x + answer(arm, other) + shared,
                answer(arm, again) == x + first_count + 1,
                same >= 3,
            ];
            for p in 0..6 {
                checks += 1;
                if not verdicts[p] {
                    by_property[p] += 1;
                    if failures.len() < 10 {
                        failures.push(f"\"{s}\" arm {names[arm]}: P{p + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{strings.len()} strings: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for p in 0..6 {
            if by_property[p] > 0 {
                println(f"P{p + 1} {by_property[p]}");
            }
        }
    }
}
