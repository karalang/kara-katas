// LeetCode #2083: Substrings That Begin and End With the Same Letter --
// the ★ arm's benchmark (same.kara): one text of 10^6 letters built once,
// then 5000 windows of 10^5 letters, each at a random place, counted
// through a `Str` view of the text: 5 · 10^8 letters read.

fn number_of_substrings(s: Str) -> i64 {
    let mut counts = [0; 26];
    for b in s.bytes() {
        counts[(b - b'a') as i64] += 1;
    }
    counts.iter().map(|c| c * (c + 1) / 2).sum()
}

// ---- benchmark -------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let letters = "abcdefghijklmnopqrstuvwxyz";
    let mut seed = 2083;
    let mut text = String.new();
    for _ in 0..1000000 {
        // a skewed alphabet: the first letters far more often
        let at = next_random(mut seed) % 26 * (next_random(mut seed) % 26) / 25;
        text.push_str(letters.substring(at, at + 1));
    }
    let mut total = 0;
    let mut check = 0;
    for _ in 0..5000 {
        let from = (next_random(mut seed) * 32768 + next_random(mut seed)) % 900001;
        let a = number_of_substrings(text[from..from + 100000]);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"5000 windows: sum {total}, checksum {check}");
}
