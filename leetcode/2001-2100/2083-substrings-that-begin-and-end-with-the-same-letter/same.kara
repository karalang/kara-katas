// LeetCode #2083: Substrings That Begin and End With the Same Letter --
// the ★ arm. A substring is fixed by its two ends, so a letter that occurs
// `c` times begins and ends `c` substrings of one letter and `c(c - 1) / 2`
// longer ones, `c(c + 1) / 2` in all. The letters are counted in an array
// of 26 and those counts summed. O(n).

fn number_of_substrings(s: Str) -> i64 {
    let mut counts = [0; 26];
    for b in s.bytes() {
        counts[(b - b'a') as i64] += 1;
    }
    counts.iter().map(|c| c * (c + 1) / 2).sum()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then four more
    let examples = ["abcba", "abacad", "a", "aaaa", "abcdefghijklmnopqrstuvwxyz", "zzazz", "mississippi"];
    for s in examples.iter() {
        println(f"{s} -> {number_of_substrings(s)}");
    }
    // 2000 random strings of 1 to 200 letters, from the first 1, 2, 5 or
    // 26 letters of the alphabet
    let letters = "abcdefghijklmnopqrstuvwxyz";
    let mut seed = 2083;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 200 + 1;
        let width = [1, 2, 5, 26][next_random(mut seed) % 4];
        let mut s = String.new();
        for _ in 0..n {
            let at = next_random(mut seed) % width;
            s.push_str(letters.substring(at, at + 1));
        }
        let a = number_of_substrings(s);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"2000 strings: sum {total}, checksum {check}");
    // the constraints' largest, 10^5 letters of three
    let mut s = String.new();
    for _ in 0..100000 {
        let at = next_random(mut seed) % 3;
        s.push_str(letters.substring(at, at + 1));
    }
    println(f"100000 letters: {number_of_substrings(s)}");
}
