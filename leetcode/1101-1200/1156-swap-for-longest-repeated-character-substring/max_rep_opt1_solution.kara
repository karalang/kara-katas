// LeetCode #1156: Swap For Longest Repeated Character Substring -- a Rust
// solution as LeetCode's Rust users write it (`impl Solution`, `text:
// String`, `as_bytes()`, a `[i32; 26]` count, `usize` indices walking the
// runs with `while`, and `std::cmp::max` / `min`), carried to Kāra by
// `karac fix`.

struct Solution {}

impl Solution {
    pub fn max_rep_opt1(text: String) -> i32 {
        let s = text.bytes();
        let n = s.len();
        let mut cnt = [0i32; 26];
        for c in s {
            cnt[(c - b'a') as usize] += 1;
        }
        let mut ans = 0;
        let mut i = 0;
        while i < n {
            let mut j = i;
            while j < n and s[j] == s[i] {
                j += 1;
            }
            let len = (j - i) as i32;
            let mut k = j + 1;
            while k < n and s[k] == s[i] {
                k += 1;
            }
            let joined = (k - i - 1) as i32;
            ans = max(ans, min(joined + 1, cnt[(s[i] - b'a') as usize]));
            ans = max(ans, min(len + 1, cnt[(s[i] - b'a') as usize]));
            i = j;
        }
        ans
    }
}

fn max_rep_opt1(text: Str) -> i64 {
    Solution.max_rep_opt1(text.to_string())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(text: Str) {
    println(f"{text}  ->  {max_rep_opt1(text)}");
}

fn random_text(seed: mut ref i64, n: i64, letters: i64) -> String {
    let b: Vec[u8] = (0..n).map(|_| b'a' + (next_random(mut seed) % letters) as u8).collect();
    String.from_utf8(b).unwrap()
}

fn main() {
    show("ababa");
    show("aaabaaa");
    show("aaabbaaa");
    show("aaaaa");
    show("abcdef");
    show("a");
    show("ab");
    show("aba");
    show("aab");
    show("baaab");
    show("aaabaaab");
    show("abaaac");
    show("bbababaaaa");

    // 2000 random texts of 1 to 40 letters over the first 1 to 4 letters
    let mut seed = 1156;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 40;
        let letters = 1 + next_random(mut seed) % 4;
        let answer = max_rep_opt1(random_text(mut seed, n, letters));
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"2000 random texts: total {total}, checksum {check}");

    // 20000 letters, the most the constraints allow: random over 2 and
    // over 26 letters, all one letter, and one letter with a single other
    // letter in the middle and another at the end
    println(f"20000 random over 2: {max_rep_opt1(random_text(mut seed, 20000, 2))}");
    println(f"20000 random over 26: {max_rep_opt1(random_text(mut seed, 20000, 26))}");
    let same: Vec[u8] = Vec.filled(20000, b'a');
    println(f"20000 of one letter: {max_rep_opt1(String.from_utf8(same.clone()).unwrap())}");
    let mut split = same.clone();
    split[10000] = b'b';
    split[19999] = b'c';
    println(f"one letter split once, another at the end: {max_rep_opt1(String.from_utf8(split).unwrap())}");
}
