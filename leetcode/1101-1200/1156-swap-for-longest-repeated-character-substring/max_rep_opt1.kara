// LeetCode #1156: Swap For Longest Repeated Character Substring. The text
// as runs of one letter: a run can grow by one, with a letter swapped in
// from elsewhere, and two runs of one letter split by a single other
// letter can join through it. Neither can use more of the letter than the
// text holds, which is what the swap draws on. O(n)

fn max_rep_opt1(text: Str) -> i64 {
    let b = text.bytes();
    let mut count: Vec[i64] = Vec.filled(26, 0);
    for c in b.iter() {
        count[c - b'a'] += 1;
    }
    // (letter, length) of each run, in order
    let mut runs: Vec[(u8, i64)] = [];
    let mut i = 0;
    while i < b.len() {
        let mut j = i;
        while j < b.len() and b[j] == b[i] {
            j += 1;
        }
        runs.push((b[i], j - i));
        i = j;
    }
    let mut best = 0;
    for r in 0..runs.len() {
        let (c, len) = runs[r];
        let have = count[c - b'a'];
        best = best.max((len + 1).min(have));
        if r + 2 < runs.len() and runs[r + 1].1 == 1 and runs[r + 2].0 == c {
            best = best.max((len + runs[r + 2].1 + 1).min(have));
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(text: Str) {
    println(f"{text}  ->  {max_rep_opt1(text)}");
}

fn random_text(seed: mut ref i64, n: i64, letters: i64) -> String {
    let b: Vec[u8] = (0..n).map(|_| b'a' + (next_random(mut seed) % letters) as u8).collect();
    String.from_utf8(b).unwrap()
}

fn main() {
    show("ababa");
    show("aaabaaa");
    show("aaabbaaa");
    show("aaaaa");
    show("abcdef");
    show("a");
    show("ab");
    show("aba");
    show("aab");
    show("baaab");
    show("aaabaaab");
    show("abaaac");
    show("bbababaaaa");

    // 2000 random texts of 1 to 40 letters over the first 1 to 4 letters
    let mut seed = 1156;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 40;
        let letters = 1 + next_random(mut seed) % 4;
        let answer = max_rep_opt1(random_text(mut seed, n, letters));
        total += answer;
        check = (check * 31 + answer) % 1000000007;
    }
    println(f"2000 random texts: total {total}, checksum {check}");

    // 20000 letters, the most the constraints allow: random over 2 and
    // over 26 letters, all one letter, and one letter with a single other
    // letter in the middle and another at the end
    println(f"20000 random over 2: {max_rep_opt1(random_text(mut seed, 20000, 2))}");
    println(f"20000 random over 26: {max_rep_opt1(random_text(mut seed, 20000, 26))}");
    let same: Vec[u8] = Vec.filled(20000, b'a');
    println(f"20000 of one letter: {max_rep_opt1(String.from_utf8(same.clone()).unwrap())}");
    let mut split = same.clone();
    split[10000] = b'b';
    split[19999] = b'c';
    println(f"one letter split once, another at the end: {max_rep_opt1(String.from_utf8(split).unwrap())}");
}
