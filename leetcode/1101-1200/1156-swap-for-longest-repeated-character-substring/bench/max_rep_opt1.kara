// LeetCode #1156: Swap For Longest Repeated Character Substring -- the ★
// arm: the text as runs of one letter; a run grows by one with a letter
// swapped in from elsewhere, and two runs of one letter split by a single
// other letter join through it, neither past how many of the letter the
// text holds. O(n)

fn max_rep_opt1(text: Str) -> i64 {
    let b = text.bytes();
    let mut count: Vec[i64] = Vec.filled(26, 0);
    for c in b.iter() {
        count[c - b'a'] += 1;
    }
    // (letter, length) of each run, in order
    let mut runs: Vec[(u8, i64)] = [];
    let mut i = 0;
    while i < b.len() {
        let mut j = i;
        while j < b.len() and b[j] == b[i] {
            j += 1;
        }
        runs.push((b[i], j - i));
        i = j;
    }
    let mut best = 0;
    for r in 0..runs.len() {
        let (c, len) = runs[r];
        let have = count[c - b'a'];
        best = best.max((len + 1).min(have));
        if r + 2 < runs.len() and runs[r + 1].1 == 1 and runs[r + 2].0 == c {
            best = best.max((len + runs[r + 2].1 + 1).min(have));
        }
    }
    best
}

// ---- bench ----------------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 64 texts of 20000 letters, the most the constraints allow, built
    // once, four kinds in turn: random over 2 letters, over 3, over 26,
    // and runs of `a` of 1 to 40 letters split by single other letters.
    // Each of 100 passes answers all 64 in turn.
    let passes = 100;
    let mut seed = 1156;
    let mut texts: Vec[String] = [];
    for t in 0..64 {
        let mut b: Vec[u8] = [];
        while b.len() < 20000 {
            if t % 4 == 3 {
                for _ in 0..1 + next_random(mut seed) % 40 {
                    b.push(b'a');
                }
                b.push(b'b' + (next_random(mut seed) % 25) as u8);
            } else {
                let letters = [2, 3, 26][t % 4];
                b.push(b'a' + (next_random(mut seed) % letters) as u8);
            }
        }
        b.truncate(20000);
        texts.push(String.from_utf8(b).unwrap());
    }
    let mut check = 0;
    for p in 0..passes {
        for text in texts.iter() {
            check = (check * 31 + max_rep_opt1(text) + p) % 1000000007;
        }
    }
    println(f"{passes} passes over 64 texts of 20000 letters: checksum {check}");
}
