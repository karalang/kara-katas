// LeetCode #1115: Print FooBar Alternately -- two semaphores, as the
// Python solutions on LeetCode write it with `threading.Semaphore`, each
// a channel holding its permits: `acquire` takes one and `release` puts
// one back. `foo` starts with a permit and `bar` without, and each
// method releases the other's after it prints. The standard library's
// `Semaphore` would be the natural type, but its `acquire` does not wait
// for another task's `release` (B-2026-11-10-NN).

import std.sync.{Mutex, TaskGroup};

sync struct Permits {
    permits: (Sender[()], Receiver[()]),
}

impl Permits {
    fn new(value: i64) -> Permits {
        let permits = channel(1);
        for _ in 0..value {
            let _ = permits.0.send(());
        }
        Permits { permits }
    }

    fn acquire(self) {
        let _ = self.permits.1.recv();
    }

    fn release(self) {
        let _ = self.permits.0.send(());
    }
}

sync struct FooBar {
    n: i64,
    foo_sem: Permits,
    bar_sem: Permits,
}

impl FooBar {
    fn new(n: i64) -> FooBar {
        FooBar { n, foo_sem: Permits.new(1), bar_sem: Permits.new(0) }
    }

    fn foo(self, print_foo: Fn()) {
        for _ in 0..self.n {
            self.foo_sem.acquire();
            print_foo();
            self.bar_sem.release();
        }
    }

    fn bar(self, print_bar: Fn()) {
        for _ in 0..self.n {
            self.bar_sem.acquire();
            print_bar();
            self.foo_sem.release();
        }
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// LeetCode's run: one task calls `foo` and another `bar`, started in the
// order given, each handing its method a print function; the prints go
// to one log, which the run returns.
fn run(n: i64, bar_first: bool) -> String {
    let log: Mutex[String] = Mutex.new(String.new());
    let fb = FooBar.new(n);
    {
        let group = TaskGroup.new();
        if bar_first {
            group.spawn(|| fb.bar(|| log.lock().value.push_str("bar")));
            group.spawn(|| fb.foo(|| log.lock().value.push_str("foo")));
        } else {
            group.spawn(|| fb.foo(|| log.lock().value.push_str("foo")));
            group.spawn(|| fb.bar(|| log.lock().value.push_str("bar")));
        }
    }
    let g = log.lock();
    g.value.clone()
}

fn main() {
    println(f"n = 1 -> {run(1, false)}");
    println(f"n = 2 -> {run(2, false)}");
    println(f"n = 2, bar started first -> {run(2, true)}");
    println(f"n = 3, bar started first -> {run(3, true)}");
    // 2000 runs of up to 12 rounds, either task started first
    let mut seed = 1115;
    let mut alternating = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 12 + 1;
        let bar_first = next_random(mut seed) % 2 == 1;
        let out = run(n, bar_first);
        if out == "foobar".repeat(n) {
            alternating += 1;
        }
        for b in out.bytes() {
            check = (check * 131 + b) % 1000000007;
        }
    }
    println(f"2000 runs of up to 12 rounds: {alternating} alternating, checksum {check}");
    // LeetCode's largest
    let out = run(1000, true);
    let mut check = 0;
    for b in out.bytes() {
        check = (check * 131 + b) % 1000000007;
    }
    println(f"n = 1000: {out.len()} characters, alternating {out == "foobar".repeat(1000)}, checksum {check}");
}
