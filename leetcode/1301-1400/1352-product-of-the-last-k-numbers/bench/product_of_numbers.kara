// LeetCode #1352: Product of the Last K Numbers -- the ★ arm: the running
// products of the numbers since the last zero, after a leading 1. A zero
// ends every product that reaches back past it, so it starts the list
// over. The last k numbers' product is the last running product divided
// by the one k places before it, or 0 when the last k reach back to a
// zero. O(1) for each call

struct ProductOfNumbers {
    prefix: Vec[i64],
}

impl ProductOfNumbers {
    fn new() -> ProductOfNumbers {
        ProductOfNumbers { prefix: [1] }
    }

    fn add(mut ref self, num: i32) {
        if num == 0 {
            self.prefix = [1];
        } else {
            let last = self.prefix[self.prefix.len() - 1];
            self.prefix.push(last * num);
        }
    }

    fn get_product(self, k: i32) -> i32 {
        let n = self.prefix.len();
        if k >= n {
            return 0;
        }
        (self.prefix[n - 1] / self.prefix[n - 1 - k]) as i32
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10^7 rounds, each adding a number, 0 one time in 1000, otherwise
    // 1, or 2 to 100 one time in 20, taken back to 1 when the product
    // since the last zero would reach 2^31; and asking the product of the
    // last 1 to 50,000 numbers, k drawn from the checksum so far
    let mut seed = 1352;
    let mut since: i64 = 1;
    let mut p = ProductOfNumbers.new();
    let mut check: i64 = 0;
    for r in 0..10000000 {
        let mut num: i64 = 1;
        if next_random(mut seed) % 1000 == 0 {
            num = 0;
            since = 1;
        } else {
            if next_random(mut seed) % 20 == 0 {
                num = 2 + next_random(mut seed) % 99;
            }
            if since * num >= 2147483648 {
                num = 1;
            }
            since *= num;
        }
        p.add(num as i32);
        let k = 1 + check % 50000.min(r + 1);
        check = (check * 31 + p.get_product(k as i32) + r) % 1000000007;
    }
    println(f"10000000 rounds: checksum {check}");
}
