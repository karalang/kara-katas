// LeetCode #1380: Lucky Numbers in a Matrix -- the rows' least values
// gathered in a `Set`, then each column's greatest looked up in it. The
// values are all different, so a value that is both is one cell's. A
// value found joins the answer in column order. O(mn)

fn lucky_numbers(matrix: Vec[Vec[i32]]) -> Vec[i32] {
    let mut row_mins: Set[i32] = Set.new();
    for row in matrix.iter() {
        row_mins.insert(row.iter().min().unwrap());
    }
    let mut lucky: Vec[i32] = Vec.new();
    for j in 0..matrix[0].len() {
        let top = matrix.iter().map(|row| row[j]).max().unwrap();
        if row_mins.contains(top) {
            lucky.push(top);
        }
    }
    lucky
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// An m by n matrix of different values from 1 to 10^5. Kind 0 places them
// at random. Kind 1 plants a lucky number at a random cell: the m - 1
// least values go to the rest of its column, the next to the cell, the
// n - 1 greatest to the rest of its row, and the others at random.
fn matrix(seed: mut ref i64, m: i64, n: i64, kind: i64) -> Vec[Vec[i32]] {
    let cells = m * n;
    // `cells` different values: a random stride through 1 to 99991, a prime
    let step = 1 + next_random(mut seed) % 99990;
    let start = next_random(mut seed) % 99991;
    let mut values: Vec[i32] = (0..cells).map(|k| (1 + (start + k * step) % 99991) as i32).collect();
    values.sort();
    let mut grid: Vec[Vec[i32]] = Vec.filled(m, Vec.filled(n, 0));
    let mut free: Vec[(i64, i64)] = Vec.new();
    let mut next = 0;
    if kind == 1 {
        let (r, c) = (next_random(mut seed) % m, next_random(mut seed) % n);
        for i in 0..m {
            if i != r {
                grid[i][c] = values[next];
                next += 1;
            }
        }
        grid[r][c] = values[next];
        next += 1;
        let mut top = cells - 1;
        for j in 0..n {
            if j != c {
                grid[r][j] = values[top];
                top -= 1;
            }
        }
        for i in 0..m {
            for j in 0..n {
                if i != r and j != c {
                    free.push((i, j));
                }
            }
        }
    } else {
        for i in 0..m {
            for j in 0..n {
                free.push((i, j));
            }
        }
    }
    let mut rest: Vec[i32] = values[next..next + free.len()].to_vec();
    for i in (1..rest.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        rest.swap(i, j);
    }
    for (k, (i, j)) in free.iter().enumerate() {
        grid[i][j] = rest[k];
    }
    grid
}

fn show(lucky: Vec[i32]) -> String {
    let parts: Vec[String] = lucky.iter().map(|v| f"{v}").collect();
    f"[{parts.join(",")}]"
}

fn main() {
    // LeetCode's three examples, and 50 by 50, the constraints' most:
    // values rising along each row and down each column, so the bottom
    // left corner is lucky, and each row the one above shifted one place
    // left, the least of a row and the greatest of a column far apart, so
    // no cell is
    let mut shown: Vec[String] = Vec.new();
    shown.push(show(lucky_numbers([[3, 7, 8], [9, 11, 13], [15, 16, 17]])));
    shown.push(show(lucky_numbers([[1, 10, 4, 2], [9, 3, 8, 7], [15, 16, 17, 12]])));
    shown.push(show(lucky_numbers([[7, 8], [1, 2]])));
    let rising: Vec[Vec[i32]] = (0..50).map(|i| (0..50).map(|j| (i * 50 + j + 1) as i32).collect()).collect();
    shown.push(show(lucky_numbers(rising)));
    let shifted: Vec[Vec[i32]] = (0..50).map(|i| (0..50).map(|j| ((i + j) % 50 * 50 + i + 1) as i32).collect()).collect();
    shown.push(show(lucky_numbers(shifted)));
    println(shown.join(" "));
    // 2000 random matrices of 1 to 50 rows and columns, half with a
    // lucky number planted
    let mut seed = 1380;
    let mut found = 0;
    let mut check: i64 = 0;
    for c in 0..2000 {
        let m = 1 + next_random(mut seed) % 50;
        let n = 1 + next_random(mut seed) % 50;
        let lucky = lucky_numbers(matrix(mut seed, m, n, c % 2));
        found += lucky.len();
        for v in lucky.iter() {
            check = (check * 131 + v) % 1000000007;
        }
        check = (check * 131 + lucky.len()) % 1000000007;
    }
    println(f"2000 random matrices: {found} lucky numbers, checksum {check}");
}
