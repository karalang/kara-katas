// LeetCode #1335: Minimum Difficulty of a Job Schedule -- a Rust solution
// as LeetCode's Rust users write it (a `vec![vec![i32::MAX; n + 1]; d +
// 1]` table indexed by `usize`, inclusive ranges `k..=n`, and the running
// hardest job and the cell kept with `.max(..)` and `.min(..)`), carried
// to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn min_difficulty(job_difficulty: Vec[i32], d: i32) -> i32 {
        let n = job_difficulty.len();
        let d = d as i64;
        if n < d {
            return -1;
        }
        let mut dp = Vec.filled(d + 1, Vec.filled(n + 1, i32.MAX));
        dp[0][0] = 0;
        for k in 1..=d {
            for i in k..=n {
                let mut mx: i32 = 0;
                for j in (k..=i).rev() {
                    mx = mx.max(job_difficulty[j - 1]);
                    if dp[k - 1][j - 1] != i32.MAX {
                        dp[k][i] = dp[k][i].min(dp[k - 1][j - 1] + mx);
                    }
                }
            }
        }
        dp[d][n]
    }
}

fn min_difficulty(job_difficulty: Vec[i32], d: i32) -> i32 {
    Solution.min_difficulty(job_difficulty, d)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; one job; more days than jobs
    let ex = [min_difficulty([6, 5, 4, 3, 2, 1], 2), min_difficulty([9, 9, 9], 4), min_difficulty([1, 1, 1], 3)];
    println(f"{ex[0]} {ex[1]} {ex[2]} {min_difficulty([7], 1)} {min_difficulty([0, 0], 1)}");
    // 300 jobs, the constraints' most, in 10 days and in 1, and 300 jobs
    // rising from 0
    let mut seed = 1335;
    let mut jobs: Vec[i32] = Vec.new();
    let mut rising: Vec[i32] = Vec.new();
    for i in 0..300 {
        jobs.push((next_random(mut seed) % 1001) as i32);
        rising.push((i * 3) as i32);
    }
    println(f"300 jobs: {min_difficulty(jobs, 10)} {min_difficulty(jobs, 1)}, rising {min_difficulty(rising, 10)}");
    // 300 random schedules of 1 to 300 jobs, most of them short, with
    // difficulties up to 5 or 1000 and 1 to 10 days
    let mut check = 0;
    let mut impossible = 0;
    for t in 0..300 {
        let n = if t % 25 == 0 { 1 + next_random(mut seed) % 300 } else { 1 + next_random(mut seed) % 15 };
        let top = if t % 2 == 0 { 6 } else { 1001 };
        let mut job_difficulty: Vec[i32] = Vec.new();
        for _ in 0..n {
            job_difficulty.push((next_random(mut seed) % top) as i32);
        }
        let d = (1 + next_random(mut seed) % 10) as i32;
        let answer = min_difficulty(job_difficulty, d);
        if answer < 0 {
            impossible += 1;
        }
        check = (check * 131 + answer + 7) % 1000000007;
    }
    println(f"300 random schedules: {impossible} impossible, checksum {check}");
}
