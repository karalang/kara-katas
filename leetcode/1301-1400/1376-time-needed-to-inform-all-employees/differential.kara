// LeetCode #1376: Time Needed to Inform All Employees -- differential
// test of the five arms against the statement read literally, with five
// more properties.
//
// The literal reading: an employee hears the news once every manager
// above it, from the head down, has spent its inform time, so its time
// is the sum of those inform times, found by climbing from it to the
// head; the answer is the latest.

// ---- num_of_minutes.kara ----
fn a0_num_of_minutes(n: i32, head_id: i32, manager: Vec[i32], inform_time: Vec[i32]) -> i32 {
    let mut reports: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for (i, m) in manager.iter().enumerate() {
        if m >= 0 {
            reports[m].push(i);
        }
    }
    let mut heard = Vec.filled(n, 0i32);
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(head_id);
    let mut latest: i32 = 0;
    while let Some(u) = queue.pop_front() {
        latest = latest.max(heard[u]);
        for v in reports[u].iter() {
            heard[v] = heard[u] + inform_time[u];
            queue.push_back(v);
        }
    }
    latest
}

// ---- num_of_minutes_dfs.kara ----
fn a1_take(reports: Vec[Vec[i64]], inform_time: Vec[i32], u: i64) -> i32 {
    let mut longest: i32 = 0;
    for v in reports[u].iter() {
        longest = longest.max(a1_take(reports, inform_time, v));
    }
    longest + inform_time[u]
}

fn a1_num_of_minutes(n: i32, head_id: i32, manager: Vec[i32], inform_time: Vec[i32]) -> i32 {
    let mut reports: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for (i, m) in manager.iter().enumerate() {
        if m >= 0 {
            reports[m].push(i);
        }
    }
    a1_take(reports, inform_time, head_id)
}

// ---- num_of_minutes_climb.kara ----
fn a2_num_of_minutes(n: i32, head_id: i32, manager: Vec[i32], inform_time: Vec[i32]) -> i32 {
    let mut heard: Vec[i32] = Vec.filled(n, -1);
    heard[head_id] = 0;
    let mut latest: i32 = 0;
    let mut climb: Vec[i64] = Vec.new();
    for i in 0..n {
        let mut at = i;
        while heard[at] < 0 {
            climb.push(at);
            at = manager[at];
        }
        while let Some(e) = climb.pop() {
            let m = manager[e];
            heard[e] = heard[m] + inform_time[m];
        }
        latest = latest.max(heard[i]);
    }
    latest
}

// ---- num_of_minutes_leaves.kara ----
fn a3_num_of_minutes(n: i32, head_id: i32, manager: Vec[i32], inform_time: Vec[i32]) -> i32 {
    let mut waiting: Vec[i32] = Vec.filled(n, 0);
    for m in manager.iter() {
        if m >= 0 {
            waiting[m] += 1;
        }
    }
    let mut longest: Vec[i32] = Vec.filled(n, 0);
    let mut ready: Vec[i64] = (0..n).filter(|e| waiting[e] == 0).map(|x| x as i64).collect();
    while let Some(e) = ready.pop() {
        let time = longest[e] + inform_time[e];
        if e == head_id {
            return time;
        }
        let m = manager[e];
        longest[m] = longest[m].max(time);
        waiting[m] -= 1;
        if waiting[m] == 0 {
            ready.push(m);
        }
    }
    0
}

// ---- num_of_minutes_solution.kara ----
struct A4Solution {}

fn a4_dfs(u: i64, children: ref Vec[Vec[i64]], inform_time: ref Vec[i32]) -> i32 {
    let mut best: i32 = 0;
    for v in ref children[u] {
        best = best.max(a4_dfs(v, children, inform_time));
    }
    best + inform_time[u]
}

impl A4Solution {
    pub fn a4_num_of_minutes(n: i32, head_id: i32, manager: Vec[i32], inform_time: Vec[i32]) -> i32 {
        let n = n as i64;
        let mut children = Vec.filled(n, Vec.new());
        for (i, m) in manager.iter().enumerate() {
            if m >= 0 {
                children[m].push(i);
            }
        }
        a4_dfs(head_id, children, inform_time)
    }
}

fn a4_num_of_minutes(n: i32, head_id: i32, manager: Vec[i32], inform_time: Vec[i32]) -> i32 {
    A4Solution.a4_num_of_minutes(n, head_id, manager, inform_time)
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn literal(n: i32, head_id: i32, manager: Vec[i32], inform_time: Vec[i32]) -> i32 {
    let mut latest: i32 = 0;
    for i in 0..n {
        let mut time: i32 = 0;
        let mut at = i;
        while at != head_id {
            let m = manager[at];
            time += inform_time[m];
            at = m;
        }
        latest = latest.max(time);
    }
    latest
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, n: i32, head_id: i32, manager: Vec[i32], inform_time: Vec[i32]) -> i32 {
    match i {
        0 => a0_num_of_minutes(n, head_id, manager, inform_time),
        1 => a1_num_of_minutes(n, head_id, manager, inform_time),
        2 => a2_num_of_minutes(n, head_id, manager, inform_time),
        3 => a3_num_of_minutes(n, head_id, manager, inform_time),
        _ => a4_num_of_minutes(n, head_id, manager, inform_time),
    }
}

fn check_case(t: mut ref Tally, head: i32, manager: Vec[i32], inform: Vec[i32], extra: i32) {
    t.cases += 1;
    let n = manager.len() as i32;
    let want = literal(n, head, manager, inform);
    t.check = (t.check * 131 + want * 13 + n) % 1000000007;
    let star = a0_num_of_minutes(n, head, manager, inform);
    // every inform time doubled
    let doubled: Vec[i32] = inform.iter().map(|x| 2 * x).collect();
    // employee i renamed n - 1 - i
    let renamed: Vec[i32] = manager.iter().rev().map(|m| if m < 0 { -1 } else { n - 1 - m }).collect();
    let renamed_time: Vec[i32] = inform.iter().rev().cloned().collect();
    // a new head, employee n, above the old one, taking `extra` minutes
    let mut above = manager.clone();
    above[head] = n;
    above.push(-1);
    let mut above_time = inform.clone();
    above_time.push(extra);
    let total: i32 = inform.iter().sum();
    for i in 0..5 {
        let got = arm(i, n, head, manager, inform);
        let what = f"arm {i} on head {head}, managers {manager}, times {inform}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: every inform time doubled: twice as long
        let dt = arm(i, n, head, manager, doubled);
        expect(mut t, 2, dt == 2 * got, f"P2 {what}, doubled: {dt}");
        // P3: the employees renamed: the same time
        let rn = arm(i, n, n - 1 - head, renamed, renamed_time);
        expect(mut t, 3, rn == got, f"P3 {what}, renamed: {rn}");
        // P4: a new head above, taking `extra` minutes: that much longer
        let ab = arm(i, n + 1, n, above, above_time);
        expect(mut t, 4, ab == got + extra, f"P4 {what}, a head above taking {extra}: {ab}");
        // P5: at least the head's own time and at most every time added,
        // and 0 exactly when the head is alone
        expect(mut t, 5, got >= inform[head] and got <= total and (got == 0) == (n == 1), f"P5 {what}: {got} against head {inform[head]}, total {total}");
        // P6: the ★ arm's time
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's two examples
    check_case(mut t, 0, [-1], [0], 5);
    check_case(mut t, 2, [2, 2, -1, 2, 2, 2], [0, 0, 1, 0, 0, 0], 5);
    // 2000 companies of 1 to 12 employees, 500 of each kind: each
    // employee after the first, in a random order, reports to any taken
    // before it, to one of the last three, to one of the first three, or
    // to one of the last half; a manager takes 1 to 9 minutes. Every
    // company is drawn before any arm answers.
    let mut seed = 13761;
    let mut cases: Vec[(i32, Vec[i32], Vec[i32], i32)] = Vec.new();
    for c in 0..2000 {
        let kind = c % 4;
        let n = 1 + next_random(mut seed) % 12;
        let mut order: Vec[i64] = (0..n).collect();
        for i in (1..n).rev() {
            let j = next_random(mut seed) % (i + 1);
            order.swap(i, j);
        }
        let mut manager: Vec[i32] = Vec.filled(n, -1);
        let mut inform: Vec[i32] = Vec.filled(n, 0);
        for k in 1..n {
            let back = if kind == 0 {
                next_random(mut seed) % k
            } else if kind == 1 {
                k - 1 - next_random(mut seed) % k.min(3)
            } else if kind == 2 {
                next_random(mut seed) % k.min(3)
            } else {
                k / 2 + next_random(mut seed) % (k - k / 2)
            };
            manager[order[k]] = order[back] as i32;
        }
        for i in 0..n {
            let m = manager[i];
            if m >= 0 and inform[m] == 0 {
                inform[m] = (1 + next_random(mut seed) % 9) as i32;
            }
        }
        let extra = (1 + next_random(mut seed) % 9) as i32;
        cases.push((order[0] as i32, manager, inform, extra));
    }
    for (head, manager, inform, extra) in cases.iter() {
        check_case(mut t, head, manager, inform, extra);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
