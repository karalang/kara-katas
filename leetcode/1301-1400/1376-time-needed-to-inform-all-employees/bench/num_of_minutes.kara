// LeetCode #1376 bench -- the ★ arm: each manager's reports in a list,
// then a breadth-first walk down from the head, each employee hearing
// the news when the manager heard it plus the manager's inform time.

fn num_of_minutes(n: i32, head_id: i32, manager: Vec[i32], inform_time: Vec[i32]) -> i32 {
    let mut reports: Vec[Vec[i64]] = Vec.filled(n, Vec.new());
    for (i, m) in manager.iter().enumerate() {
        if m >= 0 {
            reports[m].push(i);
        }
    }
    let mut heard = Vec.filled(n, 0i32);
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(head_id);
    let mut latest: i32 = 0;
    while let Some(u) = queue.pop_front() {
        latest = latest.max(heard[u]);
        for v in reports[u].iter() {
            heard[v] = heard[u] + inform_time[u];
            queue.push_back(v);
        }
    }
    latest
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 10 companies of 10^5 employees, the constraints' most, built once:
    // labelled in a random order, each employee after the first reporting
    // to any taken before it, a manager taking 1 to 1000 minutes; then
    // 200 rounds, each giving one employee of one company, both drawn
    // from the checksum so far, a new inform time if it is a manager, and
    // timing that company
    let n = 100000;
    let mut seed = 1376;
    let mut heads: Vec[i32] = Vec.new();
    let mut managers: Vec[Vec[i32]] = Vec.new();
    let mut informs: Vec[Vec[i32]] = Vec.new();
    for _ in 0..10 {
        let mut order: Vec[i64] = (0..n).collect();
        for i in (1..n).rev() {
            let j = next_random(mut seed) % (i + 1);
            order.swap(i, j);
        }
        let mut manager: Vec[i32] = Vec.filled(n, -1);
        let mut inform: Vec[i32] = Vec.filled(n, 0);
        for k in 1..n {
            let m = order[next_random(mut seed) % k];
            manager[order[k]] = m as i32;
            if inform[m] == 0 {
                inform[m] = (1 + next_random(mut seed) % 1000) as i32;
            }
        }
        heads.push(order[0] as i32);
        managers.push(manager);
        informs.push(inform);
    }
    let mut check: i64 = 0;
    for r in 0..200 {
        let c = check % 10;
        let e = (check / 10) % n;
        let inform = mut ref informs[c];
        if inform[e] > 0 {
            inform[e] = (1 + (check + r) % 1000) as i32;
        }
        let got = num_of_minutes(n as i32, heads[c], managers[c], informs[c]) as i64;
        check = (check * 31 + got + r) % 1000000007;
    }
    println(f"200 rounds over 10 companies of 100000 employees: checksum {check}");
}
