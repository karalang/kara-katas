// LeetCode #1354: Construct Target Array With Multiple Sums -- bench, the
// ★ arm: the moves undone from the target, largest value first, in a
// max-first `PriorityQueue` with a running total, many undos of one value
// as one remainder
fn is_possible(target: Vec[i32]) -> bool {
    if target.len() == 1 {
        return target[0] == 1;
    }
    let mut total: i64 = 0;
    let mut heap: PriorityQueue[i64] = PriorityQueue.max_first();
    for x in target.iter() {
        total += x as i64;
        heap.push(x);
    }
    loop {
        let x = heap.pop().unwrap();
        let rest = total - x;
        if x == 1 or rest == 1 {
            return true;
        }
        if x <= rest or x % rest == 0 {
            return false;
        }
        let before = x % rest;
        heap.push(before);
        total = rest + before;
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n ones, then up to `moves` moves, each setting a random place to the
// sum of all, stopping before a value would pass `top`
fn reached(seed: mut ref i64, n: i64, moves: i64, top: i64) -> Vec[i32] {
    let mut arr: Vec[i64] = Vec.filled(n, 1);
    let mut total = n;
    for _ in 0..moves {
        if total > top {
            break;
        }
        let i = next_random(mut seed) % n;
        let was = arr[i];
        arr[i] = total;
        total = 2 * total - was;
    }
    arr.iter().map(|x| x as i32).collect()
}

fn main() {
    // 20 targets of 5 * 10^4 values, each reached from the ones by moves
    // until a value would pass 10^9, built once; then 2000 rounds, each
    // changing one place of one target, drawn from the checksum so far,
    // answering, and putting the place back; one round in four leaves the
    // value as it was
    let mut seed = 1354;
    let mut targets: Vec[Vec[i32]] = Vec.new();
    for _ in 0..20 {
        targets.push(reached(mut seed, 50000, 100, 1000000000));
    }
    let mut check: i64 = 0;
    for r in 0..2000 {
        let k = check % 20;
        let at = (check / 20) % 50000;
        let was = targets[k][at];
        if r % 4 != 0 {
            targets[k][at] = was + 1 + ((check / 7) % 3) as i32;
        }
        let got = if is_possible(targets[k]) { 1 } else { 0 };
        targets[k][at] = was;
        check = (check * 31 + got * 1000 + r) % 1000000007;
    }
    println(f"2000 rounds over 20 targets of 5 * 10^4 values: checksum {check}");
}
