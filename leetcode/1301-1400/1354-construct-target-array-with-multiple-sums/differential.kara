// LeetCode #1354: Construct Target Array With Multiple Sums --
// differential test of the five arms against the statement read
// literally, with five more properties.
//
// The statement: start from an array of n ones; a move sets any one place
// to the sum of the whole array. Return whether `target` can be reached
// by some number of moves.

// ---- is_possible.kara ----
fn a0_is_possible(target: Vec[i32]) -> bool {
    if target.len() == 1 {
        return target[0] == 1;
    }
    let mut total: i64 = 0;
    let mut heap: PriorityQueue[i64] = PriorityQueue.max_first();
    for x in target.iter() {
        total += x as i64;
        heap.push(x);
    }
    loop {
        let x = heap.pop().unwrap();
        let rest = total - x;
        if x == 1 or rest == 1 {
            return true;
        }
        if x <= rest or x % rest == 0 {
            return false;
        }
        let before = x % rest;
        heap.push(before);
        total = rest + before;
    }
}

// ---- is_possible_scan.kara ----
fn a1_is_possible(target: Vec[i32]) -> bool {
    let n = target.len();
    if n == 1 {
        return target[0] == 1;
    }
    let mut values: Vec[i64] = target.iter().map(|x| x as i64).collect();
    let mut total: i64 = values.iter().sum();
    loop {
        let mut at = 0;
        for i in 1..n {
            if values[i] > values[at] {
                at = i;
            }
        }
        let x = values[at];
        let rest = total - x;
        if x == 1 or rest == 1 {
            return true;
        }
        if x <= rest or x % rest == 0 {
            return false;
        }
        values[at] = x % rest;
        total = rest + values[at];
    }
}

// ---- is_possible_sorted.kara ----
fn a2_is_possible(target: Vec[i32]) -> bool {
    if target.len() == 1 {
        return target[0] == 1;
    }
    let mut counts: SortedMap[i64, i64] = SortedMap.new();
    let mut total: i64 = 0;
    for x in target.iter() {
        total += x as i64;
        counts[x as i64] = counts.get(x as i64).unwrap_or(0) + 1;
    }
    loop {
        let (x, k) = counts.last().unwrap();
        let (x, k) = (*x, *k);
        let rest = total - x;
        if x == 1 or rest == 1 {
            return true;
        }
        if x <= rest or x % rest == 0 {
            return false;
        }
        if k == 1 {
            counts.remove(x);
        } else {
            counts[x] = k - 1;
        }
        let before = x % rest;
        counts[before] = counts.get(before).unwrap_or(0) + 1;
        total = rest + before;
    }
}

// ---- is_possible_tree.kara ----
fn a3_larger(values: Vec[i64], a: i64, b: i64) -> i64 {
    if values[b] > values[a] { b } else { a }
}

fn a3_is_possible(target: Vec[i32]) -> bool {
    let n = target.len();
    if n == 1 {
        return target[0] == 1;
    }
    let mut values: Vec[i64] = target.iter().map(|x| x as i64).collect();
    let mut total: i64 = values.iter().sum();
    let mut size = 1;
    while size < n {
        size *= 2;
    }
    values.resize(size, 0);
    let mut best: Vec[i64] = Vec.filled(2 * size, 0);
    for i in 0..size {
        best[size + i] = i;
    }
    let mut node = size - 1;
    while node >= 1 {
        best[node] = a3_larger(values, best[2 * node], best[2 * node + 1]);
        node -= 1;
    }
    loop {
        let at = best[1];
        let x = values[at];
        let rest = total - x;
        if x == 1 or rest == 1 {
            return true;
        }
        if x <= rest or x % rest == 0 {
            return false;
        }
        values[at] = x % rest;
        total = rest + values[at];
        let mut node = (size + at) / 2;
        while node >= 1 {
            best[node] = a3_larger(values, best[2 * node], best[2 * node + 1]);
            node /= 2;
        }
    }
}

// ---- is_possible_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_is_possible(target: Vec[i32]) -> bool {
        if target.len() == 1 {
            return target[0] == 1;
        }
        let mut total: i64 = target.iter().map(|x| x as i64).sum();
        let mut heap: PriorityQueue[i64] = PriorityQueue.max_first_from(target.iter().map(|x| x as i64).collect());
        while let Some(x) = heap.pop() {
            let rest = total - x;
            if x == 1 or rest == 1 {
                return true;
            }
            if rest == 0 or x <= rest or x % rest == 0 {
                return false;
            }
            let prev = x % rest;
            total = rest + prev;
            heap.push(prev);
        }
        true
    }
}

fn a4_is_possible(target: Vec[i32]) -> bool {
    A4Solution.a4_is_possible(target)
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// every array reachable by moves from `arr`, its sum `total`, without
// passing the target anywhere: a value only grows, so a move that sets a
// place above its target can never be undone. Each array but the ones has
// one move that made it, its largest value, so no array is met twice
fn search(arr: mut ref Vec[i64], total: i64, target: Vec[i64]) -> bool {
    let n = target.len();
    let mut same = true;
    for i in 0..n {
        if arr[i] != target[i] {
            same = false;
        }
    }
    if same {
        return true;
    }
    for i in 0..n {
        if total <= target[i] {
            let was = arr[i];
            arr[i] = total;
            let found = search(mut arr, 2 * total - was, target);
            arr[i] = was;
            if found {
                return true;
            }
        }
    }
    false
}

// the statement read literally: the moves made forward from the ones, every
// choice of place tried. One value has no move that changes it
fn literal(target: Vec[i32]) -> bool {
    let n = target.len();
    if n == 1 {
        return target[0] == 1;
    }
    let goal: Vec[i64] = target.iter().map(|x| x as i64).collect();
    let mut arr: Vec[i64] = Vec.filled(n, 1);
    search(mut arr, n, goal)
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

// n ones, then up to `moves` moves, each setting a random place to the
// sum of all, stopping before a value would pass `top`
fn reached(seed: mut ref i64, n: i64, moves: i64, top: i64) -> Vec[i32] {
    let mut arr: Vec[i64] = Vec.filled(n, 1);
    let mut total = n;
    for _ in 0..moves {
        if total > top {
            break;
        }
        let i = next_random(mut seed) % n;
        let was = arr[i];
        arr[i] = total;
        total = 2 * total - was;
    }
    arr.iter().map(|x| x as i32).collect()
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, target: Vec[i32]) -> bool {
    match i {
        0 => a0_is_possible(target),
        1 => a1_is_possible(target),
        2 => a2_is_possible(target),
        3 => a3_is_possible(target),
        _ => a4_is_possible(target),
    }
}

fn check_case(t: mut ref Tally, target: Vec[i32]) {
    t.cases += 1;
    let n = target.len();
    let want = literal(target);
    t.check = (t.check * 131 + if want { 7 } else { 0 } + n) % 1000000007;
    let backwards: Vec[i32] = target.iter().rev().cloned().collect();
    // one move more, at the place the sum picks
    let total: i64 = target.iter().map(|x| x as i64).sum();
    let mut moved = target.clone();
    moved[total % n] = total as i32;
    let largest = target.iter().cloned().max().unwrap() as i64;
    let first_two: Vec[i32] = if n == 1 { target.clone() } else { [target[0], target[1]] };
    let coprime = if n == 1 { target[0] == 1 } else { gcd(target[0], target[1]) == 1 };
    let star = a0_is_possible(target);
    for i in 0..5 {
        let got = arm(i, target);
        let what = f"arm {i} on {target}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: the values in the opposite order: the same answer
        let bw = arm(i, backwards);
        expect(mut t, 2, bw == got, f"P2 {what}, backwards: {bw}");
        // P3: one move more: the same answer, since the move can be undone
        // only one way
        let mv = arm(i, moved);
        expect(mut t, 3, mv == got, f"P3 {what}, a move more {moved}: {mv}");
        // P4: a target that can be reached has its largest value 1, or
        // above the sum of the rest
        expect(mut t, 4, not got or largest == 1 or largest > total - largest or n == 1, f"P4 {what}: {got}");
        // P5: the first two values alone: possible exactly when they share
        // no factor
        let ft = arm(i, first_two);
        expect(mut t, 5, ft == coprime, f"P5 {what}, the first two {first_two}: {ft}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 targets of 1 to 4 values in four kinds, 500 each: reached by up
    // to 8 moves with no value past 200; values from 1 to 6; values from 1
    // to 30; and reached by up to 8 moves, one value then raised by 1 or
    // 2. Every target is drawn before any arm answers.
    let mut seed = 13541;
    let mut cases: Vec[Vec[i32]] = Vec.new();
    for c in 0..2000 {
        let kind = c / 500;
        let n = 1 + next_random(mut seed) % 4;
        let mut target: Vec[i32] = Vec.new();
        if kind == 0 or kind == 3 {
            target = reached(mut seed, n, next_random(mut seed) % 9, 200);
        } else {
            let top = if kind == 1 { 6 } else { 30 };
            for _ in 0..n {
                target.push((1 + next_random(mut seed) % top) as i32);
            }
        }
        if kind == 3 {
            let i = next_random(mut seed) % n;
            target[i] += (1 + next_random(mut seed) % 2) as i32;
        }
        cases.push(target);
    }
    for target in cases.iter() {
        check_case(mut t, target);
    }
    println(f"{t.cases} targets: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
