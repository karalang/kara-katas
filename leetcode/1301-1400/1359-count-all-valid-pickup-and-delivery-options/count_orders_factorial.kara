// LeetCode #1359: Count All Valid Pickup and Delivery Options -- the
// factorial arm: of the (2n)! orders of the 2n events, each pair's two
// events come pickup first in exactly half, and the pairs are independent,
// so the count is (2n)! / 2^n; the division is a multiplication by the
// inverse of 2^n, 2^(n (p - 2)) by Fermat's little theorem, p = 10^9 + 7.
// O(n + log p)
const MOD: i64 = 1000000007;

fn power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut b = base % MOD;
    let mut e = exp;
    while e > 0 {
        if e % 2 == 1 {
            result = result * b % MOD;
        }
        b = b * b % MOD;
        e /= 2;
    }
    result
}

fn count_orders(n: i32) -> i32 {
    let mut factorial: i64 = 1;
    for k in 1..2 * n as i64 + 1 {
        factorial = factorial * k % MOD;
    }
    let halves = power(power(2, n), MOD - 2);
    (factorial * halves % MOD) as i32
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; 4, 10 and 500, the constraints' largest
    println(f"{count_orders(1)} {count_orders(2)} {count_orders(3)} {count_orders(4)} {count_orders(10)} {count_orders(500)}");
    // every n from 1 to 500, folded into a checksum
    let mut check: i64 = 0;
    for n in 1..501 {
        check = (check * 131 + count_orders(n)) % MOD;
    }
    println(f"n from 1 to 500: checksum {check}");
}
