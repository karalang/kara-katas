// LeetCode #1359: Count All Valid Pickup and Delivery Options --
// differential test of the five arms against the statement read
// literally, with five more properties.
//
// The statement: given n orders, each a pickup and a delivery, count the
// valid sequences of all 2n events, those in which every delivery comes
// after its own pickup, modulo 10^9 + 7.

// ---- count_orders.kara ----
const A0_MOD: i64 = 1000000007;

fn a0_count_orders(n: i32) -> i32 {
    let mut count: i64 = 1;
    for i in 1..n as i64 + 1 {
        count = count * i % A0_MOD * (2 * i - 1) % A0_MOD;
    }
    count as i32
}

// ---- count_orders_dp.kara ----
const A1_MOD: i64 = 1000000007;

fn a1_count_orders(n: i32) -> i32 {
    let size = n as i64 + 1;
    // ways[p * size + d]: the orders to finish from p waiting, d on the way
    let mut ways: Vec[i64] = Vec.filled(size * size, 0);
    for p in 0..size {
        for d in 0..size - p {
            if p == 0 and d == 0 {
                ways[0] = 1;
                continue;
            }
            let mut w = 0;
            if p > 0 {
                w += p * ways[(p - 1) * size + d + 1];
            }
            if d > 0 {
                w += d * ways[p * size + d - 1];
            }
            ways[p * size + d] = w % A1_MOD;
        }
    }
    ways[(size - 1) * size] as i32
}

// ---- count_orders_factorial.kara ----
const A2_MOD: i64 = 1000000007;

fn a2_power(base: i64, exp: i64) -> i64 {
    let mut result = 1;
    let mut b = base % A2_MOD;
    let mut e = exp;
    while e > 0 {
        if e % 2 == 1 {
            result = result * b % A2_MOD;
        }
        b = b * b % A2_MOD;
        e /= 2;
    }
    result
}

fn a2_count_orders(n: i32) -> i32 {
    let mut factorial: i64 = 1;
    for k in 1..2 * n as i64 + 1 {
        factorial = factorial * k % A2_MOD;
    }
    let halves = a2_power(a2_power(2, n), A2_MOD - 2);
    (factorial * halves % A2_MOD) as i32
}

// ---- count_orders_gaps.kara ----
const A3_MOD: i64 = 1000000007;

fn a3_count_orders(n: i32) -> i32 {
    let mut count: i64 = 1;
    for i in 1..n as i64 + 1 {
        let gaps = 2 * i - 1;
        let mut ways: i64 = 0;
        for pickup in 1..gaps + 1 {
            // the delivery goes after the pickup, in the same gap or a later one
            ways += gaps - pickup + 1;
        }
        count = count * (ways % A3_MOD) % A3_MOD;
    }
    count as i32
}

// ---- count_orders_solution.kara ----
const A4_MOD: i64 = 1_000_000_007;

struct A4Solution {}

impl A4Solution {
    pub fn a4_count_orders(n: i32) -> i32 {
        let mut ans: i64 = 1;
        for i in 1..=n as i64 {
            ans = ans * i % A4_MOD * (2 * i - 1) % A4_MOD;
        }
        ans as i32
    }
}

fn a4_count_orders(n: i32) -> i32 {
    A4Solution.a4_count_orders(n)
}

// ---- the differential -------------------------------------------------------

const P: i64 = 1000000007;

// the ways to finish from a state, the state an order's place in base 3:
// 0 waiting to be picked up, 1 on the way, 2 delivered. Each step puts
// next any waiting pickup or the delivery of any order on the way
fn finish(state: i64, n: i64, memo: mut ref Map[i64, i64]) -> i64 {
    if let Some(w) = memo.get(state) {
        return w;
    }
    let mut ways = 0;
    let mut done = true;
    let mut place = 1;
    for _ in 0..n {
        let digit = (state / place) % 3;
        if digit < 2 {
            done = false;
            ways = (ways + finish(state + place, n, mut memo)) % P;
        }
        place *= 3;
    }
    if done {
        ways = 1;
    }
    memo.insert(state, ways);
    ways
}

// the statement read literally: the 2n events put in order one at a time,
// every choice followed, counted when all are placed; a memo on which
// orders are waiting, on the way and delivered
fn literal(n: i64) -> i64 {
    let mut memo: Map[i64, i64] = Map.new();
    finish(0, n, mut memo)
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, n: i64) -> i64 {
    let got = match i {
        0 => a0_count_orders(n as i32),
        1 => a1_count_orders(n as i32),
        2 => a2_count_orders(n as i32),
        3 => a3_count_orders(n as i32),
        _ => a4_count_orders(n as i32),
    };
    got
}

fn check_case(t: mut ref Tally, n: i64) {
    t.cases += 1;
    let want = if n <= 8 { literal(n) } else { -1 };
    t.check = (t.check * 131 + want + n) % P;
    // (2n)!, 2^n, n! and (2n - 1)!!, each modulo p
    let mut every = 1;
    let mut two = 1;
    let mut fact = 1;
    let mut odd = 1;
    for k in 1..2 * n + 1 {
        every = every * k % P;
    }
    for k in 1..n + 1 {
        two = two * 2 % P;
        fact = fact * k % P;
        odd = odd * (2 * k - 1) % P;
    }
    let star = arm(0, n);
    for i in 0..5 {
        let got = arm(i, n);
        let what = f"arm {i} at n = {n}";
        // P1: the statement read literally, for n up to 8
        if n <= 8 {
            expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        }
        // P2: one order more: the new pickup and delivery go into the 2n + 1
        // gaps in (n + 1)(2n + 1) ways
        if n < 500 {
            let more = arm(i, n + 1);
            expect(mut t, 2, more == got * ((n + 1) * (2 * n + 1) % P) % P, f"P2 {what}, n + 1: {more}");
        }
        // P3: each pair in order in half the (2n)! orders: times 2^n, (2n)!
        expect(mut t, 3, got * two % P == every, f"P3 {what}: {got}");
        // P4: a residue modulo p, and not 0, since p is a prime above 2n
        expect(mut t, 4, got > 0 and got < P, f"P4 {what}: {got}");
        // P5: the orders' own order times the ways to pair the 2n places,
        // n! (2n - 1)!!
        expect(mut t, 5, got == fact * odd % P, f"P5 {what}: {got}");
        // P6: the ★ arm's count
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // every n from 1 to 500, the constraints' whole range
    for n in 1..501 {
        check_case(mut t, n);
    }
    println(f"{t.cases} values of n: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
