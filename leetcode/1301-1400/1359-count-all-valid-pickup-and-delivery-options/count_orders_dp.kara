// LeetCode #1359: Count All Valid Pickup and Delivery Options -- the dp
// arm: the events put in order one at a time, counting by how many
// orders wait to be picked up and how many are on the way. From p waiting
// and d on the way, any of the p can be picked up, which puts one more on
// the way, or any of the d delivered. O(n^2)
const MOD: i64 = 1000000007;

fn count_orders(n: i32) -> i32 {
    let size = n as i64 + 1;
    // ways[p * size + d]: the orders to finish from p waiting, d on the way
    let mut ways: Vec[i64] = Vec.filled(size * size, 0);
    for p in 0..size {
        for d in 0..size - p {
            if p == 0 and d == 0 {
                ways[0] = 1;
                continue;
            }
            let mut w = 0;
            if p > 0 {
                w += p * ways[(p - 1) * size + d + 1];
            }
            if d > 0 {
                w += d * ways[p * size + d - 1];
            }
            ways[p * size + d] = w % MOD;
        }
    }
    ways[(size - 1) * size] as i32
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; 4, 10 and 500, the constraints' largest
    println(f"{count_orders(1)} {count_orders(2)} {count_orders(3)} {count_orders(4)} {count_orders(10)} {count_orders(500)}");
    // every n from 1 to 500, folded into a checksum
    let mut check: i64 = 0;
    for n in 1..501 {
        check = (check * 131 + count_orders(n)) % MOD;
    }
    println(f"n from 1 to 500: checksum {check}");
}
