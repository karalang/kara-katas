// LeetCode #1359: Count All Valid Pickup and Delivery Options -- a Rust
// solution as LeetCode's Rust users write it, carried to Kāra by `karac
// fix`.

const MOD: i64 = 1_000_000_007;

struct Solution {}

impl Solution {
    pub fn count_orders(n: i32) -> i32 {
        let mut ans: i64 = 1;
        for i in 1..=n as i64 {
            ans = ans * i % MOD * (2 * i - 1) % MOD;
        }
        ans as i32
    }
}

fn count_orders(n: i32) -> i32 {
    Solution.count_orders(n)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; 4, 10 and 500, the constraints' largest
    println(f"{count_orders(1)} {count_orders(2)} {count_orders(3)} {count_orders(4)} {count_orders(10)} {count_orders(500)}");
    // every n from 1 to 500, folded into a checksum
    let mut check: i64 = 0;
    for n in 1..501 {
        check = (check * 131 + count_orders(n)) % MOD;
    }
    println(f"n from 1 to 500: checksum {check}");
}
