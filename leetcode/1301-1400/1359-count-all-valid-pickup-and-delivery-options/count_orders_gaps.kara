// LeetCode #1359: Count All Valid Pickup and Delivery Options -- the gaps
// arm: the i-th order's pickup goes into one of the 2i - 1 gaps the
// orders before it leave, and its delivery into any gap after that; the
// pairs of gaps are counted one by one rather than summed in closed form.
// O(n^2)
const MOD: i64 = 1000000007;

fn count_orders(n: i32) -> i32 {
    let mut count: i64 = 1;
    for i in 1..n as i64 + 1 {
        let gaps = 2 * i - 1;
        let mut ways: i64 = 0;
        for pickup in 1..gaps + 1 {
            // the delivery goes after the pickup, in the same gap or a later one
            ways += gaps - pickup + 1;
        }
        count = count * (ways % MOD) % MOD;
    }
    count as i32
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; 4, 10 and 500, the constraints' largest
    println(f"{count_orders(1)} {count_orders(2)} {count_orders(3)} {count_orders(4)} {count_orders(10)} {count_orders(500)}");
    // every n from 1 to 500, folded into a checksum
    let mut check: i64 = 0;
    for n in 1..501 {
        check = (check * 131 + count_orders(n)) % MOD;
    }
    println(f"n from 1 to 500: checksum {check}");
}
