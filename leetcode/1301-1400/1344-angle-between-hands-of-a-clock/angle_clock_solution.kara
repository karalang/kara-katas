// LeetCode #1344: Angle Between Hands of a Clock -- a Rust solution as
// LeetCode's Rust users write it (the hands as `f64` from `hour as f64 %
// 12.0 * 30.0 + minutes as f64 / 2.0` and `minutes as f64 * 6.0`, the gap
// by `(h - m).abs()`, the answer `diff.min(360.0 - diff)`), carried to
// Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn angle_clock(hour: i32, minutes: i32) -> f64 {
        let h = hour as f64 % 12.0 * 30.0 + minutes as f64 / 2.0;
        let m = minutes as f64 * 6.0;
        let diff = (h - m).abs();
        diff.min(360.0 - diff)
    }
}

fn angle_clock(hour: i32, minutes: i32) -> f64 {
    Solution.angle_clock(hour, minutes)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; noon; six o'clock; and 1:05, where the
    // hands nearly meet
    println(f"{angle_clock(12, 30)} {angle_clock(3, 30)} {angle_clock(3, 15)} {angle_clock(12, 0)} {angle_clock(6, 0)} {angle_clock(1, 5)}");
    // every one of the 720 times; each angle is a whole number of half
    // degrees, so twice it is folded into the checksum exactly
    let mut total = 0.0;
    let mut largest = 0.0;
    let mut check: i64 = 0;
    for hour in 1..13 {
        for minutes in 0..60 {
            let a = angle_clock(hour, minutes);
            total += a;
            largest = largest.max(a);
            check = (check * 131 + (2.0 * a) as i64) % 1000000007;
        }
    }
    println(f"720 times: angles total {total}, largest {largest}, checksum {check}");
}
