// LeetCode #1344: Angle Between Hands of a Clock -- the walk arm: both
// hands set at 12 and moved one minute at a time, in half degrees so every
// step is whole: the hour hand 1 a minute and the minute hand 12, round a
// face of 720. Then the gap between them, the shorter way round, halved
// into degrees. O(minutes since 12)

fn angle_clock(hour: i32, minutes: i32) -> f64 {
    let mut hour_hand = 0;
    let mut minute_hand = 0;
    for _ in 0..hour % 12 * 60 + minutes {
        hour_hand += 1;
        minute_hand = (minute_hand + 12) % 720;
    }
    let gap = (minute_hand - hour_hand + 720) % 720;
    let shorter = if gap > 360 { 720 - gap } else { gap };
    shorter as f64 / 2.0
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; noon; six o'clock; and 1:05, where the
    // hands nearly meet
    println(f"{angle_clock(12, 30)} {angle_clock(3, 30)} {angle_clock(3, 15)} {angle_clock(12, 0)} {angle_clock(6, 0)} {angle_clock(1, 5)}");
    // every one of the 720 times; each angle is a whole number of half
    // degrees, so twice it is folded into the checksum exactly
    let mut total = 0.0;
    let mut largest = 0.0;
    let mut check: i64 = 0;
    for hour in 1..13 {
        for minutes in 0..60 {
            let a = angle_clock(hour, minutes);
            total += a;
            largest = largest.max(a);
            check = (check * 131 + (2.0 * a) as i64) % 1000000007;
        }
    }
    println(f"720 times: angles total {total}, largest {largest}, checksum {check}");
}
