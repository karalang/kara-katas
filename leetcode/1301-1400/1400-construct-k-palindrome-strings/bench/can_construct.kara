// LeetCode #1400 bench: the ★ arm (at least k letters, and at most k
// letters that appear an odd number of times, the letters counted in an
// array of 26) on 10^5 letters, one letter and k changed, at places drawn
// from the checksum so far, before each of 3000 rounds.

fn can_construct(s: String, k: i32) -> bool {
    if s.len() < k {
        return false;
    }
    let mut count: Vec[i64] = Vec.filled(26, 0);
    for b in s.bytes().iter() {
        count[b - b'a'] += 1;
    }
    let odd = count.iter().filter(|c| c % 2 == 1).count();
    odd <= k
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 100000;
    let mut seed = 1400;
    let mut letters: Vec[u8] = (0..n).map(|_| (97 + next_random(mut seed) % 26) as u8).collect();
    let mut check: i64 = 0;
    for _ in 0..3000 {
        seed = (seed + check) % 2147483648;
        let at = next_random(mut seed) % n;
        letters[at] = (97 + next_random(mut seed) % 26) as u8;
        let k = 1 + next_random(mut seed) % 30;
        let s = String.from_utf8(letters).unwrap();
        let got = can_construct(s, k as i32);
        check = (check * 131 + (if got { k } else { 0 }) + at) % 1000000007;
    }
    println(f"3000 rounds over 10^5 letters: checksum {check}");
}
