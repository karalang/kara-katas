// LeetCode #1400: Construct K Palindrome Strings -- differential test of
// the five arms against the statement read literally, with five more
// properties.

// ---- can_construct.kara ----
fn a0_can_construct(s: String, k: i32) -> bool {
    if s.len() < k {
        return false;
    }
    let mut count: Vec[i64] = Vec.filled(26, 0);
    for b in s.bytes().iter() {
        count[b - b'a'] += 1;
    }
    let odd = count.iter().filter(|c| c % 2 == 1).count();
    odd <= k
}

// ---- can_construct_map.kara ----
fn a1_can_construct(s: String, k: i32) -> bool {
    let mut count: Map[char, i64] = Map.new();
    for c in s.chars() {
        *count.entry(c).or_insert(0) += 1;
    }
    let odd = count.values().filter(|n| n % 2 == 1).count();
    s.len() >= k and odd <= k
}

// ---- can_construct_bits.kara ----
fn a2_can_construct(s: String, k: i32) -> bool {
    let mut mask: u32 = 0;
    for b in s.bytes().iter() {
        mask ^= 1 << (b - b'a');
    }
    s.len() >= k and mask.count_ones() <= k
}

// ---- can_construct_sorted.kara ----
fn a3_can_construct(s: String, k: i32) -> bool {
    let mut letters: Vec[char] = s.chars().collect();
    letters.sort();
    let mut odd = 0;
    let mut start = 0;
    while start < letters.len() {
        let mut end = start + 1;
        while end < letters.len() and letters[end] == letters[start] {
            end += 1;
        }
        if (end - start) % 2 == 1 {
            odd += 1;
        }
        start = end;
    }
    letters.len() >= k and odd <= k
}

// ---- can_construct_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_can_construct(s: String, k: i32) -> bool {
        if s.len() < k {
            return false;
        }
        let mut freq = [0; 26];
        for c in s.chars() {
            freq[(c as u32 as u8 - b'a') as usize] += 1;
        }
        let odd = freq.iter().filter(|x| x % 2 == 1).count();
        odd <= k
    }
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters drawn from the first `letters` of the alphabet
fn drawn(n: i64, letters: i64, seed: mut ref i64) -> String {
    let out: Vec[char] = (0..n).map(|_| (97 + next_random(mut seed) % letters) as u8 as char).collect();
    out.iter().collect()
}

// whether the letters put in each of the k groups can be laid out as a
// palindrome: at most one letter an odd number of times
fn all_palindromes(b: Slice[u8], group: Vec[i64], k: i64) -> bool {
    for g in 0..k {
        let mut count: Vec[i64] = Vec.filled(26, 0);
        for i in 0..b.len() {
            if group[i] == g {
                count[b[i] - b'a'] += 1;
            }
        }
        let mut odd = 0;
        for c in count.iter() {
            if c % 2 == 1 {
                odd += 1;
            }
        }
        if odd > 1 {
            return false;
        }
    }
    true
}

// every way to put letters i.. into the k groups, `used` of them taken so
// far, each new group the next one, so each split is tried once
fn split(b: Slice[u8], i: i64, k: i64, used: i64, group: mut ref Vec[i64]) -> bool {
    if i == b.len() {
        return used == k and all_palindromes(b, group, k);
    }
    if used + (b.len() - i) < k {
        return false;
    }
    for g in 0..=used.min(k - 1) {
        group[i] = g;
        if split(b, i + 1, k, used.max(g + 1), mut group) {
            return true;
        }
    }
    false
}

// the statement read literally: every split of the letters into k
// non-empty groups tried, until one whose every group can be a palindrome
fn literal(s: String, k: i64) -> bool {
    let b = s.bytes();
    let mut group: Vec[i64] = Vec.filled(b.len(), 0);
    split(b, 0, k, 0, mut group)
}

fn arm(i: i64, s: String, k: i64) -> bool {
    let k = k as i32;
    match i {
        0 => a0_can_construct(s, k),
        1 => a1_can_construct(s, k),
        2 => a2_can_construct(s, k),
        3 => a3_can_construct(s, k),
        _ => A4Solution.a4_can_construct(s, k),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, c: i64, s: String, k: i64) {
    t.cases += 1;
    let want = literal(s, k);
    t.check = (t.check * 131 + (if want { k } else { 0 })) % 1000000007;
    t.check = (t.check * 131 + s.len()) % 1000000007;
    let n = s.len();
    let star = arm(0, s, k);
    let backwards: String = s.chars().rev().collect();
    let first = s[0..1].to_string();
    let paired = f"{s}{first}{first}";
    for i in 0..5 {
        let got = arm(i, s, k);
        let what = f"arm {i} on case {c} ({s}, {k})";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: the letters read backwards: the same
        let back = arm(i, backwards, k);
        expect(mut t, 2, back == got, f"P2 {what}, backwards: {back}");
        // P3: k palindromes that can be made leave k + 1 possible while
        // there are letters enough: one splits off its middle or its ends
        let more = arm(i, s, k + 1);
        expect(mut t, 3, not got or k + 1 > n or more, f"P3 {what}: {got}, but {more} for k + 1");
        // P4: two more of the first letter, which can wrap any
        // palindrome, change nothing while there are k letters already
        let wrapped = arm(i, paired, k);
        expect(mut t, 4, k > n or wrapped == got, f"P4 {what}: {wrapped} with {first}{first} added");
        // P5: every letter its own palindrome, so k = n can be made, and
        // k = n + 1 cannot
        let ends = (arm(i, s, n), arm(i, s, n + 1));
        expect(mut t, 5, ends == (true, false), f"P5 {what}: {ends} for k = n, n + 1");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    let mut cases: Vec[(String, i64)] = Vec.new();
    // LeetCode's three examples
    cases.push(("annabelle".to_string(), 2));
    cases.push(("leetcode".to_string(), 3));
    cases.push(("true".to_string(), 4));
    // 2000 random cases of 1 to 8 letters from the first 1 to 5, k from 1
    // to 9. Every case is drawn before any arm answers.
    let mut seed = 14001;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 8;
        let letters = 1 + next_random(mut seed) % 5;
        let s = drawn(n, letters, mut seed);
        let k = 1 + next_random(mut seed) % 9;
        cases.push((s, k));
    }
    let mut c = 0;
    for (s, k) in cases.iter() {
        check_case(mut t, c, s, k);
        c += 1;
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
