// LeetCode #1310: XOR Queries of a Subarray -- the Fenwick arm: a binary
// indexed tree whose node i holds the XOR of the `i & -i` numbers ending at
// i, built by XORing each number into the nodes above it; a prefix's XOR
// read off along `i -= i & -i`, and a range's from two prefixes.
// O((n + q) log n)

fn prefix_xor(tree: Vec[i64], end: i64) -> i64 {
    let mut x = 0;
    let mut i = end;
    while i > 0 {
        x ^= tree[i];
        i -= i & -i;
    }
    x
}

fn xor_queries(arr: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let n = arr.len();
    let mut tree: Vec[i64] = Vec.filled(n + 1, 0);
    for k in 0..n {
        let mut i = k + 1;
        while i <= n {
            tree[i] ^= arr[k];
            i += i & -i;
        }
    }
    queries.iter().map(|q| prefix_xor(tree, q[1] + 1) ^ prefix_xor(tree, q[0])).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    parts.join(",")
}

fn main() {
    // LeetCode's two examples, one number asked alone, and the largest
    // numbers, 10^9, over a range of two that cancels
    let e1 = xor_queries([1, 3, 4, 8], [[0, 1], [1, 2], [0, 3], [3, 3]]);
    let e2 = xor_queries([4, 8, 2, 10], [[2, 3], [1, 3], [0, 0], [0, 3]]);
    let one = xor_queries([7], [[0, 0]]);
    let big = xor_queries([1000000000, 1000000000, 999999999], [[0, 1], [0, 2], [1, 2]]);
    println(f"{show(e1)} {show(e2)} {show(one)} {show(big)}");
    // 1000 random arrays of 1 to 300 numbers up to 1, 1000 or 10^9, each
    // with 1 to 300 random ranges
    let mut seed = 1310;
    let mut total = 0;
    let mut check = 0;
    for i in 0..1000 {
        let top = if i % 3 == 0 { 2 } else if i % 3 == 1 { 1001 } else { 1000000001 };
        let n = 1 + next_random(mut seed) % 300;
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            arr.push((next_random(mut seed) * 65536 + next_random(mut seed)) % top);
        }
        let q = 1 + next_random(mut seed) % 300;
        let mut queries: Vec[Vec[i64]] = Vec.new();
        for _ in 0..q {
            let a = next_random(mut seed) % n;
            let b = next_random(mut seed) % n;
            queries.push(if a <= b { [a, b] } else { [b, a] });
        }
        let got = xor_queries(arr, queries);
        total += got.len();
        for x in got.iter() {
            check = (check * 31 + x) % 1000000007;
        }
    }
    println(f"1000 random arrays: {total} answers, checksum {check}");
}
