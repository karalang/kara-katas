// LeetCode #1310 bench: the ★ arm (a prefix XOR, each answer the XOR of the
// prefixes at the range's two ends) on 10 arrays of 3 * 10^4 numbers up to
// 10^9, each with 3 * 10^4 ranges, the constraints' most, built once; then
// 100 passes, each setting one number and one range of every array from the
// checksum so far, so no answer carries over, answering every range and
// folding two of the answers, at places chosen by the checksum, plus the
// pass into the checksum.

fn xor_queries(arr: Vec[i64], queries: Vec[Vec[i64]]) -> Vec[i64] {
    let mut prefix: Vec[i64] = Vec.filled(arr.len() + 1, 0);
    for i in 0..arr.len() {
        prefix[i + 1] = prefix[i] ^ arr[i];
    }
    queries.iter().map(|q| prefix[q[1] + 1] ^ prefix[q[0]]).collect()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 30000;
    let m = 30000;
    let mut seed = 1310;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    let mut ranges: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..10 {
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            let hi = next_random(mut seed);
            let lo = next_random(mut seed);
            arr.push(1 + (hi * 65536 + lo) % 1000000000);
        }
        arrays.push(arr);
        let mut queries: Vec[Vec[i64]] = Vec.new();
        for _ in 0..m {
            let a = next_random(mut seed) % n;
            let b = next_random(mut seed) % n;
            queries.push(if a <= b { [a, b] } else { [b, a] });
        }
        ranges.push(queries);
    }
    let mut check: i64 = 0;
    for pass in 0..100 {
        for a in 0..10 {
            arrays[a][check % n] = 1 + (check / 7) % 1000000000;
            let x = (check / 11) % n;
            let y = (check / 13) % n;
            ranges[a][check % m] = if x <= y { [x, y] } else { [y, x] };
            let got = xor_queries(arrays[a], ranges[a]);
            check = (check * 31 + got[(check / 3) % m]) % 1000000007;
            check = (check * 31 + got[(check / 17) % m] + pass) % 1000000007;
        }
    }
    println(f"100 passes over 10 arrays of 3 * 10^4: checksum {check}");
}
