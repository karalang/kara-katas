// LeetCode #1392 bench: the ★ arm (the prefix function over the bytes) on
// 10^5 letters, a block of 7 repeated, one letter changed before each of
// 2000 rounds and put back after it.

fn longest_prefix(s: String) -> String {
    let b = s.bytes();
    let n = b.len();
    let mut border: Vec[i64] = Vec.filled(n, 0);
    let mut k = 0;
    for i in 1..n {
        while k > 0 and b[i] != b[k] {
            k = border[k - 1];
        }
        if b[i] == b[k] {
            k += 1;
        }
        border[i] = k;
    }
    s[0..border[n - 1]].to_string()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 100000;
    let block = "abacaba".bytes();
    let mut letters: Vec[u8] = (0..n).map(|i| block[i % 7]).collect();
    let mut seed = 1392;
    let mut check: i64 = 0;
    for _ in 0..2000 {
        seed = (seed + check) % 2147483648;
        let at = next_random(mut seed) % n;
        let was = letters[at];
        letters[at] = (97 + next_random(mut seed) % 3) as u8;
        let s = String.from_utf8(letters).unwrap();
        let got = longest_prefix(s);
        letters[at] = was;
        check = (check * 131 + got.len() * 7 + at) % 1000000007;
    }
    println(f"2000 rounds over 10^5 letters: checksum {check}");
}
