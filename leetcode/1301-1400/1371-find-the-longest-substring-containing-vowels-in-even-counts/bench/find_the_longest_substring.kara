// LeetCode #1371 bench -- the ★ arm: each vowel's count kept as a parity
// bit, and the answer the furthest apart two prefixes with the same bits
// are.
fn find_the_longest_substring(s: Str) -> i32 {
    let mut first: Vec[i64] = Vec.filled(32, -2);
    first[0] = -1;
    let mut bits = 0;
    let mut best = 0;
    for (i, c) in s.chars().enumerate() {
        match c {
            'a' => bits ^= 1,
            'e' => bits ^= 2,
            'i' => bits ^= 4,
            'o' => bits ^= 8,
            'u' => bits ^= 16,
            _ => {}
        }
        if first[bits] == -2 {
            first[bits] = i;
        } else {
            best = best.max(i - first[bits]);
        }
    }
    best as i32
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 4 strings of 5 * 10^5 letters, the constraints' most, drawn from
    // "aeioubcxyz", built once; then 80 rounds, each changing one letter
    // of one string to a copy, both drawn from the checksum so far, and
    // finding that string's longest substring
    let pool: Vec[u8] = "aeioubcxyz".bytes().iter().collect();
    let mut seed = 1371;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..4 {
        let mut bytes: Vec[u8] = Vec.new();
        for _ in 0..500000 {
            bytes.push(pool[next_random(mut seed) % 10]);
        }
        strings.push(String.from_utf8(bytes).unwrap());
    }
    let mut check: i64 = 0;
    for r in 0..80 {
        let i = check % 4;
        let at = (check / 4) % 500000;
        let mut bytes: Vec[u8] = strings[i].bytes().iter().collect();
        bytes[at] = pool[(check / 2000000) % 10];
        strings[i] = String.from_utf8(bytes).unwrap();
        let got = find_the_longest_substring(strings[i]) as i64;
        check = (check * 31 + got + r) % 1000000007;
    }
    println(f"80 rounds over 4 strings of 500000 letters: checksum {check}");
}
