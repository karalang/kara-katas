// LeetCode #1371: Find the Longest Substring Containing Vowels in Even
// Counts -- the twopass arm: a first pass writes every prefix's vowel
// bits; a second records each pattern's first and last prefix, and the
// answer is the widest such pair. O(n)
fn find_the_longest_substring(s: Str) -> i32 {
    let bytes = s.bytes();
    // prefix[k]: the bits of the first k letters
    let mut prefix: Vec[i64] = [0];
    for b in bytes.iter() {
        let flip = match b {
            b'a' => 1,
            b'e' => 2,
            b'i' => 4,
            b'o' => 8,
            b'u' => 16,
            _ => 0,
        };
        prefix.push(prefix[prefix.len() - 1] ^ flip);
    }
    let mut lo: Vec[i64] = Vec.filled(32, -1);
    let mut hi: Vec[i64] = Vec.filled(32, -1);
    for k in 0..prefix.len() {
        let p = prefix[k];
        if lo[p] < 0 {
            lo[p] = k;
        }
        hi[p] = k;
    }
    let mut best = 0;
    for p in 0..32 {
        if lo[p] >= 0 {
            best = best.max(hi[p] - lo[p]);
        }
    }
    best as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; one vowel, two of it, and a string of
    // 2000 letters cycling through the alphabet
    let mut cycle = String.new();
    for i in 0..2000 {
        cycle.push((b'a' + (i % 26) as u8) as char);
    }
    let shown: Vec[String] = ["eleetminicoworoep", "leetcodeisgreat", "bcbcbc", "a", "aa", cycle.as_str()].iter().map(|s| f"{find_the_longest_substring(s)}").collect();
    println(shown.join(" "));
    // 2000 random strings of 1 to 300 letters, drawn from the first 1 to
    // 10 of "aeioubcxyz", or from the whole alphabet
    let pool: Vec[char] = "aeioubcxyz".chars().collect();
    let mut seed = 1371;
    let mut total = 0;
    let mut check: i64 = 0;
    for _ in 0..2000 {
        let len = 1 + next_random(mut seed) % 300;
        let kinds = 1 + next_random(mut seed) % 11;
        let mut s = String.new();
        for _ in 0..len {
            let r = next_random(mut seed);
            if kinds == 11 {
                s.push((b'a' + (r % 26) as u8) as char);
            } else {
                s.push(pool[r % kinds]);
            }
        }
        let got = find_the_longest_substring(s) as i64;
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random strings: lengths total {total}, checksum {check}");
}
