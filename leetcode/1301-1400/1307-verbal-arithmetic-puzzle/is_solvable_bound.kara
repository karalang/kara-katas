// LeetCode #1307: Verbal Arithmetic Puzzle -- the bounding arm: the puzzle as
// one sum, each letter weighed by the place values it stands at (plus in the
// words, minus in the result), so that a solution makes the weighted digits
// add up to 0; the letters tried heaviest first, and a branch dropped once
// the letters still free could no longer bring the sum back to 0, even
// ignoring that their digits must differ.

struct Search {
    weight: Vec[i64],
    lead: Vec[bool],
    // the least and the most the letters from each place on can add
    low: Vec[i64],
    high: Vec[i64],
    taken: Vec[bool],
}

fn search(s: mut ref Search, i: i64, sum: i64) -> bool {
    if i == s.weight.len() {
        return sum == 0;
    }
    if sum + s.low[i] > 0 or sum + s.high[i] < 0 {
        return false;
    }
    let first = if s.lead[i] { 1 } else { 0 };
    for d in first..10 {
        if s.taken[d] {
            continue;
        }
        s.taken[d] = true;
        let ok = search(mut s, i + 1, sum + s.weight[i] * d);
        s.taken[d] = false;
        if ok {
            return true;
        }
    }
    false
}

fn is_solvable(words: Vec[String], result: String) -> bool {
    let mut weight: Vec[i64] = Vec.filled(26, 0);
    let mut seen: Vec[bool] = Vec.filled(26, false);
    let mut lead: Vec[bool] = Vec.filled(26, false);
    let mut texts = words.clone();
    texts.push(result.clone());
    for t in 0..texts.len() {
        let sign = if t == texts.len() - 1 { -1 } else { 1 };
        let chars: Vec[char] = texts[t].chars().collect();
        let mut place = 1;
        for k in (0..chars.len()).rev() {
            let c = chars[k] as i64 - 'A' as i64;
            weight[c] += sign * place;
            seen[c] = true;
            place *= 10;
        }
        if chars.len() > 1 {
            lead[chars[0] as i64 - 'A' as i64] = true;
        }
    }
    let mut order: Vec[i64] = (0..26).filter(|c| seen[c]).collect();
    order.sort_by_key(|c| -weight[c].abs());
    let n = order.len();
    let mut s = Search { weight: Vec.new(), lead: Vec.new(), low: Vec.filled(n + 1, 0), high: Vec.filled(n + 1, 0), taken: Vec.filled(10, false) };
    for c in order.iter() {
        s.weight.push(weight[c]);
        s.lead.push(lead[c]);
    }
    for i in (0..n).rev() {
        let least = if s.lead[i] { 1 } else { 0 };
        let a = s.weight[i] * least;
        let b = s.weight[i] * 9;
        s.low[i] = s.low[i + 1] + a.min(b);
        s.high[i] = s.high[i + 1] + a.max(b);
    }
    search(mut s, 0, 0)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn puzzle(words: Vec[Str], result: Str) -> bool {
    is_solvable(words.iter().map(|w| w.to_string()).collect(), result.to_string())
}

fn main() {
    // LeetCode's three examples; a one-letter word may be 0 (A + B = A, with
    // B = 0); a result shorter than a word; a letter on both sides (A + A =
    // B); and two words whose first letters may not be 0
    let e1 = puzzle(["SEND", "MORE"], "MONEY");
    let e2 = puzzle(["SIX", "SEVEN", "SEVEN"], "TWENTY");
    let e3 = puzzle(["LEET", "CODE"], "POINT");
    let zero = puzzle(["A", "B"], "A");
    let short = puzzle(["AB", "CD"], "E");
    let twice = puzzle(["A", "A"], "B");
    let lead = puzzle(["AB", "BA"], "CC");
    println(f"{e1} {e2} {e3} {zero} {short} {twice} {lead}");
    // 600 random puzzles: half of them a true sum of 2 to 4 numbers of 1 to 3
    // digits, written with a letter for each digit it uses, no more than 6;
    // half 2 to 4 words over 2 to 5 letters with a result of random letters
    let letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J'];
    let mut seed = 1307;
    let mut solvable = 0;
    let mut check = 0;
    for p in 0..600 {
        let count = 2 + next_random(mut seed) % 3;
        let mut words: Vec[String] = Vec.new();
        let mut result = String.new();
        if p % 2 == 0 {
            let mut texts: Vec[String] = Vec.new();
            let mut digits: Vec[char] = Vec.new();
            loop {
                texts = Vec.new();
                let mut sum = 0;
                for _ in 0..count {
                    let len = 1 + next_random(mut seed) % 3;
                    let low = if len == 1 { 0 } else if len == 2 { 10 } else { 100 };
                    let value = low + next_random(mut seed) % (10 * (if low == 0 { 1 } else { low }) - low);
                    texts.push(f"{value}");
                    sum += value;
                }
                texts.push(f"{sum}");
                digits = Vec.new();
                for text in texts.iter() {
                    for c in text.chars() {
                        if not digits.contains(c) {
                            digits.push(c);
                        }
                    }
                }
                if digits.len() <= 6 {
                    break;
                }
            }
            let mut written: Vec[String] = Vec.new();
            for text in texts.iter() {
                let mut word = String.new();
                for c in text.chars() {
                    let mut at = 0;
                    while digits[at] != c {
                        at += 1;
                    }
                    word.push(letters[at]);
                }
                written.push(word);
            }
            result = written.pop().unwrap();
            words = written;
        } else {
            let k = 2 + next_random(mut seed) % 4;
            for _ in 0..count {
                let len = 1 + next_random(mut seed) % 3;
                let mut word = String.new();
                for _ in 0..len {
                    word.push(letters[next_random(mut seed) % k]);
                }
                words.push(word);
            }
            let len = 1 + next_random(mut seed) % 4;
            for _ in 0..len {
                result.push(letters[next_random(mut seed) % k]);
            }
        }
        let got = is_solvable(words, result);
        if got {
            solvable += 1;
        }
        check = (check * 3 + if got { 1 } else { 0 }) % 1000000007;
    }
    println(f"600 random puzzles: {solvable} solvable, checksum {check}");
}
