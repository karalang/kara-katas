// LeetCode #1307: Verbal Arithmetic Puzzle -- the ★ arm: the sum done by
// hand, a column at a time from the right with its carry, the letters of
// each column given a digit as they are met, and the result's letter in that
// column fixed by the column's sum, so that a wrong guess fails in its own
// column. O(10!) at worst, far less in practice

struct Puzzle {
    // each word and the result as letter numbers, rightmost first
    words: Vec[Vec[i64]],
    result: Vec[i64],
    // a letter that leads a number of more than one digit
    leads: Vec[bool],
    // the digit of each letter, -1 while it has none, and the digits taken
    digit: Vec[i64],
    taken: Vec[bool],
}

// the column `col`, at word `row`, with `sum` added up so far (the carry in,
// and the column's digits of the words before `row`)
fn solve(p: mut ref Puzzle, col: i64, row: i64, sum: i64) -> bool {
    if col == p.result.len() {
        return sum == 0;
    }
    if row == p.words.len() {
        let letter = p.result[col];
        let d = sum % 10;
        if p.digit[letter] >= 0 {
            return p.digit[letter] == d and solve(mut p, col + 1, 0, sum / 10);
        }
        if p.taken[d] or (d == 0 and p.leads[letter]) {
            return false;
        }
        p.digit[letter] = d;
        p.taken[d] = true;
        let ok = solve(mut p, col + 1, 0, sum / 10);
        p.digit[letter] = -1;
        p.taken[d] = false;
        return ok;
    }
    if col >= p.words[row].len() {
        return solve(mut p, col, row + 1, sum);
    }
    let letter = p.words[row][col];
    if p.digit[letter] >= 0 {
        return solve(mut p, col, row + 1, sum + p.digit[letter]);
    }
    for d in 0..10 {
        if p.taken[d] or (d == 0 and p.leads[letter]) {
            continue;
        }
        p.digit[letter] = d;
        p.taken[d] = true;
        let ok = solve(mut p, col, row + 1, sum + d);
        p.digit[letter] = -1;
        p.taken[d] = false;
        if ok {
            return true;
        }
    }
    false
}

fn is_solvable(words: Vec[String], result: String) -> bool {
    // a word longer than the result cannot add up to it
    if words.iter().any(|w| w.len() > result.len()) {
        return false;
    }
    let mut number: Vec[i64] = Vec.filled(26, -1);
    let mut letters = 0;
    let mut leads: Vec[bool] = Vec.new();
    let mut texts = words.clone();
    texts.push(result.clone());
    let mut rows: Vec[Vec[i64]] = Vec.new();
    for text in texts.iter() {
        let mut row: Vec[i64] = Vec.new();
        for c in text.chars() {
            let k = c as i64 - 'A' as i64;
            if number[k] < 0 {
                number[k] = letters;
                letters += 1;
                leads.push(false);
            }
            row.push(number[k]);
        }
        if row.len() > 1 {
            leads[row[0]] = true;
        }
        row.reverse();
        rows.push(row);
    }
    let result_row = rows.pop().unwrap();
    let mut p = Puzzle { words: rows, result: result_row, leads, digit: Vec.filled(letters, -1), taken: Vec.filled(10, false) };
    solve(mut p, 0, 0, 0)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn puzzle(words: Vec[Str], result: Str) -> bool {
    is_solvable(words.iter().map(|w| w.to_string()).collect(), result.to_string())
}

fn main() {
    // LeetCode's three examples; a one-letter word may be 0 (A + B = A, with
    // B = 0); a result shorter than a word; a letter on both sides (A + A =
    // B); and two words whose first letters may not be 0
    let e1 = puzzle(["SEND", "MORE"], "MONEY");
    let e2 = puzzle(["SIX", "SEVEN", "SEVEN"], "TWENTY");
    let e3 = puzzle(["LEET", "CODE"], "POINT");
    let zero = puzzle(["A", "B"], "A");
    let short = puzzle(["AB", "CD"], "E");
    let twice = puzzle(["A", "A"], "B");
    let lead = puzzle(["AB", "BA"], "CC");
    println(f"{e1} {e2} {e3} {zero} {short} {twice} {lead}");
    // 600 random puzzles: half of them a true sum of 2 to 4 numbers of 1 to 3
    // digits, written with a letter for each digit it uses, no more than 6;
    // half 2 to 4 words over 2 to 5 letters with a result of random letters
    let letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J'];
    let mut seed = 1307;
    let mut solvable = 0;
    let mut check = 0;
    for p in 0..600 {
        let count = 2 + next_random(mut seed) % 3;
        let mut words: Vec[String] = Vec.new();
        let mut result = String.new();
        if p % 2 == 0 {
            let mut texts: Vec[String] = Vec.new();
            let mut digits: Vec[char] = Vec.new();
            loop {
                texts = Vec.new();
                let mut sum = 0;
                for _ in 0..count {
                    let len = 1 + next_random(mut seed) % 3;
                    let low = if len == 1 { 0 } else if len == 2 { 10 } else { 100 };
                    let value = low + next_random(mut seed) % (10 * (if low == 0 { 1 } else { low }) - low);
                    texts.push(f"{value}");
                    sum += value;
                }
                texts.push(f"{sum}");
                digits = Vec.new();
                for text in texts.iter() {
                    for c in text.chars() {
                        if not digits.contains(c) {
                            digits.push(c);
                        }
                    }
                }
                if digits.len() <= 6 {
                    break;
                }
            }
            let mut written: Vec[String] = Vec.new();
            for text in texts.iter() {
                let mut word = String.new();
                for c in text.chars() {
                    let mut at = 0;
                    while digits[at] != c {
                        at += 1;
                    }
                    word.push(letters[at]);
                }
                written.push(word);
            }
            result = written.pop().unwrap();
            words = written;
        } else {
            let k = 2 + next_random(mut seed) % 4;
            for _ in 0..count {
                let len = 1 + next_random(mut seed) % 3;
                let mut word = String.new();
                for _ in 0..len {
                    word.push(letters[next_random(mut seed) % k]);
                }
                words.push(word);
            }
            let len = 1 + next_random(mut seed) % 4;
            for _ in 0..len {
                result.push(letters[next_random(mut seed) % k]);
            }
        }
        let got = is_solvable(words, result);
        if got {
            solvable += 1;
        }
        check = (check * 3 + if got { 1 } else { 0 }) % 1000000007;
    }
    println(f"600 random puzzles: {solvable} solvable, checksum {check}");
}
