// LeetCode #1356: Sort Integers by The Number of 1 Bits -- the packed arm:
// each value packed with its number of 1 bits into one integer, the bits
// above 2^14 and the value below, so a plain sort of the packed integers
// orders by bits and then by value; the value is the remainder.
// O(n log n)
fn sort_by_bits(arr: Vec[i32]) -> Vec[i32] {
    let mut packed: Vec[i32] = arr.iter().map(|x| x.count_ones() as i32 * 16384 + x).collect();
    packed.sort();
    packed.iter().map(|p| p % 16384).collect()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one value, the largest; equal values; the
    // 14 powers of two up to 10^4, largest first; and 500 values, the
    // constraints' most, from 0 to 10^4
    println(f"{sort_by_bits([0, 1, 2, 3, 4, 5, 6, 7, 8])}");
    println(f"{sort_by_bits([1024, 512, 256, 128, 64, 32, 16, 8, 4, 2, 1])}");
    let powers: Vec[i32] = (0..14).rev().map(|k| 1 << k).collect();
    println(f"{sort_by_bits([10000])} {sort_by_bits([7, 0, 7, 0])} {sort_by_bits(powers)}");
    let mut seed = 1356;
    let big: Vec[i32] = (0..500).map(|_| (next_random(mut seed) % 10001) as i32).collect();
    let got = sort_by_bits(big);
    println(f"500 values: first {got[0]}, middle {got[250]}, last {got[499]}");
    // 2000 random arrays of 1 to 500 values, from 0 to 15, 0 to 1000 or 0
    // to 10^4, each answer folded into a checksum
    let mut check = 0;
    for c in 0..2000 {
        let n = if c % 4 == 0 { 1 + next_random(mut seed) % 500 } else { 1 + next_random(mut seed) % 20 };
        let top = if c % 3 == 0 { 16 } else if c % 3 == 1 { 1001 } else { 10001 };
        let arr: Vec[i32] = (0..n).map(|_| (next_random(mut seed) % top) as i32).collect();
        for x in sort_by_bits(arr).iter() {
            check = (check * 131 + x + 1) % 1000000007;
        }
    }
    println(f"2000 random arrays: checksum {check}");
}
