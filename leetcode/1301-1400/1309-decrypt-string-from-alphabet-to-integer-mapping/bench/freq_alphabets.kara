// LeetCode #1309 bench: the ★ arm (the code read from the right, a `#`
// taking the two digits before it) on 200 codes of texts of 300 letters, up
// to 900 digits and `#`s each, within the constraints' 1000, built once;
// then 500 passes, each setting one letter of one text from the checksum so
// far and writing that text's code afresh, then reading every code back and
// folding one letter of each answer, at a place also chosen from the
// checksum, its length and the pass into the checksum.

fn freq_alphabets(s: String) -> String {
    let b = s.bytes();
    let mut letters: Vec[char] = Vec.new();
    let mut i = b.len() - 1;
    while i >= 0 {
        let number = if b[i] == b'#' {
            i -= 3;
            (b[i + 1] - b'0') * 10 + (b[i + 2] - b'0')
        } else {
            i -= 1;
            b[i + 1] - b'0'
        };
        letters.push((b'a' + number - 1) as char);
    }
    letters.reverse();
    letters.iter().collect()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn encode(letters: Vec[i64]) -> String {
    let mut code = String.new();
    for k in letters.iter() {
        if k < 9 {
            code.push_str(f"{k + 1}");
        } else {
            code.push_str(f"{k + 1}#");
        }
    }
    code
}

fn main() {
    let mut seed = 1309;
    let mut texts: Vec[Vec[i64]] = Vec.new();
    let mut codes: Vec[String] = Vec.new();
    for _ in 0..200 {
        let mut letters: Vec[i64] = Vec.new();
        for _ in 0..300 {
            letters.push(next_random(mut seed) % 26);
        }
        codes.push(encode(letters));
        texts.push(letters);
    }
    let mut check: i64 = 0;
    for pass in 0..500 {
        let t = check % 200;
        texts[t][(check / 200) % 300] = (check / 7) % 26;
        codes[t] = encode(texts[t]);
        for c in 0..200 {
            let got = freq_alphabets(codes[c]);
            let b = got.bytes();
            check = (check * 31 + b[check % b.len()] + b.len() + pass) % 1000000007;
        }
    }
    println(f"500 passes over 200 codes: checksum {check}");
}
