// LeetCode #1312: Minimum Insertion Steps to Make a String Palindrome -- the
// table arm: the same interval costs as the ★ arm, but every one kept in an
// n by n table filled by the length of the piece, shortest first. O(n^2)
// time and space

fn min_insertions(s: String) -> i64 {
    let b = s.bytes();
    let n = b.len();
    let mut cost: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(n, 0));
    for len in 2..n + 1 {
        for i in 0..n - len + 1 {
            let j = i + len - 1;
            cost[i][j] = if b[i] == b[j] {
                if len == 2 { 0 } else { cost[i + 1][j - 1] }
            } else {
                1 + cost[i + 1][j].min(cost[i][j - 1])
            };
        }
    }
    cost[0][n - 1]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn ask(s: Str) -> i64 {
    min_insertions(s.to_string())
}

fn main() {
    // LeetCode's three examples; one letter; two different letters; four
    // different letters, each but one needing a partner; and a palindrome
    // with one letter taken out of the middle of one side
    println(f"{ask("zzazz")} {ask("mbadm")} {ask("leetcode")} {ask("a")} {ask("ab")} {ask("abcd")} {ask("racecr")}");
    // 600 random strings of 1 to 500 letters, the constraints' longest, over
    // 2, 4 or 26 letters, every other one a palindrome with up to 20
    // letters taken out
    let letters = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z'];
    let mut seed = 1312;
    let mut total = 0;
    let mut check = 0;
    for t in 0..600 {
        let n = 1 + next_random(mut seed) % 500;
        let k = if t % 3 == 0 { 2 } else if t % 3 == 1 { 4 } else { 26 };
        let mut chars: Vec[char] = Vec.new();
        for _ in 0..n {
            chars.push(letters[next_random(mut seed) % k]);
        }
        if t % 2 == 0 {
            // a palindrome: the first half mirrored, then some letters cut
            for i in 0..n / 2 {
                chars[n - 1 - i] = chars[i];
            }
            let cuts = next_random(mut seed) % 21;
            for _ in 0..cuts {
                if chars.len() > 1 {
                    chars.remove(next_random(mut seed) % chars.len());
                }
            }
        }
        let s: String = chars.iter().collect();
        let got = min_insertions(s);
        total += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"600 random strings: insertions total {total}, checksum {check}");
}
