// LeetCode #1367: Linked List in Binary Tree -- differential test of
// the five arms against the statement read literally, with five more
// properties.
//
// The statement: given a binary tree root and a linked list head,
// return true if all the elements of the list, from the head on,
// correspond to some downward path connected in the tree, a path that
// starts at some node and goes down; otherwise return false.

// ---- linked_list_in_binary_tree.kara ----
fn a0_matches_from(head: Option[ListNode], node: Option[TreeNode]) -> bool {
    let Some(h) = head else {
        return true;
    };
    let Some(n) = node else {
        return false;
    };
    h.val == n.val and (a0_matches_from(h.next, n.left) or a0_matches_from(h.next, n.right))
}

fn a0_is_sub_path(head: Option[ListNode], root: Option[TreeNode]) -> bool {
    let Some(r) = root else {
        return false;
    };
    a0_matches_from(head, root) or a0_is_sub_path(head, r.left) or a0_is_sub_path(head, r.right)
}

// ---- linked_list_in_binary_tree_kmp.kara ----
fn a1_search(node: Option[TreeNode], pattern: Vec[i32], fail: Vec[i64], matched: i64) -> bool {
    let Some(n) = node else {
        return false;
    };
    let mut k = matched;
    while k > 0 and n.val != pattern[k] {
        k = fail[k - 1];
    }
    if n.val == pattern[k] {
        k += 1;
    }
    if k == pattern.len() {
        return true;
    }
    a1_search(n.left, pattern, fail, k) or a1_search(n.right, pattern, fail, k)
}

fn a1_is_sub_path(head: Option[ListNode], root: Option[TreeNode]) -> bool {
    let mut pattern: Vec[i32] = Vec.new();
    let mut at = head;
    while let Some(node) = at {
        pattern.push(node.val);
        at = node.next;
    }
    // fail[i]: the longest proper prefix of pattern[..=i] that also ends it
    let mut fail: Vec[i64] = Vec.filled(pattern.len(), 0);
    let mut k = 0;
    for i in 1..pattern.len() {
        while k > 0 and pattern[i] != pattern[k] {
            k = fail[k - 1];
        }
        if pattern[i] == pattern[k] {
            k += 1;
        }
        fail[i] = k;
    }
    a1_search(root, pattern, fail, 0)
}

// ---- linked_list_in_binary_tree_paths.kara ----
fn a2_ends_with(path: Vec[i32], pattern: Vec[i32]) -> bool {
    if path.len() < pattern.len() {
        return false;
    }
    let start = path.len() - pattern.len();
    for i in 0..pattern.len() {
        if path[start + i] != pattern[i] {
            return false;
        }
    }
    true
}

fn a2_walk(node: Option[TreeNode], pattern: Vec[i32], path: mut ref Vec[i32]) -> bool {
    let Some(n) = node else {
        return false;
    };
    path.push(n.val);
    let found = a2_ends_with(path, pattern) or a2_walk(n.left, pattern, mut path) or a2_walk(n.right, pattern, mut path);
    path.pop();
    found
}

fn a2_is_sub_path(head: Option[ListNode], root: Option[TreeNode]) -> bool {
    let mut pattern: Vec[i32] = Vec.new();
    let mut at = head;
    while let Some(node) = at {
        pattern.push(node.val);
        at = node.next;
    }
    let mut path: Vec[i32] = Vec.new();
    a2_walk(root, pattern, mut path)
}

// ---- linked_list_in_binary_tree_stack.kara ----
fn a3_is_sub_path(head: Option[ListNode], root: Option[TreeNode]) -> bool {
    let Some(r) = root else {
        return false;
    };
    let Some(first) = head else {
        return true;
    };
    let mut stack: Vec[(TreeNode, ListNode, bool)] = [(r, first, true)];
    while let Some((node, want, start)) = stack.pop() {
        if start {
            if let Some(l) = node.left {
                stack.push((l, first, true));
            }
            if let Some(r) = node.right {
                stack.push((r, first, true));
            }
        }
        if node.val != want.val {
            continue;
        }
        let Some(next) = want.next else {
            return true;
        };
        if let Some(l) = node.left {
            stack.push((l, next, false));
        }
        if let Some(r) = node.right {
            stack.push((r, next, false));
        }
    }
    false
}

// ---- linked_list_in_binary_tree_solution.kara ----
struct A4Solution {}

fn a4_go(head: ref Option[ListNode], root: Option[TreeNode]) -> bool {
    if let Some(r) = root {
        let node = r;
        a4_dfs(head, root) or a4_go(head, node.left) or a4_go(head, node.right)
    } else {
        false
    }
}

fn a4_dfs(head: ref Option[ListNode], root: Option[TreeNode]) -> bool {
    match head {
        None => true,
        Some(h) => match root {
            None => false,
            Some(r) => {
                h.val == r.val and (a4_dfs(h.next, r.left) or a4_dfs(h.next, r.right))
            }
        },
    }
}

impl A4Solution {
    pub fn a4_is_sub_path(head: Option[ListNode], root: Option[TreeNode]) -> bool {
        a4_go(head, root)
    }
}

fn a4_is_sub_path(head: Option[ListNode], root: Option[TreeNode]) -> bool {
    A4Solution.a4_is_sub_path(head, root)
}

// ---- the differential -------------------------------------------------------

shared struct ListNode {
    mut val: i32,
    mut next: Option[ListNode],
}

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the values as a linked list, in order
fn from_values(values: Vec[i32]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for v in values.iter().rev() {
        head = Some(ListNode { val: v, next: head });
    }
    head
}

// LeetCode's level-order list, `None` for a missing child
fn from_level(values: Vec[Option[i32]]) -> Option[TreeNode] {
    if values.len() == 0 or values[0].is_none() {
        return None;
    }
    let root = TreeNode { val: values[0].unwrap(), left: None, right: None };
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    queue.push_back(root);
    let mut i = 1;
    while i < values.len() {
        let Some(node) = queue.pop_front() else {
            break;
        };
        if let Some(v) = values[i] {
            let child = TreeNode { val: v, left: None, right: None };
            node.left = Some(child);
            queue.push_back(child);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let child = TreeNode { val: v, left: None, right: None };
                node.right = Some(child);
                queue.push_back(child);
            }
            i += 1;
        }
    }
    Some(root)
}

// n nodes with values from 1 to `range`, each hung on an empty child
// place of the tree so far chosen at random
fn random_tree(seed: mut ref i64, n: i64, range: i64) -> TreeNode {
    let root = TreeNode { val: (1 + next_random(mut seed) % range) as i32, left: None, right: None };
    let mut places: Vec[(TreeNode, bool)] = [(root, true), (root, false)];
    for _ in 1..n {
        let k = next_random(mut seed) % places.len();
        let (parent, left) = places.swap_remove(k);
        let node = TreeNode { val: (1 + next_random(mut seed) % range) as i32, left: None, right: None };
        if left {
            parent.left = Some(node);
        } else {
            parent.right = Some(node);
        }
        places.push((node, true));
        places.push((node, false));
    }
    root
}

// a random child of `node`, or None at a leaf
fn random_child(seed: mut ref i64, node: TreeNode) -> Option[TreeNode] {
    match (node.left, node.right) {
        (Some(l), Some(r)) => if next_random(mut seed) % 2 == 0 { Some(l) } else { Some(r) },
        (Some(l), None) => Some(l),
        (None, Some(r)) => Some(r),
        (None, None) => None,
    }
}

// up to m values read down a random path that starts a random number of
// steps below the root
fn path_values(seed: mut ref i64, root: TreeNode, m: i64) -> Vec[i32] {
    let mut at = root;
    for _ in 0..next_random(mut seed) % 12 {
        match random_child(mut seed, at) {
            Some(child) => at = child,
            None => break,
        }
    }
    let mut values: Vec[i32] = [at.val];
    while values.len() < m {
        match random_child(mut seed, at) {
            Some(child) => {
                values.push(child.val);
                at = child;
            }
            None => break,
        }
    }
    values
}


// the statement read literally: every node is the bottom of one
// downward path of each length that fits, read upward through the
// nodes' parents; the list is found when one of those paths is it
fn literal(head: Option[ListNode], root: Option[TreeNode]) -> bool {
    let mut want: Vec[i32] = Vec.new();
    let mut at = head;
    while let Some(node) = at {
        want.push(node.val);
        at = node.next;
    }
    // every node with the index of its parent, -1 for the root
    let mut nodes: Vec[(TreeNode, i64)] = Vec.new();
    if let Some(r) = root {
        nodes.push((r, -1));
    }
    let mut i = 0;
    while i < nodes.len() {
        let node = nodes[i].0;
        if let Some(l) = node.left {
            nodes.push((l, i));
        }
        if let Some(r) = node.right {
            nodes.push((r, i));
        }
        i += 1;
    }
    for bottom in 0..nodes.len() {
        // the path's values from the bottom up, as far as the list is long
        let mut up: Vec[i32] = Vec.new();
        let mut k = bottom;
        while k >= 0 and up.len() < want.len() {
            up.push(nodes[k].0.val);
            k = nodes[k].1;
        }
        up.reverse();
        if up == want {
            return true;
        }
    }
    false
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, values: Vec[i32], root: Option[TreeNode]) -> bool {
    let head = from_values(values);
    match i {
        0 => a0_is_sub_path(head, root),
        1 => a1_is_sub_path(head, root),
        2 => a2_is_sub_path(head, root),
        3 => a3_is_sub_path(head, root),
        _ => a4_is_sub_path(head, root),
    }
}

// a new tree, every node's children swapped
fn mirrored(node: Option[TreeNode]) -> Option[TreeNode] {
    let Some(n) = node else {
        return None;
    };
    Some(TreeNode { val: n.val, left: mirrored(n.right), right: mirrored(n.left) })
}

fn check_case(t: mut ref Tally, values: Vec[i32], root: Option[TreeNode], path: Vec[i32]) {
    t.cases += 1;
    let want = literal(from_values(values), root);
    t.check = (t.check * 131 + values.len() * 2 + if want { 1 } else { 0 }) % 1000000007;
    let mirror = mirrored(root);
    // the tree hung under a new root valued 0, a value no list holds
    let raised = Some(TreeNode { val: 0, left: root, right: None });
    let star = arm(0, values, root);
    for i in 0..5 {
        let got = arm(i, values, root);
        let what = f"arm {i} at list {values}, {path.len()} on a path";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: the tree mirrored, the same answer
        expect(mut t, 2, arm(i, values, mirror) == got, f"P2 {what}, mirrored");
        // P3: a list found leaves its list without the last value, and
        // without the first, found too
        if got and values.len() > 1 {
            let front: Vec[i32] = values.iter().take(values.len() - 1).collect();
            let back: Vec[i32] = values.iter().skip(1).collect();
            expect(mut t, 3, arm(i, front, root) and arm(i, back, root), f"P3 {what}, shortened");
        }
        // P4: the tree under a new root valued 0, the same answer
        expect(mut t, 4, arm(i, values, raised) == got, f"P4 {what}, raised");
        // P5: a list read down a path of the tree is found
        expect(mut t, 5, arm(i, path, root), f"P5 {what}, path {path}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's three examples, each with [1] as the path for P5; then
    // 1000 random trees of up to 30 nodes valued 1 or 2, where partial
    // matches are common, and 1000 of up to 300 valued from 1 to 2, 3 or
    // 100; half the lists read down a path of the tree, half drawn at
    // random, and a second path read for P5
    let tree: Vec[Option[i32]] = [Some(1), Some(4), Some(4), None, Some(2), Some(2), None, Some(1), None, Some(6), Some(8), None, None, None, None, Some(1), Some(3)];
    check_case(mut t, [4, 2, 8], from_level(tree), [1]);
    check_case(mut t, [1, 4, 2, 6], from_level(tree), [1]);
    check_case(mut t, [1, 4, 2, 6, 8], from_level(tree), [1]);
    let mut seed = 1367;
    for k in 0..2000 {
        let n = 1 + next_random(mut seed) % if k < 1000 { 30 } else { 300 };
        let range = if k < 1000 {
            2
        } else {
            match next_random(mut seed) % 3 {
                0 => 2,
                1 => 3,
                _ => 100,
            }
        };
        let root = random_tree(mut seed, n, range);
        let m = 1 + next_random(mut seed) % if next_random(mut seed) % 2 == 0 { 4 } else { 12 };
        let mut values: Vec[i32] = Vec.new();
        if next_random(mut seed) % 2 == 0 {
            values = path_values(mut seed, root, m);
        } else {
            for _ in 0..m {
                values.push((1 + next_random(mut seed) % range) as i32);
            }
        }
        let path = path_values(mut seed, root, 1 + next_random(mut seed) % 12);
        check_case(mut t, values, Some(root), path);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
