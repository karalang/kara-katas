// LeetCode #1367: Linked List in Binary Tree -- the paths arm: the list
// read into a pattern; one walk down the tree keeps the values on the
// path from the root, and at each node checks whether the path ends with
// the pattern. O(n m)

fn ends_with(path: Vec[i32], pattern: Vec[i32]) -> bool {
    if path.len() < pattern.len() {
        return false;
    }
    let start = path.len() - pattern.len();
    for i in 0..pattern.len() {
        if path[start + i] != pattern[i] {
            return false;
        }
    }
    true
}

fn walk(node: Option[TreeNode], pattern: Vec[i32], path: mut ref Vec[i32]) -> bool {
    let Some(n) = node else {
        return false;
    };
    path.push(n.val);
    let found = ends_with(path, pattern) or walk(n.left, pattern, mut path) or walk(n.right, pattern, mut path);
    path.pop();
    found
}

fn is_sub_path(head: Option[ListNode], root: Option[TreeNode]) -> bool {
    let mut pattern: Vec[i32] = Vec.new();
    let mut at = head;
    while let Some(node) = at {
        pattern.push(node.val);
        at = node.next;
    }
    let mut path: Vec[i32] = Vec.new();
    walk(root, pattern, mut path)
}

// ---- test harness ---------------------------------------------------------

shared struct ListNode {
    mut val: i32,
    mut next: Option[ListNode],
}

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the values as a linked list, in order
fn from_values(values: Vec[i32]) -> Option[ListNode] {
    let mut head: Option[ListNode] = None;
    for v in values.iter().rev() {
        head = Some(ListNode { val: v, next: head });
    }
    head
}

// LeetCode's level-order list, `None` for a missing child
fn from_level(values: Vec[Option[i32]]) -> Option[TreeNode] {
    if values.len() == 0 or values[0].is_none() {
        return None;
    }
    let root = TreeNode { val: values[0].unwrap(), left: None, right: None };
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    queue.push_back(root);
    let mut i = 1;
    while i < values.len() {
        let Some(node) = queue.pop_front() else {
            break;
        };
        if let Some(v) = values[i] {
            let child = TreeNode { val: v, left: None, right: None };
            node.left = Some(child);
            queue.push_back(child);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let child = TreeNode { val: v, left: None, right: None };
                node.right = Some(child);
                queue.push_back(child);
            }
            i += 1;
        }
    }
    Some(root)
}

// n nodes with values from 1 to `range`, each hung on an empty child
// place of the tree so far chosen at random
fn random_tree(seed: mut ref i64, n: i64, range: i64) -> TreeNode {
    let root = TreeNode { val: (1 + next_random(mut seed) % range) as i32, left: None, right: None };
    let mut places: Vec[(TreeNode, bool)] = [(root, true), (root, false)];
    for _ in 1..n {
        let k = next_random(mut seed) % places.len();
        let (parent, left) = places.swap_remove(k);
        let node = TreeNode { val: (1 + next_random(mut seed) % range) as i32, left: None, right: None };
        if left {
            parent.left = Some(node);
        } else {
            parent.right = Some(node);
        }
        places.push((node, true));
        places.push((node, false));
    }
    root
}

// a random child of `node`, or None at a leaf
fn random_child(seed: mut ref i64, node: TreeNode) -> Option[TreeNode] {
    match (node.left, node.right) {
        (Some(l), Some(r)) => if next_random(mut seed) % 2 == 0 { Some(l) } else { Some(r) },
        (Some(l), None) => Some(l),
        (None, Some(r)) => Some(r),
        (None, None) => None,
    }
}

// up to m values read down a random path that starts a random number of
// steps below the root
fn path_values(seed: mut ref i64, root: TreeNode, m: i64) -> Vec[i32] {
    let mut at = root;
    for _ in 0..next_random(mut seed) % 12 {
        match random_child(mut seed, at) {
            Some(child) => at = child,
            None => break,
        }
    }
    let mut values: Vec[i32] = [at.val];
    while values.len() < m {
        match random_child(mut seed, at) {
            Some(child) => {
                values.push(child.val);
                at = child;
            }
            None => break,
        }
    }
    values
}

fn main() {
    // LeetCode's three examples; a chain of 2500 nodes valued 1, each the
    // right child of the one before, against 100 1s and against 99 1s
    // and a 2, the constraints' most
    let tree: Vec[Option[i32]] = [Some(1), Some(4), Some(4), None, Some(2), Some(2), None, Some(1), None, Some(6), Some(8), None, None, None, None, Some(1), Some(3)];
    let e1 = is_sub_path(from_values([4, 2, 8]), from_level(tree));
    let e2 = is_sub_path(from_values([1, 4, 2, 6]), from_level(tree));
    let e3 = is_sub_path(from_values([1, 4, 2, 6, 8]), from_level(tree));
    let mut chain: Option[TreeNode] = None;
    for _ in 0..2500 {
        chain = Some(TreeNode { val: 1, left: None, right: chain });
    }
    let ones: Vec[i32] = Vec.filled(100, 1);
    let mut short = Vec.filled(99, 1);
    short.push(2);
    println(f"{e1} {e2} {e3} {is_sub_path(from_values(ones), chain)} {is_sub_path(from_values(short), chain)}");
    // 2000 random trees of 1 to 300 nodes, valued from 1 to 2, 3 or 100;
    // half the lists read down a path of the tree, half drawn at random
    let mut seed = 1367;
    let mut found = 0;
    let mut check: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 300;
        let range = match next_random(mut seed) % 3 {
            0 => 2,
            1 => 3,
            _ => 100,
        };
        let root = random_tree(mut seed, n, range);
        let m = 1 + next_random(mut seed) % if next_random(mut seed) % 2 == 0 { 4 } else { 12 };
        let mut values: Vec[i32] = Vec.new();
        if next_random(mut seed) % 2 == 0 {
            values = path_values(mut seed, root, m);
        } else {
            for _ in 0..m {
                values.push((1 + next_random(mut seed) % range) as i32);
            }
        }
        let got = is_sub_path(from_values(values), Some(root));
        if got {
            found += 1;
        }
        check = (check * 131 + values.len() * 2 + if got { 1 } else { 0 }) % 1000000007;
    }
    println(f"2000 random trees: {found} found, checksum {check}");
}
