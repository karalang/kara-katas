// LeetCode #1345: Jump Game IV -- a Rust solution as LeetCode's Rust users
// write it (a `HashMap<i32, Vec<usize>>` filled by
// `.entry(x).or_insert_with(Vec::new).push(i)`, a `VecDeque<usize>` taken a
// level at a time, `vec![false; n]` for the visited indices, and a value's
// list taken out by `if let Some(nexts) = graph.remove(&arr[i])`), carried
// to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn min_jumps(arr: Vec[i32]) -> i32 {
        let n = arr.len();
        if n == 1 {
            return 0;
        }
        let mut graph: Map[i32, Vec[i64]] = Map.new();
        for (i, x) in arr.iter().enumerate() {
            graph.entry(x).or_insert_with(Vec.new).push(i);
        }
        let mut visited = Vec.filled(n, false);
        visited[0] = true;
        let mut queue = VecDeque.new();
        queue.push_back(0);
        let mut steps = 0;
        while not queue.is_empty() {
            for _ in 0..queue.len() {
                let i = queue.pop_front().unwrap();
                if i == n - 1 {
                    return steps;
                }
                if let Some(nexts) = graph.remove(arr[i]) {
                    for j in nexts {
                        if not visited[j] {
                            visited[j] = true;
                            queue.push_back(j);
                        }
                    }
                }
                if i + 1 < n and not visited[i + 1] {
                    visited[i + 1] = true;
                    queue.push_back(i + 1);
                }
                if i > 0 and not visited[i - 1] {
                    visited[i - 1] = true;
                    queue.push_back(i - 1);
                }
            }
            steps += 1;
        }
        -1
    }
}

fn min_jumps(arr: Vec[i32]) -> i32 {
    Solution.min_jumps(arr)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; 5 * 10^4 values, the constraints' longest,
    // all equal; all different, rising; at random from 1 to 1000; and the
    // first and last values unique, the rest at random from -10^8 to 10^8
    // in 300 kinds
    let e1 = min_jumps([100, -23, -23, 404, 100, 23, 23, 23, 3, 404]);
    let e2 = min_jumps([7]);
    let e3 = min_jumps([7, 6, 9, 6, 9, 6, 9, 7]);
    let n = 50000;
    let same: Vec[i32] = Vec.filled(n, 5);
    let rising: Vec[i32] = (0..n).map(|i| i as i32).collect();
    let mut seed = 1345;
    let mut thousand: Vec[i32] = Vec.new();
    let mut kinds: Vec[i32] = Vec.new();
    let mut spread: Vec[i32] = [-100000000];
    for _ in 0..300 {
        kinds.push(((next_random(mut seed) * 65536 + next_random(mut seed)) % 200000001 - 100000000) as i32);
    }
    for i in 0..n {
        thousand.push((1 + next_random(mut seed) % 1000) as i32);
        if i > 0 and i < n - 1 {
            spread.push(kinds[next_random(mut seed) % 300]);
        }
    }
    spread.push(100000000);
    println(f"{e1} {e2} {e3} {min_jumps(same)} {min_jumps(rising)} {min_jumps(thousand)} {min_jumps(spread)}");
    // 1000 random arrays of 1 to 500 values, most of them short, from 1 to
    // 3, to 20 or to 10^4
    let mut check = 0;
    for t in 0..1000 {
        let len = if t % 10 == 0 { 1 + next_random(mut seed) % 500 } else { 1 + next_random(mut seed) % 30 };
        let top = if t % 3 == 0 { 3 } else if t % 3 == 1 { 20 } else { 10000 };
        let mut arr: Vec[i32] = Vec.new();
        for _ in 0..len {
            arr.push((1 + next_random(mut seed) % top) as i32);
        }
        check = (check * 131 + min_jumps(arr)) % 1000000007;
    }
    println(f"1000 random arrays: checksum {check}");
}
