// LeetCode #1345 bench: the ★ arm (a breadth-first search over i - 1,
// i + 1 and the indices of the same value, gathered in a `Map` and each
// value's list emptied the first time it is used) on 10 arrays of 5 * 10^4
// values, the constraints' longest, built once: half at random from 1 to
// 1000, where a few jumps reach the end, and half with every value twice
// in a row, where the path walks most of the array; then 30 passes, each
// setting one value of every array from the checksum so far, so no answer
// carries over, answering it and folding the answer plus the pass into
// the checksum.

fn min_jumps(arr: Vec[i32]) -> i32 {
    let n = arr.len();
    let mut places: Map[i32, Vec[i64]] = Map.new();
    for i in 0..n {
        places.entry(arr[i]).or_insert(Vec.new()).push(i);
    }
    let mut steps: Vec[i32] = Vec.filled(n, -1);
    steps[0] = 0;
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(0);
    while let Some(i) = queue.pop_front() {
        if i == n - 1 {
            return steps[i];
        }
        let mut next: Vec[i64] = places.remove(arr[i]).unwrap_or(Vec.new());
        next.push(i - 1);
        next.push(i + 1);
        for j in next.iter() {
            if j >= 0 and j < n and steps[j] < 0 {
                steps[j] = steps[i] + 1;
                queue.push_back(j);
            }
        }
    }
    steps[n - 1]
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 50000;
    let mut seed = 1345;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    for a in 0..10 {
        let mut arr: Vec[i32] = Vec.new();
        for i in 0..n {
            if a % 2 == 0 {
                arr.push((1 + next_random(mut seed) % 1000) as i32);
            } else {
                arr.push((i / 2) as i32);
            }
        }
        arrays.push(arr);
    }
    let mut check: i64 = 0;
    for pass in 0..30 {
        for a in 0..10 {
            arrays[a][check % n] = ((check / 7) % 25000) as i32;
            let answer = min_jumps(arrays[a]);
            check = (check * 31 + answer + pass) % 1000000007;
        }
    }
    println(f"30 passes over 10 arrays of 5 * 10^4: checksum {check}");
}
