// LeetCode #1338 bench: the ★ arm (each value counted in a `Map`, the
// counts sorted largest first and taken until half the array is gone) on
// 20 arrays of 10^5 values, the constraints' longest, from 1 to 10^5 or
// from 1 to 1000, built once. Then 30 passes, each setting one value of
// every array from the checksum so far, answering every array and folding
// the answer plus the pass into the checksum.

fn min_set_size(arr: Vec[i32]) -> i32 {
    let mut counts: Map[i32, i64] = Map.new();
    for x in arr.iter() {
        counts[x] = counts.get(x).unwrap_or(0) + 1;
    }
    let mut sizes: Vec[i64] = counts.values().cloned().collect();
    sizes.sort_by(|a, b| b.cmp(a));
    let mut removed = 0;
    let mut chosen = 0;
    for s in sizes.iter() {
        if 2 * removed >= arr.len() {
            break;
        }
        removed += s;
        chosen += 1;
    }
    chosen
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 100000;
    let mut seed = 1338;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    for t in 0..20 {
        let top = if t % 2 == 0 { 100000 } else { 1000 };
        let mut arr: Vec[i32] = Vec.new();
        for _ in 0..n {
            arr.push((1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top) as i32);
        }
        arrays.push(arr);
    }
    let mut check: i64 = 0;
    for pass in 0..30 {
        for t in 0..20 {
            let at = check % n;
            arrays[t][at] = (1 + check / 3 % 1000) as i32;
            let answer = min_set_size(arrays[t]);
            check = (check * 31 + answer + pass) % 1000000007;
        }
    }
    println(f"30 passes over 20 arrays of 10^5: checksum {check}");
}
