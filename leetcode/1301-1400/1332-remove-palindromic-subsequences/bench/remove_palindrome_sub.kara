// LeetCode #1332 bench: the ★ arm (one step when the string reads the
// same from both ends, two otherwise) on 1000 strings of 1000 letters, the
// constraints' longest, built once: palindromes, half of them with one
// letter beside the middle changed, so nearly every answer reads to the
// middle. Then 500 passes, each setting one letter of one string from the
// checksum so far, rebuilding that string, and answering every string.

fn remove_palindrome_sub(s: String) -> i32 {
    let b = s.bytes();
    let n = b.len();
    for i in 0..n / 2 {
        if b[i] != b[n - 1 - i] {
            return 2;
        }
    }
    1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let count = 1000;
    let n = 1000;
    let mut seed = 1332;
    let mut letters: Vec[Vec[char]] = Vec.new();
    let mut strings: Vec[String] = Vec.new();
    for t in 0..count {
        let mut row: Vec[char] = Vec.filled(n, 'a');
        for i in 0..n / 2 {
            let c = if next_random(mut seed) % 2 == 0 { 'a' } else { 'b' };
            row[i] = c;
            row[n - 1 - i] = c;
        }
        if t % 2 == 1 {
            row[n / 2 - 1 - t % 3] = if row[n / 2 - 1 - t % 3] == 'a' { 'b' } else { 'a' };
        }
        strings.push(row.iter().collect());
        letters.push(row);
    }
    let mut check: i64 = 0;
    for pass in 0..500 {
        let t = check % count;
        let at = check / count % n;
        let c = if check / 7 % 2 == 0 { 'a' } else { 'b' };
        letters[t][at] = c;
        if pass % 2 == 0 {
            letters[t][n - 1 - at] = c;
        }
        strings[t] = letters[t].iter().collect();
        for s in strings.iter() {
            check = (check * 31 + remove_palindrome_sub(s) + pass) % 1000000007;
        }
    }
    println(f"500 passes over 1000 strings of 1000 letters: checksum {check}");
}
