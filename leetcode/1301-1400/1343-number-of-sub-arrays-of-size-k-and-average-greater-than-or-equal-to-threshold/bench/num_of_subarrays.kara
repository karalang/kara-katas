// LeetCode #1343 bench: the ★ arm (a sliding window of the last k values,
// counted when its sum reaches k * threshold) on 10 arrays of 10^5
// values, the constraints' longest, at random from 1 to 10^4, built once;
// then 60 passes, each setting one value of every array from the checksum
// so far and drawing k from 1 to 1000 and the threshold from 4500 to 4899
// from it too, so no answer carries over, answering it and folding the
// answer plus the pass into the checksum.

fn num_of_subarrays(arr: Vec[i32], k: i32, threshold: i32) -> i32 {
    let need = k * threshold;
    let mut sum = 0;
    let mut count = 0;
    for i in 0..arr.len() {
        sum += arr[i];
        if i >= k {
            sum -= arr[i - k];
        }
        if i >= k - 1 and sum >= need {
            count += 1;
        }
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 100000;
    let mut seed = 1343;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    for _ in 0..10 {
        let mut arr: Vec[i32] = Vec.new();
        for _ in 0..n {
            arr.push((1 + next_random(mut seed) % 10000) as i32);
        }
        arrays.push(arr);
    }
    let mut check: i64 = 0;
    for pass in 0..60 {
        for a in 0..10 {
            arrays[a][check % n] = (1 + (check / 7) % 10000) as i32;
            let k = (1 + check % 1000) as i32;
            let threshold = (4500 + check % 400) as i32;
            let answer = num_of_subarrays(arrays[a], k, threshold);
            check = (check * 31 + answer + pass) % 1000000007;
        }
    }
    println(f"60 passes over 10 arrays of 10^5: checksum {check}");
}
