// LeetCode #1343: Number of Sub-arrays of Size K and Average Greater than
// or Equal to Threshold -- the average arm: the window's average taken by
// integer division, which rounds down, so it reaches a whole threshold
// exactly when the true average does; the window slides by one value at a
// time. O(n)

fn num_of_subarrays(arr: Vec[i32], k: i32, threshold: i32) -> i32 {
    if arr.len() < k {
        return 0;
    }
    let mut sum: i32 = arr[0..k].iter().sum();
    let mut count = if sum / k >= threshold { 1 } else { 0 };
    for i in k..arr.len() {
        sum += arr[i] - arr[i - k];
        if sum / k >= threshold {
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one value; 10^5 values, the constraints'
    // longest, at random from 1 to 10^4, with k = 1000 and threshold 4700,
    // with k = 1 and threshold 0, and with k the whole length and threshold
    // 4697, just under their average
    let e1 = num_of_subarrays([2, 2, 2, 2, 5, 5, 5, 8], 3, 4);
    let e2 = num_of_subarrays([11, 13, 17, 23, 29, 31, 7, 5, 2, 3], 3, 5);
    let one = num_of_subarrays([7], 1, 7);
    let mut seed = 1343;
    let mut big: Vec[i32] = Vec.new();
    for _ in 0..100000 {
        big.push((1 + next_random(mut seed) % 10000) as i32);
    }
    println(f"{e1} {e2} {one} {num_of_subarrays(big, 1000, 4700)} {num_of_subarrays(big, 1, 0)} {num_of_subarrays(big, 100000, 4697)}");
    // 1000 random arrays of 1 to 300 values, most of them short, from 1 to
    // 10 or to 10^4, with k from 1 to the length and the threshold near the
    // values' middle
    let mut check = 0;
    for t in 0..1000 {
        let n = if t % 10 == 0 { 1 + next_random(mut seed) % 300 } else { 1 + next_random(mut seed) % 20 };
        let top = if t % 2 == 0 { 10 } else { 10000 };
        let mut arr: Vec[i32] = Vec.new();
        for _ in 0..n {
            arr.push((1 + next_random(mut seed) % top) as i32);
        }
        let k = (1 + next_random(mut seed) % n) as i32;
        let threshold = (next_random(mut seed) % (top + 1)) as i32;
        check = (check * 131 + num_of_subarrays(arr, k, threshold)) % 1000000007;
    }
    println(f"1000 random arrays: checksum {check}");
}
