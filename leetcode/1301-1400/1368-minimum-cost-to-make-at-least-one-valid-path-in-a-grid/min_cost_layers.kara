// LeetCode #1368: Minimum Cost to Make at Least One Valid Path in a Grid
// -- the layers arm: the cells reached at cost k are everything the
// signs lead to, for free, from the cells first reached at cost k; a
// depth-first walk follows the signs, and the cells next to a layer that
// no layer has reached start the layer of cost k + 1. O(m n)

// follows the signs from (r, c), marking each new cell with `cost` and
// adding it to `layer`
fn follow(grid: Vec[Vec[i32]], cost: mut ref Vec[Vec[i64]], layer: mut ref Vec[(i64, i64)], r: i64, c: i64, k: i64) {
    let (m, n) = (grid.len(), grid[0].len());
    let mut (r, c) = (r, c);
    while r >= 0 and r < m and c >= 0 and c < n and cost[r][c] < 0 {
        cost[r][c] = k;
        layer.push((r, c));
        match grid[r][c] {
            1 => c += 1,
            2 => c -= 1,
            3 => r += 1,
            _ => r -= 1,
        }
    }
}

fn min_cost(grid: Vec[Vec[i32]]) -> i32 {
    let (m, n) = (grid.len(), grid[0].len());
    let mut cost: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n, -1));
    let mut layer: Vec[(i64, i64)] = Vec.new();
    follow(grid, mut cost, mut layer, 0, 0, 0);
    let mut k = 0;
    while cost[m - 1][n - 1] < 0 {
        k += 1;
        let mut next: Vec[(i64, i64)] = Vec.new();
        for (r, c) in layer.iter() {
            for (nr, nc) in [(r, c + 1), (r, c - 1), (r + 1, c), (r - 1, c)] {
                follow(grid, mut cost, mut next, nr, nc, k);
            }
        }
        layer = next;
    }
    cost[m - 1][n - 1] as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// an m by n grid of signs drawn at random from 1 to 4
fn random_grid(seed: mut ref i64, m: i64, n: i64) -> Vec[Vec[i32]] {
    let mut grid: Vec[Vec[i32]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i32] = Vec.new();
        for _ in 0..n {
            row.push((1 + next_random(mut seed) % 4) as i32);
        }
        grid.push(row);
    }
    grid
}

fn main() {
    // LeetCode's three examples; one cell; a 100 by 100 grid of 2s, every
    // sign pointing left, the constraints' most; and a 100 by 100 grid at
    // random
    let e1 = min_cost([[1, 1, 1, 1], [2, 2, 2, 2], [1, 1, 1, 1], [2, 2, 2, 2]]);
    let e2 = min_cost([[1, 1, 3], [3, 2, 2], [1, 1, 4]]);
    let e3 = min_cost([[1, 2], [4, 3]]);
    let one = min_cost([[4]]);
    let left = min_cost(Vec.filled(100, Vec.filled(100, 2)));
    let mut seed = 1368;
    let big = min_cost(random_grid(mut seed, 100, 100));
    println(f"{e1} {e2} {e3} {one} {left} {big}");
    // 2000 random grids of 1 to 30 by 1 to 30
    let mut total = 0;
    let mut check: i64 = 0;
    for _ in 0..2000 {
        let m = 1 + next_random(mut seed) % 30;
        let n = 1 + next_random(mut seed) % 30;
        let got = min_cost(random_grid(mut seed, m, n)) as i64;
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random grids: costs total {total}, checksum {check}");
}
