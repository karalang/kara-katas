// LeetCode #1368: Minimum Cost to Make at Least One Valid Path in a Grid
// -- the dijkstra arm: Dijkstra's search with a `PriorityQueue` of (cost,
// row, column), min-first; a cell taken off the queue at a cost above
// its best is stale and skipped. O(m n log(m n))
fn min_cost(grid: Vec[Vec[i32]]) -> i32 {
    let m = grid.len();
    let n = grid[0].len();
    let mut best: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n, i64.MAX));
    let mut queue: PriorityQueue[(i64, i64, i64)] = PriorityQueue.new();
    best[0][0] = 0;
    queue.push((0, 0, 0));
    while let Some((cost, r, c)) = queue.pop() {
        if cost > best[r][c] {
            continue;
        }
        if r == m - 1 and c == n - 1 {
            return cost as i32;
        }
        let neighbours = [(r, c + 1, 1), (r, c - 1, 2), (r + 1, c, 3), (r - 1, c, 4)];
        for (nr, nc, sign) in neighbours {
            if nr >= 0 and nr < m and nc >= 0 and nc < n {
                let next = cost + if grid[r][c] == sign { 0 } else { 1 };
                if next < best[nr][nc] {
                    best[nr][nc] = next;
                    queue.push((next, nr, nc));
                }
            }
        }
    }
    best[m - 1][n - 1] as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// an m by n grid of signs drawn at random from 1 to 4
fn random_grid(seed: mut ref i64, m: i64, n: i64) -> Vec[Vec[i32]] {
    let mut grid: Vec[Vec[i32]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i32] = Vec.new();
        for _ in 0..n {
            row.push((1 + next_random(mut seed) % 4) as i32);
        }
        grid.push(row);
    }
    grid
}

fn main() {
    // LeetCode's three examples; one cell; a 100 by 100 grid of 2s, every
    // sign pointing left, the constraints' most; and a 100 by 100 grid at
    // random
    let e1 = min_cost([[1, 1, 1, 1], [2, 2, 2, 2], [1, 1, 1, 1], [2, 2, 2, 2]]);
    let e2 = min_cost([[1, 1, 3], [3, 2, 2], [1, 1, 4]]);
    let e3 = min_cost([[1, 2], [4, 3]]);
    let one = min_cost([[4]]);
    let left = min_cost(Vec.filled(100, Vec.filled(100, 2)));
    let mut seed = 1368;
    let big = min_cost(random_grid(mut seed, 100, 100));
    println(f"{e1} {e2} {e3} {one} {left} {big}");
    // 2000 random grids of 1 to 30 by 1 to 30
    let mut total = 0;
    let mut check: i64 = 0;
    for _ in 0..2000 {
        let m = 1 + next_random(mut seed) % 30;
        let n = 1 + next_random(mut seed) % 30;
        let got = min_cost(random_grid(mut seed, m, n)) as i64;
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random grids: costs total {total}, checksum {check}");
}
