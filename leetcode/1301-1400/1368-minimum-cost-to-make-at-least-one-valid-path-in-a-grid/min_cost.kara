// LeetCode #1368: Minimum Cost to Make at Least One Valid Path in a Grid
// -- the ★ arm: a 0-1 breadth-first search over the cells; a step the
// cell's sign points to costs 0 and goes to the deque's front, any other
// costs 1 and goes to its back, so cells leave the deque in cost order.
// O(m n)
fn min_cost(grid: Vec[Vec[i32]]) -> i32 {
    let (m, n) = (grid.len(), grid[0].len());
    // signs 1 to 4: right, left, down, up
    let moves = [(0, 1), (0, -1), (1, 0), (-1, 0)];
    let mut cost: Vec[Vec[i32]] = Vec.filled(m, Vec.filled(n, i32.MAX));
    let mut deque: VecDeque[(i64, i64)] = VecDeque.new();
    cost[0][0] = 0;
    deque.push_back((0, 0));
    while let Some((r, c)) = deque.pop_front() {
        for d in 0..4 {
            let (nr, nc) = (r + moves[d].0, c + moves[d].1);
            if nr < 0 or nr >= m or nc < 0 or nc >= n {
                continue;
            }
            let step: i32 = if grid[r][c] == (d + 1) as i32 { 0 } else { 1 };
            if cost[r][c] + step < cost[nr][nc] {
                cost[nr][nc] = cost[r][c] + step;
                if step == 0 {
                    deque.push_front((nr, nc));
                } else {
                    deque.push_back((nr, nc));
                }
            }
        }
    }
    cost[m - 1][n - 1]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// an m by n grid of signs drawn at random from 1 to 4
fn random_grid(seed: mut ref i64, m: i64, n: i64) -> Vec[Vec[i32]] {
    let mut grid: Vec[Vec[i32]] = Vec.new();
    for _ in 0..m {
        let mut row: Vec[i32] = Vec.new();
        for _ in 0..n {
            row.push((1 + next_random(mut seed) % 4) as i32);
        }
        grid.push(row);
    }
    grid
}

fn main() {
    // LeetCode's three examples; one cell; a 100 by 100 grid of 2s, every
    // sign pointing left, the constraints' most; and a 100 by 100 grid at
    // random
    let e1 = min_cost([[1, 1, 1, 1], [2, 2, 2, 2], [1, 1, 1, 1], [2, 2, 2, 2]]);
    let e2 = min_cost([[1, 1, 3], [3, 2, 2], [1, 1, 4]]);
    let e3 = min_cost([[1, 2], [4, 3]]);
    let one = min_cost([[4]]);
    let left = min_cost(Vec.filled(100, Vec.filled(100, 2)));
    let mut seed = 1368;
    let big = min_cost(random_grid(mut seed, 100, 100));
    println(f"{e1} {e2} {e3} {one} {left} {big}");
    // 2000 random grids of 1 to 30 by 1 to 30
    let mut total = 0;
    let mut check: i64 = 0;
    for _ in 0..2000 {
        let m = 1 + next_random(mut seed) % 30;
        let n = 1 + next_random(mut seed) % 30;
        let got = min_cost(random_grid(mut seed, m, n)) as i64;
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random grids: costs total {total}, checksum {check}");
}
