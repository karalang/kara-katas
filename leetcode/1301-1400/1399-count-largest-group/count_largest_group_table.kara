// LeetCode #1399: Count Largest Group -- each digit sum from the one
// before: x's sum is the sum of x / 10 plus x's last digit, so one
// addition a number, kept in a table; the sizes counted as the table
// fills, and the largest size and its count kept up to date as each
// size grows. O(n)

fn count_largest_group(n: i32) -> i32 {
    let mut sums: Vec[i32] = Vec.filled(n + 1, 0);
    let mut size: Vec[i32] = Vec.filled(37, 0);
    let mut largest = 0;
    let mut count = 0;
    for x in 1..=n {
        sums[x] = sums[x / 10] + x % 10;
        let s = sums[x];
        size[s] += 1;
        if size[s] > largest {
            largest = size[s];
            count = 1;
        } else if size[s] == largest {
            count += 1;
        }
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples, and two more
    let shown: Vec[String] = [13, 2, 15, 24].iter().map(|n| f"{count_largest_group(n)}").collect();
    println(shown.join(" "));
    // the constraints' most, and the turns of the decades
    let ends: Vec[String] = [10000, 9999, 1000, 999, 100, 99, 10, 9, 1].iter().map(|n| f"{count_largest_group(n)}").collect();
    println(f"ends: {ends.join(" ")}");
    // every n from 1 to 10^4
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for n in 1..=10000 {
        let got = count_largest_group(n);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"n = 1 to 10^4: {total} in all, checksum {check}");
}
