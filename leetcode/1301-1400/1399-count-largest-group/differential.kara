// LeetCode #1399: Count Largest Group -- differential test of
// the five arms against the statement read literally, with five more
// properties.

// ---- count_largest_group.kara ----
fn a0_digit_sum(x: i32) -> i64 {
    let mut rest = x;
    let mut sum = 0;
    while rest > 0 {
        sum += rest % 10;
        rest /= 10;
    }
    sum
}

fn a0_count_largest_group(n: i32) -> i32 {
    let mut size: Vec[i32] = Vec.filled(37, 0);
    for x in 1..=n {
        size[a0_digit_sum(x)] += 1;
    }
    let largest = size.iter().max().unwrap();
    size.iter().filter(|s| s == largest).count() as i32
}

// ---- count_largest_group_map.kara ----
fn a1_count_largest_group(n: i32) -> i32 {
    let mut groups: Map[i64, i64] = Map.new();
    for x in 1..=n {
        let sum: i64 = f"{x}".chars().map(|c| c.to_digit(10).unwrap() as i64).sum();
        *groups.entry(sum).or_insert(0) += 1;
    }
    let largest = groups.values().max().unwrap();
    groups.values().filter(|s| s == largest).count() as i32
}

// ---- count_largest_group_table.kara ----
fn a2_count_largest_group(n: i32) -> i32 {
    let mut sums: Vec[i32] = Vec.filled(n + 1, 0);
    let mut size: Vec[i32] = Vec.filled(37, 0);
    let mut largest = 0;
    let mut count = 0;
    for x in 1..=n {
        sums[x] = sums[x / 10] + x % 10;
        let s = sums[x];
        size[s] += 1;
        if size[s] > largest {
            largest = size[s];
            count = 1;
        } else if size[s] == largest {
            count += 1;
        }
    }
    count
}

// ---- count_largest_group_sorted.kara ----
fn a3_count_largest_group(n: i32) -> i32 {
    let mut sums: Vec[i32] = (1..=n).map(|x| {
        let mut rest = x;
        let mut sum: i32 = 0;
        while rest > 0 {
            sum += rest % 10;
            rest /= 10;
        }
        sum
    }).collect();
    sums.sort();
    let mut longest = 0;
    let mut count = 0;
    let mut start = 0;
    while start < sums.len() {
        let mut end = start;
        while end < sums.len() and sums[end] == sums[start] {
            end += 1;
        }
        let run = end - start;
        if run > longest {
            longest = run;
            count = 1;
        } else if run == longest {
            count += 1;
        }
        start = end;
    }
    count
}

// ---- count_largest_group_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_count_largest_group(n: i32) -> i32 {
        let mut map: Map[i32, i32] = Map.new();
        for i in 1..=n {
            let sum: i32 = i.to_string().chars().map(|c| c.to_digit(10).unwrap() as i32).sum();
            *map.entry(sum).or_insert(0) += 1;
        }
        let max = *map.values().max().unwrap();
        map.values().filter(|v| v == max).count() as i32
    }
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: every number from 1 to n put in the group
// of its digits' sum, each digit read off its decimal text, and the
// groups as long as the longest counted
fn literal(n: i64) -> i64 {
    let mut groups: Vec[Vec[i64]] = Vec.new();
    for x in 1..=n {
        let mut sum = 0;
        for c in f"{x}".chars() {
            sum += c as i64 - '0' as i64;
        }
        while groups.len() <= sum {
            groups.push(Vec.new());
        }
        groups[sum].push(x);
    }
    let mut longest = 0;
    for g in groups.iter() {
        longest = longest.max(g.len());
    }
    let mut count = 0;
    for g in groups.iter() {
        if g.len() == longest {
            count += 1;
        }
    }
    count
}

fn arm(i: i64, n: i64) -> i64 {
    let n = n as i32;
    let got = match i {
        0 => a0_count_largest_group(n),
        1 => a1_count_largest_group(n),
        2 => a2_count_largest_group(n),
        3 => a3_count_largest_group(n),
        _ => A4Solution.a4_count_largest_group(n),
    };
    got
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, n: i64) {
    t.cases += 1;
    let want = literal(n);
    t.check = (t.check * 131 + want) % 1000000007;
    t.check = (t.check * 131 + n) % 1000000007;
    let star = arm(0, n);
    for i in 0..5 {
        let got = arm(i, n);
        let what = f"arm {i} on n = {n}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: at least one group, and no more than the numbers, or than
        // the 36 sums a number up to 10^4 can have
        expect(mut t, 2, got >= 1 and got <= n.min(36), f"P2 {what}: {got} groups");
        // P3: one more number joins one group, so the count of the
        // largest groups stays, grows by one when that group catches up,
        // or falls to one when it pulls ahead
        if n > 1 {
            let before = arm(i, n - 1);
            let step = got == before or got == before + 1 or got == 1;
            expect(mut t, 3, step, f"P3 {what}: {got} after {before} for n - 1");
        }
        // P4: below 10 every number is its own group
        if n < 10 {
            expect(mut t, 4, got == n, f"P4 {what}: {got}");
        }
        // P5: the sums of 1 to 10^k - 1 lie symmetric about 9k / 2, so the
        // largest groups are the middle sum when 9k is even and the two
        // middle sums when it is odd (all nine for k = 1)
        if n == 99 or n == 999 or n == 9999 {
            let k = f"{n}".len();
            let middle = if 9 * k % 2 == 0 { 1 } else { 2 };
            expect(mut t, 5, got == middle, f"P5 {what}: {got}, not {middle}");
        }
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // every n from 1 to 1000, the constraints' most and the turns of the
    // decades above it, and 993 n drawn from 1001 to 10^4. Every case is
    // drawn before any arm answers.
    let mut cases: Vec[i64] = (1..=1000).collect();
    for n in [10000, 9999, 1001, 1009, 1010, 1099, 1100, 1999, 2000, 9990] {
        cases.push(n);
    }
    let mut seed = 13991;
    for _ in 0..993 {
        cases.push(1001 + next_random(mut seed) % 9000);
    }
    for n in cases.iter() {
        check_case(mut t, n);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
