// LeetCode #1399: Count Largest Group -- a Rust solution as LeetCode's
// Rust users write it: a `HashMap<i32, i32>` filled through
// `entry().or_insert`, the digit sum by `to_string().chars()` and
// `to_digit`, the largest from `values().max()` and the groups of that
// size counted by `filter`, carried to Kāra by `karac fix`

struct Solution {}

impl Solution {
    pub fn count_largest_group(n: i32) -> i32 {
        let mut map: Map[i32, i32] = Map.new();
        for i in 1..=n {
            let sum: i32 = i.to_string().chars().map(|c| c.to_digit(10).unwrap() as i32).sum();
            *map.entry(sum).or_insert(0) += 1;
        }
        let max = *map.values().max().unwrap();
        map.values().filter(|v| v == max).count() as i32
    }
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples, and two more
    let shown: Vec[String] = [13, 2, 15, 24].iter().map(|n| f"{Solution.count_largest_group(n)}").collect();
    println(shown.join(" "));
    // the constraints' most, and the turns of the decades
    let ends: Vec[String] = [10000, 9999, 1000, 999, 100, 99, 10, 9, 1].iter().map(|n| f"{Solution.count_largest_group(n)}").collect();
    println(f"ends: {ends.join(" ")}");
    // every n from 1 to 10^4
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for n in 1..=10000 {
        let got = Solution.count_largest_group(n);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"n = 1 to 10^4: {total} in all, checksum {check}");
}
