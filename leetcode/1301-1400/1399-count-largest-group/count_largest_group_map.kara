// LeetCode #1399: Count Largest Group -- the groups kept in a `Map` from
// digit sum to size, the sum of a number's digits read off its decimal
// text, then the largest of the map's values and the groups of that
// size. O(n log n)

fn count_largest_group(n: i32) -> i32 {
    let mut groups: Map[i64, i64] = Map.new();
    for x in 1..=n {
        let sum: i64 = f"{x}".chars().map(|c| c.to_digit(10).unwrap() as i64).sum();
        *groups.entry(sum).or_insert(0) += 1;
    }
    let largest = groups.values().max().unwrap();
    groups.values().filter(|s| s == largest).count() as i32
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples, and two more
    let shown: Vec[String] = [13, 2, 15, 24].iter().map(|n| f"{count_largest_group(n)}").collect();
    println(shown.join(" "));
    // the constraints' most, and the turns of the decades
    let ends: Vec[String] = [10000, 9999, 1000, 999, 100, 99, 10, 9, 1].iter().map(|n| f"{count_largest_group(n)}").collect();
    println(f"ends: {ends.join(" ")}");
    // every n from 1 to 10^4
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for n in 1..=10000 {
        let got = count_largest_group(n);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"n = 1 to 10^4: {total} in all, checksum {check}");
}
