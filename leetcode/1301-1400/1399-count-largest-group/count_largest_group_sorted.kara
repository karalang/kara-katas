// LeetCode #1399: Count Largest Group -- every digit sum written down,
// the list sorted so each group is a run, and the runs' lengths walked
// for the longest and the number of runs that long. O(n log n)

fn count_largest_group(n: i32) -> i32 {
    let mut sums: Vec[i32] = (1..=n).map(|x| {
        let mut rest = x;
        let mut sum: i32 = 0;
        while rest > 0 {
            sum += rest % 10;
            rest /= 10;
        }
        sum
    }).collect();
    sums.sort();
    let mut longest = 0;
    let mut count = 0;
    let mut start = 0;
    while start < sums.len() {
        let mut end = start;
        while end < sums.len() and sums[end] == sums[start] {
            end += 1;
        }
        let run = end - start;
        if run > longest {
            longest = run;
            count = 1;
        } else if run == longest {
            count += 1;
        }
        start = end;
    }
    count
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples, and two more
    let shown: Vec[String] = [13, 2, 15, 24].iter().map(|n| f"{count_largest_group(n)}").collect();
    println(shown.join(" "));
    // the constraints' most, and the turns of the decades
    let ends: Vec[String] = [10000, 9999, 1000, 999, 100, 99, 10, 9, 1].iter().map(|n| f"{count_largest_group(n)}").collect();
    println(f"ends: {ends.join(" ")}");
    // every n from 1 to 10^4
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for n in 1..=10000 {
        let got = count_largest_group(n);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"n = 1 to 10^4: {total} in all, checksum {check}");
}
