// LeetCode #1399: Count Largest Group -- the ★ arm: each number's digit
// sum found by peeling off its last digit, the groups' sizes counted in
// an array indexed by the sum (at most 36, for 9999), then the largest
// size found and the groups of that size counted. O(n log n)

fn digit_sum(x: i32) -> i64 {
    let mut rest = x;
    let mut sum = 0;
    while rest > 0 {
        sum += rest % 10;
        rest /= 10;
    }
    sum
}

fn count_largest_group(n: i32) -> i32 {
    let mut size: Vec[i32] = Vec.filled(37, 0);
    for x in 1..=n {
        size[digit_sum(x)] += 1;
    }
    let largest = size.iter().max().unwrap();
    size.iter().filter(|s| s == largest).count() as i32
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's two examples, and two more
    let shown: Vec[String] = [13, 2, 15, 24].iter().map(|n| f"{count_largest_group(n)}").collect();
    println(shown.join(" "));
    // the constraints' most, and the turns of the decades
    let ends: Vec[String] = [10000, 9999, 1000, 999, 100, 99, 10, 9, 1].iter().map(|n| f"{count_largest_group(n)}").collect();
    println(f"ends: {ends.join(" ")}");
    // every n from 1 to 10^4
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for n in 1..=10000 {
        let got = count_largest_group(n);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"n = 1 to 10^4: {total} in all, checksum {check}");
}
