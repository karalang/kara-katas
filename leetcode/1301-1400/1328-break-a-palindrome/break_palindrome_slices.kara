// LeetCode #1328: Break a Palindrome -- the slices arm: the first half, a
// `Str` view, searched for a letter that is not an a (written as Rust's
// `half.find(|c: char| c != 'a')`, which `karac fix` takes to
// `char_indices().find(..)`), and the answer put together from the text's
// slices around the one changed letter. O(n)

fn break_palindrome(palindrome: String) -> String {
    let n = palindrome.len();
    if n < 2 {
        return "".to_string();
    }
    let half = palindrome[..n / 2];
    match half.char_indices().find(|(_, c)| c != 'a').map(|(i, _)| i) {
        Some(i) => f"{palindrome[..i]}a{palindrome[i + 1..]}",
        None => f"{palindrome[..n - 1]}b",
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn ask(s: Str) -> String {
    f"[{break_palindrome(s.to_string())}]"
}

fn main() {
    // LeetCode's two examples; two of one letter; a middle letter, which
    // changes nothing when changed; a first half with no a; a first half of
    // nothing but a around a middle b; and 1000 of a, the constraints'
    // longest, whose answer ends in b
    let long = break_palindrome("a".repeat(1000));
    println(f"{ask("abccba")} {ask("a")} {ask("aa")} {ask("aba")} {ask("zzz")} {ask("aabaa")} {long.len()} {long.ends_with("ab")}");
    // 600 random palindromes of 1 to 200 letters, most of them short, over
    // a alone, a and b, or all 26 letters
    let letters = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z'];
    let mut seed = 1328;
    let mut empty = 0;
    let mut check = 0;
    for t in 0..600 {
        let n = if t % 5 == 0 { 1 + next_random(mut seed) % 200 } else { 1 + next_random(mut seed) % 12 };
        let k = if t % 3 == 0 { 1 } else if t % 3 == 1 { 2 } else { 26 };
        let mut half: Vec[char] = Vec.new();
        for _ in 0..(n + 1) / 2 {
            half.push(letters[next_random(mut seed) % k]);
        }
        let mut chars = half.clone();
        for i in (0..n / 2).rev() {
            chars.push(half[i]);
        }
        let s: String = chars.iter().collect();
        let got = break_palindrome(s);
        if got.len() == 0 {
            empty += 1;
        }
        for b in got.bytes().iter() {
            check = (check * 131 + *b) % 1000000007;
        }
        check = (check * 131 + 1) % 1000000007;
    }
    println(f"600 random palindromes: {empty} left unbroken, checksum {check}");
}
