// LeetCode #1379: Find a Corresponding Node of a Binary Tree in a Clone of
// That Tree -- the ★ arm: the two trees walked together, depth first, each
// step taken in both; the clone's node at the step where the original's
// is the target itself, the same node and not one equal to it, is the
// answer. O(n), as deep as the tree

fn find(o: TreeNode, c: TreeNode, target: TreeNode) -> Option[TreeNode] {
    if o.ref_eq(target) {
        return Some(c);
    }
    if let (Some(lo), Some(lc)) = (o.left, c.left) {
        if let Some(found) = find(lo, lc, target) {
            return Some(found);
        }
    }
    if let (Some(ro), Some(rc)) = (o.right, c.right) {
        return find(ro, rc, target);
    }
    None
}

fn get_target_copy(original: TreeNode, cloned: TreeNode, target: TreeNode) -> TreeNode {
    find(original, cloned, target).unwrap()
}

// ---- test harness ---------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// LeetCode's level-order list, `None` for a missing child
fn from_level(values: Vec[Option[i32]]) -> TreeNode {
    let root = TreeNode { val: values[0].unwrap(), left: None, right: None };
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    queue.push_back(root);
    let mut i = 1;
    while i < values.len() {
        let Some(node) = queue.pop_front() else {
            break;
        };
        if let Some(v) = values[i] {
            let child = TreeNode { val: v, left: None, right: None };
            node.left = Some(child);
            queue.push_back(child);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let child = TreeNode { val: v, left: None, right: None };
                node.right = Some(child);
                queue.push_back(child);
            }
            i += 1;
        }
    }
    root
}

// a copy of the tree, node for node
fn clone_tree(node: TreeNode) -> TreeNode {
    let copy = TreeNode { val: node.val, left: None, right: None };
    if let Some(l) = node.left {
        copy.left = Some(clone_tree(l));
    }
    if let Some(r) = node.right {
        copy.right = Some(clone_tree(r));
    }
    copy
}

// the nodes of a tree and of its clone, in the same breadth-first order
fn pairs(original: TreeNode, cloned: TreeNode) -> Vec[(TreeNode, TreeNode)] {
    let mut out: Vec[(TreeNode, TreeNode)] = [(original, cloned)];
    let mut i = 0;
    while i < out.len() {
        let (o, c) = out[i];
        if let (Some(lo), Some(lc)) = (o.left, c.left) {
            out.push((lo, lc));
        }
        if let (Some(ro), Some(rc)) = (o.right, c.right) {
            out.push((ro, rc));
        }
        i += 1;
    }
    out
}

// n nodes holding n different values, each hung on an empty child place
// of the tree so far: chosen at random (kind 0), the last two opened, so
// the tree runs deep (kind 1), or the first two still open, so it fills
// level by level (kind 2)
fn random_tree(seed: mut ref i64, n: i64, kind: i64) -> TreeNode {
    let mut values: Vec[i32] = (1..n + 1).map(|v| (v * 37 % 100003) as i32).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        values.swap(i, j);
    }
    let root = TreeNode { val: values[0], left: None, right: None };
    let mut places: Vec[(TreeNode, bool)] = [(root, true), (root, false)];
    for k in 1..n {
        let at = if kind == 0 {
            next_random(mut seed) % places.len()
        } else if kind == 1 {
            places.len() - 1 - next_random(mut seed) % 2
        } else {
            next_random(mut seed) % 2
        };
        let (parent, left) = places.remove(at);
        let node = TreeNode { val: values[k], left: None, right: None };
        if left {
            parent.left = Some(node);
        } else {
            parent.right = Some(node);
        }
        places.push((node, true));
        places.push((node, false));
    }
    root
}

// the copy found for the k-th node: its value, and whether it is that
// node's own copy in the clone
fn ask(both: Vec[(TreeNode, TreeNode)], original: TreeNode, cloned: TreeNode, k: i64) -> (i32, bool) {
    let (target, copy) = both[k];
    let found = get_target_copy(original, cloned, target);
    (found.val, found.ref_eq(copy))
}

fn main() {
    // LeetCode's three examples; 10^4 nodes, the constraints' most, in a
    // chain of left children (the last node asked for) and as a complete
    // tree (the last node and a middle one)
    let mut shown: Vec[String] = Vec.new();
    let examples: Vec[(Vec[Option[i32]], i32)] = [
        ([Some(7), Some(4), Some(3), None, None, Some(6), Some(19)], 3),
        ([Some(7)], 7),
        ([Some(8), None, Some(6), None, Some(5), None, Some(4), None, Some(3), None, Some(2), None, Some(1)], 4),
    ];
    for (level, want) in examples.iter() {
        let original = from_level(level);
        let cloned = clone_tree(original);
        let both = pairs(original, cloned);
        let k = both.iter().position(|p| p.0.val == want).unwrap();
        let (v, own) = ask(both, original, cloned, k);
        shown.push(if own { f"{v}" } else { f"{v}?" });
    }
    let mut chain = TreeNode { val: 1, left: None, right: None };
    for v in 2..10001 {
        chain = TreeNode { val: v as i32, left: Some(chain), right: None };
    }
    let chain_copy = clone_tree(chain);
    let chain_pairs = pairs(chain, chain_copy);
    let (v, own) = ask(chain_pairs, chain, chain_copy, 9999);
    shown.push(if own { f"{v}" } else { f"{v}?" });
    let full = from_level((1..10001).map(|v| Some(v as i32)).collect());
    let full_copy = clone_tree(full);
    let full_pairs = pairs(full, full_copy);
    for k in [9999, 4321] {
        let (v, own) = ask(full_pairs, full, full_copy, k);
        shown.push(if own { f"{v}" } else { f"{v}?" });
    }
    println(shown.join(" "));
    // 2000 random trees of 1 to 300 nodes, a third of each kind, and a
    // node of each asked for at random
    let mut seed = 1379;
    let mut own_copies = 0;
    let mut check: i64 = 0;
    for c in 0..2000 {
        let n = 1 + next_random(mut seed) % 300;
        let original = random_tree(mut seed, n, c % 3);
        let cloned = clone_tree(original);
        let both = pairs(original, cloned);
        let k = next_random(mut seed) % n;
        let (v, own) = ask(both, original, cloned, k);
        if own {
            own_copies += 1;
        }
        check = (check * 131 + v) % 1000000007;
    }
    println(f"2000 random trees: {own_copies} own copies found, checksum {check}");
}
