// LeetCode #1346 bench: the ★ arm (a `Set` of the values seen so far, each
// new value checked for its double and, when even, its half) on 2000
// arrays of 500 values, the constraints' longest, built once from odd
// values between -999 and 999, so none starts with a pair; then 100
// passes, each setting one value of every array from the checksum so far
// to any value from -1000 to 1000, answering it and folding the answer
// plus the pass into the checksum.

fn check_if_exist(arr: Vec[i32]) -> bool {
    let mut seen: Set[i32] = Set.new();
    for x in arr.iter() {
        if seen.contains(2 * x) or (x % 2 == 0 and seen.contains(x / 2)) {
            return true;
        }
        seen.insert(x);
    }
    false
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1346;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    for _ in 0..2000 {
        let mut arr: Vec[i32] = Vec.new();
        for _ in 0..500 {
            arr.push((2 * (next_random(mut seed) % 1000) - 999) as i32);
        }
        arrays.push(arr);
    }
    let mut check: i64 = 0;
    for pass in 0..100 {
        for a in 0..2000 {
            arrays[a][check % 500] = ((check / 7) % 2001 - 1000) as i32;
            let yes = check_if_exist(arrays[a]);
            check = (check * 31 + (if yes { 2 } else { 1 }) + pass) % 1000000007;
        }
    }
    println(f"100 passes over 2000 arrays of 500: checksum {check}");
}
