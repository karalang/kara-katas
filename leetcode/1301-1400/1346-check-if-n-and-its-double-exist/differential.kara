// LeetCode #1346: Check If N and Its Double Exist -- differential test of
// the five arms against the statement read literally, with five more
// properties.
//
// The statement: given an array arr of integers, check if there exist two
// indices i and j such that i != j, 0 <= i, j < arr.length, and arr[i] ==
// 2 * arr[j].

// ---- check_if_exist.kara ----
fn a0_check_if_exist(arr: Vec[i32]) -> bool {
    let mut seen: Set[i32] = Set.new();
    for x in arr.iter() {
        if seen.contains(2 * x) or (x % 2 == 0 and seen.contains(x / 2)) {
            return true;
        }
        seen.insert(x);
    }
    false
}

// ---- check_if_exist_counts.kara ----
fn a1_check_if_exist(arr: Vec[i32]) -> bool {
    let mut count: Vec[i32] = Vec.filled(2001, 0);
    for x in arr.iter() {
        count[x + 1000] += 1;
    }
    for x in -500..501 {
        let have = count[x + 1000];
        if have == 0 {
            continue;
        }
        if x == 0 {
            if have >= 2 {
                return true;
            }
        } else if count[2 * x + 1000] > 0 {
            return true;
        }
    }
    false
}

// ---- check_if_exist_sorted.kara ----
fn a2_check_if_exist(arr: Vec[i32]) -> bool {
    let mut s = arr.clone();
    s.sort();
    for i in 0..s.len() {
        {
            let j = s.partition_point(|y| y <= 2 * s[i]);
            if j > 0 and s[j - 1] == 2 * s[i] {
                let j = j - 1;
                if j != i {
                    return true;
                }
                if i > 0 and s[i - 1] == s[i] or i + 1 < s.len() and s[i + 1] == s[i] {
                    return true;
                }
            }
        }
    }
    false
}

// ---- check_if_exist_pairs.kara ----
fn a3_check_if_exist(arr: Vec[i32]) -> bool {
    for i in 0..arr.len() {
        for j in 0..arr.len() {
            if i != j and arr[i] == 2 * arr[j] {
                return true;
            }
        }
    }
    false
}

// ---- check_if_exist_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_check_if_exist(arr: Vec[i32]) -> bool {
        let mut seen = Set.new();
        for x in ref arr {
            if seen.contains(x * 2) or (x % 2 == 0 and seen.contains(x / 2)) {
                return true;
            }
            seen.insert(x);
        }
        false
    }
}

fn a4_check_if_exist(arr: Vec[i32]) -> bool {
    A4Solution.a4_check_if_exist(arr)
}
// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: for each index j, the indices i holding
// 2 * arr[j] are counted, and j itself is taken off when it is one of
// them, so i != j; any count left is a pair
fn literal(arr: Vec[i32]) -> bool {
    for j in 0..arr.len() {
        let mut holders = 0;
        for i in 0..arr.len() {
            if arr[i] == 2 * arr[j] {
                holders += 1;
            }
        }
        if arr[j] == 2 * arr[j] {
            holders -= 1;
        }
        if holders > 0 {
            return true;
        }
    }
    false
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, arr: Vec[i32]) -> bool {
    match i {
        0 => a0_check_if_exist(arr),
        1 => a1_check_if_exist(arr),
        2 => a2_check_if_exist(arr),
        3 => a3_check_if_exist(arr),
        _ => a4_check_if_exist(arr),
    }
}

fn check_case(t: mut ref Tally, arr: Vec[i32]) {
    t.cases += 1;
    let want = literal(arr);
    t.check = (t.check * 131 + (if want { 2 } else { 1 }) * 17 + arr.len()) % 1000000007;
    let star = a0_check_if_exist(arr);
    let backwards: Vec[i32] = arr.iter().rev().cloned().collect();
    let negated: Vec[i32] = arr.iter().map(|x| -x).collect();
    let doubled: Vec[i32] = arr.iter().map(|x| 2 * x).collect();
    let mut with_double = arr.clone();
    with_double.push(2 * arr[0]);
    for i in 0..5 {
        let got = arm(i, arr);
        let what = f"arm {i} on {arr}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: the array read backwards: the same answer
        let bw = arm(i, backwards);
        expect(mut t, 2, bw == got, f"P2 {what}, backwards: {bw}");
        // P3: every value negated: a = 2b exactly when -a = 2(-b), so the
        // same answer
        let ng = arm(i, negated);
        expect(mut t, 3, ng == got, f"P3 {what}, negated: {ng}");
        // P4: every value doubled: the same answer
        let db = arm(i, doubled);
        expect(mut t, 4, db == got, f"P4 {what}, doubled: {db}");
        // P5: twice the first value put at the end: a pair
        let wd = arm(i, with_double);
        expect(mut t, 5, wd, f"P5 {what}, with {2 * arr[0]} at the end: {wd}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 arrays of 2 to 10 values in four kinds, 500 each: from -3 to 3;
    // from -20 to 20; odd, from -99 to 99, where no value is another's
    // double; and powers of two up to 256 with either sign. Every value
    // lies within -500 to 500, so doubling keeps it within the constraints.
    // Every array is drawn before any arm answers.
    let mut seed = 13461;
    let mut cases: Vec[Vec[i32]] = Vec.new();
    for c in 0..2000 {
        let kind = c / 500;
        let n = 2 + next_random(mut seed) % 9;
        let mut arr: Vec[i32] = Vec.new();
        for _ in 0..n {
            let v = if kind == 0 {
                next_random(mut seed) % 7 - 3
            } else if kind == 1 {
                next_random(mut seed) % 41 - 20
            } else if kind == 2 {
                2 * (next_random(mut seed) % 100) - 99
            } else {
                let p = 1 << (next_random(mut seed) % 9);
                if next_random(mut seed) % 2 == 0 { p } else { -p }
            };
            arr.push(v as i32);
        }
        cases.push(arr);
    }
    for arr in cases.iter() {
        check_case(mut t, arr);
    }
    println(f"{t.cases} arrays: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
