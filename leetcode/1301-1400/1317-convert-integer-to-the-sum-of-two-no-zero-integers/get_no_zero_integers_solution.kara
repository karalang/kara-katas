// LeetCode #1317: Convert Integer to the Sum of Two No-Zero Integers -- a
// Rust solution as LeetCode's Rust users write it (`(1..n).find(|&a|
// !a.to_string().contains('0') && !(n - a).to_string().contains('0'))`,
// the pair returned as `vec![a, n - a]`), carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn get_no_zero_integers(n: i32) -> Vec[i32] {
        let a = (1..n)
            .find(|a| not a.to_string().contains("0") and not (n - a).to_string().contains("0"))
            .unwrap();
        [a, n - a]
    }
}

fn get_no_zero_integers(n: i64) -> Vec[i64] {
    Solution.get_no_zero_integers(n as i32).iter().map(|x| x as i64).collect()
}

// ---- test harness ---------------------------------------------------------

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    parts.join(",")
}

fn main() {
    // LeetCode's two examples; 10, 100 and 1010, with a 0 in n; 9999; and
    // 10^4, the constraints' most
    let asks = [2, 11, 10, 100, 1010, 9999, 10000];
    let shown: Vec[String] = asks.iter().map(|n| show(get_no_zero_integers(n))).collect();
    println(shown.join(" "));
    // every n from 2 to 10^4
    let mut total = 0;
    let mut check = 0;
    for n in 2..=10000 {
        let v = get_no_zero_integers(n);
        total += v[0];
        check = (check * 31 + v[0] * 10007 + v[1]) % 1000000007;
    }
    println(f"every n from 2 to 10^4: first numbers total {total}, checksum {check}");
}
