// LeetCode #1317: Convert Integer to the Sum of Two No-Zero Integers -- the
// text arm: the first numbers from 1 up, each pair written out with an
// f-string and searched for a '0' by `contains`; the first pair with none
// is the answer. O(n log n) at worst

fn get_no_zero_integers(n: i64) -> Vec[i64] {
    for a in 1..n {
        let b = n - a;
        if not f"{a}{b}".contains("0") {
            return [a, b];
        }
    }
    [0, 0]
}

// ---- test harness ---------------------------------------------------------

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    parts.join(",")
}

fn main() {
    // LeetCode's two examples; 10, 100 and 1010, with a 0 in n; 9999; and
    // 10^4, the constraints' most
    let asks = [2, 11, 10, 100, 1010, 9999, 10000];
    let shown: Vec[String] = asks.iter().map(|n| show(get_no_zero_integers(n))).collect();
    println(shown.join(" "));
    // every n from 2 to 10^4
    let mut total = 0;
    let mut check = 0;
    for n in 2..=10000 {
        let v = get_no_zero_integers(n);
        total += v[0];
        check = (check * 31 + v[0] * 10007 + v[1]) % 1000000007;
    }
    println(f"every n from 2 to 10^4: first numbers total {total}, checksum {check}");
}
