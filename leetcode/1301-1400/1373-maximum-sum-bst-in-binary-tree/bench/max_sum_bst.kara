// LeetCode #1373 bench -- the ★ arm: one walk up from the leaves; each
// subtree reports whether it is a search tree, its smallest and largest
// key, and its sum.

struct Summary {
    search: bool,
    low: i64,
    high: i64,
    sum: i64,
}

fn summarize(node: Option[TreeNode], best: mut ref i64) -> Summary {
    let Some(n) = node else {
        // an empty tree is a search tree with no keys
        return Summary { search: true, low: i64.MAX, high: i64.MIN, sum: 0 };
    };
    let l = summarize(n.left, mut best);
    let r = summarize(n.right, mut best);
    let key = n.val as i64;
    if l.search and r.search and l.high < key and key < r.low {
        let sum = l.sum + key + r.sum;
        *best = (*best).max(sum);
        return Summary { search: true, low: l.low.min(key), high: r.high.max(key), sum: sum };
    }
    Summary { search: false, low: 0, high: 0, sum: 0 }
}

fn max_sum_bst(root: Option[TreeNode]) -> i32 {
    let mut best = 0;
    summarize(root, mut best);
    best as i32
}

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 4 search trees of 4 * 10^4 nodes, the constraints' most, keys from
    // -4 * 10^4 to 4 * 10^4 put in one by one, a key already there
    // skipped, built once; then 300 rounds, each giving one node of one
    // tree a new key, both drawn from the checksum so far, which may
    // break the order there, and finding that tree's largest search tree
    let mut seed = 1373;
    let mut roots: Vec[TreeNode] = Vec.new();
    let mut nodes: Vec[Vec[TreeNode]] = Vec.new();
    for _ in 0..4 {
        let root = TreeNode { val: 0, left: None, right: None };
        let mut all: Vec[TreeNode] = [root];
        while all.len() < 40000 {
            let key = ((next_random(mut seed) * 32768 + next_random(mut seed)) % 80001 - 40000) as i32;
            let mut at = root;
            loop {
                if key == at.val {
                    break;
                }
                let next = if key < at.val { at.left } else { at.right };
                match next {
                    Some(child) => at = child,
                    None => {
                        let node = TreeNode { val: key, left: None, right: None };
                        if key < at.val {
                            at.left = Some(node);
                        } else {
                            at.right = Some(node);
                        }
                        all.push(node);
                        break;
                    }
                }
            }
        }
        roots.push(root);
        nodes.push(all);
    }
    let mut check: i64 = 0;
    for r in 0..300 {
        let t = check % 4;
        let node = nodes[t][(check / 4) % 40000];
        node.val = ((check / 160000) % 80001 - 40000) as i32;
        let got = max_sum_bst(Some(roots[t])) as i64;
        check = (check * 31 + got + r) % 1000000007;
    }
    println(f"300 rounds over 4 trees of 40000 nodes: checksum {check}");
}
