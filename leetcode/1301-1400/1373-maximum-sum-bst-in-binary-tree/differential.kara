// LeetCode #1373: Maximum Sum BST in Binary Tree -- differential test of
// the five arms against the statement read literally, with five more
// properties.
//
// The statement: return the maximum sum of all keys of any subtree that
// is also a binary search tree: the left subtree of a node holds only
// keys less than its key, the right only greater, and both are search
// trees too. The empty tree counts, so the answer is never below 0.

// ---- max_sum_bst.kara ----
struct Summary {
    search: bool,
    low: i64,
    high: i64,
    sum: i64,
}

fn a0_summarize(node: Option[TreeNode], best: mut ref i64) -> Summary {
    let Some(n) = node else {
        // an empty tree is a search tree with no keys
        return Summary { search: true, low: i64.MAX, high: i64.MIN, sum: 0 };
    };
    let l = a0_summarize(n.left, mut best);
    let r = a0_summarize(n.right, mut best);
    let key = n.val as i64;
    if l.search and r.search and l.high < key and key < r.low {
        let sum = l.sum + key + r.sum;
        *best = (*best).max(sum);
        return Summary { search: true, low: l.low.min(key), high: r.high.max(key), sum: sum };
    }
    Summary { search: false, low: 0, high: 0, sum: 0 }
}

fn a0_max_sum_bst(root: Option[TreeNode]) -> i32 {
    let mut best = 0;
    a0_summarize(root, mut best);
    best as i32
}

// ---- max_sum_bst_bounds.kara ----
fn a1_within(node: Option[TreeNode], low: i64, high: i64) -> bool {
    let Some(n) = node else {
        return true;
    };
    let key = n.val as i64;
    low < key and key < high and a1_within(n.left, low, key) and a1_within(n.right, key, high)
}

fn a1_total(node: Option[TreeNode]) -> i64 {
    let Some(n) = node else {
        return 0;
    };
    n.val + a1_total(n.left) + a1_total(n.right)
}

fn a1_visit(node: Option[TreeNode], best: mut ref i64) {
    let Some(n) = node else {
        return;
    };
    if a1_within(node, i64.MIN, i64.MAX) {
        *best = (*best).max(a1_total(node));
    }
    a1_visit(n.left, mut best);
    a1_visit(n.right, mut best);
}

fn a1_max_sum_bst(root: Option[TreeNode]) -> i32 {
    let mut best = 0;
    a1_visit(root, mut best);
    best as i32
}

// ---- max_sum_bst_inorder.kara ----
fn a2_walk(node: Option[TreeNode], keys: mut ref Vec[i64], runs: mut ref Vec[(i64, i64)]) {
    let Some(n) = node else {
        return;
    };
    let start = keys.len();
    a2_walk(n.left, mut keys, mut runs);
    keys.push(n.val);
    a2_walk(n.right, mut keys, mut runs);
    runs.push((start, keys.len()));
}

fn a2_max_sum_bst(root: Option[TreeNode]) -> i32 {
    let mut keys: Vec[i64] = Vec.new();
    let mut runs: Vec[(i64, i64)] = Vec.new();
    a2_walk(root, mut keys, mut runs);
    let n = keys.len();
    // reach[i]: the end of the longest strictly increasing run from i
    let mut reach: Vec[i64] = Vec.filled(n + 1, n);
    for i in (0..n).rev() {
        reach[i] = if i + 1 < n and keys[i] < keys[i + 1] { reach[i + 1] } else { i + 1 };
    }
    let mut prefix: Vec[i64] = [0];
    for k in keys.iter() {
        prefix.push(prefix[prefix.len() - 1] + k);
    }
    let mut best = 0;
    for (start, end) in runs.iter() {
        if reach[start] >= end {
            best = best.max(prefix[end] - prefix[start]);
        }
    }
    best as i32
}

// ---- max_sum_bst_order.kara ----
fn a3_max_sum_bst(root: Option[TreeNode]) -> i32 {
    let Some(r) = root else {
        return 0;
    };
    // (node, parent's place, a left child)
    let mut order: Vec[(TreeNode, i64, bool)] = [(r, -1, false)];
    let mut i = 0;
    while i < order.len() {
        let node = order[i].0;
        if let Some(l) = node.left {
            order.push((l, i, true));
        }
        if let Some(rr) = node.right {
            order.push((rr, i, false));
        }
        i += 1;
    }
    let n = order.len();
    // each node's left and right subtree, as (search tree, low, high, sum);
    // a missing child stays the empty search tree
    let empty = (true, i64.MAX, i64.MIN, 0);
    let mut lefts: Vec[(bool, i64, i64, i64)] = Vec.filled(n, empty);
    let mut rights: Vec[(bool, i64, i64, i64)] = Vec.filled(n, empty);
    let mut best = 0;
    for k in (0..n).rev() {
        let (node, parent, is_left) = order[k];
        let key = node.val as i64;
        let (ls, llo, lhi, lsum) = lefts[k];
        let (rs, rlo, rhi, rsum) = rights[k];
        let mine = if ls and rs and lhi < key and key < rlo {
            let sum = lsum + key + rsum;
            best = best.max(sum);
            (true, llo.min(key), rhi.max(key), sum)
        } else {
            (false, 0, 0, 0)
        };
        if parent >= 0 {
            if is_left {
                lefts[parent] = mine;
            } else {
                rights[parent] = mine;
            }
        }
    }
    best as i32
}

// ---- max_sum_bst_solution.kara ----
struct A4Solution {}

fn a4_dfs(node: Option[TreeNode], ans: mut ref i32) -> (bool, i32, i32, i32) {
    match node {
        None => (true, i32.MAX, i32.MIN, 0),
        Some(n) => {
            let (lb, lmin, lmax, lsum) = a4_dfs(n.left, mut ans);
            let (rb, rmin, rmax, rsum) = a4_dfs(n.right, mut ans);
            if lb and rb and lmax < n.val and n.val < rmin {
                let sum = lsum + rsum + n.val;
                *ans = (*ans).max(sum);
                (true, lmin.min(n.val), rmax.max(n.val), sum)
            } else {
                (false, 0, 0, 0)
            }
        }
    }
}

impl A4Solution {
    pub fn a4_max_sum_bst(root: Option[TreeNode]) -> i32 {
        // returns (is_bst, min, max, sum)
        let mut ans = 0;
        a4_dfs(root, mut ans);
        ans
    }
}

fn a4_max_sum_bst(root: Option[TreeNode]) -> i32 {
    A4Solution.a4_max_sum_bst(root)
}

// ---- the differential -------------------------------------------------------
shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// LeetCode's level-order list, `None` for a missing child
fn from_level(values: Vec[Option[i32]]) -> Option[TreeNode] {
    if values.len() == 0 or values[0].is_none() {
        return None;
    }
    let root = TreeNode { val: values[0].unwrap(), left: None, right: None };
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    queue.push_back(root);
    let mut i = 1;
    while i < values.len() {
        let Some(node) = queue.pop_front() else {
            break;
        };
        if let Some(v) = values[i] {
            let child = TreeNode { val: v, left: None, right: None };
            node.left = Some(child);
            queue.push_back(child);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let child = TreeNode { val: v, left: None, right: None };
                node.right = Some(child);
                queue.push_back(child);
            }
            i += 1;
        }
    }
    Some(root)
}

// n nodes valued from -range to range, each hung on an empty child place
// of the tree so far chosen at random
fn random_tree(seed: mut ref i64, n: i64, range: i64) -> TreeNode {
    let root = TreeNode { val: (next_random(mut seed) % (2 * range + 1) - range) as i32, left: None, right: None };
    let mut places: Vec[(TreeNode, bool)] = [(root, true), (root, false)];
    for _ in 1..n {
        let k = next_random(mut seed) % places.len();
        let (parent, left) = places.swap_remove(k);
        let node = TreeNode { val: (next_random(mut seed) % (2 * range + 1) - range) as i32, left: None, right: None };
        if left {
            parent.left = Some(node);
        } else {
            parent.right = Some(node);
        }
        places.push((node, true));
        places.push((node, false));
    }
    root
}

// n keys from -range to range put into a search tree one by one, a key
// already there skipped; then `noise` nodes, found by random walks from
// the root, given a random value, which may break the order there
fn random_search_tree(seed: mut ref i64, n: i64, range: i64, noise: i64) -> TreeNode {
    let root = TreeNode { val: (next_random(mut seed) % (2 * range + 1) - range) as i32, left: None, right: None };
    for _ in 1..n {
        let key = (next_random(mut seed) % (2 * range + 1) - range) as i32;
        let mut at = root;
        loop {
            if key == at.val {
                break;
            }
            let next = if key < at.val { at.left } else { at.right };
            match next {
                Some(child) => at = child,
                None => {
                    let node = TreeNode { val: key, left: None, right: None };
                    if key < at.val {
                        at.left = Some(node);
                    } else {
                        at.right = Some(node);
                    }
                    break;
                }
            }
        }
    }
    for _ in 0..noise {
        let mut at = root;
        for _ in 0..next_random(mut seed) % 8 {
            let next = if next_random(mut seed) % 2 == 0 { at.left } else { at.right };
            match next {
                Some(child) => at = child,
                None => break,
            }
        }
        at.val = (next_random(mut seed) % (2 * range + 1) - range) as i32;
    }
    root
}

// the keys of a subtree
fn keys(node: Option[TreeNode], out: mut ref Vec[i64]) {
    let Some(n) = node else {
        return;
    };
    out.push(n.val);
    keys(n.left, mut out);
    keys(n.right, mut out);
}

// the statement read literally: the left subtree holds only keys less
// than the node's, the right only greater, and both are search trees
fn is_search(node: Option[TreeNode]) -> bool {
    let Some(n) = node else {
        return true;
    };
    let key = n.val as i64;
    let mut lefts: Vec[i64] = Vec.new();
    keys(n.left, mut lefts);
    let mut rights: Vec[i64] = Vec.new();
    keys(n.right, mut rights);
    lefts.iter().all(|k| k < key) and rights.iter().all(|k| k > key) and is_search(n.left) and is_search(n.right)
}

// the nodes, parents first
fn listed(root: TreeNode) -> Vec[TreeNode] {
    let mut nodes: Vec[TreeNode] = [root];
    let mut i = 0;
    while i < nodes.len() {
        let node = nodes[i];
        if let Some(l) = node.left {
            nodes.push(l);
        }
        if let Some(r) = node.right {
            nodes.push(r);
        }
        i += 1;
    }
    nodes
}

// every subtree that is a search tree, its keys summed; the largest sum,
// and 0 for the empty tree
fn literal(root: TreeNode) -> i64 {
    let mut best = 0;
    for node in listed(root).iter() {
        if is_search(Some(node)) {
            let mut all: Vec[i64] = Vec.new();
            keys(Some(node), mut all);
            best = best.max(all.iter().sum());
        }
    }
    best
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, root: Option[TreeNode]) -> i64 {
    let got = match i {
        0 => a0_max_sum_bst(root),
        1 => a1_max_sum_bst(root),
        2 => a2_max_sum_bst(root),
        3 => a3_max_sum_bst(root),
        _ => a4_max_sum_bst(root),
    };
    got
}

// a new tree, every key k made k * scale + shift
fn mapped(node: Option[TreeNode], scale: i32, shift: i32) -> Option[TreeNode] {
    let Some(n) = node else {
        return None;
    };
    Some(TreeNode { val: n.val * scale + shift, left: mapped(n.left, scale, shift), right: mapped(n.right, scale, shift) })
}

fn check_case(t: mut ref Tally, root: TreeNode) {
    t.cases += 1;
    let tree = Some(root);
    let want = literal(root);
    t.check = (t.check * 131 + want) % 1000000007;
    let nodes = listed(root);
    let n = nodes.len();
    let mut low = i64.MAX;
    let mut high = i64.MIN;
    let mut positive = 0;
    let mut leaf_high = i64.MIN;
    for node in nodes.iter() {
        let key = node.val as i64;
        low = low.min(key);
        high = high.max(key);
        positive += key.max(0);
        if node.left.is_none() and node.right.is_none() {
            leaf_high = leaf_high.max(key);
        }
    }
    // the tree hung as the left child of a new root below every key, and
    // as the right child of one above every key: neither new root heads a
    // search tree
    let under_low = Some(TreeNode { val: (low - 1) as i32, left: tree, right: None });
    let under_high = Some(TreeNode { val: (high + 1) as i32, left: None, right: tree });
    let doubled = mapped(tree, 2, 0);
    let shift = (1 - low).max(0);
    let shifted = mapped(tree, 1, shift as i32);
    let star = arm(0, tree);
    for i in 0..5 {
        let got = arm(i, tree);
        let what = f"arm {i} at a tree of {n} nodes";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: the tree under a new root that cannot head a search tree, the
        // same sum
        let left = arm(i, under_low);
        let right = arm(i, under_high);
        expect(mut t, 2, left == got and right == got, f"P2 {what}: {got}, then {left} and {right}");
        // P3: every key doubled, the sum doubled
        let twice = arm(i, doubled);
        expect(mut t, 3, twice == 2 * got, f"P3 {what}: {got}, doubled {twice}");
        // P4: every key shifted up until all are positive, a sum never
        // smaller and at least 1
        let up = arm(i, shifted);
        expect(mut t, 4, up >= got and up >= 1, f"P4 {what}: {got}, shifted by {shift} {up}");
        // P5: at least every leaf's key and 0, at most the positive keys'
        // sum
        expect(mut t, 5, got >= leaf_high.max(0) and got <= positive, f"P5 {what}: {got}, leaf {leaf_high}, positive {positive}");
        // P6: the ★ arm's sum
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's three examples and two more; then 1500 random trees of 1
    // to 12 nodes and 500 of 1 to 40, keys from -3 to 3, -10 to 10 or
    // -10000 to 10000, half with keys at random and half search trees
    // with a few keys changed
    let examples: Vec[Vec[Option[i32]]] = [
        [Some(1), Some(4), Some(3), Some(2), Some(4), Some(2), Some(5), None, None, None, None, None, None, Some(4), Some(6)],
        [Some(4), Some(3), None, Some(1), Some(2)],
        [Some(-4), Some(-2), Some(-5)],
        [Some(2), Some(1), Some(3)],
        [Some(5), Some(4), Some(8), Some(3), None, Some(6), Some(3)],
    ];
    for level in examples.iter() {
        check_case(mut t, from_level(level).unwrap());
    }
    let ranges = [3, 10, 10000];
    let mut seed = 1373;
    for k in 0..2000 {
        let n = 1 + next_random(mut seed) % if k < 1500 { 12 } else { 40 };
        let range = ranges[next_random(mut seed) % 3];
        let root = if k % 2 == 0 {
            random_tree(mut seed, n, range)
        } else {
            random_search_tree(mut seed, n, range, next_random(mut seed) % 4)
        };
        check_case(mut t, root);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
