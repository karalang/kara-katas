// LeetCode #1388: Pizza With 3n Slices -- the ★ arm: the slices you get
// are any n of the 3n with no two side by side around the circle, so the
// answer is the better of two straight runs, without the last slice and
// without the first; in each, best[i][j] is the most from at most j
// slices, no two adjacent, among the first i. O(n^2)

fn best_in_line(slices: Slice[i32], n: i64) -> i32 {
    let len = slices.len();
    let mut best: Vec[Vec[i32]] = Vec.filled(len + 1, Vec.filled(n + 1, 0));
    for i in 1..len + 1 {
        for j in 1..n + 1 {
            let skip = best[i - 1][j];
            let take = if i >= 2 { best[i - 2][j - 1] } else { 0 } + slices[i - 1];
            best[i][j] = skip.max(take);
        }
    }
    best[len][n]
}

fn max_size_slices(slices: Vec[i32]) -> i32 {
    let n = slices.len() / 3;
    let len = slices.len();
    best_in_line(slices[0..len - 1], n).max(best_in_line(slices[1..len], n))
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `len` slices of 1 to `most`
fn pizza(seed: mut ref i64, len: i64, most: i64) -> Vec[i32] {
    (0..len).map(|_| (1 + next_random(mut seed) % most) as i32).collect()
}

fn main() {
    // LeetCode's two examples; three slices; six of one size; and one
    // large slice beside two that together are larger
    let mut shown: Vec[String] = Vec.new();
    shown.push(f"{max_size_slices([1, 2, 3, 4, 5, 6])}");
    shown.push(f"{max_size_slices([8, 9, 8, 6, 1, 1])}");
    shown.push(f"{max_size_slices([4, 1, 2])}");
    shown.push(f"{max_size_slices([7, 7, 7, 7, 7, 7])}");
    shown.push(f"{max_size_slices([5, 9, 6, 1, 1, 1])}");
    println(shown.join(" "));
    // the constraints' most: 498 slices up to 1000, and 498 of size 1000
    let mut seed = 1388;
    let big = pizza(mut seed, 498, 1000);
    let flat: Vec[i32] = Vec.filled(498, 1000);
    println(f"498 slices: {max_size_slices(big)}, and {max_size_slices(flat)} when all are 1000");
    // 2000 random pizzas of 3 to 60 slices, of up to 1000 or up to 3
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for c in 0..2000 {
        let len = 3 * (1 + next_random(mut seed) % 20);
        let most = if c % 2 == 0 { 1000 } else { 3 };
        let slices = pizza(mut seed, len, most);
        let got = max_size_slices(slices);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random pizzas: {total} in all, checksum {check}");
}
