// LeetCode #1388: Pizza With 3n Slices -- a greedy that can take back
// what it took: the largest slice taken, and in its place one slice
// worth its two neighbours less itself, the neighbours gone, so that
// taking that slice later trades the first for both neighbours. The
// circle kept as a linked list in two `Vec`s, the slices in a max-first
// `PriorityQueue`, stale entries skipped. O(n log n)

fn max_size_slices(slices: Vec[i32]) -> i32 {
    let len = slices.len();
    let mut value: Vec[i32] = slices.clone();
    let mut left: Vec[i64] = (0..len).map(|i| (i + len - 1) % len).collect();
    let mut right: Vec[i64] = (0..len).map(|i| (i + 1) % len).collect();
    let mut gone: Vec[bool] = Vec.filled(len, false);
    let mut queue: PriorityQueue[(i32, i64)] = PriorityQueue.max_first();
    for i in 0..len {
        queue.push((value[i], i));
    }
    let mut total: i32 = 0;
    let mut taken = 0;
    while taken < len / 3 {
        let (v, i) = queue.pop().unwrap();
        if gone[i] or v != value[i] {
            continue;
        }
        total += v;
        taken += 1;
        let (l, r) = (left[i], right[i]);
        value[i] = value[l] + value[r] - value[i];
        gone[l] = true;
        gone[r] = true;
        left[i] = left[l];
        right[i] = right[r];
        right[left[i]] = i;
        left[right[i]] = i;
        queue.push((value[i], i));
    }
    total
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// `len` slices of 1 to `most`
fn pizza(seed: mut ref i64, len: i64, most: i64) -> Vec[i32] {
    (0..len).map(|_| (1 + next_random(mut seed) % most) as i32).collect()
}

fn main() {
    // LeetCode's two examples; three slices; six of one size; and one
    // large slice beside two that together are larger
    let mut shown: Vec[String] = Vec.new();
    shown.push(f"{max_size_slices([1, 2, 3, 4, 5, 6])}");
    shown.push(f"{max_size_slices([8, 9, 8, 6, 1, 1])}");
    shown.push(f"{max_size_slices([4, 1, 2])}");
    shown.push(f"{max_size_slices([7, 7, 7, 7, 7, 7])}");
    shown.push(f"{max_size_slices([5, 9, 6, 1, 1, 1])}");
    println(shown.join(" "));
    // the constraints' most: 498 slices up to 1000, and 498 of size 1000
    let mut seed = 1388;
    let big = pizza(mut seed, 498, 1000);
    let flat: Vec[i32] = Vec.filled(498, 1000);
    println(f"498 slices: {max_size_slices(big)}, and {max_size_slices(flat)} when all are 1000");
    // 2000 random pizzas of 3 to 60 slices, of up to 1000 or up to 3
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for c in 0..2000 {
        let len = 3 * (1 + next_random(mut seed) % 20);
        let most = if c % 2 == 0 { 1000 } else { 3 };
        let slices = pizza(mut seed, len, most);
        let got = max_size_slices(slices);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random pizzas: {total} in all, checksum {check}");
}
