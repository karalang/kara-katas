// LeetCode #1353: Maximum Number of Events That Can Be Attended -- the ★
// arm: a sweep over the days with a `PriorityQueue` of the open events'
// last days, smallest first. Each day the events starting then join the
// queue, the ones already over leave it, and the open event ending
// soonest is attended. Attending the most urgent event never costs a
// later one. O(n log n + D) over D days

fn max_events(events: Vec[Vec[i32]]) -> i32 {
    let mut by_start = events.clone();
    by_start.sort_by_key(|e| e[0]);
    let mut ends: PriorityQueue[i32] = PriorityQueue.new();
    let mut next = 0;
    let mut attended = 0;
    let mut day = 1;
    while next < by_start.len() or not ends.is_empty() {
        if ends.is_empty() and by_start[next][0] > day {
            day = by_start[next][0];
        }
        while next < by_start.len() and by_start[next][0] == day {
            ends.push(by_start[next][1]);
            next += 1;
        }
        while let Some(end) = ends.peek() {
            if end >= day {
                break;
            }
            ends.pop();
        }
        if not ends.is_empty() {
            ends.pop();
            attended += 1;
        }
        day += 1;
    }
    attended
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 sets of 10^4 events, starting on day 1 to 10^4 and lasting 1 to
    // 30 days, built once; then 600 rounds, each moving one event of one
    // set to a start and length drawn from the checksum so far, and
    // answering that set
    let mut seed = 1353;
    let mut sets: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..20 {
        let mut events: Vec[Vec[i32]] = Vec.new();
        for _ in 0..10000 {
            let start = 1 + next_random(mut seed) % 10000;
            let end = start + next_random(mut seed) % 30;
            events.push([start as i32, end as i32]);
        }
        sets.push(events);
    }
    let mut check: i64 = 0;
    for r in 0..600 {
        let k = check % 20;
        let at = (check / 20) % 10000;
        let start = 1 + (check / 7) % 10000;
        sets[k][at] = [start as i32, (start + (check / 11) % 30) as i32];
        check = (check * 31 + max_events(sets[k]) + r) % 1000000007;
    }
    println(f"600 rounds over 20 sets of 10^4 events: checksum {check}");
}
