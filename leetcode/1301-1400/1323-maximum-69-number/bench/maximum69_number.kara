// LeetCode #1323 bench: the ★ arm (the number written out, its first 6
// turned to a 9 by `replacen`, and the text read back) on the 30 numbers
// the constraints allow, 1 to 4 digits each a 6 or a 9; 100000 passes over
// all 30, each pass starting at a place chosen by the checksum so far and
// folding every answer plus the pass into it.

fn maximum69_number(num: i32) -> i32 {
    i32.parse(f"{num}".replacen("6", "9", 1)).unwrap()
}

fn main() {
    let mut nums: Vec[i32] = Vec.new();
    for digits in 1..=4 {
        for pattern in 0..1 << digits {
            let mut num: i32 = 0;
            for k in 0..digits {
                num = num * 10 + if (pattern >> k) & 1 == 1 { 9 } else { 6 };
            }
            nums.push(num);
        }
    }
    let mut check: i64 = 0;
    for pass in 0..100000 {
        let start = check % 30;
        for k in 0..30 {
            let got = maximum69_number(nums[(start + k) % 30]);
            check = (check * 31 + got + pass) % 1000000007;
        }
    }
    println(f"100000 passes over the 30 numbers: checksum {check}");
}
