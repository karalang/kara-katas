// LeetCode #1323: Maximum 69 Number -- the digits arm: the number taken
// apart into a `Vec` of digits, most significant first, the first 6
// found by `position` turned to a 9, and the digits folded back into a
// number. O(digits)

fn maximum69_number(num: i32) -> i32 {
    let mut digits: Vec[i32] = Vec.new();
    let mut rest = num;
    while rest > 0 {
        digits.push(rest % 10);
        rest /= 10;
    }
    digits.reverse();
    if let Some(at) = digits.iter().position(|d| d == 6) {
        digits[at] = 9;
    }
    digits.iter().fold(0, |acc, d| acc * 10 + d)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; one digit, a 6 and a 9; and 6666, the
    // most a 6 can gain
    let asks = [9669, 9996, 9999, 6, 9, 6666];
    let shown: Vec[String] = asks.iter().map(|n| f"{maximum69_number(n)}").collect();
    println(shown.join(" "));
    // every number of 1 to 4 digits each 6 or 9, the constraints' whole range
    let mut count = 0;
    let mut total = 0;
    let mut check = 0;
    for digits in 1..=4 {
        for pattern in 0..1 << digits {
            let mut num: i32 = 0;
            for k in 0..digits {
                num = num * 10 + if (pattern >> k) & 1 == 1 { 9 } else { 6 };
            }
            let got = maximum69_number(num) as i64;
            count += 1;
            total += got;
            check = (check * 31 + got) % 1000000007;
        }
    }
    println(f"every one of the {count} numbers: answers total {total}, checksum {check}");
}
