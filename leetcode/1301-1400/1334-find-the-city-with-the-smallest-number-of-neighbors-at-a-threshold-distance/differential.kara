// LeetCode #1334: Find the City With the Smallest Number of Neighbors at a
// Threshold Distance -- differential test of the five arms against the
// statement read literally, with five more properties.
//
// The statement: there are n cities numbered from 0 to n - 1, and edges
// where edges[i] = [from, to, weight] is a bidirectional weighted edge.
// Return the city with the smallest number of cities reachable through
// some path whose distance is at most distanceThreshold; if there are
// multiple such cities, return the city with the greatest number. The
// distance of a path is the sum of the edges' weights along it.

// ---- find_the_city.kara ----
fn a0_find_the_city(n: i32, edges: Vec[Vec[i32]], distance_threshold: i32) -> i32 {
    let n = n as i64;
    let far = 1000000000;
    let mut dist: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(n, far));
    for i in 0..n {
        dist[i][i] = 0;
    }
    for e in edges.iter() {
        dist[e[0]][e[1]] = e[2];
        dist[e[1]][e[0]] = e[2];
    }
    for k in 0..n {
        for i in 0..n {
            for j in 0..n {
                if dist[i][k] + dist[k][j] < dist[i][j] {
                    dist[i][j] = dist[i][k] + dist[k][j];
                }
            }
        }
    }
    let mut best = 0;
    let mut fewest = n + 1;
    for i in 0..n {
        let near = (0..n).filter(|j| j != i and dist[i][j] <= distance_threshold).count();
        if near <= fewest {
            fewest = near;
            best = i;
        }
    }
    best as i32
}

// ---- find_the_city_dijkstra.kara ----
fn a1_reachable(adj: Vec[Vec[(i64, i64)]], from: i64, threshold: i64) -> i64 {
    let mut dist: Vec[i64] = Vec.filled(adj.len(), -1);
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    queue.push((0, from));
    let mut count = 0;
    while let Some((d, city)) = queue.pop() {
        if dist[city] >= 0 {
            continue;
        }
        dist[city] = d;
        count += 1;
        for (next, w) in adj[city].iter() {
            if dist[next] < 0 and d + w <= threshold {
                queue.push((d + w, next));
            }
        }
    }
    count - 1
}

fn a1_find_the_city(n: i32, edges: Vec[Vec[i32]], distance_threshold: i32) -> i32 {
    let mut adj: Vec[Vec[(i64, i64)]] = Vec.filled(n, Vec.new());
    for e in edges.iter() {
        adj[e[0]].push((e[1] as i64, e[2] as i64));
        adj[e[1]].push((e[0] as i64, e[2] as i64));
    }
    let mut best = 0;
    let mut fewest = i64.MAX;
    for city in 0..n as i64 {
        let near = a1_reachable(adj, city, distance_threshold);
        if near <= fewest {
            fewest = near;
            best = city;
        }
    }
    best as i32
}

// ---- find_the_city_bellman.kara ----
fn a2_find_the_city(n: i32, edges: Vec[Vec[i32]], distance_threshold: i32) -> i32 {
    let n = n as i64;
    let mut best = -1;
    let mut fewest = n;
    for city in (0..n).rev() {
        let mut dist: Vec[i64] = Vec.filled(n, i64.MAX);
        dist[city] = 0;
        let mut changed = true;
        while changed {
            changed = false;
            for e in edges.iter() {
                let (a, b, w) = (e[0] as i64, e[1] as i64, e[2] as i64);
                if dist[a] != i64.MAX and dist[a] + w < dist[b] {
                    dist[b] = dist[a] + w;
                    changed = true;
                }
                if dist[b] != i64.MAX and dist[b] + w < dist[a] {
                    dist[a] = dist[b] + w;
                    changed = true;
                }
            }
        }
        let near = dist.iter().filter(|d| d <= distance_threshold).count() - 1;
        if best < 0 or near < fewest {
            fewest = near;
            best = city;
        }
    }
    best as i32
}

// ---- find_the_city_dense.kara ----
fn a3_find_the_city(n: i32, edges: Vec[Vec[i32]], distance_threshold: i32) -> i32 {
    let n = n as i64;
    let none = -1;
    let mut weight: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(n, none));
    for e in edges.iter() {
        weight[e[0]][e[1]] = e[2];
        weight[e[1]][e[0]] = e[2];
    }
    let mut best = 0;
    let mut fewest = n;
    for from in 0..n {
        let mut dist: Vec[i64] = Vec.filled(n, none);
        let mut done: Vec[bool] = Vec.filled(n, false);
        dist[from] = 0;
        loop {
            let mut pick = none;
            for c in 0..n {
                if not done[c] and dist[c] != none and (pick == none or dist[c] < dist[pick]) {
                    pick = c;
                }
            }
            if pick == none or dist[pick] > distance_threshold {
                break;
            }
            done[pick] = true;
            for c in 0..n {
                let w = weight[pick][c];
                if w != none and not done[c] and (dist[c] == none or dist[pick] + w < dist[c]) {
                    dist[c] = dist[pick] + w;
                }
            }
        }
        let near = done.iter().filter(|d| d).count() - 1;
        if near <= fewest {
            fewest = near;
            best = from;
        }
    }
    best as i32
}

// ---- find_the_city_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_find_the_city(n: i32, edges: Vec[Vec[i32]], distance_threshold: i32) -> i32 {
        let n = n as i64;
        let mut dist = Vec.filled(n, Vec.filled(n, i32.MAX / 2));
        for i in 0..n {
            dist[i][i] = 0;
        }
        for e in edges.iter() {
            let (u, v, w) = (e[0] as i64, e[1] as i64, e[2]);
            dist[u][v] = w;
            dist[v][u] = w;
        }
        for k in 0..n {
            for i in 0..n {
                for j in 0..n {
                    dist[i][j] = dist[i][j].min(dist[i][k] + dist[k][j]);
                }
            }
        }
        let mut ans = 0;
        let mut min_count = i64.MAX;
        for i in 0..n {
            let count = (0..n).filter(|j| j != i and dist[i][j] <= distance_threshold).count();
            if count <= min_count {
                min_count = count;
                ans = i as i32;
            }
        }
        ans
    }
}

fn a4_find_the_city(n: i32, edges: Vec[Vec[i32]], distance_threshold: i32) -> i32 {
    A4Solution.a4_find_the_city(n, edges, distance_threshold)
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the shortest distance from `at` to every city over the paths that visit
// no city twice, every such path walked
fn walk(n: i64, edges: Vec[Vec[i32]], at: i64, so_far: i64, seen: mut ref Vec[bool], best: mut ref Vec[i64]) {
    if best[at] < 0 or so_far < best[at] {
        best[at] = so_far;
    }
    for e in edges.iter() {
        for (a, b) in [(e[0] as i64, e[1] as i64), (e[1] as i64, e[0] as i64)] {
            if a == at and not seen[b] {
                seen[b] = true;
                walk(n, edges, b, so_far + e[2], mut seen, mut best);
                seen[b] = false;
            }
        }
    }
}

// the statement read literally: each city's count of others with some
// path of distance at most the threshold; the fewest, the greatest city
fn literal(n: i64, edges: Vec[Vec[i32]], threshold: i64) -> i32 {
    let mut answer = 0;
    let mut fewest = n + 1;
    for city in 0..n {
        let mut seen: Vec[bool] = Vec.filled(n, false);
        seen[city] = true;
        let mut best: Vec[i64] = Vec.filled(n, -1);
        walk(n, edges, city, 0, mut seen, mut best);
        let mut count = 0;
        for other in 0..n {
            if other != city and best[other] >= 0 and best[other] <= threshold {
                count += 1;
            }
        }
        if count < fewest or (count == fewest and city > answer) {
            fewest = count;
            answer = city;
        }
    }
    answer as i32
}

// the greatest city of a smallest group of cities joined by roads
fn smallest_group(n: i64, edges: Vec[Vec[i32]]) -> i32 {
    let mut group: Vec[i64] = (0..n).collect();
    let mut changed = true;
    while changed {
        changed = false;
        for e in edges.iter() {
            let low = min(group[e[0]], group[e[1]]);
            if group[e[0]] != low or group[e[1]] != low {
                group[e[0]] = low;
                group[e[1]] = low;
                changed = true;
            }
        }
    }
    let mut answer = 0;
    let mut fewest = n + 1;
    for city in 0..n {
        let size = group.iter().filter(|g| g == group[city]).count();
        if size <= fewest {
            fewest = size;
            answer = city;
        }
    }
    answer as i32
}

struct Case {
    n: i64,
    edges: Vec[Vec[i32]],
    threshold: i32,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, n: i64, edges: Vec[Vec[i32]], threshold: i32) -> i32 {
    match i {
        0 => a0_find_the_city(n as i32, edges, threshold),
        1 => a1_find_the_city(n as i32, edges, threshold),
        2 => a2_find_the_city(n as i32, edges, threshold),
        3 => a3_find_the_city(n as i32, edges, threshold),
        _ => a4_find_the_city(n as i32, edges, threshold),
    }
}

fn check_case(t: mut ref Tally, c: Case) {
    t.cases += 1;
    let n = c.n;
    let want = literal(n, c.edges, c.threshold);
    t.check = (t.check * 131 + want + n) % 1000000007;
    let turned: Vec[Vec[i32]] = c.edges.iter().rev().map(|e| [e[1], e[0], e[2]]).collect();
    let doubled: Vec[Vec[i32]] = c.edges.iter().map(|e| [e[0], e[1], 2 * e[2]]).collect();
    let mut total: i32 = 0;
    for e in c.edges.iter() {
        total += e[2];
    }
    let group = smallest_group(n, c.edges);
    // P5: a road too long to use, between the first two cities not joined
    let mut longer = c.edges.clone();
    let mut added = false;
    for a in 0..n {
        for b in a + 1..n {
            if not added and not c.edges.iter().any(|e| (e[0] == a and e[1] == b) or (e[0] == b and e[1] == a)) {
                longer.push([a as i32, b as i32, c.threshold + 1]);
                added = true;
            }
        }
    }
    let star = a0_find_the_city(n as i32, c.edges, c.threshold);
    for i in 0..5 {
        let got = arm(i, n, c.edges, c.threshold);
        let what = f"arm {i} on {n} {c.edges} {c.threshold}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: the roads listed backwards, each from its other end
        let tv = arm(i, n, turned, c.threshold);
        expect(mut t, 2, tv == got, f"P2 {what}, turned: {tv}");
        // P3: every weight and the threshold doubled: the same answer
        let db = arm(i, n, doubled, 2 * c.threshold);
        expect(mut t, 3, db == got, f"P3 {what}, doubled: {db}");
        // P4: the threshold every weight summed: the greatest city of a
        // smallest group joined by roads
        let all = arm(i, n, c.edges, total);
        expect(mut t, 4, all == group, f"P4 {what}, threshold {total}: {all}, group {group}");
        // P5: a road longer than the threshold added: the same answer
        let lg = arm(i, n, longer, c.threshold);
        expect(mut t, 5, lg == got, f"P5 {what}, a long road added: {lg}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 maps of 2 to 6 cities in four kinds, 500 each: each pair joined
    // with chance 1 in 3 and weights from 1 to 3; with chance 2 in 3 and
    // weights from 1 to 10; every weight 1; and weights up to 10^4. The
    // threshold runs from 0 to twice the heaviest weight. Every map is
    // drawn before any arm answers.
    let mut seed = 13341;
    let mut cases: Vec[Case] = Vec.new();
    for k in 0..2000 {
        let kind = k / 500;
        let n = 2 + next_random(mut seed) % 5;
        let percent = if kind == 1 { 67 } else { 33 + kind * 10 };
        let heaviest = if kind == 0 { 3 } else if kind == 1 { 10 } else if kind == 2 { 1 } else { 10000 };
        let mut edges: Vec[Vec[i32]] = Vec.new();
        for a in 0..n {
            for b in a + 1..n {
                if next_random(mut seed) % 100 < percent {
                    edges.push([a as i32, b as i32, (1 + next_random(mut seed) % heaviest) as i32]);
                }
            }
        }
        let threshold = (next_random(mut seed) % (2 * heaviest + 1)) as i32;
        cases.push(Case { n, edges, threshold });
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} maps: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
