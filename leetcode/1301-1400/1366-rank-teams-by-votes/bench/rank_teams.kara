// LeetCode #1366 bench -- the ★ arm: how many votes put each team in each
// place counted, and the teams sorted by those counts, then by letter.
fn rank_teams(votes: Vec[String]) -> String {
    let places = votes[0].len();
    let mut counts: Vec[Vec[i64]] = Vec.filled(26, Vec.filled(places, 0));
    for vote in votes.iter() {
        for (place, team) in vote.bytes().iter().enumerate() {
            counts[team - b'A'][place] += 1;
        }
    }
    let mut teams: Vec[u8] = votes[0].bytes().iter().collect();
    teams.sort_by(|a, b| counts[b - b'A'].cmp(counts[a - b'A']).then(a.cmp(b)));
    String.from_utf8(teams).unwrap()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 elections of 1000 votes over all 26 teams, the constraints' most,
    // built once; then 3000 rounds, each swapping two places of one vote,
    // all drawn from the checksum so far, ranking that election and
    // folding the ranking into the checksum
    let mut seed = 1366;
    let mut elections: Vec[Vec[String]] = Vec.new();
    for _ in 0..20 {
        let mut votes: Vec[String] = Vec.new();
        for _ in 0..1000 {
            let mut vote: Vec[u8] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".bytes().iter().collect();
            for i in 1..26 {
                let j = next_random(mut seed) % (i + 1);
                let held = vote[i];
                vote[i] = vote[j];
                vote[j] = held;
            }
            votes.push(String.from_utf8(vote).unwrap());
        }
        elections.push(votes);
    }
    let mut check: i64 = 0;
    for r in 0..3000 {
        let e = check % 20;
        let v = (check / 20) % 1000;
        let (i, j) = ((check / 20000) % 26, (check / 520000) % 26);
        let mut vote: Vec[u8] = elections[e][v].bytes().iter().collect();
        let held = vote[i];
        vote[i] = vote[j];
        vote[j] = held;
        elections[e][v] = String.from_utf8(vote).unwrap();
        let ranked = rank_teams(elections[e]);
        for b in ranked.bytes() {
            check = (check * 31 + b) % 1000000007;
        }
        check = (check + r) % 1000000007;
    }
    println(f"3000 rounds over 20 elections of 1000 votes: checksum {check}");
}
