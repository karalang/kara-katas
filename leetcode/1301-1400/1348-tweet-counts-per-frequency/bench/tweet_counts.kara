// LeetCode #1348: Tweet Counts Per Frequency -- the ★ arm: each name's
// times in the order they were recorded; a query makes one count per
// chunk and walks every time of the name, adding the ones in range to the
// chunk `(time - start) / size`. O(1) to record, O(k) to answer for k
// times of the name

fn chunk_size(freq: Str) -> i32 {
    match freq {
        "minute" => 60,
        "hour" => 3600,
        _ => 86400,
    }
}

struct TweetCounts {
    times: Map[String, Vec[i32]],
}

impl TweetCounts {
    fn new() -> TweetCounts {
        TweetCounts { times: Map.new() }
    }

    fn record_tweet(mut ref self, name: Str, time: i32) {
        if not self.times.contains_key(name) {
            self.times[name.to_string()] = Vec.new();
        }
        self.times[name].push(time);
    }

    fn get_tweet_counts_per_frequency(self, freq: Str, name: Str, start: i32, end: i32) -> Vec[i32] {
        let size = chunk_size(freq);
        let mut counts: Vec[i32] = Vec.filled((end - start) / size + 1, 0);
        if let Some(times) = self.times.get(name) {
            for t in times.iter() {
                if t >= start and t <= end {
                    counts[(t - start) / size] += 1;
                }
            }
        }
        counts
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 100,000 tweets under ten names at times up to 10^6, recorded once;
    // then 10,000 rounds, each recording one more tweet and asking one
    // query over the constraints' widest period, 10^4 seconds, the name,
    // time, start and frequency all drawn from the checksum so far
    let names = ["n0", "n1", "n2", "n3", "n4", "n5", "n6", "n7", "n8", "n9"];
    let freqs = ["minute", "hour", "day"];
    let mut seed = 1348;
    let mut tc = TweetCounts.new();
    for _ in 0..100000 {
        let name = ref names[next_random(mut seed) % 10];
        tc.record_tweet(name, (next_random(mut seed) % 1000001) as i32);
    }
    let mut check: i64 = 0;
    for r in 0..10000 {
        tc.record_tweet(names[check % 10], (check % 1000001) as i32);
        let start = (check / 11) % 990001;
        let counts = tc.get_tweet_counts_per_frequency(freqs[(check / 13) % 3], names[(check / 17) % 10], start as i32, (start + 10000) as i32);
        for n in counts.iter() {
            check = (check * 31 + n as i64) % 1000000007;
        }
        check = (check * 31 + r) % 1000000007;
    }
    println(f"10000 rounds over 100000 tweets: checksum {check}");
}
