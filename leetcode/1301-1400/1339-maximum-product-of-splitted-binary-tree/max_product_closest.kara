// LeetCode #1339: Maximum Product of Splitted Binary Tree -- the closest
// arm: s * (total - s) grows as s nears half the total, so every subtree's
// sum is gathered by one walk, and the sum nearest half the total is the
// cut; only that one product is made. O(n), as deep as the tree

fn sums(node: Option[TreeNode], out: mut ref Vec[i64]) -> i64 {
    let Some(n) = node else {
        return 0;
    };
    let s = n.val + sums(n.left, mut out) + sums(n.right, mut out);
    out.push(s);
    s
}

fn max_product(root: Option[TreeNode]) -> i32 {
    let mut all_sums: Vec[i64] = Vec.new();
    let all = sums(root, mut all_sums);
    // the distance of 2s from the total measures how far s is from half
    let mut nearest = all_sums[0];
    for s in all_sums.iter() {
        if (2 * s - all).abs() < (2 * nearest - all).abs() {
            nearest = s;
        }
    }
    (nearest * (all - nearest) % 1000000007) as i32
}

// ---- test harness ---------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// LeetCode's level-order list, `None` for a missing child
fn from_level(values: Vec[Option[i32]]) -> Option[TreeNode] {
    if values.len() == 0 or values[0].is_none() {
        return None;
    }
    let root = TreeNode { val: values[0].unwrap(), left: None, right: None };
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    queue.push_back(root);
    let mut i = 1;
    while i < values.len() {
        let Some(node) = queue.pop_front() else {
            break;
        };
        if let Some(v) = values[i] {
            let child = TreeNode { val: v, left: None, right: None };
            node.left = Some(child);
            queue.push_back(child);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let child = TreeNode { val: v, left: None, right: None };
                node.right = Some(child);
                queue.push_back(child);
            }
            i += 1;
        }
    }
    Some(root)
}

// n nodes with values from 1 to `top`, each hung on an empty child place of
// the tree so far chosen at random
fn random_tree(seed: mut ref i64, n: i64, top: i64) -> Option[TreeNode] {
    let root = TreeNode { val: (1 + next_random(mut seed) % top) as i32, left: None, right: None };
    let mut places: Vec[(TreeNode, bool)] = [(root, true), (root, false)];
    for _ in 1..n {
        let k = next_random(mut seed) % places.len();
        let (parent, left) = places.swap_remove(k);
        let node = TreeNode { val: (1 + next_random(mut seed) % top) as i32, left: None, right: None };
        if left {
            parent.left = Some(node);
        } else {
            parent.right = Some(node);
        }
        places.push((node, true));
        places.push((node, false));
    }
    Some(root)
}

fn main() {
    // LeetCode's two examples; two nodes; a chain of 5 * 10^4 nodes, the
    // constraints' most, each the right child of the one before, with
    // values up to 10^4; and a full tree of 2^15 - 1 nodes
    let e1 = max_product(from_level([Some(1), Some(2), Some(3), Some(4), Some(5), Some(6)]));
    let e2 = max_product(from_level([Some(1), None, Some(2), Some(3), Some(4), None, None, Some(5), Some(6)]));
    let two = max_product(from_level([Some(1), Some(2)]));
    let mut chain: Option[TreeNode] = None;
    for v in 0..50000 {
        chain = Some(TreeNode { val: (v * 7 % 10000 + 1) as i32, left: None, right: chain });
    }
    let full: Vec[Option[i32]] = (0..32767).map(|i| Some((i * 13 % 10000 + 1) as i32)).collect();
    println(f"{e1} {e2} {two} {max_product(chain)} {max_product(from_level(full))}");
    // 1000 random trees of 2 to 2000 nodes, most of them small, with values
    // up to 100 or up to 10^4
    let mut seed = 1339;
    let mut check = 0;
    for t in 0..1000 {
        let n = if t % 20 == 0 { 2 + next_random(mut seed) % 1999 } else { 2 + next_random(mut seed) % 30 };
        let top = if t % 2 == 0 { 100 } else { 10000 };
        check = (check * 131 + max_product(random_tree(mut seed, n, top))) % 1000000007;
    }
    println(f"1000 random trees: checksum {check}");
}
