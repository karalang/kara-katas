// LeetCode #1370: Increasing Decreasing String -- a Rust solution as
// LeetCode's Rust users write it, carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn sort_string(s: String) -> String {
        let mut cnt = [0; 26];
        for c in s.bytes() {
            cnt[(c - b'a') as usize] += 1;
        }
        let mut res = String.with_capacity(s.len());
        while res.len() < s.len() {
            for i in 0..26 {
                if cnt[i] > 0 {
                    res.push((b'a' + i as u8) as char);
                    cnt[i] -= 1;
                }
            }
            for i in (0..26).rev() {
                if cnt[i] > 0 {
                    res.push((b'a' + i as u8) as char);
                    cnt[i] -= 1;
                }
            }
        }
        res
    }
}

fn sort_string(s: String) -> String {
    Solution.sort_string(s)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's examples, and one letter seven times
    let shown: Vec[String] = ["aaaabbbbcccc", "rat", "leetcode", "ggggggg", "spo"].iter().map(|s| sort_string(s)).collect();
    println(shown.join(" "));
    // 2000 random strings of 1 to 500 letters, from the first 1 to 26
    // letters of the alphabet
    let mut seed = 1370;
    let mut check: i64 = 0;
    let mut same = 0;
    for _ in 0..2000 {
        let len = 1 + next_random(mut seed) % 500;
        let letters = 1 + next_random(mut seed) % 26;
        let mut s = String.new();
        for _ in 0..len {
            s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        let got = sort_string(s);
        if got == s {
            same += 1;
        }
        for b in got.bytes() {
            check = (check * 31 + b) % 1000000007;
        }
    }
    println(f"2000 random strings: {same} unchanged, checksum {check}");
}
