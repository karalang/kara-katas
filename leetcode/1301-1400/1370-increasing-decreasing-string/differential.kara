// LeetCode #1370: Increasing Decreasing String -- differential test of
// the five arms against the statement read literally, with five more
// properties.
//
// The statement: repeatedly pick the smallest letter left, then the
// smallest left greater than the last picked, until none is; then the
// largest left, then the largest left smaller than the last picked,
// until none is; and again from the smallest until every letter of s is
// picked. Return the letters in the order picked.

// ---- sort_string.kara ----
fn a0_sort_string(s: Str) -> String {
    let mut counts: Vec[i64] = Vec.filled(26, 0);
    for b in s.bytes() {
        counts[b - b'a'] += 1;
    }
    let mut out = String.new();
    let mut left = s.len();
    while left > 0 {
        for i in 0..26 {
            if counts[i] > 0 {
                out.push((b'a' + i as u8) as char);
                counts[i] -= 1;
                left -= 1;
            }
        }
        for i in (0..26).rev() {
            if counts[i] > 0 {
                out.push((b'a' + i as u8) as char);
                counts[i] -= 1;
                left -= 1;
            }
        }
    }
    out
}

// ---- sort_string_sorted.kara ----
fn a1_sort_string(s: Str) -> String {
    let mut letters: Vec[char] = s.chars().collect();
    letters.sort();
    let n = letters.len();
    let mut used: Vec[bool] = Vec.filled(n, false);
    let mut out = String.new();
    let mut taken = 0;
    while taken < n {
        // forward: the first unused copy of each letter, smallest first
        let mut last = ' ';
        for i in 0..n {
            if not used[i] and letters[i] != last {
                used[i] = true;
                out.push(letters[i]);
                last = letters[i];
                taken += 1;
            }
        }
        // backward: the same, largest first
        last = ' ';
        for i in (0..n).rev() {
            if not used[i] and letters[i] != last {
                used[i] = true;
                out.push(letters[i]);
                last = letters[i];
                taken += 1;
            }
        }
    }
    out
}

// ---- sort_string_map.kara ----
fn a2_sort_string(s: Str) -> String {
    let mut counts: SortedMap[char, i64] = SortedMap.new();
    for c in s.chars() {
        *counts.entry(c).or_insert(0) += 1;
    }
    let mut out = String.new();
    let mut up = true;
    while not counts.is_empty() {
        let mut keys: Vec[char] = counts.keys().collect();
        if not up {
            keys.reverse();
        }
        for c in keys {
            out.push(c);
            let left = counts[c] - 1;
            if left == 0 {
                counts.remove(c);
            } else {
                counts.insert(c, left);
            }
        }
        up = not up;
    }
    out
}

// ---- sort_string_bounce.kara ----
fn a3_sort_string(s: Str) -> String {
    let mut counts: Vec[i64] = Vec.filled(26, 0);
    for b in s.bytes() {
        counts[b - b'a'] += 1;
    }
    let mut out: Vec[u8] = Vec.new();
    let mut at = 0;
    let mut step = 1;
    while out.len() < s.len() {
        if counts[at] > 0 {
            out.push(b'a' + at as u8);
            counts[at] -= 1;
        }
        if at + step < 0 or at + step > 25 {
            // the end: the same letter starts the walk back
            step = -step;
        } else {
            at += step;
        }
    }
    String.from_utf8(out).unwrap()
}

// ---- sort_string_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_sort_string(s: String) -> String {
        let mut cnt = [0; 26];
        for c in s.bytes() {
            cnt[(c - b'a') as usize] += 1;
        }
        let mut res = String.with_capacity(s.len());
        while res.len() < s.len() {
            for i in 0..26 {
                if cnt[i] > 0 {
                    res.push((b'a' + i as u8) as char);
                    cnt[i] -= 1;
                }
            }
            for i in (0..26).rev() {
                if cnt[i] > 0 {
                    res.push((b'a' + i as u8) as char);
                    cnt[i] -= 1;
                }
            }
        }
        res
    }
}

fn a4_sort_string(s: String) -> String {
    A4Solution.a4_sort_string(s)
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: the letters left in a list, and each
// step scanning it for the letter the step names, taking it out
fn literal(s: Str) -> String {
    let mut left: Vec[char] = s.chars().collect();
    let mut out = String.new();
    while left.len() > 0 {
        // steps 1 to 3: the smallest, then the smallest greater than the
        // last, while there is one
        let mut last: Option[char] = None;
        loop {
            let mut pick: Option[i64] = None;
            for i in 0..left.len() {
                let fits = match last {
                    Some(l) => left[i] > l,
                    None => true,
                };
                if fits and (pick.is_none() or left[i] < left[pick.unwrap()]) {
                    pick = Some(i);
                }
            }
            let Some(i) = pick else {
                break;
            };
            last = Some(left[i]);
            out.push(left.remove(i));
        }
        // steps 4 to 6: the largest, then the largest smaller than the
        // last, while there is one
        last = None;
        loop {
            let mut pick: Option[i64] = None;
            for i in 0..left.len() {
                let fits = match last {
                    Some(l) => left[i] < l,
                    None => true,
                };
                if fits and (pick.is_none() or left[i] > left[pick.unwrap()]) {
                    pick = Some(i);
                }
            }
            let Some(i) = pick else {
                break;
            };
            last = Some(left[i]);
            out.push(left.remove(i));
        }
    }
    out
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, s: Str) -> String {
    match i {
        0 => a0_sort_string(s),
        1 => a1_sort_string(s),
        2 => a2_sort_string(s),
        3 => a3_sort_string(s),
        _ => a4_sort_string(s.to_string()),
    }
}

fn sorted_letters(s: Str) -> Vec[char] {
    let mut letters: Vec[char] = s.chars().collect();
    letters.sort();
    letters
}

// every letter moved up by `by` places in the alphabet
fn shifted(s: Str, by: i64) -> String {
    s.chars().map(|c| (c as u32 + by) as u32 as u8 as char).collect()
}

fn check_case(t: mut ref Tally, s: Str) {
    t.cases += 1;
    let want = literal(s);
    for b in want.bytes() {
        t.check = (t.check * 31 + b) % 1000000007;
    }
    t.check = (t.check * 131 + s.len()) % 1000000007;
    let reversed: String = s.chars().rev().collect();
    let mut distinct = sorted_letters(s);
    distinct.dedup();
    let first: String = distinct.iter().collect();
    // move every letter as far up the alphabet as the largest allows
    let top = sorted_letters(s).last().unwrap() as u32 as i64;
    let by = b'z' - top;
    let star = arm(0, s);
    for i in 0..5 {
        let got = arm(i, s);
        let what = f"arm {i} at {s}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: the same letters, each as often
        expect(mut t, 2, sorted_letters(got) == sorted_letters(s), f"P2 {what}: {got} not a rearrangement");
        // P3: the string reversed, the same answer
        expect(mut t, 3, arm(i, reversed) == got, f"P3 {what}, reversed");
        // P4: the answer begins with every distinct letter once, in order
        expect(mut t, 4, got.starts_with(first), f"P4 {what}: {got} does not begin {first}");
        // P5: every letter moved up the alphabet alike, the answer moved
        expect(mut t, 5, arm(i, shifted(s, by)) == shifted(got, by), f"P5 {what}, moved up {by}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // LeetCode's examples and one letter seven times; then 1500 random
    // strings of 1 to 20 letters and 500 of 1 to 200, from the first 1 to
    // 26 letters of the alphabet
    for s in ["aaaabbbbcccc", "rat", "leetcode", "ggggggg", "spo"] {
        check_case(mut t, s);
    }
    let mut seed = 1370;
    for k in 0..2000 {
        let len = 1 + next_random(mut seed) % if k < 1500 { 20 } else { 200 };
        let letters = 1 + next_random(mut seed) % 26;
        let mut s = String.new();
        for _ in 0..len {
            s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        check_case(mut t, s);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
