// LeetCode #1370: Increasing Decreasing String -- the bounce arm: the
// letters counted as bytes; one index runs up the 26 letters and back
// down, turning at each end, taking a letter each time it lands on one
// that is left, and the result built as bytes. O(n + 26 r)
fn sort_string(s: Str) -> String {
    let mut counts: Vec[i64] = Vec.filled(26, 0);
    for b in s.bytes() {
        counts[b - b'a'] += 1;
    }
    let mut out: Vec[u8] = Vec.new();
    let mut at = 0;
    let mut step = 1;
    while out.len() < s.len() {
        if counts[at] > 0 {
            out.push(b'a' + at as u8);
            counts[at] -= 1;
        }
        if at + step < 0 or at + step > 25 {
            // the end: the same letter starts the walk back
            step = -step;
        } else {
            at += step;
        }
    }
    String.from_utf8(out).unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's examples, and one letter seven times
    let shown: Vec[String] = ["aaaabbbbcccc", "rat", "leetcode", "ggggggg", "spo"].iter().map(|s| sort_string(s)).collect();
    println(shown.join(" "));
    // 2000 random strings of 1 to 500 letters, from the first 1 to 26
    // letters of the alphabet
    let mut seed = 1370;
    let mut check: i64 = 0;
    let mut same = 0;
    for _ in 0..2000 {
        let len = 1 + next_random(mut seed) % 500;
        let letters = 1 + next_random(mut seed) % 26;
        let mut s = String.new();
        for _ in 0..len {
            s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        let got = sort_string(s);
        if got == s {
            same += 1;
        }
        for b in got.bytes() {
            check = (check * 31 + b) % 1000000007;
        }
    }
    println(f"2000 random strings: {same} unchanged, checksum {check}");
}
