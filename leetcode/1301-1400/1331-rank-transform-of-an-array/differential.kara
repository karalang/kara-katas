// LeetCode #1331: Rank Transform of an Array -- differential test of the
// five arms against the statement read literally, with five more
// properties.
//
// The statement: given an array of integers arr, replace each element
// with its rank. The rank represents how large the element is: it is an
// integer starting from 1; the larger the element, the larger the rank;
// if two elements are equal, their rank must be the same; and the rank
// should be as small as possible.

// ---- array_rank_transform.kara ----
fn a0_array_rank_transform(arr: Vec[i32]) -> Vec[i32] {
    let mut distinct = arr.clone();
    distinct.sort();
    distinct.dedup();
    arr.iter().map(|x| (distinct.binary_search(x).unwrap() + 1) as i32).collect()
}

// ---- array_rank_transform_map.kara ----
fn a1_array_rank_transform(arr: Vec[i32]) -> Vec[i32] {
    let mut sorted = arr.clone();
    sorted.sort();
    let mut rank: Map[i32, i32] = Map.new();
    for x in sorted.iter() {
        if not rank.contains_key(x) {
            let next = rank.len() as i32 + 1;
            rank.insert(x, next);
        }
    }
    arr.iter().map(|x| rank[x]).collect()
}

// ---- array_rank_transform_order.kara ----
fn a2_array_rank_transform(arr: Vec[i32]) -> Vec[i32] {
    let mut order: Vec[i64] = (0..arr.len()).collect();
    order.sort_by_key(|i| arr[i]);
    let mut ranks: Vec[i32] = Vec.filled(arr.len(), 0);
    let mut rank = 0;
    for (k, i) in order.iter().enumerate() {
        if k == 0 or arr[i] != arr[order[k - 1]] {
            rank += 1;
        }
        ranks[i] = rank;
    }
    ranks
}

// ---- array_rank_transform_tree.kara ----
fn a3_array_rank_transform(arr: Vec[i32]) -> Vec[i32] {
    let values: SortedSet[i32] = arr.iter().cloned().collect();
    let mut rank: SortedMap[i32, i32] = SortedMap.new();
    for (i, v) in values.iter().enumerate() {
        rank.insert(v, i as i32 + 1);
    }
    arr.iter().map(|x| rank[x]).collect()
}

// ---- array_rank_transform_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_array_rank_transform(arr: Vec[i32]) -> Vec[i32] {
        let mut sorted = arr.clone();
        sorted.sort();
        sorted.dedup();
        let rank: Map[i32, i32] = sorted
            .iter()
            .enumerate()
            .map(|(i, x)| (x, i as i32 + 1))
            .collect();
        arr.iter().map(|x| rank[x]).collect()
    }
}

fn a4_array_rank_transform(arr: Vec[i32]) -> Vec[i32] {
    A4Solution.a4_array_rank_transform(arr)
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: as small as the rules allow, a value's
// rank is 1 more than the number of different values below it
fn literal(arr: Vec[i32]) -> Vec[i32] {
    let mut out: Vec[i32] = Vec.new();
    for x in arr.iter() {
        let mut below: Vec[i32] = Vec.new();
        for y in arr.iter() {
            if y < x and not below.contains(y) {
                below.push(y);
            }
        }
        out.push(below.len() as i32 + 1);
    }
    out
}

struct Case {
    arr: Vec[i32],
    // P3: the amount every value is moved by
    shift: i32,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, arr: Vec[i32]) -> Vec[i32] {
    match i {
        0 => a0_array_rank_transform(arr),
        1 => a1_array_rank_transform(arr),
        2 => a2_array_rank_transform(arr),
        3 => a3_array_rank_transform(arr),
        _ => a4_array_rank_transform(arr),
    }
}

fn check_case(t: mut ref Tally, c: Case) {
    t.cases += 1;
    let want = literal(c.arr);
    for r in want.iter() {
        t.check = (t.check * 131 + r) % 1000000007;
    }
    t.check = (t.check * 131 + 7) % 1000000007;
    let reversed: Vec[i32] = c.arr.iter().rev().cloned().collect();
    let shifted: Vec[i32] = c.arr.iter().map(|x| x + c.shift).collect();
    let negated: Vec[i32] = c.arr.iter().map(|x| -x).collect();
    let mut twice = c.arr.clone();
    twice.extend(c.arr.iter());
    let star = a0_array_rank_transform(c.arr);
    for i in 0..5 {
        let got = arm(i, c.arr);
        let what = f"arm {i} case {t.cases} {c.arr}: got {got}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}, literal {want}");
        // P2: the array read backwards: the ranks backwards
        let rv = arm(i, reversed);
        let back: Vec[i32] = got.iter().rev().cloned().collect();
        expect(mut t, 2, rv == back, f"P2 {what}, backwards: {rv}");
        // P3: every value moved by one amount: the same ranks
        let sh = arm(i, shifted);
        expect(mut t, 3, sh == got, f"P3 {what}, moved by {c.shift}: {sh}");
        // P4: every value negated: the ranks turned over, the highest
        // becoming 1
        let ng = arm(i, negated);
        let top = got.iter().cloned().max().unwrap_or(0);
        let over: Vec[i32] = got.iter().map(|r| top + 1 - r).collect();
        expect(mut t, 4, ng == over, f"P4 {what}, negated: {ng}");
        // P5: the array twice over: its ranks twice over
        let tw = arm(i, twice);
        let mut both = got.clone();
        both.extend(got.iter());
        expect(mut t, 5, tw == both, f"P5 {what}, twice: {tw}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 arrays of 0 to 8 values in four kinds, 500 each: values from 0
    // to 2; within 5 of 0; each one of -10^9, -1, 0, 1 or 10^9; and rising
    // by 1 to 3 from a start within 50. Every array and the amount it is
    // moved by are drawn before any arm answers.
    let ends = [-1000000000, -1, 0, 1, 1000000000];
    let mut seed = 13311;
    let mut cases: Vec[Case] = Vec.new();
    for c in 0..2000 {
        let kind = c / 500;
        let n = next_random(mut seed) % 9;
        let mut v = next_random(mut seed) % 101 - 50;
        let mut arr: Vec[i32] = Vec.new();
        for _ in 0..n {
            let x = if kind == 0 {
                next_random(mut seed) % 3
            } else if kind == 1 {
                next_random(mut seed) % 11 - 5
            } else if kind == 2 {
                ends[next_random(mut seed) % 5]
            } else {
                v += 1 + next_random(mut seed) % 3;
                v
            };
            arr.push(x as i32);
        }
        let shift = (next_random(mut seed) % 2001 - 1000) as i32;
        cases.push(Case { arr, shift });
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} arrays: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
