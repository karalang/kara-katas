// LeetCode #1331: Rank Transform of an Array -- a Rust solution as
// LeetCode's Rust users write it (`sort_unstable()` and `dedup()` on a
// clone, a `HashMap<i32, i32>` collected from `enumerate()` with the
// pattern `|(i, &x)|`, and every value looked up as `rank[x]`), carried to
// Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn array_rank_transform(arr: Vec[i32]) -> Vec[i32] {
        let mut sorted = arr.clone();
        sorted.sort();
        sorted.dedup();
        let rank: Map[i32, i32] = sorted
            .iter()
            .enumerate()
            .map(|(i, x)| (x, i as i32 + 1))
            .collect();
        arr.iter().map(|x| rank[x]).collect()
    }
}

fn array_rank_transform(arr: Vec[i32]) -> Vec[i32] {
    Solution.array_rank_transform(arr)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn fold(check: i64, ranks: Vec[i32]) -> i64 {
    let mut c = check;
    for r in ranks.iter() {
        c = (c * 131 + r) % 1000000007;
    }
    (c * 131 + 7) % 1000000007
}

fn main() {
    // LeetCode's three examples; no values; the constraints' extremes; and
    // 10^5 values, the constraints' longest, counting down in pairs
    println(f"{array_rank_transform([40, 10, 20, 30])} {array_rank_transform([100, 100, 100])} {array_rank_transform([37, 12, 28, 9, 100, 56, 80, 5, 12])}");
    let none: Vec[i32] = Vec.new();
    println(f"{array_rank_transform(none)} {array_rank_transform([1000000000, -1000000000, 0, -1000000000])}");
    let mut long: Vec[i32] = Vec.new();
    for i in 0..100000 {
        long.push((50000 - i / 2) as i32);
    }
    let ranks = array_rank_transform(long);
    println(f"10^5 values: first {ranks[0]}, last {ranks[99999]}, checksum {fold(0, ranks)}");
    // 600 random arrays of 0 to 3000 values, most of them short, from 3,
    // 1000 or 2 * 10^9 + 1 possible values
    let mut seed = 1331;
    let mut check = 0;
    let mut most = 0;
    for t in 0..600 {
        let n = if t % 10 == 0 { next_random(mut seed) % 3001 } else { next_random(mut seed) % 13 };
        let mut arr: Vec[i32] = Vec.new();
        for _ in 0..n {
            let v = if t % 3 == 0 {
                next_random(mut seed) % 3
            } else if t % 3 == 1 {
                next_random(mut seed) % 1000 - 500
            } else {
                (next_random(mut seed) * 61036 + next_random(mut seed)) % 2000000001 - 1000000000
            };
            arr.push(v as i32);
        }
        let ranks = array_rank_transform(arr);
        for r in ranks.iter() {
            most = max(most, r);
        }
        check = fold(check, ranks);
    }
    println(f"600 random arrays: highest rank {most}, checksum {check}");
}
