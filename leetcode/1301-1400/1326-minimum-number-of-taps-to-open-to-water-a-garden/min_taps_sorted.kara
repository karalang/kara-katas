// LeetCode #1326: Minimum Number of Taps to Open to Water a Garden -- the
// sorted arm: every open tap as the stretch it waters, sorted by its left
// end; then the classic cover of a line by intervals, each step taking,
// among the stretches that start inside what is already watered, the one
// that reaches farthest. O(n log n)

fn min_taps(n: i32, ranges: Vec[i32]) -> i32 {
    let mut spans: Vec[(i32, i32)] = Vec.new();
    for i in 0..ranges.len() {
        let r = ranges[i];
        if r > 0 {
            let at = i as i32;
            spans.push(((at - r).max(0), (at + r).min(n)));
        }
    }
    spans.sort();
    let mut taps = 0;
    let mut watered = 0;
    let mut k = 0;
    while watered < n {
        let mut best = watered;
        while k < spans.len() and spans[k].0 <= watered {
            best = best.max(spans[k].1);
            k += 1;
        }
        if best == watered {
            return -1;
        }
        taps += 1;
        watered = best;
    }
    taps
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; three more with an answer of 3, 2 and 1; a
    // garden of 10^4, the constraints' longest, with every tap shut, and
    // with every tap reaching 1 either way; and only the middle tap open,
    // reaching 100 either way, which waters a garden of 200 but not 201
    let shut: Vec[i32] = Vec.filled(10001, 0);
    let ones: Vec[i32] = Vec.filled(10001, 1);
    let mut middle: Vec[i32] = Vec.filled(201, 0);
    middle[100] = 100;
    let mut short = middle.clone();
    short.push(0);
    println(f"{min_taps(5, [3, 4, 1, 1, 0, 0])} {min_taps(3, [0, 0, 0, 0])} {min_taps(7, [1, 2, 1, 0, 2, 1, 0, 1])} {min_taps(8, [4, 0, 0, 0, 0, 0, 0, 0, 4])} {min_taps(8, [4, 0, 0, 0, 4, 0, 0, 0, 4])} {min_taps(10000, shut)} {min_taps(10000, ones)} {min_taps(200, middle)} {min_taps(201, short)}");
    // 600 random gardens of 1 to 10^4, most of them short, each tap shut
    // or reaching up to 3, 10 or 100 either way, open one time in 1, 3 or
    // 20
    let mut seed = 1326;
    let mut total = 0;
    let mut check = 0;
    for t in 0..600 {
        let n = if t % 6 == 0 { 1 + next_random(mut seed) % 10000 } else { 1 + next_random(mut seed) % 60 };
        let reach = if t % 3 == 0 { 3 } else if t % 3 == 1 { 10 } else { 100 };
        let open = if t % 4 == 0 { 1 } else if t % 4 == 1 { 3 } else { 20 };
        let mut ranges: Vec[i32] = Vec.new();
        for _ in 0..n + 1 {
            let r = if next_random(mut seed) % open == 0 { 1 + next_random(mut seed) % reach } else { 0 };
            ranges.push(r as i32);
        }
        let got = min_taps(n as i32, ranges) as i64;
        total += got;
        check = (check * 131 + got + 1) % 1000000007;
    }
    println(f"600 random gardens: taps total {total}, checksum {check}");
}
