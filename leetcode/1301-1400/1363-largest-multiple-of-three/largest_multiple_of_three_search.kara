// LeetCode #1363: Largest Multiple of Three -- the search arm: digits of
// residue 0 are always kept, and of the c1 digits of residue 1 and c2 of
// residue 2 a multiple of three keeps k1 and k2 with k1 ≡ k2 (mod 3);
// dropping three of one residue never helps, so k1 and k2 are tried from
// each count down by at most 2, the smallest dropped, and the longest
// answer kept, the largest of equal length. O(n)
fn build(count: Vec[i64]) -> String {
    let mut out = String.new();
    let mut d = 9;
    while d >= 0 {
        for _ in 0..count[d] {
            out += d.to_string();
        }
        d -= 1;
    }
    if out.starts_with("0") {
        return "0".to_string();
    }
    out
}

// the count with the smallest `drop` digits of residue `r` taken out
fn without(count: Vec[i64], r: i64, drop: i64) -> Vec[i64] {
    let mut left = count.clone();
    let mut need = drop;
    for d in [r, r + 3, r + 6] {
        while need > 0 and left[d] > 0 {
            left[d] -= 1;
            need -= 1;
        }
    }
    left
}

fn largest_multiple_of_three(digits: Vec[i32]) -> String {
    let mut count: Vec[i64] = Vec.filled(10, 0);
    for d in digits.iter() {
        count[d] += 1;
    }
    let c1 = count[1] + count[4] + count[7];
    let c2 = count[2] + count[5] + count[8];
    let mut best = String.new();
    for drop1 in 0..3 {
        for drop2 in 0..3 {
            if drop1 > c1 or drop2 > c2 or (c1 - drop1) % 3 != (c2 - drop2) % 3 {
                continue;
            }
            let answer = build(without(without(count, 1, drop1), 2, drop2));
            if answer.len() > best.len() or (answer.len() == best.len() and answer > best) {
                best = answer;
            }
        }
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a string's length and its digits folded into a checksum
fn fold(check: i64, s: Str) -> i64 {
    let mut c = (check * 131 + s.len()) % 1000000007;
    for b in s.bytes() {
        c = (c * 31 + b) % 1000000007;
    }
    c
}

fn main() {
    // LeetCode's three examples; all zeros; one digit kept of two; two
    // removed of residue 2 when no 1 is there
    let cases: Vec[Vec[i32]] = [[8, 1, 9], [8, 6, 7, 1, 0], [1], [0, 0, 0, 0, 0, 0], [2, 2], [5, 8, 9]];
    let shown: Vec[String] = cases.iter().map(|digits| f"\"{largest_multiple_of_three(digits)}\"").collect();
    println(shown.join(" "));
    // 10^4 digits, the constraints' most, and 2000 random arrays of up to
    // 30, each answer folded into a checksum
    let mut seed = 1363;
    let mut long: Vec[i32] = Vec.new();
    for _ in 0..10000 {
        long.push((next_random(mut seed) % 10) as i32);
    }
    let answer = largest_multiple_of_three(long);
    println(f"10^4 digits: {answer.len()} kept, checksum {fold(0, answer)}");
    let mut check: i64 = 0;
    let mut empty = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 30;
        let mut digits: Vec[i32] = Vec.new();
        for _ in 0..n {
            digits.push((next_random(mut seed) % 10) as i32);
        }
        let answer = largest_multiple_of_three(digits);
        if answer.is_empty() {
            empty += 1;
        }
        check = fold(check, answer);
    }
    println(f"2000 random arrays: {empty} with none, checksum {check}");
}
