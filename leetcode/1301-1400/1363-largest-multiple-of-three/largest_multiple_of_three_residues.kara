// LeetCode #1363: Largest Multiple of Three -- the residues arm: the
// digits sorted from largest down and dealt into three lists by residue
// mod 3, each list then ending at its smallest; the sum's residue r put
// right by popping the last of list r, or failing that two from list
// 3 - r; the three lists merged back, largest first. O(n log n)
fn largest_multiple_of_three(digits: Vec[i32]) -> String {
    let mut sorted = digits.clone();
    sorted.sort_by(|a, b| b.cmp(a));
    let mut lists: Vec[Vec[i32]] = [Vec.new(), Vec.new(), Vec.new()];
    let mut sum = 0;
    for d in sorted {
        lists[d % 3].push(d);
        sum += d;
    }
    let r = sum % 3;
    if r != 0 {
        if lists[r].len() > 0 {
            lists[r].pop();
        } else {
            lists[3 - r].pop();
            lists[3 - r].pop();
        }
    }
    let mut kept: Vec[i32] = Vec.new();
    for list in lists {
        kept.extend(list);
    }
    kept.sort_by(|a, b| b.cmp(a));
    if kept.len() > 0 and kept[0] == 0 {
        return "0".to_string();
    }
    Vec[String].from_iter(kept.iter().map(|d| d.to_string())).join("")
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a string's length and its digits folded into a checksum
fn fold(check: i64, s: Str) -> i64 {
    let mut c = (check * 131 + s.len()) % 1000000007;
    for b in s.bytes() {
        c = (c * 31 + b) % 1000000007;
    }
    c
}

fn main() {
    // LeetCode's three examples; all zeros; one digit kept of two; two
    // removed of residue 2 when no 1 is there
    let cases: Vec[Vec[i32]] = [[8, 1, 9], [8, 6, 7, 1, 0], [1], [0, 0, 0, 0, 0, 0], [2, 2], [5, 8, 9]];
    let shown: Vec[String] = cases.iter().map(|digits| f"\"{largest_multiple_of_three(digits)}\"").collect();
    println(shown.join(" "));
    // 10^4 digits, the constraints' most, and 2000 random arrays of up to
    // 30, each answer folded into a checksum
    let mut seed = 1363;
    let mut long: Vec[i32] = Vec.new();
    for _ in 0..10000 {
        long.push((next_random(mut seed) % 10) as i32);
    }
    let answer = largest_multiple_of_three(long);
    println(f"10^4 digits: {answer.len()} kept, checksum {fold(0, answer)}");
    let mut check: i64 = 0;
    let mut empty = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 30;
        let mut digits: Vec[i32] = Vec.new();
        for _ in 0..n {
            digits.push((next_random(mut seed) % 10) as i32);
        }
        let answer = largest_multiple_of_three(digits);
        if answer.is_empty() {
            empty += 1;
        }
        check = fold(check, answer);
    }
    println(f"2000 random arrays: {empty} with none, checksum {check}");
}
