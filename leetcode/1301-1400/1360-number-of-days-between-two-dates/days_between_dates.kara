// LeetCode #1360: Number of Days Between Two Dates -- the ★ arm: each date
// as its count of days from 1971-01-01, the years before it and the
// months before it in its year added up, a leap year being one divisible
// by 4 but not by 100, or by 400; the answer is the two counts' distance.
// O(Y) for Y years
fn is_leap(year: i64) -> bool {
    (year % 4 == 0 and year % 100 != 0) or year % 400 == 0
}

fn days_from_1971(date: Str) -> i64 {
    let year = i64.parse(date[0..4]).unwrap();
    let month = i64.parse(date[5..7]).unwrap();
    let day = i64.parse(date[8..10]).unwrap();
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let mut days = day - 1;
    for y in 1971..year {
        days += if is_leap(y) { 366 } else { 365 };
    }
    for m in 1..month {
        days += lengths[m - 1];
        if m == 2 and is_leap(year) {
            days += 1;
        }
    }
    days
}

fn days_between_dates(date1: Str, date2: Str) -> i32 {
    (days_from_1971(date1) - days_from_1971(date2)).abs() as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a valid date from 1971 to 2100, written YYYY-MM-DD
fn random_date(seed: mut ref i64) -> String {
    let year = 1971 + next_random(mut seed) % 130;
    let month = 1 + next_random(mut seed) % 12;
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let mut last = lengths[month - 1];
    if month == 2 and ((year % 4 == 0 and year % 100 != 0) or year % 400 == 0) {
        last += 1;
    }
    let day = 1 + next_random(mut seed) % last;
    f"{year}-{month:02}-{day:02}"
}

fn main() {
    // LeetCode's two examples; the same date; the range's two ends; across
    // the leap day of 2000, divisible by 400; and across the end of
    // February 2100, divisible by 100 and not a leap year
    let e1 = days_between_dates("2019-06-29", "2019-06-30");
    let e2 = days_between_dates("2020-01-15", "2019-12-31");
    let same = days_between_dates("1999-12-31", "1999-12-31");
    let ends = days_between_dates("2100-12-31", "1971-01-01");
    let leap = days_between_dates("2000-02-28", "2000-03-01");
    let plain = days_between_dates("2100-02-28", "2100-03-01");
    println(f"{e1} {e2} {same} {ends} {leap} {plain}");
    // 2000 random pairs of dates, folded into a checksum
    let mut seed = 1360;
    let mut total: i64 = 0;
    let mut check: i64 = 0;
    for _ in 0..2000 {
        let a = random_date(mut seed);
        let b = random_date(mut seed);
        let got = days_between_dates(a, b);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random pairs: {total} days in all, checksum {check}");
}
