// LeetCode #1382: Balance a Binary Search Tree -- differential test of
// the five arms against the statement read literally, with five more
// properties.

// ---- balance_bst.kara ----
fn a0_values_in_order(node: Option[TreeNode], values: mut ref Vec[i32]) {
    if let Some(n) = node {
        a0_values_in_order(n.left, mut values);
        values.push(n.val);
        a0_values_in_order(n.right, mut values);
    }
}

// the values from `lo` up to but not including `hi`, as a balanced tree
fn a0_build(values: Vec[i32], lo: i64, hi: i64) -> Option[TreeNode] {
    if lo >= hi {
        return None;
    }
    let mid = (lo + hi) / 2;
    Some(TreeNode { val: values[mid], left: a0_build(values, lo, mid), right: a0_build(values, mid + 1, hi) })
}

fn a0_balance_bst(root: TreeNode) -> TreeNode {
    let mut values: Vec[i32] = Vec.new();
    a0_values_in_order(Some(root), mut values);
    a0_build(values, 0, values.len()).unwrap()
}

// ---- balance_bst_relink.kara ----
fn a1_link(nodes: Vec[TreeNode], lo: i64, hi: i64) -> Option[TreeNode] {
    if lo >= hi {
        return None;
    }
    let mid = (lo + hi) / 2;
    let node = nodes[mid];
    node.left = a1_link(nodes, lo, mid);
    node.right = a1_link(nodes, mid + 1, hi);
    Some(node)
}

fn a1_balance_bst(root: TreeNode) -> TreeNode {
    let mut nodes: Vec[TreeNode] = Vec.new();
    let mut stack: Vec[TreeNode] = Vec.new();
    let mut at = Some(root);
    while at.is_some() or not stack.is_empty() {
        while let Some(node) = at {
            stack.push(node);
            at = node.left;
        }
        let node = stack.pop().unwrap();
        nodes.push(node);
        at = node.right;
    }
    a1_link(nodes, 0, nodes.len()).unwrap()
}

// ---- balance_bst_dsw.kara ----
fn a2_to_vine(above: TreeNode) -> i64 {
    let mut tail = above;
    let mut rest = tail.right;
    let mut count = 0;
    while let Some(node) = rest {
        if let Some(l) = node.left {
            // rotate right: the left child takes the node's place
            node.left = l.right;
            l.right = Some(node);
            tail.right = Some(l);
            rest = Some(l);
        } else {
            count += 1;
            tail = node;
            rest = node.right;
        }
    }
    count
}

// `times` left rotations down the vine under `above`, of every other
// node
fn a2_compress(above: TreeNode, times: i64) {
    let mut scanner = above;
    for _ in 0..times {
        let child = scanner.right.unwrap();
        let next = child.right.unwrap();
        scanner.right = Some(next);
        child.right = next.left;
        next.left = Some(child);
        scanner = next;
    }
}

fn a2_balance_bst(root: TreeNode) -> TreeNode {
    let above = TreeNode { val: 0, left: None, right: Some(root) };
    let n = a2_to_vine(above);
    // the greatest count one less than a power of two, at most n
    let mut m = 1;
    while m * 2 + 1 <= n {
        m = m * 2 + 1;
    }
    a2_compress(above, n - m);
    while m > 1 {
        m /= 2;
        a2_compress(above, m);
    }
    above.right.unwrap()
}

// ---- balance_bst_avl.kara ----
shared struct A3Avl {
    val: i32,
    mut height: i64,
    mut left: Option[A3Avl],
    mut right: Option[A3Avl],
}

fn a3_height(node: Option[A3Avl]) -> i64 {
    match node {
        Some(n) => n.height,
        None => 0,
    }
}

fn a3_update(node: A3Avl) {
    node.height = 1 + a3_height(node.left).max(a3_height(node.right));
}

fn a3_rotate_left(node: A3Avl) -> A3Avl {
    let r = node.right.unwrap();
    node.right = r.left;
    r.left = Some(node);
    a3_update(node);
    a3_update(r);
    r
}

fn a3_rotate_right(node: A3Avl) -> A3Avl {
    let l = node.left.unwrap();
    node.left = l.right;
    l.right = Some(node);
    a3_update(node);
    a3_update(l);
    l
}

fn a3_insert(node: Option[A3Avl], val: i32) -> A3Avl {
    let Some(n) = node else {
        return A3Avl { val, height: 1, left: None, right: None };
    };
    if val < n.val {
        n.left = Some(a3_insert(n.left, val));
    } else {
        n.right = Some(a3_insert(n.right, val));
    }
    a3_update(n);
    let lean = a3_height(n.left) - a3_height(n.right);
    if lean > 1 {
        let l = n.left.unwrap();
        if val > l.val {
            n.left = Some(a3_rotate_left(l));
        }
        return a3_rotate_right(n);
    }
    if lean < -1 {
        let r = n.right.unwrap();
        if val < r.val {
            n.right = Some(a3_rotate_right(r));
        }
        return a3_rotate_left(n);
    }
    n
}

fn a3_read(node: Option[TreeNode], values: mut ref Vec[i32]) {
    if let Some(n) = node {
        a3_read(n.left, mut values);
        values.push(n.val);
        a3_read(n.right, mut values);
    }
}

fn a3_copy(node: Option[A3Avl]) -> Option[TreeNode] {
    let n = node?;
    Some(TreeNode { val: n.val, left: a3_copy(n.left), right: a3_copy(n.right) })
}

fn a3_balance_bst(root: TreeNode) -> TreeNode {
    let mut values: Vec[i32] = Vec.new();
    a3_read(Some(root), mut values);
    let mut avl: Option[A3Avl] = None;
    for v in values.iter() {
        avl = Some(a3_insert(avl, v));
    }
    a3_copy(avl).unwrap()
}

// ---- balance_bst_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_balance_bst(root: Option[TreeNode]) -> Option[TreeNode] {
        let mut vals = Vec.new();
        A4Solution.a4_inorder(root, mut vals);
        A4Solution.a4_build(vals, 0, vals.len() as i32 - 1)
    }

    fn a4_inorder(node: Option[TreeNode], vals: mut ref Vec[i32]) {
        if let Some(n) = node {
            A4Solution.a4_inorder(n.left, mut vals);
            vals.push(n.val);
            A4Solution.a4_inorder(n.right, mut vals);
        }
    }

    fn a4_build(vals: Slice[i32], l: i32, r: i32) -> Option[TreeNode] {
        if l > r {
            return None;
        }
        let m = l + (r - l) / 2;
        let node = TreeNode.new(vals[m as usize]);
        node.left = A4Solution.a4_build(vals, l, m - 1);
        node.right = A4Solution.a4_build(vals, m + 1, r);
        Some(node)
    }
}

fn a4_balance_bst(root: TreeNode) -> TreeNode {
    A4Solution.a4_balance_bst(Some(root)).unwrap()
}

// ---- the differential -------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

impl TreeNode {
    fn new(val: i32) -> TreeNode {
        TreeNode { val, left: None, right: None }
    }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a case is a list of values and how the tree is made of them: put in
// one by one in their order (0), or hung each under the one before (1)
fn search_tree(values: Vec[i32]) -> TreeNode {
    let root = TreeNode.new(values[0]);
    for v in values[1..].iter() {
        let mut at = root;
        loop {
            let next = if v < at.val { at.left } else { at.right };
            match next {
                Some(child) => at = child,
                None => {
                    if v < at.val {
                        at.left = Some(TreeNode.new(v));
                    } else {
                        at.right = Some(TreeNode.new(v));
                    }
                    break;
                }
            }
        }
    }
    root
}

fn chain(values: Vec[i32]) -> TreeNode {
    let root = TreeNode.new(values[0]);
    let mut at = root;
    for v in values[1..].iter() {
        let next = TreeNode.new(v);
        if v < at.val {
            at.left = Some(next);
        } else {
            at.right = Some(next);
        }
        at = next;
    }
    root
}

// a new tree for every arm: two of them rebuild the tree they are given
fn make(values: Vec[i32], hung: bool) -> TreeNode {
    if hung { chain(values) } else { search_tree(values) }
}

// the tree before its root's left and right: each node's value, -1 for
// a missing child
fn outline(node: Option[TreeNode], out: mut ref Vec[i64]) {
    match node {
        Some(n) => {
            out.push(n.val);
            outline(n.left, mut out);
            outline(n.right, mut out);
        }
        None => out.push(-1),
    }
}

// whether every node's two sides differ in height by at most one, read
// literally: each node's sides measured afresh
fn depth(node: Option[TreeNode]) -> i64 {
    match node {
        Some(n) => 1 + depth(n.left).max(depth(n.right)),
        None => 0,
    }
}

fn every_node_balanced(node: Option[TreeNode]) -> bool {
    match node {
        Some(n) => (depth(n.left) - depth(n.right)).abs() <= 1 and every_node_balanced(n.left) and every_node_balanced(n.right),
        None => true,
    }
}

// a binary search tree read literally: each node's value greater than
// every value to its left and less than every one to its right
fn values_of(node: Option[TreeNode], out: mut ref Vec[i32]) {
    if let Some(n) = node {
        values_of(n.left, mut out);
        out.push(n.val);
        values_of(n.right, mut out);
    }
}

fn searchable(node: Option[TreeNode]) -> bool {
    let Some(n) = node else {
        return true;
    };
    let mut left: Vec[i32] = Vec.new();
    values_of(n.left, mut left);
    let mut right: Vec[i32] = Vec.new();
    values_of(n.right, mut right);
    left.iter().all(|v| v < n.val) and right.iter().all(|v| v > n.val) and searchable(n.left) and searchable(n.right)
}

fn arm(i: i64, root: TreeNode) -> TreeNode {
    match i {
        0 => a0_balance_bst(root),
        1 => a1_balance_bst(root),
        2 => a2_balance_bst(root),
        3 => a3_balance_bst(root),
        _ => a4_balance_bst(root),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, values: Vec[i32], hung: bool) {
    t.cases += 1;
    let n = values.len();
    let mut sorted = values.clone();
    sorted.sort();
    // the least height n nodes can have
    let mut least = 0;
    while (1 << least) <= n {
        least += 1;
    }
    t.check = (t.check * 131 + n * 7 + least + if hung { 1 } else { 0 }) % 1000000007;
    for v in sorted.iter() {
        t.check = (t.check * 131 + v as i64) % 1000000007;
    }
    let shifted: Vec[i32] = values.iter().map(|v| v + 1000).collect();
    let star = arm(0, make(values, hung));
    let star_height = depth(Some(star));
    for i in 0..5 {
        let got = arm(i, make(values, hung));
        let what = f"arm {i} on {values} hung {hung}";
        let mut kept: Vec[i32] = Vec.new();
        values_of(Some(got), mut kept);
        let height = depth(Some(got));
        let mut shape: Vec[i64] = Vec.new();
        outline(Some(got), mut shape);
        // P1: the statement read literally: a binary search tree of the
        // same values
        expect(mut t, 1, kept == sorted and searchable(Some(got)), f"P1 {what}: values {kept}");
        // P2: the statement read literally: balanced
        expect(mut t, 2, every_node_balanced(Some(got)), f"P2 {what}: shape {shape}");
        // P3: no taller than n nodes need be, as every arm here promises
        expect(mut t, 3, height == least, f"P3 {what}: height {height}, least {least}");
        // P4: every value raised by 1000: the same shape, each value
        // raised by 1000
        let up = arm(i, make(shifted, hung));
        let mut up_shape: Vec[i64] = Vec.new();
        outline(Some(up), mut up_shape);
        let raised: Vec[i64] = shape.iter().map(|v| if v < 0 { v } else { v + 1000 }).collect();
        expect(mut t, 4, up_shape == raised, f"P4 {what}: raised {up_shape}");
        // P5: the answer balanced again: the same values, balanced, and
        // no taller
        let again = arm(i, got);
        let mut again_kept: Vec[i32] = Vec.new();
        values_of(Some(again), mut again_kept);
        expect(mut t, 5, again_kept == sorted and every_node_balanced(Some(again)) and depth(Some(again)) <= height, f"P5 {what}: again {again_kept}");
        // P6: as tall as the ★ arm's answer
        expect(mut t, 6, height == star_height, f"P6 {what}: height {height}, ★ {star_height}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    let mut cases: Vec[(Vec[i32], bool)] = Vec.new();
    // LeetCode's two examples, hung as given
    cases.push(([1, 2, 3, 4], true));
    cases.push(([2, 1, 3], false));
    // 2000 trees of 1 to 40 different values from 1 to 100, in five
    // kinds of 400: put in at random; hung rising; hung falling; hung
    // from both ends in turn; and put in from the middle out, already
    // balanced. Every case is drawn before any arm answers.
    let mut seed = 13821;
    for c in 0..2000 {
        let n = 1 + next_random(mut seed) % 40;
        let mut pool: Vec[i32] = (1..101).map(|v| v as i32).collect();
        for i in (1..100).rev() {
            let j = next_random(mut seed) % (i + 1);
            pool.swap(i, j);
        }
        let mut values: Vec[i32] = pool[0..n].to_vec();
        let kind = c % 5;
        if kind > 0 {
            values.sort();
        }
        if kind == 2 {
            values.reverse();
        } else if kind == 3 {
            let ends: Vec[i32] = (0..n).map(|k| if k % 2 == 0 { values[k / 2] } else { values[n - 1 - k / 2] }).collect();
            values = ends;
        } else if kind == 4 {
            // breadth first through the halves: each middle before the
            // middles of its halves
            let mut order: Vec[i32] = Vec.new();
            let mut spans: VecDeque[(i64, i64)] = VecDeque.new();
            spans.push_back((0, n));
            while let Some((lo, hi)) = spans.pop_front() {
                if lo < hi {
                    let mid = (lo + hi) / 2;
                    order.push(values[mid]);
                    spans.push_back((lo, mid));
                    spans.push_back((mid + 1, hi));
                }
            }
            values = order;
        }
        cases.push((values, kind >= 1 and kind <= 3));
    }
    for (values, hung) in cases.iter() {
        check_case(mut t, values, hung);
    }
    println(f"{t.cases} trees: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
