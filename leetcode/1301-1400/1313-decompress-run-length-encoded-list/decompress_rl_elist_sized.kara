// LeetCode #1313: Decompress Run-Length Encoded List -- the sized arm: the
// counts added up first, the answer made that long at once, and each run
// written into its place by index. O(total)

fn decompress_rl_elist(nums: Vec[i64]) -> Vec[i64] {
    let mut total = 0;
    let mut i = 0;
    while i < nums.len() {
        total += nums[i];
        i += 2;
    }
    let mut out: Vec[i64] = Vec.filled(total, 0);
    let mut at = 0;
    i = 0;
    while i < nums.len() {
        for k in 0..nums[i] {
            out[at + k] = nums[i + 1];
        }
        at += nums[i];
        i += 2;
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(v: Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{x}").collect();
    parts.join(",")
}

fn main() {
    // LeetCode's two examples; one pair; a value repeated across two pairs;
    // and the largest count and value, 100 of 100 (shown by its length and
    // sum)
    let e1 = decompress_rl_elist([1, 2, 3, 4]);
    let e2 = decompress_rl_elist([1, 1, 2, 3]);
    let one = decompress_rl_elist([3, 7]);
    let again = decompress_rl_elist([2, 5, 1, 5, 1, 6]);
    let big = decompress_rl_elist([100, 100]);
    let big_sum: i64 = big.iter().sum();
    println(f"{show(e1)} {show(e2)} {show(one)} {show(again)} {big.len()}:{big_sum}");
    // 1000 random lists of 1 to 50 pairs, the constraints' most, with counts
    // up to 1, 5 or 100 and values up to 100
    let mut seed = 1313;
    let mut total = 0;
    let mut check = 0;
    for t in 0..1000 {
        let pairs = 1 + next_random(mut seed) % 50;
        let most = if t % 3 == 0 { 1 } else if t % 3 == 1 { 5 } else { 100 };
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..pairs {
            nums.push(1 + next_random(mut seed) % most);
            nums.push(1 + next_random(mut seed) % 100);
        }
        let got = decompress_rl_elist(nums);
        total += got.len();
        for x in got.iter() {
            check = (check * 31 + x) % 1000000007;
        }
    }
    println(f"1000 random lists: {total} numbers, checksum {check}");
}
