// LeetCode #1361: Validate Binary Tree Nodes -- the climbing arm: each
// node's one parent written down (a second is a failure at once), the
// one node with none the root, then every node climbs toward the root,
// a node known to reach it ending the climb early; a climb of n steps
// that has not arrived is going round a cycle. O(n) amortized
fn validate_binary_tree_nodes(n: i32, left_child: Vec[i32], right_child: Vec[i32]) -> bool {
    let mut parent: Vec[i64] = Vec.filled(n, -1);
    for i in 0..n {
        for child in [left_child[i], right_child[i]] {
            if child != -1 {
                if parent[child] != -1 or child == i {
                    return false;
                }
                parent[child] = i;
            }
        }
    }
    let mut root = -1;
    for i in 0..n {
        if parent[i] == -1 {
            if root != -1 {
                return false;
            }
            root = i;
        }
    }
    if root == -1 {
        return false;
    }
    let mut reaches: Vec[bool] = Vec.filled(n, false);
    reaches[root] = true;
    for start in 0..n {
        let mut path: Vec[i64] = Vec.new();
        let mut at: i64 = start;
        while not reaches[at] {
            if path.len() > n {
                return false;
            }
            path.push(at);
            at = parent[at];
        }
        for node in path {
            reaches[node] = true;
        }
    }
    true
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n nodes made into one binary tree, each node after the first hung on a
// free side of a node already placed; then, one time in two, broken or
// not: a free side pointed at any node, an edge cut, or an edge moved to
// any node
fn random_case(seed: mut ref i64) -> (i32, Vec[i32], Vec[i32]) {
    let n = 1 + next_random(mut seed) % 40;
    let mut left: Vec[i32] = Vec.filled(n, -1);
    let mut right: Vec[i32] = Vec.filled(n, -1);
    let mut order: Vec[i64] = Vec.new();
    for i in 0..n {
        order.push(i);
    }
    for i in 1..n {
        let j = next_random(mut seed) % (i + 1);
        let held = order[i];
        order[i] = order[j];
        order[j] = held;
    }
    for i in 1..n {
        loop {
            let parent = order[next_random(mut seed) % i];
            if next_random(mut seed) % 2 == 0 {
                if left[parent] == -1 {
                    left[parent] = order[i] as i32;
                    break;
                }
            } else if right[parent] == -1 {
                right[parent] = order[i] as i32;
                break;
            }
        }
    }
    let node = next_random(mut seed) % n;
    let other = (next_random(mut seed) % n) as i32;
    match next_random(mut seed) % 6 {
        0 => {
            if left[node] == -1 {
                left[node] = other;
            } else if right[node] == -1 {
                right[node] = other;
            }
        }
        1 => {
            left[node] = -1;
        }
        2 => {
            if right[node] != -1 {
                right[node] = other;
            }
        }
        _ => {}
    }
    (n as i32, left, right)
}

fn main() {
    // LeetCode's three examples; one node; two parents for one node; two
    // roots; a node its own child; a cycle under the root
    let e1 = validate_binary_tree_nodes(4, [1, -1, 3, -1], [2, -1, -1, -1]);
    let e2 = validate_binary_tree_nodes(4, [1, -1, 3, -1], [2, 3, -1, -1]);
    let e3 = validate_binary_tree_nodes(2, [1, 0], [-1, -1]);
    let one = validate_binary_tree_nodes(1, [-1], [-1]);
    let two_parents = validate_binary_tree_nodes(3, [1, -1, -1], [2, 2, -1]);
    let two_roots = validate_binary_tree_nodes(2, [-1, -1], [-1, -1]);
    let own = validate_binary_tree_nodes(2, [1, -1], [-1, 1]);
    let cycle = validate_binary_tree_nodes(4, [1, 2, -1, -1], [-1, -1, 1, -1]);
    println(f"{e1} {e2} {e3} {one} {two_parents} {two_roots} {own} {cycle}");
    // 2000 random cases, folded into a checksum
    let mut seed = 1361;
    let mut valid = 0;
    let mut check: i64 = 0;
    for _ in 0..2000 {
        let (n, left, right) = random_case(mut seed);
        let got = validate_binary_tree_nodes(n, left, right);
        if got {
            valid += 1;
        }
        check = (check * 131 + n + if got { 1 } else { 0 }) % 1000000007;
    }
    println(f"2000 random cases: {valid} valid, checksum {check}");
}
