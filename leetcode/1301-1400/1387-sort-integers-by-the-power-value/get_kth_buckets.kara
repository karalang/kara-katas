// LeetCode #1387: Sort Integers by The Power Value -- each value's power
// by a recursive function that keeps what it finds in a `Map` passed
// `mut ref`; then a `SortedMap` from each power to its values, which go
// in rising, and the k-th found by walking the powers up. O(m log m)
// after the walks

fn power(x: i64, memo: mut ref Map[i64, i32]) -> i32 {
    if x == 1 {
        return 0;
    }
    if let Some(p) = memo.get(x) {
        return p;
    }
    let next = if x % 2 == 0 { x / 2 } else { 3 * x + 1 };
    let p = 1 + power(next, mut memo);
    memo.insert(x, p);
    p
}

fn get_kth(lo: i32, hi: i32, k: i32) -> i32 {
    let mut memo: Map[i64, i32] = Map.new();
    let mut by_power: SortedMap[i32, Vec[i32]] = SortedMap.new();
    for x in lo..hi + 1 {
        let p = power(x, mut memo);
        let mut values = by_power.get(p).cloned().unwrap_or(Vec.new());
        values.push(x);
        by_power.insert(p, values);
    }
    let mut left = k;
    for (_, values) in by_power.iter() {
        if left <= values.len() {
            return values[left - 1];
        }
        left -= values.len() as i32;
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one value; the first and the last of the
    // whole range 1 to 1000; and a range whose powers tie
    let mut shown: Vec[String] = Vec.new();
    shown.push(f"{get_kth(12, 15, 2)}");
    shown.push(f"{get_kth(7, 11, 4)}");
    shown.push(f"{get_kth(1, 1, 1)}");
    shown.push(f"{get_kth(1, 1000, 1)}");
    shown.push(f"{get_kth(1, 1000, 1000)}");
    shown.push(f"{get_kth(12, 13, 1)}");
    println(shown.join(" "));
    // the constraints' most: every k over 1 to 1000
    let mut check: i64 = 0;
    for k in 1..1001 {
        check = (check * 131 + get_kth(1, 1000, k as i32)) % 1000000007;
    }
    println(f"every k over 1 to 1000: checksum {check}");
    // 2000 random ranges inside 1 to 1000, at a random k
    let mut seed = 1387;
    let mut check: i64 = 0;
    for _ in 0..2000 {
        let a = 1 + next_random(mut seed) % 1000;
        let b = 1 + next_random(mut seed) % 1000;
        let (lo, hi) = if a <= b { (a, b) } else { (b, a) };
        let k = 1 + next_random(mut seed) % (hi - lo + 1);
        check = (check * 131 + get_kth(lo as i32, hi as i32, k as i32)) % 1000000007;
    }
    println(f"2000 random ranges: checksum {check}");
}
