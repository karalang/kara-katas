// LeetCode #1387: Sort Integers by The Power Value -- the ★ arm: each
// value walked only until it meets one whose power is known, in a `Map`
// that every walk fills on its way back; the (power, value) pairs sorted
// and the k-th read off. O(m log m) after the walks, each step of which
// is taken once. Bench workload.

fn get_kth(lo: i32, hi: i32, k: i32) -> i32 {
    let mut known: Map[i64, i32] = Map.new();
    known.insert(1, 0);
    let mut keyed: Vec[(i32, i32)] = Vec.new();
    for x in lo..hi + 1 {
        let mut path: Vec[i64] = Vec.new();
        let mut v: i64 = x;
        while not known.contains_key(v) {
            path.push(v);
            v = if v % 2 == 0 { v / 2 } else { 3 * v + 1 };
        }
        let mut steps = known[v];
        while let Some(p) = path.pop() {
            steps += 1;
            known.insert(p, steps);
        }
        keyed.push((known[x], x));
    }
    keyed.sort();
    keyed[k - 1].1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// 4000 queries, each a range from 1 to 200 up to 800 to 1000, the
// constraints' most, at a random k, all drawn from the checksum so far
fn main() {
    let mut seed = 1387;
    let mut check: i64 = 0;
    for _ in 0..4000 {
        seed = (seed + check) % 2147483648;
        let lo = 1 + next_random(mut seed) % 200;
        let hi = 800 + next_random(mut seed) % 201;
        let k = 1 + next_random(mut seed) % (hi - lo + 1);
        check = (check * 131 + get_kth(lo as i32, hi as i32, k as i32)) % 1000000007;
    }
    println(f"4000 queries over ranges up to 1 to 1000: checksum {check}");
}
