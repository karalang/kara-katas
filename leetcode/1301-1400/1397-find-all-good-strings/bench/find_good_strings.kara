// LeetCode #1397 bench: the ★ arm (the strings built a letter at a time,
// counted by how much of `evil` their end matches and whether they are
// still at s1's prefix and at s2's, the matches stepped through a KMP
// automaton table) at the constraints' most, n = 500 and an evil string
// of 50 letters, one letter of each changed before each of 200 rounds.

fn slot(j: i64, low: bool, high: bool) -> i64 {
    j * 4 + (if low { 2 } else { 0 }) + (if high { 1 } else { 0 })
}

fn find_good_strings(n: i32, s1: String, s2: String, evil: String) -> i32 {
    let modulus = 1000000007;
    let lo = s1.bytes();
    let hi = s2.bytes();
    let e = evil.bytes();
    let m = e.len();
    // border[i]: the longest proper border of evil's first i + 1 letters
    let mut border: Vec[i64] = Vec.filled(m, 0);
    let mut k = 0;
    for i in 1..m {
        while k > 0 and e[i] != e[k] {
            k = border[k - 1];
        }
        if e[i] == e[k] {
            k += 1;
        }
        border[i] = k;
    }
    // next[j * 26 + c]: the letters matched after j matched and letter c
    let mut next: Vec[i64] = Vec.filled(m * 26, 0);
    for j in 0..m {
        for c in 0..26 {
            if e[j] as i64 == 97 + c {
                next[j * 26 + c] = j + 1;
            } else if j > 0 {
                next[j * 26 + c] = next[border[j - 1] * 26 + c];
            }
        }
    }
    let mut ways: Vec[i64] = Vec.filled(m * 4, 0);
    ways[slot(0, true, true)] = 1;
    for i in 0..n {
        let mut after: Vec[i64] = Vec.filled(m * 4, 0);
        for j in 0..m {
            for low in [false, true] {
                for high in [false, true] {
                    let w = ways[slot(j, low, high)];
                    if w == 0 {
                        continue;
                    }
                    let first = if low { lo[i] as i64 - 97 } else { 0 };
                    let last = if high { hi[i] as i64 - 97 } else { 25 };
                    for c in first..=last {
                        let to = next[j * 26 + c];
                        if to == m {
                            continue;
                        }
                        let at = slot(to, low and c == first, high and c == last);
                        after[at] = (after[at] + w) % modulus;
                    }
                }
            }
        }
        ways = after;
    }
    let mut total = 0;
    for w in ways.iter() {
        total = (total + w) % modulus;
    }
    total as i32
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 1397;
    let mut low: Vec[char] = (0..500).map(|_| (97 + next_random(mut seed) % 3) as u8 as char).collect();
    let mut high: Vec[char] = (0..500).map(|_| (120 + next_random(mut seed) % 3) as u8 as char).collect();
    let mut evil: Vec[char] = (0..50).map(|_| (97 + next_random(mut seed) % 3) as u8 as char).collect();
    let mut check: i64 = 0;
    for _ in 0..200 {
        seed = (seed + check) % 2147483648;
        low[next_random(mut seed) % 500] = (97 + next_random(mut seed) % 3) as u8 as char;
        high[next_random(mut seed) % 500] = (120 + next_random(mut seed) % 3) as u8 as char;
        evil[next_random(mut seed) % 50] = (97 + next_random(mut seed) % 3) as u8 as char;
        let s1: String = low.iter().collect();
        let s2: String = high.iter().collect();
        let e: String = evil.iter().collect();
        check = (check * 131 + find_good_strings(500, s1, s2, e)) % 1000000007;
    }
    println(f"200 rounds at n = 500, evil of 50 letters: checksum {check}");
}
