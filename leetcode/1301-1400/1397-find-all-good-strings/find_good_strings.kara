// LeetCode #1397: Find All Good Strings -- the ★ arm: the strings built a
// letter at a time, counted by how much of `evil` their end matches and
// whether they are still equal to s1's prefix and to s2's; the matches
// stepped through Knuth, Morris and Pratt's automaton, a table of the
// next match for every match and letter, and a string that matches all
// of `evil` dropped. O(n m 26)

// the slot of a count: j letters of `evil` matched, still at s1's prefix
// (`low`), still at s2's (`high`)
fn slot(j: i64, low: bool, high: bool) -> i64 {
    j * 4 + (if low { 2 } else { 0 }) + (if high { 1 } else { 0 })
}

fn find_good_strings(n: i32, s1: String, s2: String, evil: String) -> i32 {
    let modulus = 1000000007;
    let lo = s1.bytes();
    let hi = s2.bytes();
    let e = evil.bytes();
    let m = e.len();
    // border[i]: the longest proper border of evil's first i + 1 letters
    let mut border: Vec[i64] = Vec.filled(m, 0);
    let mut k = 0;
    for i in 1..m {
        while k > 0 and e[i] != e[k] {
            k = border[k - 1];
        }
        if e[i] == e[k] {
            k += 1;
        }
        border[i] = k;
    }
    // next[j * 26 + c]: the letters matched after j matched and letter c
    let mut next: Vec[i64] = Vec.filled(m * 26, 0);
    for j in 0..m {
        for c in 0..26 {
            if e[j] as i64 == 97 + c {
                next[j * 26 + c] = j + 1;
            } else if j > 0 {
                next[j * 26 + c] = next[border[j - 1] * 26 + c];
            }
        }
    }
    let mut ways: Vec[i64] = Vec.filled(m * 4, 0);
    ways[slot(0, true, true)] = 1;
    for i in 0..n {
        let mut after: Vec[i64] = Vec.filled(m * 4, 0);
        for j in 0..m {
            for low in [false, true] {
                for high in [false, true] {
                    let w = ways[slot(j, low, high)];
                    if w == 0 {
                        continue;
                    }
                    let first = if low { lo[i] as i64 - 97 } else { 0 };
                    let last = if high { hi[i] as i64 - 97 } else { 25 };
                    for c in first..=last {
                        let to = next[j * 26 + c];
                        if to == m {
                            continue;
                        }
                        let at = slot(to, low and c == first, high and c == last);
                        after[at] = (after[at] + w) % modulus;
                    }
                }
            }
        }
        ways = after;
    }
    let mut total = 0;
    for w in ways.iter() {
        total = (total + w) % modulus;
    }
    total as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters drawn from the first `letters` of the alphabet
fn drawn(n: i64, letters: i64, seed: mut ref i64) -> String {
    let out: Vec[char] = (0..n).map(|_| (97 + next_random(mut seed) % letters) as u8 as char).collect();
    out.iter().collect()
}

// a case of the given sizes: two strings of n letters, the smaller first,
// and an evil string of m letters
fn case_of(n: i64, letters: i64, m: i64, evil_letters: i64, seed: mut ref i64) -> (String, String, String) {
    let a = drawn(n, letters, mut seed);
    let b = drawn(n, letters, mut seed);
    let evil = drawn(m, evil_letters, mut seed);
    if a <= b {
        (a, b, evil)
    } else {
        (b, a, evil)
    }
}

fn main() {
    // LeetCode's three examples; one string, good; one string, evil
    let shown: Vec[String] = [
        find_good_strings(2, "aa", "da", "b"),
        find_good_strings(8, "leetcode", "leetgoes", "leet"),
        find_good_strings(2, "gx", "gz", "x"),
        find_good_strings(3, "abc", "abc", "d"),
        find_good_strings(3, "abc", "abc", "bc"),
    ].iter().map(|x| f"{x}").collect();
    println(shown.join(" "));
    // the constraints' most: n = 500, the whole alphabet, and evil strings
    // of 1, 8 and 50 letters
    let mut seed = 1397;
    let z: Vec[char] = (0..500).map(|_| 'z').collect();
    let top: String = z.iter().collect();
    let mut big: Vec[String] = Vec.new();
    for m in [1, 8, 50] {
        let low = drawn(500, 3, mut seed);
        let evil = drawn(m, 2, mut seed);
        big.push(f"{find_good_strings(500, low, top, evil)}");
    }
    println(f"n = 500: {big.join(" ")}");
    // 2000 random cases of 1 to 12 letters from the first 1 to 26, the
    // evil string 1 to 4 letters from the first 1 to 3
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 12;
        let letters = 1 + next_random(mut seed) % 26;
        let m = 1 + next_random(mut seed) % 4;
        let evil_letters = 1 + next_random(mut seed) % 3;
        let (a, b, evil) = case_of(n, letters, m, evil_letters, mut seed);
        let got = find_good_strings(n as i32, a, b, evil) as i64;
        total = (total + got) % 1000000007;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random cases: {total} in all, checksum {check}");
}
