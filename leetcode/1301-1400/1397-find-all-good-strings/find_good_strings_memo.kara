// LeetCode #1397: Find All Good Strings -- top-down: the count of good
// endings from a position, given how much of `evil` is matched and
// whether the string is still at s1's prefix and at s2's, memoized in one
// flat `Vec` with -1 for unknown, the next match found by falling back
// along the failure table. O(n m 26), beside the falls back

struct Search {
    lo: Vec[u8],
    hi: Vec[u8],
    e: Vec[u8],
    border: Vec[i64],
    memo: Vec[i64],
}

impl Search {
    fn ways(mut ref self, i: i64, j: i64, low: bool, high: bool) -> i64 {
        let m = self.e.len();
        if j == m {
            return 0;
        }
        if i == self.lo.len() {
            return 1;
        }
        let key = ((i * m + j) * 2 + (if low { 1 } else { 0 })) * 2 + (if high { 1 } else { 0 });
        if self.memo[key] >= 0 {
            return self.memo[key];
        }
        let first = if low { self.lo[i] } else { b'a' };
        let last = if high { self.hi[i] } else { b'z' };
        let mut total = 0;
        for c in first..=last {
            let mut k = j;
            while k > 0 and self.e[k] != c {
                k = self.border[k - 1];
            }
            if self.e[k] == c {
                k += 1;
            }
            total = (total + self.ways(i + 1, k, low and c == first, high and c == last)) % 1000000007;
        }
        self.memo[key] = total;
        total
    }
}

fn find_good_strings(n: i32, s1: String, s2: String, evil: String) -> i32 {
    let e = evil.bytes();
    let m = e.len();
    let mut border: Vec[i64] = Vec.filled(m, 0);
    let mut k = 0;
    for i in 1..m {
        while k > 0 and e[i] != e[k] {
            k = border[k - 1];
        }
        if e[i] == e[k] {
            k += 1;
        }
        border[i] = k;
    }
    let mut search = Search { lo: s1.bytes().to_vec(), hi: s2.bytes().to_vec(), e: e.to_vec(), border: border, memo: Vec.filled(n * m * 4, -1) };
    search.ways(0, 0, true, true) as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters drawn from the first `letters` of the alphabet
fn drawn(n: i64, letters: i64, seed: mut ref i64) -> String {
    let out: Vec[char] = (0..n).map(|_| (97 + next_random(mut seed) % letters) as u8 as char).collect();
    out.iter().collect()
}

// a case of the given sizes: two strings of n letters, the smaller first,
// and an evil string of m letters
fn case_of(n: i64, letters: i64, m: i64, evil_letters: i64, seed: mut ref i64) -> (String, String, String) {
    let a = drawn(n, letters, mut seed);
    let b = drawn(n, letters, mut seed);
    let evil = drawn(m, evil_letters, mut seed);
    if a <= b {
        (a, b, evil)
    } else {
        (b, a, evil)
    }
}

fn main() {
    // LeetCode's three examples; one string, good; one string, evil
    let shown: Vec[String] = [
        find_good_strings(2, "aa", "da", "b"),
        find_good_strings(8, "leetcode", "leetgoes", "leet"),
        find_good_strings(2, "gx", "gz", "x"),
        find_good_strings(3, "abc", "abc", "d"),
        find_good_strings(3, "abc", "abc", "bc"),
    ].iter().map(|x| f"{x}").collect();
    println(shown.join(" "));
    // the constraints' most: n = 500, the whole alphabet, and evil strings
    // of 1, 8 and 50 letters
    let mut seed = 1397;
    let z: Vec[char] = (0..500).map(|_| 'z').collect();
    let top: String = z.iter().collect();
    let mut big: Vec[String] = Vec.new();
    for m in [1, 8, 50] {
        let low = drawn(500, 3, mut seed);
        let evil = drawn(m, 2, mut seed);
        big.push(f"{find_good_strings(500, low, top, evil)}");
    }
    println(f"n = 500: {big.join(" ")}");
    // 2000 random cases of 1 to 12 letters from the first 1 to 26, the
    // evil string 1 to 4 letters from the first 1 to 3
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 12;
        let letters = 1 + next_random(mut seed) % 26;
        let m = 1 + next_random(mut seed) % 4;
        let evil_letters = 1 + next_random(mut seed) % 3;
        let (a, b, evil) = case_of(n, letters, m, evil_letters, mut seed);
        let got = find_good_strings(n as i32, a, b, evil) as i64;
        total = (total + got) % 1000000007;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random cases: {total} in all, checksum {check}");
}
