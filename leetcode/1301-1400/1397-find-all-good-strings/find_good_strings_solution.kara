// LeetCode #1397: Find All Good Strings -- a Rust solution as LeetCode's
// Rust users write it: the KMP prefix table built with a `while` loop, a
// nested `fn dfs` over position, evil index and the two tight flags as
// `usize`s, memoized in a four-deep `vec!`, carried to Kāra by `karac fix`

struct Solution {}

fn dfs(pos: i64, ev: i64, lt: i64, rt: i64, n: i64, s1: Slice[u8], s2: Slice[u8], evil: Slice[u8], lps: Slice[i64], memo: mut ref Vec[Vec[Vec[Vec[i64]]]]) -> i64 {
    if ev == evil.len() {
        return 0;
    }
    if pos == n {
        return 1;
    }
    if memo[pos][ev][lt][rt] != -1 {
        return memo[pos][ev][lt][rt];
    }
    let lo = if lt == 1 { s1[pos] } else { b'a' };
    let hi = if rt == 1 { s2[pos] } else { b'z' };
    let mut res = 0;
    for c in lo..=hi {
        let mut j = ev;
        while j > 0 and evil[j] != c {
            j = lps[j - 1];
        }
        if evil[j] == c {
            j += 1;
        }
        let nlt = if lt == 1 and c == lo { 1 } else { 0 };
        let nrt = if rt == 1 and c == hi { 1 } else { 0 };
        res = (res + dfs(pos + 1, j, nlt, nrt, n, s1, s2, evil, lps, mut memo)) % 1_000_000_007;
    }
    memo[pos][ev][lt][rt] = res;
    res
}

impl Solution {
    pub fn find_good_strings(n: i32, s1: String, s2: String, evil: String) -> i32 {
        let n = n as i64;
        let s1 = s1.bytes();
        let s2 = s2.bytes();
        let evil = evil.bytes();
        let m = evil.len();
        let mut lps = Vec.filled(m, 0);
        let mut len = 0;
        let mut i = 1;
        while i < m {
            if evil[i] == evil[len] {
                len += 1;
                lps[i] = len;
                i += 1;
            } else if len > 0 {
                len = lps[len - 1];
            } else {
                lps[i] = 0;
                i += 1;
            }
        }
        let mut memo = Vec.filled(n, Vec.filled(m, Vec.filled(2, Vec.filled(2, -1))));
        dfs(0, 0, 1, 1, n, s1, s2, evil, lps, mut memo) as i32
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters drawn from the first `letters` of the alphabet
fn drawn(n: i64, letters: i64, seed: mut ref i64) -> String {
    let out: Vec[char] = (0..n).map(|_| (97 + next_random(mut seed) % letters) as u8 as char).collect();
    out.iter().collect()
}

// a case of the given sizes: two strings of n letters, the smaller first,
// and an evil string of m letters
fn case_of(n: i64, letters: i64, m: i64, evil_letters: i64, seed: mut ref i64) -> (String, String, String) {
    let a = drawn(n, letters, mut seed);
    let b = drawn(n, letters, mut seed);
    let evil = drawn(m, evil_letters, mut seed);
    if a <= b {
        (a, b, evil)
    } else {
        (b, a, evil)
    }
}

fn main() {
    // LeetCode's three examples; one string, good; one string, evil
    let shown: Vec[String] = [
        Solution.find_good_strings(2, "aa", "da", "b"),
        Solution.find_good_strings(8, "leetcode", "leetgoes", "leet"),
        Solution.find_good_strings(2, "gx", "gz", "x"),
        Solution.find_good_strings(3, "abc", "abc", "d"),
        Solution.find_good_strings(3, "abc", "abc", "bc"),
    ].iter().map(|x| f"{x}").collect();
    println(shown.join(" "));
    // the constraints' most: n = 500, the whole alphabet, and evil strings
    // of 1, 8 and 50 letters
    let mut seed = 1397;
    let z: Vec[char] = (0..500).map(|_| 'z').collect();
    let top: String = z.iter().collect();
    let mut big: Vec[String] = Vec.new();
    for m in [1, 8, 50] {
        let low = drawn(500, 3, mut seed);
        let evil = drawn(m, 2, mut seed);
        big.push(f"{Solution.find_good_strings(500, low, top, evil)}");
    }
    println(f"n = 500: {big.join(" ")}");
    // 2000 random cases of 1 to 12 letters from the first 1 to 26, the
    // evil string 1 to 4 letters from the first 1 to 3
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for _ in 0..2000 {
        let n = 1 + next_random(mut seed) % 12;
        let letters = 1 + next_random(mut seed) % 26;
        let m = 1 + next_random(mut seed) % 4;
        let evil_letters = 1 + next_random(mut seed) % 3;
        let (a, b, evil) = case_of(n, letters, m, evil_letters, mut seed);
        let got = Solution.find_good_strings(n as i32, a, b, evil) as i64;
        total = (total + got) % 1000000007;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random cases: {total} in all, checksum {check}");
}
