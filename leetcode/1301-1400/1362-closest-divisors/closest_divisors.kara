// LeetCode #1362: Closest Divisors -- the ★ arm: a divisor pair of m is
// closest when its smaller part is the largest divisor of m at most √m,
// so d counts down from √(num + 2), and the first d that divides num + 1
// or num + 2 gives the answer; the two targets' best pairs cannot tie,
// and num + 1 is tried first at each d. O(√num)
fn isqrt(x: i64) -> i64 {
    let mut r = (x as f64).sqrt() as i64;
    while r * r > x {
        r -= 1;
    }
    while (r + 1) * (r + 1) <= x {
        r += 1;
    }
    r
}

fn closest_divisors(num: i32) -> Vec[i32] {
    let (one, two) = (num as i64 + 1, num as i64 + 2);
    let mut d = isqrt(two);
    while d > 0 {
        if one % d == 0 {
            return [d as i32, (one / d) as i32];
        }
        if two % d == 0 {
            return [d as i32, (two / d) as i32];
        }
        d -= 1;
    }
    [1, num + 1]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the pair, smaller first, since either order is an answer
fn show(pair: Vec[i32]) -> String {
    let (a, b) = (pair[0].min(pair[1]), pair[0].max(pair[1]));
    f"[{a},{b}]"
}

fn main() {
    // LeetCode's three examples; the constraints' two ends; num + 2 a
    // square; num + 1 twice a prime and num + 2 the prime 10^9 + 7
    let nums = [8, 123, 999, 1, 1000000000, 23, 1000000005];
    let shown: Vec[String] = nums.iter().map(|num| show(closest_divisors(num))).collect();
    println(shown.join(" "));
    // 500 random numbers up to 10^9, folded into a checksum
    let mut seed = 1362;
    let mut check: i64 = 0;
    for _ in 0..500 {
        let num = (1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000) as i32;
        let pair = closest_divisors(num);
        let (a, b) = (pair[0].min(pair[1]) as i64, pair[0].max(pair[1]) as i64);
        check = (check * 131 + a * 7 + b) % 1000000007;
    }
    println(f"500 random numbers: checksum {check}");
}
