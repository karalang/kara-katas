// LeetCode #1362: Closest Divisors -- the ascending arm: d counts up from
// 1 while d² is at most num + 2, the last divisor of each target seen
// kept, so each ends at its largest divisor at most its square root; the
// closer of the two pairs is the answer. O(√num), always the whole way
fn closest_divisors(num: i32) -> Vec[i32] {
    let one = num as i64 + 1;
    let two = num as i64 + 2;
    let mut best_one = 1;
    let mut best_two = 1;
    let mut d = 1;
    while d * d <= two {
        if d * d <= one and one % d == 0 {
            best_one = d;
        }
        if two % d == 0 {
            best_two = d;
        }
        d += 1;
    }
    let (a, b) = (best_one, one / best_one);
    let (c, e) = (best_two, two / best_two);
    if b - a <= e - c {
        [a as i32, b as i32]
    } else {
        [c as i32, e as i32]
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the pair, smaller first, since either order is an answer
fn show(pair: Vec[i32]) -> String {
    let (a, b) = (pair[0].min(pair[1]), pair[0].max(pair[1]));
    f"[{a},{b}]"
}

fn main() {
    // LeetCode's three examples; the constraints' two ends; num + 2 a
    // square; num + 1 twice a prime and num + 2 the prime 10^9 + 7
    let nums = [8, 123, 999, 1, 1000000000, 23, 1000000005];
    let shown: Vec[String] = nums.iter().map(|num| show(closest_divisors(num))).collect();
    println(shown.join(" "));
    // 500 random numbers up to 10^9, folded into a checksum
    let mut seed = 1362;
    let mut check: i64 = 0;
    for _ in 0..500 {
        let num = (1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % 1000000000) as i32;
        let pair = closest_divisors(num);
        let (a, b) = (pair[0].min(pair[1]) as i64, pair[0].max(pair[1]) as i64);
        check = (check * 131 + a * 7 + b) % 1000000007;
    }
    println(f"500 random numbers: checksum {check}");
}
