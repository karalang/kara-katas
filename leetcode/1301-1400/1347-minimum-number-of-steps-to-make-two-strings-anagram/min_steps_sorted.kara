// LeetCode #1347: Minimum Number of Steps to Make Two Strings Anagram --
// the sorted arm: both words' letters sorted and walked together, a
// matching letter kept by both; every letter of t not kept is replaced.
// Written first as Rust writes it, `s.bytes().collect()` and `let (mut
// i, mut j, mut kept) = (0, 0, 0);`, and carried by `karac fix`: `bytes()`
// is a `Slice[u8]`, so `.iter()` before the `collect`, and one `mut`
// before the whole pattern. O(n log n)

fn min_steps(s: Str, t: Str) -> i32 {
    let mut a: Vec[u8] = s.bytes().iter().collect();
    let mut b: Vec[u8] = t.bytes().iter().collect();
    a.sort();
    b.sort();
    let mut (i, j, kept) = (0, 0, 0);
    while i < a.len() and j < b.len() {
        if a[i] == b[j] {
            kept += 1;
            i += 1;
            j += 1;
        } else if a[i] < b[j] {
            i += 1;
        } else {
            j += 1;
        }
    }
    (b.len() - kept) as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n letters drawn from the first `letters` of the alphabet
fn random_word(seed: mut ref i64, n: i64, letters: i64) -> String {
    let mut w = String.new();
    for _ in 0..n {
        w.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    w
}

fn main() {
    // LeetCode's three examples; one letter the same and one different;
    // 5 * 10^4 a's against as many b's, the constraints' longest; and two
    // random words of that length over the whole alphabet
    let e1 = min_steps("bab", "aba");
    let e2 = min_steps("leetcode", "practice");
    let e3 = min_steps("anagram", "mangaar");
    let same = min_steps("q", "q");
    let differ = min_steps("a", "z");
    let a_s = "a".repeat(50000);
    let b_s = "b".repeat(50000);
    let mut seed = 1347;
    let s = random_word(mut seed, 50000, 26);
    let t = random_word(mut seed, 50000, 26);
    println(f"{e1} {e2} {e3} {same} {differ} {min_steps(a_s, b_s)} {min_steps(s, t)}");
    // 2000 random pairs of 1 to 300 letters, most of them short, over 2, 5
    // or 26 letters
    let mut total = 0;
    let mut check = 0;
    for c in 0..2000 {
        let n = if c % 10 == 0 { 1 + next_random(mut seed) % 300 } else { 1 + next_random(mut seed) % 12 };
        let letters = if c % 3 == 0 { 2 } else if c % 3 == 1 { 5 } else { 26 };
        let s = random_word(mut seed, n, letters);
        let t = random_word(mut seed, n, letters);
        let got = min_steps(s, t) as i64;
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random pairs: {total} steps in all, checksum {check}");
}
