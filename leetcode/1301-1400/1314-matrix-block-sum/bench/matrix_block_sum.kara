// LeetCode #1314 bench: the ★ arm (a table of sums over every top-left
// rectangle, each block's sum four lookups) on 20 matrices of 100 by 100,
// the constraints' most, with numbers up to 100, built once; then 200
// passes, each setting one number of every matrix and choosing k from 1 to
// 100, mostly small, both from the checksum so far, so no answer carries
// over, answering it and folding two of its sums, at places chosen by the
// checksum, plus the pass into the checksum.

fn matrix_block_sum(mat: Vec[Vec[i64]], k: i64) -> Vec[Vec[i64]] {
    let m = mat.len();
    let n = mat[0].len();
    let mut sums: Vec[Vec[i64]] = Vec.filled(m + 1, Vec.filled(n + 1, 0));
    for i in 0..m {
        for j in 0..n {
            sums[i + 1][j + 1] = mat[i][j] + sums[i][j + 1] + sums[i + 1][j] - sums[i][j];
        }
    }
    let mut out: Vec[Vec[i64]] = Vec.filled(m, Vec.filled(n, 0));
    for i in 0..m {
        let top = (i - k).max(0);
        let bottom = (i + k + 1).min(m);
        for j in 0..n {
            let left = (j - k).max(0);
            let right = (j + k + 1).min(n);
            out[i][j] = sums[bottom][right] - sums[top][right] - sums[bottom][left] + sums[top][left];
        }
    }
    out
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 100;
    let mut seed = 1314;
    let mut mats: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..20 {
        let mut mat: Vec[Vec[i64]] = Vec.new();
        for _ in 0..n {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..n {
                row.push(1 + next_random(mut seed) % 100);
            }
            mat.push(row);
        }
        mats.push(mat);
    }
    let mut check: i64 = 0;
    for pass in 0..200 {
        for g in 0..20 {
            mats[g][check % n][(check / 7) % n] = 1 + (check / 11) % 100;
            let k = if check % 4 == 0 { 1 + (check / 13) % 100 } else { 1 + (check / 13) % 5 };
            let got = matrix_block_sum(mats[g], k);
            check = (check * 31 + got[(check / 3) % n][(check / 17) % n]) % 1000000007;
            check = (check * 31 + got[(check / 19) % n][(check / 23) % n] + pass) % 1000000007;
        }
    }
    println(f"200 passes over 20 matrices of 100 by 100: checksum {check}");
}
