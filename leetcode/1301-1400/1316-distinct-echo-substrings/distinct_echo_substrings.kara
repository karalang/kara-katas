// LeetCode #1316: Distinct Echo Substrings -- the ★ arm: how far the
// suffixes from every two places agree, in a table filled from the back;
// a piece of length 2h from i is an echo when the suffixes from i and i + h
// agree for h letters, and it is counted at the first place it starts,
// which is when no earlier suffix agrees with the one from i for all 2h
// letters. O(n^2) time and space, no set

fn distinct_echo_substrings(text: String) -> i32 {
    let s = text.bytes();
    let n = s.len();
    // agree[i][j]: how many letters the suffixes from i and from j share
    let mut agree: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(n + 1, 0));
    for i in (0..n).rev() {
        for j in (i + 1..n).rev() {
            if s[i] == s[j] {
                agree[i][j] = agree[i + 1][j + 1] + 1;
            }
        }
    }
    // earlier[j]: the longest piece from j that also starts somewhere before j
    let mut earlier: Vec[i64] = Vec.filled(n, 0);
    for i in 0..n {
        for j in i + 1..n {
            earlier[j] = earlier[j].max(agree[i][j]);
        }
    }
    let mut count = 0;
    for i in 0..n {
        for h in 1..=(n - i) / 2 {
            if agree[i][i + h] >= h and 2 * h > earlier[i] {
                count += 1;
            }
        }
    }
    count as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn ask(s: Str) -> i32 {
    distinct_echo_substrings(s.to_string())
}

fn main() {
    // LeetCode's two examples; one letter; four of one letter, with "aa" and
    // "aaaa"; an echo that is also found again later; and 300 of one letter
    println(f"{ask("abcabcabc")} {ask("leetcodeleetcode")} {ask("a")} {ask("aaaa")} {ask("ababxabab")} {ask("a".repeat(300))}");
    // 400 random strings of 1 to 300 letters over 1, 2, 3 or 26 letters,
    // every other one a block of 1 to 6 letters said over and over with a
    // few letters changed
    let letters = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z'];
    let mut seed = 1316;
    let mut total = 0;
    let mut check = 0;
    for t in 0..400 {
        let n = 1 + next_random(mut seed) % 300;
        let k = if t % 4 == 0 { 1 } else if t % 4 == 1 { 2 } else if t % 4 == 2 { 3 } else { 26 };
        let mut chars: Vec[char] = Vec.new();
        if t % 2 == 0 {
            let b = 1 + next_random(mut seed) % 6;
            let mut block: Vec[char] = Vec.new();
            for _ in 0..b {
                block.push(letters[next_random(mut seed) % 26]);
            }
            for i in 0..n {
                chars.push(block[i % b]);
            }
            let changes = next_random(mut seed) % 4;
            for _ in 0..changes {
                let at = next_random(mut seed) % n;
                chars[at] = letters[next_random(mut seed) % 26];
            }
        } else {
            for _ in 0..n {
                chars.push(letters[next_random(mut seed) % k]);
            }
        }
        let s: String = chars.iter().collect();
        let got = distinct_echo_substrings(s) as i64;
        total += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"400 random strings: echoes total {total}, checksum {check}");
}
