// LeetCode #1316: Distinct Echo Substrings -- the hash arm: a rolling hash
// of every prefix under two primes, so that any piece's hash is two
// lookups; the halves compared by hash, and each echo kept in a `Set` as
// its two hashes and its length. O(n^2), exact unless two pieces collide
// under both primes at once

fn distinct_echo_substrings(text: String) -> i32 {
    let s = text.bytes();
    let n = s.len();
    let mods = [1000000007, 998244353];
    let base = 131;
    let mut pre: Vec[Vec[i64]] = Vec.new();
    let mut pow: Vec[Vec[i64]] = Vec.new();
    for m in mods {
        let mut p: Vec[i64] = Vec.filled(n + 1, 0);
        let mut w: Vec[i64] = Vec.filled(n + 1, 1);
        for i in 0..n {
            p[i + 1] = (p[i] * base + s[i]) % m;
            w[i + 1] = w[i] * base % m;
        }
        pre.push(p);
        pow.push(w);
    }
    let mut found: Set[(i64, i64, i64)] = Set.new();
    for h in 1..=n / 2 {
        for i in 0..=n - 2 * h {
            let mut hs = [0, 0, 0, 0];
            for k in 0..2 {
                let m = mods[k];
                let first = (pre[k][i + h] - pre[k][i] * pow[k][h] % m + m) % m;
                let second = (pre[k][i + 2 * h] - pre[k][i + h] * pow[k][h] % m + m) % m;
                hs[2 * k] = first;
                hs[2 * k + 1] = second;
            }
            if hs[0] == hs[1] and hs[2] == hs[3] {
                let whole0 = (hs[0] * pow[0][h] + hs[1]) % mods[0];
                let whole1 = (hs[2] * pow[1][h] + hs[3]) % mods[1];
                found.insert((whole0, whole1, h));
            }
        }
    }
    found.len() as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn ask(s: Str) -> i32 {
    distinct_echo_substrings(s.to_string())
}

fn main() {
    // LeetCode's two examples; one letter; four of one letter, with "aa" and
    // "aaaa"; an echo that is also found again later; and 300 of one letter
    println(f"{ask("abcabcabc")} {ask("leetcodeleetcode")} {ask("a")} {ask("aaaa")} {ask("ababxabab")} {ask("a".repeat(300))}");
    // 400 random strings of 1 to 300 letters over 1, 2, 3 or 26 letters,
    // every other one a block of 1 to 6 letters said over and over with a
    // few letters changed
    let letters = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z'];
    let mut seed = 1316;
    let mut total = 0;
    let mut check = 0;
    for t in 0..400 {
        let n = 1 + next_random(mut seed) % 300;
        let k = if t % 4 == 0 { 1 } else if t % 4 == 1 { 2 } else if t % 4 == 2 { 3 } else { 26 };
        let mut chars: Vec[char] = Vec.new();
        if t % 2 == 0 {
            let b = 1 + next_random(mut seed) % 6;
            let mut block: Vec[char] = Vec.new();
            for _ in 0..b {
                block.push(letters[next_random(mut seed) % 26]);
            }
            for i in 0..n {
                chars.push(block[i % b]);
            }
            let changes = next_random(mut seed) % 4;
            for _ in 0..changes {
                let at = next_random(mut seed) % n;
                chars[at] = letters[next_random(mut seed) % 26];
            }
        } else {
            for _ in 0..n {
                chars.push(letters[next_random(mut seed) % k]);
            }
        }
        let s: String = chars.iter().collect();
        let got = distinct_echo_substrings(s) as i64;
        total += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"400 random strings: echoes total {total}, checksum {check}");
}
