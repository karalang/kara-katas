// LeetCode #1395: Count Number of Teams -- differential test of
// the five arms against the statement read literally, with five more
// properties.

// ---- num_teams.kara ----
fn a0_num_teams(rating: Vec[i32]) -> i32 {
    let n = rating.len();
    let mut teams = 0;
    for j in 0..n {
        let mut (less_left, greater_left) = (0, 0);
        let mut (less_right, greater_right) = (0, 0);
        for i in 0..j {
            if rating[i] < rating[j] {
                less_left += 1;
            } else {
                greater_left += 1;
            }
        }
        for k in j + 1..n {
            if rating[k] < rating[j] {
                less_right += 1;
            } else {
                greater_right += 1;
            }
        }
        teams += less_left * greater_right + greater_left * less_right;
    }
    teams
}

// ---- num_teams_pairs.kara ----
fn a1_num_teams(rating: Vec[i32]) -> i32 {
    let n = rating.len();
    let mut rising_pairs: Vec[i32] = Vec.filled(n, 0);
    let mut falling_pairs: Vec[i32] = Vec.filled(n, 0);
    let mut teams: i32 = 0;
    for k in 0..n {
        for j in 0..k {
            if rating[j] < rating[k] {
                rising_pairs[k] += 1;
                teams += rising_pairs[j];
            } else {
                falling_pairs[k] += 1;
                teams += falling_pairs[j];
            }
        }
    }
    teams
}

// ---- num_teams_fenwick.kara ----
struct A2Fenwick {
    tree: Vec[i64],
}

impl A2Fenwick {
    fn a2_new(size: i64) -> A2Fenwick {
        A2Fenwick { tree: Vec.filled(size + 1, 0) }
    }

    // one more at rank r (counted from 1)
    fn a2_add(mut ref self, r: i64) {
        let mut i = r;
        while i < self.tree.len() {
            self.tree[i] += 1;
            i += i & -i;
        }
    }

    // how many at the ranks 1 to r
    fn a2_upto(ref self, r: i64) -> i64 {
        let mut i = r;
        let mut total = 0;
        while i > 0 {
            total += self.tree[i];
            i -= i & -i;
        }
        total
    }
}

fn a2_num_teams(rating: Vec[i32]) -> i32 {
    let n = rating.len();
    let mut sorted = rating.clone();
    sorted.sort();
    let mut left = A2Fenwick.a2_new(n);
    let mut teams = 0;
    for j in 0..n {
        // rank of rating[j] among all, from 1
        let r = sorted.binary_search(rating[j]).unwrap() + 1;
        let less_left = left.a2_upto(r - 1);
        let greater_left = j - less_left;
        let less_right = r - 1 - less_left;
        let greater_right = n - r - greater_left;
        teams += less_left * greater_right + greater_left * less_right;
        left.a2_add(r);
    }
    teams as i32
}

// ---- num_teams_sorted.kara ----
fn a3_num_teams(rating: Vec[i32]) -> i32 {
    let mut left: SortedSet[i32] = SortedSet.new();
    let mut right: SortedSet[i32] = rating.iter().collect();
    let mut teams: i64 = 0;
    for x in rating.iter() {
        right.remove(x);
        let less_left = left.range(i32.MIN, x).count();
        let greater_left = left.len() - less_left;
        let less_right = right.range(i32.MIN, x).count();
        let greater_right = right.len() - less_right;
        teams += less_left * greater_right + greater_left * less_right;
        left.insert(x);
    }
    teams as i32
}

// ---- num_teams_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_num_teams(rating: Vec[i32]) -> i32 {
        let n = rating.len();
        let mut res = 0;
        for j in 1..n - 1 {
            let mut (ll, lg, rl, rg) = (0, 0, 0, 0);
            for i in 0..j {
                if rating[i] < rating[j] {
                    ll += 1;
                } else if rating[i] > rating[j] {
                    lg += 1;
                }
            }
            for k in j + 1..n {
                if rating[k] < rating[j] {
                    rl += 1;
                } else if rating[k] > rating[j] {
                    rg += 1;
                }
            }
            res += ll * rg + lg * rl;
        }
        res
    }
}

fn a4_num_teams(rating: Vec[i32]) -> i32 {
    A4Solution.a4_num_teams(rating)
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n distinct ratings: 1 to n shuffled, each times a scale from 1 to `most`
fn drawn(n: i64, most: i64, seed: mut ref i64) -> Vec[i32] {
    let mut out: Vec[i32] = (1..=n).map(|v| v as i32).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        out.swap(i, j);
    }
    let scale = (1 + next_random(mut seed) % most) as i32;
    out.iter().map(|v| v * scale).collect()
}

// the statement read literally: every three soldiers i < j < k tried,
// and those whose ratings rise or fall all the way counted
fn literal(rating: Vec[i32]) -> i64 {
    let n = rating.len();
    let mut teams = 0;
    for i in 0..n {
        for j in i + 1..n {
            for k in j + 1..n {
                let (a, b, c) = (rating[i], rating[j], rating[k]);
                if (a < b and b < c) or (a > b and b > c) {
                    teams += 1;
                }
            }
        }
    }
    teams
}

// the pairs i < j whose ratings rise
fn rising_pairs(rating: Vec[i32]) -> i64 {
    let mut pairs = 0;
    for i in 0..rating.len() {
        for j in i + 1..rating.len() {
            if rating[i] < rating[j] {
                pairs += 1;
            }
        }
    }
    pairs
}

fn arm(i: i64, rating: Vec[i32]) -> i64 {
    match i {
        0 => a0_num_teams(rating),
        1 => a1_num_teams(rating),
        2 => a2_num_teams(rating),
        3 => a3_num_teams(rating),
        _ => a4_num_teams(rating),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, rating: Vec[i32]) {
    t.cases += 1;
    let want = literal(rating);
    t.check = (t.check * 131 + want * 7 + rating.len()) % 1000000007;
    let star = arm(0, rating);
    let top = rating.iter().max().unwrap();
    let reversed: Vec[i32] = rating.iter().rev().collect();
    let flipped: Vec[i32] = rating.iter().map(|r| top + 1 - r).collect();
    let mut tallest = rating.clone();
    tallest.push(top + 1);
    let pairs = rising_pairs(rating);
    let tripled: Vec[i32] = rating.iter().map(|r| r * 3).collect();
    for i in 0..5 {
        let got = arm(i, rating);
        let what = f"arm {i} on {rating}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: the line read from the other end: the same
        let rv = arm(i, reversed);
        expect(mut t, 2, rv == got, f"P2 {what}, reversed: {rv}");
        // P3: each rating r made top + 1 - r, so rising is falling: the same
        let fl = arm(i, flipped);
        expect(mut t, 3, fl == got, f"P3 {what}, flipped: {fl}");
        // P4: a soldier taller than all added at the end: one more team for
        // each rising pair
        let ta = arm(i, tallest);
        expect(mut t, 4, ta == got + pairs, f"P4 {what}, a tallest soldier added: {ta}, rising pairs {pairs}");
        // P5: every rating three times as large: the same
        let tr = arm(i, tripled);
        expect(mut t, 5, tr == got, f"P5 {what}, tripled: {tr}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    let mut cases: Vec[Vec[i32]] = Vec.new();
    // LeetCode's three examples
    cases.push([2, 5, 3, 4, 1]);
    cases.push([2, 1, 3]);
    cases.push([1, 2, 3, 4]);
    // 2000 lines of 3 to 14 soldiers, 1 to n shuffled and scaled by up to
    // 100, leaving room for P4 and P5 inside the constraints. Every case
    // is drawn before any arm answers.
    let mut seed = 13951;
    for _ in 0..2000 {
        let n = 3 + next_random(mut seed) % 12;
        cases.push(drawn(n, 100, mut seed));
    }
    for rating in cases.iter() {
        check_case(mut t, rating);
    }
    println(f"{t.cases} lines: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
