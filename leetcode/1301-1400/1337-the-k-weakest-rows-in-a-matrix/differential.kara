// LeetCode #1337: The K Weakest Rows in a Matrix -- differential test of
// the five arms against the statement read literally, with five more
// properties.
//
// The statement: you are given an m x n binary matrix mat of 1's
// (soldiers) and 0's (civilians); the soldiers stand in front of the
// civilians in each row. A row i is weaker than a row j if the number of
// soldiers in row i is less than in row j, or both have the same number
// and i < j. Return the indices of the k weakest rows, ordered from
// weakest to strongest.

// ---- k_weakest_rows.kara ----
fn a0_soldiers(row: Vec[i32]) -> i64 {
    let mut low = 0;
    let mut high = row.len();
    while low < high {
        let mid = (low + high) / 2;
        if row[mid] == 1 {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    low
}

fn a0_k_weakest_rows(mat: Vec[Vec[i32]], k: i32) -> Vec[i32] {
    let mut rows: Vec[(i64, i64)] = Vec.new();
    for (i, row) in mat.iter().enumerate() {
        rows.push((a0_soldiers(row), i));
    }
    rows.sort();
    rows.iter().take(k).map(|p| p.1 as i32).collect()
}

// ---- k_weakest_rows_sum.kara ----
fn a1_k_weakest_rows(mat: Vec[Vec[i32]], k: i32) -> Vec[i32] {
    let counts: Vec[i32] = mat.iter().map(|row| row.iter().sum()).collect();
    let mut order: Vec[i32] = (0..mat.len() as i32).collect();
    order.sort_by_key(|i| counts[i]);
    order.truncate(k);
    order
}

// ---- k_weakest_rows_heap.kara ----
fn a2_k_weakest_rows(mat: Vec[Vec[i32]], k: i32) -> Vec[i32] {
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.max_first();
    for (i, row) in mat.iter().enumerate() {
        let count = row.iter().filter(|x| x == 1).count();
        queue.push((count, i));
        if queue.len() > k {
            queue.pop();
        }
    }
    let mut rows: Vec[i32] = Vec.new();
    while let Some((_, i)) = queue.pop() {
        rows.push(i as i32);
    }
    rows.reverse();
    rows
}

// ---- k_weakest_rows_columns.kara ----
fn a3_k_weakest_rows(mat: Vec[Vec[i32]], k: i32) -> Vec[i32] {
    let m = mat.len();
    let n = mat[0].len();
    let mut rows: Vec[i32] = Vec.new();
    for c in 0..n {
        for r in 0..m {
            if mat[r][c] == 0 and (c == 0 or mat[r][c - 1] == 1) {
                rows.push(r as i32);
            }
        }
    }
    for r in 0..m {
        if mat[r][n - 1] == 1 {
            rows.push(r as i32);
        }
    }
    rows.truncate(k);
    rows
}

// ---- k_weakest_rows_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_k_weakest_rows(mat: Vec[Vec[i32]], k: i32) -> Vec[i32] {
        let mut rows: Vec[(i32, i64)] = mat.iter().enumerate().map(|(i, r)| (r.iter().sum(), i)).collect();
        rows.sort();
        rows.iter().take(k).map(|(_, i)| i as i32).collect()
    }
}

fn a4_k_weakest_rows(mat: Vec[Vec[i32]], k: i32) -> Vec[i32] {
    A4Solution.a4_k_weakest_rows(mat, k)
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the statement read literally: each row's soldiers counted one by one;
// a row's place is the number of rows weaker than it, by fewer soldiers or
// as many and a smaller index; the rows of the first k places, in order
fn literal(mat: Vec[Vec[i32]], k: i64) -> Vec[i32] {
    let m = mat.len();
    let mut count: Vec[i64] = Vec.new();
    for row in mat.iter() {
        let mut s = 0;
        for x in row.iter() {
            if x == 1 {
                s += 1;
            }
        }
        count.push(s);
    }
    let mut out: Vec[i32] = Vec.filled(k, -1);
    for i in 0..m {
        let mut place = 0;
        for j in 0..m {
            if count[j] < count[i] or (count[j] == count[i] and j < i) {
                place += 1;
            }
        }
        if place < k {
            out[place] = i as i32;
        }
    }
    out
}

struct Case {
    mat: Vec[Vec[i32]],
    k: i32,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, mat: Vec[Vec[i32]], k: i32) -> Vec[i32] {
    match i {
        0 => a0_k_weakest_rows(mat, k),
        1 => a1_k_weakest_rows(mat, k),
        2 => a2_k_weakest_rows(mat, k),
        3 => a3_k_weakest_rows(mat, k),
        _ => a4_k_weakest_rows(mat, k),
    }
}

fn check_case(t: mut ref Tally, c: Case) {
    t.cases += 1;
    let m = c.mat.len();
    let n = c.mat[0].len();
    let want = literal(c.mat, c.k);
    for r in want.iter() {
        t.check = (t.check * 131 + r) % 1000000007;
    }
    t.check = (t.check * 131 + 7) % 1000000007;
    let mut civilian_after: Vec[Vec[i32]] = Vec.new();
    let mut soldier_before: Vec[Vec[i32]] = Vec.new();
    for row in c.mat.iter() {
        let mut wider = row.clone();
        wider.push(0);
        civilian_after.push(wider);
        let mut front: Vec[i32] = [1];
        front.extend(row.iter());
        soldier_before.push(front);
    }
    let mut strong_below = c.mat.clone();
    strong_below.push(Vec.filled(n, 1));
    let star = a0_k_weakest_rows(c.mat, c.k);
    for i in 0..5 {
        let got = arm(i, c.mat, c.k);
        let what = f"arm {i} on {c.mat}, k {c.k}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: a civilian added at the end of every row: the same answer
        let ca = arm(i, civilian_after, c.k);
        expect(mut t, 2, ca == got, f"P2 {what}, a civilian after: {ca}");
        // P3: a soldier added at the front of every row: the same answer
        let sb = arm(i, soldier_before, c.k);
        expect(mut t, 3, sb == got, f"P3 {what}, a soldier before: {sb}");
        // P4: every row asked for: the answer is its first k
        let every = arm(i, c.mat, m as i32);
        let first: Vec[i32] = every.iter().take(c.k).cloned().collect();
        expect(mut t, 4, first == got and every.len() == m, f"P4 {what}, every row: {every}");
        // P5: a row of nothing but soldiers added below: the same answer
        let sbw = arm(i, strong_below, c.k);
        expect(mut t, 5, sbw == got, f"P5 {what}, a strong row below: {sbw}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 matrices of 2 to 6 rows and 2 to 6 columns, in four kinds, 500
    // each: 0 to n soldiers a row; 0 or 1; every row alike; and each row
    // seven more than the last, taken modulo n + 1. k runs from 1 to m.
    // Every matrix is drawn before any arm answers.
    let mut seed = 13371;
    let mut cases: Vec[Case] = Vec.new();
    for c in 0..2000 {
        let kind = c / 500;
        let m = 2 + next_random(mut seed) % 5;
        let n = 2 + next_random(mut seed) % 5;
        let alike = next_random(mut seed) % (n + 1);
        let mut mat: Vec[Vec[i32]] = Vec.new();
        for r in 0..m {
            let soldiers = if kind == 0 {
                next_random(mut seed) % (n + 1)
            } else if kind == 1 {
                next_random(mut seed) % 2
            } else if kind == 2 {
                alike
            } else {
                (r * 7 + alike) % (n + 1)
            };
            let mut row: Vec[i32] = Vec.filled(n, 0);
            for x in 0..soldiers {
                row[x] = 1;
            }
            mat.push(row);
        }
        let k = (1 + next_random(mut seed) % m) as i32;
        cases.push(Case { mat, k });
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} matrices: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
