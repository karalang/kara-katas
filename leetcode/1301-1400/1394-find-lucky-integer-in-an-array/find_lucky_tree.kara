// LeetCode #1394: Find Lucky Integer in an Array -- the counts in a
// `SortedMap`, walked from its largest key down with `iter().rev()`, the
// first key whose count is itself the answer. O(n log n)

fn find_lucky(arr: Vec[i32]) -> i32 {
    let mut count: SortedMap[i32, i32] = SortedMap.new();
    for x in arr.iter() {
        let seen = count.get(x).cloned().unwrap_or(0);
        count.insert(x, seen + 1);
    }
    for (x, c) in count.iter().rev() {
        if x == c {
            return x;
        }
    }
    -1
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n values from 1 to `most`; half the time a value x is first written x
// times, when there is room, so that it may be lucky; then shuffled
fn drawn(n: i64, most: i64, seed: mut ref i64) -> Vec[i32] {
    let mut out: Vec[i32] = Vec.new();
    let x = 1 + next_random(mut seed) % most;
    if x <= n and next_random(mut seed) % 2 == 0 {
        out = Vec.filled(x, x as i32);
    }
    while out.len() < n {
        out.push((1 + next_random(mut seed) % most) as i32);
    }
    for i in (1..out.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        out.swap(i, j);
    }
    out
}

fn main() {
    // LeetCode's three examples; one 1; five 5s; one 7
    let mut shown: Vec[String] = Vec.new();
    shown.push(f"{find_lucky([2, 2, 3, 4])}");
    shown.push(f"{find_lucky([1, 2, 2, 3, 3, 3])}");
    shown.push(f"{find_lucky([2, 2, 2, 3, 3])}");
    shown.push(f"{find_lucky([1])}");
    shown.push(f"{find_lucky([5, 5, 5, 5, 5])}");
    shown.push(f"{find_lucky([7])}");
    println(shown.join(" "));
    // the constraints' most, 500 values: 500 of 500; 499 of 499 and a 1;
    // drawn from 1 to 500, and from 1 to 30
    let mut seed = 1394;
    let mut last = Vec.filled(499, 499i32);
    last.push(1);
    let mut big: Vec[String] = Vec.new();
    big.push(f"{find_lucky(Vec.filled(500, 500i32))}");
    big.push(f"{find_lucky(last)}");
    big.push(f"{find_lucky(drawn(500, 500, mut seed))}");
    big.push(f"{find_lucky(drawn(500, 30, mut seed))}");
    println(f"500 values: {big.join(" ")}");
    // 2000 random arrays of 1 to 60 values, from 1 to at most 12 or 500
    let mut check: i64 = 0;
    let mut total: i64 = 0;
    for c in 0..2000 {
        let n = 1 + next_random(mut seed) % 60;
        let most = 1 + next_random(mut seed) % (if c % 2 == 0 { 12 } else { 500 });
        let got = find_lucky(drawn(n, most, mut seed));
        total += got;
        check = (check * 131 + got + 1) % 1000000007;
    }
    println(f"2000 random arrays: {total} in all, checksum {check}");
}
