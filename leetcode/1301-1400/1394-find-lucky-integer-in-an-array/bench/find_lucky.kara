// LeetCode #1394 bench: the ★ arm (a count for each value from 1 to 500,
// read from the top down) on 500 values, one value changed before each
// of 600000 rounds.

fn find_lucky(arr: Vec[i32]) -> i32 {
    let mut count: Vec[i32] = Vec.filled(501, 0);
    for x in arr.iter() {
        count[x] += 1;
    }
    for x in (1i32..=500).rev() {
        if count[x] == x {
            return x;
        }
    }
    -1
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 500;
    let mut seed = 1394;
    let mut arr: Vec[i32] = Vec.new();
    for _ in 0..n {
        arr.push((1 + next_random(mut seed) % 40) as i32);
    }
    let mut check: i64 = 0;
    for _ in 0..600000 {
        seed = (seed + check) % 2147483648;
        let i = next_random(mut seed) % n;
        arr[i] = (1 + next_random(mut seed) % 40) as i32;
        check = (check * 131 + find_lucky(arr) + 1) % 1000000007;
    }
    println(f"600000 rounds over 500 values: checksum {check}");
}
