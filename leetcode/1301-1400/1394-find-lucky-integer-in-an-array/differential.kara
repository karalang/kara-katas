// LeetCode #1394: Find Lucky Integer in an Array -- differential test of
// the five arms against the statement read literally, with five more
// properties.

// ---- find_lucky.kara ----
fn a0_find_lucky(arr: Vec[i32]) -> i32 {
    let mut count: Vec[i32] = Vec.filled(501, 0);
    for x in arr.iter() {
        count[x] += 1;
    }
    for x in (1i32..=500).rev() {
        if count[x] == x {
            return x;
        }
    }
    -1
}

// ---- find_lucky_map.kara ----
fn a1_find_lucky(arr: Vec[i32]) -> i32 {
    let mut count: Map[i32, i32] = Map.new();
    for x in arr.iter() {
        *count.entry(x).or_insert(0) += 1;
    }
    count.iter().filter(|(x, c)| x == c).map(|(x, _)| x).max().unwrap_or(-1)
}

// ---- find_lucky_sorted.kara ----
fn a2_find_lucky(arr: Vec[i32]) -> i32 {
    let mut values = arr.clone();
    values.sort_by(|a, b| b.cmp(a));
    let mut i = 0;
    while i < values.len() {
        let mut j = i;
        while j < values.len() and values[j] == values[i] {
            j += 1;
        }
        if j - i == values[i] {
            return values[i];
        }
        i = j;
    }
    -1
}

// ---- find_lucky_tree.kara ----
fn a3_find_lucky(arr: Vec[i32]) -> i32 {
    let mut count: SortedMap[i32, i32] = SortedMap.new();
    for x in arr.iter() {
        let seen = count.get(x).cloned().unwrap_or(0);
        count.insert(x, seen + 1);
    }
    for (x, c) in count.iter().rev() {
        if x == c {
            return x;
        }
    }
    -1
}

// ---- find_lucky_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_find_lucky(arr: Vec[i32]) -> i32 {
        let mut freq: Map[i32, i32] = Map.new();
        for x in ref arr {
            *freq.entry(x).or_insert(0) += 1;
        }
        freq.into_iter()
            .filter(|(k, v)| k == v)
            .map(|(k, _)| k)
            .max()
            .unwrap_or(-1)
    }
}

fn a4_find_lucky(arr: Vec[i32]) -> i32 {
    A4Solution.a4_find_lucky(arr)
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// n values from 1 to `most`; half the time a value x is first written x
// times, when there is room, so that it may be lucky; then shuffled
fn drawn(n: i64, most: i64, seed: mut ref i64) -> Vec[i32] {
    let mut out: Vec[i32] = Vec.new();
    let x = 1 + next_random(mut seed) % most;
    if x <= n and next_random(mut seed) % 2 == 0 {
        out = Vec.filled(x, x as i32);
    }
    while out.len() < n {
        out.push((1 + next_random(mut seed) % most) as i32);
    }
    for i in (1..out.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        out.swap(i, j);
    }
    out
}

// how many times x is in the array, counted by looking at every value
fn times(arr: Vec[i32], x: i32) -> i64 {
    let mut count = 0;
    for v in arr.iter() {
        if v == x {
            count += 1;
        }
    }
    count
}

// the statement read literally: every value of the array counted, and
// the largest whose count is itself, or -1
fn literal(arr: Vec[i32]) -> i32 {
    let mut best: i32 = -1;
    for x in arr.iter() {
        if times(arr, x) == x and x > best {
            best = x;
        }
    }
    best
}

fn arm(i: i64, arr: Vec[i32]) -> i32 {
    match i {
        0 => a0_find_lucky(arr),
        1 => a1_find_lucky(arr),
        2 => a2_find_lucky(arr),
        3 => a3_find_lucky(arr),
        _ => a4_find_lucky(arr),
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn check_case(t: mut ref Tally, arr: Vec[i32]) {
    t.cases += 1;
    let want = literal(arr);
    t.check = (t.check * 131 + want * 7 + arr.len()) % 1000000007;
    let star = arm(0, arr);
    let reversed: Vec[i32] = arr.iter().rev().collect();
    // the smallest value not in the array, written that many times more
    let mut fresh: i32 = 1;
    while times(arr, fresh) > 0 {
        fresh += 1;
    }
    let mut planted = arr.clone();
    for _ in 0..fresh {
        planted.push(fresh);
    }
    for i in 0..5 {
        let got = arm(i, arr);
        let what = f"arm {i} on {arr}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: the values in reverse order: the same
        let rv = arm(i, reversed);
        expect(mut t, 2, rv == got, f"P2 {what}, reversed: {rv}");
        // P3: one more of the answer, so it is lucky no longer: a smaller
        // answer, or -1 (nothing to check when the answer is -1)
        if got > 0 {
            let mut more = arr.clone();
            more.push(got);
            let mo = arm(i, more);
            expect(mut t, 3, mo < got, f"P3 {what}, one more {got}: {mo}");
        } else {
            expect(mut t, 3, got == -1, f"P3 {what}: {got} is neither a value nor -1");
        }
        // P4: the smallest value not in the array, written that many
        // times: the larger of it and the answer
        let pl = arm(i, planted);
        expect(mut t, 4, pl == got.max(fresh), f"P4 {what}, {fresh} written {fresh} times: {pl}");
        // P5: -1, or a value of the array found that many times in it
        let fits = got == -1 or times(arr, got) == got;
        expect(mut t, 5, fits, f"P5 {what}: {got} is not lucky");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    let mut cases: Vec[Vec[i32]] = Vec.new();
    // LeetCode's three examples
    cases.push([2, 2, 3, 4]);
    cases.push([1, 2, 2, 3, 3, 3]);
    cases.push([2, 2, 2, 3, 3]);
    // 2000 arrays of 1 to 60 values, from 1 to at most 12 or 500, half of
    // them with a value first written as many times as it is. Every case
    // is drawn before any arm answers.
    let mut seed = 13941;
    for c in 0..2000 {
        let n = 1 + next_random(mut seed) % 60;
        let most = 1 + next_random(mut seed) % (if c % 2 == 0 { 12 } else { 500 });
        cases.push(drawn(n, most, mut seed));
    }
    for arr in cases.iter() {
        check_case(mut t, arr);
    }
    println(f"{t.cases} arrays: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
