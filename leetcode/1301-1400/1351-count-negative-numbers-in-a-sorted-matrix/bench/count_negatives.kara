// LeetCode #1351: Count Negative Numbers in a Sorted Matrix -- the ★ arm:
// a staircase walk from the bottom-left corner. While the value there is
// negative, so is the rest of its row to the right; count them and move
// up a row. Otherwise move right. O(m + n)

fn count_negatives(grid: Vec[Vec[i32]]) -> i32 {
    let n = grid[0].len();
    let mut row = grid.len() - 1;
    let mut col = 0;
    let mut count = 0;
    while row >= 0 and col < n {
        if grid[row][col] < 0 {
            count += n - col;
            row -= 1;
        } else {
            col += 1;
        }
    }
    count as i32
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 50 grids of 100 by 100, the constraints' largest, each from a top
    // of 60 down by random steps of 0 to 1, built once; then 300,000
    // rounds, each moving one cell of one grid, both drawn from the
    // checksum so far, as far as the order allows: up to the smaller of
    // the cells above and to the left, or down to the larger of the cells
    // below and to the right, and counting that grid's negatives
    let mut seed = 1351;
    let mut grids: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..50 {
        let mut grid: Vec[Vec[i32]] = Vec.new();
        for i in 0..100 {
            let mut row: Vec[i32] = Vec.new();
            for j in 0..100 {
                let mut v: i32 = 60;
                if i > 0 {
                    v = v.min(grid[i - 1][j]);
                }
                if j > 0 {
                    v = v.min(row[j - 1]);
                }
                if i + j > 0 {
                    v -= (next_random(mut seed) % 2) as i32;
                }
                row.push(v.max(-100));
            }
            grid.push(row);
        }
        grids.push(grid);
    }
    let mut check: i64 = 0;
    for r in 0..300000 {
        let k = check % 50;
        let i = (check / 50) % 100;
        let j = (check / 5000) % 100;
        if check % 2 == 0 {
            let mut v: i32 = 100;
            if i > 0 {
                v = v.min(grids[k][i - 1][j]);
            }
            if j > 0 {
                v = v.min(grids[k][i][j - 1]);
            }
            grids[k][i][j] = v;
        } else {
            let mut v: i32 = -100;
            if i < 99 {
                v = v.max(grids[k][i + 1][j]);
            }
            if j < 99 {
                v = v.max(grids[k][i][j + 1]);
            }
            grids[k][i][j] = v;
        }
        check = (check * 31 + count_negatives(grids[k]) + r) % 1000000007;
    }
    println(f"300000 rounds over 50 grids of 100 by 100: checksum {check}");
}
