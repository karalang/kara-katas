// LeetCode #1342: Number of Steps to Reduce a Number to Zero -- the
// recursive arm: an odd number is one step from num - 1 and an even one
// one step from num / 2, written as a `match` on the number and its low
// bit. O(log num), as deep

fn number_of_steps(num: i32) -> i32 {
    match (num, num % 2) {
        (0, _) => 0,
        (_, 0) => 1 + number_of_steps(num / 2),
        _ => 1 + number_of_steps(num - 1),
    }
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; zero; one; the constraints' largest, 10^6;
    // and 2^19 - 1, the most steps below 10^6
    println(f"{number_of_steps(14)} {number_of_steps(8)} {number_of_steps(123)} {number_of_steps(0)} {number_of_steps(1)} {number_of_steps(1000000)} {number_of_steps(524287)}");
    // every number from 0 to 10^6
    let mut total: i64 = 0;
    let mut check: i64 = 0;
    for num in 0..1000001 {
        let steps = number_of_steps(num as i32);
        total += steps;
        check = (check * 131 + steps) % 1000000007;
    }
    println(f"0 to 10^6: {total} steps, checksum {check}");
}
