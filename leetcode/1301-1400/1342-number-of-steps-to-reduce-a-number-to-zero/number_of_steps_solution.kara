// LeetCode #1342: Number of Steps to Reduce a Number to Zero -- a Rust
// solution as LeetCode's Rust users write it (the parameter taken as `mut
// num: i32`, a `while num != 0` loop with `num /= 2` or `num -= 1` chosen
// by `num % 2 == 0`, and the count in `let mut steps = 0`), carried to Kāra
// by `karac fix`.

struct Solution {}

impl Solution {
    pub fn number_of_steps(num: i32) -> i32 {
        let mut num = num;
        let mut steps = 0;
        while num != 0 {
            if num % 2 == 0 {
                num /= 2;
            } else {
                num -= 1;
            }
            steps += 1;
        }
        steps
    }
}

fn number_of_steps(num: i32) -> i32 {
    Solution.number_of_steps(num)
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples; zero; one; the constraints' largest, 10^6;
    // and 2^19 - 1, the most steps below 10^6
    println(f"{number_of_steps(14)} {number_of_steps(8)} {number_of_steps(123)} {number_of_steps(0)} {number_of_steps(1)} {number_of_steps(1000000)} {number_of_steps(524287)}");
    // every number from 0 to 10^6
    let mut total: i64 = 0;
    let mut check: i64 = 0;
    for num in 0..1000001 {
        let steps = number_of_steps(num as i32);
        total += steps;
        check = (check * 131 + steps) % 1000000007;
    }
    println(f"0 to 10^6: {total} steps, checksum {check}");
}
