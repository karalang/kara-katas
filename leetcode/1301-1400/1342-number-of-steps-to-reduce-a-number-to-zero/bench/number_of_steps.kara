// LeetCode #1342 bench: the ★ arm (halve an even number, take one from an
// odd one, count the steps) over every number from 0 to 10^6, the
// constraints' range, 5 times; each number is offset by the checksum so
// far, so no answer can be computed ahead, and the answer plus the pass is
// folded into the checksum.

fn number_of_steps(num: i32) -> i32 {
    let mut n = num;
    let mut steps = 0;
    while n > 0 {
        if n % 2 == 0 {
            n /= 2;
        } else {
            n -= 1;
        }
        steps += 1;
    }
    steps
}

fn main() {
    let mut check: i64 = 0;
    for pass in 0..5 {
        for x in 0..1000001 {
            let steps = number_of_steps(((x + check) % 1000001) as i32);
            check = (check * 31 + steps + pass) % 1000000007;
        }
    }
    println(f"5 passes over 10^6 + 1 numbers: checksum {check}");
}
