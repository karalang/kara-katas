// LeetCode #1306 bench: the ★ arm (a breadth-first walk from the start in a
// `VecDeque`, each place queued once) on 10 arrays of 5 * 10^4 places, the
// constraints' most, with jumps from 1 to 10 and one 0, built once; then 300
// passes, each setting one place of every array to a value from 0 to 10 and
// choosing the start, both from the checksum so far, so no answer carries
// over, answering it and folding the answer and the pass into the checksum.

fn can_reach(arr: Vec[i64], start: i64) -> bool {
    let n = arr.len();
    let mut seen: Vec[bool] = Vec.filled(n, false);
    let mut queue: VecDeque[i64] = VecDeque.new();
    queue.push_back(start);
    seen[start] = true;
    while let Some(i) = queue.pop_front() {
        if arr[i] == 0 {
            return true;
        }
        for j in [i + arr[i], i - arr[i]] {
            if j >= 0 and j < n and not seen[j] {
                seen[j] = true;
                queue.push_back(j);
            }
        }
    }
    false
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 50000;
    let mut seed = 1306;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..10 {
        let mut arr: Vec[i64] = Vec.new();
        for _ in 0..n {
            arr.push(1 + next_random(mut seed) % 10);
        }
        let at = next_random(mut seed) % n;
        arr[at] = 0;
        arrays.push(arr);
    }
    let mut check: i64 = 0;
    for pass in 0..300 {
        for a in 0..10 {
            arrays[a][check % n] = (check / 7) % 11;
            let start = (check / 13) % n;
            let got = can_reach(arrays[a], start);
            check = (check * 31 + if got { 1 } else { 2 } + pass) % 1000000007;
        }
    }
    println(f"300 passes over 10 arrays of 5 * 10^4: checksum {check}");
}
