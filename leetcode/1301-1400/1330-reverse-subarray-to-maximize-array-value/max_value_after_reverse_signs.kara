// LeetCode #1330: Reverse Subarray To Maximize Array Value -- the signs
// arm: a reversal from after pair (a, b) through pair (c, d) gains
// |a - c| + |b - d| - |a - b| - |c - d|, and |x| is the larger of x and -x,
// so the gain is the best of four sums, s (a - c) + t (b - d) less the two
// old gaps, for s and t each 1 or -1. Each sum splits into a part of the
// left pair and a part of the right one, so one pass keeps the best left
// part of each of the four. Reversals of a prefix or a suffix are tried
// at every place. O(n)

fn max_value_after_reverse(nums: Vec[i32]) -> i32 {
    let n = nums.len();
    let v: Vec[i64] = nums.iter().map(|x| x as i64).collect();
    let mut total = 0;
    let mut gain = 0;
    let mut best: Vec[Option[i64]] = Vec.filled(4, None);
    for j in 0..n - 1 {
        let c = v[j];
        let d = v[j + 1];
        let gap = (c - d).abs();
        total += gap;
        gain = max(gain, (v[0] - d).abs() - gap);
        gain = max(gain, (v[n - 1] - c).abs() - gap);
        for k in 0..4 {
            let s = if k % 2 == 0 { 1 } else { -1 };
            let t = if k / 2 == 0 { 1 } else { -1 };
            if let Some(left) = best[k] {
                gain = max(gain, left - s * c - t * d - gap);
            }
            let here = s * c + t * d - gap;
            best[k] = Some(match best[k] {
                Some(left) => max(left, here),
                None => here,
            });
        }
    }
    (total + gain) as i32
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples; one value; two; all equal; a rise that a
    // reversal of a prefix helps; and 400 values swinging between the
    // constraints' extremes
    let swing: Vec[i32] = (0..400).map(|i| if i % 2 == 0 { 100000 } else { -100000 }).collect();
    let mut climb: Vec[i32] = Vec.new();
    for i in 0..400 {
        climb.push((i * 495 - 99000) as i32);
    }
    println(f"{max_value_after_reverse([2, 3, 1, 5, 4])} {max_value_after_reverse([2, 4, 9, 24, 2, 1, 10])} {max_value_after_reverse([5])} {max_value_after_reverse([1, 9])} {max_value_after_reverse([7, 7, 7, 7])} {max_value_after_reverse([1, 2, 3, 10])} {max_value_after_reverse(swing)} {max_value_after_reverse(climb)}");
    // 600 random arrays of 1 to 400 values, most of them short, the
    // values within 10, 1000 or 100000 either side of 0
    let mut seed = 1330;
    let mut check = 0;
    let mut total = 0;
    for t in 0..600 {
        let n = if t % 20 == 0 { 1 + next_random(mut seed) % 400 } else { 1 + next_random(mut seed) % 12 };
        let reach = if t % 3 == 0 { 10 } else if t % 3 == 1 { 1000 } else { 100000 };
        let mut nums: Vec[i32] = Vec.new();
        for _ in 0..n {
            nums.push((next_random(mut seed) % (2 * reach + 1) - reach) as i32);
        }
        let got = max_value_after_reverse(nums);
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"600 random arrays: values total {total}, checksum {check}");
}
