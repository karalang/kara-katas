// LeetCode #1349: Maximum Students Taking Exam -- the ★ arm: a row's
// students as a bit mask, one bit per seat; a row's mask must sit on good
// seats with no two students side by side, and against the row in front
// no student may sit diagonally behind another, so `mask & (prev << 1)`
// and `mask & (prev >> 1)` must be empty. best[mask] is the most students
// in the rows so far with the last row seated as `mask`. O(m * 4^n)

fn max_students(seats: Vec[Vec[char]]) -> i32 {
    let n = seats[0].len();
    let full = 1 << n;
    let mut best: Vec[i32] = Vec.filled(full, -1);
    best[0] = 0;
    for row in seats.iter() {
        let mut good = 0;
        for j in 0..n {
            if row[j] == '.' {
                good |= 1 << j;
            }
        }
        let mut next: Vec[i32] = Vec.filled(full, -1);
        for mask in 0..full {
            if mask & good != mask or mask & (mask << 1) != 0 {
                continue;
            }
            let here = mask.count_ones() as i32;
            for prev in 0..full {
                if best[prev] < 0 or mask & (prev << 1) != 0 or mask & (prev >> 1) != 0 {
                    continue;
                }
                next[mask] = next[mask].max(best[prev] + here);
            }
        }
        best = next;
    }
    best.iter().cloned().max().unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn grid(rows: Vec[Str]) -> Vec[Vec[char]] {
    rows.iter().map(|r| r.chars().collect()).collect()
}

fn main() {
    // LeetCode's three examples; one good seat; every seat broken; and
    // 8 by 8, the constraints' largest, every seat good, and every seat
    // good but the diagonal
    let e1 = max_students(grid(["#.##.#", ".####.", "#.##.#"]));
    let e2 = max_students(grid([".#", "##", "#.", "##", ".#"]));
    let e3 = max_students(grid(["#...#", ".#.#.", "..#..", ".#.#.", "#...#"]));
    let one = max_students(grid(["."]));
    let none = max_students(grid(["###", "###"]));
    let mut open: Vec[Vec[char]] = Vec.new();
    let mut cross: Vec[Vec[char]] = Vec.new();
    for i in 0..8 {
        open.push(Vec.filled(8, '.'));
        let mut r: Vec[char] = Vec.filled(8, '.');
        r[i] = '#';
        cross.push(r);
    }
    println(f"{e1} {e2} {e3} {one} {none} {max_students(open)} {max_students(cross)}");
    // 2000 random rooms of 1 to 8 rows and columns, each seat good with
    // probability 1/2, 3/4 or 1
    let mut seed = 1349;
    let mut total = 0;
    let mut check = 0;
    for c in 0..2000 {
        let m = 1 + next_random(mut seed) % 8;
        let n = 1 + next_random(mut seed) % 8;
        let broken = if c % 3 == 0 { 2 } else if c % 3 == 1 { 4 } else { 0 };
        let mut seats: Vec[Vec[char]] = Vec.new();
        for _ in 0..m {
            let mut r: Vec[char] = Vec.new();
            for _ in 0..n {
                let bad = broken > 0 and next_random(mut seed) % broken == 0;
                r.push(if bad { '#' } else { '.' });
            }
            seats.push(r);
        }
        let got = max_students(seats) as i64;
        total += got;
        check = (check * 131 + got) % 1000000007;
    }
    println(f"2000 random rooms: {total} students in all, checksum {check}");
}
