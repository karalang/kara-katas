// LeetCode #1372 bench -- the ★ arm: one walk up from the leaves, each
// node reporting the longest zigzag starting at it going left and going
// right, each one more than its child's the other way.

// (the longest zigzag from `node` going left first, going right first)
fn lengths(node: TreeNode, best: mut ref i64) -> (i64, i64) {
    let mut left = 0;
    let mut right = 0;
    if let Some(l) = node.left {
        left = 1 + lengths(l, mut best).1;
    }
    if let Some(r) = node.right {
        right = 1 + lengths(r, mut best).0;
    }
    *best = (*best).max(left).max(right);
    (left, right)
}

fn longest_zig_zag(root: Option[TreeNode]) -> i32 {
    let mut best = 0;
    if let Some(r) = root {
        lengths(r, mut best);
    }
    best as i32
}

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // 20 trees of 5 * 10^4 nodes, the constraints' most, each node hung
    // on a random empty child place, built once; then 300 rounds, each
    // hanging one more leaf on one tree, on a place drawn from the
    // checksum so far, and finding that tree's longest zigzag
    let mut seed = 1372;
    let mut roots: Vec[TreeNode] = Vec.new();
    let mut places: Vec[Vec[(TreeNode, bool)]] = Vec.new();
    for _ in 0..20 {
        let root = TreeNode { val: 1, left: None, right: None };
        let mut free: Vec[(TreeNode, bool)] = [(root, true), (root, false)];
        for _ in 1..50000 {
            let k = next_random(mut seed) % free.len();
            let (parent, left) = free.swap_remove(k);
            let node = TreeNode { val: 1, left: None, right: None };
            if left {
                parent.left = Some(node);
            } else {
                parent.right = Some(node);
            }
            free.push((node, true));
            free.push((node, false));
        }
        roots.push(root);
        places.push(free);
    }
    let mut check: i64 = 0;
    for r in 0..300 {
        let t = check % 20;
        let free = mut ref places[t];
        let k = (check / 20) % free.len();
        let (parent, left) = free.swap_remove(k);
        let node = TreeNode { val: 1, left: None, right: None };
        if left {
            parent.left = Some(node);
        } else {
            parent.right = Some(node);
        }
        free.push((node, true));
        free.push((node, false));
        let got = longest_zig_zag(Some(roots[t])) as i64;
        check = (check * 31 + got + r) % 1000000007;
    }
    println(f"300 rounds over 20 trees of 50000 nodes: checksum {check}");
}
