// LeetCode #1333 bench: the ★ arm (the restaurants that pass the three
// filters sorted by rating and then id, both highest first) on 20 lists of
// 10^4 restaurants, the constraints' most, built once. Then 100 passes,
// each setting one rating of every list from the checksum so far and
// drawing the filters from it too, answering every list and folding the
// answer's length, two of its ids and the pass into the checksum.

fn filter_restaurants(restaurants: Vec[Vec[i32]], vegan_friendly: i32, max_price: i32, max_distance: i32) -> Vec[i32] {
    let mut kept: Vec[(i32, i32)] = Vec.new();
    for r in restaurants.iter() {
        if (vegan_friendly == 0 or r[2] == 1) and r[3] <= max_price and r[4] <= max_distance {
            kept.push((r[1], r[0]));
        }
    }
    kept.sort_by(|a, b| b.0.cmp(a.0).then(b.1.cmp(a.1)));
    kept.iter().map(|p| p.1).collect()
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 10000;
    let mut seed = 1333;
    let mut lists: Vec[Vec[Vec[i32]]] = Vec.new();
    for _ in 0..20 {
        let mut list: Vec[Vec[i32]] = Vec.new();
        for i in 0..n {
            let id = (i * 10 + 1 + next_random(mut seed) % 10) as i32;
            let rating = (1 + next_random(mut seed) % 100000) as i32;
            let vegan = (next_random(mut seed) % 2) as i32;
            let price = (1 + next_random(mut seed) % 100000) as i32;
            let distance = (1 + next_random(mut seed) % 100000) as i32;
            list.push([id, rating, vegan, price, distance]);
        }
        lists.push(list);
    }
    let mut check: i64 = 0;
    for pass in 0..100 {
        let vegan = (pass % 2) as i32;
        let max_price = (50000 + check % 50001) as i32;
        let max_distance = (50000 + check / 7 % 50001) as i32;
        for t in 0..20 {
            let at = check % n;
            lists[t][at][1] = (1 + check / 3 % 100000) as i32;
            let ids = filter_restaurants(lists[t], vegan, max_price, max_distance);
            let k = ids.len();
            check = (check * 31 + k + ids[0] + ids[k / 2] + pass) % 1000000007;
        }
    }
    println(f"100 passes over 20 lists of 10^4: checksum {check}");
}
