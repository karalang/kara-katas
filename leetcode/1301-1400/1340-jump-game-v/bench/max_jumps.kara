// LeetCode #1340 bench: the ★ arm (memoized depth-first search, each
// direction walked outward up to d steps and stopped at the first value
// not lower) on 20 arrays of 1000 values, the constraints' longest, built
// once: half at random from 1 to 10^5 with d = 1000, where most walks stop
// soon, and half rising, each value 100 more than the last give or take
// 99, with d = 300, where every walk to the left runs its d steps; then 20
// passes, each setting one value of every array from the checksum so far,
// so no answer carries over, answering it and folding the answer plus the
// pass into the checksum.

fn most_from(arr: Vec[i32], d: i32, i: i64, memo: mut ref Vec[i32]) -> i32 {
    if memo[i] > 0 {
        return memo[i];
    }
    let mut best = 1;
    for step in [-1, 1] {
        let mut j = i + step;
        while j >= 0 and j < arr.len() and (j - i).abs() <= d and arr[j] < arr[i] {
            best = max(best, 1 + most_from(arr, d, j, mut memo));
            j += step;
        }
    }
    memo[i] = best;
    best
}

fn max_jumps(arr: Vec[i32], d: i32) -> i32 {
    let mut memo: Vec[i32] = Vec.filled(arr.len(), 0);
    let mut best = 0;
    for i in 0..arr.len() {
        best = max(best, most_from(arr, d, i, mut memo));
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let n = 1000;
    let mut seed = 1340;
    let mut arrays: Vec[Vec[i32]] = Vec.new();
    for a in 0..20 {
        let mut arr: Vec[i32] = Vec.new();
        for k in 0..n {
            if a % 2 == 0 {
                arr.push((1 + next_random(mut seed) % 100000) as i32);
            } else {
                arr.push((100 * k + 1 + next_random(mut seed) % 100) as i32);
            }
        }
        arrays.push(arr);
    }
    let mut check: i64 = 0;
    for pass in 0..20 {
        for a in 0..20 {
            arrays[a][check % n] = (1 + (check / 7) % 100000) as i32;
            let d = if a % 2 == 0 { 1000 } else { 300 };
            let answer = max_jumps(arrays[a], d);
            check = (check * 31 + answer + pass) % 1000000007;
        }
    }
    println(f"20 passes over 20 arrays of 1000: checksum {check}");
}
