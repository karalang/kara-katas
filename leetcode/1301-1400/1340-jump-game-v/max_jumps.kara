// LeetCode #1340: Jump Game V -- the ★ arm: a jump always lands lower, so
// the jumps from an index never come back to it, and the most indices
// visited from i is 1 + the most from any index it can reach. Memoized
// depth-first search: from i, each direction is walked outward up to d
// steps and stops at the first value not lower than arr[i], since that one
// blocks everything past it. O(n * d), as deep as the longest descent

fn most_from(arr: Vec[i32], d: i32, i: i64, memo: mut ref Vec[i32]) -> i32 {
    if memo[i] > 0 {
        return memo[i];
    }
    let mut best = 1;
    for step in [-1, 1] {
        let mut j = i + step;
        while j >= 0 and j < arr.len() and (j - i).abs() <= d and arr[j] < arr[i] {
            best = max(best, 1 + most_from(arr, d, j, mut memo));
            j += step;
        }
    }
    memo[i] = best;
    best
}

fn max_jumps(arr: Vec[i32], d: i32) -> i32 {
    let mut memo: Vec[i32] = Vec.filled(arr.len(), 0);
    let mut best = 0;
    for i in 0..arr.len() {
        best = max(best, most_from(arr, d, i, mut memo));
    }
    best
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; one value; 1000 values rising, the
    // constraints' longest, with d = 1000; and 1000 values at random up to
    // 10^5 with d = 1000 and with d = 10
    let e1 = max_jumps([6, 4, 14, 6, 8, 13, 9, 7, 10, 6, 12], 2);
    let e2 = max_jumps([3, 3, 3, 3, 3], 3);
    let e3 = max_jumps([7, 6, 5, 4, 3, 2, 1], 1);
    let one = max_jumps([5], 1);
    let rising: Vec[i32] = (1..1001).collect();
    let mut seed = 1340;
    let mut big: Vec[i32] = Vec.new();
    for _ in 0..1000 {
        big.push((1 + next_random(mut seed) % 100000) as i32);
    }
    println(f"{e1} {e2} {e3} {one} {max_jumps(rising, 1000)} {max_jumps(big, 1000)} {max_jumps(big, 10)}");
    // 1000 random arrays of 1 to 200 values, most of them short, from 1 to
    // 5 or to 10^5, with d from 1 to the length
    let mut check = 0;
    for t in 0..1000 {
        let n = if t % 10 == 0 { 1 + next_random(mut seed) % 200 } else { 1 + next_random(mut seed) % 20 };
        let top = if t % 2 == 0 { 5 } else { 100000 };
        let mut arr: Vec[i32] = Vec.new();
        for _ in 0..n {
            arr.push((1 + next_random(mut seed) % top) as i32);
        }
        let d = (1 + next_random(mut seed) % n) as i32;
        check = (check * 131 + max_jumps(arr, d)) % 1000000007;
    }
    println(f"1000 random arrays: checksum {check}");
}
