// LeetCode #1340: Jump Game V -- the stack arm: O(n). If i can jump to j,
// so can every index on the way that stands above j, so the only jumps
// that matter land on an index from its nearest higher neighbour on either
// side. A stack of indices, their values falling, finds those neighbours:
// when a higher value arrives, the run of equal values on top is popped,
// and each popped index is reached from the newcomer on its right and from
// the index now on top on its left, each within d. A last value higher
// than all, past the end, empties the stack. Values are popped lowest
// first, so each index's answer is final before it is used

fn max_jumps(arr: Vec[i32], d: i32) -> i32 {
    let n = arr.len();
    let mut most: Vec[i32] = Vec.filled(n + 1, 1);
    let mut stack: Vec[i64] = Vec.new();
    for i in 0..n + 1 {
        let here = if i < n { arr[i] } else { i32.MAX };
        while stack.len() > 0 and arr[stack[stack.len() - 1]] < here {
            let low = arr[stack[stack.len() - 1]];
            let mut run: Vec[i64] = Vec.new();
            while stack.len() > 0 and arr[stack[stack.len() - 1]] == low {
                run.push(stack.pop().unwrap());
            }
            for j in run.iter() {
                if i - j <= d {
                    most[i] = max(most[i], most[j] + 1);
                }
                if stack.len() > 0 {
                    let left = stack[stack.len() - 1];
                    if j - left <= d {
                        most[left] = max(most[left], most[j] + 1);
                    }
                }
            }
        }
        stack.push(i);
    }
    most[0..n].iter().max().unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; one value; 1000 values rising, the
    // constraints' longest, with d = 1000; and 1000 values at random up to
    // 10^5 with d = 1000 and with d = 10
    let e1 = max_jumps([6, 4, 14, 6, 8, 13, 9, 7, 10, 6, 12], 2);
    let e2 = max_jumps([3, 3, 3, 3, 3], 3);
    let e3 = max_jumps([7, 6, 5, 4, 3, 2, 1], 1);
    let one = max_jumps([5], 1);
    let rising: Vec[i32] = (1..1001).collect();
    let mut seed = 1340;
    let mut big: Vec[i32] = Vec.new();
    for _ in 0..1000 {
        big.push((1 + next_random(mut seed) % 100000) as i32);
    }
    println(f"{e1} {e2} {e3} {one} {max_jumps(rising, 1000)} {max_jumps(big, 1000)} {max_jumps(big, 10)}");
    // 1000 random arrays of 1 to 200 values, most of them short, from 1 to
    // 5 or to 10^5, with d from 1 to the length
    let mut check = 0;
    for t in 0..1000 {
        let n = if t % 10 == 0 { 1 + next_random(mut seed) % 200 } else { 1 + next_random(mut seed) % 20 };
        let top = if t % 2 == 0 { 5 } else { 100000 };
        let mut arr: Vec[i32] = Vec.new();
        for _ in 0..n {
            arr.push((1 + next_random(mut seed) % top) as i32);
        }
        let d = (1 + next_random(mut seed) % n) as i32;
        check = (check * 131 + max_jumps(arr, d)) % 1000000007;
    }
    println(f"1000 random arrays: checksum {check}");
}
