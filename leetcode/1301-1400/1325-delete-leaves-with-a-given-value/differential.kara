// LeetCode #1325: Delete Leaves With a Given Value -- differential test of the
// six arms against the statement read literally, with five more
// properties.
//
// The statement: given a binary tree root and an integer target, delete
// all the leaf nodes with value target. Once you delete a leaf node with
// value target, if its parent node becomes a leaf node and has the value
// target, it should also be deleted (you need to continue doing that until
// you cannot).

// ---- remove_leaf_nodes.kara ----
fn a0_remove_leaf_nodes(root: Option[TreeNode], target: i32) -> Option[TreeNode] {
    let Some(node) = root else {
        return None;
    };
    node.left = a0_remove_leaf_nodes(node.left, target);
    node.right = a0_remove_leaf_nodes(node.right, target);
    if node.left.is_none() and node.right.is_none() and node.val == target {
        return None;
    }
    Some(node)
}

// ---- remove_leaf_nodes_stack.kara ----
fn a1_remove_leaf_nodes(root: Option[TreeNode], target: i32) -> Option[TreeNode] {
    let Some(top) = root else {
        return None;
    };
    // (node, its parent, whether it is the parent's left child, children done)
    let mut stack: Vec[(TreeNode, Option[TreeNode], bool, bool)] = [(top, None, false, false)];
    let mut root_gone = false;
    while let Some((node, parent, is_left, done)) = stack.pop() {
        if not done {
            stack.push((node, parent, is_left, true));
            if let Some(r) = node.right {
                stack.push((r, Some(node), false, false));
            }
            if let Some(l) = node.left {
                stack.push((l, Some(node), true, false));
            }
            continue;
        }
        if node.left.is_none() and node.right.is_none() and node.val == target {
            match parent {
                Some(p) => {
                    if is_left {
                        p.left = None;
                    } else {
                        p.right = None;
                    }
                }
                None => root_gone = true,
            }
        }
    }
    if root_gone { None } else { Some(top) }
}

// ---- remove_leaf_nodes_rounds.kara ----
fn a2_cut_round(node: TreeNode, target: i32) -> bool {
    let mut cut = false;
    if let Some(l) = node.left {
        if l.left.is_none() and l.right.is_none() and l.val == target {
            node.left = None;
            cut = true;
        } else if a2_cut_round(l, target) {
            cut = true;
        }
    }
    if let Some(r) = node.right {
        if r.left.is_none() and r.right.is_none() and r.val == target {
            node.right = None;
            cut = true;
        } else if a2_cut_round(r, target) {
            cut = true;
        }
    }
    cut
}

fn a2_remove_leaf_nodes(root: Option[TreeNode], target: i32) -> Option[TreeNode] {
    let Some(top) = root else {
        return None;
    };
    loop {
        if top.left.is_none() and top.right.is_none() and top.val == target {
            return None;
        }
        if not a2_cut_round(top, target) {
            return Some(top);
        }
    }
}

// ---- remove_leaf_nodes_levels.kara ----
fn a3_remove_leaf_nodes(root: Option[TreeNode], target: i32) -> Option[TreeNode] {
    let Some(top) = root else {
        return None;
    };
    let mut nodes: Vec[TreeNode] = [top];
    let mut parent: Vec[i64] = [-1];
    let mut i = 0;
    while i < nodes.len() {
        let node = nodes[i];
        if let Some(l) = node.left {
            nodes.push(l);
            parent.push(i);
        }
        if let Some(r) = node.right {
            nodes.push(r);
            parent.push(i);
        }
        i += 1;
    }
    let mut kept_children: Vec[i64] = Vec.filled(nodes.len(), 0);
    let mut deleted: Vec[bool] = Vec.filled(nodes.len(), false);
    for j in (0..nodes.len()).rev() {
        if kept_children[j] == 0 and nodes[j].val == target {
            deleted[j] = true;
        } else if parent[j] >= 0 {
            kept_children[parent[j]] += 1;
        }
    }
    if deleted[0] {
        return None;
    }
    for j in 1..nodes.len() {
        if deleted[j] {
            let p = nodes[parent[j]];
            if let Some(l) = p.left {
                if l.ref_eq(nodes[j]) {
                    p.left = None;
                    continue;
                }
            }
            p.right = None;
        }
    }
    Some(top)
}

// ---- remove_leaf_nodes_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_remove_leaf_nodes(root: Option[TreeNode], target: i32) -> Option[TreeNode] {
        if let Some(node) = root {
            let left = A4Solution.a4_remove_leaf_nodes(node.left.take(), target);
            let right = A4Solution.a4_remove_leaf_nodes(node.right.take(), target);
            {
                let n = node;
                n.left = left;
                n.right = right;
                if n.left.is_none() and n.right.is_none() and n.val == target {
                    return None;
                }
            }
            Some(node)
        } else {
            None
        }
    }
}

fn a4_remove_leaf_nodes(root: Option[TreeNode], target: i32) -> Option[TreeNode] {
    A4Solution.a4_remove_leaf_nodes(root, target)
}

// ---- remove_leaf_nodes_match.kara ----
struct A5Solution {}

impl A5Solution {
    pub fn a5_remove_leaf_nodes(root: Option[TreeNode], target: i32) -> Option[TreeNode] {
        match root {
            None => None,
            Some(node) => {
                let l = A5Solution.a5_remove_leaf_nodes(node.left.clone(), target);
                let r = A5Solution.a5_remove_leaf_nodes(node.right.clone(), target);
                if l.is_none() and r.is_none() and node.val == target {
                    return None;
                }
                node.left = l;
                node.right = r;
                Some(node)
            }
        }
    }
}

fn a5_remove_leaf_nodes(root: Option[TreeNode], target: i32) -> Option[TreeNode] {
    A5Solution.a5_remove_leaf_nodes(root, target)
}

// ---- the differential -------------------------------------------------------

shared struct TreeNode {
    mut val: i32,
    mut left: Option[TreeNode],
    mut right: Option[TreeNode],
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// LeetCode's level-order list, `None` for a missing child
fn from_level(values: Vec[Option[i32]]) -> Option[TreeNode] {
    if values.len() == 0 or values[0].is_none() {
        return None;
    }
    let root = TreeNode { val: values[0].unwrap(), left: None, right: None };
    let mut queue: VecDeque[TreeNode] = VecDeque.new();
    queue.push_back(root);
    let mut i = 1;
    while i < values.len() {
        let Some(node) = queue.pop_front() else {
            break;
        };
        if let Some(v) = values[i] {
            let child = TreeNode { val: v, left: None, right: None };
            node.left = Some(child);
            queue.push_back(child);
        }
        i += 1;
        if i < values.len() {
            if let Some(v) = values[i] {
                let child = TreeNode { val: v, left: None, right: None };
                node.right = Some(child);
                queue.push_back(child);
            }
            i += 1;
        }
    }
    Some(root)
}

// the tree back as LeetCode's level-order list, with no `None` at the end
fn to_level(root: Option[TreeNode]) -> Vec[Option[i32]] {
    let mut out: Vec[Option[i32]] = Vec.new();
    let mut queue: VecDeque[Option[TreeNode]] = VecDeque.new();
    queue.push_back(root);
    while let Some(slot) = queue.pop_front() {
        if let Some(node) = slot {
            out.push(Some(node.val));
            queue.push_back(node.left);
            queue.push_back(node.right);
        } else {
            out.push(None);
        }
    }
    while out.len() > 0 and out[out.len() - 1].is_none() {
        out.pop();
    }
    out
}

fn show(values: Vec[Option[i32]]) -> String {
    let parts: Vec[String] = values.iter().map(|v| match v {
        Some(x) => f"{x}",
        None => "null".to_string(),
    }).collect();
    f"[{parts.join(",")}]"
}

fn swap_sides(node: Option[TreeNode]) {
    if let Some(n) = node {
        let l = n.left;
        n.left = n.right;
        n.right = l;
        swap_sides(n.left);
        swap_sides(n.right);
    }
}

// the tree a level-order list stands for, mirrored, as a list again
fn mirrored(values: Vec[Option[i32]]) -> Vec[Option[i32]] {
    let root = from_level(values);
    swap_sides(root);
    to_level(root)
}

// the statement read literally: the tree as lists of values and children,
// and while some node still there has no child still there and the
// target's value, the first such node deleted
fn literal(values: Vec[Option[i32]], target: i32) -> Vec[Option[i32]] {
    let Some(root) = from_level(values) else {
        return Vec.new();
    };
    let mut nodes: Vec[TreeNode] = [root];
    let mut i = 0;
    while i < nodes.len() {
        let n = nodes[i];
        if let Some(l) = n.left {
            nodes.push(l);
        }
        if let Some(r) = n.right {
            nodes.push(r);
        }
        i += 1;
    }
    let mut gone: Vec[bool] = Vec.filled(nodes.len(), false);
    loop {
        let mut found = -1;
        for j in 0..nodes.len() {
            if gone[j] or nodes[j].val != target {
                continue;
            }
            let mut has_child = false;
            for c in 0..nodes.len() {
                if gone[c] {
                    continue;
                }
                let is_left = match nodes[j].left {
                    Some(l) => l.ref_eq(nodes[c]),
                    None => false,
                };
                let is_right = match nodes[j].right {
                    Some(r) => r.ref_eq(nodes[c]),
                    None => false,
                };
                if is_left or is_right {
                    has_child = true;
                }
            }
            if not has_child {
                found = j;
                break;
            }
        }
        if found < 0 {
            break;
        }
        gone[found] = true;
    }
    if gone[0] {
        return Vec.new();
    }
    for j in 0..nodes.len() {
        let n = nodes[j];
        if let Some(l) = n.left {
            if gone[nodes.iter().position(|m| m.ref_eq(l)).unwrap()] {
                n.left = None;
            }
        }
        if let Some(r) = n.right {
            if gone[nodes.iter().position(|m| m.ref_eq(r)).unwrap()] {
                n.right = None;
            }
        }
    }
    to_level(Some(root))
}

// the tree a level-order list stands for, as the left child of a new root
// with the value v, as a list again
fn on_top(values: Vec[Option[i32]], v: i32) -> Vec[Option[i32]] {
    to_level(Some(TreeNode { val: v, left: from_level(values), right: None }))
}

struct Case {
    values: Vec[Option[i32]],
    target: i32,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

// the arm's answer for a fresh tree built from the list, as a list
fn arm(i: i64, values: Vec[Option[i32]], target: i32) -> Vec[Option[i32]] {
    let root = from_level(values);
    let got = match i {
        0 => a0_remove_leaf_nodes(root, target),
        1 => a1_remove_leaf_nodes(root, target),
        2 => a2_remove_leaf_nodes(root, target),
        3 => a3_remove_leaf_nodes(root, target),
        4 => a4_remove_leaf_nodes(root, target),
        _ => a5_remove_leaf_nodes(root, target),
    };
    to_level(got)
}

fn check_case(t: mut ref Tally, c: Case) {
    t.cases += 1;
    let want = literal(c.values, c.target);
    for v in want.iter() {
        t.check = (t.check * 131 + match v {
            Some(x) => x as i64,
            None => 1001,
        }) % 1000000007;
    }
    t.check = (t.check * 131 + 1002) % 1000000007;
    let mirror = mirrored(c.values);
    let above = on_top(c.values, c.target);
    let star = arm(0, c.values, c.target);
    for i in 0..6 {
        let got = arm(i, c.values, c.target);
        let what = f"arm {i} case {t.cases} {show(c.values)} target {c.target}: got {show(got)}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}, literal {show(want)}");
        // P2: the tree mirrored: the answer mirrored
        let mr = arm(i, mirror, c.target);
        expect(mut t, 2, mr == mirrored(got), f"P2 {what}, mirrored: {show(mr)}");
        // P3: a target no node has: the tree as it was
        let none = arm(i, c.values, 1001);
        expect(mut t, 3, none == to_level(from_level(c.values)), f"P3 {what}, target 1001: {show(none)}");
        // P4: a new root with the target's value above the old root: the
        // new root kept above the answer, or deleted with it
        let ab = arm(i, above, c.target);
        let ab_want = if got.len() == 0 { Vec.new() } else { on_top(got, c.target) };
        expect(mut t, 4, ab == ab_want, f"P4 {what}, a new root above: {show(ab)}");
        // P5: the answer asked again: nothing more to delete
        let again = arm(i, got, c.target);
        expect(mut t, 5, again == got, f"P5 {what}, asked again: {show(again)}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {show(star)}");
    }
}

// n nodes with values from 1 to k, each hung on an empty child place of the
// tree so far, chosen at random, or when deep, three times in four one of
// the two newest
fn random_tree(seed: mut ref i64, n: i64, k: i64, deep: bool) -> Option[TreeNode] {
    let root = TreeNode { val: (1 + next_random(mut seed) % k) as i32, left: None, right: None };
    let mut places: Vec[(TreeNode, bool)] = [(root, true), (root, false)];
    for _ in 1..n {
        let r = next_random(mut seed);
        let k_at = if deep and r % 4 != 0 { places.len() - 1 - next_random(mut seed) % 2 } else { next_random(mut seed) % places.len() };
        let (parent, left) = places.swap_remove(k_at);
        let node = TreeNode { val: (1 + next_random(mut seed) % k) as i32, left: None, right: None };
        if left {
            parent.left = Some(node);
        } else {
            parent.right = Some(node);
        }
        places.push((node, true));
        places.push((node, false));
    }
    Some(root)
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 trees of 1 to 12 nodes in four kinds, 500 each: values 1 to 2;
    // 1 to 3; 1 to 2 with the tree run deep; and every value the target but
    // one. Every tree and target is drawn before any arm answers.
    let mut seed = 13251;
    let mut cases: Vec[Case] = Vec.new();
    for i in 0..2000 {
        let kind = i / 500;
        let n = 1 + next_random(mut seed) % 12;
        let k = if kind == 1 { 3 } else if kind == 3 { 1 } else { 2 };
        let mut values = to_level(random_tree(mut seed, n, k, kind == 2));
        let target = (1 + next_random(mut seed) % k) as i32;
        if kind == 3 {
            let places: Vec[i64] = (0..values.len()).filter(|j| values[j].is_some()).collect();
            values[places[next_random(mut seed) % places.len()]] = Some(2);
        }
        cases.push(Case { values, target });
    }
    for c in cases.iter() {
        check_case(mut t, c);
    }
    println(f"{t.cases} trees: checksum {t.check}, {t.checks} checks over 6 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
