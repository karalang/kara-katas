// LeetCode #1318: Minimum Flips to Make a OR b Equal to c -- a second Rust
// solution as LeetCode's Rust users write it (`for i in 0..32` with `let
// mask = 1 << i;`, each bit tested by `a & mask != 0`, and a `match (bit_a,
// bit_b, bit_c)` on the three), carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn min_flips(a: i32, b: i32, c: i32) -> i32 {
        let mut flips = 0;
        for i in 0..32 {
            let mask = 1 << i;
            let bit_a = a & mask != 0;
            let bit_b = b & mask != 0;
            let bit_c = c & mask != 0;
            flips += match (bit_a, bit_b, bit_c) {
                (false, false, true) => 1,
                (true, true, false) => 2,
                (true, false, false) | (false, true, false) => 1,
                _ => 0,
            };
        }
        flips
    }
}

fn min_flips(a: i64, b: i64, c: i64) -> i64 {
    Solution.min_flips(a as i32, b as i32, c as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; every bit of a and b wanted off; every bit
    // of 10^9 wanted on from nothing set; and a, b, c all 10^9, the
    // constraints' most
    let big = 1000000000;
    println(f"{min_flips(2, 6, 5)} {min_flips(4, 2, 7)} {min_flips(1, 2, 3)} {min_flips(big, 999999999, 1)} {min_flips(1, 1, big)} {min_flips(big, big, big)}");
    // 100000 random triples from 1 to 10^9, every other one from 1 to 15
    let mut seed = 1318;
    let mut total = 0;
    let mut check = 0;
    for t in 0..100000 {
        let top = if t % 2 == 0 { 15 } else { big };
        let a = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
        let b = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
        let c = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
        let got = min_flips(a, b, c);
        total += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"100000 random triples: flips total {total}, checksum {check}");
}
