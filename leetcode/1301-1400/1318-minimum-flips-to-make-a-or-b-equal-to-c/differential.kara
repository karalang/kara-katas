// LeetCode #1318: Minimum Flips to Make a OR b Equal to c -- differential
// test of the six arms against the statement read literally, with five
// more properties.
//
// The statement: given 3 positive numbers a, b and c, return the minimum
// flips required in some bits of a and b to make (a OR b == c) (bitwise
// OR). A flip changes any single bit 1 to 0 or 0 to 1 in their binary
// representation.

// ---- min_flips.kara ----
fn a0_min_flips(a: i64, b: i64, c: i64) -> i64 {
    let mut flips = 0;
    for i in 0..30 {
        let x = (a >> i) & 1;
        let y = (b >> i) & 1;
        let z = (c >> i) & 1;
        flips += if z == 1 { 1 - (x | y) } else { x + y };
    }
    flips
}

// ---- min_flips_count.kara ----
fn a1_min_flips(a: i64, b: i64, c: i64) -> i64 {
    let wrong = (a | b) ^ c;
    (wrong.count_ones() + (a & b & wrong).count_ones())
}

// ---- min_flips_text.kara ----
fn a2_min_flips(a: i64, b: i64, c: i64) -> i64 {
    let x: Vec[char] = f"{a:030b}".chars().collect();
    let y: Vec[char] = f"{b:030b}".chars().collect();
    let z: Vec[char] = f"{c:030b}".chars().collect();
    let mut flips = 0;
    for i in 0..30 {
        if z[i] == '1' {
            if x[i] == '0' and y[i] == '0' {
                flips += 1;
            }
        } else {
            if x[i] == '1' {
                flips += 1;
            }
            if y[i] == '1' {
                flips += 1;
            }
        }
    }
    flips
}

// ---- min_flips_peel.kara ----
fn a3_min_flips(a: i64, b: i64, c: i64) -> i64 {
    if a == 0 and b == 0 and c == 0 {
        return 0;
    }
    let here = if c % 2 == 1 {
        if a % 2 == 0 and b % 2 == 0 { 1 } else { 0 }
    } else {
        a % 2 + b % 2
    };
    here + a3_min_flips(a / 2, b / 2, c / 2)
}

// ---- min_flips_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_min_flips(a: i32, b: i32, c: i32) -> i32 {
        (((a | b) ^ c).count_ones() + (a & b & ((a | b) ^ c)).count_ones()) as i32
    }
}

fn a4_min_flips(a: i64, b: i64, c: i64) -> i64 {
    A4Solution.a4_min_flips(a as i32, b as i32, c as i32)
}

// ---- min_flips_masks.kara ----
struct A5Solution {}

impl A5Solution {
    pub fn a5_min_flips(a: i32, b: i32, c: i32) -> i32 {
        let mut flips = 0;
        for i in 0..32 {
            let mask = 1 << i;
            let bit_a = a & mask != 0;
            let bit_b = b & mask != 0;
            let bit_c = c & mask != 0;
            flips += match (bit_a, bit_b, bit_c) {
                (false, false, true) => 1,
                (true, true, false) => 2,
                (true, false, false) | (false, true, false) => 1,
                _ => 0,
            };
        }
        flips
    }
}

fn a5_min_flips(a: i64, b: i64, c: i64) -> i64 {
    A5Solution.a5_min_flips(a as i32, b as i32, c as i32)
}

// ---- the differential -------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn ones(x: i64) -> i64 {
    let mut count = 0;
    let mut rest = x;
    while rest > 0 {
        count += rest % 2;
        rest /= 2;
    }
    count
}

// the statement read literally: a flip changes one bit of a or b, so the
// fewest flips that make a OR b equal c is the least, over every a2 and b2
// with a2 OR b2 equal to c, of the bits a2 differs from a in plus the bits
// b2 differs from b in; no bit above c's highest can be wanted, so a2 and b2
// range up to the next power of 2 above all three
fn literal(a: i64, b: i64, c: i64) -> i64 {
    let mut top = 1;
    while top <= a or top <= b or top <= c {
        top *= 2;
    }
    let mut best = -1;
    for a2 in 0..top {
        for b2 in 0..top {
            if a2 | b2 == c {
                let cost = ones(a2 ^ a) + ones(b2 ^ b);
                if best < 0 or cost < best {
                    best = cost;
                }
            }
        }
    }
    best
}

struct Case {
    a: i64,
    b: i64,
    c: i64,
    // P3: how far all three are shifted left
    shift: i64,
    // P5: the bit of c changed
    bit: i64,
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, a: i64, b: i64, c: i64) -> i64 {
    match i {
        0 => a0_min_flips(a, b, c),
        1 => a1_min_flips(a, b, c),
        2 => a2_min_flips(a, b, c),
        3 => a3_min_flips(a, b, c),
        4 => a4_min_flips(a, b, c),
        _ => a5_min_flips(a, b, c),
    }
}

fn check_case(t: mut ref Tally, k: Case) {
    t.cases += 1;
    let (a, b, c) = (k.a, k.b, k.c);
    let want = literal(a, b, c);
    t.check = (t.check * 31 + want) % 1000000007;
    let star = a0_min_flips(a, b, c);
    let s = k.shift;
    // a bit above every bit the three have, put on all three
    let mut high = 1;
    while high <= a or high <= b or high <= c {
        high *= 2;
    }
    for i in 0..6 {
        let got = arm(i, a, b, c);
        let what = f"arm {i} case {t.cases} ({a}, {b}, {c}): got {got}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}, literal {want}");
        // P2: a and b swapped, the same answer
        let sw = arm(i, b, a, c);
        expect(mut t, 2, sw == got, f"P2 {what}, swapped: {sw}");
        // P3: all three shifted left, the same answer
        let sh = arm(i, a << s, b << s, c << s);
        expect(mut t, 3, sh == got, f"P3 {what}, shifted {s}: {sh}");
        // P4: a bit above all their bits put on all three, which costs
        // nothing, the same answer
        let up = arm(i, a + high, b + high, c + high);
        expect(mut t, 4, up == got, f"P4 {what}, {high} added: {up}");
        // P5: one bit of c changed, an answer at most 2 away
        let ch = arm(i, a, b, c ^ k.bit);
        expect(mut t, 5, ch >= got - 2 and ch <= got + 2, f"P5 {what}, c ^ {k.bit}: {ch}");
        // P6: the ★ arm's answer
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // 2000 triples in four kinds, 500 each: numbers 1 to 7; 1 to 31; a and b
    // equal, from 1 to 31, with c from 1 to 31; and c a OR b with one or two
    // of its bits changed, kept at 1 or more. Every triple, shift and bit is
    // drawn before any arm answers.
    let mut seed = 13181;
    let mut cases: Vec[Case] = Vec.new();
    for i in 0..2000 {
        let kind = i / 500;
        let top = if kind == 0 { 7 } else { 31 };
        let a = 1 + next_random(mut seed) % top;
        let b = if kind == 2 { a } else { 1 + next_random(mut seed) % top };
        let mut c = 1 + next_random(mut seed) % top;
        if kind == 3 {
            c = a | b;
            for _ in 0..1 + next_random(mut seed) % 2 {
                c ^= 1 << next_random(mut seed) % 5;
            }
            if c == 0 {
                c = 1;
            }
        }
        let shift = 1 + next_random(mut seed) % 20;
        let bit = 1 << next_random(mut seed) % 6;
        cases.push(Case { a, b, c, shift, bit });
    }
    for k in cases.iter() {
        check_case(mut t, k);
    }
    println(f"{t.cases} triples: checksum {t.check}, {t.checks} checks over 6 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
