// LeetCode #1318: Minimum Flips to Make a OR b Equal to c -- the text arm:
// the three numbers written in binary, 30 digits each with leading 0s, by
// `f"{a:030b}"`, and the digits read side by side, each place costing as
// the ★ arm's bit does. O(bits)

fn min_flips(a: i64, b: i64, c: i64) -> i64 {
    let x: Vec[char] = f"{a:030b}".chars().collect();
    let y: Vec[char] = f"{b:030b}".chars().collect();
    let z: Vec[char] = f"{c:030b}".chars().collect();
    let mut flips = 0;
    for i in 0..30 {
        if z[i] == '1' {
            if x[i] == '0' and y[i] == '0' {
                flips += 1;
            }
        } else {
            if x[i] == '1' {
                flips += 1;
            }
            if y[i] == '1' {
                flips += 1;
            }
        }
    }
    flips
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples; every bit of a and b wanted off; every bit
    // of 10^9 wanted on from nothing set; and a, b, c all 10^9, the
    // constraints' most
    let big = 1000000000;
    println(f"{min_flips(2, 6, 5)} {min_flips(4, 2, 7)} {min_flips(1, 2, 3)} {min_flips(big, 999999999, 1)} {min_flips(1, 1, big)} {min_flips(big, big, big)}");
    // 100000 random triples from 1 to 10^9, every other one from 1 to 15
    let mut seed = 1318;
    let mut total = 0;
    let mut check = 0;
    for t in 0..100000 {
        let top = if t % 2 == 0 { 15 } else { big };
        let a = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
        let b = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
        let c = 1 + (next_random(mut seed) * 32768 + next_random(mut seed)) % top;
        let got = min_flips(a, b, c);
        total += got;
        check = (check * 31 + got) % 1000000007;
    }
    println(f"100000 random triples: flips total {total}, checksum {check}");
}
