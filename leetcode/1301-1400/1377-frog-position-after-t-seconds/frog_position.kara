// LeetCode #1377: Frog Position After T Seconds -- the ★ arm: the chance
// of the frog being on each vertex, moved one second at a time. The
// vertices it can be on make up a level, starting from {1}; each second,
// a vertex of the level with unvisited neighbours hands its chance to
// them in equal shares and keeps none, and they make up the next level,
// while a vertex with none keeps its chance for good. O(n)

fn frog_position(n: i32, edges: Vec[Vec[i32]], t: i32, target: i32) -> f64 {
    let mut adjacent: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.new());
    for e in edges.iter() {
        adjacent[e[0]].push(e[1]);
        adjacent[e[1]].push(e[0]);
    }
    let mut seen = Vec.filled(n + 1, false);
    seen[1] = true;
    let mut chance = Vec.filled(n + 1, 0.0);
    chance[1] = 1.0;
    let mut level: Vec[i64] = [1];
    for _ in 0..t {
        let mut next: Vec[i64] = Vec.new();
        for u in level.iter() {
            let ahead: Vec[i64] = adjacent[u].iter().filter(|v| not seen[v]).collect();
            if ahead.is_empty() {
                continue;
            }
            let share = chance[u] / ahead.len() as f64;
            for v in ahead.iter() {
                seen[v] = true;
                chance[v] = share;
                next.push(v);
            }
            chance[u] = 0.0;
        }
        level = next;
    }
    chance[target]
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// A tree of n vertices, numbered in a random order. Taking them one by
// one in that order, each after the first is joined to one taken before
// it: any of them (kind 0), one of the last three taken, so the tree runs
// deep (kind 1), one of the first three, so it runs wide (kind 2), or one
// of the last half (kind 3). Each edge is written either way round, and
// the edges in a random order.
fn tree(seed: mut ref i64, n: i64, kind: i64) -> Vec[Vec[i32]] {
    let mut order: Vec[i64] = (1..n + 1).collect();
    for i in (1..n).rev() {
        let j = next_random(mut seed) % (i + 1);
        order.swap(i, j);
    }
    let mut edges: Vec[Vec[i32]] = Vec.new();
    for k in 1..n {
        let back = if kind == 0 {
            next_random(mut seed) % k
        } else if kind == 1 {
            k - 1 - next_random(mut seed) % k.min(3)
        } else if kind == 2 {
            next_random(mut seed) % k.min(3)
        } else {
            k / 2 + next_random(mut seed) % (k - k / 2)
        };
        let (a, b) = (order[k] as i32, order[back] as i32);
        if next_random(mut seed) % 2 == 0 {
            edges.push([a, b]);
        } else {
            edges.push([b, a]);
        }
    }
    for i in (1..edges.len()).rev() {
        let j = next_random(mut seed) % (i + 1);
        edges.swap(i, j);
    }
    edges
}

fn main() {
    // LeetCode's two examples; 100 vertices, the constraints' most, in a
    // path from 1 (t = 50 to vertex 51, and to vertex 100, out of reach),
    // as a star around 1 (t = 1 and t = 50 to a leaf), and as a binary
    // heap (t = 6 to vertex 64, and t = 50 to vertex 100)
    let example: Vec[Vec[i32]] = [[1, 2], [1, 3], [1, 7], [2, 4], [2, 6], [3, 5]];
    let path: Vec[Vec[i32]] = (1..100).map(|i| [i as i32, (i + 1) as i32]).collect();
    let star: Vec[Vec[i32]] = (2..101).map(|i| [1, i as i32]).collect();
    let heap: Vec[Vec[i32]] = (2..101).map(|i| [(i / 2) as i32, i as i32]).collect();
    let shown: Vec[f64] = [
        frog_position(7, example, 2, 4),
        frog_position(7, example, 1, 7),
        frog_position(100, path, 50, 51),
        frog_position(100, path, 50, 100),
        frog_position(100, star, 1, 2),
        frog_position(100, star, 50, 2),
        frog_position(100, heap, 6, 64),
        frog_position(100, heap, 50, 100),
    ];
    let parts: Vec[String] = shown.iter().map(|p| f"{p:.6}").collect();
    println(parts.join(" "));
    // 2000 random trees of 1 to 100 vertices, 500 of each kind, a time of
    // 1 to 12 seconds and a target at random; each answer counted in
    // units of 2^-20, rounded half up
    let mut seed = 1377;
    let mut reached = 0;
    let mut check: i64 = 0;
    for c in 0..2000 {
        let n = 1 + next_random(mut seed) % 100;
        let edges = tree(mut seed, n, c % 4);
        let t = 1 + next_random(mut seed) % 12;
        let target = 1 + next_random(mut seed) % n;
        let p = frog_position(n as i32, edges, t as i32, target as i32);
        let units = (p * 1048576.0 + 0.5).floor() as i64;
        if units > 0 {
            reached += 1;
        }
        check = (check * 131 + units) % 1000000007;
    }
    println(f"2000 random trees: {reached} targets reachable, checksum {check}");
}
