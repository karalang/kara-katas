// LeetCode #1301: Number of Paths with Max Score -- the topological arm: the
// squares as a graph whose edges are the moves, taken in an order where every
// square comes after all the squares that step into it (Kahn's algorithm: a
// `VecDeque` of squares with no moves left to come in), each square passing
// its best score and count on to the squares it steps to. O(n^2)

fn paths_with_max_score(board: Vec[String]) -> Vec[i64] {
    let grid: Vec[Vec[char]] = board.iter().map(|row| row.chars().collect()).collect();
    let n = grid.len();
    let open = |i: i64, j: i64| i >= 0 and j >= 0 and i < n and j < n and grid[i][j] != 'X';
    let mut waiting: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(n, 0));
    for i in 0..n {
        for j in 0..n {
            if open(i, j) {
                for (a, b) in [(i + 1, j), (i, j + 1), (i + 1, j + 1)] {
                    if open(a, b) {
                        waiting[i][j] += 1;
                    }
                }
            }
        }
    }
    let mut best: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(n, -1));
    let mut ways: Vec[Vec[i64]] = Vec.filled(n, Vec.filled(n, 0));
    best[n - 1][n - 1] = 0;
    ways[n - 1][n - 1] = 1;
    let mut ready: VecDeque[(i64, i64)] = VecDeque.new();
    for i in 0..n {
        for j in 0..n {
            if open(i, j) and waiting[i][j] == 0 {
                ready.push_back((i, j));
            }
        }
    }
    while let Some((i, j)) = ready.pop_front() {
        if best[i][j] >= 0 and not (i == n - 1 and j == n - 1) {
            let points = match grid[i][j].to_digit(10) {
                Some(d) => d as i64,
                None => 0,
            };
            best[i][j] += points;
        }
        for (a, b) in [(i - 1, j), (i, j - 1), (i - 1, j - 1)] {
            if not open(a, b) {
                continue;
            }
            if best[i][j] >= 0 {
                if best[i][j] > best[a][b] {
                    best[a][b] = best[i][j];
                    ways[a][b] = ways[i][j];
                } else if best[i][j] == best[a][b] {
                    ways[a][b] = (ways[a][b] + ways[i][j]) % 1000000007;
                }
            }
            waiting[a][b] -= 1;
            if waiting[a][b] == 0 {
                ready.push_back((a, b));
            }
        }
    }
    if best[0][0] < 0 {
        [0, 0]
    } else {
        [best[0][0], ways[0][0]]
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn show(v: Vec[i64]) -> String {
    f"{v[0]},{v[1]}"
}

// an n by n board, each square other than the corners an obstacle wall
// times in 100, else a digit from 1 to 9
fn make_board(seed: mut ref i64, n: i64, wall: i64) -> Vec[String] {
    let mut board: Vec[String] = Vec.new();
    for i in 0..n {
        let mut row = String.new();
        for j in 0..n {
            if i == 0 and j == 0 {
                row.push('E');
            } else if i == n - 1 and j == n - 1 {
                row.push('S');
            } else if next_random(mut seed) % 100 < wall {
                row.push('X');
            } else {
                let d = next_random(mut seed) % 9 + 1;
                row.push(char.from_digit(d as u32, 10).unwrap());
            }
        }
        board.push(row);
    }
    board
}

fn main() {
    // LeetCode's three examples, the smallest board, and two ways that tie
    let e1 = paths_with_max_score(["E23", "2X2", "12S"].iter().map(|s| s.to_string()).collect());
    let e2 = paths_with_max_score(["E12", "1X1", "21S"].iter().map(|s| s.to_string()).collect());
    let e3 = paths_with_max_score(["E11", "XXX", "11S"].iter().map(|s| s.to_string()).collect());
    let e4 = paths_with_max_score(["EX", "XS"].iter().map(|s| s.to_string()).collect());
    let e5 = paths_with_max_score(["E5", "5S"].iter().map(|s| s.to_string()).collect());
    println(f"{show(e1)} {show(e2)} {show(e3)} {show(e4)} {show(e5)}");
    // random boards of 2 to 30 squares a side with obstacles from 0 to 60 in
    // 100; then two of 100, the constraints' largest, one without obstacles
    let mut seed = 1301;
    let mut total = 0;
    let mut none = 0;
    let mut check = 0;
    for i in 0..602 {
        let n = if i < 600 { 2 + next_random(mut seed) % 29 } else { 100 };
        let wall = if i < 600 { next_random(mut seed) % 61 } else if i == 600 { 0 } else { 20 };
        let board = make_board(mut seed, n, wall);
        let got = paths_with_max_score(board);
        if got[1] == 0 {
            none += 1;
        }
        total += got[0];
        check = (check * 131 + got[0]) % 1000000007;
        check = (check * 131 + got[1]) % 1000000007;
    }
    println(f"602 random boards: {none} with no path, scores total {total}, checksum {check}");
}
