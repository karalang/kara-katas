// LeetCode #1304: Find N Unique Integers Sum up to Zero -- differential test
// of the five arms against the statement read literally, with four more
// properties.
//
// The statement: given an integer n, return any array containing n unique
// integers such that they add up to 0.

// ---- sum_zero.kara ----
fn a0_sum_zero(n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for i in 1..n / 2 + 1 {
        out.push(i);
        out.push(-i);
    }
    if n % 2 == 1 {
        out.push(0);
    }
    out
}

// ---- sum_zero_symmetric.kara ----
fn a1_sum_zero(n: i64) -> Vec[i64] {
    (0..n).map(|i| i * 2 - n + 1).collect()
}

// ---- sum_zero_running.kara ----
fn a2_sum_zero(n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut total = 0;
    for i in 1..n {
        out.push(i);
        total += i;
    }
    out.push(-total);
    out
}

// ---- sum_zero_iter.kara ----
fn a3_sum_zero(n: i64) -> Vec[i64] {
    (1..n / 2 + 1).flat_map(|i| [i, -i].into_iter()).chain((0..n % 2).map(|_| 0)).collect()
}

// ---- sum_zero_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_sum_zero(n: i32) -> Vec[i32] {
        let mut res = Vec.filled(n, 0);
        for i in 0..(n / 2) as usize {
            res[2 * i] = (i + 1) as i32;
            res[2 * i + 1] = -((i + 1) as i32);
        }
        res
    }
}

fn a4_sum_zero(n: i64) -> Vec[i64] {
    A4Solution.a4_sum_zero(n as i32).iter().map(|x| x as i64).collect()
}
// ---- the statement read literally -----------------------------------------

// n numbers, each compared with every other for an equal, all added up to 0
fn literal(n: i64, got: Vec[i64]) -> bool {
    if got.len() != n {
        return false;
    }
    let mut sum = 0;
    for i in 0..got.len() {
        for j in 0..got.len() {
            if i != j and got[i] == got[j] {
                return false;
            }
        }
        sum += got[i];
    }
    sum == 0
}

// ---- the checks -------------------------------------------------------------

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, n: i64) -> Vec[i64] {
    match i {
        0 => a0_sum_zero(n),
        1 => a1_sum_zero(n),
        2 => a2_sum_zero(n),
        3 => a3_sum_zero(n),
        _ => a4_sum_zero(n),
    }
}

fn check_case(t: mut ref Tally, n: i64) {
    t.cases += 1;
    for i in 0..5 {
        let got = arm(i, n);
        let what = f"arm {i} n {n}";
        // P1: the statement read literally
        expect(mut t, 1, literal(n, got), f"P1 {what}: not n unique numbers summing to 0");
        // P2: n numbers
        expect(mut t, 2, got.len() == n, f"P2 {what}: {got.len()} numbers");
        // P3: no two equal, found by sorting
        let mut sorted = got.clone();
        sorted.sort();
        let mut twice = 0;
        for k in 1..sorted.len() {
            if sorted[k] == sorted[k - 1] {
                twice += 1;
            }
        }
        expect(mut t, 3, twice == 0, f"P3 {what}: {twice} repeats");
        // P4: every number fits an i32, LeetCode's return type
        let outside = got.iter().filter(|x| x < -2147483648 or x > 2147483647).count();
        expect(mut t, 4, outside == 0, f"P4 {what}: {outside} outside i32");
        // P5: the same n asked again, the same array
        let again = arm(i, n);
        expect(mut t, 5, again == got, f"P5 {what}: a different array the second time");
        // the checksum folds the sorted array, so that it pins the arm's own answer
        for x in sorted.iter() {
            t.check = ((t.check * 131 + x) % 1000000007 + 1000000007) % 1000000007;
        }
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(6, 0) };
    // every n from 1 to 200, and 600 to 1000 in steps of 50; the literal
    // check compares every pair, so the large sizes are few
    let mut sizes: Vec[i64] = (1..201).collect();
    for k in 0..9 {
        sizes.push(600 + 50 * k);
    }
    for n in sizes.iter() {
        check_case(mut t, n);
    }
    println(f"{t.cases} sizes: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..6).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
