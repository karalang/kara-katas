// LeetCode #1304: Find N Unique Integers Sum up to Zero -- a Rust solution
// as LeetCode's Rust users write it (a `vec![0; n as usize]` with each pair
// written at `2 * i` and `2 * i + 1`, the last place left 0 when n is odd),
// carried to Kāra by `karac fix`.

struct Solution {}

impl Solution {
    pub fn sum_zero(n: i32) -> Vec[i32] {
        let mut res = Vec.filled(n, 0);
        for i in 0..(n / 2) as usize {
            res[2 * i] = (i + 1) as i32;
            res[2 * i + 1] = -((i + 1) as i32);
        }
        res
    }
}

fn sum_zero(n: i64) -> Vec[i64] {
    Solution.sum_zero(n as i32).iter().map(|x| x as i64).collect()
}

// ---- test harness ---------------------------------------------------------

// "Any array" is the answer, so the harness checks each array against the
// statement rather than printing it: n numbers, no two equal, summing to 0.
fn valid(n: i64, got: Vec[i64]) -> bool {
    if got.len() != n {
        return false;
    }
    let mut sorted = got.clone();
    sorted.sort();
    let mut sum = 0;
    for i in 0..sorted.len() {
        if i > 0 and sorted[i] == sorted[i - 1] {
            return false;
        }
        sum += sorted[i];
    }
    sum == 0
}

fn main() {
    // LeetCode's three examples
    let mut line: Vec[String] = Vec.new();
    for n in [5, 3, 1] {
        let ok = if valid(n, sum_zero(n)) { "ok" } else { "WRONG" };
        line.push(f"{n}:{ok}");
    }
    println(line.join(" "));
    // every n the constraints allow
    let mut good = 0;
    let mut total = 0;
    for n in 1..1001 {
        let got = sum_zero(n);
        if valid(n, got) {
            good += 1;
        }
        total += got.len();
    }
    println(f"1000 sizes: {good} valid, numbers total {total}");
}
