// LeetCode #1304: Find N Unique Integers Sum up to Zero -- the symmetric
// arm: n numbers two apart, centred on 0, `2i - n + 1` for i from 0 to
// n - 1: odd numbers when n is even, even ones when n is odd. O(n)

fn sum_zero(n: i64) -> Vec[i64] {
    (0..n).map(|i| i * 2 - n + 1).collect()
}

// ---- test harness ---------------------------------------------------------

// "Any array" is the answer, so the harness checks each array against the
// statement rather than printing it: n numbers, no two equal, summing to 0.
fn valid(n: i64, got: Vec[i64]) -> bool {
    if got.len() != n {
        return false;
    }
    let mut sorted = got.clone();
    sorted.sort();
    let mut sum = 0;
    for i in 0..sorted.len() {
        if i > 0 and sorted[i] == sorted[i - 1] {
            return false;
        }
        sum += sorted[i];
    }
    sum == 0
}

fn main() {
    // LeetCode's three examples
    let mut line: Vec[String] = Vec.new();
    for n in [5, 3, 1] {
        let ok = if valid(n, sum_zero(n)) { "ok" } else { "WRONG" };
        line.push(f"{n}:{ok}");
    }
    println(line.join(" "));
    // every n the constraints allow
    let mut good = 0;
    let mut total = 0;
    for n in 1..1001 {
        let got = sum_zero(n);
        if valid(n, got) {
            good += 1;
        }
        total += got.len();
    }
    println(f"1000 sizes: {good} valid, numbers total {total}");
}
