// LeetCode #1304 bench: the ★ arm (the pairs i and -i up to n / 2, and 0
// when n is odd, pushed onto a fresh `Vec`) called 10^6 times, each n
// from 1 to 1000, the constraints' range, chosen from the checksum so far,
// so no answer carries over; one number of each answer, at a place also
// chosen from the checksum, folded into the checksum with the call's
// number.

fn sum_zero(n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for i in 1..n / 2 + 1 {
        out.push(i);
        out.push(-i);
    }
    if n % 2 == 1 {
        out.push(0);
    }
    out
}

fn main() {
    let mut check: i64 = 0;
    for call in 0..1000000 {
        let n = 1 + check % 1000;
        let got = sum_zero(n);
        let x = got[(check / 1000) % n];
        check = (check * 31 + x + 1000 + call) % 1000000007;
    }
    println(f"1000000 calls: checksum {check}");
}
