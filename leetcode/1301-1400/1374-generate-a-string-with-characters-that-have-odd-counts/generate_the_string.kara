// LeetCode #1374: Generate a String With Characters That Have Odd Counts
// -- the ★ arm: n a's when n is odd, and n - 1 a's and a b when it is
// even, the smallest answer in dictionary order. O(n)

fn generate_the_string(n: i32) -> String {
    if n % 2 == 1 {
        return "a".repeat(n);
    }
    "a".repeat(n - 1) + "b"
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples
    let shown: Vec[String] = [4, 2, 7].iter().map(|n| generate_the_string(n)).collect();
    println(shown.join(" "));
    // every n from 1 to 500, the constraints' range
    let mut letters = 0;
    let mut bs = 0;
    let mut check: i64 = 0;
    for n in 1..501 {
        let s = generate_the_string(n);
        letters += s.len();
        for b in s.bytes().iter() {
            if b == b'b' {
                bs += 1;
            }
            check = (check * 131 + b as i64) % 1000000007;
        }
    }
    println(f"n from 1 to 500: {letters} letters, {bs} b's, checksum {check}");
}
