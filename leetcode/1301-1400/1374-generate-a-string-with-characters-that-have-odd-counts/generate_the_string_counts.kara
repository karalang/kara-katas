// LeetCode #1374: Generate a String With Characters That Have Odd Counts
// -- the counts arm: how many of each letter the answer holds, in a
// 26-place array, then the letters written out in order. O(n)

fn generate_the_string(n: i32) -> String {
    let mut counts: Array[i32, 26] = [0; 26];
    counts[0] = n;
    if n % 2 == 0 {
        counts[0] -= 1;
        counts[1] = 1;
    }
    let mut s = String.new();
    for (i, c) in counts.iter().enumerate() {
        for _ in 0..c {
            s.push((b'a' + i as u8) as char);
        }
    }
    s
}

// ---- test harness ---------------------------------------------------------

fn main() {
    // LeetCode's three examples
    let shown: Vec[String] = [4, 2, 7].iter().map(|n| generate_the_string(n)).collect();
    println(shown.join(" "));
    // every n from 1 to 500, the constraints' range
    let mut letters = 0;
    let mut bs = 0;
    let mut check: i64 = 0;
    for n in 1..501 {
        let s = generate_the_string(n);
        letters += s.len();
        for b in s.bytes().iter() {
            if b == b'b' {
                bs += 1;
            }
            check = (check * 131 + b as i64) % 1000000007;
        }
    }
    println(f"n from 1 to 500: {letters} letters, {bs} b's, checksum {check}");
}
