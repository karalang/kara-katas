// LeetCode #1374: Generate a String With Characters That Have Odd Counts
// -- differential test of the five arms against the statement read
// literally, with five more properties.
//
// The statement: return a string of n lowercase letters in which every
// letter that appears does so an odd number of times. Any such string is
// accepted, so every arm gives the same one: the smallest in dictionary
// order.

// ---- generate_the_string.kara ----
fn a0_generate_the_string(n: i32) -> String {
    if n % 2 == 1 {
        return "a".repeat(n);
    }
    "a".repeat(n - 1) + "b"
}

// ---- generate_the_string_counts.kara ----
fn a1_generate_the_string(n: i32) -> String {
    let mut counts: Array[i32, 26] = [0; 26];
    counts[0] = n;
    if n % 2 == 0 {
        counts[0] -= 1;
        counts[1] = 1;
    }
    let mut s = String.new();
    for (i, c) in counts.iter().enumerate() {
        for _ in 0..c {
            s.push((b'a' + i as u8) as char);
        }
    }
    s
}

// ---- generate_the_string_greedy.kara ----
fn a2_generate_the_string(n: i32) -> String {
    let mut counts: Vec[i32] = Vec.filled(26, 0);
    let mut s = String.new();
    for placed in 0..n {
        let left = n - placed - 1;
        for letter in 0..26 {
            counts[letter] += 1;
            let even = counts.iter().filter(|c| c > 0 and c % 2 == 0).count();
            let unused = counts.iter().any(|c| c == 0);
            if even <= left and ((left - even) % 2 == 0 or unused) {
                s.push((b'a' + letter as u8) as char);
                break;
            }
            counts[letter] -= 1;
        }
    }
    s
}

// ---- generate_the_string_bytes.kara ----
fn a3_generate_the_string(n: i32) -> String {
    let mut bytes: Vec[u8] = Vec.filled(n, b'a');
    if n % 2 == 0 {
        bytes[n - 1] = b'b';
    }
    String.from_utf8(bytes).unwrap()
}

// ---- generate_the_string_solution.kara ----
struct A4Solution {}

impl A4Solution {
    pub fn a4_generate_the_string(n: i32) -> String {
        let mut s = "a".repeat((n - 1) as i64);
        s.push(if n % 2 == 0 { 'b' } else { 'a' });
        s
    }
}

fn a4_generate_the_string(n: i32) -> String {
    A4Solution.a4_generate_the_string(n)
}

// ---- the differential -------------------------------------------------------

// every letter that appears does so an odd number of times, and there
// is nothing but lowercase letters
fn valid(s: Str) -> bool {
    let mut counts: Array[i64, 26] = [0; 26];
    for b in s.bytes().iter() {
        if b < b'a' or b > b'z' {
            return false;
        }
        counts[b - b'a'] += 1;
    }
    counts.iter().all(|c| c == 0 or c % 2 == 1)
}

// the statement read literally: the strings of n lowercase letters
// counted through in dictionary order from n a's, the first valid one
fn literal(n: i64) -> String {
    let mut letters: Vec[u8] = Vec.filled(n, b'a');
    loop {
        let s = String.from_utf8(letters.clone()).unwrap();
        if valid(s) {
            return s;
        }
        // the next string: the last letter that is not a z moved on one,
        // every z after it back to a
        let mut i = n - 1;
        while letters[i] == b'z' {
            letters[i] = b'a';
            i -= 1;
        }
        letters[i] += 1;
    }
}

struct Tally {
    cases: i64,
    checks: i64,
    failures: i64,
    check: i64,
    by: Vec[i64],
}

fn expect(t: mut ref Tally, property: i64, ok: bool, what: Str) {
    t.checks += 1;
    if not ok {
        t.failures += 1;
        t.by[property] += 1;
        if t.failures <= 5 {
            println(f"FAIL {what}");
        }
    }
}

fn arm(i: i64, n: i32) -> String {
    match i {
        0 => a0_generate_the_string(n),
        1 => a1_generate_the_string(n),
        2 => a2_generate_the_string(n),
        3 => a3_generate_the_string(n),
        _ => a4_generate_the_string(n),
    }
}

fn check_case(t: mut ref Tally, n: i32) {
    t.cases += 1;
    let want = literal(n);
    for b in want.bytes().iter() {
        t.check = (t.check * 131 + b) % 1000000007;
    }
    let star = arm(0, n);
    for i in 0..5 {
        let got = arm(i, n);
        let what = f"arm {i} at n = {n}";
        // P1: the statement read literally
        expect(mut t, 1, got == want, f"P1 {what}: literal {want}, got {got}");
        // P2: n letters, and valid
        expect(mut t, 2, got.len() == n and valid(got), f"P2 {what}: {got}");
        // P3: two letters more, the same string after two a's
        let longer = arm(i, n + 2);
        expect(mut t, 3, longer == "aa" + got, f"P3 {what}: {got}, then {longer}");
        // P4: any one letter but an a made the letter before it, the
        // string no longer valid
        let mut lowered = true;
        let bytes = got.bytes();
        for k in 0..bytes.len() {
            if bytes[k] > b'a' {
                let mut other: Vec[u8] = bytes.to_vec();
                other[k] -= 1;
                if valid(String.from_utf8(other).unwrap()) {
                    lowered = false;
                }
            }
        }
        expect(mut t, 4, lowered, f"P4 {what}: {got}");
        // P5: the letters in order, never falling
        let sorted = (1..bytes.len()).all(|k| bytes[k - 1] <= bytes[k]);
        expect(mut t, 5, sorted, f"P5 {what}: {got}");
        // P6: the ★ arm's string
        expect(mut t, 6, got == star, f"P6 {what}, ★: {star}");
    }
}

fn main() {
    let mut t = Tally { cases: 0, checks: 0, failures: 0, check: 0, by: Vec.filled(7, 0) };
    // every n from 1 to 500, the constraints' range, LeetCode's three
    // examples among them
    for n in 1..501 {
        check_case(mut t, n);
    }
    println(f"{t.cases} cases: checksum {t.check}, {t.checks} checks over 5 arms: {t.failures} failures");
    if t.failures > 0 {
        let parts: Vec[String] = (1..7).filter(|p| t.by[p] > 0).map(|p| f"P{p} {t.by[p]}").collect();
        println(f"failures by property: {parts.join(", ")}");
    }
}
