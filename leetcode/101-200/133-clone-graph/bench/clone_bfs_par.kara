// Parallel-K variant — same per-clone BFS as clone_bfs.kara, but split the
// K=500 outer clones into 18 par-block branches so each runs on a separate
// thread. Calibrated for M5 Pro (6 performance + 12 efficiency = 18 cores);
// 18-way reaches every core. A sweep at K=500 / N ∈ {6, 8, 12, 18, 24} on
// this machine shows N=18 as the wall-clock optimum: par-24 slightly
// regresses because oversubscription costs more than the marginal core
// utilization saves.
//
// 500 doesn't divide cleanly by 18 — 14 branches do 28 clones each (392
// total), the remaining 4 do 27 (108 total), summing to 500. The 4% load
// imbalance is small enough that the longest branch still determines
// wall-clock.
//
// DOES NOT COMPILE — DELIBERATELY KEPT. `karac build` refuses this file:
//
//     error[ownership]: shared struct `Node` cannot be accessed from multiple
//     concurrent tasks (binding `root` reachable from two par-block branches)
//
// and that refusal is CORRECT, per design.md § Rc vs Arc: a `shared struct`
// reachable from more than one concurrent branch is a compile error. Rc→Arc
// promotion covers a sole-ownership move into exactly ONE branch, not an
// 18-way read-only fan-out. The reason is refcount traffic, not mutation —
// `emit_rc_inc` is a plain load/add/store, so even pure READS race.
//
// An earlier revision of this header claimed promotion made `root` "thread-safe
// without any annotation". That was wrong, and the numbers once published from
// it came from a stale pre-gate binary that raced (~0.8% of runs died with
// SIGSEGV/SIGTRAP — kara B-2026-07-28-13, closed as a stale-binary artifact).
//
// The file stays in the tree as a live marker of the expressiveness gap filed
// as kara B-2026-08-01-33. That entry has been corrected twice; its current
// reading: `par struct` with IMMUTABLE fields DOES share across tasks lock-free
// (verified), but the `shared struct` (RC) tier is excluded from parallelism on
// BOTH surfaces — an explicit `par {}` hard-errors as above, and auto-par, the
// DEFAULT build path, silently declines any loop body touching a plain `shared`
// value (concurrency.rs's B-2026-07-16-6 gate, same non-atomic-refcount
// reason). So the Rc-vs-Arc decision is forced at type-declaration time.
//
// This kata sits at the awkward end of it: `Node.neighbors` must be `mut` to
// link a cyclic graph after its nodes exist, and a `mut` COMPOUND field on a
// `par struct` requires `Mutex[T]` (`Atomic[T]` covers only scalars) — so the
// only legal formulation holds a lock through an entirely read-only traversal
// phase, a cost the lock-free C/rust/go mirrors do not pay. Three candidate
// fixes are on the ledger entry (par-capture RC elision, whole-program
// atomicity promotion, freeze point); if any lands, this file starts compiling
// and the par lane can come back. bench.sh skips it; see the § Runtime — par
// lane note in ../README.md.

shared struct Node {
    val: i64,
    mut neighbors: Vec[Node],
}

fn clone_graph(root: Node) -> Node {
    let mut visited: Map[i64, Node] = Map.new();
    let mut queue: VecDeque[Node] = VecDeque.new();

    let root_clone = Node { val: root.val, neighbors: Vec.new() };
    let _ = visited.insert(root.val, root_clone);
    queue.push_back(root);

    loop {
        if let Some(curr) = queue.pop_front() {
            let curr_clone = visited.get(curr.val).unwrap();
            for nb in curr.neighbors.iter() {
                if let None = visited.get(nb.val) {
                    let fresh = Node { val: nb.val, neighbors: Vec.new() };
                    let _ = visited.insert(nb.val, fresh);
                    queue.push_back(nb);
                }
                let nb_clone = visited.get(nb.val).unwrap();
                curr_clone.neighbors.push(nb_clone);
            }
        } else {
            break;
        }
    }

    // Return the held `root_clone` alias directly (same shape as
    // clone_bfs.kara — see the note there; was the bug-7 hang).
    root_clone
}

fn sum_clones(root: Node, count: i64) -> i64 {
    let mut s: i64 = 0;
    for _ in 0..count {
        let c = clone_graph(root);
        s = s + c.val;
    }
    s
}

fn main() {
    let n: i64 = 2000;
    let half_deg: i64 = 5;

    let mut nodes: Vec[Node] = Vec.new();
    for i in 0..n {
        nodes.push(Node { val: i + 1, neighbors: Vec.new() });
    }
    for i in 0..n {
        for d in 1..(half_deg + 1) {
            let j = (i + d) % n;
            nodes[i as u64].neighbors.push(nodes[j as u64]);
            nodes[j as u64].neighbors.push(nodes[i as u64]);
        }
    }

    let root = nodes[0];

    // K=500 split 18-way: 28 × 14 + 27 × 4 = 500.
    let (s1, s2, s3, s4, s5, s6, s7, s8, s9,
         s10, s11, s12, s13, s14, s15, s16, s17, s18) = par {
        let s1 = sum_clones(root, 28);
        let s2 = sum_clones(root, 28);
        let s3 = sum_clones(root, 28);
        let s4 = sum_clones(root, 28);
        let s5 = sum_clones(root, 28);
        let s6 = sum_clones(root, 28);
        let s7 = sum_clones(root, 28);
        let s8 = sum_clones(root, 28);
        let s9 = sum_clones(root, 28);
        let s10 = sum_clones(root, 28);
        let s11 = sum_clones(root, 28);
        let s12 = sum_clones(root, 28);
        let s13 = sum_clones(root, 28);
        let s14 = sum_clones(root, 28);
        let s15 = sum_clones(root, 27);
        let s16 = sum_clones(root, 27);
        let s17 = sum_clones(root, 27);
        let s18 = sum_clones(root, 27);
        (s1, s2, s3, s4, s5, s6, s7, s8, s9,
         s10, s11, s12, s13, s14, s15, s16, s17, s18)
    };
    println(s1+s2+s3+s4+s5+s6+s7+s8+s9+s10+s11+s12+s13+s14+s15+s16+s17+s18);
}
