// Benchmark harness for LeetCode #134 — Gas Station.
//
// Build-once + punch (BENCHMARKS.md): eight gas/cost array pairs are built
// once, then each punch runs the greedy single pass over one of them.
//
// The parameters are `ref Vec[i64]` rather than the kata's by-value
// `Vec[i64]`: taking them by value would copy 200 000 elements per call, which
// no mirror does and which would swamp the O(n) scan being measured.
//
// Half the pairs are feasible (total gas >= total cost, so a unique start
// exists) and half are not. Both walk the entire array — the algorithm has no
// early exit — but they differ in how often the `tank < 0` restart fires, which
// is the only branch in the loop.

fn can_complete(gas: ref Vec[i64], cost: ref Vec[i64]) -> i64 {
    let n = gas.len();
    let mut total = 0i64;
    let mut tank = 0i64;
    let mut start = 0i64;
    let mut i = 0i64;
    while i < n {
        let d = gas[i] - cost[i];
        total = total + d;
        tank = tank + d;
        if tank < 0i64 {
            start = i + 1i64;
            tank = 0i64;
        }
        i = i + 1i64;
    }
    if total >= 0i64 {
        start
    } else {
        -1i64
    }
}

fn lcg(seed: i64, n: i64, cap: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = seed;
    let mut k = 0i64;
    while k < n {
        x = (x * 1103515245i64 + 12345i64) % 2147483648i64;
        out.push((x / 65536i64) % cap);
        k = k + 1i64;
    }
    out
}

fn main() {
    let np = 8i64;
    let n = 200000i64;
    let iters = 1200i64;

    let mut gases: Vec[Vec[i64]] = Vec.new();
    let mut costs: Vec[Vec[i64]] = Vec.new();
    let mut j = 0i64;
    while j < np {
        gases.push(lcg(j + 1i64, n, 100i64));
        // Even j: costs drawn from a smaller range, so total gas exceeds total
        // cost and the trip is feasible. Odd j: a larger range, so it is not.
        if j % 2i64 == 0i64 {
            costs.push(lcg(j + 100i64, n, 90i64));
        } else {
            costs.push(lcg(j + 100i64, n, 110i64));
        }
        j = j + 1i64;
    }

    let mut sink = 0i64;
    let mut it = 0i64;
    while it < iters {
        let idx = (it * 3i64) % np;
        sink = (sink + can_complete(gases[idx], costs[idx])) % 1000000007i64;
        it = it + 1i64;
    }
    println(f"{sink}");
}
