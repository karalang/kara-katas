// LeetCode #2518: Number of Great Partitions -- the differential. The six
// arms against the statement read literally: every split of the numbers
// into a first group and a second, made by a recursion that puts each
// number in one or the other, counted when both groups sum to at least
// k. No knapsack and no complement. 300 random lists of 1 to 10 numbers
// to 20 with k from 1 to 30; then 20 of 12 ones with k from 1 to 7, and
// 40 of 8 numbers to 10^9 with k to 1000; every one drawn before any arm
// answers.
//
// P1  the answer is the statement read literally
// P2  even, and at most 2^n - 2
// P3  the numbers in the reverse order: the same answer
// P4  every number doubled, and k doubled: the same answer
// P5  k one more: at most the answer
// P6  each arm agrees with at least three of the other five

const MOD: i64 = 1000000007;

// ---- the statement read literally

fn splits(nums: Vec[i64], k: i64, at: i64, first: i64, second: i64) -> i64 {
    if at == nums.len() {
        return if first >= k and second >= k { 1 } else { 0 };
    }
    splits(nums, k, at + 1, first + nums[at], second) + splits(nums, k, at + 1, first, second + nums[at])
}

fn literal(nums: Vec[i64], k: i64) -> i64 {
    splits(nums, k, 0, 0, 0)
}

// ---- star (great.kara) ---------------------------------------------------

fn star_count_partitions(nums: Vec[i64], k: i64) -> i64 {
    let total: i64 = nums.iter().sum();
    if total < 2 * k {
        return 0;
    }
    let mut ways: Vec[i64] = Vec.filled(k, 0);
    ways[0] = 1;
    let mut all = 1;
    for x in nums.iter() {
        all = all * 2 % MOD;
        if x < k {
            for s in (x..k).rev() {
                ways[s] = (ways[s] + ways[s - x]) % MOD;
            }
        }
    }
    let short = ways.iter().fold(0, |a, w| (a + w) % MOD);
    ((all - 2 * short) % MOD + MOD) % MOD
}

// ---- table (great_table.kara) --------------------------------------------

fn table_count_partitions(nums: Vec[i64], k: i64) -> i64 {
    let n = nums.len();
    if nums.iter().sum() < 2 * k {
        return 0;
    }
    let mut table: Vec[Vec[i64]] = Vec.filled(n + 1, Vec.filled(k, 0));
    table[0][0] = 1;
    for i in 1..n + 1 {
        for s in 0..k {
            let mut w = table[i - 1][s];
            if s >= nums[i - 1] {
                w = (w + table[i - 1][s - nums[i - 1]]) % MOD;
            }
            table[i][s] = w;
        }
    }
    let mut all = 1;
    for _ in 0..n {
        all = all * 2 % MOD;
    }
    let mut short = 0;
    for s in 0..k {
        short = (short + table[n][s]) % MOD;
    }
    (all - 2 * short % MOD + MOD) % MOD
}

// ---- sums (great_sums.kara) ----------------------------------------------

fn sums_count_partitions(nums: Vec[i64], k: i64) -> i64 {
    if nums.iter().sum() < 2 * k {
        return 0;
    }
    let mut reached: SortedMap[i64, i64] = SortedMap.new();
    reached.insert(0, 1);
    let mut all = 1;
    for x in nums.iter() {
        all = all * 2 % MOD;
        let mut more: Vec[(i64, i64)] = Vec.new();
        for (s, w) in reached.iter() {
            if s + x < k {
                more.push((s + x, w));
            }
        }
        for (s, w) in more.iter() {
            let before = reached.get(s) ?? 0;
            reached.insert(s, (before + w) % MOD);
        }
    }
    let mut short = 0;
    for (_, w) in reached.iter() {
        short = (short + w) % MOD;
    }
    ((all - 2 * short) % MOD + MOD) % MOD
}

// ---- rec (great_rec.kara) ------------------------------------------------

fn rec_fit(nums: Vec[i64], i: i64, room: i64, memo: mut ref Vec[Vec[i64]]) -> i64 {
    if i == nums.len() {
        return 1;
    }
    if memo[i][room] >= 0 {
        return memo[i][room];
    }
    let mut ways = rec_fit(nums, i + 1, room, mut memo);
    if nums[i] <= room {
        ways = (ways + rec_fit(nums, i + 1, room - nums[i], mut memo)) % MOD;
    }
    memo[i][room] = ways;
    ways
}

fn rec_two_to(n: i64) -> i64 {
    if n == 0 {
        1
    } else {
        let half = rec_two_to(n / 2);
        if n % 2 == 1 { half * half % MOD * 2 % MOD } else { half * half % MOD }
    }
}

fn rec_count_partitions(nums: Vec[i64], k: i64) -> i64 {
    if nums.iter().sum() < 2 * k {
        return 0;
    }
    let mut memo: Vec[Vec[i64]] = Vec.filled(nums.len(), Vec.filled(k, -1));
    let short = rec_fit(nums, 0, k - 1, mut memo);
    ((rec_two_to(nums.len()) - 2 * short) % MOD + MOD) % MOD
}

// ---- iter (great_iter.kara) ----------------------------------------------

fn iter_count_partitions(nums: Vec[i64], k: i64) -> i64 {
    if nums.iter().sum() < 2 * k {
        return 0;
    }
    let start: Vec[i64] = (0..k).map(|s| if s == 0 { 1 } else { 0 }).collect();
    let ways = nums.iter().fold(start, |ways, x| (0..k).map(|s| if s >= x { (ways[s] + ways[s - x]) % MOD } else { ways[s] }).collect());
    let short = ways.iter().fold(0, |a, w| (a + w) % MOD);
    let all = nums.iter().fold(1, |a, _| a * 2 % MOD);
    ((all - 2 * short) % MOD + MOD) % MOD
}

// ---- solution (great_solution.kara) --------------------------------------

struct Solution {}

impl Solution {
    pub fn count_partitions(nums: Vec[i32], k: i32) -> i32 {
        let total: i64 = nums.iter().map(|x| x as i64).sum();
        if total < 2 * k as i64 {
            return 0;
        }
        let k = k as i64;
        let mut dp = Vec.filled(k, 0);
        dp[0] = 1;
        let mut all: i64 = 1;
        for x in ref nums {
            all = all * 2 % MOD;
            let x = x as i64;
            for s in (x..k).rev() {
                dp[s] = (dp[s] + dp[s - x]) % MOD;
            }
        }
        let bad: i64 = dp.iter().sum() % MOD;
        ((all - 2 * bad % MOD + 2 * MOD) % MOD) as i32
    }
}

fn solution_count_partitions(nums: Vec[i64], k: i64) -> i64 {
    let v: Vec[i32] = nums.iter().map(|x| x as i32).collect();
    Solution.count_partitions(v, k as i32)
}

// ---- the differential --------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn below(top: i64, seed: mut ref i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % top
}

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_count_partitions(nums, k),
        1 => table_count_partitions(nums, k),
        2 => sums_count_partitions(nums, k),
        3 => rec_count_partitions(nums, k),
        4 => iter_count_partitions(nums, k),
        _ => solution_count_partitions(nums, k),
    }
}

fn main() {
    let names = ["star", "table", "sums", "rec", "iter", "solution"];
    let mut seed = 2518;
    let mut problems: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..360 {
        let (n, top, most_k) = if t < 300 { (next_random(mut seed) % 10 + 1, 20, 30) } else if t < 320 { (12, 1, 7) } else { (8, 1000000000, 1000) };
        let nums: Vec[i64] = (0..n).map(|_| below(top, mut seed) + 1).collect();
        let k = next_random(mut seed) % most_k + 1;
        problems.push((nums, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut none = 0;
    for (nums, k) in problems.iter() {
        let truth = literal(nums, k);
        if truth == 0 {
            none += 1;
        }
        check = (check * 31 + truth) % MOD;
        let mut reversed = nums.clone();
        reversed.reverse();
        let doubled: Vec[i64] = nums.iter().map(|x| 2 * x).collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                x % 2 == 0 and x >= 0 and x <= (1 << nums.len()) - 2,
                answer(arm, reversed, k) == x,
                answer(arm, doubled, 2 * k) == x,
                answer(arm, nums, k + 1) <= x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} k {k}, arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases, {none} with no great partition: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
