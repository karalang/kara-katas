// LeetCode #2502: Design Memory Allocator -- a segment tree over the
// units, each node holding its longest free run and the free runs at its
// two ends; `allocate` descends to the leftmost run of `size`, through a
// child or across the two children's meeting ends, then marks its units
// one by one. Every unit's owner is kept too, for `free_memory`. O(size
// log n) to allocate, O(n + freed log n) to free.

struct Allocator {
    n: i64,
    owner: Vec[i64],
    prefix: Vec[i64],
    suffix: Vec[i64],
    best: Vec[i64],
}

impl Allocator {
    fn new(n: i64) -> Allocator {
        let mut a = Allocator { n: n, owner: Vec.filled(n, 0), prefix: Vec.filled(4 * n, 0), suffix: Vec.filled(4 * n, 0), best: Vec.filled(4 * n, 0) };
        a.build(1, 0, n - 1);
        a
    }

    fn build(mut ref self, node: i64, lo: i64, hi: i64) {
        let length = hi - lo + 1;
        self.prefix[node] = length;
        self.suffix[node] = length;
        self.best[node] = length;
        if lo < hi {
            let mid = (lo + hi) / 2;
            self.build(2 * node, lo, mid);
            self.build(2 * node + 1, mid + 1, hi);
        }
    }

    fn set(mut ref self, node: i64, lo: i64, hi: i64, at: i64, free: bool) {
        if lo == hi {
            let v = if free { 1 } else { 0 };
            self.prefix[node] = v;
            self.suffix[node] = v;
            self.best[node] = v;
            return;
        }
        let mid = (lo + hi) / 2;
        if at <= mid {
            self.set(2 * node, lo, mid, at, free);
        } else {
            self.set(2 * node + 1, mid + 1, hi, at, free);
        }
        let (l, r) = (2 * node, 2 * node + 1);
        self.prefix[node] = if self.prefix[l] == mid - lo + 1 { self.prefix[l] + self.prefix[r] } else { self.prefix[l] };
        self.suffix[node] = if self.suffix[r] == hi - mid { self.suffix[r] + self.suffix[l] } else { self.suffix[r] };
        self.best[node] = self.best[l].max(self.best[r]).max(self.suffix[l] + self.prefix[r]);
    }

    fn find(self, node: i64, lo: i64, hi: i64, size: i64) -> i64 {
        if self.best[node] < size {
            return -1;
        }
        if lo == hi {
            return lo;
        }
        let mid = (lo + hi) / 2;
        let (l, r) = (2 * node, 2 * node + 1);
        if self.best[l] >= size {
            self.find(l, lo, mid, size)
        } else if self.suffix[l] + self.prefix[r] >= size {
            mid - self.suffix[l] + 1
        } else {
            self.find(r, mid + 1, hi, size)
        }
    }

    fn allocate(mut ref self, size: i64, m_id: i64) -> i64 {
        let start = self.find(1, 0, self.n - 1, size);
        if start >= 0 {
            for i in start..start + size {
                self.owner[i] = m_id;
                self.set(1, 0, self.n - 1, i, false);
            }
        }
        start
    }

    fn free_memory(mut ref self, m_id: i64) -> i64 {
        let mut freed = 0;
        for i in 0..self.n {
            if self.owner[i] == m_id {
                self.owner[i] = 0;
                self.set(1, 0, self.n - 1, i, true);
                freed += 1;
            }
        }
        freed
    }
}

// the calls in order: (0, size, id) allocates, (1, id, _) frees
fn drive(n: i64, ops: Vec[(i64, i64, i64)]) -> Vec[i64] {
    let mut allocator = Allocator.new(n);
    let mut out: Vec[i64] = Vec.new();
    for (kind, x, y) in ops.iter() {
        out.push(if kind == 0 { allocator.allocate(x, y) } else { allocator.free_memory(x) });
    }
    out
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// an allocate two times in three, of 1 to `most` units; else a free
fn random_ops(count: i64, most: i64, ids: i64, seed: mut ref i64) -> Vec[(i64, i64, i64)] {
    let mut ops: Vec[(i64, i64, i64)] = Vec.new();
    for _ in 0..count {
        if next_random(mut seed) % 3 < 2 {
            let size = next_random(mut seed) % most + 1;
            ops.push((0, size, next_random(mut seed) % ids + 1));
        } else {
            ops.push((1, next_random(mut seed) % ids + 1, 0));
        }
    }
    ops
}

fn main() {
    // LeetCode's example, then three more
    let example = [(0, 1, 1), (0, 1, 2), (0, 1, 3), (1, 2, 0), (0, 3, 4), (0, 1, 1), (0, 1, 1), (1, 1, 0), (0, 10, 2), (1, 7, 0)].to_vec();
    println(f"example: {drive(10, example)}");
    println(f"one unit: {drive(1, [(0, 1, 5), (0, 1, 5), (1, 5, 0), (1, 5, 0), (0, 1, 6)].to_vec())}");
    println(f"whole: {drive(4, [(0, 4, 1), (1, 1, 0), (0, 2, 2), (0, 3, 3), (0, 2, 3), (1, 2, 0), (0, 3, 1)].to_vec())}");
    println(f"gaps: {drive(6, [(0, 2, 1), (0, 2, 2), (0, 2, 1), (1, 1, 0), (0, 3, 3), (0, 1, 4), (0, 2, 5), (1, 2, 0), (0, 3, 6)].to_vec())}");
    // 2000 random sequences of 1 to 60 calls on 1 to 50 units, ids to 3
    // and to 20: how many allocations are refused, and a checksum
    let mut seed = 2502;
    for ids in [3, 20] {
        let mut check = 0;
        let mut refused = 0;
        for _ in 0..2000 {
            let n = next_random(mut seed) % 50 + 1;
            let count = next_random(mut seed) % 60 + 1;
            for r in drive(n, random_ops(count, n / 3 + 1, ids, mut seed)).iter() {
                if r == -1 {
                    refused += 1;
                }
                check = (check * 31 + r + 1) % 1000000007;
            }
        }
        println(f"2000 random, ids to {ids}: {refused} refused, checksum {check}");
    }
    // the constraints' largest: 1000 units and 1000 random calls; and 999
    // allocations of one unit, then a free
    let big = drive(1000, random_ops(1000, 20, 50, mut seed));
    let mut check = 0;
    for r in big.iter() {
        check = (check * 31 + r + 1) % 1000000007;
    }
    println(f"1000 units, 1000 random calls: {big.iter().filter(|r| r == -1).count()} refused, checksum {check}");
    let mut ones: Vec[(i64, i64, i64)] = (0..999).map(|i| (0, 1, i % 1000 + 1)).collect();
    ones.push((1, 500, 0));
    let got = drive(1000, ones);
    println(f"1000 units, 999 of one, then a free: last {got[got.len() - 2]}, freed {got[got.len() - 1]}");
}
