// LeetCode #2532: Time to Cross a Bridge -- no queues: each worker's
// place and the minute it is free, and every choice a scan over all `k`
// workers. The least efficient waiting on the right crosses first, else
// the least efficient waiting on the left while boxes are left to send
// for, else the clock moves to the soonest worker to finish a box.
// O(n k).

enum Place {
    WaitLeft,
    Picking,
    WaitRight,
    Putting,
}

fn find_crossing_time(n: i64, k: i64, time: Vec[Vec[i64]]) -> i64 {
    let mut place = Vec.filled(k, Place.WaitLeft);
    let mut free = Vec.filled(k, 0);
    let mut boxes = n;
    let mut carried = 0;
    let mut now = 0;
    while carried < n {
        for i in 0..k {
            if free[i] <= now {
                match place[i] {
                    Place.Picking => place[i] = Place.WaitRight,
                    Place.Putting => place[i] = Place.WaitLeft,
                    _ => {}
                }
            }
        }
        let mut right = -1;
        let mut left = -1;
        for i in 0..k {
            let worse = |j: i64| j == -1 or time[i][0] + time[i][2] >= time[j][0] + time[j][2];
            match place[i] {
                Place.WaitRight => if worse(right) { right = i; },
                Place.WaitLeft => if worse(left) { left = i; },
                _ => {}
            }
        }
        if right != -1 {
            now += time[right][2];
            place[right] = Place.Putting;
            free[right] = now + time[right][3];
            carried += 1;
        } else if boxes > 0 and left != -1 {
            now += time[left][0];
            place[left] = Place.Picking;
            free[left] = now + time[left][1];
            boxes -= 1;
        } else {
            let mut next = i64.MAX;
            for i in 0..k {
                match place[i] {
                    Place.Picking => next = next.min(free[i]),
                    Place.Putting => if boxes > 0 { next = next.min(free[i]); },
                    _ => {}
                }
            }
            now = next;
        }
    }
    now
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then six more
    let fixed: Vec[(i64, i64, Vec[Vec[i64]])] = [
        (1, 3, [[1, 1, 2, 1], [1, 1, 3, 1], [1, 1, 4, 1]]),
        (3, 2, [[1, 9, 1, 8], [10, 10, 10, 10]]),
        (1, 1, [[1, 1, 1, 1]]),
        (1000, 1, [[1, 1, 1, 1]]),
        (2, 3, [[5, 1, 5, 1], [1, 1, 9, 1], [9, 1, 1, 1]]),
        (5, 2, [[1, 1000, 1, 1000], [1000, 1, 1000, 1]]),
        (4, 4, [[3, 3, 3, 3], [3, 3, 3, 3], [3, 3, 3, 3], [3, 3, 3, 3]]),
        (10, 3, [[2, 7, 4, 1], [6, 1, 1, 9], [3, 3, 3, 3]]),
    ];
    for (n, k, time) in fixed.iter() {
        println(f"n {n} k {k} {time} -> {find_crossing_time(n, k, time)}");
    }
    // 2000 random cases of 1 to 10 boxes, 1 to 5 workers and times to 10,
    // and 40 of 1 to 1000 boxes, 1 to 100 workers and times to 1000
    let mut seed = 2532;
    for (count, boxes, workers, most) in [(2000, 10, 5, 10), (40, 1000, 100, 1000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = next_random(mut seed) % boxes + 1;
            let k = next_random(mut seed) % workers + 1;
            let mut time: Vec[Vec[i64]] = Vec.new();
            for _ in 0..k {
                let mut row = Vec.new();
                for _ in 0..4 {
                    row.push(next_random(mut seed) % most + 1);
                }
                time.push(row);
            }
            let answer = find_crossing_time(n, k, time);
            total += answer;
            check = (check * 31 + answer) % 1000000007;
        }
        println(f"{count} random cases of up to {boxes} boxes and {workers} workers: total {total}, checksum {check}");
    }
}
