// LeetCode #2532: Time to Cross a Bridge -- the ★ arm.
// An event simulation on four priority queues: the workers waiting on
// each side, least efficient first, as `(lr + rl, i)` largest first, and
// the workers picking or putting, as `(done, i)` soonest first. The
// bridge goes to a worker waiting on the right, else to one on the left
// while boxes are left to send for, else the clock jumps to the next
// worker to finish. O(n log k).

fn find_crossing_time(n: i64, k: i64, time: Vec[Vec[i64]]) -> i64 {
    let mut left: PriorityQueue[(i64, i64)] = PriorityQueue.max_first();
    for i in 0..k {
        left.push((time[i][0] + time[i][2], i));
    }
    let mut right: PriorityQueue[(i64, i64)] = PriorityQueue.max_first();
    let mut picking: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut putting: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut boxes = n;
    let mut now = 0;
    while boxes > 0 or not right.is_empty() or not picking.is_empty() {
        while let Some((done, i)) = putting.peek() {
            if not (done <= now) {
                break;
            }
            putting.pop();
            left.push((time[i][0] + time[i][2], i));
        }
        while let Some((done, i)) = picking.peek() {
            if not (done <= now) {
                break;
            }
            picking.pop();
            right.push((time[i][0] + time[i][2], i));
        }
        if let Some((_, i)) = right.pop() {
            now += time[i][2];
            putting.push((now + time[i][3], i));
        } else if boxes > 0 and not left.is_empty() {
            let (_, i) = left.pop().unwrap();
            now += time[i][0];
            boxes -= 1;
            picking.push((now + time[i][1], i));
        } else {
            let mut next = i64.MAX;
            if let Some((done, _)) = picking.peek() {
                next = next.min(done);
            }
            if boxes > 0 {
                if let Some((done, _)) = putting.peek() {
                    next = next.min(done);
                }
            }
            now = next;
        }
    }
    now
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then six more
    let fixed: Vec[(i64, i64, Vec[Vec[i64]])] = [
        (1, 3, [[1, 1, 2, 1], [1, 1, 3, 1], [1, 1, 4, 1]]),
        (3, 2, [[1, 9, 1, 8], [10, 10, 10, 10]]),
        (1, 1, [[1, 1, 1, 1]]),
        (1000, 1, [[1, 1, 1, 1]]),
        (2, 3, [[5, 1, 5, 1], [1, 1, 9, 1], [9, 1, 1, 1]]),
        (5, 2, [[1, 1000, 1, 1000], [1000, 1, 1000, 1]]),
        (4, 4, [[3, 3, 3, 3], [3, 3, 3, 3], [3, 3, 3, 3], [3, 3, 3, 3]]),
        (10, 3, [[2, 7, 4, 1], [6, 1, 1, 9], [3, 3, 3, 3]]),
    ];
    for (n, k, time) in fixed.iter() {
        println(f"n {n} k {k} {time} -> {find_crossing_time(n, k, time)}");
    }
    // 2000 random cases of 1 to 10 boxes, 1 to 5 workers and times to 10,
    // and 40 of 1 to 1000 boxes, 1 to 100 workers and times to 1000
    let mut seed = 2532;
    for (count, boxes, workers, most) in [(2000, 10, 5, 10), (40, 1000, 100, 1000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = next_random(mut seed) % boxes + 1;
            let k = next_random(mut seed) % workers + 1;
            let mut time: Vec[Vec[i64]] = Vec.new();
            for _ in 0..k {
                let mut row = Vec.new();
                for _ in 0..4 {
                    row.push(next_random(mut seed) % most + 1);
                }
                time.push(row);
            }
            let answer = find_crossing_time(n, k, time);
            total += answer;
            check = (check * 31 + answer) % 1000000007;
        }
        println(f"{count} random cases of up to {boxes} boxes and {workers} workers: total {total}, checksum {check}");
    }
}
