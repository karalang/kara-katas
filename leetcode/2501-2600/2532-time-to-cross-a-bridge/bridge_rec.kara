// LeetCode #2532: Time to Cross a Bridge -- recursion: the ★ arm's four
// queues, with each move of the simulation one call. `release` moves the
// workers done by `now` to their side's waiting queue, one call each, and
// `cross` makes one move (a crossing or a jump of the clock) and calls
// itself for the rest. At most about 4n deep.

fn release(working: mut ref PriorityQueue[(i64, i64)], waiting: mut ref PriorityQueue[(i64, i64)], time: Vec[Vec[i64]], now: i64) {
    match working.peek() {
        Some((done, i)) if done <= now => {
            let worker = i;
            working.pop();
            waiting.push((time[worker][0] + time[worker][2], worker));
            release(mut working, mut waiting, time, now);
        }
        _ => {}
    }
}

fn cross(
    time: Vec[Vec[i64]],
    left: mut ref PriorityQueue[(i64, i64)],
    right: mut ref PriorityQueue[(i64, i64)],
    picking: mut ref PriorityQueue[(i64, i64)],
    putting: mut ref PriorityQueue[(i64, i64)],
    boxes: i64,
    now: i64,
) -> i64 {
    if boxes == 0 and right.is_empty() and picking.is_empty() {
        return now;
    }
    release(mut putting, mut left, time, now);
    release(mut picking, mut right, time, now);
    if let Some((_, i)) = right.pop() {
        let at = now + time[i][2];
        putting.push((at + time[i][3], i));
        cross(time, mut left, mut right, mut picking, mut putting, boxes, at)
    } else if boxes > 0 and not left.is_empty() {
        let (_, i) = left.pop().unwrap();
        let at = now + time[i][0];
        picking.push((at + time[i][1], i));
        cross(time, mut left, mut right, mut picking, mut putting, boxes - 1, at)
    } else {
        let mut next = picking.peek().map(|p| p.0).unwrap_or(i64.MAX);
        if boxes > 0 {
            next = next.min(putting.peek().map(|p| p.0).unwrap_or(i64.MAX));
        }
        cross(time, mut left, mut right, mut picking, mut putting, boxes, next)
    }
}

fn find_crossing_time(n: i64, k: i64, time: Vec[Vec[i64]]) -> i64 {
    let mut left: PriorityQueue[(i64, i64)] = PriorityQueue.max_first_from((0..k).map(|i| (time[i][0] + time[i][2], i)).collect());
    let mut right: PriorityQueue[(i64, i64)] = PriorityQueue.max_first();
    let mut picking: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut putting: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    cross(time, mut left, mut right, mut picking, mut putting, n, 0)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then six more
    let fixed: Vec[(i64, i64, Vec[Vec[i64]])] = [
        (1, 3, [[1, 1, 2, 1], [1, 1, 3, 1], [1, 1, 4, 1]]),
        (3, 2, [[1, 9, 1, 8], [10, 10, 10, 10]]),
        (1, 1, [[1, 1, 1, 1]]),
        (1000, 1, [[1, 1, 1, 1]]),
        (2, 3, [[5, 1, 5, 1], [1, 1, 9, 1], [9, 1, 1, 1]]),
        (5, 2, [[1, 1000, 1, 1000], [1000, 1, 1000, 1]]),
        (4, 4, [[3, 3, 3, 3], [3, 3, 3, 3], [3, 3, 3, 3], [3, 3, 3, 3]]),
        (10, 3, [[2, 7, 4, 1], [6, 1, 1, 9], [3, 3, 3, 3]]),
    ];
    for (n, k, time) in fixed.iter() {
        println(f"n {n} k {k} {time} -> {find_crossing_time(n, k, time)}");
    }
    // 2000 random cases of 1 to 10 boxes, 1 to 5 workers and times to 10,
    // and 40 of 1 to 1000 boxes, 1 to 100 workers and times to 1000
    let mut seed = 2532;
    for (count, boxes, workers, most) in [(2000, 10, 5, 10), (40, 1000, 100, 1000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = next_random(mut seed) % boxes + 1;
            let k = next_random(mut seed) % workers + 1;
            let mut time: Vec[Vec[i64]] = Vec.new();
            for _ in 0..k {
                let mut row = Vec.new();
                for _ in 0..4 {
                    row.push(next_random(mut seed) % most + 1);
                }
                time.push(row);
            }
            let answer = find_crossing_time(n, k, time);
            total += answer;
            check = (check * 31 + answer) % 1000000007;
        }
        println(f"{count} random cases of up to {boxes} boxes and {workers} workers: total {total}, checksum {check}");
    }
}
