// LeetCode #2532: Time to Cross a Bridge -- ordered sets for the four
// queues: each side's waiting workers as `(lr + rl, i)` in a `SortedSet`,
// the least efficient its last, and the workers picking or putting as
// `(done, i)`, the soonest first. A finished worker is taken off with
// `pop_first` and put back when it is not done yet. O(n log k).

fn find_crossing_time(n: i64, k: i64, time: Vec[Vec[i64]]) -> i64 {
    let mut left: SortedSet[(i64, i64)] = SortedSet.new();
    for i in 0..k {
        left.insert((time[i][0] + time[i][2], i));
    }
    let mut right: SortedSet[(i64, i64)] = SortedSet.new();
    let mut picking: SortedSet[(i64, i64)] = SortedSet.new();
    let mut putting: SortedSet[(i64, i64)] = SortedSet.new();
    let mut boxes = n;
    let mut now = 0;
    while boxes > 0 or right.len() > 0 or picking.len() > 0 {
        while let Some(first) = putting.pop_first() {
            if first.0 > now {
                putting.insert(first);
                break;
            }
            left.insert((time[first.1][0] + time[first.1][2], first.1));
        }
        while let Some(first) = picking.pop_first() {
            if first.0 > now {
                picking.insert(first);
                break;
            }
            right.insert((time[first.1][0] + time[first.1][2], first.1));
        }
        if let Some((_, i)) = right.pop_last() {
            now += time[i][2];
            putting.insert((now + time[i][3], i));
        } else if boxes > 0 and left.len() > 0 {
            let (_, i) = left.pop_last().unwrap();
            now += time[i][0];
            boxes -= 1;
            picking.insert((now + time[i][1], i));
        } else {
            let soonest_pick = picking.min().map(|p| p.0).unwrap_or(i64.MAX);
            let soonest_put = if boxes > 0 { putting.min().map(|p| p.0).unwrap_or(i64.MAX) } else { i64.MAX };
            now = soonest_pick.min(soonest_put);
        }
    }
    now
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then six more
    let fixed: Vec[(i64, i64, Vec[Vec[i64]])] = [
        (1, 3, [[1, 1, 2, 1], [1, 1, 3, 1], [1, 1, 4, 1]]),
        (3, 2, [[1, 9, 1, 8], [10, 10, 10, 10]]),
        (1, 1, [[1, 1, 1, 1]]),
        (1000, 1, [[1, 1, 1, 1]]),
        (2, 3, [[5, 1, 5, 1], [1, 1, 9, 1], [9, 1, 1, 1]]),
        (5, 2, [[1, 1000, 1, 1000], [1000, 1, 1000, 1]]),
        (4, 4, [[3, 3, 3, 3], [3, 3, 3, 3], [3, 3, 3, 3], [3, 3, 3, 3]]),
        (10, 3, [[2, 7, 4, 1], [6, 1, 1, 9], [3, 3, 3, 3]]),
    ];
    for (n, k, time) in fixed.iter() {
        println(f"n {n} k {k} {time} -> {find_crossing_time(n, k, time)}");
    }
    // 2000 random cases of 1 to 10 boxes, 1 to 5 workers and times to 10,
    // and 40 of 1 to 1000 boxes, 1 to 100 workers and times to 1000
    let mut seed = 2532;
    for (count, boxes, workers, most) in [(2000, 10, 5, 10), (40, 1000, 100, 1000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = next_random(mut seed) % boxes + 1;
            let k = next_random(mut seed) % workers + 1;
            let mut time: Vec[Vec[i64]] = Vec.new();
            for _ in 0..k {
                let mut row = Vec.new();
                for _ in 0..4 {
                    row.push(next_random(mut seed) % most + 1);
                }
                time.push(row);
            }
            let answer = find_crossing_time(n, k, time);
            total += answer;
            check = (check * 31 + answer) % 1000000007;
        }
        println(f"{count} random cases of up to {boxes} boxes and {workers} workers: total {total}, checksum {check}");
    }
}
