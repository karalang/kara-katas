// LeetCode #2532: Time to Cross a Bridge -- benchmark of the ★ arm
// (bridge.kara): 200 cases built once, then the passes, each asking every
// case from an offset the checksum picks.

fn find_crossing_time(n: i64, k: i64, time: Vec[Vec[i64]]) -> i64 {
    let mut left: PriorityQueue[(i64, i64)] = PriorityQueue.max_first();
    for i in 0..k {
        left.push((time[i][0] + time[i][2], i));
    }
    let mut right: PriorityQueue[(i64, i64)] = PriorityQueue.max_first();
    let mut picking: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut putting: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    let mut boxes = n;
    let mut now = 0;
    while boxes > 0 or not right.is_empty() or not picking.is_empty() {
        while let Some((done, i)) = putting.peek() {
            if not (done <= now) {
                break;
            }
            putting.pop();
            left.push((time[i][0] + time[i][2], i));
        }
        while let Some((done, i)) = picking.peek() {
            if not (done <= now) {
                break;
            }
            picking.pop();
            right.push((time[i][0] + time[i][2], i));
        }
        if let Some((_, i)) = right.pop() {
            now += time[i][2];
            putting.push((now + time[i][3], i));
        } else if boxes > 0 and not left.is_empty() {
            let (_, i) = left.pop().unwrap();
            now += time[i][0];
            boxes -= 1;
            picking.push((now + time[i][1], i));
        } else {
            let mut next = i64.MAX;
            if let Some((done, _)) = picking.peek() {
                next = next.min(done);
            }
            if boxes > 0 {
                if let Some((done, _)) = putting.peek() {
                    next = next.min(done);
                }
            }
            now = next;
        }
    }
    now
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2532;
    let mut cases: Vec[(i64, i64, Vec[Vec[i64]])] = Vec.new();
    for _ in 0..200 {
        let n = next_random(mut seed) % 1000 + 1;
        let k = next_random(mut seed) % 100 + 1;
        let mut time: Vec[Vec[i64]] = Vec.new();
        for _ in 0..k {
            let mut row = Vec.new();
            for _ in 0..4 {
                row.push(next_random(mut seed) % 1000 + 1);
            }
            time.push(row);
        }
        cases.push((n, k, time));
    }
    let passes = 100;
    let mut check = 0;
    for p in 0..passes {
        let start = check % 200;
        for i in 0..200 {
            let (n, k, time) = ref cases[(start + i) % 200];
            check = (check * 31 + find_crossing_time(n, k, time) + p) % 1000000007;
        }
    }
    println(f"{passes} passes over 200 cases: checksum {check}");
}
