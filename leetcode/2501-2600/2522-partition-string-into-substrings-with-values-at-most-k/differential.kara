// LeetCode #2522: Partition String Into Substrings With Values at Most K --
// the differential. The six arms against the statement read literally:
// every way to cut the string, one for each set of the gaps between its
// digits, each part's value read and checked against `k`; the fewest parts
// of a cut that passes, and -1 when none does. No greedy. 300 random
// strings of 1 to 10 digits from 1 to 9 with `k` from 1 to 100, 30 with
// `k` from 1 to 10^9, and 30 with `k` from 1 to 9; every one drawn before
// any arm answers.
//
// P1  the answer is the statement read literally
// P2  -1 exactly when some digit is above k; otherwise from the digits
//     over k's length, rounded up, to the number of digits
// P3  k one more: not -1 and at most the answer, unless the answer is -1
// P4  the string written twice: from the answer to twice it, unless -1
// P5  k = 10^9: the digits over 9, rounded up
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally

fn literal(s: String, k: i64) -> i64 {
    let digits = s.bytes();
    let n = digits.len();
    let mut best = -1;
    for cuts in 0..(1 << (n - 1)) {
        let mut parts = 1;
        let mut value = 0;
        let mut fits = true;
        for i in 0..n {
            if i > 0 and (cuts >> (i - 1)) % 2 == 1 {
                fits = fits and value <= k;
                parts += 1;
                value = 0;
            }
            value = value * 10 + (digits[i] - b'0');
        }
        fits = fits and value <= k;
        if fits and (best == -1 or parts < best) {
            best = parts;
        }
    }
    best
}

// ---- star (greedy.kara) --------------------------------------------------

fn star_minimum_partition(s: String, k: i64) -> i64 {
    let mut parts = 1;
    let mut value = 0;
    for b in s.bytes() {
        let d = (b - b'0') as i64;
        if d > k {
            return -1;
        }
        value = value * 10 + d;
        if value > k {
            parts += 1;
            value = d;
        }
    }
    parts
}

// ---- dp (greedy_dp.kara) -------------------------------------------------

fn dp_minimum_partition(s: String, k: i64) -> i64 {
    let digits = s.bytes();
    let n = digits.len();
    let none = n + 1;
    let mut fewest: Vec[i64] = Vec.filled(n + 1, none);
    fewest[0] = 0;
    for i in 1..n + 1 {
        let mut value = 0;
        let mut place = 1;
        let mut j = i;
        while j > 0 and i - j < 10 {
            j -= 1;
            value += (digits[j] - b'0') * place;
            place *= 10;
            if value > k {
                break;
            }
            if fewest[j] + 1 < fewest[i] {
                fewest[i] = fewest[j] + 1;
            }
        }
    }
    if fewest[n] == none { -1 } else { fewest[n] }
}

// ---- text (greedy_text.kara) ---------------------------------------------

fn text_at_most(part: Str, limit: Str) -> bool {
    part.len() < limit.len() or (part.len() == limit.len() and part <= limit)
}

fn text_minimum_partition(s: String, k: i64) -> i64 {
    let limit = k.to_string();
    let mut parts = 0;
    let mut start = 0;
    while start < s.len() {
        if not text_at_most(s[start..start + 1], limit) {
            return -1;
        }
        let mut end = start + 1;
        while end < s.len() and text_at_most(s[start..end + 1], limit) {
            end += 1;
        }
        parts += 1;
        start = end;
    }
    parts
}

// ---- rec (greedy_rec.kara) -----------------------------------------------

fn rec_part_end(digits: Slice[u8], i: i64, value: i64, k: i64) -> i64 {
    if i == digits.len() {
        return i;
    }
    let grown = value * 10 + (digits[i] - b'0');
    if grown > k { i } else { rec_part_end(digits, i + 1, grown, k) }
}

fn rec_minimum_partition(s: String, k: i64) -> i64 {
    let digits = s.bytes();
    let mut parts = 0;
    let mut i = 0;
    while i < digits.len() {
        let end = rec_part_end(digits, i, 0, k);
        if end == i {
            return -1;
        }
        parts += 1;
        i = end;
    }
    parts
}

// ---- iter (greedy_iter.kara) ---------------------------------------------

fn iter_minimum_partition(s: String, k: i64) -> i64 {
    let digits: Vec[i64] = s.bytes().iter().map(|b| (b - b'0') as i64).collect();
    if digits.iter().any(|d| d > k) {
        return -1;
    }
    let (parts, _) = digits.iter().fold((1, 0), |(parts, value), d| {
        if value * 10 + d > k { (parts + 1, d) } else { (parts, value * 10 + d) }
    });
    parts
}

// ---- solution (greedy_solution.kara) -------------------------------------

struct Solution {}

impl Solution {
    pub fn minimum_partition(s: String, k: i32) -> i32 {
        let k = k as i64;
        let mut count = 1;
        let mut cur: i64 = 0;
        for c in s.chars() {
            let d = c.to_digit(10).unwrap() as i64;
            if d > k {
                return -1;
            }
            cur = cur * 10 + d;
            if cur > k {
                count += 1;
                cur = d;
            }
        }
        count
    }
}

fn solution_minimum_partition(s: String, k: i64) -> i64 {
    Solution.minimum_partition(s, k as i32)
}

// ---- the differential --------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn answer(arm: i64, s: String, k: i64) -> i64 {
    match arm {
        0 => star_minimum_partition(s, k),
        1 => dp_minimum_partition(s, k),
        2 => text_minimum_partition(s, k),
        3 => rec_minimum_partition(s, k),
        4 => iter_minimum_partition(s, k),
        _ => solution_minimum_partition(s, k),
    }
}

fn main() {
    let names = ["star", "dp", "text", "rec", "iter", "solution"];
    let mut seed = 2522;
    let mut problems: Vec[(String, i64)] = Vec.new();
    for t in 0..360 {
        let n = next_random(mut seed) % 10 + 1;
        let mut s = String.new();
        for _ in 0..n {
            s.push(((next_random(mut seed) % 9 + 1) as u8 + b'0') as char);
        }
        let k = if t < 300 {
            next_random(mut seed) % 100 + 1
        } else if t < 330 {
            wide_random(mut seed) % 1000000000 + 1
        } else {
            next_random(mut seed) % 9 + 1
        };
        problems.push((s, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut refused = 0;
    for (s, k) in problems.iter() {
        let truth = literal(s, k);
        if truth == -1 {
            refused += 1;
        }
        check = (check * 31 + truth + 1) % 1000000007;
        let n = s.len();
        let width = k.to_string().len();
        let too_big = s.bytes().iter().any(|b| (b - b'0') > k);
        let twice = f"{s}{s}";
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, s, k)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let looser = answer(arm, s, k + 1);
            let doubled = answer(arm, twice, k);
            let verdicts = [
                x == truth,
                if too_big { x == -1 } else { x >= (n + width - 1) / width and x <= n },
                x == -1 or (looser != -1 and looser <= x),
                x == -1 or (doubled >= x and doubled <= 2 * x),
                answer(arm, s, 1000000000) == (n + 8) / 9,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"\"{s}\" {k}, arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases, {refused} with -1: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
