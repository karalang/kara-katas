// LeetCode #2529: Maximum Count of Positive Integer and Negative Integer
// -- the differential. The six arms against the statement read literally:
// the numbers above 0 counted, the numbers below 0 counted, and the larger
// of the two counts. 300 random sorted lists of 1 to 12 numbers from -3 to
// 3, and 60 of 1 to 200 from -2000 to 2000; every one drawn before any arm
// answers.
//
// P1  the answer is the statement read literally
// P2  the answer is at most n, and at least half the nonzero numbers
// P3  every number negated, the list reversed: the same answer
// P4  a 0 put in its sorted place: the same answer
// P5  every number doubled in place: twice the answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally

fn literal(nums: Vec[i64]) -> i64 {
    let mut pos = 0;
    let mut neg = 0;
    for x in nums.iter() {
        if x > 0 {
            pos += 1;
        }
        if x < 0 {
            neg += 1;
        }
    }
    if pos > neg { pos } else { neg }
}

// ---- star (count.kara) ---------------------------------------------------

fn star_first_where(nums: Vec[i64], above: i64) -> i64 {
    let mut lo = 0;
    let mut hi = nums.len();
    while lo < hi {
        let mid = lo + (hi - lo) / 2;
        if nums[mid] > above {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

fn star_maximum_count(nums: Vec[i64]) -> i64 {
    let negatives = star_first_where(nums, -1);
    let positives = nums.len() - star_first_where(nums, 0);
    negatives.max(positives)
}

// ---- tally (count_tally.kara) --------------------------------------------

fn tally_maximum_count(nums: Vec[i64]) -> i64 {
    let mut negatives = 0;
    let mut positives = 0;
    for x in nums.iter() {
        if x < 0 {
            negatives += 1;
        } else if x > 0 {
            positives += 1;
        }
    }
    negatives.max(positives)
}

// ---- walk (count_walk.kara) ----------------------------------------------

fn walk_maximum_count(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut left = 0;
    while left < n and nums[left] < 0 {
        left += 1;
    }
    let mut right = n;
    while right > left and nums[right - 1] > 0 {
        right -= 1;
    }
    left.max(n - right)
}

// ---- rec (count_rec.kara) ------------------------------------------------

fn rec_first_above(nums: Vec[i64], above: i64, lo: i64, hi: i64) -> i64 {
    if lo == hi {
        lo
    } else {
        let mid = lo + (hi - lo) / 2;
        if nums[mid] > above {
            rec_first_above(nums, above, lo, mid)
        } else {
            rec_first_above(nums, above, mid + 1, hi)
        }
    }
}

fn rec_maximum_count(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    rec_first_above(nums, -1, 0, n).max(n - rec_first_above(nums, 0, 0, n))
}

// ---- iter (count_iter.kara) ----------------------------------------------

fn iter_maximum_count(nums: Vec[i64]) -> i64 {
    let negatives = nums.iter().take_while(|x| x < 0).count();
    let positives = nums.iter().rev().take_while(|x| x > 0).count();
    negatives.max(positives)
}

// ---- solution (count_solution.kara) --------------------------------------

struct Solution {}

impl Solution {
    pub fn maximum_count(nums: Vec[i32]) -> i32 {
        let negatives = nums.partition_point(|x| x < 0);
        let positives = nums.len() - nums.partition_point(|x| x <= 0);
        negatives.max(positives) as i32
    }
}

fn solution_maximum_count(nums: Vec[i64]) -> i64 {
    Solution.maximum_count(nums.iter().map(|x| x as i32).collect())
}

// ---- the differential --------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_maximum_count(nums),
        1 => tally_maximum_count(nums),
        2 => walk_maximum_count(nums),
        3 => rec_maximum_count(nums),
        4 => iter_maximum_count(nums),
        _ => solution_maximum_count(nums),
    }
}

fn main() {
    let names = ["star", "tally", "walk", "rec", "iter", "solution"];
    let mut seed = 2529;
    let mut problems: Vec[Vec[i64]] = Vec.new();
    for t in 0..360 {
        let (most, top) = if t < 300 { (12, 3) } else { (200, 2000) };
        let n = next_random(mut seed) % most + 1;
        let mut nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % (2 * top + 1) - top).collect();
        nums.sort();
        problems.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut zero = 0;
    for nums in problems.iter() {
        let truth = literal(nums);
        if truth == 0 {
            zero += 1;
        }
        check = (check * 31 + truth) % 1000000007;
        let nonzero = nums.iter().filter(|x| x != 0).count();
        let mirrored: Vec[i64] = nums.iter().rev().map(|x| -x).collect();
        let mut with_zero = nums.clone();
        with_zero.push(0);
        with_zero.sort();
        let doubled: Vec[i64] = nums.iter().flat_map(|x| [x, x].into_iter()).collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                x <= nums.len() and 2 * x >= nonzero,
                answer(arm, mirrored) == x,
                answer(arm, with_zero) == x,
                answer(arm, doubled) == 2 * x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums}, arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases, {zero} with no sign: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
