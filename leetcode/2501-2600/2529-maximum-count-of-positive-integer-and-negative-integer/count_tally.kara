// LeetCode #2529: Maximum Count of Positive Integer and Negative Integer
// -- one pass that counts each sign, the order not used. O(n).

fn maximum_count(nums: Vec[i64]) -> i64 {
    let mut negatives = 0;
    let mut positives = 0;
    for x in nums.iter() {
        if x < 0 {
            negatives += 1;
        } else if x > 0 {
            positives += 1;
        }
    }
    negatives.max(positives)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's three examples, then five more
    let fixed: Vec[Vec[i64]] = [
        [-2, -1, -1, 1, 2, 3],
        [-3, -2, -1, 0, 0, 1, 2],
        [5, 20, 66, 1314],
        [0],
        [-2000],
        [0, 0, 0, 2000],
        [-5, -4, 0, 0, 3, 4],
        [-1, -1, -1, -1, 1, 1, 1, 1],
    ];
    for nums in fixed.iter() {
        println(f"{nums} -> {maximum_count(nums)}");
    }
    // 3000 random sorted lists of 1 to 40 numbers from -5 to 5, and 1000
    // of 1 to 2000 from -2000 to 2000: the sum of the answers and a checksum
    let mut seed = 2529;
    for (count, most, top) in [(3000, 40, 5), (1000, 2000, 2000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = next_random(mut seed) % most + 1;
            let mut nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % (2 * top + 1) - top).collect();
            nums.sort();
            let a = maximum_count(nums);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
        println(f"{count} random lists of up to {most} numbers within {top}: total {total}, checksum {check}");
    }
}
