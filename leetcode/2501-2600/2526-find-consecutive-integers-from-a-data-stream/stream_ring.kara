// LeetCode #2526: Find Consecutive Integers from a Data Stream -- a ring:
// the latest `k` numbers in a `Vec` of `k` slots written round, the slot of
// the `i`-th number `i % k`, and a count of the slots that hold `value`;
// the answer is whether at least `k` numbers came and all slots match.

struct DataStream {
    value: i64,
    k: i64,
    slots: Vec[i64],
    seen: i64,
    matching: i64,
}

impl DataStream {
    fn new(value: i64, k: i64) -> DataStream {
        DataStream { value: value, k: k, slots: Vec.filled(k, 0), seen: 0, matching: 0 }
    }

    fn consec(mut ref self, num: i64) -> bool {
        let at = self.seen % self.k;
        if self.seen >= self.k and self.slots[at] == self.value {
            self.matching -= 1;
        }
        self.slots[at] = num;
        if num == self.value {
            self.matching += 1;
        }
        self.seen += 1;
        self.seen >= self.k and self.matching == self.k
    }
}

fn open_stream(value: i64, k: i64) -> DataStream {
    DataStream.new(value, k)
}

fn feed(stream: mut ref DataStream, num: i64) -> bool {
    stream.consec(num)
}


// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// the answers to a stream, as a string of T and F
fn answers(value: i64, k: i64, nums: Vec[i64]) -> String {
    let mut stream = open_stream(value, k);
    let mut out = String.new();
    for num in nums.iter() {
        out.push(if feed(mut stream, num) { 'T' } else { 'F' });
    }
    out
}

fn main() {
    // LeetCode's example, then five more
    println(f"4 3 [4, 4, 4, 3] -> {answers(4, 3, [4, 4, 4, 3].to_vec())}");
    println(f"1 1 [1, 2, 1, 1] -> {answers(1, 1, [1, 2, 1, 1].to_vec())}");
    println(f"5 2 [5, 6, 5, 5, 5, 6, 5] -> {answers(5, 2, [5, 6, 5, 5, 5, 6, 5].to_vec())}");
    println(f"9 4 [9, 9, 9] -> {answers(9, 4, [9, 9, 9].to_vec())}");
    println(f"1000000000 2 [1000000000, 1000000000, 1] -> {answers(1000000000, 2, [1000000000, 1000000000, 1].to_vec())}");
    println(f"2 3 [1, 2, 2, 2, 2, 1, 2, 2, 2] -> {answers(2, 3, [1, 2, 2, 2, 2, 1, 2, 2, 2].to_vec())}");
    // 2000 random streams of 1 to 60 numbers from 1 to 3, value 1 to 3 and
    // k 1 to 6: how many answers are true, and a checksum of the answers
    let mut seed = 2526;
    let mut trues = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let value = next_random(mut seed) % 3 + 1;
        let k = next_random(mut seed) % 6 + 1;
        let n = next_random(mut seed) % 60 + 1;
        let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 3 + 1).collect();
        for c in answers(value, k, nums).chars() {
            let t = if c == 'T' { 1 } else { 0 };
            trues += t;
            check = (check * 31 + t + 1) % 1000000007;
        }
    }
    println(f"2000 random streams: {trues} true, checksum {check}");
    // the constraints' largest: 10^5 calls. With k 10^5, every number value
    // but one in each 50; with k 100, all value; and with k 3, value 7 drawn
    // half the time against 8
    let mut spaced: Vec[i64] = Vec.new();
    for i in 0..100000 {
        spaced.push(if i % 50 == 49 { 8 } else { 7 });
    }
    println(f"10^5, k 10^5, one in 50 not value: {answers(7, 100000, spaced).chars().filter(|c| c == 'T').count()} true");
    println(f"10^5, k 100, all value: {answers(7, 100, Vec.filled(100000, 7)).chars().filter(|c| c == 'T').count()} true");
    let halves: Vec[i64] = (0..100000).map(|_| next_random(mut seed) % 2 + 7).collect();
    println(f"10^5, k 3, half value: {answers(7, 3, halves).chars().filter(|c| c == 'T').count()} true");
}
