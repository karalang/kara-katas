// LeetCode #2509: Cycle Length Queries in a Tree -- the differential. The
// six arms against the statement read literally: for each query, the
// whole tree of 2^n - 1 nodes built as neighbour lists, the edge a-b
// added, and every node of one neighbour peeled away until none is left;
// the nodes that stay are the cycle. No parent is halved and no path is
// walked. 300 random trees of 2 to 7 levels with 1 to 8 queries; then
// 20 of 2 levels, and 40 of 10 levels with 10 queries; every one drawn
// before any arm answers.
//
// P1  every answer is the statement read literally
// P2  every answer from 2 to 2 n - 1
// P3  every query's ends swapped: the same answers
// P4  the queries in the other order: the answers in the other order
// P5  one level more, and every node v of depth d written v + 2^d, its
//     place in the root's left subtree: the same answers
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally

fn literal(n: i64, queries: Vec[Vec[i64]]) -> Vec[i64] {
    let size = (1 << n) - 1;
    let mut tree: Vec[Vec[i64]] = Vec.filled(size + 1, Vec.new());
    for v in 2..size + 1 {
        tree[v].push(v / 2);
        tree[v / 2].push(v);
    }
    let mut answers: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let mut graph = tree.clone();
        graph[q[0]].push(q[1]);
        graph[q[1]].push(q[0]);
        let mut degree: Vec[i64] = graph.iter().map(|next| next.len()).collect();
        let mut gone: Vec[bool] = Vec.filled(size + 1, false);
        let mut leaves: Vec[i64] = (1..size + 1).filter(|v| degree[v] == 1).collect();
        while let Some(v) = leaves.pop() {
            gone[v] = true;
            for w in graph[v].iter() {
                if not gone[w] {
                    degree[w] -= 1;
                    if degree[w] == 1 {
                        leaves.push(w);
                    }
                }
            }
        }
        answers.push((1..size + 1).filter(|v| not gone[v]).count());
    }
    answers
}

// ---- star (cycle.kara) ---------------------------------------------------

fn star_cycle_length_queries(n: i64, queries: Vec[Vec[i64]]) -> Vec[i64] {
    let mut answer: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let mut (a, b) = (q[0], q[1]);
        let mut length = 1;
        while a != b {
            if a > b {
                a /= 2;
            } else {
                b /= 2;
            }
            length += 1;
        }
        answer.push(length);
    }
    answer
}

// ---- bits (cycle_bits.kara) ----------------------------------------------

fn bits_bit_length(v: i64) -> i64 {
    64 - v.leading_zeros()
}

fn bits_cycle_length_queries(n: i64, queries: Vec[Vec[i64]]) -> Vec[i64] {
    let mut answer: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let mut (a, b) = (q[0], q[1]);
        let (da, db) = (bits_bit_length(a), bits_bit_length(b));
        let lift = (da - db).abs();
        if da > db {
            a >>= lift;
        } else {
            b >>= lift;
        }
        answer.push(lift + 2 * bits_bit_length(a ^ b) + 1);
    }
    answer
}

// ---- path (cycle_path.kara) ----------------------------------------------

fn path_cycle_length_queries(n: i64, queries: Vec[Vec[i64]]) -> Vec[i64] {
    let mut answer: Vec[i64] = Vec.new();
    for q in queries.iter() {
        let mut above: Map[i64, i64] = Map.new();
        let mut a = q[0];
        let mut steps = 0;
        while a > 0 {
            above.insert(a, steps);
            a /= 2;
            steps += 1;
        }
        let mut b = q[1];
        let mut climbed = 0;
        while not above.contains_key(b) {
            b /= 2;
            climbed += 1;
        }
        answer.push(above[b] + climbed + 1);
    }
    answer
}

// ---- rec (cycle_rec.kara) ------------------------------------------------

fn rec_distance(a: i64, b: i64) -> i64 {
    if a == b {
        0
    } else if a > b {
        1 + rec_distance(a / 2, b)
    } else {
        1 + rec_distance(a, b / 2)
    }
}

fn rec_cycle_length_queries(n: i64, queries: Vec[Vec[i64]]) -> Vec[i64] {
    queries.iter().map(|q| rec_distance(q[0], q[1]) + 1).collect()
}

// ---- iter (cycle_iter.kara) ----------------------------------------------

fn iter_root_path(v: i64) -> Vec[i64] {
    let mut path: Vec[i64] = (0..64).map(|k| v >> k).take_while(|x| x > 0).collect();
    path.reverse();
    path
}

fn iter_cycle_length_queries(n: i64, queries: Vec[Vec[i64]]) -> Vec[i64] {
    queries
        .iter()
        .map(|q| {
            let (pa, pb) = (iter_root_path(q[0]), iter_root_path(q[1]));
            let shared = pa.iter().zip(pb.iter()).take_while(|(x, y)| x == y).count();
            pa.len() + pb.len() - 2 * shared + 1
        })
        .collect()
}

// ---- solution (cycle_solution.kara) --------------------------------------

struct Solution {}

impl Solution {
    pub fn cycle_length_queries(n: i32, queries: Vec[Vec[i32]]) -> Vec[i32] {
        queries
            .iter()
            .map(|q| {
                let mut (a, b) = (q[0], q[1]);
                let mut len = 1;
                while a != b {
                    if a > b {
                        a >>= 1;
                    } else {
                        b >>= 1;
                    }
                    len += 1;
                }
                len
            })
            .collect()
    }
}

fn solution_cycle_length_queries(n: i64, queries: Vec[Vec[i64]]) -> Vec[i64] {
    let asked: Vec[Vec[i32]] = queries.iter().map(|q| q.iter().map(|v| v as i32).collect()).collect();
    Solution.cycle_length_queries(n as i32, asked).iter().map(|v| v as i64).collect()
}

// ---- the differential --------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(arm: i64, n: i64, queries: Vec[Vec[i64]]) -> Vec[i64] {
    match arm {
        0 => star_cycle_length_queries(n, queries),
        1 => bits_cycle_length_queries(n, queries),
        2 => path_cycle_length_queries(n, queries),
        3 => rec_cycle_length_queries(n, queries),
        4 => iter_cycle_length_queries(n, queries),
        _ => solution_cycle_length_queries(n, queries),
    }
}

// v's place in the root's left subtree: a 0 put under its leading 1
fn left_copy(v: i64) -> i64 {
    let mut top = 1;
    while top * 2 <= v {
        top *= 2;
    }
    v + top
}

fn main() {
    let names = ["star", "bits", "path", "rec", "iter", "solution"];
    let mut seed = 2509;
    let mut problems: Vec[(i64, Vec[Vec[i64]])] = Vec.new();
    for t in 0..360 {
        let n = if t < 300 { next_random(mut seed) % 6 + 2 } else if t < 320 { 2 } else { 10 };
        let count = if t < 320 { next_random(mut seed) % 8 + 1 } else { 10 };
        let size = (1 << n) - 1;
        let mut queries: Vec[Vec[i64]] = Vec.new();
        while queries.len() < count {
            let a = next_random(mut seed) % size + 1;
            let b = next_random(mut seed) % size + 1;
            if a != b {
                queries.push([a, b].to_vec());
            }
        }
        problems.push((n, queries));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut asked = 0;
    for (n, queries) in problems.iter() {
        let truth = literal(n, queries);
        for t in truth.iter() {
            check = (check * 31 + t) % 1000000007;
        }
        asked += queries.len();
        let swapped: Vec[Vec[i64]] = queries.iter().map(|q| [q[1], q[0]].to_vec()).collect();
        let reversed: Vec[Vec[i64]] = queries.iter().rev().map(|q| q.clone()).collect();
        let copied: Vec[Vec[i64]] = queries.iter().map(|q| [left_copy(q[0]), left_copy(q[1])].to_vec()).collect();
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, n, queries)).collect();
        for arm in 0..6 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let back: Vec[i64] = answer(arm, n, reversed).iter().rev().map(|v| *v).collect();
            let verdicts = [
                x == truth,
                x.len() == queries.len() and x.iter().all(|v| v >= 2 and v <= 2 * n - 1),
                answer(arm, n, swapped) == x,
                back == x,
                answer(arm, n + 1, copied) == x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{n} levels, {queries}, arm {names[arm]}: P{q + 1} fails, answers {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases, {asked} queries: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
