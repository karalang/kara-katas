// LeetCode #2515: Shortest Distance to Target String in a Circular Array
// -- the differential. The six arms against the statement read literally:
// a breadth-first search from the start, each place's distance one more
// than the place it was reached from, its two neighbours the next and the
// previous word round the circle; the answer the distance of the first
// place taken off the queue that holds the target. No distance is worked
// out by a formula. 300 random lists of 1 to 10 words of 1 letter from 3,
// the target 1 letter from 4; then 20 of one word; and 40 of 20 words of
// 1 to 2 letters from 2; every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  -1 exactly when no word is the target, and otherwise from 0 to n / 2
// P3  the list reversed, the start at n - 1 - start: the same answer
// P4  the first word moved to the end, the start one place back: the same
//     answer
// P5  the list followed by a copy of itself: the same answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally

fn literal(words: Vec[String], target: String, start: i64) -> i64 {
    let n = words.len();
    let mut distance: Vec[i64] = Vec.filled(n, -1);
    let mut queue: VecDeque[i64] = VecDeque.new();
    distance[start] = 0;
    queue.push_back(start);
    while let Some(place) = queue.pop_front() {
        if words[place] == target {
            return distance[place];
        }
        for next in [(place + 1) % n, (place + n - 1) % n] {
            if distance[next] == -1 {
                distance[next] = distance[place] + 1;
                queue.push_back(next);
            }
        }
    }
    -1
}

// ---- star (closest.kara) -------------------------------------------------

fn star_closet_target(words: Vec[String], target: String, start: i64) -> i64 {
    let n = words.len();
    let mut best = -1;
    for i in 0..n {
        if words[i] == target {
            let d = (i - start).abs();
            let shortest = d.min(n - d);
            if best == -1 or shortest < best {
                best = shortest;
            }
        }
    }
    best
}

// ---- outward (closest_outward.kara) --------------------------------------

fn outward_closet_target(words: Vec[String], target: String, start: i64) -> i64 {
    let n = words.len();
    for k in 0..n / 2 + 1 {
        if words[(start + k) % n] == target or words[(start - k + n) % n] == target {
            return k;
        }
    }
    -1
}

// ---- walks (closest_walks.kara) ------------------------------------------

fn walks_walk(words: Vec[String], target: String, start: i64, step: i64) -> i64 {
    let n = words.len();
    let mut place = start;
    let mut steps = 0;
    while words[place] != target {
        if steps == n {
            return -1;
        }
        place = (place + step + n) % n;
        steps += 1;
    }
    steps
}

fn walks_closet_target(words: Vec[String], target: String, start: i64) -> i64 {
    let right = walks_walk(words, target, start, 1);
    let left = walks_walk(words, target, start, -1);
    if right == -1 { -1 } else { right.min(left) }
}

// ---- rec (closest_rec.kara) ----------------------------------------------

fn rec_search(words: Vec[String], target: String, start: i64, k: i64) -> i64 {
    let n = words.len();
    if k > n / 2 {
        -1
    } else if words[(start + k) % n] == target or words[(start + n - k) % n] == target {
        k
    } else {
        rec_search(words, target, start, k + 1)
    }
}

fn rec_closet_target(words: Vec[String], target: String, start: i64) -> i64 {
    rec_search(words, target, start, 0)
}

// ---- iter (closest_iter.kara) --------------------------------------------

fn iter_closet_target(words: Vec[String], target: String, start: i64) -> i64 {
    let n = words.len();
    words
        .iter()
        .enumerate()
        .filter(|(_, w)| w == target)
        .map(|(i, _)| (i - start).abs().min(n - (i - start).abs()))
        .min()
        ?? -1
}

// ---- solution (closest_solution.kara) ------------------------------------

struct Solution {}

impl Solution {
    pub fn closet_target(words: Vec[String], target: String, start_index: i32) -> i32 {
        let n = words.len() as i32;
        let mut ans = i32.MAX;
        for (i, w) in words.iter().enumerate() {
            if *w == target {
                let d = (i as i32 - start_index).abs();
                ans = ans.min(d.min(n - d));
            }
        }
        if ans == i32.MAX { -1 } else { ans }
    }
}

fn solution_closet_target(words: Vec[String], target: String, start: i64) -> i64 {
    Solution.closet_target(words, target, start as i32)
}

// ---- the differential --------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(arm: i64, words: Vec[String], target: String, start: i64) -> i64 {
    match arm {
        0 => star_closet_target(words, target, start),
        1 => outward_closet_target(words, target, start),
        2 => walks_closet_target(words, target, start),
        3 => rec_closet_target(words, target, start),
        4 => iter_closet_target(words, target, start),
        _ => solution_closet_target(words, target, start),
    }
}

fn word(most: i64, letters: i64, seed: mut ref i64) -> String {
    let mut w = String.new();
    let length = next_random(mut seed) % most + 1;
    for _ in 0..length {
        w.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    w
}

fn main() {
    let names = ["star", "outward", "walks", "rec", "iter", "solution"];
    let mut seed = 2515;
    let mut problems: Vec[(Vec[String], String, i64)] = Vec.new();
    for t in 0..360 {
        let (n, most, letters, target_letters) = if t < 300 {
            (next_random(mut seed) % 10 + 1, 1, 3, 4)
        } else if t < 320 {
            (1, 1, 3, 4)
        } else {
            (20, 2, 2, 2)
        };
        let words: Vec[String] = (0..n).map(|_| word(most, letters, mut seed)).collect();
        let target = word(most, target_letters, mut seed);
        let start = next_random(mut seed) % n;
        problems.push((words, target, start));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut misses = 0;
    for (words, target, start) in problems.iter() {
        let n = words.len();
        let truth = literal(words, target, start);
        if truth == -1 {
            misses += 1;
        }
        check = (check * 31 + truth + 1) % 1000000007;
        let present = words.contains(target);
        let mut reversed = words.clone();
        reversed.reverse();
        let mut turned: Vec[String] = words[1..n].to_vec();
        turned.push(words[0].clone());
        let mut doubled = words.clone();
        doubled.extend(words.iter().cloned());
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, words, target, start)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                if present { x >= 0 and x <= n / 2 } else { x == -1 },
                answer(arm, reversed, target, n - 1 - start) == x,
                answer(arm, turned, target, (start + n - 1) % n) == x,
                answer(arm, doubled, target, start) == x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{words} \"{target}\" from {start}, arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases, {misses} with no target: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
