// LeetCode #2515: Shortest Distance to Target String in a Circular Array
// -- benchmark of the ★ arm (closest.kara): 2000 lists of 100 words of 1
// to 3 letters from 3 built once from its own generator; then the passes,
// each asking every list for the word at a place the checksum so far
// picks, from a start it picks too.

fn closet_target(words: Vec[String], target: String, start: i64) -> i64 {
    let n = words.len();
    let mut best = -1;
    for i in 0..n {
        if words[i] == target {
            let d = (i - start).abs();
            let shortest = d.min(n - d);
            if best == -1 or shortest < best {
                best = shortest;
            }
        }
    }
    best
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2515;
    let mut lists: Vec[Vec[String]] = Vec.new();
    for _ in 0..2000 {
        let mut words: Vec[String] = Vec.new();
        for _ in 0..100 {
            let mut w = String.new();
            let length = next_random(mut seed) % 3 + 1;
            for _ in 0..length {
                w.push((b'a' + (next_random(mut seed) % 3) as u8) as char);
            }
            words.push(w);
        }
        lists.push(words);
    }
    let passes = 900;
    let mut check = 0;
    for p in 0..passes {
        for words in lists.iter() {
            let target = words[check / 100 % 100].clone();
            check = (check * 31 + closet_target(words, target, check % 100) + p) % 1000000007;
        }
    }
    println(f"{passes} passes over 2000 lists of 100 words: checksum {check}");
}
