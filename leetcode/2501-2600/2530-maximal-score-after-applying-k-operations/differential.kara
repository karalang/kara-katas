// LeetCode #2530: Maximal Score After Applying K Operations -- the
// differential. The six arms against the statement read literally: `k`
// times, the list walked for its first largest number, which is added to
// the score and replaced by its third rounded up, the ceiling taken by
// whether 3 divides it. 300 random lists of 1 to 10 numbers from 1 to 30
// with `k` from 1 to 20, and 60 of 1 to 10 from 1 to 10^9 with `k` from 1
// to 40; every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer is at least k and at most k times the largest number
// P3  the list reversed: the same answer
// P4  k one more: the answer grows by at least 1 and by at most the largest number
// P5  a 1 appended: the same answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally

fn literal(nums: Vec[i64], k: i64) -> i64 {
    let mut list = nums.clone();
    let mut score = 0;
    for _ in 0..k {
        let mut at = 0;
        for i in 1..list.len() {
            if list[i] > list[at] {
                at = i;
            }
        }
        score += list[at];
        list[at] = if list[at] % 3 == 0 { list[at] / 3 } else { list[at] / 3 + 1 };
    }
    score
}

// ---- star (score.kara) ---------------------------------------------------

fn star_max_kelements(nums: Vec[i64], k: i64) -> i64 {
    let mut heap: PriorityQueue[i64] = PriorityQueue.max_first();
    for x in nums.iter() {
        heap.push(x);
    }
    let mut score = 0;
    for _ in 0..k {
        let top = heap.pop().unwrap();
        score += top;
        heap.push((top + 2) / 3);
    }
    score
}

// ---- counts (score_counts.kara) ------------------------------------------

fn counts_max_kelements(nums: Vec[i64], k: i64) -> i64 {
    let mut counts: SortedMap[i64, i64] = SortedMap.new();
    for x in nums.iter() {
        counts[x] = counts.get(x).unwrap_or(0) + 1;
    }
    let mut score = 0;
    for _ in 0..k {
        let (top, many): (i64, i64) = counts.last().unwrap();
        score += top;
        if many == 1 {
            counts.remove(top);
        } else {
            counts[top] = many - 1;
        }
        let third = (top + 2) / 3;
        counts[third] = counts.get(third).unwrap_or(0) + 1;
    }
    score
}

// ---- queues (score_queues.kara) ------------------------------------------

fn queues_max_kelements(nums: Vec[i64], k: i64) -> i64 {
    let mut sorted = nums.clone();
    sorted.sort();
    sorted.reverse();
    let mut thirds: VecDeque[i64] = VecDeque.new();
    let mut next = 0;
    let mut score = 0;
    for _ in 0..k {
        let from_sorted = next < sorted.len() and (thirds.is_empty() or sorted[next] >= thirds.front().unwrap());
        let top = if from_sorted {
            next += 1;
            sorted[next - 1]
        } else {
            thirds.pop_front().unwrap()
        };
        score += top;
        thirds.push_back((top + 2) / 3);
    }
    score
}

// ---- rec (score_rec.kara) ------------------------------------------------

fn rec_take(heap: mut ref PriorityQueue[i64], k: i64) -> i64 {
    if k == 0 {
        0
    } else {
        let top = heap.pop().unwrap();
        heap.push((top + 2) / 3);
        top + rec_take(mut heap, k - 1)
    }
}

fn rec_max_kelements(nums: Vec[i64], k: i64) -> i64 {
    let mut heap: PriorityQueue[i64] = PriorityQueue.max_first_from(nums.iter().collect());
    rec_take(mut heap, k)
}

// ---- iter (score_iter.kara) ----------------------------------------------

fn iter_max_kelements(nums: Vec[i64], k: i64) -> i64 {
    let mut heap: PriorityQueue[i64] = PriorityQueue.max_first_from(nums.iter().collect());
    (0..k).map(|_| {
        let top = heap.pop().unwrap();
        heap.push((top + 2) / 3);
        top
    }).sum()
}

// ---- solution (score_solution.kara) --------------------------------------

struct Solution {}

impl Solution {
    pub fn max_kelements(nums: own Vec[i32], k: i32) -> i64 {
        let mut heap: PriorityQueue[i32] = PriorityQueue.max_first_from(nums.into_iter().collect());
        let mut score: i64 = 0;
        for _ in 0..k {
            let top = heap.pop().unwrap();
            score += top;
            heap.push((top + 2) / 3);
        }
        score
    }
}

fn solution_max_kelements(nums: Vec[i64], k: i64) -> i64 {
    Solution.max_kelements(nums.iter().map(|x| x as i32).collect(), k as i32)
}

// ---- the differential --------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn answer(arm: i64, nums: Vec[i64], k: i64) -> i64 {
    match arm {
        0 => star_max_kelements(nums, k),
        1 => counts_max_kelements(nums, k),
        2 => queues_max_kelements(nums, k),
        3 => rec_max_kelements(nums, k),
        4 => iter_max_kelements(nums, k),
        _ => solution_max_kelements(nums, k),
    }
}

fn main() {
    let names = ["star", "counts", "queues", "rec", "iter", "solution"];
    let mut seed = 2530;
    let mut problems: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..360 {
        let (top, ops) = if t < 300 { (30, 20) } else { (1000000000, 40) };
        let n = next_random(mut seed) % 10 + 1;
        let nums: Vec[i64] = (0..n).map(|_| wide_random(mut seed) % top + 1).collect();
        problems.push((nums, next_random(mut seed) % ops + 1));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut ones = 0;
    for (nums, k) in problems.iter() {
        let truth = literal(nums, k);
        if literal(nums, k + 1) - truth == 1 {
            ones += 1;
        }
        check = (check * 31 + truth % 1000000007) % 1000000007;
        let largest = nums.iter().max().unwrap();
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let mut with_one = nums.clone();
        with_one.push(1);
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums, k)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let grown = answer(arm, nums, k + 1) - x;
            let verdicts = [
                x == truth,
                x >= k and x <= k * largest,
                answer(arm, reversed, k) == x,
                grown >= 1 and grown <= largest,
                answer(arm, with_one, k) == x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} k {k}, arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases, {ones} with a next step of 1: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
