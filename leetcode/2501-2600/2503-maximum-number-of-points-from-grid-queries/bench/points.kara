// LeetCode #2503: Maximum Number of Points From Grid Queries -- the
// benchmark: the ★ arm over 4 grids of 316 by 316 and 10^4 queries, built
// once, then the passes; each sets one cell of every grid from the
// checksum so far, asks every query, and puts it back.

fn max_points(grid: Vec[Vec[i64]], queries: Vec[i64]) -> Vec[i64] {
    let m = grid.len();
    let n = grid[0].len();
    let mut order: Vec[i64] = (0..queries.len()).collect();
    order.sort_by_key(|i| queries[i]);
    let mut answer: Vec[i64] = Vec.filled(queries.len(), 0);
    let mut seen: Vec[Vec[bool]] = Vec.filled(m, Vec.filled(n, false));
    let mut border: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    border.push((grid[0][0], 0));
    seen[0][0] = true;
    let mut reached = 0;
    for i in order.iter() {
        let q = queries[i];
        while border.peek().is_some_and(|(value, _)| value < q) {
            let (_, cell) = border.pop().unwrap();
            reached += 1;
            let (r, c) = (cell / n, cell % n);
            for (dr, dc) in [(1, 0), (-1, 0), (0, 1), (0, -1)] {
                let (rr, cc) = (r + dr, c + dc);
                if rr >= 0 and rr < m and cc >= 0 and cc < n and not seen[rr][cc] {
                    seen[rr][cc] = true;
                    border.push((grid[rr][cc], rr * n + cc));
                }
            }
        }
        answer[i] = reached;
    }
    answer
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn below(top: i64, seed: mut ref i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % top
}

fn main() {
    let passes = 14;
    let mut seed = 2503;
    let mut grids: Vec[Vec[Vec[i64]]] = Vec.new();
    for _ in 0..4 {
        let mut grid: Vec[Vec[i64]] = Vec.new();
        for _ in 0..316 {
            let mut row: Vec[i64] = Vec.new();
            for _ in 0..316 {
                row.push(below(1000000, mut seed) + 1);
            }
            grid.push(row);
        }
        grids.push(grid);
    }
    let queries: Vec[i64] = (0..10000).map(|_| below(1000000, mut seed) + 1).collect();
    let mut check = 0;
    for p in 0..passes {
        for g in 0..4 {
            let r = check % 316;
            let c = check / 316 % 316;
            let was = grids[g][r][c];
            grids[g][r][c] = (check + p) % 1000000 + 1;
            for a in max_points(grids[g], queries).iter() {
                check = (check * 31 + a + p) % 1000000007;
            }
            grids[g][r][c] = was;
        }
    }
    println(f"{passes} passes over 4 grids of 316 by 316, 10^4 queries: checksum {check}");
}
