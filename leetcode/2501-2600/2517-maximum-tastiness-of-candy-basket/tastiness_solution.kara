// LeetCode #2517: Maximum Tastiness of Candy Basket -- LeetCode's Rust
// template: `Vec<i32>` and `i32` in, `i32` out; `mut price` sorted in
// place, a bisection over `i32` with the greedy pick as a closure over
// `&price`; carried by `karac fix`.

struct Solution {}

impl Solution {
    pub fn maximum_tastiness(price: own Vec[i32], k: i32) -> i32 {
        let mut price = price;
        price.sort();
        let check = |d: i32| {
            let mut cnt = 1;
            let mut last = price[0];
            for p in price.iter().skip(1) {
                if p - last >= d {
                    cnt += 1;
                    last = p;
                }
            }
            cnt >= k
        };
        let mut (lo, hi) = (0i32, price[price.len() - 1] - price[0]);
        while lo < hi {
            let mid = lo + (hi - lo + 1) / 2;
            if check(mid) {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        lo
    }
}

fn maximum_tastiness(price: Vec[i64], k: i64) -> i64 {
    let p: Vec[i32] = price.iter().map(|v| v as i32).collect();
    Solution.maximum_tastiness(p, k as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a draw from 0 to top - 1, two draws wide, for tops past 32768
fn below(top: i64, seed: mut ref i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % top
}

fn main() {
    // LeetCode's three examples, then five more
    let cases: Vec[(Vec[i64], i64)] = [
        ([13, 5, 1, 8, 21, 2].to_vec(), 3),
        ([1, 3, 1].to_vec(), 2),
        ([7, 7, 7, 7].to_vec(), 2),
        ([1, 2].to_vec(), 2),
        ([1, 1000000000].to_vec(), 2),
        ([1, 2, 3, 4, 5].to_vec(), 5),
        ([5, 4, 3, 2, 1].to_vec(), 3),
        ([10, 1, 10, 1, 6].to_vec(), 3),
    ].to_vec();
    for (price, k) in cases.iter() {
        println(f"{price} k {k} -> {maximum_tastiness(price, k)}");
    }
    // 2000 random lists of 2 to 10 prices to 20, and 2000 of 2 to 1000
    // prices to 10^9, each with k from 2 to the length: the sum and a
    // checksum
    let mut seed = 2517;
    for (most, top) in [(10, 20), (1000, 1000000000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..2000 {
            let n = next_random(mut seed) % (most - 1) + 2;
            let price: Vec[i64] = (0..n).map(|_| below(top, mut seed) + 1).collect();
            let k = next_random(mut seed) % (n - 1) + 2;
            let a = maximum_tastiness(price, k);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
        println(f"2000 random of up to {most} prices to {top}: total {total}, checksum {check}");
    }
    // the constraints' largest, 10^5 prices: random to 10^9 with k 2, 1000
    // and 10^5; and 1 to 10^5 with k 50000 and 50001
    let price: Vec[i64] = (0..100000).map(|_| below(1000000000, mut seed) + 1).collect();
    for k in [2, 1000, 100000] {
        println(f"10^5 random, k {k}: {maximum_tastiness(price, k)}");
    }
    let run: Vec[i64] = (1..100001).collect();
    for k in [50000, 50001] {
        println(f"1 to 10^5, k {k}: {maximum_tastiness(run, k)}");
    }
}
