// LeetCode #2507: Smallest Value After Replacing With Sum of Prime
// Factors -- recursions: the factor sum of `rest` from divisor `p` up is
// `p` plus the sum of `rest / p` from `p` when `p` divides it, the sum
// from `p + 1` when it does not, and `rest` itself once `p * p` passes
// it; and n's smallest value is n when its sum is n, else the smallest
// value of the sum. The divisor recursion is at most sqrt(n) + log(n)
// deep, about 330.

fn factor_sum(rest: i64, p: i64) -> i64 {
    if rest == 1 {
        return 0;
    }
    if p * p > rest {
        return rest;
    }
    if rest % p == 0 {
        p + factor_sum(rest / p, p)
    } else {
        factor_sum(rest, p + 1)
    }
}

fn smallest_value(n: i64) -> i64 {
    let total = factor_sum(n, 2);
    if total == n { n } else { smallest_value(total) }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then eight more
    for n in [15, 3, 2, 4, 6, 8, 12, 99991, 65536, 100000] {
        println(f"{n} -> {smallest_value(n)}");
    }
    // every n from 2 to 20000: how many are already their smallest, and a
    // checksum
    let mut check = 0;
    let mut fixed = 0;
    for n in 2..20001 {
        let a = smallest_value(n);
        if a == n {
            fixed += 1;
        }
        check = (check * 31 + a) % 1000000007;
    }
    println(f"2 to 20000: {fixed} already smallest, checksum {check}");
    // 2000 random n to the constraints' 10^5: how many end at 5, and a
    // checksum
    let mut seed = 2507;
    let mut check = 0;
    let mut fives = 0;
    for _ in 0..2000 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 99999 + 2;
        let a = smallest_value(n);
        if a == 5 {
            fives += 1;
        }
        check = (check * 31 + a) % 1000000007;
    }
    println(f"2000 random to 10^5: {fives} end at 5, checksum {check}");
}
