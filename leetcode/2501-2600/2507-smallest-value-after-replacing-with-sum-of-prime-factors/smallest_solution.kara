// LeetCode #2507: Smallest Value After Replacing With Sum of Prime
// Factors -- LeetCode's Rust template: `mut n: i32` in, `i32` out; trial
// division in a `loop` that returns at the first sum equal to n; carried
// by `karac fix`.

struct Solution {}

impl Solution {
    pub fn smallest_value(n: i32) -> i32 {
        let mut n = n;
        loop {
            let mut x = n;
            let mut s: i32 = 0;
            let mut i: i32 = 2;
            while i * i <= x {
                while x % i == 0 {
                    s += i;
                    x /= i;
                }
                i += 1;
            }
            if x > 1 {
                s += x;
            }
            if s == n {
                return n;
            }
            n = s;
        }
    }
}

fn smallest_value(n: i64) -> i64 {
    Solution.smallest_value(n as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then eight more
    for n in [15, 3, 2, 4, 6, 8, 12, 99991, 65536, 100000] {
        println(f"{n} -> {smallest_value(n)}");
    }
    // every n from 2 to 20000: how many are already their smallest, and a
    // checksum
    let mut check = 0;
    let mut fixed = 0;
    for n in 2..20001 {
        let a = smallest_value(n);
        if a == n {
            fixed += 1;
        }
        check = (check * 31 + a) % 1000000007;
    }
    println(f"2 to 20000: {fixed} already smallest, checksum {check}");
    // 2000 random n to the constraints' 10^5: how many end at 5, and a
    // checksum
    let mut seed = 2507;
    let mut check = 0;
    let mut fives = 0;
    for _ in 0..2000 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 99999 + 2;
        let a = smallest_value(n);
        if a == 5 {
            fives += 1;
        }
        check = (check * 31 + a) % 1000000007;
    }
    println(f"2000 random to 10^5: {fives} end at 5, checksum {check}");
}
