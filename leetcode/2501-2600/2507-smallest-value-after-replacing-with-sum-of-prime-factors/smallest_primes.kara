// LeetCode #2507: Smallest Value After Replacing With Sum of Prime
// Factors -- the primes to the square root of n sieved first, then each
// step divides by primes only: whatever is left above 1 once they are
// spent is itself a prime. O(sqrt(n) log log n) to sieve, then
// O(sqrt(n) / log n) a step.

fn primes_to(top: i64) -> Vec[i64] {
    let mut composite: Vec[bool] = Vec.filled(top + 1, false);
    let mut primes: Vec[i64] = Vec.new();
    for p in 2..top + 1 {
        if not composite[p] {
            primes.push(p);
            let mut q = p * p;
            while q <= top {
                composite[q] = true;
                q += p;
            }
        }
    }
    primes
}

fn smallest_value(n: i64) -> i64 {
    let primes = primes_to(n.isqrt());
    let mut n = n;
    loop {
        let mut rest = n;
        let mut total = 0;
        for p in primes.iter() {
            if p * p > rest {
                break;
            }
            while rest % p == 0 {
                rest /= p;
                total += p;
            }
        }
        if rest > 1 {
            total += rest;
        }
        if total == n {
            return n;
        }
        n = total;
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then eight more
    for n in [15, 3, 2, 4, 6, 8, 12, 99991, 65536, 100000] {
        println(f"{n} -> {smallest_value(n)}");
    }
    // every n from 2 to 20000: how many are already their smallest, and a
    // checksum
    let mut check = 0;
    let mut fixed = 0;
    for n in 2..20001 {
        let a = smallest_value(n);
        if a == n {
            fixed += 1;
        }
        check = (check * 31 + a) % 1000000007;
    }
    println(f"2 to 20000: {fixed} already smallest, checksum {check}");
    // 2000 random n to the constraints' 10^5: how many end at 5, and a
    // checksum
    let mut seed = 2507;
    let mut check = 0;
    let mut fives = 0;
    for _ in 0..2000 {
        let n = (next_random(mut seed) * 32768 + next_random(mut seed)) % 99999 + 2;
        let a = smallest_value(n);
        if a == 5 {
            fives += 1;
        }
        check = (check * 31 + a) % 1000000007;
    }
    println(f"2000 random to 10^5: {fives} end at 5, checksum {check}");
}
