// LeetCode #2523: Closest Prime Numbers in Range -- benchmark of the ★ arm
// (closest.kara): the queries, each a range of width 10^4 ending at a
// `right` from 500001 to 10^6 the checksum so far picks, each answered by
// a fresh sieve to its `right`, the pair folded into the checksum.

fn closest_primes(left: i64, right: i64) -> (i64, i64) {
    let mut composite: Vec[bool] = Vec.filled(right + 1, false);
    let mut p = 2;
    while p * p <= right {
        if not composite[p] {
            let mut m = p * p;
            while m <= right {
                composite[m] = true;
                m += p;
            }
        }
        p += 1;
    }
    let mut best = (-1, -1);
    let mut last = -1;
    for x in left.max(2)..right + 1 {
        if not composite[x] {
            if last != -1 and (best.0 == -1 or x - last < best.1 - best.0) {
                best = (last, x);
            }
            last = x;
        }
    }
    best
}

fn main() {
    let queries = 150;
    let mut check = 0;
    for q in 0..queries {
        let right = check % 500000 + 500001;
        let (a, b) = closest_primes(right - 10000, right);
        check = (check * 31 + a + q) % 1000000007;
        check = (check * 31 + b) % 1000000007;
    }
    println(f"{queries} queries to 10^6: checksum {check}");
}
