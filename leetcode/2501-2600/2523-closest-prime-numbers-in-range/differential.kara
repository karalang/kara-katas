// LeetCode #2523: Closest Prime Numbers in Range -- the differential. The
// six arms against the statement read literally: a prime is a number with
// exactly two divisors, counted in pairs up to its square root; every pair
// of primes `num1 < num2` in the range is tried, not only neighbours, and
// the pair with the smallest gap and then the smallest `num1` wins. No
// sieve. 300 random ranges of width 0 to 40 within 1 to 500, 30 of width 0
// to 100 within 1 to 50000, and 30 starting at 1 to 5 of width 0 to 9;
// every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  [-1, -1], or two primes of the range, num1 < num2, a gap of 1 only
//     for [2, 3]
// P3  the range one wider at each end (kept within 1 to 10^6): a gap no
//     larger
// P4  the range cut to the answer itself: the same answer
// P5  the range cut to end at the answer's num2: the same answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally

fn divisors(x: i64) -> i64 {
    let mut count = 0;
    let mut d = 1;
    while d * d <= x {
        if x % d == 0 {
            count += if d * d == x { 1 } else { 2 };
        }
        d += 1;
    }
    count
}

fn literal(left: i64, right: i64) -> (i64, i64) {
    let primes: Vec[i64] = (left..right + 1).filter(|x| divisors(x) == 2).collect();
    let mut best = (-1, -1);
    for i in 0..primes.len() {
        for j in i + 1..primes.len() {
            let (a, b) = (primes[i], primes[j]);
            if best.0 == -1 or b - a < best.1 - best.0 or (b - a == best.1 - best.0 and a < best.0) {
                best = (a, b);
            }
        }
    }
    best
}

// ---- star (closest.kara) -------------------------------------------------

fn star_closest_primes(left: i64, right: i64) -> (i64, i64) {
    let mut composite: Vec[bool] = Vec.filled(right + 1, false);
    let mut p = 2;
    while p * p <= right {
        if not composite[p] {
            let mut m = p * p;
            while m <= right {
                composite[m] = true;
                m += p;
            }
        }
        p += 1;
    }
    let mut best = (-1, -1);
    let mut last = -1;
    for x in left.max(2)..right + 1 {
        if not composite[x] {
            if last != -1 and (best.0 == -1 or x - last < best.1 - best.0) {
                best = (last, x);
            }
            last = x;
        }
    }
    best
}

// ---- trial (closest_trial.kara) ------------------------------------------

fn trial_is_prime(x: i64) -> bool {
    if x < 2 {
        return false;
    }
    let mut d = 2;
    while d * d <= x {
        if x % d == 0 {
            return false;
        }
        d += 1;
    }
    true
}

fn trial_closest_primes(left: i64, right: i64) -> (i64, i64) {
    let mut best = (-1, -1);
    let mut last = -1;
    for x in left..right + 1 {
        if trial_is_prime(x) {
            if last != -1 and (best.0 == -1 or x - last < best.1 - best.0) {
                best = (last, x);
                if x - last <= 2 {
                    break;
                }
            }
            last = x;
        }
    }
    best
}

// ---- segmented (closest_segmented.kara) ----------------------------------

fn segmented_closest_primes(left: i64, right: i64) -> (i64, i64) {
    let root = (1..right + 2).find(|r| r * r > right).unwrap() - 1;
    let mut small: Vec[bool] = Vec.filled(root + 1, true);
    let lo = left.max(2);
    if lo > right {
        return (-1, -1);
    }
    let mut composite: Vec[bool] = Vec.filled(right - lo + 1, false);
    for p in 2..root + 1 {
        if small[p] {
            let mut q = p * p;
            while q <= root {
                small[q] = false;
                q += p;
            }
            let mut m = ((lo + p - 1) / p * p).max(p * p);
            while m <= right {
                composite[m - lo] = true;
                m += p;
            }
        }
    }
    let mut best = (-1, -1);
    let mut last = -1;
    for x in lo..right + 1 {
        if not composite[x - lo] {
            if last != -1 and (best.0 == -1 or x - last < best.1 - best.0) {
                best = (last, x);
            }
            last = x;
        }
    }
    best
}

// ---- rec (closest_rec.kara) ----------------------------------------------

struct Stretch {
    first: i64,
    last: i64,
    a: i64,
    b: i64,
}

fn rec_closer(a: i64, b: i64, than_a: i64, than_b: i64) -> bool {
    a != -1 and (than_a == -1 or b - a < than_b - than_a)
}

fn rec_stretch(lo: i64, hi: i64, composite: Vec[bool]) -> Stretch {
    if lo == hi {
        return if composite[lo] { Stretch { first: -1, last: -1, a: -1, b: -1 } } else { Stretch { first: lo, last: lo, a: -1, b: -1 } };
    }
    let mid = lo + (hi - lo) / 2;
    let l = rec_stretch(lo, mid, composite);
    let r = rec_stretch(mid + 1, hi, composite);
    let mut (a, b) = (l.a, l.b);
    if l.last != -1 and r.first != -1 and rec_closer(l.last, r.first, a, b) {
        a = l.last;
        b = r.first;
    }
    if rec_closer(r.a, r.b, a, b) {
        a = r.a;
        b = r.b;
    }
    Stretch {
        first: if l.first != -1 { l.first } else { r.first },
        last: if r.last != -1 { r.last } else { l.last },
        a: a,
        b: b,
    }
}

fn rec_closest_primes(left: i64, right: i64) -> (i64, i64) {
    let mut composite: Vec[bool] = Vec.filled(right + 1, false);
    composite[0] = true;
    if right >= 1 {
        composite[1] = true;
    }
    let mut p = 2;
    while p * p <= right {
        if not composite[p] {
            let mut m = p * p;
            while m <= right {
                composite[m] = true;
                m += p;
            }
        }
        p += 1;
    }
    let s = rec_stretch(left, right, composite);
    (s.a, s.b)
}

// ---- iter (closest_iter.kara) --------------------------------------------

fn iter_closest_primes(left: i64, right: i64) -> (i64, i64) {
    let composite = (2..right + 1).take_while(|p| p * p <= right).fold(Vec.filled(right + 1, false), |marks, p| {
        let mut marks = marks;
        if not marks[p] {
            for m in (p * p..right + 1).step_by(p) {
                marks[m] = true;
            }
        }
        marks
    });
    let primes: Vec[i64] = (left.max(2)..right + 1).filter(|x| not composite[x]).collect();
    primes.windows(2).into_iter().fold((-1, -1), |best, w| if best.0 == -1 or w[1] - w[0] < best.1 - best.0 { (w[0], w[1]) } else { best })
}

// ---- solution (closest_solution.kara) ------------------------------------

struct Solution {}

impl Solution {
    pub fn closest_primes(left: i32, right: i32) -> Vec[i32] {
        let n = right as i64;
        let mut is_prime = Vec.filled(n + 1, true);
        is_prime[0] = false;
        if n >= 1 {
            is_prime[1] = false;
        }
        let mut i = 2;
        while i * i <= n {
            if is_prime[i] {
                let mut j = i * i;
                while j <= n {
                    is_prime[j] = false;
                    j += i;
                }
            }
            i += 1;
        }
        let mut ans = [-1, -1];
        let mut prev: i32 = -1;
        let mut best = i32.MAX;
        for x in left..=right {
            if is_prime[x] {
                if prev != -1 and x - prev < best {
                    best = x - prev;
                    ans = [prev, x];
                }
                prev = x;
            }
        }
        ans
    }
}

fn solution_closest_primes(left: i64, right: i64) -> (i64, i64) {
    let v = Solution.closest_primes(left as i32, right as i32);
    (v[0] as i64, v[1] as i64)
}

// ---- the differential --------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn answer(arm: i64, left: i64, right: i64) -> (i64, i64) {
    match arm {
        0 => star_closest_primes(left, right),
        1 => trial_closest_primes(left, right),
        2 => segmented_closest_primes(left, right),
        3 => rec_closest_primes(left, right),
        4 => iter_closest_primes(left, right),
        _ => solution_closest_primes(left, right),
    }
}

fn main() {
    let names = ["star", "trial", "segmented", "rec", "iter", "solution"];
    let mut seed = 2523;
    let mut problems: Vec[(i64, i64)] = Vec.new();
    for t in 0..360 {
        let (top, width) = if t < 300 { (500, 41) } else if t < 330 { (50000, 101) } else { (5, 10) };
        let left = wide_random(mut seed) % top + 1;
        problems.push((left, (left + wide_random(mut seed) % width).min(1000000)));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut none = 0;
    for (left, right) in problems.iter() {
        let truth = literal(left, right);
        if truth.0 == -1 {
            none += 1;
        }
        check = (check * 31 + truth.0 + 1) % 1000000007;
        check = (check * 31 + truth.1 + 1) % 1000000007;
        let got: Vec[(i64, i64)] = (0..6).map(|arm| answer(arm, left, right)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let (a, b) = x;
            let wider = answer(arm, (left - 1).max(1), (right + 1).min(1000000));
            let verdicts = [
                x == truth,
                x == (-1, -1) or (left <= a and a < b and b <= right and divisors(a) == 2 and divisors(b) == 2 and (b - a > 1 or x == (2, 3))),
                x == (-1, -1) or (wider.0 != -1 and wider.1 - wider.0 <= b - a),
                x == (-1, -1) or answer(arm, a, b) == x,
                x == (-1, -1) or answer(arm, left, b) == x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{left} {right}, arm {names[arm]}: P{q + 1} fails, answer [{a}, {b}], literal [{truth.0}, {truth.1}]");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases, {none} with no pair: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
