// LeetCode #2523: Closest Prime Numbers in Range -- recursion: divide and
// conquer over the range. Each half reports a `Stretch`: its first prime,
// its last, and its closest pair; the whole range's closest pair is the
// left half's, the pair straddling the middle (the left's last prime, the
// right's first), or the right half's, preferred in that order on a tie.
// At most 21 deep.

struct Stretch {
    first: i64,
    last: i64,
    a: i64,
    b: i64,
}

fn closer(a: i64, b: i64, than_a: i64, than_b: i64) -> bool {
    a != -1 and (than_a == -1 or b - a < than_b - than_a)
}

fn stretch(lo: i64, hi: i64, composite: Vec[bool]) -> Stretch {
    if lo == hi {
        return if composite[lo] { Stretch { first: -1, last: -1, a: -1, b: -1 } } else { Stretch { first: lo, last: lo, a: -1, b: -1 } };
    }
    let mid = lo + (hi - lo) / 2;
    let l = stretch(lo, mid, composite);
    let r = stretch(mid + 1, hi, composite);
    let mut (a, b) = (l.a, l.b);
    if l.last != -1 and r.first != -1 and closer(l.last, r.first, a, b) {
        a = l.last;
        b = r.first;
    }
    if closer(r.a, r.b, a, b) {
        a = r.a;
        b = r.b;
    }
    Stretch {
        first: if l.first != -1 { l.first } else { r.first },
        last: if r.last != -1 { r.last } else { l.last },
        a: a,
        b: b,
    }
}

fn closest_primes(left: i64, right: i64) -> (i64, i64) {
    let mut composite: Vec[bool] = Vec.filled(right + 1, false);
    composite[0] = true;
    if right >= 1 {
        composite[1] = true;
    }
    let mut p = 2;
    while p * p <= right {
        if not composite[p] {
            let mut m = p * p;
            while m <= right {
                composite[m] = true;
                m += p;
            }
        }
        p += 1;
    }
    let s = stretch(left, right, composite);
    (s.a, s.b)
}


// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a value from 0 to 2^30 - 1, next_random giving only 15 bits
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples, then eight more
    for (left, right) in [(10, 19), (4, 6), (1, 1), (1, 2), (2, 3), (1, 10), (14, 16), (89, 97), (1000000, 1000000), (999900, 1000000)] {
        let (a, b) = closest_primes(left, right);
        println(f"{left} {right} -> [{a}, {b}]");
    }
    // 2000 random ranges of width 0 to 99 within 1 to 10^4, and 30 of width
    // 0 to 9999 within 1 to 10^6: how many have no pair, the sum of the
    // gaps, and a checksum
    let mut seed = 2523;
    for (count, top, width) in [(2000, 10000, 100), (30, 1000000, 10000)] {
        let mut none = 0;
        let mut gaps = 0;
        let mut check = 0;
        for _ in 0..count {
            let left = wide_random(mut seed) % top + 1;
            let right = (left + wide_random(mut seed) % width).min(top);
            let (a, b) = closest_primes(left, right);
            if a == -1 {
                none += 1;
            } else {
                gaps += b - a;
            }
            check = (check * 31 + a + 1) % 1000000007;
        }
        println(f"{count} random ranges to {top}: {none} with no pair, gaps {gaps}, checksum {check}");
    }
    // the constraints' largest: 1 to 10^6
    let (a, b) = closest_primes(1, 1000000);
    println(f"1 1000000 -> [{a}, {b}]");
}
