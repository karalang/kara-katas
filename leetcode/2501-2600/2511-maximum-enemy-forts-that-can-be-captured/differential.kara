// LeetCode #2511: Maximum Enemy Forts That Can Be Captured -- the
// differential. The six arms against the statement read literally: every
// fort of ours and every empty fort as a pair, the march between them
// allowed when every fort strictly between is an enemy fort, and the
// most forts any allowed march passes. No run is followed and no last
// fort kept. 300 random lines of 1 to 12 forts, a 0 one time in three or
// four in six; then 20 of 1 or 2 forts, and 40 of 40 forts, a 0 eight
// times in ten; every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  from 0 to n - 2, and 0 when no fort is ours or none is empty
// P3  the line in the other order: the same answer
// P4  every fort negated, ours as empty and empty as ours: the same
//     answer
// P5  every enemy fort written twice: twice the answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally

fn literal(forts: Vec[i64]) -> i64 {
    let mut best = 0;
    for i in 0..forts.len() {
        for j in 0..forts.len() {
            if forts[i] == 1 and forts[j] == -1 {
                let (lo, hi) = (i.min(j), i.max(j));
                if (lo + 1..hi).all(|k| forts[k] == 0) {
                    best = best.max(hi - lo - 1);
                }
            }
        }
    }
    best
}

// ---- star (forts.kara) ---------------------------------------------------

fn star_capture_forts(forts: Vec[i64]) -> i64 {
    let mut best = 0;
    let mut last = -1;
    for i in 0..forts.len() {
        if forts[i] != 0 {
            if last >= 0 and forts[last] == -forts[i] {
                best = best.max(i - last - 1);
            }
            last = i;
        }
    }
    best
}

// ---- scan (forts_scan.kara) ----------------------------------------------

fn scan_march(forts: Vec[i64], from: i64, step: i64) -> i64 {
    let mut j = from + step;
    while j >= 0 and j < forts.len() and forts[j] == 0 {
        j += step;
    }
    if j >= 0 and j < forts.len() and forts[j] == -1 {
        (j - from).abs() - 1
    } else {
        0
    }
}

fn scan_capture_forts(forts: Vec[i64]) -> i64 {
    let mut best = 0;
    for i in 0..forts.len() {
        if forts[i] == 1 {
            best = best.max(scan_march(forts, i, -1)).max(scan_march(forts, i, 1));
        }
    }
    best
}

// ---- pairs (forts_pairs.kara) --------------------------------------------

fn pairs_capture_forts(forts: Vec[i64]) -> i64 {
    let mut places: Vec[i64] = Vec.new();
    for i in 0..forts.len() {
        if forts[i] != 0 {
            places.push(i);
        }
    }
    let mut best = 0;
    for k in 1..places.len() {
        let (p, q) = (places[k - 1], places[k]);
        if forts[p] * forts[q] == -1 {
            best = best.max(q - p - 1);
        }
    }
    best
}

// ---- rec (forts_rec.kara) ------------------------------------------------

fn rec_best_from(forts: Vec[i64], i: i64, last: i64, run: i64) -> i64 {
    if i == forts.len() {
        0
    } else if forts[i] == 0 {
        rec_best_from(forts, i + 1, last, run + 1)
    } else {
        let here = if last == -forts[i] { run } else { 0 };
        here.max(rec_best_from(forts, i + 1, forts[i], 0))
    }
}

fn rec_capture_forts(forts: Vec[i64]) -> i64 {
    rec_best_from(forts, 0, 0, 0)
}

// ---- iter (forts_iter.kara) ----------------------------------------------

fn iter_capture_forts(forts: Vec[i64]) -> i64 {
    let places: Vec[i64] = forts.iter().enumerate().filter(|(_, f)| f != 0).map(|(i, _)| i).collect();
    places.windows(2).into_iter().filter(|w| forts[w[0]] + forts[w[1]] == 0).map(|w| w[1] - w[0] - 1).max() ?? 0
}

// ---- solution (forts_solution.kara) --------------------------------------

struct Solution {}

impl Solution {
    pub fn capture_forts(forts: Vec[i32]) -> i32 {
        let mut ans: i32 = 0;
        let mut last: Option[i64] = None;
        for i in 0..forts.len() {
            if forts[i] != 0 {
                if let Some(j) = last {
                    if forts[j] != forts[i] {
                        ans = ans.max((i - j - 1) as i32);
                    }
                }
                last = Some(i);
            }
        }
        ans
    }
}

fn solution_capture_forts(forts: Vec[i64]) -> i64 {
    let asked: Vec[i32] = forts.iter().map(|f| f as i32).collect();
    Solution.capture_forts(asked)
}

// ---- the differential --------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(arm: i64, forts: Vec[i64]) -> i64 {
    match arm {
        0 => star_capture_forts(forts),
        1 => scan_capture_forts(forts),
        2 => pairs_capture_forts(forts),
        3 => rec_capture_forts(forts),
        4 => iter_capture_forts(forts),
        _ => solution_capture_forts(forts),
    }
}

fn main() {
    let names = ["star", "scan", "pairs", "rec", "iter", "solution"];
    let mut seed = 2511;
    let mut problems: Vec[Vec[i64]] = Vec.new();
    for t in 0..360 {
        let n = if t < 300 { next_random(mut seed) % 12 + 1 } else if t < 320 { next_random(mut seed) % 2 + 1 } else { 40 };
        let (zeros, of) = if t < 300 {
            if next_random(mut seed) % 2 == 0 { (1, 3) } else { (4, 6) }
        } else {
            (8, 10)
        };
        let forts: Vec[i64] = (0..n)
            .map(|_| {
                let r = next_random(mut seed) % of;
                if r < zeros { 0 } else if r % 2 == 0 { 1 } else { -1 }
            })
            .collect();
        problems.push(forts);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut none = 0;
    for forts in problems.iter() {
        let truth = literal(forts);
        if truth == 0 {
            none += 1;
        }
        check = (check * 31 + truth) % 1000000007;
        let n = forts.len();
        let both = forts.contains(1) and forts.contains(-1);
        let reversed: Vec[i64] = forts.iter().rev().map(|f| *f).collect();
        let negated: Vec[i64] = forts.iter().map(|f| -f).collect();
        let mut doubled: Vec[i64] = Vec.new();
        for f in forts.iter() {
            doubled.push(f);
            if f == 0 {
                doubled.push(0);
            }
        }
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, forts)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                x >= 0 and x <= (n - 2).max(0) and (both or x == 0),
                answer(arm, reversed) == x,
                answer(arm, negated) == x,
                answer(arm, doubled) == 2 * x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{forts}, arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases, {none} capture nothing: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
