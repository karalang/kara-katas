// LeetCode #2521: Distinct Prime Factors of Product of Array -- LeetCode's
// Rust template: `Vec<i32>` in, `i32` out; each number split by trial
// division, every prime into a `HashSet`, and its `len()` cast back;
// carried by `karac fix`.

struct Solution {}

impl Solution {
    pub fn distinct_prime_factors(nums: Vec[i32]) -> i32 {
        let mut set = Set.new();
        for n in ref nums {
            let mut x = n;
            let mut p: i32 = 2;
            while p * p <= x {
                while x % p == 0 {
                    set.insert(p);
                    x /= p;
                }
                p += 1;
            }
            if x > 1 {
                set.insert(x);
            }
        }
        set.len() as i32
    }
}

fn distinct_prime_factors(nums: Vec[i64]) -> i64 {
    Solution.distinct_prime_factors(nums.iter().map(|x| x as i32).collect())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then six more
    let fixed: Vec[Vec[i64]] = [
        [2, 4, 3, 7, 10, 6].to_vec(),
        [2, 4, 8, 16].to_vec(),
        [1000].to_vec(),
        [997].to_vec(),
        [30, 30, 30].to_vec(),
        [961, 31, 2].to_vec(),
        [512, 729, 625, 343].to_vec(),
        [210, 770, 858].to_vec(),
    ].to_vec();
    for nums in fixed.iter() {
        println(f"{nums} -> {distinct_prime_factors(nums)}");
    }
    // 2000 random lists of 1 to 10 numbers from 2 to 50, and 2000 of 1 to
    // 100 from 2 to 1000: the sum and a checksum
    let mut seed = 2521;
    for (most, top) in [(10, 50), (100, 1000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..2000 {
            let n = next_random(mut seed) % most + 1;
            let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % (top - 1) + 2).collect();
            let a = distinct_prime_factors(nums);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
        println(f"2000 random lists of up to {most} numbers to {top}: total {total}, checksum {check}");
    }
    // the constraints' largest: 10^4 numbers, every one 2 to 1000 in turn,
    // all 1000, and random from 2 to 1000
    let every: Vec[i64] = (0..10000).map(|i| i % 999 + 2).collect();
    println(f"10^4 numbers cycling 2 to 1000: {distinct_prime_factors(every)}");
    println(f"10^4 of 1000: {distinct_prime_factors(Vec.filled(10000, 1000))}");
    let random: Vec[i64] = (0..10000).map(|_| next_random(mut seed) % 999 + 2).collect();
    println(f"10^4 random to 1000: {distinct_prime_factors(random)}");
}
