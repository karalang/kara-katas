// LeetCode #2508: Add Edges to Make Degrees of All Nodes Even -- the ★
// arm. An added edge flips the parity of its two ends, so two edges can
// mend at most four odd nodes: none needs nothing; two, a and b, need
// the edge a-b or, failing that, a third node joined to neither; four
// need one of their three pairings to be two absent edges. The edges
// are held in a `Set`, each as one number. O(n + edges).

fn is_possible(n: i64, edges: Vec[Vec[i64]]) -> bool {
    let mut degree: Vec[i64] = Vec.filled(n + 1, 0);
    let mut present: Set[i64] = Set.new();
    for edge in edges.iter() {
        let (a, b) = (edge[0], edge[1]);
        degree[a] += 1;
        degree[b] += 1;
        present.insert(a.min(b) * (n + 1) + a.max(b));
    }
    let free = |a: i64, b: i64| not present.contains(a.min(b) * (n + 1) + a.max(b));
    let odd: Vec[i64] = (1..n + 1).filter(|v| degree[v] % 2 == 1).collect();
    match odd.len() {
        0 => true,
        2 => {
            let (a, b) = (odd[0], odd[1]);
            free(a, b) or (1..n + 1).any(|c| c != a and c != b and free(a, c) and free(b, c))
        }
        4 => {
            let (a, b, c, d) = (odd[0], odd[1], odd[2], odd[3]);
            (free(a, b) and free(c, d)) or (free(a, c) and free(b, d)) or (free(a, d) and free(b, c))
        }
        _ => false,
    }
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// up to `wanted` distinct edges, drawn until that many or 4 `wanted`
// draws
fn random_graph(n: i64, wanted: i64, seed: mut ref i64) -> Vec[Vec[i64]] {
    let mut seen: Set[(i64, i64)] = Set.new();
    let mut edges: Vec[Vec[i64]] = Vec.new();
    for _ in 0..4 * wanted {
        if edges.len() == wanted {
            break;
        }
        let a = next_random(mut seed) % n + 1;
        let b = next_random(mut seed) % n + 1;
        if a != b and not seen.contains((a.min(b), a.max(b))) {
            seen.insert((a.min(b), a.max(b)));
            edges.push([a, b].to_vec());
        }
    }
    edges
}

fn edges_of(pairs: Vec[(i64, i64)]) -> Vec[Vec[i64]] {
    pairs.iter().map(|(a, b)| [a, b].to_vec()).collect()
}

fn main() {
    // LeetCode's three examples, then five more
    let cases: Vec[(i64, Vec[Vec[i64]])] = [
        (5, edges_of([(1, 2), (2, 3), (3, 4), (4, 2), (1, 4), (2, 5)].to_vec())),
        (4, edges_of([(1, 2), (3, 4)].to_vec())),
        (4, edges_of([(1, 2), (1, 3), (1, 4)].to_vec())),
        (3, edges_of([(1, 2)].to_vec())),
        (3, edges_of([(1, 2), (2, 3), (1, 3)].to_vec())),
        (4, edges_of([(1, 2), (1, 3), (1, 4), (2, 3), (2, 4)].to_vec())),
        (6, edges_of([(1, 2), (3, 4), (5, 6)].to_vec())),
        (5, edges_of([(1, 2), (1, 3), (1, 4), (1, 5), (2, 3), (2, 4), (2, 5)].to_vec())),
    ].to_vec();
    for (n, edges) in cases.iter() {
        println(f"{n} nodes, {edges.len()} edges -> {is_possible(n, edges)}");
    }
    // 2000 random graphs of 3 to 8 nodes and of 3 to 30, with 1 to every
    // possible edge: how many can be mended, and a checksum of the answers
    let mut seed = 2508;
    for most in [8, 30] {
        let mut check = 0;
        let mut yes = 0;
        for _ in 0..2000 {
            let n = next_random(mut seed) % (most - 2) + 3;
            let wanted = next_random(mut seed) % (n * (n - 1) / 2) + 1;
            let a = is_possible(n, random_graph(n, wanted, mut seed));
            if a {
                yes += 1;
            }
            check = (check * 2 + if a { 1 } else { 0 }) % 1000000007;
        }
        println(f"2000 random to {most} nodes: {yes} possible, checksum {check}");
    }
    // the constraints' largest: a star and a path on 10^5 nodes; 33000
    // nodes, 3 to n in a ring, 1 and 2 joined, and both joined to every
    // node of the ring, then the same with one ring node left alone; and
    // 10^5 random edges on 10^5 nodes
    let star: Vec[Vec[i64]] = (2..100001).map(|v| [1, v].to_vec()).collect();
    println(f"10^5 nodes, a star -> {is_possible(100000, star)}");
    let path: Vec[Vec[i64]] = (1..100000).map(|v| [v, v + 1].to_vec()).collect();
    println(f"10^5 nodes, a path -> {is_possible(100000, path)}");
    let mut ring: Vec[Vec[i64]] = (3..33000).map(|v| [v, v + 1].to_vec()).collect();
    ring.push([33000, 3].to_vec());
    ring.push([1, 2].to_vec());
    let mut joined = ring.clone();
    let mut spared = ring.clone();
    for v in 3..33001 {
        for h in [1, 2] {
            joined.push([h, v].to_vec());
            if v != 17000 {
                spared.push([h, v].to_vec());
            }
        }
    }
    println(f"33000 nodes, two odd joined to all -> {is_possible(33000, joined)}");
    println(f"33000 nodes, two odd joined to all but one -> {is_possible(33000, spared)}");
    let big = random_graph(100000, 100000, mut seed);
    println(f"10^5 nodes, {big.len()} random edges -> {is_possible(100000, big)}");
}
