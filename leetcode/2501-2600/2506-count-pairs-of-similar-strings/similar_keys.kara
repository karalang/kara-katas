// LeetCode #2506: Count Pairs Of Similar Strings -- every word's distinct
// letters, sorted, as a `String` key; the keys sorted, and each run of
// `r` equal keys counted as `r (r - 1) / 2` pairs. O(total length log +
// n log n).

fn key_of(word: String) -> String {
    let mut letters: Vec[char] = word.chars().collect();
    letters.sort();
    letters.dedup();
    letters.iter().collect()
}

fn similar_pairs(words: Vec[String]) -> i64 {
    let mut keys: Vec[String] = words.iter().map(|w| key_of(w)).collect();
    keys.sort();
    let mut pairs = 0;
    let mut start = 0;
    for i in 1..keys.len() + 1 {
        if i == keys.len() or keys[i] != keys[start] {
            let run = i - start;
            pairs += run * (run - 1) / 2;
            start = i;
        }
    }
    pairs
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a word of `length` letters drawn from the first `letters` of the
// alphabet
fn random_word(length: i64, letters: i64, seed: mut ref i64) -> String {
    let mut word = String.new();
    for _ in 0..length {
        word.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    word
}

fn words_of(list: Vec[Str]) -> Vec[String] {
    list.iter().map(|w| w.to_string()).collect()
}

fn main() {
    // LeetCode's three examples, then five more
    let cases: Vec[Vec[String]] = [
        words_of(["aba", "aabb", "abcd", "bac", "aabc"].to_vec()),
        words_of(["aabb", "ab", "ba"].to_vec()),
        words_of(["nba", "cba", "dba"].to_vec()),
        words_of(["z"].to_vec()),
        words_of(["abc", "cab", "bca", "cba"].to_vec()),
        words_of(["a", "aa", "aaa", "b", "bb"].to_vec()),
        words_of(["abcdefghijklmnopqrstuvwxyz", "zyxwvutsrqponmlkjihgfedcba", "a"].to_vec()),
        words_of(["ab", "abc", "abcd", "dcba", "cba"].to_vec()),
    ].to_vec();
    for words in cases.iter() {
        println(f"{words.len()} words -> {similar_pairs(words)}");
    }
    // 2000 random lists of 1 to 30 words of 1 to 8 letters, from 3 letters
    // and from 26: how many have no pair, and a checksum
    let mut seed = 2506;
    for letters in [3, 26] {
        let mut check = 0;
        let mut none = 0;
        for _ in 0..2000 {
            let count = next_random(mut seed) % 30 + 1;
            let mut words: Vec[String] = Vec.new();
            for _ in 0..count {
                let length = next_random(mut seed) % 8 + 1;
                words.push(random_word(length, letters, mut seed));
            }
            let a = similar_pairs(words);
            if a == 0 {
                none += 1;
            }
            check = (check * 31 + a) % 1000000007;
        }
        println(f"2000 random of {letters} letters: {none} with no pair, checksum {check}");
    }
    // the constraints' largest, 100 words: each of 100 letters running
    // through the alphabet from a different start; 100 random words of 100
    // letters; and 100 random words of 1 to 4 letters from 3
    let same: Vec[String] = (0..100).map(|i| (0..100).map(|j| (b'a' + ((i + j) % 26) as u8) as char).collect()).collect();
    println(f"100 words of every letter -> {similar_pairs(same)}");
    let long_words: Vec[String] = (0..100).map(|_| random_word(100, 26, mut seed)).collect();
    println(f"100 random words of 100 letters -> {similar_pairs(long_words)}");
    let mut short_words: Vec[String] = Vec.new();
    for _ in 0..100 {
        let length = next_random(mut seed) % 4 + 1;
        short_words.push(random_word(length, 3, mut seed));
    }
    println(f"100 random words to 4 letters from 3 -> {similar_pairs(short_words)}");
}
