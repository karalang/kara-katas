// LeetCode #2528: Maximize the Minimum Powered City -- a sliding window
// over the stations themselves, no power formed ahead: for a target, the
// window of stations within `r` of city `i`, the ones placed so far
// counted in, gains the city `r` on and loses the one `r + 1` back; a
// shortfall is placed at the window's right end, `min(i + r, n - 1)`. The
// search between the fewest stations any window holds and that plus `k`.

fn reachable(stations: Vec[i64], r: i64, k: i64, target: i64) -> bool {
    let n = stations.len();
    let mut placed = Vec.filled(n, 0);
    let mut window = 0;
    for j in 0..r.min(n - 1) + 1 {
        window += stations[j];
    }
    let mut used = 0;
    for i in 0..n {
        if i + r < n and i > 0 {
            window += stations[i + r];
        }
        if i - r - 1 >= 0 {
            window -= stations[i - r - 1] + placed[i - r - 1];
        }
        if window < target {
            let need = target - window;
            used += need;
            if used > k {
                return false;
            }
            placed[(i + r).min(n - 1)] += need;
            window += need;
        }
    }
    true
}

fn max_power(stations: Vec[i64], r: i64, k: i64) -> i64 {
    let n = stations.len();
    let mut least = -1;
    let mut window = 0;
    for j in 0..r.min(n - 1) + 1 {
        window += stations[j];
    }
    for i in 0..n {
        if i + r < n and i > 0 {
            window += stations[i + r];
        }
        if i - r - 1 >= 0 {
            window -= stations[i - r - 1];
        }
        if least == -1 or window < least {
            least = window;
        }
    }
    let mut lo = least;
    let mut hi = least + k;
    while lo < hi {
        let mid = lo + (hi - lo + 1) / 2;
        if reachable(stations, r, k, mid) {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a value from 0 to 2^30 - 1, next_random giving only 15 bits
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples, then six more
    let fixed: Vec[(Vec[i64], i64, i64)] = [
        ([1, 2, 4, 5, 0], 1, 2),
        ([4, 4, 4, 4], 0, 3),
        ([0], 0, 0),
        ([0], 0, 1000000000),
        ([5, 0, 0, 0, 0, 0, 5], 1, 3),
        ([1, 0, 0, 0, 1], 4, 0),
        ([0, 0, 0, 0, 0, 0], 1, 4),
        ([100000, 0, 100000], 0, 1),
    ];
    for (stations, r, k) in fixed.iter() {
        println(f"{stations} r {r} k {k} -> {max_power(stations, r, k)}");
    }
    // 2000 random cities of 1 to 20, 0 to 5 stations each, r up to n - 1
    // and k up to 20: the sum of the answers and a checksum
    let mut seed = 2528;
    let mut total = 0;
    let mut check = 0;
    for _ in 0..2000 {
        let n = next_random(mut seed) % 20 + 1;
        let stations: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 6).collect();
        let r = next_random(mut seed) % n;
        let k = next_random(mut seed) % 21;
        let a = max_power(stations, r, k);
        total += a;
        check = (check * 31 + a) % 1000000007;
    }
    println(f"2000 random lists of up to 20 cities: total {total}, checksum {check}");
    // the constraints' largest: 10^5 cities of up to 10^5 stations, with
    // k = 10^9 and r of 0, 10 and 10^4
    let stations: Vec[i64] = (0..100000).map(|_| next_random(mut seed) % 100001).collect();
    for r in [0, 10, 10000] {
        println(f"10^5 cities, r {r}, k 10^9: {max_power(stations, r, 1000000000)}");
    }
}
