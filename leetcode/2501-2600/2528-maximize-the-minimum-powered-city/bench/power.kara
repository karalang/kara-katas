// LeetCode #2528: Maximize the Minimum Powered City -- benchmark of the
// ★ arm (power.kara): 10^5 cities of 0 to 10^5 stations built once from
// its own generator; then the passes, each asking for the answer with an
// `r` and a `k` the checksum so far picks.

fn reachable(power: Vec[i64], r: i64, k: i64, target: i64) -> bool {
    let n = power.len();
    let mut ends = Vec.filled(n + 1, 0);
    let mut running = 0;
    let mut used = 0;
    for i in 0..n {
        running += ends[i];
        let have = power[i] + running;
        if have < target {
            let need = target - have;
            used += need;
            if used > k {
                return false;
            }
            running += need;
            ends[(i + 2 * r + 1).min(n)] -= need;
        }
    }
    true
}

fn max_power(stations: Vec[i64], r: i64, k: i64) -> i64 {
    let n = stations.len();
    let mut prefix = Vec.filled(n + 1, 0);
    for i in 0..n {
        prefix[i + 1] = prefix[i] + stations[i];
    }
    let power: Vec[i64] = (0..n).map(|i| prefix[(i + r + 1).min(n)] - prefix[(i - r).max(0)]).collect();
    let mut lo = power.iter().min().unwrap();
    let mut hi = lo + k;
    while lo < hi {
        let mid = lo + (hi - lo + 1) / 2;
        if reachable(power, r, k, mid) {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2528;
    let stations: Vec[i64] = (0..100000).map(|_| next_random(mut seed) % 100001).collect();
    let passes = 20;
    let mut check = 0;
    for p in 0..passes {
        let r = check % 100;
        let k = 1000000000 - check % 1000;
        check = (check * 31 + max_power(stations, r, k) + p) % 1000000007;
    }
    println(f"{passes} passes over 100000 cities: checksum {check}");
}
