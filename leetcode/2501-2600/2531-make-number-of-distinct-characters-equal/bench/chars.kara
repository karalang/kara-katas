// LeetCode #2531: Make Number of Distinct Characters Equal -- benchmark of
// the ★ arm (chars.kara): 1000 pairs of words of 1 to 1000 letters built
// once from its own generator, each word from its own first 1 to 26
// letters; then the passes, each asking every pair, starting at an
// offset the checksum so far picks.

fn distinct(counts: Array[i64, 26]) -> i64 {
    counts.iter().filter(|c| c > 0).count()
}

fn is_it_possible(word1: Str, word2: Str) -> bool {
    let mut one = [0; 26];
    let mut two = [0; 26];
    for b in word1.bytes() {
        one[b - b'a'] += 1;
    }
    for b in word2.bytes() {
        two[b - b'a'] += 1;
    }
    for a in 0..26 {
        for b in 0..26 {
            if one[a] > 0 and two[b] > 0 {
                one[a] -= 1;
                one[b] += 1;
                two[b] -= 1;
                two[a] += 1;
                let equal = distinct(one) == distinct(two);
                one[a] += 1;
                one[b] -= 1;
                two[b] += 1;
                two[a] -= 1;
                if equal {
                    return true;
                }
            }
        }
    }
    false
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, length: i64, letters: i64) -> String {
    let mut word = String.new();
    for _ in 0..length {
        word.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    word
}

fn main() {
    let mut seed = 2531;
    let mut pairs: Vec[(String, String)] = Vec.new();
    for _ in 0..1000 {
        let word1 = random_word(mut seed, next_random(mut seed) % 1000 + 1, next_random(mut seed) % 26 + 1);
        let word2 = random_word(mut seed, next_random(mut seed) % 1000 + 1, next_random(mut seed) % 26 + 1);
        pairs.push((word1, word2));
    }
    let passes = 24;
    let mut check = 0;
    for p in 0..passes {
        let start = check % 1000;
        for i in 0..1000 {
            let (word1, word2) = ref pairs[(start + i) % 1000];
            let answer = is_it_possible(word1, word2);
            check = (check * 31 + (if answer { 2 } else { 1 }) + p) % 1000000007;
        }
    }
    println(f"{passes} passes over 1000 pairs of words: checksum {check}");
}
