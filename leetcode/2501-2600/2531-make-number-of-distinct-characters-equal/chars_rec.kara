// LeetCode #2531: Make Number of Distinct Characters Equal -- recursion:
// the 676 pairs of letters walked by a recursion on the pair's number,
// `p / 26` from word1 and `p % 26` from word2, each tried on the counts
// as the ★ arm does; at most 677 deep.

fn distinct(counts: Array[i64, 26]) -> i64 {
    counts.iter().filter(|c| c > 0).count()
}

fn try_from(one: mut ref Array[i64, 26], two: mut ref Array[i64, 26], p: i64) -> bool {
    if p == 676 {
        return false;
    }
    let a = p / 26;
    let b = p % 26;
    if one[a] > 0 and two[b] > 0 {
        one[a] -= 1;
        one[b] += 1;
        two[b] -= 1;
        two[a] += 1;
        let equal = distinct(one) == distinct(two);
        one[a] += 1;
        one[b] -= 1;
        two[b] += 1;
        two[a] -= 1;
        if equal {
            return true;
        }
    }
    try_from(mut one, mut two, p + 1)
}

fn is_it_possible(word1: Str, word2: Str) -> bool {
    let mut one = [0; 26];
    let mut two = [0; 26];
    for b in word1.bytes() {
        one[b - b'a'] += 1;
    }
    for b in word2.bytes() {
        two[b - b'a'] += 1;
    }
    try_from(mut one, mut two, 0)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn random_word(seed: mut ref i64, length: i64, letters: i64) -> String {
    let mut word = String.new();
    for _ in 0..length {
        word.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
    }
    word
}

fn main() {
    // LeetCode's three examples, then five more
    let fixed = [
        ("ac", "b"),
        ("abcc", "aab"),
        ("abcde", "fghij"),
        ("a", "a"),
        ("a", "bb"),
        ("aa", "bcd"),
        ("abcdefghijklmnopqrstuvwxyz", "a"),
        ("ab", "abcd"),
    ];
    for (word1, word2) in fixed.iter() {
        println(f"{word1} {word2} -> {is_it_possible(word1, word2)}");
    }
    // 3000 random pairs of 1 to 8 letters from the first 1 to 6, and 300
    // of 1 to 2000 letters from all 26: how many are possible
    let mut seed = 2531;
    for (count, most, letters) in [(3000, 8, 6), (300, 2000, 26)] {
        let mut yes = 0;
        let mut check = 0;
        for _ in 0..count {
            let pick = next_random(mut seed) % letters + 1;
            let word1 = random_word(mut seed, next_random(mut seed) % most + 1, pick);
            let word2 = random_word(mut seed, next_random(mut seed) % most + 1, next_random(mut seed) % letters + 1);
            let answer = is_it_possible(word1, word2);
            if answer {
                yes += 1;
            }
            check = (check * 31 + (if answer { 2 } else { 1 })) % 1000000007;
        }
        println(f"{count} random pairs of up to {most} letters: {yes} possible, checksum {check}");
    }
}
