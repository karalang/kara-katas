// LeetCode #2527: Find Xor-Beauty of Array -- the differential. The six
// arms against the statement read literally: every triple `(i, j, k)` of
// indices, repeats allowed, its effective value `(nums[i] | nums[j]) &
// nums[k]` formed, and all `n^3` of them xor'd together. 300 random lists
// of 1 to 12 numbers from 1 to 64, and 60 of 1 to 12 from 1 to 10^9, each
// with one more number drawn from the same range; every one drawn before
// any arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer is below 2^30, and every bit it holds is held by some number
// P3  the list reversed: the same answer
// P4  the extra number appended: the answer xor'd with it
// P5  the list split in two (when n > 1): the xor of the halves' answers
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally

fn literal(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut beauty = 0;
    for i in 0..n {
        for j in 0..n {
            for k in 0..n {
                beauty ^= (nums[i] | nums[j]) & nums[k];
            }
        }
    }
    beauty
}

// ---- star (xor.kara) -----------------------------------------------------

fn star_xor_beauty(nums: Vec[i64]) -> i64 {
    let mut beauty = 0;
    for x in nums.iter() {
        beauty ^= x;
    }
    beauty
}

// ---- bits (xor_bits.kara) ------------------------------------------------

fn bits_xor_beauty(nums: Vec[i64]) -> i64 {
    let mut beauty = 0;
    for bit in 0..30 {
        let mut ones = 0;
        for x in nums.iter() {
            ones += (x >> bit) & 1;
        }
        if ones % 2 == 1 {
            beauty |= 1 << bit;
        }
    }
    beauty
}

// ---- pairs (xor_pairs.kara) ----------------------------------------------

fn pairs_xor_beauty(nums: Vec[i64]) -> i64 {
    let n = nums.len();
    let mut beauty = 0;
    for bit in 0..30 {
        let c = nums.iter().filter(|x| (x >> bit) & 1 == 1).count();
        let pairs = n * n - (n - c) * (n - c);
        if pairs * c % 2 == 1 {
            beauty |= 1 << bit;
        }
    }
    beauty
}

// ---- rec (xor_rec.kara) --------------------------------------------------

fn rec_xor_of(nums: Vec[i64], lo: i64, hi: i64) -> i64 {
    if hi - lo == 1 {
        nums[lo]
    } else {
        let mid = lo + (hi - lo) / 2;
        rec_xor_of(nums, lo, mid) ^ rec_xor_of(nums, mid, hi)
    }
}

fn rec_xor_beauty(nums: Vec[i64]) -> i64 {
    rec_xor_of(nums, 0, nums.len())
}

// ---- iter (xor_iter.kara) ------------------------------------------------

fn iter_xor_beauty(nums: Vec[i64]) -> i64 {
    nums.iter().reduce(|a, b| a ^ b).unwrap()
}

// ---- solution (xor_solution.kara) ----------------------------------------

struct Solution {}

impl Solution {
    pub fn xor_beauty(nums: Vec[i32]) -> i32 {
        nums.iter().fold(0, |acc, x| acc ^ x)
    }
}

fn solution_xor_beauty(nums: Vec[i64]) -> i64 {
    Solution.xor_beauty(nums.iter().map(|x| x as i32).collect())
}

// ---- the differential --------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_xor_beauty(nums),
        1 => bits_xor_beauty(nums),
        2 => pairs_xor_beauty(nums),
        3 => rec_xor_beauty(nums),
        4 => iter_xor_beauty(nums),
        _ => solution_xor_beauty(nums),
    }
}

fn main() {
    let names = ["star", "bits", "pairs", "rec", "iter", "solution"];
    let mut seed = 2527;
    let mut problems: Vec[(Vec[i64], i64)] = Vec.new();
    for t in 0..360 {
        let n = next_random(mut seed) % 12 + 1;
        let top = if t < 300 { 64 } else { 1000000000 };
        let nums: Vec[i64] = (0..n).map(|_| wide_random(mut seed) % top + 1).collect();
        problems.push((nums, wide_random(mut seed) % top + 1));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut zero = 0;
    for (nums, extra) in problems.iter() {
        let truth = literal(nums);
        if truth == 0 {
            zero += 1;
        }
        check = (check * 31 + truth) % 1000000007;
        let mut any = 0;
        for x in nums.iter() {
            any |= x;
        }
        let reversed: Vec[i64] = nums.iter().rev().collect();
        let mut longer = nums.clone();
        longer.push(extra);
        let half = nums.len() / 2;
        let left: Vec[i64] = nums.iter().take(half).collect();
        let right: Vec[i64] = nums.iter().skip(half).collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                x >= 0 and x < 1073741824 and x & any == x,
                answer(arm, reversed) == x,
                answer(arm, longer) == x ^ extra,
                nums.len() < 2 or answer(arm, left) ^ answer(arm, right) == x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums} + {extra}, arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases, {zero} with beauty 0: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
