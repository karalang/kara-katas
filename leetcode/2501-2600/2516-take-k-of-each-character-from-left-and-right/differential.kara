// LeetCode #2516: Take K of Each Character From Left and Right -- the
// differential. The six arms against the statement read literally: for
// each number of minutes from 0 up, every way to split them between the
// left end and the right end, the letters taken counted by a scan of
// both parts; the first number of minutes with a split that holds k of
// each. No window is slid. 300 random strings of 1 to 10 letters, k from
// 0 to 3; then 20 of 12 letters from a and b only, k 1; and 40 of 12
// letters, k 2; every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  -1 exactly when some letter is there fewer than k times, and
//     otherwise from 3 k to n
// P3  the string reversed: the same answer
// P4  every a written b, b c, and c a: the same answer
// P5  for k - 1, while k is at least 1 and there is an answer: from 0 to
//     the answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally

fn literal(s: String, k: i64) -> i64 {
    let n = s.len();
    for minutes in 0..n + 1 {
        for from_left in 0..minutes + 1 {
            let taken = f"{s[0..from_left]}{s[n - (minutes - from_left)..n]}";
            if ["a", "b", "c"].iter().all(|c| taken.matches(c).count() >= k) {
                return minutes;
            }
        }
    }
    -1
}

// ---- star (take.kara) ----------------------------------------------------

fn star_take_characters(s: String, k: i64) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut total = [0, 0, 0];
    for b in bytes.iter() {
        total[b - b'a'] += 1;
    }
    if total[0] < k or total[1] < k or total[2] < k {
        return -1;
    }
    let mut inside = [0, 0, 0];
    let mut left = 0;
    let mut longest = 0;
    for right in 0..n {
        let c = bytes[right] - b'a';
        inside[c] += 1;
        while total[c] - inside[c] < k {
            inside[bytes[left] - b'a'] -= 1;
            left += 1;
        }
        longest = longest.max(right - left + 1);
    }
    n - longest
}

// ---- search (take_search.kara) -------------------------------------------

fn search_take_characters(s: String, k: i64) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    // prefix[i][c] = c's among the first i letters
    let mut prefix: Vec[Array[i64, 3]] = Vec.filled(n + 1, [0, 0, 0]);
    for i in 0..n {
        prefix[i + 1] = prefix[i];
        prefix[i + 1][bytes[i] - b'a'] += 1;
    }
    let enough = |i: i64, j: i64| (0..3).all(|c| prefix[i][c] + prefix[n][c] - prefix[n - j][c] >= k);
    let mut best = -1;
    for i in 0..n + 1 {
        if not enough(i, n - i) {
            continue;
        }
        let mut lo = 0;
        let mut hi = n - i;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if enough(i, mid) {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        if best == -1 or i + lo < best {
            best = i + lo;
        }
    }
    best
}

// ---- shrink (take_shrink.kara) -------------------------------------------

fn shrink_take_characters(s: String, k: i64) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut taken = [0, 0, 0];
    for b in bytes.iter() {
        taken[b - b'a'] += 1;
    }
    if taken[0] < k or taken[1] < k or taken[2] < k {
        return -1;
    }
    let mut right = n;
    let mut best = n;
    for i in (0..n).rev() {
        let c = bytes[i] - b'a';
        taken[c] -= 1;
        while taken[c] < k {
            right -= 1;
            taken[bytes[right] - b'a'] += 1;
        }
        best = best.min(i + n - right);
    }
    best
}

// ---- rec (take_rec.kara) -------------------------------------------------

fn rec_works(bytes: Slice[u8], k: i64, m: i64) -> bool {
    let n = bytes.len();
    let mut held = [0, 0, 0];
    for i in n - m..n {
        held[bytes[i] - b'a'] += 1;
    }
    if held[0] >= k and held[1] >= k and held[2] >= k {
        return true;
    }
    for i in 0..m {
        held[bytes[i] - b'a'] += 1;
        held[bytes[n - m + i] - b'a'] -= 1;
        if held[0] >= k and held[1] >= k and held[2] >= k {
            return true;
        }
    }
    false
}

fn rec_least(bytes: Slice[u8], k: i64, lo: i64, hi: i64) -> i64 {
    if lo == hi {
        return lo;
    }
    let mid = (lo + hi) / 2;
    if rec_works(bytes, k, mid) { rec_least(bytes, k, lo, mid) } else { rec_least(bytes, k, mid + 1, hi) }
}

fn rec_take_characters(s: String, k: i64) -> i64 {
    let n = s.len();
    if not rec_works(s.bytes(), k, n) {
        return -1;
    }
    rec_least(s.bytes(), k, 0, n)
}

// ---- iter (take_iter.kara) -----------------------------------------------

fn iter_take_characters(s: String, k: i64) -> i64 {
    let bytes = s.bytes();
    let total = bytes.iter().fold([0, 0, 0], |t, b| {
        let mut t = t;
        t[b - b'a'] += 1;
        t
    });
    if total.iter().any(|t| t < k) {
        return -1;
    }
    let (_, _, longest) = (0..bytes.len()).fold((0, [0, 0, 0], 0), |(left, inside, longest), right| {
        let mut (left, inside) = (left, inside);
        let c = bytes[right] - b'a';
        inside[c] += 1;
        while total[c] - inside[c] < k {
            inside[bytes[left] - b'a'] -= 1;
            left += 1;
        }
        (left, inside, longest.max(right - left + 1))
    });
    bytes.len() - longest
}

// ---- solution (take_solution.kara) ---------------------------------------

struct Solution {}

impl Solution {
    pub fn take_characters(s: String, k: i32) -> i32 {
        let b = s.bytes();
        let n = b.len();
        let mut cnt = [0i32; 3];
        for c in b {
            cnt[c - b'a'] += 1;
        }
        if cnt.iter().any(|x| x < k) {
            return -1;
        }
        let mut best = 0;
        let mut l = 0;
        for r in 0..n {
            let c = (b[r] - b'a') as i64;
            cnt[c] -= 1;
            while cnt[c] < k {
                cnt[b[l] - b'a'] += 1;
                l += 1;
            }
            best = best.max(r + 1 - l);
        }
        (n - best) as i32
    }
}

fn solution_take_characters(s: String, k: i64) -> i64 {
    Solution.take_characters(s, k as i32)
}

// ---- the differential --------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(arm: i64, s: String, k: i64) -> i64 {
    match arm {
        0 => star_take_characters(s, k),
        1 => search_take_characters(s, k),
        2 => shrink_take_characters(s, k),
        3 => rec_take_characters(s, k),
        4 => iter_take_characters(s, k),
        _ => solution_take_characters(s, k),
    }
}

fn main() {
    let names = ["star", "search", "shrink", "rec", "iter", "solution"];
    let mut seed = 2516;
    let mut problems: Vec[(String, i64)] = Vec.new();
    for t in 0..360 {
        let (n, letters, k) = if t < 300 {
            (next_random(mut seed) % 10 + 1, 3, -1)
        } else if t < 320 {
            (12, 2, 1)
        } else {
            (12, 3, 2)
        };
        let mut s = String.new();
        for _ in 0..n {
            s.push((b'a' + (next_random(mut seed) % letters) as u8) as char);
        }
        let k = if k == -1 { next_random(mut seed) % 4 } else { k };
        problems.push((s, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut misses = 0;
    for (s, k) in problems.iter() {
        let n = s.len();
        let truth = literal(s, k);
        if truth == -1 {
            misses += 1;
        }
        check = (check * 31 + truth + 1) % 1000000007;
        let short = ["a", "b", "c"].iter().any(|c| s.matches(c).count() < k);
        let reversed: String = s.chars().rev().collect();
        let renamed: String = s.chars().map(|c| if c == 'a' { 'b' } else if c == 'b' { 'c' } else { 'a' }).collect();
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, s, k)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let fewer = if k >= 1 and x >= 0 { answer(arm, s, k - 1) } else { 0 };
            let verdicts = [
                x == truth,
                if short { x == -1 } else { x >= 3 * k and x <= n },
                answer(arm, reversed, k) == x,
                answer(arm, renamed, k) == x,
                fewer >= 0 and fewer <= x.max(0),
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"\"{s}\" k {k}, arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases, {misses} with too few: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
