// LeetCode #2516: Take K of Each Character From Left and Right --
// benchmark of the ★ arm (take.kara): 40 strings of 10^5 letters built
// once from its own generator; then the passes, each asking every string
// with a k the checksum so far picks, up to 30000.

fn take_characters(s: String, k: i64) -> i64 {
    let bytes = s.bytes();
    let n = bytes.len();
    let mut total = [0, 0, 0];
    for b in bytes.iter() {
        total[b - b'a'] += 1;
    }
    if total[0] < k or total[1] < k or total[2] < k {
        return -1;
    }
    let mut inside = [0, 0, 0];
    let mut left = 0;
    let mut longest = 0;
    for right in 0..n {
        let c = bytes[right] - b'a';
        inside[c] += 1;
        while total[c] - inside[c] < k {
            inside[bytes[left] - b'a'] -= 1;
            left += 1;
        }
        longest = longest.max(right - left + 1);
    }
    n - longest
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2516;
    let mut strings: Vec[String] = Vec.new();
    for _ in 0..40 {
        let mut s = String.new();
        for _ in 0..100000 {
            s.push((b'a' + (next_random(mut seed) % 3) as u8) as char);
        }
        strings.push(s);
    }
    let passes = 7;
    let mut check = 0;
    for p in 0..passes {
        for s in strings.iter() {
            check = (check * 31 + take_characters(s, check % 30001) + 1 + p) % 1000000007;
        }
    }
    println(f"{passes} passes over 40 strings of 10^5: checksum {check}");
}
