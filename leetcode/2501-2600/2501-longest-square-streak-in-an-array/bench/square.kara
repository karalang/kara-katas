// LeetCode #2501: Longest Square Streak in an Array -- the benchmark: the
// ★ arm over 20 arrays of 10^5 values from squares chains, built once,
// then the passes; each sets one value of every array from the checksum
// so far, asks, and puts it back.

fn longest_square_streak(nums: Vec[i64]) -> i64 {
    let present: Set[i64] = nums.iter().cloned().collect();
    let mut best = 0;
    for v in present.iter() {
        let r = v.isqrt();
        if r * r == v and present.contains(r) {
            continue;
        }
        let mut length = 0;
        let mut x = v;
        while present.contains(x) {
            length += 1;
            x = x * x;
        }
        best = best.max(length);
    }
    if best >= 2 { best } else { -1 }
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn below(top: i64, seed: mut ref i64) -> i64 {
    (next_random(mut seed) * 32768 + next_random(mut seed)) % top
}

fn chained(n: i64, seed: mut ref i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for _ in 0..n {
        if next_random(mut seed) % 4 == 0 {
            out.push(below(99999, mut seed) + 2);
        } else {
            let mut v = next_random(mut seed) % 19 + 2;
            for _ in 0..next_random(mut seed) % 4 {
                if v * v <= 100000 {
                    v = v * v;
                }
            }
            out.push(v);
        }
    }
    out
}

fn main() {
    let passes = 32;
    let n = 100000;
    let mut seed = 2501;
    let mut arrays: Vec[Vec[i64]] = Vec.new();
    for _ in 0..20 {
        arrays.push(chained(n, mut seed));
    }
    let mut check = 0;
    for p in 0..passes {
        for q in 0..20 {
            let at = check % n;
            let was = arrays[q][at];
            arrays[q][at] = (check + p) % 99999 + 2;
            check = (check * 31 + longest_square_streak(arrays[q]) + 1 + p) % 1000000007;
            arrays[q][at] = was;
        }
    }
    println(f"{passes} passes over 20 arrays of 10^5: checksum {check}");
}
