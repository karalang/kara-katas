// LeetCode #2512: Reward Top K Students -- the differential. The six arms
// against the statement read literally: each report's score counted
// word by word against every feedback word in turn, 3 for each positive
// match and -1 for each negative one; then k rounds, each taking the
// student not yet taken with the highest score, the smaller id at a
// tie. No set is built and nothing is sorted. 300 random cases of 1 to
// 8 reports of 1 to 6 words from 3 to 8; then 20 of one report, and 40
// of 12 reports all of one score; every one drawn before any arm
// answers.
//
// P1  the answer is the statement read literally
// P2  k ids, distinct, every one a student's
// P3  the reports and their ids in the other order: the same answer
// P4  every report's words in the other order: the same answer
// P5  every id doubled and a negative word added to every report: the
//     answer's ids doubled
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally

fn literal(positive: Vec[String], negative: Vec[String], report: Vec[String], student_id: Vec[i64], k: i64) -> Vec[i64] {
    let mut scores: Vec[i64] = Vec.new();
    for r in report.iter() {
        let words: Vec[Str] = r.split(" ").collect();
        let mut score = 0;
        for w in words.iter() {
            for p in positive.iter() {
                if p == w {
                    score += 3;
                }
            }
            for q in negative.iter() {
                if q == w {
                    score -= 1;
                }
            }
        }
        scores.push(score);
    }
    let mut taken: Vec[bool] = Vec.filled(report.len(), false);
    let mut answer: Vec[i64] = Vec.new();
    for _ in 0..k {
        let mut best = -1;
        for i in 0..report.len() {
            if not taken[i] and (best < 0 or scores[i] > scores[best] or (scores[i] == scores[best] and student_id[i] < student_id[best])) {
                best = i;
            }
        }
        taken[best] = true;
        answer.push(student_id[best]);
    }
    answer
}

// ---- star (reward.kara) --------------------------------------------------

fn star_top_students(positive: Vec[String], negative: Vec[String], report: Vec[String], student_id: Vec[i64], k: i64) -> Vec[i64] {
    let good: Set[String] = positive.iter().map(|w| w.clone()).collect();
    let bad: Set[String] = negative.iter().map(|w| w.clone()).collect();
    let mut ranked: Vec[(i64, i64)] = Vec.new();
    for i in 0..report.len() {
        let mut score = 0;
        for word in report[i].split(" ") {
            if good.contains(word) {
                score += 3;
            } else if bad.contains(word) {
                score -= 1;
            }
        }
        ranked.push((-score, student_id[i]));
    }
    ranked.sort();
    ranked.iter().take(k).map(|(_, id)| id).collect()
}

// ---- sorted (reward_sorted.kara) -----------------------------------------

fn sorted_top_students(positive: Vec[String], negative: Vec[String], report: Vec[String], student_id: Vec[i64], k: i64) -> Vec[i64] {
    let mut good = positive.clone();
    good.sort();
    let mut bad = negative.clone();
    bad.sort();
    let mut scores: Vec[i64] = Vec.new();
    for r in report.iter() {
        let mut score = 0;
        for word in r.split(" ") {
            if good.binary_search(word).is_some() {
                score += 3;
            } else if bad.binary_search(word).is_some() {
                score -= 1;
            }
        }
        scores.push(score);
    }
    let mut order: Vec[i64] = (0..report.len()).collect();
    order.sort_by(|a, b| if scores[a] != scores[b] { scores[b].cmp(scores[a]) } else { student_id[a].cmp(student_id[b]) });
    order.iter().take(k).map(|i| student_id[i]).collect()
}

// ---- heap (reward_heap.kara) ---------------------------------------------

fn heap_top_students(positive: Vec[String], negative: Vec[String], report: Vec[String], student_id: Vec[i64], k: i64) -> Vec[i64] {
    let mut weight: Map[String, i64] = Map.new();
    for w in positive.iter() {
        weight.insert(w.clone(), 3);
    }
    for w in negative.iter() {
        weight.insert(w.clone(), -1);
    }
    let mut queue: PriorityQueue[(i64, i64)] = PriorityQueue.new();
    for i in 0..report.len() {
        let mut score = 0;
        for word in report[i].split(" ") {
            score += weight.get(word) ?? 0;
        }
        queue.push((-score, student_id[i]));
    }
    let mut top: Vec[i64] = Vec.new();
    while top.len() < k {
        let (_, id) = queue.pop().unwrap();
        top.push(id);
    }
    top
}

// ---- rec (reward_rec.kara) -----------------------------------------------

fn rec_score_from(words: Vec[Str], w: i64, good: Set[String], bad: Set[String]) -> i64 {
    if w == words.len() {
        0
    } else {
        let here = if good.contains(words[w]) { 3 } else if bad.contains(words[w]) { -1 } else { 0 };
        here + rec_score_from(words, w + 1, good, bad)
    }
}

fn rec_merge_sort(pairs: Vec[(i64, i64)]) -> Vec[(i64, i64)] {
    if pairs.len() <= 1 {
        return pairs.clone();
    }
    let middle = pairs.len() / 2;
    let left = rec_merge_sort(pairs[0..middle].to_vec());
    let right = rec_merge_sort(pairs[middle..pairs.len()].to_vec());
    let mut merged: Vec[(i64, i64)] = Vec.new();
    let mut (i, j) = (0, 0);
    while i < left.len() or j < right.len() {
        if j == right.len() or (i < left.len() and left[i] <= right[j]) {
            merged.push(left[i]);
            i += 1;
        } else {
            merged.push(right[j]);
            j += 1;
        }
    }
    merged
}

fn rec_top_students(positive: Vec[String], negative: Vec[String], report: Vec[String], student_id: Vec[i64], k: i64) -> Vec[i64] {
    let good: Set[String] = positive.iter().map(|w| w.clone()).collect();
    let bad: Set[String] = negative.iter().map(|w| w.clone()).collect();
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for i in 0..report.len() {
        let words: Vec[Str] = report[i].split(" ").collect();
        pairs.push((-rec_score_from(words, 0, good, bad), student_id[i]));
    }
    let ranked = rec_merge_sort(pairs);
    (0..k).map(|i| ranked[i].1).collect()
}

// ---- iter (reward_iter.kara) ---------------------------------------------

fn iter_top_students(positive: Vec[String], negative: Vec[String], report: Vec[String], student_id: Vec[i64], k: i64) -> Vec[i64] {
    let good: Set[String] = positive.iter().map(|w| w.clone()).collect();
    let bad: Set[String] = negative.iter().map(|w| w.clone()).collect();
    let weight = |w: Str| if good.contains(w) { 3 } else if bad.contains(w) { -1 } else { 0 };
    let mut ranked: Vec[(i64, i64)] = report
        .iter()
        .map(|r| -r.split(" ").map(|w| weight(w)).sum())
        .zip(student_id.iter())
        .collect();
    ranked.sort();
    ranked.iter().take(k).map(|(_, id)| id).collect()
}

// ---- solution (reward_solution.kara) -------------------------------------

struct Solution {}

impl Solution {
    pub fn top_students(
        positive_feedback: Vec[String],
        negative_feedback: Vec[String],
        report: Vec[String],
        student_id: Vec[i32],
        k: i32,
    ) -> Vec[i32] {
        let pos: Set[Str] = positive_feedback.iter().map(|s| s.as_str()).collect();
        let neg: Set[Str] = negative_feedback.iter().map(|s| s.as_str()).collect();
        let mut v: Vec[(i32, i32)] = report
            .iter()
            .zip(student_id.iter())
            .map(|(r, id)| {
                let score = r.split_whitespace().fold(0, |acc, w| {
                    if pos.contains(w) {
                        acc + 3
                    } else if neg.contains(w) {
                        acc - 1
                    } else {
                        acc
                    }
                });
                (score, id)
            })
            .collect();
        v.sort_by(|a, b| b.0.cmp(a.0).then(a.1.cmp(b.1)));
        v.into_iter().take(k).map(|(_, id)| id).collect()
    }
}

fn solution_top_students(positive: Vec[String], negative: Vec[String], report: Vec[String], student_id: Vec[i64], k: i64) -> Vec[i64] {
    let ids: Vec[i32] = student_id.iter().map(|v| v as i32).collect();
    Solution.top_students(positive, negative, report, ids, k as i32).iter().map(|v| v as i64).collect()
}

// ---- the differential --------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(arm: i64, positive: Vec[String], negative: Vec[String], report: Vec[String], ids: Vec[i64], k: i64) -> Vec[i64] {
    match arm {
        0 => star_top_students(positive, negative, report, ids, k),
        1 => sorted_top_students(positive, negative, report, ids, k),
        2 => heap_top_students(positive, negative, report, ids, k),
        3 => rec_top_students(positive, negative, report, ids, k),
        4 => iter_top_students(positive, negative, report, ids, k),
        _ => solution_top_students(positive, negative, report, ids, k),
    }
}

fn word(w: i64) -> String {
    let mut text = String.new();
    text.push((b'a' + w as u8) as char);
    text
}

fn main() {
    let names = ["star", "sorted", "heap", "rec", "iter", "solution"];
    let mut seed = 2512;
    let mut problems: Vec[(Vec[String], Vec[String], Vec[String], Vec[i64], i64)] = Vec.new();
    for t in 0..360 {
        let size = if t < 300 { next_random(mut seed) % 6 + 3 } else { 4 };
        let p = next_random(mut seed) % (size - 1) + 1;
        let q = next_random(mut seed) % (size - p) + 1;
        let positive: Vec[String] = (0..p).map(|w| word(w)).collect();
        let negative: Vec[String] = (p..p + q).map(|w| word(w)).collect();
        let n = if t < 300 { next_random(mut seed) % 8 + 1 } else if t < 320 { 1 } else { 12 };
        let mut report: Vec[String] = Vec.new();
        for _ in 0..n {
            if t < 320 {
                let length = next_random(mut seed) % 6 + 1;
                let words: Vec[String] = (0..length).map(|_| word(next_random(mut seed) % size)).collect();
                report.push(words.join(" "));
            } else {
                // one positive word and one negative word, in either order
                let (a, b) = (word(next_random(mut seed) % p), word(p + next_random(mut seed) % q));
                report.push(if next_random(mut seed) % 2 == 0 { f"{a} {b}" } else { f"{b} {a}" });
            }
        }
        let mut ids: Vec[i64] = Vec.new();
        while ids.len() < n {
            let id = next_random(mut seed) % 40 + 1;
            if not ids.contains(id) {
                ids.push(id);
            }
        }
        let k = next_random(mut seed) % n + 1;
        problems.push((positive, negative, report, ids, k));
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut whole = 0;
    for (positive, negative, report, ids, k) in problems.iter() {
        let truth = literal(positive, negative, report, ids, k);
        for t in truth.iter() {
            check = (check * 31 + t) % 1000000007;
        }
        if k == report.len() {
            whole += 1;
        }
        let back_reports: Vec[String] = report.iter().rev().map(|r| r.clone()).collect();
        let back_ids: Vec[i64] = ids.iter().rev().map(|v| *v).collect();
        let turned: Vec[String] = report.iter().map(|r| Vec[Str].from_iter(r.split(" ").rev()).join(" ")).collect();
        let worse: Vec[String] = report.iter().map(|r| f"{r} {negative[0]}").collect();
        let doubled: Vec[i64] = ids.iter().map(|v| 2 * v).collect();
        let got: Vec[Vec[i64]] = (0..6).map(|arm| answer(arm, positive, negative, report, ids, k)).collect();
        for arm in 0..6 {
            let x = got[arm].clone();
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let mut distinct = true;
            for i in 0..x.len() {
                for j in i + 1..x.len() {
                    if x[i] == x[j] {
                        distinct = false;
                    }
                }
            }
            let twice: Vec[i64] = x.iter().map(|v| 2 * v).collect();
            let verdicts = [
                x == truth,
                x.len() == k and distinct and x.iter().all(|v| ids.contains(v)),
                answer(arm, positive, negative, back_reports, back_ids, k) == x,
                answer(arm, positive, negative, turned, ids, k) == x,
                answer(arm, positive, negative, worse, doubled, k) == twice,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{report} {ids} k {k}, arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases, {whole} asking every student: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
