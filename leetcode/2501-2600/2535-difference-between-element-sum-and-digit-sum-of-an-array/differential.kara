// LeetCode #2535: Difference Between Element Sum and Digit Sum of an Array
// -- the differential. The six arms against the statement read literally:
// the sum of the numbers, the sum of every digit of every number written
// out, and the absolute difference. 400 random lists of 1 to 12 numbers
// to 2000, then 40 of the far end: every number 2000, or 1999, or 1 to 9;
// every one drawn before any arm answers.
//
// P1  the answer is the statement read literally
// P2  the answer is at least 0 and a multiple of 9, since a number and
//     its digit sum leave the same remainder by 9
// P3  the numbers in the other order: the same answer
// P4  the digits 1 to 9 added: the same answer, since a one-digit number
//     is its own digit sum
// P5  every number written twice: twice the answer
// P6  each arm agrees with at least three of the other five

// ---- the statement read literally

fn literal(nums: Vec[i64]) -> i64 {
    let mut element_sum = 0;
    let mut digit_sum = 0;
    for x in nums.iter() {
        element_sum += x;
        for c in f"{x}".chars() {
            digit_sum += c as i64 - '0' as i64;
        }
    }
    (element_sum - digit_sum).abs()
}

// ---- star (difference.kara) ----------------------------------------------

fn star_difference_of_sum(nums: Vec[i64]) -> i64 {
    let mut element_sum = 0;
    let mut digit_sum = 0;
    for x in nums.iter() {
        element_sum += x;
        let mut rest = x;
        while rest > 0 {
            digit_sum += rest % 10;
            rest /= 10;
        }
    }
    (element_sum - digit_sum).abs()
}

// ---- each (difference_each.kara) -----------------------------------------

fn each_difference_of_sum(nums: Vec[i64]) -> i64 {
    let mut difference = 0;
    for x in nums.iter() {
        let mut digits = 0;
        let mut place = 1000;
        while place > 0 {
            digits += x / place % 10;
            place /= 10;
        }
        difference += x - digits;
    }
    difference
}

// ---- rec (difference_rec.kara) -------------------------------------------

fn rec_digit_sum(x: i64) -> i64 {
    if x == 0 { 0 } else { x % 10 + rec_digit_sum(x / 10) }
}

fn rec_difference_from(nums: Vec[i64], i: i64) -> i64 {
    if i == nums.len() {
        0
    } else {
        nums[i] - rec_digit_sum(nums[i]) + rec_difference_from(nums, i + 1)
    }
}

fn rec_difference_of_sum(nums: Vec[i64]) -> i64 {
    rec_difference_from(nums, 0)
}

// ---- iter (difference_iter.kara) -----------------------------------------

fn iter_difference_of_sum(nums: Vec[i64]) -> i64 {
    let element_sum: i64 = nums.iter().sum();
    let digit_sum: i64 = nums
        .iter()
        .flat_map(|x| successors(Some(*x), |r| if r >= 10 { Some(r / 10) } else { None }).map(|r| r % 10))
        .sum();
    (element_sum - digit_sum).abs()
}

// ---- text (difference_text.kara) -----------------------------------------

fn text_difference_of_sum(nums: Vec[i64]) -> i64 {
    let element_sum: i64 = nums.iter().sum();
    let mut digit_sum = 0;
    for x in nums.iter() {
        for c in x.to_string().chars() {
            digit_sum += c.to_digit(10).unwrap();
        }
    }
    (element_sum - digit_sum).abs()
}

// ---- solution (difference_solution.kara) ---------------------------------

struct Solution {}

impl Solution {
    pub fn difference_of_sum(nums: Vec[i32]) -> i32 {
        let element_sum: i32 = nums.iter().sum();
        let digit_sum: i32 = nums
            .iter()
            .map(|x| {
                let mut x = x;
                let mut s: i32 = 0;
                while x > 0 {
                    s += x % 10;
                    x /= 10;
                }
                s
            })
            .sum();
        (element_sum - digit_sum).abs()
    }
}

fn solution_difference_of_sum(nums: Vec[i64]) -> i64 {
    Solution.difference_of_sum(nums.iter().map(|x| x as i32).collect())
}

// ---- the differential --------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn answer(arm: i64, nums: Vec[i64]) -> i64 {
    match arm {
        0 => star_difference_of_sum(nums),
        1 => each_difference_of_sum(nums),
        2 => rec_difference_of_sum(nums),
        3 => iter_difference_of_sum(nums),
        4 => text_difference_of_sum(nums),
        _ => solution_difference_of_sum(nums),
    }
}

fn main() {
    let names = ["star", "each", "rec", "iter", "text", "solution"];
    let mut seed = 2535;
    let mut problems: Vec[Vec[i64]] = Vec.new();
    for t in 0..440 {
        let n = next_random(mut seed) % 12 + 1;
        let mut nums: Vec[i64] = Vec.new();
        for _ in 0..n {
            let v = if t < 400 {
                next_random(mut seed) % 2000 + 1
            } else if t < 410 {
                2000
            } else if t < 420 {
                1999
            } else {
                next_random(mut seed) % 9 + 1
            };
            nums.push(v);
        }
        problems.push(nums);
    }
    let mut failures: Vec[String] = Vec.new();
    let mut by_property = [0, 0, 0, 0, 0, 0];
    let mut checks = 0;
    let mut check = 0;
    let mut zero = 0;
    for nums in problems.iter() {
        let truth = literal(nums);
        if truth == 0 {
            zero += 1;
        }
        check = (check * 31 + truth) % 1000000007;
        let reversed: Vec[i64] = nums.iter().rev().cloned().collect();
        let mut digits = nums.clone();
        digits.extend((1..10).map(|d| d));
        let mut twice = nums.clone();
        twice.extend(nums.iter().cloned());
        let got: Vec[i64] = (0..6).map(|arm| answer(arm, nums)).collect();
        for arm in 0..6 {
            let x = got[arm];
            let mut same = 0;
            for o in 0..6 {
                if o != arm and got[o] == x {
                    same += 1;
                }
            }
            let verdicts = [
                x == truth,
                x >= 0 and x % 9 == 0,
                answer(arm, reversed) == x,
                answer(arm, digits) == x,
                answer(arm, twice) == 2 * x,
                same >= 3,
            ];
            for q in 0..6 {
                checks += 1;
                if not verdicts[q] {
                    by_property[q] += 1;
                    if failures.len() < 10 {
                        failures.push(f"{nums}, arm {names[arm]}: P{q + 1} fails, answer {x}, literal {truth}");
                    }
                }
            }
        }
    }
    let total = by_property.iter().sum();
    println(f"{problems.len()} cases, {zero} with answer 0: checksum {check}, {checks} checks over 6 arms: {total} failures");
    if total > 0 {
        for f in failures.iter() {
            println(f);
        }
        for q in 0..6 {
            if by_property[q] > 0 {
                println(f"P{q + 1} {by_property[q]}");
            }
        }
    }
}
