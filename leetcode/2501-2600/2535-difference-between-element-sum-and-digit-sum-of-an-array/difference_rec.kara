// LeetCode #2535: Difference Between Element Sum and Digit Sum of an Array
// -- recursion: a number's digit sum is its last digit plus the digit sum
// of the rest, and the list's difference is its first number's less its
// digits plus the difference of the rest. At most 2000 deep.

fn digit_sum(x: i64) -> i64 {
    if x == 0 { 0 } else { x % 10 + digit_sum(x / 10) }
}

fn difference_from(nums: Vec[i64], i: i64) -> i64 {
    if i == nums.len() {
        0
    } else {
        nums[i] - digit_sum(nums[i]) + difference_from(nums, i + 1)
    }
}

fn difference_of_sum(nums: Vec[i64]) -> i64 {
    difference_from(nums, 0)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then six more
    let fixed: Vec[Vec[i64]] = [
        [1, 15, 6, 3],
        [1, 2, 3, 4],
        [2000],
        [1999],
        [9, 99, 999],
        [10, 100, 1000],
        [1, 1, 1, 1, 1],
        [1234, 567, 89],
    ];
    for nums in fixed.iter() {
        println(f"{nums} -> {difference_of_sum(nums)}");
    }
    // 3000 random lists of 1 to 20 numbers from 1 to 2000, and 1000 of 1
    // to 2000: the sum of the answers and a checksum
    let mut seed = 2535;
    for (count, most) in [(3000, 20), (1000, 2000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = next_random(mut seed) % most + 1;
            let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 2000 + 1).collect();
            let a = difference_of_sum(nums);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
        println(f"{count} random lists of up to {most} numbers: total {total}, checksum {check}");
    }
}
