// LeetCode #2535: Difference Between Element Sum and Digit Sum of an Array
// -- LeetCode's Rust template: `Vec<i32>` in, `i32` out; the element sum
// and the digit sum each a `sum` over the numbers, the digits taken off
// in a loop; carried by `karac fix`.

struct Solution {}

impl Solution {
    pub fn difference_of_sum(nums: Vec[i32]) -> i32 {
        let element_sum: i32 = nums.iter().sum();
        let digit_sum: i32 = nums
            .iter()
            .map(|x| {
                let mut x = x;
                let mut s: i32 = 0;
                while x > 0 {
                    s += x % 10;
                    x /= 10;
                }
                s
            })
            .sum();
        (element_sum - digit_sum).abs()
    }
}

fn difference_of_sum(nums: Vec[i64]) -> i64 {
    Solution.difference_of_sum(nums.iter().map(|x| x as i32).collect())
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    // LeetCode's two examples, then six more
    let fixed: Vec[Vec[i64]] = [
        [1, 15, 6, 3],
        [1, 2, 3, 4],
        [2000],
        [1999],
        [9, 99, 999],
        [10, 100, 1000],
        [1, 1, 1, 1, 1],
        [1234, 567, 89],
    ];
    for nums in fixed.iter() {
        println(f"{nums} -> {difference_of_sum(nums)}");
    }
    // 3000 random lists of 1 to 20 numbers from 1 to 2000, and 1000 of 1
    // to 2000: the sum of the answers and a checksum
    let mut seed = 2535;
    for (count, most) in [(3000, 20), (1000, 2000)] {
        let mut total = 0;
        let mut check = 0;
        for _ in 0..count {
            let n = next_random(mut seed) % most + 1;
            let nums: Vec[i64] = (0..n).map(|_| next_random(mut seed) % 2000 + 1).collect();
            let a = difference_of_sum(nums);
            total += a;
            check = (check * 31 + a) % 1000000007;
        }
        println(f"{count} random lists of up to {most} numbers: total {total}, checksum {check}");
    }
}
