// LeetCode #2520: Count the Digits That Divide a Number -- benchmark of the
// ★ arm (digits.kara): 100000 numbers of 1 to 9 digits from 1 to 9 built
// once from its own generator; then the passes, each asking every number,
// starting at an offset the checksum so far picks.

fn count_digits(num: i64) -> i64 {
    let mut rest = num;
    let mut count = 0;
    while rest > 0 {
        if num % (rest % 10) == 0 {
            count += 1;
        }
        rest /= 10;
    }
    count
}

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

fn main() {
    let mut seed = 2520;
    let mut nums: Vec[i64] = Vec.new();
    for _ in 0..100000 {
        let length = next_random(mut seed) % 9 + 1;
        let mut num = 0;
        for _ in 0..length {
            num = num * 10 + next_random(mut seed) % 9 + 1;
        }
        nums.push(num);
    }
    let passes = 150;
    let mut check = 0;
    for p in 0..passes {
        let start = check % 100000;
        for i in 0..100000 {
            check = (check * 31 + count_digits(nums[(start + i) % 100000]) + p) % 1000000007;
        }
    }
    println(f"{passes} passes over 100000 numbers: checksum {check}");
}
