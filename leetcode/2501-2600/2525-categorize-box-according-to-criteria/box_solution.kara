// LeetCode #2525: Categorize Box According to Criteria -- LeetCode's Rust
// template: `i32` in, `String` out; the volume formed as an `i64` from the
// sides cast up, and the name chosen by a `match` on the two tests and
// turned into a `String`; carried by `karac fix`.

struct Solution {}

impl Solution {
    pub fn categorize_box(length: i32, width: i32, height: i32, mass: i32) -> String {
        let volume = length as i64 * width as i64 * height;
        let bulky = length >= 10_000 or width >= 10_000 or height >= 10_000 or volume >= 1_000_000_000;
        let heavy = mass >= 100;
        match (bulky, heavy) {
            (true, true) => "Both".to_string(),
            (true, false) => "Bulky".to_string(),
            (false, true) => "Heavy".to_string(),
            (false, false) => "Neither".to_string(),
        }
    }
}

fn categorize_box(length: i64, width: i64, height: i64, mass: i64) -> String {
    Solution.categorize_box(length as i32, width as i32, height as i32, mass as i32)
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a value from 0 to 2^30 - 1, next_random giving only 15 bits
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples, then eight more at the edges
    let fixed = [
        (1000, 35, 700, 300),
        (200, 50, 800, 50),
        (10000, 1, 1, 1),
        (9999, 1, 1, 100),
        (1000, 1000, 1000, 100),
        (999, 1000, 1000, 99),
        (100000, 100000, 100000, 1000),
        (1, 1, 1, 1),
        (1, 9999, 9999, 99),
        (2, 9999, 9999, 100),
    ];
    for (length, width, height, mass) in fixed {
        println(f"{length} {width} {height} {mass} -> {categorize_box(length, width, height, mass)}");
    }
    // 10^5 random boxes with sides from 1 to 10^5, and 10^5 with sides
    // from 1 to 2000; masses from 1 to 1000: how many of each name
    let mut seed = 2525;
    for top in [100000, 2000] {
        let mut counts = [0, 0, 0, 0];
        for _ in 0..100000 {
            let length = wide_random(mut seed) % top + 1;
            let width = wide_random(mut seed) % top + 1;
            let height = wide_random(mut seed) % top + 1;
            let mass = next_random(mut seed) % 1000 + 1;
            let name = categorize_box(length, width, height, mass);
            let at = if name == "Both" { 0 } else if name == "Bulky" { 1 } else if name == "Heavy" { 2 } else { 3 };
            counts[at] += 1;
        }
        println(f"10^5 random to {top}: Both {counts[0]}, Bulky {counts[1]}, Heavy {counts[2]}, Neither {counts[3]}");
    }
}
