// LeetCode #2525: Categorize Box According to Criteria -- iterators: bulky
// when `any` side reaches 10^4 or the sides' `product` reaches 10^9; the
// name the one `filter`ed from a table of the four by its two tests.

fn categorize_box(length: i64, width: i64, height: i64, mass: i64) -> Str {
    let sides = [length, width, height];
    let bulky = sides.iter().any(|s| s >= 10000) or sides.iter().product() >= 1000000000;
    let heavy = mass >= 100;
    let table: Vec[(Str, bool, bool)] = [("Both", true, true), ("Bulky", true, false), ("Heavy", false, true), ("Neither", false, false)];
    table
        .iter()
        .filter(|(_, b, h)| b == bulky and h == heavy)
        .map(|(name, _, _)| name)
        .next()
        .unwrap()
}

// ---- test harness ---------------------------------------------------------

fn next_random(seed: mut ref i64) -> i64 {
    *seed = (*seed * 1103515245 + 12345) % 2147483648;
    *seed / 65536
}

// a value from 0 to 2^30 - 1, next_random giving only 15 bits
fn wide_random(seed: mut ref i64) -> i64 {
    next_random(mut seed) * 32768 + next_random(mut seed)
}

fn main() {
    // LeetCode's two examples, then eight more at the edges
    let fixed = [
        (1000, 35, 700, 300),
        (200, 50, 800, 50),
        (10000, 1, 1, 1),
        (9999, 1, 1, 100),
        (1000, 1000, 1000, 100),
        (999, 1000, 1000, 99),
        (100000, 100000, 100000, 1000),
        (1, 1, 1, 1),
        (1, 9999, 9999, 99),
        (2, 9999, 9999, 100),
    ];
    for (length, width, height, mass) in fixed {
        println(f"{length} {width} {height} {mass} -> {categorize_box(length, width, height, mass)}");
    }
    // 10^5 random boxes with sides from 1 to 10^5, and 10^5 with sides
    // from 1 to 2000; masses from 1 to 1000: how many of each name
    let mut seed = 2525;
    for top in [100000, 2000] {
        let mut counts = [0, 0, 0, 0];
        for _ in 0..100000 {
            let length = wide_random(mut seed) % top + 1;
            let width = wide_random(mut seed) % top + 1;
            let height = wide_random(mut seed) % top + 1;
            let mass = next_random(mut seed) % 1000 + 1;
            let name = categorize_box(length, width, height, mass);
            let at = if name == "Both" { 0 } else if name == "Bulky" { 1 } else if name == "Heavy" { 2 } else { 3 };
            counts[at] += 1;
        }
        println(f"10^5 random to {top}: Both {counts[0]}, Bulky {counts[1]}, Heavy {counts[2]}, Neither {counts[3]}");
    }
}
