// Discriminator for B-2026-07-24-2: isolate the map KEY WALK from map PROBING.
// Same shape as LeetCode #170's `find` loop, but with NO `get` in the body —
// so the only per-key work is the iterator step itself.
//
// The body xors each key with the outer index so the inner walk genuinely
// depends on `i` and neither compiler can hoist it out of the outer loop.
// Both language versions pay that identical extra xor.

fn walk(m: ref Map[i64, i64], i: i64) -> i64 {
    let mut s = 0i64;
    for k in m.keys() {
        s = s ^ (k + i);
    }
    s
}

fn main() {
    let mut m: Map[i64, i64] = Map.new();
    let mut j = 0i64;
    while j < 170i64 {
        let _ = m.insert(j * 7919i64, j);
        j = j + 1i64;
    }

    let mut total = 0i64;
    let mut i = 0i64;
    while i < 1200000i64 {
        total = total + walk(m, i);
        i = i + 1i64;
    }
    println(total);
}
