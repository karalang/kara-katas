target/
# Equal-safety rayon twin build dir (bench-lib.sh ovf_build_rayon). RUSTFLAGS is
# part of cargo's fingerprint, so the overflow-checked build needs its own
# CARGO_TARGET_DIR or it and the plain build evict each other every alternation.
target-ovf/
__pycache__/
*.pyc
.DS_Store

# working/staging planning lists — promote settled content into the corpus
wip-*.md

# karac/rustc-compiled binaries (extensionless build outputs)
backend/todo-api/main
leetcode/1-100/7-reverse-integer/bench/red_min
leetcode/1-100/7-reverse-integer/bench/red_test
leetcode/101-200/133-clone-graph/bench/clone_bfs_small
leetcode/1-100/91-decode-ways/main
leetcode/1-100/2-add-two-numbers/bench/iterative
backend/supervised_echo/main
